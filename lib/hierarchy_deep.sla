// Deepened Bevy ECS hierarchy surface.
// Mirrors src/hierarchy.rs:
//   ChildOf / Children (linked_spawn Relationship)
//   Children swap / sort_by_key (entity id order)
//   EntityWorldMut with_children / add_children / add_child / insert_children / remove_children
//   Parent despawn linked-despawns descendants
//   ancestor / descendant walk helpers
// Shallow lib/hierarchy.sla retained.

const ECS_H_LINKED_SPAWN: bool = true;

fn ecs_h_linked_spawn() -> bool { return ECS_H_LINKED_SPAWN; }

// Children collection capacity 8
struct EcsHChildrenDeep {
    c0: i64, c1: i64, c2: i64, c3: i64,
    c4: i64, c5: i64, c6: i64, c7: i64,
    len: i32,
}

fn ecs_h_children_new() -> EcsHChildrenDeep {
    return EcsHChildrenDeep {
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0, len: 0,
    };
}

fn ecs_h_children_len(c: EcsHChildrenDeep) -> i32 { return c.len; }
fn ecs_h_children_is_empty(c: EcsHChildrenDeep) -> bool { return c.len == 0; }

fn ecs_h_children_at(c: EcsHChildrenDeep, idx: i32) -> i64 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    if idx == 7 { return c.c7; };
    return 0;
}

fn ecs_h_children_contains(c: EcsHChildrenDeep, e: i64) -> bool {
    if c.len >= 1 && c.c0 == e { return true; };
    if c.len >= 2 && c.c1 == e { return true; };
    if c.len >= 3 && c.c2 == e { return true; };
    if c.len >= 4 && c.c3 == e { return true; };
    if c.len >= 5 && c.c4 == e { return true; };
    if c.len >= 6 && c.c5 == e { return true; };
    if c.len >= 7 && c.c6 == e { return true; };
    if c.len >= 8 && c.c7 == e { return true; };
    return false;
}

fn ecs_h_children_set(c: EcsHChildrenDeep, idx: i32, e: i64) -> EcsHChildrenDeep {
    if idx == 0 { return EcsHChildrenDeep { c0: e, c1: c.c1, c2: c.c2, c3: c.c3, c4: c.c4, c5: c.c5, c6: c.c6, c7: c.c7, len: c.len }; };
    if idx == 1 { return EcsHChildrenDeep { c0: c.c0, c1: e, c2: c.c2, c3: c.c3, c4: c.c4, c5: c.c5, c6: c.c6, c7: c.c7, len: c.len }; };
    if idx == 2 { return EcsHChildrenDeep { c0: c.c0, c1: c.c1, c2: e, c3: c.c3, c4: c.c4, c5: c.c5, c6: c.c6, c7: c.c7, len: c.len }; };
    if idx == 3 { return EcsHChildrenDeep { c0: c.c0, c1: c.c1, c2: c.c2, c3: e, c4: c.c4, c5: c.c5, c6: c.c6, c7: c.c7, len: c.len }; };
    if idx == 4 { return EcsHChildrenDeep { c0: c.c0, c1: c.c1, c2: c.c2, c3: c.c3, c4: e, c5: c.c5, c6: c.c6, c7: c.c7, len: c.len }; };
    if idx == 5 { return EcsHChildrenDeep { c0: c.c0, c1: c.c1, c2: c.c2, c3: c.c3, c4: c.c4, c5: e, c6: c.c6, c7: c.c7, len: c.len }; };
    if idx == 6 { return EcsHChildrenDeep { c0: c.c0, c1: c.c1, c2: c.c2, c3: c.c3, c4: c.c4, c5: c.c5, c6: e, c7: c.c7, len: c.len }; };
    if idx == 7 { return EcsHChildrenDeep { c0: c.c0, c1: c.c1, c2: c.c2, c3: c.c3, c4: c.c4, c5: c.c5, c6: c.c6, c7: e, len: c.len }; };
    return c;
}

fn ecs_h_children_push(c: EcsHChildrenDeep, e: i64) -> EcsHChildrenDeep {
    if c.len >= 8 { return c; };
    let n = c.len;
    c = ecs_h_children_set(c, n, e);
    return EcsHChildrenDeep {
        c0: c.c0, c1: c.c1, c2: c.c2, c3: c.c3, c4: c.c4, c5: c.c5, c6: c.c6, c7: c.c7, len: n + 1,
    };
}

fn ecs_h_children_remove(c: EcsHChildrenDeep, e: i64) -> EcsHChildrenDeep {
    let out = ecs_h_children_new();
    if c.len >= 1 && c.c0 != e { out = ecs_h_children_push(out, c.c0); };
    if c.len >= 2 && c.c1 != e { out = ecs_h_children_push(out, c.c1); };
    if c.len >= 3 && c.c2 != e { out = ecs_h_children_push(out, c.c2); };
    if c.len >= 4 && c.c3 != e { out = ecs_h_children_push(out, c.c3); };
    if c.len >= 5 && c.c4 != e { out = ecs_h_children_push(out, c.c4); };
    if c.len >= 6 && c.c5 != e { out = ecs_h_children_push(out, c.c5); };
    if c.len >= 7 && c.c6 != e { out = ecs_h_children_push(out, c.c6); };
    if c.len >= 8 && c.c7 != e { out = ecs_h_children_push(out, c.c7); };
    return out;
}

fn ecs_h_children_swap(c: EcsHChildrenDeep, a: i32, b: i32) -> EcsHChildrenDeep {
    if a < 0 || b < 0 || a >= c.len || b >= c.len { return c; };
    let va = ecs_h_children_at(c, a);
    let vb = ecs_h_children_at(c, b);
    c = ecs_h_children_set(c, a, vb);
    c = ecs_h_children_set(c, b, va);
    return c;
}

// stable-ish bubble sort by entity id
fn ecs_h_children_sort_by_id(c: EcsHChildrenDeep) -> EcsHChildrenDeep {
    let n = c.len;
    if n <= 1 { return c; };
    // three bubble passes
    let pass = 0;
    if pass < n {
        let i = 0;
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
        };
    };
    if n > 2 {
        let i = 0;
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
        };
    };
    if n > 3 {
        let i = 0;
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_h_children_at(c, i) > ecs_h_children_at(c, i + 1) {
                c = ecs_h_children_swap(c, i, i + 1);
            };
        };
    };
    return c;
}

fn ecs_h_children_insert(c: EcsHChildrenDeep, index: i32, e: i64) -> EcsHChildrenDeep {
    if c.len >= 8 { return c; };
    if index < 0 { index = 0; };
    if index > c.len { index = c.len; };
    c = ecs_h_children_push(c, 0);
    let i = c.len - 1;
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    if i > index { c = ecs_h_children_set(c, i, ecs_h_children_at(c, i - 1)); i = i - 1; };
    c = ecs_h_children_set(c, index, e);
    return c;
}

// Entity
struct EcsHEntityDeep {
    id: i64,
    alive: bool,
    has_child_of: bool,
    parent: i64,
    has_children: bool,
    children: EcsHChildrenDeep,
}

fn ecs_h_entity_new(id: i64) -> EcsHEntityDeep {
    return EcsHEntityDeep {
        id: id, alive: true, has_child_of: false, parent: 0,
        has_children: false, children: ecs_h_children_new(),
    };
}

// World capacity 8 entities
struct EcsHWorldDeep {
    e0: EcsHEntityDeep, e1: EcsHEntityDeep, e2: EcsHEntityDeep, e3: EcsHEntityDeep,
    e4: EcsHEntityDeep, e5: EcsHEntityDeep, e6: EcsHEntityDeep, e7: EcsHEntityDeep,
    elen: i32,
    next_entity: i64,
    despawn_count: i32,
}

fn ecs_h_world_new(next_entity: i64) -> EcsHWorldDeep {
    return EcsHWorldDeep {
        e0: ecs_h_entity_new(0), e1: ecs_h_entity_new(0), e2: ecs_h_entity_new(0), e3: ecs_h_entity_new(0),
        e4: ecs_h_entity_new(0), e5: ecs_h_entity_new(0), e6: ecs_h_entity_new(0), e7: ecs_h_entity_new(0),
        elen: 0, next_entity: next_entity, despawn_count: 0,
    };
}

fn ecs_h_world_despawn_count(w: EcsHWorldDeep) -> i32 { return w.despawn_count; }
fn ecs_h_world_next(w: EcsHWorldDeep) -> i64 { return w.next_entity; }

fn ecs_h_world_get(w: EcsHWorldDeep, id: i64) -> (bool, EcsHEntityDeep) {
    if w.elen >= 1 && w.e0.id == id { return (true, w.e0); };
    if w.elen >= 2 && w.e1.id == id { return (true, w.e1); };
    if w.elen >= 3 && w.e2.id == id { return (true, w.e2); };
    if w.elen >= 4 && w.e3.id == id { return (true, w.e3); };
    if w.elen >= 5 && w.e4.id == id { return (true, w.e4); };
    if w.elen >= 6 && w.e5.id == id { return (true, w.e5); };
    if w.elen >= 7 && w.e6.id == id { return (true, w.e6); };
    if w.elen >= 8 && w.e7.id == id { return (true, w.e7); };
    return (false, ecs_h_entity_new(0));
}

fn ecs_h_world_set(w: EcsHWorldDeep, e: EcsHEntityDeep) -> EcsHWorldDeep {
    if w.elen >= 1 && w.e0.id == e.id {
        return EcsHWorldDeep { e0: e, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 2 && w.e1.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: e, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 3 && w.e2.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: e, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 4 && w.e3.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: e, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 5 && w.e4.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: e, e5: w.e5, e6: w.e6, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 6 && w.e5.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: e, e6: w.e6, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 7 && w.e6.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: e, e7: w.e7, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    if w.elen >= 8 && w.e7.id == e.id {
        return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: e, elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count };
    };
    let n = w.elen;
    if n == 0 { return EcsHWorldDeep { e0: e, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: 1, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 1 { return EcsHWorldDeep { e0: w.e0, e1: e, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: 2, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 2 { return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: e, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: 3, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 3 { return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: e, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7, elen: 4, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 4 { return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: e, e5: w.e5, e6: w.e6, e7: w.e7, elen: 5, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 5 { return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: e, e6: w.e6, e7: w.e7, elen: 6, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 6 { return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: e, e7: w.e7, elen: 7, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    if n == 7 { return EcsHWorldDeep { e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: e, elen: 8, next_entity: w.next_entity, despawn_count: w.despawn_count }; };
    return w;
}

fn ecs_h_world_spawn_empty(w: EcsHWorldDeep) -> (EcsHWorldDeep, i64) {
    let id = w.next_entity;
    let e = ecs_h_entity_new(id);
    w = ecs_h_world_set(w, e);
    w = EcsHWorldDeep {
        e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7,
        elen: w.elen, next_entity: id + 1, despawn_count: w.despawn_count,
    };
    return (w, id);
}

fn ecs_h_world_ensure(w: EcsHWorldDeep, id: i64) -> EcsHWorldDeep {
    let f = ecs_h_world_get(w, id);
    if f.0 { return w; };
    return ecs_h_world_set(w, ecs_h_entity_new(id));
}

// insert ChildOf(child -> parent)
fn ecs_h_insert_child_of(w: EcsHWorldDeep, child: i64, parent: i64) -> EcsHWorldDeep {
    w = ecs_h_world_ensure(w, child);
    w = ecs_h_world_ensure(w, parent);
    // if already has parent, remove from old
    let cf = ecs_h_world_get(w, child);
    if cf.1.has_child_of && cf.1.parent != parent {
        w = ecs_h_remove_child_of(w, child);
        cf = ecs_h_world_get(w, child);
    };
    let ce = EcsHEntityDeep {
        id: cf.1.id, alive: cf.1.alive, has_child_of: true, parent: parent,
        has_children: cf.1.has_children, children: cf.1.children,
    };
    w = ecs_h_world_set(w, ce);
    let pf = ecs_h_world_get(w, parent);
    let kids = pf.1.children;
    if ecs_h_children_contains(kids, child) != true {
        kids = ecs_h_children_push(kids, child);
    };
    let pe = EcsHEntityDeep {
        id: pf.1.id, alive: pf.1.alive, has_child_of: pf.1.has_child_of, parent: pf.1.parent,
        has_children: true, children: kids,
    };
    return ecs_h_world_set(w, pe);
}

fn ecs_h_remove_child_of(w: EcsHWorldDeep, child: i64) -> EcsHWorldDeep {
    let cf = ecs_h_world_get(w, child);
    if cf.0 != true || cf.1.has_child_of != true { return w; };
    let parent = cf.1.parent;
    let ce = EcsHEntityDeep {
        id: cf.1.id, alive: cf.1.alive, has_child_of: false, parent: 0,
        has_children: cf.1.has_children, children: cf.1.children,
    };
    w = ecs_h_world_set(w, ce);
    let pf = ecs_h_world_get(w, parent);
    if pf.0 != true || pf.1.has_children != true { return w; };
    let kids = ecs_h_children_remove(pf.1.children, child);
    let empty = ecs_h_children_is_empty(kids);
    let pe = EcsHEntityDeep {
        id: pf.1.id, alive: pf.1.alive, has_child_of: pf.1.has_child_of, parent: pf.1.parent,
        has_children: empty != true, children: kids,
    };
    return ecs_h_world_set(w, pe);
}

fn ecs_h_add_child(w: EcsHWorldDeep, parent: i64, child: i64) -> EcsHWorldDeep {
    return ecs_h_insert_child_of(w, child, parent);
}

fn ecs_h_add_children2(w: EcsHWorldDeep, parent: i64, a: i64, b: i64) -> EcsHWorldDeep {
    w = ecs_h_add_child(w, parent, a);
    w = ecs_h_add_child(w, parent, b);
    return w;
}

fn ecs_h_insert_children(w: EcsHWorldDeep, parent: i64, index: i32, a: i64, b: i64, n: i32) -> EcsHWorldDeep {
    if n >= 1 {
        w = ecs_h_insert_child_of(w, a, parent);
        let pf = ecs_h_world_get(w, parent);
        let kids = ecs_h_children_remove(pf.1.children, a);
        kids = ecs_h_children_insert(kids, index, a);
        let pe = EcsHEntityDeep {
            id: pf.1.id, alive: pf.1.alive, has_child_of: pf.1.has_child_of, parent: pf.1.parent,
            has_children: true, children: kids,
        };
        w = ecs_h_world_set(w, pe);
    };
    if n >= 2 {
        w = ecs_h_insert_child_of(w, b, parent);
        let pf = ecs_h_world_get(w, parent);
        let kids = ecs_h_children_remove(pf.1.children, b);
        kids = ecs_h_children_insert(kids, index + 1, b);
        let pe = EcsHEntityDeep {
            id: pf.1.id, alive: pf.1.alive, has_child_of: pf.1.has_child_of, parent: pf.1.parent,
            has_children: true, children: kids,
        };
        w = ecs_h_world_set(w, pe);
    };
    return w;
}

fn ecs_h_remove_children2(w: EcsHWorldDeep, parent: i64, a: i64, b: i64) -> EcsHWorldDeep {
    // remove ChildOf if still pointing to parent
    let af = ecs_h_world_get(w, a);
    if af.0 && af.1.has_child_of && af.1.parent == parent {
        w = ecs_h_remove_child_of(w, a);
    };
    let bf = ecs_h_world_get(w, b);
    if bf.0 && bf.1.has_child_of && bf.1.parent == parent {
        w = ecs_h_remove_child_of(w, b);
    };
    return w;
}

// with_children: spawn N empty children under parent
fn ecs_h_with_children(w: EcsHWorldDeep, parent: i64, count: i32) -> EcsHWorldDeep {
    if count >= 1 {
        let r = ecs_h_world_spawn_empty(w);
        w = r.0;
        w = ecs_h_insert_child_of(w, r.1, parent);
    };
    if count >= 2 {
        let r = ecs_h_world_spawn_empty(w);
        w = r.0;
        w = ecs_h_insert_child_of(w, r.1, parent);
    };
    if count >= 3 {
        let r = ecs_h_world_spawn_empty(w);
        w = r.0;
        w = ecs_h_insert_child_of(w, r.1, parent);
    };
    return w;
}

// linked despawn of entity and descendants
fn ecs_h_despawn(w: EcsHWorldDeep, id: i64) -> EcsHWorldDeep {
    let f = ecs_h_world_get(w, id);
    if f.0 != true || f.1.alive != true { return w; };
    // capture children ids first
    let has_children = f.1.has_children;
    let c0 = f.1.children.c0;
    let c1 = f.1.children.c1;
    let c2 = f.1.children.c2;
    let c3 = f.1.children.c3;
    let clen = f.1.children.len;
    let parent = f.1.parent;
    let has_child_of = f.1.has_child_of;
    // remove from parent first
    if has_child_of {
        w = ecs_h_remove_child_of(w, id);
    };
    // despawn children recursively (linked_spawn)
    if has_children {
        if clen >= 1 { w = ecs_h_despawn(w, c0); };
        if clen >= 2 { w = ecs_h_despawn(w, c1); };
        if clen >= 3 { w = ecs_h_despawn(w, c2); };
        if clen >= 4 { w = ecs_h_despawn(w, c3); };
    };
    let ef = ecs_h_world_get(w, id);
    if ef.0 {
        let e = EcsHEntityDeep {
            id: ef.1.id, alive: false, has_child_of: false, parent: 0,
            has_children: false, children: ecs_h_children_new(),
        };
        w = ecs_h_world_set(w, e);
    };
    return EcsHWorldDeep {
        e0: w.e0, e1: w.e1, e2: w.e2, e3: w.e3, e4: w.e4, e5: w.e5, e6: w.e6, e7: w.e7,
        elen: w.elen, next_entity: w.next_entity, despawn_count: w.despawn_count + 1,
    };
}

fn ecs_h_parent_of(w: EcsHWorldDeep, id: i64) -> (bool, i64) {
    let f = ecs_h_world_get(w, id);
    if f.0 != true || f.1.has_child_of != true { return (false, 0); };
    return (true, f.1.parent);
}

fn ecs_h_children_of(w: EcsHWorldDeep, id: i64) -> EcsHChildrenDeep {
    let f = ecs_h_world_get(w, id);
    if f.0 != true || f.1.has_children != true { return ecs_h_children_new(); };
    return f.1.children;
}

fn ecs_h_alive(w: EcsHWorldDeep, id: i64) -> bool {
    let f = ecs_h_world_get(w, id);
    if f.0 != true { return false; };
    return f.1.alive;
}

// root_ancestor: walk parents until none
fn ecs_h_root_ancestor(w: EcsHWorldDeep, id: i64) -> i64 {
    let cur = id;
    let guard = 0;
    if guard < 8 {
        let p = ecs_h_parent_of(w, cur);
        if p.0 != true { return cur; };
        cur = p.1;
        guard = guard + 1;
    };
    if guard < 8 {
        let p = ecs_h_parent_of(w, cur);
        if p.0 != true { return cur; };
        cur = p.1;
        guard = guard + 1;
    };
    if guard < 8 {
        let p = ecs_h_parent_of(w, cur);
        if p.0 != true { return cur; };
        cur = p.1;
        guard = guard + 1;
    };
    if guard < 8 {
        let p = ecs_h_parent_of(w, cur);
        if p.0 != true { return cur; };
        cur = p.1;
    };
    return cur;
}

// count descendants BFS one level + their kids (depth 2)
fn ecs_h_descendant_count(w: EcsHWorldDeep, id: i64) -> i32 {
    let kids = ecs_h_children_of(w, id);
    let count = kids.len;
    if kids.len >= 1 { count = count + ecs_h_children_len(ecs_h_children_of(w, kids.c0)); };
    if kids.len >= 2 { count = count + ecs_h_children_len(ecs_h_children_of(w, kids.c1)); };
    if kids.len >= 3 { count = count + ecs_h_children_len(ecs_h_children_of(w, kids.c2)); };
    if kids.len >= 4 { count = count + ecs_h_children_len(ecs_h_children_of(w, kids.c3)); };
    return count;
}

fn ecs_h_sort_children(w: EcsHWorldDeep, parent: i64) -> EcsHWorldDeep {
    let pf = ecs_h_world_get(w, parent);
    if pf.0 != true || pf.1.has_children != true { return w; };
    let kids = ecs_h_children_sort_by_id(pf.1.children);
    let pe = EcsHEntityDeep {
        id: pf.1.id, alive: pf.1.alive, has_child_of: pf.1.has_child_of, parent: pf.1.parent,
        has_children: pf.1.has_children, children: kids,
    };
    return ecs_h_world_set(w, pe);
}

fn ecs_h_swap_children(w: EcsHWorldDeep, parent: i64, a: i32, b: i32) -> EcsHWorldDeep {
    let pf = ecs_h_world_get(w, parent);
    if pf.0 != true || pf.1.has_children != true { return w; };
    let kids = ecs_h_children_swap(pf.1.children, a, b);
    let pe = EcsHEntityDeep {
        id: pf.1.id, alive: pf.1.alive, has_child_of: pf.1.has_child_of, parent: pf.1.parent,
        has_children: pf.1.has_children, children: kids,
    };
    return ecs_h_world_set(w, pe);
}
