// Deepened Bevy ECS ComponentSparseSet + SparseSets extras.
// Mirrors src/storage/sparse_set.rs tick/change accessors.
// Fixed capacity: 8 entries. Shallow lib/sparse_set_extras.sla retained.

struct EcsSseDeep {
    drop_id: i32,
    e0: i32, v0: i64, a0: i32, c0: i32, b0: i32,
    e1: i32, v1: i64, a1: i32, c1: i32, b1: i32,
    e2: i32, v2: i64, a2: i32, c2: i32, b2: i32,
    e3: i32, v3: i64, a3: i32, c3: i32, b3: i32,
    e4: i32, v4: i64, a4: i32, c4: i32, b4: i32,
    e5: i32, v5: i64, a5: i32, c5: i32, b5: i32,
    e6: i32, v6: i64, a6: i32, c6: i32, b6: i32,
    e7: i32, v7: i64, a7: i32, c7: i32, b7: i32,
    len: i32,
}

fn ecs_sse_deep_new(drop_id: i32) -> EcsSseDeep {
    return EcsSseDeep {
        drop_id: drop_id,
        e0: -1, v0: 0, a0: 0, c0: 0, b0: 0,
        e1: -1, v1: 0, a1: 0, c1: 0, b1: 0,
        e2: -1, v2: 0, a2: 0, c2: 0, b2: 0,
        e3: -1, v3: 0, a3: 0, c3: 0, b3: 0,
        e4: -1, v4: 0, a4: 0, c4: 0, b4: 0,
        e5: -1, v5: 0, a5: 0, c5: 0, b5: 0,
        e6: -1, v6: 0, a6: 0, c6: 0, b6: 0,
        e7: -1, v7: 0, a7: 0, c7: 0, b7: 0,
        len: 0,
    };
}

fn ecs_sse_deep_len(s: EcsSseDeep) -> i32 { return s.len; }
fn ecs_sse_deep_is_empty(s: EcsSseDeep) -> bool { return s.len == 0; }
fn ecs_sse_deep_drop_id(s: EcsSseDeep) -> i32 { return s.drop_id; }

fn ecs_sse_deep_rebuild(
    drop_id: i32,
    e0: i32, v0: i64, a0: i32, c0: i32, b0: i32,
    e1: i32, v1: i64, a1: i32, c1: i32, b1: i32,
    e2: i32, v2: i64, a2: i32, c2: i32, b2: i32,
    e3: i32, v3: i64, a3: i32, c3: i32, b3: i32,
    e4: i32, v4: i64, a4: i32, c4: i32, b4: i32,
    e5: i32, v5: i64, a5: i32, c5: i32, b5: i32,
    e6: i32, v6: i64, a6: i32, c6: i32, b6: i32,
    e7: i32, v7: i64, a7: i32, c7: i32, b7: i32,
    len: i32
) -> EcsSseDeep {
    return EcsSseDeep {
        drop_id: drop_id,
        e0: e0, v0: v0, a0: a0, c0: c0, b0: b0,
        e1: e1, v1: v1, a1: a1, c1: c1, b1: b1,
        e2: e2, v2: v2, a2: a2, c2: c2, b2: b2,
        e3: e3, v3: v3, a3: a3, c3: c3, b3: b3,
        e4: e4, v4: v4, a4: a4, c4: c4, b4: b4,
        e5: e5, v5: v5, a5: a5, c5: c5, b5: b5,
        e6: e6, v6: v6, a6: a6, c6: c6, b6: b6,
        e7: e7, v7: v7, a7: a7, c7: c7, b7: b7,
        len: len,
    };
}

fn ecs_sse_deep_contains(s: EcsSseDeep, entity_index: i32) -> bool {
    if s.len >= 1 { if s.e0 == entity_index { return true; }; };
    if s.len >= 2 { if s.e1 == entity_index { return true; }; };
    if s.len >= 3 { if s.e2 == entity_index { return true; }; };
    if s.len >= 4 { if s.e3 == entity_index { return true; }; };
    if s.len >= 5 { if s.e4 == entity_index { return true; }; };
    if s.len >= 6 { if s.e5 == entity_index { return true; }; };
    if s.len >= 7 { if s.e6 == entity_index { return true; }; };
    if s.len >= 8 { if s.e7 == entity_index { return true; }; };
    return false;
}

fn ecs_sse_deep_insert(s: EcsSseDeep, entity_index: i32, value: i64, tick: i32, by: i32) -> EcsSseDeep {
    // overwrite if exists
    if s.len >= 1 { if s.e0 == entity_index { return ecs_sse_deep_rebuild(s.drop_id, s.e0, value, s.a0, tick, by, s.e1, s.v1, s.a1, s.c1, s.b1, s.e2, s.v2, s.a2, s.c2, s.b2, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, s.len); }; };
    if s.len >= 2 { if s.e1 == entity_index { return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, s.e1, value, s.a1, tick, by, s.e2, s.v2, s.a2, s.c2, s.b2, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, s.len); }; };
    if s.len == 0 { return ecs_sse_deep_rebuild(s.drop_id, entity_index, value, tick, tick, by, s.e1, s.v1, s.a1, s.c1, s.b1, s.e2, s.v2, s.a2, s.c2, s.b2, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, 1); };
    if s.len == 1 { return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, entity_index, value, tick, tick, by, s.e2, s.v2, s.a2, s.c2, s.b2, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, 2); };
    if s.len == 2 { return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, s.e1, s.v1, s.a1, s.c1, s.b1, entity_index, value, tick, tick, by, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, 3); };
    if s.len == 3 { return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, s.e1, s.v1, s.a1, s.c1, s.b1, s.e2, s.v2, s.a2, s.c2, s.b2, entity_index, value, tick, tick, by, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, 4); };
    return s;
}

struct EcsSseGetDeep {
    ok: bool,
    value: i64,
}

fn ecs_sse_get_ok(g: EcsSseGetDeep) -> bool { return g.ok; }
fn ecs_sse_get_value(g: EcsSseGetDeep) -> i64 { return g.value; }

fn ecs_sse_deep_get(s: EcsSseDeep, entity_index: i32) -> EcsSseGetDeep {
    if s.len >= 1 { if s.e0 == entity_index { return EcsSseGetDeep { ok: true, value: s.v0 }; }; };
    if s.len >= 2 { if s.e1 == entity_index { return EcsSseGetDeep { ok: true, value: s.v1 }; }; };
    if s.len >= 3 { if s.e2 == entity_index { return EcsSseGetDeep { ok: true, value: s.v2 }; }; };
    if s.len >= 4 { if s.e3 == entity_index { return EcsSseGetDeep { ok: true, value: s.v3 }; }; };
    return EcsSseGetDeep { ok: false, value: 0 };
}

struct EcsSseTicksDeep {
    ok: bool,
    added: i32,
    changed: i32,
    by: i32,
}

fn ecs_sse_ticks_ok(t: EcsSseTicksDeep) -> bool { return t.ok; }
fn ecs_sse_ticks_added(t: EcsSseTicksDeep) -> i32 { return t.added; }
fn ecs_sse_ticks_changed(t: EcsSseTicksDeep) -> i32 { return t.changed; }
fn ecs_sse_ticks_by(t: EcsSseTicksDeep) -> i32 { return t.by; }

fn ecs_sse_deep_ticks(s: EcsSseDeep, entity_index: i32) -> EcsSseTicksDeep {
    if s.len >= 1 { if s.e0 == entity_index { return EcsSseTicksDeep { ok: true, added: s.a0, changed: s.c0, by: s.b0 }; }; };
    if s.len >= 2 { if s.e1 == entity_index { return EcsSseTicksDeep { ok: true, added: s.a1, changed: s.c1, by: s.b1 }; }; };
    if s.len >= 3 { if s.e2 == entity_index { return EcsSseTicksDeep { ok: true, added: s.a2, changed: s.c2, by: s.b2 }; }; };
    if s.len >= 4 { if s.e3 == entity_index { return EcsSseTicksDeep { ok: true, added: s.a3, changed: s.c3, by: s.b3 }; }; };
    return EcsSseTicksDeep { ok: false, added: 0, changed: 0, by: 0 };
}

fn ecs_sse_deep_remove_slot(s: EcsSseDeep, idx: i32) -> EcsSseDeep {
    let last_e = -1;
    let last_v = 0;
    let last_a = 0;
    let last_c = 0;
    let last_b = 0;
    if s.len == 1 { last_e = s.e0; last_v = s.v0; last_a = s.a0; last_c = s.c0; last_b = s.b0; };
    if s.len == 2 { last_e = s.e1; last_v = s.v1; last_a = s.a1; last_c = s.c1; last_b = s.b1; };
    if s.len == 3 { last_e = s.e2; last_v = s.v2; last_a = s.a2; last_c = s.c2; last_b = s.b2; };
    if s.len == 4 { last_e = s.e3; last_v = s.v3; last_a = s.a3; last_c = s.c3; last_b = s.b3; };
    let nlen = s.len - 1;
    if idx == 0 {
        return ecs_sse_deep_rebuild(s.drop_id, last_e, last_v, last_a, last_c, last_b, s.e1, s.v1, s.a1, s.c1, s.b1, s.e2, s.v2, s.a2, s.c2, s.b2, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, nlen);
    };
    if idx == 1 {
        return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, last_e, last_v, last_a, last_c, last_b, s.e2, s.v2, s.a2, s.c2, s.b2, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, nlen);
    };
    if idx == 2 {
        return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, s.e1, s.v1, s.a1, s.c1, s.b1, last_e, last_v, last_a, last_c, last_b, s.e3, s.v3, s.a3, s.c3, s.b3, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, nlen);
    };
    return ecs_sse_deep_rebuild(s.drop_id, s.e0, s.v0, s.a0, s.c0, s.b0, s.e1, s.v1, s.a1, s.c1, s.b1, s.e2, s.v2, s.a2, s.c2, s.b2, last_e, last_v, last_a, last_c, last_b, s.e4, s.v4, s.a4, s.c4, s.b4, s.e5, s.v5, s.a5, s.c5, s.b5, s.e6, s.v6, s.a6, s.c6, s.b6, s.e7, s.v7, s.a7, s.c7, s.b7, nlen);
}

fn ecs_sse_deep_remove(s: EcsSseDeep, entity_index: i32) -> EcsSseDeep {
    if s.len >= 1 { if s.e0 == entity_index { return ecs_sse_deep_remove_slot(s, 0); }; };
    if s.len >= 2 { if s.e1 == entity_index { return ecs_sse_deep_remove_slot(s, 1); }; };
    if s.len >= 3 { if s.e2 == entity_index { return ecs_sse_deep_remove_slot(s, 2); }; };
    if s.len >= 4 { if s.e3 == entity_index { return ecs_sse_deep_remove_slot(s, 3); }; };
    return s;
}

fn ecs_sse_deep_clear(s: EcsSseDeep) -> EcsSseDeep {
    return ecs_sse_deep_new(s.drop_id);
}

// SparseSets collection: map component_id -> sparse set drop id proxy, 4 slots
struct EcsSsesDeep {
    k0: i32, d0: i32,
    k1: i32, d1: i32,
    k2: i32, d2: i32,
    k3: i32, d3: i32,
    len: i32,
}

fn ecs_sses_deep_new() -> EcsSsesDeep {
    return EcsSsesDeep { k0: -1, d0: 0, k1: -1, d1: 0, k2: -1, d2: 0, k3: -1, d3: 0, len: 0 };
}

fn ecs_sses_deep_len(s: EcsSsesDeep) -> i32 { return s.len; }

fn ecs_sses_deep_register(s: EcsSsesDeep, component_id: i32, drop_id: i32) -> EcsSsesDeep {
    if s.len >= 1 { if s.k0 == component_id { return EcsSsesDeep { k0: s.k0, d0: drop_id, k1: s.k1, d1: s.d1, k2: s.k2, d2: s.d2, k3: s.k3, d3: s.d3, len: s.len }; }; };
    if s.len >= 2 { if s.k1 == component_id { return EcsSsesDeep { k0: s.k0, d0: s.d0, k1: s.k1, d1: drop_id, k2: s.k2, d2: s.d2, k3: s.k3, d3: s.d3, len: s.len }; }; };
    if s.len == 0 { return EcsSsesDeep { k0: component_id, d0: drop_id, k1: s.k1, d1: s.d1, k2: s.k2, d2: s.d2, k3: s.k3, d3: s.d3, len: 1 }; };
    if s.len == 1 { return EcsSsesDeep { k0: s.k0, d0: s.d0, k1: component_id, d1: drop_id, k2: s.k2, d2: s.d2, k3: s.k3, d3: s.d3, len: 2 }; };
    if s.len == 2 { return EcsSsesDeep { k0: s.k0, d0: s.d0, k1: s.k1, d1: s.d1, k2: component_id, d2: drop_id, k3: s.k3, d3: s.d3, len: 3 }; };
    if s.len == 3 { return EcsSsesDeep { k0: s.k0, d0: s.d0, k1: s.k1, d1: s.d1, k2: s.k2, d2: s.d2, k3: component_id, d3: drop_id, len: 4 }; };
    return s;
}

fn ecs_sses_deep_get_drop(s: EcsSsesDeep, component_id: i32) -> i32 {
    if s.len >= 1 { if s.k0 == component_id { return s.d0; }; };
    if s.len >= 2 { if s.k1 == component_id { return s.d1; }; };
    if s.len >= 3 { if s.k2 == component_id { return s.d2; }; };
    if s.len >= 4 { if s.k3 == component_id { return s.d3; }; };
    return -1;
}
