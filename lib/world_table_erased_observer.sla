    let triple_with_marker = table_erased_observer_world_query_triple_with_auto<TableErasedPos, TableErasedVel, TableErasedMarker, TableErasedTime, TableErasedEvent>(filter13, TABLE_ERASED_POS_TYPE, TABLE_ERASED_VEL_TYPE, TABLE_ERASED_MARKER_TYPE, TABLE_ERASED_MARKER_TYPE);
    if len(triple_with_marker.items) != 1 { panic(14943); };
    let triple_without_missing = table_erased_observer_world_query_triple_without<TableErasedPos, TableErasedVel, TableErasedMarker, TableErasedTime, TableErasedEvent>(filter13, filter_position.id, TABLE_ERASED_POS_TYPE, filter_velocity.id, TABLE_ERASED_VEL_TYPE, filter_marker.id, TABLE_ERASED_MARKER_TYPE, 987654);
