// TableErasedWorld integrated with erased observers.
// Observer/event semantics live in sla_ecs data, not in the Sla compiler.
@import "world_table_erased.sla"
@import "event_observer_erased.sla"

const TABLE_ERASED_LIFECYCLE_EVENT_TYPE: i32 = 141001;
const TABLE_ERASED_LIFECYCLE_ADD: i32 = 1;
const TABLE_ERASED_LIFECYCLE_INSERT: i32 = 2;
const TABLE_ERASED_LIFECYCLE_REPLACE: i32 = 3;
const TABLE_ERASED_LIFECYCLE_REMOVE: i32 = 4;
const TABLE_ERASED_LIFECYCLE_DESPAWN: i32 = 5;

struct TableErasedObserverWorld<R, M> {
    table: TableErasedWorld<R, M>,
    observers: ErasedObservers,
}

@derive(Event)
struct TableErasedLifecycleEvent {
    kind: i32,
    entity_id: i32,
    component_id: i32,
    type_id: i32,
}

impl TableErasedLifecycleEvent {
    fn event_type_id() -> i32 { return TABLE_ERASED_LIFECYCLE_EVENT_TYPE; }
}

fn table_erased_observer_world_new<R, M>(default_r: R, default_m: M) -> TableErasedObserverWorld<R, M> {
    return TableErasedObserverWorld<R, M> { table: table_erased_world_new<R, M>(default_r, default_m), observers: erased_observers_new() };
}

fn table_erased_observer_world_add_observer<R, M>(world: TableErasedObserverWorld<R, M>, type_id: i32, run: fn(ErasedEventValue, i32) -> i32) -> TableErasedObserverWorld<R, M> {
    world.observers = erased_observers_add(world.observers, erased_observer_new(type_id, run));
    return world;
}

fn table_erased_observer_world_register_table<R, M>(world: TableErasedObserverWorld<R, M>, type_id: i32, drop_fn: fn(*u8) -> void) -> (TableErasedObserverWorld<R, M>, ComponentInfo) {
    let (table, info) = table_erased_world_register_table<R, M>(world.table, type_id, drop_fn);
    world.table = table;
    return (world, info);
}

fn table_erased_observer_world_register_sparse_set<R, M>(world: TableErasedObserverWorld<R, M>, type_id: i32, drop_fn: fn(*u8) -> void) -> (TableErasedObserverWorld<R, M>, ComponentInfo) {
    let (table, info) = table_erased_world_register_sparse_set<R, M>(world.table, type_id, drop_fn);
    world.table = table;
    return (world, info);
}

fn table_erased_observer_world_register_disabling_component<R, M>(world: TableErasedObserverWorld<R, M>, component_id: i32) -> TableErasedObserverWorld<R, M> {
    world.table = table_erased_world_register_disabling_component<R, M>(world.table, component_id);
    return world;
}

fn table_erased_observer_world_register_default_query_filter<R, M>(world: TableErasedObserverWorld<R, M>, component_id: i32) -> TableErasedObserverWorld<R, M> {
    world.table = table_erased_world_register_default_query_filter<R, M>(world.table, component_id);
    return world;
}

fn table_erased_observer_world_default_query_filter_count<R, M>(world: TableErasedObserverWorld<R, M>) -> i64 {
    return table_erased_world_default_query_filter_count<R, M>(world.table);
}

fn table_erased_observer_world_default_query_filter_at<R, M>(world: TableErasedObserverWorld<R, M>, index: i64) -> i32 {
    return table_erased_world_default_query_filter_at<R, M>(world.table, index);
}

fn table_erased_observer_world_clear_default_query_filters<R, M>(world: TableErasedObserverWorld<R, M>) -> TableErasedObserverWorld<R, M> {
    world.table = table_erased_world_clear_default_query_filters<R, M>(world.table);
    return world;
}

fn table_erased_observer_world_register_disabling_component_auto<R, M>(world: TableErasedObserverWorld<R, M>, type_id: i32) -> TableErasedObserverWorld<R, M> {
    world.table = table_erased_world_register_disabling_component_auto<R, M>(world.table, type_id);
    return world;
}

fn table_erased_observer_world_query_entities<R, M>(world: TableErasedObserverWorld<R, M>) -> Query<Entity> { return table_erased_world_query_entities<R, M>(world.table); }
fn table_erased_observer_world_query<T, R, M>(world: TableErasedObserverWorld<R, M>, component_id: i32, type_id: i32) -> Query<EntityItem<T>> { return table_erased_world_query<T, R, M>(world.table, component_id, type_id); }
fn table_erased_observer_world_query_with_access<T, R, M>(world: TableErasedObserverWorld<R, M>, component_id: i32, type_id: i32, access_component_ids: Vec<i32>) -> Query<EntityItem<T>> { return table_erased_world_query_with_access<T, R, M>(world.table, component_id, type_id, access_component_ids); }
