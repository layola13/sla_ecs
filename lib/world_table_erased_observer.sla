fn table_erased_lifecycle_score(value: ErasedEventValue, target_entity_id: i32) -> i32 {
    let event = erased_event_value_read<TableErasedLifecycleEvent>(value, TableErasedLifecycleEvent::event_type_id());
    return event.kind + event.component_id + target_entity_id;
}

fn table_erased_observer_test_world_new() -> TableErasedObserverWorld<TableErasedTime, TableErasedEvent> {
    return table_erased_observer_world_new<TableErasedTime, TableErasedEvent>(table_erased_time_default(), table_erased_event_default());
}

@derive(Event)
struct TableErasedObserverPing { amount: i32 }

impl TableErasedObserverPing {
    fn event_type_id() -> i32 { return 141101; }
}

fn table_erased_observer_ping_score(value: ErasedEventValue, target_entity_id: i32) -> i32 {
    let event = erased_event_value_read<TableErasedObserverPing>(value, TableErasedObserverPing::event_type_id());
    if target_entity_id >= 0 { return event.amount + target_entity_id; };
    return event.amount;
}

@test "table erased observer world exposes message reader cursor helpers"() {
    let raw = table_erased_observer_test_world_new();
    let w0 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(raw, TableErasedLifecycleEvent::event_type_id(), table_erased_lifecycle_score);
    let w_tick = table_erased_observer_world_increment_tick<TableErasedTime, TableErasedEvent>(w0);
    let w_res = table_erased_observer_world_insert_resource<TableErasedTime, TableErasedEvent>(w_tick, TableErasedTime { tick: 9 });
    if table_erased_observer_world_has_resource<TableErasedTime, TableErasedEvent>(w_res) != true { panic(14206); };
    if table_erased_observer_world_get_resource<TableErasedTime, TableErasedEvent>(w_res).tick != 9 { panic(14207); };
    if table_erased_observer_world_resource_added_since<TableErasedTime, TableErasedEvent>(w_res, 0) != true { panic(14208); };
    let res = table_erased_observer_world_res<TableErasedTime, TableErasedEvent>(w_res);
    if res.value.tick != 9 { panic(14209); };
    let res_mut = table_erased_observer_world_res_mut<TableErasedTime, TableErasedEvent>(w_res);
    let w_res_written = table_erased_observer_world_res_mut_write<TableErasedTime, TableErasedEvent>(w_res, res_mut, TableErasedTime { tick: 10 });
    if table_erased_observer_world_resource_changed_since<TableErasedTime, TableErasedEvent>(w_res_written, 0) != true { panic(14210); };
