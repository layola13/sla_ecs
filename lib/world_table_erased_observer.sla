@test "table erased observer world triggers add insert replace remove despawn"() {
    let w0 = table_erased_observer_test_world_new();
    let w1 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(w0, TableErasedLifecycleEvent::event_type_id(), table_erased_lifecycle_score);
    let (w2, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w3, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w2);
    let w4 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w3, entity, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 3, y: 0 });
    if w4.observers.trigger_count != 2 { panic(14110); };
    if w4.observers.last_entity_id != entity.id { panic(14111); };
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w4, entity, position.id, TABLE_ERASED_POS_TYPE).x != 3 { panic(14112); };
    let w5 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w4, entity, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 8, y: 0 });
    if w5.observers.trigger_count != 4 { panic(14113); };
    if table_erased_observer_world_get<TableErasedPos, TableErasedTime, TableErasedEvent>(w5, entity, position.id, TABLE_ERASED_POS_TYPE).x != 8 { panic(14114); };
    let w6 = table_erased_observer_world_remove<TableErasedTime, TableErasedEvent>(w5, entity, position.id);
    if w6.observers.trigger_count != 5 { panic(14115); };
    if table_erased_world_has<TableErasedTime, TableErasedEvent>(w6.table, entity, position.id) != false { panic(14116); };
    let w7 = table_erased_observer_world_despawn<TableErasedTime, TableErasedEvent>(w6, entity);
    if w7.observers.trigger_count != 6 { panic(14117); };
    if table_erased_world_is_alive<TableErasedTime, TableErasedEvent>(w7.table, entity) != false { panic(14118); };
}

@test "table erased observer world triggers component removes before despawn"() {
    let w0 = table_erased_observer_test_world_new();
    let w1 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(w0, TableErasedLifecycleEvent::event_type_id(), table_erased_lifecycle_score);
    let (w2, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w3, velocity) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w2, TABLE_ERASED_VEL_TYPE, ecs_box_drop<TableErasedVel>);
    let (w4, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w3);
    let w5 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w4, entity, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 2, y: 0 });
    let w6 = table_erased_observer_world_insert<TableErasedVel, TableErasedTime, TableErasedEvent>(w5, entity, velocity.id, TABLE_ERASED_VEL_TYPE, TableErasedVel { x: 5, y: 0 });
    let before = w6.observers.trigger_count;
    let w7 = table_erased_observer_world_despawn<TableErasedTime, TableErasedEvent>(w6, entity);
    if w7.observers.trigger_count != before + 3 { panic(14120); };
    if w7.observers.last_entity_id != entity.id { panic(14121); };
    if table_erased_world_has<TableErasedTime, TableErasedEvent>(w7.table, entity, position.id) != false { panic(14122); };
    if table_erased_world_has<TableErasedTime, TableErasedEvent>(w7.table, entity, velocity.id) != false { panic(14123); };
}

@test "table erased observer world delegates removed components"() {
    let w0 = table_erased_observer_test_world_new();
    let w1 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(w0, TableErasedLifecycleEvent::event_type_id(), table_erased_lifecycle_score);
    let (w2, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w3, marker) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w2, TABLE_ERASED_MARKER_TYPE, ecs_box_drop<TableErasedMarker>);
    let (w4, e1) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w3);
    let (w5, e2) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w4);
    let w6 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w5, e1, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 1, y: 0 });
    let w7 = table_erased_observer_world_insert<TableErasedMarker, TableErasedTime, TableErasedEvent>(w6, e1, marker.id, TABLE_ERASED_MARKER_TYPE, TableErasedMarker { value: 9 });
    let w8 = table_erased_observer_world_insert<TableErasedPos, TableErasedTime, TableErasedEvent>(w7, e2, position.id, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 2, y: 0 });

    let remove_since = w8.table.registry.change_tick;
    let w9 = table_erased_observer_world_increment_tick<TableErasedTime, TableErasedEvent>(w8);
    let before_remove = w9.observers.trigger_count;
    let w10 = table_erased_observer_world_remove_auto<TableErasedTime, TableErasedEvent>(w9, e1, TABLE_ERASED_MARKER_TYPE);
    if w10.observers.trigger_count != before_remove + 1 { panic(15010); };
    let sidecar_before_removed_queries = w10.observers.trigger_count;
    let marker_removed = table_erased_observer_world_removed_components_auto<TableErasedTime, TableErasedEvent>(w10, TABLE_ERASED_MARKER_TYPE, remove_since);
    if len(marker_removed.items) != 1 { panic(15011); };
    if marker_removed.items[0].id != e1.id { panic(15012); };
    let marker_current = table_erased_observer_world_removed_components<TableErasedTime, TableErasedEvent>(w10, marker.id, w10.table.registry.change_tick);
    if len(marker_current.items) != 0 { panic(15013); };
    if w10.observers.trigger_count != sidecar_before_removed_queries { panic(15014); };

    let w11 = table_erased_observer_world_clear_removed_components<TableErasedTime, TableErasedEvent>(w10);
    if w11.observers.trigger_count != sidecar_before_removed_queries { panic(15015); };
    let marker_after_clear = table_erased_observer_world_removed_components_auto<TableErasedTime, TableErasedEvent>(w11, TABLE_ERASED_MARKER_TYPE, 0);
    if len(marker_after_clear.items) != 0 { panic(15016); };

    let despawn_since = w11.table.registry.change_tick;
    let w12 = table_erased_observer_world_increment_tick<TableErasedTime, TableErasedEvent>(w11);
    let before_despawn = w12.observers.trigger_count;
    let w13 = table_erased_observer_world_despawn<TableErasedTime, TableErasedEvent>(w12, e2);
    if w13.observers.trigger_count != before_despawn + 2 { panic(15017); };
    let pos_removed = table_erased_observer_world_removed_components<TableErasedTime, TableErasedEvent>(w13, position.id, despawn_since);
    if len(pos_removed.items) != 1 { panic(15018); };
    if pos_removed.items[0].id != e2.id { panic(15019); };
    let marker_removed_after_despawn = table_erased_observer_world_removed_components_auto<TableErasedTime, TableErasedEvent>(w13, TABLE_ERASED_MARKER_TYPE, despawn_since);
    if len(marker_removed_after_despawn.items) != 0 { panic(15020); };
}

@test "table erased observer world delegates direct component access"() {
    let w0 = table_erased_observer_test_world_new();
    let w1 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(w0, TableErasedLifecycleEvent::event_type_id(), table_erased_lifecycle_score);
    let (w2, position) = table_erased_observer_world_register_table<TableErasedTime, TableErasedEvent>(w1, TABLE_ERASED_POS_TYPE, ecs_box_drop<TableErasedPos>);
    let (w3, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w2);
    if table_erased_observer_world_is_alive<TableErasedTime, TableErasedEvent>(w3, entity) != true { panic(15030); };
    let w4 = table_erased_observer_world_insert_auto<TableErasedPos, TableErasedTime, TableErasedEvent>(w3, entity, TABLE_ERASED_POS_TYPE, TableErasedPos { x: 21, y: 2 });
    let before_direct = w4.observers.trigger_count;
    if table_erased_observer_world_has<TableErasedTime, TableErasedEvent>(w4, entity, position.id) != true { panic(15031); };
    if table_erased_observer_world_has_type<TableErasedTime, TableErasedEvent>(w4, entity, TABLE_ERASED_POS_TYPE) != true { panic(15032); };
    let pos = table_erased_observer_world_get_auto<TableErasedPos, TableErasedTime, TableErasedEvent>(w4, entity, TABLE_ERASED_POS_TYPE);
    if pos.x != 21 { panic(15033); };
    if pos.y != 2 { panic(15034); };
    if w4.observers.trigger_count != before_direct { panic(15035); };
    let w5 = table_erased_observer_world_remove_auto<TableErasedTime, TableErasedEvent>(w4, entity, TABLE_ERASED_POS_TYPE);
    if table_erased_observer_world_has_type<TableErasedTime, TableErasedEvent>(w5, entity, TABLE_ERASED_POS_TYPE) { panic(15036); };
    let w6 = table_erased_observer_world_despawn<TableErasedTime, TableErasedEvent>(w5, entity);
    if table_erased_observer_world_is_alive<TableErasedTime, TableErasedEvent>(w6, entity) { panic(15037); };
}

@test "table erased observer world supports explicit targeted events"() {
    let w0 = table_erased_observer_test_world_new();
    let w1 = table_erased_observer_world_add_observer<TableErasedTime, TableErasedEvent>(w0, TableErasedObserverPing::event_type_id(), table_erased_observer_ping_score);
    let (w2, entity) = table_erased_observer_world_spawn<TableErasedTime, TableErasedEvent>(w1);
    let w3 = table_erased_observer_world_trigger_entity<TableErasedObserverPing, TableErasedTime, TableErasedEvent>(w2, entity, TableErasedObserverPing::event_type_id(), ecs_box_drop<TableErasedObserverPing>, TableErasedObserverPing { amount: 4 });
    if w3.observers.trigger_count != 1 { panic(14130); };
    if w3.observers.last_entity_id != entity.id { panic(14131); };
    if w3.observers.result_sum != entity.id + 4 { panic(14132); };
}
