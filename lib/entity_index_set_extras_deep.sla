// Deepened Bevy ECS EntityIndexSet ordered extras.
// Mirrors src/entity/index_set.rs insert/contains/index/range/iter/set ops.
// Fixed capacity: 8 ordered values. Shallow lib/entity_index_set_extras.sla retained.

struct EcsEisDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
}

fn ecs_eis_deep_new() -> EcsEisDeep {
    return EcsEisDeep { e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0, len: 0 };
}

fn ecs_eis_deep_len(s: EcsEisDeep) -> i32 { return s.len; }
fn ecs_eis_deep_is_empty(s: EcsEisDeep) -> bool { return s.len == 0; }

fn ecs_eis_deep_rebuild(e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64, len: i32) -> EcsEisDeep {
    return EcsEisDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7, len: len };
}

fn ecs_eis_deep_contains(s: EcsEisDeep, value: i64) -> bool {
    if s.len >= 1 { if s.e0 == value { return true; }; };
    if s.len >= 2 { if s.e1 == value { return true; }; };
    if s.len >= 3 { if s.e2 == value { return true; }; };
    if s.len >= 4 { if s.e3 == value { return true; }; };
    if s.len >= 5 { if s.e4 == value { return true; }; };
    if s.len >= 6 { if s.e5 == value { return true; }; };
    if s.len >= 7 { if s.e6 == value { return true; }; };
    if s.len >= 8 { if s.e7 == value { return true; }; };
    return false;
}

fn ecs_eis_deep_insert(s: EcsEisDeep, value: i64) -> EcsEisDeep {
    if ecs_eis_deep_contains(s, value) { return s; };
    if s.len == 0 { return ecs_eis_deep_rebuild(value, 0, 0, 0, 0, 0, 0, 0, 1); };
    if s.len == 1 { return ecs_eis_deep_rebuild(s.e0, value, 0, 0, 0, 0, 0, 0, 2); };
    if s.len == 2 { return ecs_eis_deep_rebuild(s.e0, s.e1, value, 0, 0, 0, 0, 0, 3); };
    if s.len == 3 { return ecs_eis_deep_rebuild(s.e0, s.e1, s.e2, value, 0, 0, 0, 0, 4); };
    if s.len == 4 { return ecs_eis_deep_rebuild(s.e0, s.e1, s.e2, s.e3, value, 0, 0, 0, 5); };
    if s.len == 5 { return ecs_eis_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, value, 0, 0, 6); };
    if s.len == 6 { return ecs_eis_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, value, 0, 7); };
    if s.len == 7 { return ecs_eis_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, value, 8); };
    return s;
}

fn ecs_eis_deep_at(s: EcsEisDeep, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return -1;
}

// range [start, end) into slice of up to 4
struct EcsEisSliceDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    len: i32,
}

fn ecs_eis_deep_get_range(s: EcsEisDeep, start: i32, end: i32) -> EcsEisSliceDeep {
    if start < 0 { return EcsEisSliceDeep { e0: 0, e1: 0, e2: 0, e3: 0, len: 0 }; };
    if end > s.len { return EcsEisSliceDeep { e0: 0, e1: 0, e2: 0, e3: 0, len: 0 }; };
    if start >= end { return EcsEisSliceDeep { e0: 0, e1: 0, e2: 0, e3: 0, len: 0 }; };
    let n = end - start;
    if n > 4 { n = 4; };
    let e0 = ecs_eis_deep_at(s, start);
    let e1 = 0;
    let e2 = 0;
    let e3 = 0;
    if n >= 2 { e1 = ecs_eis_deep_at(s, start + 1); };
    if n >= 3 { e2 = ecs_eis_deep_at(s, start + 2); };
    if n >= 4 { e3 = ecs_eis_deep_at(s, start + 3); };
    return EcsEisSliceDeep { e0: e0, e1: e1, e2: e2, e3: e3, len: n };
}

fn ecs_eis_slice_len(sl: EcsEisSliceDeep) -> i32 { return sl.len; }
fn ecs_eis_slice_at(sl: EcsEisSliceDeep, idx: i32) -> i64 {
    if idx == 0 { return sl.e0; };
    if idx == 1 { return sl.e1; };
    if idx == 2 { return sl.e2; };
    if idx == 3 { return sl.e3; };
    return -1;
}

fn ecs_eis_deep_union(a: EcsEisDeep, b: EcsEisDeep) -> EcsEisDeep {
    let out = a;
    if b.len >= 1 { out = ecs_eis_deep_insert(out, b.e0); };
    if b.len >= 2 { out = ecs_eis_deep_insert(out, b.e1); };
    if b.len >= 3 { out = ecs_eis_deep_insert(out, b.e2); };
    if b.len >= 4 { out = ecs_eis_deep_insert(out, b.e3); };
    if b.len >= 5 { out = ecs_eis_deep_insert(out, b.e4); };
    if b.len >= 6 { out = ecs_eis_deep_insert(out, b.e5); };
    if b.len >= 7 { out = ecs_eis_deep_insert(out, b.e6); };
    if b.len >= 8 { out = ecs_eis_deep_insert(out, b.e7); };
    return out;
}

fn ecs_eis_deep_intersection(a: EcsEisDeep, b: EcsEisDeep) -> EcsEisDeep {
    let out = ecs_eis_deep_new();
    if a.len >= 1 { if ecs_eis_deep_contains(b, a.e0) { out = ecs_eis_deep_insert(out, a.e0); }; };
    if a.len >= 2 { if ecs_eis_deep_contains(b, a.e1) { out = ecs_eis_deep_insert(out, a.e1); }; };
    if a.len >= 3 { if ecs_eis_deep_contains(b, a.e2) { out = ecs_eis_deep_insert(out, a.e2); }; };
    if a.len >= 4 { if ecs_eis_deep_contains(b, a.e3) { out = ecs_eis_deep_insert(out, a.e3); }; };
    if a.len >= 5 { if ecs_eis_deep_contains(b, a.e4) { out = ecs_eis_deep_insert(out, a.e4); }; };
    if a.len >= 6 { if ecs_eis_deep_contains(b, a.e5) { out = ecs_eis_deep_insert(out, a.e5); }; };
    if a.len >= 7 { if ecs_eis_deep_contains(b, a.e6) { out = ecs_eis_deep_insert(out, a.e6); }; };
    if a.len >= 8 { if ecs_eis_deep_contains(b, a.e7) { out = ecs_eis_deep_insert(out, a.e7); }; };
    return out;
}

fn ecs_eis_deep_difference(a: EcsEisDeep, b: EcsEisDeep) -> EcsEisDeep {
    let out = ecs_eis_deep_new();
    if a.len >= 1 { if ecs_eis_deep_contains(b, a.e0) != true { out = ecs_eis_deep_insert(out, a.e0); }; };
    if a.len >= 2 { if ecs_eis_deep_contains(b, a.e1) != true { out = ecs_eis_deep_insert(out, a.e1); }; };
    if a.len >= 3 { if ecs_eis_deep_contains(b, a.e2) != true { out = ecs_eis_deep_insert(out, a.e2); }; };
    if a.len >= 4 { if ecs_eis_deep_contains(b, a.e3) != true { out = ecs_eis_deep_insert(out, a.e3); }; };
    if a.len >= 5 { if ecs_eis_deep_contains(b, a.e4) != true { out = ecs_eis_deep_insert(out, a.e4); }; };
    if a.len >= 6 { if ecs_eis_deep_contains(b, a.e5) != true { out = ecs_eis_deep_insert(out, a.e5); }; };
    if a.len >= 7 { if ecs_eis_deep_contains(b, a.e6) != true { out = ecs_eis_deep_insert(out, a.e6); }; };
    if a.len >= 8 { if ecs_eis_deep_contains(b, a.e7) != true { out = ecs_eis_deep_insert(out, a.e7); }; };
    return out;
}

fn ecs_eis_deep_is_subset(a: EcsEisDeep, b: EcsEisDeep) -> bool {
    if a.len >= 1 { if ecs_eis_deep_contains(b, a.e0) != true { return false; }; };
    if a.len >= 2 { if ecs_eis_deep_contains(b, a.e1) != true { return false; }; };
    if a.len >= 3 { if ecs_eis_deep_contains(b, a.e2) != true { return false; }; };
    if a.len >= 4 { if ecs_eis_deep_contains(b, a.e3) != true { return false; }; };
    if a.len >= 5 { if ecs_eis_deep_contains(b, a.e4) != true { return false; }; };
    if a.len >= 6 { if ecs_eis_deep_contains(b, a.e5) != true { return false; }; };
    if a.len >= 7 { if ecs_eis_deep_contains(b, a.e6) != true { return false; }; };
    if a.len >= 8 { if ecs_eis_deep_contains(b, a.e7) != true { return false; }; };
    return true;
}

// double-ended iter
struct EcsEisIterDeep {
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    front: i32,
    back: i32,
}

fn ecs_eis_deep_iter(s: EcsEisDeep) -> EcsEisIterDeep {
    return EcsEisIterDeep {
        e0: s.e0, e1: s.e1, e2: s.e2, e3: s.e3, e4: s.e4, e5: s.e5, e6: s.e6, e7: s.e7,
        len: s.len, front: 0, back: s.len,
    };
}

fn ecs_eis_iter_remaining(i: EcsEisIterDeep) -> i32 { return i.back - i.front; }

struct EcsEisNextDeep {
    iter: EcsEisIterDeep,
    has: bool,
    value: i64,
}

fn ecs_eis_next_has(n: EcsEisNextDeep) -> bool { return n.has; }
fn ecs_eis_next_value(n: EcsEisNextDeep) -> i64 { return n.value; }
fn ecs_eis_next_iter(n: EcsEisNextDeep) -> EcsEisIterDeep { return n.iter; }

fn ecs_eis_iter_next(i: EcsEisIterDeep) -> EcsEisNextDeep {
    if i.front >= i.back {
        return EcsEisNextDeep { iter: i, has: false, value: -1 };
    };
    let value = ecs_eis_deep_at(ecs_eis_deep_rebuild(i.e0, i.e1, i.e2, i.e3, i.e4, i.e5, i.e6, i.e7, i.len), i.front);
    let i2 = EcsEisIterDeep {
        e0: i.e0, e1: i.e1, e2: i.e2, e3: i.e3, e4: i.e4, e5: i.e5, e6: i.e6, e7: i.e7,
        len: i.len, front: i.front + 1, back: i.back,
    };
    return EcsEisNextDeep { iter: i2, has: true, value: value };
}

fn ecs_eis_iter_next_back(i: EcsEisIterDeep) -> EcsEisNextDeep {
    if i.front >= i.back {
        return EcsEisNextDeep { iter: i, has: false, value: -1 };
    };
    let idx = i.back - 1;
    let value = ecs_eis_deep_at(ecs_eis_deep_rebuild(i.e0, i.e1, i.e2, i.e3, i.e4, i.e5, i.e6, i.e7, i.len), idx);
    let i2 = EcsEisIterDeep {
        e0: i.e0, e1: i.e1, e2: i.e2, e3: i.e3, e4: i.e4, e5: i.e5, e6: i.e6, e7: i.e7,
        len: i.len, front: i.front, back: idx,
    };
    return EcsEisNextDeep { iter: i2, has: true, value: value };
}

fn ecs_eis_deep_clear(s: EcsEisDeep) -> EcsEisDeep {
    return ecs_eis_deep_new();
}
