// Deepened Bevy-style schedule conflict analyzer for dynamic-world systems
// (lib/schedule_dynamic.sla deep). Deep variant records cap-8 system access
// records (reads/writes per resource kind) without retaining fn pointers.
// Operations:
//   dynamic_system_access_none/all/with, dynamic_access_conflicts,
//   schedule_default, schedule_add_systems (records conflict_count against
//   all previous systems), schedule_conflict_count, schedule_len,
//   schedule_system_access_at (introspection), schedule_clear.

const ECS_SCHED_DYN_CAP_DEEP: i32 = 8;

struct EcsDynSystemAccessDeep {
    reads_a: i32,
    writes_a: i32,
    reads_b: i32,
    writes_b: i32,
    reads_resource: i32,
    writes_resource: i32,
    reads_messages: i32,
    writes_messages: i32,
}

fn ecs_dynamic_system_access_none() -> EcsDynSystemAccessDeep {
    return EcsDynSystemAccessDeep {
        reads_a: 0, writes_a: 0,
        reads_b: 0, writes_b: 0,
        reads_resource: 0, writes_resource: 0,
        reads_messages: 0, writes_messages: 0,
    };
}

fn ecs_dynamic_system_access_all() -> EcsDynSystemAccessDeep {
    return EcsDynSystemAccessDeep {
        reads_a: 1, writes_a: 1,
        reads_b: 1, writes_b: 1,
        reads_resource: 1, writes_resource: 1,
        reads_messages: 1, writes_messages: 1,
    };
}

fn ecs_dynamic_system_access(
    reads_a: i32, writes_a: i32,
    reads_b: i32, writes_b: i32,
    reads_resource: i32, writes_resource: i32,
    reads_messages: i32, writes_messages: i32
) -> EcsDynSystemAccessDeep {
    return EcsDynSystemAccessDeep {
        reads_a: reads_a, writes_a: writes_a,
        reads_b: reads_b, writes_b: writes_b,
        reads_resource: reads_resource, writes_resource: writes_resource,
        reads_messages: reads_messages, writes_messages: writes_messages,
    };
}

fn ecs_dyn_access_reads_a(a: EcsDynSystemAccessDeep) -> i32 { return a.reads_a; }
fn ecs_dyn_access_writes_a(a: EcsDynSystemAccessDeep) -> i32 { return a.writes_a; }
fn ecs_dyn_access_reads_b(a: EcsDynSystemAccessDeep) -> i32 { return a.reads_b; }
fn ecs_dyn_access_writes_b(a: EcsDynSystemAccessDeep) -> i32 { return a.writes_b; }
fn ecs_dyn_access_reads_resource(a: EcsDynSystemAccessDeep) -> i32 { return a.reads_resource; }
fn ecs_dyn_access_writes_resource(a: EcsDynSystemAccessDeep) -> i32 { return a.writes_resource; }
fn ecs_dyn_access_reads_messages(a: EcsDynSystemAccessDeep) -> i32 { return a.reads_messages; }
fn ecs_dyn_access_writes_messages(a: EcsDynSystemAccessDeep) -> i32 { return a.writes_messages; }

// conflict: write/any or read+write on the same resource kind constitute a conflict (Hazard pattern).
fn ecs_dynamic_access_conflicts(left: EcsDynSystemAccessDeep, right: EcsDynSystemAccessDeep) -> bool {
    if left.writes_a != 0 {
        if right.reads_a != 0 { return true; };
        if right.writes_a != 0 { return true; };
    };
    if right.writes_a != 0 {
        if left.reads_a != 0 { return true; };
    };
    if left.writes_b != 0 {
        if right.reads_b != 0 { return true; };
        if right.writes_b != 0 { return true; };
    };
    if right.writes_b != 0 {
        if left.reads_b != 0 { return true; };
    };
    if left.writes_resource != 0 {
        if right.reads_resource != 0 { return true; };
        if right.writes_resource != 0 { return true; };
    };
    if right.writes_resource != 0 {
        if left.reads_resource != 0 { return true; };
    };
    if left.writes_messages != 0 {
        if right.reads_messages != 0 { return true; };
        if right.writes_messages != 0 { return true; };
    };
    if right.writes_messages != 0 {
        if left.reads_messages != 0 { return true; };
    };
    return false;
}

struct EcsDynScheduleDeep {
    a0: EcsDynSystemAccessDeep, a1: EcsDynSystemAccessDeep, a2: EcsDynSystemAccessDeep, a3: EcsDynSystemAccessDeep,
    a4: EcsDynSystemAccessDeep, a5: EcsDynSystemAccessDeep, a6: EcsDynSystemAccessDeep, a7: EcsDynSystemAccessDeep,
    count: i32,
    conflict_count: i32,
}

fn ecs_schedule_default() -> EcsDynScheduleDeep {
    let blank = ecs_dynamic_system_access_none();
    let s = EcsDynScheduleDeep {
        a0: blank, a1: ecs_dynamic_system_access_none(), a2: ecs_dynamic_system_access_none(), a3: ecs_dynamic_system_access_none(),
        a4: ecs_dynamic_system_access_none(), a5: ecs_dynamic_system_access_none(), a6: ecs_dynamic_system_access_none(), a7: ecs_dynamic_system_access_none(),
        count: 0,
        conflict_count: 0,
    };
    return s;
}

fn ecs_schedule_len(s: EcsDynScheduleDeep) -> i32 { return s.count; }
fn ecs_schedule_conflict_count(s: EcsDynScheduleDeep) -> i32 { return s.conflict_count; }

fn ecs_schedule_access_at(s: EcsDynScheduleDeep, idx: i32) -> EcsDynSystemAccessDeep {
    if idx == 0 { return s.a0; };
    if idx == 1 { return s.a1; };
    if idx == 2 { return s.a2; };
    if idx == 3 { return s.a3; };
    if idx == 4 { return s.a4; };
    if idx == 5 { return s.a5; };
    if idx == 6 { return s.a6; };
    if idx == 7 { return s.a7; };
    return ecs_dynamic_system_access_none();
}

fn ecs_schedule_set_access_at(s: EcsDynScheduleDeep, idx: i32, a: EcsDynSystemAccessDeep) -> EcsDynScheduleDeep {
    // Capture scalar fields, construct fresh per branch (UseAfterMove safe).
    let ra = ecs_dyn_access_reads_a(a);
    let wa = ecs_dyn_access_writes_a(a);
    let rb = ecs_dyn_access_reads_b(a);
    let wb = ecs_dyn_access_writes_b(a);
    let rr = ecs_dyn_access_reads_resource(a);
    let wr = ecs_dyn_access_writes_resource(a);
    let rm = ecs_dyn_access_reads_messages(a);
    let wm = ecs_dyn_access_writes_messages(a);
    if idx == 0 { s.a0 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 1 { s.a1 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 2 { s.a2 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 3 { s.a3 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 4 { s.a4 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 5 { s.a5 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 6 { s.a6 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    if idx == 7 { s.a7 = EcsDynSystemAccessDeep { reads_a: ra, writes_a: wa, reads_b: rb, writes_b: wb, reads_resource: rr, writes_resource: wr, reads_messages: rm, writes_messages: wm }; };
    return s;
}

// add_systems: appends a system, incrementing conflict_count once per prior system
// it conflicts with.
fn ecs_schedule_add_systems(s: EcsDynScheduleDeep, access: EcsDynSystemAccessDeep) -> EcsDynScheduleDeep {
    if s.count >= ECS_SCHED_DYN_CAP_DEEP { return s; };
    // Count conflicts against all current systems in the schedule.
    let i: i32 = 0;
    while i < s.count {
        let other = ecs_schedule_access_at(s, i);
        if ecs_dynamic_access_conflicts(access, other) { s.conflict_count = s.conflict_count + 1; };
        i = i + 1;
    }
    let slot = s.count;
    s = ecs_schedule_set_access_at(s, slot, access);
    s.count = s.count + 1;
    return s;
}

fn ecs_schedule_clear(s: EcsDynScheduleDeep) -> EcsDynScheduleDeep {
    return ecs_schedule_default();
}
