// Deepened Bevy ECS EntityHashSet set algebra / drain / extract_if.
// Mirrors src/entity/hash_set.rs ops surface.
// Fixed capacity: 8 entities. Shallow lib/entity_hash_set_ops.sla retained.

struct EcsEhsDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
}

fn ecs_ehs_deep_new() -> EcsEhsDeep {
    return EcsEhsDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0, len: 0,
    };
}

fn ecs_ehs_deep_len(s: EcsEhsDeep) -> i32 { return s.len; }
fn ecs_ehs_deep_is_empty(s: EcsEhsDeep) -> bool { return s.len == 0; }

fn ecs_ehs_deep_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64, len: i32
) -> EcsEhsDeep {
    return EcsEhsDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7, len: len,
    };
}

fn ecs_ehs_deep_at(s: EcsEhsDeep, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return -1;
}

fn ecs_ehs_deep_contains(s: EcsEhsDeep, entity: i64) -> bool {
    if s.len >= 1 { if s.e0 == entity { return true; }; };
    if s.len >= 2 { if s.e1 == entity { return true; }; };
    if s.len >= 3 { if s.e2 == entity { return true; }; };
    if s.len >= 4 { if s.e3 == entity { return true; }; };
    if s.len >= 5 { if s.e4 == entity { return true; }; };
    if s.len >= 6 { if s.e5 == entity { return true; }; };
    if s.len >= 7 { if s.e6 == entity { return true; }; };
    if s.len >= 8 { if s.e7 == entity { return true; }; };
    return false;
}

fn ecs_ehs_deep_insert(s: EcsEhsDeep, entity: i64) -> EcsEhsDeep {
    if ecs_ehs_deep_contains(s, entity) { return s; };
    if s.len == 0 { return ecs_ehs_deep_rebuild(entity, 0, 0, 0, 0, 0, 0, 0, 1); };
    if s.len == 1 { return ecs_ehs_deep_rebuild(s.e0, entity, 0, 0, 0, 0, 0, 0, 2); };
    if s.len == 2 { return ecs_ehs_deep_rebuild(s.e0, s.e1, entity, 0, 0, 0, 0, 0, 3); };
    if s.len == 3 { return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, entity, 0, 0, 0, 0, 4); };
    if s.len == 4 { return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, entity, 0, 0, 0, 5); };
    if s.len == 5 { return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, entity, 0, 0, 6); };
    if s.len == 6 { return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, entity, 0, 7); };
    if s.len == 7 { return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, entity, 8); };
    return s;
}

fn ecs_ehs_deep_remove_slot(s: EcsEhsDeep, idx: i32) -> EcsEhsDeep {
    // swap-remove with last
    let last = ecs_ehs_deep_at(s, s.len - 1);
    let nlen = s.len - 1;
    if idx == 0 {
        if nlen == 0 { return ecs_ehs_deep_rebuild(0,0,0,0,0,0,0,0,0); };
        return ecs_ehs_deep_rebuild(last, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, 0, nlen);
    };
    if idx == 1 {
        if nlen == 1 { return ecs_ehs_deep_rebuild(s.e0,0,0,0,0,0,0,0,1); };
        return ecs_ehs_deep_rebuild(s.e0, last, s.e2, s.e3, s.e4, s.e5, s.e6, 0, nlen);
    };
    if idx == 2 {
        if nlen == 2 { return ecs_ehs_deep_rebuild(s.e0,s.e1,0,0,0,0,0,0,2); };
        return ecs_ehs_deep_rebuild(s.e0, s.e1, last, s.e3, s.e4, s.e5, s.e6, 0, nlen);
    };
    if idx == 3 {
        if nlen == 3 { return ecs_ehs_deep_rebuild(s.e0,s.e1,s.e2,0,0,0,0,0,3); };
        return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, last, s.e4, s.e5, s.e6, 0, nlen);
    };
    if idx == 4 {
        if nlen == 4 { return ecs_ehs_deep_rebuild(s.e0,s.e1,s.e2,s.e3,0,0,0,0,4); };
        return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, last, s.e5, s.e6, 0, nlen);
    };
    if idx == 5 {
        if nlen == 5 { return ecs_ehs_deep_rebuild(s.e0,s.e1,s.e2,s.e3,s.e4,0,0,0,5); };
        return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, last, s.e6, 0, nlen);
    };
    if idx == 6 {
        if nlen == 6 { return ecs_ehs_deep_rebuild(s.e0,s.e1,s.e2,s.e3,s.e4,s.e5,0,0,6); };
        return ecs_ehs_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, last, 0, nlen);
    };
    // idx == 7 or last
    return ecs_ehs_deep_rebuild(s.e0,s.e1,s.e2,s.e3,s.e4,s.e5,s.e6,0,nlen);
}

fn ecs_ehs_deep_remove(s: EcsEhsDeep, entity: i64) -> EcsEhsDeep {
    if s.len >= 1 { if s.e0 == entity { return ecs_ehs_deep_remove_slot(s, 0); }; };
    if s.len >= 2 { if s.e1 == entity { return ecs_ehs_deep_remove_slot(s, 1); }; };
    if s.len >= 3 { if s.e2 == entity { return ecs_ehs_deep_remove_slot(s, 2); }; };
    if s.len >= 4 { if s.e3 == entity { return ecs_ehs_deep_remove_slot(s, 3); }; };
    if s.len >= 5 { if s.e4 == entity { return ecs_ehs_deep_remove_slot(s, 4); }; };
    if s.len >= 6 { if s.e5 == entity { return ecs_ehs_deep_remove_slot(s, 5); }; };
    if s.len >= 7 { if s.e6 == entity { return ecs_ehs_deep_remove_slot(s, 6); }; };
    if s.len >= 8 { if s.e7 == entity { return ecs_ehs_deep_remove_slot(s, 7); }; };
    return s;
}

fn ecs_ehs_deep_clear(s: EcsEhsDeep) -> EcsEhsDeep {
    return ecs_ehs_deep_new();
}

// union
fn ecs_ehs_deep_union(a: EcsEhsDeep, b: EcsEhsDeep) -> EcsEhsDeep {
    let out = a;
    if b.len >= 1 { out = ecs_ehs_deep_insert(out, b.e0); };
    if b.len >= 2 { out = ecs_ehs_deep_insert(out, b.e1); };
    if b.len >= 3 { out = ecs_ehs_deep_insert(out, b.e2); };
    if b.len >= 4 { out = ecs_ehs_deep_insert(out, b.e3); };
    if b.len >= 5 { out = ecs_ehs_deep_insert(out, b.e4); };
    if b.len >= 6 { out = ecs_ehs_deep_insert(out, b.e5); };
    if b.len >= 7 { out = ecs_ehs_deep_insert(out, b.e6); };
    if b.len >= 8 { out = ecs_ehs_deep_insert(out, b.e7); };
    return out;
}

// intersection
fn ecs_ehs_deep_intersection(a: EcsEhsDeep, b: EcsEhsDeep) -> EcsEhsDeep {
    let out = ecs_ehs_deep_new();
    if a.len >= 1 { if ecs_ehs_deep_contains(b, a.e0) { out = ecs_ehs_deep_insert(out, a.e0); }; };
    if a.len >= 2 { if ecs_ehs_deep_contains(b, a.e1) { out = ecs_ehs_deep_insert(out, a.e1); }; };
    if a.len >= 3 { if ecs_ehs_deep_contains(b, a.e2) { out = ecs_ehs_deep_insert(out, a.e2); }; };
    if a.len >= 4 { if ecs_ehs_deep_contains(b, a.e3) { out = ecs_ehs_deep_insert(out, a.e3); }; };
    if a.len >= 5 { if ecs_ehs_deep_contains(b, a.e4) { out = ecs_ehs_deep_insert(out, a.e4); }; };
    if a.len >= 6 { if ecs_ehs_deep_contains(b, a.e5) { out = ecs_ehs_deep_insert(out, a.e5); }; };
    if a.len >= 7 { if ecs_ehs_deep_contains(b, a.e6) { out = ecs_ehs_deep_insert(out, a.e6); }; };
    if a.len >= 8 { if ecs_ehs_deep_contains(b, a.e7) { out = ecs_ehs_deep_insert(out, a.e7); }; };
    return out;
}

// difference a - b
fn ecs_ehs_deep_difference(a: EcsEhsDeep, b: EcsEhsDeep) -> EcsEhsDeep {
    let out = ecs_ehs_deep_new();
    if a.len >= 1 { if ecs_ehs_deep_contains(b, a.e0) != true { out = ecs_ehs_deep_insert(out, a.e0); }; };
    if a.len >= 2 { if ecs_ehs_deep_contains(b, a.e1) != true { out = ecs_ehs_deep_insert(out, a.e1); }; };
    if a.len >= 3 { if ecs_ehs_deep_contains(b, a.e2) != true { out = ecs_ehs_deep_insert(out, a.e2); }; };
    if a.len >= 4 { if ecs_ehs_deep_contains(b, a.e3) != true { out = ecs_ehs_deep_insert(out, a.e3); }; };
    if a.len >= 5 { if ecs_ehs_deep_contains(b, a.e4) != true { out = ecs_ehs_deep_insert(out, a.e4); }; };
    if a.len >= 6 { if ecs_ehs_deep_contains(b, a.e5) != true { out = ecs_ehs_deep_insert(out, a.e5); }; };
    if a.len >= 7 { if ecs_ehs_deep_contains(b, a.e6) != true { out = ecs_ehs_deep_insert(out, a.e6); }; };
    if a.len >= 8 { if ecs_ehs_deep_contains(b, a.e7) != true { out = ecs_ehs_deep_insert(out, a.e7); }; };
    return out;
}

// symmetric difference
fn ecs_ehs_deep_symmetric_difference(a: EcsEhsDeep, b: EcsEhsDeep) -> EcsEhsDeep {
    return ecs_ehs_deep_union(ecs_ehs_deep_difference(a, b), ecs_ehs_deep_difference(b, a));
}

fn ecs_ehs_deep_is_subset(a: EcsEhsDeep, b: EcsEhsDeep) -> bool {
    if a.len >= 1 { if ecs_ehs_deep_contains(b, a.e0) != true { return false; }; };
    if a.len >= 2 { if ecs_ehs_deep_contains(b, a.e1) != true { return false; }; };
    if a.len >= 3 { if ecs_ehs_deep_contains(b, a.e2) != true { return false; }; };
    if a.len >= 4 { if ecs_ehs_deep_contains(b, a.e3) != true { return false; }; };
    if a.len >= 5 { if ecs_ehs_deep_contains(b, a.e4) != true { return false; }; };
    if a.len >= 6 { if ecs_ehs_deep_contains(b, a.e5) != true { return false; }; };
    if a.len >= 7 { if ecs_ehs_deep_contains(b, a.e6) != true { return false; }; };
    if a.len >= 8 { if ecs_ehs_deep_contains(b, a.e7) != true { return false; }; };
    return true;
}

fn ecs_ehs_deep_is_disjoint(a: EcsEhsDeep, b: EcsEhsDeep) -> bool {
    return ecs_ehs_deep_len(ecs_ehs_deep_intersection(a, b)) == 0;
}

// drain: empty set, return drained copy
struct EcsEhsDrainDeep {
    set: EcsEhsDeep,
    drained: EcsEhsDeep,
}

fn ecs_ehs_drain_set(d: EcsEhsDrainDeep) -> EcsEhsDeep { return d.set; }
fn ecs_ehs_drain_drained(d: EcsEhsDrainDeep) -> EcsEhsDeep { return d.drained; }

fn ecs_ehs_deep_drain(s: EcsEhsDeep) -> EcsEhsDrainDeep {
    return EcsEhsDrainDeep { set: ecs_ehs_deep_new(), drained: s };
}

// extract_if: extract entities with value > threshold (predicate model)
struct EcsEhsExtractDeep {
    set: EcsEhsDeep,
    extracted: EcsEhsDeep,
}

fn ecs_ehs_extract_set(e: EcsEhsExtractDeep) -> EcsEhsDeep { return e.set; }
fn ecs_ehs_extract_extracted(e: EcsEhsExtractDeep) -> EcsEhsDeep { return e.extracted; }

fn ecs_ehs_deep_extract_if_gt(s: EcsEhsDeep, threshold: i64) -> EcsEhsExtractDeep {
    let kept = ecs_ehs_deep_new();
    let extracted = ecs_ehs_deep_new();
    if s.len >= 1 {
        if s.e0 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e0); }
        else { kept = ecs_ehs_deep_insert(kept, s.e0); };
    };
    if s.len >= 2 {
        if s.e1 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e1); }
        else { kept = ecs_ehs_deep_insert(kept, s.e1); };
    };
    if s.len >= 3 {
        if s.e2 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e2); }
        else { kept = ecs_ehs_deep_insert(kept, s.e2); };
    };
    if s.len >= 4 {
        if s.e3 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e3); }
        else { kept = ecs_ehs_deep_insert(kept, s.e3); };
    };
    if s.len >= 5 {
        if s.e4 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e4); }
        else { kept = ecs_ehs_deep_insert(kept, s.e4); };
    };
    if s.len >= 6 {
        if s.e5 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e5); }
        else { kept = ecs_ehs_deep_insert(kept, s.e5); };
    };
    if s.len >= 7 {
        if s.e6 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e6); }
        else { kept = ecs_ehs_deep_insert(kept, s.e6); };
    };
    if s.len >= 8 {
        if s.e7 > threshold { extracted = ecs_ehs_deep_insert(extracted, s.e7); }
        else { kept = ecs_ehs_deep_insert(kept, s.e7); };
    };
    return EcsEhsExtractDeep { set: kept, extracted: extracted };
}

fn ecs_ehs_deep_extend(a: EcsEhsDeep, b: EcsEhsDeep) -> EcsEhsDeep {
    return ecs_ehs_deep_union(a, b);
}

fn ecs_ehs_deep_eq(a: EcsEhsDeep, b: EcsEhsDeep) -> bool {
    if a.len != b.len { return false; };
    return ecs_ehs_deep_is_subset(a, b);
}
