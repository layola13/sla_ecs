// Deepened Bevy ECS schedule stepping (Stepping cursor + ScheduleState) for the standalone
// deep model. (shallow lib/schedule_stepping.sla already contains an inline Vec-based deep;
// this file mirrors src/schedule/stepping.rs Steering::next_frame + ScheduleState::skipped_systems
// on fixed-cap storage: no Vec, no tuple returns in tests, no `let mut`, no `let w = fn(w,...)`
// chained rebinds -- wrapper structs + flat let-ladders / cascade-of-return per cookbook.)
//
// Storage: cap-8 schedules (EcsSteppingDeep) × cap-16 systems-per-schedule (EcsSteppingScheduleStateDeep).
// Updates queue cap-8. Behaviors / behavior_updates / skip-flags per-system sliders cap-16 each.
//
// Kinds (mirror shallow `ECS_STEPPING_UPDATE_*`):
//   SET_ACTION=0, ADD_SCHEDULE=1, REMOVE_SCHEDULE=2, CLEAR_SCHEDULE=3,
//   SET_BEHAVIOR=4, CLEAR_BEHAVIOR=5.
// System behaviors (mirror shallow `ECS_SB_*`):
//   ALWAYS_RUN=0, NEVER_RUN=1, BREAK=2, CONTINUE=3.
// Actions (mirror shallow `ECS_STEPPING_ACTION_*`):
//   RUN_ALL=0, WAITING=1, CONTINUE=2, STEP=3.
// System identifiers: SID_NODE=1 (kind), SID_TYPE=0 (kind).
//
// Wrapper structs (Batch 373 rule -- no test tuple destructuring):
//  EcsStepSchedulesDeep   { found, order }           -- schedules(): found + capped order list
//  EcsStepCursorDeep      { found, label, system_idx } -- cursor()
//  EcsStepSkippedDeep     { found, skip_count, next_system, f0..f15 } -- skipped_systems()
//  EcsStepUpdateDeep      { variant, action_or_label, sid_kind, sid_id, behavior_val } -- queued update

const ECS_STEP_CAP_SCHEDULES: i32 = 8;
const ECS_STEP_CAP_SYSTEMS: i32 = 16;
const ECS_STEP_CAP_UPDATES: i32 = 8;

const ECS_STEPPING_ACTION_RUN_ALL_D: i32 = 0;
const ECS_STEPPING_ACTION_WAITING_D: i32 = 1;
const ECS_STEPPING_ACTION_CONTINUE_D: i32 = 2;
const ECS_STEPPING_ACTION_STEP_D: i32 = 3;

const ECS_SB_ALWAYS_RUN_D: i32 = 0;
const ECS_SB_NEVER_RUN_D: i32 = 1;
const ECS_SB_BREAK_D: i32 = 2;
const ECS_SB_CONTINUE_D: i32 = 3;

const ECS_STEPPING_UPDATE_SET_ACTION_D: i32 = 0;
const ECS_STEPPING_UPDATE_ADD_SCHEDULE_D: i32 = 1;
const ECS_STEPPING_UPDATE_REMOVE_SCHEDULE_D: i32 = 2;
const ECS_STEPPING_UPDATE_CLEAR_SCHEDULE_D: i32 = 3;
const ECS_STEPPING_UPDATE_SET_BEHAVIOR_D: i32 = 4;
const ECS_STEPPING_UPDATE_CLEAR_BEHAVIOR_D: i32 = 5;

const ECS_SID_TYPE_D: i32 = 0;
const ECS_SID_NODE_D: i32 = 1;

// ── Queued update (cap-8 ring of structured updates) ───────────────────────
struct EcsStepUpdateDeep {
    variant: i32,
    action_or_label: i32,
    sid_kind: i32,
    sid_id: i32,
    behavior_val: i32,
}

// ── Per-schedule state (cap-16 systems) ─────────────────────────────────────
struct EcsSteppingScheduleStateDeepS {
    label: i32,
    // per-system behavior keyed by system index (0..15); ECS_SB_CONTINUE_D = unset/default.
    b0: i32, b1: i32, b2: i32, b3: i32, b4: i32, b5: i32, b6: i32, b7: i32,
    b8: i32, b9: i32, b10: i32, b11: i32, b12: i32, b13: i32, b14: i32, b15: i32,
    node_count: i32,
    first: i32,
    // per-system behavior_updates (queued pending): -1 = none, else behavior.
    u0: i32, u1: i32, u2: i32, u3: i32, u4: i32, u5: i32, u6: i32, u7: i32,
    u8: i32, u9: i32, u10: i32, u11: i32, u12: i32, u13: i32, u14: i32, u15: i32,
    has_pending_updates: i32,
    cursor_system: i32,
    start: i32,
}

fn ecs_stepping_deep_state_new_s(label: i32, node_count: i32) -> EcsSteppingScheduleStateDeepS {
    let s = EcsSteppingScheduleStateDeepS {
        label: label,
        b0: ECS_SB_CONTINUE_D, b1: ECS_SB_CONTINUE_D, b2: ECS_SB_CONTINUE_D, b3: ECS_SB_CONTINUE_D,
        b4: ECS_SB_CONTINUE_D, b5: ECS_SB_CONTINUE_D, b6: ECS_SB_CONTINUE_D, b7: ECS_SB_CONTINUE_D,
        b8: ECS_SB_CONTINUE_D, b9: ECS_SB_CONTINUE_D, b10: ECS_SB_CONTINUE_D, b11: ECS_SB_CONTINUE_D,
        b12: ECS_SB_CONTINUE_D, b13: ECS_SB_CONTINUE_D, b14: ECS_SB_CONTINUE_D, b15: ECS_SB_CONTINUE_D,
        node_count: node_count,
        first: -1,
        u0: -1, u1: -1, u2: -1, u3: -1, u4: -1, u5: -1, u6: -1, u7: -1,
        u8: -1, u9: -1, u10: -1, u11: -1, u12: -1, u13: -1, u14: -1, u15: -1,
        has_pending_updates: 0,
        cursor_system: 0,
        start: 0,
    };
    return s;
}

// behavior-at cascading accessor (cap-16).
fn ecs_stepping_deep_state_behavior_at_s(st: EcsSteppingScheduleStateDeepS, idx: i32) -> i32 {
    if idx == 0 { return st.b0; };
    if idx == 1 { return st.b1; };
    if idx == 2 { return st.b2; };
    if idx == 3 { return st.b3; };
    if idx == 4 { return st.b4; };
    if idx == 5 { return st.b5; };
    if idx == 6 { return st.b6; };
    if idx == 7 { return st.b7; };
    if idx == 8 { return st.b8; };
    if idx == 9 { return st.b9; };
    if idx == 10 { return st.b10; };
    if idx == 11 { return st.b11; };
    if idx == 12 { return st.b12; };
    if idx == 13 { return st.b13; };
    if idx == 14 { return st.b14; };
    return st.b15;
}

// set-behavior-at cascade-of-return (Batch 377 shape). Caps at the configured node_count;
// grows node_count if system_index >= node_count (mirror inline deep auto-resize, up to cap-16).
fn ecs_stepping_deep_state_set_behavior_s(st0: EcsSteppingScheduleStateDeepS, system_index: i32, behavior: i32) -> EcsSteppingScheduleStateDeepS {
    if system_index < 0 { return st0; };
    if system_index >= ECS_STEP_CAP_SYSTEMS { return st0; };
    let st1 = _ecs_stepping_deep_state_grow_s(st0, system_index + 1);
    if system_index == 0 { st1.b0 = behavior; st1.first = -1; return st1; };
    if system_index == 1 { st1.b1 = behavior; st1.first = -1; return st1; };
    if system_index == 2 { st1.b2 = behavior; st1.first = -1; return st1; };
    if system_index == 3 { st1.b3 = behavior; st1.first = -1; return st1; };
    if system_index == 4 { st1.b4 = behavior; st1.first = -1; return st1; };
    if system_index == 5 { st1.b5 = behavior; st1.first = -1; return st1; };
    if system_index == 6 { st1.b6 = behavior; st1.first = -1; return st1; };
    if system_index == 7 { st1.b7 = behavior; st1.first = -1; return st1; };
    if system_index == 8 { st1.b8 = behavior; st1.first = -1; return st1; };
    if system_index == 9 { st1.b9 = behavior; st1.first = -1; return st1; };
    if system_index == 10 { st1.b10 = behavior; st1.first = -1; return st1; };
    if system_index == 11 { st1.b11 = behavior; st1.first = -1; return st1; };
    if system_index == 12 { st1.b12 = behavior; st1.first = -1; return st1; };
    if system_index == 13 { st1.b13 = behavior; st1.first = -1; return st1; };
    if system_index == 14 { st1.b14 = behavior; st1.first = -1; return st1; };
    st1.b15 = behavior;
    st1.first = -1;
    return st1;
}

// grow node_count to `target` (only if larger); behavior / update slots stay at default ComeBy
// default since the struct literal already fills them -- this is a no-op above cap-16 since the
// slots exist with default values. Used so set_behavior at a high system_index keeps node_count in sync.
fn _ecs_stepping_deep_state_grow_s(st: EcsSteppingScheduleStateDeepS, target: i32) -> EcsSteppingScheduleStateDeepS {
    if target <= st.node_count { return st; };
    if target > ECS_STEP_CAP_SYSTEMS { target = ECS_STEP_CAP_SYSTEMS; };
    st.node_count = target;
    return st;
}

// clear_behavior_at: reset the slot to Continue default (mirror inline deep clear = unset).
fn ecs_stepping_deep_state_clear_behavior_s(st0: EcsSteppingScheduleStateDeepS, system_index: i32) -> EcsSteppingScheduleStateDeepS {
    if system_index < 0 { return st0; };
    if system_index >= ECS_STEP_CAP_SYSTEMS { return st0; };
    let st1 = _ecs_stepping_deep_state_grow_s(st0, system_index + 1);
    if system_index == 0 { st1.b0 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 1 { st1.b1 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 2 { st1.b2 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 3 { st1.b3 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 4 { st1.b4 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 5 { st1.b5 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 6 { st1.b6 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 7 { st1.b7 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 8 { st1.b8 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 9 { st1.b9 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 10 { st1.b10 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 11 { st1.b11 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 12 { st1.b12 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 13 { st1.b13 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    if system_index == 14 { st1.b14 = ECS_SB_CONTINUE_D; st1.first = -1; return st1; };
    st1.b15 = ECS_SB_CONTINUE_D;
    st1.first = -1;
    return st1;
}

// clear_all: reset every slot to Continue, first = -1.
fn ecs_stepping_deep_state_clear_all_s(st0: EcsSteppingScheduleStateDeepS) -> EcsSteppingScheduleStateDeepS {
    st0.b0 = ECS_SB_CONTINUE_D; st0.b1 = ECS_SB_CONTINUE_D; st0.b2 = ECS_SB_CONTINUE_D; st0.b3 = ECS_SB_CONTINUE_D;
    st0.b4 = ECS_SB_CONTINUE_D; st0.b5 = ECS_SB_CONTINUE_D; st0.b6 = ECS_SB_CONTINUE_D; st0.b7 = ECS_SB_CONTINUE_D;
    st0.b8 = ECS_SB_CONTINUE_D; st0.b9 = ECS_SB_CONTINUE_D; st0.b10 = ECS_SB_CONTINUE_D; st0.b11 = ECS_SB_CONTINUE_D;
    st0.b12 = ECS_SB_CONTINUE_D; st0.b13 = ECS_SB_CONTINUE_D; st0.b14 = ECS_SB_CONTINUE_D; st0.b15 = ECS_SB_CONTINUE_D;
    st0.first = -1;
    return st0;
}

// compute_first: first steppable system (skip AlwaysRun / NeverRun), else -1. Flat let-ladder.
fn ecs_stepping_deep_compute_first_s(st: EcsSteppingScheduleStateDeepS) -> i32 {
    let n = st.node_count;
    let c0 = _ecs_stepping_deep_first_step_at(st, 0, n);
    let c1 = _ecs_stepping_deep_first_step_at(st, 1, n);
    let c2 = _ecs_stepping_deep_first_step_at(st, 2, n);
    let c3 = _ecs_stepping_deep_first_step_at(st, 3, n);
    let c4 = _ecs_stepping_deep_first_step_at(st, 4, n);
    let c5 = _ecs_stepping_deep_first_step_at(st, 5, n);
    let c6 = _ecs_stepping_deep_first_step_at(st, 6, n);
    let c7 = _ecs_stepping_deep_first_step_at(st, 7, n);
    let c8 = _ecs_stepping_deep_first_step_at(st, 8, n);
    let c9 = _ecs_stepping_deep_first_step_at(st, 9, n);
    let c10 = _ecs_stepping_deep_first_step_at(st, 10, n);
    let c11 = _ecs_stepping_deep_first_step_at(st, 11, n);
    let c12 = _ecs_stepping_deep_first_step_at(st, 12, n);
    let c13 = _ecs_stepping_deep_first_step_at(st, 13, n);
    let c14 = _ecs_stepping_deep_first_step_at(st, 14, n);
    let c15 = _ecs_stepping_deep_first_step_at(st, 15, n);
    return _ecs_stepping_deep_pick_first(c0, c1, c2, c3, c4, c5, c6, c7, c8, c9, c10, c11, c12, c13, c14, c15);
}

// Returns idx if slot is steppable (Continue/Break), else -1.
fn _ecs_stepping_deep_first_step_at(st: EcsSteppingScheduleStateDeepS, idx: i32, n: i32) -> i32 {
    if idx >= n { return -1; };
    let beh = ecs_stepping_deep_state_behavior_at_s(st, idx);
    if beh == ECS_SB_ALWAYS_RUN_D { return -1; };
    if beh == ECS_SB_NEVER_RUN_D { return -1; };
    return idx;
}

// Pick the first non-negative from up to 16 candidates (earliest index wins).
fn _ecs_stepping_deep_pick_first(c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32, c8: i32, c9: i32, c10: i32, c11: i32, c12: i32, c13: i32, c14: i32, c15: i32) -> i32 {
    if c0 >= 0 { return c0; };
    if c1 >= 0 { return c1; };
    if c2 >= 0 { return c2; };
    if c3 >= 0 { return c3; };
    if c4 >= 0 { return c4; };
    if c5 >= 0 { return c5; };
    if c6 >= 0 { return c6; };
    if c7 >= 0 { return c7; };
    if c8 >= 0 { return c8; };
    if c9 >= 0 { return c9; };
    if c10 >= 0 { return c10; };
    if c11 >= 0 { return c11; };
    if c12 >= 0 { return c12; };
    if c13 >= 0 { return c13; };
    if c14 >= 0 { return c14; };
    return c15;
}

// ── EcsSteppingDeepS: cap-8 schedules × cap-16 systems scheduler steering ──
struct EcsSteppingDeepS {
    // cap-8 queued updates
    uv0: i32, uv1: i32, uv2: i32, uv3: i32, uv4: i32, uv5: i32, uv6: i32, uv7: i32,
    ua0: i32, ua1: i32, ua2: i32, ua3: i32, ua4: i32, ua5: i32, ua6: i32, ua7: i32,
    uk0: i32, uk1: i32, uk2: i32, uk3: i32, uk4: i32, uk5: i32, uk6: i32, uk7: i32,
    ui0: i32, ui1: i32, ui2: i32, ui3: i32, ui4: i32, ui5: i32, ui6: i32, ui7: i32,
    ub0: i32, ub1: i32, ub2: i32, ub3: i32, ub4: i32, ub5: i32, ub6: i32, ub7: i32,
    update_count: i32,
    // action currently applied (RUN_ALL/WAITING/CONTINUE/STEP)
    action: i32,
    // cap-8 schedule order (labels)
    so0: i32, so1: i32, so2: i32, so3: i32, so4: i32, so5: i32, so6: i32, so7: i32,
    so_count: i32,
    // cap-8 per-schedule states
    s0: EcsSteppingScheduleStateDeepS, s1: EcsSteppingScheduleStateDeepS,
    s2: EcsSteppingScheduleStateDeepS, s3: EcsSteppingScheduleStateDeepS,
    s4: EcsSteppingScheduleStateDeepS, s5: EcsSteppingScheduleStateDeepS,
    s6: EcsSteppingScheduleStateDeepS, s7: EcsSteppingScheduleStateDeepS,
    st_count: i32,
    // cursor: schedule index in schedule_order, system index within schedule
    cursor_schedule: i32,
    cursor_system: i32,
    previous_schedule: i32,
    initialized: i32,
}

fn ecs_stepping_deep_new_s() -> EcsSteppingDeepS {
    let d = EcsSteppingDeepS {
        uv0: 0, uv1: 0, uv2: 0, uv3: 0, uv4: 0, uv5: 0, uv6: 0, uv7: 0,
        ua0: 0, ua1: 0, ua2: 0, ua3: 0, ua4: 0, ua5: 0, ua6: 0, ua7: 0,
        uk0: 0, uk1: 0, uk2: 0, uk3: 0, uk4: 0, uk5: 0, uk6: 0, uk7: 0,
        ui0: 0, ui1: 0, ui2: 0, ui3: 0, ui4: 0, ui5: 0, ui6: 0, ui7: 0,
        ub0: 0, ub1: 0, ub2: 0, ub3: 0, ub4: 0, ub5: 0, ub6: 0, ub7: 0,
        update_count: 0,
        action: ECS_STEPPING_ACTION_RUN_ALL_D,
        so0: -1, so1: -1, so2: -1, so3: -1, so4: -1, so5: -1, so6: -1, so7: -1,
        so_count: 0,
        s0: ecs_stepping_deep_state_new_s(-1, 0), s1: ecs_stepping_deep_state_new_s(-1, 0),
        s2: ecs_stepping_deep_state_new_s(-1, 0), s3: ecs_stepping_deep_state_new_s(-1, 0),
        s4: ecs_stepping_deep_state_new_s(-1, 0), s5: ecs_stepping_deep_state_new_s(-1, 0),
        s6: ecs_stepping_deep_state_new_s(-1, 0), s7: ecs_stepping_deep_state_new_s(-1, 0),
        st_count: 0,
        cursor_schedule: 0,
        cursor_system: 0,
        previous_schedule: -1,
        initialized: 0,
    };
    return d;
}

fn ecs_stepping_deep_is_enabled_s(d: EcsSteppingDeepS) -> bool {
    return d.action != ECS_STEPPING_ACTION_RUN_ALL_D;
}

fn ecs_stepping_deep_action_s(d: EcsSteppingDeepS) -> i32 { return d.action; }

// ── Queue update setters (cap-8 reject silent) ──────────────────────────────
fn _ecs_stepping_deep_push_update(d: EcsSteppingDeepS, variant: i32, action_or_label: i32, sid_kind: i32, sid_id: i32, behavior_val: i32) -> EcsSteppingDeepS {
    if d.update_count >= ECS_STEP_CAP_UPDATES { return d; };
    let n = d.update_count;
    if n == 0 { d.uv0 = variant; d.ua0 = action_or_label; d.uk0 = sid_kind; d.ui0 = sid_id; d.ub0 = behavior_val; };
    if n == 1 { d.uv1 = variant; d.ua1 = action_or_label; d.uk1 = sid_kind; d.ui1 = sid_id; d.ub1 = behavior_val; };
    if n == 2 { d.uv2 = variant; d.ua2 = action_or_label; d.uk2 = sid_kind; d.ui2 = sid_id; d.ub2 = behavior_val; };
    if n == 3 { d.uv3 = variant; d.ua3 = action_or_label; d.uk3 = sid_kind; d.ui3 = sid_id; d.ub3 = behavior_val; };
    if n == 4 { d.uv4 = variant; d.ua4 = action_or_label; d.uk4 = sid_kind; d.ui4 = sid_id; d.ub4 = behavior_val; };
    if n == 5 { d.uv5 = variant; d.ua5 = action_or_label; d.uk5 = sid_kind; d.ui5 = sid_id; d.ub5 = behavior_val; };
    if n == 6 { d.uv6 = variant; d.ua6 = action_or_label; d.uk6 = sid_kind; d.ui6 = sid_id; d.ub6 = behavior_val; };
    if n == 7 { d.uv7 = variant; d.ua7 = action_or_label; d.uk7 = sid_kind; d.ui7 = sid_id; d.ub7 = behavior_val; };
    d.update_count = d.update_count + 1;
    return d;
}

fn ecs_stepping_deep_queue_set_action_s(d: EcsSteppingDeepS, action: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_push_update(d, ECS_STEPPING_UPDATE_SET_ACTION_D, action, ECS_SID_TYPE_D, 0, 0);
}
fn ecs_stepping_deep_queue_add_schedule_s(d: EcsSteppingDeepS, label: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_push_update(d, ECS_STEPPING_UPDATE_ADD_SCHEDULE_D, label, ECS_SID_TYPE_D, 0, 0);
}
fn ecs_stepping_deep_queue_remove_schedule_s(d: EcsSteppingDeepS, label: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_push_update(d, ECS_STEPPING_UPDATE_REMOVE_SCHEDULE_D, label, ECS_SID_TYPE_D, 0, 0);
}
fn ecs_stepping_deep_queue_clear_schedule_s(d: EcsSteppingDeepS, label: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_push_update(d, ECS_STEPPING_UPDATE_CLEAR_SCHEDULE_D, label, ECS_SID_TYPE_D, 0, 0);
}
fn ecs_stepping_deep_queue_set_behavior_s(d: EcsSteppingDeepS, label: i32, system_index: i32, behavior: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_push_update(d, ECS_STEPPING_UPDATE_SET_BEHAVIOR_D, label, ECS_SID_NODE_D, system_index, behavior);
}
fn ecs_stepping_deep_queue_clear_behavior_s(d: EcsSteppingDeepS, label: i32, system_index: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_push_update(d, ECS_STEPPING_UPDATE_CLEAR_BEHAVIOR_D, label, ECS_SID_NODE_D, system_index, 0);
}

fn ecs_stepping_deep_enable_s(d: EcsSteppingDeepS) -> EcsSteppingDeepS { return ecs_stepping_deep_queue_set_action_s(d, ECS_STEPPING_ACTION_WAITING_D); }
fn ecs_stepping_deep_disable_s(d: EcsSteppingDeepS) -> EcsSteppingDeepS { return ecs_stepping_deep_queue_set_action_s(d, ECS_STEPPING_ACTION_RUN_ALL_D); }
fn ecs_stepping_deep_step_frame_s(d: EcsSteppingDeepS) -> EcsSteppingDeepS { return ecs_stepping_deep_queue_set_action_s(d, ECS_STEPPING_ACTION_STEP_D); }
fn ecs_stepping_deep_continue_frame_s(d: EcsSteppingDeepS) -> EcsSteppingDeepS { return ecs_stepping_deep_queue_set_action_s(d, ECS_STEPPING_ACTION_CONTINUE_D); }

fn ecs_stepping_deep_update_count_s(d: EcsSteppingDeepS) -> i32 { return d.update_count; }

// ── Schedule-slot accessors for EcsSteppingDeepS ────────────────────────────
fn _ecs_stepping_deep_state_at(d: EcsSteppingDeepS, idx: i32) -> EcsSteppingScheduleStateDeepS {
    if idx == 0 { return d.s0; };
    if idx == 1 { return d.s1; };
    if idx == 2 { return d.s2; };
    if idx == 3 { return d.s3; };
    if idx == 4 { return d.s4; };
    if idx == 5 { return d.s5; };
    if idx == 6 { return d.s6; };
    return d.s7;
}

fn _ecs_stepping_deep_set_state(d: EcsSteppingDeepS, idx: i32, st: EcsSteppingScheduleStateDeepS) -> EcsSteppingDeepS {
    if idx == 0 { d.s0 = st; return d; };
    if idx == 1 { d.s1 = st; return d; };
    if idx == 2 { d.s2 = st; return d; };
    if idx == 3 { d.s3 = st; return d; };
    if idx == 4 { d.s4 = st; return d; };
    if idx == 5 { d.s5 = st; return d; };
    if idx == 6 { d.s6 = st; return d; };
    d.s7 = st;
    return d;
}

fn _ecs_stepping_deep_so_at(d: EcsSteppingDeepS, idx: i32) -> i32 {
    if idx == 0 { return d.so0; };
    if idx == 1 { return d.so1; };
    if idx == 2 { return d.so2; };
    if idx == 3 { return d.so3; };
    if idx == 4 { return d.so4; };
    if idx == 5 { return d.so5; };
    if idx == 6 { return d.so6; };
    return d.so7;
}

fn _ecs_stepping_deep_set_so_at(d: EcsSteppingDeepS, idx: i32, v: i32) -> EcsSteppingDeepS {
    if idx == 0 { d.so0 = v; return d; };
    if idx == 1 { d.so1 = v; return d; };
    if idx == 2 { d.so2 = v; return d; };
    if idx == 3 { d.so3 = v; return d; };
    if idx == 4 { d.so4 = v; return d; };
    if idx == 5 { d.so5 = v; return d; };
    if idx == 6 { d.so6 = v; return d; };
    d.so7 = v;
    return d;
}

// Find state index by label in [0..st_count); -1 if not found.
fn _ecs_stepping_deep_state_index_s(d: EcsSteppingDeepS, label: i32) -> i32 {
    if d.st_count <= 0 { return -1; };
    if d.s0.label == label { return 0; };
    if d.st_count > 1 { if d.s1.label == label { return 1; }; };
    if d.st_count > 2 { if d.s2.label == label { return 2; }; };
    if d.st_count > 3 { if d.s3.label == label { return 3; }; };
    if d.st_count > 4 { if d.s4.label == label { return 4; }; };
    if d.st_count > 5 { if d.s5.label == label { return 5; }; };
    if d.st_count > 6 { if d.s6.label == label { return 6; }; };
    if d.st_count > 7 { if d.s7.label == label { return 7; }; };
    return -1;
}

fn ecs_stepping_deep_state_exists_s(d: EcsSteppingDeepS, label: i32) -> bool {
    return _ecs_stepping_deep_state_index_s(d, label) >= 0;
}

fn ecs_stepping_deep_has_schedule_s(d: EcsSteppingDeepS, label: i32) -> bool {
    return _ecs_stepping_deep_state_index_s(d, label) >= 0;
}

// first_system at order-index: returns the state.first (or 0 if none).
fn _ecs_stepping_deep_first_system_s(d: EcsSteppingDeepS, order_idx: i32) -> i32 {
    if order_idx < 0 { return 0; };
    if order_idx >= d.so_count { return 0; };
    let lbl = _ecs_stepping_deep_so_at(d, order_idx);
    let si = _ecs_stepping_deep_state_index_s(d, lbl);
    if si < 0 { return 0; };
    let st = _ecs_stepping_deep_state_at(d, si);
    if st.first < 0 { return 0; };
    return st.first;
}

// behavior_for: read the per-system behavior of a schedule (label).
fn ecs_stepping_deep_behavior_for_s(d: EcsSteppingDeepS, label: i32, system_index: i32) -> i32 {
    let si = _ecs_stepping_deep_state_index_s(d, label);
    if si < 0 { return ECS_SB_CONTINUE_D; };
    let st = _ecs_stepping_deep_state_at(d, si);
    if system_index < 0 { return ECS_SB_CONTINUE_D; };
    if system_index >= ECS_STEP_CAP_SYSTEMS { return ECS_SB_CONTINUE_D; };
    if system_index >= st.node_count { return ECS_SB_CONTINUE_D; };
    return ecs_stepping_deep_state_behavior_at_s(st, system_index);
}

// reset_cursor: cursor_schedule = 0, cursor_system = first of schedule 0.
fn ecs_stepping_deep_reset_cursor_s(d0: EcsSteppingDeepS) -> EcsSteppingDeepS {
    d0.cursor_schedule = 0;
    d0.cursor_system = _ecs_stepping_deep_first_system_s(d0, 0);
    return d0;
}

// ── Update payload accessors ────────────────────────────────────────────────
fn _ecs_stepping_deep_uv_at(d: EcsSteppingDeepS, n: i32) -> i32 {
    if n == 0 { return d.uv0; };
    if n == 1 { return d.uv1; };
    if n == 2 { return d.uv2; };
    if n == 3 { return d.uv3; };
    if n == 4 { return d.uv4; };
    if n == 5 { return d.uv5; };
    if n == 6 { return d.uv6; };
    return d.uv7;
}

fn _ecs_stepping_deep_ua_at(d: EcsSteppingDeepS, n: i32) -> i32 {
    if n == 0 { return d.ua0; };
    if n == 1 { return d.ua1; };
    if n == 2 { return d.ua2; };
    if n == 3 { return d.ua3; };
    if n == 4 { return d.ua4; };
    if n == 5 { return d.ua5; };
    if n == 6 { return d.ua6; };
    return d.ua7;
}

fn _ecs_stepping_deep_uk_at(d: EcsSteppingDeepS, n: i32) -> i32 {
    if n == 0 { return d.uk0; };
    if n == 1 { return d.uk1; };
    if n == 2 { return d.uk2; };
    if n == 3 { return d.uk3; };
    if n == 4 { return d.uk4; };
    if n == 5 { return d.uk5; };
    if n == 6 { return d.uk6; };
    return d.uk7;
}

fn _ecs_stepping_deep_ui_at(d: EcsSteppingDeepS, n: i32) -> i32 {
    if n == 0 { return d.ui0; };
    if n == 1 { return d.ui1; };
    if n == 2 { return d.ui2; };
    if n == 3 { return d.ui3; };
    if n == 4 { return d.ui4; };
    if n == 5 { return d.ui5; };
    if n == 6 { return d.ui6; };
    return d.ui7;
}

fn _ecs_stepping_deep_ub_at(d: EcsSteppingDeepS, n: i32) -> i32 {
    if n == 0 { return d.ub0; };
    if n == 1 { return d.ub1; };
    if n == 2 { return d.ub2; };
    if n == 3 { return d.ub3; };
    if n == 4 { return d.ub4; };
    if n == 5 { return d.ub5; };
    if n == 6 { return d.ub6; };
    return d.ub7;
}

// ── Action-transition filter: mirror inline deep skip-set (lines 656-672) ────
// Returns 1 if the (cur, target) SET_ACTION pair should be skipped (no transition applied).
fn _ecs_stepping_deep_should_skip_action(cur: i32, target: i32) -> i32 {
    if cur == target { return 1; };
    // (Continue, Waiting) / (Step, Waiting): skip
    if cur == ECS_STEPPING_ACTION_CONTINUE_D && target == ECS_STEPPING_ACTION_WAITING_D { return 1; };
    if cur == ECS_STEPPING_ACTION_STEP_D && target == ECS_STEPPING_ACTION_WAITING_D { return 1; };
    // (RunAll, non-Waiting): skip (only the WAITING transition escapes this to enable stepping)
    if cur == ECS_STEPPING_ACTION_RUN_ALL_D && target != ECS_STEPPING_ACTION_WAITING_D { return 1; };
    // (Continue, Step) / (Step, Continue): skip
    if cur == ECS_STEPPING_ACTION_CONTINUE_D && target == ECS_STEPPING_ACTION_STEP_D { return 1; };
    if cur == ECS_STEPPING_ACTION_STEP_D && target == ECS_STEPPING_ACTION_CONTINUE_D { return 1; };
    return 0;
}

// Remove the state at `si` by shifting later states down + decrementing st_count.
fn _ecs_stepping_deep_remove_state(d: EcsSteppingDeepS, si: i32) -> EcsSteppingDeepS {
    let cnt = d.st_count;
    if si < 0 { return d; };
    if si >= cnt { return d; };
    // Shift: src si+1 -> dst si, down to cnt-1.
    let d1 = _ecs_stepping_deep_shift_states(d, si, cnt);
    // Clear the freed tail slot to a default state + decrement st_count.
    let d2 = _ecs_stepping_deep_clear_state_slot(d1, cnt - 1);
    d2.st_count = d2.st_count - 1;
    return d2;
}

// Move state[k+1] into slot k for k from `from..cnt-1` (cascade-of-return style helper).
fn _ecs_stepping_deep_shift_states(d: EcsSteppingDeepS, from: i32, cnt: i32) -> EcsSteppingDeepS {
    if from >= cnt - 1 { return d; };
    let src = from + 1;
    let st = _ecs_stepping_deep_state_at(d, src);
    let d1 = _ecs_stepping_deep_set_state(d, from, st);
    let d2 = _ecs_stepping_deep_shift_states(d1, from + 1, cnt);
    return d2;
}

fn _ecs_stepping_deep_clear_state_slot(d: EcsSteppingDeepS, idx: i32) -> EcsSteppingDeepS {
    return _ecs_stepping_deep_set_state(d, idx, ecs_stepping_deep_state_new_s(-1, 0));
}

// Append `label` to the end of schedule_order if not present (cap-8 reject silent).
fn _ecs_stepping_deep_append_order(d: EcsSteppingDeepS, label: i32) -> EcsSteppingDeepS {
    if d.so_count >= ECS_STEP_CAP_SCHEDULES { return d; };
    if d.so_count == 0 { d.so0 = label; };
    if d.so_count == 1 { d.so1 = label; };
    if d.so_count == 2 { d.so2 = label; };
    if d.so_count == 3 { d.so3 = label; };
    if d.so_count == 4 { d.so4 = label; };
    if d.so_count == 5 { d.so5 = label; };
    if d.so_count == 6 { d.so6 = label; };
    if d.so_count == 7 { d.so7 = label; };
    d.so_count = d.so_count + 1;
    return d;
}

// Append a fresh state labeled `label` (cap-8 reject silent).
fn _ecs_stepping_deep_append_state(d: EcsSteppingDeepS, label: i32) -> EcsSteppingDeepS {
    if d.st_count >= ECS_STEP_CAP_SCHEDULES { return d; };
    let st = ecs_stepping_deep_state_new_s(label, 0);
    return _ecs_stepping_deep_set_state(d, d.st_count, st);
    // NOTE: st_count bump deferred — caller bumps via _ecs_stepping_deep_inc_st_count.
}

fn _ecs_stepping_deep_inc_st_count(d: EcsSteppingDeepS) -> EcsSteppingDeepS {
    d.st_count = d.st_count + 1;
    return d;
}

// Remove label from schedule_order (cap-8 compact shift-down).
fn _ecs_stepping_deep_remove_from_order(d0: EcsSteppingDeepS, label: i32) -> EcsSteppingDeepS {
    let cnt = d0.so_count;
    if cnt <= 0 { return d0; };
    let d1 = _ecs_stepping_deep_remove_from_order_scan(d0, 0, cnt, label, 0);
    return d1;
}

// Rebuild the schedule_order in-place: walk 0..cnt; each matching label skipped; others written
// compactly at the running write index. Returns the compacted EcsSteppingDeepS with so_count fixed.
fn _ecs_stepping_deep_remove_from_order_scan(d0: EcsSteppingDeepS, k: i32, cnt: i32, label: i32, wpos: i32) -> EcsSteppingDeepS {
    if k >= cnt {
        // Clear freed tail slots (wpos..cnt-1) and set so_count = wpos.
        let dc = _ecs_stepping_deep_order_clear_tail(d0, wpos, cnt);
        dc.so_count = wpos;
        return dc;
    };
    let v = _ecs_stepping_deep_so_at(d0, k);
    if v == label {
        return _ecs_stepping_deep_remove_from_order_scan(d0, k + 1, cnt, label, wpos);
    };
    let d1 = _ecs_stepping_deep_set_so_at(d0, wpos, v);
    return _ecs_stepping_deep_remove_from_order_scan(d1, k + 1, cnt, label, wpos + 1);
}

fn _ecs_stepping_deep_order_clear_tail(d0: EcsSteppingDeepS, from: i32, to: i32) -> EcsSteppingDeepS {
    if from >= to { return d0; };
    let d1 = _ecs_stepping_deep_set_so_at(d0, from, -1);
    return _ecs_stepping_deep_order_clear_tail(d1, from + 1, to);
}

// ════════════════════════════════════════════════════════════════════════════
// Batch 382 continuation: next_frame / begin_frame / schedules / cursor /
// skipped_systems + wrapper structs (EcsStepSchedulesDeep / EcsStepCursorDeep /
// EcsStepSkippedDeep) + EcsStepSkipAccDeep walker accumulator.
//
// Mirrors Bevy src/schedule/stepping.rs (next_frame / skipped_systems /
// ScheduleState::skipped_systems) using fixed-cap storage + cascade-of-return.
// No Vec, no `let mut`, no tuple-return in tests, no `let w = fn(w,...)` rebind.
// Walk the cap-16 system indices via simple recursive read-only i32 dispatch
// (Batch 381 finding) on an accumulator struct; accumulator field-assigns are at
// top-level function scope (Batch 374) and inside plain `if`-guards that lead
// directly to `return` (cascade-of-return, Batch 377) -- never inside `while`.
// ════════════════════════════════════════════════════════════════════════════

// schedule_order insert-at helper (cap-8 compact). Returns updated EcsSteppingDeepS
// with label inserted at `pos` (other items shifted right; overflow drops the tail).
fn _ecs_stepping_deep_insert_order_at(d0: EcsSteppingDeepS, pos: i32, label: i32) -> EcsSteppingDeepS {
    if pos < 0 { return d0; };
    let cnt = d0.so_count;
    // Cap clamp: maximum stored is cap-8; if already full, reject silent (Bevy insert still works on unbounded Vec, but our fixed cap can't).
    if cnt >= ECS_STEP_CAP_SCHEDULES { return d0; };
    // Insert position beyond count: treat as append.
    if pos >= cnt {
        let d1 = _ecs_stepping_deep_set_so_at(d0, cnt, label);
        d1.so_count = d1.so_count + 1;
        return d1;
    };
    // Shift right by one from cnt-1 down to pos; then write label at pos; bump so_count.
    let d1 = _ecs_stepping_deep_insert_shift(d0, cnt - 1, pos);
    let d2 = _ecs_stepping_deep_set_so_at(d1, pos, label);
    d2.so_count = d2.so_count + 1;
    return d2;
}

// Shift one-past-tail item from src=k to dst=k+1 for k from `from` down to `pos`.
fn _ecs_stepping_deep_insert_shift(d0: EcsSteppingDeepS, k: i32, pos: i32) -> EcsSteppingDeepS {
    if k < pos { return d0; };
    let v = _ecs_stepping_deep_so_at(d0, k);
    let d1 = _ecs_stepping_deep_set_so_at(d0, k + 1, v);
    return _ecs_stepping_deep_insert_shift(d1, k - 1, pos);
}

// ── schedules()/cursor()/skipped_systems() result wrappers (Batch 373 rule) ──
struct EcsStepSchedulesDeep {
    valid: bool,
    l0: i32, l1: i32, l2: i32, l3: i32, l4: i32, l5: i32, l6: i32, l7: i32,
    count: i32,
}

fn ecs_stepping_deep_schedules_valid_s(r: EcsStepSchedulesDeep) -> bool { return r.valid; }
fn ecs_stepping_deep_schedules_count_s(r: EcsStepSchedulesDeep) -> i32 { return r.count; }
fn ecs_stepping_deep_schedules_at_s(r: EcsStepSchedulesDeep, idx: i32) -> i32 {
    if idx == 0 { return r.l0; };
    if idx == 1 { return r.l1; };
    if idx == 2 { return r.l2; };
    if idx == 3 { return r.l3; };
    if idx == 4 { return r.l4; };
    if idx == 5 { return r.l5; };
    if idx == 6 { return r.l6; };
    if idx == 7 { return r.l7; };
    return -1;
}

struct EcsStepCursorDeep {
    valid: bool,
    label: i32,
    system_idx: i32,
}

fn ecs_stepping_deep_cursor_valid_s(r: EcsStepCursorDeep) -> bool { return r.valid; }
fn ecs_stepping_deep_cursor_label_s(r: EcsStepCursorDeep) -> i32 { return r.label; }
fn ecs_stepping_deep_cursor_system_s(r: EcsStepCursorDeep) -> i32 { return r.system_idx; }

struct EcsStepSkippedDeep {
    valid: bool,
    skip_count: i32,
    next_system: i32,
    f0: i32, f1: i32, f2: i32, f3: i32, f4: i32, f5: i32, f6: i32, f7: i32,
    f8: i32, f9: i32, f10: i32, f11: i32, f12: i32, f13: i32, f14: i32, f15: i32,
}

fn ecs_stepping_deep_skipped_valid_s(r: EcsStepSkippedDeep) -> bool { return r.valid; }
fn ecs_stepping_deep_skipped_count_s(r: EcsStepSkippedDeep) -> i32 { return r.skip_count; }
fn ecs_stepping_deep_skipped_next_s(r: EcsStepSkippedDeep) -> i32 { return r.next_system; }
fn ecs_stepping_deep_skipped_at_s(r: EcsStepSkippedDeep, idx: i32) -> bool {
    if idx == 0 { return r.f0 == 1; };
    if idx == 1 { return r.f1 == 1; };
    if idx == 2 { return r.f2 == 1; };
    if idx == 3 { return r.f3 == 1; };
    if idx == 4 { return r.f4 == 1; };
    if idx == 5 { return r.f5 == 1; };
    if idx == 6 { return r.f6 == 1; };
    if idx == 7 { return r.f7 == 1; };
    if idx == 8 { return r.f8 == 1; };
    if idx == 9 { return r.f9 == 1; };
    if idx == 10 { return r.f10 == 1; };
    if idx == 11 { return r.f11 == 1; };
    if idx == 12 { return r.f12 == 1; };
    if idx == 13 { return r.f13 == 1; };
    if idx == 14 { return r.f14 == 1; };
    if idx == 15 { return r.f15 == 1; };
    return false;
}

// ── Skipped-systems walker accumulator (cap-16 skip flags + thread state) ─────
struct EcsStepSkipAccDeep {
    is_cursor: i32,    // 1 if cursor schedule, 0 otherwise (waiting-only walk).
    pos: i32,          // running cursor position within schedule.
    start: i32,        // start position (cursor.system for cursor schedule; 0 else).
    local_action: i32, // running action (stepped from d.action for cursor; Waiting for non-cursor).
    cursor_sys: i32,   // capturing original cursor.system (for non-cursor next_system).
    next_sys: i32,     // finalized next_system index (-1 if past end).
    skip_count: i32,   // count of systems flagged for skip.
    f0: i32, f1: i32, f2: i32, f3: i32, f4: i32, f5: i32, f6: i32, f7: i32,
    f8: i32, f9: i32, f10: i32, f11: i32, f12: i32, f13: i32, f14: i32, f15: i32,
}

fn _ecs_stepping_deep_skip_acc_new(is_cursor: i32, pos: i32, start: i32, local_action: i32, cursor_sys: i32) -> EcsStepSkipAccDeep {
    let a = EcsStepSkipAccDeep {
        is_cursor: is_cursor,
        pos: pos,
        start: start,
        local_action: local_action,
        cursor_sys: cursor_sys,
        next_sys: -1,
        skip_count: 0,
        f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0,
        f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0,
    };
    return a;
}

// per-slot flag writer (cascade-of-return, Batch 377 shape).
fn _ecs_stepping_deep_skip_acc_set_flag(acc: EcsStepSkipAccDeep, idx: i32, flag: i32) -> EcsStepSkipAccDeep {
    if idx == 0 { acc.f0 = flag; return acc; };
    if idx == 1 { acc.f1 = flag; return acc; };
    if idx == 2 { acc.f2 = flag; return acc; };
    if idx == 3 { acc.f3 = flag; return acc; };
    if idx == 4 { acc.f4 = flag; return acc; };
    if idx == 5 { acc.f5 = flag; return acc; };
    if idx == 6 { acc.f6 = flag; return acc; };
    if idx == 7 { acc.f7 = flag; return acc; };
    if idx == 8 { acc.f8 = flag; return acc; };
    if idx == 9 { acc.f9 = flag; return acc; };
    if idx == 10 { acc.f10 = flag; return acc; };
    if idx == 11 { acc.f11 = flag; return acc; };
    if idx == 12 { acc.f12 = flag; return acc; };
    if idx == 13 { acc.f13 = flag; return acc; };
    if idx == 14 { acc.f14 = flag; return acc; };
    acc.f15 = flag;
    return acc;
}

fn _ecs_stepping_deep_skip_acc_set_pos(acc: EcsStepSkipAccDeep, v: i32) -> EcsStepSkipAccDeep { acc.pos = v; return acc; }
fn _ecs_stepping_deep_skip_acc_set_la(acc: EcsStepSkipAccDeep, v: i32) -> EcsStepSkipAccDeep { acc.local_action = v; return acc; }
fn _ecs_stepping_deep_skip_acc_set_next(acc: EcsStepSkipAccDeep, v: i32) -> EcsStepSkipAccDeep { acc.next_sys = v; return acc; }
fn _ecs_stepping_deep_skip_acc_set_skipcount(acc: EcsStepSkipAccDeep, v: i32) -> EcsStepSkipAccDeep { acc.skip_count = v; return acc; }

// ── per-system skip flag (mirrors Bevy (action, behavior) dispatch) ──────────
// 1 = skip system i, 0 = run it.
fn _ecs_stepping_deep_step_skip_flag(acc: EcsStepSkipAccDeep, i: i32, beh: i32) -> i32 {
    if beh == ECS_SB_NEVER_RUN_D { return 1; };
    if beh == ECS_SB_ALWAYS_RUN_D { return 0; };
    // Non-cursor schedule: action == Waiting forced; AllRun/AlwaysRun already handled.
    if acc.is_cursor != 1 { return 1; };
    let la = acc.local_action;
    if la == ECS_STEPPING_ACTION_WAITING_D { return 1; };
    if la == ECS_STEPPING_ACTION_STEP_D {
        if i < acc.pos { return 1; };
        if i == acc.pos { return 0; };
        return 1; // i > pos unreachable in Bevy; skip for safety.
    };
    if la == ECS_STEPPING_ACTION_CONTINUE_D {
        if beh == ECS_SB_CONTINUE_D {
            if i < acc.start { return 1; };
            return 0;
        };
        // Break
        if i != acc.start { return 1; };
        return 0;
    };
    return 0;
}

// ── per-system running action update (mirrors Bevy `(action, behavior)` action assignments) ──
fn _ecs_stepping_deep_step_skip_la(acc: EcsStepSkipAccDeep, i: i32, beh: i32) -> i32 {
    if acc.is_cursor != 1 { return acc.local_action; };
    let la = acc.local_action;
    if beh == ECS_SB_NEVER_RUN_D { return la; };
    if beh == ECS_SB_ALWAYS_RUN_D { return la; };
    if la == ECS_STEPPING_ACTION_WAITING_D { return la; };
    if la == ECS_STEPPING_ACTION_STEP_D {
        if i == acc.pos { return ECS_STEPPING_ACTION_WAITING_D; };
        return la;
    };
    if la == ECS_STEPPING_ACTION_CONTINUE_D {
        if beh == ECS_SB_BREAK_D {
            if i > acc.start { return ECS_STEPPING_ACTION_WAITING_D; };
        };
        return la;
    };
    return la;
}

// ── per-system pos update from fan-out branch (Bevy `if i == pos { pos += 1 }`) ──
fn _ecs_stepping_deep_step_skip_pos(acc: EcsStepSkipAccDeep, i: i32, beh: i32) -> i32 {
    if acc.is_cursor != 1 { return acc.pos; };
    let la = acc.local_action;
    let pos = acc.pos;
    if beh == ECS_SB_NEVER_RUN_D {
        if i == pos { return pos + 1; };
        return pos;
    };
    if beh == ECS_SB_ALWAYS_RUN_D {
        if i == pos { return pos + 1; };
        return pos;
    };
    if la == ECS_STEPPING_ACTION_WAITING_D { return pos; };
    if la == ECS_STEPPING_ACTION_STEP_D {
        if i == pos { return pos + 1; };
        return pos;
    };
    // Continue (+ Continue/Break): branch never mutates pos; tail rule below handles cursor advance.
    return pos;
}

// Tail rule: after per-branch dispatch, if i==pos && local_action != Waiting, pos += 1.
// Uses the branch-updated pos and local_action.
fn _ecs_stepping_deep_step_tail_pos(acc: EcsStepSkipAccDeep, i: i32, new_pos: i32, new_la: i32) -> i32 {
    if acc.is_cursor != 1 { return new_pos; };
    if i == new_pos {
        if new_la != ECS_STEPPING_ACTION_WAITING_D { return new_pos + 1; };
    };
    return new_pos;
}

// Recursive walker: process system index `i`, return final accumulator (cap-16).
// Simple recursive read-only i32 dispatch (Batch 381 finding) -- accumulator field-assigns
// happen via cascade-of-return helpers at top-level function scope, never inside `if`/`while`.
fn _ecs_stepping_deep_step_skip_walk(acc0: EcsStepSkipAccDeep, i: i32, n: i32, st: EcsSteppingScheduleStateDeepS) -> EcsStepSkipAccDeep {
    if i >= n {
        // epilog: finalize next_sys
        if acc0.is_cursor != 1 {
            return _ecs_stepping_deep_skip_acc_set_next(acc0, acc0.cursor_sys);
        };
        if acc0.pos >= n {
            return _ecs_stepping_deep_skip_acc_set_next(acc0, -1);
        };
        if acc0.pos < 0 {
            return _ecs_stepping_deep_skip_acc_set_next(acc0, -1);
        };
        return _ecs_stepping_deep_skip_acc_set_next(acc0, acc0.pos);
    };
    let beh = ecs_stepping_deep_state_behavior_at_s(st, i);
    let skip_flag = _ecs_stepping_deep_step_skip_flag(acc0, i, beh);
    let new_la = _ecs_stepping_deep_step_skip_la(acc0, i, beh);
    let new_pos = _ecs_stepping_deep_step_skip_pos(acc0, i, beh);
    let tail_pos = _ecs_stepping_deep_step_tail_pos(acc0, i, new_pos, new_la);
    let acc1 = _ecs_stepping_deep_skip_acc_set_flag(acc0, i, skip_flag);
    let acc2 = _ecs_stepping_deep_skip_acc_set_pos(acc1, tail_pos);
    let acc3 = _ecs_stepping_deep_skip_acc_set_la(acc2, new_la);
    let acc4 = _ecs_stepping_deep_skip_acc_set_skipcount(acc3, acc3.skip_count + skip_flag);
    return _ecs_stepping_deep_step_skip_walk(acc4, i + 1, n, st);
}

// ── apply_behavior_updates: drain pending behavior_updates u0..15 into b0..15 ──
fn ecs_stepping_deep_state_apply_updates_s(st0: EcsSteppingScheduleStateDeepS) -> EcsSteppingScheduleStateDeepS {
    if st0.has_pending_updates != 1 { return st0; };
    // Clear the has_pending_updates flag + first-field (mirror shallow)
    let st1 = _ecs_stepping_deep_state_drain_one_s(st0, 0);
    st1.has_pending_updates = 0;
    st1.first = -1;
    return st1;
}

// Drain a single behavior_update slot k into b[k]; -1 = reset to Continue; >= 0 = set behavior; then clear u[k] = -1.
fn _ecs_stepping_deep_state_drain_one_s(st0: EcsSteppingScheduleStateDeepS, k: i32) -> EcsSteppingScheduleStateDeepS {
    if k >= ECS_STEP_CAP_SYSTEMS { return st0; };
    let upd = _ecs_stepping_deep_state_update_at_s(st0, k);
    let st1 = _ecs_stepping_deep_state_drain_apply_s(st0, k, upd);
    let st2 = _ecs_stepping_deep_state_set_update_s(st1, k, -1);
    return _ecs_stepping_deep_state_drain_one_s(st2, k + 1);
}

// Apply a single behavior update value at slot k (cascade-of-return).
fn _ecs_stepping_deep_state_drain_apply_s(st0: EcsSteppingScheduleStateDeepS, k: i32, upd: i32) -> EcsSteppingScheduleStateDeepS {
    // -1 = clear (reset to Continue); >= 0 = set behavior.
    if upd == -1 { return ecs_stepping_deep_state_clear_behavior_s(st0, k); };
    if upd >= 0 { return ecs_stepping_deep_state_set_behavior_s(st0, k, upd); };
    return st0;
}

// Read the queued pending behavior update at slot k.
fn _ecs_stepping_deep_state_update_at_s(st: EcsSteppingScheduleStateDeepS, k: i32) -> i32 {
    if k == 0 { return st.u0; };
    if k == 1 { return st.u1; };
    if k == 2 { return st.u2; };
    if k == 3 { return st.u3; };
    if k == 4 { return st.u4; };
    if k == 5 { return st.u5; };
    if k == 6 { return st.u6; };
    if k == 7 { return st.u7; };
    if k == 8 { return st.u8; };
    if k == 9 { return st.u9; };
    if k == 10 { return st.u10; };
    if k == 11 { return st.u11; };
    if k == 12 { return st.u12; };
    if k == 13 { return st.u13; };
    if k == 14 { return st.u14; };
    return st.u15;
}

// Set the queued pending behavior update at slot k (cascade-of-return).
fn _ecs_stepping_deep_state_set_update_s(st0: EcsSteppingScheduleStateDeepS, k: i32, v: i32) -> EcsSteppingScheduleStateDeepS {
    if k == 0 { st0.u0 = v; return st0; };
    if k == 1 { st0.u1 = v; return st0; };
    if k == 2 { st0.u2 = v; return st0; };
    if k == 3 { st0.u3 = v; return st0; };
    if k == 4 { st0.u4 = v; return st0; };
    if k == 5 { st0.u5 = v; return st0; };
    if k == 6 { st0.u6 = v; return st0; };
    if k == 7 { st0.u7 = v; return st0; };
    if k == 8 { st0.u8 = v; return st0; };
    if k == 9 { st0.u9 = v; return st0; };
    if k == 10 { st0.u10 = v; return st0; };
    if k == 11 { st0.u11 = v; return st0; };
    if k == 12 { st0.u12 = v; return st0; };
    if k == 13 { st0.u13 = v; return st0; };
    if k == 14 { st0.u14 = v; return st0; };
    st0.u15 = v;
    return st0;
}

// _set_behavior / _clear_behavior both set has_pending_updates=1 so apply_updates drains next skipped pass.
fn _ecs_stepping_deep_state_mark_pending_s(st0: EcsSteppingScheduleStateDeepS, k: i32, v: i32) -> EcsSteppingScheduleStateDeepS {
    let st1 = _ecs_stepping_deep_state_set_update_s(st0, k, v);
    st1.has_pending_updates = 1;
    return st1;
}

// grow state's node_count to system_count (mirror Bevy ScheduleState node_ids clone-from schedule,
// here just ensuring node_count matches). Can only grow; cap at ECS_STEP_CAP_SYSTEMS.
fn _ecs_stepping_deep_state_resize_s(st0: EcsSteppingScheduleStateDeepS, system_count: i32) -> EcsSteppingScheduleStateDeepS {
    if system_count <= st0.node_count {
        let st1 = _ecs_stepping_deep_state_set_node_count_s(st0, system_count);
        return st1;
    };
    let st1 = _ecs_stepping_deep_state_set_node_count_s(st0, system_count);
    return st1;
}

fn _ecs_stepping_deep_state_set_node_count_s(st0: EcsSteppingScheduleStateDeepS, v: i32) -> EcsSteppingScheduleStateDeepS {
    if v > ECS_STEP_CAP_SYSTEMS {
        st0.node_count = ECS_STEP_CAP_SYSTEMS;
        return st0;
    };
    st0.node_count = v;
    return st0;
}

// ── next_frame: apply queued updates via flat 8-slot let-ladder (Batch 378 rule) ──
// Pre-step: if action != RunAll, set action=Waiting, previous_schedule=-1, and if cursor_schedule
// >= so_count, reset_cursor. Set initialized=1. Apply updates in queue order; clear update_count
// at the end; if reset_cursor flag was set, reset_cursor.
fn ecs_stepping_deep_next_frame_s(d_in: EcsSteppingDeepS) -> EcsSteppingDeepS {
    // Pre-step: initialized=1
    let d0 = d_in;
    d0.initialized = 1;
    // If action != RunAll, reset action to Waiting, previous_schedule to -1, and reset cursor if so_count reached.
    let d1 = _ecs_stepping_deep_next_frame_prelude(d0);
    // Early exit if no updates queued.
    if d1.update_count <= 0 { return d1; };
    // Apply updates via flat 8-slot ladder threading mut_reset_cursor as i32 flag.
    let a0 = _ecs_stepping_deep_apply_result_new(d1, 0);
    let a1 = _ecs_stepping_deep_next_frame_apply_slot(a0, 0, d1);
    let a2 = _ecs_stepping_deep_next_frame_apply_slot(a1, 1, d1);
    let a3 = _ecs_stepping_deep_next_frame_apply_slot(a2, 2, d1);
    let a4 = _ecs_stepping_deep_next_frame_apply_slot(a3, 3, d1);
    let a5 = _ecs_stepping_deep_next_frame_apply_slot(a4, 4, d1);
    let a6 = _ecs_stepping_deep_next_frame_apply_slot(a5, 5, d1);
    let a7 = _ecs_stepping_deep_next_frame_apply_slot(a6, 6, d1);
    let a8 = _ecs_stepping_deep_next_frame_apply_slot(a7, 7, d1);
    // Clear wraparound: a8 has the final d plus the final reset_cursor flag.
    let d_final = a8.d;
    let flag_final = a8.flag;
    d_final.update_count = 0;
    if flag_final == 1 {
        let d_reset = ecs_stepping_deep_reset_cursor_s(d_final);
        return d_reset;
    };
    return d_final;
}

// Prelude: if action != RunAll, set action=Waiting, previous_schedule=-1, reset cursor if so_count reached.
fn _ecs_stepping_deep_next_frame_prelude(d0: EcsSteppingDeepS) -> EcsSteppingDeepS {
    if d0.action == ECS_STEPPING_ACTION_RUN_ALL_D { return d0; };
    d0.action = ECS_STEPPING_ACTION_WAITING_D;
    d0.previous_schedule = -1;
    if d0.cursor_schedule >= d0.so_count {
        let d1 = ecs_stepping_deep_reset_cursor_s(d0);
        return d1;
    };
    return d0;
}

// Apply result bundles the threading d + the running reset_cursor flag (Batch 373 rule -- no tuple destructuring).
struct EcsSteppingNextFrameApplyDeep {
    d: EcsSteppingDeepS,
    flag: i32,
}

fn _ecs_stepping_deep_apply_result_new(d: EcsSteppingDeepS, flag: i32) -> EcsSteppingNextFrameApplyDeep {
    let a = EcsSteppingNextFrameApplyDeep { d: d, flag: flag };
    return a;
}

// Apply slot k (if update_count > k) of the queued updates ladder.
fn _ecs_stepping_deep_next_frame_apply_slot(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    if d_orig.update_count <= k { return a_in; };
    let variant = _ecs_stepping_deep_uv_at(d_orig, k);
    return _ecs_stepping_deep_next_frame_apply_variant(a_in, variant, k, d_orig);
}

// Dispatch on the update variant; thread the reset_cursor flag.
fn _ecs_stepping_deep_next_frame_apply_variant(a_in: EcsSteppingNextFrameApplyDeep, variant: i32, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    if variant == ECS_STEPPING_UPDATE_SET_ACTION_D {
        return _ecs_stepping_deep_next_frame_apply_set_action(a_in, k, d_orig);
    };
    if variant == ECS_STEPPING_UPDATE_ADD_SCHEDULE_D {
        return _ecs_stepping_deep_next_frame_apply_add_schedule(a_in, k, d_orig);
    };
    if variant == ECS_STEPPING_UPDATE_REMOVE_SCHEDULE_D {
        return _ecs_stepping_deep_next_frame_apply_remove_schedule(a_in, k, d_orig);
    };
    if variant == ECS_STEPPING_UPDATE_CLEAR_SCHEDULE_D {
        return _ecs_stepping_deep_next_frame_apply_clear_schedule(a_in, k, d_orig);
    };
    if variant == ECS_STEPPING_UPDATE_SET_BEHAVIOR_D {
        return _ecs_stepping_deep_next_frame_apply_set_behavior(a_in, k, d_orig);
    };
    if variant == ECS_STEPPING_UPDATE_CLEAR_BEHAVIOR_D {
        return _ecs_stepping_deep_next_frame_apply_clear_behavior(a_in, k, d_orig);
    };
    return a_in;
}

// Read-only first-step init helper: returns the input apply result unchanged when the slot count is below the index
// (kept for symmetry with the ladder convention)
fn _ecs_stepping_deep_next_frame_step(d: EcsSteppingDeepS, k: i32) -> EcsSteppingDeepS {
    return d;
}

fn _ecs_stepping_deep_next_frame_apply_set_action(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    let target = _ecs_stepping_deep_ua_at(d_orig, k);
    let d_prev = a_in.d;
    let flag_prev = a_in.flag;
    if target == ECS_STEPPING_ACTION_RUN_ALL_D {
        let d1 = _ecs_stepping_deep_set_action_field(d_prev, ECS_STEPPING_ACTION_RUN_ALL_D);
        return _ecs_stepping_deep_apply_result_new(d1, 1);
    };
    let cur = d_prev.action;
    let skip = _ecs_stepping_deep_should_skip_action(cur, target);
    if skip == 1 { return a_in; };
    let d1 = _ecs_stepping_deep_set_action_field(d_prev, target);
    return _ecs_stepping_deep_apply_result_new(d1, flag_prev);
}

fn _ecs_stepping_deep_set_action_field(d: EcsSteppingDeepS, v: i32) -> EcsSteppingDeepS {
    d.action = v;
    return d;
}

fn _ecs_stepping_deep_next_frame_apply_add_schedule(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    let label = _ecs_stepping_deep_ua_at(d_orig, k);
    let d_prev = a_in.d;
    // Append state + bump st_count + append order (cap-8 reject silent).
    let d1 = _ecs_stepping_deep_append_state(d_prev, label);
    let d2 = _ecs_stepping_deep_inc_st_count(d1);
    let d3 = _ecs_stepping_deep_append_order(d2, label);
    return _ecs_stepping_deep_apply_result_new(d3, a_in.flag);
}

fn _ecs_stepping_deep_next_frame_apply_remove_schedule(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    let label = _ecs_stepping_deep_ua_at(d_orig, k);
    let d_prev = a_in.d;
    let si = _ecs_stepping_deep_state_index_s(d_prev, label);
    let d1 = _ecs_stepping_deep_remove_state_if(d_prev, si);
    let d2 = _ecs_stepping_deep_remove_from_order(d1, label);
    return _ecs_stepping_deep_apply_result_new(d2, 1);
}

fn _ecs_stepping_deep_remove_state_if(d0: EcsSteppingDeepS, si: i32) -> EcsSteppingDeepS {
    if si < 0 { return d0; };
    return _ecs_stepping_deep_remove_state(d0, si);
}

fn _ecs_stepping_deep_next_frame_apply_clear_schedule(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    let label = _ecs_stepping_deep_ua_at(d_orig, k);
    let d_prev = a_in.d;
    let si = _ecs_stepping_deep_state_index_s(d_prev, label);
    if si < 0 { return a_in; };
    let st = _ecs_stepping_deep_state_at(d_prev, si);
    let st1 = ecs_stepping_deep_state_clear_all_s(st);
    let d1 = _ecs_stepping_deep_set_state(d_prev, si, st1);
    return _ecs_stepping_deep_apply_result_new(d1, a_in.flag);
}

fn _ecs_stepping_deep_next_frame_apply_set_behavior(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    let label = _ecs_stepping_deep_ua_at(d_orig, k);
    let sid_kind = _ecs_stepping_deep_uk_at(d_orig, k);
    let sid_id = _ecs_stepping_deep_ui_at(d_orig, k);
    let beh = _ecs_stepping_deep_ub_at(d_orig, k);
    let d_prev = a_in.d;
    if sid_kind != ECS_SID_NODE_D { return a_in; };
    let si = _ecs_stepping_deep_state_index_s(d_prev, label);
    if si < 0 { return a_in; };
    let st = _ecs_stepping_deep_state_at(d_prev, si);
    let st1 = _ecs_stepping_deep_state_mark_pending_s(st, sid_id, beh);
    let d1 = _ecs_stepping_deep_set_state(d_prev, si, st1);
    return _ecs_stepping_deep_apply_result_new(d1, a_in.flag);
}

fn _ecs_stepping_deep_next_frame_apply_clear_behavior(a_in: EcsSteppingNextFrameApplyDeep, k: i32, d_orig: EcsSteppingDeepS) -> EcsSteppingNextFrameApplyDeep {
    let label = _ecs_stepping_deep_ua_at(d_orig, k);
    let sid_kind = _ecs_stepping_deep_uk_at(d_orig, k);
    let sid_id = _ecs_stepping_deep_ui_at(d_orig, k);
    let d_prev = a_in.d;
    if sid_kind != ECS_SID_NODE_D { return a_in; };
    let si = _ecs_stepping_deep_state_index_s(d_prev, label);
    if si < 0 { return a_in; };
    let st = _ecs_stepping_deep_state_at(d_prev, si);
    // Clear: queue a reset-to-Continue by enqueueing -1 in the behavior_updates for sid_id.
    let st1 = _ecs_stepping_deep_state_set_update_s(st, sid_id, -1);
    st1.has_pending_updates = 1;
    st1.first = -1;
    let d1 = _ecs_stepping_deep_set_state(d_prev, si, st1);
    return _ecs_stepping_deep_apply_result_new(d1, a_in.flag);
}

// begin_frame = next_frame.
fn ecs_stepping_deep_begin_frame_s(d: EcsSteppingDeepS) -> EcsSteppingDeepS {
    return ecs_stepping_deep_next_frame_s(d);
}

// schedules(): found when initialized && so_count == st_count; copy so0..so7 into the wrapper.
fn ecs_stepping_deep_schedules_s(d: EcsSteppingDeepS) -> EcsStepSchedulesDeep {
    if d.initialized != 1 {
        return _ecs_stepping_deep_schedules_wrap(false, -1, -1, -1, -1, -1, -1, -1, -1, 0);
    };
    if d.so_count != d.st_count {
        return _ecs_stepping_deep_schedules_wrap(false, -1, -1, -1, -1, -1, -1, -1, -1, 0);
    };
    return _ecs_stepping_deep_schedules_wrap(true, d.so0, d.so1, d.so2, d.so3, d.so4, d.so5, d.so6, d.so7, d.so_count);
}

fn _ecs_stepping_deep_schedules_wrap(valid: bool, l0: i32, l1: i32, l2: i32, l3: i32, l4: i32, l5: i32, l6: i32, l7: i32, count: i32) -> EcsStepSchedulesDeep {
    let r = EcsStepSchedulesDeep {
        valid: valid,
        l0: l0, l1: l1, l2: l2, l3: l3, l4: l4, l5: l5, l6: l6, l7: l7,
        count: count,
    };
    return r;
}

// cursor(): found when action != RunAll && cursor_schedule < so_count && state exists && cursor_system < node_count.
fn ecs_stepping_deep_cursor_s(d: EcsSteppingDeepS) -> EcsStepCursorDeep {
    if d.action == ECS_STEPPING_ACTION_RUN_ALL_D {
        return _ecs_stepping_deep_cursor_wrap(false, 0, 0);
    };
    if d.cursor_schedule >= d.so_count {
        return _ecs_stepping_deep_cursor_wrap(false, 0, 0);
    };
    if d.cursor_schedule < 0 {
        return _ecs_stepping_deep_cursor_wrap(false, 0, 0);
    };
    let lbl = _ecs_stepping_deep_so_at(d, d.cursor_schedule);
    let si = _ecs_stepping_deep_state_index_s(d, lbl);
    if si < 0 {
        return _ecs_stepping_deep_cursor_wrap(false, 0, 0);
    };
    let st = _ecs_stepping_deep_state_at(d, si);
    if d.cursor_system >= st.node_count {
        return _ecs_stepping_deep_cursor_wrap(false, 0, 0);
    };
    if d.cursor_system < 0 {
        return _ecs_stepping_deep_cursor_wrap(false, 0, 0);
    };
    return _ecs_stepping_deep_cursor_wrap(true, lbl, d.cursor_system);
}

fn _ecs_stepping_deep_cursor_wrap(valid: bool, label: i32, system_idx: i32) -> EcsStepCursorDeep {
    let r = EcsStepCursorDeep { valid: valid, label: label, system_idx: system_idx };
    return r;
}

// skipped_systems(): the cursor traversal (mirror Bevy Stepping::skipped_systems +
// ScheduleState::skipped_systems). Returns EcsStepSkippedDeep wrapper.
fn ecs_stepping_deep_skipped_systems_s(d_in: EcsSteppingDeepS, label: i32, system_count: i32) -> EcsSteppingDeepSkippedResultDeep {
    if d_in.action == ECS_STEPPING_ACTION_RUN_ALL_D {
        return _ecs_stepping_deep_skipped_fail(d_in);
    };
    // Find existing order index for this label.
    let order_idx = _ecs_stepping_deep_order_index_s(d_in, label);
    // Insert into schedule_order if not present (cap-8 reject silent).
    let d1 = _ecs_stepping_deep_skipped_insert_order(d_in, label, order_idx);
    // Resolve the new order_idx after potential insertion.
    let order_idx2 = _ecs_stepping_deep_order_index_s(d1, label);
    // Store previous_schedule = order_idx2.
    let d2 = _ecs_stepping_deep_set_previous_schedule_s(d1, order_idx2);
    // Find the state for this label.
    let si = _ecs_stepping_deep_state_index_s(d2, label);
    if si < 0 {
        return _ecs_stepping_deep_skipped_fail(d2);
    };
    // Resize the state to system_count + apply_behavior_updates + compute first if unset.
    let st0 = _ecs_stepping_deep_state_at(d2, si);
    let st1 = _ecs_stepping_deep_state_resize_s(st0, system_count);
    let st2 = ecs_stepping_deep_state_apply_updates_s(st1);
    let st3 = _ecs_stepping_deep_state_compute_first_s(st2);
    // Persist the updated state.
    let d3 = _ecs_stepping_deep_set_state(d2, si, st3);
    // Determine if this is the cursor schedule (order_idx2 == cursor_schedule).
    let is_cursor = _ecs_stepping_deep_is_cursor_schedule(d3, order_idx2);
    // Build the walker accumulator:
    //   is_cursor==1: start = cursor_system, pos = cursor_system, local_action = d.action.
    //   is_cursor==0: start = 0, pos = 0, local_action = Waiting (forced skip-all-non-AlwaysRun).
    let acc0 = _ecs_stepping_deep_skipped_acc_init(d3, is_cursor);
    // Walk systems 0..system_count.
    let n_clamped = _ecs_stepping_deep_clamp_system_count(system_count);
    let acc_final = _ecs_stepping_deep_step_skip_walk(acc0, 0, n_clamped, st3);
    // After Step on the cursor schedule, switch action to Waiting (mirror Bevy self.action = Action::Waiting).
    let d4 = _ecs_stepping_deep_skipped_apply_step_to_waiting(d3, is_cursor);
    // Update cursor based on next_sys.
    let d5 = _ecs_stepping_deep_skipped_update_cursor(d4, is_cursor, acc_final.next_sys);
    // Build the wrapper result.
    return _ecs_stepping_deep_skipped_wrap(d5, true, acc_final);
}

// Wrapper result struct bundling the post-traversal d + the EcsStepSkippedDeep payload.
struct EcsSteppingDeepSkippedResultDeep {
    d: EcsSteppingDeepS,
    skipped: EcsStepSkippedDeep,
}

fn _ecs_stepping_deep_skipped_fail(d_in: EcsSteppingDeepS) -> EcsSteppingDeepSkippedResultDeep {
    let r = EcsStepSkippedDeep {
        valid: false, skip_count: 0, next_system: -1,
        f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0,
        f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0,
    };
    let w = EcsSteppingDeepSkippedResultDeep { d: d_in, skipped: r };
    return w;
}

fn _ecs_stepping_deep_skipped_wrap(d_in: EcsSteppingDeepS, valid: bool, acc: EcsStepSkipAccDeep) -> EcsSteppingDeepSkippedResultDeep {
    let r = EcsStepSkippedDeep {
        valid: valid,
        skip_count: acc.skip_count,
        next_system: acc.next_sys,
        f0: acc.f0, f1: acc.f1, f2: acc.f2, f3: acc.f3, f4: acc.f4, f5: acc.f5, f6: acc.f6, f7: acc.f7,
        f8: acc.f8, f9: acc.f9, f10: acc.f10, f11: acc.f11, f12: acc.f12, f13: acc.f13, f14: acc.f14, f15: acc.f15,
    };
    let w = EcsSteppingDeepSkippedResultDeep { d: d_in, skipped: r };
    return w;
}

// Accessors for the wrapper result.
fn ecs_stepping_deep_skipped_result_d_s(w: EcsSteppingDeepSkippedResultDeep) -> EcsSteppingDeepS { return w.d; }
fn ecs_stepping_deep_skipped_result_skipped_s(w: EcsSteppingDeepSkippedResultDeep) -> EcsStepSkippedDeep { return w.skipped; }

// Find the index of `label` in schedule_order (cap-8); -1 if absent.
fn _ecs_stepping_deep_order_index_s(d: EcsSteppingDeepS, label: i32) -> i32 {
    if d.so_count <= 0 { return -1; };
    if d.so0 == label { return 0; };
    if d.so_count > 1 { if d.so1 == label { return 1; }; };
    if d.so_count > 2 { if d.so2 == label { return 2; }; };
    if d.so_count > 3 { if d.so3 == label { return 3; }; };
    if d.so_count > 4 { if d.so4 == label { return 4; }; };
    if d.so_count > 5 { if d.so5 == label { return 5; }; };
    if d.so_count > 6 { if d.so6 == label { return 6; }; };
    if d.so_count > 7 { if d.so7 == label { return 7; }; };
    return -1;
}

// Insert `label` into schedule_order at position determined by previous_schedule (mirror Bevy).
// Bevy: (Some(idx), _) -> idx; (None, None) -> insert(0); (None, Some(last)) -> insert(last + 1).
fn _ecs_stepping_deep_skipped_insert_order(d0: EcsSteppingDeepS, label: i32, existing_idx: i32) -> EcsSteppingDeepS {
    if existing_idx >= 0 { return d0; };
    let prev = d0.previous_schedule;
    if prev < 0 {
        return _ecs_stepping_deep_insert_order_at(d0, 0, label);
    };
    return _ecs_stepping_deep_insert_order_at(d0, prev + 1, label);
}

fn _ecs_stepping_deep_set_previous_schedule_s(d0: EcsSteppingDeepS, v: i32) -> EcsSteppingDeepS {
    d0.previous_schedule = v;
    return d0;
}

// compute_first: first steppable (Continue/Break) index 0..node_count; -1 if none.
fn _ecs_stepping_deep_state_compute_first_s(st: EcsSteppingScheduleStateDeepS) -> EcsSteppingScheduleStateDeepS {
    if st.first >= 0 { return st; };
    let f = _ecs_stepping_deep_first_step_s(st);
    let st1 = _ecs_stepping_deep_state_set_first_s(st, f);
    return st1;
}

fn _ecs_stepping_deep_state_set_first_s(st0: EcsSteppingScheduleStateDeepS, v: i32) -> EcsSteppingScheduleStateDeepS {
    st0.first = v;
    return st0;
}

// Recursive read-only scan for first steppable index (Batch 381 finding -- pure i32 recursion OK).
fn _ecs_stepping_deep_first_step_s(st: EcsSteppingScheduleStateDeepS) -> i32 {
    return _ecs_stepping_deep_first_step_scan_s(st, 0, st.node_count);
}

fn _ecs_stepping_deep_first_step_scan_s(st: EcsSteppingScheduleStateDeepS, i: i32, n: i32) -> i32 {
    if i >= n { return -1; };
    let beh = ecs_stepping_deep_state_behavior_at_s(st, i);
    if beh == ECS_SB_ALWAYS_RUN_D {
        return _ecs_stepping_deep_first_step_scan_s(st, i + 1, n);
    };
    if beh == ECS_SB_NEVER_RUN_D {
        return _ecs_stepping_deep_first_step_scan_s(st, i + 1, n);
    };
    return i;
}

fn _ecs_stepping_deep_is_cursor_schedule(d: EcsSteppingDeepS, order_idx: i32) -> i32 {
    if order_idx == d.cursor_schedule { return 1; };
    return 0;
}

// Initialize the walker accumulator based on whether this is the cursor schedule.
fn _ecs_stepping_deep_skipped_acc_init(d: EcsSteppingDeepS, is_cursor: i32) -> EcsStepSkipAccDeep {
    if is_cursor != 1 {
        return _ecs_stepping_deep_skip_acc_new(0, 0, 0, ECS_STEPPING_ACTION_WAITING_D, d.cursor_system);
    };
    return _ecs_stepping_deep_skip_acc_new(1, d.cursor_system, d.cursor_system, d.action, d.cursor_system);
}

// After a Step on the cursor schedule, switch action to Waiting (mirror Bevy).
fn _ecs_stepping_deep_skipped_apply_step_to_waiting(d0: EcsSteppingDeepS, is_cursor: i32) -> EcsSteppingDeepS {
    if is_cursor != 1 { return d0; };
    if d0.action != ECS_STEPPING_ACTION_STEP_D { return d0; };
    d0.action = ECS_STEPPING_ACTION_WAITING_D;
    return d0;
}

// Update the cursor based on next_sys:
//   next_sys >= 0 -> cursor_system = next_sys
//   next_sys < 0  -> cursor_schedule += 1, cursor_system = first_system(cursor_schedule)
fn _ecs_stepping_deep_skipped_update_cursor(d0: EcsSteppingDeepS, is_cursor: i32, next_sys: i32) -> EcsSteppingDeepS {
    if is_cursor != 1 { return d0; };
    if next_sys >= 0 {
        d0.cursor_system = next_sys;
        return d0;
    };
    let next_schedule = d0.cursor_schedule + 1;
    d0.cursor_schedule = next_schedule;
    d0.cursor_system = _ecs_stepping_deep_first_system_s(d0, next_schedule);
    return d0;
}

fn _ecs_stepping_deep_clamp_system_count(n: i32) -> i32 {
    if n < 0 { return 0; };
    if n > ECS_STEP_CAP_SYSTEMS { return ECS_STEP_CAP_SYSTEMS; };
    return n;
}
