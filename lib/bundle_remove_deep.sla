// Deepened Bevy ECS bundle remove surface.
// Mirrors src/bundle/remove.rs:
//   BundleRemover::new / new_with_id (require_all / intersection)
//   empty_pre_remove, remove with pre_remove callback
//   sorted_remove for table/sparse component lists
//   BundleInfo::remove_bundle_from_archetype edge cache (remove vs take)
//   table move when table components change; ArchetypeCreated flag
// Shallow lib/bundle_remove.sla retained.

// === Storage types ===
const ECS_BR_TABLE: i32 = 0;
const ECS_BR_SPARSE: i32 = 1;

fn ecs_br_storage_table() -> i32 { return ECS_BR_TABLE; }
fn ecs_br_storage_sparse() -> i32 { return ECS_BR_SPARSE; }

// === sorted_remove (stable retain vs sorted remove list) ===
// Fixed capacity 8 source list modeled as struct
struct EcsBrI32ListDeep {
    v0: i32, v1: i32, v2: i32, v3: i32,
    v4: i32, v5: i32, v6: i32, v7: i32,
    len: i32,
}

fn ecs_br_list_new() -> EcsBrI32ListDeep {
    return EcsBrI32ListDeep {
        v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0, len: 0,
    };
}

fn ecs_br_list_len(l: EcsBrI32ListDeep) -> i32 { return l.len; }

fn ecs_br_list_at(l: EcsBrI32ListDeep, idx: i32) -> i32 {
    if idx == 0 { return l.v0; };
    if idx == 1 { return l.v1; };
    if idx == 2 { return l.v2; };
    if idx == 3 { return l.v3; };
    if idx == 4 { return l.v4; };
    if idx == 5 { return l.v5; };
    if idx == 6 { return l.v6; };
    if idx == 7 { return l.v7; };
    return 0;
}

fn ecs_br_list_push(l: EcsBrI32ListDeep, v: i32) -> EcsBrI32ListDeep {
    let n = l.len;
    if n == 0 { return EcsBrI32ListDeep { v0: v, v1: l.v1, v2: l.v2, v3: l.v3, v4: l.v4, v5: l.v5, v6: l.v6, v7: l.v7, len: 1 }; };
    if n == 1 { return EcsBrI32ListDeep { v0: l.v0, v1: v, v2: l.v2, v3: l.v3, v4: l.v4, v5: l.v5, v6: l.v6, v7: l.v7, len: 2 }; };
    if n == 2 { return EcsBrI32ListDeep { v0: l.v0, v1: l.v1, v2: v, v3: l.v3, v4: l.v4, v5: l.v5, v6: l.v6, v7: l.v7, len: 3 }; };
    if n == 3 { return EcsBrI32ListDeep { v0: l.v0, v1: l.v1, v2: l.v2, v3: v, v4: l.v4, v5: l.v5, v6: l.v6, v7: l.v7, len: 4 }; };
    if n == 4 { return EcsBrI32ListDeep { v0: l.v0, v1: l.v1, v2: l.v2, v3: l.v3, v4: v, v5: l.v5, v6: l.v6, v7: l.v7, len: 5 }; };
    if n == 5 { return EcsBrI32ListDeep { v0: l.v0, v1: l.v1, v2: l.v2, v3: l.v3, v4: l.v4, v5: v, v6: l.v6, v7: l.v7, len: 6 }; };
    if n == 6 { return EcsBrI32ListDeep { v0: l.v0, v1: l.v1, v2: l.v2, v3: l.v3, v4: l.v4, v5: l.v5, v6: v, v7: l.v7, len: 7 }; };
    if n == 7 { return EcsBrI32ListDeep { v0: l.v0, v1: l.v1, v2: l.v2, v3: l.v3, v4: l.v4, v5: l.v5, v6: l.v6, v7: v, len: 8 }; };
    return l;
}

fn ecs_br_list_contains(l: EcsBrI32ListDeep, v: i32) -> bool {
    if l.len >= 1 && l.v0 == v { return true; };
    if l.len >= 2 && l.v1 == v { return true; };
    if l.len >= 3 && l.v2 == v { return true; };
    if l.len >= 4 && l.v3 == v { return true; };
    if l.len >= 5 && l.v4 == v { return true; };
    if l.len >= 6 && l.v5 == v { return true; };
    if l.len >= 7 && l.v6 == v { return true; };
    if l.len >= 8 && l.v7 == v { return true; };
    return false;
}

// Bevy sorted_remove: both lists sorted; retain values not in remove
fn ecs_br_sorted_remove(source: EcsBrI32ListDeep, remove: EcsBrI32ListDeep) -> EcsBrI32ListDeep {
    let out = ecs_br_list_new();
    // unrolled for up to 8 source values
    if source.len >= 1 {
        if ecs_br_list_contains(remove, source.v0) != true { out = ecs_br_list_push(out, source.v0); };
    };
    if source.len >= 2 {
        if ecs_br_list_contains(remove, source.v1) != true { out = ecs_br_list_push(out, source.v1); };
    };
    if source.len >= 3 {
        if ecs_br_list_contains(remove, source.v2) != true { out = ecs_br_list_push(out, source.v2); };
    };
    if source.len >= 4 {
        if ecs_br_list_contains(remove, source.v3) != true { out = ecs_br_list_push(out, source.v3); };
    };
    if source.len >= 5 {
        if ecs_br_list_contains(remove, source.v4) != true { out = ecs_br_list_push(out, source.v4); };
    };
    if source.len >= 6 {
        if ecs_br_list_contains(remove, source.v5) != true { out = ecs_br_list_push(out, source.v5); };
    };
    if source.len >= 7 {
        if ecs_br_list_contains(remove, source.v6) != true { out = ecs_br_list_push(out, source.v6); };
    };
    if source.len >= 8 {
        if ecs_br_list_contains(remove, source.v7) != true { out = ecs_br_list_push(out, source.v7); };
    };
    return out;
}

// === Bundle components (explicit) with storage types ===
struct EcsBrBundleDeep {
    id: i32,
    // up to 4 explicit components
    c0: i32, s0: i32,
    c1: i32, s1: i32,
    c2: i32, s2: i32,
    c3: i32, s3: i32,
    len: i32,
}

fn ecs_br_bundle_new(id: i32) -> EcsBrBundleDeep {
    return EcsBrBundleDeep {
        id: id, c0: 0, s0: 0, c1: 0, s1: 0, c2: 0, s2: 0, c3: 0, s3: 0, len: 0,
    };
}

fn ecs_br_bundle_push(b: EcsBrBundleDeep, component: i32, storage: i32) -> EcsBrBundleDeep {
    let n = b.len;
    if n == 0 {
        return EcsBrBundleDeep { id: b.id, c0: component, s0: storage, c1: b.c1, s1: b.s1, c2: b.c2, s2: b.s2, c3: b.c3, s3: b.s3, len: 1 };
    };
    if n == 1 {
        return EcsBrBundleDeep { id: b.id, c0: b.c0, s0: b.s0, c1: component, s1: storage, c2: b.c2, s2: b.s2, c3: b.c3, s3: b.s3, len: 2 };
    };
    if n == 2 {
        return EcsBrBundleDeep { id: b.id, c0: b.c0, s0: b.s0, c1: b.c1, s1: b.s1, c2: component, s2: storage, c3: b.c3, s3: b.s3, len: 3 };
    };
    if n == 3 {
        return EcsBrBundleDeep { id: b.id, c0: b.c0, s0: b.s0, c1: b.c1, s1: b.s1, c2: b.c2, s2: b.s2, c3: component, s3: storage, len: 4 };
    };
    return b;
}

fn ecs_br_bundle_len(b: EcsBrBundleDeep) -> i32 { return b.len; }
fn ecs_br_bundle_id(b: EcsBrBundleDeep) -> i32 { return b.id; }

// === Archetype ===
struct EcsBrArchetypeDeep {
    id: i32,
    table_id: i32,
    table_comps: EcsBrI32ListDeep,
    sparse_comps: EcsBrI32ListDeep,
    // edge cache: remove_edge_bundle_id -> new archetype id (-1 none, -2 invalid take)
    remove_edge_bundle: i32,
    remove_edge_arch: i32,
    remove_edge_valid: bool,
    take_edge_bundle: i32,
    take_edge_arch: i32,
    take_edge_valid: bool,
    take_edge_is_none: bool,
}

fn ecs_br_archetype_new(id: i32, table_id: i32) -> EcsBrArchetypeDeep {
    return EcsBrArchetypeDeep {
        id: id, table_id: table_id,
        table_comps: ecs_br_list_new(),
        sparse_comps: ecs_br_list_new(),
        remove_edge_bundle: -1, remove_edge_arch: -1, remove_edge_valid: false,
        take_edge_bundle: -1, take_edge_arch: -1, take_edge_valid: false, take_edge_is_none: false,
    };
}

fn ecs_br_archetype_add_table(a: EcsBrArchetypeDeep, c: i32) -> EcsBrArchetypeDeep {
    let t = ecs_br_list_push(a.table_comps, c);
    return EcsBrArchetypeDeep {
        id: a.id, table_id: a.table_id, table_comps: t, sparse_comps: a.sparse_comps,
        remove_edge_bundle: a.remove_edge_bundle, remove_edge_arch: a.remove_edge_arch, remove_edge_valid: a.remove_edge_valid,
        take_edge_bundle: a.take_edge_bundle, take_edge_arch: a.take_edge_arch, take_edge_valid: a.take_edge_valid, take_edge_is_none: a.take_edge_is_none,
    };
}

fn ecs_br_archetype_add_sparse(a: EcsBrArchetypeDeep, c: i32) -> EcsBrArchetypeDeep {
    let s = ecs_br_list_push(a.sparse_comps, c);
    return EcsBrArchetypeDeep {
        id: a.id, table_id: a.table_id, table_comps: a.table_comps, sparse_comps: s,
        remove_edge_bundle: a.remove_edge_bundle, remove_edge_arch: a.remove_edge_arch, remove_edge_valid: a.remove_edge_valid,
        take_edge_bundle: a.take_edge_bundle, take_edge_arch: a.take_edge_arch, take_edge_valid: a.take_edge_valid, take_edge_is_none: a.take_edge_is_none,
    };
}

fn ecs_br_archetype_contains(a: EcsBrArchetypeDeep, c: i32) -> bool {
    if ecs_br_list_contains(a.table_comps, c) { return true; };
    if ecs_br_list_contains(a.sparse_comps, c) { return true; };
    return false;
}

fn ecs_br_archetype_id(a: EcsBrArchetypeDeep) -> i32 { return a.id; }
fn ecs_br_archetype_table_id(a: EcsBrArchetypeDeep) -> i32 { return a.table_id; }

// === World with up to 4 archetypes + table id allocator ===
struct EcsBrWorldDeep {
    a0: EcsBrArchetypeDeep, a0_has: bool,
    a1: EcsBrArchetypeDeep, a1_has: bool,
    a2: EcsBrArchetypeDeep, a2_has: bool,
    a3: EcsBrArchetypeDeep, a3_has: bool,
    next_arch_id: i32,
    next_table_id: i32,
    archetype_created_count: i32,
    last_created_arch: i32,
    // lifecycle counters
    discard_triggers: i32,
    remove_triggers: i32,
    on_remove_hooks: i32,
    // entity location
    entity: i64,
    entity_arch: i32,
    entity_alive: bool,
}

fn ecs_br_world_new() -> EcsBrWorldDeep {
    return EcsBrWorldDeep {
        a0: ecs_br_archetype_new(0, 0), a0_has: false,
        a1: ecs_br_archetype_new(0, 0), a1_has: false,
        a2: ecs_br_archetype_new(0, 0), a2_has: false,
        a3: ecs_br_archetype_new(0, 0), a3_has: false,
        next_arch_id: 1, next_table_id: 1,
        archetype_created_count: 0, last_created_arch: -1,
        discard_triggers: 0, remove_triggers: 0, on_remove_hooks: 0,
        entity: 0, entity_arch: 0, entity_alive: false,
    };
}

fn ecs_br_world_spawn(w: EcsBrWorldDeep, entity: i64, arch: EcsBrArchetypeDeep) -> EcsBrWorldDeep {
    w = ecs_br_world_set_arch(w, arch);
    let next_a = w.next_arch_id;
    if arch.id >= next_a { next_a = arch.id + 1; };
    let next_t = w.next_table_id;
    if arch.table_id >= next_t { next_t = arch.table_id + 1; };
    return EcsBrWorldDeep {
        a0: w.a0, a0_has: w.a0_has, a1: w.a1, a1_has: w.a1_has, a2: w.a2, a2_has: w.a2_has, a3: w.a3, a3_has: w.a3_has,
        next_arch_id: next_a, next_table_id: next_t,
        archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
        discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
        entity: entity, entity_arch: arch.id, entity_alive: true,
    };
}

fn ecs_br_world_set_arch(w: EcsBrWorldDeep, a: EcsBrArchetypeDeep) -> EcsBrWorldDeep {
    if w.a0_has != true || w.a0.id == a.id {
        return EcsBrWorldDeep {
            a0: a, a0_has: true, a1: w.a1, a1_has: w.a1_has, a2: w.a2, a2_has: w.a2_has, a3: w.a3, a3_has: w.a3_has,
            next_arch_id: w.next_arch_id, next_table_id: w.next_table_id,
            archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
            discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
            entity: w.entity, entity_arch: w.entity_arch, entity_alive: w.entity_alive,
        };
    };
    if w.a1_has != true || w.a1.id == a.id {
        return EcsBrWorldDeep {
            a0: w.a0, a0_has: w.a0_has, a1: a, a1_has: true, a2: w.a2, a2_has: w.a2_has, a3: w.a3, a3_has: w.a3_has,
            next_arch_id: w.next_arch_id, next_table_id: w.next_table_id,
            archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
            discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
            entity: w.entity, entity_arch: w.entity_arch, entity_alive: w.entity_alive,
        };
    };
    if w.a2_has != true || w.a2.id == a.id {
        return EcsBrWorldDeep {
            a0: w.a0, a0_has: w.a0_has, a1: w.a1, a1_has: w.a1_has, a2: a, a2_has: true, a3: w.a3, a3_has: w.a3_has,
            next_arch_id: w.next_arch_id, next_table_id: w.next_table_id,
            archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
            discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
            entity: w.entity, entity_arch: w.entity_arch, entity_alive: w.entity_alive,
        };
    };
    return EcsBrWorldDeep {
        a0: w.a0, a0_has: w.a0_has, a1: w.a1, a1_has: w.a1_has, a2: w.a2, a2_has: w.a2_has, a3: a, a3_has: true,
        next_arch_id: w.next_arch_id, next_table_id: w.next_table_id,
        archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
        discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
        entity: w.entity, entity_arch: w.entity_arch, entity_alive: w.entity_alive,
    };
}

fn ecs_br_world_get_arch(w: EcsBrWorldDeep, id: i32) -> (bool, EcsBrArchetypeDeep) {
    if w.a0_has && w.a0.id == id { return (true, w.a0); };
    if w.a1_has && w.a1.id == id { return (true, w.a1); };
    if w.a2_has && w.a2.id == id { return (true, w.a2); };
    if w.a3_has && w.a3.id == id { return (true, w.a3); };
    return (false, ecs_br_archetype_new(0, 0));
}

fn ecs_br_world_entity_arch(w: EcsBrWorldDeep) -> i32 { return w.entity_arch; }
fn ecs_br_world_created_count(w: EcsBrWorldDeep) -> i32 { return w.archetype_created_count; }
fn ecs_br_world_remove_triggers(w: EcsBrWorldDeep) -> i32 { return w.remove_triggers; }
fn ecs_br_world_on_remove_hooks(w: EcsBrWorldDeep) -> i32 { return w.on_remove_hooks; }

// Collect removed components present on archetype
fn ecs_br_collect_removed(arch: EcsBrArchetypeDeep, bundle: EcsBrBundleDeep, intersection: bool) -> (bool, EcsBrI32ListDeep, EcsBrI32ListDeep) {
    // returns (ok, removed_table, removed_sparse)
    let rt = ecs_br_list_new();
    let rs = ecs_br_list_new();
    // component 0
    if bundle.len >= 1 {
        if ecs_br_archetype_contains(arch, bundle.c0) {
            if bundle.s0 == ECS_BR_TABLE { rt = ecs_br_list_push(rt, bundle.c0); } else { rs = ecs_br_list_push(rs, bundle.c0); };
        } else {
            if intersection != true { return (false, rt, rs); };
        };
    };
    if bundle.len >= 2 {
        if ecs_br_archetype_contains(arch, bundle.c1) {
            if bundle.s1 == ECS_BR_TABLE { rt = ecs_br_list_push(rt, bundle.c1); } else { rs = ecs_br_list_push(rs, bundle.c1); };
        } else {
            if intersection != true { return (false, rt, rs); };
        };
    };
    if bundle.len >= 3 {
        if ecs_br_archetype_contains(arch, bundle.c2) {
            if bundle.s2 == ECS_BR_TABLE { rt = ecs_br_list_push(rt, bundle.c2); } else { rs = ecs_br_list_push(rs, bundle.c2); };
        } else {
            if intersection != true { return (false, rt, rs); };
        };
    };
    if bundle.len >= 4 {
        if ecs_br_archetype_contains(arch, bundle.c3) {
            if bundle.s3 == ECS_BR_TABLE { rt = ecs_br_list_push(rt, bundle.c3); } else { rs = ecs_br_list_push(rs, bundle.c3); };
        } else {
            if intersection != true { return (false, rt, rs); };
        };
    };
    return (true, rt, rs);
}

// remove_bundle_from_archetype
fn ecs_br_remove_from_archetype(w: EcsBrWorldDeep, arch_id: i32, bundle: EcsBrBundleDeep, intersection: bool) -> (EcsBrWorldDeep, bool, i32, bool) {
    // returns (world, has_result, new_arch_id, is_new_created)
    let got = ecs_br_world_get_arch(w, arch_id);
    if got.0 != true { return (w, false, -1, false); };
    let arch = got.1;
    // check cache
    if intersection {
        if arch.remove_edge_valid && arch.remove_edge_bundle == bundle.id {
            return (w, true, arch.remove_edge_arch, false);
        };
    } else {
        if arch.take_edge_valid && arch.take_edge_bundle == bundle.id {
            if arch.take_edge_is_none { return (w, false, -1, false); };
            return (w, true, arch.take_edge_arch, false);
        };
    };
    let col = ecs_br_collect_removed(arch, bundle, intersection);
    if col.0 != true {
        // cache take None
        let arch2 = EcsBrArchetypeDeep {
            id: arch.id, table_id: arch.table_id, table_comps: arch.table_comps, sparse_comps: arch.sparse_comps,
            remove_edge_bundle: arch.remove_edge_bundle, remove_edge_arch: arch.remove_edge_arch, remove_edge_valid: arch.remove_edge_valid,
            take_edge_bundle: bundle.id, take_edge_arch: -1, take_edge_valid: true, take_edge_is_none: true,
        };
        w = ecs_br_world_set_arch(w, arch2);
        return (w, false, -1, false);
    };
    let next_table = ecs_br_sorted_remove(arch.table_comps, col.1);
    let next_sparse = ecs_br_sorted_remove(arch.sparse_comps, col.2);
    let table_changed = ecs_br_list_len(col.1) > 0;
    let new_table_id = arch.table_id;
    if table_changed {
        new_table_id = w.next_table_id;
    };
    let new_id = w.next_arch_id;
    let new_arch = EcsBrArchetypeDeep {
        id: new_id, table_id: new_table_id, table_comps: next_table, sparse_comps: next_sparse,
        remove_edge_bundle: -1, remove_edge_arch: -1, remove_edge_valid: false,
        take_edge_bundle: -1, take_edge_arch: -1, take_edge_valid: false, take_edge_is_none: false,
    };
    // update next ids / created
    let next_arch = w.next_arch_id + 1;
    let next_table_alloc = w.next_table_id;
    if table_changed { next_table_alloc = w.next_table_id + 1; };
    let created = w.archetype_created_count + 1;
    // cache edge on old arch
    let old2 = EcsBrArchetypeDeep {
        id: arch.id, table_id: arch.table_id, table_comps: arch.table_comps, sparse_comps: arch.sparse_comps,
        remove_edge_bundle: if intersection { bundle.id } else { arch.remove_edge_bundle },
        remove_edge_arch: if intersection { new_id } else { arch.remove_edge_arch },
        remove_edge_valid: if intersection { true } else { arch.remove_edge_valid },
        take_edge_bundle: if intersection != true { bundle.id } else { arch.take_edge_bundle },
        take_edge_arch: if intersection != true { new_id } else { arch.take_edge_arch },
        take_edge_valid: if intersection != true { true } else { arch.take_edge_valid },
        take_edge_is_none: if intersection != true { false } else { arch.take_edge_is_none },
    };
    w = EcsBrWorldDeep {
        a0: w.a0, a0_has: w.a0_has, a1: w.a1, a1_has: w.a1_has, a2: w.a2, a2_has: w.a2_has, a3: w.a3, a3_has: w.a3_has,
        next_arch_id: next_arch, next_table_id: next_table_alloc,
        archetype_created_count: created, last_created_arch: new_id,
        discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
        entity: w.entity, entity_arch: w.entity_arch, entity_alive: w.entity_alive,
    };
    w = ecs_br_world_set_arch(w, old2);
    w = ecs_br_world_set_arch(w, new_arch);
    return (w, true, new_id, true);
}

// BundleRemover
struct EcsBrRemoverDeep {
    bundle: EcsBrBundleDeep,
    old_arch: i32,
    new_arch: i32,
    old_table: i32,
    new_table: i32,
    table_move: bool,
    relationship_hook_mode: i32,
    valid: bool,
    pre_remove_keep: bool,
    removed_count: i32,
}

fn ecs_br_remover_valid(r: EcsBrRemoverDeep) -> bool { return r.valid; }
fn ecs_br_remover_new_arch(r: EcsBrRemoverDeep) -> i32 { return r.new_arch; }
fn ecs_br_remover_table_move(r: EcsBrRemoverDeep) -> bool { return r.table_move; }
fn ecs_br_remover_removed_count(r: EcsBrRemoverDeep) -> i32 { return r.removed_count; }

fn ecs_br_empty_pre_remove() -> bool {
    // returns keep=true like Bevy empty_pre_remove
    return true;
}

fn ecs_br_remover_new(w: EcsBrWorldDeep, arch_id: i32, bundle: EcsBrBundleDeep, require_all: bool) -> (EcsBrWorldDeep, EcsBrRemoverDeep) {
    let intersection = require_all != true;
    let r = ecs_br_remove_from_archetype(w, arch_id, bundle, intersection);
    w = r.0;
    if r.1 != true {
        return (w, EcsBrRemoverDeep {
            bundle: bundle, old_arch: arch_id, new_arch: -1, old_table: 0, new_table: 0,
            table_move: false, relationship_hook_mode: 0, valid: false, pre_remove_keep: true, removed_count: 0,
        });
    };
    let oldg = ecs_br_world_get_arch(w, arch_id);
    let newg = ecs_br_world_get_arch(w, r.2);
    let old_table = oldg.1.table_id;
    let new_table = newg.1.table_id;
    let move_t = old_table != new_table;
    return (w, EcsBrRemoverDeep {
        bundle: bundle, old_arch: arch_id, new_arch: r.2, old_table: old_table, new_table: new_table,
        table_move: move_t, relationship_hook_mode: 0, valid: true, pre_remove_keep: true, removed_count: 0,
    });
}

// remove: pre_remove keep? then move entity, fire remove triggers/hooks
fn ecs_br_remover_remove(w: EcsBrWorldDeep, r: EcsBrRemoverDeep, keep: bool) -> (EcsBrWorldDeep, EcsBrRemoverDeep) {
    if r.valid != true { return (w, r); };
    if keep != true {
        // entity despawned during pre_remove
        let w2 = EcsBrWorldDeep {
            a0: w.a0, a0_has: w.a0_has, a1: w.a1, a1_has: w.a1_has, a2: w.a2, a2_has: w.a2_has, a3: w.a3, a3_has: w.a3_has,
            next_arch_id: w.next_arch_id, next_table_id: w.next_table_id,
            archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
            discard_triggers: w.discard_triggers, remove_triggers: w.remove_triggers, on_remove_hooks: w.on_remove_hooks,
            entity: w.entity, entity_arch: w.entity_arch, entity_alive: false,
        };
        return (w2, r);
    };
    // count removed components present
    let oldg = ecs_br_world_get_arch(w, r.old_arch);
    let col = ecs_br_collect_removed(oldg.1, r.bundle, true);
    let removed = ecs_br_list_len(col.1) + ecs_br_list_len(col.2);
    let hooks = w.on_remove_hooks + removed;
    let triggers = w.remove_triggers + 1;
    let w2 = EcsBrWorldDeep {
        a0: w.a0, a0_has: w.a0_has, a1: w.a1, a1_has: w.a1_has, a2: w.a2, a2_has: w.a2_has, a3: w.a3, a3_has: w.a3_has,
        next_arch_id: w.next_arch_id, next_table_id: w.next_table_id,
        archetype_created_count: w.archetype_created_count, last_created_arch: w.last_created_arch,
        discard_triggers: w.discard_triggers, remove_triggers: triggers, on_remove_hooks: hooks,
        entity: w.entity, entity_arch: r.new_arch, entity_alive: true,
    };
    let r2 = EcsBrRemoverDeep {
        bundle: r.bundle, old_arch: r.old_arch, new_arch: r.new_arch, old_table: r.old_table, new_table: r.new_table,
        table_move: r.table_move, relationship_hook_mode: r.relationship_hook_mode, valid: r.valid,
        pre_remove_keep: keep, removed_count: removed,
    };
    return (w2, r2);
}
