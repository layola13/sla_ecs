// Deep self-contained Bevy ECS schedule node extensions: SystemSets, ConflictingSystems, Systems.
// Mirrors lib/schedule_node_sets.sla (523 lines) with fixed-cap (cap-16) scalar slot families.
// No @import. All structs carry @derive(copy). Booleans are stored as i32 (0/1).
// Nested structs are flattened inline; tuple-return replacement wrappers flatten the tuple
// companion into the mutated container (avoids the SA MemoryLeak — see docs/issue.md).

const ECS_NODE_SET_DEEP_CAP: i32 = 16;

// === EcsNodeSetEntryDeep (flat: mirrors EcsNodeSetEntry) ===
@derive(copy)
struct EcsNodeSetEntryDeep {
    system_id: i32,
    system_name: i64,
    is_exclusive: i32,
}

fn ecs_node_set_entry_deep_new(system_id: i32, system_name: i64, is_exclusive: bool) -> EcsNodeSetEntryDeep {
    let ie: i32 = 0;
    if is_exclusive { ie = 1; };
    return EcsNodeSetEntryDeep { system_id: system_id, system_name: system_name, is_exclusive: ie };
}

fn ecs_node_set_entry_deep_id(e: EcsNodeSetEntryDeep) -> i32 { return e.system_id; }
fn ecs_node_set_entry_deep_name(e: EcsNodeSetEntryDeep) -> i64 { return e.system_name; }
fn ecs_node_set_entry_deep_is_exclusive(e: EcsNodeSetEntryDeep) -> bool { return e.is_exclusive != 0; }

// === EcsNodeSetCondDeep (flat: single field, kept for parity) ===
@derive(copy)
struct EcsNodeSetCondDeep {
    condition_id: i32,
}

fn ecs_node_set_cond_deep_new(condition_id: i32) -> EcsNodeSetCondDeep {
    return EcsNodeSetCondDeep { condition_id: condition_id };
}

fn ecs_node_set_cond_deep_id(c: EcsNodeSetCondDeep) -> i32 { return c.condition_id; }

// === EcsNodeSetSystemsDeep: cap-16 entries + cap-16 conditions per-entry + uninit/initialized lists ===
// Each entry stored inline (flat) with cap-16 condition ids.
@derive(copy)
struct EcsNodeSetSystemsDeep {
    // entries count (cap-16).
    entry_count: i32,
    // Parallel cap-16 entry fields (entry N's system_id/name/exclusive live at the same N).
    sid0: i32, sid1: i32, sid2: i32, sid3: i32, sid4: i32, sid5: i32, sid6: i32, sid7: i32,
    sid8: i32, sid9: i32, sid10: i32, sid11: i32, sid12: i32, sid13: i32, sid14: i32, sid15: i32,
    sname0: i64, sname1: i64, sname2: i64, sname3: i64, sname4: i64, sname5: i64, sname6: i64, sname7: i64,
    sname8: i64, sname9: i64, sname10: i64, sname11: i64, sname12: i64, sname13: i64, sname14: i64, sname15: i64,
    sxc0: i32, sxc1: i32, sxc2: i32, sxc3: i32, sxc4: i32, sxc5: i32, sxc6: i32, sxc7: i32,
    sxc8: i32, sxc9: i32, sxc10: i32, sxc11: i32, sxc12: i32, sxc13: i32, sxc14: i32, sxc15: i32,
    // Per-entry cap-16 condition-id slot family.
    conds0_0: i32, conds0_1: i32, conds0_2: i32, conds0_3: i32, conds0_4: i32, conds0_5: i32, conds0_6: i32, conds0_7: i32,
    conds0_8: i32, conds0_9: i32, conds0_10: i32, conds0_11: i32, conds0_12: i32, conds0_13: i32, conds0_14: i32, conds0_15: i32,
    conds0_n: i32,
    conds1_0: i32, conds1_1: i32, conds1_2: i32, conds1_3: i32, conds1_4: i32, conds1_5: i32, conds1_6: i32, conds1_7: i32,
    conds1_8: i32, conds1_9: i32, conds1_10: i32, conds1_11: i32, conds1_12: i32, conds1_13: i32, conds1_14: i32, conds1_15: i32,
    conds1_n: i32,
    // Cap-16 uninit and initialized slot lists (i32 keys).
    uninit0: i32, uninit1: i32, uninit2: i32, uninit3: i32, uninit4: i32, uninit5: i32, uninit6: i32, uninit7: i32,
    uninit8: i32, uninit9: i32, uninit10: i32, uninit11: i32, uninit12: i32, uninit13: i32, uninit14: i32, uninit15: i32,
    uninit_n: i32,
    init0: i32, init1: i32, init2: i32, init3: i32, init4: i32, init5: i32, init6: i32, init7: i32,
    init8: i32, init9: i32, init10: i32, init11: i32, init12: i32, init13: i32, init14: i32, init15: i32,
    init_n: i32,
    // Inline companion for (Registry, key) tuple returned by insert.
    last_insert_key: i32,
    // Inline (bool, Entry) tuple-replacement companion for get / get_mut.
    last_get_found: i32,
    last_get_entry_system_id: i32,
    last_get_entry_system_name: i64,
    last_get_entry_is_exclusive: i32,
    // Inline (Registry, bool) tuple-replacement companion for remove.
    last_remove_found: i32,
}

fn ecs_systems_ext_deep_new() -> EcsNodeSetSystemsDeep {
    return EcsNodeSetSystemsDeep {
        entry_count: 0,
        sid0: 0, sid1: 0, sid2: 0, sid3: 0, sid4: 0, sid5: 0, sid6: 0, sid7: 0,
        sid8: 0, sid9: 0, sid10: 0, sid11: 0, sid12: 0, sid13: 0, sid14: 0, sid15: 0,
        sname0: 0, sname1: 0, sname2: 0, sname3: 0, sname4: 0, sname5: 0, sname6: 0, sname7: 0,
        sname8: 0, sname9: 0, sname10: 0, sname11: 0, sname12: 0, sname13: 0, sname14: 0, sname15: 0,
        sxc0: 0, sxc1: 0, sxc2: 0, sxc3: 0, sxc4: 0, sxc5: 0, sxc6: 0, sxc7: 0,
        sxc8: 0, sxc9: 0, sxc10: 0, sxc11: 0, sxc12: 0, sxc13: 0, sxc14: 0, sxc15: 0,
        conds0_0: 0, conds0_1: 0, conds0_2: 0, conds0_3: 0, conds0_4: 0, conds0_5: 0, conds0_6: 0, conds0_7: 0,
        conds0_8: 0, conds0_9: 0, conds0_10: 0, conds0_11: 0, conds0_12: 0, conds0_13: 0, conds0_14: 0, conds0_15: 0,
        conds0_n: 0,
        conds1_0: 0, conds1_1: 0, conds1_2: 0, conds1_3: 0, conds1_4: 0, conds1_5: 0, conds1_6: 0, conds1_7: 0,
        conds1_8: 0, conds1_9: 0, conds1_10: 0, conds1_11: 0, conds1_12: 0, conds1_13: 0, conds1_14: 0, conds1_15: 0,
        conds1_n: 0,
        uninit0: (0 - 1), uninit1: (0 - 1), uninit2: (0 - 1), uninit3: (0 - 1),
        uninit4: (0 - 1), uninit5: (0 - 1), uninit6: (0 - 1), uninit7: (0 - 1),
        uninit8: (0 - 1), uninit9: (0 - 1), uninit10: (0 - 1), uninit11: (0 - 1),
        uninit12: (0 - 1), uninit13: (0 - 1), uninit14: (0 - 1), uninit15: (0 - 1),
        uninit_n: 0,
        init0: (0 - 1), init1: (0 - 1), init2: (0 - 1), init3: (0 - 1),
        init4: (0 - 1), init5: (0 - 1), init6: (0 - 1), init7: (0 - 1),
        init8: (0 - 1), init9: (0 - 1), init10: (0 - 1), init11: (0 - 1),
        init12: (0 - 1), init13: (0 - 1), init14: (0 - 1), init15: (0 - 1),
        init_n: 0,
        last_insert_key: (0 - 1),
        last_get_found: 0,
        last_get_entry_system_id: 0,
        last_get_entry_system_name: 0,
        last_get_entry_is_exclusive: 0,
        last_remove_found: 0,
    };
}

fn _esns_sid_at(s: EcsNodeSetSystemsDeep, idx: i32) -> i32 {
    if idx == 0 { return s.sid0; };
    if idx == 1 { return s.sid1; };
    if idx == 2 { return s.sid2; };
    if idx == 3 { return s.sid3; };
    if idx == 4 { return s.sid4; };
    if idx == 5 { return s.sid5; };
    if idx == 6 { return s.sid6; };
    if idx == 7 { return s.sid7; };
    if idx == 8 { return s.sid8; };
    if idx == 9 { return s.sid9; };
    if idx == 10 { return s.sid10; };
    if idx == 11 { return s.sid11; };
    if idx == 12 { return s.sid12; };
    if idx == 13 { return s.sid13; };
    if idx == 14 { return s.sid14; };
    if idx == 15 { return s.sid15; };
    panic(146200);
}

