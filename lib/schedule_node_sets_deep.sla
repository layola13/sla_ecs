    if idx == 0 { s.sid0 = v; return s; };
    if idx == 1 { s.sid1 = v; return s; };
    if idx == 2 { s.sid2 = v; return s; };
    if idx == 3 { s.sid3 = v; return s; };
    if idx == 4 { s.sid4 = v; return s; };
