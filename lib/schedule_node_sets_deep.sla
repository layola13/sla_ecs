fn ecs_system_access_deep_add_read(a: EcsNodeSetSystemAccessDeep, comp_id: i32) -> EcsNodeSetSystemAccessDeep {
    if a.rcn < ECS_NODE_SET_DEEP_CAP {
        a = _essa_rc_set(a, a.rcn, comp_id);
        a.rcn = a.rcn + 1;
    };
    return a;
}

fn ecs_system_access_deep_add_write(a: EcsNodeSetSystemAccessDeep, comp_id: i32) -> EcsNodeSetSystemAccessDeep {
    if a.wcn < ECS_NODE_SET_DEEP_CAP {
        a = _essa_wc_set(a, a.wcn, comp_id);
        a.wcn = a.wcn + 1;
    };
    return a;
}

fn ecs_system_access_deep_set_reads_all(a: EcsNodeSetSystemAccessDeep) -> EcsNodeSetSystemAccessDeep {
    a.reads_all = 1;
    return a;
}

fn ecs_system_access_deep_set_writes_all(a: EcsNodeSetSystemAccessDeep) -> EcsNodeSetSystemAccessDeep {
    a.writes_all = 1;
    return a;
}

fn _essa_contains_rc(a: EcsNodeSetSystemAccessDeep, v: i32) -> bool {
    let i: i32 = 0;
    while i < a.rcn {
        if _essa_rc_at(a, i) == v { return true; };
        i = i + 1;
    }
    return false;
}

fn _essa_contains_wc(a: EcsNodeSetSystemAccessDeep, v: i32) -> bool {
    let i: i32 = 0;
    while i < a.wcn {
        if _essa_wc_at(a, i) == v { return true; };
        i = i + 1;
    }
    return false;
}

// get_conflicts: storage via inline fields (rc_n, wc_n, cf_n + flags).
// Returns registry inlined with conflict count + first few ids + is_individual flag.
// We re-use a flat struct here to keep the result self-contained.
@derive(copy)
struct AccessConflictsResultDeep {
    is_individual: i32,
    conflict_count: i32,
    cf0: i32,
    cf1: i32,
    cf2: i32,
    cf3: i32,
}

fn ecs_system_access_deep_get_conflicts(a: EcsNodeSetSystemAccessDeep, b: EcsNodeSetSystemAccessDeep) -> AccessConflictsResultDeep {
    if a.writes_all != 0 || b.writes_all != 0 {
        return AccessConflictsResultDeep { is_individual: 0, conflict_count: 0, cf0: 0, cf1: 0, cf2: 0, cf3: 0 };
    };
    if a.reads_all != 0 && b.writes_all != 0 {
        return AccessConflictsResultDeep { is_individual: 0, conflict_count: 0, cf0: 0, cf1: 0, cf2: 0, cf3: 0 };
    };
    if a.writes_all != 0 && b.reads_all != 0 {
        return AccessConflictsResultDeep { is_individual: 0, conflict_count: 0, cf0: 0, cf1: 0, cf2: 0, cf3: 0 };
    };
    let out0: i32 = (0 - 1);
    let out1: i32 = (0 - 1);
    let out2: i32 = (0 - 1);
    let out3: i32 = (0 - 1);
    let n: i32 = 0;
    let add: i32 = 0;
    let i: i32 = 0;
    while i < a.wcn {
        let w = _essa_wc_at(a, i);
        add = 0;
        if _essa_contains_wc(b, w) { add = 1; };
        if _essa_contains_rc(b, w) { add = 1; };
        if add != 0 {
            if n == 0 { out0 = w; n = 1; };
            if n == 1 { if w != out0 { out1 = w; n = 2; }; };
            if n == 2 { if w != out0 { if w != out1 { out2 = w; n = 3; }; }; };
            if n == 3 { if w != out0 { if w != out1 { if w != out2 { out3 = w; n = 4; }; }; }; };
        };
        i = i + 1;
    }
    let j: i32 = 0;
    while j < a.rcn {
        let r = _essa_rc_at(a, j);
        if _essa_contains_wc(b, r) {
            if n == 0 { out0 = r; n = 1; };
            if n == 1 { if r != out0 { out1 = r; n = 2; }; };
            if n == 2 { if r != out0 { if r != out1 { out2 = r; n = 3; }; }; };
            if n == 3 { if r != out0 { if r != out1 { if r != out2 { out3 = r; n = 4; }; }; }; };
        };
        j = j + 1;
    }
    return AccessConflictsResultDeep { is_individual: 1, conflict_count: n, cf0: out0, cf1: out1, cf2: out2, cf3: out3 };
}

fn ecs_access_conflict_result_deep_is_individual(r: AccessConflictsResultDeep) -> bool { return r.is_individual != 0; }
fn ecs_access_conflict_result_deep_count(r: AccessConflictsResultDeep) -> i32 { return r.conflict_count; }
fn ecs_access_conflict_result_deep_cf(r: AccessConflictsResultDeep, slot: i32) -> i32 {
    if slot == 0 { return r.cf0; };
    if slot == 1 { return r.cf1; };
    if slot == 2 { return r.cf2; };
    if slot == 3 { return r.cf3; };
    return (0 - 1);
}

// === SystemSets: cap-16 sets ===
@derive(copy)
struct EcsNodeSetSystemSetsDeep {
    // sets slot family (set_id + is_system_type per set).
    set_id0: i32, set_id1: i32, set_id2: i32, set_id3: i32, set_id4: i32, set_id5: i32, set_id6: i32, set_id7: i32,
    set_id8: i32, set_id9: i32, set_id10: i32, set_id11: i32, set_id12: i32, set_id13: i32, set_id14: i32, set_id15: i32,
    is_st0: i32, is_st1: i32, is_st2: i32, is_st3: i32, is_st4: i32, is_st5: i32, is_st6: i32, is_st7: i32,
    is_st8: i32, is_st9: i32, is_st10: i32, is_st11: i32, is_st12: i32, is_st13: i32, is_st14: i32, is_st15: i32,
    // ids_map: storing key-ids; ids_map_keys parallel to sets order key 0..n.
    ids_map0: i32, ids_map1: i32, ids_map2: i32, ids_map3: i32, ids_map4: i32, ids_map5: i32, ids_map6: i32, ids_map7: i32,
    ids_map8: i32, ids_map9: i32, ids_map10: i32, ids_map11: i32, ids_map12: i32, ids_map13: i32, ids_map14: i32, ids_map15: i32,
    sets_count: i32,
    // Cap-16 uninit2 slot list (key,start,end parallel) for add_condition and the uninit list.
    uninit2_key0: i32, uninit2_key1: i32, uninit2_key2: i32, uninit2_key3: i32,
    uninit2_key4: i32, uninit2_key5: i32, uninit2_key6: i32, uninit2_key7: i32,
    uninit2_key8: i32, uninit2_key9: i32, uninit2_key10: i32, uninit2_key11: i32,
    uninit2_key12: i32, uninit2_key13: i32, uninit2_key14: i32, uninit2_key15: i32,
    uninit2_start0: i64, uninit2_start1: i64, uninit2_start2: i64, uninit2_start3: i64,
    uninit2_start4: i64, uninit2_start5: i64, uninit2_start6: i64, uninit2_start7: i64,
    uninit2_start8: i64, uninit2_start9: i64, uninit2_start10: i64, uninit2_start11: i64,
    uninit2_start12: i64, uninit2_start13: i64, uninit2_start14: i64, uninit2_start15: i64,
    uninit2_end0: i64, uninit2_end1: i64, uninit2_end2: i64, uninit2_end3: i64,
    uninit2_end4: i64, uninit2_end5: i64, uninit2_end6: i64, uninit2_end7: i64,
    uninit2_end8: i64, uninit2_end9: i64, uninit2_end10: i64, uninit2_end11: i64,
    uninit2_end12: i64, uninit2_end13: i64, uninit2_end14: i64, uninit2_end15: i64,
    uninit2_n: i32,
    // Inline companions for tuple-return replacement.
    last_get_or_insert_key: i32,
    last_contains: i32,
    last_get_index: i32,
}

fn ecs_system_sets_deep_new() -> EcsNodeSetSystemSetsDeep {
    let empty = EcsNodeSetSystemSetsDeep {
        set_id0: 0, set_id1: 0, set_id2: 0, set_id3: 0, set_id4: 0, set_id5: 0, set_id6: 0, set_id7: 0,
        set_id8: 0, set_id9: 0, set_id10: 0, set_id11: 0, set_id12: 0, set_id13: 0, set_id14: 0, set_id15: 0,
        is_st0: 0, is_st1: 0, is_st2: 0, is_st3: 0, is_st4: 0, is_st5: 0, is_st6: 0, is_st7: 0,
        is_st8: 0, is_st9: 0, is_st10: 0, is_st11: 0, is_st12: 0, is_st13: 0, is_st14: 0, is_st15: 0,
        ids_map0: (0 - 1), ids_map1: (0 - 1), ids_map2: (0 - 1), ids_map3: (0 - 1),
        ids_map4: (0 - 1), ids_map5: (0 - 1), ids_map6: (0 - 1), ids_map7: (0 - 1),
        ids_map8: (0 - 1), ids_map9: (0 - 1), ids_map10: (0 - 1), ids_map11: (0 - 1),
        ids_map12: (0 - 1), ids_map13: (0 - 1), ids_map14: (0 - 1), ids_map15: (0 - 1),
        sets_count: 0,
        uninit2_key0: 0, uninit2_key1: 0, uninit2_key2: 0, uninit2_key3: 0,
        uninit2_key4: 0, uninit2_key5: 0, uninit2_key6: 0, uninit2_key7: 0,
        uninit2_key8: 0, uninit2_key9: 0, uninit2_key10: 0, uninit2_key11: 0,
        uninit2_key12: 0, uninit2_key13: 0, uninit2_key14: 0, uninit2_key15: 0,
        uninit2_start0: 0, uninit2_start1: 0, uninit2_start2: 0, uninit2_start3: 0,
        uninit2_start4: 0, uninit2_start5: 0, uninit2_start6: 0, uninit2_start7: 0,
        uninit2_start8: 0, uninit2_start9: 0, uninit2_start10: 0, uninit2_start11: 0,
        uninit2_start12: 0, uninit2_start13: 0, uninit2_start14: 0, uninit2_start15: 0,
        uninit2_end0: 0, uninit2_end1: 0, uninit2_end2: 0, uninit2_end3: 0,
        uninit2_end4: 0, uninit2_end5: 0, uninit2_end6: 0, uninit2_end7: 0,
        uninit2_end8: 0, uninit2_end9: 0, uninit2_end10: 0, uninit2_end11: 0,
        uninit2_end12: 0, uninit2_end13: 0, uninit2_end14: 0, uninit2_end15: 0,
        uninit2_n: 0,
        last_get_or_insert_key: (0 - 1),
