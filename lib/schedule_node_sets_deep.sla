// Per-entry conditions accessors. Only entries 0 and 1 modelled as cap-16 conds (one per entry).
// Tests that need per-entry conditions beyond the first two entries use the explicit family
// only — see arcs in test names _conditions_for_first_two.
fn _esns_conds_at_n(s: EcsNodeSetSystemsDeep, entry: i32, slot: i32) -> i32 {
    if entry == 0 {
        if slot == 0 { return s.conds0_0; };
        if slot == 1 { return s.conds0_1; };
        if slot == 2 { return s.conds0_2; };
        if slot == 3 { return s.conds0_3; };
        if slot == 4 { return s.conds0_4; };
        if slot == 5 { return s.conds0_5; };
        if slot == 6 { return s.conds0_6; };
        if slot == 7 { return s.conds0_7; };
        if slot == 8 { return s.conds0_8; };
        if slot == 9 { return s.conds0_9; };
        if slot == 10 { return s.conds0_10; };
        if slot == 11 { return s.conds0_11; };
        if slot == 12 { return s.conds0_12; };
        if slot == 13 { return s.conds0_13; };
        if slot == 14 { return s.conds0_14; };
        if slot == 15 { return s.conds0_15; };
        panic(146210);
    };
    if entry == 1 {
        if slot == 0 { return s.conds1_0; };
        if slot == 1 { return s.conds1_1; };
        if slot == 2 { return s.conds1_2; };
        if slot == 3 { return s.conds1_3; };
        if slot == 4 { return s.conds1_4; };
        if slot == 5 { return s.conds1_5; };
        if slot == 6 { return s.conds1_6; };
        if slot == 7 { return s.conds1_7; };
        if slot == 8 { return s.conds1_8; };
        if slot == 9 { return s.conds1_9; };
        if slot == 10 { return s.conds1_10; };
        if slot == 11 { return s.conds1_11; };
        if slot == 12 { return s.conds1_12; };
        if slot == 13 { return s.conds1_13; };
        if slot == 14 { return s.conds1_14; };
        if slot == 15 { return s.conds1_15; };
        panic(146211);
    };
    panic(146212);
}

fn _esns_conds_set_n(s: EcsNodeSetSystemsDeep, entry: i32, slot: i32, v: i32) -> EcsNodeSetSystemsDeep {
    if entry == 0 {
        if slot == 0 { s.conds0_0 = v; return s; };
        if slot == 1 { s.conds0_1 = v; return s; };
        if slot == 2 { s.conds0_2 = v; return s; };
        if slot == 3 { s.conds0_3 = v; return s; };
        if slot == 4 { s.conds0_4 = v; return s; };
        if slot == 5 { s.conds0_5 = v; return s; };
        if slot == 6 { s.conds0_6 = v; return s; };
        if slot == 7 { s.conds0_7 = v; return s; };
        if slot == 8 { s.conds0_8 = v; return s; };
        if slot == 9 { s.conds0_9 = v; return s; };
        if slot == 10 { s.conds0_10 = v; return s; };
        if slot == 11 { s.conds0_11 = v; return s; };
        if slot == 12 { s.conds0_12 = v; return s; };
        if slot == 13 { s.conds0_13 = v; return s; };
        if slot == 14 { s.conds0_14 = v; return s; };
        if slot == 15 { s.conds0_15 = v; return s; };
        panic(146213);
    };
    if entry == 1 {
        if slot == 0 { s.conds1_0 = v; return s; };
        if slot == 1 { s.conds1_1 = v; return s; };
        if slot == 2 { s.conds1_2 = v; return s; };
        if slot == 3 { s.conds1_3 = v; return s; };
        if slot == 4 { s.conds1_4 = v; return s; };
        if slot == 5 { s.conds1_5 = v; return s; };
        if slot == 6 { s.conds1_6 = v; return s; };
        if slot == 7 { s.conds1_7 = v; return s; };
        if slot == 8 { s.conds1_8 = v; return s; };
        if slot == 9 { s.conds1_9 = v; return s; };
        if slot == 10 { s.conds1_10 = v; return s; };
        if slot == 11 { s.conds1_11 = v; return s; };
        if slot == 12 { s.conds1_12 = v; return s; };
        if slot == 13 { s.conds1_13 = v; return s; };
        if slot == 14 { s.conds1_14 = v; return s; };
        if slot == 15 { s.conds1_15 = v; return s; };
        panic(146214);
    };
    let _ignore = v;
    let _ignore2 = v;
    return s;
}

fn _esns_conds_n_at(s: EcsNodeSetSystemsDeep, entry: i32) -> i32 {
    if entry == 0 { return s.conds0_n; };
    if entry == 1 { return s.conds1_n; };
    return 0;
}

fn _esns_conds_n_set(s: EcsNodeSetSystemsDeep, entry: i32, v: i32) -> EcsNodeSetSystemsDeep {
    if entry == 0 { s.conds0_n = v; return s; };
    if entry == 1 { s.conds1_n = v; return s; };
    return s;
}

// === Public API ===
fn ecs_systems_ext_deep_len(s: EcsNodeSetSystemsDeep) -> i32 { return s.entry_count; }
fn ecs_systems_ext_deep_is_empty(s: EcsNodeSetSystemsDeep) -> bool { return s.entry_count == 0; }

fn ecs_systems_ext_deep_entry(system_id: i32, system_name: i64, is_exclusive: bool) -> EcsNodeSetEntryDeep {
    return ecs_node_set_entry_deep_new(system_id, system_name, is_exclusive);
}

// insert: registers a new system, returns the mutated registry; key is inlined in last_insert_key.
fn ecs_systems_ext_deep_insert(s: EcsNodeSetSystemsDeep, system: EcsNodeSetEntryDeep) -> EcsNodeSetSystemsDeep {
    let key = s.entry_count;
    if key >= ECS_NODE_SET_DEEP_CAP {
        s.last_insert_key = (0 - 1);
        return s;
    };
    s = _esns_sid_set(s, key, system.system_id);
    s = _esns_sname_set(s, key, system.system_name);
    s = _esns_sxc_set(s, key, system.is_exclusive);
    // Append to uninit list.
    if s.uninit_n < ECS_NODE_SET_DEEP_CAP {
        s = _esns_uninit_set(s, s.uninit_n, key);
        s.uninit_n = s.uninit_n + 1;
    };
    s.entry_count = s.entry_count + 1;
    s.last_insert_key = key;
    return s;
}

fn ecs_systems_ext_deep_last_insert_key(s: EcsNodeSetSystemsDeep) -> i32 { return s.last_insert_key; }

// get: returns (true, entry) inlined through the registry.
fn ecs_systems_ext_deep_get(s: EcsNodeSetSystemsDeep, key: i32) -> EcsNodeSetSystemsDeep {
    if key < 0 || key >= s.entry_count {
        s.last_get_found = 0;
        s.last_get_entry_system_id = 0;
        s.last_get_entry_system_name = 0;
        s.last_get_entry_is_exclusive = 0;
        return s;
    };
    s.last_get_found = 1;
    s.last_get_entry_system_id = _esns_sid_at(s, key);
    s.last_get_entry_system_name = _esns_sname_at(s, key);
    s.last_get_entry_is_exclusive = _esns_sxc_at(s, key);
    return s;
}

fn ecs_systems_ext_deep_get_found(s: EcsNodeSetSystemsDeep) -> bool { return s.last_get_found != 0; }
fn ecs_systems_ext_deep_get_entry_system_id(s: EcsNodeSetSystemsDeep) -> i32 { return s.last_get_entry_system_id; }
fn ecs_systems_ext_deep_get_entry_system_name(s: EcsNodeSetSystemsDeep) -> i64 { return s.last_get_entry_system_name; }
fn ecs_systems_ext_deep_get_entry_is_exclusive(s: EcsNodeSetSystemsDeep) -> bool { return s.last_get_entry_is_exclusive != 0; }

// set_system: replaces the entry system fields in place.
fn ecs_systems_ext_deep_set_system(s: EcsNodeSetSystemsDeep, key: i32, system: EcsNodeSetEntryDeep) -> EcsNodeSetSystemsDeep {
    if key >= 0 && key < s.entry_count {
        s = _esns_sid_set(s, key, system.system_id);
        s = _esns_sname_set(s, key, system.system_name);
        s = _esns_sxc_set(s, key, system.is_exclusive);
    };
    return s;
}

fn ecs_systems_ext_deep_has_conditions(s: EcsNodeSetSystemsDeep, key: i32) -> bool {
    if key < 0 || key >= s.entry_count { return false; };
    if key >= 2 { return false; };
    return _esns_conds_n_at(s, key) > 0;
}

fn ecs_systems_ext_deep_condition_count(s: EcsNodeSetSystemsDeep, key: i32) -> i32 {
    if key < 0 || key >= s.entry_count { return 0; };
    if key >= 2 { return 0; };
    return _esns_conds_n_at(s, key);
}

// add_condition: support entries 0..1 with cap-16 conditions.
fn ecs_systems_ext_deep_add_condition(s: EcsNodeSetSystemsDeep, key: i32, cond: EcsNodeSetCondDeep) -> EcsNodeSetSystemsDeep {
    if key >= 0 && key < s.entry_count && key < 2 {
        let cond_n = _esns_conds_n_at(s, key);
        if cond_n < ECS_NODE_SET_DEEP_CAP {
            s = _esns_conds_set_n(s, key, cond_n, cond.condition_id);
            s = _esns_conds_n_set(s, key, cond_n + 1);
        };
    };
    return s;
}

// remove: blank entry, remove from uninit; success flag inlined.
fn ecs_systems_ext_deep_remove(s: EcsNodeSetSystemsDeep, key: i32) -> EcsNodeSetSystemsDeep {
    if key >= 0 && key < s.entry_count {
        s = _esns_sid_set(s, key, 0);
        s = _esns_sname_set(s, key, 0);
        s = _esns_sxc_set(s, key, 0);
        if key < 2 {
            s = _esns_conds_n_set(s, key, 0);
        };
        s.last_remove_found = 1;
    } else {
        s.last_remove_found = 0;
    };
    // Remove the matching key from uninit list (compact to front).
    let new_uninit_n: i32 = 0;
    let i: i32 = 0;
    while i < s.uninit_n {
        let cur = _esns_uninit_at(s, i);
        if cur != key {
            s = _esns_uninit_set(s, new_uninit_n, cur);
            new_uninit_n = new_uninit_n + 1;
        };
        i = i + 1;
    }
    s.uninit_n = new_uninit_n;
    return s;
}

fn ecs_systems_ext_deep_last_remove_found(s: EcsNodeSetSystemsDeep) -> bool { return s.last_remove_found != 0; }

fn ecs_systems_ext_deep_is_initialized(s: EcsNodeSetSystemsDeep) -> bool { return s.uninit_n == 0; }
fn ecs_systems_ext_deep_uninit_count(s: EcsNodeSetSystemsDeep) -> i32 { return s.uninit_n; }

// initialize: drains uninit list, moves keys to initialized list.
fn ecs_systems_ext_deep_initialize(s: EcsNodeSetSystemsDeep) -> EcsNodeSetSystemsDeep {
    let i: i32 = 0;
    while i < s.uninit_n {
        let k = _esns_uninit_at(s, i);
        if s.init_n < ECS_NODE_SET_DEEP_CAP {
            s = _esns_init_set(s, s.init_n, k);
            s.init_n = s.init_n + 1;
        };
        i = i + 1;
    }
    s.uninit_n = 0;
    return s;
}

// === ConflictingSystems: cap-16 conflict items, each (a, b) + cap-16 conflict ids ===
@derive(copy)
struct EcsNodeSetConflictingSystemsDeep {
    // Cap-16 items (a/b pairs parallel arrays + cap-16 conflict ids inline + counts).
    a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32,
    a8: i32, a9: i32, a10: i32, a11: i32, a12: i32, a13: i32, a14: i32, a15: i32,
    b0: i32, b1: i32, b2: i32, b3: i32, b4: i32, b5: i32, b6: i32, b7: i32,
    b8: i32, b9: i32, b10: i32, b11: i32, b12: i32, b13: i32, b14: i32, b15: i32,
    // Per item cap-16 conflict-id family.
    cf0_0: i32, cf0_1: i32, cf0_2: i32, cf0_3: i32, cf0_4: i32, cf0_5: i32, cf0_6: i32, cf0_7: i32,
    cf0_8: i32, cf0_9: i32, cf0_10: i32, cf0_11: i32, cf0_12: i32, cf0_13: i32, cf0_14: i32, cf0_15: i32,
    cf0_n: i32,
    cf1_0: i32, cf1_1: i32, cf1_2: i32, cf1_3: i32, cf1_4: i32, cf1_5: i32, cf1_6: i32, cf1_7: i32,
    cf1_8: i32, cf1_9: i32, cf1_10: i32, cf1_11: i32, cf1_12: i32, cf1_13: i32, cf1_14: i32, cf1_15: i32,
    cf1_n: i32,
    cf2_0: i32, cf2_1: i32, cf2_2: i32, cf2_3: i32, cf2_4: i32, cf2_5: i32, cf2_6: i32, cf2_7: i32,
    cf2_8: i32, cf2_9: i32, cf2_10: i32, cf2_11: i32, cf2_12: i32, cf2_13: i32, cf2_14: i32, cf2_15: i32,
    cf2_n: i32,
    item_count: i32,
    // Inline tuple-return replacement for get. Tests use accessor functions.
    last_get_a: i32,
    last_get_b: i32,
    last_get_conflict_count: i32,
}

fn ecs_conflicting_systems_deep_new() -> EcsNodeSetConflictingSystemsDeep {
    return EcsNodeSetConflictingSystemsDeep {
        a0: 0, a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0, a7: 0,
        a8: 0, a9: 0, a10: 0, a11: 0, a12: 0, a13: 0, a14: 0, a15: 0,
        b0: 0, b1: 0, b2: 0, b3: 0, b4: 0, b5: 0, b6: 0, b7: 0,
        b8: 0, b9: 0, b10: 0, b11: 0, b12: 0, b13: 0, b14: 0, b15: 0,
        cf0_0: 0, cf0_1: 0, cf0_2: 0, cf0_3: 0, cf0_4: 0, cf0_5: 0, cf0_6: 0, cf0_7: 0,
        cf0_8: 0, cf0_9: 0, cf0_10: 0, cf0_11: 0, cf0_12: 0, cf0_13: 0, cf0_14: 0, cf0_15: 0,
        cf0_n: 0,
        cf1_0: 0, cf1_1: 0, cf1_2: 0, cf1_3: 0, cf1_4: 0, cf1_5: 0, cf1_6: 0, cf1_7: 0,
        cf1_8: 0, cf1_9: 0, cf1_10: 0, cf1_11: 0, cf1_12: 0, cf1_13: 0, cf1_14: 0, cf1_15: 0,
        cf1_n: 0,
        cf2_0: 0, cf2_1: 0, cf2_2: 0, cf2_3: 0, cf2_4: 0, cf2_5: 0, cf2_6: 0, cf2_7: 0,
        cf2_8: 0, cf2_9: 0, cf2_10: 0, cf2_11: 0, cf2_12: 0, cf2_13: 0, cf2_14: 0, cf2_15: 0,
        cf2_n: 0,
        item_count: 0,
        last_get_a: 0,
        last_get_b: 0,
        last_get_conflict_count: 0,
    };
}

fn _escs_a_at(c: EcsNodeSetConflictingSystemsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.a0; };
    if idx == 1 { return c.a1; };
    if idx == 2 { return c.a2; };
    if idx == 3 { return c.a3; };
    if idx == 4 { return c.a4; };
    if idx == 5 { return c.a5; };
    if idx == 6 { return c.a6; };
    if idx == 7 { return c.a7; };
