fn ecs_system_sets_deep_len(s: EcsNodeSetSystemSetsDeep) -> i32 { return s.sets_count; }
fn ecs_system_sets_deep_is_empty(s: EcsNodeSetSystemSetsDeep) -> bool { return s.sets_count == 0; }

fn ecs_system_sets_deep_contains(s: EcsNodeSetSystemSetsDeep, set_id: i32) -> bool {
    let i: i32 = 0;
    while i < s.sets_count {
        if _esets_ids_map_at(s, i) == set_id { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_system_sets_deep_get_index(s: EcsNodeSetSystemSetsDeep, set_id: i32) -> i32 {
    let i: i32 = 0;
    while i < s.sets_count {
        if _esets_ids_map_at(s, i) == set_id { return i; };
        i = i + 1;
    }
    return (0 - 1);
}

fn ecs_system_sets_deep_get_set_id(s: EcsNodeSetSystemSetsDeep, key: i32) -> i32 {
    if key < 0 || key >= s.sets_count { return (0 - 1); };
    return _esets_set_id_at(s, key);
}

// get_key_or_insert: returns the mutated sets with key inlined in last_get_or_insert_key.
fn ecs_system_sets_deep_get_key_or_insert(s: EcsNodeSetSystemSetsDeep, set_id: i32) -> EcsNodeSetSystemSetsDeep {
    let idx = ecs_system_sets_deep_get_index(s, set_id);
    if idx >= 0 {
        s.last_get_or_insert_key = idx;
        return s;
    };
    if s.sets_count >= ECS_NODE_SET_DEEP_CAP {
        s.last_get_or_insert_key = (0 - 1);
        return s;
    };
    let key = s.sets_count;
    s = _esets_set_id_set(s, key, set_id);
    s = _esets_is_st_set(s, key, 0);
    // The ids_map entry is populated at the same index as the new key.
    if key == 0 { s.ids_map0 = set_id; };
    if key == 1 { s.ids_map1 = set_id; };
    if key == 2 { s.ids_map2 = set_id; };
    if key == 3 { s.ids_map3 = set_id; };
    if key == 4 { s.ids_map4 = set_id; };
    if key == 5 { s.ids_map5 = set_id; };
    if key == 6 { s.ids_map6 = set_id; };
    if key == 7 { s.ids_map7 = set_id; };
    if key == 8 { s.ids_map8 = set_id; };
    if key == 9 { s.ids_map9 = set_id; };
    if key == 10 { s.ids_map10 = set_id; };
    if key == 11 { s.ids_map11 = set_id; };
    if key == 12 { s.ids_map12 = set_id; };
    if key == 13 { s.ids_map13 = set_id; };
    if key == 14 { s.ids_map14 = set_id; };
    if key == 15 { s.ids_map15 = set_id; };
    s.sets_count = s.sets_count + 1;
    s.last_get_or_insert_key = key;
    return s;
}

fn ecs_system_sets_deep_last_get_or_insert_key(s: EcsNodeSetSystemSetsDeep) -> i32 { return s.last_get_or_insert_key; }

fn ecs_system_sets_deep_set_is_system_type(s: EcsNodeSetSystemSetsDeep, key: i32, is_st: bool) -> EcsNodeSetSystemSetsDeep {
    let v: i32 = 0;
    if is_st { v = 1; };
    if key >= 0 && key < s.sets_count {
        s = _esets_is_st_set(s, key, v);
    };
    return s;
}

fn ecs_system_sets_deep_get_is_system_type(s: EcsNodeSetSystemSetsDeep, key: i32) -> bool {
    if key < 0 || key >= s.sets_count { return false; };
    return _esets_is_st_at(s, key) != 0;
}

fn ecs_system_sets_deep_is_initialized(s: EcsNodeSetSystemSetsDeep) -> bool { return s.uninit2_n == 0; }
fn ecs_system_sets_deep_uninit_count(s: EcsNodeSetSystemSetsDeep) -> i32 { return s.uninit2_n; }

fn ecs_system_sets_deep_initialize(s: EcsNodeSetSystemSetsDeep) -> EcsNodeSetSystemSetsDeep {
    s.uninit2_n = 0;
    return s;
}

// === SystemTypeSetAmbiguityError ===
@derive(copy)
struct EcsSystemTypeSetAmbiguityErrorDeep {
    key: i32,
}

fn ecs_system_type_set_ambiguity_error_deep_new(key: i32) -> EcsSystemTypeSetAmbiguityErrorDeep {
    return EcsSystemTypeSetAmbiguityErrorDeep { key: key };
}

fn ecs_system_type_set_ambiguity_error_deep_key(e: EcsSystemTypeSetAmbiguityErrorDeep) -> i32 { return e.key; }
