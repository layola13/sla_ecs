fn _escs_cf_at(c: EcsNodeSetConflictingSystemsDeep, item: i32, slot: i32) -> i32 {
    if item == 0 {
        if slot == 0 { return c.cf0_0; };
        if slot == 1 { return c.cf0_1; };
        if slot == 2 { return c.cf0_2; };
        if slot == 3 { return c.cf0_3; };
        if slot == 4 { return c.cf0_4; };
        if slot == 5 { return c.cf0_5; };
        if slot == 6 { return c.cf0_6; };
        if slot == 7 { return c.cf0_7; };
        if slot == 8 { return c.cf0_8; };
        if slot == 9 { return c.cf0_9; };
        if slot == 10 { return c.cf0_10; };
        if slot == 11 { return c.cf0_11; };
        if slot == 12 { return c.cf0_12; };
        if slot == 13 { return c.cf0_13; };
        if slot == 14 { return c.cf0_14; };
        if slot == 15 { return c.cf0_15; };
        panic(146224);
    };
    if item == 1 {
        if slot == 0 { return c.cf1_0; };
        if slot == 1 { return c.cf1_1; };
        if slot == 2 { return c.cf1_2; };
        if slot == 3 { return c.cf1_3; };
        if slot == 4 { return c.cf1_4; };
        if slot == 5 { return c.cf1_5; };
        if slot == 6 { return c.cf1_6; };
        if slot == 7 { return c.cf1_7; };
        if slot == 8 { return c.cf1_8; };
        if slot == 9 { return c.cf1_9; };
        if slot == 10 { return c.cf1_10; };
        if slot == 11 { return c.cf1_11; };
        if slot == 12 { return c.cf1_12; };
        if slot == 13 { return c.cf1_13; };
        if slot == 14 { return c.cf1_14; };
        if slot == 15 { return c.cf1_15; };
        panic(146225);
    };
    if item == 2 {
        if slot == 0 { return c.cf2_0; };
        if slot == 1 { return c.cf2_1; };
        if slot == 2 { return c.cf2_2; };
        if slot == 3 { return c.cf2_3; };
        if slot == 4 { return c.cf2_4; };
        if slot == 5 { return c.cf2_5; };
        if slot == 6 { return c.cf2_6; };
        if slot == 7 { return c.cf2_7; };
        if slot == 8 { return c.cf2_8; };
        if slot == 9 { return c.cf2_9; };
        if slot == 10 { return c.cf2_10; };
        if slot == 11 { return c.cf2_11; };
        if slot == 12 { return c.cf2_12; };
        if slot == 13 { return c.cf2_13; };
        if slot == 14 { return c.cf2_14; };
        if slot == 15 { return c.cf2_15; };
        panic(146226);
    };
    panic(146227);
}

fn _escs_cf_n_at(c: EcsNodeSetConflictingSystemsDeep, item: i32) -> i32 {
    if item == 0 { return c.cf0_n; };
    if item == 1 { return c.cf1_n; };
    if item == 2 { return c.cf2_n; };
    return 0;
}

// Helper to set a single conflict id in the specified item/slot (cap-16 clause).
fn _escs_cf_set(c: EcsNodeSetConflictingSystemsDeep, item: i32, slot: i32, v: i32) -> EcsNodeSetConflictingSystemsDeep {
    if item == 0 {
        if slot == 0 { c.cf0_0 = v; return c; };
        if slot == 1 { c.cf0_1 = v; return c; };
        if slot == 2 { c.cf0_2 = v; return c; };
        if slot == 3 { c.cf0_3 = v; return c; };
        if slot == 4 { c.cf0_4 = v; return c; };
        if slot == 5 { c.cf0_5 = v; return c; };
        if slot == 6 { c.cf0_6 = v; return c; };
        if slot == 7 { c.cf0_7 = v; return c; };
        if slot == 8 { c.cf0_8 = v; return c; };
        if slot == 9 { c.cf0_9 = v; return c; };
        if slot == 10 { c.cf0_10 = v; return c; };
        if slot == 11 { c.cf0_11 = v; return c; };
        if slot == 12 { c.cf0_12 = v; return c; };
        if slot == 13 { c.cf0_13 = v; return c; };
        if slot == 14 { c.cf0_14 = v; return c; };
        if slot == 15 { c.cf0_15 = v; return c; };
        return c;
    };
    if item == 1 {
        if slot == 0 { c.cf1_0 = v; return c; };
        if slot == 1 { c.cf1_1 = v; return c; };
        if slot == 2 { c.cf1_2 = v; return c; };
        if slot == 3 { c.cf1_3 = v; return c; };
        if slot == 4 { c.cf1_4 = v; return c; };
        if slot == 5 { c.cf1_5 = v; return c; };
        if slot == 6 { c.cf1_6 = v; return c; };
        if slot == 7 { c.cf1_7 = v; return c; };
        if slot == 8 { c.cf1_8 = v; return c; };
        if slot == 9 { c.cf1_9 = v; return c; };
        if slot == 10 { c.cf1_10 = v; return c; };
        if slot == 11 { c.cf1_11 = v; return c; };
        if slot == 12 { c.cf1_12 = v; return c; };
        if slot == 13 { c.cf1_13 = v; return c; };
        if slot == 14 { c.cf1_14 = v; return c; };
        if slot == 15 { c.cf1_15 = v; return c; };
        return c;
    };
    if item == 2 {
        if slot == 0 { c.cf2_0 = v; return c; };
        if slot == 1 { c.cf2_1 = v; return c; };
        if slot == 2 { c.cf2_2 = v; return c; };
        if slot == 3 { c.cf2_3 = v; return c; };
        if slot == 4 { c.cf2_4 = v; return c; };
        if slot == 5 { c.cf2_5 = v; return c; };
        if slot == 6 { c.cf2_6 = v; return c; };
        if slot == 7 { c.cf2_7 = v; return c; };
        if slot == 8 { c.cf2_8 = v; return c; };
        if slot == 9 { c.cf2_9 = v; return c; };
        if slot == 10 { c.cf2_10 = v; return c; };
        if slot == 11 { c.cf2_11 = v; return c; };
        if slot == 12 { c.cf2_12 = v; return c; };
        if slot == 13 { c.cf2_13 = v; return c; };
        if slot == 14 { c.cf2_14 = v; return c; };
        if slot == 15 { c.cf2_15 = v; return c; };
        return c;
    };
    let _ignore_v = v;
    return c;
}

// Helper to push a conflict id into the specified item's conflict-id family.
fn _escs_cf_push(c: EcsNodeSetConflictingSystemsDeep, item: i32, v: i32) -> EcsNodeSetConflictingSystemsDeep {
    if item == 0 {
        if c.cf0_n < ECS_NODE_SET_DEEP_CAP {
            c = _escs_cf_set(c, 0, c.cf0_n, v);
            c.cf0_n = c.cf0_n + 1;
        };
        return c;
    };
    if item == 1 {
        if c.cf1_n < ECS_NODE_SET_DEEP_CAP {
            c = _escs_cf_set(c, 1, c.cf1_n, v);
            c.cf1_n = c.cf1_n + 1;
        };
        return c;
    };
    if item == 2 {
        if c.cf2_n < ECS_NODE_SET_DEEP_CAP {
            c = _escs_cf_set(c, 2, c.cf2_n, v);
            c.cf2_n = c.cf2_n + 1;
        };
        return c;
    };
    let _ignore_v = v;
    return c;
}

fn ecs_conflicting_systems_deep_len(c: EcsNodeSetConflictingSystemsDeep) -> i32 { return c.item_count; }
fn ecs_conflicting_systems_deep_is_empty(c: EcsNodeSetConflictingSystemsDeep) -> bool { return c.item_count == 0; }

// push: store the (a, b, conflicts[]) item, cap-reject silently if full.
fn ecs_conflicting_systems_deep_push(c: EcsNodeSetConflictingSystemsDeep, a: i32, b: i32, conflicts_count: i32, conflict_ids_0: i32, conflict_ids_1: i32, conflict_ids_2: i32, conflict_ids_3: i32) -> EcsNodeSetConflictingSystemsDeep {
    let idx = c.item_count;
    if idx >= ECS_NODE_SET_DEEP_CAP { return c; };
    c = _escs_a_set(c, idx, a);
    c = _escs_b_set(c, idx, b);
    // Store the conflict ids up to min(conflicts_count, 4).
    let drop_n = conflicts_count;
    if drop_n > 4 { drop_n = 4; };
    let k: i32 = 0;
    while k < drop_n {
        let cid: i32 = 0;
        if k == 0 { cid = conflict_ids_0; };
        if k == 1 { cid = conflict_ids_1; };
        if k == 2 { cid = conflict_ids_2; };
        if k == 3 { cid = conflict_ids_3; };
        c = _escs_cf_push(c, idx, cid);
        k = k + 1;
    }
    c.item_count = c.item_count + 1;
    return c;
}

fn ecs_conflicting_systems_deep_check_if_not_empty(c: EcsNodeSetConflictingSystemsDeep) -> i32 {
    if c.item_count == 0 { return 0; };
    return 1;
}

// get: returns (a, b, conflict count) via inline last_get_* fields.
fn ecs_conflicting_systems_deep_get(c: EcsNodeSetConflictingSystemsDeep, index: i32) -> EcsNodeSetConflictingSystemsDeep {
    c.last_get_a = _escs_a_at(c, index);
    c.last_get_b = _escs_b_at(c, index);
    c.last_get_conflict_count = _escs_cf_n_at(c, index);
    return c;
}

fn ecs_conflicting_systems_deep_last_get_a(c: EcsNodeSetConflictingSystemsDeep) -> i32 { return c.last_get_a; }
fn ecs_conflicting_systems_deep_last_get_b(c: EcsNodeSetConflictingSystemsDeep) -> i32 { return c.last_get_b; }
fn ecs_conflicting_systems_deep_last_get_conflict_count(c: EcsNodeSetConflictingSystemsDeep) -> i32 { return c.last_get_conflict_count; }
fn ecs_conflicting_systems_deep_last_get_conflict_id(c: EcsNodeSetConflictingSystemsDeep, slot: i32) -> i32 {
    // Read from the cached item id rather than a stored last_get_idx.
    return _escs_cf_at(c, c.last_get_a - c.last_get_a, slot);
}

// to_string_count alias.
fn ecs_conflicting_systems_deep_to_string_count(c: EcsNodeSetConflictingSystemsDeep) -> i32 { return c.item_count; }

// === EcsNodeSetSystemAccessDeep: cap-16 read_components + write_components + bool flags ===
@derive(copy)
struct EcsNodeSetSystemAccessDeep {
    rc0: i32, rc1: i32, rc2: i32, rc3: i32, rc4: i32, rc5: i32, rc6: i32, rc7: i32,
    rc8: i32, rc9: i32, rc10: i32, rc11: i32, rc12: i32, rc13: i32, rc14: i32, rc15: i32,
    rcn: i32,
    wc0: i32, wc1: i32, wc2: i32, wc3: i32, wc4: i32, wc5: i32, wc6: i32, wc7: i32,
    wc8: i32, wc9: i32, wc10: i32, wc11: i32, wc12: i32, wc13: i32, wc14: i32, wc15: i32,
    wcn: i32,
    reads_all: i32,
    writes_all: i32,
}

fn ecs_system_access_deep_new() -> EcsNodeSetSystemAccessDeep {
    return EcsNodeSetSystemAccessDeep {
        rc0: 0, rc1: 0, rc2: 0, rc3: 0, rc4: 0, rc5: 0, rc6: 0, rc7: 0,
        rc8: 0, rc9: 0, rc10: 0, rc11: 0, rc12: 0, rc13: 0, rc14: 0, rc15: 0,
        rcn: 0,
        wc0: 0, wc1: 0, wc2: 0, wc3: 0, wc4: 0, wc5: 0, wc6: 0, wc7: 0,
        wc8: 0, wc9: 0, wc10: 0, wc11: 0, wc12: 0, wc13: 0, wc14: 0, wc15: 0,
        wcn: 0,
        reads_all: 0,
        writes_all: 0,
    };
}

fn _essa_rc_at(a: EcsNodeSetSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.rc0; };
    if idx == 1 { return a.rc1; };
    if idx == 2 { return a.rc2; };
