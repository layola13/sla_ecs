// Deepened Bevy ECS system adapter surface.
// Mirrors src/system/adapter_system.rs Not/Map/Chain/AdapterSystem.
// Shallow retained.

struct EcsSaeErrDeep {
    code: i32,
    payload: i64,
}

fn ecs_sae_ok() -> EcsSaeErrDeep { return EcsSaeErrDeep { code: 0, payload: 0 }; }
fn ecs_sae_err(code: i32, payload: i64) -> EcsSaeErrDeep {
    return EcsSaeErrDeep { code: code, payload: payload };
}
fn ecs_sae_is_ok(e: EcsSaeErrDeep) -> bool { return e.code == 0; }
fn ecs_sae_payload(e: EcsSaeErrDeep) -> i64 { return e.payload; }

struct EcsSaeNotDeep { tag: i32 }
fn ecs_sae_not_new() -> EcsSaeNotDeep { return EcsSaeNotDeep { tag: 1 }; }

struct EcsSaeNotResDeep {
    err: EcsSaeErrDeep,
    value: bool,
}
fn ecs_sae_not_res_err(r: EcsSaeNotResDeep) -> EcsSaeErrDeep { return r.err; }
fn ecs_sae_not_res_value(r: EcsSaeNotResDeep) -> bool { return r.value; }

fn ecs_sae_not_adapt(marker: EcsSaeNotDeep, inner_result: bool, inner_err: EcsSaeErrDeep) -> EcsSaeNotResDeep {
    let _ = marker;
    if ecs_sae_is_ok(inner_err) {
        let inv = false;
        if inner_result != true { inv = true; };
        return EcsSaeNotResDeep { err: ecs_sae_ok(), value: inv };
    };
    return EcsSaeNotResDeep { err: inner_err, value: false };
}

struct EcsSaeSysDeep {
    func_kind: i32,
    inner_value: i64,
    name: i64,
}

fn ecs_sae_sys_new(func_kind: i32, inner_value: i64, name: i64) -> EcsSaeSysDeep {
    return EcsSaeSysDeep { func_kind: func_kind, inner_value: inner_value, name: name };
}
fn ecs_sae_sys_kind(s: EcsSaeSysDeep) -> i32 { return s.func_kind; }
fn ecs_sae_sys_name(s: EcsSaeSysDeep) -> i64 { return s.name; }

struct EcsSaeRunDeep {
    err: EcsSaeErrDeep,
    value: i64,
}
fn ecs_sae_run_err(r: EcsSaeRunDeep) -> EcsSaeErrDeep { return r.err; }
fn ecs_sae_run_value(r: EcsSaeRunDeep) -> i64 { return r.value; }

fn ecs_sae_sys_run(s: EcsSaeSysDeep, input: i64) -> EcsSaeRunDeep {
    if s.func_kind == 0 {
        let out = 0;
        if s.inner_value == 0 { out = 1; };
        return EcsSaeRunDeep { err: ecs_sae_ok(), value: out };
    };
    if s.func_kind == 1 {
        return EcsSaeRunDeep { err: ecs_sae_ok(), value: input + s.inner_value };
    };
    return EcsSaeRunDeep { err: ecs_sae_ok(), value: s.inner_value + input };
}

struct EcsSaeIntoDeep {
    func_kind: i32,
    inner_value: i64,
}
fn ecs_sae_into_new(func_kind: i32, inner_value: i64) -> EcsSaeIntoDeep {
    return EcsSaeIntoDeep { func_kind: func_kind, inner_value: inner_value };
}
fn ecs_sae_into_system(s: EcsSaeIntoDeep, name: i64) -> EcsSaeSysDeep {
    return ecs_sae_sys_new(s.func_kind, s.inner_value, name);
}

struct EcsSaeMapDeep { offset: i64 }
fn ecs_sae_map_new(offset: i64) -> EcsSaeMapDeep { return EcsSaeMapDeep { offset: offset }; }
fn ecs_sae_map_adapt(m: EcsSaeMapDeep, inner_value: i64, inner_err: EcsSaeErrDeep) -> EcsSaeRunDeep {
    if ecs_sae_is_ok(inner_err) {
        return EcsSaeRunDeep { err: ecs_sae_ok(), value: inner_value + m.offset };
    };
    return EcsSaeRunDeep { err: inner_err, value: 0 };
}

struct EcsSaeChainDeep { second_offset: i64 }
fn ecs_sae_chain_new(second_offset: i64) -> EcsSaeChainDeep {
    return EcsSaeChainDeep { second_offset: second_offset };
}
fn ecs_sae_chain_adapt(c: EcsSaeChainDeep, first_output: i64, first_err: EcsSaeErrDeep) -> EcsSaeRunDeep {
    if ecs_sae_is_ok(first_err) {
        return EcsSaeRunDeep { err: ecs_sae_ok(), value: first_output + c.second_offset };
    };
    return EcsSaeRunDeep { err: first_err, value: 0 };
}

struct EcsSaeMarkDeep { tag: i32 }
fn ecs_sae_mark_new() -> EcsSaeMarkDeep { return EcsSaeMarkDeep { tag: 1 }; }
fn ecs_sae_mark_tag(m: EcsSaeMarkDeep) -> i32 { return m.tag; }
