// Bevy ECS EntityRef extras — the EntityRef pub surface not in lib/entity_access.sla.
// Mirrors src/world/entity_access/entity_ref.rs (gaps not in lib/entity_access.sla).
// Uncovered Bevy pub fns: into_filtered / location / archetype / contains_id / contains_type_id /
// get_ref / get_change_ticks / get_changed_by / get_change_ticks_by_id / get_by_id / components /
// get_components / spawned_by / spawn_tick.

// A tiny entity model: component-id-keyed column store per entity.
struct EcsEntityRefModel {
    entity_id: i32,
    archetype_id: i32,
    location_archetype: i32,
    location_table_row: i32,
    spawn_tick: i32,
    spawned_by_id: i32,
    component_ids: Vec<i32>,
    type_ids: Vec<i32>,
    values: Vec<i32>,
    added_ticks: Vec<i32>,
    changed_ticks: Vec<i32>,
    changed_by_ids: Vec<i32>,
}

fn ecs_entity_ref_extra_new(entity_id: i32) -> EcsEntityRefModel {
    let r = EcsEntityRefModel { entity_id: entity_id, archetype_id: 0, location_archetype: 0, location_table_row: 0, spawn_tick: 0, spawned_by_id: 0, component_ids: Vec::new(), type_ids: Vec::new(), values: Vec::new(), added_ticks: Vec::new(), changed_ticks: Vec::new(), changed_by_ids: Vec::new() };
    return r;
}

fn ecs_entity_ref_extra_id(r: EcsEntityRefModel) -> i32 {
    return r.entity_id;
}

// location: returns archetype_id + table_row as a result struct
struct EcsEntityLocationResult {
    archetype: i32,
    table_row: i32,
}

fn ecs_entity_ref_extra_location(r: EcsEntityRefModel) -> EcsEntityLocationResult {
    let res = EcsEntityLocationResult { archetype: r.location_archetype, table_row: r.location_table_row };
    return res;
}

fn ecs_entity_ref_extra_location_archetype(res: EcsEntityLocationResult) -> i32 {
    return res.archetype;
}

fn ecs_entity_ref_extra_location_table_row(res: EcsEntityLocationResult) -> i32 {
    return res.table_row;
}

fn ecs_entity_ref_extra_archetype(r: EcsEntityRefModel) -> i32 {
    return r.archetype_id;
}

fn ecs_entity_ref_extra_spawn_tick(r: EcsEntityRefModel) -> i32 {
    return r.spawn_tick;
}

fn ecs_entity_ref_extra_spawned_by(r: EcsEntityRefModel) -> i32 {
    return r.spawned_by_id;
}

// add a component slot to the entity (used to populate in tests)
fn ecs_entity_ref_extra_add(r: EcsEntityRefModel, component_id: i32, type_id: i32, tick: i32, spawned_by: i32) -> EcsEntityRefModel {
    r.component_ids.push(component_id);
    r.type_ids.push(type_id);
    r.values.push(0);
    r.added_ticks.push(tick);
    r.changed_ticks.push(tick);
    r.changed_by_ids.push(spawned_by);
    return r;
}

fn ecs_entity_ref_extra_set_archetype_location(r: EcsEntityRefModel, archetype_id: i32, table_row: i32) -> EcsEntityRefModel {
    r.archetype_id = archetype_id;
    r.location_archetype = archetype_id;
    r.location_table_row = table_row;
    return r;
}

fn ecs_entity_ref_extra_set_spawn(r: EcsEntityRefModel, spawn_tick: i32, spawned_by: i32) -> EcsEntityRefModel {
    r.spawn_tick = spawn_tick;
    r.spawned_by_id = spawned_by;
    return r;
}

// contains_id / contains_type_id: linear scan over stored component_ids/type_ids.
fn ecs_entity_ref_extra_contains_id(r: EcsEntityRefModel, component_id: i32) -> bool {
    let n: i32 = len(r.component_ids) as i32;
    let i: i32 = 0;
    while i < n { if r.component_ids[i] == component_id { return true; }; i = i + 1; }
    return false;
}

fn ecs_entity_ref_extra_contains_type_id(r: EcsEntityRefModel, type_id: i32) -> bool {
    let n: i32 = len(r.type_ids) as i32;
    let i: i32 = 0;
    while i < n { if r.type_ids[i] == type_id { return true; }; i = i + 1; }
    return false;
}

// get_by_id: returns the i32 value at the component_id slot, or NotFound (-1).
fn ecs_entity_ref_extra_get_by_id(r: EcsEntityRefModel, component_id: i32) -> i32 {
    let n: i32 = len(r.component_ids) as i32;
    let i: i32 = 0;
    while i < n { if r.component_ids[i] == component_id { return r.values[i]; }; i = i + 1; }
    return -1;
}

// get_change_ticks_by_id: returns (added_tick, changed_tick) via result struct
struct ComponentTicksResult {
    found: i32,
    added_tick: i32,
    changed_tick: i32,
}

fn ecs_entity_ref_extra_get_change_ticks_by_id(r: EcsEntityRefModel, component_id: i32) -> ComponentTicksResult {
    let n: i32 = len(r.component_ids) as i32;
    let i: i32 = 0;
    while i < n { if r.component_ids[i] == component_id { let res = ComponentTicksResult { found: 1, added_tick: r.added_ticks[i], changed_tick: r.changed_ticks[i] }; return res; }; i = i + 1; }
    let res = ComponentTicksResult { found: 0, added_tick: 0, changed_tick: 0 };
    return res;
}

fn ecs_ct_found(res: ComponentTicksResult) -> bool {
    return res.found == 1;
}

fn ecs_ct_added_tick(res: ComponentTicksResult) -> i32 {
    return res.added_tick;
}

fn ecs_ct_changed_tick(res: ComponentTicksResult) -> i32 {
    return res.changed_tick;
}

// get_changed_by: returns the changed-by id for the component_id, or -1.
fn ecs_entity_ref_extra_get_changed_by(r: EcsEntityRefModel, component_id: i32) -> i32 {
    let n: i32 = len(r.component_ids) as i32;
    let i: i32 = 0;
    while i < n { if r.component_ids[i] == component_id { return r.changed_by_ids[i]; }; i = i + 1; }
    return -1;
}

// get_ref: returns the value with added/changed/changed-by (a "Ref<T>"); found flag.
struct EcsRefResult {
    found: i32,
    value: i32,
    added_tick: i32,
    changed_tick: i32,
    changed_by_id: i32,
}

fn ecs_entity_ref_extra_get_ref(r: EcsEntityRefModel, component_id: i32) -> EcsRefResult {
    let n: i32 = len(r.component_ids) as i32;
    let i: i32 = 0;
    while i < n { if r.component_ids[i] == component_id { let res = EcsRefResult { found: 1, value: r.values[i], added_tick: r.added_ticks[i], changed_tick: r.changed_ticks[i], changed_by_id: r.changed_by_ids[i] }; return res; }; i = i + 1; }
    let res = EcsRefResult { found: 0, value: 0, added_tick: 0, changed_tick: 0, changed_by_id: 0 };
    return res;
}

fn ecs_ref_found(res: EcsRefResult) -> bool {
    return res.found == 1;
}

fn ecs_ref_value(res: EcsRefResult) -> i32 {
    return res.value;
}

fn ecs_ref_added_tick(res: EcsRefResult) -> i32 {
    return res.added_tick;
}

fn ecs_ref_changed_tick(res: EcsRefResult) -> i32 {
    return res.changed_tick;
}

fn ecs_ref_changed_by_id(res: EcsRefResult) -> i32 {
    return res.changed_by_id;
}

// get_change_ticks: an alias typed-by-component-id; we model with an explicit component_id arg.
fn ecs_entity_ref_extra_get_change_ticks(r: EcsEntityRefModel, component_id: i32) -> ComponentTicksResult {
    return ecs_entity_ref_extra_get_change_ticks_by_id(r, component_id);
}

// components: returns how many of the requested component ids are present (matches the Bevy
// "fetch all of the queried components and report how many were found" semantics).
fn ecs_entity_ref_extra_components_count(r: EcsEntityRefModel, requested: Vec<i32>) -> i32 {
    let n: i32 = len(requested) as i32;
    let count: i32 = 0;
    let i: i32 = 0;
    while i < n { if ecs_entity_ref_extra_contains_id(r, requested[i]) { count = count + 1; }; i = i + 1; }
    return count;
}

// get_components: same shape as components (read-only multi-fetch), with a scalar reduce.
// Bevy returns Option<...> only if ALL of the requested ids are present; here we return 1 if all
// present, else 0.
fn ecs_entity_ref_extra_get_components_result(r: EcsEntityRefModel, requested: Vec<i32>) -> i32 {
    let n: i32 = len(requested) as i32;
    let i: i32 = 0;
    while i < n { if !ecs_entity_ref_extra_contains_id(r, requested[i]) { return 0; }; i = i + 1; }
    return 1;
}

// into_filtered: returns a FilteredEntityRef model (record the access-readall semantics).
// We model it as simply returning a fresh struct that flattens the component set + an access id sentinel.
struct EcsFilteredEntityRef {
    entity_id: i32,
    access_id: i32,
    component_count: i32,
}

fn ecs_filtered_entity_ref_entity_id(f: EcsFilteredEntityRef) -> i32 {
    return f.entity_id;
}

fn ecs_filtered_entity_ref_access_id(f: EcsFilteredEntityRef) -> i32 {
    return f.access_id;
}

fn ecs_filtered_entity_ref_component_count(f: EcsFilteredEntityRef) -> i32 {
    return f.component_count;
}

fn ecs_entity_ref_extra_into_filtered(r: EcsEntityRefModel) -> EcsFilteredEntityRef {
    let f = EcsFilteredEntityRef { entity_id: r.entity_id, access_id: -1, component_count: len(r.component_ids) as i32 };
    return f;
}
