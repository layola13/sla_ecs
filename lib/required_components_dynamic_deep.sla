// Deep bed for lib/required_components_dynamic.sla (Batch 395).
// Self-contained fixed-cap model of direct/all required-component registration.
// Vec<i32> direct_ids/all_ids become cap-16 slot families. No @import, no Vec.

const ECS_RCD_CAP: i32 = 16;
const ECS_RCD_ERR_DUPLICATE: i32 = 0;

struct EcsReqDynResultDeep { ok: i32, err_kind: i32, direct_len: i32, all_len: i32 }
fn ecs_rcd_result_ok(r: EcsReqDynResultDeep) -> i32 { return r.ok; }
fn ecs_rcd_result_err_kind(r: EcsReqDynResultDeep) -> i32 { return r.err_kind; }
fn ecs_rcd_result_direct_len(r: EcsReqDynResultDeep) -> i32 { return r.direct_len; }
fn ecs_rcd_result_all_len(r: EcsReqDynResultDeep) -> i32 { return r.all_len; }

struct EcsRequiredComponentsDynDeep {
    direct_count: i32, all_count: i32,
    direct_id0: i32, direct_id1: i32, direct_id2: i32, direct_id3: i32, direct_id4: i32, direct_id5: i32, direct_id6: i32, direct_id7: i32, direct_id8: i32, direct_id9: i32, direct_id10: i32, direct_id11: i32, direct_id12: i32, direct_id13: i32, direct_id14: i32, direct_id15: i32,
    all_id0: i32, all_id1: i32, all_id2: i32, all_id3: i32, all_id4: i32, all_id5: i32, all_id6: i32, all_id7: i32, all_id8: i32, all_id9: i32, all_id10: i32, all_id11: i32, all_id12: i32, all_id13: i32, all_id14: i32, all_id15: i32,
}

fn ecs_rcd_new() -> EcsRequiredComponentsDynDeep { return EcsRequiredComponentsDynDeep { direct_count: 0, all_count: 0, direct_id0: 0, direct_id1: 0, direct_id2: 0, direct_id3: 0, direct_id4: 0, direct_id5: 0, direct_id6: 0, direct_id7: 0, direct_id8: 0, direct_id9: 0, direct_id10: 0, direct_id11: 0, direct_id12: 0, direct_id13: 0, direct_id14: 0, direct_id15: 0, all_id0: 0, all_id1: 0, all_id2: 0, all_id3: 0, all_id4: 0, all_id5: 0, all_id6: 0, all_id7: 0, all_id8: 0, all_id9: 0, all_id10: 0, all_id11: 0, all_id12: 0, all_id13: 0, all_id14: 0, all_id15: 0 }; }
fn ecs_rcd_direct_count(r: EcsRequiredComponentsDynDeep) -> i32 { return r.direct_count; }
fn ecs_rcd_all_count(r: EcsRequiredComponentsDynDeep) -> i32 { return r.all_count; }
fn ecs_rcd_err_dup_kind() -> i32 { return ECS_RCD_ERR_DUPLICATE; }

fn _ecs_rcd_direct_id_at(r: EcsRequiredComponentsDynDeep, idx: i32) -> i32 {
    if idx < 0 { return -1; };
    if idx >= ECS_RCD_CAP { return -1; };
    if idx == 0 { return r.direct_id0; };
    if idx == 1 { return r.direct_id1; };
    if idx == 2 { return r.direct_id2; };
    if idx == 3 { return r.direct_id3; };
    if idx == 4 { return r.direct_id4; };
    if idx == 5 { return r.direct_id5; };
    if idx == 6 { return r.direct_id6; };
    if idx == 7 { return r.direct_id7; };
    if idx == 8 { return r.direct_id8; };
    if idx == 9 { return r.direct_id9; };
    if idx == 10 { return r.direct_id10; };
    if idx == 11 { return r.direct_id11; };
    if idx == 12 { return r.direct_id12; };
    if idx == 13 { return r.direct_id13; };
    if idx == 14 { return r.direct_id14; };
    return r.direct_id15;
}

fn _ecs_rcd_set_direct_id(r: EcsRequiredComponentsDynDeep, idx: i32, value: i32) -> EcsRequiredComponentsDynDeep {
    if idx == 0 { r.direct_id0 = value; return r; };
    if idx == 1 { r.direct_id1 = value; return r; };
    if idx == 2 { r.direct_id2 = value; return r; };
    if idx == 3 { r.direct_id3 = value; return r; };
    if idx == 4 { r.direct_id4 = value; return r; };
    if idx == 5 { r.direct_id5 = value; return r; };
    if idx == 6 { r.direct_id6 = value; return r; };
    if idx == 7 { r.direct_id7 = value; return r; };
    if idx == 8 { r.direct_id8 = value; return r; };
    if idx == 9 { r.direct_id9 = value; return r; };
    if idx == 10 { r.direct_id10 = value; return r; };
    if idx == 11 { r.direct_id11 = value; return r; };
    if idx == 12 { r.direct_id12 = value; return r; };
    if idx == 13 { r.direct_id13 = value; return r; };
    if idx == 14 { r.direct_id14 = value; return r; };
    r.direct_id15 = value; return r;
}

fn _ecs_rcd_all_id_at(r: EcsRequiredComponentsDynDeep, idx: i32) -> i32 {
    if idx < 0 { return -1; };
    if idx >= ECS_RCD_CAP { return -1; };
    if idx == 0 { return r.all_id0; };
    if idx == 1 { return r.all_id1; };
    if idx == 2 { return r.all_id2; };
    if idx == 3 { return r.all_id3; };
    if idx == 4 { return r.all_id4; };
    if idx == 5 { return r.all_id5; };
    if idx == 6 { return r.all_id6; };
    if idx == 7 { return r.all_id7; };
    if idx == 8 { return r.all_id8; };
    if idx == 9 { return r.all_id9; };
    if idx == 10 { return r.all_id10; };
    if idx == 11 { return r.all_id11; };
    if idx == 12 { return r.all_id12; };
    if idx == 13 { return r.all_id13; };
    if idx == 14 { return r.all_id14; };
    return r.all_id15;
}

fn _ecs_rcd_set_all_id(r: EcsRequiredComponentsDynDeep, idx: i32, value: i32) -> EcsRequiredComponentsDynDeep {
    if idx == 0 { r.all_id0 = value; return r; };
    if idx == 1 { r.all_id1 = value; return r; };
    if idx == 2 { r.all_id2 = value; return r; };
    if idx == 3 { r.all_id3 = value; return r; };
    if idx == 4 { r.all_id4 = value; return r; };
    if idx == 5 { r.all_id5 = value; return r; };
    if idx == 6 { r.all_id6 = value; return r; };
    if idx == 7 { r.all_id7 = value; return r; };
    if idx == 8 { r.all_id8 = value; return r; };
    if idx == 9 { r.all_id9 = value; return r; };
    if idx == 10 { r.all_id10 = value; return r; };
    if idx == 11 { r.all_id11 = value; return r; };
    if idx == 12 { r.all_id12 = value; return r; };
    if idx == 13 { r.all_id13 = value; return r; };
    if idx == 14 { r.all_id14 = value; return r; };
    r.all_id15 = value; return r;
}

fn ecs_rcd_direct_at(r: EcsRequiredComponentsDynDeep, idx: i32) -> i32 { if idx < 0 { return -1; }; if idx >= r.direct_count { return -1; }; return _ecs_rcd_direct_id_at(r, idx); }
fn ecs_rcd_all_at(r: EcsRequiredComponentsDynDeep, idx: i32) -> i32 { if idx < 0 { return -1; }; if idx >= r.all_count { return -1; }; return _ecs_rcd_all_id_at(r, idx); }
fn ecs_rcd_iter_count(r: EcsRequiredComponentsDynDeep) -> i32 { return r.all_count; }
fn ecs_rcd_iter_nth(r: EcsRequiredComponentsDynDeep, n: i32) -> i32 { return ecs_rcd_all_at(r, n); }

fn _ecs_rcd_direct_contains(r: EcsRequiredComponentsDynDeep, component_id: i32) -> bool {
    let i: i32 = 0;
    while i < r.direct_count { if _ecs_rcd_direct_id_at(r, i) == component_id { return true; }; i = i + 1; }
    return false;
}

fn _ecs_rcd_all_contains(r: EcsRequiredComponentsDynDeep, component_id: i32) -> bool {
    let i: i32 = 0;
    while i < r.all_count { if _ecs_rcd_all_id_at(r, i) == component_id { return true; }; i = i + 1; }
    return false;
}

struct EcsReqDynMutResultDeep { required: EcsRequiredComponentsDynDeep, result: EcsReqDynResultDeep }
fn ecs_rcd_mut_required(r: EcsReqDynMutResultDeep) -> EcsRequiredComponentsDynDeep { return r.required; }
fn ecs_rcd_mut_result(r: EcsReqDynMutResultDeep) -> EcsReqDynResultDeep { return r.result; }

fn _ecs_rcd_push_head_all(r: EcsRequiredComponentsDynDeep, component_id: i32) -> EcsRequiredComponentsDynDeep {
    let i = r.all_count;
    while i > 0 {
        let prev = _ecs_rcd_all_id_at(r, i - 1);
        r = _ecs_rcd_set_all_id(r, i, prev);
        i = i - 1;
    }
    r = _ecs_rcd_set_all_id(r, 0, component_id);
    r.all_count = r.all_count + 1;
    return r;
}

fn ecs_rcd_register_dynamic_with_result(r: EcsRequiredComponentsDynDeep, component_id: i32, constructor_id: i32) -> EcsReqDynMutResultDeep {
    if _ecs_rcd_direct_contains(r, component_id) {
        let res = EcsReqDynResultDeep { ok: 0, err_kind: ECS_RCD_ERR_DUPLICATE, direct_len: r.direct_count, all_len: r.all_count };
        return EcsReqDynMutResultDeep { required: r, result: res };
    };
    if r.direct_count >= ECS_RCD_CAP {
        let res = EcsReqDynResultDeep { ok: 0, err_kind: ECS_RCD_ERR_DUPLICATE, direct_len: r.direct_count, all_len: r.all_count };
        return EcsReqDynMutResultDeep { required: r, result: res };
    };
    r = _ecs_rcd_set_direct_id(r, r.direct_count, component_id);
    r.direct_count = r.direct_count + 1;
    r = _ecs_rcd_push_head_all(r, component_id);
    let res = EcsReqDynResultDeep { ok: 1, err_kind: -1, direct_len: r.direct_count, all_len: r.all_count };
    return EcsReqDynMutResultDeep { required: r, result: res };
}

fn ecs_rcd_register_dynamic_with(r: EcsRequiredComponentsDynDeep, component_id: i32, constructor_id: i32) -> EcsReqDynResultDeep {
    let m = ecs_rcd_register_dynamic_with_result(r, component_id, constructor_id);
    return ecs_rcd_mut_result(m);
}
fn ecs_rcd_register_by_id(r: EcsRequiredComponentsDynDeep, component_id: i32, constructor_id: i32) -> EcsReqDynResultDeep { return ecs_rcd_register_dynamic_with(r, component_id, constructor_id); }
fn ecs_rcd_register_dynamic_with_mut(r: EcsRequiredComponentsDynDeep, component_id: i32, constructor_id: i32) -> EcsRequiredComponentsDynDeep { return ecs_rcd_mut_required(ecs_rcd_register_dynamic_with_result(r, component_id, constructor_id)); }
fn ecs_rcd_register_by_id_mut(r: EcsRequiredComponentsDynDeep, component_id: i32, constructor_id: i32) -> EcsRequiredComponentsDynDeep { return ecs_rcd_register_dynamic_with_mut(r, component_id, constructor_id); }

struct EcsRequiredComponentsRegistratorDynDeep { target_component_id: i32, required: EcsRequiredComponentsDynDeep, components_next_id: i32, last_ok: i32, last_err_kind: i32 }
fn ecs_rcd_registrator_new(target_component_id: i32) -> EcsRequiredComponentsRegistratorDynDeep { return EcsRequiredComponentsRegistratorDynDeep { target_component_id: target_component_id, required: ecs_rcd_new(), components_next_id: 100, last_ok: 1, last_err_kind: -1 }; }
fn ecs_rcd_registrator_target(r: EcsRequiredComponentsRegistratorDynDeep) -> i32 { return r.target_component_id; }
fn ecs_rcd_registrator_components_next_id(r: EcsRequiredComponentsRegistratorDynDeep) -> i32 { return r.components_next_id; }
fn ecs_rcd_registrator_last_ok(r: EcsRequiredComponentsRegistratorDynDeep) -> i32 { return r.last_ok; }
fn ecs_rcd_registrator_last_err_kind(r: EcsRequiredComponentsRegistratorDynDeep) -> i32 { return r.last_err_kind; }
fn ecs_rcd_registrator_required_direct_count(r: EcsRequiredComponentsRegistratorDynDeep) -> i32 { return ecs_rcd_direct_count(r.required); }
fn ecs_rcd_registrator_required_all_count(r: EcsRequiredComponentsRegistratorDynDeep) -> i32 { return ecs_rcd_all_count(r.required); }
fn ecs_rcd_registrator_required_direct_at(r: EcsRequiredComponentsRegistratorDynDeep, idx: i32) -> i32 { return ecs_rcd_direct_at(r.required, idx); }
fn ecs_rcd_registrator_required_all_at(r: EcsRequiredComponentsRegistratorDynDeep, idx: i32) -> i32 { return ecs_rcd_all_at(r.required, idx); }

fn _ecs_rcd_registrator_apply(r: EcsRequiredComponentsRegistratorDynDeep, component_id: i32, constructor_id: i32) -> EcsRequiredComponentsRegistratorDynDeep {
    let m = ecs_rcd_register_dynamic_with_result(r.required, component_id, constructor_id);
    let res = ecs_rcd_mut_result(m);
    r.required = ecs_rcd_mut_required(m);
    r.last_ok = res.ok;
    r.last_err_kind = res.err_kind;
    return r;
}
fn ecs_rcd_registrator_register_required_by_id(r: EcsRequiredComponentsRegistratorDynDeep, component_id: i32, constructor_id: i32) -> EcsRequiredComponentsRegistratorDynDeep { return _ecs_rcd_registrator_apply(r, component_id, constructor_id); }
fn ecs_rcd_registrator_register_required_dynamic_with(r: EcsRequiredComponentsRegistratorDynDeep, component_id: i32, constructor_id: i32) -> EcsRequiredComponentsRegistratorDynDeep { return _ecs_rcd_registrator_apply(r, component_id, constructor_id); }
