// Deepened Bevy ECS BlobArray surface.
// Mirrors src/storage/blob_array.rs:
//   with_capacity / layout / is_zst / get_drop
//   initialize / replace / get / get_sub_slice
//   swap_remove / swap_remove_and_drop / clear / drop_last / drop_all
// Shallow lib/blob_array.sla retained.
// Fixed capacity 8 typed-erased i64 slots + drop_count observability.

struct EcsBaDeep {
    item_size: i64,
    item_align: i64,
    has_drop: bool,
    capacity: i32,
    len: i32,
    d0: i64, d1: i64, d2: i64, d3: i64, d4: i64, d5: i64, d6: i64, d7: i64,
    drop_count: i32, // how many elements conceptually dropped
}

fn ecs_ba_new(item_size: i64, item_align: i64, has_drop: bool) -> EcsBaDeep {
    return EcsBaDeep {
        item_size: item_size, item_align: item_align, has_drop: has_drop,
        capacity: 8, len: 0,
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        drop_count: 0,
    };
}

fn ecs_ba_with_capacity(item_size: i64, item_align: i64, has_drop: bool, capacity: i32) -> EcsBaDeep {
    let c = capacity;
    if c > 8 { c = 8; };
    if c < 0 { c = 0; };
    return EcsBaDeep {
        item_size: item_size, item_align: item_align, has_drop: has_drop,
        capacity: c, len: 0,
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        drop_count: 0,
    };
}

fn ecs_ba_layout_size(b: EcsBaDeep) -> i64 { return b.item_size; }
fn ecs_ba_layout_align(b: EcsBaDeep) -> i64 { return b.item_align; }
fn ecs_ba_is_zst(b: EcsBaDeep) -> bool {
    if b.item_size == 0 { return true; };
    return false;
}
fn ecs_ba_get_drop(b: EcsBaDeep) -> bool { return b.has_drop; }
fn ecs_ba_len(b: EcsBaDeep) -> i32 { return b.len; }
fn ecs_ba_capacity(b: EcsBaDeep) -> i32 { return b.capacity; }
fn ecs_ba_is_empty(b: EcsBaDeep) -> bool {
    if b.len == 0 { return true; };
    return false;
}
fn ecs_ba_drop_count(b: EcsBaDeep) -> i32 { return b.drop_count; }

fn ecs_ba_get(b: EcsBaDeep, index: i32) -> (bool, i64) {
    if index < 0 || index >= b.len { return (false, 0); };
    if index == 0 { return (true, b.d0); };
    if index == 1 { return (true, b.d1); };
    if index == 2 { return (true, b.d2); };
    if index == 3 { return (true, b.d3); };
    if index == 4 { return (true, b.d4); };
    if index == 5 { return (true, b.d5); };
    if index == 6 { return (true, b.d6); };
    if index == 7 { return (true, b.d7); };
    return (false, 0);
}

fn ecs_ba_get_ptr(b: EcsBaDeep) -> (bool, i64) {
    if b.len <= 0 { return (false, 0); };
    return (true, b.d0);
}

fn ecs_ba_set_at(b: EcsBaDeep, index: i32, value: i64) -> EcsBaDeep {
    if index == 0 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: value, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 1 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: value, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 2 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: b.d1, d2: value, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 3 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: b.d1, d2: b.d2, d3: value, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 4 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: value, d5: b.d5, d6: b.d6, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 5 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: value, d6: b.d6, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 6 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: value, d7: b.d7,
            drop_count: b.drop_count,
        };
    };
    if index == 7 {
        return EcsBaDeep {
            item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
            capacity: b.capacity, len: b.len,
            d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: value,
            drop_count: b.drop_count,
        };
    };
    return b;
}

fn ecs_ba_with_len(b: EcsBaDeep, len: i32) -> EcsBaDeep {
    return EcsBaDeep {
        item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
        capacity: b.capacity, len: len,
        d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
        drop_count: b.drop_count,
    };
}

fn ecs_ba_with_drop_count(b: EcsBaDeep, drop_count: i32) -> EcsBaDeep {
    return EcsBaDeep {
        item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
        capacity: b.capacity, len: b.len,
        d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
        drop_count: drop_count,
    };
}

// initialize_unchecked: index must be == len (append) or within reserved
fn ecs_ba_initialize(b: EcsBaDeep, index: i32, value: i64) -> EcsBaDeep {
    if index != b.len { return b; };
    if b.len >= b.capacity { return b; };
    if b.len >= 8 { return b; };
    let b2 = ecs_ba_with_len(b, b.len + 1);
    return ecs_ba_set_at(b2, index, value);
}

fn ecs_ba_replace(b: EcsBaDeep, index: i32, value: i64) -> EcsBaDeep {
    if index < 0 || index >= b.len { return b; };
    let has_drop = b.has_drop;
    let drops = b.drop_count;
    if has_drop {
        drops = drops + 1;
    };
    let b2 = ecs_ba_with_drop_count(b, drops);
    return ecs_ba_set_at(b2, index, value);
}

fn ecs_ba_swap_remove(b: EcsBaDeep, index: i32) -> EcsBaDeep {
    if index < 0 || index >= b.len { return b; };
    let last = b.len - 1;
    if index != last {
        let g = ecs_ba_get(b, last);
        let b2 = ecs_ba_set_at(b, index, g.1);
        return ecs_ba_with_len(b2, last);
    };
    return ecs_ba_with_len(b, last);
}

fn ecs_ba_swap_remove_and_drop(b: EcsBaDeep, index: i32) -> EcsBaDeep {
    if index < 0 || index >= b.len { return b; };
    let has_drop = b.has_drop;
    let drops = b.drop_count;
    if has_drop {
        drops = drops + 1;
    };
    let b2 = ecs_ba_with_drop_count(b, drops);
    return ecs_ba_swap_remove(b2, index);
}

fn ecs_ba_clear(b: EcsBaDeep) -> EcsBaDeep {
    let drops = b.drop_count;
    if b.has_drop {
        drops = drops + b.len;
    };
    return EcsBaDeep {
        item_size: b.item_size, item_align: b.item_align, has_drop: b.has_drop,
        capacity: b.capacity, len: 0,
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        drop_count: drops,
    };
}

fn ecs_ba_drop_last(b: EcsBaDeep) -> EcsBaDeep {
    if b.len <= 0 { return b; };
    let new_len = b.len - 1;
    let has_drop = b.has_drop;
    let drops = b.drop_count;
    if has_drop {
        drops = drops + 1;
    };
    let b2 = ecs_ba_with_drop_count(b, drops);
    return ecs_ba_with_len(b2, new_len);
}

fn ecs_ba_drop_all(b: EcsBaDeep) -> EcsBaDeep {
    return ecs_ba_clear(b);
}

// get_sub_slice as fixed list of first n values (n<=4 for tests)
struct EcsBaSlice {
    v0: i64, v1: i64, v2: i64, v3: i64, len: i32,
}

fn ecs_ba_get_sub_slice(b: EcsBaDeep, slice_len: i32) -> EcsBaSlice {
    let n = slice_len;
    if n > b.len { n = b.len; };
    if n > 4 { n = 4; };
    if n < 0 { n = 0; };
    let v0 = 0; let v1 = 0; let v2 = 0; let v3 = 0;
    if n >= 1 { v0 = b.d0; };
    if n >= 2 { v1 = b.d1; };
    if n >= 3 { v2 = b.d2; };
    if n >= 4 { v3 = b.d3; };
    return EcsBaSlice { v0: v0, v1: v1, v2: v2, v3: v3, len: n };
}

fn ecs_ba_slice_len(s: EcsBaSlice) -> i32 { return s.len; }
fn ecs_ba_slice_at(s: EcsBaSlice, i: i32) -> i64 {
    if i == 0 { return s.v0; };
    if i == 1 { return s.v1; };
    if i == 2 { return s.v2; };
    if i == 3 { return s.v3; };
    return 0;
}

fn ecs_ba_count_matching(b: EcsBaDeep, value: i64) -> i32 {
    let count = 0;
    if b.len >= 1 { if b.d0 == value { count = count + 1; }; };
    if b.len >= 2 { if b.d1 == value { count = count + 1; }; };
    if b.len >= 3 { if b.d2 == value { count = count + 1; }; };
    if b.len >= 4 { if b.d3 == value { count = count + 1; }; };
    if b.len >= 5 { if b.d4 == value { count = count + 1; }; };
    if b.len >= 6 { if b.d5 == value { count = count + 1; }; };
    if b.len >= 7 { if b.d6 == value { count = count + 1; }; };
    if b.len >= 8 { if b.d7 == value { count = count + 1; }; };
    return count;
}
