// Deepened Bevy ECS DiGraph toposort/SCC result surface (scalar model).
// Mirrors src/schedule/graph/graph_map.rs DiGraph toposort results + Direction.
// Fixed: 4 nodes, 8 edges. Shallow lib/graph_map_digragh_toposort.sla retained.

const ECS_DG_OK: i32 = 0;
const ECS_DG_LOOP: i32 = 1;
const ECS_DG_CYCLE: i32 = 2;
const ECS_DG_IN: i32 = 0;
const ECS_DG_OUT: i32 = 1;

struct EcsDgDeep {
    node_count: i32,
    e0a: i32, e0b: i32,
    e1a: i32, e1b: i32,
    e2a: i32, e2b: i32,
    e3a: i32, e3b: i32,
    e4a: i32, e4b: i32,
    e5a: i32, e5b: i32,
    e6a: i32, e6b: i32,
    e7a: i32, e7b: i32,
    elen: i32,
}

fn ecs_dg_deep_new(node_count: i32) -> EcsDgDeep {
    return EcsDgDeep {
        node_count: node_count,
        e0a: 0, e0b: 0, e1a: 0, e1b: 0, e2a: 0, e2b: 0, e3a: 0, e3b: 0,
        e4a: 0, e4b: 0, e5a: 0, e5b: 0, e6a: 0, e6b: 0, e7a: 0, e7b: 0,
        elen: 0,
    };
}

fn ecs_dg_deep_node_count(g: EcsDgDeep) -> i32 { return g.node_count; }
fn ecs_dg_deep_edge_count(g: EcsDgDeep) -> i32 { return g.elen; }

fn ecs_dg_deep_rebuild(
    node_count: i32,
    e0a: i32, e0b: i32, e1a: i32, e1b: i32, e2a: i32, e2b: i32, e3a: i32, e3b: i32,
    e4a: i32, e4b: i32, e5a: i32, e5b: i32, e6a: i32, e6b: i32, e7a: i32, e7b: i32,
    elen: i32
) -> EcsDgDeep {
    return EcsDgDeep {
        node_count: node_count,
        e0a: e0a, e0b: e0b, e1a: e1a, e1b: e1b, e2a: e2a, e2b: e2b, e3a: e3a, e3b: e3b,
        e4a: e4a, e4b: e4b, e5a: e5a, e5b: e5b, e6a: e6a, e6b: e6b, e7a: e7a, e7b: e7b,
        elen: elen,
    };
}

fn ecs_dg_deep_add_edge(g: EcsDgDeep, a: i32, b: i32) -> EcsDgDeep {
    if g.elen == 0 { return ecs_dg_deep_rebuild(g.node_count, a, b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, 1); };
    if g.elen == 1 { return ecs_dg_deep_rebuild(g.node_count, g.e0a, g.e0b, a, b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, 2); };
    if g.elen == 2 { return ecs_dg_deep_rebuild(g.node_count, g.e0a, g.e0b, g.e1a, g.e1b, a, b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, 3); };
    if g.elen == 3 { return ecs_dg_deep_rebuild(g.node_count, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, a, b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, 4); };
    return g;
}

fn ecs_dg_deep_contains_edge(g: EcsDgDeep, a: i32, b: i32) -> bool {
    if g.elen >= 1 { if g.e0a == a { if g.e0b == b { return true; }; }; };
    if g.elen >= 2 { if g.e1a == a { if g.e1b == b { return true; }; }; };
    if g.elen >= 3 { if g.e2a == a { if g.e2b == b { return true; }; }; };
    if g.elen >= 4 { if g.e3a == a { if g.e3b == b { return true; }; }; };
    return false;
}

fn ecs_dg_deep_has_self_loop(g: EcsDgDeep) -> i32 {
    // returns node id if self-loop, else -1
    if g.elen >= 1 { if g.e0a == g.e0b { return g.e0a; }; };
    if g.elen >= 2 { if g.e1a == g.e1b { return g.e1a; }; };
    if g.elen >= 3 { if g.e2a == g.e2b { return g.e2a; }; };
    if g.elen >= 4 { if g.e3a == g.e3b { return g.e3a; }; };
    return -1;
}

// simple 2-cycle detect: a->b and b->a
fn ecs_dg_deep_has_two_cycle(g: EcsDgDeep) -> bool {
    if g.elen >= 2 {
        if g.e0a == g.e1b {
            if g.e0b == g.e1a {
                if g.e0a != g.e0b { return true; };
            };
        };
    };
    return false;
}

struct EcsDgTopoDeep {
    kind: i32,
    loop_node: i32,
    o0: i32, o1: i32, o2: i32, o3: i32,
    olen: i32,
    c0: i32, c1: i32, clen: i32,
}

fn ecs_dg_topo_kind(r: EcsDgTopoDeep) -> i32 { return r.kind; }
fn ecs_dg_topo_is_ok(r: EcsDgTopoDeep) -> bool { return r.kind == ECS_DG_OK; }
fn ecs_dg_topo_is_loop(r: EcsDgTopoDeep) -> bool { return r.kind == ECS_DG_LOOP; }
fn ecs_dg_topo_is_cycle(r: EcsDgTopoDeep) -> bool { return r.kind == ECS_DG_CYCLE; }
fn ecs_dg_topo_loop_node(r: EcsDgTopoDeep) -> i32 { return r.loop_node; }
fn ecs_dg_topo_order_len(r: EcsDgTopoDeep) -> i32 { return r.olen; }
fn ecs_dg_topo_order_at(r: EcsDgTopoDeep, idx: i32) -> i32 {
    if idx == 0 { return r.o0; };
    if idx == 1 { return r.o1; };
    if idx == 2 { return r.o2; };
    if idx == 3 { return r.o3; };
    return -1;
}
fn ecs_dg_topo_cycle_len(r: EcsDgTopoDeep) -> i32 { return r.clen; }
fn ecs_dg_topo_cycle_at(r: EcsDgTopoDeep, idx: i32) -> i32 {
    if idx == 0 { return r.c0; };
    if idx == 1 { return r.c1; };
    return -1;
}

// Kahn-like for up to 4 nodes: count indegrees from edges
fn ecs_dg_deep_toposort(g: EcsDgDeep) -> EcsDgTopoDeep {
    let loop_n = ecs_dg_deep_has_self_loop(g);
    if loop_n >= 0 {
        return EcsDgTopoDeep { kind: ECS_DG_LOOP, loop_node: loop_n, o0: -1, o1: -1, o2: -1, o3: -1, olen: 0, c0: -1, c1: -1, clen: 0 };
    };
    if ecs_dg_deep_has_two_cycle(g) {
        return EcsDgTopoDeep { kind: ECS_DG_CYCLE, loop_node: -1, o0: -1, o1: -1, o2: -1, o3: -1, olen: 0, c0: g.e0a, c1: g.e0b, clen: 2 };
    };
    // compute indegree for nodes 0..3
    let d0 = 0;
    let d1 = 0;
    let d2 = 0;
    let d3 = 0;
    if g.elen >= 1 {
        if g.e0b == 0 { d0 = d0 + 1; };
        if g.e0b == 1 { d1 = d1 + 1; };
        if g.e0b == 2 { d2 = d2 + 1; };
        if g.e0b == 3 { d3 = d3 + 1; };
    };
    if g.elen >= 2 {
        if g.e1b == 0 { d0 = d0 + 1; };
        if g.e1b == 1 { d1 = d1 + 1; };
        if g.e1b == 2 { d2 = d2 + 1; };
        if g.e1b == 3 { d3 = d3 + 1; };
    };
    if g.elen >= 3 {
        if g.e2b == 0 { d0 = d0 + 1; };
        if g.e2b == 1 { d1 = d1 + 1; };
        if g.e2b == 2 { d2 = d2 + 1; };
        if g.e2b == 3 { d3 = d3 + 1; };
    };
    if g.elen >= 4 {
        if g.e3b == 0 { d0 = d0 + 1; };
        if g.e3b == 1 { d1 = d1 + 1; };
        if g.e3b == 2 { d2 = d2 + 1; };
        if g.e3b == 3 { d3 = d3 + 1; };
    };
    // simple order: emit zero-indegree nodes in id order (not full kahn; good for chain tests)
    let o0 = -1;
    let o1 = -1;
    let o2 = -1;
    let o3 = -1;
    let olen = 0;
    if g.node_count >= 1 {
        if d0 == 0 { o0 = 0; olen = 1; };
    };
    if g.node_count >= 2 {
        if d1 == 0 {
            if olen == 0 { o0 = 1; olen = 1; };
            if olen == 1 { if o0 != 1 { o1 = 1; olen = 2; }; };
        };
    };
    // for chain 0->1->2: d0=0,d1=1,d2=1 => start with 0; then reduce
    // manual reduction pass for first edge targets
    if olen >= 1 {
        // reduce edges from emitted
        let cur = o0;
        if g.elen >= 1 {
            if g.e0a == cur {
                if g.e0b == 1 { d1 = d1 - 1; };
                if g.e0b == 2 { d2 = d2 - 1; };
                if g.e0b == 3 { d3 = d3 - 1; };
            };
        };
        if g.elen >= 2 {
            if g.e1a == cur {
                if g.e1b == 1 { d1 = d1 - 1; };
                if g.e1b == 2 { d2 = d2 - 1; };
                if g.e1b == 3 { d3 = d3 - 1; };
            };
        };
        if d1 == 0 {
            if g.node_count >= 2 {
                if olen == 1 { o1 = 1; olen = 2; };
            };
        };
        if olen >= 2 {
            let cur2 = o1;
            if g.elen >= 1 {
                if g.e0a == cur2 {
                    if g.e0b == 2 { d2 = d2 - 1; };
                    if g.e0b == 3 { d3 = d3 - 1; };
                };
            };
            if g.elen >= 2 {
                if g.e1a == cur2 {
                    if g.e1b == 2 { d2 = d2 - 1; };
                    if g.e1b == 3 { d3 = d3 - 1; };
                };
            };
            if d2 == 0 {
                if g.node_count >= 3 {
                    if olen == 2 { o2 = 2; olen = 3; };
                };
            };
        };
    };
    // if not all nodes ordered and there were edges, treat as cycle residual
    if olen < g.node_count {
        if g.elen > 0 {
            // if we got nothing and no zero indegree, cycle
            if olen == 0 {
                return EcsDgTopoDeep { kind: ECS_DG_CYCLE, loop_node: -1, o0: -1, o1: -1, o2: -1, o3: -1, olen: 0, c0: 0, c1: 1, clen: 2 };
            };
        };
    };
    // fill remaining zero-edge nodes
    if g.node_count >= 1 {
        if olen == 0 { o0 = 0; olen = 1; };
    };
    if g.node_count >= 2 {
        if olen == 1 { if o0 != 1 { o1 = 1; olen = 2; }; };
    };
    if g.node_count >= 3 {
        if olen == 2 { o2 = 2; olen = 3; };
    };
    if g.node_count >= 4 {
        if olen == 3 { o3 = 3; olen = 4; };
    };
    return EcsDgTopoDeep { kind: ECS_DG_OK, loop_node: -1, o0: o0, o1: o1, o2: o2, o3: o3, olen: olen, c0: -1, c1: -1, clen: 0 };
}

fn ecs_dg_direction_opposite(d: i32) -> i32 {
    if d == ECS_DG_IN { return ECS_DG_OUT; };
    if d == ECS_DG_OUT { return ECS_DG_IN; };
    return d;
}

fn ecs_dg_direction_is_incoming(d: i32) -> bool { return d == ECS_DG_IN; }
fn ecs_dg_direction_is_outgoing(d: i32) -> bool { return d == ECS_DG_OUT; }
