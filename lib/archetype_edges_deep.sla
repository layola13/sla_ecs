// Deepened Bevy ECS archetype Edges — archetype transitions for bundle insert/remove/take.
// Fixed capacity-4 edge maps per operation kind. Shallow lib/archetype_edges.sla retained.

struct EcsArchIdDeep { id: i32 }
fn ecs_aid_new(id: i32) -> EcsArchIdDeep { return EcsArchIdDeep { id: id }; }
fn ecs_aid_value(a: EcsArchIdDeep) -> i32 { return a.id; }
fn ecs_aid_eq(a: EcsArchIdDeep, b: EcsArchIdDeep) -> bool { return a.id == b.id; }

struct EcsArchRowDeep { row: i32 }
fn ecs_arow_new(row: i32) -> EcsArchRowDeep { return EcsArchRowDeep { row: row }; }
fn ecs_arow_value(r: EcsArchRowDeep) -> i32 { return r.row; }

const ECS_CS_NOT_PRESENT: i32 = 0;
const ECS_CS_ADDED: i32 = 1;
const ECS_CS_EXISTED: i32 = 2;

// ArchetypeAfterBundleInsert: fixed added/existed components capacity-4
struct EcsAabiDeep {
    archetype_id: i32,
    added0: i32, added1: i32, added2: i32, added3: i32,
    added_len: i32,
    existed_len: i32,
    total_len: i32,
}

fn ecs_aabi_rebuild(
    archetype_id: i32,
    a0: i32, a1: i32, a2: i32, a3: i32,
    added_len: i32, existed_len: i32, total_len: i32
) -> EcsAabiDeep {
    return EcsAabiDeep {
        archetype_id: archetype_id, added0: a0, added1: a1, added2: a2, added3: a3,
        added_len: added_len, existed_len: existed_len, total_len: total_len,
    };
}

fn ecs_aabi_new(archetype_id: i32) -> EcsAabiDeep {
    return ecs_aabi_rebuild(archetype_id, 0, 0, 0, 0, 0, 0, 0);
}

fn ecs_aabi_push_added(a: EcsAabiDeep, cid: i32) -> EcsAabiDeep {
    let ln = a.added_len;
    if ln >= 4 { return a; };
    let a0 = a.added0; let a1 = a.added1; let a2 = a.added2; let a3 = a.added3;
    if ln == 0 { a0 = cid; };
    if ln == 1 { a1 = cid; };
    if ln == 2 { a2 = cid; };
    if ln == 3 { a3 = cid; };
    return ecs_aabi_rebuild(a.archetype_id, a0, a1, a2, a3, ln + 1, a.existed_len, a.total_len + 1);
}

fn ecs_aabi_push_existed(a: EcsAabiDeep, cid: i32) -> EcsAabiDeep {
    let ln = a.existed_len;
    // existed components are not stored in slots; just bump counts for deep tests.
    return ecs_aabi_rebuild(a.archetype_id, a.added0, a.added1, a.added2, a.added3, a.added_len, ln + 1, a.total_len + 1);
}

fn ecs_aabi_archetype_id(a: EcsAabiDeep) -> i32 { return a.archetype_id; }
fn ecs_aabi_added_len(a: EcsAabiDeep) -> i32 { return a.added_len; }
fn ecs_aabi_existed_len(a: EcsAabiDeep) -> i32 { return a.existed_len; }
fn ecs_aabi_total_len(a: EcsAabiDeep) -> i32 { return a.total_len; }
fn ecs_aabi_added_at(a: EcsAabiDeep, idx: i32) -> i32 {
    if idx == 0 { return a.added0; };
    if idx == 1 { return a.added1; };
    if idx == 2 { return a.added2; };
    if idx == 3 { return a.added3; };
    return -1;
}

// Edges: insert/remove/take maps, each capacity-4 entries
struct EcsArchEdgesDeep {
    ins_b0: i32, ins_t0: i32,
    ins_b1: i32, ins_t1: i32,
    ins_b2: i32, ins_t2: i32,
    ins_b3: i32, ins_t3: i32,
    ins_len: i32,
    rem_b0: i32, rem_t0: i32,
    rem_b1: i32, rem_t1: i32,
    rem_b2: i32, rem_t2: i32,
    rem_b3: i32, rem_t3: i32,
    rem_len: i32,
    take_b0: i32, take_t0: i32,
    take_b1: i32, take_t1: i32,
    take_b2: i32, take_t2: i32,
    take_b3: i32, take_t3: i32,
    take_len: i32,
}

fn ecs_aenew() -> EcsArchEdgesDeep {
    return EcsArchEdgesDeep {
        ins_b0: 0, ins_t0: 0, ins_b1: 0, ins_t1: 0, ins_b2: 0, ins_t2: 0, ins_b3: 0, ins_t3: 0, ins_len: 0,
        rem_b0: 0, rem_t0: 0, rem_b1: 0, rem_t1: 0, rem_b2: 0, rem_t2: 0, rem_b3: 0, rem_t3: 0, rem_len: 0,
        take_b0: 0, take_t0: 0, take_b1: 0, take_t1: 0, take_b2: 0, take_t2: 0, take_b3: 0, take_t3: 0, take_len: 0,
    };
}

fn ecs_ae_rebuild_ins(
    e: EcsArchEdgesDeep,
    b0: i32, t0: i32, b1: i32, t1: i32, b2: i32, t2: i32, b3: i32, t3: i32, len: i32
) -> EcsArchEdgesDeep {
    e.ins_b0 = b0; e.ins_t0 = t0; e.ins_b1 = b1; e.ins_t1 = t1;
    e.ins_b2 = b2; e.ins_t2 = t2; e.ins_b3 = b3; e.ins_t3 = t3;
    e.ins_len = len;
    return e;
}

fn ecs_ae_rebuild_rem(
    e: EcsArchEdgesDeep,
    b0: i32, t0: i32, b1: i32, t1: i32, b2: i32, t2: i32, b3: i32, t3: i32, len: i32
) -> EcsArchEdgesDeep {
    e.rem_b0 = b0; e.rem_t0 = t0; e.rem_b1 = b1; e.rem_t1 = t1;
    e.rem_b2 = b2; e.rem_t2 = t2; e.rem_b3 = b3; e.rem_t3 = t3;
    e.rem_len = len;
    return e;
}

fn ecs_ae_rebuild_take(
    e: EcsArchEdgesDeep,
    b0: i32, t0: i32, b1: i32, t1: i32, b2: i32, t2: i32, b3: i32, t3: i32, len: i32
) -> EcsArchEdgesDeep {
    e.take_b0 = b0; e.take_t0 = t0; e.take_b1 = b1; e.take_t1 = t1;
    e.take_b2 = b2; e.take_t2 = t2; e.take_b3 = b3; e.take_t3 = t3;
    e.take_len = len;
    return e;
}

struct EcsAeInsResDeep { found: bool, target: i32 }
fn ecs_ae_ins_found(r: EcsAeInsResDeep) -> bool { return r.found; }
fn ecs_ae_ins_target(r: EcsAeInsResDeep) -> i32 { return r.target; }

fn ecs_ae_get_insert(e: EcsArchEdgesDeep, bundle_id: i32) -> EcsAeInsResDeep {
    if e.ins_len >= 1 { if e.ins_b0 == bundle_id { return EcsAeInsResDeep { found: true, target: e.ins_t0 }; }; };
    if e.ins_len >= 2 { if e.ins_b1 == bundle_id { return EcsAeInsResDeep { found: true, target: e.ins_t1 }; }; };
    if e.ins_len >= 3 { if e.ins_b2 == bundle_id { return EcsAeInsResDeep { found: true, target: e.ins_t2 }; }; };
    if e.ins_len >= 4 { if e.ins_b3 == bundle_id { return EcsAeInsResDeep { found: true, target: e.ins_t3 }; }; };
    return EcsAeInsResDeep { found: false, target: 0 };
}

fn ecs_ae_cache_insert(e: EcsArchEdgesDeep, bundle_id: i32, archetype_id: i32) -> EcsArchEdgesDeep {
    let g = ecs_ae_get_insert(e, bundle_id);
    if g.found { return e; };
    let ln = e.ins_len;
    if ln >= 4 { return e; };
    if ln == 0 {
        return ecs_ae_rebuild_ins(e, bundle_id, archetype_id, 0, 0, 0, 0, 0, 0, 1);
    };
    if ln == 1 {
        return ecs_ae_rebuild_ins(e, e.ins_b0, e.ins_t0, bundle_id, archetype_id, 0, 0, 0, 0, 2);
    };
    if ln == 2 {
        return ecs_ae_rebuild_ins(e, e.ins_b0, e.ins_t0, e.ins_b1, e.ins_t1, bundle_id, archetype_id, 0, 0, 3);
    };
    if ln == 3 {
        return ecs_ae_rebuild_ins(e, e.ins_b0, e.ins_t0, e.ins_b1, e.ins_t1, e.ins_b2, e.ins_t2, bundle_id, archetype_id, 4);
    };
    return e;
}

// remove: target -1 means "cannot remove"
struct EcsAeRemResDeep { found: bool, has_result: bool, target: i32 }
fn ecs_ae_rem_found(r: EcsAeRemResDeep) -> bool { return r.found; }
fn ecs_ae_rem_has(r: EcsAeRemResDeep) -> bool { return r.has_result; }
fn ecs_ae_rem_target(r: EcsAeRemResDeep) -> i32 { return r.target; }

fn ecs_ae_get_remove(e: EcsArchEdgesDeep, bundle_id: i32) -> EcsAeRemResDeep {
    if e.rem_len >= 1 {
        if e.rem_b0 == bundle_id {
            if e.rem_t0 < 0 { return EcsAeRemResDeep { found: true, has_result: false, target: 0 }; };
            return EcsAeRemResDeep { found: true, has_result: true, target: e.rem_t0 };
        };
    };
    if e.rem_len >= 2 {
        if e.rem_b1 == bundle_id {
            if e.rem_t1 < 0 { return EcsAeRemResDeep { found: true, has_result: false, target: 0 }; };
            return EcsAeRemResDeep { found: true, has_result: true, target: e.rem_t1 };
        };
    };
    if e.rem_len >= 3 {
        if e.rem_b2 == bundle_id {
            if e.rem_t2 < 0 { return EcsAeRemResDeep { found: true, has_result: false, target: 0 }; };
            return EcsAeRemResDeep { found: true, has_result: true, target: e.rem_t2 };
        };
    };
    if e.rem_len >= 4 {
        if e.rem_b3 == bundle_id {
            if e.rem_t3 < 0 { return EcsAeRemResDeep { found: true, has_result: false, target: 0 }; };
            return EcsAeRemResDeep { found: true, has_result: true, target: e.rem_t3 };
        };
    };
    return EcsAeRemResDeep { found: false, has_result: false, target: 0 };
}

fn ecs_ae_cache_remove(e: EcsArchEdgesDeep, bundle_id: i32, archetype_id: i32) -> EcsArchEdgesDeep {
    let ln = e.rem_len;
    if ln >= 4 { return e; };
    if ln == 0 { return ecs_ae_rebuild_rem(e, bundle_id, archetype_id, 0, 0, 0, 0, 0, 0, 1); };
    if ln == 1 { return ecs_ae_rebuild_rem(e, e.rem_b0, e.rem_t0, bundle_id, archetype_id, 0, 0, 0, 0, 2); };
    if ln == 2 { return ecs_ae_rebuild_rem(e, e.rem_b0, e.rem_t0, e.rem_b1, e.rem_t1, bundle_id, archetype_id, 0, 0, 3); };
    if ln == 3 { return ecs_ae_rebuild_rem(e, e.rem_b0, e.rem_t0, e.rem_b1, e.rem_t1, e.rem_b2, e.rem_t2, bundle_id, archetype_id, 4); };
    return e;
}

fn ecs_ae_cache_remove_none(e: EcsArchEdgesDeep, bundle_id: i32) -> EcsArchEdgesDeep {
    return ecs_ae_cache_remove(e, bundle_id, -1);
}

// take (mirror)
struct EcsAeTakeResDeep { found: bool, has_result: bool, target: i32 }
fn ecs_ae_take_found(r: EcsAeTakeResDeep) -> bool { return r.found; }
fn ecs_ae_take_has(r: EcsAeTakeResDeep) -> bool { return r.has_result; }
fn ecs_ae_take_target(r: EcsAeTakeResDeep) -> i32 { return r.target; }

fn ecs_ae_get_take(e: EcsArchEdgesDeep, bundle_id: i32) -> EcsAeTakeResDeep {
    if e.take_len >= 1 { if e.take_b0 == bundle_id { if e.take_t0 < 0 { return EcsAeTakeResDeep { found: true, has_result: false, target: 0 }; }; return EcsAeTakeResDeep { found: true, has_result: true, target: e.take_t0 }; }; };
    if e.take_len >= 2 { if e.take_b1 == bundle_id { if e.take_t1 < 0 { return EcsAeTakeResDeep { found: true, has_result: false, target: 0 }; }; return EcsAeTakeResDeep { found: true, has_result: true, target: e.take_t1 }; }; };
    if e.take_len >= 3 { if e.take_b2 == bundle_id { if e.take_t2 < 0 { return EcsAeTakeResDeep { found: true, has_result: false, target: 0 }; }; return EcsAeTakeResDeep { found: true, has_result: true, target: e.take_t2 }; }; };
    if e.take_len >= 4 { if e.take_b3 == bundle_id { if e.take_t3 < 0 { return EcsAeTakeResDeep { found: true, has_result: false, target: 0 }; }; return EcsAeTakeResDeep { found: true, has_result: true, target: e.take_t3 }; }; };
    return EcsAeTakeResDeep { found: false, has_result: false, target: 0 };
}

fn ecs_ae_cache_take(e: EcsArchEdgesDeep, bundle_id: i32, archetype_id: i32) -> EcsArchEdgesDeep {
    let ln = e.take_len;
    if ln >= 4 { return e; };
    if ln == 0 { return ecs_ae_rebuild_take(e, bundle_id, archetype_id, 0, 0, 0, 0, 0, 0, 1); };
    if ln == 1 { return ecs_ae_rebuild_take(e, e.take_b0, e.take_t0, bundle_id, archetype_id, 0, 0, 0, 0, 2); };
    if ln == 2 { return ecs_ae_rebuild_take(e, e.take_b0, e.take_t0, e.take_b1, e.take_t1, bundle_id, archetype_id, 0, 0, 3); };
    if ln == 3 { return ecs_ae_rebuild_take(e, e.take_b0, e.take_t0, e.take_b1, e.take_t1, e.take_b2, e.take_t2, bundle_id, archetype_id, 4); };
    return e;
}

fn ecs_ae_cache_take_none(e: EcsArchEdgesDeep, bundle_id: i32) -> EcsArchEdgesDeep {
    return ecs_ae_cache_take(e, bundle_id, -1);
}

fn ecs_ae_insert_count(e: EcsArchEdgesDeep) -> i32 { return e.ins_len; }
fn ecs_ae_remove_count(e: EcsArchEdgesDeep) -> i32 { return e.rem_len; }
fn ecs_ae_take_count(e: EcsArchEdgesDeep) -> i32 { return e.take_len; }

struct EcsArchEntityDeep { entity: i64, table_row: i32 }
fn ecs_ae_entity_new(entity: i64, table_row: i32) -> EcsArchEntityDeep { return EcsArchEntityDeep { entity: entity, table_row: table_row }; }
fn ecs_ae_entity_id(e: EcsArchEntityDeep) -> i64 { return e.entity; }
fn ecs_ae_entity_table_row(e: EcsArchEntityDeep) -> i32 { return e.table_row; }
