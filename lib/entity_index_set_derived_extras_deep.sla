// Deepened Bevy ECS EntityIndexSet derived/wrapper surface extras.
// Constructor kinds + insert/contains/eq/union/intersection/iter capacity-8.
// Shallow lib/entity_index_set_derived_extras.sla retained.

struct EcsEisdDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    capacity_hint: i32,
    constructed_kind: i32,
}

fn ecs_eisd_new() -> EcsEisdDeep {
    return EcsEisdDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: 0, constructed_kind: 1,
    };
}
fn ecs_eisd_default() -> EcsEisdDeep {
    return EcsEisdDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: 0, constructed_kind: 2,
    };
}
fn ecs_eisd_with_capacity(capacity: i32) -> EcsEisdDeep {
    let c = capacity;
    if c < 0 { c = 0; };
    return EcsEisdDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: c, constructed_kind: 3,
    };
}

fn ecs_eisd_len(s: EcsEisdDeep) -> i32 { return s.len; }
fn ecs_eisd_kind(s: EcsEisdDeep) -> i32 { return s.constructed_kind; }
fn ecs_eisd_capacity(s: EcsEisdDeep) -> i32 { return s.capacity_hint; }
fn ecs_eisd_is_empty(s: EcsEisdDeep) -> bool { return s.len == 0; }

fn ecs_eisd_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, capacity_hint: i32, constructed_kind: i32
) -> EcsEisdDeep {
    return EcsEisdDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
        len: len, capacity_hint: capacity_hint, constructed_kind: constructed_kind,
    };
}

fn ecs_eisd_clone(s: EcsEisdDeep) -> EcsEisdDeep {
    return ecs_eisd_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, s.e7, s.len, s.capacity_hint, 4);
}
fn ecs_eisd_from_index_set(s: EcsEisdDeep) -> EcsEisdDeep {
    return ecs_eisd_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, s.e7, s.len, s.capacity_hint, 6);
}

fn ecs_eisd_contains(s: EcsEisdDeep, value: i64) -> bool {
    if s.len >= 1 { if s.e0 == value { return true; }; };
    if s.len >= 2 { if s.e1 == value { return true; }; };
    if s.len >= 3 { if s.e2 == value { return true; }; };
    if s.len >= 4 { if s.e3 == value { return true; }; };
    if s.len >= 5 { if s.e4 == value { return true; }; };
    if s.len >= 6 { if s.e5 == value { return true; }; };
    if s.len >= 7 { if s.e6 == value { return true; }; };
    if s.len >= 8 { if s.e7 == value { return true; }; };
    return false;
}

struct EcsEisdInsDeep { inserted: bool, set: EcsEisdDeep }
fn ecs_eisd_ins_inserted(r: EcsEisdInsDeep) -> bool { return r.inserted; }
fn ecs_eisd_ins_set(r: EcsEisdInsDeep) -> EcsEisdDeep { return r.set; }

fn ecs_eisd_insert(s: EcsEisdDeep, value: i64) -> EcsEisdInsDeep {
    if ecs_eisd_contains(s, value) {
        return EcsEisdInsDeep { inserted: false, set: s };
    };
    let e0 = s.e0; let e1 = s.e1; let e2 = s.e2; let e3 = s.e3;
    let e4 = s.e4; let e5 = s.e5; let e6 = s.e6; let e7 = s.e7;
    let ln = s.len; let cap = s.capacity_hint; let kind = s.constructed_kind;
    if ln >= 8 { return EcsEisdInsDeep { inserted: false, set: s }; };
    if ln == 0 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(value, 0, 0, 0, 0, 0, 0, 0, 1, cap, kind) }; };
    if ln == 1 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, value, 0, 0, 0, 0, 0, 0, 2, cap, kind) }; };
    if ln == 2 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, e1, value, 0, 0, 0, 0, 0, 3, cap, kind) }; };
    if ln == 3 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, e1, e2, value, 0, 0, 0, 0, 4, cap, kind) }; };
    if ln == 4 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, e1, e2, e3, value, 0, 0, 0, 5, cap, kind) }; };
    if ln == 5 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, e1, e2, e3, e4, value, 0, 0, 6, cap, kind) }; };
    if ln == 6 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, e1, e2, e3, e4, e5, value, 0, 7, cap, kind) }; };
    if ln == 7 { return EcsEisdInsDeep { inserted: true, set: ecs_eisd_rebuild(e0, e1, e2, e3, e4, e5, e6, value, 8, cap, kind) }; };
    return EcsEisdInsDeep { inserted: false, set: s };
}

fn ecs_eisd_at(s: EcsEisdDeep, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return -1;
}

fn ecs_eisd_eq(a: EcsEisdDeep, b: EcsEisdDeep) -> bool {
    if a.len != b.len { return false; };
    if a.len >= 1 { if ecs_eisd_contains(b, a.e0) != true { return false; }; };
    if a.len >= 2 { if ecs_eisd_contains(b, a.e1) != true { return false; }; };
    if a.len >= 3 { if ecs_eisd_contains(b, a.e2) != true { return false; }; };
    if a.len >= 4 { if ecs_eisd_contains(b, a.e3) != true { return false; }; };
    if a.len >= 5 { if ecs_eisd_contains(b, a.e4) != true { return false; }; };
    if a.len >= 6 { if ecs_eisd_contains(b, a.e5) != true { return false; }; };
    if a.len >= 7 { if ecs_eisd_contains(b, a.e6) != true { return false; }; };
    if a.len >= 8 { if ecs_eisd_contains(b, a.e7) != true { return false; }; };
    return true;
}

fn ecs_eisd_union(a: EcsEisdDeep, b: EcsEisdDeep) -> EcsEisdDeep {
    let out = a;
    if b.len >= 1 { out = ecs_eisd_ins_set(ecs_eisd_insert(out, b.e0)); };
    if b.len >= 2 { out = ecs_eisd_ins_set(ecs_eisd_insert(out, b.e1)); };
    if b.len >= 3 { out = ecs_eisd_ins_set(ecs_eisd_insert(out, b.e2)); };
    if b.len >= 4 { out = ecs_eisd_ins_set(ecs_eisd_insert(out, b.e3)); };
    return out;
}

fn ecs_eisd_intersection(a: EcsEisdDeep, b: EcsEisdDeep) -> EcsEisdDeep {
    let out = ecs_eisd_new();
    if a.len >= 1 { if ecs_eisd_contains(b, a.e0) { out = ecs_eisd_ins_set(ecs_eisd_insert(out, a.e0)); }; };
    if a.len >= 2 { if ecs_eisd_contains(b, a.e1) { out = ecs_eisd_ins_set(ecs_eisd_insert(out, a.e1)); }; };
    if a.len >= 3 { if ecs_eisd_contains(b, a.e2) { out = ecs_eisd_ins_set(ecs_eisd_insert(out, a.e2)); }; };
    if a.len >= 4 { if ecs_eisd_contains(b, a.e3) { out = ecs_eisd_ins_set(ecs_eisd_insert(out, a.e3)); }; };
    return out;
}

struct EcsEisdIterDeep {
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, cursor: i32, debug_kind: i32,
}

fn ecs_eisd_iter(s: EcsEisdDeep) -> EcsEisdIterDeep {
    return EcsEisdIterDeep {
        e0: s.e0, e1: s.e1, e2: s.e2, e3: s.e3, e4: s.e4, e5: s.e5, e6: s.e6, e7: s.e7,
        len: s.len, cursor: 0, debug_kind: 10,
    };
}
fn ecs_eisd_iter_remaining(i: EcsEisdIterDeep) -> i32 { return i.len - i.cursor; }
fn ecs_eisd_iter_debug(i: EcsEisdIterDeep) -> i32 { return i.debug_kind; }

struct EcsEisdNextDeep { iter: EcsEisdIterDeep, has: bool, value: i64 }
fn ecs_eisd_next_has(n: EcsEisdNextDeep) -> bool { return n.has; }
fn ecs_eisd_next_value(n: EcsEisdNextDeep) -> i64 { return n.value; }
fn ecs_eisd_next_iter(n: EcsEisdNextDeep) -> EcsEisdIterDeep { return n.iter; }

fn ecs_eisd_iter_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, cursor: i32, debug_kind: i32
) -> EcsEisdIterDeep {
    return EcsEisdIterDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
        len: len, cursor: cursor, debug_kind: debug_kind,
    };
}

fn ecs_eisd_iter_next(i: EcsEisdIterDeep) -> EcsEisdNextDeep {
    if i.cursor >= i.len { return EcsEisdNextDeep { iter: i, has: false, value: -1 }; };
    let value: i64 = -1;
    if i.cursor == 0 { value = i.e0; };
    if i.cursor == 1 { value = i.e1; };
    if i.cursor == 2 { value = i.e2; };
    if i.cursor == 3 { value = i.e3; };
    if i.cursor == 4 { value = i.e4; };
    if i.cursor == 5 { value = i.e5; };
    if i.cursor == 6 { value = i.e6; };
    if i.cursor == 7 { value = i.e7; };
    let i2 = ecs_eisd_iter_rebuild(
        i.e0, i.e1, i.e2, i.e3, i.e4, i.e5, i.e6, i.e7,
        i.len, i.cursor + 1, i.debug_kind
    );
    return EcsEisdNextDeep { iter: i2, has: true, value: value };
}

fn ecs_eisd_iter_next_back(i: EcsEisdIterDeep) -> EcsEisdNextDeep {
    if i.cursor >= i.len { return EcsEisdNextDeep { iter: i, has: false, value: -1 }; };
    let back = i.len - 1;
    let value: i64 = -1;
    if back == 0 { value = i.e0; };
    if back == 1 { value = i.e1; };
    if back == 2 { value = i.e2; };
    if back == 3 { value = i.e3; };
    if back == 4 { value = i.e4; };
    if back == 5 { value = i.e5; };
    if back == 6 { value = i.e6; };
    if back == 7 { value = i.e7; };
    let i2 = ecs_eisd_iter_rebuild(
        i.e0, i.e1, i.e2, i.e3, i.e4, i.e5, i.e6, i.e7,
        back, i.cursor, i.debug_kind
    );
    return EcsEisdNextDeep { iter: i2, has: true, value: value };
}
