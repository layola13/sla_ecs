// Deepened Bevy ECS Traversal surface.
// Mirrors src/traversal.rs:
//   Traversal<D>: traverse(item, data) -> Option<Entity>
//   impl Traversal for () → always None
//   impl Traversal for &R: Relationship → Some(item.get())
//   Propagation walk with max depth + cycle detection (document infinite-loop responsibility)
// Shallow lib/traversal.sla retained.

// === Unit traversal () ===
struct EcsTravNoneDeep {}

fn ecs_trav_none_new() -> EcsTravNoneDeep { return EcsTravNoneDeep {}; }

fn ecs_trav_none_traverse(t: EcsTravNoneDeep, data_id: i64) -> (bool, i64) {
    return (false, 0);
}

// === Relationship traversal &R ===
struct EcsTravRelDeep {
    target: i64,
}

fn ecs_trav_rel_new(target: i64) -> EcsTravRelDeep {
    return EcsTravRelDeep { target: target };
}

fn ecs_trav_rel_get(t: EcsTravRelDeep) -> i64 { return t.target; }

fn ecs_trav_rel_traverse(t: EcsTravRelDeep, data_id: i64) -> (bool, i64) {
    // Relationship always yields Some(get()); data ignored
    return (true, t.target);
}

// Data-dependent traversal: if data_id == 0 stop; else yield target
struct EcsTravDataDeep {
    target: i64,
}

fn ecs_trav_data_new(target: i64) -> EcsTravDataDeep {
    return EcsTravDataDeep { target: target };
}

fn ecs_trav_data_traverse(t: EcsTravDataDeep, data_id: i64) -> (bool, i64) {
    if data_id == 0 {
        return (false, 0);
    };
    return (true, t.target);
}

// === Fixed graph walk (entities 0..7 edges; -1 = none) ===
struct EcsTravGraphDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
}

fn ecs_trav_graph_new() -> EcsTravGraphDeep {
    return EcsTravGraphDeep {
        e0: -1, e1: -1, e2: -1, e3: -1,
        e4: -1, e5: -1, e6: -1, e7: -1,
    };
}

fn ecs_trav_graph_set(g: EcsTravGraphDeep, from: i64, to: i64) -> EcsTravGraphDeep {
    let e0 = g.e0;
    let e1 = g.e1;
    let e2 = g.e2;
    let e3 = g.e3;
    let e4 = g.e4;
    let e5 = g.e5;
    let e6 = g.e6;
    let e7 = g.e7;
    if from == 0 {
        return EcsTravGraphDeep { e0: to, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 };
    };
    if from == 1 {
        return EcsTravGraphDeep { e0: e0, e1: to, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 };
    };
    if from == 2 {
        return EcsTravGraphDeep { e0: e0, e1: e1, e2: to, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 };
    };
    if from == 3 {
        return EcsTravGraphDeep { e0: e0, e1: e1, e2: e2, e3: to, e4: e4, e5: e5, e6: e6, e7: e7 };
    };
    if from == 4 {
        return EcsTravGraphDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: to, e5: e5, e6: e6, e7: e7 };
    };
    if from == 5 {
        return EcsTravGraphDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: to, e6: e6, e7: e7 };
    };
    if from == 6 {
        return EcsTravGraphDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: to, e7: e7 };
    };
    if from == 7 {
        return EcsTravGraphDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: to };
    };
    return EcsTravGraphDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 };
}

fn ecs_trav_graph_next(g: EcsTravGraphDeep, from: i64) -> i64 {
    let e0 = g.e0;
    let e1 = g.e1;
    let e2 = g.e2;
    let e3 = g.e3;
    let e4 = g.e4;
    let e5 = g.e5;
    let e6 = g.e6;
    let e7 = g.e7;
    if from == 0 { return e0; };
    if from == 1 { return e1; };
    if from == 2 { return e2; };
    if from == 3 { return e3; };
    if from == 4 { return e4; };
    if from == 5 { return e5; };
    if from == 6 { return e6; };
    if from == 7 { return e7; };
    return -1;
}

// Walk result: path slots + flags
struct EcsTravWalkDeep {
    n: i32,
    p0: i64, p1: i64, p2: i64, p3: i64,
    p4: i64, p5: i64, p6: i64, p7: i64,
    stopped_cycle: bool,
    stopped_depth: bool,
    stopped_end: bool,
}

fn ecs_trav_walk_n(w: EcsTravWalkDeep) -> i32 { return w.n; }
fn ecs_trav_walk_at(w: EcsTravWalkDeep, idx: i32) -> i64 {
    if idx == 0 { return w.p0; };
    if idx == 1 { return w.p1; };
    if idx == 2 { return w.p2; };
    if idx == 3 { return w.p3; };
    if idx == 4 { return w.p4; };
    if idx == 5 { return w.p5; };
    if idx == 6 { return w.p6; };
    if idx == 7 { return w.p7; };
    return -1;
}
fn ecs_trav_walk_cycle(w: EcsTravWalkDeep) -> bool { return w.stopped_cycle; }
fn ecs_trav_walk_depth(w: EcsTravWalkDeep) -> bool { return w.stopped_depth; }
fn ecs_trav_walk_end(w: EcsTravWalkDeep) -> bool { return w.stopped_end; }

fn ecs_trav_walk_push(w: EcsTravWalkDeep, entity: i64) -> EcsTravWalkDeep {
    let n = w.n;
    let p0 = w.p0; let p1 = w.p1; let p2 = w.p2; let p3 = w.p3;
    let p4 = w.p4; let p5 = w.p5; let p6 = w.p6; let p7 = w.p7;
    let sc = w.stopped_cycle; let sd = w.stopped_depth; let se = w.stopped_end;
    if n == 0 {
        return EcsTravWalkDeep { n: 1, p0: entity, p1: p1, p2: p2, p3: p3, p4: p4, p5: p5, p6: p6, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 1 {
        return EcsTravWalkDeep { n: 2, p0: p0, p1: entity, p2: p2, p3: p3, p4: p4, p5: p5, p6: p6, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 2 {
        return EcsTravWalkDeep { n: 3, p0: p0, p1: p1, p2: entity, p3: p3, p4: p4, p5: p5, p6: p6, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 3 {
        return EcsTravWalkDeep { n: 4, p0: p0, p1: p1, p2: p2, p3: entity, p4: p4, p5: p5, p6: p6, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 4 {
        return EcsTravWalkDeep { n: 5, p0: p0, p1: p1, p2: p2, p3: p3, p4: entity, p5: p5, p6: p6, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 5 {
        return EcsTravWalkDeep { n: 6, p0: p0, p1: p1, p2: p2, p3: p3, p4: p4, p5: entity, p6: p6, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 6 {
        return EcsTravWalkDeep { n: 7, p0: p0, p1: p1, p2: p2, p3: p3, p4: p4, p5: p5, p6: entity, p7: p7, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    if n == 7 {
        return EcsTravWalkDeep { n: 8, p0: p0, p1: p1, p2: p2, p3: p3, p4: p4, p5: p5, p6: p6, p7: entity, stopped_cycle: sc, stopped_depth: sd, stopped_end: se };
    };
    return w;
}

fn ecs_trav_walk_contains(w: EcsTravWalkDeep, entity: i64) -> bool {
    if w.n >= 1 && w.p0 == entity { return true; };
    if w.n >= 2 && w.p1 == entity { return true; };
    if w.n >= 3 && w.p2 == entity { return true; };
    if w.n >= 4 && w.p3 == entity { return true; };
    if w.n >= 5 && w.p4 == entity { return true; };
    if w.n >= 6 && w.p5 == entity { return true; };
    if w.n >= 7 && w.p6 == entity { return true; };
    if w.n >= 8 && w.p7 == entity { return true; };
    return false;
}

// Follow relationship edges from start (start not included in path), max_depth steps
fn ecs_trav_edge_at(e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64, from: i64) -> i64 {
    if from == 0 { return e0; };
    if from == 1 { return e1; };
    if from == 2 { return e2; };
    if from == 3 { return e3; };
    if from == 4 { return e4; };
    if from == 5 { return e5; };
    if from == 6 { return e6; };
    if from == 7 { return e7; };
    return -1;
}

fn ecs_trav_follow(g: EcsTravGraphDeep, start: i64, max_depth: i32) -> EcsTravWalkDeep {
    // Scalarize edges once (UseAfterMove)
    let e0 = g.e0;
    let e1 = g.e1;
    let e2 = g.e2;
    let e3 = g.e3;
    let e4 = g.e4;
    let e5 = g.e5;
    let e6 = g.e6;
    let e7 = g.e7;
    let w = EcsTravWalkDeep {
        n: 0,
        p0: -1, p1: -1, p2: -1, p3: -1,
        p4: -1, p5: -1, p6: -1, p7: -1,
        stopped_cycle: false,
        stopped_depth: false,
        stopped_end: false,
    };
    let v0 = start;
    let v1: i64 = -2;
    let v2: i64 = -2;
    let v3: i64 = -2;
    let v4: i64 = -2;
    let v5: i64 = -2;
    let v6: i64 = -2;
    let v7: i64 = -2;
    let current = start;
    let depth: i32 = 0;
    if depth < max_depth {
        let next = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next < 0 {
            w.stopped_end = true;
            return w;
        };
        if next == v0 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next);
        v1 = next;
        current = next;
        depth = 1;
    };
    if depth < max_depth {
        let next2 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next2 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next2 == v0 || next2 == v1 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next2);
        v2 = next2;
        current = next2;
        depth = 2;
    };
    if depth < max_depth {
        let next3 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next3 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next3 == v0 || next3 == v1 || next3 == v2 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next3);
        v3 = next3;
        current = next3;
        depth = 3;
    };
    if depth < max_depth {
        let next4 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next4 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next4 == v0 || next4 == v1 || next4 == v2 || next4 == v3 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next4);
        v4 = next4;
        current = next4;
        depth = 4;
    };
    if depth < max_depth {
        let next5 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next5 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next5 == v0 || next5 == v1 || next5 == v2 || next5 == v3 || next5 == v4 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next5);
        v5 = next5;
        current = next5;
        depth = 5;
    };
    if depth < max_depth {
        let next6 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next6 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next6 == v0 || next6 == v1 || next6 == v2 || next6 == v3 || next6 == v4 || next6 == v5 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next6);
        v6 = next6;
        current = next6;
        depth = 6;
    };
    if depth < max_depth {
        let next7 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next7 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next7 == v0 || next7 == v1 || next7 == v2 || next7 == v3 || next7 == v4 || next7 == v5 || next7 == v6 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next7);
        v7 = next7;
        current = next7;
        depth = 7;
    };
    if depth < max_depth {
        let next8 = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if next8 < 0 {
            w.stopped_end = true;
            return w;
        };
        if next8 == v0 || next8 == v1 || next8 == v2 || next8 == v3 || next8 == v4 || next8 == v5 || next8 == v6 || next8 == v7 {
            w.stopped_cycle = true;
            return w;
        };
        w = ecs_trav_walk_push(w, next8);
        current = next8;
        depth = 8;
    };
    if depth >= max_depth {
        let more = ecs_trav_edge_at(e0, e1, e2, e3, e4, e5, e6, e7, current);
        if more >= 0 {
            w.stopped_depth = true;
        } else {
            w.stopped_end = true;
        };
    };
    return w;
}

// Propagation helper: one-step propagate using relationship traversal
fn ecs_trav_propagate_step(has_rel: bool, target: i64, propagate_enabled: bool) -> (bool, i64) {
    if propagate_enabled != true {
        return (false, 0);
    };
    if has_rel != true {
        return (false, 0);
    };
    return (true, target);
}
