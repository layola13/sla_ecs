// Deepened Bevy ECS hot-patch helpers.
// Mirrors src/system hotpatch change tracking. Shallow lib/hot_patch.sla retained.

struct EcsHpDeep {
    registered: bool,
}

fn ecs_hp_deep_new() -> EcsHpDeep {
    return EcsHpDeep { registered: true };
}

fn ecs_hp_deep_is_registered(m: EcsHpDeep) -> bool { return m.registered; }

struct EcsHpChangesDeep {
    last_changed: i64,
}

fn ecs_hp_changes_new() -> EcsHpChangesDeep {
    return EcsHpChangesDeep { last_changed: 0 };
}

fn ecs_hp_changes_last(c: EcsHpChangesDeep) -> i64 { return c.last_changed; }

fn ecs_hp_changes_apply(c: EcsHpChangesDeep, at_tick: i64) -> EcsHpChangesDeep {
    return EcsHpChangesDeep { last_changed: at_tick };
}

fn ecs_hp_changes_is_changed_after(c: EcsHpChangesDeep, system_last_run: i64) -> bool {
    return c.last_changed > system_last_run;
}

fn ecs_hp_changes_is_none_or(has_resource: bool, last_changed: i64, system_last_run: i64) -> bool {
    if has_resource != true { return true; };
    return last_changed <= system_last_run;
}

fn ecs_hp_should_refresh(has_resource: bool, last_changed: i64, system_last_run: i64) -> bool {
    if has_resource != true { return false; };
    return last_changed > system_last_run;
}

struct EcsHpSysDeep {
    last_run: i64,
    refreshed: bool,
}

fn ecs_hp_sys_new(last_run: i64) -> EcsHpSysDeep {
    return EcsHpSysDeep { last_run: last_run, refreshed: false };
}

fn ecs_hp_sys_last_run(s: EcsHpSysDeep) -> i64 { return s.last_run; }
fn ecs_hp_sys_refreshed(s: EcsHpSysDeep) -> bool { return s.refreshed; }

fn ecs_hp_sys_refresh(s: EcsHpSysDeep, record_at_tick: i64) -> EcsHpSysDeep {
    return EcsHpSysDeep { last_run: record_at_tick, refreshed: true };
}

// combined: should refresh then apply
fn ecs_hp_maybe_refresh(s: EcsHpSysDeep, has_resource: bool, last_changed: i64) -> EcsHpSysDeep {
    if ecs_hp_should_refresh(has_resource, last_changed, s.last_run) {
        return ecs_hp_sys_refresh(s, last_changed);
    };
    return s;
}
