// Deep self-contained Bevy ECS reflect::resource module.
// Mirrors lib/reflect_resource.sla (87 lines, no @import) with fixed-cap (cap-16) scalar
// slot families instead of Vec<i32>/Vec<i64>, and tuple-return replacement companions
// inlined into the mutated struct (avoids the SA MemoryLeak — see docs/issue.md).
// No @import. All structs carry @derive(copy). Booleans stored as i32 (0/1).
// The shallow `get(component_id) -> (bool, i64)` and `insert_count` are flattened: `get`
// writes `last_get_present` + `last_get_count` on the struct; accessors read them.

const ECS_REFLECT_RESOURCE_DEEP_CAP: i32 = 16;

@derive(copy)
struct EcsReflectResourceDeep {
    // Cap-16 parallel (registered_id, insert_count) pairs.
    rid0: i32, rid1: i32, rid2: i32, rid3: i32, rid4: i32, rid5: i32, rid6: i32, rid7: i32,
    rid8: i32, rid9: i32, rid10: i32, rid11: i32, rid12: i32, rid13: i32, rid14: i32, rid15: i32,
    ic0: i64, ic1: i64, ic2: i64, ic3: i64, ic4: i64, ic5: i64, ic6: i64, ic7: i64,
    ic8: i64, ic9: i64, ic10: i64, ic11: i64, ic12: i64, ic13: i64, ic14: i64, ic15: i64,
    count: i32,
    // Companion fields replacing the tuple-return of `get`.
    last_get_present: i32,
    last_get_count: i64,
}

fn ecs_reflect_resource_deep_new() -> EcsReflectResourceDeep {
    return EcsReflectResourceDeep {
        rid0: 0, rid1: 0, rid2: 0, rid3: 0, rid4: 0, rid5: 0, rid6: 0, rid7: 0,
        rid8: 0, rid9: 0, rid10: 0, rid11: 0, rid12: 0, rid13: 0, rid14: 0, rid15: 0,
        ic0: 0, ic1: 0, ic2: 0, ic3: 0, ic4: 0, ic5: 0, ic6: 0, ic7: 0,
        ic8: 0, ic9: 0, ic10: 0, ic11: 0, ic12: 0, ic13: 0, ic14: 0, ic15: 0,
        count: 0,
        last_get_present: 0,
        last_get_count: 0,
    };
}

fn _errd_rid_at(r: EcsReflectResourceDeep, idx: i32) -> i32 {
    if idx == 0 { return r.rid0; };
    if idx == 1 { return r.rid1; };
    if idx == 2 { return r.rid2; };
    if idx == 3 { return r.rid3; };
    if idx == 4 { return r.rid4; };
    if idx == 5 { return r.rid5; };
    if idx == 6 { return r.rid6; };
    if idx == 7 { return r.rid7; };
    if idx == 8 { return r.rid8; };
    if idx == 9 { return r.rid9; };
    if idx == 10 { return r.rid10; };
    if idx == 11 { return r.rid11; };
    if idx == 12 { return r.rid12; };
    if idx == 13 { return r.rid13; };
    if idx == 14 { return r.rid14; };
    if idx == 15 { return r.rid15; };
    panic(146990);
}

fn _errd_rid_set(r: EcsReflectResourceDeep, idx: i32, v: i32) -> EcsReflectResourceDeep {
    if idx == 0 { r.rid0 = v; return r; };
    if idx == 1 { r.rid1 = v; return r; };
    if idx == 2 { r.rid2 = v; return r; };
    if idx == 3 { r.rid3 = v; return r; };
    if idx == 4 { r.rid4 = v; return r; };
    if idx == 5 { r.rid5 = v; return r; };
    if idx == 6 { r.rid6 = v; return r; };
    if idx == 7 { r.rid7 = v; return r; };
    if idx == 8 { r.rid8 = v; return r; };
    if idx == 9 { r.rid9 = v; return r; };
    if idx == 10 { r.rid10 = v; return r; };
    if idx == 11 { r.rid11 = v; return r; };
    if idx == 12 { r.rid12 = v; return r; };
    if idx == 13 { r.rid13 = v; return r; };
    if idx == 14 { r.rid14 = v; return r; };
    if idx == 15 { r.rid15 = v; return r; };
    panic(146991);
}

fn _errd_ic_at(r: EcsReflectResourceDeep, idx: i32) -> i64 {
    if idx == 0 { return r.ic0; };
    if idx == 1 { return r.ic1; };
    if idx == 2 { return r.ic2; };
    if idx == 3 { return r.ic3; };
    if idx == 4 { return r.ic4; };
    if idx == 5 { return r.ic5; };
    if idx == 6 { return r.ic6; };
    if idx == 7 { return r.ic7; };
    if idx == 8 { return r.ic8; };
    if idx == 9 { return r.ic9; };
    if idx == 10 { return r.ic10; };
    if idx == 11 { return r.ic11; };
    if idx == 12 { return r.ic12; };
    if idx == 13 { return r.ic13; };
    if idx == 14 { return r.ic14; };
    if idx == 15 { return r.ic15; };
    panic(146992);
}

fn _errd_ic_set(r: EcsReflectResourceDeep, idx: i32, v: i64) -> EcsReflectResourceDeep {
    if idx == 0 { r.ic0 = v; return r; };
    if idx == 1 { r.ic1 = v; return r; };
    if idx == 2 { r.ic2 = v; return r; };
    if idx == 3 { r.ic3 = v; return r; };
    if idx == 4 { r.ic4 = v; return r; };
    if idx == 5 { r.ic5 = v; return r; };
    if idx == 6 { r.ic6 = v; return r; };
    if idx == 7 { r.ic7 = v; return r; };
    if idx == 8 { r.ic8 = v; return r; };
    if idx == 9 { r.ic9 = v; return r; };
    if idx == 10 { r.ic10 = v; return r; };
    if idx == 11 { r.ic11 = v; return r; };
    if idx == 12 { r.ic12 = v; return r; };
    if idx == 13 { r.ic13 = v; return r; };
    if idx == 14 { r.ic14 = v; return r; };
    if idx == 15 { r.ic15 = v; return r; };
    panic(146993);
}

// is_registered: linear scan of the rid slot family.
fn ecs_reflect_resource_deep_is_registered(r: EcsReflectResourceDeep, component_id: i32) -> bool {
    let i: i32 = 0;
    while i < r.count {
        if _errd_rid_at(r, i) == component_id { return true; };
        i = i + 1;
    }
    return false;
}

// register: add a resource component_id at the next slot (duplicate guard).
fn ecs_reflect_resource_deep_register(r: EcsReflectResourceDeep, component_id: i32) -> EcsReflectResourceDeep {
    if ecs_reflect_resource_deep_is_registered(r, component_id) { return r; };
    if r.count < ECS_REFLECT_RESOURCE_DEEP_CAP {
        r = _errd_rid_set(r, r.count, component_id);
        r = _errd_ic_set(r, r.count, 0);
        r.count = r.count + 1;
    };
    return r;
}

fn ecs_reflect_resource_deep_count(r: EcsReflectResourceDeep) -> i64 { return r.count as i64; }

// insert: increment the insert_count for a registered resource; no-op if absent.
fn ecs_reflect_resource_deep_insert(r: EcsReflectResourceDeep, component_id: i32) -> EcsReflectResourceDeep {
    let i: i32 = 0;
    while i < r.count {
        if _errd_rid_at(r, i) == component_id {
            r = _errd_ic_set(r, i, _errd_ic_at(r, i) + 1);
            return r;
        };
        i = i + 1;
    }
    return r;
}

// get: reflect the resource presence via companion `last_get_present` + `last_get_count`.
fn ecs_reflect_resource_deep_get(r: EcsReflectResourceDeep, component_id: i32) -> EcsReflectResourceDeep {
    let i: i32 = 0;
    while i < r.count {
        if _errd_rid_at(r, i) == component_id {
            let c = _errd_ic_at(r, i);
            if c > 0 {
                r.last_get_present = 1;
                r.last_get_count = c;
            } else {
                r.last_get_present = 0;
                r.last_get_count = 0;
            };
            return r;
        };
        i = i + 1;
    }
    r.last_get_present = 0;
    r.last_get_count = 0;
    return r;
}

fn ecs_reflect_resource_deep_last_get_present(r: EcsReflectResourceDeep) -> bool { return r.last_get_present != 0; }
fn ecs_reflect_resource_deep_last_get_count(r: EcsReflectResourceDeep) -> i64 { return r.last_get_count; }

// remove: decrement the insert_count (min 0) for a registered resource.
fn ecs_reflect_resource_deep_remove(r: EcsReflectResourceDeep, component_id: i32) -> EcsReflectResourceDeep {
    let i: i32 = 0;
    while i < r.count {
        if _errd_rid_at(r, i) == component_id {
            let c = _errd_ic_at(r, i);
            if c > 0 {
                r = _errd_ic_set(r, i, c - 1);
            };
            return r;
        };
        i = i + 1;
    }
    return r;
}

// apply_or_insert: in this model it matches `insert`.
fn ecs_reflect_resource_deep_apply_or_insert(r: EcsReflectResourceDeep, component_id: i32) -> EcsReflectResourceDeep {
    return ecs_reflect_resource_deep_insert(r, component_id);
}

// insert_count: read the insert_count for a registered resource via `get`'s companions.
fn ecs_reflect_resource_deep_insert_count(r: EcsReflectResourceDeep, component_id: i32) -> i64 {
    r = ecs_reflect_resource_deep_get(r, component_id);
    return r.last_get_count;
}
