// Bevy ECS EntityHashSet derived/wrapper and iterator marker extras.
// Complements entity_hash_set_ops.sla with constructor/default/clone/debug,
// from/into inner wrappers, Extend variants, trusted unique construction,
// and Iter/IntoIter/Drain/ExtractIf/set-op iterator marker behavior.

struct EcsEhs4Set { items: Vec<i64>, capacity_hint: i64, constructed_kind: i32 }
struct EcsEhs4Iter { items: Vec<i64>, cursor: i64, debug_kind: i32, trusted_unique: i32, inner_exposed: i32 }
struct EcsEhs4SizeHint { lower: i64, upper: i64 }
struct EcsEhs4InsertResult { inserted: i32, set: EcsEhs4Set }
struct EcsEhs4NextResult { iter: EcsEhs4Iter, has: i32, value: i64 }

fn ecs_ehs4_new() -> EcsEhs4Set {
    return EcsEhs4Set { items: Vec::new(), capacity_hint: 0, constructed_kind: 1 };
}

fn ecs_ehs4_default() -> EcsEhs4Set {
    return EcsEhs4Set { items: Vec::new(), capacity_hint: 0, constructed_kind: 2 };
}

fn ecs_ehs4_with_capacity(capacity: i64) -> EcsEhs4Set {
    let hint = capacity;
    if hint < 0 { hint = 0; };
    return EcsEhs4Set { items: Vec::new(), capacity_hint: hint, constructed_kind: 3 };
}

fn ecs_ehs4_from_hash_set(set: EcsEhs4Set) -> EcsEhs4Set {
    return EcsEhs4Set { items: set.items, capacity_hint: set.capacity_hint, constructed_kind: 6 };
}

fn ecs_ehs4_into_inner(set: EcsEhs4Set) -> Vec<i64> { return set.items; }

fn ecs_ehs4_clone(set: EcsEhs4Set) -> EcsEhs4Set {
    let capacity_hint = set.capacity_hint;
    return EcsEhs4Set { items: set.items, capacity_hint: capacity_hint, constructed_kind: 4 };
}

fn ecs_ehs4_debug_kind(set: EcsEhs4Set) -> i32 { return set.constructed_kind; }
fn ecs_ehs4_len(set: EcsEhs4Set) -> i64 { return len(set.items) as i64; }
fn ecs_ehs4_inner_len(items: Vec<i64>) -> i64 { return len(items) as i64; }

fn ecs_ehs4_contains(set: EcsEhs4Set, value: i64) -> bool {
    let found = false;
    let index: i64 = 0;
    while index < (len(set.items) as i64) {
        if set.items[index] == value { found = true; };
        index = index + 1;
    }
    return found;
}

fn ecs_ehs4_insert(set: EcsEhs4Set, value: i64) -> EcsEhs4InsertResult {
    let duplicate = false;
    let index: i64 = 0;
    while index < (len(set.items) as i64) {
        if set.items[index] == value { duplicate = true; };
        index = index + 1;
    }
    if duplicate { return EcsEhs4InsertResult { inserted: 0, set: set }; };
    set.items.push(value);
    return EcsEhs4InsertResult { inserted: 1, set: set };
}

fn ecs_ehs4_extend_owned(set: EcsEhs4Set, values: Vec<i64>) -> EcsEhs4Set {
    let index: i64 = 0;
    while index < (len(values) as i64) {
        let inserted = ecs_ehs4_insert(set, values[index]);
        set = inserted.set;
        index = index + 1;
    }
    return set;
}

fn ecs_ehs4_extend_refs(set: EcsEhs4Set, values: Vec<i64>) -> EcsEhs4Set {
    return ecs_ehs4_extend_owned(set, values);
}

fn ecs_ehs4_from_iter(values: Vec<i64>) -> EcsEhs4Set {
    return ecs_ehs4_extend_owned(ecs_ehs4_new(), values);
}

fn ecs_ehs4_from_array4(a: i64, b: i64, c: i64, d: i64) -> EcsEhs4Set {
    let values: Vec<i64> = Vec::new();
    values.push(a);
    values.push(b);
    values.push(c);
    values.push(d);
    let set = ecs_ehs4_extend_owned(ecs_ehs4_new(), values);
    return EcsEhs4Set { items: set.items, capacity_hint: 4, constructed_kind: 5 };
}

fn ecs_ehs4_from_entity_set_iter(values: Vec<i64>, size_hint: i64) -> EcsEhs4Set {
    let set = ecs_ehs4_extend_owned(ecs_ehs4_with_capacity(size_hint), values);
    return EcsEhs4Set { items: set.items, capacity_hint: size_hint, constructed_kind: 7 };
}

fn ecs_ehs4_eq(a: EcsEhs4Set, b: EcsEhs4Set) -> bool {
    if len(a.items) != len(b.items) { return false; };
    let equal = true;
    let index: i64 = 0;
    while index < (len(a.items) as i64) {
        let found = false;
        let right_index: i64 = 0;
        while right_index < (len(b.items) as i64) {
            if b.items[right_index] == a.items[index] { found = true; };
            right_index = right_index + 1;
        }
        if found != true { equal = false; };
        index = index + 1;
    }
    return equal;
}

fn ecs_ehs4_iter_from_set(set: EcsEhs4Set, debug_kind: i32) -> EcsEhs4Iter {
    return EcsEhs4Iter { items: set.items, cursor: 0, debug_kind: debug_kind, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_iter(set: EcsEhs4Set) -> EcsEhs4Iter { return ecs_ehs4_iter_from_set(set, 10); }
fn ecs_ehs4_into_iter(set: EcsEhs4Set) -> EcsEhs4Iter { return ecs_ehs4_iter_from_set(set, 20); }

fn ecs_ehs4_drain(set: EcsEhs4Set) -> EcsEhs4Iter {
    return ecs_ehs4_iter_from_set(set, 30);
}

fn ecs_ehs4_extract_if(set: EcsEhs4Set, predicate_kind: i32, threshold: i64) -> EcsEhs4Iter {
    let extracted: Vec<i64> = Vec::new();
    let index: i64 = 0;
    while index < (len(set.items) as i64) {
        let value = set.items[index];
        let remove = false;
        if predicate_kind == 0 { if (value % 2) == 0 { remove = true; }; };
        if predicate_kind == 1 { if value > threshold { remove = true; }; };
        if remove { extracted.push(value); };
        index = index + 1;
    }
    return EcsEhs4Iter { items: extracted, cursor: 0, debug_kind: 40, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_difference_iter(left: EcsEhs4Set, right: EcsEhs4Set) -> EcsEhs4Iter {
    let out: Vec<i64> = Vec::new();
    let index: i64 = 0;
    while index < (len(left.items) as i64) {
        let found = false;
        let right_index: i64 = 0;
        while right_index < (len(right.items) as i64) {
            if right.items[right_index] == left.items[index] { found = true; };
            right_index = right_index + 1;
        }
        if found != true {
            out.push(left.items[index]);
        };
        index = index + 1;
    }
    return EcsEhs4Iter { items: out, cursor: 0, debug_kind: 51, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_intersection_iter(left: EcsEhs4Set, right: EcsEhs4Set) -> EcsEhs4Iter {
    let out: Vec<i64> = Vec::new();
    let index: i64 = 0;
    while index < (len(left.items) as i64) {
        let found = false;
        let right_index: i64 = 0;
        while right_index < (len(right.items) as i64) {
            if right.items[right_index] == left.items[index] { found = true; };
            right_index = right_index + 1;
        }
        if found {
            out.push(left.items[index]);
        };
        index = index + 1;
    }
    return EcsEhs4Iter { items: out, cursor: 0, debug_kind: 52, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_union_iter(left: EcsEhs4Set, right: EcsEhs4Set) -> EcsEhs4Iter {
    let out: Vec<i64> = Vec::new();
    let left_index: i64 = 0;
    while left_index < (len(left.items) as i64) {
        out.push(left.items[left_index]);
        left_index = left_index + 1;
    }
    let right_index: i64 = 0;
    while right_index < (len(right.items) as i64) {
        let found = false;
        let out_index: i64 = 0;
        while out_index < (len(out) as i64) {
            if out[out_index] == right.items[right_index] { found = true; };
            out_index = out_index + 1;
        }
        if found != true { out.push(right.items[right_index]); };
        right_index = right_index + 1;
    }
    return EcsEhs4Iter { items: out, cursor: 0, debug_kind: 53, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_symmetric_difference_iter(left: EcsEhs4Set, right: EcsEhs4Set) -> EcsEhs4Iter {
    let out: Vec<i64> = Vec::new();
    let left_index: i64 = 0;
    while left_index < (len(left.items) as i64) {
        let found_right = false;
        let right_index: i64 = 0;
        while right_index < (len(right.items) as i64) {
            if right.items[right_index] == left.items[left_index] { found_right = true; };
            right_index = right_index + 1;
        }
        if found_right != true {
            out.push(left.items[left_index]);
        };
        left_index = left_index + 1;
    }
    let right_index2: i64 = 0;
    while right_index2 < (len(right.items) as i64) {
        let found_left = false;
        let left_index2: i64 = 0;
        while left_index2 < (len(left.items) as i64) {
            if left.items[left_index2] == right.items[right_index2] { found_left = true; };
            left_index2 = left_index2 + 1;
        }
        if found_left != true {
            out.push(right.items[right_index2]);
        };
        right_index2 = right_index2 + 1;
    }
    return EcsEhs4Iter { items: out, cursor: 0, debug_kind: 54, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_iter_remaining(iter: EcsEhs4Iter) -> i64 {
    let remaining = (len(iter.items) as i64) - iter.cursor;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_ehs4_size_hint(iter: EcsEhs4Iter) -> EcsEhs4SizeHint {
    let remaining = ecs_ehs4_iter_remaining(iter);
    return EcsEhs4SizeHint { lower: remaining, upper: remaining };
}

fn ecs_ehs4_iter_debug_kind(iter: EcsEhs4Iter) -> i32 { return iter.debug_kind; }

fn ecs_ehs4_iter_into_inner(iter: EcsEhs4Iter) -> EcsEhs4Iter {
    return EcsEhs4Iter { items: iter.items, cursor: iter.cursor, debug_kind: iter.debug_kind, trusted_unique: iter.trusted_unique, inner_exposed: 1 };
}

fn ecs_ehs4_iter_default(debug_kind: i32) -> EcsEhs4Iter {
    return EcsEhs4Iter { items: Vec::new(), cursor: 0, debug_kind: debug_kind, trusted_unique: 1, inner_exposed: 0 };
}

fn ecs_ehs4_iter_clone(iter: EcsEhs4Iter) -> EcsEhs4Iter {
    return EcsEhs4Iter { items: iter.items, cursor: iter.cursor, debug_kind: iter.debug_kind, trusted_unique: iter.trusted_unique, inner_exposed: iter.inner_exposed };
}

fn ecs_ehs4_iter_next(iter: EcsEhs4Iter) -> EcsEhs4NextResult {
    if iter.cursor >= (len(iter.items) as i64) { return EcsEhs4NextResult { iter: iter, has: 0, value: -1 }; };
    let value = iter.items[iter.cursor];
    iter.cursor = iter.cursor + 1;
    return EcsEhs4NextResult { iter: iter, has: 1, value: value };
}
