// Deep self-contained Bevy ECS reflect::bundle module.
// Mirrors lib/reflect_bundle.sla (34 lines, no @import) with fixed-cap (cap-16) scalar slot
// families instead of Vec<i32>. All structs carry @derive(copy). Booleans stored as i32 (0/1).
// Bevy ECS reflect::bundle (src/reflect/bundle.rs): ReflectBundle — a set of component ids
// inserted together by a single bundle.

const ECS_REFLECT_BUNDLE_DEEP_CAP: i32 = 16;

@derive(copy)
struct EcsReflectBundleDeep {
    bundle_id: i32,
    // Cap-16 component_ids slot family (the component ids this bundle contains).
    cid0: i32, cid1: i32, cid2: i32, cid3: i32, cid4: i32, cid5: i32, cid6: i32, cid7: i32,
    cid8: i32, cid9: i32, cid10: i32, cid11: i32, cid12: i32, cid13: i32, cid14: i32, cid15: i32,
    count: i32,
}

fn ecs_reflect_bundle_deep_new(bundle_id: i32) -> EcsReflectBundleDeep {
    return EcsReflectBundleDeep {
        bundle_id: bundle_id,
        cid0: 0, cid1: 0, cid2: 0, cid3: 0, cid4: 0, cid5: 0, cid6: 0, cid7: 0,
        cid8: 0, cid9: 0, cid10: 0, cid11: 0, cid12: 0, cid13: 0, cid14: 0, cid15: 0,
        count: 0,
    };
}

fn ecs_reflect_bundle_deep_id(b: EcsReflectBundleDeep) -> i32 { return b.bundle_id; }

fn _erbd_cid_at(b: EcsReflectBundleDeep, idx: i32) -> i32 {
    if idx == 0 { return b.cid0; };
    if idx == 1 { return b.cid1; };
    if idx == 2 { return b.cid2; };
    if idx == 3 { return b.cid3; };
    if idx == 4 { return b.cid4; };
    if idx == 5 { return b.cid5; };
    if idx == 6 { return b.cid6; };
    if idx == 7 { return b.cid7; };
    if idx == 8 { return b.cid8; };
    if idx == 9 { return b.cid9; };
    if idx == 10 { return b.cid10; };
    if idx == 11 { return b.cid11; };
    if idx == 12 { return b.cid12; };
    if idx == 13 { return b.cid13; };
    if idx == 14 { return b.cid14; };
    if idx == 15 { return b.cid15; };
    panic(147080);
}

fn _erbd_cid_set(b: EcsReflectBundleDeep, idx: i32, v: i32) -> EcsReflectBundleDeep {
    if idx == 0 { b.cid0 = v; return b; };
    if idx == 1 { b.cid1 = v; return b; };
    if idx == 2 { b.cid2 = v; return b; };
    if idx == 3 { b.cid3 = v; return b; };
    if idx == 4 { b.cid4 = v; return b; };
    if idx == 5 { b.cid5 = v; return b; };
    if idx == 6 { b.cid6 = v; return b; };
    if idx == 7 { b.cid7 = v; return b; };
    if idx == 8 { b.cid8 = v; return b; };
    if idx == 9 { b.cid9 = v; return b; };
    if idx == 10 { b.cid10 = v; return b; };
    if idx == 11 { b.cid11 = v; return b; };
    if idx == 12 { b.cid12 = v; return b; };
    if idx == 13 { b.cid13 = v; return b; };
    if idx == 14 { b.cid14 = v; return b; };
    if idx == 15 { b.cid15 = v; return b; };
    panic(147081);
}

fn ecs_reflect_bundle_deep_add_component(b: EcsReflectBundleDeep, component_id: i32) -> EcsReflectBundleDeep {
    if b.count < ECS_REFLECT_BUNDLE_DEEP_CAP {
        b = _erbd_cid_set(b, b.count, component_id);
        b.count = b.count + 1;
    };
    return b;
}

fn ecs_reflect_bundle_deep_component_count(b: EcsReflectBundleDeep) -> i64 { return b.count as i64; }

fn ecs_reflect_bundle_deep_component_at(b: EcsReflectBundleDeep, idx: i64) -> i32 {
    return _erbd_cid_at(b, idx as i32);
}

// insert: insert all bundle components on an entity (modeled as returning count inserted).
fn ecs_reflect_bundle_deep_insert(b: EcsReflectBundleDeep, entity: i64) -> i64 {
    let n = b.count;
    return n as i64;
}

// contains: whether the bundle is registered
fn ecs_reflect_bundle_deep_is_registered(b: EcsReflectBundleDeep) -> bool { return b.bundle_id >= 0; }
