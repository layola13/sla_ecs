fn ecs_rel_decl_new(relationship_type_id: i32, source_component_type_id: i32, target_component_type_id: i32, target_mode: i32, linked_spawn: bool, allow_self: bool, ordered: bool) -> EcsRelationshipDeclarationDeep {
    if relationship_type_id <= 0 { return ecs_rel_decl_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_RELATIONSHIP_ID_DEEP); };
    if source_component_type_id <= 0 { return ecs_rel_decl_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_SOURCE_ID_DEEP); };
    if target_component_type_id <= 0 { return ecs_rel_decl_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_TARGET_ID_DEEP); };
    if target_mode != ECS_RELATIONSHIP_DECL_TARGET_MANY_DEEP {
        if target_mode != ECS_RELATIONSHIP_DECL_TARGET_ONE_DEEP { return ecs_rel_decl_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_TARGET_MODE_DEEP); };
    };
    if source_component_type_id == target_component_type_id { return ecs_rel_decl_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT_DEEP); };
    if target_mode == ECS_RELATIONSHIP_DECL_TARGET_ONE_DEEP {
        if ordered { return ecs_rel_decl_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_ONE_TO_ONE_ORDERED_DEEP); };
    };
    return EcsRelationshipDeclarationDeep { relationship_type_id: relationship_type_id, source_component_type_id: source_component_type_id, target_component_type_id: target_component_type_id, target_mode: target_mode, linked_spawn: ecs_rel_decl_bool(linked_spawn), allow_self: ecs_rel_decl_bool(allow_self), ordered: ecs_rel_decl_bool(ordered), valid: 1, error_code: ECS_RELATIONSHIP_DECL_OK_DEEP };
}

