fn ecs_rel_decl_same(left: EcsRelationshipDeclarationDeep, right: EcsRelationshipDeclarationDeep) -> bool {
    if left.relationship_type_id != right.relationship_type_id { return false; };
    if left.source_component_type_id != right.source_component_type_id { return false; };
    if left.target_component_type_id != right.target_component_type_id { return false; };
    if left.target_mode != right.target_mode { return false; };
    if left.linked_spawn != right.linked_spawn { return false; };
    if left.allow_self != right.allow_self { return false; };
    if left.ordered != right.ordered { return false; };
    return true;
}

