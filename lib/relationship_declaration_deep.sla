    registry = _ecs_rel_decl_set_linked_spawn(registry, idx, declaration.linked_spawn);
    registry = _ecs_rel_decl_set_allow_self(registry, idx, declaration.allow_self);
    registry = _ecs_rel_decl_set_ordered(registry, idx, declaration.ordered);
    registry = _ecs_rel_decl_set_valid(registry, idx, declaration.valid);
    registry = _ecs_rel_decl_set_error_code(registry, idx, declaration.error_code);
    return registry;
}

fn ecs_rel_decl_find_type_id(registry: EcsRelationshipDeclarationRegistryDeep, relationship_type_id: i32) -> i32 {
    let i: i32 = 0;
    while i < registry.count {
        if _ecs_rel_decl_relationship_type_id_at(registry, i) == relationship_type_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_rel_decl_find_pair(registry: EcsRelationshipDeclarationRegistryDeep, declaration: EcsRelationshipDeclarationDeep) -> i32 {
    let i: i32 = 0;
    while i < registry.count {
        let current = ecs_rel_decl_registry_at(registry, i);
        if ecs_rel_decl_same_pair(current, declaration) { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_rel_decl_register_result(registry: EcsRelationshipDeclarationRegistryDeep, inserted: i32, duplicate: i32, id_collision: i32, pair_conflict: i32, invalid: i32, existing_index: i32, error_code: i32) -> EcsRelationshipDeclarationRegisterResultDeep {
    return EcsRelationshipDeclarationRegisterResultDeep { registry: registry, inserted: inserted, duplicate: duplicate, id_collision: id_collision, pair_conflict: pair_conflict, invalid: invalid, existing_index: existing_index, error_code: error_code };
}

fn ecs_rel_decl_registry_register(registry: EcsRelationshipDeclarationRegistryDeep, declaration: EcsRelationshipDeclarationDeep) -> EcsRelationshipDeclarationRegisterResultDeep {
    if declaration.valid != 1 { return ecs_rel_decl_register_result(registry, 0, 0, 0, 0, 1, -1, declaration.error_code); };
    let existing_type = ecs_rel_decl_find_type_id(registry, declaration.relationship_type_id);
    if existing_type >= 0 {
        let current = ecs_rel_decl_registry_at(registry, existing_type);
        if ecs_rel_decl_same(current, declaration) { return ecs_rel_decl_register_result(registry, 0, 1, 0, 0, 0, existing_type, ECS_RELATIONSHIP_DECL_OK_DEEP); };
        return ecs_rel_decl_register_result(registry, 0, 0, 1, 0, 0, existing_type, ECS_RELATIONSHIP_DECL_OK_DEEP);
    };
    let existing_pair = ecs_rel_decl_find_pair(registry, declaration);
    if existing_pair >= 0 { return ecs_rel_decl_register_result(registry, 0, 0, 0, 1, 0, existing_pair, ECS_RELATIONSHIP_DECL_OK_DEEP); };
    if registry.count >= ECS_RELATIONSHIP_DECL_CAP_DEEP { return ecs_rel_decl_register_result(registry, 0, 0, 0, 0, 1, -1, ECS_RELATIONSHIP_DECL_ERR_RELATIONSHIP_ID_DEEP); };
    let idx = registry.count;
    registry = _ecs_rel_decl_registry_set_at(registry, idx, declaration);
    registry.count = idx + 1;
    return ecs_rel_decl_register_result(registry, 1, 0, 0, 0, 0, -1, ECS_RELATIONSHIP_DECL_OK_DEEP);
}
