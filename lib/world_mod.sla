// inspect_entity: returns (found, count)
fn ecs_world_mod_inspect_entity(w: EcsWorld, entity: i64) -> (bool, i64) {
    let v = ecs_world_mod_entity_valid(w, entity);
    if !v {
        let _ = v;
        let z = v;
        return (false, 0);
    };
    return (true, w.entity_count);
}

