// insert_batch / insert_batch_if_new / try_insert_batch / try_insert_batch_if_new
fn ecs_world_mod_insert_batch(w: EcsWorld, count: i64) -> (EcsWorld, i64) {
    let i: i64 = 0;
    while i < count {
        let r = ecs_world_mod_spawn_empty(w);
        w = r.0;
        i = i + 1;
    }
    return (w, count);
}

fn ecs_world_mod_insert_batch_if_new(w: EcsWorld, count: i64) -> (EcsWorld, i64) {
    return ecs_world_mod_insert_batch(w, count);
}

fn ecs_world_mod_try_insert_batch(w: EcsWorld, count: i64) -> (EcsWorld, i64) {
    return ecs_world_mod_insert_batch(w, count);
}

fn ecs_world_mod_try_insert_batch_if_new(w: EcsWorld, count: i64) -> (EcsWorld, i64) {
    return ecs_world_mod_insert_batch(w, count);
}

