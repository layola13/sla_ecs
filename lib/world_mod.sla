// add_schedule / try_schedule_scope / schedule_scope / try_run_schedule / run_schedule
fn ecs_world_mod_add_schedule(w: EcsWorld, label_id: i32, schedule_id: i64) -> (EcsWorld, bool) {
    let found = false;
    let i: i64 = 0;
    let n: i64 = len(w.schedules) as i64;
    while i < n {
        if w.schedules[i as i32].label_id == label_id {
            found = true;
            i = n;
        };
        i = i + 1;
    }
    if found {
        // replace
        let entry = EcsWorldScheduleEntry { label_id: label_id, schedule_id: schedule_id };
        w.schedules.push(entry);
        return (w, false);
    };
    let e2 = EcsWorldScheduleEntry { label_id: label_id, schedule_id: schedule_id };
    w.schedules.push(e2);
    return (w, true);
}

fn ecs_world_mod_try_schedule_scope(w: EcsWorld, label_id: i32) -> (EcsWorld, bool, i64) {
    let r = ecs_world_mod_get_schedule(w, label_id);
    if r.0 { return (w, true, r.1); };
    return (w, false, 0);
}

fn ecs_world_mod_schedule_scope(w: EcsWorld, label_id: i32) -> (EcsWorld, i64) {
    let r = ecs_world_mod_get_schedule(w, label_id);
    return (w, r.1);
}

fn ecs_world_mod_try_run_schedule(w: EcsWorld, label_id: i32) -> (EcsWorld, bool, i64) {
    let r = ecs_world_mod_try_schedule_scope(w, label_id);
    return (r.0, r.1, r.2);
}

fn ecs_world_mod_run_schedule(w: EcsWorld, label_id: i32) -> (EcsWorld, bool, i64) {
    let r = ecs_world_mod_try_run_schedule(w, label_id);
    return (r.0, r.1, r.2);
}

fn ecs_world_mod_get_schedule(w: EcsWorld, label_id: i32) -> (bool, i64) {
    let i: i64 = 0;
    let n: i64 = len(w.schedules) as i64;
    while i < n {
        if w.schedules[i as i32].label_id == label_id {
            return (true, w.schedules[i as i32].schedule_id);
        };
        i = i + 1;
    }
    return (false, 0);
}

fn ecs_world_mod_contains_schedule(w: EcsWorld, label_id: i32) -> bool {
    return ecs_world_mod_get_schedule(w, label_id).0;
}

fn ecs_world_mod_remove_schedule(w: EcsWorld, label_id: i32) -> (EcsWorld, bool) {
    let i: i64 = 0;
    let n: i64 = len(w.schedules) as i64;
    let idx: i64 = -1;
    let found = false;
    while i < n {
        if w.schedules[i as i32].label_id == label_id {
            idx = i;
            found = true;
            i = n;
        };
        i = i + 1;
    }
    if found {
        w.schedules[idx as i32] = EcsWorldScheduleEntry { label_id: -1, schedule_id: 0 };
        return (w, true);
    };
    return (w, false);
}

