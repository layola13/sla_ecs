    let w2 = ecs_world_mod_clear_entities(w);
    let w3 = ecs_world_mod_clear_resources(w2);
    let w4 = ecs_world_mod_clear_non_send(w3);
    return w4;
}

fn ecs_world_mod_clear_entities(w: EcsWorld) -> EcsWorld {
