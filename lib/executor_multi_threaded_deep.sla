}

fn _mt_complete_ready_batch_push_apply(r: EcsExecutorCompleteReadyBatchSummaryDeep, system_index: i64) -> EcsExecutorCompleteReadyBatchSummaryDeep {
    if r.apply_count == 0 { r.apply0 = system_index; r.apply_count = 1; return r; };
    if r.apply_count == 1 { r.apply1 = system_index; r.apply_count = 2; return r; };
    if r.apply_count == 2 { r.apply2 = system_index; r.apply_count = 3; return r; };
    return r;
}

fn _mt_complete_ready_batch_apply_unapplied(r: EcsExecutorCompleteReadyBatchSummaryDeep, s: EcsExecutorStateDeep) -> EcsExecutorCompleteReadyBatchSummaryDeep {
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_unapplied_at(s, i) { r = _mt_complete_ready_batch_push_apply(r, i); };
        i = i + 1;
    }
    return r;
}

