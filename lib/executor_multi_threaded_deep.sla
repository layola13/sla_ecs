    };
    if spec.system_index == b.system_index {
        return ecs_executor_state_deep_complete_system_with_dependents3(s, spec, spec.has_deferred != 0, b_dep0, b_dep1, b_dep2, b_dep_count);
    };
    if spec.system_index == c.system_index {
        return ecs_executor_state_deep_complete_system_with_dependents3(s, spec, spec.has_deferred != 0, c_dep0, c_dep1, c_dep2, c_dep_count);
    };
    return ecs_executor_state_deep_complete_system_with_dependents3(s, spec, spec.has_deferred != 0, -1, -1, -1, 0);
}

