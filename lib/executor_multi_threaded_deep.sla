    return EcsExecutorTickLoopSummaryDeep {
        tick_count: 0,
        lock_failed: 0,
        pending_count: 0,
        pending0: -1,
        pending1: -1,
        pending2: -1,
        batch_count: 0,
        batch0_count: 0,
        batch0_system0: -1,
        batch0_system1: -1,
        batch0_system2: -1,
        batch0_skipped_count: 0,
        batch0_skipped0: -1,
        batch0_skipped1: -1,
        batch0_skipped2: -1,
        batch1_count: 0,
        batch1_system0: -1,
        batch1_system1: -1,
