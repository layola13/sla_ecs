}

fn ecs_executor_finish_run_summary_deep_with_deferred_error(s: EcsExecutorStateDeep, apply_final_deferred: bool, fail_system_index: i64) -> EcsExecutorFinishRunSummaryDeep {
    let r = ecs_executor_finish_run_summary_deep_empty();
    r.apply_final_deferred = _mt_bool(apply_final_deferred);
    let failed: i32 = 0;
    if apply_final_deferred {
        let i: i64 = 0;
        while i < s.system_count {
            if _mt_unapplied_at(s, i) && failed == 0 {
                r.apply_count = r.apply_count + 1;
                if i == fail_system_index {
                    r.panic_payload_pending = 1;
                    r.deferred_panic_payloads = 1;
                    r.panic_payload_phase = ecs_executor_panic_phase_deep_apply_deferred();
                    r.panic_payload_system = i;
                    failed = 1;
                };
            };
            i = i + 1;
        }
    };
    s = ecs_executor_state_deep_finish_run(s, apply_final_deferred);
    return _mt_finish_run_summary_from_state(r, s);
}

fn ecs_executor_finish_run_summary_deep_with_deferred_handled_error(s: EcsExecutorStateDeep, apply_final_deferred: bool, handled_system_index: i64) -> EcsExecutorFinishRunSummaryDeep {
    let r = ecs_executor_finish_run_summary_deep_empty();
    r.apply_final_deferred = _mt_bool(apply_final_deferred);
    if apply_final_deferred {
        let i: i64 = 0;
        while i < s.system_count {
            if _mt_unapplied_at(s, i) {
                r.apply_count = r.apply_count + 1;
                if i == handled_system_index {
                    r.deferred_handled_errors = r.deferred_handled_errors + 1;
                    r.handled_error_phase = ecs_executor_panic_phase_deep_apply_deferred();
                    r.handled_error_system = i;
                };
            };
            i = i + 1;
        }
    };
    s = ecs_executor_state_deep_finish_run(s, apply_final_deferred);
    return _mt_finish_run_summary_from_state(r, s);
}

