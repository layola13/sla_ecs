    if idx == 0 { return s.evaluated0 != 0; }; if idx == 1 { return s.evaluated1 != 0; };
    if idx == 2 { return s.evaluated2 != 0; }; if idx == 3 { return s.evaluated3 != 0; };
    if idx == 4 { return s.evaluated4 != 0; }; if idx == 5 { return s.evaluated5 != 0; };
