fn _mt_bool(v: bool) -> i32 {
    if v { return 1; };
    return 0;
}

fn ecs_executor_panic_phase_deep_none() -> i64 { return 0; }
fn ecs_executor_panic_phase_deep_system() -> i64 { return 1; }
fn ecs_executor_panic_phase_deep_apply_deferred() -> i64 { return 2; }
fn ecs_executor_panic_phase_deep_run_condition() -> i64 { return 3; }

fn ecs_executor_condition_outcome_deep_false() -> i64 { return 0; }
fn ecs_executor_condition_outcome_deep_true() -> i64 { return 1; }
fn ecs_executor_condition_outcome_deep_handled_error() -> i64 { return 2; }
fn ecs_executor_condition_outcome_deep_error_handler_panic() -> i64 { return 3; }

fn ecs_executor_error_state_deep_new() -> EcsExecutorErrorStateDeep {
    return EcsExecutorErrorStateDeep {
        panic_payload_pending: 0,
        system_panic_payloads: 0,
        deferred_panic_payloads: 0,
        panic_payload_phase: 0,
        panic_payload_system: -1,
        panic_payload_rethrows: 0,
        system_handled_errors: 0,
        deferred_handled_errors: 0,
        handled_error_phase: 0,
        handled_error_system: -1,
    };
}

fn ecs_executor_error_state_deep_panic_payload_pending(e: EcsExecutorErrorStateDeep) -> bool { return e.panic_payload_pending != 0; }
fn ecs_executor_error_state_deep_system_panic_payloads(e: EcsExecutorErrorStateDeep) -> i64 { return e.system_panic_payloads; }
fn ecs_executor_error_state_deep_deferred_panic_payloads(e: EcsExecutorErrorStateDeep) -> i64 { return e.deferred_panic_payloads; }
fn ecs_executor_error_state_deep_panic_payload_phase(e: EcsExecutorErrorStateDeep) -> i64 { return e.panic_payload_phase; }
fn ecs_executor_error_state_deep_panic_payload_system(e: EcsExecutorErrorStateDeep) -> i64 { return e.panic_payload_system; }
fn ecs_executor_error_state_deep_panic_payload_rethrows(e: EcsExecutorErrorStateDeep) -> i64 { return e.panic_payload_rethrows; }
fn ecs_executor_error_state_deep_system_handled_errors(e: EcsExecutorErrorStateDeep) -> i64 { return e.system_handled_errors; }
fn ecs_executor_error_state_deep_deferred_handled_errors(e: EcsExecutorErrorStateDeep) -> i64 { return e.deferred_handled_errors; }
fn ecs_executor_error_state_deep_handled_error_phase(e: EcsExecutorErrorStateDeep) -> i64 { return e.handled_error_phase; }
fn ecs_executor_error_state_deep_handled_error_system(e: EcsExecutorErrorStateDeep) -> i64 { return e.handled_error_system; }

fn ecs_executor_error_state_deep_record_system_panic_payload(e: EcsExecutorErrorStateDeep, system_index: i64) -> EcsExecutorErrorStateDeep {
    e.panic_payload_pending = 1;
    e.system_panic_payloads = e.system_panic_payloads + 1;
    e.panic_payload_phase = ecs_executor_panic_phase_deep_system();
    e.panic_payload_system = system_index;
    return e;
}

fn ecs_executor_error_state_deep_record_deferred_panic_payload(e: EcsExecutorErrorStateDeep, system_index: i64) -> EcsExecutorErrorStateDeep {
    e.panic_payload_pending = 1;
    e.deferred_panic_payloads = e.deferred_panic_payloads + 1;
    e.panic_payload_phase = ecs_executor_panic_phase_deep_apply_deferred();
    e.panic_payload_system = system_index;
    return e;
}

fn ecs_executor_error_state_deep_record_system_handled_error(e: EcsExecutorErrorStateDeep, system_index: i64) -> EcsExecutorErrorStateDeep {
    e.system_handled_errors = e.system_handled_errors + 1;
    e.handled_error_phase = ecs_executor_panic_phase_deep_system();
    e.handled_error_system = system_index;
    return e;
}

fn ecs_executor_error_state_deep_record_deferred_handled_error(e: EcsExecutorErrorStateDeep, system_index: i64) -> EcsExecutorErrorStateDeep {
    e.deferred_handled_errors = e.deferred_handled_errors + 1;
    e.handled_error_phase = ecs_executor_panic_phase_deep_apply_deferred();
    e.handled_error_system = system_index;
    return e;
}

fn ecs_executor_error_state_deep_take_panic_payload(e: EcsExecutorErrorStateDeep) -> EcsExecutorErrorStateDeep {
    if e.panic_payload_pending != 0 { e.panic_payload_rethrows = e.panic_payload_rethrows + 1; };
    e.panic_payload_pending = 0;
    e.panic_payload_phase = ecs_executor_panic_phase_deep_none();
    e.panic_payload_system = -1;
    return e;
}

fn ecs_executor_condition_fold_deep_new() -> EcsExecutorConditionFoldDeep {
    return EcsExecutorConditionFoldDeep {
        should_run: 1,
        evaluated_count: 0,
        aborted: 0,
        panic_payload_pending: 0,
        system_panic_payloads: 0,
        panic_payload_phase: 0,
        panic_payload_system: -1,
        system_handled_errors: 0,
        handled_error_phase: 0,
        handled_error_system: -1,
    };
}

fn ecs_executor_condition_fold_deep_should_run(f: EcsExecutorConditionFoldDeep) -> bool { return f.should_run != 0; }
fn ecs_executor_condition_fold_deep_evaluated_count(f: EcsExecutorConditionFoldDeep) -> i64 { return f.evaluated_count; }
fn ecs_executor_condition_fold_deep_aborted(f: EcsExecutorConditionFoldDeep) -> bool { return f.aborted != 0; }
fn ecs_executor_condition_fold_deep_panic_payload_pending(f: EcsExecutorConditionFoldDeep) -> bool { return f.panic_payload_pending != 0; }
fn ecs_executor_condition_fold_deep_system_panic_payloads(f: EcsExecutorConditionFoldDeep) -> i64 { return f.system_panic_payloads; }
fn ecs_executor_condition_fold_deep_panic_payload_phase(f: EcsExecutorConditionFoldDeep) -> i64 { return f.panic_payload_phase; }
fn ecs_executor_condition_fold_deep_panic_payload_system(f: EcsExecutorConditionFoldDeep) -> i64 { return f.panic_payload_system; }
fn ecs_executor_condition_fold_deep_system_handled_errors(f: EcsExecutorConditionFoldDeep) -> i64 { return f.system_handled_errors; }
fn ecs_executor_condition_fold_deep_handled_error_phase(f: EcsExecutorConditionFoldDeep) -> i64 { return f.handled_error_phase; }
fn ecs_executor_condition_fold_deep_handled_error_system(f: EcsExecutorConditionFoldDeep) -> i64 { return f.handled_error_system; }

fn ecs_executor_drive_summary_deep_empty() -> EcsExecutorDriveSummaryDeep {
    return EcsExecutorDriveSummaryDeep {
        selected_count: 0,
        selected0: -1,
        selected1: -1,
        selected2: -1,
        skipped_count: 0,
        apply_count: 0,
        completed_count: 0,
        ready_count: 0,
        unapplied_count: 0,
        stalled: 0,
        lock_failed: 0,
        pending_count: 0,
        pending0: -1,
        pending1: -1,
        pending2: -1,
    };
}

fn ecs_executor_drive_summary_deep_selected_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.selected_count; }
fn ecs_executor_drive_summary_deep_selected_at(r: EcsExecutorDriveSummaryDeep, index: i64) -> i64 {
    if index == 0 && r.selected_count > 0 { return r.selected0; };
    if index == 1 && r.selected_count > 1 { return r.selected1; };
    if index == 2 && r.selected_count > 2 { return r.selected2; };
    return -1;
}
fn ecs_executor_drive_summary_deep_skipped_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.skipped_count; }
fn ecs_executor_drive_summary_deep_apply_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.apply_count; }
fn ecs_executor_drive_summary_deep_completed_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.completed_count; }
fn ecs_executor_drive_summary_deep_ready_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.ready_count; }
fn ecs_executor_drive_summary_deep_unapplied_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.unapplied_count; }
fn ecs_executor_drive_summary_deep_stalled(r: EcsExecutorDriveSummaryDeep) -> bool { return r.stalled != 0; }
fn ecs_executor_drive_summary_deep_lock_failed(r: EcsExecutorDriveSummaryDeep) -> bool { return r.lock_failed != 0; }
fn ecs_executor_drive_summary_deep_pending_count(r: EcsExecutorDriveSummaryDeep) -> i64 { return r.pending_count; }
fn ecs_executor_drive_summary_deep_pending_at(r: EcsExecutorDriveSummaryDeep, index: i64) -> i64 {
    if index == 0 && r.pending_count > 0 { return r.pending0; };
    if index == 1 && r.pending_count > 1 { return r.pending1; };
    if index == 2 && r.pending_count > 2 { return r.pending2; };
    return -1;
}

