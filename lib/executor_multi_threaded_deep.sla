    r.completed_after = ecs_executor_state_deep_completed_count(s);
    r.unapplied_after = ecs_executor_state_deep_unapplied_count(s);
    r.local_thread_running = _mt_bool(ecs_executor_state_deep_local_running(s));
    r.exclusive_running = _mt_bool(ecs_executor_state_deep_exclusive_running(s));
    return r;
}

fn _mt_complete_ready_batch_push_started(r: EcsExecutorCompleteReadyBatchSummaryDeep, system_index: i64) -> EcsExecutorCompleteReadyBatchSummaryDeep {
    if r.started_count == 0 { r.started0 = system_index; r.started_count = 1; return r; };
    if r.started_count == 1 { r.started1 = system_index; r.started_count = 2; return r; };
    if r.started_count == 2 { r.started2 = system_index; r.started_count = 3; return r; };
    return r;
}

fn _mt_complete_ready_batch_push_completed(r: EcsExecutorCompleteReadyBatchSummaryDeep, system_index: i64) -> EcsExecutorCompleteReadyBatchSummaryDeep {
    if r.completed_count == 0 { r.completed0 = system_index; r.completed_count = 1; return r; };
    if r.completed_count == 1 { r.completed1 = system_index; r.completed_count = 2; return r; };
    if r.completed_count == 2 { r.completed2 = system_index; r.completed_count = 3; return r; };
