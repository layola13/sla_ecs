    r.skipped_after = ecs_executor_state_deep_skipped_count(s);
    r.deps0 = ecs_executor_state_deep_get_dependencies(s, 0);
    r.deps1 = ecs_executor_state_deep_get_dependencies(s, 1);
    r.deps2 = ecs_executor_state_deep_get_dependencies(s, 2);
    r.ready0 = _mt_bool(ecs_executor_state_deep_is_ready(s, 0));
    r.ready1 = _mt_bool(ecs_executor_state_deep_is_ready(s, 1));
