    if r.skipped_count == 2 { r.skipped2 = system_index; r.skipped_count = 3; return r; };
    return r;
}

fn _mt_drive_ready_batch_integration_push_apply(r: EcsExecutorDriveReadyBatchIntegrationSummaryDeep, system_index: i64) -> EcsExecutorDriveReadyBatchIntegrationSummaryDeep {
    if r.apply_count == 0 { r.apply0 = system_index; r.apply_count = 1; return r; };
    if r.apply_count == 1 { r.apply1 = system_index; r.apply_count = 2; return r; };
    if r.apply_count == 2 { r.apply2 = system_index; r.apply_count = 3; return r; };
    return r;
}

fn _mt_drive_ready_batch_integration_apply_unapplied(r: EcsExecutorDriveReadyBatchIntegrationSummaryDeep, s: EcsExecutorStateDeep) -> EcsExecutorDriveReadyBatchIntegrationSummaryDeep {
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_unapplied_at(s, i) { r = _mt_drive_ready_batch_integration_push_apply(r, i); };
        i = i + 1;
    }
    return r;
}

fn _mt_drive_ready_batch_integration_selected_at(r: EcsExecutorDriveReadyBatchIntegrationSummaryDeep, position: i64) -> i64 {
    if position == 0 { return r.run0; };
    if position == 1 { return r.run1; };
    if position == 2 { return r.run2; };
    return -1;
}

fn _mt_drive_ready_batch_integration_can_select(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep, batch_local: i32, batch_exclusive: i32, batch_run_count: i64) -> bool {
    let idx = spec.system_index;
    if idx < 0 || idx >= s.system_count { return false; };
    if _mt_ready_at(s, idx) != true { return false; };
    if _mt_completed_at(s, idx) { return false; };
    if _mt_running_at(s, idx) { return false; };
    if s.exclusive_running != 0 { return false; };
    if batch_exclusive != 0 { return false; };
    if spec.is_exclusive != 0 && (s.num_running_systems + batch_run_count) > 0 { return false; };
    if spec.is_local != 0 && (s.local_thread_running != 0 || batch_local != 0) { return false; };
    if ecs_executor_state_deep_conflicts_with_running(s, spec) { return false; };
    return true;
}

fn ecs_executor_drive_ready_batch_integration_summary_deep3(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64, max_width: i64) -> EcsExecutorDriveReadyBatchIntegrationSummaryDeep {
    let r = ecs_executor_drive_ready_batch_integration_summary_deep_empty();
    let batch_local: i32 = 0;
    let batch_exclusive: i32 = 0;
    if max_width <= 0 {
        if ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
        return _mt_drive_ready_batch_integration_from_state(r, s);
    };
    if r.run_count < max_width && batch_exclusive == 0 && s.system_count > 0 {
        let spec0 = _mt_spec3_by_system_index(a, b, c, 0);
        if _mt_drive_ready_batch_integration_can_select(s, spec0, batch_local, batch_exclusive, r.run_count) {
            if spec0.should_run == 0 || _mt_skipped_at(s, 0) {
                if r.skipped_count == 0 { r.skipped0 = 0; };
                if r.skipped_count == 1 { r.skipped1 = 0; };
                if r.skipped_count == 2 { r.skipped2 = 0; };
                r.skipped_count = r.skipped_count + 1;
                s = _mt_skip_with_history_deps3(s, spec0, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
            } else {
                if r.run_count == 0 { r.run0 = 0; };
                if r.run_count == 1 { r.run1 = 0; };
                if r.run_count == 2 { r.run2 = 0; };
                r.run_count = r.run_count + 1;
                if spec0.is_local != 0 { batch_local = 1; };
                if spec0.is_exclusive != 0 { batch_exclusive = 1; batch_local = 1; };
            };
        };
    };
    if r.run_count < max_width && batch_exclusive == 0 && s.system_count > 1 {
        let spec1 = _mt_spec3_by_system_index(a, b, c, 1);
        if _mt_drive_ready_batch_integration_can_select(s, spec1, batch_local, batch_exclusive, r.run_count) {
            if spec1.should_run == 0 || _mt_skipped_at(s, 1) {
                if r.skipped_count == 0 { r.skipped0 = 1; };
                if r.skipped_count == 1 { r.skipped1 = 1; };
                if r.skipped_count == 2 { r.skipped2 = 1; };
                r.skipped_count = r.skipped_count + 1;
                s = _mt_skip_with_history_deps3(s, spec1, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
            } else {
                if spec1.is_exclusive == 0 || r.run_count == 0 {
                    if spec1.is_local == 0 || batch_local == 0 {
                        if r.run_count == 0 { r.run0 = 1; };
                        if r.run_count == 1 { r.run1 = 1; };
                        if r.run_count == 2 { r.run2 = 1; };
                        r.run_count = r.run_count + 1;
                        if spec1.is_local != 0 { batch_local = 1; };
                        if spec1.is_exclusive != 0 { batch_exclusive = 1; batch_local = 1; };
                    };
                };
            };
        };
    };
    if r.run_count < max_width && batch_exclusive == 0 && s.system_count > 2 {
        let spec2 = _mt_spec3_by_system_index(a, b, c, 2);
        if _mt_drive_ready_batch_integration_can_select(s, spec2, batch_local, batch_exclusive, r.run_count) {
            if spec2.should_run == 0 || _mt_skipped_at(s, 2) {
                if r.skipped_count == 0 { r.skipped0 = 2; };
                if r.skipped_count == 1 { r.skipped1 = 2; };
                if r.skipped_count == 2 { r.skipped2 = 2; };
                r.skipped_count = r.skipped_count + 1;
                s = _mt_skip_with_history_deps3(s, spec2, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
            } else {
                if spec2.is_exclusive == 0 || r.run_count == 0 {
                    if spec2.is_local == 0 || batch_local == 0 {
                        if r.run_count == 0 { r.run0 = 2; };
                        if r.run_count == 1 { r.run1 = 2; };
                        if r.run_count == 2 { r.run2 = 2; };
                        r.run_count = r.run_count + 1;
                        if spec2.is_local != 0 { batch_local = 1; };
                        if spec2.is_exclusive != 0 { batch_exclusive = 1; batch_local = 1; };
                    };
                };
            };
        };
    };
    let start_pos: i64 = 0;
    while start_pos < r.run_count && start_pos < 3 {
        let start_index = _mt_drive_ready_batch_integration_selected_at(r, start_pos);
        let start_spec = _mt_spec3_by_system_index(a, b, c, start_index);
        if _mt_running_at(s, start_index) != true {
            s = ecs_executor_state_deep_start_system(s, start_spec);
        };
        start_pos = start_pos + 1;
    }
    let pos: i64 = 0;
    while pos < r.run_count && pos < 3 {
        let system_index = _mt_drive_ready_batch_integration_selected_at(r, pos);
