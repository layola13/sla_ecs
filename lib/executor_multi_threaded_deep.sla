fn ecs_executor_complete_ready_batch_summary_deep3(s: EcsExecutorStateDeep, selected0: i64, selected1: i64, selected2: i64, selected_count: i64, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64) -> EcsExecutorCompleteReadyBatchSummaryDeep {
    let r = ecs_executor_complete_ready_batch_summary_deep_empty();
    if selected_count > 0 && selected0 >= 0 && selected0 < s.system_count {
        let spec0 = _mt_spec3_by_system_index(a, b, c, selected0);
        if _mt_running_at(s, selected0) != true {
            s = ecs_executor_state_deep_start_system(s, spec0);
            r.started0 = selected0;
            r.started_count = 1;
        };
    };
    if selected_count > 1 && selected1 >= 0 && selected1 < s.system_count {
        let spec1 = _mt_spec3_by_system_index(a, b, c, selected1);
        if _mt_running_at(s, selected1) != true {
            s = ecs_executor_state_deep_start_system(s, spec1);
            if r.started_count == 0 { r.started0 = selected1; };
            if r.started_count == 1 { r.started1 = selected1; };
            r.started_count = r.started_count + 1;
        };
    };
    if selected_count > 2 && selected2 >= 0 && selected2 < s.system_count {
        let spec2 = _mt_spec3_by_system_index(a, b, c, selected2);
        if _mt_running_at(s, selected2) != true {
