    r.unapplied_after = ecs_executor_state_deep_unapplied_count(s);
    return r;
}

fn _mt_completed_tick_error_from_batch(r: EcsExecutorCompletedTickErrorSummaryDeep, b: EcsExecutorReadyBatchRescanSummaryDeep, s: EcsExecutorStateDeep) -> EcsExecutorCompletedTickErrorSummaryDeep {
    r.tick_count = 1;
    r.selected_count = b.selected_count;
    r.selected0 = b.selected0;
    r.selected1 = b.selected1;
    r.selected2 = b.selected2;
    r.skipped_count = b.skipped_count;
    r.skipped0 = b.skipped0;
    r.skipped1 = b.skipped1;
    r.skipped2 = b.skipped2;
    r.ready_after = b.ready_after;
    r.running_after = b.running_after;
    r.completed_after = b.completed_after;
    r.unapplied_after = ecs_executor_state_deep_unapplied_count(s);
    r.stalled = b.stalled;
    return r;
}

fn _mt_completed_tick_error_record_system_panic(r: EcsExecutorCompletedTickErrorSummaryDeep, system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    r.panic_payload_pending = 1;
    r.system_panic_payloads = r.system_panic_payloads + 1;
    r.panic_payload_phase = ecs_executor_panic_phase_deep_system();
    r.panic_payload_system = system_index;
    return r;
}

fn _mt_completed_tick_error_record_deferred_panic(r: EcsExecutorCompletedTickErrorSummaryDeep, system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    r.panic_payload_pending = 1;
    r.deferred_panic_payloads = r.deferred_panic_payloads + 1;
    r.panic_payload_phase = ecs_executor_panic_phase_deep_apply_deferred();
    r.panic_payload_system = system_index;
    return r;
}

fn _mt_completed_tick_error_record_system_handled(r: EcsExecutorCompletedTickErrorSummaryDeep, system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    r.system_handled_errors = r.system_handled_errors + 1;
    r.handled_error_phase = ecs_executor_panic_phase_deep_system();
    r.handled_error_system = system_index;
    return r;
}

fn _mt_completed_tick_error_record_deferred_handled(r: EcsExecutorCompletedTickErrorSummaryDeep, system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    r.deferred_handled_errors = r.deferred_handled_errors + 1;
    r.handled_error_phase = ecs_executor_panic_phase_deep_apply_deferred();
    r.handled_error_system = system_index;
    return r;
}

fn _mt_completed_tick_error_pending(r: EcsExecutorCompletedTickErrorSummaryDeep, s: EcsExecutorStateDeep, system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    r.lock_failed = 1;
    r.pending_count = 1;
    r.pending0 = system_index;
    return _mt_completed_tick_error_from_state(r, s);
}

fn _mt_completed_tick_error_apply_deferred_panic(r: EcsExecutorCompletedTickErrorSummaryDeep, s: EcsExecutorStateDeep, fail_system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    let failed: i32 = 0;
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_unapplied_at(s, i) {
            if failed == 0 {
                r.apply_count = r.apply_count + 1;
                if i == fail_system_index {
                    r = _mt_completed_tick_error_record_deferred_panic(r, i);
                    failed = 1;
                };
            };
        };
        i = i + 1;
    }
    return r;
}

fn _mt_completed_tick_error_apply_deferred_handled(r: EcsExecutorCompletedTickErrorSummaryDeep, s: EcsExecutorStateDeep, handled_system_index: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_unapplied_at(s, i) {
            r.apply_count = r.apply_count + 1;
            if i == handled_system_index {
                r = _mt_completed_tick_error_record_deferred_handled(r, i);
            };
        };
        i = i + 1;
    }
    return r;
}

fn _mt_completed_tick_error_apply_deferred_clear(s: EcsExecutorStateDeep) -> EcsExecutorStateDeep {
    return ecs_executor_state_deep_apply_deferred_all(s);
}

