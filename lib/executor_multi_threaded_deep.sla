// Deep self-contained core of lib/executor_multi_threaded.sla.
// Batch 420 focuses on ExecutorState gates and ready-batch selection using cap-16
// scalar slots instead of Vec bitsets. Batch 421 extends the same flat model with
// skipped/evaluated state, deferred cleanup, dependent release, and tick handoff.

const ECS_MT_DEEP_CAP: i32 = 16;

@derive(copy)
struct EcsExecutorStateDeep {
    system_count: i64,
    set_count: i64,
    local_thread_running: i32,
    exclusive_running: i32,
    num_running_systems: i64,
    ready0: i32, ready1: i32, ready2: i32, ready3: i32,
    ready4: i32, ready5: i32, ready6: i32, ready7: i32,
    ready8: i32, ready9: i32, ready10: i32, ready11: i32,
    ready12: i32, ready13: i32, ready14: i32, ready15: i32,
    running0: i32, running1: i32, running2: i32, running3: i32,
    running4: i32, running5: i32, running6: i32, running7: i32,
    running8: i32, running9: i32, running10: i32, running11: i32,
    running12: i32, running13: i32, running14: i32, running15: i32,
    completed0: i32, completed1: i32, completed2: i32, completed3: i32,
    completed4: i32, completed5: i32, completed6: i32, completed7: i32,
    completed8: i32, completed9: i32, completed10: i32, completed11: i32,
    completed12: i32, completed13: i32, completed14: i32, completed15: i32,
    skipped0: i32, skipped1: i32, skipped2: i32, skipped3: i32,
    skipped4: i32, skipped5: i32, skipped6: i32, skipped7: i32,
    skipped8: i32, skipped9: i32, skipped10: i32, skipped11: i32,
    skipped12: i32, skipped13: i32, skipped14: i32, skipped15: i32,
    unapplied0: i32, unapplied1: i32, unapplied2: i32, unapplied3: i32,
    unapplied4: i32, unapplied5: i32, unapplied6: i32, unapplied7: i32,
    unapplied8: i32, unapplied9: i32, unapplied10: i32, unapplied11: i32,
    unapplied12: i32, unapplied13: i32, unapplied14: i32, unapplied15: i32,
    evaluated0: i32, evaluated1: i32, evaluated2: i32, evaluated3: i32,
    evaluated4: i32, evaluated5: i32, evaluated6: i32, evaluated7: i32,
    evaluated8: i32, evaluated9: i32, evaluated10: i32, evaluated11: i32,
    evaluated12: i32, evaluated13: i32, evaluated14: i32, evaluated15: i32,
    deps0: i64, deps1: i64, deps2: i64, deps3: i64,
    deps4: i64, deps5: i64, deps6: i64, deps7: i64,
    deps8: i64, deps9: i64, deps10: i64, deps11: i64,
    deps12: i64, deps13: i64, deps14: i64, deps15: i64,
}

@derive(copy)
struct EcsExecutorSystemSpecDeep {
    system_index: i64,
    is_exclusive: i32,
    is_local: i32,
    access_conflict0: i64,
    access_conflict1: i64,
    access_conflict_count: i64,
}

@derive(copy)
struct EcsExecutorReadyBatchDeep {
    count: i64,
    system0: i64,
    system1: i64,
    system2: i64,
    is_exclusive: i32,
    is_local: i32,
}

fn _mt_bool(v: bool) -> i32 {
    if v { return 1; };
    return 0;
}

fn ecs_executor_state_deep_new() -> EcsExecutorStateDeep {
    return EcsExecutorStateDeep {
        system_count: 0, set_count: 0, local_thread_running: 0, exclusive_running: 0, num_running_systems: 0,
        ready0: 0, ready1: 0, ready2: 0, ready3: 0, ready4: 0, ready5: 0, ready6: 0, ready7: 0,
        ready8: 0, ready9: 0, ready10: 0, ready11: 0, ready12: 0, ready13: 0, ready14: 0, ready15: 0,
        running0: 0, running1: 0, running2: 0, running3: 0, running4: 0, running5: 0, running6: 0, running7: 0,
        running8: 0, running9: 0, running10: 0, running11: 0, running12: 0, running13: 0, running14: 0, running15: 0,
        completed0: 0, completed1: 0, completed2: 0, completed3: 0, completed4: 0, completed5: 0, completed6: 0, completed7: 0,
        completed8: 0, completed9: 0, completed10: 0, completed11: 0, completed12: 0, completed13: 0, completed14: 0, completed15: 0,
        skipped0: 0, skipped1: 0, skipped2: 0, skipped3: 0, skipped4: 0, skipped5: 0, skipped6: 0, skipped7: 0,
        skipped8: 0, skipped9: 0, skipped10: 0, skipped11: 0, skipped12: 0, skipped13: 0, skipped14: 0, skipped15: 0,
        unapplied0: 0, unapplied1: 0, unapplied2: 0, unapplied3: 0, unapplied4: 0, unapplied5: 0, unapplied6: 0, unapplied7: 0,
        unapplied8: 0, unapplied9: 0, unapplied10: 0, unapplied11: 0, unapplied12: 0, unapplied13: 0, unapplied14: 0, unapplied15: 0,
        evaluated0: 0, evaluated1: 0, evaluated2: 0, evaluated3: 0, evaluated4: 0, evaluated5: 0, evaluated6: 0, evaluated7: 0,
        evaluated8: 0, evaluated9: 0, evaluated10: 0, evaluated11: 0, evaluated12: 0, evaluated13: 0, evaluated14: 0, evaluated15: 0,
        deps0: 0, deps1: 0, deps2: 0, deps3: 0, deps4: 0, deps5: 0, deps6: 0, deps7: 0,
        deps8: 0, deps9: 0, deps10: 0, deps11: 0, deps12: 0, deps13: 0, deps14: 0, deps15: 0,
    };
}

fn ecs_executor_state_deep_init(s: EcsExecutorStateDeep, system_count: i64, set_count: i64) -> EcsExecutorStateDeep {
    s = ecs_executor_state_deep_new();
    s.system_count = system_count;
    if s.system_count < 0 { s.system_count = 0; };
    if s.system_count > ECS_MT_DEEP_CAP as i64 { s.system_count = ECS_MT_DEEP_CAP as i64; };
    s.set_count = set_count;
    if s.set_count < 0 { s.set_count = 0; };
    if s.set_count > ECS_MT_DEEP_CAP as i64 { s.set_count = ECS_MT_DEEP_CAP as i64; };
    return s;
}

fn _mt_ready_at(s: EcsExecutorStateDeep, idx: i64) -> bool {
    if idx == 0 { return s.ready0 != 0; }; if idx == 1 { return s.ready1 != 0; };
    if idx == 2 { return s.ready2 != 0; }; if idx == 3 { return s.ready3 != 0; };
    if idx == 4 { return s.ready4 != 0; }; if idx == 5 { return s.ready5 != 0; };
    if idx == 6 { return s.ready6 != 0; }; if idx == 7 { return s.ready7 != 0; };
    if idx == 8 { return s.ready8 != 0; }; if idx == 9 { return s.ready9 != 0; };
    if idx == 10 { return s.ready10 != 0; }; if idx == 11 { return s.ready11 != 0; };
    if idx == 12 { return s.ready12 != 0; }; if idx == 13 { return s.ready13 != 0; };
    if idx == 14 { return s.ready14 != 0; }; if idx == 15 { return s.ready15 != 0; };
    return false;
}

fn _mt_ready_set(s: EcsExecutorStateDeep, idx: i64, v: bool) -> EcsExecutorStateDeep {
    let b = _mt_bool(v);
    if idx == 0 { s.ready0 = b; return s; }; if idx == 1 { s.ready1 = b; return s; };
    if idx == 2 { s.ready2 = b; return s; }; if idx == 3 { s.ready3 = b; return s; };
    if idx == 4 { s.ready4 = b; return s; }; if idx == 5 { s.ready5 = b; return s; };
    if idx == 6 { s.ready6 = b; return s; }; if idx == 7 { s.ready7 = b; return s; };
    if idx == 8 { s.ready8 = b; return s; }; if idx == 9 { s.ready9 = b; return s; };
    if idx == 10 { s.ready10 = b; return s; }; if idx == 11 { s.ready11 = b; return s; };
    if idx == 12 { s.ready12 = b; return s; }; if idx == 13 { s.ready13 = b; return s; };
    if idx == 14 { s.ready14 = b; return s; }; if idx == 15 { s.ready15 = b; return s; };
    return s;
}

