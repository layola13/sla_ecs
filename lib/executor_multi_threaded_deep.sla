fn ecs_executor_run_history_deep_record_batch3(h: EcsExecutorRunHistoryDeep, b: EcsExecutorReadyBatchDeep) -> EcsExecutorRunHistoryDeep {
    if b.count > 0 { h = ecs_executor_run_history_deep_push_run(h, b.system0); };
    if b.count > 1 { h = ecs_executor_run_history_deep_push_run(h, b.system1); };
    if b.count > 2 { h = ecs_executor_run_history_deep_push_run(h, b.system2); };
    return h;
}

fn ecs_executor_run_history_deep_drive_one(h: EcsExecutorRunHistoryDeep, s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep) -> EcsExecutorRunHistoryDeep {
    if ecs_executor_state_deep_can_spawn_system(s, spec) != true {
        if ecs_executor_state_deep_completed_count(s) < s.system_count { h.stalled = 1; };
        return h;
    };
    if spec.should_run == 0 || _mt_skipped_at(s, spec.system_index) {
        return ecs_executor_run_history_deep_push_skipped(h, spec.system_index);
    };
    h = ecs_executor_run_history_deep_push_run(h, spec.system_index);
    if spec.is_apply_deferred != 0 { h = ecs_executor_run_history_deep_apply_unapplied(h, s); };
    return h;
}

fn _mt_spec3_by_system_index(a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, system_index: i64) -> EcsExecutorSystemSpecDeep {
    if a.system_index == system_index { return a; };
    if b.system_index == system_index { return b; };
    if c.system_index == system_index { return c; };
    return ecs_executor_system_spec_deep_new(system_index, false, false);
}

fn ecs_executor_state_deep_next_runnable_by_index3(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep) -> i64 {
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_ready_at(s, i) && _mt_completed_at(s, i) != true && _mt_running_at(s, i) != true {
            let spec = _mt_spec3_by_system_index(a, b, c, i);
            if ecs_executor_state_deep_can_spawn_system(s, spec) { return i; };
        };
        i = i + 1;
    }
    return -1;
}

fn _mt_complete_with_history_deps3(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64) -> EcsExecutorStateDeep {
    if spec.system_index == a.system_index {
