fn _mt_tick_with_completions_no_drain_fast(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, max_width: i64) -> EcsExecutorTickWithCompletionsSummaryDeep {
    let r = ecs_executor_tick_with_completions_summary_deep_empty();
    if max_width <= 0 {
        if ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
        return _mt_tick_with_completions_summary_from_state(r, s);
    };
    let batch = ecs_executor_state_deep_take_ready_batch3(s, a, b, c);
    let selected_count = batch.count;
    if selected_count > 0 && max_width > 0 {
        r.selected0 = ecs_executor_ready_batch_deep_at(batch, 0);
        r.selected_count = 1;
    };
    if selected_count > 1 && max_width > 1 {
        r.selected1 = ecs_executor_ready_batch_deep_at(batch, 1);
        r.selected_count = 2;
    };
    if selected_count > 2 && max_width > 2 {
        r.selected2 = ecs_executor_ready_batch_deep_at(batch, 2);
        r.selected_count = 3;
    };
    r.ready_after = ecs_executor_state_deep_ready_count(s) - r.selected_count;
    if r.ready_after < 0 { r.ready_after = 0; };
    r.running_after = ecs_executor_state_deep_running_count(s) + r.selected_count;
    r.completed_after = ecs_executor_state_deep_completed_count(s);
    r.unapplied_after = ecs_executor_state_deep_unapplied_count(s);
    r.deps0 = ecs_executor_state_deep_get_dependencies(s, 0);
    r.deps1 = ecs_executor_state_deep_get_dependencies(s, 1);
    r.deps2 = ecs_executor_state_deep_get_dependencies(s, 2);
    r.ready0 = _mt_bool(ecs_executor_state_deep_is_ready(s, 0));
    r.ready1 = _mt_bool(ecs_executor_state_deep_is_ready(s, 1));
    r.ready2 = _mt_bool(ecs_executor_state_deep_is_ready(s, 2));
    if r.selected_count > 0 {
        if r.selected0 == 0 { r.ready0 = 0; };
        if r.selected0 == 1 { r.ready1 = 0; };
        if r.selected0 == 2 { r.ready2 = 0; };
        let spec0 = _mt_spec3_by_system_index(a, b, c, r.selected0);
        if spec0.is_local != 0 { r.local_thread_running = 1; };
        if spec0.is_exclusive != 0 { r.exclusive_running = 1; r.local_thread_running = 1; };
    };
    if r.selected_count > 1 {
        if r.selected1 == 0 { r.ready0 = 0; };
        if r.selected1 == 1 { r.ready1 = 0; };
        if r.selected1 == 2 { r.ready2 = 0; };
        let spec1 = _mt_spec3_by_system_index(a, b, c, r.selected1);
        if spec1.is_local != 0 { r.local_thread_running = 1; };
        if spec1.is_exclusive != 0 { r.exclusive_running = 1; r.local_thread_running = 1; };
    };
    if r.selected_count > 2 {
        if r.selected2 == 0 { r.ready0 = 0; };
        if r.selected2 == 1 { r.ready1 = 0; };
        if r.selected2 == 2 { r.ready2 = 0; };
        let spec2 = _mt_spec3_by_system_index(a, b, c, r.selected2);
        if spec2.is_local != 0 { r.local_thread_running = 1; };
        if spec2.is_exclusive != 0 { r.exclusive_running = 1; r.local_thread_running = 1; };
    };
    if r.selected_count == 0 && ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
    return r;
}

