    r.running_count = ecs_executor_state_deep_running_count(s);
    r.completed_count = ecs_executor_state_deep_completed_count(s);
    r.skipped_count = ecs_executor_state_deep_skipped_count(s);
    r.evaluated_count = ecs_executor_state_deep_evaluated_set_count(s);
    r.unapplied_count = ecs_executor_state_deep_unapplied_count(s);
    r.local_thread_running = _mt_bool(ecs_executor_state_deep_local_running(s));
    r.exclusive_running = _mt_bool(ecs_executor_state_deep_exclusive_running(s));
    return r;
}

fn ecs_executor_begin_run_summary_deep3(s: EcsExecutorStateDeep, start0: bool, start1: bool, start2: bool, dep0: i64, dep1: i64, dep2: i64) -> EcsExecutorBeginRunSummaryDeep {
    let r = ecs_executor_begin_run_summary_deep_empty();
    let i: i64 = 0;
    while i < s.system_count {
        s = _mt_ready_set(s, i, false);
        s = _mt_running_set(s, i, false);
        s = _mt_skipped_set(s, i, false);
        s = _mt_completed_set(s, i, false);
        i = i + 1;
    }
    let j: i64 = 0;
    while j < s.set_count {
        s = _mt_evaluated_set(s, j, false);
        j = j + 1;
    }
    s.num_running_systems = 0;
    s.local_thread_running = 0;
    s.exclusive_running = 0;
    if s.system_count > 0 { s = _mt_ready_set(s, 0, start0); s = _mt_deps_set(s, 0, dep0); };
    if s.system_count > 1 { s = _mt_ready_set(s, 1, start1); s = _mt_deps_set(s, 1, dep1); };
    if s.system_count > 2 { s = _mt_ready_set(s, 2, start2); s = _mt_deps_set(s, 2, dep2); };
    return _mt_begin_run_summary_from_state(r, s);
}

