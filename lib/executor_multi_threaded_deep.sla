fn _mt_deps_at(s: EcsExecutorStateDeep, idx: i64) -> i64 {
    if idx == 0 { return s.deps0; }; if idx == 1 { return s.deps1; };
    if idx == 2 { return s.deps2; }; if idx == 3 { return s.deps3; };
    if idx == 4 { return s.deps4; }; if idx == 5 { return s.deps5; };
    if idx == 6 { return s.deps6; }; if idx == 7 { return s.deps7; };
    if idx == 8 { return s.deps8; }; if idx == 9 { return s.deps9; };
    if idx == 10 { return s.deps10; }; if idx == 11 { return s.deps11; };
    if idx == 12 { return s.deps12; }; if idx == 13 { return s.deps13; };
    if idx == 14 { return s.deps14; }; if idx == 15 { return s.deps15; };
    return 0;
}

fn _mt_deps_set(s: EcsExecutorStateDeep, idx: i64, v: i64) -> EcsExecutorStateDeep {
    let d = v;
    if d < 0 { d = 0; };
    if idx == 0 { s.deps0 = d; return s; }; if idx == 1 { s.deps1 = d; return s; };
    if idx == 2 { s.deps2 = d; return s; }; if idx == 3 { s.deps3 = d; return s; };
    if idx == 4 { s.deps4 = d; return s; }; if idx == 5 { s.deps5 = d; return s; };
    if idx == 6 { s.deps6 = d; return s; }; if idx == 7 { s.deps7 = d; return s; };
    if idx == 8 { s.deps8 = d; return s; }; if idx == 9 { s.deps9 = d; return s; };
    if idx == 10 { s.deps10 = d; return s; }; if idx == 11 { s.deps11 = d; return s; };
    if idx == 12 { s.deps12 = d; return s; }; if idx == 13 { s.deps13 = d; return s; };
    if idx == 14 { s.deps14 = d; return s; }; if idx == 15 { s.deps15 = d; return s; };
    return s;
}

fn ecs_executor_state_deep_set_dependencies(s: EcsExecutorStateDeep, system_index: i64, count: i64) -> EcsExecutorStateDeep {
    if system_index >= 0 && system_index < s.system_count { return _mt_deps_set(s, system_index, count); };
    return s;
}

fn ecs_executor_state_deep_get_dependencies(s: EcsExecutorStateDeep, system_index: i64) -> i64 {
    if system_index < 0 || system_index >= s.system_count { return 0; };
    return _mt_deps_at(s, system_index);
}

fn ecs_executor_state_deep_mark_ready(s: EcsExecutorStateDeep, system_index: i64) -> EcsExecutorStateDeep {
    if system_index >= 0 && system_index < s.system_count && _mt_deps_at(s, system_index) == 0 && _mt_completed_at(s, system_index) != true {
        return _mt_ready_set(s, system_index, true);
    };
    return s;
}

fn ecs_executor_state_deep_is_ready(s: EcsExecutorStateDeep, system_index: i64) -> bool {
    if system_index < 0 || system_index >= s.system_count { return false; };
    return _mt_ready_at(s, system_index);
}

fn ecs_executor_state_deep_start_system(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep) -> EcsExecutorStateDeep {
    let idx = spec.system_index;
    if idx < 0 || idx >= s.system_count { return s; };
    if _mt_running_at(s, idx) { return s; };
    s = _mt_ready_set(s, idx, false);
    s = _mt_running_set(s, idx, true);
    s.num_running_systems = s.num_running_systems + 1;
    if spec.is_local != 0 { s.local_thread_running = 1; };
    if spec.is_exclusive != 0 { s.exclusive_running = 1; s.local_thread_running = 1; };
    return s;
}

fn ecs_executor_state_deep_complete_system(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep, has_deferred: bool) -> EcsExecutorStateDeep {
    let idx = spec.system_index;
    if idx < 0 || idx >= s.system_count { return s; };
    if _mt_running_at(s, idx) {
        s = _mt_running_set(s, idx, false);
        if s.num_running_systems > 0 { s.num_running_systems = s.num_running_systems - 1; };
    };
    s = _mt_completed_set(s, idx, true);
    if has_deferred { s = _mt_unapplied_set(s, idx, true); };
    if spec.is_exclusive != 0 { s.exclusive_running = 0; s.local_thread_running = 0; };
    if spec.is_local != 0 && spec.is_exclusive == 0 { s.local_thread_running = 0; };
    return s;
}

fn ecs_executor_state_deep_release_dependent(s: EcsExecutorStateDeep, dep_idx: i64) -> EcsExecutorStateDeep {
    if dep_idx >= 0 && dep_idx < s.system_count {
        let deps = _mt_deps_at(s, dep_idx);
        if deps > 0 { s = _mt_deps_set(s, dep_idx, deps - 1); };
        if _mt_deps_at(s, dep_idx) == 0 && _mt_completed_at(s, dep_idx) != true && _mt_skipped_at(s, dep_idx) != true {
            s = _mt_ready_set(s, dep_idx, true);
        };
    };
    return s;
}

fn ecs_executor_state_deep_release_dependents3(s: EcsExecutorStateDeep, dep0: i64, dep1: i64, dep2: i64, count: i64) -> EcsExecutorStateDeep {
    if count > 0 { s = ecs_executor_state_deep_release_dependent(s, dep0); };
    if count > 1 { s = ecs_executor_state_deep_release_dependent(s, dep1); };
    if count > 2 { s = ecs_executor_state_deep_release_dependent(s, dep2); };
    return s;
}

fn ecs_executor_state_deep_complete_system_with_dependents3(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep, has_deferred: bool, dep0: i64, dep1: i64, dep2: i64, dep_count: i64) -> EcsExecutorStateDeep {
    s = ecs_executor_state_deep_complete_system(s, spec, has_deferred);
    return ecs_executor_state_deep_release_dependents3(s, dep0, dep1, dep2, dep_count);
}

fn ecs_executor_state_deep_skip_system(s: EcsExecutorStateDeep, system_index: i64) -> EcsExecutorStateDeep {
    if system_index >= 0 && system_index < s.system_count {
        s = _mt_skipped_set(s, system_index, true);
        s = _mt_completed_set(s, system_index, true);
        s = _mt_ready_set(s, system_index, false);
    };
    return s;
}

fn ecs_executor_state_deep_mark_skipped_pending(s: EcsExecutorStateDeep, system_index: i64) -> EcsExecutorStateDeep {
    if system_index >= 0 && system_index < s.system_count && _mt_completed_at(s, system_index) != true {
        s = _mt_skipped_set(s, system_index, true);
    };
    return s;
}

fn ecs_executor_state_deep_skip_system_with_dependents3(s: EcsExecutorStateDeep, system_index: i64, dep0: i64, dep1: i64, dep2: i64, dep_count: i64) -> EcsExecutorStateDeep {
    s = ecs_executor_state_deep_skip_system(s, system_index);
    return ecs_executor_state_deep_release_dependents3(s, dep0, dep1, dep2, dep_count);
}

fn ecs_executor_state_deep_mark_set_evaluated(s: EcsExecutorStateDeep, set_index: i64) -> EcsExecutorStateDeep {
    if set_index >= 0 && set_index < s.set_count { return _mt_evaluated_set(s, set_index, true); };
    return s;
}

fn ecs_executor_state_deep_is_set_evaluated(s: EcsExecutorStateDeep, set_index: i64) -> bool {
    if set_index < 0 || set_index >= s.set_count { return false; };
    return _mt_evaluated_at(s, set_index);
}

fn ecs_executor_state_deep_apply_deferred_system(s: EcsExecutorStateDeep, system_index: i64) -> EcsExecutorStateDeep {
    if system_index >= 0 && system_index < s.system_count { return _mt_unapplied_set(s, system_index, false); };
    return s;
}

fn ecs_executor_state_deep_apply_deferred_all(s: EcsExecutorStateDeep) -> EcsExecutorStateDeep {
    let i: i64 = 0;
    while i < s.system_count {
        s = _mt_unapplied_set(s, i, false);
        i = i + 1;
    }
    return s;
}

fn ecs_executor_state_deep_finish_run(s: EcsExecutorStateDeep, apply_final_deferred: bool) -> EcsExecutorStateDeep {
    let i: i64 = 0;
    while i < s.system_count {
        s = _mt_ready_set(s, i, false);
        s = _mt_running_set(s, i, false);
        s = _mt_skipped_set(s, i, false);
        s = _mt_completed_set(s, i, false);
        if apply_final_deferred { s = _mt_unapplied_set(s, i, false); };
        i = i + 1;
    }
    let j: i64 = 0;
    while j < s.set_count {
        s = _mt_evaluated_set(s, j, false);
        j = j + 1;
    }
    s.num_running_systems = 0;
    s.local_thread_running = 0;
    s.exclusive_running = 0;
    return s;
}

fn ecs_executor_state_deep_tick_after_completion3(s: EcsExecutorStateDeep, completed_spec: EcsExecutorSystemSpecDeep, has_deferred: bool, dep0: i64, dep1: i64, dep2: i64, dep_count: i64, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep) -> EcsExecutorReadyBatchDeep {
    s = ecs_executor_state_deep_complete_system_with_dependents3(s, completed_spec, has_deferred, dep0, dep1, dep2, dep_count);
    return ecs_executor_state_deep_take_ready_batch3(s, a, b, c);
}

fn ecs_executor_system_spec_deep_new(system_index: i64, is_exclusive: bool, is_local: bool) -> EcsExecutorSystemSpecDeep {
    return EcsExecutorSystemSpecDeep {
        system_index: system_index,
        is_exclusive: _mt_bool(is_exclusive),
        is_local: _mt_bool(is_local),
        access_conflict0: -1,
        access_conflict1: -1,
        access_conflict_count: 0,
    };
}

fn ecs_executor_system_spec_deep_with_conflict(spec: EcsExecutorSystemSpecDeep, other: i64) -> EcsExecutorSystemSpecDeep {
    if spec.access_conflict_count == 0 { spec.access_conflict0 = other; spec.access_conflict_count = 1; return spec; };
    if spec.access_conflict_count == 1 { spec.access_conflict1 = other; spec.access_conflict_count = 2; return spec; };
    return spec;
}

fn ecs_executor_state_deep_conflicts_with_running(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep) -> bool {
    if spec.access_conflict_count > 0 && _mt_running_at(s, spec.access_conflict0) { return true; };
    if spec.access_conflict_count > 1 && _mt_running_at(s, spec.access_conflict1) { return true; };
    return false;
}

fn ecs_executor_state_deep_can_spawn_system(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep) -> bool {
    if spec.system_index < 0 || spec.system_index >= s.system_count { return false; };
    if _mt_completed_at(s, spec.system_index) { return false; };
    if _mt_ready_at(s, spec.system_index) != true { return false; };
    if s.exclusive_running != 0 { return false; };
    if spec.is_exclusive != 0 && s.num_running_systems > 0 { return false; };
    if spec.is_local != 0 && s.local_thread_running != 0 { return false; };
    if ecs_executor_state_deep_conflicts_with_running(s, spec) { return false; };
    return true;
}

fn ecs_executor_ready_batch_deep_empty() -> EcsExecutorReadyBatchDeep {
    return EcsExecutorReadyBatchDeep { count: 0, system0: -1, system1: -1, system2: -1, is_exclusive: 0, is_local: 0 };
}

fn ecs_executor_ready_batch_deep_at(b: EcsExecutorReadyBatchDeep, index: i64) -> i64 {
    if index == 0 { return b.system0; };
    if index == 1 { return b.system1; };
    if index == 2 { return b.system2; };
    return -1;
}

fn ecs_executor_state_deep_take_ready_batch3(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep) -> EcsExecutorReadyBatchDeep {
    let batch = ecs_executor_ready_batch_deep_empty();
    if ecs_executor_state_deep_can_spawn_system(s, a) {
        batch.system0 = a.system_index; batch.count = 1; batch.is_exclusive = a.is_exclusive; batch.is_local = a.is_local;
        s = ecs_executor_state_deep_start_system(s, a);
    };
    if batch.is_exclusive == 0 && ecs_executor_state_deep_can_spawn_system(s, b) {
        if batch.count == 0 { batch.system0 = b.system_index; } else { batch.system1 = b.system_index; };
        batch.count = batch.count + 1;
        if b.is_local != 0 { batch.is_local = 1; };
        s = ecs_executor_state_deep_start_system(s, b);
    };
    if batch.is_exclusive == 0 && batch.count < 3 && ecs_executor_state_deep_can_spawn_system(s, c) {
        if batch.count == 0 { batch.system0 = c.system_index; };
        if batch.count == 1 { batch.system1 = c.system_index; };
        if batch.count == 2 { batch.system2 = c.system_index; };
        batch.count = batch.count + 1;
        if c.is_local != 0 { batch.is_local = 1; };
    };
    return batch;
}

fn ecs_executor_state_deep_running_count(s: EcsExecutorStateDeep) -> i64 { return s.num_running_systems; }
fn ecs_executor_state_deep_local_running(s: EcsExecutorStateDeep) -> bool { return s.local_thread_running != 0; }
fn ecs_executor_state_deep_exclusive_running(s: EcsExecutorStateDeep) -> bool { return s.exclusive_running != 0; }
fn ecs_executor_state_deep_is_running(s: EcsExecutorStateDeep, system_index: i64) -> bool { return _mt_running_at(s, system_index); }
fn ecs_executor_state_deep_is_completed(s: EcsExecutorStateDeep, system_index: i64) -> bool { return _mt_completed_at(s, system_index); }
fn ecs_executor_state_deep_is_skipped(s: EcsExecutorStateDeep, system_index: i64) -> bool { return _mt_skipped_at(s, system_index); }
fn ecs_executor_state_deep_is_unapplied(s: EcsExecutorStateDeep, system_index: i64) -> bool { return _mt_unapplied_at(s, system_index); }

fn ecs_executor_state_deep_ready_count(s: EcsExecutorStateDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_ready_at(s, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn ecs_executor_state_deep_completed_count(s: EcsExecutorStateDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_completed_at(s, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn ecs_executor_state_deep_unapplied_count(s: EcsExecutorStateDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_unapplied_at(s, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn ecs_executor_state_deep_skipped_count(s: EcsExecutorStateDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_skipped_at(s, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn ecs_executor_state_deep_evaluated_set_count(s: EcsExecutorStateDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < s.set_count {
        if _mt_evaluated_at(s, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}
