// Deep self-contained core of lib/executor_multi_threaded.sla.
// Batch 420 focuses on ExecutorState gates and ready-batch selection using cap-16
// scalar slots instead of Vec bitsets. Batch 421 extends the same flat model with
// skipped/evaluated state, deferred cleanup, dependent release, and tick handoff.
// Batch 422 adds flat condition-folding and panic/handled-error facades.
// Batch 423 adds flat drive-loop and lock-failure tick summaries.
// Batch 424 adds fixed-arity multi-wave tick-loop summaries.
// Batch 425 adds flat run/apply/skip history tracking.
// Batch 426 adds fixed-arity drive-all history integration.
// Batch 427 adds flat finish-run deferred cleanup summaries.
// Batch 428 adds ready-batch skip/rescan summaries.
// Batch 429 adds begin-run reset summaries.
// Batch 430 adds completed-tick error summaries.
// Batch 431 adds complete-ready-batch summaries.
// Batch 432 adds initial-skip summaries.
// Batch 433 adds completion-queue drain summaries.
// Batch 434 adds tick-with-completions summaries.
// Batch 435 adds drive-ready-batch integration summaries.
// Batch 436 adds drive-all-batched integration summaries.
// Batch 437 adds ready-batch and tick-loop accessor parity helpers.
// Batch 438 adds skipped-batch accessor parity helpers.
// Batch 439 adds condition-fold and run-history accessor parity helpers.
// Batch 440 adds error-state and condition-error accessor parity helpers.
// Batch 442 adds complete-ready-batch summary accessor helpers.
// Batch 443 adds initial-skip summary accessor helpers.
// Batch 444 adds completion-queue drain summary accessor helpers.
// Batch 445 adds tick-with-completions summary accessor helpers.
// Batch 446 adds drive-ready-batch integration summary accessor helpers.
// Batch 447 adds drive-all-batched integration summary accessor helpers.
// Batch 448 adds ready-batch rescan summary accessor helpers.

const ECS_MT_DEEP_CAP: i32 = 16;

