fn _mt_drive_all_batched_integration_from_state(r: EcsExecutorDriveAllBatchedIntegrationSummaryDeep, s: EcsExecutorStateDeep) -> EcsExecutorDriveAllBatchedIntegrationSummaryDeep {
    r.ready_after = ecs_executor_state_deep_ready_count(s);
    r.running_after = ecs_executor_state_deep_running_count(s);
    r.completed_after = ecs_executor_state_deep_completed_count(s);
    r.unapplied_after = ecs_executor_state_deep_unapplied_count(s);
    r.deps0 = ecs_executor_state_deep_get_dependencies(s, 0);
    r.deps1 = ecs_executor_state_deep_get_dependencies(s, 1);
    r.deps2 = ecs_executor_state_deep_get_dependencies(s, 2);
    return r;
}

fn _mt_drive_all_batched_push_apply(r: EcsExecutorDriveAllBatchedIntegrationSummaryDeep, system_index: i64) -> EcsExecutorDriveAllBatchedIntegrationSummaryDeep {
    if r.apply_count == 0 { r.apply0 = system_index; r.apply_count = 1; return r; };
    if r.apply_count == 1 { r.apply1 = system_index; r.apply_count = 2; return r; };
    if r.apply_count == 2 { r.apply2 = system_index; r.apply_count = 3; return r; };
    return r;
}

fn _mt_drive_all_batched_record_apply(r: EcsExecutorDriveAllBatchedIntegrationSummaryDeep, s: EcsExecutorStateDeep) -> EcsExecutorDriveAllBatchedIntegrationSummaryDeep {
    let i: i64 = 0;
    while i < s.system_count {
        if _mt_unapplied_at(s, i) {
            r = _mt_drive_all_batched_push_apply(r, i);
        };
        i = i + 1;
    }
    return r;
}

fn ecs_executor_drive_all_batched_integration_summary_deep3(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64, max_width: i64, max_waves: i64) -> EcsExecutorDriveAllBatchedIntegrationSummaryDeep {
    let r = ecs_executor_drive_all_batched_integration_summary_deep_empty();
    if max_width <= 0 {
        if ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
        return _mt_drive_all_batched_integration_from_state(r, s);
    };
    let guard: i64 = 0;
    let limit = max_waves;
    if limit <= 0 { limit = 3; };
    while guard < limit && guard < 3 {
        if ecs_executor_state_deep_completed_count(s) >= s.system_count { return _mt_drive_all_batched_integration_from_state(r, s); };
        let before_completed = ecs_executor_state_deep_completed_count(s);
        let selected_count: i64 = 0;
        let selected0: i64 = -1;
        let selected1: i64 = -1;
        let selected2: i64 = -1;
        let batch_local: i32 = 0;
        let batch_exclusive: i32 = 0;
        if selected_count < max_width && batch_exclusive == 0 && s.system_count > 0 {
            let spec0 = _mt_spec3_by_system_index(a, b, c, 0);
            if _mt_drive_ready_batch_integration_can_select(s, spec0, batch_local, batch_exclusive, selected_count) {
                if spec0.should_run == 0 || _mt_skipped_at(s, 0) {
                    if r.skipped_count == 0 { r.skipped0 = 0; };
                    if r.skipped_count == 1 { r.skipped1 = 0; };
                    if r.skipped_count == 2 { r.skipped2 = 0; };
                    r.skipped_count = r.skipped_count + 1;
                    s = _mt_skip_with_history_deps3(s, spec0, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                } else {
                    selected0 = 0;
                    selected_count = 1;
                    if r.run_count == 0 { r.run0 = 0; };
                    if r.run_count == 1 { r.run1 = 0; };
                    if r.run_count == 2 { r.run2 = 0; };
                    r.run_count = r.run_count + 1;
                    if spec0.is_local != 0 { batch_local = 1; };
                    if spec0.is_exclusive != 0 { batch_exclusive = 1; batch_local = 1; };
                };
            };
        };
        if selected_count < max_width && batch_exclusive == 0 && s.system_count > 1 {
            let spec1 = _mt_spec3_by_system_index(a, b, c, 1);
            if _mt_drive_ready_batch_integration_can_select(s, spec1, batch_local, batch_exclusive, selected_count) {
                if spec1.should_run == 0 || _mt_skipped_at(s, 1) {
                    if r.skipped_count == 0 { r.skipped0 = 1; };
                    if r.skipped_count == 1 { r.skipped1 = 1; };
                    if r.skipped_count == 2 { r.skipped2 = 1; };
                    r.skipped_count = r.skipped_count + 1;
                    s = _mt_skip_with_history_deps3(s, spec1, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                } else {
                    if selected_count == 0 { selected0 = 1; };
                    if selected_count == 1 { selected1 = 1; };
                    if selected_count == 2 { selected2 = 1; };
                    selected_count = selected_count + 1;
                    if r.run_count == 0 { r.run0 = 1; };
                    if r.run_count == 1 { r.run1 = 1; };
                    if r.run_count == 2 { r.run2 = 1; };
                    r.run_count = r.run_count + 1;
                    if spec1.is_local != 0 { batch_local = 1; };
                    if spec1.is_exclusive != 0 { batch_exclusive = 1; batch_local = 1; };
                };
            };
        };
        if selected_count < max_width && batch_exclusive == 0 && s.system_count > 2 {
            let spec2 = _mt_spec3_by_system_index(a, b, c, 2);
            if _mt_drive_ready_batch_integration_can_select(s, spec2, batch_local, batch_exclusive, selected_count) {
                if spec2.should_run == 0 || _mt_skipped_at(s, 2) {
                    if r.skipped_count == 0 { r.skipped0 = 2; };
                    if r.skipped_count == 1 { r.skipped1 = 2; };
                    if r.skipped_count == 2 { r.skipped2 = 2; };
                    r.skipped_count = r.skipped_count + 1;
                    s = _mt_skip_with_history_deps3(s, spec2, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                } else {
                    if selected_count == 0 { selected0 = 2; };
                    if selected_count == 1 { selected1 = 2; };
                    if selected_count == 2 { selected2 = 2; };
                    selected_count = selected_count + 1;
                    if r.run_count == 0 { r.run0 = 2; };
                    if r.run_count == 1 { r.run1 = 2; };
                    if r.run_count == 2 { r.run2 = 2; };
                    r.run_count = r.run_count + 1;
                    if spec2.is_local != 0 { batch_local = 1; };
                    if spec2.is_exclusive != 0 { batch_exclusive = 1; batch_local = 1; };
                };
            };
        };
        if selected_count > 0 {
            if selected_count > 0 {
                let start_spec0 = _mt_spec3_by_system_index(a, b, c, selected0);
                s = ecs_executor_state_deep_start_system(s, start_spec0);
            };
            if selected_count > 1 {
                let start_spec1 = _mt_spec3_by_system_index(a, b, c, selected1);
                s = ecs_executor_state_deep_start_system(s, start_spec1);
            };
            if selected_count > 2 {
                let start_spec2 = _mt_spec3_by_system_index(a, b, c, selected2);
                s = ecs_executor_state_deep_start_system(s, start_spec2);
            };
            if selected_count > 0 {
                let complete_spec0 = _mt_spec3_by_system_index(a, b, c, selected0);
                if complete_spec0.is_apply_deferred != 0 { r = _mt_drive_all_batched_record_apply(r, s); s = ecs_executor_state_deep_apply_deferred_all(s); };
                s = _mt_complete_with_history_deps3(s, complete_spec0, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                if r.completed_count == 0 { r.completed0 = selected0; };
                if r.completed_count == 1 { r.completed1 = selected0; };
                if r.completed_count == 2 { r.completed2 = selected0; };
                r.completed_count = r.completed_count + 1;
            };
            if selected_count > 1 {
                let complete_spec1 = _mt_spec3_by_system_index(a, b, c, selected1);
                if complete_spec1.is_apply_deferred != 0 { r = _mt_drive_all_batched_record_apply(r, s); s = ecs_executor_state_deep_apply_deferred_all(s); };
                s = _mt_complete_with_history_deps3(s, complete_spec1, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                if r.completed_count == 0 { r.completed0 = selected1; };
                if r.completed_count == 1 { r.completed1 = selected1; };
                if r.completed_count == 2 { r.completed2 = selected1; };
                r.completed_count = r.completed_count + 1;
            };
            if selected_count > 2 {
                let complete_spec2 = _mt_spec3_by_system_index(a, b, c, selected2);
                if complete_spec2.is_apply_deferred != 0 { r = _mt_drive_all_batched_record_apply(r, s); s = ecs_executor_state_deep_apply_deferred_all(s); };
                s = _mt_complete_with_history_deps3(s, complete_spec2, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                if r.completed_count == 0 { r.completed0 = selected2; };
                if r.completed_count == 1 { r.completed1 = selected2; };
                if r.completed_count == 2 { r.completed2 = selected2; };
                r.completed_count = r.completed_count + 1;
            };
        };
        if selected_count > 0 || ecs_executor_state_deep_completed_count(s) > before_completed { r.wave_count = r.wave_count + 1; };
        if ecs_executor_state_deep_completed_count(s) == before_completed {
            if ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
            return _mt_drive_all_batched_integration_from_state(r, s);
        };
        guard = guard + 1;
    }
    if ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
    return _mt_drive_all_batched_integration_from_state(r, s);
}

fn _mt_skip_with_history_deps3(s: EcsExecutorStateDeep, spec: EcsExecutorSystemSpecDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64) -> EcsExecutorStateDeep {
    if spec.system_index == a.system_index {
        return ecs_executor_state_deep_skip_system_with_dependents3(s, spec.system_index, a_dep0, a_dep1, a_dep2, a_dep_count);
    };
    if spec.system_index == b.system_index {
        return ecs_executor_state_deep_skip_system_with_dependents3(s, spec.system_index, b_dep0, b_dep1, b_dep2, b_dep_count);
    };
    if spec.system_index == c.system_index {
        return ecs_executor_state_deep_skip_system_with_dependents3(s, spec.system_index, c_dep0, c_dep1, c_dep2, c_dep_count);
    };
    return ecs_executor_state_deep_skip_system_with_dependents3(s, spec.system_index, -1, -1, -1, 0);
}

fn _mt_drive_all_batched_ran_apply_deferred(r: EcsExecutorDriveAllBatchedIntegrationSummaryDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep) -> bool {
    if r.run_count > 0 && _mt_spec3_by_system_index(a, b, c, r.run0).is_apply_deferred != 0 { return true; };
    if r.run_count > 1 && _mt_spec3_by_system_index(a, b, c, r.run1).is_apply_deferred != 0 { return true; };
    if r.run_count > 2 && _mt_spec3_by_system_index(a, b, c, r.run2).is_apply_deferred != 0 { return true; };
    return false;
}

fn _mt_run_history_apply_contains(h: EcsExecutorRunHistoryDeep, system_index: i64) -> bool {
    if h.apply_count > 0 && h.apply0 == system_index { return true; };
    if h.apply_count > 1 && h.apply1 == system_index { return true; };
    if h.apply_count > 2 && h.apply2 == system_index { return true; };
    return false;
}

fn _mt_run_history_merge_apply(h: EcsExecutorRunHistoryDeep, system_index: i64) -> EcsExecutorRunHistoryDeep {
    if system_index < 0 { return h; };
    if _mt_run_history_apply_contains(h, system_index) { return h; };
    return ecs_executor_run_history_deep_push_apply(h, system_index);
}

fn _mt_run_history_from_drive_all_batched(r: EcsExecutorDriveAllBatchedIntegrationSummaryDeep, s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep) -> EcsExecutorRunHistoryDeep {
    let h = ecs_executor_run_history_deep_new();
    h.run_count = r.run_count;
    h.run0 = r.run0;
    h.run1 = r.run1;
    h.run2 = r.run2;
    if _mt_drive_all_batched_ran_apply_deferred(r, a, b, c) {
        h = ecs_executor_run_history_deep_apply_unapplied(h, s);
        if r.apply_count > 0 { h = _mt_run_history_merge_apply(h, r.apply0); };
        if r.apply_count > 1 { h = _mt_run_history_merge_apply(h, r.apply1); };
        if r.apply_count > 2 { h = _mt_run_history_merge_apply(h, r.apply2); };
    } else {
        h.apply_count = r.apply_count;
        h.apply0 = r.apply0;
        h.apply1 = r.apply1;
        h.apply2 = r.apply2;
    };
    h.skipped_count = r.skipped_count;
    h.skipped0 = r.skipped0;
    h.skipped1 = r.skipped1;
    h.skipped2 = r.skipped2;
    h.stalled = r.stalled;
    return h;
}

fn ecs_executor_run_history_deep_drive_all3(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64, max_steps: i64) -> EcsExecutorRunHistoryDeep {
    let r = ecs_executor_drive_all_batched_integration_summary_deep3(
        s, a, b, c,
        a_dep0, a_dep1, a_dep2, a_dep_count,
        b_dep0, b_dep1, b_dep2, b_dep_count,
        c_dep0, c_dep1, c_dep2, c_dep_count,
        1, max_steps
    );
    return _mt_run_history_from_drive_all_batched(r, s, a, b, c);
}

fn ecs_executor_ready_batch_rescan_summary_deep3(s: EcsExecutorStateDeep, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64, max_width: i64) -> EcsExecutorReadyBatchRescanSummaryDeep {
    let r = ecs_executor_ready_batch_rescan_summary_deep_empty();
    if max_width <= 0 {
        if ecs_executor_state_deep_completed_count(s) < s.system_count { r.stalled = 1; };
        return _mt_ready_batch_rescan_summary_from_state(r, s);
    };
    let rescan: bool = true;
    let guard: i64 = 0;
    while rescan && guard < ECS_MT_DEEP_CAP as i64 {
        rescan = false;
        r.rescan_count = r.rescan_count + 1;
        let i: i64 = 0;
        while i < s.system_count {
            if r.selected_count >= max_width { return _mt_ready_batch_rescan_summary_from_state(r, s); };
            if _mt_ready_at(s, i) && _mt_completed_at(s, i) != true && _mt_running_at(s, i) != true {
                let spec = _mt_spec3_by_system_index(a, b, c, i);
                if ecs_executor_state_deep_can_spawn_system(s, spec) {
                    if spec.should_run == 0 || _mt_skipped_at(s, i) {
                        r = _mt_ready_batch_rescan_push_skipped(r, i);
                        s = _mt_skip_with_history_deps3(s, spec, a, b, c, a_dep0, a_dep1, a_dep2, a_dep_count, b_dep0, b_dep1, b_dep2, b_dep_count, c_dep0, c_dep1, c_dep2, c_dep_count);
                        rescan = true;
                    } else {
                        if spec.is_exclusive != 0 {
                            if r.selected_count == 0 {
                                r = _mt_ready_batch_rescan_push_selected(r, i);
                                s = ecs_executor_state_deep_start_system(s, spec);
                            };
                            return _mt_ready_batch_rescan_summary_from_state(r, s);
                        } else {
                            r = _mt_ready_batch_rescan_push_selected(r, i);
                            s = ecs_executor_state_deep_start_system(s, spec);
                        };
                    };
                };
            };
            i = i + 1;
        }
        guard = guard + 1;
    }
    if r.selected_count == 0 && r.skipped_count == 0 && ecs_executor_state_deep_completed_count(s) < s.system_count {
        r.stalled = 1;
    };
    return _mt_ready_batch_rescan_summary_from_state(r, s);
}

fn _mt_completed_tick_error_complete_and_tick3(r: EcsExecutorCompletedTickErrorSummaryDeep, s: EcsExecutorStateDeep, completed_spec: EcsExecutorSystemSpecDeep, has_deferred: bool, dep0: i64, dep1: i64, dep2: i64, dep_count: i64, a: EcsExecutorSystemSpecDeep, b: EcsExecutorSystemSpecDeep, c: EcsExecutorSystemSpecDeep, a_dep0: i64, a_dep1: i64, a_dep2: i64, a_dep_count: i64, b_dep0: i64, b_dep1: i64, b_dep2: i64, b_dep_count: i64, c_dep0: i64, c_dep1: i64, c_dep2: i64, c_dep_count: i64, max_width: i64) -> EcsExecutorCompletedTickErrorSummaryDeep {
    s = ecs_executor_state_deep_complete_system_with_dependents3(s, completed_spec, has_deferred, dep0, dep1, dep2, dep_count);
    let batch_summary = ecs_executor_ready_batch_rescan_summary_deep3(
        s, a, b, c,
        a_dep0, a_dep1, a_dep2, a_dep_count,
        b_dep0, b_dep1, b_dep2, b_dep_count,
        c_dep0, c_dep1, c_dep2, c_dep_count,
        max_width
    );
    return _mt_completed_tick_error_from_batch(r, batch_summary, s);
}

