// Deepened Bevy ECS ComponentInfo surface.
// Mirrors src/component/info.rs:
//   ComponentId, StorageType, ComponentCloneBehavior
//   ComponentDescriptor (component/resource/non_send)
//   ComponentInfo from descriptor + hooks flags + required/required_by
//   update_archetype_flags from hooks
// Shallow lib/component_info.sla retained.

// StorageType
fn ecs_ci_storage_table() -> i32 { return 0; }
fn ecs_ci_storage_sparse() -> i32 { return 1; }

// CloneBehavior: Default=0, Ignore=1, Custom=2
fn ecs_ci_clone_default() -> i32 { return 0; }
fn ecs_ci_clone_ignore() -> i32 { return 1; }
fn ecs_ci_clone_custom() -> i32 { return 2; }

// Hook kinds / archetype flags bits
fn ecs_ci_hook_on_add() -> i32 { return 1; }
fn ecs_ci_hook_on_insert() -> i32 { return 2; }
fn ecs_ci_hook_on_discard() -> i32 { return 4; }
fn ecs_ci_hook_on_remove() -> i32 { return 8; }
fn ecs_ci_hook_on_despawn() -> i32 { return 16; }

struct EcsCiId {
    index: i32,
}

fn ecs_ci_id_new(index: i32) -> EcsCiId { return EcsCiId { index: index }; }
fn ecs_ci_id_index(id: EcsCiId) -> i32 { return id.index; }
fn ecs_ci_id_eq(a: EcsCiId, b: EcsCiId) -> bool {
    if a.index == b.index { return true; };
    return false;
}

struct EcsCiDesc {
    name_id: i64,
    mutable: bool,
    type_id: i64,
    has_type_id: bool,
    storage_type: i32,
    is_send_and_sync: bool,
    layout_size: i64,
    layout_align: i64,
    has_drop: bool,
    clone_behavior: i32,
    is_resource: bool,
    relationship_kind: i32, // 0 none, 1 relationship, 2 target
}

fn ecs_ci_desc_new(name_id: i64) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: name_id, mutable: true, type_id: 0, has_type_id: false,
        storage_type: 0, is_send_and_sync: true,
        layout_size: 0, layout_align: 1, has_drop: false,
        clone_behavior: 0, is_resource: false, relationship_kind: 0,
    };
}

fn ecs_ci_desc_new_resource(name_id: i64) -> EcsCiDesc {
    // Bevy resources always Table storage
    return EcsCiDesc {
        name_id: name_id, mutable: true, type_id: 0, has_type_id: false,
        storage_type: 0, is_send_and_sync: true,
        layout_size: 0, layout_align: 1, has_drop: false,
        clone_behavior: 0, is_resource: true, relationship_kind: 0,
    };
}

fn ecs_ci_desc_new_non_send(name_id: i64, storage_type: i32) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: name_id, mutable: true, type_id: 0, has_type_id: false,
        storage_type: storage_type, is_send_and_sync: false,
        layout_size: 0, layout_align: 1, has_drop: false,
        clone_behavior: 0, is_resource: false, relationship_kind: 0,
    };
}

fn ecs_ci_desc_set_type_id(d: EcsCiDesc, type_id: i64) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: d.mutable, type_id: type_id, has_type_id: true,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: d.has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource, relationship_kind: d.relationship_kind,
    };
}

fn ecs_ci_desc_set_layout(d: EcsCiDesc, size: i64, align: i64) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: d.mutable, type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: size, layout_align: align, has_drop: d.has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource, relationship_kind: d.relationship_kind,
    };
}

fn ecs_ci_desc_set_storage(d: EcsCiDesc, storage_type: i32) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: d.mutable, type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: d.has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource, relationship_kind: d.relationship_kind,
    };
}

fn ecs_ci_desc_set_mutable(d: EcsCiDesc, mutable: bool) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: mutable, type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: d.has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource, relationship_kind: d.relationship_kind,
    };
}

fn ecs_ci_desc_set_drop(d: EcsCiDesc, has_drop: bool) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: d.mutable, type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource, relationship_kind: d.relationship_kind,
    };
}

fn ecs_ci_desc_set_clone(d: EcsCiDesc, kind: i32) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: d.mutable, type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: d.has_drop,
        clone_behavior: kind, is_resource: d.is_resource, relationship_kind: d.relationship_kind,
    };
}

fn ecs_ci_desc_set_relationship(d: EcsCiDesc, kind: i32) -> EcsCiDesc {
    return EcsCiDesc {
        name_id: d.name_id, mutable: d.mutable, type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: d.has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource, relationship_kind: kind,
    };
}

struct EcsCiInfo {
    id: i32,
    name_id: i64,
    mutable: bool,
    type_id: i64,
    has_type_id: bool,
    storage_type: i32,
    is_send_and_sync: bool,
    layout_size: i64,
    layout_align: i64,
    has_drop: bool,
    clone_behavior: i32,
    is_resource: bool,
    relationship_kind: i32,
    // hooks present bits
    hooks: i32,
    // required components count + required_by count (fixed ids optional)
    required_count: i32,
    required_by_count: i32,
    rb0: i32, rb1: i32, rb2: i32, rb3: i32,
}

fn ecs_ci_info_from_descriptor(id: i32, d: EcsCiDesc) -> EcsCiInfo {
    return EcsCiInfo {
        id: id, name_id: d.name_id, mutable: d.mutable,
        type_id: d.type_id, has_type_id: d.has_type_id,
        storage_type: d.storage_type, is_send_and_sync: d.is_send_and_sync,
        layout_size: d.layout_size, layout_align: d.layout_align, has_drop: d.has_drop,
        clone_behavior: d.clone_behavior, is_resource: d.is_resource,
        relationship_kind: d.relationship_kind,
        hooks: 0, required_count: 0, required_by_count: 0,
        rb0: -1, rb1: -1, rb2: -1, rb3: -1,
    };
}

fn ecs_ci_info_id(c: EcsCiInfo) -> i32 { return c.id; }
fn ecs_ci_info_name(c: EcsCiInfo) -> i64 { return c.name_id; }
fn ecs_ci_info_mutable(c: EcsCiInfo) -> bool { return c.mutable; }
fn ecs_ci_info_storage_type(c: EcsCiInfo) -> i32 { return c.storage_type; }
fn ecs_ci_info_is_send_and_sync(c: EcsCiInfo) -> bool { return c.is_send_and_sync; }
fn ecs_ci_info_has_drop(c: EcsCiInfo) -> bool { return c.has_drop; }
fn ecs_ci_info_clone_behavior(c: EcsCiInfo) -> i32 { return c.clone_behavior; }
fn ecs_ci_info_is_resource(c: EcsCiInfo) -> bool { return c.is_resource; }
fn ecs_ci_info_relationship(c: EcsCiInfo) -> i32 { return c.relationship_kind; }
fn ecs_ci_info_required_count(c: EcsCiInfo) -> i32 { return c.required_count; }
fn ecs_ci_info_required_by_count(c: EcsCiInfo) -> i32 { return c.required_by_count; }

fn ecs_ci_info_type_id(c: EcsCiInfo) -> (bool, i64) {
    return (c.has_type_id, c.type_id);
}

fn ecs_ci_info_layout(c: EcsCiInfo) -> (i64, i64) {
    return (c.layout_size, c.layout_align);
}

fn ecs_ci_info_set_hooks(c: EcsCiInfo, hooks: i32) -> EcsCiInfo {
    return EcsCiInfo {
        id: c.id, name_id: c.name_id, mutable: c.mutable, type_id: c.type_id, has_type_id: c.has_type_id,
        storage_type: c.storage_type, is_send_and_sync: c.is_send_and_sync,
        layout_size: c.layout_size, layout_align: c.layout_align, has_drop: c.has_drop,
        clone_behavior: c.clone_behavior, is_resource: c.is_resource, relationship_kind: c.relationship_kind,
        hooks: hooks, required_count: c.required_count, required_by_count: c.required_by_count,
        rb0: c.rb0, rb1: c.rb1, rb2: c.rb2, rb3: c.rb3,
    };
}

fn ecs_ci_info_enable_hook(c: EcsCiInfo, hook_bit: i32) -> EcsCiInfo {
    return ecs_ci_info_set_hooks(c, c.hooks | hook_bit);
}

fn ecs_ci_info_has_hook(c: EcsCiInfo, hook_bit: i32) -> bool {
    if (c.hooks & hook_bit) != 0 { return true; };
    return false;
}

fn ecs_ci_info_set_required_count(c: EcsCiInfo, count: i32) -> EcsCiInfo {
    return EcsCiInfo {
        id: c.id, name_id: c.name_id, mutable: c.mutable, type_id: c.type_id, has_type_id: c.has_type_id,
        storage_type: c.storage_type, is_send_and_sync: c.is_send_and_sync,
        layout_size: c.layout_size, layout_align: c.layout_align, has_drop: c.has_drop,
        clone_behavior: c.clone_behavior, is_resource: c.is_resource, relationship_kind: c.relationship_kind,
        hooks: c.hooks, required_count: count, required_by_count: c.required_by_count,
        rb0: c.rb0, rb1: c.rb1, rb2: c.rb2, rb3: c.rb3,
    };
}

fn ecs_ci_info_add_required_by(c: EcsCiInfo, other_id: i32) -> EcsCiInfo {
    if c.required_by_count >= 4 { return c; };
    // de-dup
    if c.required_by_count >= 1 { if c.rb0 == other_id { return c; }; };
    if c.required_by_count >= 2 { if c.rb1 == other_id { return c; }; };
    if c.required_by_count >= 3 { if c.rb2 == other_id { return c; }; };
    if c.required_by_count >= 4 { if c.rb3 == other_id { return c; }; };
    let n = c.required_by_count;
    let rb0 = c.rb0; let rb1 = c.rb1; let rb2 = c.rb2; let rb3 = c.rb3;
    if n == 0 { rb0 = other_id; };
    if n == 1 { rb1 = other_id; };
    if n == 2 { rb2 = other_id; };
    if n == 3 { rb3 = other_id; };
    return EcsCiInfo {
        id: c.id, name_id: c.name_id, mutable: c.mutable, type_id: c.type_id, has_type_id: c.has_type_id,
        storage_type: c.storage_type, is_send_and_sync: c.is_send_and_sync,
        layout_size: c.layout_size, layout_align: c.layout_align, has_drop: c.has_drop,
        clone_behavior: c.clone_behavior, is_resource: c.is_resource, relationship_kind: c.relationship_kind,
        hooks: c.hooks, required_count: c.required_count, required_by_count: n + 1,
        rb0: rb0, rb1: rb1, rb2: rb2, rb3: rb3,
    };
}

fn ecs_ci_info_required_by_at(c: EcsCiInfo, idx: i32) -> i32 {
    if idx == 0 { return c.rb0; };
    if idx == 1 { return c.rb1; };
    if idx == 2 { return c.rb2; };
    if idx == 3 { return c.rb3; };
    return -1;
}

// update_archetype_flags: OR hook bits into flags
fn ecs_ci_update_archetype_flags(c: EcsCiInfo, flags: i32) -> i32 {
    return flags | c.hooks;
}

// clone_behavior resolve: Default stays default unless forced
fn ecs_ci_clone_resolve(kind: i32, default_kind: i32) -> i32 {
    if kind == ecs_ci_clone_default() { return default_kind; };
    return kind;
}
