// Deepened Bevy ECS UniqueEntityVec base.
// Fixed capacity 8. Shallow lib/unique_vec.sla retained.

struct EcsUvDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
}

fn ecs_uv_deep_new() -> EcsUvDeep {
    return EcsUvDeep { e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0, len: 0 };
}

fn ecs_uv_deep_rebuild(e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64, len: i32) -> EcsUvDeep {
    return EcsUvDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7, len: len };
}

fn ecs_uv_deep_len(v: EcsUvDeep) -> i32 { return v.len; }
fn ecs_uv_deep_is_empty(v: EcsUvDeep) -> bool { return v.len == 0; }

fn ecs_uv_deep_contains(v: EcsUvDeep, entity: i64) -> bool {
    if v.len >= 1 { if v.e0 == entity { return true; }; };
    if v.len >= 2 { if v.e1 == entity { return true; }; };
    if v.len >= 3 { if v.e2 == entity { return true; }; };
    if v.len >= 4 { if v.e3 == entity { return true; }; };
    if v.len >= 5 { if v.e4 == entity { return true; }; };
    if v.len >= 6 { if v.e5 == entity { return true; }; };
    if v.len >= 7 { if v.e6 == entity { return true; }; };
    if v.len >= 8 { if v.e7 == entity { return true; }; };
    return false;
}

fn ecs_uv_deep_push(v: EcsUvDeep, entity: i64) -> EcsUvDeep {
    if ecs_uv_deep_contains(v, entity) { return v; };
    if v.len >= 8 { return v; };
    if v.len == 0 { return ecs_uv_deep_rebuild(entity, 0, 0, 0, 0, 0, 0, 0, 1); };
    if v.len == 1 { return ecs_uv_deep_rebuild(v.e0, entity, 0, 0, 0, 0, 0, 0, 2); };
    if v.len == 2 { return ecs_uv_deep_rebuild(v.e0, v.e1, entity, 0, 0, 0, 0, 0, 3); };
    if v.len == 3 { return ecs_uv_deep_rebuild(v.e0, v.e1, v.e2, entity, 0, 0, 0, 0, 4); };
    if v.len == 4 { return ecs_uv_deep_rebuild(v.e0, v.e1, v.e2, v.e3, entity, 0, 0, 0, 5); };
    if v.len == 5 { return ecs_uv_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, entity, 0, 0, 6); };
    if v.len == 6 { return ecs_uv_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, v.e5, entity, 0, 7); };
    if v.len == 7 { return ecs_uv_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, v.e5, v.e6, entity, 8); };
    return v;
}

fn ecs_uv_deep_at(v: EcsUvDeep, idx: i32) -> i64 {
    if idx == 0 { return v.e0; };
    if idx == 1 { return v.e1; };
    if idx == 2 { return v.e2; };
    if idx == 3 { return v.e3; };
    if idx == 4 { return v.e4; };
    if idx == 5 { return v.e5; };
    if idx == 6 { return v.e6; };
    if idx == 7 { return v.e7; };
    return -1;
}

struct EcsUvGetDeep { ok: bool, value: i64 }
fn ecs_uv_get_ok(g: EcsUvGetDeep) -> bool { return g.ok; }
fn ecs_uv_get_value(g: EcsUvGetDeep) -> i64 { return g.value; }

fn ecs_uv_deep_get(v: EcsUvDeep, idx: i32) -> EcsUvGetDeep {
    if idx < 0 { return EcsUvGetDeep { ok: false, value: -1 }; };
    if idx >= v.len { return EcsUvGetDeep { ok: false, value: -1 }; };
    return EcsUvGetDeep { ok: true, value: ecs_uv_deep_at(v, idx) };
}

fn ecs_uv_deep_first(v: EcsUvDeep) -> EcsUvGetDeep {
    if v.len == 0 { return EcsUvGetDeep { ok: false, value: -1 }; };
    return EcsUvGetDeep { ok: true, value: v.e0 };
}

fn ecs_uv_deep_last(v: EcsUvDeep) -> EcsUvGetDeep {
    if v.len == 0 { return EcsUvGetDeep { ok: false, value: -1 }; };
    return EcsUvGetDeep { ok: true, value: ecs_uv_deep_at(v, v.len - 1) };
}

fn ecs_uv_deep_index_of(v: EcsUvDeep, entity: i64) -> i32 {
    if v.len >= 1 { if v.e0 == entity { return 0; }; };
    if v.len >= 2 { if v.e1 == entity { return 1; }; };
    if v.len >= 3 { if v.e2 == entity { return 2; }; };
    if v.len >= 4 { if v.e3 == entity { return 3; }; };
    if v.len >= 5 { if v.e4 == entity { return 4; }; };
    if v.len >= 6 { if v.e5 == entity { return 5; }; };
    if v.len >= 7 { if v.e6 == entity { return 6; }; };
    if v.len >= 8 { if v.e7 == entity { return 7; }; };
    return -1;
}

fn ecs_uv_deep_clear(v: EcsUvDeep) -> EcsUvDeep {
    return ecs_uv_deep_new();
}
