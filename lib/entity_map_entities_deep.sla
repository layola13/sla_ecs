// Deepened Bevy ECS entity::map_entities surface.
// Mirrors src/entity/map_entities.rs:
//   EntityMapper (identity / pair / hash_map / scene)
//   MapEntities for Entity, Option, fixed list, pair component
//   SceneEntityMapper get_mapped allocate + set_mapped + finish reserve count
// Shallow lib/entity_map_entities.sla retained.
// Fixed capacity: 8 map entries, 4 list slots.

// EntityHashMap-like fixed map
struct EcsMeMapDeep {
    len: i32,
    k0: i64, v0: i64,
    k1: i64, v1: i64,
    k2: i64, v2: i64,
    k3: i64, v3: i64,
    k4: i64, v4: i64,
    k5: i64, v5: i64,
    k6: i64, v6: i64,
    k7: i64, v7: i64,
}

fn ecs_me_map_deep_new() -> EcsMeMapDeep {
    return EcsMeMapDeep {
        len: 0,
        k0: 0, v0: 0, k1: 0, v1: 0, k2: 0, v2: 0, k3: 0, v3: 0,
        k4: 0, v4: 0, k5: 0, v5: 0, k6: 0, v6: 0, k7: 0, v7: 0,
    };
}

fn ecs_me_map_deep_len(m: EcsMeMapDeep) -> i32 { return m.len; }

fn ecs_me_map_deep_get(m: EcsMeMapDeep, key: i64) -> (bool, i64) {
    if m.len >= 1 { if m.k0 == key { return (true, m.v0); }; };
    if m.len >= 2 { if m.k1 == key { return (true, m.v1); }; };
    if m.len >= 3 { if m.k2 == key { return (true, m.v2); }; };
    if m.len >= 4 { if m.k3 == key { return (true, m.v3); }; };
    if m.len >= 5 { if m.k4 == key { return (true, m.v4); }; };
    if m.len >= 6 { if m.k5 == key { return (true, m.v5); }; };
    if m.len >= 7 { if m.k6 == key { return (true, m.v6); }; };
    if m.len >= 8 { if m.k7 == key { return (true, m.v7); }; };
    return (false, 0);
}

fn ecs_me_map_deep_insert(m: EcsMeMapDeep, key: i64, value: i64) -> EcsMeMapDeep {
    if m.len >= 1 { if m.k0 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: value, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 2 { if m.k1 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: value, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 3 { if m.k2 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: value, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 4 { if m.k3 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: value,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 5 { if m.k4 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: value, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 6 { if m.k5 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: value, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 7 { if m.k6 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: value, k7: m.k7, v7: m.v7,
        };
    }; };
    if m.len >= 8 { if m.k7 == key {
        return EcsMeMapDeep {
            len: m.len, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: value,
        };
    }; };
    if m.len >= 8 { return m; };
    let n = m.len;
    if n == 0 {
        return EcsMeMapDeep {
            len: 1, k0: key, v0: value, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    };
    if n == 1 {
        return EcsMeMapDeep {
            len: 2, k0: m.k0, v0: m.v0, k1: key, v1: value, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    };
    if n == 2 {
        return EcsMeMapDeep {
            len: 3, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: key, v2: value, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    };
    if n == 3 {
        return EcsMeMapDeep {
            len: 4, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: key, v3: value,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    };
    if n == 4 {
        return EcsMeMapDeep {
            len: 5, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: key, v4: value, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    };
    if n == 5 {
        return EcsMeMapDeep {
            len: 6, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: key, v5: value, k6: m.k6, v6: m.v6, k7: m.k7, v7: m.v7,
        };
    };
    if n == 6 {
        return EcsMeMapDeep {
            len: 7, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
            k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: key, v6: value, k7: m.k7, v7: m.v7,
        };
    };
    return EcsMeMapDeep {
        len: 8, k0: m.k0, v0: m.v0, k1: m.k1, v1: m.v1, k2: m.k2, v2: m.v2, k3: m.k3, v3: m.v3,
        k4: m.k4, v4: m.v4, k5: m.k5, v5: m.v5, k6: m.k6, v6: m.v6, k7: key, v7: value,
    };
}

// EntityMapper result: updated mapper payload + mapped entity
struct EcsMeMappedDeep {
    mapped: i64,
    map: EcsMeMapDeep,
    generations: i32,
}

fn ecs_me_mapped_entity(r: EcsMeMappedDeep) -> i64 { return r.mapped; }
fn ecs_me_mapped_map(r: EcsMeMappedDeep) -> EcsMeMapDeep { return r.map; }
fn ecs_me_mapped_generations(r: EcsMeMappedDeep) -> i32 { return r.generations; }

// Identity mapper () — always returns source
fn ecs_me_identity_get_mapped(source: i64) -> i64 { return source; }
fn ecs_me_identity_set_mapped() -> bool { return true; }

// Pair mapper (source, target)
fn ecs_me_pair_get_mapped(pair_src: i64, pair_dst: i64, source: i64) -> i64 {
    if source == pair_src { return pair_dst; };
    return source;
}

// HashMap EntityMapper: missing -> identity
fn ecs_me_hash_get_mapped(m: EcsMeMapDeep, source: i64) -> i64 {
    let found = ecs_me_map_deep_get(m, source);
    if found.0 { return found.1; };
    return source;
}

fn ecs_me_hash_set_mapped(m: EcsMeMapDeep, source: i64, target: i64) -> EcsMeMapDeep {
    return ecs_me_map_deep_insert(m, source, target);
}

// SceneEntityMapper: map + dead_start + generations
// dead entity id encoding: base_index + (generation offset encoded as high bits-ish via value = base + gen)
// Deep model: allocated = dead_start + generations (as i64 offset)
struct EcsMeSceneDeep {
    map: EcsMeMapDeep,
    dead_start: i64,
    generations: i32,
}

fn ecs_me_scene_deep_new(dead_start: i64) -> EcsMeSceneDeep {
    return EcsMeSceneDeep { map: ecs_me_map_deep_new(), dead_start: dead_start, generations: 0 };
}

fn ecs_me_scene_deep_from_map(map: EcsMeMapDeep, dead_start: i64) -> EcsMeSceneDeep {
    return EcsMeSceneDeep { map: map, dead_start: dead_start, generations: 0 };
}

fn ecs_me_scene_deep_map_len(s: EcsMeSceneDeep) -> i32 { return ecs_me_map_deep_len(s.map); }
fn ecs_me_scene_deep_generations(s: EcsMeSceneDeep) -> i32 { return s.generations; }
fn ecs_me_scene_deep_dead_start(s: EcsMeSceneDeep) -> i64 { return s.dead_start; }
fn ecs_me_scene_deep_map(s: EcsMeSceneDeep) -> EcsMeMapDeep { return s.map; }

// get_mapped: existing mapping or allocate dead entity = dead_start + generations
fn ecs_me_scene_deep_get_mapped(s: EcsMeSceneDeep, source: i64) -> EcsMeMappedDeep {
    let found = ecs_me_map_deep_get(s.map, source);
    if found.0 {
        return EcsMeMappedDeep { mapped: found.1, map: s.map, generations: s.generations };
    };
    let gen = s.generations;
    let allocated = s.dead_start + (gen as i64);
    let map2 = ecs_me_map_deep_insert(s.map, source, allocated);
    return EcsMeMappedDeep { mapped: allocated, map: map2, generations: gen + 1 };
}

fn ecs_me_scene_deep_apply_mapped(s: EcsMeSceneDeep, r: EcsMeMappedDeep) -> EcsMeSceneDeep {
    return EcsMeSceneDeep { map: r.map, dead_start: s.dead_start, generations: r.generations };
}

fn ecs_me_scene_deep_set_mapped(s: EcsMeSceneDeep, source: i64, target: i64) -> EcsMeSceneDeep {
    let map2 = ecs_me_map_deep_insert(s.map, source, target);
    return EcsMeSceneDeep { map: map2, dead_start: s.dead_start, generations: s.generations };
}

// finish: generations that must be reserved after world_scope
fn ecs_me_scene_deep_finish_reserve(s: EcsMeSceneDeep) -> i32 { return s.generations; }

// MapEntities for Entity
fn ecs_me_map_entity_with_hash(m: EcsMeMapDeep, entity: i64) -> i64 {
    return ecs_me_hash_get_mapped(m, entity);
}

// Option<Entity> style: has flag
struct EcsMeOptEntityDeep {
    has: bool,
    entity: i64,
}

fn ecs_me_opt_none() -> EcsMeOptEntityDeep {
    return EcsMeOptEntityDeep { has: false, entity: 0 };
}
fn ecs_me_opt_some(entity: i64) -> EcsMeOptEntityDeep {
    return EcsMeOptEntityDeep { has: true, entity: entity };
}
fn ecs_me_opt_has(o: EcsMeOptEntityDeep) -> bool { return o.has; }
fn ecs_me_opt_entity(o: EcsMeOptEntityDeep) -> i64 { return o.entity; }

fn ecs_me_map_opt_entity_with_hash(m: EcsMeMapDeep, o: EcsMeOptEntityDeep) -> EcsMeOptEntityDeep {
    if o.has != true { return o; };
    let mapped = ecs_me_hash_get_mapped(m, o.entity);
    return EcsMeOptEntityDeep { has: true, entity: mapped };
}

// Fixed list of entities (Vec-like MapEntities)
struct EcsMeListDeep {
    len: i32,
    e0: i64, e1: i64, e2: i64, e3: i64,
}

fn ecs_me_list_deep_new() -> EcsMeListDeep {
    return EcsMeListDeep { len: 0, e0: 0, e1: 0, e2: 0, e3: 0 };
}
fn ecs_me_list_deep_len(l: EcsMeListDeep) -> i32 { return l.len; }
fn ecs_me_list_deep_at(l: EcsMeListDeep, idx: i32) -> i64 {
    if idx == 0 { return l.e0; };
    if idx == 1 { return l.e1; };
    if idx == 2 { return l.e2; };
    if idx == 3 { return l.e3; };
    return 0;
}
fn ecs_me_list_deep_push(l: EcsMeListDeep, e: i64) -> EcsMeListDeep {
    if l.len >= 4 { return l; };
    if l.len == 0 { return EcsMeListDeep { len: 1, e0: e, e1: l.e1, e2: l.e2, e3: l.e3 }; };
    if l.len == 1 { return EcsMeListDeep { len: 2, e0: l.e0, e1: e, e2: l.e2, e3: l.e3 }; };
    if l.len == 2 { return EcsMeListDeep { len: 3, e0: l.e0, e1: l.e1, e2: e, e3: l.e3 }; };
    return EcsMeListDeep { len: 4, e0: l.e0, e1: l.e1, e2: l.e2, e3: e };
}

fn ecs_me_map_list_with_hash(m: EcsMeMapDeep, l: EcsMeListDeep) -> EcsMeListDeep {
    let e0 = l.e0; let e1 = l.e1; let e2 = l.e2; let e3 = l.e3;
    if l.len >= 1 { e0 = ecs_me_hash_get_mapped(m, e0); };
    if l.len >= 2 { e1 = ecs_me_hash_get_mapped(m, e1); };
    if l.len >= 3 { e2 = ecs_me_hash_get_mapped(m, e2); };
    if l.len >= 4 { e3 = ecs_me_hash_get_mapped(m, e3); };
    return EcsMeListDeep { len: l.len, e0: e0, e1: e1, e2: e2, e3: e3 };
}

// Spring-like pair component MapEntities
struct EcsMeSpringDeep {
    a: i64,
    b: i64,
}

fn ecs_me_spring_deep_new(a: i64, b: i64) -> EcsMeSpringDeep {
    return EcsMeSpringDeep { a: a, b: b };
}
fn ecs_me_spring_a(s: EcsMeSpringDeep) -> i64 { return s.a; }
fn ecs_me_spring_b(s: EcsMeSpringDeep) -> i64 { return s.b; }

fn ecs_me_map_spring_with_hash(m: EcsMeMapDeep, s: EcsMeSpringDeep) -> EcsMeSpringDeep {
    let a = ecs_me_hash_get_mapped(m, s.a);
    let b = ecs_me_hash_get_mapped(m, s.b);
    return EcsMeSpringDeep { a: a, b: b };
}

// Scene-driven MapEntities for spring
fn ecs_me_map_spring_with_scene(s: EcsMeSceneDeep, spring: EcsMeSpringDeep) -> (EcsMeSceneDeep, EcsMeSpringDeep) {
    let ra = ecs_me_scene_deep_get_mapped(s, spring.a);
    s = ecs_me_scene_deep_apply_mapped(s, ra);
    let a = ecs_me_mapped_entity(ra);
    let rb = ecs_me_scene_deep_get_mapped(s, spring.b);
    s = ecs_me_scene_deep_apply_mapped(s, rb);
    let b = ecs_me_mapped_entity(rb);
    return (s, EcsMeSpringDeep { a: a, b: b });
}

// world_scope-like: run one get_mapped then finish reserve count
struct EcsMeWorldScopeDeep {
    mapper: EcsMeSceneDeep,
    result: i64,
    reserve: i32,
}

fn ecs_me_world_scope_deep_get(m: EcsMeSceneDeep, source: i64) -> EcsMeWorldScopeDeep {
    let r = ecs_me_scene_deep_get_mapped(m, source);
    let m2 = ecs_me_scene_deep_apply_mapped(m, r);
    return EcsMeWorldScopeDeep {
        mapper: m2,
        result: ecs_me_mapped_entity(r),
        reserve: ecs_me_scene_deep_finish_reserve(m2),
    };
}

fn ecs_me_world_scope_result(w: EcsMeWorldScopeDeep) -> i64 { return w.result; }
fn ecs_me_world_scope_reserve(w: EcsMeWorldScopeDeep) -> i32 { return w.reserve; }
fn ecs_me_world_scope_mapper(w: EcsMeWorldScopeDeep) -> EcsMeSceneDeep { return w.mapper; }
