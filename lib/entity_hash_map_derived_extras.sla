// Bevy ECS EntityHashMap derived/wrapper and iterator marker extras.
// Complements entity_hash_map_extras.sla with constructor/default/clone/debug,
// From/Extend variants, PartialEq<HashMap>, IntoIterator markers, and Keys /
// IntoKeys iterator size-hint/debug/default/trusted-unique behavior.

struct EcsEhm4Pair { key: i64, value: i32 }
struct EcsEhm4Map { entries: Vec<EcsEhm4Pair>, capacity_hint: i64, constructed_kind: i32 }
struct EcsEhm4Iter { entries: Vec<EcsEhm4Pair>, front: i64, back: i64, debug_kind: i32, trusted_unique: i32, mutable_view: i32, inner_exposed: i32 }
struct EcsEhm4SizeHint { lower: i64, upper: i64 }
struct EcsEhm4InsertResult { replaced: i32, map: EcsEhm4Map }
struct EcsEhm4GetResult { has: i32, key: i64, value: i32 }
struct EcsEhm4NextResult { iter: EcsEhm4Iter, has: i32, key: i64, value: i32 }
struct EcsEhm4KeyResult { iter: EcsEhm4Iter, has: i32, key: i64 }

fn ecs_ehm4_pair(key: i64, value: i32) -> EcsEhm4Pair {
    return EcsEhm4Pair { key: key, value: value };
}

fn ecs_ehm4_new() -> EcsEhm4Map {
    return EcsEhm4Map { entries: Vec::new(), capacity_hint: 0, constructed_kind: 1 };
}

fn ecs_ehm4_default() -> EcsEhm4Map {
    return EcsEhm4Map { entries: Vec::new(), capacity_hint: 0, constructed_kind: 2 };
}

fn ecs_ehm4_with_capacity(capacity: i64) -> EcsEhm4Map {
    let hint = capacity;
    if hint < 0 { hint = 0; };
    return EcsEhm4Map { entries: Vec::new(), capacity_hint: hint, constructed_kind: 3 };
}

fn ecs_ehm4_clone(map: EcsEhm4Map) -> EcsEhm4Map {
    let capacity_hint = map.capacity_hint;
    return EcsEhm4Map { entries: map.entries, capacity_hint: capacity_hint, constructed_kind: 4 };
}

fn ecs_ehm4_from_hash_map(map: EcsEhm4Map) -> EcsEhm4Map {
    return EcsEhm4Map { entries: map.entries, capacity_hint: map.capacity_hint, constructed_kind: 6 };
}

fn ecs_ehm4_from_index_map(map: EcsEhm4Map) -> EcsEhm4Map {
    return ecs_ehm4_from_hash_map(map);
}

fn ecs_ehm4_into_inner(map: EcsEhm4Map) -> Vec<EcsEhm4Pair> { return map.entries; }
fn ecs_ehm4_debug_kind(map: EcsEhm4Map) -> i32 { return map.constructed_kind; }
fn ecs_ehm4_len(map: EcsEhm4Map) -> i64 { return len(map.entries) as i64; }
fn ecs_ehm4_inner_len(entries: Vec<EcsEhm4Pair>) -> i64 { return len(entries) as i64; }

fn ecs_ehm4_get(map: EcsEhm4Map, key: i64) -> EcsEhm4GetResult {
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        if map.entries[index].key == key {
            return EcsEhm4GetResult { has: 1, key: key, value: map.entries[index].value };
        };
        index = index + 1;
    }
    return EcsEhm4GetResult { has: 0, key: key, value: 0 };
}

fn ecs_ehm4_index_entity_equivalent(map: EcsEhm4Map, key: i64) -> i32 {
    let got = ecs_ehm4_get(map, key);
    if got.has == 0 { return -1; };
    return got.value;
}

fn ecs_ehm4_insert(map: EcsEhm4Map, key: i64, value: i32) -> EcsEhm4InsertResult {
    let found_index: i64 = -1;
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        if map.entries[index].key == key { found_index = index + 0; };
        index = index + 1;
    }
    if found_index >= 0 {
        map.entries[found_index].value = value;
        return EcsEhm4InsertResult { replaced: 1, map: map };
    };
    map.entries.push(EcsEhm4Pair { key: key, value: value });
    return EcsEhm4InsertResult { replaced: 0, map: map };
}

fn ecs_ehm4_extend_owned(map: EcsEhm4Map, entries: Vec<EcsEhm4Pair>) -> EcsEhm4Map {
    let index: i64 = 0;
    while index < (len(entries) as i64) {
        let inserted = ecs_ehm4_insert(map, entries[index].key, entries[index].value);
        map = inserted.map;
        index = index + 1;
    }
    return map;
}

fn ecs_ehm4_extend_ref_pairs(map: EcsEhm4Map, entries: Vec<EcsEhm4Pair>) -> EcsEhm4Map {
    return ecs_ehm4_extend_owned(map, entries);
}

fn ecs_ehm4_extend_ref_kv(map: EcsEhm4Map, keys: Vec<i64>, values: Vec<i64>) -> EcsEhm4Map {
    let index: i64 = 0;
    let key_count = len(keys) as i64;
    let value_count = len(values) as i64;
    while index < key_count {
        if index < value_count {
            let value = values[index] as i32;
            let inserted = ecs_ehm4_insert(map, keys[index], value);
            map = inserted.map;
        };
        index = index + 1;
    }
    return map;
}

fn ecs_ehm4_from_iter(entries: Vec<EcsEhm4Pair>) -> EcsEhm4Map {
    return ecs_ehm4_extend_owned(ecs_ehm4_new(), entries);
}

fn ecs_ehm4_from_array4(k1: i64, v1: i32, k2: i64, v2: i32, k3: i64, v3: i32, k4: i64, v4: i32) -> EcsEhm4Map {
    let entries: Vec<EcsEhm4Pair> = Vec::new();
    entries.push(ecs_ehm4_pair(k1, v1));
    entries.push(ecs_ehm4_pair(k2, v2));
    entries.push(ecs_ehm4_pair(k3, v3));
    entries.push(ecs_ehm4_pair(k4, v4));
    let map = ecs_ehm4_extend_owned(ecs_ehm4_new(), entries);
    return EcsEhm4Map { entries: map.entries, capacity_hint: 4, constructed_kind: 5 };
}

fn ecs_ehm4_eq_inner(map: EcsEhm4Map, entries: Vec<EcsEhm4Pair>) -> bool {
    let inner = ecs_ehm4_from_iter(entries);
    if len(map.entries) != len(inner.entries) { return false; };
    let equal = true;
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        let found = false;
        let inner_index: i64 = 0;
        while inner_index < (len(inner.entries) as i64) {
            if inner.entries[inner_index].key == map.entries[index].key {
                if inner.entries[inner_index].value == map.entries[index].value { found = true; };
            };
            inner_index = inner_index + 1;
        }
        if found != true { equal = false; };
        index = index + 1;
    }
    return equal;
}

fn ecs_ehm4_iter_from_map(map: EcsEhm4Map, debug_kind: i32, mutable_view: i32, trusted_unique: i32) -> EcsEhm4Iter {
    return EcsEhm4Iter { entries: map.entries, front: 0, back: len(map.entries) as i64, debug_kind: debug_kind, trusted_unique: trusted_unique, mutable_view: mutable_view, inner_exposed: 0 };
}

fn ecs_ehm4_iter(map: EcsEhm4Map) -> EcsEhm4Iter { return ecs_ehm4_iter_from_map(map, 10, 0, 0); }
fn ecs_ehm4_iter_mut(map: EcsEhm4Map) -> EcsEhm4Iter { return ecs_ehm4_iter_from_map(map, 11, 1, 0); }
fn ecs_ehm4_into_iter(map: EcsEhm4Map) -> EcsEhm4Iter { return ecs_ehm4_iter_from_map(map, 20, 0, 0); }
fn ecs_ehm4_keys(map: EcsEhm4Map) -> EcsEhm4Iter { return ecs_ehm4_iter_from_map(map, 40, 0, 1); }
fn ecs_ehm4_into_keys(map: EcsEhm4Map) -> EcsEhm4Iter { return ecs_ehm4_iter_from_map(map, 50, 0, 1); }

fn ecs_ehm4_iter_remaining(iter: EcsEhm4Iter) -> i64 {
    let remaining = iter.back - iter.front;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_ehm4_size_hint(iter: EcsEhm4Iter) -> EcsEhm4SizeHint {
    let remaining = ecs_ehm4_iter_remaining(iter);
    return EcsEhm4SizeHint { lower: remaining, upper: remaining };
}

fn ecs_ehm4_iter_debug_kind(iter: EcsEhm4Iter) -> i32 { return iter.debug_kind; }

fn ecs_ehm4_iter_default(debug_kind: i32, trusted_unique: i32) -> EcsEhm4Iter {
    return EcsEhm4Iter { entries: Vec::new(), front: 0, back: 0, debug_kind: debug_kind, trusted_unique: trusted_unique, mutable_view: 0, inner_exposed: 0 };
}

fn ecs_ehm4_iter_clone(iter: EcsEhm4Iter) -> EcsEhm4Iter {
    return EcsEhm4Iter { entries: iter.entries, front: iter.front, back: iter.back, debug_kind: iter.debug_kind, trusted_unique: iter.trusted_unique, mutable_view: iter.mutable_view, inner_exposed: iter.inner_exposed };
}

fn ecs_ehm4_iter_into_inner(iter: EcsEhm4Iter) -> EcsEhm4Iter {
    return EcsEhm4Iter { entries: iter.entries, front: iter.front, back: iter.back, debug_kind: iter.debug_kind, trusted_unique: iter.trusted_unique, mutable_view: iter.mutable_view, inner_exposed: 1 };
}

fn ecs_ehm4_iter_next(iter: EcsEhm4Iter) -> EcsEhm4NextResult {
    if iter.front >= iter.back { return EcsEhm4NextResult { iter: iter, has: 0, key: -1, value: 0 }; };
    let pair = iter.entries[iter.front];
    iter.front = iter.front + 1;
    return EcsEhm4NextResult { iter: iter, has: 1, key: pair.key, value: pair.value };
}

fn ecs_ehm4_key_next(iter: EcsEhm4Iter) -> EcsEhm4KeyResult {
    if iter.front >= iter.back { return EcsEhm4KeyResult { iter: iter, has: 0, key: -1 }; };
    let pair = iter.entries[iter.front];
    iter.front = iter.front + 1;
    return EcsEhm4KeyResult { iter: iter, has: 1, key: pair.key };
}
