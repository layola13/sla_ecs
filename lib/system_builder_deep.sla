// Deepened Bevy ECS system::builder surface (flattened for SLA stability).
// Mirrors src/system/builder.rs BuilderSystemInner: Uninitialized/Initialized/Invalid,
// initialize transition, run_unsafe panic if uninit, deferred no-op when uninit,
// Option/Result/If/ParamSet/Local/Dyn builders.

const ECS_BS_UNINITIALIZED: i32 = 0;
const ECS_BS_INITIALIZED: i32 = 1;
const ECS_BS_INVALID: i32 = 2;

const ECS_PB_DEEP_OF: i32 = 0;
const ECS_PB_DEEP_RESOURCE: i32 = 1;
const ECS_PB_DEEP_RESOURCE_MUT: i32 = 2;
const ECS_PB_DEEP_LOCAL: i32 = 3;
const ECS_PB_DEEP_QUERY: i32 = 4;
const ECS_PB_DEEP_QUERY_FILTERED: i32 = 5;
const ECS_PB_DEEP_OPTION: i32 = 6;
const ECS_PB_DEEP_RESULT: i32 = 7;
const ECS_PB_DEEP_IF: i32 = 8;
const ECS_PB_DEEP_PARAM_SET: i32 = 9;
const ECS_PB_DEEP_DYN: i32 = 10;
const ECS_PB_DEEP_FILTERED_RES: i32 = 11;
const ECS_PB_DEEP_FILTERED_RES_MUT: i32 = 12;

struct EcsParamBuilderDeep {
    kind: i32,
    type_id: i64,
    filter_id: i64,
    local_initial: i64,
    inner_kind: i32,
    inner_type_id: i64,
    set_count: i64,
    read_count: i64,
    write_count: i64,
}

fn ecs_param_builder_deep_of(type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_OF, type_id: type_id, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_resource(type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_RESOURCE, type_id: type_id, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_resource_mut(type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_RESOURCE_MUT, type_id: type_id, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_local(type_id: i64, initial: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_LOCAL, type_id: type_id, filter_id: 0, local_initial: initial,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_query(type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_QUERY, type_id: type_id, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_query_filtered(type_id: i64, filter_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_QUERY_FILTERED, type_id: type_id, filter_id: filter_id, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_option(inner_kind: i32, inner_type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_OPTION, type_id: inner_type_id, filter_id: 0, local_initial: 0,
        inner_kind: inner_kind, inner_type_id: inner_type_id, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_result(inner_kind: i32, inner_type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_RESULT, type_id: inner_type_id, filter_id: 0, local_initial: 0,
        inner_kind: inner_kind, inner_type_id: inner_type_id, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_if(inner_kind: i32, inner_type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_IF, type_id: inner_type_id, filter_id: 0, local_initial: 0,
        inner_kind: inner_kind, inner_type_id: inner_type_id, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_param_set(count: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_PARAM_SET, type_id: 0, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: count, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_dyn(inner_kind: i32, inner_type_id: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_DYN, type_id: inner_type_id, filter_id: 0, local_initial: 0,
        inner_kind: inner_kind, inner_type_id: inner_type_id, set_count: 0, read_count: 0, write_count: 0,
    };
}

fn ecs_param_builder_deep_filtered_res(reads: i64, writes: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_FILTERED_RES, type_id: 0, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: reads, write_count: writes,
    };
}

fn ecs_param_builder_deep_filtered_res_mut(reads: i64, writes: i64) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: ECS_PB_DEEP_FILTERED_RES_MUT, type_id: 0, filter_id: 0, local_initial: 0,
        inner_kind: 0, inner_type_id: 0, set_count: 0, read_count: reads, write_count: writes,
    };
}

fn ecs_param_builder_deep_kind(b: EcsParamBuilderDeep) -> i32 { return b.kind; }
fn ecs_param_builder_deep_type_id(b: EcsParamBuilderDeep) -> i64 { return b.type_id; }
fn ecs_param_builder_deep_filter_id(b: EcsParamBuilderDeep) -> i64 { return b.filter_id; }
fn ecs_param_builder_deep_local_initial(b: EcsParamBuilderDeep) -> i64 { return b.local_initial; }
fn ecs_param_builder_deep_inner_kind(b: EcsParamBuilderDeep) -> i32 { return b.inner_kind; }
fn ecs_param_builder_deep_set_count(b: EcsParamBuilderDeep) -> i64 { return b.set_count; }
fn ecs_param_builder_deep_read_count(b: EcsParamBuilderDeep) -> i64 { return b.read_count; }
fn ecs_param_builder_deep_write_count(b: EcsParamBuilderDeep) -> i64 { return b.write_count; }

// Flattened access derivation without recursion into structs
fn ecs_pb_kind_access_reads(kind: i32, set_count: i64, read_count: i64, write_count: i64) -> i64 {
    if kind == ECS_PB_DEEP_RESOURCE { return 1; };
    if kind == ECS_PB_DEEP_RESOURCE_MUT { return 0; };
    if kind == ECS_PB_DEEP_QUERY { return 1; };
    if kind == ECS_PB_DEEP_QUERY_FILTERED { return 1; };
    if kind == ECS_PB_DEEP_FILTERED_RES { return read_count; };
    if kind == ECS_PB_DEEP_FILTERED_RES_MUT { return read_count; };
    if kind == ECS_PB_DEEP_PARAM_SET { return set_count; };
    if kind == ECS_PB_DEEP_OF { return 0; };
    if kind == ECS_PB_DEEP_LOCAL { return 0; };
    return 0;
}

fn ecs_pb_kind_access_writes(kind: i32, write_count: i64) -> i64 {
    if kind == ECS_PB_DEEP_RESOURCE_MUT { return 1; };
    if kind == ECS_PB_DEEP_FILTERED_RES { return write_count; };
    if kind == ECS_PB_DEEP_FILTERED_RES_MUT { return write_count; };
    return 0;
}

fn ecs_param_builder_deep_build_access(b: EcsParamBuilderDeep) -> (i64, i64, i32) {
    let kind = b.kind;
    // unwrap wrappers once
    if kind == ECS_PB_DEEP_OPTION || kind == ECS_PB_DEEP_RESULT || kind == ECS_PB_DEEP_IF || kind == ECS_PB_DEEP_DYN {
        kind = b.inner_kind;
    };
    let reads = ecs_pb_kind_access_reads(kind, b.set_count, b.read_count, b.write_count);
    let writes = ecs_pb_kind_access_writes(kind, b.write_count);
    return (reads, writes, 0);
}

// Flat BuilderSystem: no nested FunctionSystem struct assignment
struct EcsBuilderSystemDeep {
    state: i32,
    builder_kind: i32,
    builder_type_id: i64,
    builder_filter_id: i64,
    builder_local_initial: i64,
    builder_inner_kind: i32,
    builder_inner_type_id: i64,
    builder_set_count: i64,
    builder_read_count: i64,
    builder_write_count: i64,
    func_id: i64,
    name_id: i64,
    meta_flags: i32,
    meta_last_run: i64,
    // initialized system fields
    sys_flags: i32,
    sys_last_run: i64,
    sys_access_reads: i64,
    sys_access_writes: i64,
    sys_deferred: i64,
    sys_run_count: i64,
    last_error: i32,
}

fn ecs_builder_system_deep_new(builder: EcsParamBuilderDeep, func_id: i64, name_id: i64) -> EcsBuilderSystemDeep {
    return EcsBuilderSystemDeep {
        state: ECS_BS_UNINITIALIZED,
        builder_kind: builder.kind,
        builder_type_id: builder.type_id,
        builder_filter_id: builder.filter_id,
        builder_local_initial: builder.local_initial,
        builder_inner_kind: builder.inner_kind,
        builder_inner_type_id: builder.inner_type_id,
        builder_set_count: builder.set_count,
        builder_read_count: builder.read_count,
        builder_write_count: builder.write_count,
        func_id: func_id,
        name_id: name_id,
        meta_flags: 0,
        meta_last_run: 0,
        sys_flags: 0,
        sys_last_run: 0,
        sys_access_reads: 0,
        sys_access_writes: 0,
        sys_deferred: 0,
        sys_run_count: 0,
        last_error: 0,
    };
}

fn ecs_builder_system_deep_builder(s: EcsBuilderSystemDeep) -> EcsParamBuilderDeep {
    return EcsParamBuilderDeep {
        kind: s.builder_kind,
        type_id: s.builder_type_id,
        filter_id: s.builder_filter_id,
        local_initial: s.builder_local_initial,
        inner_kind: s.builder_inner_kind,
        inner_type_id: s.builder_inner_type_id,
        set_count: s.builder_set_count,
        read_count: s.builder_read_count,
        write_count: s.builder_write_count,
    };
}

fn ecs_builder_system_deep_state(s: EcsBuilderSystemDeep) -> i32 { return s.state; }
fn ecs_builder_system_deep_is_uninitialized(s: EcsBuilderSystemDeep) -> bool { return s.state == ECS_BS_UNINITIALIZED; }
fn ecs_builder_system_deep_is_initialized(s: EcsBuilderSystemDeep) -> bool { return s.state == ECS_BS_INITIALIZED; }
fn ecs_builder_system_deep_is_invalid(s: EcsBuilderSystemDeep) -> bool { return s.state == ECS_BS_INVALID; }

fn ecs_builder_system_deep_name(s: EcsBuilderSystemDeep) -> (bool, i64) {
    if s.state == ECS_BS_INVALID { return (false, -1); };
    return (true, s.name_id);
}

fn ecs_builder_system_deep_flags(s: EcsBuilderSystemDeep) -> (bool, i32) {
    if s.state == ECS_BS_INVALID { return (false, 0); };
    if s.state == ECS_BS_INITIALIZED { return (true, s.sys_flags); };
    return (true, s.meta_flags);
}

fn ecs_builder_system_deep_get_last_run(s: EcsBuilderSystemDeep) -> (bool, i64) {
    if s.state == ECS_BS_INVALID { return (false, -1); };
    if s.state == ECS_BS_INITIALIZED { return (true, s.sys_last_run); };
    return (true, s.meta_last_run);
}

fn ecs_builder_system_deep_set_last_run(s: EcsBuilderSystemDeep, tick: i64) -> EcsBuilderSystemDeep {
    if s.state == ECS_BS_INITIALIZED {
        s.sys_last_run = tick;
    } else {
        if s.state == ECS_BS_UNINITIALIZED {
            s.meta_last_run = tick;
        };
    };
    return s;
}

fn ecs_builder_system_deep_set_meta_flags(s: EcsBuilderSystemDeep, flags: i32) -> EcsBuilderSystemDeep {
    s.meta_flags = flags;
    return s;
}

fn ecs_builder_system_deep_run_unsafe(s: EcsBuilderSystemDeep) -> EcsBuilderSystemDeep {
    if s.state == ECS_BS_UNINITIALIZED {
        s.last_error = 1;
        return s;
    };
    if s.state == ECS_BS_INVALID {
        s.last_error = 2;
        return s;
    };
    s.sys_run_count = s.sys_run_count + 1;
    s.last_error = 0;
    return s;
}

fn ecs_builder_system_deep_last_error(s: EcsBuilderSystemDeep) -> i32 { return s.last_error; }
fn ecs_builder_system_deep_run_ok(s: EcsBuilderSystemDeep) -> bool { return s.last_error == 0; }


fn ecs_builder_system_deep_apply_deferred(s: EcsBuilderSystemDeep) -> EcsBuilderSystemDeep {
    if s.state == ECS_BS_INITIALIZED { s.sys_deferred = 0; };
    return s;
}

fn ecs_builder_system_deep_queue_deferred(s: EcsBuilderSystemDeep, n: i64) -> EcsBuilderSystemDeep {
    if s.state == ECS_BS_INITIALIZED { s.sys_deferred = s.sys_deferred + n; };
    return s;
}

fn ecs_builder_system_deep_check_change_tick(s: EcsBuilderSystemDeep) -> EcsBuilderSystemDeep {
    return s;
}

fn ecs_builder_system_deep_initialize(s: EcsBuilderSystemDeep) -> EcsBuilderSystemDeep {
    if s.state == ECS_BS_INVALID {
        s.last_error = 2;
        return s;
    };
    let b = ecs_builder_system_deep_builder(s);
    let acc = ecs_param_builder_deep_build_access(b);
    s.sys_access_reads = acc.0;
    s.sys_access_writes = acc.1;
    s.sys_flags = s.meta_flags | acc.2;
    if s.state == ECS_BS_UNINITIALIZED {
        s.sys_last_run = s.meta_last_run;
    };
    s.state = ECS_BS_INITIALIZED;
    s.last_error = 0;
    return s;
}

fn ecs_builder_system_deep_force_invalid(s: EcsBuilderSystemDeep) -> EcsBuilderSystemDeep {
    s.state = ECS_BS_INVALID;
    return s;
}

fn ecs_into_builder_system_deep_into(builder: EcsParamBuilderDeep, func_id: i64, name_id: i64) -> EcsBuilderSystemDeep {
    return ecs_builder_system_deep_new(builder, func_id, name_id);
}

fn ecs_param_builder_deep_build_system(builder: EcsParamBuilderDeep, func_id: i64, name_id: i64) -> EcsBuilderSystemDeep {
    return ecs_builder_system_deep_new(builder, func_id, name_id);
}

struct EcsSystemStateDeep {
    ready: bool,
    builder_kind: i32,
    builder_type_id: i64,
    builder_filter_id: i64,
    builder_local_initial: i64,
    builder_inner_kind: i32,
    builder_inner_type_id: i64,
    builder_set_count: i64,
    builder_read_count: i64,
    builder_write_count: i64,
    world_id: i64,
}

fn ecs_param_builder_deep_build_state(builder: EcsParamBuilderDeep, world_id: i64) -> EcsSystemStateDeep {
    return EcsSystemStateDeep {
        ready: true,
        builder_kind: builder.kind,
        builder_type_id: builder.type_id,
        builder_filter_id: builder.filter_id,
        builder_local_initial: builder.local_initial,
        builder_inner_kind: builder.inner_kind,
        builder_inner_type_id: builder.inner_type_id,
        builder_set_count: builder.set_count,
        builder_read_count: builder.read_count,
        builder_write_count: builder.write_count,
        world_id: world_id,
    };
}

fn ecs_system_state_deep_ready(s: EcsSystemStateDeep) -> bool { return s.ready; }
fn ecs_system_state_deep_world_id(s: EcsSystemStateDeep) -> i64 { return s.world_id; }

fn ecs_system_state_deep_build_system(state: EcsSystemStateDeep, func_id: i64, name_id: i64) -> EcsBuilderSystemDeep {
    let b = EcsParamBuilderDeep {
        kind: state.builder_kind,
        type_id: state.builder_type_id,
        filter_id: state.builder_filter_id,
        local_initial: state.builder_local_initial,
        inner_kind: state.builder_inner_kind,
        inner_type_id: state.builder_inner_type_id,
        set_count: state.builder_set_count,
        read_count: state.builder_read_count,
        write_count: state.builder_write_count,
    };
    let s = ecs_builder_system_deep_new(b, func_id, name_id);
    return ecs_builder_system_deep_initialize(s);
}

fn ecs_query_param_builder_deep_new(closure_id: i64) -> EcsParamBuilderDeep {
    return ecs_param_builder_deep_query(closure_id);
}

fn ecs_query_param_builder_deep_new_box(closure_id: i64) -> EcsParamBuilderDeep {
    return ecs_param_builder_deep_query(closure_id);
}

fn ecs_local_builder_deep_value(b: EcsParamBuilderDeep) -> i64 { return b.local_initial; }

struct EcsParamSetBuilderDeep {
    count: i64,
}

fn ecs_param_set_builder_deep_new() -> EcsParamSetBuilderDeep {
    return EcsParamSetBuilderDeep { count: 0 };
}

fn ecs_param_set_builder_deep_add(p: EcsParamSetBuilderDeep, b: EcsParamBuilderDeep) -> EcsParamSetBuilderDeep {
    p.count = p.count + 1;
    let _ = b;
    return p;
}

fn ecs_param_set_builder_deep_len(p: EcsParamSetBuilderDeep) -> i64 { return p.count; }

fn ecs_param_set_builder_deep_into_param_builder(p: EcsParamSetBuilderDeep) -> EcsParamBuilderDeep {
    return ecs_param_builder_deep_param_set(p.count);
}

fn ecs_builder_system_deep_system_run_count(s: EcsBuilderSystemDeep) -> i64 {
    if s.state != ECS_BS_INITIALIZED { return -1; };
    return s.sys_run_count;
}

fn ecs_builder_system_deep_system_access_reads(s: EcsBuilderSystemDeep) -> i64 {
    if s.state != ECS_BS_INITIALIZED { return -1; };
    return s.sys_access_reads;
}

fn ecs_builder_system_deep_system_access_writes(s: EcsBuilderSystemDeep) -> i64 {
    if s.state != ECS_BS_INITIALIZED { return -1; };
    return s.sys_access_writes;
}

fn ecs_builder_system_deep_system_deferred(s: EcsBuilderSystemDeep) -> i64 {
    if s.state != ECS_BS_INITIALIZED { return -1; };
    return s.sys_deferred;
}

fn ecs_builder_system_deep_builder_kind(s: EcsBuilderSystemDeep) -> i32 { return s.builder_kind; }
fn ecs_builder_system_deep_func_id(s: EcsBuilderSystemDeep) -> i64 { return s.func_id; }
