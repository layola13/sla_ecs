// Deepened Bevy ECS world error surface.
// Mirrors src/world/error.rs:
//   TryRunScheduleError, TryInsertBatchError, EntityDespawnError,
//   EntityComponentError, EntityMutableFetchError, ResourceFetchError,
//   EntityNotSpawnedError (source for despawn/mutable fetch).
// Shallow fragments live in lib/unsafe_world_cell.sla; kept separate.
// Fixed capacity: 4 entities in TryInsertBatchError.

const ECS_WE_ENTITY_NOT_SPAWNED: i32 = 1;

const ECS_WE_COMP_MISSING: i32 = 0;
const ECS_WE_COMP_ALIASED: i32 = 1;

const ECS_WE_MUT_NOT_SPAWNED: i32 = 0;
const ECS_WE_MUT_ALIASED: i32 = 1;

const ECS_WE_RES_NOT_REGISTERED: i32 = 0;
const ECS_WE_RES_DOES_NOT_EXIST: i32 = 1;
const ECS_WE_RES_NO_ACCESS: i32 = 2;
const ECS_WE_RES_IMMUTABLE: i32 = 3;

// EntityNotSpawnedError
struct EcsWeEntityNotSpawnedDeep {
    entity: i64,
}

fn ecs_we_entity_not_spawned_new(entity: i64) -> EcsWeEntityNotSpawnedDeep {
    return EcsWeEntityNotSpawnedDeep { entity: entity };
}
fn ecs_we_entity_not_spawned_entity(e: EcsWeEntityNotSpawnedDeep) -> i64 { return e.entity; }
fn ecs_we_entity_not_spawned_code() -> i32 { return ECS_WE_ENTITY_NOT_SPAWNED; }

// TryRunScheduleError
struct EcsWeTryRunScheduleDeep {
    schedule_label: i32,
}

fn ecs_we_try_run_schedule_new(label: i32) -> EcsWeTryRunScheduleDeep {
    return EcsWeTryRunScheduleDeep { schedule_label: label };
}
fn ecs_we_try_run_schedule_label(e: EcsWeTryRunScheduleDeep) -> i32 { return e.schedule_label; }

// TryInsertBatchError
struct EcsWeTryInsertBatchDeep {
    bundle_type_id: i32,
    len: i32,
    e0: i64, e1: i64, e2: i64, e3: i64,
}

fn ecs_we_try_insert_batch_new(bundle_type_id: i32) -> EcsWeTryInsertBatchDeep {
    return EcsWeTryInsertBatchDeep {
        bundle_type_id: bundle_type_id, len: 0, e0: 0, e1: 0, e2: 0, e3: 0,
    };
}
fn ecs_we_try_insert_batch_bundle_type(e: EcsWeTryInsertBatchDeep) -> i32 { return e.bundle_type_id; }
fn ecs_we_try_insert_batch_len(e: EcsWeTryInsertBatchDeep) -> i32 { return e.len; }
fn ecs_we_try_insert_batch_entity_at(e: EcsWeTryInsertBatchDeep, idx: i32) -> i64 {
    if idx == 0 { return e.e0; };
    if idx == 1 { return e.e1; };
    if idx == 2 { return e.e2; };
    if idx == 3 { return e.e3; };
    return 0;
}
fn ecs_we_try_insert_batch_push(e: EcsWeTryInsertBatchDeep, entity: i64) -> EcsWeTryInsertBatchDeep {
    if e.len >= 4 { return e; };
    if e.len == 0 {
        return EcsWeTryInsertBatchDeep {
            bundle_type_id: e.bundle_type_id, len: 1, e0: entity, e1: e.e1, e2: e.e2, e3: e.e3,
        };
    };
    if e.len == 1 {
        return EcsWeTryInsertBatchDeep {
            bundle_type_id: e.bundle_type_id, len: 2, e0: e.e0, e1: entity, e2: e.e2, e3: e.e3,
        };
    };
    if e.len == 2 {
        return EcsWeTryInsertBatchDeep {
            bundle_type_id: e.bundle_type_id, len: 3, e0: e.e0, e1: e.e1, e2: entity, e3: e.e3,
        };
    };
    return EcsWeTryInsertBatchDeep {
        bundle_type_id: e.bundle_type_id, len: 4, e0: e.e0, e1: e.e1, e2: e.e2, e3: entity,
    };
}
fn ecs_we_try_insert_batch_is_empty(e: EcsWeTryInsertBatchDeep) -> bool {
    if e.len == 0 { return true; };
    return false;
}

// EntityDespawnError wraps EntityNotSpawnedError
struct EcsWeEntityDespawnDeep {
    entity: i64,
}

fn ecs_we_entity_despawn_from_not_spawned(src: EcsWeEntityNotSpawnedDeep) -> EcsWeEntityDespawnDeep {
    return EcsWeEntityDespawnDeep { entity: src.entity };
}
fn ecs_we_entity_despawn_new(entity: i64) -> EcsWeEntityDespawnDeep {
    return EcsWeEntityDespawnDeep { entity: entity };
}
fn ecs_we_entity_despawn_entity(e: EcsWeEntityDespawnDeep) -> i64 { return e.entity; }
fn ecs_we_entity_despawn_as_not_spawned(e: EcsWeEntityDespawnDeep) -> EcsWeEntityNotSpawnedDeep {
    return EcsWeEntityNotSpawnedDeep { entity: e.entity };
}

// EntityComponentError
struct EcsWeEntityComponentDeep {
    kind: i32,
    component_id: i32,
}

fn ecs_we_entity_component_missing(cid: i32) -> EcsWeEntityComponentDeep {
    return EcsWeEntityComponentDeep { kind: ECS_WE_COMP_MISSING, component_id: cid };
}
fn ecs_we_entity_component_aliased(cid: i32) -> EcsWeEntityComponentDeep {
    return EcsWeEntityComponentDeep { kind: ECS_WE_COMP_ALIASED, component_id: cid };
}
fn ecs_we_entity_component_kind(e: EcsWeEntityComponentDeep) -> i32 { return e.kind; }
fn ecs_we_entity_component_id(e: EcsWeEntityComponentDeep) -> i32 { return e.component_id; }
fn ecs_we_entity_component_is_missing(e: EcsWeEntityComponentDeep) -> bool {
    if e.kind == ECS_WE_COMP_MISSING { return true; };
    return false;
}
fn ecs_we_entity_component_is_aliased(e: EcsWeEntityComponentDeep) -> bool {
    if e.kind == ECS_WE_COMP_ALIASED { return true; };
    return false;
}
fn ecs_we_entity_component_eq(a: EcsWeEntityComponentDeep, b: EcsWeEntityComponentDeep) -> bool {
    if a.kind != b.kind { return false; };
    if a.component_id != b.component_id { return false; };
    return true;
}

// EntityMutableFetchError
struct EcsWeEntityMutableFetchDeep {
    kind: i32,
    entity: i64,
}

fn ecs_we_entity_mutable_not_spawned(entity: i64) -> EcsWeEntityMutableFetchDeep {
    return EcsWeEntityMutableFetchDeep { kind: ECS_WE_MUT_NOT_SPAWNED, entity: entity };
}
fn ecs_we_entity_mutable_from_not_spawned(src: EcsWeEntityNotSpawnedDeep) -> EcsWeEntityMutableFetchDeep {
    return EcsWeEntityMutableFetchDeep { kind: ECS_WE_MUT_NOT_SPAWNED, entity: src.entity };
}
fn ecs_we_entity_mutable_aliased(entity: i64) -> EcsWeEntityMutableFetchDeep {
    return EcsWeEntityMutableFetchDeep { kind: ECS_WE_MUT_ALIASED, entity: entity };
}
fn ecs_we_entity_mutable_kind(e: EcsWeEntityMutableFetchDeep) -> i32 { return e.kind; }
fn ecs_we_entity_mutable_entity(e: EcsWeEntityMutableFetchDeep) -> i64 { return e.entity; }
fn ecs_we_entity_mutable_is_not_spawned(e: EcsWeEntityMutableFetchDeep) -> bool {
    if e.kind == ECS_WE_MUT_NOT_SPAWNED { return true; };
    return false;
}
fn ecs_we_entity_mutable_is_aliased(e: EcsWeEntityMutableFetchDeep) -> bool {
    if e.kind == ECS_WE_MUT_ALIASED { return true; };
    return false;
}
fn ecs_we_entity_mutable_eq(a: EcsWeEntityMutableFetchDeep, b: EcsWeEntityMutableFetchDeep) -> bool {
    if a.kind != b.kind { return false; };
    if a.entity != b.entity { return false; };
    return true;
}

// ResourceFetchError
struct EcsWeResourceFetchDeep {
    kind: i32,
    component_id: i32,
}

fn ecs_we_resource_not_registered() -> EcsWeResourceFetchDeep {
    return EcsWeResourceFetchDeep { kind: ECS_WE_RES_NOT_REGISTERED, component_id: 0 };
}
fn ecs_we_resource_does_not_exist(cid: i32) -> EcsWeResourceFetchDeep {
    return EcsWeResourceFetchDeep { kind: ECS_WE_RES_DOES_NOT_EXIST, component_id: cid };
}
fn ecs_we_resource_no_access(cid: i32) -> EcsWeResourceFetchDeep {
    return EcsWeResourceFetchDeep { kind: ECS_WE_RES_NO_ACCESS, component_id: cid };
}
fn ecs_we_resource_immutable(cid: i32) -> EcsWeResourceFetchDeep {
    return EcsWeResourceFetchDeep { kind: ECS_WE_RES_IMMUTABLE, component_id: cid };
}
fn ecs_we_resource_kind(e: EcsWeResourceFetchDeep) -> i32 { return e.kind; }
fn ecs_we_resource_component_id(e: EcsWeResourceFetchDeep) -> i32 { return e.component_id; }
fn ecs_we_resource_is_not_registered(e: EcsWeResourceFetchDeep) -> bool {
    if e.kind == ECS_WE_RES_NOT_REGISTERED { return true; };
    return false;
}
fn ecs_we_resource_is_does_not_exist(e: EcsWeResourceFetchDeep) -> bool {
    if e.kind == ECS_WE_RES_DOES_NOT_EXIST { return true; };
    return false;
}
fn ecs_we_resource_is_no_access(e: EcsWeResourceFetchDeep) -> bool {
    if e.kind == ECS_WE_RES_NO_ACCESS { return true; };
    return false;
}
fn ecs_we_resource_is_immutable(e: EcsWeResourceFetchDeep) -> bool {
    if e.kind == ECS_WE_RES_IMMUTABLE { return true; };
    return false;
}
fn ecs_we_resource_eq(a: EcsWeResourceFetchDeep, b: EcsWeResourceFetchDeep) -> bool {
    if a.kind != b.kind { return false; };
    if a.component_id != b.component_id { return false; };
    return true;
}

// Classify helpers used by world API surfaces
fn ecs_we_classify_entity_lookup(spawned: bool, entity: i64) -> EcsWeEntityMutableFetchDeep {
    if spawned != true {
        return ecs_we_entity_mutable_not_spawned(entity);
    };
    // successful lookup is not an error; callers check is_not_spawned
    return EcsWeEntityMutableFetchDeep { kind: -1, entity: entity };
}

fn ecs_we_classify_resource_mut(registered: bool, exists: bool, has_access: bool, is_mutable: bool, cid: i32) -> EcsWeResourceFetchDeep {
    if registered != true { return ecs_we_resource_not_registered(); };
    if exists != true { return ecs_we_resource_does_not_exist(cid); };
    if has_access != true { return ecs_we_resource_no_access(cid); };
    if is_mutable != true { return ecs_we_resource_immutable(cid); };
    return EcsWeResourceFetchDeep { kind: -1, component_id: cid };
}

fn ecs_we_resource_classify_is_ok(e: EcsWeResourceFetchDeep) -> bool {
    if e.kind == -1 { return true; };
    return false;
}
fn ecs_we_entity_mutable_classify_is_ok(e: EcsWeEntityMutableFetchDeep) -> bool {
    if e.kind == -1 { return true; };
    return false;
}
