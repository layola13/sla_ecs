// Deepened Bevy ECS query Access ops (component set + access conflicts).
// Mirrors src/query/access.rs residual. Fixed bit ids 0..15 via bitset i32.
// Shallow lib/query_access_ops.sla retained.

// Component set as bit mask (ids 0..30)
struct EcsCsetDeep {
    bits: i32,
    inverted: bool,
}

fn ecs_cset_deep_new() -> EcsCsetDeep {
    return EcsCsetDeep { bits: 0, inverted: false };
}

fn ecs_cset_deep_inverted() -> EcsCsetDeep {
    return EcsCsetDeep { bits: 0, inverted: true };
}

fn ecs_cset_deep_insert(s: EcsCsetDeep, id: i32) -> EcsCsetDeep {
    if id < 0 { return s; };
    if id > 30 { return s; };
    let mask = 1;
    let i = 0;
    // shift 1 << id via unrolled multiply-by-2 for small ids
    if id == 0 { mask = 1; };
    if id == 1 { mask = 2; };
    if id == 2 { mask = 4; };
    if id == 3 { mask = 8; };
    if id == 4 { mask = 16; };
    if id == 5 { mask = 32; };
    if id == 6 { mask = 64; };
    if id == 7 { mask = 128; };
    if id == 8 { mask = 256; };
    if id == 9 { mask = 512; };
    if id == 10 { mask = 1024; };
    if id == 11 { mask = 2048; };
    if id == 12 { mask = 4096; };
    if id == 13 { mask = 8192; };
    if id == 14 { mask = 16384; };
    if id == 15 { mask = 32768; };
    return EcsCsetDeep { bits: s.bits | mask, inverted: s.inverted };
}

fn ecs_cset_deep_mask(id: i32) -> i32 {
    if id == 0 { return 1; };
    if id == 1 { return 2; };
    if id == 2 { return 4; };
    if id == 3 { return 8; };
    if id == 4 { return 16; };
    if id == 5 { return 32; };
    if id == 6 { return 64; };
    if id == 7 { return 128; };
    if id == 8 { return 256; };
    if id == 9 { return 512; };
    if id == 10 { return 1024; };
    if id == 11 { return 2048; };
    if id == 12 { return 4096; };
    if id == 13 { return 8192; };
    if id == 14 { return 16384; };
    if id == 15 { return 32768; };
    return 0;
}

fn ecs_cset_deep_contains(s: EcsCsetDeep, id: i32) -> bool {
    let m = ecs_cset_deep_mask(id);
    if m == 0 { return false; };
    let has = (s.bits & m) != 0;
    if s.inverted { return has != true; };
    return has;
}

fn ecs_cset_deep_is_empty(s: EcsCsetDeep) -> bool {
    if s.inverted { return false; };
    return s.bits == 0;
}

fn ecs_cset_deep_is_clear(s: EcsCsetDeep) -> bool {
    return s.bits == 0;
}

fn ecs_cset_deep_union(a: EcsCsetDeep, b: EcsCsetDeep) -> EcsCsetDeep {
    return EcsCsetDeep { bits: a.bits | b.bits, inverted: false };
}

fn ecs_cset_deep_intersection(a: EcsCsetDeep, b: EcsCsetDeep) -> EcsCsetDeep {
    return EcsCsetDeep { bits: a.bits & b.bits, inverted: false };
}

fn ecs_cset_deep_difference(a: EcsCsetDeep, b: EcsCsetDeep) -> EcsCsetDeep {
    return EcsCsetDeep { bits: a.bits & (0 - 1 - b.bits), inverted: false };
}

fn ecs_cset_deep_is_subset(a: EcsCsetDeep, b: EcsCsetDeep) -> bool {
    return (a.bits & b.bits) == a.bits;
}

fn ecs_cset_deep_is_disjoint(a: EcsCsetDeep, b: EcsCsetDeep) -> bool {
    return (a.bits & b.bits) == 0;
}

fn ecs_cset_deep_bits(s: EcsCsetDeep) -> i32 { return s.bits; }

// Access ops
struct EcsAopsDeep {
    reads: i32,
    writes: i32,
}

fn ecs_aops_deep_new() -> EcsAopsDeep {
    return EcsAopsDeep { reads: 0, writes: 0 };
}

fn ecs_aops_deep_add_read(a: EcsAopsDeep, id: i32) -> EcsAopsDeep {
    let m = ecs_cset_deep_mask(id);
    return EcsAopsDeep { reads: a.reads | m, writes: a.writes };
}

fn ecs_aops_deep_add_write(a: EcsAopsDeep, id: i32) -> EcsAopsDeep {
    let m = ecs_cset_deep_mask(id);
    return EcsAopsDeep { reads: a.reads | m, writes: a.writes | m };
}

fn ecs_aops_deep_has_any_read(a: EcsAopsDeep) -> bool { return a.reads != 0; }
fn ecs_aops_deep_has_any_write(a: EcsAopsDeep) -> bool { return a.writes != 0; }
fn ecs_aops_deep_reads(a: EcsAopsDeep) -> i32 { return a.reads; }
fn ecs_aops_deep_writes(a: EcsAopsDeep) -> i32 { return a.writes; }

// conflicts: write of one intersects read/write of other
struct EcsAconfDeep {
    all: bool,
    bits: i32,
}

fn ecs_aconf_deep_empty() -> EcsAconfDeep {
    return EcsAconfDeep { all: false, bits: 0 };
}

fn ecs_aconf_deep_all() -> EcsAconfDeep {
    return EcsAconfDeep { all: true, bits: 0 };
}

fn ecs_aconf_deep_is_all(c: EcsAconfDeep) -> bool { return c.all; }
fn ecs_aconf_deep_is_empty(c: EcsAconfDeep) -> bool {
    if c.all { return false; };
    return c.bits == 0;
}

fn ecs_aconf_deep_bits(c: EcsAconfDeep) -> i32 { return c.bits; }

fn ecs_aops_deep_get_conflicts(a: EcsAopsDeep, b: EcsAopsDeep) -> EcsAconfDeep {
    // conflicts where a's writes hit b's reads/writes or b's writes hit a's reads/writes
    let c1 = a.writes & (b.reads | b.writes);
    let c2 = b.writes & (a.reads | a.writes);
    return EcsAconfDeep { all: false, bits: c1 | c2 };
}

fn ecs_aops_deep_extend(a: EcsAopsDeep, b: EcsAopsDeep) -> EcsAopsDeep {
    return EcsAopsDeep { reads: a.reads | b.reads, writes: a.writes | b.writes };
}

fn ecs_aops_deep_union(a: EcsAopsDeep, b: EcsAopsDeep) -> EcsAopsDeep {
    return ecs_aops_deep_extend(a, b);
}

struct EcsAopsInterDeep {
    reads: i32,
    writes: i32,
}

fn ecs_aops_deep_intersection(a: EcsAopsDeep, b: EcsAopsDeep) -> EcsAopsInterDeep {
    return EcsAopsInterDeep { reads: a.reads & b.reads, writes: a.writes & b.writes };
}

fn ecs_aops_inter_reads(r: EcsAopsInterDeep) -> i32 { return r.reads; }
fn ecs_aops_inter_writes(r: EcsAopsInterDeep) -> i32 { return r.writes; }
