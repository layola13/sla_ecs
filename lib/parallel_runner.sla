        let access_e = catalog.accesses[se];
        let sum = ecs_parallel_run_mut_quint_batch<R, M>(world, run_a, run_b, run_c, run_d, run_e, access_a, access_b, access_c, access_d, access_e);
        return ecs_parallel_catalog_complete_batch(plan, batch, sum, 5, skipped, true);
    };
    return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true);
