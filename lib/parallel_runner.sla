        let sg = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, g);
        if sg < 0 { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
        let sh = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, h);
        if sh < 0 { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
        let run_a = catalog.runs[sa];
