    while guard < limit {
        if ecs_executor_state_completed_count(p.executor.state) >= p.executor.state.system_count {
            return ecs_parallel_ready_batch_run_result(p, total_sum, total_ran, total_skipped, any_threads, false);
        };
        let before = ecs_executor_state_completed_count(p.executor.state);
