        let sd = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, d);
        if sd < 0 { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
        let se = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, e);
        if se < 0 { return ecs_parallel_ready_batch_run_result(plan, 0, 0, skipped, false, true); };
        let sf = ecs_parallel_fn_catalog_find_slot<R, M>(catalog, f);
