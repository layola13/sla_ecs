        let sum = ecs_parallel_run_mut_oct_batch<R, M>(world, run_a, run_b, run_c, run_d, run_e, run_f, run_g, run_h, access_a, access_b, access_c, access_d, access_e, access_f, access_g, access_h);
        return ecs_parallel_catalog_complete_batch(plan, batch, sum, 8, skipped, true);
