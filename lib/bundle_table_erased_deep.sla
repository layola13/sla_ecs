// ecs_bte_world_query_pair_auto: iterate Pos store; for each entity that ALSO has Vel emit a
// pair item. The shallow delegates to archetype-column machinery; this deep uses a direct
// Pos-iterative lookup against Vel since both are row-indexed typed stores. Returns EcsBtePairQuery.
fn ecs_bte_world_query_pair_auto(w: EcsBteWorld) -> EcsBtePairQuery {
    let q0 = EcsBtePairQuery { count: 0, ent_id0: 0, ent_id1: 0, ent_id2: 0, ent_id3: 0, ent_id4: 0, ent_id5: 0, ent_id6: 0, ent_id7: 0, ent_id8: 0, ent_id9: 0, ent_id10: 0, ent_id11: 0, ent_id12: 0, ent_id13: 0, ent_id14: 0, ent_id15: 0, a_x0: 0, a_x1: 0, a_x2: 0, a_x3: 0, a_x4: 0, a_x5: 0, a_x6: 0, a_x7: 0, a_x8: 0, a_x9: 0, a_x10: 0, a_x11: 0, a_x12: 0, a_x13: 0, a_x14: 0, a_x15: 0, a_y0: 0, a_y1: 0, a_y2: 0, a_y3: 0, a_y4: 0, a_y5: 0, a_y6: 0, a_y7: 0, a_y8: 0, a_y9: 0, a_y10: 0, a_y11: 0, a_y12: 0, a_y13: 0, a_y14: 0, a_y15: 0, b_x0: 0, b_x1: 0, b_x2: 0, b_x3: 0, b_x4: 0, b_x5: 0, b_x6: 0, b_x7: 0, b_x8: 0, b_x9: 0, b_x10: 0, b_x11: 0, b_x12: 0, b_x13: 0, b_x14: 0, b_x15: 0, b_y0: 0, b_y1: 0, b_y2: 0, b_y3: 0, b_y4: 0, b_y5: 0, b_y6: 0, b_y7: 0, b_y8: 0, b_y9: 0, b_y10: 0, b_y11: 0, b_y12: 0, b_y13: 0, b_y14: 0, b_y15: 0 };
    let i: i32 = 0;
    while i < w.pos_count {
        let eid = _ecs_bte_pos_eid_at(w, i);
        let gen = _ecs_bte_gen_at(w, eid);
        let e = EcsBteEntity { id: eid, generation: gen };
        if ecs_bte_is_alive(w, e) {
            let v_slot = _ecs_bte_vel_slot_of(w, eid);
            if v_slot >= 0 {
                let out = q0.count;
                q0 = _ecs_bte_q_set_ent_id(q0, out, eid);
                q0 = _ecs_bte_q_set_a_x(q0, out, _ecs_bte_pos_x_at(w, i));
                q0 = _ecs_bte_q_set_a_y(q0, out, _ecs_bte_pos_y_at(w, i));
                q0 = _ecs_bte_q_set_b_x(q0, out, _ecs_bte_vel_x_at(w, v_slot));
                q0 = _ecs_bte_q_set_b_y(q0, out, _ecs_bte_vel_y_at(w, v_slot));
                q0.count = out + 1;
            };
        };
        i = i + 1;
    }
    return q0;
}

// ecs_bte_world_get_dispatch / insert_auto_dispatch: routes by type_id (mirror shallow's
// `table_erased_world_get<T,R,M>(world, entity, comp_id, type_id)` and `insert_auto<T,R,M>(`.
fn ecs_bte_world_get_dispatch(w: EcsBteWorld, e: EcsBteEntity, type_id: i32) -> EcsBtePos {
    if type_id == ECS_BTE_POS_TYPE { return ecs_bte_world_get_pos(w, e); };
    panic(12570);
}
fn ecs_bte_world_get_vel_dispatch(w: EcsBteWorld, e: EcsBteEntity, type_id: i32) -> EcsBteVel {
    if type_id == ECS_BTE_VEL_TYPE { return ecs_bte_world_get_vel(w, e); };
    panic(12571);
}
fn ecs_bte_world_get_player_dispatch(w: EcsBteWorld, e: EcsBteEntity, type_id: i32) -> EcsBtePlayer {
    if type_id == ECS_BTE_PLAYER_TYPE { return ecs_bte_world_get_player(w, e); };
    panic(12572);
}

