// ── Entity-allocator slot accessors (gen / free_id / occ / arch). ─────────────────────
fn _ecs_bte_gen_at(w: EcsBteWorld, idx: i32) -> i32 {
    if idx == 0 { return w.gen0; };
    if idx == 1 { return w.gen1; };
    if idx == 2 { return w.gen2; };
    if idx == 3 { return w.gen3; };
    if idx == 4 { return w.gen4; };
    if idx == 5 { return w.gen5; };
    if idx == 6 { return w.gen6; };
    if idx == 7 { return w.gen7; };
    if idx == 8 { return w.gen8; };
    if idx == 9 { return w.gen9; };
    if idx == 10 { return w.gen10; };
    if idx == 11 { return w.gen11; };
    if idx == 12 { return w.gen12; };
    if idx == 13 { return w.gen13; };
    if idx == 14 { return w.gen14; };
    return w.gen15;
}

fn _ecs_bte_set_gen(w0: EcsBteWorld, idx: i32, value: i32) -> EcsBteWorld {
    if idx == 0 { w0.gen0 = value; return w0; };
    if idx == 1 { w0.gen1 = value; return w0; };
    if idx == 2 { w0.gen2 = value; return w0; };
    if idx == 3 { w0.gen3 = value; return w0; };
    if idx == 4 { w0.gen4 = value; return w0; };
    if idx == 5 { w0.gen5 = value; return w0; };
    if idx == 6 { w0.gen6 = value; return w0; };
    if idx == 7 { w0.gen7 = value; return w0; };
    if idx == 8 { w0.gen8 = value; return w0; };
    if idx == 9 { w0.gen9 = value; return w0; };
    if idx == 10 { w0.gen10 = value; return w0; };
    if idx == 11 { w0.gen11 = value; return w0; };
