// Deep bed for lib/bundle_table_erased.sla (Batch 392).
//
// Mirrors the shallow `lib/bundle_table_erased.sla` (349 lines, Bevy-style component bundles over
// `TableErasedWorld<R, M>`: bundle2/bundle3 sets inserted together) as a SELF-CONTAINED fixed-
// cap variant (NO `@import`). The shallow depends on `world_table_erased.sla` (deferred — large,
// uses generic `TableErasedWorld<R, M>` + boxed `ErasedComponentValue` + `drop_fn: fn(*u8) -> void`
// + Tables / sparse-set column machinery). This deep follows the Batch 387 #1 convention (erase
// the type-erased value box to a tagged i32 slot family; drop the generic type params <R, M>;
// drop the fn-pointer drop_fn — the deep's values are owned scalars so drop is a no-op) and the
// Batch 386/388-391 deep convention (Vec-backed mutable store → cap-N scalar slot families;
// `impl QueryIter { fn self }` method-call syntax → free functions; tuple returns → wrapper
// structs).
//
// Concrete typed plugs mirror the shallow's WORLD-3 register scenario exactly:
//   - storage_kind 0 = TABLE-backed (Bevy `Table` dense-row storage chosen by `register_table`):
//     PLUG Pos{x,y} at type_id 401, Vel{x,y} at type_id 402. Each table is a cap-16 dense store
//     keyed by row index, paralleled by an `entity_id[k]` lookup slot family so the component
//     row maps back to its World Entity.
//   - storage_kind 1 = SPARSE-SET-backed (Bevy `SparseSet` per-entity slot storage chosen by
//     `register_sparse_set`): PLUG Player{team} at type_id 403. Sparse-set is a cap-16
//     (entity_id[k], team[k]) slot family.
// The component registry is a cap-4 slot family (type_id[i], storage_kind[i], store_idx[i]) —
// the test registers exactly 3 components, so cap-4 leaves room for one extension (mirrors the
// shallow's `ComponentInfo { id, ... }` ComponentId allocation pattern where id == registry slot
// index). Entity allocator is cap-16 (slot 0 reserved; first id = 1, mirroring the shallow
// `dynamic_world3` allocator convention).
//
// Bundle surface mirrored: bundle2_new / bundle3_new (panic on duplicate type_id); insert_bundle2
// / insert_bundle3 (panic on duplicate-component-id collision after type→id resolution);
// insert_bundle2_if_new / insert_bundle3_if_new (drop_uninserted_bundle_value if entity already
// has the component, else insert); spawn_bundle2 / spawn_bundle3; spawn_batch_bundle2 /
// spawn_batch_bundle3 (Vec<BundleK> → cap-2 batch append); insert_batch_bundle2 /
// insert_batch_bundle3 (paired entities + bundles; panic on length mismatch);
// insert_batch_bundle2_if_new / insert_batch_bundle3_if_new.
//
// Query surface: query_pair_auto(A_type_id, B_type_id) returns a flat-scalar pair-query wrapper
// (count + per-item (entity_id, a_x, a_y, b_x, b_y)) iterating the smaller store to find paired
// entities; tests use while loops over the wrapper's count + per-index accessor (no for-in).
//
// Wrapper structs (Batch 373 rule — no tuple destructuring in tests): `EcsBteRegister{world,
// component_id}` (replaces `(World, ComponentInfo)` from registerComponent);
// `EcsBteSpawn{world, entity}` (replaces `(World, Entity)` from spawn / spawn_bundle2 /
// spawn_bundle3); `EcsBteSpawnBatch{world, count, entity_id0..}` (replaces
// `(World, Vec<Entity>)` from spawn_batch_bundle2 / spawn_batch_bundle3);
// `EcsBteBundle2{first_type_id, second_type_id, first_x, first_y, second_x, second_y}` and
// `EcsBteBundle3{...team}` (replaces shallow's `TableErasedBundle2 / 3` carrying
// `ErasedComponentValue` boxes — the deep folds each value into typed scalar pair; avoids generics
// `<A, B, C>` / `registry_erased_value_new<A>` and the boxed `ErasedComponentValue` entirely).
// `EcsBtePairQuery{count + a/b flat slot families}` (replaces `Query<TableErasedPair<A, B>>`).

// ── Caps. ─────────────────────────────────────────────────────────────────────────────
const ECS_BTE_ENTITY_CAP: i32 = 16;
const ECS_BTE_REGISTRY_CAP: i32 = 4;
const ECS_BTE_STORE_CAP: i32 = 16;
const ECS_BTE_BATCH_CAP: i32 = 2;

// ── Entity wrapper { id, generation }. ─────────────────────────────────────────────────
struct EcsBteEntity { id: i32, generation: i32 }
fn ecs_bte_entity_id(e: EcsBteEntity) -> i32 { return e.id; }
fn ecs_bte_entity_gen(e: EcsBteEntity) -> i32 { return e.generation; }
fn ecs_bte_entity_new(id: i32, gen: i32) -> EcsBteEntity { return EcsBteEntity { id: id, generation: gen }; }

// ── Concrete typed plugs (mirrors shallow type_id set 401/402/403). ─────────────────────
struct EcsBtePos { x: i32, y: i32 }
struct EcsBteVel { x: i32, y: i32 }
struct EcsBtePlayer { team: i32 }
struct EcsBteTime { tick: i32 }
struct EcsBteEvent { amount: i32 }
fn ecs_bte_pos_new(x: i32, y: i32) -> EcsBtePos { return EcsBtePos { x: x, y: y }; }
fn ecs_bte_pos_x(p: EcsBtePos) -> i32 { return p.x; }
fn ecs_bte_pos_y(p: EcsBtePos) -> i32 { return p.y; }
fn ecs_bte_vel_new(x: i32, y: i32) -> EcsBteVel { return EcsBteVel { x: x, y: y }; }
fn ecs_bte_vel_x(v: EcsBteVel) -> i32 { return v.x; }
fn ecs_bte_vel_y(v: EcsBteVel) -> i32 { return v.y; }
fn ecs_bte_player_new(t: i32) -> EcsBtePlayer { return EcsBtePlayer { team: t }; }
fn ecs_bte_player_team(p: EcsBtePlayer) -> i32 { return p.team; }
fn ecs_bte_time_new(t: i32) -> EcsBteTime { return EcsBteTime { tick: t }; }
fn ecs_bte_time_tick(t: EcsBteTime) -> i32 { return t.tick; }
fn ecs_bte_event_new(a: i32) -> EcsBteEvent { return EcsBteEvent { amount: a }; }
fn ecs_bte_event_amount(e: EcsBteEvent) -> i32 { return e.amount; }

// Type ids (mirror shallow's TABLE_ERASED_BUNDLE_*_TYPE).
const ECS_BTE_POS_TYPE: i32 = 401;
const ECS_BTE_VEL_TYPE: i32 = 402;
const ECS_BTE_PLAYER_TYPE: i32 = 403;
const ECS_BTE_TABLE_KIND: i32 = 0;
const ECS_BTE_SPARSE_KIND: i32 = 1;

// ── World: entity allocator (cap-16) + component registry (cap-4) +
//    three typed component stores (Pos table cap-16, Vel table cap-16, Player sparse cap-16) +
//    archetype_id per entity (cap-16).
struct EcsBteWorld {
    // entity allocator
    next_id: i32,
    free_count: i32,
    gen0: i32, gen1: i32, gen2: i32, gen3: i32, gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    gen8: i32, gen9: i32, gen10: i32, gen11: i32, gen12: i32, gen13: i32, gen14: i32, gen15: i32,
    free_id0: i32, free_id1: i32, free_id2: i32, free_id3: i32, free_id4: i32, free_id5: i32, free_id6: i32, free_id7: i32,
    free_id8: i32, free_id9: i32, free_id10: i32, free_id11: i32, free_id12: i32, free_id13: i32, free_id14: i32, free_id15: i32,
    occ0: i32, occ1: i32, occ2: i32, occ3: i32, occ4: i32, occ5: i32, occ6: i32, occ7: i32,
    occ8: i32, occ9: i32, occ10: i32, occ11: i32, occ12: i32, occ13: i32, occ14: i32, occ15: i32,
    // per-entity archetype_id (the shallow assigns >= 1 once an entity has any component; zero default)
    arch0: i32, arch1: i32, arch2: i32, arch3: i32, arch4: i32, arch5: i32, arch6: i32, arch7: i32,
    arch8: i32, arch9: i32, arch10: i32, arch11: i32, arch12: i32, arch13: i32, arch14: i32, arch15: i32,
    // component registry: cap-4 slots.
    reg_count: i32,
    reg_type0: i32, reg_type1: i32, reg_type2: i32, reg_type3: i32,
    reg_kind0: i32, reg_kind1: i32, reg_kind2: i32, reg_kind3: i32,
    reg_store0: i32, reg_store1: i32, reg_store2: i32, reg_store3: i32,
    // Pos table store (row-indexed cap-16): row slots 0..15 parallel to eid, value x/y.
    pos_count: i32,
    pos_eid0: i32, pos_eid1: i32, pos_eid2: i32, pos_eid3: i32, pos_eid4: i32, pos_eid5: i32, pos_eid6: i32, pos_eid7: i32,
    pos_eid8: i32, pos_eid9: i32, pos_eid10: i32, pos_eid11: i32, pos_eid12: i32, pos_eid13: i32, pos_eid14: i32, pos_eid15: i32,
    pos_x0: i32, pos_x1: i32, pos_x2: i32, pos_x3: i32, pos_x4: i32, pos_x5: i32, pos_x6: i32, pos_x7: i32,
    pos_x8: i32, pos_x9: i32, pos_x10: i32, pos_x11: i32, pos_x12: i32, pos_x13: i32, pos_x14: i32, pos_x15: i32,
    pos_y0: i32, pos_y1: i32, pos_y2: i32, pos_y3: i32, pos_y4: i32, pos_y5: i32, pos_y6: i32, pos_y7: i32,
    pos_y8: i32, pos_y9: i32, pos_y10: i32, pos_y11: i32, pos_y12: i32, pos_y13: i32, pos_y14: i32, pos_y15: i32,
    // Vel table store (row-indexed cap-16).
    vel_count: i32,
    vel_eid0: i32, vel_eid1: i32, vel_eid2: i32, vel_eid3: i32, vel_eid4: i32, vel_eid5: i32, vel_eid6: i32, vel_eid7: i32,
    vel_eid8: i32, vel_eid9: i32, vel_eid10: i32, vel_eid11: i32, vel_eid12: i32, vel_eid13: i32, vel_eid14: i32, vel_eid15: i32,
    vel_x0: i32, vel_x1: i32, vel_x2: i32, vel_x3: i32, vel_x4: i32, vel_x5: i32, vel_x6: i32, vel_x7: i32,
    vel_x8: i32, vel_x9: i32, vel_x10: i32, vel_x11: i32, vel_x12: i32, vel_x13: i32, vel_x14: i32, vel_x15: i32,
    vel_y0: i32, vel_y1: i32, vel_y2: i32, vel_y3: i32, vel_y4: i32, vel_y5: i32, vel_y6: i32, vel_y7: i32,
    vel_y8: i32, vel_y9: i32, vel_y10: i32, vel_y11: i32, vel_y12: i32, vel_y13: i32, vel_y14: i32, vel_y15: i32,
    // Player sparse-set store (cap-16): per-slot (eid, team).
    player_count: i32,
    player_eid0: i32, player_eid1: i32, player_eid2: i32, player_eid3: i32, player_eid4: i32, player_eid5: i32, player_eid6: i32, player_eid7: i32,
    player_eid8: i32, player_eid9: i32, player_eid10: i32, player_eid11: i32, player_eid12: i32, player_eid13: i32, player_eid14: i32, player_eid15: i32,
    player_team0: i32, player_team1: i32, player_team2: i32, player_team3: i32, player_team4: i32, player_team5: i32, player_team6: i32, player_team7: i32,
    player_team8: i32, player_team9: i32, player_team10: i32, player_team11: i32, player_team12: i32, player_team13: i32, player_team14: i32, player_team15: i32,
}

fn ecs_bte_world_new() -> EcsBteWorld {
    return EcsBteWorld {
        next_id: 1, free_count: 0,
        gen0: 0, gen1: 0, gen2: 0, gen3: 0, gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        gen8: 0, gen9: 0, gen10: 0, gen11: 0, gen12: 0, gen13: 0, gen14: 0, gen15: 0,
        free_id0: 0, free_id1: 0, free_id2: 0, free_id3: 0, free_id4: 0, free_id5: 0, free_id6: 0, free_id7: 0,
        free_id8: 0, free_id9: 0, free_id10: 0, free_id11: 0, free_id12: 0, free_id13: 0, free_id14: 0, free_id15: 0,
        occ0: 0, occ1: 0, occ2: 0, occ3: 0, occ4: 0, occ5: 0, occ6: 0, occ7: 0,
        occ8: 0, occ9: 0, occ10: 0, occ11: 0, occ12: 0, occ13: 0, occ14: 0, occ15: 0,
        arch0: 0, arch1: 0, arch2: 0, arch3: 0, arch4: 0, arch5: 0, arch6: 0, arch7: 0,
