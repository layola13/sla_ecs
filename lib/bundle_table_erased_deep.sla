    if idx == 8 { return EcsBteVel { x: q.b_x8, y: q.b_y8 }; };
    if idx == 9 { return EcsBteVel { x: q.b_x9, y: q.b_y9 }; };
    if idx == 10 { return EcsBteVel { x: q.b_x10, y: q.b_y10 }; };
    if idx == 11 { return EcsBteVel { x: q.b_x11, y: q.b_y11 }; };
    if idx == 12 { return EcsBteVel { x: q.b_x12, y: q.b_y12 }; };
    if idx == 13 { return EcsBteVel { x: q.b_x13, y: q.b_y13 }; };
    if idx == 14 { return EcsBteVel { x: q.b_x14, y: q.b_y14 }; };
    return EcsBteVel { x: q.b_x15, y: q.b_y15 };
}

fn _ecs_bte_q_set_ent_id(q0: EcsBtePairQuery, idx: i32, value: i32) -> EcsBtePairQuery {
    if idx == 0 { q0.ent_id0 = value; return q0; };
    if idx == 1 { q0.ent_id1 = value; return q0; };
    if idx == 2 { q0.ent_id2 = value; return q0; };
    if idx == 3 { q0.ent_id3 = value; return q0; };
    if idx == 4 { q0.ent_id4 = value; return q0; };
    if idx == 5 { q0.ent_id5 = value; return q0; };
    if idx == 6 { q0.ent_id6 = value; return q0; };
    if idx == 7 { q0.ent_id7 = value; return q0; };
    if idx == 8 { q0.ent_id8 = value; return q0; };
