fn _ecs_bte_set_reg_store(w0: EcsBteWorld, idx: i32, value: i32) -> EcsBteWorld {
    if idx == 0 { w0.reg_store0 = value; return w0; };
    if idx == 1 { w0.reg_store1 = value; return w0; };
    if idx == 2 { w0.reg_store2 = value; return w0; };
    w0.reg_store3 = value;
    return w0;
}

// ── Component registration. ───────────────────────────────────────────────────────────
struct EcsBteRegister { world: EcsBteWorld, component_id: i32 }
fn ecs_bte_register_world(r: EcsBteRegister) -> EcsBteWorld { return r.world; }
fn ecs_bte_register_component_id(r: EcsBteRegister) -> i32 { return r.component_id; }

// ecs_bte_world_register_component_metadata: allocate the next registry slot (cap-4); panic on cap.
// Mirrors shallow's register_table (kind=0) vs register_sparse_set (kind=1). component_id == reg slot.
fn ecs_bte_world_register_component_metadata(w0: EcsBteWorld, type_id: i32, storage_kind: i32) -> EcsBteRegister {
    if w0.reg_count >= ECS_BTE_REGISTRY_CAP { panic(12530); };
    if (storage_kind != ECS_BTE_TABLE_KIND) {
        if (storage_kind != ECS_BTE_SPARSE_KIND) { panic(12531); };
    };
    let slot = w0.reg_count;
    w0 = _ecs_bte_set_reg_type(w0, slot, type_id);
    w0 = _ecs_bte_set_reg_kind(w0, slot, storage_kind);
    w0 = _ecs_bte_set_reg_store(w0, slot, slot);
    w0.reg_count = slot + 1;
    return EcsBteRegister { world: w0, component_id: slot };
}

// ecs_bte_world_component_id_for_type: linear scan of registry matching type_id.
fn ecs_bte_world_component_id_for_type(w: EcsBteWorld, type_id: i32) -> i32 {
    let i: i32 = 0;
    while i < w.reg_count {
        if _ecs_bte_reg_type_at(w, i) == type_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_bte_world_kind_for_component(w: EcsBteWorld, component_id: i32) -> i32 { return _ecs_bte_reg_kind_at(w, component_id); }


