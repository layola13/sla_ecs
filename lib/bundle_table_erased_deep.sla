        pos_y8: 0, pos_y9: 0, pos_y10: 0, pos_y11: 0, pos_y12: 0, pos_y13: 0, pos_y14: 0, pos_y15: 0,
        vel_count: 0,
        vel_eid0: 0, vel_eid1: 0, vel_eid2: 0, vel_eid3: 0, vel_eid4: 0, vel_eid5: 0, vel_eid6: 0, vel_eid7: 0,
        vel_eid8: 0, vel_eid9: 0, vel_eid10: 0, vel_eid11: 0, vel_eid12: 0, vel_eid13: 0, vel_eid14: 0, vel_eid15: 0,
        vel_x0: 0, vel_x1: 0, vel_x2: 0, vel_x3: 0, vel_x4: 0, vel_x5: 0, vel_x6: 0, vel_x7: 0,
        vel_x8: 0, vel_x9: 0, vel_x10: 0, vel_x11: 0, vel_x12: 0, vel_x13: 0, vel_x14: 0, vel_x15: 0,
