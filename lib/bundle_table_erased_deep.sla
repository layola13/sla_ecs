    if idx == 9 { w0.arch9 = value; return w0; };
    if idx == 10 { w0.arch10 = value; return w0; };
    if idx == 11 { w0.arch11 = value; return w0; };
    if idx == 12 { w0.arch12 = value; return w0; };
    if idx == 13 { w0.arch13 = value; return w0; };
    if idx == 14 { w0.arch14 = value; return w0; };
    w0.arch15 = value;
    return w0;
}

// ── Entity allocator ops. ───────────────────────────────────────────────────────────
fn _ecs_bte_id_is_free(w: EcsBteWorld, id: i32) -> bool {
    let i: i32 = 0;
    while i < w.free_count {
        if _ecs_bte_free_id_at(w, i) == id { return true; };
        i = i + 1;
    }
    return false;
}

struct EcsBteSpawn { world: EcsBteWorld, entity: EcsBteEntity }
fn ecs_bte_spawn_world(s: EcsBteSpawn) -> EcsBteWorld { return s.world; }
fn ecs_bte_spawn_entity(s: EcsBteSpawn) -> EcsBteEntity { return s.entity; }

// ecs_bte_alloc_entity pops a free id (decrements free_count, clears slot) or bumps next_id;
// returns sentinel EcsBteEntity{id:-1,generation:0} at cap (NO panic per Batch 388/389/390/391 #2/#3).
fn ecs_bte_alloc_entity(w0: EcsBteWorld) -> EcsBteSpawn {
    if w0.free_count > 0 {
        let nfc = w0.free_count - 1;
        let id = _ecs_bte_free_id_at(w0, nfc);
        w0.free_count = nfc;
        w0 = _ecs_bte_set_free_id(w0, nfc, 0);
        let gen = _ecs_bte_gen_at(w0, id);
        return EcsBteSpawn { world: w0, entity: EcsBteEntity { id: id, generation: gen } };
    };
    if w0.next_id >= ECS_BTE_ENTITY_CAP {
        return EcsBteSpawn { world: w0, entity: EcsBteEntity { id: -1, generation: 0 } };
    };
    let id = w0.next_id;
    w0.next_id = id + 1;
    let gen = _ecs_bte_gen_at(w0, id);
    return EcsBteSpawn { world: w0, entity: EcsBteEntity { id: id, generation: gen } };
}

fn ecs_bte_is_alive(w: EcsBteWorld, e: EcsBteEntity) -> bool {
    if e.id <= 0 { return false; };
    if e.id >= ECS_BTE_ENTITY_CAP { return false; };
    if e.id >= w.next_id { return false; };
    if _ecs_bte_id_is_free(w, e.id) { return false; };
    return _ecs_bte_gen_at(w, e.id) == e.generation;
}

fn ecs_bte_free_entity(w0: EcsBteWorld, e: EcsBteEntity) -> EcsBteWorld {
    if ecs_bte_is_alive(w0, e) != true { return w0; };
    let cg = _ecs_bte_gen_at(w0, e.id);
    w0 = _ecs_bte_set_gen(w0, e.id, cg + 1);
    let pos = w0.free_count;
    w0 = _ecs_bte_set_free_id(w0, pos, e.id);
    w0.free_count = pos + 1;
    return w0;
}

fn ecs_bte_world_spawn(w0: EcsBteWorld) -> EcsBteSpawn { return ecs_bte_alloc_entity(w0); }

fn ecs_bte_world_entity_count(w: EcsBteWorld) -> i32 { return w.next_id - w.free_count - 1; }

// ── Component-registry accessors (reg_type / reg_kind / reg_store; cap-4). ───────────────
fn _ecs_bte_reg_type_at(w: EcsBteWorld, idx: i32) -> i32 {
    if idx == 0 { return w.reg_type0; };
    if idx == 1 { return w.reg_type1; };
    if idx == 2 { return w.reg_type2; };
    return w.reg_type3;
}

fn _ecs_bte_set_reg_type(w0: EcsBteWorld, idx: i32, value: i32) -> EcsBteWorld {
    if idx == 0 { w0.reg_type0 = value; return w0; };
    if idx == 1 { w0.reg_type1 = value; return w0; };
    if idx == 2 { w0.reg_type2 = value; return w0; };
    w0.reg_type3 = value;
    return w0;
}

