    if idx == 5 { return EcsBtePos { x: q.a_x5, y: q.a_y5 }; };
    if idx == 6 { return EcsBtePos { x: q.a_x6, y: q.a_y6 }; };
    if idx == 7 { return EcsBtePos { x: q.a_x7, y: q.a_y7 }; };
    if idx == 8 { return EcsBtePos { x: q.a_x8, y: q.a_y8 }; };
    if idx == 9 { return EcsBtePos { x: q.a_x9, y: q.a_y9 }; };
    if idx == 10 { return EcsBtePos { x: q.a_x10, y: q.a_y10 }; };
    if idx == 11 { return EcsBtePos { x: q.a_x11, y: q.a_y11 }; };
    if idx == 12 { return EcsBtePos { x: q.a_x12, y: q.a_y12 }; };
    if idx == 13 { return EcsBtePos { x: q.a_x13, y: q.a_y13 }; };
    if idx == 14 { return EcsBtePos { x: q.a_x14, y: q.a_y14 }; };
    return EcsBtePos { x: q.a_x15, y: q.a_y15 };
}

fn ecs_bte_pair_query_b_at(q: EcsBtePairQuery, idx: i32) -> EcsBteVel {
    if idx == 0 { return EcsBteVel { x: q.b_x0, y: q.b_y0 }; };
    if idx == 1 { return EcsBteVel { x: q.b_x1, y: q.b_y1 }; };
