}

fn ecs_bte_pair_query_count(q: EcsBtePairQuery) -> i32 { return q.count; }
fn ecs_bte_pair_query_entity_id_at(q: EcsBtePairQuery, idx: i32) -> i32 {
    if idx == 0 { return q.ent_id0; };
    if idx == 1 { return q.ent_id1; };
    if idx == 2 { return q.ent_id2; };
    if idx == 3 { return q.ent_id3; };
    if idx == 4 { return q.ent_id4; };
    if idx == 5 { return q.ent_id5; };
    if idx == 6 { return q.ent_id6; };
    if idx == 7 { return q.ent_id7; };
    if idx == 8 { return q.ent_id8; };
    if idx == 9 { return q.ent_id9; };
    if idx == 10 { return q.ent_id10; };
    if idx == 11 { return q.ent_id11; };
    if idx == 12 { return q.ent_id12; };
    if idx == 13 { return q.ent_id13; };
    if idx == 14 { return q.ent_id14; };
    return q.ent_id15;
}

fn ecs_bte_pair_query_a_at(q: EcsBtePairQuery, idx: i32) -> EcsBtePos {
    if idx == 0 { return EcsBtePos { x: q.a_x0, y: q.a_y0 }; };
    if idx == 1 { return EcsBtePos { x: q.a_x1, y: q.a_y1 }; };
    if idx == 2 { return EcsBtePos { x: q.a_x2, y: q.a_y2 }; };
    if idx == 3 { return EcsBtePos { x: q.a_x3, y: q.a_y3 }; };
