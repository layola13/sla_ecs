        reg_type0: 0, reg_type1: 0, reg_type2: 0, reg_type3: 0,
        reg_kind0: 0, reg_kind1: 0, reg_kind2: 0, reg_kind3: 0,
        reg_store0: 0, reg_store1: 0, reg_store2: 0, reg_store3: 0,
        pos_count: 0,
        pos_eid0: 0, pos_eid1: 0, pos_eid2: 0, pos_eid3: 0, pos_eid4: 0, pos_eid5: 0, pos_eid6: 0, pos_eid7: 0,
        pos_eid8: 0, pos_eid9: 0, pos_eid10: 0, pos_eid11: 0, pos_eid12: 0, pos_eid13: 0, pos_eid14: 0, pos_eid15: 0,
        pos_x0: 0, pos_x1: 0, pos_x2: 0, pos_x3: 0, pos_x4: 0, pos_x5: 0, pos_x6: 0, pos_x7: 0,
