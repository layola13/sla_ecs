}

fn _ecs_bte_reg_store_at(w: EcsBteWorld, idx: i32) -> i32 {
    if idx == 0 { return w.reg_store0; };
    if idx == 1 { return w.reg_store1; };
    if idx == 2 { return w.reg_store2; };
