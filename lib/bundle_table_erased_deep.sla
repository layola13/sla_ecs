    if idx == 4 { w0.player_team4 = value; return w0; };
    if idx == 5 { w0.player_team5 = value; return w0; };
    if idx == 6 { w0.player_team6 = value; return w0; };
    if idx == 7 { w0.player_team7 = value; return w0; };
    if idx == 8 { w0.player_team8 = value; return w0; };
    if idx == 9 { w0.player_team9 = value; return w0; };
    if idx == 10 { w0.player_team10 = value; return w0; };
    if idx == 11 { w0.player_team11 = value; return w0; };
    if idx == 12 { w0.player_team12 = value; return w0; };
    if idx == 13 { w0.player_team13 = value; return w0; };
    if idx == 14 { w0.player_team14 = value; return w0; };
    w0.player_team15 = value;
    return w0;
}

fn _ecs_bte_pos_slot_of(w: EcsBteWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.pos_count {
        if _ecs_bte_pos_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_bte_vel_slot_of(w: EcsBteWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.vel_count {
        if _ecs_bte_vel_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_bte_player_slot_of(w: EcsBteWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.player_count {
        if _ecs_bte_player_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

// ── Component insert/has/get per plug (Pos/Vel table, Player sparse). ───────────────────
fn ecs_bte_world_insert_pos(w0: EcsBteWorld, e: EcsBteEntity, x: i32, y: i32) -> EcsBteWorld {
    if ecs_bte_is_alive(w0, e) != true { panic(12540); };
    let slot = _ecs_bte_pos_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_bte_set_pos_x(w0, slot, x);
        w0 = _ecs_bte_set_pos_y(w0, slot, y);
        return w0;
    };
    let ns = w0.pos_count;
    if ns >= ECS_BTE_STORE_CAP { panic(12541); };
    w0 = _ecs_bte_set_pos_eid(w0, ns, e.id);
    w0 = _ecs_bte_set_pos_x(w0, ns, x);
    w0 = _ecs_bte_set_pos_y(w0, ns, y);
    w0.pos_count = ns + 1;
    w0 = _ecs_bte_set_arch(w0, e.id, _ecs_bte_arch_at(w0, e.id) | 1);
    return w0;
}

fn ecs_bte_world_has_pos(w: EcsBteWorld, e: EcsBteEntity) -> bool {
    if ecs_bte_is_alive(w, e) != true { return false; };
    return _ecs_bte_pos_slot_of(w, e.id) >= 0;
}

fn ecs_bte_world_get_pos(w: EcsBteWorld, e: EcsBteEntity) -> EcsBtePos {
    if ecs_bte_world_has_pos(w, e) != true { panic(12542); };
    let slot = _ecs_bte_pos_slot_of(w, e.id);
    return EcsBtePos { x: _ecs_bte_pos_x_at(w, slot), y: _ecs_bte_pos_y_at(w, slot) };
}

fn ecs_bte_world_insert_vel(w0: EcsBteWorld, e: EcsBteEntity, x: i32, y: i32) -> EcsBteWorld {
    if ecs_bte_is_alive(w0, e) != true { panic(12543); };
    let slot = _ecs_bte_vel_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_bte_set_vel_x(w0, slot, x);
        w0 = _ecs_bte_set_vel_y(w0, slot, y);
        return w0;
    };
    let ns = w0.vel_count;
    if ns >= ECS_BTE_STORE_CAP { panic(12544); };
    w0 = _ecs_bte_set_vel_eid(w0, ns, e.id);
    w0 = _ecs_bte_set_vel_x(w0, ns, x);
    w0 = _ecs_bte_set_vel_y(w0, ns, y);
    w0.vel_count = ns + 1;
    w0 = _ecs_bte_set_arch(w0, e.id, _ecs_bte_arch_at(w0, e.id) | 2);
    return w0;
}

fn ecs_bte_world_has_vel(w: EcsBteWorld, e: EcsBteEntity) -> bool {
    if ecs_bte_is_alive(w, e) != true { return false; };
    return _ecs_bte_vel_slot_of(w, e.id) >= 0;
}

fn ecs_bte_world_get_vel(w: EcsBteWorld, e: EcsBteEntity) -> EcsBteVel {
    if ecs_bte_world_has_vel(w, e) != true { panic(12545); };
    let slot = _ecs_bte_vel_slot_of(w, e.id);
    return EcsBteVel { x: _ecs_bte_vel_x_at(w, slot), y: _ecs_bte_vel_y_at(w, slot) };
}

fn ecs_bte_world_insert_player(w0: EcsBteWorld, e: EcsBteEntity, team: i32) -> EcsBteWorld {
    if ecs_bte_is_alive(w0, e) != true { panic(12546); };
    let slot = _ecs_bte_player_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_bte_set_player_team(w0, slot, team);
        return w0;
    };
    let ns = w0.player_count;
    if ns >= ECS_BTE_STORE_CAP { panic(12547); };
    w0 = _ecs_bte_set_player_eid(w0, ns, e.id);
    w0 = _ecs_bte_set_player_team(w0, ns, team);
    w0.player_count = ns + 1;
    w0 = _ecs_bte_set_arch(w0, e.id, _ecs_bte_arch_at(w0, e.id) | 4);
    return w0;
}

fn ecs_bte_world_has_player(w: EcsBteWorld, e: EcsBteEntity) -> bool {
    if ecs_bte_is_alive(w, e) != true { return false; };
    return _ecs_bte_player_slot_of(w, e.id) >= 0;
}

fn ecs_bte_world_get_player(w: EcsBteWorld, e: EcsBteEntity) -> EcsBtePlayer {
    if ecs_bte_world_has_player(w, e) != true { panic(12548); };
    let slot = _ecs_bte_player_slot_of(w, e.id);
    return EcsBtePlayer { team: _ecs_bte_player_team_at(w, slot) };
}

// ecs_bte_world_insert_dispatch: routes by component_id (0|1|2) to the matching store.
fn ecs_bte_world_insert_dispatch(w0: EcsBteWorld, e: EcsBteEntity, component_id: i32, x: i32, y: i32, team: i32) -> EcsBteWorld {
    if component_id == 0 { return ecs_bte_world_insert_pos(w0, e, x, y); };
    if component_id == 1 { return ecs_bte_world_insert_vel(w0, e, x, y); };
    if component_id == 2 { return ecs_bte_world_insert_player(w0, e, team); };
    panic(12549);
}

fn ecs_bte_world_has(w: EcsBteWorld, e: EcsBteEntity, component_id: i32) -> bool {
    if component_id == 0 { return ecs_bte_world_has_pos(w, e); };
    if component_id == 1 { return ecs_bte_world_has_vel(w, e); };
    if component_id == 2 { return ecs_bte_world_has_player(w, e); };
    return false;
}

// entity_archetype_id: shallow returns > 0 once entity has any component; deep mirror uses arch bitmask (>0).
fn ecs_bte_world_entity_archetype_id(w: EcsBteWorld, e: EcsBteEntity) -> i32 {
    if ecs_bte_is_alive(w, e) != true { return 0; };
    return _ecs_bte_arch_at(w, e.id);
}

// ── Bundle wrapper structs. ─────────────────────────────────────────────────────────────
// EcsBteBundle2 and EcsBteBundle3 fold the shallow's `ErasedComponentValue` box into typed
// scalar pairs per slot. Each component slot carries its type_id + the matching scalar value
// (Pos/Vel take x and y; Player takes team). Insert constants ECS_BTE_POS_TYPE=401, VEL=402,
// PLAYER=403; the deep asserts duplicate type_id within a bundle (panic 12500/12501/12502/12503).
struct EcsBteBundle2 {
    first_type_id: i32, second_type_id: i32,
    first_x: i32, first_y: i32, first_team: i32,
    second_x: i32, second_y: i32, second_team: i32,
}
struct EcsBteBundle3 {
    first_type_id: i32, second_type_id: i32, third_type_id: i32,
    first_x: i32, first_y: i32, first_team: i32,
    second_x: i32, second_y: i32, second_team: i32,
    third_x: i32, third_y: i32, third_team: i32,
}

// Bundle3 typed constructors covering the shallow's test patterns:
// (Player=team, Pos=x/y, Vel=x/y) and (Pos=x/y, Vel=x/y, Player=team). The first_type_id and
// second_type_id collisions within a bundle panic per the shallow.
fn ecs_bte_bundle3_new_player_pos_vel(team: i32, px: i32, py: i32, vx: i32, vy: i32) -> EcsBteBundle3 {
    return EcsBteBundle3 {
        first_type_id: ECS_BTE_PLAYER_TYPE, second_type_id: ECS_BTE_POS_TYPE, third_type_id: ECS_BTE_VEL_TYPE,
        first_x: 0, first_y: 0, first_team: team,
        second_x: px, second_y: py, second_team: 0,
        third_x: vx, third_y: vy, third_team: 0,
    };
}

fn ecs_bte_bundle3_new_pos_vel_player(px: i32, py: i32, vx: i32, vy: i32, team: i32) -> EcsBteBundle3 {
    return EcsBteBundle3 {
        first_type_id: ECS_BTE_POS_TYPE, second_type_id: ECS_BTE_VEL_TYPE, third_type_id: ECS_BTE_PLAYER_TYPE,
        first_x: px, first_y: py, first_team: 0,
        second_x: vx, second_y: vy, second_team: 0,
        third_x: 0, third_y: 0, third_team: team,
    };
}

// Bundle2 typed (Pos, Vel) constructor for parity.
fn ecs_bte_bundle2_new_vel_player(vx: i32, vy: i32, team: i32) -> EcsBteBundle2 {
    return EcsBteBundle2 {
        first_type_id: ECS_BTE_VEL_TYPE, second_type_id: ECS_BTE_PLAYER_TYPE,
        first_x: vx, first_y: vy, first_team: 0,
        second_x: 0, second_y: 0, second_team: team,
    };
}

fn ecs_bte_bundle2_new_pos_player(px: i32, py: i32, team: i32) -> EcsBteBundle2 {
    return EcsBteBundle2 {
        first_type_id: ECS_BTE_POS_TYPE, second_type_id: ECS_BTE_PLAYER_TYPE,
        first_x: px, first_y: py, first_team: 0,
        second_x: 0, second_y: 0, second_team: team,
    };
}

fn ecs_bte_bundle2_new_pos_vel(px: i32, py: i32, vx: i32, vy: i32) -> EcsBteBundle2 {
    return EcsBteBundle2 {
        first_type_id: ECS_BTE_POS_TYPE, second_type_id: ECS_BTE_VEL_TYPE,
        first_x: px, first_y: py, first_team: 0,
        second_x: vx, second_y: vy, second_team: 0,
    };
}

// _ecs_bte_world_insert_by_type: routes a single typed bundle-component write by type_id.
fn _ecs_bte_world_insert_by_type(w0: EcsBteWorld, e: EcsBteEntity, type_id: i32, x: i32, y: i32, team: i32) -> EcsBteWorld {
    if type_id == ECS_BTE_POS_TYPE { return ecs_bte_world_insert_pos(w0, e, x, y); };
    if type_id == ECS_BTE_VEL_TYPE { return ecs_bte_world_insert_vel(w0, e, x, y); };
    if type_id == ECS_BTE_PLAYER_TYPE { return ecs_bte_world_insert_player(w0, e, team); };
    panic(12550);
}

// ecs_bte_world_insert_bundle3: resolve each bundle slot's type_id to a component_id then
// route the write; panic on any duplicate component_id post-resolution (12505/12506/12507).
fn ecs_bte_world_insert_bundle3(w0: EcsBteWorld, e: EcsBteEntity, bundle: EcsBteBundle3) -> EcsBteWorld {
    let lid = ecs_bte_world_component_id_for_type(w0, bundle.first_type_id);
    let rid = ecs_bte_world_component_id_for_type(w0, bundle.second_type_id);
    let tid = ecs_bte_world_component_id_for_type(w0, bundle.third_type_id);
    if lid < 0 { panic(12551); };
    if rid < 0 { panic(12552); };
    if tid < 0 { panic(12553); };
    if lid == rid { panic(12505); };
    if lid == tid { panic(12506); };
    if rid == tid { panic(12507); };
    w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.first_type_id, bundle.first_x, bundle.first_y, bundle.first_team);
    w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.second_type_id, bundle.second_x, bundle.second_y, bundle.second_team);
    w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.third_type_id, bundle.third_x, bundle.third_y, bundle.third_team);
    return w0;
}

fn ecs_bte_world_insert_bundle2(w0: EcsBteWorld, e: EcsBteEntity, bundle: EcsBteBundle2) -> EcsBteWorld {
    let lid = ecs_bte_world_component_id_for_type(w0, bundle.first_type_id);
    let rid = ecs_bte_world_component_id_for_type(w0, bundle.second_type_id);
    if lid < 0 { panic(12554); };
    if rid < 0 { panic(12555); };
    if lid == rid { panic(12504); };
    w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.first_type_id, bundle.first_x, bundle.first_y, bundle.first_team);
    w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.second_type_id, bundle.second_x, bundle.second_y, bundle.second_team);
    return w0;
}

// ecs_bte_world_drop_uninserted_bundle_value: the shallow invokes def.drop_fn(value.raw).
// The deep's values are owned scalars (no heap box), so drop is a no-op; return world unchanged.
fn ecs_bte_world_drop_uninserted_bundle_value(w0: EcsBteWorld, component_id: i32, x: i32, y: i32, team: i32) -> EcsBteWorld {
    return w0;
}

// ecs_bte_world_insert_bundle3_if_new: preserve already-present components, insert new ones.
fn ecs_bte_world_insert_bundle3_if_new(w0: EcsBteWorld, e: EcsBteEntity, bundle: EcsBteBundle3) -> EcsBteWorld {
    let lid = ecs_bte_world_component_id_for_type(w0, bundle.first_type_id);
    let rid = ecs_bte_world_component_id_for_type(w0, bundle.second_type_id);
    let tid = ecs_bte_world_component_id_for_type(w0, bundle.third_type_id);
    if lid < 0 { panic(12556); };
    if rid < 0 { panic(12557); };
    if tid < 0 { panic(12558); };
    if lid == rid { panic(12582); };
    if lid == tid { panic(12583); };
    if rid == tid { panic(12584); };
    if ecs_bte_world_has(w0, e, lid) {
        w0 = ecs_bte_world_drop_uninserted_bundle_value(w0, lid, bundle.first_x, bundle.first_y, bundle.first_team);
    } else {
        w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.first_type_id, bundle.first_x, bundle.first_y, bundle.first_team);
    };
    if ecs_bte_world_has(w0, e, rid) {
        w0 = ecs_bte_world_drop_uninserted_bundle_value(w0, rid, bundle.second_x, bundle.second_y, bundle.second_team);
    } else {
        w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.second_type_id, bundle.second_x, bundle.second_y, bundle.second_team);
    };
    if ecs_bte_world_has(w0, e, tid) {
        w0 = ecs_bte_world_drop_uninserted_bundle_value(w0, tid, bundle.third_x, bundle.third_y, bundle.third_team);
    } else {
        w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.third_type_id, bundle.third_x, bundle.third_y, bundle.third_team);
    };
    return w0;
}

fn ecs_bte_world_insert_bundle2_if_new(w0: EcsBteWorld, e: EcsBteEntity, bundle: EcsBteBundle2) -> EcsBteWorld {
    let lid = ecs_bte_world_component_id_for_type(w0, bundle.first_type_id);
    let rid = ecs_bte_world_component_id_for_type(w0, bundle.second_type_id);
    if lid < 0 { panic(12559); };
    if rid < 0 { panic(12560); };
    if lid == rid { panic(12581); };
    if ecs_bte_world_has(w0, e, lid) {
        w0 = ecs_bte_world_drop_uninserted_bundle_value(w0, lid, bundle.first_x, bundle.first_y, bundle.first_team);
    } else {
        w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.first_type_id, bundle.first_x, bundle.first_y, bundle.first_team);
    };
    if ecs_bte_world_has(w0, e, rid) {
        w0 = ecs_bte_world_drop_uninserted_bundle_value(w0, rid, bundle.second_x, bundle.second_y, bundle.second_team);
    } else {
        w0 = _ecs_bte_world_insert_by_type(w0, e, bundle.second_type_id, bundle.second_x, bundle.second_y, bundle.second_team);
    };
    return w0;
}

// ecs_bte_world_spawn_bundle3 / spawn_bundle2: spawn entity then insert bundle components.
fn ecs_bte_world_spawn_bundle3(w0: EcsBteWorld, bundle: EcsBteBundle3) -> EcsBteSpawn {
    let sp = ecs_bte_alloc_entity(w0);
    let w1 = ecs_bte_spawn_world(sp);
    let e = ecs_bte_spawn_entity(sp);
    let w2 = ecs_bte_world_insert_bundle3(w1, e, bundle);
    return EcsBteSpawn { world: w2, entity: e };
}

fn ecs_bte_world_spawn_bundle2(w0: EcsBteWorld, bundle: EcsBteBundle2) -> EcsBteSpawn {
    let sp = ecs_bte_alloc_entity(w0);
    let w1 = ecs_bte_spawn_world(sp);
    let e = ecs_bte_spawn_entity(sp);
    let w2 = ecs_bte_world_insert_bundle2(w1, e, bundle);
    return EcsBteSpawn { world: w2, entity: e };
}

// Batch insert wrappers: the shallow's Vec<Entity>+Vec<Bundle> cap-N becomes a cap-2 paired
// (entities + bundles) family here. insert_batch_bundle3_length_check panics on length mismatch.
fn ecs_bte_world_insert_batch_bundle3(w0: EcsBteWorld, e0: EcsBteEntity, b0: EcsBteBundle3, e1: EcsBteEntity, b1: EcsBteBundle3) -> EcsBteWorld {
    let w1 = ecs_bte_world_insert_bundle3(w0, e0, b0);
    let w2 = ecs_bte_world_insert_bundle3(w1, e1, b1);
    return w2;
}

fn ecs_bte_world_insert_batch_bundle3_if_new(w0: EcsBteWorld, e0: EcsBteEntity, b0: EcsBteBundle3, e1: EcsBteEntity, b1: EcsBteBundle3) -> EcsBteWorld {
    let w1 = ecs_bte_world_insert_bundle3_if_new(w0, e0, b0);
    let w2 = ecs_bte_world_insert_bundle3_if_new(w1, e1, b1);
    return w2;
}

fn ecs_bte_world_insert_batch_bundle2(w0: EcsBteWorld, e0: EcsBteEntity, b0: EcsBteBundle2, e1: EcsBteEntity, b1: EcsBteBundle2) -> EcsBteWorld {
    let w1 = ecs_bte_world_insert_bundle2(w0, e0, b0);
    let w2 = ecs_bte_world_insert_bundle2(w1, e1, b1);
    return w2;
}

fn ecs_bte_world_insert_batch_bundle2_if_new(w0: EcsBteWorld, e0: EcsBteEntity, b0: EcsBteBundle2, e1: EcsBteEntity, b1: EcsBteBundle2) -> EcsBteWorld {
    let w1 = ecs_bte_world_insert_bundle2_if_new(w0, e0, b0);
    let w2 = ecs_bte_world_insert_bundle2_if_new(w1, e1, b1);
    return w2;
}

struct EcsBteSpawnBatch {
    world: EcsBteWorld,
    count: i32,
    entity_id0: i32,
    entity_gen0: i32,
    entity_id1: i32,
    entity_gen1: i32,
}
fn ecs_bte_spawn_batch_world(s: EcsBteSpawnBatch) -> EcsBteWorld { return s.world; }
fn ecs_bte_spawn_batch_count(s: EcsBteSpawnBatch) -> i32 { return s.count; }
fn ecs_bte_spawn_batch_entity_at(s: EcsBteSpawnBatch, idx: i32) -> EcsBteEntity {
    if idx == 0 { return EcsBteEntity { id: s.entity_id0, generation: s.entity_gen0 }; };
    return EcsBteEntity { id: s.entity_id1, generation: s.entity_gen1 };
}

fn ecs_bte_world_spawn_batch_bundle3(w0: EcsBteWorld, b0: EcsBteBundle3, b1: EcsBteBundle3) -> EcsBteSpawnBatch {
    let sp0 = ecs_bte_world_spawn_bundle3(w0, b0);
    let w1 = ecs_bte_spawn_world(sp0);
    let e0 = ecs_bte_spawn_entity(sp0);
    let sp1 = ecs_bte_world_spawn_bundle3(w1, b1);
    let w2 = ecs_bte_spawn_world(sp1);
    let e1 = ecs_bte_spawn_entity(sp1);
    return EcsBteSpawnBatch { world: w2, count: 2, entity_id0: e0.id, entity_gen0: e0.generation, entity_id1: e1.id, entity_gen1: e1.generation };
}

fn ecs_bte_world_spawn_batch_bundle2(w0: EcsBteWorld, b0: EcsBteBundle2, b1: EcsBteBundle2) -> EcsBteSpawnBatch {
    let sp0 = ecs_bte_world_spawn_bundle2(w0, b0);
    let w1 = ecs_bte_spawn_world(sp0);
    let e0 = ecs_bte_spawn_entity(sp0);
    let sp1 = ecs_bte_world_spawn_bundle2(w1, b1);
    let w2 = ecs_bte_spawn_world(sp1);
    let e1 = ecs_bte_spawn_entity(sp1);
    return EcsBteSpawnBatch { world: w2, count: 2, entity_id0: e0.id, entity_gen0: e0.generation, entity_id1: e1.id, entity_gen1: e1.generation };
}

// ── Pair query over Pos × Vel (the shallow's query_pair_auto(PosTypeId, VelTypeId)). ───────
// Iterates the smaller of (Pos count, Vel count); for each entity, if both has_pos and
// has_vel, emits a pair item (entity_id, a_x, a_y, b_x, b_y). Each item is a flat-scalar
// slot family cap-16 (mirrors Batch 389 EcsWdPairQuery pattern with c_team + c_slot removed).

struct EcsBtePairQuery {
    count: i32,
    ent_id0: i32, ent_id1: i32, ent_id2: i32, ent_id3: i32, ent_id4: i32, ent_id5: i32, ent_id6: i32, ent_id7: i32, ent_id8: i32, ent_id9: i32, ent_id10: i32, ent_id11: i32, ent_id12: i32, ent_id13: i32, ent_id14: i32, ent_id15: i32,
    a_x0: i32, a_x1: i32, a_x2: i32, a_x3: i32, a_x4: i32, a_x5: i32, a_x6: i32, a_x7: i32, a_x8: i32, a_x9: i32, a_x10: i32, a_x11: i32, a_x12: i32, a_x13: i32, a_x14: i32, a_x15: i32,
    a_y0: i32, a_y1: i32, a_y2: i32, a_y3: i32, a_y4: i32, a_y5: i32, a_y6: i32, a_y7: i32, a_y8: i32, a_y9: i32, a_y10: i32, a_y11: i32, a_y12: i32, a_y13: i32, a_y14: i32, a_y15: i32,
