// Deepened Bevy ECS type-erased resource storage (lib/resource_erased.sla deep).
// Mirrors the storage owner (ErasedResources): one resource slot per type-id
// (cap-8 fixed slots), tracking added_tick / changed_tick, ownership by scalars.
// No generics, no raw pointers, no Box, no fn-ptr drop callback (the deep variant
// replaces the dropped-raw storage with scalar payloads and ref-count on insertion).
// Operations: new, increment_tick, slot, count, has, insert (overwrite+track
// changed_tick), get_payload, res (returns Res with added+changed ticks),
// res_mut (mirrors res), write (overwrite), res_mut_write, added_since,
// changed_since, remove (swap-remove), clear.

const ECS_ERASED_RES_CAP_DEEP: i32 = 8;

struct EcsErasedResourceValueDeep {
    type_id: i32,
    payload: i32,
}

fn ecs_erased_resource_value_new(type_id: i32, payload: i32) -> EcsErasedResourceValueDeep {
    return EcsErasedResourceValueDeep { type_id: type_id, payload: payload };
}
fn ecs_erased_resource_value_type_id(v: EcsErasedResourceValueDeep) -> i32 { return v.type_id; }
fn ecs_erased_resource_value_payload(v: EcsErasedResourceValueDeep) -> i32 { return v.payload; }

struct EcsErasedResDeep {
    added_tick: i32,
    changed_tick: i32,
    value: i32,
}

fn ecs_erased_res_new(added_tick: i32, changed_tick: i32, value: i32) -> EcsErasedResDeep {
    return EcsErasedResDeep { added_tick: added_tick, changed_tick: changed_tick, value: value };
}

fn ecs_erased_res_added_tick(r: EcsErasedResDeep) -> i32 { return r.added_tick; }
fn ecs_erased_res_changed_tick(r: EcsErasedResDeep) -> i32 { return r.changed_tick; }
fn ecs_erased_res_value(r: EcsErasedResDeep) -> i32 { return r.value; }

struct EcsErasedResourcesDeep {
    t0: i32, t1: i32, t2: i32, t3: i32, t4: i32, t5: i32, t6: i32, t7: i32,
    p0: i32, p1: i32, p2: i32, p3: i32, p4: i32, p5: i32, p6: i32, p7: i32,
    a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    count: i32,
    change_tick: i32,
}

fn ecs_erased_resources_new() -> EcsErasedResourcesDeep {
    let r = EcsErasedResourcesDeep {
        t0: 0, t1: 0, t2: 0, t3: 0, t4: 0, t5: 0, t6: 0, t7: 0,
        p0: 0, p1: 0, p2: 0, p3: 0, p4: 0, p5: 0, p6: 0, p7: 0,
        a0: 0, a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0, a7: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        count: 0,
        change_tick: 1,
    };
    return r;
}

fn ecs_erased_resources_change_tick(r: EcsErasedResourcesDeep) -> i32 { return r.change_tick; }
fn ecs_erased_resources_count(r: EcsErasedResourcesDeep) -> i32 { return r.count; }

fn ecs_erased_resources_increment_tick(r: EcsErasedResourcesDeep) -> EcsErasedResourcesDeep {
    r.change_tick = r.change_tick + 1;
    return r;
}

// Dense slot accessors.
fn ecs_erased_resources_type_at(r: EcsErasedResourcesDeep, idx: i32) -> i32 {
    if idx == 0 { return r.t0; };
    if idx == 1 { return r.t1; };
    if idx == 2 { return r.t2; };
    if idx == 3 { return r.t3; };
    if idx == 4 { return r.t4; };
    if idx == 5 { return r.t5; };
    if idx == 6 { return r.t6; };
    if idx == 7 { return r.t7; };
    return 0;
}

fn ecs_erased_resources_payload_at(r: EcsErasedResourcesDeep, idx: i32) -> i32 {
    if idx == 0 { return r.p0; };
    if idx == 1 { return r.p1; };
    if idx == 2 { return r.p2; };
    if idx == 3 { return r.p3; };
    if idx == 4 { return r.p4; };
    if idx == 5 { return r.p5; };
    if idx == 6 { return r.p6; };
    if idx == 7 { return r.p7; };
    return 0;
}

fn ecs_erased_resources_added_at(r: EcsErasedResourcesDeep, idx: i32) -> i32 {
    if idx == 0 { return r.a0; };
    if idx == 1 { return r.a1; };
    if idx == 2 { return r.a2; };
    if idx == 3 { return r.a3; };
    if idx == 4 { return r.a4; };
    if idx == 5 { return r.a5; };
    if idx == 6 { return r.a6; };
    if idx == 7 { return r.a7; };
    return 0;
}

fn ecs_erased_resources_changed_at(r: EcsErasedResourcesDeep, idx: i32) -> i32 {
    if idx == 0 { return r.c0; };
    if idx == 1 { return r.c1; };
    if idx == 2 { return r.c2; };
    if idx == 3 { return r.c3; };
    if idx == 4 { return r.c4; };
    if idx == 5 { return r.c5; };
    if idx == 6 { return r.c6; };
    if idx == 7 { return r.c7; };
    return 0;
}

fn ecs_erased_resources_set_slot(r: EcsErasedResourcesDeep, idx: i32, t: i32, p: i32, added: i32, changed: i32) -> EcsErasedResourcesDeep {
    if idx == 0 { r.t0 = t; r.p0 = p; r.a0 = added; r.c0 = changed; };
    if idx == 1 { r.t1 = t; r.p1 = p; r.a1 = added; r.c1 = changed; };
    if idx == 2 { r.t2 = t; r.p2 = p; r.a2 = added; r.c2 = changed; };
    if idx == 3 { r.t3 = t; r.p3 = p; r.a3 = added; r.c3 = changed; };
    if idx == 4 { r.t4 = t; r.p4 = p; r.a4 = added; r.c4 = changed; };
    if idx == 5 { r.t5 = t; r.p5 = p; r.a5 = added; r.c5 = changed; };
    if idx == 6 { r.t6 = t; r.p6 = p; r.a6 = added; r.c6 = changed; };
    if idx == 7 { r.t7 = t; r.p7 = p; r.a7 = added; r.c7 = changed; };
    return r;
}

// Linear search slot index (or -1) for a type-id.
fn ecs_erased_resources_slot(r: EcsErasedResourcesDeep, type_id: i32) -> i32 {
    let i: i32 = 0;
    while i < r.count {
        if ecs_erased_resources_type_at(r, i) == type_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_erased_resources_has(r: EcsErasedResourcesDeep, type_id: i32) -> bool {
    let s = ecs_erased_resources_slot(r, type_id);
    return s >= 0;
}

// insert: replace or append. Mirrors `erased_resources_insert`.
fn ecs_erased_resources_insert(r: EcsErasedResourcesDeep, type_id: i32, payload: i32) -> EcsErasedResourcesDeep {
    let s = ecs_erased_resources_slot(r, type_id);
    if s >= 0 {
        // Replace value; track changed_tick with current change_tick (added preserved).
        let added = ecs_erased_resources_added_at(r, s);
        return ecs_erased_resources_set_slot(r, s, type_id, payload, added, r.change_tick);
    };
    if r.count >= ECS_ERASED_RES_CAP_DEEP { return r; };
    let slot = r.count;
    r = ecs_erased_resources_set_slot(r, slot, type_id, payload, r.change_tick, r.change_tick);
    r.count = r.count + 1;
    return r;
}

fn ecs_erased_resources_get_payload(r: EcsErasedResourcesDeep, type_id: i32) -> i32 {
    let s = ecs_erased_resources_slot(r, type_id);
    if s < 0 { panic(136800); };
    return ecs_erased_resources_payload_at(r, s);
}

// res returns the added/changed/value triple for a type-id (panics if absent).
fn ecs_erased_resources_res(r: EcsErasedResourcesDeep, type_id: i32) -> EcsErasedResDeep {
    let s = ecs_erased_resources_slot(r, type_id);
    if s < 0 { panic(136801); };
    return ecs_erased_res_new(
        ecs_erased_resources_added_at(r, s),
        ecs_erased_resources_changed_at(r, s),
        ecs_erased_resources_payload_at(r, s));
}

// res_mut mirrors res (the deep variant does not differentiate borrow mutability).
fn ecs_erased_resources_res_mut(r: EcsErasedResourcesDeep, type_id: i32) -> EcsErasedResDeep {
    return ecs_erased_resources_res(r, type_id);
}

// write replaces value of existing slot, bumping changed_tick.
fn ecs_erased_resources_write(r: EcsErasedResourcesDeep, type_id: i32, payload: i32) -> EcsErasedResourcesDeep {
    let s = ecs_erased_resources_slot(r, type_id);
    if s < 0 { return r; };
    return ecs_erased_resources_set_slot(r, s, type_id, payload, ecs_erased_resources_added_at(r, s), r.change_tick);
}

// res_mut_write composes res_mut + write into a single call.
fn ecs_erased_resources_res_mut_write(r: EcsErasedResourcesDeep, type_id: i32, payload: i32) -> EcsErasedResourcesDeep {
    return ecs_erased_resources_write(r, type_id, payload);
}

fn ecs_erased_resources_added_since(r: EcsErasedResourcesDeep, type_id: i32, tick: i32) -> bool {
    let s = ecs_erased_resources_slot(r, type_id);
    if s < 0 { return false; };
    return ecs_erased_resources_added_at(r, s) > tick;
}

fn ecs_erased_resources_changed_since(r: EcsErasedResourcesDeep, type_id: i32, tick: i32) -> bool {
    let s = ecs_erased_resources_slot(r, type_id);
    if s < 0 { return false; };
    return ecs_erased_resources_changed_at(r, s) > tick;
}

// remove: swap-remove the slot; preserves others (swap-removes last into removed slot).
fn ecs_erased_resources_remove(r: EcsErasedResourcesDeep, type_id: i32) -> EcsErasedResourcesDeep {
    let s = ecs_erased_resources_slot(r, type_id);
    if s < 0 { return r; };
    let last = r.count - 1;
    if s != last {
        let lt = ecs_erased_resources_type_at(r, last);
        let lp = ecs_erased_resources_payload_at(r, last);
        let la = ecs_erased_resources_added_at(r, last);
        let lc = ecs_erased_resources_changed_at(r, last);
        r = ecs_erased_resources_set_slot(r, s, lt, lp, la, lc);
    };
    r = ecs_erased_resources_set_slot(r, last, 0, 0, 0, 0);
    r.count = r.count - 1;
    return r;
}

fn ecs_erased_resources_clear(r: EcsErasedResourcesDeep) -> EcsErasedResourcesDeep {
    return ecs_erased_resources_new();
}
