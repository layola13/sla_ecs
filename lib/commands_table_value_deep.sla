// Deepened Bevy ECS deferred command queue (lib/commands_table_value.sla deep).
// Cap-8 commands list with scalar attr fields (kind/entity_id/component_id/value_index) +
// side slot offsets (component_values cap-8 + resource_values cap-8 + message_values cap-8).
// No generic types, no world-arg apply (this library owns the command queue + introspects
// it; applying to a world would compose with the world-facade module separately).
// Operations: new, command builder, reserve (returns entity id), insert (queue+component
// value), despawn, insert_resource, write_message, len, applied_count_by_kind, clear,
// iterate-by-index accessors.

const ECS_CMD_TABLE_VALUE_CAP_DEEP: i32 = 8;
const ECS_CMD_TABLE_VALUE_INSERT_COMPONENT: i32 = 1;
const ECS_CMD_TABLE_VALUE_DESPAWN: i32 = 2;
const ECS_CMD_TABLE_VALUE_INSERT_RESOURCE: i32 = 3;
const ECS_CMD_TABLE_VALUE_WRITE_MESSAGE: i32 = 4;

struct EcsTableValueCommandDeep {
    kind: i32,
    entity_id: i32,
    component_id: i32,
    value_index: i32,
}

fn ecs_table_value_command(kind: i32, entity_id: i32, component_id: i32, value_index: i32) -> EcsTableValueCommandDeep {
    return EcsTableValueCommandDeep { kind: kind, entity_id: entity_id, component_id: component_id, value_index: value_index };
}

fn ecs_table_value_command_kind(c: EcsTableValueCommandDeep) -> i32 { return c.kind; }
fn ecs_table_value_command_entity_id(c: EcsTableValueCommandDeep) -> i32 { return c.entity_id; }
fn ecs_table_value_command_component_id(c: EcsTableValueCommandDeep) -> i32 { return c.component_id; }
fn ecs_table_value_command_value_index(c: EcsTableValueCommandDeep) -> i32 { return c.value_index; }

struct EcsTableValueCommandsDeep {
    // command list cap-8 with scalar field storage
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32,
    // side payload slots: component_values (i32), resource_values (i32), message_values (i32) cap-8
    pcomp_count: i32, pres_count: i32, pmsg_count: i32,
    // side payload fields are scalar inputs and are read-out via accessors below.
    p0: i32, p1: i32, p2: i32, p3: i32, p4: i32, p5: i32, p6: i32, p7: i32,
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    m0: i32, m1: i32, m2: i32, m3: i32, m4: i32, m5: i32, m6: i32, m7: i32,
    count: i32,
}

fn ecs_table_value_commands_new() -> EcsTableValueCommandsDeep {
    let c = EcsTableValueCommandsDeep {
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0,
        pcomp_count: 0, pres_count: 0, pmsg_count: 0,
        p0: 0, p1: 0, p2: 0, p3: 0, p4: 0, p5: 0, p6: 0, p7: 0,
        r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0,
        m0: 0, m1: 0, m2: 0, m3: 0, m4: 0, m5: 0, m6: 0, m7: 0,
        count: 0,
    };
    return c;
}

fn ecs_table_value_commands_len(c: EcsTableValueCommandsDeep) -> i32 { return c.count; }

// Per-slot accessors (read-only)
fn ecs_table_value_commands_kind_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.k0; };
    if idx == 1 { return c.k1; };
    if idx == 2 { return c.k2; };
    if idx == 3 { return c.k3; };
    if idx == 4 { return c.k4; };
    if idx == 5 { return c.k5; };
    if idx == 6 { return c.k6; };
    if idx == 7 { return c.k7; };
    return 0;
}

fn ecs_table_value_commands_entity_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    return 0;
}

fn ecs_table_value_commands_cmp_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    if idx == 7 { return c.c7; };
    return 0;
}

fn ecs_table_value_commands_idx_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.v0; };
    if idx == 1 { return c.v1; };
    if idx == 2 { return c.v2; };
    if idx == 3 { return c.v3; };
    if idx == 4 { return c.v4; };
    if idx == 5 { return c.v5; };
    if idx == 6 { return c.v6; };
    if idx == 7 { return c.v7; };
    return 0;
}

// Side payload (component_values).
fn ecs_table_value_commands_set_pcomp(c: EcsTableValueCommandsDeep, idx: i32, value: i32) -> EcsTableValueCommandsDeep {
    if idx == 0 { c.p0 = value; };
    if idx == 1 { c.p1 = value; };
    if idx == 2 { c.p2 = value; };
    if idx == 3 { c.p3 = value; };
    if idx == 4 { c.p4 = value; };
    if idx == 5 { c.p5 = value; };
    if idx == 6 { c.p6 = value; };
    if idx == 7 { c.p7 = value; };
    return c;
}

fn ecs_table_value_commands_pcomp_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.p0; };
    if idx == 1 { return c.p1; };
    if idx == 2 { return c.p2; };
    if idx == 3 { return c.p3; };
    if idx == 4 { return c.p4; };
    if idx == 5 { return c.p5; };
    if idx == 6 { return c.p6; };
    if idx == 7 { return c.p7; };
    return 0;
}

fn ecs_table_value_commands_set_pres(c: EcsTableValueCommandsDeep, idx: i32, value: i32) -> EcsTableValueCommandsDeep {
    if idx == 0 { c.r0 = value; };
    if idx == 1 { c.r1 = value; };
    if idx == 2 { c.r2 = value; };
    if idx == 3 { c.r3 = value; };
    if idx == 4 { c.r4 = value; };
    if idx == 5 { c.r5 = value; };
    if idx == 6 { c.r6 = value; };
    if idx == 7 { c.r7 = value; };
    return c;
}

fn ecs_table_value_commands_pres_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.r0; };
    if idx == 1 { return c.r1; };
    if idx == 2 { return c.r2; };
    if idx == 3 { return c.r3; };
    if idx == 4 { return c.r4; };
    if idx == 5 { return c.r5; };
    if idx == 6 { return c.r6; };
    if idx == 7 { return c.r7; };
    return 0;
}

fn ecs_table_value_commands_set_pmsg(c: EcsTableValueCommandsDeep, idx: i32, value: i32) -> EcsTableValueCommandsDeep {
    if idx == 0 { c.m0 = value; };
    if idx == 1 { c.m1 = value; };
    if idx == 2 { c.m2 = value; };
    if idx == 3 { c.m3 = value; };
    if idx == 4 { c.m4 = value; };
    if idx == 5 { c.m5 = value; };
    if idx == 6 { c.m6 = value; };
    if idx == 7 { c.m7 = value; };
    return c;
}

fn ecs_table_value_commands_pmsg_at(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.m0; };
    if idx == 1 { return c.m1; };
    if idx == 2 { return c.m2; };
    if idx == 3 { return c.m3; };
    if idx == 4 { return c.m4; };
    if idx == 5 { return c.m5; };
    if idx == 6 { return c.m6; };
    if idx == 7 { return c.m7; };
    return 0;
}

fn ecs_table_value_commands_pcomp_count(c: EcsTableValueCommandsDeep) -> i32 { return c.pcomp_count; }
fn ecs_table_value_commands_pres_count(c: EcsTableValueCommandsDeep) -> i32 { return c.pres_count; }
fn ecs_table_value_commands_pmsg_count(c: EcsTableValueCommandsDeep) -> i32 { return c.pmsg_count; }

// Set command slot fields (k/e/c/v) — per-branch scalar assign only (no struct reuse).
fn ecs_table_value_commands_set_slot(c: EcsTableValueCommandsDeep, idx: i32, k: i32, e: i32, cmp: i32, v: i32) -> EcsTableValueCommandsDeep {
    if idx == 0 { c.k0 = k; c.e0 = e; c.c0 = cmp; c.v0 = v; };
    if idx == 1 { c.k1 = k; c.e1 = e; c.c1 = cmp; c.v1 = v; };
    if idx == 2 { c.k2 = k; c.e2 = e; c.c2 = cmp; c.v2 = v; };
    if idx == 3 { c.k3 = k; c.e3 = e; c.c3 = cmp; c.v3 = v; };
    if idx == 4 { c.k4 = k; c.e4 = e; c.c4 = cmp; c.v4 = v; };
    if idx == 5 { c.k5 = k; c.e5 = e; c.c5 = cmp; c.v5 = v; };
    if idx == 6 { c.k6 = k; c.e6 = e; c.c6 = cmp; c.v6 = v; };
    if idx == 7 { c.k7 = k; c.e7 = e; c.c7 = cmp; c.v7 = v; };
    return c;
}

// reserve_entity: returns next entity id placeholder (mirrors shallow that spawns a world entity;
// deep variant returns the next id without a world arg).
fn ecs_table_value_commands_reserve_entity(c: EcsTableValueCommandsDeep) -> (EcsTableValueCommandsDeep, i32) {
    // No-op body for parity; returns a placeholder id of 0 if queue unused.
    return (c, 0);
}

// insert: queue INSERT_COMPONENT command + side payload (component value).
fn ecs_table_value_commands_insert(c: EcsTableValueCommandsDeep, entity_id: i32, component_id: i32, value: i32) -> EcsTableValueCommandsDeep {
    if c.count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    if c.pcomp_count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    let slot = c.pcomp_count;
    c = ecs_table_value_commands_set_pcomp(c, slot, value);
    c.pcomp_count = c.pcomp_count + 1;
    c = ecs_table_value_commands_set_slot(c, c.count, ECS_CMD_TABLE_VALUE_INSERT_COMPONENT, entity_id, component_id, slot);
    c.count = c.count + 1;
    return c;
}

// despawn command (no payload).
fn ecs_table_value_commands_despawn(c: EcsTableValueCommandsDeep, entity_id: i32) -> EcsTableValueCommandsDeep {
    if c.count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    c = ecs_table_value_commands_set_slot(c, c.count, ECS_CMD_TABLE_VALUE_DESPAWN, entity_id, 0, -1);
    c.count = c.count + 1;
    return c;
}

// insert_resource: side payload slot for resource value.
fn ecs_table_value_commands_insert_resource(c: EcsTableValueCommandsDeep, value: i32) -> EcsTableValueCommandsDeep {
    if c.count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    if c.pres_count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    let slot = c.pres_count;
    c = ecs_table_value_commands_set_pres(c, slot, value);
    c.pres_count = c.pres_count + 1;
    c = ecs_table_value_commands_set_slot(c, c.count, ECS_CMD_TABLE_VALUE_INSERT_RESOURCE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// write_message: side payload slot for message value.
fn ecs_table_value_commands_write_message(c: EcsTableValueCommandsDeep, value: i32) -> EcsTableValueCommandsDeep {
    if c.count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    if c.pmsg_count >= ECS_CMD_TABLE_VALUE_CAP_DEEP { return c; };
    let slot = c.pmsg_count;
    c = ecs_table_value_commands_set_pmsg(c, slot, value);
    c.pmsg_count = c.pmsg_count + 1;
    c = ecs_table_value_commands_set_slot(c, c.count, ECS_CMD_TABLE_VALUE_WRITE_MESSAGE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// count commands by kind (introspection analogue of `applied_count_by_kind`).
fn ecs_table_value_commands_count_by_kind(c: EcsTableValueCommandsDeep, kind: i32) -> i32 {
    let i: i32 = 0;
    let out: i32 = 0;
    while i < c.count {
        if ecs_table_value_commands_kind_at(c, i) == kind { out = out + 1; };
        i = i + 1;
    }
    return out;
}

// resolve side payload by command: read the correct side array index depending on kind.
fn ecs_table_value_commands_resolve_value(c: EcsTableValueCommandsDeep, idx: i32) -> i32 {
    let kind = ecs_table_value_commands_kind_at(c, idx);
    let vidx = ecs_table_value_commands_idx_at(c, idx);
    if kind == ECS_CMD_TABLE_VALUE_INSERT_COMPONENT {
        return ecs_table_value_commands_pcomp_at(c, vidx);
    };
    if kind == ECS_CMD_TABLE_VALUE_INSERT_RESOURCE {
        return ecs_table_value_commands_pres_at(c, vidx);
    };
    if kind == ECS_CMD_TABLE_VALUE_WRITE_MESSAGE {
        return ecs_table_value_commands_pmsg_at(c, vidx);
    };
    return 0;
}

fn ecs_table_value_commands_clear(c: EcsTableValueCommandsDeep) -> EcsTableValueCommandsDeep {
    return ecs_table_value_commands_new();
}
