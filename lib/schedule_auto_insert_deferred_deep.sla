// Deepened Bevy ECS AutoInsertApplyDeferredPass.
// Mirrors src/schedule/auto_insert_apply_deferred.rs.
// Fixed 4 no-sync edges + 4 sync points. Shallow retained.

struct EcsAidDeep {
    n0: i32, n1: i32, n2: i32, n3: i32,
    nlen: i32,
    d0: i32, sn0: i32,
    d1: i32, sn1: i32,
    d2: i32, sn2: i32,
    d3: i32, sn3: i32,
    slen: i32,
    next_sync_node: i32,
}

fn ecs_aid_deep_new() -> EcsAidDeep {
    return EcsAidDeep {
        n0: 0, n1: 0, n2: 0, n3: 0, nlen: 0,
        d0: 0, sn0: 0, d1: 0, sn1: 0, d2: 0, sn2: 0, d3: 0, sn3: 0, slen: 0,
        next_sync_node: 0,
    };
}

fn ecs_aid_deep_edge_key(from: i32, to: i32) -> i32 {
    return from * 10000 + to;
}

fn ecs_aid_deep_rebuild(
    n0: i32, n1: i32, n2: i32, n3: i32, nlen: i32,
    d0: i32, sn0: i32, d1: i32, sn1: i32, d2: i32, sn2: i32, d3: i32, sn3: i32, slen: i32,
    next_sync_node: i32
) -> EcsAidDeep {
    return EcsAidDeep {
        n0: n0, n1: n1, n2: n2, n3: n3, nlen: nlen,
        d0: d0, sn0: sn0, d1: d1, sn1: sn1, d2: d2, sn2: sn2, d3: d3, sn3: sn3, slen: slen,
        next_sync_node: next_sync_node,
    };
}

fn ecs_aid_deep_no_sync_count(p: EcsAidDeep) -> i32 { return p.nlen; }
fn ecs_aid_deep_sync_count(p: EcsAidDeep) -> i32 { return p.slen; }
fn ecs_aid_deep_next(p: EcsAidDeep) -> i32 { return p.next_sync_node; }

fn ecs_aid_deep_add_dependency(p: EcsAidDeep, from: i32, to: i32, ignore_deferred: bool) -> EcsAidDeep {
    if ignore_deferred != true { return p; };
    let key = ecs_aid_deep_edge_key(from, to);
    if p.nlen == 0 { return ecs_aid_deep_rebuild(key, p.n1, p.n2, p.n3, 1, p.d0, p.sn0, p.d1, p.sn1, p.d2, p.sn2, p.d3, p.sn3, p.slen, p.next_sync_node); };
    if p.nlen == 1 { return ecs_aid_deep_rebuild(p.n0, key, p.n2, p.n3, 2, p.d0, p.sn0, p.d1, p.sn1, p.d2, p.sn2, p.d3, p.sn3, p.slen, p.next_sync_node); };
    if p.nlen == 2 { return ecs_aid_deep_rebuild(p.n0, p.n1, key, p.n3, 3, p.d0, p.sn0, p.d1, p.sn1, p.d2, p.sn2, p.d3, p.sn3, p.slen, p.next_sync_node); };
    if p.nlen == 3 { return ecs_aid_deep_rebuild(p.n0, p.n1, p.n2, key, 4, p.d0, p.sn0, p.d1, p.sn1, p.d2, p.sn2, p.d3, p.sn3, p.slen, p.next_sync_node); };
    return p;
}

fn ecs_aid_deep_is_no_sync(p: EcsAidDeep, from: i32, to: i32) -> bool {
    let key = ecs_aid_deep_edge_key(from, to);
    if p.nlen >= 1 { if p.n0 == key { return true; }; };
    if p.nlen >= 2 { if p.n1 == key { return true; }; };
    if p.nlen >= 3 { if p.n2 == key { return true; }; };
    if p.nlen >= 4 { if p.n3 == key { return true; }; };
    return false;
}

struct EcsAidSyncDeep {
    pass: EcsAidDeep,
    node_id: i32,
}
fn ecs_aid_sync_pass(r: EcsAidSyncDeep) -> EcsAidDeep { return r.pass; }
fn ecs_aid_sync_node(r: EcsAidSyncDeep) -> i32 { return r.node_id; }

fn ecs_aid_deep_get_sync_point(p: EcsAidDeep, distance: i32) -> EcsAidSyncDeep {
    let n0 = p.n0; let n1 = p.n1; let n2 = p.n2; let n3 = p.n3; let nlen = p.nlen;
    let d0 = p.d0; let sn0 = p.sn0; let d1 = p.d1; let sn1 = p.sn1;
    let d2 = p.d2; let sn2 = p.sn2; let d3 = p.d3; let sn3 = p.sn3; let slen = p.slen;
    let next = p.next_sync_node;
    if slen >= 1 { if d0 == distance { return EcsAidSyncDeep { pass: p, node_id: sn0 }; }; };
    if slen >= 2 { if d1 == distance { return EcsAidSyncDeep { pass: p, node_id: sn1 }; }; };
    if slen >= 3 { if d2 == distance { return EcsAidSyncDeep { pass: p, node_id: sn2 }; }; };
    if slen >= 4 { if d3 == distance { return EcsAidSyncDeep { pass: p, node_id: sn3 }; }; };
    let node_id = next;
    if slen == 0 {
        let p2 = ecs_aid_deep_rebuild(n0, n1, n2, n3, nlen, distance, node_id, d1, sn1, d2, sn2, d3, sn3, 1, node_id + 1);
        return EcsAidSyncDeep { pass: p2, node_id: node_id };
    };
    if slen == 1 {
        let p2 = ecs_aid_deep_rebuild(n0, n1, n2, n3, nlen, d0, sn0, distance, node_id, d2, sn2, d3, sn3, 2, node_id + 1);
        return EcsAidSyncDeep { pass: p2, node_id: node_id };
    };
    if slen == 2 {
        let p2 = ecs_aid_deep_rebuild(n0, n1, n2, n3, nlen, d0, sn0, d1, sn1, distance, node_id, d3, sn3, 3, node_id + 1);
        return EcsAidSyncDeep { pass: p2, node_id: node_id };
    };
    if slen == 3 {
        let p2 = ecs_aid_deep_rebuild(n0, n1, n2, n3, nlen, d0, sn0, d1, sn1, d2, sn2, distance, node_id, 4, node_id + 1);
        return EcsAidSyncDeep { pass: p2, node_id: node_id };
    };
    return EcsAidSyncDeep { pass: p, node_id: 0 - 1 };
}

fn ecs_aid_deep_add_auto_sync(p: EcsAidDeep) -> EcsAidSyncDeep {
    let node_id = p.next_sync_node;
    let p2 = ecs_aid_deep_rebuild(p.n0, p.n1, p.n2, p.n3, p.nlen, p.d0, p.sn0, p.d1, p.sn1, p.d2, p.sn2, p.d3, p.sn3, p.slen, node_id + 1);
    return EcsAidSyncDeep { pass: p2, node_id: node_id };
}

fn ecs_aid_deep_should_insert_sync(p: EcsAidDeep, from: i32, to: i32, source_has_deferred: bool) -> bool {
    if source_has_deferred != true { return false; };
    if ecs_aid_deep_is_no_sync(p, from, to) { return false; };
    return true;
}

// build single edge helper: returns whether sync inserted + node
struct EcsAidBuildDeep {
    pass: EcsAidDeep,
    inserted: bool,
    from: i32,
    sync: i32,
    to: i32,
}
fn ecs_aid_build_pass(r: EcsAidBuildDeep) -> EcsAidDeep { return r.pass; }
fn ecs_aid_build_inserted(r: EcsAidBuildDeep) -> bool { return r.inserted; }
fn ecs_aid_build_from(r: EcsAidBuildDeep) -> i32 { return r.from; }
fn ecs_aid_build_sync(r: EcsAidBuildDeep) -> i32 { return r.sync; }
fn ecs_aid_build_to(r: EcsAidBuildDeep) -> i32 { return r.to; }

fn ecs_aid_deep_build_edge(p: EcsAidDeep, from: i32, to: i32, has_deferred: bool) -> EcsAidBuildDeep {
    if ecs_aid_deep_should_insert_sync(p, from, to, has_deferred) {
        let s = ecs_aid_deep_get_sync_point(p, 0);
        return EcsAidBuildDeep {
            pass: ecs_aid_sync_pass(s),
            inserted: true,
            from: from,
            sync: ecs_aid_sync_node(s),
            to: to,
        };
    };
    return EcsAidBuildDeep { pass: p, inserted: false, from: from, sync: -1, to: to };
}
