// Public per-item entity accessor: returns EcsWdEntity constructed from (id, gen).
fn ecs_wd_pair_query_entity_at(q: EcsWdPairQuery, idx: i32) -> EcsWdEntity {
    return EcsWdEntity { id: _ecs_wd_q_e_id_at(q, idx), generation: _ecs_wd_q_e_gen_at(q, idx) };
}
fn ecs_wd_pair_query_a_slot_at(q: EcsWdPairQuery, idx: i32) -> i32 { return _ecs_wd_q_a_slot_at(q, idx); }
fn ecs_wd_pair_query_a_at(q: EcsWdPairQuery, idx: i32) -> EcsWdPos {
    return EcsWdPos { x: _ecs_wd_q_a_x_at(q, idx), y: _ecs_wd_q_a_y_at(q, idx) };
}
fn ecs_wd_pair_query_b_at(q: EcsWdPairQuery, idx: i32) -> EcsWdVel {
    return EcsWdVel { x: _ecs_wd_q_b_x_at(q, idx), y: _ecs_wd_q_b_y_at(q, idx) };
}

// Setters per-item so the build loop can write into the query item-by-item.
