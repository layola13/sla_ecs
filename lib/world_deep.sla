// ── Entity allocator ops (mirrors shallow entity.sla). ──────────────────────────────────────
fn ecs_wd_allocator_next_id(w: EcsWdWorld) -> i32 { return w.next_id; }
fn ecs_wd_allocator_free_count(w: EcsWdWorld) -> i32 { return w.free_count; }
fn ecs_wd_world_change_tick(w: EcsWdWorld) -> i32 { return w.change_tick; }

fn ecs_wd_increment_tick(w0: EcsWdWorld) -> EcsWdWorld {
    w0.change_tick = w0.change_tick + 1;
    return w0;
}

// _ecs_wd_id_is_free scans world's free list for id; mirrors allocator_id_is_free.
fn _ecs_wd_id_is_free(w: EcsWdWorld, id: i32) -> bool {
    let i: i32 = 0;
    while i < w.free_count {
        if _ecs_wd_free_id_at(w, i) == id { return true; };
        i = i + 1;
    }
    return false;
}

// EcsWdSpawn wraps (World, Entity) — replaces tuple destructuring.
struct EcsWdSpawn { world: EcsWdWorld, entity: EcsWdEntity }
fn ecs_wd_spawn_world(s: EcsWdSpawn) -> EcsWdWorld { return s.world; }
fn ecs_wd_spawn_entity(s: EcsWdSpawn) -> EcsWdEntity { return s.entity; }

// ecs_wd_alloc_entity pops a free id (and decrements free_count, clears the slot) or bumps
// next_id; panics if at cap. Returns EcsWdSpawn (world, entity) wrapper.
fn ecs_wd_alloc_entity(w0: EcsWdWorld) -> EcsWdSpawn {
    if w0.free_count > 0 {
        let next_free_count = w0.free_count - 1;
        let id = _ecs_wd_free_id_at(w0, next_free_count);
        w0.free_count = next_free_count;
        w0 = _ecs_wd_set_free_id(w0, next_free_count, 0);
        let gen = _ecs_wd_gen_at(w0, id);
        return EcsWdSpawn { world: w0, entity: EcsWdEntity { id: id, generation: gen } };
    };
    if w0.next_id >= ECS_WD_CAP {
        return EcsWdSpawn { world: w0, entity: EcsWdEntity { id: -1, generation: 0 } };
    };
    let id = w0.next_id;
    w0.next_id = id + 1;
    let gen = _ecs_wd_gen_at(w0, id);
    return EcsWdSpawn { world: w0, entity: EcsWdEntity { id: id, generation: gen } };
}

// ecs_wd_is_alive checks entity id in [1, 16), below next_id, not in free list, gen matches.
fn ecs_wd_is_alive(w: EcsWdWorld, e: EcsWdEntity) -> bool {
    if e.id <= 0 { return false; };
    if e.id >= ECS_WD_CAP { return false; };
    if e.id >= w.next_id { return false; };
    if _ecs_wd_id_is_free(w, e.id) { return false; };
    return _ecs_wd_gen_at(w, e.id) == e.generation;
}

// ecs_wd_free_entity bumps generation of id and pushes id onto free_ids; no-op if not alive.
fn ecs_wd_free_entity(w0: EcsWdWorld, e: EcsWdEntity) -> EcsWdWorld {
    if ecs_wd_is_alive(w0, e) != true { return w0; };
    let cur_gen = _ecs_wd_gen_at(w0, e.id);
    w0 = _ecs_wd_set_gen(w0, e.id, cur_gen + 1);
    let pos = w0.free_count;
    w0 = _ecs_wd_set_free_id(w0, pos, e.id);
    w0.free_count = pos + 1;
    return w0;
}

// ecs_wd_world_spawn is the public spawn: returns EcsWdSpawn wrapper.
fn ecs_wd_world_spawn(w0: EcsWdWorld) -> EcsWdSpawn {
    return ecs_wd_alloc_entity(w0);
}

// ── A store slot lookup (linear scan of a_eid slots). Returns slot index >= 0 or -1. ─────────
fn _ecs_wd_a_slot_of(w: EcsWdWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.a_count {
        if _ecs_wd_a_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_wd_b_slot_of(w: EcsWdWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.b_count {
        if _ecs_wd_b_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

// ── World component operations: insert / write / remove / get / has. ─────────────────────────
// ecs_wd_insert_a: if entity alive and slot exists -> replace value, bump changed-tick only;
// else append new slot, stamp added + changed. Panics if entity not alive.
fn ecs_wd_insert_a(w0: EcsWdWorld, e: EcsWdEntity, x: i32, y: i32) -> EcsWdWorld {
    if ecs_wd_is_alive(w0, e) != true { panic(142802); };
    let slot = _ecs_wd_a_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_wd_a_set_x(w0, slot, x);
        w0 = _ecs_wd_a_set_y(w0, slot, y);
        w0 = _ecs_wd_a_set_changed(w0, slot, w0.change_tick);
        return w0;
    };
    let new_slot = w0.a_count;
    if new_slot >= ECS_WD_CAP { panic(142803); };
    w0 = _ecs_wd_a_set_eid(w0, new_slot, e.id);
    w0 = _ecs_wd_a_set_x(w0, new_slot, x);
    w0 = _ecs_wd_a_set_y(w0, new_slot, y);
    w0 = _ecs_wd_a_set_added(w0, new_slot, w0.change_tick);
    w0 = _ecs_wd_a_set_changed(w0, new_slot, w0.change_tick);
    w0.a_count = new_slot + 1;
    return w0;
}

// ecs_wd_insert_b: mirror insert_a with b_* fields.
fn ecs_wd_insert_b(w0: EcsWdWorld, e: EcsWdEntity, x: i32, y: i32) -> EcsWdWorld {
    if ecs_wd_is_alive(w0, e) != true { panic(142804); };
    let slot = _ecs_wd_b_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_wd_b_set_x(w0, slot, x);
        w0 = _ecs_wd_b_set_y(w0, slot, y);
        w0 = _ecs_wd_b_set_changed(w0, slot, w0.change_tick);
        return w0;
    };
    let new_slot = w0.b_count;
    if new_slot >= ECS_WD_CAP { panic(142805); };
    w0 = _ecs_wd_b_set_eid(w0, new_slot, e.id);
    w0 = _ecs_wd_b_set_x(w0, new_slot, x);
    w0 = _ecs_wd_b_set_y(w0, new_slot, y);
    w0 = _ecs_wd_b_set_added(w0, new_slot, w0.change_tick);
    w0 = _ecs_wd_b_set_changed(w0, new_slot, w0.change_tick);
    w0.b_count = new_slot + 1;
    return w0;
}

// ecs_wd_has_a / has_b: requires alive AND slot exists.
fn ecs_wd_has_a(w: EcsWdWorld, e: EcsWdEntity) -> bool {
    if ecs_wd_is_alive(w, e) != true { return false; };
    return _ecs_wd_a_slot_of(w, e.id) >= 0;
}

fn ecs_wd_has_b(w: EcsWdWorld, e: EcsWdEntity) -> bool {
    if ecs_wd_is_alive(w, e) != true { return false; };
    return _ecs_wd_b_slot_of(w, e.id) >= 0;
}

// ecs_wd_get_a / get_b: panic if missing. Returns EcsWdPos / EcsWdVel wrapper.
fn ecs_wd_get_a(w: EcsWdWorld, e: EcsWdEntity) -> EcsWdPos {
    if ecs_wd_has_a(w, e) != true { panic(142806); };
    let slot = _ecs_wd_a_slot_of(w, e.id);
    return EcsWdPos { x: _ecs_wd_a_x_at(w, slot), y: _ecs_wd_a_y_at(w, slot) };
}

fn ecs_wd_get_b(w: EcsWdWorld, e: EcsWdEntity) -> EcsWdVel {
    if ecs_wd_has_b(w, e) != true { panic(142807); };
    let slot = _ecs_wd_b_slot_of(w, e.id);
    return EcsWdVel { x: _ecs_wd_b_x_at(w, slot), y: _ecs_wd_b_y_at(w, slot) };
}

// ecs_wd_write_a: in-place write at slot (no new allocation); bumps changed-tick only.
fn ecs_wd_write_a(w0: EcsWdWorld, e: EcsWdEntity, x: i32, y: i32) -> EcsWdWorld {
    if ecs_wd_has_a(w0, e) != true { panic(142808); };
    let slot = _ecs_wd_a_slot_of(w0, e.id);
    if slot < 0 { panic(142809); };
    w0 = _ecs_wd_a_set_x(w0, slot, x);
    w0 = _ecs_wd_a_set_y(w0, slot, y);
    w0 = _ecs_wd_a_set_changed(w0, slot, w0.change_tick);
    return w0;
}

// ecs_wd_remove_a / remove_b: slot-addressed swap-remove. Copies last slot's eid+x+y+added+changed
// into the removed slot, then clears the last slot's eid+x+y+added+changed to 0 and drops count.
// If slot not found, no-op.
fn ecs_wd_remove_a(w0: EcsWdWorld, e: EcsWdEntity) -> EcsWdWorld {
    let slot = _ecs_wd_a_slot_of(w0, e.id);
    if slot < 0 { return w0; };
    let last = w0.a_count - 1;
    if slot != last {
        let last_eid = _ecs_wd_a_eid_at(w0, last);
        let last_x = _ecs_wd_a_x_at(w0, last);
        let last_y = _ecs_wd_a_y_at(w0, last);
        let last_added = _ecs_wd_a_added_at(w0, last);
        let last_changed = _ecs_wd_a_changed_at(w0, last);
        w0 = _ecs_wd_a_set_eid(w0, slot, last_eid);
        w0 = _ecs_wd_a_set_x(w0, slot, last_x);
        w0 = _ecs_wd_a_set_y(w0, slot, last_y);
        w0 = _ecs_wd_a_set_added(w0, slot, last_added);
        w0 = _ecs_wd_a_set_changed(w0, slot, last_changed);
    };
    w0 = _ecs_wd_a_set_eid(w0, last, 0);
    w0 = _ecs_wd_a_set_x(w0, last, 0);
    w0 = _ecs_wd_a_set_y(w0, last, 0);
    w0 = _ecs_wd_a_set_added(w0, last, 0);
    w0 = _ecs_wd_a_set_changed(w0, last, 0);
    w0.a_count = last;
    return w0;
}

fn ecs_wd_remove_b(w0: EcsWdWorld, e: EcsWdEntity) -> EcsWdWorld {
    let slot = _ecs_wd_b_slot_of(w0, e.id);
    if slot < 0 { return w0; };
    let last = w0.b_count - 1;
    if slot != last {
        let last_eid = _ecs_wd_b_eid_at(w0, last);
        let last_x = _ecs_wd_b_x_at(w0, last);
        let last_y = _ecs_wd_b_y_at(w0, last);
        let last_added = _ecs_wd_b_added_at(w0, last);
        let last_changed = _ecs_wd_b_changed_at(w0, last);
        w0 = _ecs_wd_b_set_eid(w0, slot, last_eid);
        w0 = _ecs_wd_b_set_x(w0, slot, last_x);
        w0 = _ecs_wd_b_set_y(w0, slot, last_y);
        w0 = _ecs_wd_b_set_added(w0, slot, last_added);
        w0 = _ecs_wd_b_set_changed(w0, slot, last_changed);
    };
    w0 = _ecs_wd_b_set_eid(w0, last, 0);
    w0 = _ecs_wd_b_set_x(w0, last, 0);
    w0 = _ecs_wd_b_set_y(w0, last, 0);
    w0 = _ecs_wd_b_set_added(w0, last, 0);
    w0 = _ecs_wd_b_set_changed(w0, last, 0);
    w0.b_count = last;
    return w0;
}

// ecs_wd_despawn: remove_a + remove_b + free_entity (entity allocator); no-op if not alive.
fn ecs_wd_despawn(w0: EcsWdWorld, e: EcsWdEntity) -> EcsWdWorld {
    if ecs_wd_is_alive(w0, e) != true { return w0; };
    w0 = ecs_wd_remove_a(w0, e);
    w0 = ecs_wd_remove_b(w0, e);
    w0 = ecs_wd_free_entity(w0, e);
    return w0;
}

// ecs_wd_a_added_since / a_changed_since: strict-greater-than (stamp > tick).
fn ecs_wd_a_added_since(w: EcsWdWorld, e: EcsWdEntity, tick: i32) -> bool {
    let slot = _ecs_wd_a_slot_of(w, e.id);
    if slot < 0 { return false; };
    return _ecs_wd_a_added_at(w, slot) > tick;
}

fn ecs_wd_a_changed_since(w: EcsWdWorld, e: EcsWdEntity, tick: i32) -> bool {
    let slot = _ecs_wd_a_slot_of(w, e.id);
    if slot < 0 { return false; };
    return _ecs_wd_a_changed_at(w, slot) > tick;
}

// ── Pair query over A × B. ─────────────────────────────────────────────────────────────────
// Iterates A store, finds B-slot by eid, emits an item carrying (entity, a_slot, b_slot, a, b).
// Each item is mirrored via per-index scalar fields (NO `[T; 16]` arrays in deep).
struct EcsWdPairQuery {
    count: i32,
    // Per-item entity (id + generation) up to cap-16.
    e_id0: i32, e_id1: i32, e_id2: i32, e_id3: i32, e_id4: i32, e_id5: i32, e_id6: i32, e_id7: i32,
    e_id8: i32, e_id9: i32, e_id10: i32, e_id11: i32, e_id12: i32, e_id13: i32, e_id14: i32, e_id15: i32,
    e_gen0: i32, e_gen1: i32, e_gen2: i32, e_gen3: i32, e_gen4: i32, e_gen5: i32, e_gen6: i32, e_gen7: i32,
    e_gen8: i32, e_gen9: i32, e_gen10: i32, e_gen11: i32, e_gen12: i32, e_gen13: i32, e_gen14: i32, e_gen15: i32,
    a_slot0: i32, a_slot1: i32, a_slot2: i32, a_slot3: i32, a_slot4: i32, a_slot5: i32, a_slot6: i32, a_slot7: i32,
    a_slot8: i32, a_slot9: i32, a_slot10: i32, a_slot11: i32, a_slot12: i32, a_slot13: i32, a_slot14: i32, a_slot15: i32,
    b_slot0: i32, b_slot1: i32, b_slot2: i32, b_slot3: i32, b_slot4: i32, b_slot5: i32, b_slot6: i32, b_slot7: i32,
    b_slot8: i32, b_slot9: i32, b_slot10: i32, b_slot11: i32, b_slot12: i32, b_slot13: i32, b_slot14: i32, b_slot15: i32,
    a_x0: i32, a_x1: i32, a_x2: i32, a_x3: i32, a_x4: i32, a_x5: i32, a_x6: i32, a_x7: i32,
    a_x8: i32, a_x9: i32, a_x10: i32, a_x11: i32, a_x12: i32, a_x13: i32, a_x14: i32, a_x15: i32,
    a_y0: i32, a_y1: i32, a_y2: i32, a_y3: i32, a_y4: i32, a_y5: i32, a_y6: i32, a_y7: i32,
    a_y8: i32, a_y9: i32, a_y10: i32, a_y11: i32, a_y12: i32, a_y13: i32, a_y14: i32, a_y15: i32,
    b_x0: i32, b_x1: i32, b_x2: i32, b_x3: i32, b_x4: i32, b_x5: i32, b_x6: i32, b_x7: i32,
    b_x8: i32, b_x9: i32, b_x10: i32, b_x11: i32, b_x12: i32, b_x13: i32, b_x14: i32, b_x15: i32,
    b_y0: i32, b_y1: i32, b_y2: i32, b_y3: i32, b_y4: i32, b_y5: i32, b_y6: i32, b_y7: i32,
    b_y8: i32, b_y9: i32, b_y10: i32, b_y11: i32, b_y12: i32, b_y13: i32, b_y14: i32, b_y15: i32,
}

fn ecs_wd_pair_query_new() -> EcsWdPairQuery {
    return EcsWdPairQuery {
        count: 0,
        e_id0: 0, e_id1: 0, e_id2: 0, e_id3: 0, e_id4: 0, e_id5: 0, e_id6: 0, e_id7: 0,
        e_id8: 0, e_id9: 0, e_id10: 0, e_id11: 0, e_id12: 0, e_id13: 0, e_id14: 0, e_id15: 0,
        e_gen0: 0, e_gen1: 0, e_gen2: 0, e_gen3: 0, e_gen4: 0, e_gen5: 0, e_gen6: 0, e_gen7: 0,
        e_gen8: 0, e_gen9: 0, e_gen10: 0, e_gen11: 0, e_gen12: 0, e_gen13: 0, e_gen14: 0, e_gen15: 0,
        a_slot0: 0, a_slot1: 0, a_slot2: 0, a_slot3: 0, a_slot4: 0, a_slot5: 0, a_slot6: 0, a_slot7: 0,
        a_slot8: 0, a_slot9: 0, a_slot10: 0, a_slot11: 0, a_slot12: 0, a_slot13: 0, a_slot14: 0, a_slot15: 0,
        b_slot0: 0, b_slot1: 0, b_slot2: 0, b_slot3: 0, b_slot4: 0, b_slot5: 0, b_slot6: 0, b_slot7: 0,
        b_slot8: 0, b_slot9: 0, b_slot10: 0, b_slot11: 0, b_slot12: 0, b_slot13: 0, b_slot14: 0, b_slot15: 0,
        a_x0: 0, a_x1: 0, a_x2: 0, a_x3: 0, a_x4: 0, a_x5: 0, a_x6: 0, a_x7: 0,
        a_x8: 0, a_x9: 0, a_x10: 0, a_x11: 0, a_x12: 0, a_x13: 0, a_x14: 0, a_x15: 0,
        a_y0: 0, a_y1: 0, a_y2: 0, a_y3: 0, a_y4: 0, a_y5: 0, a_y6: 0, a_y7: 0,
        a_y8: 0, a_y9: 0, a_y10: 0, a_y11: 0, a_y12: 0, a_y13: 0, a_y14: 0, a_y15: 0,
        b_x0: 0, b_x1: 0, b_x2: 0, b_x3: 0, b_x4: 0, b_x5: 0, b_x6: 0, b_x7: 0,
        b_x8: 0, b_x9: 0, b_x10: 0, b_x11: 0, b_x12: 0, b_x13: 0, b_x14: 0, b_x15: 0,
        b_y0: 0, b_y1: 0, b_y2: 0, b_y3: 0, b_y4: 0, b_y5: 0, b_y6: 0, b_y7: 0,
        b_y8: 0, b_y9: 0, b_y10: 0, b_y11: 0, b_y12: 0, b_y13: 0, b_y14: 0, b_y15: 0,
    };
}

fn ecs_wd_pair_query_count(q: EcsWdPairQuery) -> i32 { return q.count; }

// Per-item accessors (cascade-of-return on idx, dropping through to idx==15 final).
fn _ecs_wd_q_e_id_at(q: EcsWdPairQuery, idx: i32) -> i32 {
    if idx == 0 { return q.e_id0; };
    if idx == 1 { return q.e_id1; };
    if idx == 2 { return q.e_id2; };
    if idx == 3 { return q.e_id3; };
    if idx == 4 { return q.e_id4; };
    if idx == 5 { return q.e_id5; };
    if idx == 6 { return q.e_id6; };
    if idx == 7 { return q.e_id7; };
    if idx == 8 { return q.e_id8; };
    if idx == 9 { return q.e_id9; };
    if idx == 10 { return q.e_id10; };
    if idx == 11 { return q.e_id11; };
    if idx == 12 { return q.e_id12; };
    if idx == 13 { return q.e_id13; };
    if idx == 14 { return q.e_id14; };
    return q.e_id15;
}

