// ecs_wd_query_a_b: iterate A store, find B-slot by eid, emit item with entity, a_slot, b_slot, a, b.
fn ecs_wd_query_a_b(w: EcsWdWorld) -> EcsWdPairQuery {
    let q0 = ecs_wd_pair_query_new();
    let i: i32 = 0;
    while i < w.a_count {
        let eid = _ecs_wd_a_eid_at(w, i);
        let b_slot = _ecs_wd_b_slot_of(w, eid);
        if b_slot >= 0 {
            let gen = _ecs_wd_gen_at(w, eid);
            let e_at = EcsWdEntity { id: eid, generation: gen };
            if ecs_wd_is_alive(w, e_at) {
                let out = q0.count;
                q0 = _ecs_wd_q_set_e_id(q0, out, eid);
                q0 = _ecs_wd_q_set_e_gen(q0, out, gen);
                q0 = _ecs_wd_q_set_a_slot(q0, out, i);
                q0 = _ecs_wd_q_set_b_slot(q0, out, b_slot);
                q0 = _ecs_wd_q_set_a_x(q0, out, _ecs_wd_a_x_at(w, i));
                q0 = _ecs_wd_q_set_a_y(q0, out, _ecs_wd_a_y_at(w, i));
                q0 = _ecs_wd_q_set_b_x(q0, out, _ecs_wd_b_x_at(w, b_slot));
                q0 = _ecs_wd_q_set_b_y(q0, out, _ecs_wd_b_y_at(w, b_slot));
                q0.count = out + 1;
            };
        };
        i = i + 1;
    }
    return q0;
}

// ecs_wd_pair_write_a: writes A slot at item.a_slot with value, bumps changed-tick.
// Requires entity alive. Returns world.
fn ecs_wd_pair_write_a(w0: EcsWdWorld, e: EcsWdEntity, a_slot: i32, x: i32, y: i32) -> EcsWdWorld {
    if ecs_wd_is_alive(w0, e) != true { return w0; };
    if a_slot < 0 { return w0; };
    w0 = _ecs_wd_a_set_x(w0, a_slot, x);
    w0 = _ecs_wd_a_set_y(w0, a_slot, y);
    w0 = _ecs_wd_a_set_changed(w0, a_slot, w0.change_tick);
    return w0;
}

// ── Resource slot (single EcsWdTime plug) operations. ───────────────────────────────────────
// ecs_wd_insert_resource: sets res_has=1 and res_tick=tick, also stamps res_added_t+res_changed_t
// using change_tick (mirrors shallow which delegates to resource_insert + the slot has no tick
// stamp at all -- shallow resource slot has NO tick arrays; res_added_t/res_changed_t here exist
// solely to support optional `_since` queries on the resource like the world archetype batches).
// For Batch 389 the resource "added/changed since" is NOT in shallow's @test battery so we keep a
// faithful minimal mirror: shallow has no resource added/changed tick fields; here we do stamp them
// on insert to mirror archetype batch behavior for parity, but the tests only assert has/get/remove.
fn ecs_wd_insert_resource(w0: EcsWdWorld, tick: i32) -> EcsWdWorld {
    w0.res_has = 1;
    w0.res_tick = tick;
    w0.res_added_t = w0.change_tick;
    w0.res_changed_t = w0.change_tick;
    return w0;
}

fn ecs_wd_has_resource(w: EcsWdWorld) -> bool {
    return w.res_has == 1;
}

fn ecs_wd_get_resource(w: EcsWdWorld) -> EcsWdTime {
    if w.res_has != 1 { panic(142810); };
    return EcsWdTime { tick: w.res_tick };
}

fn ecs_wd_remove_resource(w0: EcsWdWorld) -> EcsWdWorld {
    w0.res_has = 0;
    return w0;
}

// ── Message queue (cap-16 EcsWdDamage plug) operations. ────────────────────────────────────
// Mirrors shallow messages_write + messages_read_next minimal slice: the deep replaces the
// ids[] + values[] + next_id + count machinery with cap-16 scalar msg slot family msg_tail (the
// current queue tail index), each msg[i] holding an amount. A read consumes at a reader cursor
// that is simply an integer; the deep returns an EcsWdRead wrapper with has_value + amount +
// cursor so the test can chain reads without tuple destructuring.
struct EcsWdRead { has_value: i32, amount: i32, cursor: i32 }
fn ecs_wd_read_has_value(r: EcsWdRead) -> i32 { return r.has_value; }
fn ecs_wd_read_amount(r: EcsWdRead) -> i32 { return r.amount; }
fn ecs_wd_read_cursor(r: EcsWdRead) -> i32 { return r.cursor; }

struct EcsWdMessageReader { cursor: i32 }
fn ecs_wd_message_reader_new() -> EcsWdMessageReader { return EcsWdMessageReader { cursor: 0 }; }
fn ecs_wd_message_reader_cursor(r: EcsWdMessageReader) -> i32 { return r.cursor; }

// ecs_wd_write_message appends an amount to the tail slot if cap available (shallow's Messages<T>
// also raises a panic on overflow -- panic 6001; here we use the unique code 142820). Bumps msg_tail.
fn ecs_wd_write_message(w0: EcsWdWorld, amount: i32) -> EcsWdWorld {
    if w0.msg_tail >= ECS_WD_CAP { panic(142820); };
    w0 = _ecs_wd_set_msg(w0, w0.msg_tail, amount);
    w0.msg_tail = w0.msg_tail + 1;
    return w0;
}

// ecs_wd_read_message reads the next unread slot at the given reader cursor. If cursor < msg_tail,
// returns has_value=1 with the amount and advancing cursor to cursor+1; else has_value=0.
fn ecs_wd_read_message(w: EcsWdWorld, reader: EcsWdMessageReader) -> EcsWdRead {
    if reader.cursor < w.msg_tail {
        let amt = _ecs_wd_msg_at(w, reader.cursor);
        return EcsWdRead { has_value: 1, amount: amt, cursor: reader.cursor + 1 };
    };
    return EcsWdRead { has_value: 0, amount: 0, cursor: reader.cursor };
}

// ecs_wd_message_count returns the current tail (number of queued messages).
fn ecs_wd_message_count(w: EcsWdWorld) -> i32 { return w.msg_tail; }

// ecs_wd_message_reader_with_cursor is the constructor helper used by tests to advance a cursor
// without inline struct-init (`let r = EcsWdMessageReader { cursor: x }` is rejected by the SA
// compiler on the test side).
fn ecs_wd_message_reader_with_cursor(cursor: i32) -> EcsWdMessageReader {
    return EcsWdMessageReader { cursor: cursor };
}
