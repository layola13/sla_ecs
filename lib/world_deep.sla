// ── Cap-16 slot accessors (cascade-of-return). ──────────────────────────────────────────────
fn _ecs_wd_at(slot: i32) -> i32 {
    if slot < 8 {
        if slot == 0 { return 0; };
        if slot == 1 { return 1; };
        if slot == 2 { return 2; };
        if slot == 3 { return 3; };
        if slot == 4 { return 4; };
        if slot == 5 { return 5; };
        if slot == 6 { return 6; };
        return 7;
    };
    if slot == 8 { return 8; };
    if slot == 9 { return 9; };
    if slot == 10 { return 10; };
    if slot == 11 { return 11; };
    if slot == 12 { return 12; };
    if slot == 13 { return 13; };
    if slot == 14 { return 14; };
    return 15;
}

fn _ecs_wd_gen_at(w: EcsWdWorld, id: i32) -> i32 {
    if id == 0 { return w.gen0; };
    if id == 1 { return w.gen1; };
    if id == 2 { return w.gen2; };
    if id == 3 { return w.gen3; };
    if id == 4 { return w.gen4; };
    if id == 5 { return w.gen5; };
    if id == 6 { return w.gen6; };
    if id == 7 { return w.gen7; };
    if id == 8 { return w.gen8; };
    if id == 9 { return w.gen9; };
    if id == 10 { return w.gen10; };
    if id == 11 { return w.gen11; };
    if id == 12 { return w.gen12; };
    if id == 13 { return w.gen13; };
    if id == 14 { return w.gen14; };
    return w.gen15;
}

fn _ecs_wd_set_gen(w0: EcsWdWorld, id: i32, value: i32) -> EcsWdWorld {
    if id == 0 { w0.gen0 = value; return w0; };
    if id == 1 { w0.gen1 = value; return w0; };
    if id == 2 { w0.gen2 = value; return w0; };
    if id == 3 { w0.gen3 = value; return w0; };
    if id == 4 { w0.gen4 = value; return w0; };
    if id == 5 { w0.gen5 = value; return w0; };
    if id == 6 { w0.gen6 = value; return w0; };
    if id == 7 { w0.gen7 = value; return w0; };
    if id == 8 { w0.gen8 = value; return w0; };
    if id == 9 { w0.gen9 = value; return w0; };
    if id == 10 { w0.gen10 = value; return w0; };
    if id == 11 { w0.gen11 = value; return w0; };
    if id == 12 { w0.gen12 = value; return w0; };
    if id == 13 { w0.gen13 = value; return w0; };
    if id == 14 { w0.gen14 = value; return w0; };
    w0.gen15 = value;
    return w0;
}

fn _ecs_wd_free_id_at(w: EcsWdWorld, idx: i32) -> i32 {
    if idx == 0 { return w.free_id0; };
    if idx == 1 { return w.free_id1; };
    if idx == 2 { return w.free_id2; };
    if idx == 3 { return w.free_id3; };
    if idx == 4 { return w.free_id4; };
    if idx == 5 { return w.free_id5; };
    if idx == 6 { return w.free_id6; };
    if idx == 7 { return w.free_id7; };
    if idx == 8 { return w.free_id8; };
