// Deep self-contained mirror of lib/executor_single_threaded.sla.
// Fixed-cap scalar model of Bevy SingleThreadedExecutor transient state.

const ECS_ST_DEEP_CAP: i32 = 16;

@derive(copy)
struct EcsSingleThreadedExecutorDeep {
    apply_final_deferred: i32,
    system_count: i64,
    set_count: i64,
    systems_run: i64,
    systems_skipped: i64,
    deferred_applied: i64,
    panic_payload_pending: i32,
    system_panic_payloads: i64,
    deferred_panic_payloads: i64,
    panic_payload_phase: i64,
    panic_payload_system: i64,
    panic_payload_rethrows: i64,
    system_handled_errors: i64,
    deferred_handled_errors: i64,
    handled_error_phase: i64,
    handled_error_system: i64,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    c8: i32, c9: i32, c10: i32, c11: i32, c12: i32, c13: i32, c14: i32, c15: i32,
    u0: i32, u1: i32, u2: i32, u3: i32, u4: i32, u5: i32, u6: i32, u7: i32,
    u8: i32, u9: i32, u10: i32, u11: i32, u12: i32, u13: i32, u14: i32, u15: i32,
    s0: i32, s1: i32, s2: i32, s3: i32, s4: i32, s5: i32, s6: i32, s7: i32,
    s8: i32, s9: i32, s10: i32, s11: i32, s12: i32, s13: i32, s14: i32, s15: i32,
}

@derive(copy)
struct EcsSingleThreadedConditionFoldResultDeep {
    should_run: i32,
    evaluated_count: i64,
    aborted: i32,
    panic_payload_pending: i32,
    system_panic_payloads: i64,
    system_handled_errors: i64,
    phase: i64,
    system: i64,
}

fn ecs_st_deep_panic_phase_none() -> i64 { return 0; }
fn ecs_st_deep_panic_phase_system() -> i64 { return 1; }
fn ecs_st_deep_panic_phase_apply_deferred() -> i64 { return 2; }
fn ecs_st_deep_panic_phase_run_condition() -> i64 { return 3; }

fn ecs_st_deep_condition_outcome_false() -> i64 { return 0; }
fn ecs_st_deep_condition_outcome_true() -> i64 { return 1; }
fn ecs_st_deep_condition_outcome_handled_error() -> i64 { return 2; }
fn ecs_st_deep_condition_outcome_error_handler_panic() -> i64 { return 3; }

fn ecs_single_threaded_executor_deep_new() -> EcsSingleThreadedExecutorDeep {
    return EcsSingleThreadedExecutorDeep {
        apply_final_deferred: 1, system_count: 0, set_count: 0,
        systems_run: 0, systems_skipped: 0, deferred_applied: 0,
        panic_payload_pending: 0, system_panic_payloads: 0, deferred_panic_payloads: 0,
        panic_payload_phase: 0, panic_payload_system: -1, panic_payload_rethrows: 0,
        system_handled_errors: 0, deferred_handled_errors: 0,
        handled_error_phase: 0, handled_error_system: -1,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        c8: 0, c9: 0, c10: 0, c11: 0, c12: 0, c13: 0, c14: 0, c15: 0,
        u0: 0, u1: 0, u2: 0, u3: 0, u4: 0, u5: 0, u6: 0, u7: 0,
        u8: 0, u9: 0, u10: 0, u11: 0, u12: 0, u13: 0, u14: 0, u15: 0,
        s0: 0, s1: 0, s2: 0, s3: 0, s4: 0, s5: 0, s6: 0, s7: 0,
        s8: 0, s9: 0, s10: 0, s11: 0, s12: 0, s13: 0, s14: 0, s15: 0,
    };
}

fn ecs_single_threaded_executor_deep_init(e: EcsSingleThreadedExecutorDeep, system_count: i64, set_count: i64) -> EcsSingleThreadedExecutorDeep {
    e.system_count = system_count;
    if e.system_count < 0 { e.system_count = 0; };
    if e.system_count > ECS_ST_DEEP_CAP as i64 { e.system_count = ECS_ST_DEEP_CAP as i64; };
    e.set_count = set_count;
    if e.set_count < 0 { e.set_count = 0; };
    if e.set_count > ECS_ST_DEEP_CAP as i64 { e.set_count = ECS_ST_DEEP_CAP as i64; };
    e.systems_run = 0;
    e.systems_skipped = 0;
    e.deferred_applied = 0;
    e.panic_payload_pending = 0;
    e.system_panic_payloads = 0;
    e.deferred_panic_payloads = 0;
    e.panic_payload_phase = ecs_st_deep_panic_phase_none();
    e.panic_payload_system = -1;
    e.panic_payload_rethrows = 0;
    e.system_handled_errors = 0;
    e.deferred_handled_errors = 0;
    e.handled_error_phase = ecs_st_deep_panic_phase_none();
    e.handled_error_system = -1;
    let i: i64 = 0;
    while i < ECS_ST_DEEP_CAP as i64 {
        e = _ecs_st_deep_completed_set(e, i, false);
        e = _ecs_st_deep_unapplied_set(e, i, false);
        e = _ecs_st_deep_set_eval_set(e, i, false);
        i = i + 1;
    }
    return e;
}

fn _ecs_st_deep_completed_at(e: EcsSingleThreadedExecutorDeep, idx: i64) -> bool {
    if idx == 0 { return e.c0 != 0; }; if idx == 1 { return e.c1 != 0; };
    if idx == 2 { return e.c2 != 0; }; if idx == 3 { return e.c3 != 0; };
    if idx == 4 { return e.c4 != 0; }; if idx == 5 { return e.c5 != 0; };
    if idx == 6 { return e.c6 != 0; }; if idx == 7 { return e.c7 != 0; };
    if idx == 8 { return e.c8 != 0; }; if idx == 9 { return e.c9 != 0; };
    if idx == 10 { return e.c10 != 0; }; if idx == 11 { return e.c11 != 0; };
    if idx == 12 { return e.c12 != 0; }; if idx == 13 { return e.c13 != 0; };
    if idx == 14 { return e.c14 != 0; }; if idx == 15 { return e.c15 != 0; };
    return false;
}

fn _ecs_st_deep_completed_set(e: EcsSingleThreadedExecutorDeep, idx: i64, v: bool) -> EcsSingleThreadedExecutorDeep {
    let b: i32 = 0;
    if v { b = 1; };
    if idx == 0 { e.c0 = b; return e; }; if idx == 1 { e.c1 = b; return e; };
    if idx == 2 { e.c2 = b; return e; }; if idx == 3 { e.c3 = b; return e; };
    if idx == 4 { e.c4 = b; return e; }; if idx == 5 { e.c5 = b; return e; };
    if idx == 6 { e.c6 = b; return e; }; if idx == 7 { e.c7 = b; return e; };
    if idx == 8 { e.c8 = b; return e; }; if idx == 9 { e.c9 = b; return e; };
    if idx == 10 { e.c10 = b; return e; }; if idx == 11 { e.c11 = b; return e; };
    if idx == 12 { e.c12 = b; return e; }; if idx == 13 { e.c13 = b; return e; };
    if idx == 14 { e.c14 = b; return e; }; if idx == 15 { e.c15 = b; return e; };
    return e;
}

fn _ecs_st_deep_unapplied_at(e: EcsSingleThreadedExecutorDeep, idx: i64) -> bool {
    if idx == 0 { return e.u0 != 0; }; if idx == 1 { return e.u1 != 0; };
    if idx == 2 { return e.u2 != 0; }; if idx == 3 { return e.u3 != 0; };
    if idx == 4 { return e.u4 != 0; }; if idx == 5 { return e.u5 != 0; };
    if idx == 6 { return e.u6 != 0; }; if idx == 7 { return e.u7 != 0; };
    if idx == 8 { return e.u8 != 0; }; if idx == 9 { return e.u9 != 0; };
    if idx == 10 { return e.u10 != 0; }; if idx == 11 { return e.u11 != 0; };
    if idx == 12 { return e.u12 != 0; }; if idx == 13 { return e.u13 != 0; };
    if idx == 14 { return e.u14 != 0; }; if idx == 15 { return e.u15 != 0; };
    return false;
}

fn _ecs_st_deep_unapplied_set(e: EcsSingleThreadedExecutorDeep, idx: i64, v: bool) -> EcsSingleThreadedExecutorDeep {
    let b: i32 = 0;
    if v { b = 1; };
    if idx == 0 { e.u0 = b; return e; }; if idx == 1 { e.u1 = b; return e; };
    if idx == 2 { e.u2 = b; return e; }; if idx == 3 { e.u3 = b; return e; };
    if idx == 4 { e.u4 = b; return e; }; if idx == 5 { e.u5 = b; return e; };
    if idx == 6 { e.u6 = b; return e; }; if idx == 7 { e.u7 = b; return e; };
    if idx == 8 { e.u8 = b; return e; }; if idx == 9 { e.u9 = b; return e; };
    if idx == 10 { e.u10 = b; return e; }; if idx == 11 { e.u11 = b; return e; };
    if idx == 12 { e.u12 = b; return e; }; if idx == 13 { e.u13 = b; return e; };
    if idx == 14 { e.u14 = b; return e; }; if idx == 15 { e.u15 = b; return e; };
    return e;
}

fn _ecs_st_deep_set_eval_at(e: EcsSingleThreadedExecutorDeep, idx: i64) -> bool {
    if idx == 0 { return e.s0 != 0; }; if idx == 1 { return e.s1 != 0; };
    if idx == 2 { return e.s2 != 0; }; if idx == 3 { return e.s3 != 0; };
    if idx == 4 { return e.s4 != 0; }; if idx == 5 { return e.s5 != 0; };
    if idx == 6 { return e.s6 != 0; }; if idx == 7 { return e.s7 != 0; };
    if idx == 8 { return e.s8 != 0; }; if idx == 9 { return e.s9 != 0; };
    if idx == 10 { return e.s10 != 0; }; if idx == 11 { return e.s11 != 0; };
    if idx == 12 { return e.s12 != 0; }; if idx == 13 { return e.s13 != 0; };
    if idx == 14 { return e.s14 != 0; }; if idx == 15 { return e.s15 != 0; };
    return false;
}

fn _ecs_st_deep_set_eval_set(e: EcsSingleThreadedExecutorDeep, idx: i64, v: bool) -> EcsSingleThreadedExecutorDeep {
    let b: i32 = 0;
    if v { b = 1; };
    if idx == 0 { e.s0 = b; return e; }; if idx == 1 { e.s1 = b; return e; };
    if idx == 2 { e.s2 = b; return e; }; if idx == 3 { e.s3 = b; return e; };
    if idx == 4 { e.s4 = b; return e; }; if idx == 5 { e.s5 = b; return e; };
    if idx == 6 { e.s6 = b; return e; }; if idx == 7 { e.s7 = b; return e; };
    if idx == 8 { e.s8 = b; return e; }; if idx == 9 { e.s9 = b; return e; };
    if idx == 10 { e.s10 = b; return e; }; if idx == 11 { e.s11 = b; return e; };
    if idx == 12 { e.s12 = b; return e; }; if idx == 13 { e.s13 = b; return e; };
    if idx == 14 { e.s14 = b; return e; }; if idx == 15 { e.s15 = b; return e; };
    return e;
}

fn ecs_st_deep_set_apply_final_deferred(e: EcsSingleThreadedExecutorDeep, apply: bool) -> EcsSingleThreadedExecutorDeep {
    e.apply_final_deferred = 0;
    if apply { e.apply_final_deferred = 1; };
    return e;
}

fn ecs_st_deep_apply_final_deferred(e: EcsSingleThreadedExecutorDeep) -> bool { return e.apply_final_deferred != 0; }
fn ecs_st_deep_system_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.system_count; }
fn ecs_st_deep_set_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.set_count; }
fn ecs_st_deep_systems_run(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.systems_run; }
fn ecs_st_deep_systems_skipped(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.systems_skipped; }
fn ecs_st_deep_deferred_applied(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.deferred_applied; }
fn ecs_st_deep_has_panic_payload(e: EcsSingleThreadedExecutorDeep) -> bool { return e.panic_payload_pending != 0; }
fn ecs_st_deep_panic_payload_phase(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.panic_payload_phase; }
fn ecs_st_deep_panic_payload_system(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.panic_payload_system; }
fn ecs_st_deep_system_panic_payload_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.system_panic_payloads; }
fn ecs_st_deep_deferred_panic_payload_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.deferred_panic_payloads; }
fn ecs_st_deep_panic_rethrow_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.panic_payload_rethrows; }
fn ecs_st_deep_system_handled_error_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.system_handled_errors; }
fn ecs_st_deep_deferred_handled_error_count(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.deferred_handled_errors; }
fn ecs_st_deep_handled_error_phase(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.handled_error_phase; }
fn ecs_st_deep_handled_error_system(e: EcsSingleThreadedExecutorDeep) -> i64 { return e.handled_error_system; }

fn ecs_st_deep_is_completed(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> bool {
    if system_index < 0 { return false; };
    if system_index >= e.system_count { return false; };
    return _ecs_st_deep_completed_at(e, system_index);
}

fn ecs_st_deep_is_unapplied(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> bool {
    if system_index < 0 { return false; };
    if system_index >= e.system_count { return false; };
    return _ecs_st_deep_unapplied_at(e, system_index);
}

fn ecs_st_deep_is_set_evaluated(e: EcsSingleThreadedExecutorDeep, set_index: i64) -> bool {
    if set_index < 0 { return false; };
    if set_index >= e.set_count { return false; };
    return _ecs_st_deep_set_eval_at(e, set_index);
}

fn ecs_st_deep_mark_completed(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    if system_index >= 0 && system_index < e.system_count { return _ecs_st_deep_completed_set(e, system_index, true); };
    return e;
}

fn ecs_st_deep_mark_unapplied(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    if system_index >= 0 && system_index < e.system_count { return _ecs_st_deep_unapplied_set(e, system_index, true); };
    return e;
}

fn ecs_st_deep_mark_set_evaluated(e: EcsSingleThreadedExecutorDeep, set_index: i64) -> EcsSingleThreadedExecutorDeep {
    if set_index >= 0 && set_index < e.set_count { return _ecs_st_deep_set_eval_set(e, set_index, true); };
    return e;
}

fn ecs_st_deep_run_system(e: EcsSingleThreadedExecutorDeep, system_index: i64, is_apply_deferred: bool) -> EcsSingleThreadedExecutorDeep {
    if ecs_st_deep_is_completed(e, system_index) { return e; };
    e = ecs_st_deep_mark_completed(e, system_index);
    if is_apply_deferred {
        e = ecs_st_deep_apply_deferred(e);
        e.systems_run = e.systems_run + 1;
        return e;
    };
    e = ecs_st_deep_mark_unapplied(e, system_index);
    e.systems_run = e.systems_run + 1;
    return e;
}

fn ecs_st_deep_skip_system(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    if ecs_st_deep_is_completed(e, system_index) { return e; };
    e = ecs_st_deep_mark_completed(e, system_index);
    e.systems_skipped = e.systems_skipped + 1;
    return e;
}

fn ecs_st_deep_process_system(e: EcsSingleThreadedExecutorDeep, system_index: i64, should_run: bool, is_apply_deferred: bool) -> EcsSingleThreadedExecutorDeep {
    if ecs_st_deep_is_completed(e, system_index) { return e; };
    if should_run != true { return ecs_st_deep_skip_system(e, system_index); };
    return ecs_st_deep_run_system(e, system_index, is_apply_deferred);
}

fn ecs_st_deep_apply_deferred(e: EcsSingleThreadedExecutorDeep) -> EcsSingleThreadedExecutorDeep {
    let i: i64 = 0;
    while i < e.system_count {
        if _ecs_st_deep_unapplied_at(e, i) {
            e = _ecs_st_deep_unapplied_set(e, i, false);
            e.deferred_applied = e.deferred_applied + 1;
        };
        i = i + 1;
    }
    return e;
}

fn ecs_st_deep_record_system_panic_payload(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    e.panic_payload_pending = 1;
    e.system_panic_payloads = e.system_panic_payloads + 1;
    e.panic_payload_phase = ecs_st_deep_panic_phase_system();
    e.panic_payload_system = system_index;
    return e;
}

fn ecs_st_deep_record_deferred_panic_payload(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    e.panic_payload_pending = 1;
    e.deferred_panic_payloads = e.deferred_panic_payloads + 1;
    e.panic_payload_phase = ecs_st_deep_panic_phase_apply_deferred();
    e.panic_payload_system = system_index;
    return e;
}

fn ecs_st_deep_record_system_handled_error(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    e.system_handled_errors = e.system_handled_errors + 1;
    e.handled_error_phase = ecs_st_deep_panic_phase_system();
    e.handled_error_system = system_index;
    return e;
}

fn ecs_st_deep_record_deferred_handled_error(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    e.deferred_handled_errors = e.deferred_handled_errors + 1;
    e.handled_error_phase = ecs_st_deep_panic_phase_apply_deferred();
    e.handled_error_system = system_index;
    return e;
}

fn ecs_st_deep_run_system_with_panic_payload(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    e = ecs_st_deep_record_system_panic_payload(e, system_index);
    return ecs_st_deep_run_system(e, system_index, false);
}

fn ecs_st_deep_run_system_with_handled_error(e: EcsSingleThreadedExecutorDeep, system_index: i64) -> EcsSingleThreadedExecutorDeep {
    e = ecs_st_deep_record_system_handled_error(e, system_index);
    return ecs_st_deep_run_system(e, system_index, false);
}

fn ecs_st_deep_apply_deferred_with_error(e: EcsSingleThreadedExecutorDeep, fail_system_index: i64) -> EcsSingleThreadedExecutorDeep {
    let failed: bool = false;
    let i: i64 = 0;
    while i < e.system_count {
        if _ecs_st_deep_unapplied_at(e, i) && failed != true {
            e = _ecs_st_deep_unapplied_set(e, i, false);
            e.deferred_applied = e.deferred_applied + 1;
            if i == fail_system_index {
                e = ecs_st_deep_record_deferred_panic_payload(e, i);
                failed = true;
            };
        };
        i = i + 1;
    }
    if failed {
        let j: i64 = 0;
        while j < e.system_count {
            e = _ecs_st_deep_unapplied_set(e, j, false);
            j = j + 1;
        }
    };
    return e;
}

fn ecs_st_deep_apply_deferred_with_handled_error(e: EcsSingleThreadedExecutorDeep, handled_system_index: i64) -> EcsSingleThreadedExecutorDeep {
    let i: i64 = 0;
    while i < e.system_count {
        if _ecs_st_deep_unapplied_at(e, i) {
            e = _ecs_st_deep_unapplied_set(e, i, false);
            e.deferred_applied = e.deferred_applied + 1;
            if i == handled_system_index { e = ecs_st_deep_record_deferred_handled_error(e, i); };
        };
        i = i + 1;
    }
    return e;
}

fn ecs_st_deep_finish_run(e: EcsSingleThreadedExecutorDeep) -> EcsSingleThreadedExecutorDeep {
    if e.apply_final_deferred != 0 { e = ecs_st_deep_apply_deferred(e); };
    let i: i64 = 0;
    while i < e.system_count {
        e = _ecs_st_deep_completed_set(e, i, false);
        i = i + 1;
    }
    let j: i64 = 0;
    while j < e.set_count {
        e = _ecs_st_deep_set_eval_set(e, j, false);
        j = j + 1;
    }
    return e;
}

fn ecs_st_deep_finish_run_with_deferred_error(e: EcsSingleThreadedExecutorDeep, fail_system_index: i64) -> EcsSingleThreadedExecutorDeep {
    if e.apply_final_deferred != 0 { e = ecs_st_deep_apply_deferred_with_error(e, fail_system_index); };
    e = ecs_st_deep_finish_run(ecs_st_deep_set_apply_final_deferred(e, false));
    e.apply_final_deferred = 1;
    return e;
}

fn ecs_st_deep_take_panic_payload(e: EcsSingleThreadedExecutorDeep) -> EcsSingleThreadedExecutorDeep {
    if e.panic_payload_pending != 0 { e.panic_payload_rethrows = e.panic_payload_rethrows + 1; };
    e.panic_payload_pending = 0;
    e.panic_payload_phase = ecs_st_deep_panic_phase_none();
    e.panic_payload_system = -1;
    return e;
}

fn ecs_st_deep_apply_initial_skips3(e: EcsSingleThreadedExecutorDeep, a: i64, b: i64, c: i64) -> EcsSingleThreadedExecutorDeep {
    if a >= 0 { e = ecs_st_deep_skip_system(e, a); };
    if b >= 0 { e = ecs_st_deep_skip_system(e, b); };
    if c >= 0 { e = ecs_st_deep_skip_system(e, c); };
    return e;
}

fn ecs_st_deep_apply_failed_set_condition3(e: EcsSingleThreadedExecutorDeep, set_index: i64, a: i64, b: i64, c: i64) -> EcsSingleThreadedExecutorDeep {
    if ecs_st_deep_is_set_evaluated(e, set_index) { return e; };
    if a >= 0 { e = ecs_st_deep_skip_system(e, a); };
    if b >= 0 { e = ecs_st_deep_skip_system(e, b); };
    if c >= 0 { e = ecs_st_deep_skip_system(e, c); };
    return ecs_st_deep_mark_set_evaluated(e, set_index);
}

fn ecs_st_deep_apply_passed_set_condition(e: EcsSingleThreadedExecutorDeep, set_index: i64) -> EcsSingleThreadedExecutorDeep {
    if ecs_st_deep_is_set_evaluated(e, set_index) { return e; };
    return ecs_st_deep_mark_set_evaluated(e, set_index);
}

fn ecs_st_deep_evaluate_and_fold_conditions4(e: EcsSingleThreadedExecutorDeep, system_index: i64, o0: i64, o1: i64, o2: i64, o3: i64, count: i64) -> EcsSingleThreadedConditionFoldResultDeep {
    let should_run: i32 = 1;
    let evaluated: i64 = 0;
    while evaluated < count {
        let outcome = o0;
        if evaluated == 1 { outcome = o1; };
        if evaluated == 2 { outcome = o2; };
        if evaluated == 3 { outcome = o3; };
        if outcome == ecs_st_deep_condition_outcome_error_handler_panic() {
            e = ecs_st_deep_record_system_panic_payload(e, system_index);
            e.panic_payload_phase = ecs_st_deep_panic_phase_run_condition();
            return EcsSingleThreadedConditionFoldResultDeep { should_run: 0, evaluated_count: evaluated + 1, aborted: 1, panic_payload_pending: e.panic_payload_pending, system_panic_payloads: e.system_panic_payloads, system_handled_errors: e.system_handled_errors, phase: e.panic_payload_phase, system: e.panic_payload_system };
        };
        if outcome == ecs_st_deep_condition_outcome_handled_error() {
            e.system_handled_errors = e.system_handled_errors + 1;
            e.handled_error_phase = ecs_st_deep_panic_phase_run_condition();
            e.handled_error_system = system_index;
            should_run = 0;
        } else {
            if outcome != ecs_st_deep_condition_outcome_true() { should_run = 0; };
        };
        evaluated = evaluated + 1;
    }
    return EcsSingleThreadedConditionFoldResultDeep { should_run: should_run, evaluated_count: evaluated, aborted: 0, panic_payload_pending: e.panic_payload_pending, system_panic_payloads: e.system_panic_payloads, system_handled_errors: e.system_handled_errors, phase: e.handled_error_phase, system: e.handled_error_system };
}

fn ecs_st_deep_condition_fold_should_run(r: EcsSingleThreadedConditionFoldResultDeep) -> bool { return r.should_run != 0; }
fn ecs_st_deep_condition_fold_evaluated_count(r: EcsSingleThreadedConditionFoldResultDeep) -> i64 { return r.evaluated_count; }
fn ecs_st_deep_condition_fold_aborted(r: EcsSingleThreadedConditionFoldResultDeep) -> bool { return r.aborted != 0; }
fn ecs_st_deep_condition_fold_has_payload(r: EcsSingleThreadedConditionFoldResultDeep) -> bool { return r.panic_payload_pending != 0; }
fn ecs_st_deep_condition_fold_phase(r: EcsSingleThreadedConditionFoldResultDeep) -> i64 { return r.phase; }
fn ecs_st_deep_condition_fold_system(r: EcsSingleThreadedConditionFoldResultDeep) -> i64 { return r.system; }
fn ecs_st_deep_condition_fold_handled_errors(r: EcsSingleThreadedConditionFoldResultDeep) -> i64 { return r.system_handled_errors; }

fn ecs_st_deep_completed_count(e: EcsSingleThreadedExecutorDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < e.system_count {
        if _ecs_st_deep_completed_at(e, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn ecs_st_deep_unapplied_count(e: EcsSingleThreadedExecutorDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < e.system_count {
        if _ecs_st_deep_unapplied_at(e, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}

fn ecs_st_deep_evaluated_set_count(e: EcsSingleThreadedExecutorDeep) -> i64 {
    let count: i64 = 0;
    let i: i64 = 0;
    while i < e.set_count {
        if _ecs_st_deep_set_eval_at(e, i) { count = count + 1; };
        i = i + 1;
    }
    return count;
}
