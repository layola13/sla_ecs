// Deepened Bevy ECS deferred command queue for RegistryErasedWorld
// (shallow lib/commands_registry_erased.sla deep; src/system/commands/registry_erased.rs).
//
// Mirrors the shallow queue but replaces the generic `RegistryErasedCommands<R, M>` + boxed
// ErasedComponentValue side array with a fixed-cap-8 kind-discriminated command queue and two
// parallel scalar side arrays per INSERT_COMPONENT entry (a `type_id` and a scalar payload
// modeling the boxed-erased-value interior we can observe). Resource and message side payloads
// are each a single cap-8 i32 array. Avoids generic type params and fn-ptr world-application:
// this library owns the command queue and introspects it; applying to a world composes with the
// world-facade module separately.
//
// Kinds (mirror shallow): INSERT_COMPONENT=1, DESPAWN=2, INSERT_RESOURCE=3, WRITE_MESSAGE=4.
// The INSERT_COMPONENT `vN` indexes the ptype/pval arrays. INSERT_RESOURCE uses pres; WRITE_MESSAGE uses pmsg.
// Operations: new, command builder, insert (queue+type_id+component value), despawn,
// insert_resource, write_message, len, count_by_kind, resolve_value, resolve_type,
// resolve_resource, resolve_message, clear, per-slot accessors.

const ECS_CMD_REG_ERASED_CAP_DEEP: i32 = 8;
const ECS_CMD_REG_ERASED_INSERT_COMPONENT: i32 = 1;
const ECS_CMD_REG_ERASED_DESPAWN: i32 = 2;
const ECS_CMD_REG_ERASED_INSERT_RESOURCE: i32 = 3;
const ECS_CMD_REG_ERASED_WRITE_MESSAGE: i32 = 4;

struct EcsRegErasedCommandDeep {
    kind: i32,
    entity_id: i32,
    component_id: i32,
    value_index: i32,
}

fn ecs_reg_erased_command(kind: i32, entity_id: i32, component_id: i32, value_index: i32) -> EcsRegErasedCommandDeep {
    return EcsRegErasedCommandDeep { kind: kind, entity_id: entity_id, component_id: component_id, value_index: value_index };
}

fn ecs_reg_erased_command_kind(c: EcsRegErasedCommandDeep) -> i32 { return c.kind; }
fn ecs_reg_erased_command_entity_id(c: EcsRegErasedCommandDeep) -> i32 { return c.entity_id; }
fn ecs_reg_erased_command_component_id(c: EcsRegErasedCommandDeep) -> i32 { return c.component_id; }
fn ecs_reg_erased_command_value_index(c: EcsRegErasedCommandDeep) -> i32 { return c.value_index; }

struct EcsRegErasedCommandsDeep {
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32,
    // erased-component side arrays: parallel ptype/pval cap-8
    pt0: i32, pt1: i32, pt2: i32, pt3: i32, pt4: i32, pt5: i32, pt6: i32, pt7: i32,
    pv0: i32, pv1: i32, pv2: i32, pv3: i32, pv4: i32, pv5: i32, pv6: i32, pv7: i32,
    pcomp_count: i32,
    // resource side array cap-8
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    pres_count: i32,
    // message side array cap-8
    m0: i32, m1: i32, m2: i32, m3: i32, m4: i32, m5: i32, m6: i32, m7: i32,
    pmsg_count: i32,
    count: i32,
}

fn ecs_reg_erased_commands_new() -> EcsRegErasedCommandsDeep {
    let c = EcsRegErasedCommandsDeep {
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0,
        pt0: 0, pt1: 0, pt2: 0, pt3: 0, pt4: 0, pt5: 0, pt6: 0, pt7: 0,
        pv0: 0, pv1: 0, pv2: 0, pv3: 0, pv4: 0, pv5: 0, pv6: 0, pv7: 0,
        pcomp_count: 0,
        r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0,
        pres_count: 0,
        m0: 0, m1: 0, m2: 0, m3: 0, m4: 0, m5: 0, m6: 0, m7: 0,
        pmsg_count: 0,
        count: 0,
    };
    return c;
}

fn ecs_reg_erased_commands_len(c: EcsRegErasedCommandsDeep) -> i32 { return c.count; }

fn ecs_reg_erased_commands_kind_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.k0; };
    if idx == 1 { return c.k1; };
    if idx == 2 { return c.k2; };
    if idx == 3 { return c.k3; };
    if idx == 4 { return c.k4; };
    if idx == 5 { return c.k5; };
    if idx == 6 { return c.k6; };
    if idx == 7 { return c.k7; };
    return 0;
}

fn ecs_reg_erased_commands_entity_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    return 0;
}

fn ecs_reg_erased_commands_cmp_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    if idx == 7 { return c.c7; };
    return 0;
}

fn ecs_reg_erased_commands_idx_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.v0; };
    if idx == 1 { return c.v1; };
    if idx == 2 { return c.v2; };
    if idx == 3 { return c.v3; };
    if idx == 4 { return c.v4; };
    if idx == 5 { return c.v5; };
    if idx == 6 { return c.v6; };
    if idx == 7 { return c.v7; };
    return 0;
}

// ptype/pval setters/readers (cap-8)
fn ecs_reg_erased_commands_set_pt(c: EcsRegErasedCommandsDeep, idx: i32, value: i32) -> EcsRegErasedCommandsDeep {
    if idx == 0 { c.pt0 = value; };
    if idx == 1 { c.pt1 = value; };
    if idx == 2 { c.pt2 = value; };
    if idx == 3 { c.pt3 = value; };
    if idx == 4 { c.pt4 = value; };
    if idx == 5 { c.pt5 = value; };
    if idx == 6 { c.pt6 = value; };
    if idx == 7 { c.pt7 = value; };
    return c;
}

fn ecs_reg_erased_commands_pt_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.pt0; };
    if idx == 1 { return c.pt1; };
    if idx == 2 { return c.pt2; };
    if idx == 3 { return c.pt3; };
    if idx == 4 { return c.pt4; };
    if idx == 5 { return c.pt5; };
    if idx == 6 { return c.pt6; };
    if idx == 7 { return c.pt7; };
    return 0;
}

fn ecs_reg_erased_commands_set_pv(c: EcsRegErasedCommandsDeep, idx: i32, value: i32) -> EcsRegErasedCommandsDeep {
    if idx == 0 { c.pv0 = value; };
    if idx == 1 { c.pv1 = value; };
    if idx == 2 { c.pv2 = value; };
    if idx == 3 { c.pv3 = value; };
    if idx == 4 { c.pv4 = value; };
    if idx == 5 { c.pv5 = value; };
    if idx == 6 { c.pv6 = value; };
    if idx == 7 { c.pv7 = value; };
    return c;
}

fn ecs_reg_erased_commands_pv_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.pv0; };
    if idx == 1 { return c.pv1; };
    if idx == 2 { return c.pv2; };
    if idx == 3 { return c.pv3; };
    if idx == 4 { return c.pv4; };
    if idx == 5 { return c.pv5; };
    if idx == 6 { return c.pv6; };
    if idx == 7 { return c.pv7; };
    return 0;
}

// pres
fn ecs_reg_erased_commands_set_pres(c: EcsRegErasedCommandsDeep, idx: i32, value: i32) -> EcsRegErasedCommandsDeep {
    if idx == 0 { c.r0 = value; };
    if idx == 1 { c.r1 = value; };
    if idx == 2 { c.r2 = value; };
    if idx == 3 { c.r3 = value; };
    if idx == 4 { c.r4 = value; };
    if idx == 5 { c.r5 = value; };
    if idx == 6 { c.r6 = value; };
    if idx == 7 { c.r7 = value; };
    return c;
}

fn ecs_reg_erased_commands_pres_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.r0; };
    if idx == 1 { return c.r1; };
    if idx == 2 { return c.r2; };
    if idx == 3 { return c.r3; };
    if idx == 4 { return c.r4; };
    if idx == 5 { return c.r5; };
    if idx == 6 { return c.r6; };
    if idx == 7 { return c.r7; };
    return 0;
}

// pmsg
fn ecs_reg_erased_commands_set_pmsg(c: EcsRegErasedCommandsDeep, idx: i32, value: i32) -> EcsRegErasedCommandsDeep {
    if idx == 0 { c.m0 = value; };
    if idx == 1 { c.m1 = value; };
    if idx == 2 { c.m2 = value; };
    if idx == 3 { c.m3 = value; };
    if idx == 4 { c.m4 = value; };
    if idx == 5 { c.m5 = value; };
    if idx == 6 { c.m6 = value; };
    if idx == 7 { c.m7 = value; };
    return c;
}

fn ecs_reg_erased_commands_pmsg_at(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.m0; };
    if idx == 1 { return c.m1; };
    if idx == 2 { return c.m2; };
    if idx == 3 { return c.m3; };
    if idx == 4 { return c.m4; };
    if idx == 5 { return c.m5; };
    if idx == 6 { return c.m6; };
    if idx == 7 { return c.m7; };
    return 0;
}

fn ecs_reg_erased_commands_pcomp_count(c: EcsRegErasedCommandsDeep) -> i32 { return c.pcomp_count; }
fn ecs_reg_erased_commands_pres_count(c: EcsRegErasedCommandsDeep) -> i32 { return c.pres_count; }
fn ecs_reg_erased_commands_pmsg_count(c: EcsRegErasedCommandsDeep) -> i32 { return c.pmsg_count; }

fn ecs_reg_erased_commands_set_slot(c: EcsRegErasedCommandsDeep, idx: i32, k: i32, e: i32, cmp: i32, v: i32) -> EcsRegErasedCommandsDeep {
    if idx == 0 { c.k0 = k; c.e0 = e; c.c0 = cmp; c.v0 = v; };
    if idx == 1 { c.k1 = k; c.e1 = e; c.c1 = cmp; c.v1 = v; };
    if idx == 2 { c.k2 = k; c.e2 = e; c.c2 = cmp; c.v2 = v; };
    if idx == 3 { c.k3 = k; c.e3 = e; c.c3 = cmp; c.v3 = v; };
    if idx == 4 { c.k4 = k; c.e4 = e; c.c4 = cmp; c.v4 = v; };
    if idx == 5 { c.k5 = k; c.e5 = e; c.c5 = cmp; c.v5 = v; };
    if idx == 6 { c.k6 = k; c.e6 = e; c.c6 = cmp; c.v6 = v; };
    if idx == 7 { c.k7 = k; c.e7 = e; c.c7 = cmp; c.v7 = v; };
    return c;
}

fn ecs_reg_erased_commands_reserve_entity(c: EcsRegErasedCommandsDeep) -> (EcsRegErasedCommandsDeep, i32) {
    return (c, 0);
}

// insert(entity, component_id, type_id, value): push type_id/value into the parallel pt/pv side
// array then queue INSERT_COMPONENT pointing at the side index.
fn ecs_reg_erased_commands_insert(c: EcsRegErasedCommandsDeep, entity_id: i32, component_id: i32, type_id: i32, value: i32) -> EcsRegErasedCommandsDeep {
    if c.count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    if c.pcomp_count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    let slot: i32 = c.pcomp_count;
    c = ecs_reg_erased_commands_set_pt(c, slot, type_id);
    c = ecs_reg_erased_commands_set_pv(c, slot, value);
    c.pcomp_count = c.pcomp_count + 1;
    c = ecs_reg_erased_commands_set_slot(c, c.count, ECS_CMD_REG_ERASED_INSERT_COMPONENT, entity_id, component_id, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_reg_erased_commands_despawn(c: EcsRegErasedCommandsDeep, entity_id: i32) -> EcsRegErasedCommandsDeep {
    if c.count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    c = ecs_reg_erased_commands_set_slot(c, c.count, ECS_CMD_REG_ERASED_DESPAWN, entity_id, 0, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_reg_erased_commands_insert_resource(c: EcsRegErasedCommandsDeep, value: i32) -> EcsRegErasedCommandsDeep {
    if c.count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    if c.pres_count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    let slot: i32 = c.pres_count;
    c = ecs_reg_erased_commands_set_pres(c, slot, value);
    c.pres_count = c.pres_count + 1;
    c = ecs_reg_erased_commands_set_slot(c, c.count, ECS_CMD_REG_ERASED_INSERT_RESOURCE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_reg_erased_commands_write_message(c: EcsRegErasedCommandsDeep, value: i32) -> EcsRegErasedCommandsDeep {
    if c.count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    if c.pmsg_count >= ECS_CMD_REG_ERASED_CAP_DEEP { return c; };
    let slot: i32 = c.pmsg_count;
    c = ecs_reg_erased_commands_set_pmsg(c, slot, value);
    c.pmsg_count = c.pmsg_count + 1;
    c = ecs_reg_erased_commands_set_slot(c, c.count, ECS_CMD_REG_ERASED_WRITE_MESSAGE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_reg_erased_commands_count_by_kind(c: EcsRegErasedCommandsDeep, kind: i32) -> i32 {
    let i: i32 = 0;
    let out: i32 = 0;
    while i < c.count {
        if ecs_reg_erased_commands_kind_at(c, i) == kind { out = out + 1; };
        i = i + 1;
    }
    return out;
}

// resolve_value(idx): returns the scalar payload for the kind at idx; always 0 for DESPAWN.
fn ecs_reg_erased_commands_resolve_value(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_reg_erased_commands_kind_at(c, idx);
    let vidx: i32 = ecs_reg_erased_commands_idx_at(c, idx);
    if kind == ECS_CMD_REG_ERASED_INSERT_COMPONENT {
        return ecs_reg_erased_commands_pv_at(c, vidx);
    };
    if kind == ECS_CMD_REG_ERASED_INSERT_RESOURCE {
        return ecs_reg_erased_commands_pres_at(c, vidx);
    };
    if kind == ECS_CMD_REG_ERASED_WRITE_MESSAGE {
        return ecs_reg_erased_commands_pmsg_at(c, vidx);
    };
    return 0;
}

// resolve_type(idx): returns the boxed-component type_id for INSERT_COMPONENT, else 0.
fn ecs_reg_erased_commands_resolve_type(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_reg_erased_commands_kind_at(c, idx);
    if kind == ECS_CMD_REG_ERASED_INSERT_COMPONENT {
        let vidx: i32 = ecs_reg_erased_commands_idx_at(c, idx);
        return ecs_reg_erased_commands_pt_at(c, vidx);
    };
    return 0;
}

// resolve_resource(idx): returns the resource value for INSERT_RESOURCE, else 0.
fn ecs_reg_erased_commands_resolve_resource(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_reg_erased_commands_kind_at(c, idx);
    if kind == ECS_CMD_REG_ERASED_INSERT_RESOURCE {
        let vidx: i32 = ecs_reg_erased_commands_idx_at(c, idx);
        return ecs_reg_erased_commands_pres_at(c, vidx);
    };
    return 0;
}

// resolve_message(idx): returns the message value for WRITE_MESSAGE, else 0.
fn ecs_reg_erased_commands_resolve_message(c: EcsRegErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_reg_erased_commands_kind_at(c, idx);
    if kind == ECS_CMD_REG_ERASED_WRITE_MESSAGE {
        let vidx: i32 = ecs_reg_erased_commands_idx_at(c, idx);
        return ecs_reg_erased_commands_pmsg_at(c, vidx);
    };
    return 0;
}

fn ecs_reg_erased_commands_clear(c: EcsRegErasedCommandsDeep) -> EcsRegErasedCommandsDeep {
    return ecs_reg_erased_commands_new();
}
