// Deepened Bevy ECS QueryLens surface.
// Mirrors src/system/query.rs QueryLens:
//   access subset transmute, filtered transmute, join entity intersection,
//   join_filtered, query view, write-access validation, matched get.
// Shallow lib/query_lens.sla retained.
// Fixed capacity: 4 accesses, 8 matched entities, 4 filter ids.

struct EcsQlDeep {
    access_len: i32,
    a0: i32, aw0: i32, // 0=read 1=write
    a1: i32, aw1: i32,
    a2: i32, aw2: i32,
    a3: i32, aw3: i32,
    match_len: i32,
    e0: i64, v0: i64,
    e1: i64, v1: i64,
    e2: i64, v2: i64,
    e3: i64, v3: i64,
    e4: i64, v4: i64,
    e5: i64, v5: i64,
    e6: i64, v6: i64,
    e7: i64, v7: i64,
    filter_len: i32,
    f0: i32, f1: i32, f2: i32, f3: i32,
}

fn ecs_ql_deep_new() -> EcsQlDeep {
    return EcsQlDeep {
        access_len: 0, a0: -1, aw0: 0, a1: -1, aw1: 0, a2: -1, aw2: 0, a3: -1, aw3: 0,
        match_len: 0,
        e0: 0, v0: 0, e1: 0, v1: 0, e2: 0, v2: 0, e3: 0, v3: 0,
        e4: 0, v4: 0, e5: 0, v5: 0, e6: 0, v6: 0, e7: 0, v7: 0,
        filter_len: 0, f0: -1, f1: -1, f2: -1, f3: -1,
    };
}

fn ecs_ql_deep_access_len(l: EcsQlDeep) -> i32 { return l.access_len; }
fn ecs_ql_deep_match_len(l: EcsQlDeep) -> i32 { return l.match_len; }
fn ecs_ql_deep_filter_len(l: EcsQlDeep) -> i32 { return l.filter_len; }

fn ecs_ql_deep_has_access(l: EcsQlDeep, cid: i32) -> bool {
    if l.access_len >= 1 { if l.a0 == cid { return true; }; };
    if l.access_len >= 2 { if l.a1 == cid { return true; }; };
    if l.access_len >= 3 { if l.a2 == cid { return true; }; };
    if l.access_len >= 4 { if l.a3 == cid { return true; }; };
    return false;
}

fn ecs_ql_deep_has_write(l: EcsQlDeep, cid: i32) -> bool {
    if l.access_len >= 1 { if l.a0 == cid { if l.aw0 != 0 { return true; }; }; };
    if l.access_len >= 2 { if l.a1 == cid { if l.aw1 != 0 { return true; }; }; };
    if l.access_len >= 3 { if l.a2 == cid { if l.aw2 != 0 { return true; }; }; };
    if l.access_len >= 4 { if l.a3 == cid { if l.aw3 != 0 { return true; }; }; };
    return false;
}

fn ecs_ql_deep_add_access(l: EcsQlDeep, cid: i32, is_write: i32) -> EcsQlDeep {
    if ecs_ql_deep_has_access(l, cid) { return l; };
    if l.access_len >= 4 { return l; };
    if l.access_len == 0 {
        return EcsQlDeep {
            access_len: 1, a0: cid, aw0: is_write, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
            match_len: l.match_len,
            e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
            e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
            filter_len: l.filter_len, f0: l.f0, f1: l.f1, f2: l.f2, f3: l.f3,
        };
    };
    if l.access_len == 1 {
        return EcsQlDeep {
            access_len: 2, a0: l.a0, aw0: l.aw0, a1: cid, aw1: is_write, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
            match_len: l.match_len,
            e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
            e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
            filter_len: l.filter_len, f0: l.f0, f1: l.f1, f2: l.f2, f3: l.f3,
        };
    };
    if l.access_len == 2 {
        return EcsQlDeep {
            access_len: 3, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: cid, aw2: is_write, a3: l.a3, aw3: l.aw3,
            match_len: l.match_len,
            e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
            e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
            filter_len: l.filter_len, f0: l.f0, f1: l.f1, f2: l.f2, f3: l.f3,
        };
    };
    return EcsQlDeep {
        access_len: 4, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: cid, aw3: is_write,
        match_len: l.match_len,
        e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
        e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
        filter_len: l.filter_len, f0: l.f0, f1: l.f1, f2: l.f2, f3: l.f3,
    };
}

fn ecs_ql_deep_push_match(l: EcsQlDeep, entity: i64, value: i64) -> EcsQlDeep {
    if l.match_len >= 8 { return l; };
    let n = l.match_len;
    let e0 = l.e0; let v0 = l.v0; let e1 = l.e1; let v1 = l.v1;
    let e2 = l.e2; let v2 = l.v2; let e3 = l.e3; let v3 = l.v3;
    let e4 = l.e4; let v4 = l.v4; let e5 = l.e5; let v5 = l.v5;
    let e6 = l.e6; let v6 = l.v6; let e7 = l.e7; let v7 = l.v7;
    if n == 0 { e0 = entity; v0 = value; };
    if n == 1 { e1 = entity; v1 = value; };
    if n == 2 { e2 = entity; v2 = value; };
    if n == 3 { e3 = entity; v3 = value; };
    if n == 4 { e4 = entity; v4 = value; };
    if n == 5 { e5 = entity; v5 = value; };
    if n == 6 { e6 = entity; v6 = value; };
    if n == 7 { e7 = entity; v7 = value; };
    return EcsQlDeep {
        access_len: l.access_len, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
        match_len: n + 1,
        e0: e0, v0: v0, e1: e1, v1: v1, e2: e2, v2: v2, e3: e3, v3: v3,
        e4: e4, v4: v4, e5: e5, v5: v5, e6: e6, v6: v6, e7: e7, v7: v7,
        filter_len: l.filter_len, f0: l.f0, f1: l.f1, f2: l.f2, f3: l.f3,
    };
}

fn ecs_ql_deep_entity_at(l: EcsQlDeep, idx: i32) -> i64 {
    if idx == 0 { return l.e0; };
    if idx == 1 { return l.e1; };
    if idx == 2 { return l.e2; };
    if idx == 3 { return l.e3; };
    if idx == 4 { return l.e4; };
    if idx == 5 { return l.e5; };
    if idx == 6 { return l.e6; };
    if idx == 7 { return l.e7; };
    return 0;
}
fn ecs_ql_deep_value_at(l: EcsQlDeep, idx: i32) -> i64 {
    if idx == 0 { return l.v0; };
    if idx == 1 { return l.v1; };
    if idx == 2 { return l.v2; };
    if idx == 3 { return l.v3; };
    if idx == 4 { return l.v4; };
    if idx == 5 { return l.v5; };
    if idx == 6 { return l.v6; };
    if idx == 7 { return l.v7; };
    return 0;
}

struct EcsQlFindDeep {
    found: bool,
    value: i64,
}
fn ecs_ql_find_found(r: EcsQlFindDeep) -> bool { return r.found; }
fn ecs_ql_find_value(r: EcsQlFindDeep) -> i64 { return r.value; }

fn ecs_ql_deep_find(l: EcsQlDeep, entity: i64) -> EcsQlFindDeep {
    if l.match_len >= 1 { if l.e0 == entity { return EcsQlFindDeep { found: true, value: l.v0 }; }; };
    if l.match_len >= 2 { if l.e1 == entity { return EcsQlFindDeep { found: true, value: l.v1 }; }; };
    if l.match_len >= 3 { if l.e2 == entity { return EcsQlFindDeep { found: true, value: l.v2 }; }; };
    if l.match_len >= 4 { if l.e3 == entity { return EcsQlFindDeep { found: true, value: l.v3 }; }; };
    if l.match_len >= 5 { if l.e4 == entity { return EcsQlFindDeep { found: true, value: l.v4 }; }; };
    if l.match_len >= 6 { if l.e5 == entity { return EcsQlFindDeep { found: true, value: l.v5 }; }; };
    if l.match_len >= 7 { if l.e6 == entity { return EcsQlFindDeep { found: true, value: l.v6 }; }; };
    if l.match_len >= 8 { if l.e7 == entity { return EcsQlFindDeep { found: true, value: l.v7 }; }; };
    return EcsQlFindDeep { found: false, value: 0 };
}

// transmute: keep only requested access ids that exist in source (subset)
// write requested only if source has write
fn ecs_ql_deep_transmute2(l: EcsQlDeep, c0: i32, w0: i32, c1: i32, w1: i32, n: i32) -> EcsQlDeep {
    let mlen = l.match_len;
    let me0 = l.e0; let mv0 = l.v0; let me1 = l.e1; let mv1 = l.v1;
    let me2 = l.e2; let mv2 = l.v2; let me3 = l.e3; let mv3 = l.v3;
    let me4 = l.e4; let mv4 = l.v4; let me5 = l.e5; let mv5 = l.v5;
    let me6 = l.e6; let mv6 = l.v6; let me7 = l.e7; let mv7 = l.v7;
    let alen = l.access_len;
    let la0 = l.a0; let law0 = l.aw0; let la1 = l.a1; let law1 = l.aw1;
    let la2 = l.a2; let law2 = l.aw2; let la3 = l.a3; let law3 = l.aw3;
    let has0 = false; let write0 = false;
    let has1 = false; let write1 = false;
    if n >= 1 {
        if alen >= 1 { if la0 == c0 { has0 = true; if law0 != 0 { write0 = true; }; }; };
        if alen >= 2 { if la1 == c0 { has0 = true; if law1 != 0 { write0 = true; }; }; };
        if alen >= 3 { if la2 == c0 { has0 = true; if law2 != 0 { write0 = true; }; }; };
        if alen >= 4 { if la3 == c0 { has0 = true; if law3 != 0 { write0 = true; }; }; };
        if w0 == 0 { write0 = false; };
    };
    if n >= 2 {
        if alen >= 1 { if la0 == c1 { has1 = true; if law0 != 0 { write1 = true; }; }; };
        if alen >= 2 { if la1 == c1 { has1 = true; if law1 != 0 { write1 = true; }; }; };
        if alen >= 3 { if la2 == c1 { has1 = true; if law2 != 0 { write1 = true; }; }; };
        if alen >= 4 { if la3 == c1 { has1 = true; if law3 != 0 { write1 = true; }; }; };
        if w1 == 0 { write1 = false; };
    };
    let out = ecs_ql_deep_new();
    if mlen >= 1 { out = ecs_ql_deep_push_match(out, me0, mv0); };
    if mlen >= 2 { out = ecs_ql_deep_push_match(out, me1, mv1); };
    if mlen >= 3 { out = ecs_ql_deep_push_match(out, me2, mv2); };
    if mlen >= 4 { out = ecs_ql_deep_push_match(out, me3, mv3); };
    if mlen >= 5 { out = ecs_ql_deep_push_match(out, me4, mv4); };
    if mlen >= 6 { out = ecs_ql_deep_push_match(out, me5, mv5); };
    if mlen >= 7 { out = ecs_ql_deep_push_match(out, me6, mv6); };
    if mlen >= 8 { out = ecs_ql_deep_push_match(out, me7, mv7); };
    if has0 {
        let ww = 0;
        if write0 { ww = 1; };
        out = ecs_ql_deep_add_access(out, c0, ww);
    };
    if has1 {
        let ww = 0;
        if write1 { ww = 1; };
        out = ecs_ql_deep_add_access(out, c1, ww);
    };
    return out;
}

fn ecs_ql_deep_add_filter(l: EcsQlDeep, cid: i32) -> EcsQlDeep {
    if l.filter_len >= 4 { return l; };
    if l.filter_len == 0 {
        return EcsQlDeep {
            access_len: l.access_len, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
            match_len: l.match_len,
            e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
            e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
            filter_len: 1, f0: cid, f1: l.f1, f2: l.f2, f3: l.f3,
        };
    };
    if l.filter_len == 1 {
        return EcsQlDeep {
            access_len: l.access_len, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
            match_len: l.match_len,
            e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
            e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
            filter_len: 2, f0: l.f0, f1: cid, f2: l.f2, f3: l.f3,
        };
    };
    if l.filter_len == 2 {
        return EcsQlDeep {
            access_len: l.access_len, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
            match_len: l.match_len,
            e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
            e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
            filter_len: 3, f0: l.f0, f1: l.f1, f2: cid, f3: l.f3,
        };
    };
    return EcsQlDeep {
        access_len: l.access_len, a0: l.a0, aw0: l.aw0, a1: l.a1, aw1: l.aw1, a2: l.a2, aw2: l.aw2, a3: l.a3, aw3: l.aw3,
        match_len: l.match_len,
        e0: l.e0, v0: l.v0, e1: l.e1, v1: l.v1, e2: l.e2, v2: l.v2, e3: l.e3, v3: l.v3,
        e4: l.e4, v4: l.v4, e5: l.e5, v5: l.v5, e6: l.e6, v6: l.v6, e7: l.e7, v7: l.v7,
        filter_len: 4, f0: l.f0, f1: l.f1, f2: l.f2, f3: cid,
    };
}

fn ecs_ql_deep_transmute_filtered2(l: EcsQlDeep, c0: i32, w0: i32, c1: i32, w1: i32, n: i32, filt: i32) -> EcsQlDeep {
    let out = ecs_ql_deep_transmute2(l, c0, w0, c1, w1, n);
    return ecs_ql_deep_add_filter(out, filt);
}

// join: entity intersection; values from a; merge accesses
fn ecs_ql_deep_join(a: EcsQlDeep, b: EcsQlDeep) -> EcsQlDeep {
    let aa0 = a.a0; let aaw0 = a.aw0; let aa1 = a.a1; let aaw1 = a.aw1;
    let aa2 = a.a2; let aaw2 = a.aw2; let aa3 = a.a3; let aaw3 = a.aw3; let aalen = a.access_len;
    let amlen = a.match_len;
    let ae0 = a.e0; let av0 = a.v0; let ae1 = a.e1; let av1 = a.v1;
    let ae2 = a.e2; let av2 = a.v2; let ae3 = a.e3; let av3 = a.v3;
    let ae4 = a.e4; let av4 = a.v4; let ae5 = a.e5; let av5 = a.v5;
    let ae6 = a.e6; let av6 = a.v6; let ae7 = a.e7; let av7 = a.v7;
    let ba0 = b.a0; let baw0 = b.aw0; let ba1 = b.a1; let baw1 = b.aw1;
    let ba2 = b.a2; let baw2 = b.aw2; let ba3 = b.a3; let baw3 = b.aw3; let balen = b.access_len;
    let bmlen = b.match_len;
    let be0 = b.e0; let be1 = b.e1; let be2 = b.e2; let be3 = b.e3;
    let be4 = b.e4; let be5 = b.e5; let be6 = b.e6; let be7 = b.e7;
    let out = ecs_ql_deep_new();
    if aalen >= 1 { out = ecs_ql_deep_add_access(out, aa0, aaw0); };
    if aalen >= 2 { out = ecs_ql_deep_add_access(out, aa1, aaw1); };
    if aalen >= 3 { out = ecs_ql_deep_add_access(out, aa2, aaw2); };
    if aalen >= 4 { out = ecs_ql_deep_add_access(out, aa3, aaw3); };
    if balen >= 1 { out = ecs_ql_deep_add_access(out, ba0, baw0); };
    if balen >= 2 { out = ecs_ql_deep_add_access(out, ba1, baw1); };
    if balen >= 3 { out = ecs_ql_deep_add_access(out, ba2, baw2); };
    if balen >= 4 { out = ecs_ql_deep_add_access(out, ba3, baw3); };
    // intersect using captured entity lists
    if amlen >= 1 {
        let ok = false;
        if bmlen >= 1 { if be0 == ae0 { ok = true; }; };
        if bmlen >= 2 { if be1 == ae0 { ok = true; }; };
        if bmlen >= 3 { if be2 == ae0 { ok = true; }; };
        if bmlen >= 4 { if be3 == ae0 { ok = true; }; };
        if bmlen >= 5 { if be4 == ae0 { ok = true; }; };
        if bmlen >= 6 { if be5 == ae0 { ok = true; }; };
        if bmlen >= 7 { if be6 == ae0 { ok = true; }; };
        if bmlen >= 8 { if be7 == ae0 { ok = true; }; };
        if ok { out = ecs_ql_deep_push_match(out, ae0, av0); };
    };
    if amlen >= 2 {
        let ok = false;
        if bmlen >= 1 { if be0 == ae1 { ok = true; }; };
        if bmlen >= 2 { if be1 == ae1 { ok = true; }; };
        if bmlen >= 3 { if be2 == ae1 { ok = true; }; };
        if bmlen >= 4 { if be3 == ae1 { ok = true; }; };
        if bmlen >= 5 { if be4 == ae1 { ok = true; }; };
        if bmlen >= 6 { if be5 == ae1 { ok = true; }; };
        if bmlen >= 7 { if be6 == ae1 { ok = true; }; };
        if bmlen >= 8 { if be7 == ae1 { ok = true; }; };
        if ok { out = ecs_ql_deep_push_match(out, ae1, av1); };
    };
    if amlen >= 3 {
        let ok = false;
        if bmlen >= 1 { if be0 == ae2 { ok = true; }; };
        if bmlen >= 2 { if be1 == ae2 { ok = true; }; };
        if bmlen >= 3 { if be2 == ae2 { ok = true; }; };
        if bmlen >= 4 { if be3 == ae2 { ok = true; }; };
        if bmlen >= 5 { if be4 == ae2 { ok = true; }; };
        if bmlen >= 6 { if be5 == ae2 { ok = true; }; };
        if bmlen >= 7 { if be6 == ae2 { ok = true; }; };
        if bmlen >= 8 { if be7 == ae2 { ok = true; }; };
        if ok { out = ecs_ql_deep_push_match(out, ae2, av2); };
    };
    if amlen >= 4 {
        let ok = false;
        if bmlen >= 1 { if be0 == ae3 { ok = true; }; };
        if bmlen >= 2 { if be1 == ae3 { ok = true; }; };
        if bmlen >= 3 { if be2 == ae3 { ok = true; }; };
        if bmlen >= 4 { if be3 == ae3 { ok = true; }; };
        if bmlen >= 5 { if be4 == ae3 { ok = true; }; };
        if bmlen >= 6 { if be5 == ae3 { ok = true; }; };
        if bmlen >= 7 { if be6 == ae3 { ok = true; }; };
        if bmlen >= 8 { if be7 == ae3 { ok = true; }; };
        if ok { out = ecs_ql_deep_push_match(out, ae3, av3); };
    };
    return out;
}

fn ecs_ql_deep_join_filtered(a: EcsQlDeep, b: EcsQlDeep, filt: i32) -> EcsQlDeep {
    let out = ecs_ql_deep_join(a, b);
    return ecs_ql_deep_add_filter(out, filt);
}

// as_query_lens / query: identity view
fn ecs_ql_deep_query(l: EcsQlDeep) -> EcsQlDeep { return l; }

// write count helper
fn ecs_ql_deep_write_count(l: EcsQlDeep) -> i32 {
    let n = 0;
    if l.access_len >= 1 { if l.aw0 != 0 { n = n + 1; }; };
    if l.access_len >= 2 { if l.aw1 != 0 { n = n + 1; }; };
    if l.access_len >= 3 { if l.aw2 != 0 { n = n + 1; }; };
    if l.access_len >= 4 { if l.aw3 != 0 { n = n + 1; }; };
    return n;
}
