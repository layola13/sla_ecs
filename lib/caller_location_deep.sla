// Deepened Bevy-style explicit caller location registry.
// Mirrors MaybeLocation identity path without #[track_caller]:
//   none / some(file,line,column)
//   stable location id from triple
//   registry insert/dedup/find/at
// Fixed capacity: 8 locations. Shallow lib/caller_location.sla retained.

struct EcsClLocDeep {
    has: bool,
    file_id: i32,
    line: i32,
    column: i32,
    stable_id: i64,
}

fn ecs_cl_stable_id(file_id: i32, line: i32, column: i32) -> i64 {
    // pack: file*1_000_000 + line*1000 + column (bounded model)
    return (file_id as i64) * 1000000 + (line as i64) * 1000 + (column as i64);
}

fn ecs_cl_none() -> EcsClLocDeep {
    return EcsClLocDeep { has: false, file_id: 0, line: 0, column: 0, stable_id: 0 };
}

fn ecs_cl_new(file_id: i32, line: i32, column: i32) -> EcsClLocDeep {
    if file_id <= 0 { return ecs_cl_none(); };
    if line <= 0 { return ecs_cl_none(); };
    if column <= 0 { return ecs_cl_none(); };
    return EcsClLocDeep {
        has: true, file_id: file_id, line: line, column: column,
        stable_id: ecs_cl_stable_id(file_id, line, column),
    };
}

fn ecs_cl_has(l: EcsClLocDeep) -> bool { return l.has; }
fn ecs_cl_is_some(l: EcsClLocDeep) -> bool { return l.has; }
fn ecs_cl_file(l: EcsClLocDeep) -> i32 { return l.file_id; }
fn ecs_cl_line(l: EcsClLocDeep) -> i32 { return l.line; }
fn ecs_cl_column(l: EcsClLocDeep) -> i32 { return l.column; }
fn ecs_cl_id(l: EcsClLocDeep) -> i64 { return l.stable_id; }

fn ecs_cl_same(a: EcsClLocDeep, b: EcsClLocDeep) -> bool {
    if a.has != b.has { return false; };
    if a.has != true { return true; };
    if a.file_id != b.file_id { return false; };
    if a.line != b.line { return false; };
    if a.column != b.column { return false; };
    return true;
}

fn ecs_cl_eq_id(a: EcsClLocDeep, b: EcsClLocDeep) -> bool {
    if a.has != true { return false; };
    if b.has != true { return false; };
    return a.stable_id == b.stable_id;
}

// Registry fixed 8
struct EcsClRegDeep {
    l0: EcsClLocDeep, l1: EcsClLocDeep, l2: EcsClLocDeep, l3: EcsClLocDeep,
    l4: EcsClLocDeep, l5: EcsClLocDeep, l6: EcsClLocDeep, l7: EcsClLocDeep,
    len: i32,
}

fn ecs_cl_reg_new() -> EcsClRegDeep {
    return EcsClRegDeep {
        l0: ecs_cl_none(), l1: ecs_cl_none(), l2: ecs_cl_none(), l3: ecs_cl_none(),
        l4: ecs_cl_none(), l5: ecs_cl_none(), l6: ecs_cl_none(), l7: ecs_cl_none(),
        len: 0,
    };
}

fn ecs_cl_reg_len(r: EcsClRegDeep) -> i32 { return r.len; }

fn ecs_cl_reg_rebuild(
    l0: EcsClLocDeep, l1: EcsClLocDeep, l2: EcsClLocDeep, l3: EcsClLocDeep,
    l4: EcsClLocDeep, l5: EcsClLocDeep, l6: EcsClLocDeep, l7: EcsClLocDeep, len: i32
) -> EcsClRegDeep {
    return EcsClRegDeep {
        l0: l0, l1: l1, l2: l2, l3: l3, l4: l4, l5: l5, l6: l6, l7: l7, len: len,
    };
}

fn ecs_cl_reg_at(r: EcsClRegDeep, idx: i32) -> EcsClLocDeep {
    if idx == 0 {
        if r.len >= 1 { return r.l0; };
    };
    if idx == 1 {
        if r.len >= 2 { return r.l1; };
    };
    if idx == 2 {
        if r.len >= 3 { return r.l2; };
    };
    if idx == 3 {
        if r.len >= 4 { return r.l3; };
    };
    if idx == 4 {
        if r.len >= 5 { return r.l4; };
    };
    if idx == 5 {
        if r.len >= 6 { return r.l5; };
    };
    if idx == 6 {
        if r.len >= 7 { return r.l6; };
    };
    if idx == 7 {
        if r.len >= 8 { return r.l7; };
    };
    return ecs_cl_none();
}

fn ecs_cl_reg_find(r: EcsClRegDeep, loc: EcsClLocDeep) -> i32 {
    if loc.has != true { return -1; };
    if r.len >= 1 {
        if ecs_cl_same(r.l0, loc) { return 0; };
    };
    if r.len >= 2 {
        if ecs_cl_same(r.l1, loc) { return 1; };
    };
    if r.len >= 3 {
        if ecs_cl_same(r.l2, loc) { return 2; };
    };
    if r.len >= 4 {
        if ecs_cl_same(r.l3, loc) { return 3; };
    };
    if r.len >= 5 {
        if ecs_cl_same(r.l4, loc) { return 4; };
    };
    if r.len >= 6 {
        if ecs_cl_same(r.l5, loc) { return 5; };
    };
    if r.len >= 7 {
        if ecs_cl_same(r.l6, loc) { return 6; };
    };
    if r.len >= 8 {
        if ecs_cl_same(r.l7, loc) { return 7; };
    };
    return -1;
}

struct EcsClRegResultDeep {
    registry: EcsClRegDeep,
    inserted: bool,
    duplicate: bool,
    ignored_none: bool,
    existing_index: i32,
    location_id: i64,
}

fn ecs_cl_res_registry(r: EcsClRegResultDeep) -> EcsClRegDeep { return r.registry; }
fn ecs_cl_res_inserted(r: EcsClRegResultDeep) -> bool { return r.inserted; }
fn ecs_cl_res_duplicate(r: EcsClRegResultDeep) -> bool { return r.duplicate; }
fn ecs_cl_res_ignored_none(r: EcsClRegResultDeep) -> bool { return r.ignored_none; }
fn ecs_cl_res_existing_index(r: EcsClRegResultDeep) -> i32 { return r.existing_index; }
fn ecs_cl_res_location_id(r: EcsClRegResultDeep) -> i64 { return r.location_id; }

fn ecs_cl_reg_register(r: EcsClRegDeep, loc: EcsClLocDeep) -> EcsClRegResultDeep {
    if loc.has != true {
        return EcsClRegResultDeep {
            registry: r, inserted: false, duplicate: false, ignored_none: true,
            existing_index: -1, location_id: 0,
        };
    };
    let existing = ecs_cl_reg_find(r, loc);
    if existing >= 0 {
        return EcsClRegResultDeep {
            registry: r, inserted: false, duplicate: true, ignored_none: false,
            existing_index: existing, location_id: loc.stable_id,
        };
    };
    if r.len == 0 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(loc, r.l1, r.l2, r.l3, r.l4, r.l5, r.l6, r.l7, 1),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 1 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, loc, r.l2, r.l3, r.l4, r.l5, r.l6, r.l7, 2),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 2 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, r.l1, loc, r.l3, r.l4, r.l5, r.l6, r.l7, 3),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 3 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, r.l1, r.l2, loc, r.l4, r.l5, r.l6, r.l7, 4),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 4 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, r.l1, r.l2, r.l3, loc, r.l5, r.l6, r.l7, 5),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 5 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, r.l1, r.l2, r.l3, r.l4, loc, r.l6, r.l7, 6),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 6 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, r.l1, r.l2, r.l3, r.l4, r.l5, loc, r.l7, 7),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    if r.len == 7 {
        return EcsClRegResultDeep {
            registry: ecs_cl_reg_rebuild(r.l0, r.l1, r.l2, r.l3, r.l4, r.l5, r.l6, loc, 8),
            inserted: true, duplicate: false, ignored_none: false, existing_index: -1, location_id: loc.stable_id,
        };
    };
    // full: treat as duplicate of last? report not inserted, not ignored
    return EcsClRegResultDeep {
        registry: r, inserted: false, duplicate: false, ignored_none: false,
        existing_index: -1, location_id: loc.stable_id,
    };
}
