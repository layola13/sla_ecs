// Deepened Bevy ECS component clone surface.
// Mirrors src/component/clone.rs + entity clone helpers used by ComponentCloneCtx:
//   ComponentCloneBehavior Default/Ignore/Custom/Reflect resolve
//   SourceComponent read
//   EntityMapper get_or_insert
//   ComponentCloneCtx write_target / queue / handlers
// Shallow lib/component_clone.sla retained.
// Fixed capacity: mapper 4 pairs, queue 4 entities.

// Behavior kinds
fn ecs_cc_beh_default() -> i32 { return 0; }
fn ecs_cc_beh_ignore() -> i32 { return 1; }
fn ecs_cc_beh_custom() -> i32 { return 2; }
fn ecs_cc_beh_reflect() -> i32 { return 3; }
fn ecs_cc_beh_clone() -> i32 { return 4; }

// Resolved handler ids
fn ecs_cc_fn_ignore() -> i32 { return 0; }
fn ecs_cc_fn_clone() -> i32 { return 1; }
fn ecs_cc_fn_reflect() -> i32 { return 2; }
fn ecs_cc_fn_custom_base() -> i32 { return 100; }

struct EcsCcBehavior {
    kind: i32,
    custom_fn: i32,
}

fn ecs_cc_behavior_default() -> EcsCcBehavior {
    return EcsCcBehavior { kind: ecs_cc_beh_default(), custom_fn: 0 };
}
fn ecs_cc_behavior_ignore() -> EcsCcBehavior {
    return EcsCcBehavior { kind: ecs_cc_beh_ignore(), custom_fn: 0 };
}
fn ecs_cc_behavior_reflect() -> EcsCcBehavior {
    return EcsCcBehavior { kind: ecs_cc_beh_reflect(), custom_fn: 0 };
}
fn ecs_cc_behavior_clone() -> EcsCcBehavior {
    return EcsCcBehavior { kind: ecs_cc_beh_clone(), custom_fn: 0 };
}
fn ecs_cc_behavior_custom(fn_id: i32) -> EcsCcBehavior {
    return EcsCcBehavior { kind: ecs_cc_beh_custom(), custom_fn: fn_id };
}

fn ecs_cc_behavior_kind(b: EcsCcBehavior) -> i32 { return b.kind; }
fn ecs_cc_behavior_custom_fn(b: EcsCcBehavior) -> i32 { return b.custom_fn; }

// resolve(behavior, default_fn) -> resolved handler id
fn ecs_cc_behavior_resolve(b: EcsCcBehavior, default_fn: i32) -> i32 {
    if b.kind == ecs_cc_beh_default() {
        return default_fn;
    };
    if b.kind == ecs_cc_beh_ignore() {
        return ecs_cc_fn_ignore();
    };
    if b.kind == ecs_cc_beh_reflect() {
        return ecs_cc_fn_reflect();
    };
    if b.kind == ecs_cc_beh_clone() {
        return ecs_cc_fn_clone();
    };
    if b.kind == ecs_cc_beh_custom() {
        return ecs_cc_fn_custom_base() + b.custom_fn;
    };
    return default_fn;
}

struct EcsCcSource {
    component_id: i32,
    value: i64,
    present: bool,
}

fn ecs_cc_source_new(component_id: i32, value: i64) -> EcsCcSource {
    return EcsCcSource { component_id: component_id, value: value, present: true };
}
fn ecs_cc_source_empty(component_id: i32) -> EcsCcSource {
    return EcsCcSource { component_id: component_id, value: 0, present: false };
}
fn ecs_cc_source_id(s: EcsCcSource) -> i32 { return s.component_id; }
fn ecs_cc_source_read(s: EcsCcSource) -> (bool, i64) {
    if s.present != true { return (false, 0); };
    return (true, s.value);
}
fn ecs_cc_source_ptr(s: EcsCcSource) -> i64 { return s.value; }

// EntityMapper capacity 4
struct EcsCcMapper {
    len: i32,
    s0: i64, t0: i64,
    s1: i64, t1: i64,
    s2: i64, t2: i64,
    s3: i64, t3: i64,
}

fn ecs_cc_mapper_new() -> EcsCcMapper {
    return EcsCcMapper {
        len: 0,
        s0: 0, t0: 0, s1: 0, t1: 0, s2: 0, t2: 0, s3: 0, t3: 0,
    };
}

fn ecs_cc_mapper_len(m: EcsCcMapper) -> i32 { return m.len; }

fn ecs_cc_mapper_get(m: EcsCcMapper, source: i64) -> (bool, i64) {
    if m.len >= 1 { if m.s0 == source { return (true, m.t0); }; };
    if m.len >= 2 { if m.s1 == source { return (true, m.t1); }; };
    if m.len >= 3 { if m.s2 == source { return (true, m.t2); }; };
    if m.len >= 4 { if m.s3 == source { return (true, m.t3); }; };
    return (false, 0);
}

fn ecs_cc_mapper_get_or_insert(m: EcsCcMapper, source: i64, target: i64) -> (EcsCcMapper, i64) {
    let g = ecs_cc_mapper_get(m, source);
    if g.0 == true {
        return (m, g.1);
    };
    if m.len >= 4 {
        return (m, target);
    };
    let n = m.len;
    if n == 0 {
        return (EcsCcMapper {
            len: 1, s0: source, t0: target, s1: m.s1, t1: m.t1, s2: m.s2, t2: m.t2, s3: m.s3, t3: m.t3,
        }, target);
    };
    if n == 1 {
        return (EcsCcMapper {
            len: 2, s0: m.s0, t0: m.t0, s1: source, t1: target, s2: m.s2, t2: m.t2, s3: m.s3, t3: m.t3,
        }, target);
    };
    if n == 2 {
        return (EcsCcMapper {
            len: 3, s0: m.s0, t0: m.t0, s1: m.s1, t1: m.t1, s2: source, t2: target, s3: m.s3, t3: m.t3,
        }, target);
    };
    return (EcsCcMapper {
        len: 4, s0: m.s0, t0: m.t0, s1: m.s1, t1: m.t1, s2: m.s2, t2: m.t2, s3: source, t3: target,
    }, target);
}

// Clone context
struct EcsCcCtx {
    source_entity: i64,
    target_entity: i64,
    component_id: i32,
    source_value: i64,
    target_value: i64,
    target_written: bool,
    moving: bool,
    linked_cloning: bool,
    mapper: EcsCcMapper,
    // queued entities for linked clone
    q_len: i32,
    q0: i64, q1: i64, q2: i64, q3: i64,
    handler_used: i32,
}

fn ecs_cc_ctx_new(source: i64, target: i64, component_id: i32, source_value: i64) -> EcsCcCtx {
    return EcsCcCtx {
        source_entity: source, target_entity: target, component_id: component_id,
        source_value: source_value, target_value: 0, target_written: false,
        moving: false, linked_cloning: false, mapper: ecs_cc_mapper_new(),
        q_len: 0, q0: 0, q1: 0, q2: 0, q3: 0, handler_used: -1,
    };
}

fn ecs_cc_ctx_source(c: EcsCcCtx) -> i64 { return c.source_entity; }
fn ecs_cc_ctx_target(c: EcsCcCtx) -> i64 { return c.target_entity; }
fn ecs_cc_ctx_component_id(c: EcsCcCtx) -> i32 { return c.component_id; }
fn ecs_cc_ctx_written(c: EcsCcCtx) -> bool { return c.target_written; }
fn ecs_cc_ctx_target_value(c: EcsCcCtx) -> i64 { return c.target_value; }
fn ecs_cc_ctx_moving(c: EcsCcCtx) -> bool { return c.moving; }
fn ecs_cc_ctx_linked(c: EcsCcCtx) -> bool { return c.linked_cloning; }
fn ecs_cc_ctx_handler(c: EcsCcCtx) -> i32 { return c.handler_used; }
fn ecs_cc_ctx_queue_len(c: EcsCcCtx) -> i32 { return c.q_len; }
fn ecs_cc_ctx_mapper_len(c: EcsCcCtx) -> i32 { return ecs_cc_mapper_len(c.mapper); }

fn ecs_cc_ctx_set_moving(c: EcsCcCtx, moving: bool) -> EcsCcCtx {
    return EcsCcCtx {
        source_entity: c.source_entity, target_entity: c.target_entity, component_id: c.component_id,
        source_value: c.source_value, target_value: c.target_value, target_written: c.target_written,
        moving: moving, linked_cloning: c.linked_cloning, mapper: c.mapper,
        q_len: c.q_len, q0: c.q0, q1: c.q1, q2: c.q2, q3: c.q3, handler_used: c.handler_used,
    };
}

fn ecs_cc_ctx_set_linked(c: EcsCcCtx, linked: bool) -> EcsCcCtx {
    return EcsCcCtx {
        source_entity: c.source_entity, target_entity: c.target_entity, component_id: c.component_id,
        source_value: c.source_value, target_value: c.target_value, target_written: c.target_written,
        moving: c.moving, linked_cloning: linked, mapper: c.mapper,
        q_len: c.q_len, q0: c.q0, q1: c.q1, q2: c.q2, q3: c.q3, handler_used: c.handler_used,
    };
}

fn ecs_cc_ctx_write_target(c: EcsCcCtx, value: i64) -> EcsCcCtx {
    return EcsCcCtx {
        source_entity: c.source_entity, target_entity: c.target_entity, component_id: c.component_id,
        source_value: c.source_value, target_value: value, target_written: true,
        moving: c.moving, linked_cloning: c.linked_cloning, mapper: c.mapper,
        q_len: c.q_len, q0: c.q0, q1: c.q1, q2: c.q2, q3: c.q3, handler_used: c.handler_used,
    };
}

fn ecs_cc_ctx_set_handler(c: EcsCcCtx, handler: i32) -> EcsCcCtx {
    return EcsCcCtx {
        source_entity: c.source_entity, target_entity: c.target_entity, component_id: c.component_id,
        source_value: c.source_value, target_value: c.target_value, target_written: c.target_written,
        moving: c.moving, linked_cloning: c.linked_cloning, mapper: c.mapper,
        q_len: c.q_len, q0: c.q0, q1: c.q1, q2: c.q2, q3: c.q3, handler_used: handler,
    };
}

fn ecs_cc_ctx_queue_entity(c: EcsCcCtx, entity: i64) -> EcsCcCtx {
    if c.q_len >= 4 { return c; };
    let n = c.q_len;
    let q0 = c.q0; let q1 = c.q1; let q2 = c.q2; let q3 = c.q3;
    if n == 0 { q0 = entity; };
    if n == 1 { q1 = entity; };
    if n == 2 { q2 = entity; };
    if n == 3 { q3 = entity; };
    return EcsCcCtx {
        source_entity: c.source_entity, target_entity: c.target_entity, component_id: c.component_id,
        source_value: c.source_value, target_value: c.target_value, target_written: c.target_written,
        moving: c.moving, linked_cloning: c.linked_cloning, mapper: c.mapper,
        q_len: n + 1, q0: q0, q1: q1, q2: q2, q3: q3, handler_used: c.handler_used,
    };
}

fn ecs_cc_ctx_queue_at(c: EcsCcCtx, idx: i32) -> i64 {
    if idx == 0 { return c.q0; };
    if idx == 1 { return c.q1; };
    if idx == 2 { return c.q2; };
    if idx == 3 { return c.q3; };
    return 0;
}

fn ecs_cc_ctx_map_entity(c: EcsCcCtx, source: i64, target: i64) -> (EcsCcCtx, i64) {
    let r = ecs_cc_mapper_get_or_insert(c.mapper, source, target);
    let c2 = EcsCcCtx {
        source_entity: c.source_entity, target_entity: c.target_entity, component_id: c.component_id,
        source_value: c.source_value, target_value: c.target_value, target_written: c.target_written,
        moving: c.moving, linked_cloning: c.linked_cloning, mapper: r.0,
        q_len: c.q_len, q0: c.q0, q1: c.q1, q2: c.q2, q3: c.q3, handler_used: c.handler_used,
    };
    return (c2, r.1);
}

// Handlers
fn ecs_cc_via_clone(source: EcsCcSource, ctx: EcsCcCtx) -> EcsCcCtx {
    let r = ecs_cc_source_read(source);
    if r.0 != true {
        return ecs_cc_ctx_set_handler(ctx, ecs_cc_fn_clone());
    };
    let c2 = ecs_cc_ctx_write_target(ctx, r.1);
    return ecs_cc_ctx_set_handler(c2, ecs_cc_fn_clone());
}

fn ecs_cc_via_reflect(source: EcsCcSource, ctx: EcsCcCtx) -> EcsCcCtx {
    // reflect path modeled as clone of source value with distinct handler id
    let r = ecs_cc_source_read(source);
    if r.0 != true {
        return ecs_cc_ctx_set_handler(ctx, ecs_cc_fn_reflect());
    };
    let c2 = ecs_cc_ctx_write_target(ctx, r.1);
    return ecs_cc_ctx_set_handler(c2, ecs_cc_fn_reflect());
}

fn ecs_cc_via_ignore(source: EcsCcSource, ctx: EcsCcCtx) -> EcsCcCtx {
    let _ = source;
    return ecs_cc_ctx_set_handler(ctx, ecs_cc_fn_ignore());
}

// Dispatch by resolved handler
fn ecs_cc_dispatch(source: EcsCcSource, ctx: EcsCcCtx, behavior: EcsCcBehavior, default_fn: i32) -> EcsCcCtx {
    let h = ecs_cc_behavior_resolve(behavior, default_fn);
    if h == ecs_cc_fn_ignore() {
        return ecs_cc_via_ignore(source, ctx);
    };
    if h == ecs_cc_fn_reflect() {
        return ecs_cc_via_reflect(source, ctx);
    };
    // clone and custom both write source value for this model
    let c2 = ecs_cc_via_clone(source, ctx);
    return ecs_cc_ctx_set_handler(c2, h);
}
