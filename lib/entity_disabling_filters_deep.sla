// Deepened Bevy ECS entity_disabling filters.
// Mirrors src/entity_disabling.rs:
//   Disabled marker
//   DefaultQueryFilters register/is_disabled/filter_entity
// Fixed capacity: 4 disabling component ids, 4 entity disabled bits.
// Shallow lib/entity_disabling_filters.sla retained.

struct EcsEdfDisabledDeep {
    component_id: i32,
}

fn ecs_edf_disabled_new(component_id: i32) -> EcsEdfDisabledDeep {
    return EcsEdfDisabledDeep { component_id: component_id };
}

fn ecs_edf_disabled_id(d: EcsEdfDisabledDeep) -> i32 { return d.component_id; }

struct EcsEdfDeep {
    d0: i32, d1: i32, d2: i32, d3: i32,
    dlen: i32,
}

fn ecs_edf_deep_empty() -> EcsEdfDeep {
    return EcsEdfDeep { d0: -1, d1: -1, d2: -1, d3: -1, dlen: 0 };
}

fn ecs_edf_deep_len(f: EcsEdfDeep) -> i32 { return f.dlen; }
fn ecs_edf_deep_is_empty(f: EcsEdfDeep) -> bool { return f.dlen == 0; }

fn ecs_edf_deep_rebuild(d0: i32, d1: i32, d2: i32, d3: i32, dlen: i32) -> EcsEdfDeep {
    return EcsEdfDeep { d0: d0, d1: d1, d2: d2, d3: d3, dlen: dlen };
}

fn ecs_edf_deep_register(f: EcsEdfDeep, component_id: i32) -> EcsEdfDeep {
    if f.dlen >= 1 { if f.d0 == component_id { return f; }; };
    if f.dlen >= 2 { if f.d1 == component_id { return f; }; };
    if f.dlen >= 3 { if f.d2 == component_id { return f; }; };
    if f.dlen >= 4 { if f.d3 == component_id { return f; }; };
    if f.dlen == 0 { return ecs_edf_deep_rebuild(component_id, f.d1, f.d2, f.d3, 1); };
    if f.dlen == 1 { return ecs_edf_deep_rebuild(f.d0, component_id, f.d2, f.d3, 2); };
    if f.dlen == 2 { return ecs_edf_deep_rebuild(f.d0, f.d1, component_id, f.d3, 3); };
    if f.dlen == 3 { return ecs_edf_deep_rebuild(f.d0, f.d1, f.d2, component_id, 4); };
    return f;
}

fn ecs_edf_deep_is_disabling(f: EcsEdfDeep, component_id: i32) -> bool {
    if f.dlen >= 1 { if f.d0 == component_id { return true; }; };
    if f.dlen >= 2 { if f.d1 == component_id { return true; }; };
    if f.dlen >= 3 { if f.d2 == component_id { return true; }; };
    if f.dlen >= 4 { if f.d3 == component_id { return true; }; };
    return false;
}

fn ecs_edf_deep_at(f: EcsEdfDeep, idx: i32) -> i32 {
    if idx == 0 { return f.d0; };
    if idx == 1 { return f.d1; };
    if idx == 2 { return f.d2; };
    if idx == 3 { return f.d3; };
    return -1;
}

// entity component set: up to 4 cids
fn ecs_edf_deep_entity_disabled(f: EcsEdfDeep, c0: i32, c1: i32, c2: i32, c3: i32, clen: i32) -> bool {
    if clen >= 1 { if ecs_edf_deep_is_disabling(f, c0) { return true; }; };
    if clen >= 2 { if ecs_edf_deep_is_disabling(f, c1) { return true; }; };
    if clen >= 3 { if ecs_edf_deep_is_disabling(f, c2) { return true; }; };
    if clen >= 4 { if ecs_edf_deep_is_disabling(f, c3) { return true; }; };
    return false;
}

// filter passes if entity is NOT disabled
fn ecs_edf_deep_passes(f: EcsEdfDeep, c0: i32, c1: i32, c2: i32, c3: i32, clen: i32) -> bool {
    if ecs_edf_deep_entity_disabled(f, c0, c1, c2, c3, clen) { return false; };
    return true;
}

fn ecs_edf_deep_clear(f: EcsEdfDeep) -> EcsEdfDeep {
    return ecs_edf_deep_empty();
}

// count how many of a batch of entities pass (entity encoded as has_disabled_marker bool)
fn ecs_edf_deep_count_passing(f: EcsEdfDeep, e0_dis: bool, e1_dis: bool, e2_dis: bool, e3_dis: bool, n: i32) -> i32 {
    // if filters empty, all pass
    if f.dlen == 0 { return n; };
    let c = 0;
    if n >= 1 { if e0_dis != true { c = c + 1; }; };
    if n >= 2 { if e1_dis != true { c = c + 1; }; };
    if n >= 3 { if e2_dis != true { c = c + 1; }; };
    if n >= 4 { if e3_dis != true { c = c + 1; }; };
    return c;
}
