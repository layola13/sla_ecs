// Bevy ECS EntityIndexMap derived/mutable-slice/wrapper extras.
// Complements the index_map extras batches with constructor/default/clone/debug,
// explicit Extend variants, array-style construction, PartialEq<IndexMap>, mutable
// Slice markers, and iterator size-hint/debug/trusted-unique behavior.

struct EcsEim4Pair { key: i64, value: i32 }
struct EcsEim4Map { entries: Vec<EcsEim4Pair>, capacity_hint: i64, constructed_kind: i32 }
struct EcsEim4Slice { entries: Vec<EcsEim4Pair>, mutable_view: i32, boxed: i32, inner_view: i32 }
struct EcsEim4Iter { entries: Vec<EcsEim4Pair>, front: i64, back: i64, debug_kind: i32, trusted_unique: i32, mutable_view: i32 }
struct EcsEim4SizeHint { lower: i64, upper: i64 }
struct EcsEim4InsertResult { replaced: i32, map: EcsEim4Map }
struct EcsEim4PairResult { has: i32, key: i64, value: i32 }
struct EcsEim4SliceResult { has: i32, slice: EcsEim4Slice }
struct EcsEim4SplitResult { left: EcsEim4Slice, right: EcsEim4Slice }
struct EcsEim4NextResult { iter: EcsEim4Iter, has: i32, key: i64, value: i32 }
struct EcsEim4KeyResult { iter: EcsEim4Iter, has: i32, key: i64 }
struct EcsEim4ValueResult { iter: EcsEim4Iter, has: i32, value: i32 }
struct EcsEim4DrainResult { map: EcsEim4Map, drain: EcsEim4Iter }

fn ecs_eim4_pair(key: i64, value: i32) -> EcsEim4Pair {
    return EcsEim4Pair { key: key, value: value };
}

fn ecs_eim4_new() -> EcsEim4Map {
    return EcsEim4Map { entries: Vec::new(), capacity_hint: 0, constructed_kind: 1 };
}

fn ecs_eim4_default() -> EcsEim4Map {
    return EcsEim4Map { entries: Vec::new(), capacity_hint: 0, constructed_kind: 2 };
}

fn ecs_eim4_with_capacity(capacity: i64) -> EcsEim4Map {
    let hint = capacity;
    if hint < 0 { hint = 0; };
    return EcsEim4Map { entries: Vec::new(), capacity_hint: hint, constructed_kind: 3 };
}

fn ecs_eim4_clone(map: EcsEim4Map) -> EcsEim4Map {
    let capacity_hint = map.capacity_hint;
    return EcsEim4Map { entries: map.entries, capacity_hint: capacity_hint, constructed_kind: 4 };
}

fn ecs_eim4_debug_kind(map: EcsEim4Map) -> i32 { return map.constructed_kind; }
fn ecs_eim4_len(map: EcsEim4Map) -> i64 { return len(map.entries) as i64; }
fn ecs_eim4_slice_len(slice: EcsEim4Slice) -> i64 { return len(slice.entries) as i64; }

fn ecs_eim4_get(map: EcsEim4Map, key: i64) -> EcsEim4PairResult {
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        if map.entries[index].key == key {
            return EcsEim4PairResult { has: 1, key: key, value: map.entries[index].value };
        };
        index = index + 1;
    }
    return EcsEim4PairResult { has: 0, key: key, value: 0 };
}

fn ecs_eim4_insert(map: EcsEim4Map, key: i64, value: i32) -> EcsEim4InsertResult {
    let found_index: i64 = -1;
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        if map.entries[index].key == key { found_index = index + 0; };
        index = index + 1;
    }
    if found_index >= 0 {
        map.entries[found_index].value = value;
        return EcsEim4InsertResult { replaced: 1, map: map };
    };
    map.entries.push(EcsEim4Pair { key: key, value: value });
    return EcsEim4InsertResult { replaced: 0, map: map };
}

fn ecs_eim4_extend_owned(map: EcsEim4Map, entries: Vec<EcsEim4Pair>) -> EcsEim4Map {
    let index: i64 = 0;
    while index < (len(entries) as i64) {
        let inserted = ecs_eim4_insert(map, entries[index].key, entries[index].value);
        map = inserted.map;
        index = index + 1;
    }
    return map;
}

fn ecs_eim4_extend_refs(map: EcsEim4Map, entries: Vec<EcsEim4Pair>) -> EcsEim4Map {
    return ecs_eim4_extend_owned(map, entries);
}

fn ecs_eim4_from_iter(entries: Vec<EcsEim4Pair>) -> EcsEim4Map {
    return ecs_eim4_extend_owned(ecs_eim4_new(), entries);
}

fn ecs_eim4_from_array4(k1: i64, v1: i32, k2: i64, v2: i32, k3: i64, v3: i32, k4: i64, v4: i32) -> EcsEim4Map {
    let entries: Vec<EcsEim4Pair> = Vec::new();
    entries.push(ecs_eim4_pair(k1, v1));
    entries.push(ecs_eim4_pair(k2, v2));
    entries.push(ecs_eim4_pair(k3, v3));
    entries.push(ecs_eim4_pair(k4, v4));
    let map = ecs_eim4_extend_owned(ecs_eim4_new(), entries);
    return EcsEim4Map { entries: map.entries, capacity_hint: 4, constructed_kind: 5 };
}

fn ecs_eim4_eq_inner(map: EcsEim4Map, entries: Vec<EcsEim4Pair>) -> bool {
    let inner = ecs_eim4_from_iter(entries);
    if len(map.entries) != len(inner.entries) { return false; };
    let equal = true;
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        let found = false;
        let inner_index: i64 = 0;
        while inner_index < (len(inner.entries) as i64) {
            if inner.entries[inner_index].key == map.entries[index].key {
                if inner.entries[inner_index].value == map.entries[index].value { found = true; };
            };
            inner_index = inner_index + 1;
        }
        if found != true { equal = false; };
        index = index + 1;
    }
    return equal;
}

fn ecs_eim4_as_slice(map: EcsEim4Map) -> EcsEim4Slice {
    return EcsEim4Slice { entries: map.entries, mutable_view: 0, boxed: 0, inner_view: 0 };
}

fn ecs_eim4_as_mut_slice(map: EcsEim4Map) -> EcsEim4Slice {
    return EcsEim4Slice { entries: map.entries, mutable_view: 1, boxed: 0, inner_view: 0 };
}

fn ecs_eim4_empty_mut_slice() -> EcsEim4Slice {
    return EcsEim4Slice { entries: Vec::new(), mutable_view: 1, boxed: 0, inner_view: 0 };
}

fn ecs_eim4_slice_as_inner(slice: EcsEim4Slice) -> EcsEim4Slice {
    return EcsEim4Slice { entries: slice.entries, mutable_view: slice.mutable_view, boxed: slice.boxed, inner_view: 1 };
}

fn ecs_eim4_slice_range_mut(slice: EcsEim4Slice, start: i64, end: i64) -> EcsEim4SliceResult {
    if start < 0 { return EcsEim4SliceResult { has: 0, slice: ecs_eim4_empty_mut_slice() }; };
    if end < start { return EcsEim4SliceResult { has: 0, slice: ecs_eim4_empty_mut_slice() }; };
    if end > (len(slice.entries) as i64) { return EcsEim4SliceResult { has: 0, slice: ecs_eim4_empty_mut_slice() }; };
    let out: Vec<EcsEim4Pair> = Vec::new();
    let index = start + 0;
    while index < end {
        out.push(slice.entries[index]);
        index = index + 1;
    }
    return EcsEim4SliceResult { has: 1, slice: EcsEim4Slice { entries: out, mutable_view: 1, boxed: slice.boxed, inner_view: slice.inner_view } };
}

fn ecs_eim4_slice_set_first(slice: EcsEim4Slice, value: i32) -> EcsEim4Slice {
    if len(slice.entries) > 0 { slice.entries[0].value = value; };
    return slice;
}

fn ecs_eim4_slice_set_last(slice: EcsEim4Slice, value: i32) -> EcsEim4Slice {
    let count = len(slice.entries) as i64;
    if count > 0 { slice.entries[count - 1].value = value; };
    return slice;
}

fn ecs_eim4_slice_split_at_mut(slice: EcsEim4Slice, cut: i64) -> EcsEim4SplitResult {
    let left: Vec<EcsEim4Pair> = Vec::new();
    let right: Vec<EcsEim4Pair> = Vec::new();
    let index: i64 = 0;
    while index < (len(slice.entries) as i64) {
        if index < cut { left.push(slice.entries[index]); };
        if index >= cut { right.push(slice.entries[index]); };
        index = index + 1;
    }
    return EcsEim4SplitResult { left: EcsEim4Slice { entries: left, mutable_view: 1, boxed: slice.boxed, inner_view: slice.inner_view }, right: EcsEim4Slice { entries: right, mutable_view: 1, boxed: slice.boxed, inner_view: slice.inner_view } };
}

fn ecs_eim4_iter_from_map(map: EcsEim4Map, debug_kind: i32, mutable_view: i32, trusted_unique: i32) -> EcsEim4Iter {
    return EcsEim4Iter { entries: map.entries, front: 0, back: len(map.entries) as i64, debug_kind: debug_kind, trusted_unique: trusted_unique, mutable_view: mutable_view };
}

fn ecs_eim4_iter(map: EcsEim4Map) -> EcsEim4Iter { return ecs_eim4_iter_from_map(map, 10, 0, 0); }
fn ecs_eim4_iter_mut(map: EcsEim4Map) -> EcsEim4Iter { return ecs_eim4_iter_from_map(map, 11, 1, 0); }
fn ecs_eim4_into_iter(map: EcsEim4Map) -> EcsEim4Iter { return ecs_eim4_iter_from_map(map, 20, 0, 0); }
fn ecs_eim4_keys(map: EcsEim4Map) -> EcsEim4Iter { return ecs_eim4_iter_from_map(map, 40, 0, 1); }
fn ecs_eim4_into_keys(map: EcsEim4Map) -> EcsEim4Iter { return ecs_eim4_iter_from_map(map, 50, 0, 1); }
fn ecs_eim4_into_values(map: EcsEim4Map) -> EcsEim4Iter { return ecs_eim4_iter_from_map(map, 60, 0, 0); }

fn ecs_eim4_drain_clamped(map: EcsEim4Map, start: i64, end: i64) -> EcsEim4DrainResult {
    let kept: Vec<EcsEim4Pair> = Vec::new();
    let drained: Vec<EcsEim4Pair> = Vec::new();
    let index: i64 = 0;
    while index < (len(map.entries) as i64) {
        if index < start { kept.push(map.entries[index]); };
        if index >= end { kept.push(map.entries[index]); };
        if index >= start { if index < end { drained.push(map.entries[index]); }; };
        index = index + 1;
    }
    let capacity_hint = map.capacity_hint;
    let kept_map = EcsEim4Map { entries: kept, capacity_hint: capacity_hint, constructed_kind: map.constructed_kind };
    let drain_iter = EcsEim4Iter { entries: drained, front: 0, back: len(drained) as i64, debug_kind: 30, trusted_unique: 0, mutable_view: 0 };
    return EcsEim4DrainResult { map: kept_map, drain: drain_iter };
}

fn ecs_eim4_drain(map: EcsEim4Map, start: i64, end: i64) -> EcsEim4DrainResult {
    let count = len(map.entries) as i64;
    if start <= 0 { if end >= count { return ecs_eim4_drain_clamped(map, 0, count); }; return ecs_eim4_drain_clamped(map, 0, end); };
    if start >= count { return ecs_eim4_drain_clamped(map, count, count); };
    if end <= start { return ecs_eim4_drain_clamped(map, start, start); };
    if end >= count { return ecs_eim4_drain_clamped(map, start, count); };
    return ecs_eim4_drain_clamped(map, start, end);
}

fn ecs_eim4_iter_remaining(iter: EcsEim4Iter) -> i64 {
    let remaining = iter.back - iter.front;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_eim4_size_hint(iter: EcsEim4Iter) -> EcsEim4SizeHint {
    let remaining = ecs_eim4_iter_remaining(iter);
    return EcsEim4SizeHint { lower: remaining, upper: remaining };
}

fn ecs_eim4_iter_debug_kind(iter: EcsEim4Iter) -> i32 { return iter.debug_kind; }

fn ecs_eim4_iter_into_slice(iter: EcsEim4Iter) -> EcsEim4Slice {
    let out: Vec<EcsEim4Pair> = Vec::new();
    let index = iter.front + 0;
    while index < iter.back {
        out.push(iter.entries[index]);
        index = index + 1;
    }
    return EcsEim4Slice { entries: out, mutable_view: iter.mutable_view, boxed: 0, inner_view: 1 };
}

fn ecs_eim4_iter_next(iter: EcsEim4Iter) -> EcsEim4NextResult {
    if iter.front >= iter.back { return EcsEim4NextResult { iter: iter, has: 0, key: -1, value: 0 }; };
    let pair = iter.entries[iter.front];
    iter.front = iter.front + 1;
    return EcsEim4NextResult { iter: iter, has: 1, key: pair.key, value: pair.value };
}

fn ecs_eim4_iter_next_back(iter: EcsEim4Iter) -> EcsEim4NextResult {
    if iter.front >= iter.back { return EcsEim4NextResult { iter: iter, has: 0, key: -1, value: 0 }; };
    iter.back = iter.back - 1;
    let pair = iter.entries[iter.back];
    return EcsEim4NextResult { iter: iter, has: 1, key: pair.key, value: pair.value };
}

fn ecs_eim4_key_next(iter: EcsEim4Iter) -> EcsEim4KeyResult {
    let next = ecs_eim4_iter_next(iter);
    return EcsEim4KeyResult { iter: next.iter, has: next.has, key: next.key };
}

fn ecs_eim4_value_next(iter: EcsEim4Iter) -> EcsEim4ValueResult {
    let next = ecs_eim4_iter_next(iter);
    return EcsEim4ValueResult { iter: next.iter, has: next.has, value: next.value };
}
