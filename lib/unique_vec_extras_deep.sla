// Deepened Bevy ECS UniqueVec extras core surface.
// Fixed capacity 8 + capacity_hint. Shallow lib/unique_vec_extras.sla retained.

struct EcsUveDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    capacity_hint: i32,
    leaked: i32,
}

fn ecs_uve_deep_new() -> EcsUveDeep {
    return EcsUveDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: 0, leaked: 0,
    };
}

fn ecs_uve_deep_with_capacity(capacity: i32) -> EcsUveDeep {
    let c = capacity;
    if c < 0 { c = 0; };
    return EcsUveDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: c, leaked: 0,
    };
}

fn ecs_uve_deep_len(v: EcsUveDeep) -> i32 { return v.len; }
fn ecs_uve_deep_capacity(v: EcsUveDeep) -> i32 { return v.capacity_hint; }
fn ecs_uve_deep_is_empty(v: EcsUveDeep) -> bool { return v.len == 0; }
fn ecs_uve_deep_leaked(v: EcsUveDeep) -> i32 { return v.leaked; }

fn ecs_uve_deep_spare(v: EcsUveDeep) -> i32 {
    if v.capacity_hint <= v.len { return 0; };
    return v.capacity_hint - v.len;
}

fn ecs_uve_deep_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, capacity_hint: i32, leaked: i32
) -> EcsUveDeep {
    return EcsUveDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
        len: len, capacity_hint: capacity_hint, leaked: leaked,
    };
}

fn ecs_uve_deep_contains(v: EcsUveDeep, entity: i64) -> bool {
    if v.len >= 1 { if v.e0 == entity { return true; }; };
    if v.len >= 2 { if v.e1 == entity { return true; }; };
    if v.len >= 3 { if v.e2 == entity { return true; }; };
    if v.len >= 4 { if v.e3 == entity { return true; }; };
    if v.len >= 5 { if v.e4 == entity { return true; }; };
    if v.len >= 6 { if v.e5 == entity { return true; }; };
    if v.len >= 7 { if v.e6 == entity { return true; }; };
    if v.len >= 8 { if v.e7 == entity { return true; }; };
    return false;
}

fn ecs_uve_deep_at(v: EcsUveDeep, idx: i32) -> i64 {
    if idx == 0 { return v.e0; };
    if idx == 1 { return v.e1; };
    if idx == 2 { return v.e2; };
    if idx == 3 { return v.e3; };
    if idx == 4 { return v.e4; };
    if idx == 5 { return v.e5; };
    if idx == 6 { return v.e6; };
    if idx == 7 { return v.e7; };
    return -1;
}

fn ecs_uve_deep_push_unchecked(v: EcsUveDeep, entity: i64) -> EcsUveDeep {
    if v.len >= 8 { return v; };
    let cap = v.capacity_hint;
    if cap < v.len + 1 { cap = v.len + 1; };
    if v.len == 0 { return ecs_uve_deep_rebuild(entity, v.e1, v.e2, v.e3, v.e4, v.e5, v.e6, v.e7, 1, cap, v.leaked); };
    if v.len == 1 { return ecs_uve_deep_rebuild(v.e0, entity, v.e2, v.e3, v.e4, v.e5, v.e6, v.e7, 2, cap, v.leaked); };
    if v.len == 2 { return ecs_uve_deep_rebuild(v.e0, v.e1, entity, v.e3, v.e4, v.e5, v.e6, v.e7, 3, cap, v.leaked); };
    if v.len == 3 { return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, entity, v.e4, v.e5, v.e6, v.e7, 4, cap, v.leaked); };
    if v.len == 4 { return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, v.e3, entity, v.e5, v.e6, v.e7, 5, cap, v.leaked); };
    if v.len == 5 { return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, entity, v.e6, v.e7, 6, cap, v.leaked); };
    if v.len == 6 { return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, v.e5, entity, v.e7, 7, cap, v.leaked); };
    if v.len == 7 { return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, v.e5, v.e6, entity, 8, cap, v.leaked); };
    return v;
}

fn ecs_uve_deep_reserve(v: EcsUveDeep, additional: i32) -> EcsUveDeep {
    let need = v.len + additional;
    let cap = v.capacity_hint;
    if need > cap { cap = need; };
    return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, v.e5, v.e6, v.e7, v.len, cap, v.leaked);
}

struct EcsUveTryDeep {
    ok: bool,
    vec: EcsUveDeep,
}

fn ecs_uve_try_ok(r: EcsUveTryDeep) -> bool { return r.ok; }
fn ecs_uve_try_vec(r: EcsUveTryDeep) -> EcsUveDeep { return r.vec; }

fn ecs_uve_deep_try_reserve(v: EcsUveDeep, additional: i32) -> EcsUveTryDeep {
    if additional < 0 {
        return EcsUveTryDeep { ok: false, vec: v };
    };
    return EcsUveTryDeep { ok: true, vec: ecs_uve_deep_reserve(v, additional) };
}

// split_off at index
struct EcsUveSplitDeep {
    left: EcsUveDeep,
    right: EcsUveDeep,
}

fn ecs_uve_split_left(s: EcsUveSplitDeep) -> EcsUveDeep { return s.left; }
fn ecs_uve_split_right(s: EcsUveSplitDeep) -> EcsUveDeep { return s.right; }

fn ecs_uve_deep_split_off(v: EcsUveDeep, at: i32) -> EcsUveSplitDeep {
    if at <= 0 {
        return EcsUveSplitDeep { left: ecs_uve_deep_new(), right: v };
    };
    if at >= v.len {
        return EcsUveSplitDeep { left: v, right: ecs_uve_deep_new() };
    };
    let left = ecs_uve_deep_new();
    let right = ecs_uve_deep_new();
    // unrolled: push items < at to left, >= at to right
    if v.len >= 1 {
        if 0 < at { left = ecs_uve_deep_push_unchecked(left, v.e0); };
        if 0 >= at { right = ecs_uve_deep_push_unchecked(right, v.e0); };
    };
    if v.len >= 2 {
        if 1 < at { left = ecs_uve_deep_push_unchecked(left, v.e1); };
        if 1 >= at { right = ecs_uve_deep_push_unchecked(right, v.e1); };
    };
    if v.len >= 3 {
        if 2 < at { left = ecs_uve_deep_push_unchecked(left, v.e2); };
        if 2 >= at { right = ecs_uve_deep_push_unchecked(right, v.e2); };
    };
    if v.len >= 4 {
        if 3 < at { left = ecs_uve_deep_push_unchecked(left, v.e3); };
        if 3 >= at { right = ecs_uve_deep_push_unchecked(right, v.e3); };
    };
    return EcsUveSplitDeep { left: left, right: right };
}

fn ecs_uve_deep_clear(v: EcsUveDeep) -> EcsUveDeep {
    return ecs_uve_deep_rebuild(0, 0, 0, 0, 0, 0, 0, 0, 0, v.capacity_hint, v.leaked);
}

fn ecs_uve_deep_mark_leaked(v: EcsUveDeep) -> EcsUveDeep {
    return ecs_uve_deep_rebuild(v.e0, v.e1, v.e2, v.e3, v.e4, v.e5, v.e6, v.e7, v.len, v.capacity_hint, v.leaked + 1);
}
