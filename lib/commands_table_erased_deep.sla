fn ecs_tbl_erased_commands_count_by_kind(c: EcsTblErasedCommandsDeep, kind: i32) -> i32 {
    let i: i32 = 0;
    let out: i32 = 0;
    while i < c.count {
        if ecs_tbl_erased_commands_kind_at(c, i) == kind { out = out + 1; };
        i = i + 1;
    }
    return out;
}

// resolve_value: scalar payload for INSERT_COMPONENT (pv), INSERT_RESOURCE (pres),
// WRITE_MESSAGE (pmsg); otherwise 0 (DESPAWN and all batch kinds).
fn ecs_tbl_erased_commands_resolve_value(c: EcsTblErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_erased_commands_kind_at(c, idx);
    let vidx: i32 = ecs_tbl_erased_commands_idx_at(c, idx);
    if kind == ECS_CMD_TBL_ERASED_INSERT_COMPONENT {
        return ecs_tbl_erased_commands_pv_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_ERASED_INSERT_RESOURCE {
        return ecs_tbl_erased_commands_pres_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_ERASED_WRITE_MESSAGE {
        return ecs_tbl_erased_commands_pmsg_at(c, vidx);
    };
    return 0;
}

fn ecs_tbl_erased_commands_resolve_type(c: EcsTblErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_erased_commands_kind_at(c, idx);
    if kind == ECS_CMD_TBL_ERASED_INSERT_COMPONENT {
        let vidx: i32 = ecs_tbl_erased_commands_idx_at(c, idx);
        return ecs_tbl_erased_commands_pt_at(c, vidx);
    };
    return 0;
}

// batch slot lookup: For a batch command (kinds 5..10) recover the batch slot tag.
fn ecs_tbl_erased_commands_batch_slot(c: EcsTblErasedCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_erased_commands_kind_at(c, idx);
    let is_bundle2: i32 = 0;
    if kind == ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE2 { is_bundle2 = 1; };
    if kind == ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2 { is_bundle2 = 1; };
    if kind == ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2_IF_NEW { is_bundle2 = 1; };
    if is_bundle2 == 1 {
        return ecs_tbl_erased_commands_idx_at(c, idx);
    };
    return ecs_tbl_erased_commands_idx_at(c, idx);
}

fn ecs_tbl_erased_commands_clear(c: EcsTblErasedCommandsDeep) -> EcsTblErasedCommandsDeep {
    return ecs_tbl_erased_commands_new();
}
