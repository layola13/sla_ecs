    c = ecs_tbl_erased_commands_set_b3_slot(c, slot, ce0, ce1, ft0, st0, tt0, fv0, sv0, tv0, ft1, st1, tt1, fv1, sv1, tv1, count);
    c.b3_count = c.b3_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE3_IF_NEW, 0, 0, slot);
