fn ecs_tbl_erased_commands_pcomp_count(c: EcsTblErasedCommandsDeep) -> i32 { return c.pcomp_count; }
fn ecs_tbl_erased_commands_pres_count(c: EcsTblErasedCommandsDeep) -> i32 { return c.pres_count; }
fn ecs_tbl_erased_commands_pmsg_count(c: EcsTblErasedCommandsDeep) -> i32 { return c.pmsg_count; }
fn ecs_tbl_erased_commands_b2_count(c: EcsTblErasedCommandsDeep) -> i32 { return c.b2_count; }
fn ecs_tbl_erased_commands_b3_count(c: EcsTblErasedCommandsDeep) -> i32 { return c.b3_count; }

// populate bundle2 batch slot k with two bundles (cap-2 each). entities0/1, ft0/1, st0/1, fv0/1,
// sv0/1, count. We spread the five-bundle-field groups across the per-batch structured slots
// using scalar-by-scalar assignment by branch (no struct reuse).
fn ecs_tbl_erased_commands_set_b2_slot(
    c: EcsTblErasedCommandsDeep, k: i32,
    be0: i32, be1: i32,
    ft0: i32, st0: i32, fv0: i32, sv0: i32,
    ft1: i32, st1: i32, fv1: i32, sv1: i32,
    count: i32
) -> EcsTblErasedCommandsDeep {
    if k == 0 {
        c.be00 = be0; c.be01 = be1;
        c.bft00 = ft0; c.bst00 = st0; c.bfv00 = fv0; c.bsv00 = sv0;
        c.bft01 = ft1; c.bst01 = st1; c.bfv01 = fv1; c.bsv01 = sv1;
        c.b2c0 = count;
    };
    if k == 1 {
        c.be10 = be0; c.be11 = be1;
        c.bft10 = ft0; c.bst10 = st0; c.bfv10 = fv0; c.bsv10 = sv0;
        c.bft11 = ft1; c.bst11 = st1; c.bfv11 = fv1; c.bsv11 = sv1;
        c.b2c1 = count;
    };
    return c;
}

fn ecs_tbl_erased_commands_b2c_at(c: EcsTblErasedCommandsDeep, k: i32) -> i32 {
    if k == 0 { return c.b2c0; };
    if k == 1 { return c.b2c1; };
    return 0;
}

// read bundle2 fields from batch slot k bundle i
struct EcsTblErasedBundle2Deep { entity: i32, first_type: i32, second_type: i32, first_value: i32, second_value: i32 }

fn ecs_tbl_erased_commands_b2_at(c: EcsTblErasedCommandsDeep, k: i32, i: i32) -> EcsTblErasedBundle2Deep {
    if k == 0 {
        if i == 0 { return EcsTblErasedBundle2Deep { entity: c.be00, first_type: c.bft00, second_type: c.bst00, first_value: c.bfv00, second_value: c.bsv00 }; };
        if i == 1 { return EcsTblErasedBundle2Deep { entity: c.be01, first_type: c.bft01, second_type: c.bst01, first_value: c.bfv01, second_value: c.bsv01 }; };
    };
    if k == 1 {
        if i == 0 { return EcsTblErasedBundle2Deep { entity: c.be10, first_type: c.bft10, second_type: c.bst10, first_value: c.bfv10, second_value: c.bsv10 }; };
        if i == 1 { return EcsTblErasedBundle2Deep { entity: c.be11, first_type: c.bft11, second_type: c.bst11, first_value: c.bfv11, second_value: c.bsv11 }; };
    };
    return EcsTblErasedBundle2Deep { entity: 0, first_type: 0, second_type: 0, first_value: 0, second_value: 0 };
}

fn ecs_tbl_erased_b2_entity(b: EcsTblErasedBundle2Deep) -> i32 { return b.entity; }
fn ecs_tbl_erased_b2_first_type(b: EcsTblErasedBundle2Deep) -> i32 { return b.first_type; }
fn ecs_tbl_erased_b2_second_type(b: EcsTblErasedBundle2Deep) -> i32 { return b.second_type; }
fn ecs_tbl_erased_b2_first_value(b: EcsTblErasedBundle2Deep) -> i32 { return b.first_value; }
fn ecs_tbl_erased_b2_second_value(b: EcsTblErasedBundle2Deep) -> i32 { return b.second_value; }

// populate bundle3 batch slot k with two bundles each carrying 6 fields.
fn ecs_tbl_erased_commands_set_b3_slot(
    c: EcsTblErasedCommandsDeep, k: i32,
    ce0: i32, ce1: i32,
    ft0: i32, st0: i32, tt0: i32, fv0: i32, sv0: i32, tv0: i32,
    ft1: i32, st1: i32, tt1: i32, fv1: i32, sv1: i32, tv1: i32,
    count: i32
) -> EcsTblErasedCommandsDeep {
    if k == 0 {
        c.ce00 = ce0; c.ce01 = ce1;
        c.cft00 = ft0; c.cst00 = st0; c.ctt00 = tt0; c.cfv00 = fv0; c.csv00 = sv0; c.ctv00 = tv0;
        c.cft01 = ft1; c.cst01 = st1; c.ctt01 = tt1; c.cfv01 = fv1; c.csv01 = sv1; c.ctv01 = tv1;
        c.b3c0 = count;
    };
    if k == 1 {
        c.ce10 = ce0; c.ce11 = ce1;
        c.cft10 = ft0; c.cst10 = st0; c.ctt10 = tt0; c.cfv10 = fv0; c.csv10 = sv0; c.ctv10 = tv0;
        c.cft11 = ft1; c.cst11 = st1; c.ctt11 = tt1; c.cfv11 = fv1; c.csv11 = sv1; c.ctv11 = tv1;
        c.b3c1 = count;
    };
    return c;
}

struct EcsTblErasedBundle3Deep { entity: i32, first_type: i32, second_type: i32, third_type: i32, first_value: i32, second_value: i32, third_value: i32 }

fn ecs_tbl_erased_commands_b3_at(c: EcsTblErasedCommandsDeep, k: i32, i: i32) -> EcsTblErasedBundle3Deep {
    // Capture scalar fields by reading then building a result struct; reading multiple fields
    // is fine — only reassign across branches triggers moves (here we copy out per branch).
    if k == 0 {
        if i == 0 {
            let e: i32 = c.ce00; let ft: i32 = c.cft00; let st: i32 = c.cst00; let tt: i32 = c.ctt00; let fv: i32 = c.cfv00; let sv: i32 = c.csv00; let tv: i32 = c.ctv00;
            return EcsTblErasedBundle3Deep { entity: e, first_type: ft, second_type: st, third_type: tt, first_value: fv, second_value: sv, third_value: tv };
        };
        if i == 1 {
            let e: i32 = c.ce01; let ft: i32 = c.cft01; let st: i32 = c.cst01; let tt: i32 = c.ctt01; let fv: i32 = c.cfv01; let sv: i32 = c.csv01; let tv: i32 = c.ctv01;
            return EcsTblErasedBundle3Deep { entity: e, first_type: ft, second_type: st, third_type: tt, first_value: fv, second_value: sv, third_value: tv };
        };
    };
    if k == 1 {
        if i == 0 {
            let e: i32 = c.ce10; let ft: i32 = c.cft10; let st: i32 = c.cst10; let tt: i32 = c.ctt10; let fv: i32 = c.cfv10; let sv: i32 = c.csv10; let tv: i32 = c.ctv10;
            return EcsTblErasedBundle3Deep { entity: e, first_type: ft, second_type: st, third_type: tt, first_value: fv, second_value: sv, third_value: tv };
        };
        if i == 1 {
            let e: i32 = c.ce11; let ft: i32 = c.cft11; let st: i32 = c.cst11; let tt: i32 = c.ctt11; let fv: i32 = c.cfv11; let sv: i32 = c.csv11; let tv: i32 = c.ctv11;
            return EcsTblErasedBundle3Deep { entity: e, first_type: ft, second_type: st, third_type: tt, first_value: fv, second_value: sv, third_value: tv };
        };
    };
    return EcsTblErasedBundle3Deep { entity: 0, first_type: 0, second_type: 0, third_type: 0, first_value: 0, second_value: 0, third_value: 0 };
}

fn ecs_tbl_erased_commands_b3c_at(c: EcsTblErasedCommandsDeep, k: i32) -> i32 {
    if k == 0 { return c.b3c0; };
    if k == 1 { return c.b3c1; };
    return 0;
}

fn ecs_tbl_erased_b3_entity(b: EcsTblErasedBundle3Deep) -> i32 { return b.entity; }
fn ecs_tbl_erased_b3_first_type(b: EcsTblErasedBundle3Deep) -> i32 { return b.first_type; }
fn ecs_tbl_erased_b3_second_type(b: EcsTblErasedBundle3Deep) -> i32 { return b.second_type; }
fn ecs_tbl_erased_b3_third_type(b: EcsTblErasedBundle3Deep) -> i32 { return b.third_type; }
fn ecs_tbl_erased_b3_first_value(b: EcsTblErasedBundle3Deep) -> i32 { return b.first_value; }
fn ecs_tbl_erased_b3_second_value(b: EcsTblErasedBundle3Deep) -> i32 { return b.second_value; }
fn ecs_tbl_erased_b3_third_value(b: EcsTblErasedBundle3Deep) -> i32 { return b.third_value; }

fn ecs_tbl_erased_commands_reserve_entity(c: EcsTblErasedCommandsDeep) -> (EcsTblErasedCommandsDeep, i32) {
    return (c, 0);
}

fn ecs_tbl_erased_commands_insert(c: EcsTblErasedCommandsDeep, entity_id: i32, component_id: i32, type_id: i32, value: i32) -> EcsTblErasedCommandsDeep {
    if c.count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    if c.pcomp_count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    let slot: i32 = c.pcomp_count;
    c = ecs_tbl_erased_commands_set_pt(c, slot, type_id);
    c = ecs_tbl_erased_commands_set_pv(c, slot, value);
    c.pcomp_count = c.pcomp_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_INSERT_COMPONENT, entity_id, component_id, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_erased_commands_despawn(c: EcsTblErasedCommandsDeep, entity_id: i32) -> EcsTblErasedCommandsDeep {
    if c.count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_DESPAWN, entity_id, 0, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_erased_commands_insert_resource(c: EcsTblErasedCommandsDeep, value: i32) -> EcsTblErasedCommandsDeep {
    if c.count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    if c.pres_count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    let slot: i32 = c.pres_count;
    c = ecs_tbl_erased_commands_set_pres(c, slot, value);
    c.pres_count = c.pres_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_INSERT_RESOURCE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_erased_commands_write_message(c: EcsTblErasedCommandsDeep, value: i32) -> EcsTblErasedCommandsDeep {
    if c.count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    if c.pmsg_count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    let slot: i32 = c.pmsg_count;
    c = ecs_tbl_erased_commands_set_pmsg(c, slot, value);
    c.pmsg_count = c.pmsg_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_WRITE_MESSAGE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// spawn_batch_bundle2(bundles): the deep variant pushes one batch slot (cap-2 batches) recording
// cap-2 bundles; entities stays 0 for spawn (mirrors shallow entities:-unused). Returns the queue;
// the batch side index is stored in the command slot v.
fn ecs_tbl_erased_commands_spawn_batch_bundle2(
    c: EcsTblErasedCommandsDeep,
    ft0: i32, st0: i32, fv0: i32, sv0: i32,
    ft1: i32, st1: i32, fv1: i32, sv1: i32,
    count: i32
) -> EcsTblErasedCommandsDeep {
    if c.count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    if c.b2_count >= ECS_CMD_TBL_ERASED_BATCH_CAP_DEEP { return c; };
    let slot: i32 = c.b2_count;
    c = ecs_tbl_erased_commands_set_b2_slot(c, slot, 0, 0, ft0, st0, fv0, sv0, ft1, st1, fv1, sv1, count);
    c.b2_count = c.b2_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE2, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_erased_commands_spawn_batch_bundle3(
    c: EcsTblErasedCommandsDeep,
    ft0: i32, st0: i32, tt0: i32, fv0: i32, sv0: i32, tv0: i32,
    ft1: i32, st1: i32, tt1: i32, fv1: i32, sv1: i32, tv1: i32,
    count: i32
) -> EcsTblErasedCommandsDeep {
    if c.count >= ECS_CMD_TBL_ERASED_CAP_DEEP { return c; };
    if c.b3_count >= ECS_CMD_TBL_ERASED_BATCH_CAP_DEEP { return c; };
    let slot: i32 = c.b3_count;
    c = ecs_tbl_erased_commands_set_b3_slot(c, slot, 0, 0, ft0, st0, tt0, fv0, sv0, tv0, ft1, st1, tt1, fv1, sv1, tv1, count);
    c.b3_count = c.b3_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE3, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// insert_batch_bundle2: same bundle storage as spawn, but with parallel entity ids.
