    c = ecs_tbl_erased_commands_set_b2_slot(c, slot, be0, be1, ft0, st0, fv0, sv0, ft1, st1, fv1, sv1, count);
    c.b2_count = c.b2_count + 1;
    c = ecs_tbl_erased_commands_set_slot(c, c.count, ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2, 0, 0, slot);
