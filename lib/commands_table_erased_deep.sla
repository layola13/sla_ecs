    if idx == 0 { c.pt0 = value; };
    if idx == 1 { c.pt1 = value; };
    if idx == 2 { c.pt2 = value; };
    if idx == 3 { c.pt3 = value; };
    if idx == 4 { c.pt4 = value; };
    if idx == 5 { c.pt5 = value; };
    if idx == 6 { c.pt6 = value; };
    if idx == 7 { c.pt7 = value; };
    return c;
}

fn ecs_tbl_erased_commands_pt_at(c: EcsTblErasedCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.pt0; };
    if idx == 1 { return c.pt1; };
    if idx == 2 { return c.pt2; };
    if idx == 3 { return c.pt3; };
    if idx == 4 { return c.pt4; };
    if idx == 5 { return c.pt5; };
    if idx == 6 { return c.pt6; };
    if idx == 7 { return c.pt7; };
