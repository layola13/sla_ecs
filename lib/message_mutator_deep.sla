// Deepened Bevy ECS MessageMutator surface.
// Mirrors src/message/message_mutator.rs (+ Messages write path):
//   MessageMutator { Local<MessageCursor>, ResMut<Messages> }
//   read / read_with_id / par_read
//   len / is_empty / clear
//   write / write_batch / write_default
// Double-buffered Messages (A/B) + cursor last_message_count.
// Shallow lib/message_mutator.sla retained.

// === Messages double buffer (capacity 8 per sequence) ===
struct EcsMmMessagesDeep {
    a_start: i64,
    a0: i64, a1: i64, a2: i64, a3: i64,
    a4: i64, a5: i64, a6: i64, a7: i64,
    a_len: i32,
    b_start: i64,
    b0: i64, b1: i64, b2: i64, b3: i64,
    b4: i64, b5: i64, b6: i64, b7: i64,
    b_len: i32,
    message_count: i64,
}

fn ecs_mm_messages_new() -> EcsMmMessagesDeep {
    return EcsMmMessagesDeep {
        a_start: 0,
        a0: 0, a1: 0, a2: 0, a3: 0,
        a4: 0, a5: 0, a6: 0, a7: 0,
        a_len: 0,
        b_start: 0,
        b0: 0, b1: 0, b2: 0, b3: 0,
        b4: 0, b5: 0, b6: 0, b7: 0,
        b_len: 0,
        message_count: 0,
    };
}

fn ecs_mm_messages_message_count(m: EcsMmMessagesDeep) -> i64 { return m.message_count; }

fn ecs_mm_messages_len(m: EcsMmMessagesDeep) -> i64 {
    return (m.a_len as i64) + (m.b_len as i64);
}

fn ecs_mm_a_get(m: EcsMmMessagesDeep, idx: i32) -> i64 {
    if idx == 0 { return m.a0; };
    if idx == 1 { return m.a1; };
    if idx == 2 { return m.a2; };
    if idx == 3 { return m.a3; };
    if idx == 4 { return m.a4; };
    if idx == 5 { return m.a5; };
    if idx == 6 { return m.a6; };
    if idx == 7 { return m.a7; };
    return 0;
}

fn ecs_mm_b_get(m: EcsMmMessagesDeep, idx: i32) -> i64 {
    if idx == 0 { return m.b0; };
    if idx == 1 { return m.b1; };
    if idx == 2 { return m.b2; };
    if idx == 3 { return m.b3; };
    if idx == 4 { return m.b4; };
    if idx == 5 { return m.b5; };
    if idx == 6 { return m.b6; };
    if idx == 7 { return m.b7; };
    return 0;
}

fn ecs_mm_b_set(m: EcsMmMessagesDeep, idx: i32, v: i64) -> EcsMmMessagesDeep {
    if idx == 0 { m.b0 = v; };
    if idx == 1 { m.b1 = v; };
    if idx == 2 { m.b2 = v; };
    if idx == 3 { m.b3 = v; };
    if idx == 4 { m.b4 = v; };
    if idx == 5 { m.b5 = v; };
    if idx == 6 { m.b6 = v; };
    if idx == 7 { m.b7 = v; };
    return m;
}

fn ecs_mm_b_set_mut_value(m: EcsMmMessagesDeep, idx: i32, v: i64) -> EcsMmMessagesDeep {
    return ecs_mm_b_set(m, idx, v);
}

fn ecs_mm_a_set(m: EcsMmMessagesDeep, idx: i32, v: i64) -> EcsMmMessagesDeep {
    if idx == 0 { m.a0 = v; };
    if idx == 1 { m.a1 = v; };
    if idx == 2 { m.a2 = v; };
    if idx == 3 { m.a3 = v; };
    if idx == 4 { m.a4 = v; };
    if idx == 5 { m.a5 = v; };
    if idx == 6 { m.a6 = v; };
    if idx == 7 { m.a7 = v; };
    return m;
}

// write into B (current frame buffer), return MessageId = message_count before write
fn ecs_mm_messages_write(m: EcsMmMessagesDeep, value: i64) -> (EcsMmMessagesDeep, i64) {
    let id = m.message_count;
    if m.b_len >= 8 {
        // capacity full: still bump count but drop payload (model limit)
        m.message_count = m.message_count + 1;
        return (m, id);
    };
    m = ecs_mm_b_set(m, m.b_len, value);
    m.b_len = m.b_len + 1;
    m.message_count = m.message_count + 1;
    return (m, id);
}

fn ecs_mm_messages_write_default(m: EcsMmMessagesDeep) -> (EcsMmMessagesDeep, i64) {
    return ecs_mm_messages_write(m, 0);
}

// write_batch of up to 4 values; returns first_id + count
fn ecs_mm_messages_write_batch4(
    m: EcsMmMessagesDeep,
    v0: i64, v1: i64, v2: i64, v3: i64,
    n: i32
) -> (EcsMmMessagesDeep, i64, i32) {
    let first = m.message_count;
    let i: i32 = 0;
    while i < n {
        let v: i64 = 0;
        if i == 0 { v = v0; };
        if i == 1 { v = v1; };
        if i == 2 { v = v2; };
        if i == 3 { v = v3; };
        let w = ecs_mm_messages_write(m, v);
        m = w.0;
        i = i + 1;
    }
    return (m, first, n);
}

// frame update: swap A/B, clear B, B.start = message_count
fn ecs_mm_messages_update(m: EcsMmMessagesDeep) -> EcsMmMessagesDeep {
    // move B -> A, clear B
    m.a_start = m.b_start;
    m.a0 = m.b0; m.a1 = m.b1; m.a2 = m.b2; m.a3 = m.b3;
    m.a4 = m.b4; m.a5 = m.b5; m.a6 = m.b6; m.a7 = m.b7;
    m.a_len = m.b_len;
    m.b_start = m.message_count;
    m.b0 = 0; m.b1 = 0; m.b2 = 0; m.b3 = 0;
    m.b4 = 0; m.b5 = 0; m.b6 = 0; m.b7 = 0;
    m.b_len = 0;
    return m;
}

fn ecs_mm_sat_sub(a: i64, b: i64) -> i64 {
    if a < b { return 0; };
    return a - b;
}

fn ecs_mm_min(a: i64, b: i64) -> i64 {
    if a < b { return a; };
    return b;
}

// oldest retained id
fn ecs_mm_messages_oldest(m: EcsMmMessagesDeep) -> i64 {
    if m.a_len > 0 { return m.a_start; };
    if m.b_len > 0 { return m.b_start; };
    return m.message_count;
}

// === Cursor (Local in MessageMutator) ===
struct EcsMmCursorDeep {
    last_message_count: i64,
}

fn ecs_mm_cursor_default() -> EcsMmCursorDeep {
    return EcsMmCursorDeep { last_message_count: 0 };
}

fn ecs_mm_cursor_last(c: EcsMmCursorDeep) -> i64 { return c.last_message_count; }

fn ecs_mm_cursor_len(c: EcsMmCursorDeep, m: EcsMmMessagesDeep) -> i64 {
    let diff = ecs_mm_sat_sub(m.message_count, c.last_message_count);
    return ecs_mm_min(diff, ecs_mm_messages_len(m));
}

fn ecs_mm_cursor_is_empty(c: EcsMmCursorDeep, m: EcsMmMessagesDeep) -> bool {
    return ecs_mm_cursor_len(c, m) == 0;
}

fn ecs_mm_cursor_clear(c: EcsMmCursorDeep, m: EcsMmMessagesDeep) -> EcsMmCursorDeep {
    c.last_message_count = m.message_count;
    return c;
}

fn ecs_mm_cursor_missed(c: EcsMmCursorDeep, m: EcsMmMessagesDeep) -> i64 {
    return ecs_mm_sat_sub(ecs_mm_messages_oldest(m), c.last_message_count);
}

// === Mut iterator window (up to 8 unread) ===
struct EcsMmMutIterDeep {
    last_message_count: i64,
    unread: i64,
    pos: i64,
    is_mut: bool,
    p0: i64, p1: i64, p2: i64, p3: i64,
    p4: i64, p5: i64, p6: i64, p7: i64,
    id0: i64, id1: i64, id2: i64, id3: i64,
    id4: i64, id5: i64, id6: i64, id7: i64,
    // parallel location for mutate-back: 0=A 1=B, index in sequence
    loc_seq0: i32, loc_idx0: i32,
    loc_seq1: i32, loc_idx1: i32,
    loc_seq2: i32, loc_idx2: i32,
    loc_seq3: i32, loc_idx3: i32,
    loc_seq4: i32, loc_idx4: i32,
    loc_seq5: i32, loc_idx5: i32,
    loc_seq6: i32, loc_idx6: i32,
    loc_seq7: i32, loc_idx7: i32,
}

fn ecs_mm_iter_empty() -> EcsMmMutIterDeep {
    return EcsMmMutIterDeep {
        last_message_count: 0,
        unread: 0,
        pos: 0,
        is_mut: true,
        p0: 0, p1: 0, p2: 0, p3: 0,
        p4: 0, p5: 0, p6: 0, p7: 0,
        id0: 0, id1: 0, id2: 0, id3: 0,
        id4: 0, id5: 0, id6: 0, id7: 0,
        loc_seq0: 0, loc_idx0: 0,
        loc_seq1: 0, loc_idx1: 0,
        loc_seq2: 0, loc_idx2: 0,
        loc_seq3: 0, loc_idx3: 0,
        loc_seq4: 0, loc_idx4: 0,
        loc_seq5: 0, loc_idx5: 0,
        loc_seq6: 0, loc_idx6: 0,
        loc_seq7: 0, loc_idx7: 0,
    };
}

fn ecs_mm_iter_set(
    it: EcsMmMutIterDeep,
    w: i64,
    payload: i64,
    mid: i64,
    seq: i32,
    idx: i32
) -> EcsMmMutIterDeep {
    if w == 0 {
        it.p0 = payload; it.id0 = mid; it.loc_seq0 = seq; it.loc_idx0 = idx;
    };
    if w == 1 {
        it.p1 = payload; it.id1 = mid; it.loc_seq1 = seq; it.loc_idx1 = idx;
    };
    if w == 2 {
        it.p2 = payload; it.id2 = mid; it.loc_seq2 = seq; it.loc_idx2 = idx;
    };
    if w == 3 {
        it.p3 = payload; it.id3 = mid; it.loc_seq3 = seq; it.loc_idx3 = idx;
    };
    if w == 4 {
        it.p4 = payload; it.id4 = mid; it.loc_seq4 = seq; it.loc_idx4 = idx;
    };
    if w == 5 {
        it.p5 = payload; it.id5 = mid; it.loc_seq5 = seq; it.loc_idx5 = idx;
    };
    if w == 6 {
        it.p6 = payload; it.id6 = mid; it.loc_seq6 = seq; it.loc_idx6 = idx;
    };
    if w == 7 {
        it.p7 = payload; it.id7 = mid; it.loc_seq7 = seq; it.loc_idx7 = idx;
    };
    return it;
}

fn ecs_mm_iter_get_payload(it: EcsMmMutIterDeep, idx: i64) -> i64 {
    if idx == 0 { return it.p0; };
    if idx == 1 { return it.p1; };
    if idx == 2 { return it.p2; };
    if idx == 3 { return it.p3; };
    if idx == 4 { return it.p4; };
    if idx == 5 { return it.p5; };
    if idx == 6 { return it.p6; };
    if idx == 7 { return it.p7; };
    return 0;
}

fn ecs_mm_iter_get_id(it: EcsMmMutIterDeep, idx: i64) -> i64 {
    if idx == 0 { return it.id0; };
    if idx == 1 { return it.id1; };
    if idx == 2 { return it.id2; };
    if idx == 3 { return it.id3; };
    if idx == 4 { return it.id4; };
    if idx == 5 { return it.id5; };
    if idx == 6 { return it.id6; };
    if idx == 7 { return it.id7; };
    return 0;
}

fn ecs_mm_iter_get_seq(it: EcsMmMutIterDeep, idx: i64) -> i32 {
    if idx == 0 { return it.loc_seq0; };
    if idx == 1 { return it.loc_seq1; };
    if idx == 2 { return it.loc_seq2; };
    if idx == 3 { return it.loc_seq3; };
    if idx == 4 { return it.loc_seq4; };
    if idx == 5 { return it.loc_seq5; };
    if idx == 6 { return it.loc_seq6; };
    if idx == 7 { return it.loc_seq7; };
    return 0;
}

fn ecs_mm_iter_get_loc_idx(it: EcsMmMutIterDeep, idx: i64) -> i32 {
    if idx == 0 { return it.loc_idx0; };
    if idx == 1 { return it.loc_idx1; };
    if idx == 2 { return it.loc_idx2; };
    if idx == 3 { return it.loc_idx3; };
    if idx == 4 { return it.loc_idx4; };
    if idx == 5 { return it.loc_idx5; };
    if idx == 6 { return it.loc_idx6; };
    if idx == 7 { return it.loc_idx7; };
    return 0;
}

// Build mut read iterator (MessageMutIteratorWithId::new)
fn ecs_mm_read_with_id(
    c: EcsMmCursorDeep,
    m: EcsMmMessagesDeep
) -> (EcsMmCursorDeep, EcsMmMutIterDeep) {
    let a_index = ecs_mm_sat_sub(c.last_message_count, m.a_start);
    let b_index = ecs_mm_sat_sub(c.last_message_count, m.b_start);
    let it = ecs_mm_iter_empty();
    it.is_mut = true;
    let w: i64 = 0;

    let ai: i64 = a_index;
    while ai < (m.a_len as i64) {
        if w < 8 {
            let payload = ecs_mm_a_get(m, ai as i32);
            let mid = m.a_start + ai;
            it = ecs_mm_iter_set(it, w, payload, mid, 0, ai as i32);
            w = w + 1;
        };
        ai = ai + 1;
    }

    let bi: i64 = b_index;
    while bi < (m.b_len as i64) {
        if w < 8 {
            let payload = ecs_mm_b_get(m, bi as i32);
            let mid = m.b_start + bi;
            it = ecs_mm_iter_set(it, w, payload, mid, 1, bi as i32);
            w = w + 1;
        };
        bi = bi + 1;
    }

    it.unread = w;
    // Bevy: last_message_count = message_count - unread_count before iteration
    c.last_message_count = m.message_count - w;
    it.last_message_count = c.last_message_count;
    it.pos = 0;
    return (c, it);
}

fn ecs_mm_iter_next(it: EcsMmMutIterDeep) -> (bool, i64, i64, EcsMmMutIterDeep) {
    if it.unread <= 0 {
        return (false, 0, 0, it);
    };
    let payload = ecs_mm_iter_get_payload(it, it.pos);
    let mid = ecs_mm_iter_get_id(it, it.pos);
    it.pos = it.pos + 1;
    it.unread = it.unread - 1;
    it.last_message_count = it.last_message_count + 1;
    return (true, payload, mid, it);
}

// Mutate current yielded message back into Messages (models &mut M)
fn ecs_mm_iter_apply_mut(
    m: EcsMmMessagesDeep,
    it: EcsMmMutIterDeep,
    yielded_pos: i64,
    new_value: i64
) -> EcsMmMessagesDeep {
    // yielded_pos is the window index that was just next()'d (pos-1)
    let idx = yielded_pos;
    let seq = ecs_mm_iter_get_seq(it, idx);
    let loc = ecs_mm_iter_get_loc_idx(it, idx);
    if seq == 0 {
        return ecs_mm_a_set(m, loc, new_value);
    };
    return ecs_mm_b_set(m, loc, new_value);
}

fn ecs_mm_cursor_from_iter(it: EcsMmMutIterDeep) -> EcsMmCursorDeep {
    return EcsMmCursorDeep { last_message_count: it.last_message_count };
}

fn ecs_mm_iter_unread(it: EcsMmMutIterDeep) -> i64 { return it.unread; }
fn ecs_mm_iter_is_mut(it: EcsMmMutIterDeep) -> bool { return it.is_mut; }

// === MessageMutator SystemParam ===
struct EcsMessageMutatorDeep {
    cursor: EcsMmCursorDeep,
    messages: EcsMmMessagesDeep,
    // diagnostic: write ops this system run
    write_ops: i64,
}

fn ecs_mm_mutator_new() -> EcsMessageMutatorDeep {
    return EcsMessageMutatorDeep {
        cursor: ecs_mm_cursor_default(),
        messages: ecs_mm_messages_new(),
        write_ops: 0,
    };
}

fn ecs_mm_mutator_from_parts(
    c: EcsMmCursorDeep,
    m: EcsMmMessagesDeep
) -> EcsMessageMutatorDeep {
    return EcsMessageMutatorDeep {
        cursor: c,
        messages: m,
        write_ops: 0,
    };
}

fn ecs_mm_mutator_messages(mu: EcsMessageMutatorDeep) -> EcsMmMessagesDeep {
    return mu.messages;
}

fn ecs_mm_mutator_cursor(mu: EcsMessageMutatorDeep) -> EcsMmCursorDeep {
    return mu.cursor;
}

// Bevy MessageMutator::write — does NOT advance cursor
fn ecs_mm_mutator_write(mu: EcsMessageMutatorDeep, value: i64) -> (EcsMessageMutatorDeep, i64) {
    let w = ecs_mm_messages_write(mu.messages, value);
    mu.messages = w.0;
    mu.write_ops = mu.write_ops + 1;
    return (mu, w.1);
}

fn ecs_mm_mutator_write_default(mu: EcsMessageMutatorDeep) -> (EcsMessageMutatorDeep, i64) {
    return ecs_mm_mutator_write(mu, 0);
}

fn ecs_mm_mutator_write_batch4(
    mu: EcsMessageMutatorDeep,
    v0: i64, v1: i64, v2: i64, v3: i64,
    n: i32
) -> (EcsMessageMutatorDeep, i64, i32) {
    let w = ecs_mm_messages_write_batch4(mu.messages, v0, v1, v2, v3, n);
    mu.messages = w.0;
    mu.write_ops = mu.write_ops + (n as i64);
    return (mu, w.1, w.2);
}

// Bevy MessageMutator::len / is_empty / clear
fn ecs_mm_mutator_len(mu: EcsMessageMutatorDeep) -> i64 {
    return ecs_mm_cursor_len(mu.cursor, mu.messages);
}

fn ecs_mm_mutator_is_empty(mu: EcsMessageMutatorDeep) -> bool {
    return ecs_mm_cursor_is_empty(mu.cursor, mu.messages);
}

fn ecs_mm_mutator_clear(mu: EcsMessageMutatorDeep) -> EcsMessageMutatorDeep {
    mu.cursor = ecs_mm_cursor_clear(mu.cursor, mu.messages);
    return mu;
}

// Bevy MessageMutator::read_with_id
fn ecs_mm_mutator_read_with_id(
    mu: EcsMessageMutatorDeep
) -> (EcsMessageMutatorDeep, EcsMmMutIterDeep) {
    let r = ecs_mm_read_with_id(mu.cursor, mu.messages);
    mu.cursor = r.0;
    return (mu, r.1);
}

// Bevy MessageMutator::read (values only) — same setup, is_mut true
fn ecs_mm_mutator_read(
    mu: EcsMessageMutatorDeep
) -> (EcsMessageMutatorDeep, EcsMmMutIterDeep) {
    return ecs_mm_mutator_read_with_id(mu);
}

// par_read: sequential stand-in returning unread count
struct EcsMmParIterDeep {
    unread: i64,
    is_mut: bool,
}

fn ecs_mm_mutator_par_read(mu: EcsMessageMutatorDeep) -> (EcsMessageMutatorDeep, EcsMmParIterDeep) {
    let r = ecs_mm_mutator_read_with_id(mu);
    mu = r.0;
    let p = EcsMmParIterDeep {
        unread: r.1.unread,
        is_mut: true,
    };
    // par_read constructs iterator; consuming advances cursor via iter
    // restore cursor to pre-iter last like serial construction already set
    mu.cursor = ecs_mm_cursor_from_iter(r.1);
    // Actually after construction last is message_count - unread; full par consume would add unread
    // model: par_read().for_each drains all
    mu.cursor = ecs_mm_cursor_clear(mu.cursor, mu.messages);
    return (mu, p);
}

fn ecs_mm_par_unread(p: EcsMmParIterDeep) -> i64 { return p.unread; }
fn ecs_mm_par_is_mut(p: EcsMmParIterDeep) -> bool { return p.is_mut; }

// Convenience: write, then read same system (Bevy docs example)
fn ecs_mm_run_write_then_read(
    mu: EcsMessageMutatorDeep,
    value: i64
) -> (EcsMessageMutatorDeep, bool, i64, i64) {
    let w = ecs_mm_mutator_write(mu, value);
    mu = w.0;
    let r = ecs_mm_mutator_read_with_id(mu);
    mu = r.0;
    let it = r.1;
    let n = ecs_mm_iter_next(it);
    mu.cursor = ecs_mm_cursor_from_iter(n.3);
    return (mu, n.0, n.1, n.2);
}

// Convenience: read and bump each value by 1 (chain-of-systems mutate pattern)
fn ecs_mm_run_read_and_increment_all(
    mu: EcsMessageMutatorDeep
) -> (EcsMessageMutatorDeep, i64) {
    let r = ecs_mm_mutator_read_with_id(mu);
    mu = r.0;
    let it = r.1;
    let count: i64 = 0;
    let cont: bool = true;
    while cont {
        if it.unread <= 0 {
            cont = false;
        };
        if it.unread > 0 {
            let pos = it.pos;
            let n = ecs_mm_iter_next(it);
            it = n.3;
            let new_v = n.1 + 1;
            mu.messages = ecs_mm_iter_apply_mut(mu.messages, it, pos, new_v);
            count = count + 1;
        };
    }
    mu.cursor = ecs_mm_cursor_from_iter(it);
    return (mu, count);
}

// Frame boundary for Messages resource
fn ecs_mm_mutator_messages_update(mu: EcsMessageMutatorDeep) -> EcsMessageMutatorDeep {
    mu.messages = ecs_mm_messages_update(mu.messages);
    return mu;
}

fn ecs_mm_mutator_write_ops(mu: EcsMessageMutatorDeep) -> i64 { return mu.write_ops; }

// SystemParam validation stand-in: messages resource initialized
fn ecs_mm_mutator_validation_ok(mu: EcsMessageMutatorDeep) -> bool {
    // always true for constructed mutator; false only if explicitly invalid
    return true;
}

// Concurrency note constants (documentation markers)
const ECS_MM_EXCLUSIVE_SAME_TYPE: i32 = 1;
const ECS_MM_CONFLICTS_WITH_READER: i32 = 1;
const ECS_MM_CONFLICTS_WITH_WRITER: i32 = 1;

fn ecs_mm_conflicts_with_reader() -> bool { return true; }
fn ecs_mm_conflicts_with_writer() -> bool { return true; }
fn ecs_mm_exclusive_same_type() -> bool { return true; }
