// Deepened Bevy ECS DynamicComponentStore (dense ids + sparse 'row-of') fixed cap-8.
// Stand-in for shallow lib/dyn_store.sla (Vec-backed). Operations:
//   new, count, is_empty, has, insert (overwrite existing / append new),
//   get_x, get_y (panics when missing), slot_of (returns row or -1),
//   write (by slot), swap_remove (returns bool), clear.
// Invariant: dense slot index 'row' stored in sparse map r<eid> == row of {eid}

const ECS_DYNAMIC_STORE_CAP: i32 = 8;

struct EcsDynamicStoreDeep {
    // dense entity ids (capacity 8); -1 = free slot
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    // dense values (DynPoint stand-in: x, y per row)
    x0: i32, x1: i32, x2: i32, x3: i32, x4: i32, x5: i32, x6: i32, x7: i32,
    y0: i32, y1: i32, y2: i32, y3: i32, y4: i32, y5: i32, y6: i32, y7: i32,
    // sparse 'row-of' (entity_id -> row) for ids 0..7  (-1 if absent)
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    count: i32,
}

fn ecs_dyn_store_new() -> EcsDynamicStoreDeep {
    let s = EcsDynamicStoreDeep {
        e0: -1, e1: -1, e2: -1, e3: -1, e4: -1, e5: -1, e6: -1, e7: -1,
        x0: 0, x1: 0, x2: 0, x3: 0, x4: 0, x5: 0, x6: 0, x7: 0,
        y0: 0, y1: 0, y2: 0, y3: 0, y4: 0, y5: 0, y6: 0, y7: 0,
        r0: -1, r1: -1, r2: -1, r3: -1, r4: -1, r5: -1, r6: -1, r7: -1,
        count: 0,
    };
    return s;
}

fn ecs_dyn_store_count(s: EcsDynamicStoreDeep) -> i32 { return s.count; }

fn ecs_dyn_store_is_empty(s: EcsDynamicStoreDeep) -> bool {
    if s.count == 0 { return true; };
    return false;
}

fn ecs_dyn_store_row_of(s: EcsDynamicStoreDeep, eid: i32) -> i32 {
    if eid < 0 { return -1; };
    if eid > 7 { return -1; };
    if eid == 0 { return s.r0; };
    if eid == 1 { return s.r1; };
    if eid == 2 { return s.r2; };
    if eid == 3 { return s.r3; };
    if eid == 4 { return s.r4; };
    if eid == 5 { return s.r5; };
    if eid == 6 { return s.r6; };
    if eid == 7 { return s.r7; };
    return -1;
}

fn ecs_dyn_store_has(s: EcsDynamicStoreDeep, eid: i32) -> bool {
    let row = ecs_dyn_store_row_of(s, eid);
    if row < 0 { return false; };
    return true;
}

fn ecs_dyn_store_e_at(s: EcsDynamicStoreDeep, row: i32) -> i32 {
    if row == 0 { return s.e0; };
    if row == 1 { return s.e1; };
    if row == 2 { return s.e2; };
    if row == 3 { return s.e3; };
    if row == 4 { return s.e4; };
    if row == 5 { return s.e5; };
    if row == 6 { return s.e6; };
    if row == 7 { return s.e7; };
    return -1;
}

fn ecs_dyn_store_x_at(s: EcsDynamicStoreDeep, row: i32) -> i32 {
    if row == 0 { return s.x0; };
    if row == 1 { return s.x1; };
    if row == 2 { return s.x2; };
    if row == 3 { return s.x3; };
    if row == 4 { return s.x4; };
    if row == 5 { return s.x5; };
    if row == 6 { return s.x6; };
    if row == 7 { return s.x7; };
    return 0;
}

fn ecs_dyn_store_y_at(s: EcsDynamicStoreDeep, row: i32) -> i32 {
    if row == 0 { return s.y0; };
    if row == 1 { return s.y1; };
    if row == 2 { return s.y2; };
    if row == 3 { return s.y3; };
    if row == 4 { return s.y4; };
    if row == 5 { return s.y5; };
    if row == 6 { return s.y6; };
    if row == 7 { return s.y7; };
    return 0;
}

// Mutators operate field-by-field (by-value store + reassign), honoring the SLA convention.

// Sparse-map helper for writeable reassign of row r<id>.
fn ecs_dyn_store_set_row(s: EcsDynamicStoreDeep, eid: i32, row: i32) -> EcsDynamicStoreDeep {
    if eid == 0 { s.r0 = row; };
    if eid == 1 { s.r1 = row; };
    if eid == 2 { s.r2 = row; };
    if eid == 3 { s.r3 = row; };
    if eid == 4 { s.r4 = row; };
    if eid == 5 { s.r5 = row; };
    if eid == 6 { s.r6 = row; };
    if eid == 7 { s.r7 = row; };
    return s;
}

// Dense-e helper for assign of dense id at row.
fn ecs_dyn_store_set_e(s: EcsDynamicStoreDeep, row: i32, eid: i32) -> EcsDynamicStoreDeep {
    if row == 0 { s.e0 = eid; };
    if row == 1 { s.e1 = eid; };
    if row == 2 { s.e2 = eid; };
    if row == 3 { s.e3 = eid; };
    if row == 4 { s.e4 = eid; };
    if row == 5 { s.e5 = eid; };
    if row == 6 { s.e6 = eid; };
    if row == 7 { s.e7 = eid; };
    return s;
}

// Dense-value helper for assign (x, y) at row.
fn ecs_dyn_store_set_xy(s: EcsDynamicStoreDeep, row: i32, x: i32, y: i32) -> EcsDynamicStoreDeep {
    if row == 0 { s.x0 = x; s.y0 = y; };
    if row == 1 { s.x1 = x; s.y1 = y; };
    if row == 2 { s.x2 = x; s.y2 = y; };
    if row == 3 { s.x3 = x; s.y3 = y; };
    if row == 4 { s.x4 = x; s.y4 = y; };
    if row == 5 { s.x5 = x; s.y5 = y; };
    if row == 6 { s.x6 = x; s.y6 = y; };
    if row == 7 { s.x7 = x; s.y7 = y; };
    return s;
}

// Insert: if entity already present, overwrite value. Otherwise append at next free row.
// Returns the same store (by value). Preserves sparse map invariant.
fn ecs_dyn_store_insert(s: EcsDynamicStoreDeep, eid: i32, x: i32, y: i32) -> EcsDynamicStoreDeep {
    let existing = ecs_dyn_store_row_of(s, eid);
    if existing >= 0 {
        s = ecs_dyn_store_set_xy(s, existing, x, y);
        return s;
    };
    let row = s.count;
    if row >= ECS_DYNAMIC_STORE_CAP { return s; };
    s = ecs_dyn_store_set_e(s, row, eid);
    s = ecs_dyn_store_set_xy(s, row, x, y);
    s = ecs_dyn_store_set_row(s, eid, row);
    s.count = s.count + 1;
    return s;
}

fn ecs_dyn_store_get_x(s: EcsDynamicStoreDeep, eid: i32) -> i32 {
    let row = ecs_dyn_store_row_of(s, eid);
    if row < 0 { panic(135800); };
    return ecs_dyn_store_x_at(s, row);
}

fn ecs_dyn_store_get_y(s: EcsDynamicStoreDeep, eid: i32) -> i32 {
    let row = ecs_dyn_store_row_of(s, eid);
    if row < 0 { panic(135801); };
    return ecs_dyn_store_y_at(s, row);
}

// write: overwrite (x, y) at slot
fn ecs_dyn_store_write(s: EcsDynamicStoreDeep, row: i32, x: i32, y: i32) -> EcsDynamicStoreDeep {
    s = ecs_dyn_store_set_xy(s, row, x, y);
    return s;
}

// swap_remove: removes the entry for eid; if the removed row is not the last dense row,
// the last dense row is moved into it (cheap O(1) removal). Returns true if removed.
fn ecs_dyn_store_swap_remove(s: EcsDynamicStoreDeep, eid: i32) -> EcsDynamicStoreDeep {
    let row = ecs_dyn_store_row_of(s, eid);
    if row < 0 { return s; };
    let last = s.count - 1;
    // Clear sparse map entry for removed eid.
    s = ecs_dyn_store_set_row(s, eid, -1);
    if row != last {
        // Move last dense row into removed row's slot.
        let last_eid = ecs_dyn_store_e_at(s, last);
        let last_x = ecs_dyn_store_x_at(s, last);
        let last_y = ecs_dyn_store_y_at(s, last);
        s = ecs_dyn_store_set_e(s, row, last_eid);
        s = ecs_dyn_store_set_xy(s, row, last_x, last_y);
        s = ecs_dyn_store_set_e(s, last, -1);
        s = ecs_dyn_store_set_xy(s, last, 0, 0);
        s = ecs_dyn_store_set_row(s, last_eid, row);
    } else {
        s = ecs_dyn_store_set_e(s, row, -1);
        s = ecs_dyn_store_set_xy(s, row, 0, 0);
    };
    s.count = s.count - 1;
    return s;
}

fn ecs_dyn_store_clear(s: EcsDynamicStoreDeep) -> EcsDynamicStoreDeep {
    s = ecs_dyn_store_new();
    return s;
}
