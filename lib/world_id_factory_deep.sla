// Deepened Bevy ECS WorldId factory + SparseSetIndex.
// Mirrors src/world/identifier.rs. Shallow lib/world_id_factory.sla retained.

struct EcsWidfDeep {
    next_id: i64,
    cap: i64,
    exhausted: bool,
}

fn ecs_widf_deep_new() -> EcsWidfDeep {
    return EcsWidfDeep { next_id: 0, cap: 1000000000, exhausted: false };
}

fn ecs_widf_deep_with_cap(cap: i64) -> EcsWidfDeep {
    return EcsWidfDeep { next_id: 0, cap: cap, exhausted: false };
}

fn ecs_widf_deep_next(f: EcsWidfDeep) -> i64 { return f.next_id; }
fn ecs_widf_deep_is_exhausted(f: EcsWidfDeep) -> bool { return f.exhausted; }
fn ecs_widf_deep_cap(f: EcsWidfDeep) -> i64 { return f.cap; }

struct EcsWidNewDeep {
    factory: EcsWidfDeep,
    has_id: bool,
    id_value: i64,
}

fn ecs_wid_new_factory(r: EcsWidNewDeep) -> EcsWidfDeep { return r.factory; }
fn ecs_wid_new_has(r: EcsWidNewDeep) -> bool { return r.has_id; }
fn ecs_wid_new_value(r: EcsWidNewDeep) -> i64 { return r.id_value; }

fn ecs_widf_deep_mint(f: EcsWidfDeep) -> EcsWidNewDeep {
    if f.exhausted {
        return EcsWidNewDeep { factory: f, has_id: false, id_value: 0 - 1 };
    };
    if f.next_id >= f.cap {
        let f2 = EcsWidfDeep { next_id: f.next_id, cap: f.cap, exhausted: true };
        return EcsWidNewDeep { factory: f2, has_id: false, id_value: 0 - 1 };
    };
    let v = f.next_id;
    let f2 = EcsWidfDeep { next_id: v + 1, cap: f.cap, exhausted: false };
    return EcsWidNewDeep { factory: f2, has_id: true, id_value: v };
}

struct EcsWidDeep {
    value: i64,
}

fn ecs_wid_deep_new(value: i64) -> EcsWidDeep {
    return EcsWidDeep { value: value };
}

fn ecs_wid_deep_value(id: EcsWidDeep) -> i64 { return id.value; }
fn ecs_wid_deep_sparse_index(id: EcsWidDeep) -> i64 { return id.value; }

fn ecs_wid_deep_from_sparse(value: i64) -> EcsWidDeep {
    return EcsWidDeep { value: value };
}

fn ecs_wid_deep_eq(a: EcsWidDeep, b: EcsWidDeep) -> bool {
    return a.value == b.value;
}

// mint N ids into fixed buffer of 4
struct EcsWidBatchDeep {
    factory: EcsWidfDeep,
    n: i32,
    i0: i64, i1: i64, i2: i64, i3: i64,
    ok: bool,
}

fn ecs_widf_deep_mint_many(f: EcsWidfDeep, count: i32) -> EcsWidBatchDeep {
    let n = 0;
    let i0 = 0;
    let i1 = 0;
    let i2 = 0;
    let i3 = 0;
    let ok = true;
    let cur = f;
    if count >= 1 {
        let r0 = ecs_widf_deep_mint(cur);
        cur = ecs_wid_new_factory(r0);
        if ecs_wid_new_has(r0) {
            i0 = ecs_wid_new_value(r0);
            n = 1;
        } else {
            ok = false;
        };
    };
    if count >= 2 {
        if ok {
            let r1 = ecs_widf_deep_mint(cur);
            cur = ecs_wid_new_factory(r1);
            if ecs_wid_new_has(r1) {
                i1 = ecs_wid_new_value(r1);
                n = 2;
            } else {
                ok = false;
            };
        };
    };
    if count >= 3 {
        if ok {
            let r2 = ecs_widf_deep_mint(cur);
            cur = ecs_wid_new_factory(r2);
            if ecs_wid_new_has(r2) {
                i2 = ecs_wid_new_value(r2);
                n = 3;
            } else {
                ok = false;
            };
        };
    };
    if count >= 4 {
        if ok {
            let r3 = ecs_widf_deep_mint(cur);
            cur = ecs_wid_new_factory(r3);
            if ecs_wid_new_has(r3) {
                i3 = ecs_wid_new_value(r3);
                n = 4;
            } else {
                ok = false;
            };
        };
    };
    return EcsWidBatchDeep { factory: cur, n: n, i0: i0, i1: i1, i2: i2, i3: i3, ok: ok };
}

fn ecs_wid_batch_n(b: EcsWidBatchDeep) -> i32 { return b.n; }
fn ecs_wid_batch_ok(b: EcsWidBatchDeep) -> bool { return b.ok; }
fn ecs_wid_batch_at(b: EcsWidBatchDeep, idx: i32) -> i64 {
    if idx == 0 { return b.i0; };
    if idx == 1 { return b.i1; };
    if idx == 2 { return b.i2; };
    if idx == 3 { return b.i3; };
    return -1;
}
fn ecs_wid_batch_factory(b: EcsWidBatchDeep) -> EcsWidfDeep { return b.factory; }
