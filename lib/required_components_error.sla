// Bevy ECS RequiredComponentsError + lifecycle constants — mirrors
// src/component/required.rs (RequiredComponentsError enum) + src/component/constants.rs
// (ADD/INSERT/DISCARD/REMOVE/DESPAWN/IS_RESOURCE lifecycle component indices).
//
//   pub enum RequiredComponentsError {
//       DuplicateRegistration(ComponentId, ComponentId),
//       CyclicRequirement(ComponentId, ComponentId),
//       ArchetypeExists(ComponentId),
//   }
//   pub const ADD:        usize = 0;
//   pub const INSERT:     usize = 1;
//   pub const DISCARD:    usize = 2;
//   pub const REMOVE:     usize = 3;
//   pub const DESPAWN:    usize = 4;
//   pub const IS_RESOURCE: usize = 5;
//
// We model the error with kind + up to two ComponentId payloads (a sentinel -1 means "no payload"),
// and the constants as i32 getters. The Display strings are modelled via the error kind alone.

// === RequiredComponentsError ===
// kind: 0 => DuplicateRegistration(requiree, required), 1 => CyclicRequirement(requiree, required),
// 2 => ArchetypeExists(component). The requiree/required component-id pair carries (a, b); for
// ArchetypeExists only a carries the component (b = -1).
struct EcsRequiredComponentsError {
    kind: i32,
    a_component_id: i32,
    b_component_id: i32,
}

fn ecs_rce_duplicate_registration(requiree: i32, required: i32) -> EcsRequiredComponentsError {
    return EcsRequiredComponentsError { kind: 0, a_component_id: requiree, b_component_id: required };
}

fn ecs_rce_cyclic_requirement(requiree: i32, required: i32) -> EcsRequiredComponentsError {
    return EcsRequiredComponentsError { kind: 1, a_component_id: requiree, b_component_id: required };
}

fn ecs_rce_archetype_exists(component: i32) -> EcsRequiredComponentsError {
    return EcsRequiredComponentsError { kind: 2, a_component_id: component, b_component_id: (0 - 1) };
}

fn ecs_rce_kind(e: EcsRequiredComponentsError) -> i32 {
    return e.kind;
}

fn ecs_rce_a(e: EcsRequiredComponentsError) -> i32 {
    return e.a_component_id;
}

fn ecs_rce_b(e: EcsRequiredComponentsError) -> i32 {
    return e.b_component_id;
}

fn ecs_rce_is_duplicate_registration(e: EcsRequiredComponentsError) -> bool {
    return e.kind == 0;
}

fn ecs_rce_is_cyclic_requirement(e: EcsRequiredComponentsError) -> bool {
    return e.kind == 1;
}

fn ecs_rce_is_archetype_exists(e: EcsRequiredComponentsError) -> bool {
    return e.kind == 2;
}

// === Lifecycle component constants === (src/component/constants.rs)
fn ecs_const_add() -> i32 { return 0; }
fn ecs_const_insert() -> i32 { return 1; }
fn ecs_const_discard() -> i32 { return 2; }
fn ecs_const_remove() -> i32 { return 3; }
fn ecs_const_despawn() -> i32 { return 4; }
fn ecs_const_is_resource() -> i32 { return 5; }

// A small helper: classify a lifecycle index -> symbolic name id (0..5).
fn ecs_const_lifecycle_kind(index: i32) -> i32 {
    if index < 0 || index > 5 { return (0 - 1); };
    return index;
}
