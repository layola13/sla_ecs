// Deep self-contained Bevy ECS world::reflect module.
// Mirrors lib/world_reflect.sla (34 lines, no @import). All fields are scalar (i64) — no
// Vec, no nested @derive(copy) struct field, no tuple-returning fns — so this is a direct
// scalar mirror with @derive(copy) annotations. No @import.

@derive(copy)
struct EcsReflectWorldDeep {
    world_id: i64,
    reflect_component_count: i64,
    reflect_resource_count: i64,
}

fn ecs_reflect_world_deep_new(world_id: i64) -> EcsReflectWorldDeep {
    return EcsReflectWorldDeep {
        world_id: world_id,
        reflect_component_count: 0,
        reflect_resource_count: 0,
    };
}

fn ecs_reflect_world_deep_id(w: EcsReflectWorldDeep) -> i64 { return w.world_id; }

fn ecs_reflect_world_deep_register_component(w: EcsReflectWorldDeep) -> EcsReflectWorldDeep {
    w.reflect_component_count = w.reflect_component_count + 1;
    return w;
}

fn ecs_reflect_world_deep_register_resource(w: EcsReflectWorldDeep) -> EcsReflectWorldDeep {
    w.reflect_resource_count = w.reflect_resource_count + 1;
    return w;
}

fn ecs_reflect_world_deep_component_count(w: EcsReflectWorldDeep) -> i64 { return w.reflect_component_count; }
fn ecs_reflect_world_deep_resource_count(w: EcsReflectWorldDeep) -> i64 { return w.reflect_resource_count; }

// short_type_name: returns a simplified name id (placeholder identity).
fn ecs_short_type_name_deep(full_id: i64) -> i64 { return full_id; }
