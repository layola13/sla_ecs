// Bevy ECS system::function_system extension — SystemState + FunctionSystem builders + markers.
// Mirrors src/system/function_system.rs.

// === SystemState<Param> ===
struct EcsSystemState {
    param_id: i64,
    initialized: bool,
    world_id: i64,
    last_run_tick: i32,
    cached_value: i64,
}

fn ecs_fs_system_state_new(param_id: i64, world_id: i64, change_tick: i32) -> EcsSystemState {
    let s = EcsSystemState { param_id: param_id, initialized: true, world_id: world_id, last_run_tick: change_tick, cached_value: 0 };
    return s;
}

fn ecs_fs_system_state_from_builder(param_id: i64, world_id: i64, change_tick: i32) -> EcsSystemState {
    return ecs_fs_system_state_new(param_id, world_id, change_tick);
}

// build_system / build_system_with_input / build_any_system: produce a FunctionSystem.
struct EcsFunctionSystemV2 {
    name_id: i64,
    last_run_tick: i32,
    initialized: bool,
    exclusive: bool,
    non_send: bool,
    last_output: i64,
    run_count: i64,
    input_value: i64,
}

fn ecs_fs_function_system_v2_new(name_id: i64, tick: i32) -> EcsFunctionSystemV2 {
    let fs = EcsFunctionSystemV2 { name_id: name_id, last_run_tick: tick, initialized: false, exclusive: false, non_send: false, last_output: 0, run_count: 0, input_value: 0 };
    return fs;
}

fn ecs_fs_build_system(state: EcsSystemState, system_id: i64) -> EcsFunctionSystemV2 {
    return ecs_fs_function_system_v2_new(system_id, state.last_run_tick);
}

fn ecs_fs_build_system_with_input(state: EcsSystemState, system_id: i64, input: i64) -> EcsFunctionSystemV2 {
    let fs = ecs_fs_function_system_v2_new(system_id, state.last_run_tick);
    fs.input_value = input;
    return fs;
}

fn ecs_fs_build_any_system(state: EcsSystemState, system_id: i64) -> EcsFunctionSystemV2 {
    return ecs_fs_build_system(state, system_id);
}

// accessors
fn ecs_fs_system_state_meta(state: EcsSystemState, name_id: i64) -> (i64, i32, bool) {
    // returns (name_id, last_run, initialized)
    return (name_id, state.last_run_tick, state.initialized);
}

fn ecs_fs_system_state_meta_mut(state: EcsSystemState, new_name_id: i64, last_run: i32) -> EcsSystemState {
    state.last_run_tick = last_run;
    // name_id is supplied separately as meta carries its own name on system creation
    return state;
}

fn ecs_fs_system_state_get(state: EcsSystemState) -> (bool, i64) {
    return (state.initialized, state.cached_value);
}

fn ecs_fs_system_state_get_mut(state: EcsSystemState, new_value: i64) -> EcsSystemState {
    state.cached_value = new_value;
    return state;
}

fn ecs_fs_system_state_apply(state: EcsSystemState, applied_value: i64) -> EcsSystemState {
    state.cached_value = applied_value;
    return state;
}

fn ecs_fs_system_state_matches_world(state: EcsSystemState, world_id: i64) -> bool {
    return state.world_id == world_id;
}

fn ecs_fs_system_state_param_state(state: EcsSystemState) -> i64 {
    return state.param_id;
}

// === FunctionSystem ===
fn ecs_fs_function_system_v2_with_name(fs: EcsFunctionSystemV2, new_name: i64) -> EcsFunctionSystemV2 {
    fs.name_id = new_name;
    return fs;
}

fn ecs_fs_function_system_v2_initialize(fs: EcsFunctionSystemV2) -> EcsFunctionSystemV2 {
    fs.initialized = true;
    return fs;
}

fn ecs_fs_function_system_v2_is_initialized(fs: EcsFunctionSystemV2) -> bool {
    return fs.initialized;
}

fn ecs_fs_function_system_v2_run(fs: EcsFunctionSystemV2, output: i64) -> EcsFunctionSystemV2 {
    fs.last_output = output;
    fs.run_count = fs.run_count + 1;
    return fs;
}

fn ecs_fs_function_system_v2_last_output(fs: EcsFunctionSystemV2) -> i64 {
    return fs.last_output;
}

fn ecs_fs_function_system_v2_run_count(fs: EcsFunctionSystemV2) -> i64 {
    return fs.run_count;
}

fn ecs_fs_function_system_v2_with_input(fs: EcsFunctionSystemV2, input: i64) -> EcsFunctionSystemV2 {
    fs.input_value = input;
    return fs;
}

fn ecs_fs_function_system_v2_input(fs: EcsFunctionSystemV2) -> i64 {
    return fs.input_value;
}

fn ecs_fs_function_system_v2_set_exclusive(fs: EcsFunctionSystemV2) -> EcsFunctionSystemV2 {
    fs.exclusive = true;
    return fs;
}

fn ecs_fs_function_system_v2_set_non_send(fs: EcsFunctionSystemV2) -> EcsFunctionSystemV2 {
    fs.non_send = true;
    return fs;
}

fn ecs_fs_function_system_v2_is_exclusive(fs: EcsFunctionSystemV2) -> bool { return fs.exclusive; }
fn ecs_fs_function_system_v2_is_non_send(fs: EcsFunctionSystemV2) -> bool { return fs.non_send; }

fn ecs_fs_function_system_v2_name(fs: EcsFunctionSystemV2) -> i64 { return fs.name_id; }
fn ecs_fs_function_system_v2_last_run(fs: EcsFunctionSystemV2) -> i32 { return fs.last_run_tick; }

fn ecs_fs_function_system_v2_set_last_run(fs: EcsFunctionSystemV2, tick: i32) -> EcsFunctionSystemV2 {
    fs.last_run_tick = tick;
    return fs;
}

// === Markers: IsFunctionSystem, HasSystemInput ===
struct EcsIsFunctionSystem {}
struct EcsHasSystemInput {}

fn ecs_fs_is_function_system_new() -> EcsIsFunctionSystem { return EcsIsFunctionSystem {}; }
fn ecs_fs_has_system_input_new() -> EcsHasSystemInput { return EcsHasSystemInput {}; }
