// Deepened Bevy ECS WorldQuery trait surface.
// Mirrors src/query/world_query.rs descriptors:
//   read/write/filter/has/read_only kinds
//   fetch init + update_component_access simulation
//   dense flag, shrink_item, set_last_run/this_run ticks
// Shallow lib/query_world_query.sla retained.

const ECS_WQD_READ: i32 = 0;
const ECS_WQD_WRITE: i32 = 1;
const ECS_WQD_FILTER: i32 = 2;
const ECS_WQD_HAS: i32 = 3;
const ECS_WQD_READ_ONLY: i32 = 4;

struct EcsWqDeep {
    kind: i32,
    component_id: i32,
    is_dense: bool,
}

fn ecs_wqd_read(cid: i32) -> EcsWqDeep {
    return EcsWqDeep { kind: ECS_WQD_READ, component_id: cid, is_dense: true };
}
fn ecs_wqd_write(cid: i32) -> EcsWqDeep {
    return EcsWqDeep { kind: ECS_WQD_WRITE, component_id: cid, is_dense: true };
}
fn ecs_wqd_filter(cid: i32) -> EcsWqDeep {
    return EcsWqDeep { kind: ECS_WQD_FILTER, component_id: cid, is_dense: true };
}
fn ecs_wqd_has(cid: i32) -> EcsWqDeep {
    return EcsWqDeep { kind: ECS_WQD_HAS, component_id: cid, is_dense: true };
}
fn ecs_wqd_read_only(cid: i32) -> EcsWqDeep {
    return EcsWqDeep { kind: ECS_WQD_READ_ONLY, component_id: cid, is_dense: true };
}

fn ecs_wqd_kind(q: EcsWqDeep) -> i32 { return q.kind; }
fn ecs_wqd_component_id(q: EcsWqDeep) -> i32 { return q.component_id; }
fn ecs_wqd_is_dense(q: EcsWqDeep) -> bool { return q.is_dense; }

fn ecs_wqd_set_dense(q: EcsWqDeep, dense: bool) -> EcsWqDeep {
    return EcsWqDeep { kind: q.kind, component_id: q.component_id, is_dense: dense };
}

fn ecs_wqd_is_read_only(q: EcsWqDeep) -> bool {
    if q.kind == ECS_WQD_WRITE { return false; };
    return true;
}
fn ecs_wqd_is_write(q: EcsWqDeep) -> bool {
    if q.kind == ECS_WQD_WRITE { return true; };
    return false;
}
fn ecs_wqd_is_filter(q: EcsWqDeep) -> bool {
    if q.kind == ECS_WQD_FILTER { return true; };
    if q.kind == ECS_WQD_HAS { return true; };
    return false;
}

// Fetch state for a WorldQuery
struct EcsWqFetchDeep {
    query: EcsWqDeep,
    value: i64,
    last_run: i32,
    this_run: i32,
    table_row: i32,
}

fn ecs_wqd_fetch_new(q: EcsWqDeep, value: i64) -> EcsWqFetchDeep {
    return EcsWqFetchDeep { query: q, value: value, last_run: 0, this_run: 0, table_row: -1 };
}
fn ecs_wqd_fetch_value(f: EcsWqFetchDeep) -> i64 { return f.value; }
fn ecs_wqd_fetch_kind(f: EcsWqFetchDeep) -> i32 { return f.query.kind; }
fn ecs_wqd_fetch_component_id(f: EcsWqFetchDeep) -> i32 { return f.query.component_id; }
fn ecs_wqd_fetch_last_run(f: EcsWqFetchDeep) -> i32 { return f.last_run; }
fn ecs_wqd_fetch_this_run(f: EcsWqFetchDeep) -> i32 { return f.this_run; }
fn ecs_wqd_fetch_table_row(f: EcsWqFetchDeep) -> i32 { return f.table_row; }

fn ecs_wqd_fetch_set_last_run(f: EcsWqFetchDeep, tick: i32) -> EcsWqFetchDeep {
    return EcsWqFetchDeep {
        query: f.query, value: f.value, last_run: tick, this_run: f.this_run, table_row: f.table_row,
    };
}
fn ecs_wqd_fetch_set_this_run(f: EcsWqFetchDeep, tick: i32) -> EcsWqFetchDeep {
    return EcsWqFetchDeep {
        query: f.query, value: f.value, last_run: f.last_run, this_run: tick, table_row: f.table_row,
    };
}
fn ecs_wqd_fetch_set_table_row(f: EcsWqFetchDeep, row: i32) -> EcsWqFetchDeep {
    return EcsWqFetchDeep {
        query: f.query, value: f.value, last_run: f.last_run, this_run: f.this_run, table_row: row,
    };
}
fn ecs_wqd_fetch_set_value(f: EcsWqFetchDeep, value: i64) -> EcsWqFetchDeep {
    return EcsWqFetchDeep {
        query: f.query, value: value, last_run: f.last_run, this_run: f.this_run, table_row: f.table_row,
    };
}

// update_component_access simulation: produce access flags for this query
struct EcsWqAccessDeep {
    read: bool,
    write: bool,
    filter: bool,
    component_id: i32,
}
fn ecs_wqd_access_read(a: EcsWqAccessDeep) -> bool { return a.read; }
fn ecs_wqd_access_write(a: EcsWqAccessDeep) -> bool { return a.write; }
fn ecs_wqd_access_filter(a: EcsWqAccessDeep) -> bool { return a.filter; }
fn ecs_wqd_access_component_id(a: EcsWqAccessDeep) -> i32 { return a.component_id; }

fn ecs_wqd_update_component_access(q: EcsWqDeep) -> EcsWqAccessDeep {
    if q.kind == ECS_WQD_WRITE {
        return EcsWqAccessDeep { read: true, write: true, filter: false, component_id: q.component_id };
    };
    if q.kind == ECS_WQD_FILTER {
        return EcsWqAccessDeep { read: false, write: false, filter: true, component_id: q.component_id };
    };
    if q.kind == ECS_WQD_HAS {
        return EcsWqAccessDeep { read: false, write: false, filter: true, component_id: q.component_id };
    };
    // read / read_only
    return EcsWqAccessDeep { read: true, write: false, filter: false, component_id: q.component_id };
}

// shrink_item: drop value when converting to read-only item view
fn ecs_wqd_shrink_to_readonly(f: EcsWqFetchDeep) -> EcsWqFetchDeep {
    let kind = f.query.kind;
    let cid = f.query.component_id;
    let dense = f.query.is_dense;
    let value = f.value;
    let last_run = f.last_run;
    let this_run = f.this_run;
    let table_row = f.table_row;
    if kind == ECS_WQD_WRITE {
        kind = ECS_WQD_READ_ONLY;
    };
    return EcsWqFetchDeep {
        query: EcsWqDeep { kind: kind, component_id: cid, is_dense: dense },
        value: value, last_run: last_run, this_run: this_run, table_row: table_row,
    };
}

// match archetype: filter/has require component presence; data always matches if present
fn ecs_wqd_matches_component(q: EcsWqDeep, has_component: bool) -> bool {
    if q.kind == ECS_WQD_FILTER {
        return has_component;
    };
    if q.kind == ECS_WQD_HAS {
        // Has always matches archetype; present is item data
        return true;
    };
    return has_component;
}

// combine two WorldQuery denseness (AND)
fn ecs_wqd_combine_dense(a: EcsWqDeep, b: EcsWqDeep) -> bool {
    if a.is_dense {
        if b.is_dense { return true; };
    };
    return false;
}
