// Deepened Bevy ECS EntityRef surface.
// Mirrors src/world/entity_access/entity_ref.rs:
//   id / location / archetype / spawned_by / spawn_tick
//   contains / contains_id / contains_type_id
//   get / get_ref / get_by_id / get_change_ticks / get_change_ticks_by_id / get_changed_by
//   components / get_components (all-present check)
//   into_filtered (write_all FilteredEntityRef marker)
//   PartialEq / Ord by entity id
// Fixed capacity: 4 component slots. Shallow lib/entity_ref_extras.sla retained.

struct EcsErDeep {
    entity: i64,
    archetype_id: i64,
    location_row: i64,
    spawned_by: i64,
    spawn_tick: i64,
    c0: i32, t0: i32, v0: i64, add0: i64, ch0: i64, by0: i64,
    c1: i32, t1: i32, v1: i64, add1: i64, ch1: i64, by1: i64,
    c2: i32, t2: i32, v2: i64, add2: i64, ch2: i64, by2: i64,
    c3: i32, t3: i32, v3: i64, add3: i64, ch3: i64, by3: i64,
    len: i32,
    filtered: bool,
}

fn ecs_er_deep_new(entity: i64) -> EcsErDeep {
    return EcsErDeep {
        entity: entity, archetype_id: 0, location_row: 0, spawned_by: 0, spawn_tick: 0,
        c0: -1, t0: -1, v0: 0, add0: 0, ch0: 0, by0: 0,
        c1: -1, t1: -1, v1: 0, add1: 0, ch1: 0, by1: 0,
        c2: -1, t2: -1, v2: 0, add2: 0, ch2: 0, by2: 0,
        c3: -1, t3: -1, v3: 0, add3: 0, ch3: 0, by3: 0,
        len: 0, filtered: false,
    };
}

fn ecs_er_deep_id(r: EcsErDeep) -> i64 { return r.entity; }
fn ecs_er_deep_archetype(r: EcsErDeep) -> i64 { return r.archetype_id; }
fn ecs_er_deep_location_row(r: EcsErDeep) -> i64 { return r.location_row; }
fn ecs_er_deep_spawned_by(r: EcsErDeep) -> i64 { return r.spawned_by; }
fn ecs_er_deep_spawn_tick(r: EcsErDeep) -> i64 { return r.spawn_tick; }
fn ecs_er_deep_len(r: EcsErDeep) -> i32 { return r.len; }
fn ecs_er_deep_is_filtered(r: EcsErDeep) -> bool { return r.filtered; }

fn ecs_er_deep_rebuild(
    entity: i64, archetype_id: i64, location_row: i64, spawned_by: i64, spawn_tick: i64,
    c0: i32, t0: i32, v0: i64, add0: i64, ch0: i64, by0: i64,
    c1: i32, t1: i32, v1: i64, add1: i64, ch1: i64, by1: i64,
    c2: i32, t2: i32, v2: i64, add2: i64, ch2: i64, by2: i64,
    c3: i32, t3: i32, v3: i64, add3: i64, ch3: i64, by3: i64,
    len: i32, filtered: bool
) -> EcsErDeep {
    return EcsErDeep {
        entity: entity, archetype_id: archetype_id, location_row: location_row,
        spawned_by: spawned_by, spawn_tick: spawn_tick,
        c0: c0, t0: t0, v0: v0, add0: add0, ch0: ch0, by0: by0,
        c1: c1, t1: t1, v1: v1, add1: add1, ch1: ch1, by1: by1,
        c2: c2, t2: t2, v2: v2, add2: add2, ch2: ch2, by2: by2,
        c3: c3, t3: t3, v3: v3, add3: add3, ch3: ch3, by3: by3,
        len: len, filtered: filtered,
    };
}

fn ecs_er_deep_with_meta(r: EcsErDeep, archetype_id: i64, location_row: i64, spawned_by: i64, spawn_tick: i64) -> EcsErDeep {
    return ecs_er_deep_rebuild(
        r.entity, archetype_id, location_row, spawned_by, spawn_tick,
        r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
        r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
        r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
        r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3,
        r.len, r.filtered
    );
}

fn ecs_er_deep_insert(r: EcsErDeep, cid: i32, type_id: i32, value: i64, add_tick: i64, ch_tick: i64, changed_by: i64) -> EcsErDeep {
    if r.len >= 1 {
        if r.c0 == cid {
            return ecs_er_deep_rebuild(
                r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
                r.c0, type_id, value, add_tick, ch_tick, changed_by,
                r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
                r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
                r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3, r.len, r.filtered
            );
        };
    };
    if r.len >= 2 {
        if r.c1 == cid {
            return ecs_er_deep_rebuild(
                r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
                r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
                r.c1, type_id, value, add_tick, ch_tick, changed_by,
                r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
                r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3, r.len, r.filtered
            );
        };
    };
    if r.len >= 3 {
        if r.c2 == cid {
            return ecs_er_deep_rebuild(
                r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
                r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
                r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
                r.c2, type_id, value, add_tick, ch_tick, changed_by,
                r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3, r.len, r.filtered
            );
        };
    };
    if r.len >= 4 {
        if r.c3 == cid {
            return ecs_er_deep_rebuild(
                r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
                r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
                r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
                r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
                r.c3, type_id, value, add_tick, ch_tick, changed_by, r.len, r.filtered
            );
        };
    };
    if r.len == 0 {
        return ecs_er_deep_rebuild(
            r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
            cid, type_id, value, add_tick, ch_tick, changed_by,
            r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
            r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
            r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3, 1, r.filtered
        );
    };
    if r.len == 1 {
        return ecs_er_deep_rebuild(
            r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
            r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
            cid, type_id, value, add_tick, ch_tick, changed_by,
            r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
            r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3, 2, r.filtered
        );
    };
    if r.len == 2 {
        return ecs_er_deep_rebuild(
            r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
            r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
            r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
            cid, type_id, value, add_tick, ch_tick, changed_by,
            r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3, 3, r.filtered
        );
    };
    if r.len == 3 {
        return ecs_er_deep_rebuild(
            r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
            r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
            r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
            r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
            cid, type_id, value, add_tick, ch_tick, changed_by, 4, r.filtered
        );
    };
    return r;
}

struct EcsErGet {
    found: bool,
    value: i64,
    added: i64,
    changed: i64,
    changed_by: i64,
}

fn ecs_er_get_found(g: EcsErGet) -> bool { return g.found; }
fn ecs_er_get_value(g: EcsErGet) -> i64 { return g.value; }
fn ecs_er_get_added(g: EcsErGet) -> i64 { return g.added; }
fn ecs_er_get_changed(g: EcsErGet) -> i64 { return g.changed; }
fn ecs_er_get_changed_by(g: EcsErGet) -> i64 { return g.changed_by; }

fn ecs_er_deep_raw_get(r: EcsErDeep, cid: i32) -> EcsErGet {
    if r.len >= 1 {
        if r.c0 == cid {
            return EcsErGet { found: true, value: r.v0, added: r.add0, changed: r.ch0, changed_by: r.by0 };
        };
    };
    if r.len >= 2 {
        if r.c1 == cid {
            return EcsErGet { found: true, value: r.v1, added: r.add1, changed: r.ch1, changed_by: r.by1 };
        };
    };
    if r.len >= 3 {
        if r.c2 == cid {
            return EcsErGet { found: true, value: r.v2, added: r.add2, changed: r.ch2, changed_by: r.by2 };
        };
    };
    if r.len >= 4 {
        if r.c3 == cid {
            return EcsErGet { found: true, value: r.v3, added: r.add3, changed: r.ch3, changed_by: r.by3 };
        };
    };
    return EcsErGet { found: false, value: 0, added: 0, changed: 0, changed_by: 0 };
}

fn ecs_er_deep_contains(r: EcsErDeep, cid: i32) -> bool {
    let g = ecs_er_deep_raw_get(r, cid);
    return ecs_er_get_found(g);
}
fn ecs_er_deep_contains_id(r: EcsErDeep, cid: i32) -> bool { return ecs_er_deep_contains(r, cid); }

fn ecs_er_deep_contains_type_id(r: EcsErDeep, type_id: i32) -> bool {
    if r.len >= 1 {
        if r.t0 == type_id { return true; };
    };
    if r.len >= 2 {
        if r.t1 == type_id { return true; };
    };
    if r.len >= 3 {
        if r.t2 == type_id { return true; };
    };
    if r.len >= 4 {
        if r.t3 == type_id { return true; };
    };
    return false;
}

fn ecs_er_deep_get(r: EcsErDeep, cid: i32) -> EcsErGet { return ecs_er_deep_raw_get(r, cid); }
fn ecs_er_deep_get_ref(r: EcsErDeep, cid: i32) -> EcsErGet { return ecs_er_deep_raw_get(r, cid); }
fn ecs_er_deep_get_by_id(r: EcsErDeep, cid: i32) -> EcsErGet { return ecs_er_deep_raw_get(r, cid); }
fn ecs_er_deep_get_change_ticks(r: EcsErDeep, cid: i32) -> EcsErGet { return ecs_er_deep_raw_get(r, cid); }
fn ecs_er_deep_get_change_ticks_by_id(r: EcsErDeep, cid: i32) -> EcsErGet { return ecs_er_deep_raw_get(r, cid); }
fn ecs_er_deep_get_changed_by(r: EcsErDeep, cid: i32) -> EcsErGet { return ecs_er_deep_raw_get(r, cid); }

// components count among requested ids (up to 4 requested)
fn ecs_er_deep_components_count4(r: EcsErDeep, r0: i32, r1: i32, r2: i32, r3: i32, n: i32) -> i32 {
    let count = 0;
    if n >= 1 {
        if ecs_er_deep_contains(r, r0) { count = count + 1; };
    };
    if n >= 2 {
        if ecs_er_deep_contains(r, r1) { count = count + 1; };
    };
    if n >= 3 {
        if ecs_er_deep_contains(r, r2) { count = count + 1; };
    };
    if n >= 4 {
        if ecs_er_deep_contains(r, r3) { count = count + 1; };
    };
    return count;
}

// get_components: true only if ALL requested present
fn ecs_er_deep_get_components_all4(r: EcsErDeep, r0: i32, r1: i32, r2: i32, r3: i32, n: i32) -> bool {
    if n <= 0 { return true; };
    let count = ecs_er_deep_components_count4(r, r0, r1, r2, r3, n);
    if count == n { return true; };
    return false;
}

fn ecs_er_deep_into_filtered(r: EcsErDeep) -> EcsErDeep {
    return ecs_er_deep_rebuild(
        r.entity, r.archetype_id, r.location_row, r.spawned_by, r.spawn_tick,
        r.c0, r.t0, r.v0, r.add0, r.ch0, r.by0,
        r.c1, r.t1, r.v1, r.add1, r.ch1, r.by1,
        r.c2, r.t2, r.v2, r.add2, r.ch2, r.by2,
        r.c3, r.t3, r.v3, r.add3, r.ch3, r.by3,
        r.len, true
    );
}

fn ecs_er_deep_component_at(r: EcsErDeep, idx: i32) -> i32 {
    if idx == 0 { return r.c0; };
    if idx == 1 { return r.c1; };
    if idx == 2 { return r.c2; };
    if idx == 3 { return r.c3; };
    return -1;
}

fn ecs_er_deep_eq(a: EcsErDeep, b: EcsErDeep) -> bool {
    if a.entity == b.entity { return true; };
    return false;
}

fn ecs_er_deep_cmp(a: EcsErDeep, b: EcsErDeep) -> i32 {
    if a.entity < b.entity { return -1; };
    if a.entity > b.entity { return 1; };
    return 0;
}
