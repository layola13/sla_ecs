// Deepened Bevy ECS registry-erased schedule (lib/schedule_registry_erased.sla deep).
// Records cap-8 systems. Each system's access mask stores up to cap-4 read component-ids
// and cap-4 write component-ids plus resource/messages flags. Conflict detection compares
// write-component sets against read/write sets of the other system, then resource/messages
// write/read/write/write hazard matrix.
// Intentional leave-outs: no system fn-ptr execution (harness analogue).

const ECS_REG_ERASED_CAP_DEEP: i32 = 8;
const ECS_REG_ERASED_LIST_CAP_DEEP: i32 = 4;

struct EcsRegErasedSystemAccessDeep {
    r0: i32, r1: i32, r2: i32, r3: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    reads_resource: i32,
    writes_resource: i32,
    reads_messages: i32,
    writes_messages: i32,
    len_reads: i32,
    len_writes: i32,
}

fn ecs_reg_erased_access_none() -> EcsRegErasedSystemAccessDeep {
    return EcsRegErasedSystemAccessDeep {
        r0: 0, r1: 0, r2: 0, r3: 0,
        w0: 0, w1: 0, w2: 0, w3: 0,
        reads_resource: 0, writes_resource: 0,
        reads_messages: 0, writes_messages: 0,
        len_reads: 0, len_writes: 0,
    };
}

fn ecs_reg_erased_access_build(
    r0: i32, r1: i32, r2: i32, r3: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    reads_resource: i32, writes_resource: i32,
    reads_messages: i32, writes_messages: i32,
    len_reads: i32, len_writes: i32
) -> EcsRegErasedSystemAccessDeep {
    return EcsRegErasedSystemAccessDeep {
        r0: r0, r1: r1, r2: r2, r3: r3,
        w0: w0, w1: w1, w2: w2, w3: w3,
        reads_resource: reads_resource, writes_resource: writes_resource,
        reads_messages: reads_messages, writes_messages: writes_messages,
        len_reads: len_reads, len_writes: len_writes,
    };
}

// access mutation: append a read component_id into the reads list of an access.
fn ecs_reg_erased_access_read_component(a: EcsRegErasedSystemAccessDeep, cid: i32) -> EcsRegErasedSystemAccessDeep {
    if a.len_reads >= ECS_REG_ERASED_LIST_CAP_DEEP { return a; };
    let idx = a.len_reads;
    if idx == 0 { a.r0 = cid; };
    if idx == 1 { a.r1 = cid; };
    if idx == 2 { a.r2 = cid; };
    if idx == 3 { a.r3 = cid; };
    a.len_reads = a.len_reads + 1;
    return a;
}

fn ecs_reg_erased_access_write_component(a: EcsRegErasedSystemAccessDeep, cid: i32) -> EcsRegErasedSystemAccessDeep {
    if a.len_writes >= ECS_REG_ERASED_LIST_CAP_DEEP { return a; };
    let idx = a.len_writes;
    if idx == 0 { a.w0 = cid; };
    if idx == 1 { a.w1 = cid; };
    if idx == 2 { a.w2 = cid; };
    if idx == 3 { a.w3 = cid; };
    a.len_writes = a.len_writes + 1;
    return a;
}

fn ecs_reg_erased_access_read_resource(a: EcsRegErasedSystemAccessDeep) -> EcsRegErasedSystemAccessDeep {
    a.reads_resource = 1;
    return a;
}

fn ecs_reg_erased_access_write_resource(a: EcsRegErasedSystemAccessDeep) -> EcsRegErasedSystemAccessDeep {
    a.writes_resource = 1;
    return a;
}

fn ecs_reg_erased_access_read_messages(a: EcsRegErasedSystemAccessDeep) -> EcsRegErasedSystemAccessDeep {
    a.reads_messages = 1;
    return a;
}

fn ecs_reg_erased_access_write_messages(a: EcsRegErasedSystemAccessDeep) -> EcsRegErasedSystemAccessDeep {
    a.writes_messages = 1;
    return a;
}

fn ecs_reg_erased_read_at(a: EcsRegErasedSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.r0; };
    if idx == 1 { return a.r1; };
    if idx == 2 { return a.r2; };
    if idx == 3 { return a.r3; };
    return 0;
}

fn ecs_reg_erased_write_at(a: EcsRegErasedSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.w0; };
    if idx == 1 { return a.w1; };
    if idx == 2 { return a.w2; };
    if idx == 3 { return a.w3; };
    return 0;
}

fn ecs_reg_erased_len_reads(a: EcsRegErasedSystemAccessDeep) -> i32 { return a.len_reads; }
fn ecs_reg_erased_len_writes(a: EcsRegErasedSystemAccessDeep) -> i32 { return a.len_writes; }
fn ecs_reg_erased_reads_resource(a: EcsRegErasedSystemAccessDeep) -> i32 { return a.reads_resource; }
fn ecs_reg_erased_writes_resource(a: EcsRegErasedSystemAccessDeep) -> i32 { return a.writes_resource; }
fn ecs_reg_erased_reads_messages(a: EcsRegErasedSystemAccessDeep) -> i32 { return a.reads_messages; }
fn ecs_reg_erased_writes_messages(a: EcsRegErasedSystemAccessDeep) -> i32 { return a.writes_messages; }

fn ecs_reg_erased_read_list_has(a: EcsRegErasedSystemAccessDeep, cid: i32) -> bool {
    let i: i32 = 0;
    while i < a.len_reads {
        if ecs_reg_erased_read_at(a, i) == cid { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_reg_erased_write_list_has(a: EcsRegErasedSystemAccessDeep, cid: i32) -> bool {
    let i: i32 = 0;
    while i < a.len_writes {
        if ecs_reg_erased_write_at(a, i) == cid { return true; };
        i = i + 1;
    }
    return false;
}

// Component-conflicts: any write on one system overlaps read/write on the other.
fn ecs_reg_erased_component_conflicts(left: EcsRegErasedSystemAccessDeep, right: EcsRegErasedSystemAccessDeep) -> bool {
    let i: i32 = 0;
    while i < left.len_writes {
        let cid = ecs_reg_erased_write_at(left, i);
        if ecs_reg_erased_read_list_has(right, cid) { return true; };
        if ecs_reg_erased_write_list_has(right, cid) { return true; };
        i = i + 1;
    }
    let j: i32 = 0;
    while j < right.len_writes {
        let cid = ecs_reg_erased_write_at(right, j);
        if ecs_reg_erased_read_list_has(left, cid) { return true; };
        if ecs_reg_erased_write_list_has(left, cid) { return true; };
        j = j + 1;
    }
    return false;
}

fn ecs_reg_erased_access_conflicts(left: EcsRegErasedSystemAccessDeep, right: EcsRegErasedSystemAccessDeep) -> bool {
    if ecs_reg_erased_component_conflicts(left, right) { return true; };
    if left.writes_resource != 0 {
        if right.reads_resource != 0 { return true; };
        if right.writes_resource != 0 { return true; };
    };
    if right.writes_resource != 0 {
        if left.reads_resource != 0 { return true; };
    };
    if left.writes_messages != 0 {
        if right.reads_messages != 0 { return true; };
        if right.writes_messages != 0 { return true; };
    };
    if right.writes_messages != 0 {
        if left.reads_messages != 0 { return true; };
    };
    return false;
}

// === Schedule with 8 slots ===

struct EcsRegErasedScheduleDeep {
    s0: EcsRegErasedSystemAccessDeep, s1: EcsRegErasedSystemAccessDeep,
    s2: EcsRegErasedSystemAccessDeep, s3: EcsRegErasedSystemAccessDeep,
    s4: EcsRegErasedSystemAccessDeep, s5: EcsRegErasedSystemAccessDeep,
    s6: EcsRegErasedSystemAccessDeep, s7: EcsRegErasedSystemAccessDeep,
    count: i32,
    conflict_count: i32,
}

fn ecs_reg_erased_schedule_default() -> EcsRegErasedScheduleDeep {
    let blank = ecs_reg_erased_access_none();
    let s = EcsRegErasedScheduleDeep {
        s0: blank,
        s1: ecs_reg_erased_access_none(),
        s2: ecs_reg_erased_access_none(),
        s3: ecs_reg_erased_access_none(),
        s4: ecs_reg_erased_access_none(),
        s5: ecs_reg_erased_access_none(),
        s6: ecs_reg_erased_access_none(),
        s7: ecs_reg_erased_access_none(),
        count: 0,
        conflict_count: 0,
    };
    return s;
}

fn ecs_reg_erased_schedule_len(s: EcsRegErasedScheduleDeep) -> i32 { return s.count; }
fn ecs_reg_erased_schedule_conflict_count(s: EcsRegErasedScheduleDeep) -> i32 { return s.conflict_count; }

// Per-slot access store uses scalar capture (UseAfterMove safety).
fn ecs_reg_erased_access_set_a(s: EcsRegErasedScheduleDeep, idx: i32, a: EcsRegErasedSystemAccessDeep) -> EcsRegErasedScheduleDeep {
    let r0 = ecs_reg_erased_read_at(a, 0);
    let r1 = ecs_reg_erased_read_at(a, 1);
    let r2 = ecs_reg_erased_read_at(a, 2);
    let r3 = ecs_reg_erased_read_at(a, 3);
    let w0 = ecs_reg_erased_write_at(a, 0);
    let w1 = ecs_reg_erased_write_at(a, 1);
    let w2 = ecs_reg_erased_write_at(a, 2);
    let w3 = ecs_reg_erased_write_at(a, 3);
    let rr = ecs_reg_erased_reads_resource(a);
    let wr = ecs_reg_erased_writes_resource(a);
    let rm = ecs_reg_erased_reads_messages(a);
    let wm = ecs_reg_erased_writes_messages(a);
    let lr = ecs_reg_erased_len_reads(a);
    let lw = ecs_reg_erased_len_writes(a);
    if idx == 0 { s.s0 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 1 { s.s1 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 2 { s.s2 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 3 { s.s3 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 4 { s.s4 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 5 { s.s5 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 6 { s.s6 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 7 { s.s7 = ecs_reg_erased_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    return s;
}

fn ecs_reg_erased_access_at(s: EcsRegErasedScheduleDeep, idx: i32) -> EcsRegErasedSystemAccessDeep {
    if idx == 0 { return s.s0; };
    if idx == 1 { return s.s1; };
    if idx == 2 { return s.s2; };
    if idx == 3 { return s.s3; };
    if idx == 4 { return s.s4; };
    if idx == 5 { return s.s5; };
    if idx == 6 { return s.s6; };
    if idx == 7 { return s.s7; };
    return ecs_reg_erased_access_none();
}

fn ecs_reg_erased_schedule_add_systems(s: EcsRegErasedScheduleDeep, access: EcsRegErasedSystemAccessDeep) -> EcsRegErasedScheduleDeep {
    if s.count >= ECS_REG_ERASED_CAP_DEEP { return s; };
    // Tally conflicts against all current systems.
    let i: i32 = 0;
    while i < s.count {
        let other = ecs_reg_erased_access_at(s, i);
        if ecs_reg_erased_access_conflicts(access, other) { s.conflict_count = s.conflict_count + 1; };
        i = i + 1;
    }
    let slot = s.count;
    s = ecs_reg_erased_access_set_a(s, slot, access);
    s.count = s.count + 1;
    return s;
}

fn ecs_reg_erased_schedule_clear(s: EcsRegErasedScheduleDeep) -> EcsRegErasedScheduleDeep {
    return ecs_reg_erased_schedule_default();
}
