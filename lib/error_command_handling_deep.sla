// Deepened Bevy ECS command error handling surface.
// Mirrors src/error/command_handling.rs:
//   CommandOutput::{to_err} for Result / Never / ()
//   EntityCommandOutput::{into_result} for () / Result
//   EntityCommandError::{CommandFailed, from EntityMutableFetchError}
// Fixed simple codes; integrates with ErrorContext command kind.
// Shallow lib/error_command_handling.sla retained.

const ECS_ECH_OK: i32 = 0;
const ECS_ECH_ERR: i32 = 1;

// CommandOutput kinds
const ECS_ECH_OUT_UNIT: i32 = 0;
const ECS_ECH_OUT_NEVER: i32 = 1;
const ECS_ECH_OUT_RESULT_OK: i32 = 2;
const ECS_ECH_OUT_RESULT_ERR: i32 = 3;

// EntityCommandError kinds
const ECS_ECH_ENT_OK: i32 = 0;
const ECS_ECH_ENT_COMMAND_FAILED: i32 = 1;
const ECS_ECH_ENT_NOT_SPAWNED: i32 = 2;
const ECS_ECH_ENT_ALIASED_MUT: i32 = 3;

struct EcsEchCommandOutputDeep {
    kind: i32,
    // for Result Err: error code/message id
    error_code: i32,
    message_id: i64,
}

fn ecs_ech_cmd_out_unit() -> EcsEchCommandOutputDeep {
    return EcsEchCommandOutputDeep { kind: ECS_ECH_OUT_UNIT, error_code: 0, message_id: 0 };
}

fn ecs_ech_cmd_out_never() -> EcsEchCommandOutputDeep {
    return EcsEchCommandOutputDeep { kind: ECS_ECH_OUT_NEVER, error_code: 0, message_id: 0 };
}

fn ecs_ech_cmd_out_result_ok() -> EcsEchCommandOutputDeep {
    return EcsEchCommandOutputDeep { kind: ECS_ECH_OUT_RESULT_OK, error_code: 0, message_id: 0 };
}

fn ecs_ech_cmd_out_result_err(error_code: i32, message_id: i64) -> EcsEchCommandOutputDeep {
    return EcsEchCommandOutputDeep {
        kind: ECS_ECH_OUT_RESULT_ERR, error_code: error_code, message_id: message_id,
    };
}

fn ecs_ech_cmd_out_kind(o: EcsEchCommandOutputDeep) -> i32 { return o.kind; }
fn ecs_ech_cmd_out_error_code(o: EcsEchCommandOutputDeep) -> i32 { return o.error_code; }
fn ecs_ech_cmd_out_message_id(o: EcsEchCommandOutputDeep) -> i64 { return o.message_id; }

// CommandOutput::to_err -> Option<BevyError> modeled as (has_err, code, message)
struct EcsEchToErrDeep {
    has_err: bool,
    error_code: i32,
    message_id: i64,
}

fn ecs_ech_to_err_has(r: EcsEchToErrDeep) -> bool { return r.has_err; }
fn ecs_ech_to_err_code(r: EcsEchToErrDeep) -> i32 { return r.error_code; }
fn ecs_ech_to_err_message(r: EcsEchToErrDeep) -> i64 { return r.message_id; }

fn ecs_ech_cmd_out_to_err(o: EcsEchCommandOutputDeep) -> EcsEchToErrDeep {
    if o.kind == ECS_ECH_OUT_RESULT_ERR {
        return EcsEchToErrDeep {
            has_err: true, error_code: o.error_code, message_id: o.message_id,
        };
    };
    // unit, never, result ok -> None
    return EcsEchToErrDeep { has_err: false, error_code: 0, message_id: 0 };
}

// EntityCommandOutput
struct EcsEchEntityOutDeep {
    // 0=unit success, 1=result ok with value, 2=result err, 3=from fetch error
    kind: i32,
    value: i64,
    error_kind: i32, // ECS_ECH_ENT_*
    error_code: i32,
}

fn ecs_ech_ent_out_unit() -> EcsEchEntityOutDeep {
    return EcsEchEntityOutDeep { kind: 0, value: 0, error_kind: ECS_ECH_ENT_OK, error_code: 0 };
}

fn ecs_ech_ent_out_result_ok(value: i64) -> EcsEchEntityOutDeep {
    return EcsEchEntityOutDeep {
        kind: 1, value: value, error_kind: ECS_ECH_ENT_OK, error_code: 0,
    };
}

fn ecs_ech_ent_out_result_err(error_code: i32) -> EcsEchEntityOutDeep {
    return EcsEchEntityOutDeep {
        kind: 2, value: 0, error_kind: ECS_ECH_ENT_COMMAND_FAILED, error_code: error_code,
    };
}

fn ecs_ech_ent_out_from_fetch_not_spawned() -> EcsEchEntityOutDeep {
    return EcsEchEntityOutDeep {
        kind: 3, value: 0, error_kind: ECS_ECH_ENT_NOT_SPAWNED, error_code: 0,
    };
}

fn ecs_ech_ent_out_from_fetch_aliased() -> EcsEchEntityOutDeep {
    return EcsEchEntityOutDeep {
        kind: 3, value: 0, error_kind: ECS_ECH_ENT_ALIASED_MUT, error_code: 0,
    };
}

fn ecs_ech_ent_out_kind(o: EcsEchEntityOutDeep) -> i32 { return o.kind; }
fn ecs_ech_ent_out_value(o: EcsEchEntityOutDeep) -> i64 { return o.value; }
fn ecs_ech_ent_out_error_kind(o: EcsEchEntityOutDeep) -> i32 { return o.error_kind; }
fn ecs_ech_ent_out_error_code(o: EcsEchEntityOutDeep) -> i32 { return o.error_code; }

// into_result
struct EcsEchIntoResultDeep {
    ok: bool,
    value: i64,
    error_kind: i32,
    error_code: i32,
}

fn ecs_ech_into_ok(r: EcsEchIntoResultDeep) -> bool { return r.ok; }
fn ecs_ech_into_value(r: EcsEchIntoResultDeep) -> i64 { return r.value; }
fn ecs_ech_into_error_kind(r: EcsEchIntoResultDeep) -> i32 { return r.error_kind; }
fn ecs_ech_into_error_code(r: EcsEchIntoResultDeep) -> i32 { return r.error_code; }

fn ecs_ech_ent_out_into_result(o: EcsEchEntityOutDeep) -> EcsEchIntoResultDeep {
    if o.kind == 0 {
        return EcsEchIntoResultDeep {
            ok: true, value: 0, error_kind: ECS_ECH_ENT_OK, error_code: 0,
        };
    };
    if o.kind == 1 {
        return EcsEchIntoResultDeep {
            ok: true, value: o.value, error_kind: ECS_ECH_ENT_OK, error_code: 0,
        };
    };
    // result err or fetch error
    return EcsEchIntoResultDeep {
        ok: false, value: 0, error_kind: o.error_kind, error_code: o.error_code,
    };
}

// Convert EntityCommandError into BevyError (CommandOutput path)
fn ecs_ech_entity_error_to_cmd_out(r: EcsEchIntoResultDeep) -> EcsEchCommandOutputDeep {
    if r.ok {
        return ecs_ech_cmd_out_result_ok();
    };
    // map error_kind into message id
    let mid = r.error_kind as i64;
    return ecs_ech_cmd_out_result_err(r.error_code, mid);
}

// Handler apply: if to_err Some, invoke handler; count handled
struct EcsEchHandlerDeep {
    handler_id: i32,
    handled_count: i64,
    last_error_code: i32,
    last_message_id: i64,
    last_ctx_name: i64,
}

fn ecs_ech_handler_new(handler_id: i32) -> EcsEchHandlerDeep {
    return EcsEchHandlerDeep {
        handler_id: handler_id, handled_count: 0, last_error_code: 0,
        last_message_id: 0, last_ctx_name: 0,
    };
}

fn ecs_ech_handler_id(h: EcsEchHandlerDeep) -> i32 { return h.handler_id; }
fn ecs_ech_handler_count(h: EcsEchHandlerDeep) -> i64 { return h.handled_count; }
fn ecs_ech_handler_last_code(h: EcsEchHandlerDeep) -> i32 { return h.last_error_code; }
fn ecs_ech_handler_last_message(h: EcsEchHandlerDeep) -> i64 { return h.last_message_id; }
fn ecs_ech_handler_last_ctx(h: EcsEchHandlerDeep) -> i64 { return h.last_ctx_name; }

struct EcsEchHandleResultDeep {
    handler: EcsEchHandlerDeep,
    had_error: bool,
}

fn ecs_ech_handle_handler(r: EcsEchHandleResultDeep) -> EcsEchHandlerDeep { return r.handler; }
fn ecs_ech_handle_had_error(r: EcsEchHandleResultDeep) -> bool { return r.had_error; }

fn ecs_ech_handler_apply(
    h: EcsEchHandlerDeep, out: EcsEchCommandOutputDeep, ctx_name: i64
) -> EcsEchHandleResultDeep {
    let te = ecs_ech_cmd_out_to_err(out);
    if te.has_err != true {
        return EcsEchHandleResultDeep { handler: h, had_error: false };
    };
    let h2 = EcsEchHandlerDeep {
        handler_id: h.handler_id,
        handled_count: h.handled_count + 1,
        last_error_code: te.error_code,
        last_message_id: te.message_id,
        last_ctx_name: ctx_name,
    };
    return EcsEchHandleResultDeep { handler: h2, had_error: true };
}

// queue_handled vs queue_silenced markers
const ECS_ECH_QUEUE_HANDLED: i32 = 0;
const ECS_ECH_QUEUE_SILENCED: i32 = 1;

struct EcsEchQueueDeep {
    mode: i32,
    out: EcsEchCommandOutputDeep,
    applied: bool,
}

fn ecs_ech_queue_handled(out: EcsEchCommandOutputDeep) -> EcsEchQueueDeep {
    return EcsEchQueueDeep { mode: ECS_ECH_QUEUE_HANDLED, out: out, applied: false };
}

fn ecs_ech_queue_silenced(out: EcsEchCommandOutputDeep) -> EcsEchQueueDeep {
    return EcsEchQueueDeep { mode: ECS_ECH_QUEUE_SILENCED, out: out, applied: false };
}

fn ecs_ech_queue_mode(q: EcsEchQueueDeep) -> i32 { return q.mode; }
fn ecs_ech_queue_applied(q: EcsEchQueueDeep) -> bool { return q.applied; }

struct EcsEchApplyQueueDeep {
    queue: EcsEchQueueDeep,
    handler: EcsEchHandlerDeep,
    surfaced_error: bool,
}

fn ecs_ech_apply_queue_q(r: EcsEchApplyQueueDeep) -> EcsEchQueueDeep { return r.queue; }
fn ecs_ech_apply_queue_h(r: EcsEchApplyQueueDeep) -> EcsEchHandlerDeep { return r.handler; }
fn ecs_ech_apply_queue_surfaced(r: EcsEchApplyQueueDeep) -> bool { return r.surfaced_error; }

fn ecs_ech_queue_apply(
    q: EcsEchQueueDeep, h: EcsEchHandlerDeep, ctx_name: i64
) -> EcsEchApplyQueueDeep {
    let te = ecs_ech_cmd_out_to_err(q.out);
    if te.has_err != true {
        let q2 = EcsEchQueueDeep { mode: q.mode, out: q.out, applied: true };
        return EcsEchApplyQueueDeep { queue: q2, handler: h, surfaced_error: false };
    };
    if q.mode == ECS_ECH_QUEUE_SILENCED {
        // completely ignore errors
        let q2 = EcsEchQueueDeep { mode: q.mode, out: q.out, applied: true };
        return EcsEchApplyQueueDeep { queue: q2, handler: h, surfaced_error: false };
    };
    // handled: invoke handler
    let hr = ecs_ech_handler_apply(h, q.out, ctx_name);
    let q2 = EcsEchQueueDeep { mode: q.mode, out: q.out, applied: true };
    return EcsEchApplyQueueDeep {
        queue: q2, handler: hr.handler, surfaced_error: true,
    };
}
