    return EcsAtrTypeRegistry {
        count: 0,
        t0_id: 0, t0_path: 0, t0_short: 0, t0_has_comp: 0, t0_comp_data: 0, t0_has_res: 0, t0_res_data: 0, t0_has_evt: 0, t0_evt_data: 0, t0_has_msg: 0, t0_msg_data: 0, t0_has_bun: 0, t0_bun_data: 0, t0_has_fw: 0, t0_fw_data: 0, t0_has_me: 0, t0_me_data: 0,
