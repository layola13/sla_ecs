// Deep module for lib/app_type_registry.sla (Batch 400).
// Self-contained fixed-cap type/function descriptor registries mirroring AppTypeRegistry/AppFunctionRegistry.
// Vec-backed registries are flattened to cap-8 scalar slot families; result wrapper structs preserved.

const ECS_ATR_CAP: i32 = 8;

const ECS_ATR_DATA_COMPONENT: i32 = 1;
const ECS_ATR_DATA_RESOURCE: i32 = 2;
const ECS_ATR_DATA_EVENT: i32 = 3;
const ECS_ATR_DATA_MESSAGE: i32 = 4;
const ECS_ATR_DATA_BUNDLE: i32 = 5;
const ECS_ATR_DATA_FROM_WORLD: i32 = 6;
const ECS_ATR_DATA_MAP_ENTITIES: i32 = 7;

@derive(copy)
struct EcsAtrTypeDescriptor {
    type_id: i64,
    type_path: i64,
    short_type_path: i64,
    has_component: i32, component_data: i64,
    has_resource: i32, resource_data: i64,
    has_event: i32, event_data: i64,
    has_message: i32, message_data: i64,
    has_bundle: i32, bundle_data: i64,
    has_from_world: i32, from_world_data: i64,
    has_map_entities: i32, map_entities_data: i64,
}

@derive(copy)
struct EcsAtrTypeDescriptorResult {
    has: i32,
    descriptor: EcsAtrTypeDescriptor,
}

@derive(copy)
struct EcsAtrTypeDataResult {
    has: i32,
    data: i64,
}

fn ecs_atr_descriptor_new(type_id: i64, type_path: i64, short_type_path: i64) -> EcsAtrTypeDescriptor {
    return EcsAtrTypeDescriptor {
        type_id: type_id, type_path: type_path, short_type_path: short_type_path,
        has_component: 0, component_data: 0,
        has_resource: 0, resource_data: 0,
        has_event: 0, event_data: 0,
        has_message: 0, message_data: 0,
        has_bundle: 0, bundle_data: 0,
        has_from_world: 0, from_world_data: 0,
        has_map_entities: 0, map_entities_data: 0,
    };
}

fn ecs_atr_descriptor_type_id(d: EcsAtrTypeDescriptor) -> i64 { return d.type_id; }
fn ecs_atr_descriptor_type_path(d: EcsAtrTypeDescriptor) -> i64 { return d.type_path; }
fn ecs_atr_descriptor_short_type_path(d: EcsAtrTypeDescriptor) -> i64 { return d.short_type_path; }

fn ecs_atr_descriptor_with_type_data(d: EcsAtrTypeDescriptor, kind: i32, data: i64) -> EcsAtrTypeDescriptor {
    if kind == ECS_ATR_DATA_COMPONENT { d.has_component = 1; d.component_data = data; return d; };
    if kind == ECS_ATR_DATA_RESOURCE { d.has_resource = 1; d.resource_data = data; return d; };
    if kind == ECS_ATR_DATA_EVENT { d.has_event = 1; d.event_data = data; return d; };
    if kind == ECS_ATR_DATA_MESSAGE { d.has_message = 1; d.message_data = data; return d; };
    if kind == ECS_ATR_DATA_BUNDLE { d.has_bundle = 1; d.bundle_data = data; return d; };
    if kind == ECS_ATR_DATA_FROM_WORLD { d.has_from_world = 1; d.from_world_data = data; return d; };
    if kind == ECS_ATR_DATA_MAP_ENTITIES { d.has_map_entities = 1; d.map_entities_data = data; return d; };
    return d;
}

fn ecs_atr_descriptor_has_type_data(d: EcsAtrTypeDescriptor, kind: i32) -> bool {
    if kind == ECS_ATR_DATA_COMPONENT { return d.has_component != 0; };
    if kind == ECS_ATR_DATA_RESOURCE { return d.has_resource != 0; };
    if kind == ECS_ATR_DATA_EVENT { return d.has_event != 0; };
    if kind == ECS_ATR_DATA_MESSAGE { return d.has_message != 0; };
    if kind == ECS_ATR_DATA_BUNDLE { return d.has_bundle != 0; };
    if kind == ECS_ATR_DATA_FROM_WORLD { return d.has_from_world != 0; };
    if kind == ECS_ATR_DATA_MAP_ENTITIES { return d.has_map_entities != 0; };
    return false;
}

fn ecs_atr_descriptor_type_data(d: EcsAtrTypeDescriptor, kind: i32) -> EcsAtrTypeDataResult {
    if kind == ECS_ATR_DATA_COMPONENT { return EcsAtrTypeDataResult { has: d.has_component, data: d.component_data }; };
    if kind == ECS_ATR_DATA_RESOURCE { return EcsAtrTypeDataResult { has: d.has_resource, data: d.resource_data }; };
    if kind == ECS_ATR_DATA_EVENT { return EcsAtrTypeDataResult { has: d.has_event, data: d.event_data }; };
    if kind == ECS_ATR_DATA_MESSAGE { return EcsAtrTypeDataResult { has: d.has_message, data: d.message_data }; };
    if kind == ECS_ATR_DATA_BUNDLE { return EcsAtrTypeDataResult { has: d.has_bundle, data: d.bundle_data }; };
    if kind == ECS_ATR_DATA_FROM_WORLD { return EcsAtrTypeDataResult { has: d.has_from_world, data: d.from_world_data }; };
    if kind == ECS_ATR_DATA_MAP_ENTITIES { return EcsAtrTypeDataResult { has: d.has_map_entities, data: d.map_entities_data }; };
    return EcsAtrTypeDataResult { has: 0, data: 0 };
}

fn ecs_atr_descriptor_empty_result() -> EcsAtrTypeDescriptorResult {
    return EcsAtrTypeDescriptorResult { has: 0, descriptor: ecs_atr_descriptor_new(0, 0, 0) };
}

