        t2_id: 0, t2_path: 0, t2_short: 0, t2_has_comp: 0, t2_comp_data: 0, t2_has_res: 0, t2_res_data: 0, t2_has_evt: 0, t2_evt_data: 0, t2_has_msg: 0, t2_msg_data: 0, t2_has_bun: 0, t2_bun_data: 0, t2_has_fw: 0, t2_fw_data: 0, t2_has_me: 0, t2_me_data: 0,
