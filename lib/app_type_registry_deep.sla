}

fn ecs_atr_type_registry_len(r: EcsAtrTypeRegistry) -> i32 { return r.count; }
fn ecs_atr_type_registry_is_empty(r: EcsAtrTypeRegistry) -> bool { return r.count == 0; }



fn ecs_atr_type_registry_find_index(r: EcsAtrTypeRegistry, type_id: i64) -> i32 {
    if r.count > 0 && r.t0_id == type_id { return 0; };
    if r.count > 1 && r.t1_id == type_id { return 1; };
    if r.count > 2 && r.t2_id == type_id { return 2; };
    if r.count > 3 && r.t3_id == type_id { return 3; };
    if r.count > 4 && r.t4_id == type_id { return 4; };
    if r.count > 5 && r.t5_id == type_id { return 5; };
    if r.count > 6 && r.t6_id == type_id { return 6; };
    if r.count > 7 && r.t7_id == type_id { return 7; };
    return -1;
}

fn ecs_atr_type_registry_contains(r: EcsAtrTypeRegistry, type_id: i64) -> bool {
    return ecs_atr_type_registry_find_index(r, type_id) != -1;
}

fn _ecs_atr_slot_to_desc(r: EcsAtrTypeRegistry, idx: i32) -> EcsAtrTypeDescriptor {
    if idx == 0 { return EcsAtrTypeDescriptor { type_id: r.t0_id, type_path: r.t0_path, short_type_path: r.t0_short, has_component: r.t0_has_comp, component_data: r.t0_comp_data, has_resource: r.t0_has_res, resource_data: r.t0_res_data, has_event: r.t0_has_evt, event_data: r.t0_evt_data, has_message: r.t0_has_msg, message_data: r.t0_msg_data, has_bundle: r.t0_has_bun, bundle_data: r.t0_bun_data, has_from_world: r.t0_has_fw, from_world_data: r.t0_fw_data, has_map_entities: r.t0_has_me, map_entities_data: r.t0_me_data }; };
    if idx == 1 { return EcsAtrTypeDescriptor { type_id: r.t1_id, type_path: r.t1_path, short_type_path: r.t1_short, has_component: r.t1_has_comp, component_data: r.t1_comp_data, has_resource: r.t1_has_res, resource_data: r.t1_res_data, has_event: r.t1_has_evt, event_data: r.t1_evt_data, has_message: r.t1_has_msg, message_data: r.t1_msg_data, has_bundle: r.t1_has_bun, bundle_data: r.t1_bun_data, has_from_world: r.t1_has_fw, from_world_data: r.t1_fw_data, has_map_entities: r.t1_has_me, map_entities_data: r.t1_me_data }; };
    if idx == 2 { return EcsAtrTypeDescriptor { type_id: r.t2_id, type_path: r.t2_path, short_type_path: r.t2_short, has_component: r.t2_has_comp, component_data: r.t2_comp_data, has_resource: r.t2_has_res, resource_data: r.t2_res_data, has_event: r.t2_has_evt, event_data: r.t2_evt_data, has_message: r.t2_has_msg, message_data: r.t2_msg_data, has_bundle: r.t2_has_bun, bundle_data: r.t2_bun_data, has_from_world: r.t2_has_fw, from_world_data: r.t2_fw_data, has_map_entities: r.t2_has_me, map_entities_data: r.t2_me_data }; };
    if idx == 3 { return EcsAtrTypeDescriptor { type_id: r.t3_id, type_path: r.t3_path, short_type_path: r.t3_short, has_component: r.t3_has_comp, component_data: r.t3_comp_data, has_resource: r.t3_has_res, resource_data: r.t3_res_data, has_event: r.t3_has_evt, event_data: r.t3_evt_data, has_message: r.t3_has_msg, message_data: r.t3_msg_data, has_bundle: r.t3_has_bun, bundle_data: r.t3_bun_data, has_from_world: r.t3_has_fw, from_world_data: r.t3_fw_data, has_map_entities: r.t3_has_me, map_entities_data: r.t3_me_data }; };
    if idx == 4 { return EcsAtrTypeDescriptor { type_id: r.t4_id, type_path: r.t4_path, short_type_path: r.t4_short, has_component: r.t4_has_comp, component_data: r.t4_comp_data, has_resource: r.t4_has_res, resource_data: r.t4_res_data, has_event: r.t4_has_evt, event_data: r.t4_evt_data, has_message: r.t4_has_msg, message_data: r.t4_msg_data, has_bundle: r.t4_has_bun, bundle_data: r.t4_bun_data, has_from_world: r.t4_has_fw, from_world_data: r.t4_fw_data, has_map_entities: r.t4_has_me, map_entities_data: r.t4_me_data }; };
    if idx == 5 { return EcsAtrTypeDescriptor { type_id: r.t5_id, type_path: r.t5_path, short_type_path: r.t5_short, has_component: r.t5_has_comp, component_data: r.t5_comp_data, has_resource: r.t5_has_res, resource_data: r.t5_res_data, has_event: r.t5_has_evt, event_data: r.t5_evt_data, has_message: r.t5_has_msg, message_data: r.t5_msg_data, has_bundle: r.t5_has_bun, bundle_data: r.t5_bun_data, has_from_world: r.t5_has_fw, from_world_data: r.t5_fw_data, has_map_entities: r.t5_has_me, map_entities_data: r.t5_me_data }; };
    if idx == 6 { return EcsAtrTypeDescriptor { type_id: r.t6_id, type_path: r.t6_path, short_type_path: r.t6_short, has_component: r.t6_has_comp, component_data: r.t6_comp_data, has_resource: r.t6_has_res, resource_data: r.t6_res_data, has_event: r.t6_has_evt, event_data: r.t6_evt_data, has_message: r.t6_has_msg, message_data: r.t6_msg_data, has_bundle: r.t6_has_bun, bundle_data: r.t6_bun_data, has_from_world: r.t6_has_fw, from_world_data: r.t6_fw_data, has_map_entities: r.t6_has_me, map_entities_data: r.t6_me_data }; };
    if idx == 7 { return EcsAtrTypeDescriptor { type_id: r.t7_id, type_path: r.t7_path, short_type_path: r.t7_short, has_component: r.t7_has_comp, component_data: r.t7_comp_data, has_resource: r.t7_has_res, resource_data: r.t7_res_data, has_event: r.t7_has_evt, event_data: r.t7_evt_data, has_message: r.t7_has_msg, message_data: r.t7_msg_data, has_bundle: r.t7_has_bun, bundle_data: r.t7_bun_data, has_from_world: r.t7_has_fw, from_world_data: r.t7_fw_data, has_map_entities: r.t7_has_me, map_entities_data: r.t7_me_data }; };
    return EcsAtrTypeDescriptor { type_id: r.t7_id, type_path: r.t7_path, short_type_path: r.t7_short, has_component: r.t7_has_comp, component_data: r.t7_comp_data, has_resource: r.t7_has_res, resource_data: r.t7_res_data, has_event: r.t7_has_evt, event_data: r.t7_evt_data, has_message: r.t7_has_msg, message_data: r.t7_msg_data, has_bundle: r.t7_has_bun, bundle_data: r.t7_bun_data, has_from_world: r.t7_has_fw, from_world_data: r.t7_fw_data, has_map_entities: r.t7_has_me, map_entities_data: r.t7_me_data };
}

fn _ecs_atr_set_slot(r: EcsAtrTypeRegistry, idx: i32, d: EcsAtrTypeDescriptor) -> EcsAtrTypeRegistry {
    if idx == 0 { r.t0_id = d.type_id; r.t0_path = d.type_path; r.t0_short = d.short_type_path; r.t0_has_comp = d.has_component; r.t0_comp_data = d.component_data; r.t0_has_res = d.has_resource; r.t0_res_data = d.resource_data; r.t0_has_evt = d.has_event; r.t0_evt_data = d.event_data; r.t0_has_msg = d.has_message; r.t0_msg_data = d.message_data; r.t0_has_bun = d.has_bundle; r.t0_bun_data = d.bundle_data; r.t0_has_fw = d.has_from_world; r.t0_fw_data = d.from_world_data; r.t0_has_me = d.has_map_entities; r.t0_me_data = d.map_entities_data; return r; };
    if idx == 1 { r.t1_id = d.type_id; r.t1_path = d.type_path; r.t1_short = d.short_type_path; r.t1_has_comp = d.has_component; r.t1_comp_data = d.component_data; r.t1_has_res = d.has_resource; r.t1_res_data = d.resource_data; r.t1_has_evt = d.has_event; r.t1_evt_data = d.event_data; r.t1_has_msg = d.has_message; r.t1_msg_data = d.message_data; r.t1_has_bun = d.has_bundle; r.t1_bun_data = d.bundle_data; r.t1_has_fw = d.has_from_world; r.t1_fw_data = d.from_world_data; r.t1_has_me = d.has_map_entities; r.t1_me_data = d.map_entities_data; return r; };
    if idx == 2 { r.t2_id = d.type_id; r.t2_path = d.type_path; r.t2_short = d.short_type_path; r.t2_has_comp = d.has_component; r.t2_comp_data = d.component_data; r.t2_has_res = d.has_resource; r.t2_res_data = d.resource_data; r.t2_has_evt = d.has_event; r.t2_evt_data = d.event_data; r.t2_has_msg = d.has_message; r.t2_msg_data = d.message_data; r.t2_has_bun = d.has_bundle; r.t2_bun_data = d.bundle_data; r.t2_has_fw = d.has_from_world; r.t2_fw_data = d.from_world_data; r.t2_has_me = d.has_map_entities; r.t2_me_data = d.map_entities_data; return r; };
    if idx == 3 { r.t3_id = d.type_id; r.t3_path = d.type_path; r.t3_short = d.short_type_path; r.t3_has_comp = d.has_component; r.t3_comp_data = d.component_data; r.t3_has_res = d.has_resource; r.t3_res_data = d.resource_data; r.t3_has_evt = d.has_event; r.t3_evt_data = d.event_data; r.t3_has_msg = d.has_message; r.t3_msg_data = d.message_data; r.t3_has_bun = d.has_bundle; r.t3_bun_data = d.bundle_data; r.t3_has_fw = d.has_from_world; r.t3_fw_data = d.from_world_data; r.t3_has_me = d.has_map_entities; r.t3_me_data = d.map_entities_data; return r; };
    if idx == 4 { r.t4_id = d.type_id; r.t4_path = d.type_path; r.t4_short = d.short_type_path; r.t4_has_comp = d.has_component; r.t4_comp_data = d.component_data; r.t4_has_res = d.has_resource; r.t4_res_data = d.resource_data; r.t4_has_evt = d.has_event; r.t4_evt_data = d.event_data; r.t4_has_msg = d.has_message; r.t4_msg_data = d.message_data; r.t4_has_bun = d.has_bundle; r.t4_bun_data = d.bundle_data; r.t4_has_fw = d.has_from_world; r.t4_fw_data = d.from_world_data; r.t4_has_me = d.has_map_entities; r.t4_me_data = d.map_entities_data; return r; };
    if idx == 5 { r.t5_id = d.type_id; r.t5_path = d.type_path; r.t5_short = d.short_type_path; r.t5_has_comp = d.has_component; r.t5_comp_data = d.component_data; r.t5_has_res = d.has_resource; r.t5_res_data = d.resource_data; r.t5_has_evt = d.has_event; r.t5_evt_data = d.event_data; r.t5_has_msg = d.has_message; r.t5_msg_data = d.message_data; r.t5_has_bun = d.has_bundle; r.t5_bun_data = d.bundle_data; r.t5_has_fw = d.has_from_world; r.t5_fw_data = d.from_world_data; r.t5_has_me = d.has_map_entities; r.t5_me_data = d.map_entities_data; return r; };
    if idx == 6 { r.t6_id = d.type_id; r.t6_path = d.type_path; r.t6_short = d.short_type_path; r.t6_has_comp = d.has_component; r.t6_comp_data = d.component_data; r.t6_has_res = d.has_resource; r.t6_res_data = d.resource_data; r.t6_has_evt = d.has_event; r.t6_evt_data = d.event_data; r.t6_has_msg = d.has_message; r.t6_msg_data = d.message_data; r.t6_has_bun = d.has_bundle; r.t6_bun_data = d.bundle_data; r.t6_has_fw = d.has_from_world; r.t6_fw_data = d.from_world_data; r.t6_has_me = d.has_map_entities; r.t6_me_data = d.map_entities_data; return r; };
    if idx == 7 { r.t7_id = d.type_id; r.t7_path = d.type_path; r.t7_short = d.short_type_path; r.t7_has_comp = d.has_component; r.t7_comp_data = d.component_data; r.t7_has_res = d.has_resource; r.t7_res_data = d.resource_data; r.t7_has_evt = d.has_event; r.t7_evt_data = d.event_data; r.t7_has_msg = d.has_message; r.t7_msg_data = d.message_data; r.t7_has_bun = d.has_bundle; r.t7_bun_data = d.bundle_data; r.t7_has_fw = d.has_from_world; r.t7_fw_data = d.from_world_data; r.t7_has_me = d.has_map_entities; r.t7_me_data = d.map_entities_data; return r; };
    r.t7_id = d.type_id; r.t7_path = d.type_path; r.t7_short = d.short_type_path; r.t7_has_comp = d.has_component; r.t7_comp_data = d.component_data; r.t7_has_res = d.has_resource; r.t7_res_data = d.resource_data; r.t7_has_evt = d.has_event; r.t7_evt_data = d.event_data; r.t7_has_msg = d.has_message; r.t7_msg_data = d.message_data; r.t7_has_bun = d.has_bundle; r.t7_bun_data = d.bundle_data; r.t7_has_fw = d.has_from_world; r.t7_fw_data = d.from_world_data; r.t7_has_me = d.has_map_entities; r.t7_me_data = d.map_entities_data; return r;
}

fn ecs_atr_type_registry_register_or_replace(r: EcsAtrTypeRegistry, d: EcsAtrTypeDescriptor) -> EcsAtrTypeRegistry {
    let index = ecs_atr_type_registry_find_index(r, d.type_id);
    if index != -1 { return _ecs_atr_set_slot(r, index, d); };
    if r.count >= ECS_ATR_CAP { return r; };
    r = _ecs_atr_set_slot(r, r.count, d);
    r.count = r.count + 1; return r;
}

fn ecs_atr_type_registry_get(r: EcsAtrTypeRegistry, type_id: i64) -> EcsAtrTypeDescriptorResult {
    let index = ecs_atr_type_registry_find_index(r, type_id);
    if index < 0 { return ecs_atr_descriptor_empty_result(); };
    return EcsAtrTypeDescriptorResult { has: 1, descriptor: _ecs_atr_slot_to_desc(r, index) };
}

fn ecs_atr_type_registry_at(r: EcsAtrTypeRegistry, index: i32) -> EcsAtrTypeDescriptorResult {
    if index < 0 { return ecs_atr_descriptor_empty_result(); };
    if index >= r.count { return ecs_atr_descriptor_empty_result(); };
    return EcsAtrTypeDescriptorResult { has: 1, descriptor: _ecs_atr_slot_to_desc(r, index) };
}

fn ecs_atr_type_registry_register_type_data(r: EcsAtrTypeRegistry, type_id: i64, kind: i32, data: i64) -> EcsAtrTypeRegistry {
    let found = ecs_atr_type_registry_get(r, type_id);
    if found.has != 1 { return r; };
    let d = ecs_atr_descriptor_with_type_data(found.descriptor, kind, data);
    return ecs_atr_type_registry_register_or_replace(r, d);
}

fn ecs_atr_type_registry_has_type_data(r: EcsAtrTypeRegistry, type_id: i64, kind: i32) -> bool {
    let found = ecs_atr_type_registry_get(r, type_id);
    if found.has != 1 { return false; };
    return ecs_atr_descriptor_has_type_data(found.descriptor, kind);
}

fn ecs_atr_type_registry_type_data(r: EcsAtrTypeRegistry, type_id: i64, kind: i32) -> EcsAtrTypeDataResult {
    let found = ecs_atr_type_registry_get(r, type_id);
    if found.has != 1 { return EcsAtrTypeDataResult { has: 0, data: 0 }; };
    return ecs_atr_descriptor_type_data(found.descriptor, kind);
}

// Function registry: cap-12 scalar slot family, simpler (3 fields per slot).
@derive(copy)
struct EcsAtrFunctionRegistry {
    count: i32,
    f0_id: i64, f0_name: i64, f0_handle: i64,
    f1_id: i64, f1_name: i64, f1_handle: i64,
    f2_id: i64, f2_name: i64, f2_handle: i64,
    f3_id: i64, f3_name: i64, f3_handle: i64,
    f4_id: i64, f4_name: i64, f4_handle: i64,
    f5_id: i64, f5_name: i64, f5_handle: i64,
    f6_id: i64, f6_name: i64, f6_handle: i64,
    f7_id: i64, f7_name: i64, f7_handle: i64,
}

fn ecs_atr_function_registry_new() -> EcsAtrFunctionRegistry {
    return EcsAtrFunctionRegistry {
        count: 0,
        f0_id: 0, f0_name: 0, f0_handle: 0, f1_id: 0, f1_name: 0, f1_handle: 0,
        f2_id: 0, f2_name: 0, f2_handle: 0, f3_id: 0, f3_name: 0, f3_handle: 0,
        f4_id: 0, f4_name: 0, f4_handle: 0, f5_id: 0, f5_name: 0, f5_handle: 0,
        f6_id: 0, f6_name: 0, f6_handle: 0, f7_id: 0, f7_name: 0, f7_handle: 0,
    };
}

fn ecs_atr_function_registry_len(r: EcsAtrFunctionRegistry) -> i32 { return r.count; }
fn ecs_atr_function_registry_is_empty(r: EcsAtrFunctionRegistry) -> bool { return r.count == 0; }


@derive(copy)
struct EcsAtrFunctionDescriptor { function_id: i64, name: i64, function_handle: i64 }
@derive(copy)
struct EcsAtrFunctionDescriptorResult { has: i32, descriptor: EcsAtrFunctionDescriptor }

fn ecs_atr_function_descriptor_new(function_id: i64, name: i64, function_handle: i64) -> EcsAtrFunctionDescriptor {
    return EcsAtrFunctionDescriptor { function_id: function_id, name: name, function_handle: function_handle };
}
fn ecs_atr_function_descriptor_empty_result() -> EcsAtrFunctionDescriptorResult {
    return EcsAtrFunctionDescriptorResult { has: 0, descriptor: ecs_atr_function_descriptor_new(0, 0, 0) };
}

fn ecs_atr_function_registry_find_index(r: EcsAtrFunctionRegistry, function_id: i64) -> i32 {
    if r.count > 0 && r.f0_id == function_id { return 0; };
    if r.count > 1 && r.f1_id == function_id { return 1; };
    if r.count > 2 && r.f2_id == function_id { return 2; };
    if r.count > 3 && r.f3_id == function_id { return 3; };
    if r.count > 4 && r.f4_id == function_id { return 4; };
    if r.count > 5 && r.f5_id == function_id { return 5; };
    if r.count > 6 && r.f6_id == function_id { return 6; };
    if r.count > 7 && r.f7_id == function_id { return 7; };
    return -1;
}
fn ecs_atr_function_registry_contains(r: EcsAtrFunctionRegistry, function_id: i64) -> bool {
    return ecs_atr_function_registry_find_index(r, function_id) != -1;
}

fn _ecs_atr_fslot_to_desc(r: EcsAtrFunctionRegistry, idx: i32) -> EcsAtrFunctionDescriptor {
    if idx == 0 { return EcsAtrFunctionDescriptor { function_id: r.f0_id, name: r.f0_name, function_handle: r.f0_handle }; };
    if idx == 1 { return EcsAtrFunctionDescriptor { function_id: r.f1_id, name: r.f1_name, function_handle: r.f1_handle }; };
    if idx == 2 { return EcsAtrFunctionDescriptor { function_id: r.f2_id, name: r.f2_name, function_handle: r.f2_handle }; };
    if idx == 3 { return EcsAtrFunctionDescriptor { function_id: r.f3_id, name: r.f3_name, function_handle: r.f3_handle }; };
    if idx == 4 { return EcsAtrFunctionDescriptor { function_id: r.f4_id, name: r.f4_name, function_handle: r.f4_handle }; };
    if idx == 5 { return EcsAtrFunctionDescriptor { function_id: r.f5_id, name: r.f5_name, function_handle: r.f5_handle }; };
    if idx == 6 { return EcsAtrFunctionDescriptor { function_id: r.f6_id, name: r.f6_name, function_handle: r.f6_handle }; };
    if idx == 7 { return EcsAtrFunctionDescriptor { function_id: r.f7_id, name: r.f7_name, function_handle: r.f7_handle }; };
    return EcsAtrFunctionDescriptor { function_id: r.f7_id, name: r.f7_name, function_handle: r.f7_handle };
}

fn _ecs_atr_fset_slot(r: EcsAtrFunctionRegistry, idx: i32, d: EcsAtrFunctionDescriptor) -> EcsAtrFunctionRegistry {
    if idx == 0 { r.f0_id = d.function_id; r.f0_name = d.name; r.f0_handle = d.function_handle; return r; };
    if idx == 1 { r.f1_id = d.function_id; r.f1_name = d.name; r.f1_handle = d.function_handle; return r; };
    if idx == 2 { r.f2_id = d.function_id; r.f2_name = d.name; r.f2_handle = d.function_handle; return r; };
    if idx == 3 { r.f3_id = d.function_id; r.f3_name = d.name; r.f3_handle = d.function_handle; return r; };
    if idx == 4 { r.f4_id = d.function_id; r.f4_name = d.name; r.f4_handle = d.function_handle; return r; };
    if idx == 5 { r.f5_id = d.function_id; r.f5_name = d.name; r.f5_handle = d.function_handle; return r; };
    if idx == 6 { r.f6_id = d.function_id; r.f6_name = d.name; r.f6_handle = d.function_handle; return r; };
    if idx == 7 { r.f7_id = d.function_id; r.f7_name = d.name; r.f7_handle = d.function_handle; return r; };
    r.f7_id = d.function_id; r.f7_name = d.name; r.f7_handle = d.function_handle; return r;
}

fn ecs_atr_function_descriptor_function_id(d: EcsAtrFunctionDescriptor) -> i64 { return d.function_id; }
fn ecs_atr_function_descriptor_name(d: EcsAtrFunctionDescriptor) -> i64 { return d.name; }
fn ecs_atr_function_descriptor_function_handle(d: EcsAtrFunctionDescriptor) -> i64 { return d.function_handle; }

fn ecs_atr_function_registry_register_or_replace(r: EcsAtrFunctionRegistry, d: EcsAtrFunctionDescriptor) -> EcsAtrFunctionRegistry {
    let index = ecs_atr_function_registry_find_index(r, d.function_id);
    if index != -1 { return _ecs_atr_fset_slot(r, index, d); };
    if r.count >= ECS_ATR_CAP { return r; };
    r = _ecs_atr_fset_slot(r, r.count, d);
    r.count = r.count + 1; return r;
}

fn ecs_atr_function_registry_get(r: EcsAtrFunctionRegistry, function_id: i64) -> EcsAtrFunctionDescriptorResult {
    let index = ecs_atr_function_registry_find_index(r, function_id);
    if index < 0 { return ecs_atr_function_descriptor_empty_result(); };
    return EcsAtrFunctionDescriptorResult { has: 1, descriptor: _ecs_atr_fslot_to_desc(r, index) };
}

fn ecs_atr_function_registry_at(r: EcsAtrFunctionRegistry, index: i32) -> EcsAtrFunctionDescriptorResult {
    if index < 0 { return ecs_atr_function_descriptor_empty_result(); };
    if index >= r.count { return ecs_atr_function_descriptor_empty_result(); };
    return EcsAtrFunctionDescriptorResult { has: 1, descriptor: _ecs_atr_fslot_to_desc(r, index) };
}
