    t4_has_evt: i32, t4_evt_data: i64, t4_has_msg: i32, t4_msg_data: i64,
    t4_has_bun: i32, t4_bun_data: i64, t4_has_fw: i32, t4_fw_data: i64,
    t4_has_me: i32, t4_me_data: i64,
    t5_id: i64, t5_path: i64, t5_short: i64,
    t5_has_comp: i32, t5_comp_data: i64, t5_has_res: i32, t5_res_data: i64,
    t5_has_evt: i32, t5_evt_data: i64, t5_has_msg: i32, t5_msg_data: i64,
    t5_has_bun: i32, t5_bun_data: i64, t5_has_fw: i32, t5_fw_data: i64,
    t5_has_me: i32, t5_me_data: i64,
    t6_id: i64, t6_path: i64, t6_short: i64,
    t6_has_comp: i32, t6_comp_data: i64, t6_has_res: i32, t6_res_data: i64,
    t6_has_evt: i32, t6_evt_data: i64, t6_has_msg: i32, t6_msg_data: i64,
    t6_has_bun: i32, t6_bun_data: i64, t6_has_fw: i32, t6_fw_data: i64,
    t6_has_me: i32, t6_me_data: i64,
    t7_id: i64, t7_path: i64, t7_short: i64,
    t7_has_comp: i32, t7_comp_data: i64, t7_has_res: i32, t7_res_data: i64,
    t7_has_evt: i32, t7_evt_data: i64, t7_has_msg: i32, t7_msg_data: i64,
