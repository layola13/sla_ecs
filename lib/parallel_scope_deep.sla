// Deep self-contained mirror of lib/parallel_scope.sla.
// Models Bevy ParallelCommands / ParallelCommandQueue with fixed cap-16 scalar slots
// instead of Vec<i64>. Commands preserve insertion order and carry their thread id.

const ECS_PARALLEL_SCOPE_DEEP_CAP: i32 = 16;

@derive(copy)
struct EcsParallelCommandQueueDeep {
    cmd0: i64, cmd1: i64, cmd2: i64, cmd3: i64,
    cmd4: i64, cmd5: i64, cmd6: i64, cmd7: i64,
    cmd8: i64, cmd9: i64, cmd10: i64, cmd11: i64,
    cmd12: i64, cmd13: i64, cmd14: i64, cmd15: i64,
    tid0: i64, tid1: i64, tid2: i64, tid3: i64,
    tid4: i64, tid5: i64, tid6: i64, tid7: i64,
    tid8: i64, tid9: i64, tid10: i64, tid11: i64,
    tid12: i64, tid13: i64, tid14: i64, tid15: i64,
    count: i32,
    last_get_count: i32,
    last_get0: i64, last_get1: i64, last_get2: i64, last_get3: i64,
    last_get4: i64, last_get5: i64, last_get6: i64, last_get7: i64,
    last_get8: i64, last_get9: i64, last_get10: i64, last_get11: i64,
    last_get12: i64, last_get13: i64, last_get14: i64, last_get15: i64,
}

fn ecs_parallel_command_queue_deep_new() -> EcsParallelCommandQueueDeep {
    return EcsParallelCommandQueueDeep {
        cmd0: 0, cmd1: 0, cmd2: 0, cmd3: 0,
        cmd4: 0, cmd5: 0, cmd6: 0, cmd7: 0,
        cmd8: 0, cmd9: 0, cmd10: 0, cmd11: 0,
        cmd12: 0, cmd13: 0, cmd14: 0, cmd15: 0,
        tid0: 0, tid1: 0, tid2: 0, tid3: 0,
        tid4: 0, tid5: 0, tid6: 0, tid7: 0,
        tid8: 0, tid9: 0, tid10: 0, tid11: 0,
        tid12: 0, tid13: 0, tid14: 0, tid15: 0,
        count: 0,
        last_get_count: 0,
        last_get0: 0, last_get1: 0, last_get2: 0, last_get3: 0,
        last_get4: 0, last_get5: 0, last_get6: 0, last_get7: 0,
        last_get8: 0, last_get9: 0, last_get10: 0, last_get11: 0,
        last_get12: 0, last_get13: 0, last_get14: 0, last_get15: 0,
    };
}

fn _eps_cmd_at(q: EcsParallelCommandQueueDeep, idx: i32) -> i64 {
    if idx == 0 { return q.cmd0; };
    if idx == 1 { return q.cmd1; };
    if idx == 2 { return q.cmd2; };
    if idx == 3 { return q.cmd3; };
    if idx == 4 { return q.cmd4; };
    if idx == 5 { return q.cmd5; };
    if idx == 6 { return q.cmd6; };
    if idx == 7 { return q.cmd7; };
    if idx == 8 { return q.cmd8; };
    if idx == 9 { return q.cmd9; };
    if idx == 10 { return q.cmd10; };
    if idx == 11 { return q.cmd11; };
    if idx == 12 { return q.cmd12; };
    if idx == 13 { return q.cmd13; };
    if idx == 14 { return q.cmd14; };
    if idx == 15 { return q.cmd15; };
    panic(147670);
}

fn _eps_cmd_set(q: EcsParallelCommandQueueDeep, idx: i32, v: i64) -> EcsParallelCommandQueueDeep {
    if idx == 0 { q.cmd0 = v; return q; };
    if idx == 1 { q.cmd1 = v; return q; };
    if idx == 2 { q.cmd2 = v; return q; };
    if idx == 3 { q.cmd3 = v; return q; };
    if idx == 4 { q.cmd4 = v; return q; };
    if idx == 5 { q.cmd5 = v; return q; };
    if idx == 6 { q.cmd6 = v; return q; };
    if idx == 7 { q.cmd7 = v; return q; };
    if idx == 8 { q.cmd8 = v; return q; };
    if idx == 9 { q.cmd9 = v; return q; };
    if idx == 10 { q.cmd10 = v; return q; };
    if idx == 11 { q.cmd11 = v; return q; };
    if idx == 12 { q.cmd12 = v; return q; };
    if idx == 13 { q.cmd13 = v; return q; };
    if idx == 14 { q.cmd14 = v; return q; };
    if idx == 15 { q.cmd15 = v; return q; };
    panic(147671);
}

fn _eps_tid_at(q: EcsParallelCommandQueueDeep, idx: i32) -> i64 {
    if idx == 0 { return q.tid0; };
    if idx == 1 { return q.tid1; };
    if idx == 2 { return q.tid2; };
    if idx == 3 { return q.tid3; };
    if idx == 4 { return q.tid4; };
    if idx == 5 { return q.tid5; };
    if idx == 6 { return q.tid6; };
    if idx == 7 { return q.tid7; };
    if idx == 8 { return q.tid8; };
    if idx == 9 { return q.tid9; };
    if idx == 10 { return q.tid10; };
    if idx == 11 { return q.tid11; };
    if idx == 12 { return q.tid12; };
    if idx == 13 { return q.tid13; };
    if idx == 14 { return q.tid14; };
    if idx == 15 { return q.tid15; };
    panic(147672);
}

fn _eps_tid_set(q: EcsParallelCommandQueueDeep, idx: i32, v: i64) -> EcsParallelCommandQueueDeep {
    if idx == 0 { q.tid0 = v; return q; };
    if idx == 1 { q.tid1 = v; return q; };
    if idx == 2 { q.tid2 = v; return q; };
    if idx == 3 { q.tid3 = v; return q; };
    if idx == 4 { q.tid4 = v; return q; };
    if idx == 5 { q.tid5 = v; return q; };
    if idx == 6 { q.tid6 = v; return q; };
    if idx == 7 { q.tid7 = v; return q; };
    if idx == 8 { q.tid8 = v; return q; };
    if idx == 9 { q.tid9 = v; return q; };
    if idx == 10 { q.tid10 = v; return q; };
    if idx == 11 { q.tid11 = v; return q; };
    if idx == 12 { q.tid12 = v; return q; };
    if idx == 13 { q.tid13 = v; return q; };
    if idx == 14 { q.tid14 = v; return q; };
    if idx == 15 { q.tid15 = v; return q; };
    panic(147673);
}

fn _eps_last_set(q: EcsParallelCommandQueueDeep, idx: i32, v: i64) -> EcsParallelCommandQueueDeep {
    if idx == 0 { q.last_get0 = v; return q; };
    if idx == 1 { q.last_get1 = v; return q; };
    if idx == 2 { q.last_get2 = v; return q; };
    if idx == 3 { q.last_get3 = v; return q; };
    if idx == 4 { q.last_get4 = v; return q; };
    if idx == 5 { q.last_get5 = v; return q; };
    if idx == 6 { q.last_get6 = v; return q; };
    if idx == 7 { q.last_get7 = v; return q; };
    if idx == 8 { q.last_get8 = v; return q; };
    if idx == 9 { q.last_get9 = v; return q; };
    if idx == 10 { q.last_get10 = v; return q; };
    if idx == 11 { q.last_get11 = v; return q; };
    if idx == 12 { q.last_get12 = v; return q; };
    if idx == 13 { q.last_get13 = v; return q; };
    if idx == 14 { q.last_get14 = v; return q; };
    if idx == 15 { q.last_get15 = v; return q; };
    panic(147674);
}

fn ecs_parallel_command_queue_deep_last_at(q: EcsParallelCommandQueueDeep, idx: i32) -> i64 {
    if idx == 0 { return q.last_get0; };
    if idx == 1 { return q.last_get1; };
    if idx == 2 { return q.last_get2; };
    if idx == 3 { return q.last_get3; };
    if idx == 4 { return q.last_get4; };
    if idx == 5 { return q.last_get5; };
    if idx == 6 { return q.last_get6; };
    if idx == 7 { return q.last_get7; };
    if idx == 8 { return q.last_get8; };
    if idx == 9 { return q.last_get9; };
    if idx == 10 { return q.last_get10; };
    if idx == 11 { return q.last_get11; };
    if idx == 12 { return q.last_get12; };
    if idx == 13 { return q.last_get13; };
    if idx == 14 { return q.last_get14; };
    if idx == 15 { return q.last_get15; };
    panic(147675);
}

fn ecs_parallel_command_queue_deep_command(q: EcsParallelCommandQueueDeep, thread_id: i64, command: i64) -> EcsParallelCommandQueueDeep {
    if q.count < ECS_PARALLEL_SCOPE_DEEP_CAP {
        q = _eps_cmd_set(q, q.count, command);
        q = _eps_tid_set(q, q.count, thread_id);
        q.count = q.count + 1;
    };
    return q;
}

fn ecs_parallel_command_queue_deep_len(q: EcsParallelCommandQueueDeep) -> i64 { return q.count as i64; }
fn ecs_parallel_command_queue_deep_is_empty(q: EcsParallelCommandQueueDeep) -> bool { return q.count == 0; }
fn ecs_parallel_command_queue_deep_command_at(q: EcsParallelCommandQueueDeep, idx: i32) -> i64 { return _eps_cmd_at(q, idx); }
fn ecs_parallel_command_queue_deep_thread_at(q: EcsParallelCommandQueueDeep, idx: i32) -> i64 { return _eps_tid_at(q, idx); }

fn ecs_parallel_command_queue_deep_count_for_thread(q: EcsParallelCommandQueueDeep, thread_id: i64) -> i64 {
    let total: i64 = 0;
    let i: i32 = 0;
    while i < q.count {
        if _eps_tid_at(q, i) == thread_id { total = total + 1; };
        i = i + 1;
    }
    return total;
}

fn ecs_parallel_command_queue_deep_get_commands_for_thread(q: EcsParallelCommandQueueDeep, thread_id: i64) -> EcsParallelCommandQueueDeep {
    q.last_get_count = 0;
    let i: i32 = 0;
    while i < q.count {
        if _eps_tid_at(q, i) == thread_id {
            q = _eps_last_set(q, q.last_get_count, _eps_cmd_at(q, i));
            q.last_get_count = q.last_get_count + 1;
        };
        i = i + 1;
    }
    return q;
}

fn ecs_parallel_command_queue_deep_last_count(q: EcsParallelCommandQueueDeep) -> i64 {
    return q.last_get_count as i64;
}

fn ecs_parallel_command_queue_deep_clear(q: EcsParallelCommandQueueDeep) -> EcsParallelCommandQueueDeep {
    q.count = 0;
    q.last_get_count = 0;
    return q;
}

@derive(copy)
struct EcsParallelCommandsDeep {
    cmd0: i64, cmd1: i64, cmd2: i64, cmd3: i64,
    cmd4: i64, cmd5: i64, cmd6: i64, cmd7: i64,
    cmd8: i64, cmd9: i64, cmd10: i64, cmd11: i64,
    cmd12: i64, cmd13: i64, cmd14: i64, cmd15: i64,
    tid0: i64, tid1: i64, tid2: i64, tid3: i64,
    tid4: i64, tid5: i64, tid6: i64, tid7: i64,
    tid8: i64, tid9: i64, tid10: i64, tid11: i64,
    tid12: i64, tid13: i64, tid14: i64, tid15: i64,
    count: i32,
    next_thread_id: i64,
}

fn ecs_parallel_commands_deep_new() -> EcsParallelCommandsDeep {
    return EcsParallelCommandsDeep {
        cmd0: 0, cmd1: 0, cmd2: 0, cmd3: 0,
        cmd4: 0, cmd5: 0, cmd6: 0, cmd7: 0,
        cmd8: 0, cmd9: 0, cmd10: 0, cmd11: 0,
        cmd12: 0, cmd13: 0, cmd14: 0, cmd15: 0,
        tid0: 0, tid1: 0, tid2: 0, tid3: 0,
        tid4: 0, tid5: 0, tid6: 0, tid7: 0,
        tid8: 0, tid9: 0, tid10: 0, tid11: 0,
        tid12: 0, tid13: 0, tid14: 0, tid15: 0,
        count: 0,
        next_thread_id: 0,
    };
}

fn _epc_to_queue(c: EcsParallelCommandsDeep) -> EcsParallelCommandQueueDeep {
    let q = ecs_parallel_command_queue_deep_new();
    q.cmd0 = c.cmd0; q.cmd1 = c.cmd1; q.cmd2 = c.cmd2; q.cmd3 = c.cmd3;
    q.cmd4 = c.cmd4; q.cmd5 = c.cmd5; q.cmd6 = c.cmd6; q.cmd7 = c.cmd7;
    q.cmd8 = c.cmd8; q.cmd9 = c.cmd9; q.cmd10 = c.cmd10; q.cmd11 = c.cmd11;
    q.cmd12 = c.cmd12; q.cmd13 = c.cmd13; q.cmd14 = c.cmd14; q.cmd15 = c.cmd15;
    q.tid0 = c.tid0; q.tid1 = c.tid1; q.tid2 = c.tid2; q.tid3 = c.tid3;
    q.tid4 = c.tid4; q.tid5 = c.tid5; q.tid6 = c.tid6; q.tid7 = c.tid7;
    q.tid8 = c.tid8; q.tid9 = c.tid9; q.tid10 = c.tid10; q.tid11 = c.tid11;
    q.tid12 = c.tid12; q.tid13 = c.tid13; q.tid14 = c.tid14; q.tid15 = c.tid15;
    q.count = c.count;
    return q;
}

fn _epc_from_queue(c: EcsParallelCommandsDeep, q: EcsParallelCommandQueueDeep) -> EcsParallelCommandsDeep {
    c.cmd0 = q.cmd0; c.cmd1 = q.cmd1; c.cmd2 = q.cmd2; c.cmd3 = q.cmd3;
    c.cmd4 = q.cmd4; c.cmd5 = q.cmd5; c.cmd6 = q.cmd6; c.cmd7 = q.cmd7;
    c.cmd8 = q.cmd8; c.cmd9 = q.cmd9; c.cmd10 = q.cmd10; c.cmd11 = q.cmd11;
    c.cmd12 = q.cmd12; c.cmd13 = q.cmd13; c.cmd14 = q.cmd14; c.cmd15 = q.cmd15;
    c.tid0 = q.tid0; c.tid1 = q.tid1; c.tid2 = q.tid2; c.tid3 = q.tid3;
    c.tid4 = q.tid4; c.tid5 = q.tid5; c.tid6 = q.tid6; c.tid7 = q.tid7;
    c.tid8 = q.tid8; c.tid9 = q.tid9; c.tid10 = q.tid10; c.tid11 = q.tid11;
    c.tid12 = q.tid12; c.tid13 = q.tid13; c.tid14 = q.tid14; c.tid15 = q.tid15;
    c.count = q.count;
    return c;
}

fn ecs_parallel_commands_deep_command_scope(c: EcsParallelCommandsDeep, thread_id: i64, command: i64) -> EcsParallelCommandsDeep {
    let q = _epc_to_queue(c);
    q = ecs_parallel_command_queue_deep_command(q, thread_id, command);
    c = _epc_from_queue(c, q);
    if thread_id >= c.next_thread_id { c.next_thread_id = thread_id + 1; };
    return c;
}

fn ecs_parallel_commands_deep_total_commands(c: EcsParallelCommandsDeep) -> i64 {
    return c.count as i64;
}

fn ecs_parallel_commands_deep_queue_count(c: EcsParallelCommandsDeep) -> i64 {
    if c.count == 0 { return 0; };
    return 1;
}

fn ecs_parallel_commands_deep_is_empty(c: EcsParallelCommandsDeep) -> bool {
    return c.count == 0;
}

fn ecs_parallel_commands_deep_clear(c: EcsParallelCommandsDeep) -> EcsParallelCommandsDeep {
    c.count = 0;
    return c;
}

fn ecs_parallel_commands_deep_count_for_thread(c: EcsParallelCommandsDeep, thread_id: i64) -> i64 {
    return ecs_parallel_command_queue_deep_count_for_thread(_epc_to_queue(c), thread_id);
}

fn ecs_parallel_commands_deep_get_commands_for_thread(c: EcsParallelCommandsDeep, thread_id: i64) -> EcsParallelCommandQueueDeep {
    return ecs_parallel_command_queue_deep_get_commands_for_thread(_epc_to_queue(c), thread_id);
}

fn ecs_parallel_commands_deep_next_thread_id(c: EcsParallelCommandsDeep) -> i64 {
    return c.next_thread_id;
}
