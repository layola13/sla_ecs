    cond64: i32, cond65: i32, cond66: i32, cond67: i32,
    kind7: i32, batch7: i32,
    cond7_count: i32, cond70: i32, cond71: i32, cond72: i32, cond73: i32,
    cond74: i32, cond75: i32, cond76: i32, cond77: i32,
    rte0_count: i32, rte00: i32, rte01: i32, rte02: i32, rte03: i32,
    rte04: i32, rte05: i32, rte06: i32, rte07: i32,
    rc00: i32, rc01: i32, rc02: i32, rc03: i32, rc0_count: i32, wc00: i32, wc01: i32, wc02: i32, wc03: i32, wc0_count: i32, resr0: i32, resw0: i32, msgr0: i32, msgw0: i32,
    rc10: i32, rc11: i32, rc12: i32, rc13: i32, rc1_count: i32, wc10: i32, wc11: i32, wc12: i32, wc13: i32, wc1_count: i32, resr1: i32, resw1: i32, msgr1: i32, msgw1: i32,
    rc20: i32, rc21: i32, rc22: i32, rc23: i32, rc2_count: i32, wc20: i32, wc21: i32, wc22: i32, wc23: i32, wc2_count: i32, resr2: i32, resw2: i32, msgr2: i32, msgw2: i32,
    rc30: i32, rc31: i32, rc32: i32, rc33: i32, rc3_count: i32, wc30: i32, wc31: i32, wc32: i32, wc33: i32, wc3_count: i32, resr3: i32, resw3: i32, msgr3: i32, msgw3: i32,
    rc40: i32, rc41: i32, rc42: i32, rc43: i32, rc4_count: i32, wc40: i32, wc41: i32, wc42: i32, wc43: i32, wc4_count: i32, resr4: i32, resw4: i32, msgr4: i32, msgw4: i32,
    rc50: i32, rc51: i32, rc52: i32, rc53: i32, rc5_count: i32, wc50: i32, wc51: i32, wc52: i32, wc53: i32, wc5_count: i32, resr5: i32, resw5: i32, msgr5: i32, msgw5: i32,
    rc60: i32, rc61: i32, rc62: i32, rc63: i32, rc6_count: i32, wc60: i32, wc61: i32, wc62: i32, wc63: i32, wc6_count: i32, resr6: i32, resw6: i32, msgr6: i32, msgw6: i32,
    rc70: i32, rc71: i32, rc72: i32, rc73: i32, rc7_count: i32, wc70: i32, wc71: i32, wc72: i32, wc73: i32, wc7_count: i32, resr7: i32, resw7: i32, msgr7: i32, msgw7: i32,
    sched_cond0: i32, sched_cond1: i32, sched_cond2: i32, sched_cond3: i32,
    sched_cond4: i32, sched_cond5: i32, sched_cond6: i32, sched_cond7: i32,
    sched_cond_count: i32,
}

