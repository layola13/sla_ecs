// Deep module for lib/schedule_table_erased.sla (Batch 399).
// Self-contained fixed-cap base erased schedule: access metadata, run conditions,
// batch planning, sequential/planned run, and explicit ordering (chain/before/after/in_set).
// System functions become stable kind ids; no fn-pointers or runtime world erasure.

const ECS_SCE_CAP: i32 = 8;
const ECS_SCE_LIST_CAP: i32 = 4;
const ECS_SCE_COND_CAP: i32 = 8;

const ECS_SCE_COND_ALWAYS: i32 = 0;
const ECS_SCE_COND_FALSE: i32 = 1;
const ECS_SCE_COND_TRUE: i32 = 2;
const ECS_SCE_COND_TICK_AT_LEAST_THREE: i32 = 3;

const ECS_SCE_SYS_MOVE: i32 = 1;
const ECS_SCE_SYS_DOUBLE: i32 = 2;
const ECS_SCE_SYS_INCREMENT_TICK: i32 = 3;
const ECS_SCE_SYS_SET_EVENT: i32 = 4;

struct EcsSceWorld {
    change_tick: i32,
    pos_x: i32,
    vel_x: i32,
    event_amount: i32,
}

fn ecs_sce_world_new(pos_x: i32, vel_x: i32, event_amount: i32) -> EcsSceWorld {
    return EcsSceWorld { change_tick: 1, pos_x: pos_x, vel_x: vel_x, event_amount: event_amount };
}
fn ecs_sce_world_change_tick(w: EcsSceWorld) -> i32 { return w.change_tick; }
fn ecs_sce_world_pos_x(w: EcsSceWorld) -> i32 { return w.pos_x; }
fn ecs_sce_world_vel_x(w: EcsSceWorld) -> i32 { return w.vel_x; }
fn ecs_sce_world_event_amount(w: EcsSceWorld) -> i32 { return w.event_amount; }

fn ecs_sce_condition_eval(kind: i32, change_tick: i32) -> bool {
    if kind == ECS_SCE_COND_ALWAYS { return true; };
    if kind == ECS_SCE_COND_FALSE { return false; };
    if kind == ECS_SCE_COND_TRUE { return true; };
    if kind == ECS_SCE_COND_TICK_AT_LEAST_THREE { return change_tick >= 3; };
    return false;
}

struct EcsSceConditions {
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    count: i32,
}

fn ecs_sce_conditions_default() -> EcsSceConditions {
    return EcsSceConditions { c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0, count: 0 };
}
fn _ecs_sce_cond_at(c: EcsSceConditions, idx: i32) -> i32 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    return c.c7;
}
fn _ecs_sce_set_cond(c: EcsSceConditions, idx: i32, kind: i32) -> EcsSceConditions {
    if idx == 0 { c.c0 = kind; return c; };
    if idx == 1 { c.c1 = kind; return c; };
    if idx == 2 { c.c2 = kind; return c; };
    if idx == 3 { c.c3 = kind; return c; };
    if idx == 4 { c.c4 = kind; return c; };
    if idx == 5 { c.c5 = kind; return c; };
    if idx == 6 { c.c6 = kind; return c; };
    c.c7 = kind; return c;
}
fn ecs_sce_conditions_add(c: EcsSceConditions, kind: i32) -> EcsSceConditions {
    if c.count >= ECS_SCE_COND_CAP { return c; };
    c = _ecs_sce_set_cond(c, c.count, kind);
    c.count = c.count + 1;
    return c;
}
fn ecs_sce_conditions_pass(c: EcsSceConditions, change_tick: i32) -> bool {
    let i: i32 = 0;
    while i < c.count {
        if ecs_sce_condition_eval(_ecs_sce_cond_at(c, i), change_tick) != true { return false; };
        i = i + 1;
    }
    return true;
}

struct EcsSceAccess {
    rc0: i32, rc1: i32, rc2: i32, rc3: i32,
    rc_count: i32,
    wc0: i32, wc1: i32, wc2: i32, wc3: i32,
    wc_count: i32,
    reads_resource: i32, writes_resource: i32,
    reads_messages: i32, writes_messages: i32,
}

fn ecs_sce_access_none() -> EcsSceAccess {
    return EcsSceAccess { rc0: 0, rc1: 0, rc2: 0, rc3: 0, rc_count: 0, wc0: 0, wc1: 0, wc2: 0, wc3: 0, wc_count: 0, reads_resource: 0, writes_resource: 0, reads_messages: 0, writes_messages: 0 };
}

fn _ecs_sce_rc_at(a: EcsSceAccess, idx: i32) -> i32 {
    if idx == 0 { return a.rc0; };
    if idx == 1 { return a.rc1; };
    if idx == 2 { return a.rc2; };
    return a.rc3;
}
fn _ecs_sce_set_rc(a: EcsSceAccess, idx: i32, value: i32) -> EcsSceAccess {
    if idx == 0 { a.rc0 = value; return a; };
    if idx == 1 { a.rc1 = value; return a; };
    if idx == 2 { a.rc2 = value; return a; };
    a.rc3 = value; return a;
}
fn _ecs_sce_wc_at(a: EcsSceAccess, idx: i32) -> i32 {
    if idx == 0 { return a.wc0; };
    if idx == 1 { return a.wc1; };
    if idx == 2 { return a.wc2; };
    return a.wc3;
}
fn _ecs_sce_set_wc(a: EcsSceAccess, idx: i32, value: i32) -> EcsSceAccess {
    if idx == 0 { a.wc0 = value; return a; };
    if idx == 1 { a.wc1 = value; return a; };
    if idx == 2 { a.wc2 = value; return a; };
    a.wc3 = value; return a;
}
fn ecs_sce_access_read_component(a: EcsSceAccess, id: i32) -> EcsSceAccess {
    if a.rc_count >= ECS_SCE_LIST_CAP { return a; };
    a = _ecs_sce_set_rc(a, a.rc_count, id);
    a.rc_count = a.rc_count + 1; return a;
}
fn ecs_sce_access_write_component(a: EcsSceAccess, id: i32) -> EcsSceAccess {
    if a.wc_count >= ECS_SCE_LIST_CAP { return a; };
    a = _ecs_sce_set_wc(a, a.wc_count, id);
    a.wc_count = a.wc_count + 1; return a;
}
fn ecs_sce_access_read_type(a: EcsSceAccess, type_id: i32) -> EcsSceAccess { return ecs_sce_access_read_component(a, type_id); }
fn ecs_sce_access_write_type(a: EcsSceAccess, type_id: i32) -> EcsSceAccess { return ecs_sce_access_write_component(a, type_id); }
fn ecs_sce_access_read_resource(a: EcsSceAccess) -> EcsSceAccess { a.reads_resource = 1; return a; }
fn ecs_sce_access_write_resource(a: EcsSceAccess) -> EcsSceAccess { a.writes_resource = 1; return a; }
fn ecs_sce_access_read_messages(a: EcsSceAccess) -> EcsSceAccess { a.reads_messages = 1; return a; }
fn ecs_sce_access_write_messages(a: EcsSceAccess) -> EcsSceAccess { a.writes_messages = 1; return a; }

fn _ecs_sce_list_has(a: EcsSceAccess, fam: i32, id: i32) -> bool {
    let i: i32 = 0;
    if fam == 0 { while i < a.rc_count { if _ecs_sce_rc_at(a, i) == id { return true; }; i = i + 1; } return false; };
    while i < a.wc_count { if _ecs_sce_wc_at(a, i) == id { return true; }; i = i + 1; } return false;
}
fn ecs_sce_access_conflicts(left: EcsSceAccess, right: EcsSceAccess) -> bool {
    let i: i32 = 0;
    while i < left.wc_count {
        let id = _ecs_sce_wc_at(left, i);
        if _ecs_sce_list_has(right, 0, id) { return true; };
        if _ecs_sce_list_has(right, 1, id) { return true; };
        i = i + 1;
    }
    let j: i32 = 0;
    while j < right.wc_count {
        let id = _ecs_sce_wc_at(right, j);
        if _ecs_sce_list_has(left, 0, id) { return true; };
        if _ecs_sce_list_has(left, 1, id) { return true; };
        j = j + 1;
    }
    if left.writes_resource == 1 { if right.reads_resource == 1 { return true; }; if right.writes_resource == 1 { return true; }; };
    if right.writes_resource == 1 { if left.reads_resource == 1 { return true; }; if left.writes_resource == 1 { return true; }; };
    if left.writes_messages == 1 { if right.reads_messages == 1 { return true; }; if right.writes_messages == 1 { return true; }; };
    if right.writes_messages == 1 { if left.reads_messages == 1 { return true; }; if left.writes_messages == 1 { return true; }; };
    return false;
}

