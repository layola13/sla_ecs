fn _ecs_sce_access_at(s: EcsSceSchedule, idx: i32) -> EcsSceAccess {
    let a = ecs_sce_access_none();
    if idx == 0 { a.rc_count = s.rc0_count; a.rc0 = s.rc00; a.rc1 = s.rc01; a.rc2 = s.rc02; a.rc3 = s.rc03; a.wc_count = s.wc0_count; a.wc0 = s.wc00; a.wc1 = s.wc01; a.wc2 = s.wc02; a.wc3 = s.wc03; a.reads_resource = s.resr0; a.writes_resource = s.resw0; a.reads_messages = s.msgr0; a.writes_messages = s.msgw0; return a; };
    if idx == 1 { a.rc_count = s.rc1_count; a.rc0 = s.rc10; a.rc1 = s.rc11; a.rc2 = s.rc12; a.rc3 = s.rc13; a.wc_count = s.wc1_count; a.wc0 = s.wc10; a.wc1 = s.wc11; a.wc2 = s.wc12; a.wc3 = s.wc13; a.reads_resource = s.resr1; a.writes_resource = s.resw1; a.reads_messages = s.msgr1; a.writes_messages = s.msgw1; return a; };
    if idx == 2 { a.rc_count = s.rc2_count; a.rc0 = s.rc20; a.rc1 = s.rc21; a.rc2 = s.rc22; a.rc3 = s.rc23; a.wc_count = s.wc2_count; a.wc0 = s.wc20; a.wc1 = s.wc21; a.wc2 = s.wc22; a.wc3 = s.wc23; a.reads_resource = s.resr2; a.writes_resource = s.resw2; a.reads_messages = s.msgr2; a.writes_messages = s.msgw2; return a; };
    if idx == 3 { a.rc_count = s.rc3_count; a.rc0 = s.rc30; a.rc1 = s.rc31; a.rc2 = s.rc32; a.rc3 = s.rc33; a.wc_count = s.wc3_count; a.wc0 = s.wc30; a.wc1 = s.wc31; a.wc2 = s.wc32; a.wc3 = s.wc33; a.reads_resource = s.resr3; a.writes_resource = s.resw3; a.reads_messages = s.msgr3; a.writes_messages = s.msgw3; return a; };
    if idx == 4 { a.rc_count = s.rc4_count; a.rc0 = s.rc40; a.rc1 = s.rc41; a.rc2 = s.rc42; a.rc3 = s.rc43; a.wc_count = s.wc4_count; a.wc0 = s.wc40; a.wc1 = s.wc41; a.wc2 = s.wc42; a.wc3 = s.wc43; a.reads_resource = s.resr4; a.writes_resource = s.resw4; a.reads_messages = s.msgr4; a.writes_messages = s.msgw4; return a; };
    if idx == 5 { a.rc_count = s.rc5_count; a.rc0 = s.rc50; a.rc1 = s.rc51; a.rc2 = s.rc52; a.rc3 = s.rc53; a.wc_count = s.wc5_count; a.wc0 = s.wc50; a.wc1 = s.wc51; a.wc2 = s.wc52; a.wc3 = s.wc53; a.reads_resource = s.resr5; a.writes_resource = s.resw5; a.reads_messages = s.msgr5; a.writes_messages = s.msgw5; return a; };
    if idx == 6 { a.rc_count = s.rc6_count; a.rc0 = s.rc60; a.rc1 = s.rc61; a.rc2 = s.rc62; a.rc3 = s.rc63; a.wc_count = s.wc6_count; a.wc0 = s.wc60; a.wc1 = s.wc61; a.wc2 = s.wc62; a.wc3 = s.wc63; a.reads_resource = s.resr6; a.writes_resource = s.resw6; a.reads_messages = s.msgr6; a.writes_messages = s.msgw6; return a; };
    a.rc_count = s.rc7_count; a.rc0 = s.rc70; a.rc1 = s.rc71; a.rc2 = s.rc72; a.rc3 = s.rc73; a.wc_count = s.wc7_count; a.wc0 = s.wc70; a.wc1 = s.wc71; a.wc2 = s.wc72; a.wc3 = s.wc73; a.reads_resource = s.resr7; a.writes_resource = s.resw7; a.reads_messages = s.msgr7; a.writes_messages = s.msgw7; return a;
}

fn _ecs_sce_conds_at(s: EcsSceSchedule, idx: i32) -> EcsSceConditions {
    let c = ecs_sce_conditions_default();
    if idx == 0 { c.c0 = s.cond00; c.c1 = s.cond01; c.c2 = s.cond02; c.c3 = s.cond03; c.c4 = s.cond04; c.c5 = s.cond05; c.c6 = s.cond06; c.c7 = s.cond07; c.count = s.cond0_count; return c; };
    if idx == 1 { c.c0 = s.cond10; c.c1 = s.cond11; c.c2 = s.cond12; c.c3 = s.cond13; c.c4 = s.cond14; c.c5 = s.cond15; c.c6 = s.cond16; c.c7 = s.cond17; c.count = s.cond1_count; return c; };
    if idx == 2 { c.c0 = s.cond20; c.c1 = s.cond21; c.c2 = s.cond22; c.c3 = s.cond23; c.c4 = s.cond24; c.c5 = s.cond25; c.c6 = s.cond26; c.c7 = s.cond27; c.count = s.cond2_count; return c; };
    if idx == 3 { c.c0 = s.cond30; c.c1 = s.cond31; c.c2 = s.cond32; c.c3 = s.cond33; c.c4 = s.cond34; c.c5 = s.cond35; c.c6 = s.cond36; c.c7 = s.cond37; c.count = s.cond3_count; return c; };
    if idx == 4 { c.c0 = s.cond40; c.c1 = s.cond41; c.c2 = s.cond42; c.c3 = s.cond43; c.c4 = s.cond44; c.c5 = s.cond45; c.c6 = s.cond46; c.c7 = s.cond47; c.count = s.cond4_count; return c; };
    if idx == 5 { c.c0 = s.cond50; c.c1 = s.cond51; c.c2 = s.cond52; c.c3 = s.cond53; c.c4 = s.cond54; c.c5 = s.cond55; c.c6 = s.cond56; c.c7 = s.cond57; c.count = s.cond5_count; return c; };
    if idx == 6 { c.c0 = s.cond60; c.c1 = s.cond61; c.c2 = s.cond62; c.c3 = s.cond63; c.c4 = s.cond64; c.c5 = s.cond65; c.c6 = s.cond66; c.c7 = s.cond67; c.count = s.cond6_count; return c; };
    c.c0 = s.cond70; c.c1 = s.cond71; c.c2 = s.cond72; c.c3 = s.cond73; c.c4 = s.cond74; c.c5 = s.cond75; c.c6 = s.cond76; c.c7 = s.cond77; c.count = s.cond7_count; return c;
}

fn _ecs_sce_set_slot(s: EcsSceSchedule, idx: i32, kind: i32, batch: i32, a: EcsSceAccess, conds: EcsSceConditions) -> EcsSceSchedule {
    if idx == 0 { s.kind0 = kind; s.batch0 = batch;
        s.cond0_count = conds.count; s.cond00 = conds.c0; s.cond01 = conds.c1; s.cond02 = conds.c2; s.cond03 = conds.c3; s.cond04 = conds.c4; s.cond05 = conds.c5; s.cond06 = conds.c6; s.cond07 = conds.c7;
        s.rc0_count = a.rc_count; s.rc00 = a.rc0; s.rc01 = a.rc1; s.rc02 = a.rc2; s.rc03 = a.rc3; s.wc0_count = a.wc_count; s.wc00 = a.wc0; s.wc01 = a.wc1; s.wc02 = a.wc2; s.wc03 = a.wc3; s.resr0 = a.reads_resource; s.resw0 = a.writes_resource; s.msgr0 = a.reads_messages; s.msgw0 = a.writes_messages; return s; };
    if idx == 1 { s.kind1 = kind; s.batch1 = batch;
        s.cond1_count = conds.count; s.cond10 = conds.c0; s.cond11 = conds.c1; s.cond12 = conds.c2; s.cond13 = conds.c3; s.cond14 = conds.c4; s.cond15 = conds.c5; s.cond16 = conds.c6; s.cond17 = conds.c7;
        s.rc1_count = a.rc_count; s.rc10 = a.rc0; s.rc11 = a.rc1; s.rc12 = a.rc2; s.rc13 = a.rc3; s.wc1_count = a.wc_count; s.wc10 = a.wc0; s.wc11 = a.wc1; s.wc12 = a.wc2; s.wc13 = a.wc3; s.resr1 = a.reads_resource; s.resw1 = a.writes_resource; s.msgr1 = a.reads_messages; s.msgw1 = a.writes_messages; return s; };
    if idx == 2 { s.kind2 = kind; s.batch2 = batch;
        s.cond2_count = conds.count; s.cond20 = conds.c0; s.cond21 = conds.c1; s.cond22 = conds.c2; s.cond23 = conds.c3; s.cond24 = conds.c4; s.cond25 = conds.c5; s.cond26 = conds.c6; s.cond27 = conds.c7;
        s.rc2_count = a.rc_count; s.rc20 = a.rc0; s.rc21 = a.rc1; s.rc22 = a.rc2; s.rc23 = a.rc3; s.wc2_count = a.wc_count; s.wc20 = a.wc0; s.wc21 = a.wc1; s.wc22 = a.wc2; s.wc23 = a.wc3; s.resr2 = a.reads_resource; s.resw2 = a.writes_resource; s.msgr2 = a.reads_messages; s.msgw2 = a.writes_messages; return s; };
    if idx == 3 { s.kind3 = kind; s.batch3 = batch;
        s.cond3_count = conds.count; s.cond30 = conds.c0; s.cond31 = conds.c1; s.cond32 = conds.c2; s.cond33 = conds.c3; s.cond34 = conds.c4; s.cond35 = conds.c5; s.cond36 = conds.c6; s.cond37 = conds.c7;
        s.rc3_count = a.rc_count; s.rc30 = a.rc0; s.rc31 = a.rc1; s.rc32 = a.rc2; s.rc33 = a.rc3; s.wc3_count = a.wc_count; s.wc30 = a.wc0; s.wc31 = a.wc1; s.wc32 = a.wc2; s.wc33 = a.wc3; s.resr3 = a.reads_resource; s.resw3 = a.writes_resource; s.msgr3 = a.reads_messages; s.msgw3 = a.writes_messages; return s; };
    if idx == 4 { s.kind4 = kind; s.batch4 = batch;
        s.cond4_count = conds.count; s.cond40 = conds.c0; s.cond41 = conds.c1; s.cond42 = conds.c2; s.cond43 = conds.c3; s.cond44 = conds.c4; s.cond45 = conds.c5; s.cond46 = conds.c6; s.cond47 = conds.c7;
        s.rc4_count = a.rc_count; s.rc40 = a.rc0; s.rc41 = a.rc1; s.rc42 = a.rc2; s.rc43 = a.rc3; s.wc4_count = a.wc_count; s.wc40 = a.wc0; s.wc41 = a.wc1; s.wc42 = a.wc2; s.wc43 = a.wc3; s.resr4 = a.reads_resource; s.resw4 = a.writes_resource; s.msgr4 = a.reads_messages; s.msgw4 = a.writes_messages; return s; };
    if idx == 5 { s.kind5 = kind; s.batch5 = batch;
        s.cond5_count = conds.count; s.cond50 = conds.c0; s.cond51 = conds.c1; s.cond52 = conds.c2; s.cond53 = conds.c3; s.cond54 = conds.c4; s.cond55 = conds.c5; s.cond56 = conds.c6; s.cond57 = conds.c7;
        s.rc5_count = a.rc_count; s.rc50 = a.rc0; s.rc51 = a.rc1; s.rc52 = a.rc2; s.rc53 = a.rc3; s.wc5_count = a.wc_count; s.wc50 = a.wc0; s.wc51 = a.wc1; s.wc52 = a.wc2; s.wc53 = a.wc3; s.resr5 = a.reads_resource; s.resw5 = a.writes_resource; s.msgr5 = a.reads_messages; s.msgw5 = a.writes_messages; return s; };
    if idx == 6 { s.kind6 = kind; s.batch6 = batch;
        s.cond6_count = conds.count; s.cond60 = conds.c0; s.cond61 = conds.c1; s.cond62 = conds.c2; s.cond63 = conds.c3; s.cond64 = conds.c4; s.cond65 = conds.c5; s.cond66 = conds.c6; s.cond67 = conds.c7;
        s.rc6_count = a.rc_count; s.rc60 = a.rc0; s.rc61 = a.rc1; s.rc62 = a.rc2; s.rc63 = a.rc3; s.wc6_count = a.wc_count; s.wc60 = a.wc0; s.wc61 = a.wc1; s.wc62 = a.wc2; s.wc63 = a.wc3; s.resr6 = a.reads_resource; s.resw6 = a.writes_resource; s.msgr6 = a.reads_messages; s.msgw6 = a.writes_messages; return s; };
    s.kind7 = kind; s.batch7 = batch;
    s.cond7_count = conds.count; s.cond70 = conds.c0; s.cond71 = conds.c1; s.cond72 = conds.c2; s.cond73 = conds.c3; s.cond74 = conds.c4; s.cond75 = conds.c5; s.cond76 = conds.c6; s.cond77 = conds.c7;
    s.rc7_count = a.rc_count; s.rc70 = a.rc0; s.rc71 = a.rc1; s.rc72 = a.rc2; s.rc73 = a.rc3; s.wc7_count = a.wc_count; s.wc70 = a.wc0; s.wc71 = a.wc1; s.wc72 = a.wc2; s.wc73 = a.wc3; s.resr7 = a.reads_resource; s.resw7 = a.writes_resource; s.msgr7 = a.reads_messages; s.msgw7 = a.writes_messages; return s;
}

fn ecs_sce_schedule_conflict_count(s: EcsSceSchedule) -> i32 { return s.conflict_count; }
fn ecs_sce_schedule_batch_count(s: EcsSceSchedule) -> i32 { return s.batch_count; }
fn ecs_sce_schedule_system_batch(s: EcsSceSchedule, idx: i32) -> i32 {
    if idx < 0 { return -1; }; if idx >= s.count { return -1; };
    if idx == 0 { return s.batch0; };
    if idx == 1 { return s.batch1; };
    if idx == 2 { return s.batch2; };
    if idx == 3 { return s.batch3; };
    if idx == 4 { return s.batch4; };
    if idx == 5 { return s.batch5; };
    if idx == 6 { return s.batch6; };
    return s.batch7;
}
fn ecs_sce_schedule_kind_at(s: EcsSceSchedule, idx: i32) -> i32 {
    if idx < 0 { return -1; }; if idx >= s.count { return -1; };
    if idx == 0 { return s.kind0; };
    if idx == 1 { return s.kind1; };
    if idx == 2 { return s.kind2; };
    if idx == 3 { return s.kind3; };
    if idx == 4 { return s.kind4; };
    if idx == 5 { return s.kind5; };
    if idx == 6 { return s.kind6; };
    return s.kind7;
}
fn _ecs_sce_schedule_cond_count_at(s: EcsSceSchedule, idx: i32) -> i32 {
    if idx == 0 { return s.cond0_count; };
    if idx == 1 { return s.cond1_count; };
    if idx == 2 { return s.cond2_count; };
    if idx == 3 { return s.cond3_count; };
    if idx == 4 { return s.cond4_count; };
    if idx == 5 { return s.cond5_count; };
    if idx == 6 { return s.cond6_count; };
    return s.cond7_count;
}

fn ecs_sce_schedule_batch_width(s: EcsSceSchedule, batch_id: i32) -> i32 { let c: i32 = 0; let i: i32 = 0; while i < s.count { if ecs_sce_schedule_system_batch(s, i) == batch_id { c = c + 1; }; i = i + 1; } return c; }
fn ecs_sce_schedule_max_parallel_width(s: EcsSceSchedule) -> i32 { let max: i32 = 0; let b: i32 = 0; while b < s.batch_count { let w = ecs_sce_schedule_batch_width(s, b); if w > max { max = w; }; b = b + 1; } return max; }

fn _ecs_sce_batch_accepts(s: EcsSceSchedule, batch_id: i32, a: EcsSceAccess) -> bool { let i: i32 = 0; while i < s.count { if ecs_sce_schedule_system_batch(s, i) == batch_id { if ecs_sce_access_conflicts(_ecs_sce_access_at(s, i), a) { return false; }; }; i = i + 1; } return true; }
fn _ecs_sce_choose_batch(s: EcsSceSchedule, a: EcsSceAccess) -> i32 { let b: i32 = 0; while b < s.batch_count { if _ecs_sce_batch_accepts(s, b, a) { return b; }; b = b + 1; } return s.batch_count; }

fn ecs_sce_schedule_add_system(s: EcsSceSchedule, kind: i32, a: EcsSceAccess) -> EcsSceSchedule {
    let i: i32 = 0; while i < s.count { if ecs_sce_access_conflicts(_ecs_sce_access_at(s, i), a) { s.conflict_count = s.conflict_count + 1; }; i = i + 1; }
    let batch = _ecs_sce_choose_batch(s, a);
    if batch == s.batch_count { s.batch_count = s.batch_count + 1; };
    if s.count >= ECS_SCE_CAP { return s; };
    let conds = ecs_sce_conditions_default();
    s = _ecs_sce_set_slot(s, s.count, kind, batch, a, conds);
    s.count = s.count + 1; return s;
}
fn ecs_sce_schedule_add_system_run_if(s: EcsSceSchedule, kind: i32, a: EcsSceAccess, conds: EcsSceConditions) -> EcsSceSchedule {
    let i: i32 = 0; while i < s.count { if ecs_sce_access_conflicts(_ecs_sce_access_at(s, i), a) { s.conflict_count = s.conflict_count + 1; }; i = i + 1; }
    let batch = _ecs_sce_choose_batch(s, a);
    if batch == s.batch_count { s.batch_count = s.batch_count + 1; };
    if s.count >= ECS_SCE_CAP { return s; };
    s = _ecs_sce_set_slot(s, s.count, kind, batch, a, conds);
    s.count = s.count + 1; return s;
}
fn ecs_sce_schedule_add_system_in_batch(s: EcsSceSchedule, kind: i32, a: EcsSceAccess, conds: EcsSceConditions, batch_id: i32) -> EcsSceSchedule {
    if s.count >= ECS_SCE_CAP { return s; };
    s = _ecs_sce_set_slot(s, s.count, kind, batch_id, a, conds);
    s.count = s.count + 1;
    if batch_id >= s.batch_count { s.batch_count = batch_id + 1; };
    return s;
}
fn ecs_sce_schedule_chain(s: EcsSceSchedule, kind: i32, a: EcsSceAccess, conds: EcsSceConditions) -> EcsSceSchedule {
    return ecs_sce_schedule_add_system_in_batch(s, kind, a, conds, s.batch_count);
}
fn ecs_sce_schedule_before(s: EcsSceSchedule, kind: i32, a: EcsSceAccess, conds: EcsSceConditions, target_batch_id: i32) -> EcsSceSchedule {
    let batch_id = target_batch_id - 1;
    if batch_id < 0 { return ecs_sce_schedule_add_system_in_batch(s, kind, a, conds, 0); };
    return ecs_sce_schedule_add_system_in_batch(s, kind, a, conds, batch_id);
}
fn ecs_sce_schedule_after(s: EcsSceSchedule, kind: i32, a: EcsSceAccess, conds: EcsSceConditions, target_batch_id: i32) -> EcsSceSchedule {
    return ecs_sce_schedule_add_system_in_batch(s, kind, a, conds, target_batch_id + 1);
}
fn ecs_sce_schedule_in_set(s: EcsSceSchedule, kind: i32, a: EcsSceAccess, conds: EcsSceConditions, batch_id: i32) -> EcsSceSchedule {
    return ecs_sce_schedule_add_system_in_batch(s, kind, a, conds, batch_id);
}

fn ecs_sce_schedule_run_if(s: EcsSceSchedule, kind: i32) -> EcsSceSchedule {
    if s.sched_cond_count >= ECS_SCE_COND_CAP { return s; };
    if s.sched_cond_count == 0 { s.sched_cond0 = kind; };
    if s.sched_cond_count == 1 { s.sched_cond1 = kind; };
    if s.sched_cond_count == 2 { s.sched_cond2 = kind; };
    if s.sched_cond_count == 3 { s.sched_cond3 = kind; };
    if s.sched_cond_count == 4 { s.sched_cond4 = kind; };
    if s.sched_cond_count == 5 { s.sched_cond5 = kind; };
    if s.sched_cond_count == 6 { s.sched_cond6 = kind; };
    if s.sched_cond_count == 7 { s.sched_cond7 = kind; };
    s.sched_cond_count = s.sched_cond_count + 1;
    return s;
}
fn _ecs_sce_sched_conds(s: EcsSceSchedule) -> EcsSceConditions {
    let c = ecs_sce_conditions_default();
    c.c0 = s.sched_cond0; c.c1 = s.sched_cond1; c.c2 = s.sched_cond2; c.c3 = s.sched_cond3;
    c.c4 = s.sched_cond4; c.c5 = s.sched_cond5; c.c6 = s.sched_cond6; c.c7 = s.sched_cond7;
    c.count = s.sched_cond_count;
    return c;
}
fn ecs_sce_schedule_cond_count(s: EcsSceSchedule) -> i32 { return s.sched_cond_count; }

fn _ecs_sce_run_system(kind: i32, w: EcsSceWorld) -> EcsSceWorld {
    if kind == ECS_SCE_SYS_MOVE { w.pos_x = w.pos_x + w.vel_x; return w; };
    if kind == ECS_SCE_SYS_DOUBLE { w.pos_x = w.pos_x * 2; return w; };
    if kind == ECS_SCE_SYS_INCREMENT_TICK { w.change_tick = w.change_tick + 1; return w; };
    if kind == ECS_SCE_SYS_SET_EVENT { w.event_amount = w.event_amount + 1; return w; };
    return w;
}

fn ecs_sce_schedule_run(s: EcsSceSchedule, w: EcsSceWorld) -> EcsSceWorld {
    w.change_tick = w.change_tick + 1;
    let sched_conds = _ecs_sce_sched_conds(s);
    if ecs_sce_conditions_pass(sched_conds, w.change_tick) != true { return w; };
    let i: i32 = 0;
    while i < s.count {
        let sys_conds = _ecs_sce_conds_at(s, i);
        if ecs_sce_conditions_pass(sys_conds, w.change_tick) {
            w = _ecs_sce_run_system(ecs_sce_schedule_kind_at(s, i), w);
        };
        i = i + 1;
    }
    return w;
}
fn ecs_sce_schedule_run_planned(s: EcsSceSchedule, w: EcsSceWorld) -> EcsSceWorld {
    w.change_tick = w.change_tick + 1;
    let sched_conds = _ecs_sce_sched_conds(s);
    if ecs_sce_conditions_pass(sched_conds, w.change_tick) != true { return w; };
    let b: i32 = 0;
    while b < s.batch_count {
        let i: i32 = 0;
        while i < s.count {
            if ecs_sce_schedule_system_batch(s, i) == b {
                let sys_conds = _ecs_sce_conds_at(s, i);
                if ecs_sce_conditions_pass(sys_conds, w.change_tick) {
                    w = _ecs_sce_run_system(ecs_sce_schedule_kind_at(s, i), w);
                };
            };
            i = i + 1;
        }
        b = b + 1;
    }
    return w;
}
