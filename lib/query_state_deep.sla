// Deepened Bevy ECS QueryState surface.
// Mirrors src/query/state.rs core fields/behaviors:
//   world_id, matched tables/archetypes, dense flag, archetype generation,
//   init_access, update_archetypes, new_archetype match, as_readonly,
//   contains, is_empty, get/get_many presence, shrink/intersect matched sets.
// Shallow lib/query_state.sla retained.
// Fixed capacity: 4 reads, 4 writes, 8 matched tables, 8 matched archetypes.

struct EcsQsDeep {
    world_id: i64,
    is_dense: bool,
    initialized: bool,
    last_archetype_generation: i64,
    // component access
    read_len: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    write_len: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    // matched storage ids
    table_len: i32,
    t0: i64, t1: i64, t2: i64, t3: i64, t4: i64, t5: i64, t6: i64, t7: i64,
    arch_len: i32,
    a0: i64, a1: i64, a2: i64, a3: i64, a4: i64, a5: i64, a6: i64, a7: i64,
}

fn ecs_qs_deep_new(world_id: i64) -> EcsQsDeep {
    return EcsQsDeep {
        world_id: world_id, is_dense: true, initialized: false, last_archetype_generation: 0,
        read_len: 0, r0: -1, r1: -1, r2: -1, r3: -1,
        write_len: 0, w0: -1, w1: -1, w2: -1, w3: -1,
        table_len: 0, t0: -1, t1: -1, t2: -1, t3: -1, t4: -1, t5: -1, t6: -1, t7: -1,
        arch_len: 0, a0: -1, a1: -1, a2: -1, a3: -1, a4: -1, a5: -1, a6: -1, a7: -1,
    };
}

fn ecs_qs_deep_world_id(s: EcsQsDeep) -> i64 { return s.world_id; }
fn ecs_qs_deep_is_dense(s: EcsQsDeep) -> bool { return s.is_dense; }
fn ecs_qs_deep_is_initialized(s: EcsQsDeep) -> bool { return s.initialized; }
fn ecs_qs_deep_generation(s: EcsQsDeep) -> i64 { return s.last_archetype_generation; }
fn ecs_qs_deep_read_len(s: EcsQsDeep) -> i32 { return s.read_len; }
fn ecs_qs_deep_write_len(s: EcsQsDeep) -> i32 { return s.write_len; }
fn ecs_qs_deep_table_count(s: EcsQsDeep) -> i32 { return s.table_len; }
fn ecs_qs_deep_archetype_count(s: EcsQsDeep) -> i32 { return s.arch_len; }

fn ecs_qs_deep_set_dense(s: EcsQsDeep, dense: bool) -> EcsQsDeep {
    return EcsQsDeep {
        world_id: s.world_id, is_dense: dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
        read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
        write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
        table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
        arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
    };
}

fn ecs_qs_deep_init_access(s: EcsQsDeep) -> EcsQsDeep {
    return EcsQsDeep {
        world_id: s.world_id, is_dense: s.is_dense, initialized: true, last_archetype_generation: s.last_archetype_generation,
        read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
        write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
        table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
        arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
    };
}

fn ecs_qs_list4_has(n: i32, v0: i32, v1: i32, v2: i32, v3: i32, cid: i32) -> bool {
    if n >= 1 { if v0 == cid { return true; }; };
    if n >= 2 { if v1 == cid { return true; }; };
    if n >= 3 { if v2 == cid { return true; }; };
    if n >= 4 { if v3 == cid { return true; }; };
    return false;
}

fn ecs_qs_deep_add_read(s: EcsQsDeep, cid: i32) -> EcsQsDeep {
    if ecs_qs_list4_has(s.read_len, s.r0, s.r1, s.r2, s.r3, cid) { return s; };
    if s.read_len >= 4 { return s; };
    if s.read_len == 0 {
        return EcsQsDeep {
            world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
            read_len: 1, r0: cid, r1: s.r1, r2: s.r2, r3: s.r3,
            write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
            table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
            arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
        };
    };
    if s.read_len == 1 {
        return EcsQsDeep {
            world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
            read_len: 2, r0: s.r0, r1: cid, r2: s.r2, r3: s.r3,
            write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
            table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
            arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
        };
    };
    if s.read_len == 2 {
        return EcsQsDeep {
            world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
            read_len: 3, r0: s.r0, r1: s.r1, r2: cid, r3: s.r3,
            write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
            table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
            arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
        };
    };
    return EcsQsDeep {
        world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
        read_len: 4, r0: s.r0, r1: s.r1, r2: s.r2, r3: cid,
        write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
        table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
        arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
    };
}

fn ecs_qs_deep_add_write(s: EcsQsDeep, cid: i32) -> EcsQsDeep {
    if ecs_qs_list4_has(s.write_len, s.w0, s.w1, s.w2, s.w3, cid) { return s; };
    if s.write_len >= 4 { return s; };
    if s.write_len == 0 {
        return EcsQsDeep {
            world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
            read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
            write_len: 1, w0: cid, w1: s.w1, w2: s.w2, w3: s.w3,
            table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
            arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
        };
    };
    if s.write_len == 1 {
        return EcsQsDeep {
            world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
            read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
            write_len: 2, w0: s.w0, w1: cid, w2: s.w2, w3: s.w3,
            table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
            arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
        };
    };
    if s.write_len == 2 {
        return EcsQsDeep {
            world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
            read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
            write_len: 3, w0: s.w0, w1: s.w1, w2: cid, w3: s.w3,
            table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
            arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
        };
    };
    return EcsQsDeep {
        world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
        read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
        write_len: 4, w0: s.w0, w1: s.w1, w2: s.w2, w3: cid,
        table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
        arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
    };
}

fn ecs_qs_ids8_has(n: i32, v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64, id: i64) -> bool {
    if n >= 1 { if v0 == id { return true; }; };
    if n >= 2 { if v1 == id { return true; }; };
    if n >= 3 { if v2 == id { return true; }; };
    if n >= 4 { if v3 == id { return true; }; };
    if n >= 5 { if v4 == id { return true; }; };
    if n >= 6 { if v5 == id { return true; }; };
    if n >= 7 { if v6 == id { return true; }; };
    if n >= 8 { if v7 == id { return true; }; };
    return false;
}

fn ecs_qs_deep_add_table(s: EcsQsDeep, table_id: i64) -> EcsQsDeep {
    if ecs_qs_ids8_has(s.table_len, s.t0, s.t1, s.t2, s.t3, s.t4, s.t5, s.t6, s.t7, table_id) { return s; };
    if s.table_len >= 8 { return s; };
    let n = s.table_len;
    let t0 = s.t0; let t1 = s.t1; let t2 = s.t2; let t3 = s.t3;
    let t4 = s.t4; let t5 = s.t5; let t6 = s.t6; let t7 = s.t7;
    if n == 0 { t0 = table_id; };
    if n == 1 { t1 = table_id; };
    if n == 2 { t2 = table_id; };
    if n == 3 { t3 = table_id; };
    if n == 4 { t4 = table_id; };
    if n == 5 { t5 = table_id; };
    if n == 6 { t6 = table_id; };
    if n == 7 { t7 = table_id; };
    return EcsQsDeep {
        world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
        read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
        write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
        table_len: n + 1, t0: t0, t1: t1, t2: t2, t3: t3, t4: t4, t5: t5, t6: t6, t7: t7,
        arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
    };
}

fn ecs_qs_deep_add_archetype(s: EcsQsDeep, arch_id: i64) -> EcsQsDeep {
    if ecs_qs_ids8_has(s.arch_len, s.a0, s.a1, s.a2, s.a3, s.a4, s.a5, s.a6, s.a7, arch_id) { return s; };
    if s.arch_len >= 8 { return s; };
    let n = s.arch_len;
    let a0 = s.a0; let a1 = s.a1; let a2 = s.a2; let a3 = s.a3;
    let a4 = s.a4; let a5 = s.a5; let a6 = s.a6; let a7 = s.a7;
    if n == 0 { a0 = arch_id; };
    if n == 1 { a1 = arch_id; };
    if n == 2 { a2 = arch_id; };
    if n == 3 { a3 = arch_id; };
    if n == 4 { a4 = arch_id; };
    if n == 5 { a5 = arch_id; };
    if n == 6 { a6 = arch_id; };
    if n == 7 { a7 = arch_id; };
    return EcsQsDeep {
        world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: s.last_archetype_generation,
        read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
        write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
        table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
        arch_len: n + 1, a0: a0, a1: a1, a2: a2, a3: a3, a4: a4, a5: a5, a6: a6, a7: a7,
    };
}

fn ecs_qs_deep_contains_archetype(s: EcsQsDeep, arch_id: i64) -> bool {
    return ecs_qs_ids8_has(s.arch_len, s.a0, s.a1, s.a2, s.a3, s.a4, s.a5, s.a6, s.a7, arch_id);
}

fn ecs_qs_deep_contains_table(s: EcsQsDeep, table_id: i64) -> bool {
    return ecs_qs_ids8_has(s.table_len, s.t0, s.t1, s.t2, s.t3, s.t4, s.t5, s.t6, s.t7, table_id);
}

fn ecs_qs_deep_is_empty(s: EcsQsDeep) -> bool {
    if s.table_len != 0 { return false; };
    if s.arch_len != 0 { return false; };
    return true;
}

fn ecs_qs_deep_update_archetypes(s: EcsQsDeep, generation: i64) -> EcsQsDeep {
    // Bevy only walks new archetypes when generation advances.
    if generation <= s.last_archetype_generation { return s; };
    return EcsQsDeep {
        world_id: s.world_id, is_dense: s.is_dense, initialized: s.initialized, last_archetype_generation: generation,
        read_len: s.read_len, r0: s.r0, r1: s.r1, r2: s.r2, r3: s.r3,
        write_len: s.write_len, w0: s.w0, w1: s.w1, w2: s.w2, w3: s.w3,
        table_len: s.table_len, t0: s.t0, t1: s.t1, t2: s.t2, t3: s.t3, t4: s.t4, t5: s.t5, t6: s.t6, t7: s.t7,
        arch_len: s.arch_len, a0: s.a0, a1: s.a1, a2: s.a2, a3: s.a3, a4: s.a4, a5: s.a5, a6: s.a6, a7: s.a7,
    };
}

// new_archetype: if archetype components cover all required reads+writes, match it (+table)
fn ecs_qs_deep_required_match_fields(read_len: i32, r0: i32, r1: i32, r2: i32, r3: i32, write_len: i32, w0: i32, w1: i32, c0: i32, c1: i32, c2: i32, c3: i32, clen: i32) -> bool {
    if read_len >= 1 {
        let ok = false;
        if clen >= 1 { if c0 == r0 { ok = true; }; };
        if clen >= 2 { if c1 == r0 { ok = true; }; };
        if clen >= 3 { if c2 == r0 { ok = true; }; };
        if clen >= 4 { if c3 == r0 { ok = true; }; };
        if ok != true { return false; };
    };
    if read_len >= 2 {
        let ok = false;
        if clen >= 1 { if c0 == r1 { ok = true; }; };
        if clen >= 2 { if c1 == r1 { ok = true; }; };
        if clen >= 3 { if c2 == r1 { ok = true; }; };
        if clen >= 4 { if c3 == r1 { ok = true; }; };
        if ok != true { return false; };
    };
    if read_len >= 3 {
        let ok = false;
        if clen >= 1 { if c0 == r2 { ok = true; }; };
        if clen >= 2 { if c1 == r2 { ok = true; }; };
        if clen >= 3 { if c2 == r2 { ok = true; }; };
        if clen >= 4 { if c3 == r2 { ok = true; }; };
        if ok != true { return false; };
    };
    if read_len >= 4 {
        let ok = false;
        if clen >= 1 { if c0 == r3 { ok = true; }; };
        if clen >= 2 { if c1 == r3 { ok = true; }; };
        if clen >= 3 { if c2 == r3 { ok = true; }; };
        if clen >= 4 { if c3 == r3 { ok = true; }; };
        if ok != true { return false; };
    };
    if write_len >= 1 {
        let ok = false;
        if clen >= 1 { if c0 == w0 { ok = true; }; };
        if clen >= 2 { if c1 == w0 { ok = true; }; };
        if clen >= 3 { if c2 == w0 { ok = true; }; };
        if clen >= 4 { if c3 == w0 { ok = true; }; };
        if ok != true { return false; };
    };
    if write_len >= 2 {
        let ok = false;
        if clen >= 1 { if c0 == w1 { ok = true; }; };
        if clen >= 2 { if c1 == w1 { ok = true; }; };
        if clen >= 3 { if c2 == w1 { ok = true; }; };
        if clen >= 4 { if c3 == w1 { ok = true; }; };
        if ok != true { return false; };
    };
    return true;
}

fn ecs_qs_deep_new_archetype(s: EcsQsDeep, arch_id: i64, table_id: i64, c0: i32, c1: i32, c2: i32, c3: i32, clen: i32) -> EcsQsDeep {
    let dense = s.is_dense;
    let matched = ecs_qs_deep_required_match_fields(
        s.read_len, s.r0, s.r1, s.r2, s.r3, s.write_len, s.w0, s.w1, c0, c1, c2, c3, clen
    );
    if matched != true { return s; };
    let s2 = ecs_qs_deep_add_archetype(s, arch_id);
    if dense {
        return ecs_qs_deep_add_table(s2, table_id);
    };
    return s2;
}

// as_readonly: move writes into reads
fn ecs_qs_deep_as_readonly(s: EcsQsDeep) -> EcsQsDeep {
    let wlen = s.write_len;
    let w0 = s.w0; let w1 = s.w1; let w2 = s.w2; let w3 = s.w3;
    let out = s;
    if wlen >= 1 { out = ecs_qs_deep_add_read(out, w0); };
    if wlen >= 2 { out = ecs_qs_deep_add_read(out, w1); };
    if wlen >= 3 { out = ecs_qs_deep_add_read(out, w2); };
    if wlen >= 4 { out = ecs_qs_deep_add_read(out, w3); };
    return EcsQsDeep {
        world_id: out.world_id, is_dense: out.is_dense, initialized: out.initialized, last_archetype_generation: out.last_archetype_generation,
        read_len: out.read_len, r0: out.r0, r1: out.r1, r2: out.r2, r3: out.r3,
        write_len: 0, w0: -1, w1: -1, w2: -1, w3: -1,
        table_len: out.table_len, t0: out.t0, t1: out.t1, t2: out.t2, t3: out.t3, t4: out.t4, t5: out.t5, t6: out.t6, t7: out.t7,
        arch_len: out.arch_len, a0: out.a0, a1: out.a1, a2: out.a2, a3: out.a3, a4: out.a4, a5: out.a5, a6: out.a6, a7: out.a7,
    };
}

// get: entity matched if its archetype is matched
fn ecs_qs_deep_get_ok(s: EcsQsDeep, arch_id: i64) -> bool {
    return ecs_qs_deep_contains_archetype(s, arch_id);
}

// get_many: all entities' archetypes must match; unique if all entity ids distinct
struct EcsQsManyDeep {
    ok: bool,
    unique: bool,
}

fn ecs_qs_many_ok(r: EcsQsManyDeep) -> bool { return r.ok; }
fn ecs_qs_many_unique(r: EcsQsManyDeep) -> bool { return r.unique; }

fn ecs_qs_deep_get_many2(s: EcsQsDeep, e0: i64, a0: i64, e1: i64, a1: i64) -> EcsQsManyDeep {
    let ok0 = ecs_qs_deep_contains_archetype(s, a0);
    let ok1 = ecs_qs_deep_contains_archetype(s, a1);
    let ok = false;
    if ok0 { if ok1 { ok = true; }; };
    let unique = true;
    if e0 == e1 { unique = false; };
    return EcsQsManyDeep { ok: ok, unique: unique };
}

// intersect matched sets (join-like)
fn ecs_qs_deep_intersect(a: EcsQsDeep, b: EcsQsDeep) -> EcsQsDeep {
    let world_id = a.world_id;
    let dense = a.is_dense;
    let a_init = a.initialized;
    let b_init = b.initialized;
    let ar0 = a.r0; let ar1 = a.r1; let ar2 = a.r2; let ar3 = a.r3; let arlen = a.read_len;
    let aw0 = a.w0; let aw1 = a.w1; let aw2 = a.w2; let aw3 = a.w3; let awlen = a.write_len;
    let at0 = a.t0; let at1 = a.t1; let at2 = a.t2; let at3 = a.t3; let at4 = a.t4; let at5 = a.t5; let at6 = a.t6; let at7 = a.t7; let atlen = a.table_len;
    let aa0 = a.a0; let aa1 = a.a1; let aa2 = a.a2; let aa3 = a.a3; let aa4 = a.a4; let aa5 = a.a5; let aa6 = a.a6; let aa7 = a.a7; let aalen = a.arch_len;
    let out = ecs_qs_deep_new(world_id);
    out = ecs_qs_deep_set_dense(out, dense);
    if a_init { if b_init { out = ecs_qs_deep_init_access(out); }; };
    if arlen >= 1 { out = ecs_qs_deep_add_read(out, ar0); };
    if arlen >= 2 { out = ecs_qs_deep_add_read(out, ar1); };
    if arlen >= 3 { out = ecs_qs_deep_add_read(out, ar2); };
    if arlen >= 4 { out = ecs_qs_deep_add_read(out, ar3); };
    if awlen >= 1 { out = ecs_qs_deep_add_write(out, aw0); };
    if awlen >= 2 { out = ecs_qs_deep_add_write(out, aw1); };
    if awlen >= 3 { out = ecs_qs_deep_add_write(out, aw2); };
    if awlen >= 4 { out = ecs_qs_deep_add_write(out, aw3); };
    if atlen >= 1 { if ecs_qs_deep_contains_table(b, at0) { out = ecs_qs_deep_add_table(out, at0); }; };
    if atlen >= 2 { if ecs_qs_deep_contains_table(b, at1) { out = ecs_qs_deep_add_table(out, at1); }; };
    if atlen >= 3 { if ecs_qs_deep_contains_table(b, at2) { out = ecs_qs_deep_add_table(out, at2); }; };
    if atlen >= 4 { if ecs_qs_deep_contains_table(b, at3) { out = ecs_qs_deep_add_table(out, at3); }; };
    if atlen >= 5 { if ecs_qs_deep_contains_table(b, at4) { out = ecs_qs_deep_add_table(out, at4); }; };
    if atlen >= 6 { if ecs_qs_deep_contains_table(b, at5) { out = ecs_qs_deep_add_table(out, at5); }; };
    if atlen >= 7 { if ecs_qs_deep_contains_table(b, at6) { out = ecs_qs_deep_add_table(out, at6); }; };
    if atlen >= 8 { if ecs_qs_deep_contains_table(b, at7) { out = ecs_qs_deep_add_table(out, at7); }; };
    if aalen >= 1 { if ecs_qs_deep_contains_archetype(b, aa0) { out = ecs_qs_deep_add_archetype(out, aa0); }; };
    if aalen >= 2 { if ecs_qs_deep_contains_archetype(b, aa1) { out = ecs_qs_deep_add_archetype(out, aa1); }; };
    if aalen >= 3 { if ecs_qs_deep_contains_archetype(b, aa2) { out = ecs_qs_deep_add_archetype(out, aa2); }; };
    if aalen >= 4 { if ecs_qs_deep_contains_archetype(b, aa3) { out = ecs_qs_deep_add_archetype(out, aa3); }; };
    if aalen >= 5 { if ecs_qs_deep_contains_archetype(b, aa4) { out = ecs_qs_deep_add_archetype(out, aa4); }; };
    if aalen >= 6 { if ecs_qs_deep_contains_archetype(b, aa5) { out = ecs_qs_deep_add_archetype(out, aa5); }; };
    if aalen >= 7 { if ecs_qs_deep_contains_archetype(b, aa6) { out = ecs_qs_deep_add_archetype(out, aa6); }; };
    if aalen >= 8 { if ecs_qs_deep_contains_archetype(b, aa7) { out = ecs_qs_deep_add_archetype(out, aa7); }; };
    return out;
}
