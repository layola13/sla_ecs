// Deepened Bevy ECS UniqueEntityArray.
// Fixed capacity slots: 8. Shallow lib/unique_array.sla retained.

struct EcsUaDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    capacity: i32,
}

fn ecs_ua_deep_new(capacity: i32) -> EcsUaDeep {
    let cap = capacity;
    if cap > 8 { cap = 8; };
    if cap < 0 { cap = 0; };
    return EcsUaDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity: cap,
    };
}

fn ecs_ua_deep_len(a: EcsUaDeep) -> i32 { return a.len; }
fn ecs_ua_deep_capacity(a: EcsUaDeep) -> i32 { return a.capacity; }
fn ecs_ua_deep_is_empty(a: EcsUaDeep) -> bool { return a.len == 0; }
fn ecs_ua_deep_is_full(a: EcsUaDeep) -> bool { return a.len >= a.capacity; }

fn ecs_ua_deep_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, capacity: i32
) -> EcsUaDeep {
    return EcsUaDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
        len: len, capacity: capacity,
    };
}

fn ecs_ua_deep_contains(a: EcsUaDeep, entity: i64) -> bool {
    if a.len >= 1 { if a.e0 == entity { return true; }; };
    if a.len >= 2 { if a.e1 == entity { return true; }; };
    if a.len >= 3 { if a.e2 == entity { return true; }; };
    if a.len >= 4 { if a.e3 == entity { return true; }; };
    if a.len >= 5 { if a.e4 == entity { return true; }; };
    if a.len >= 6 { if a.e5 == entity { return true; }; };
    if a.len >= 7 { if a.e6 == entity { return true; }; };
    if a.len >= 8 { if a.e7 == entity { return true; }; };
    return false;
}

fn ecs_ua_deep_at(a: EcsUaDeep, idx: i32) -> i64 {
    if idx == 0 { return a.e0; };
    if idx == 1 { return a.e1; };
    if idx == 2 { return a.e2; };
    if idx == 3 { return a.e3; };
    if idx == 4 { return a.e4; };
    if idx == 5 { return a.e5; };
    if idx == 6 { return a.e6; };
    if idx == 7 { return a.e7; };
    return -1;
}

fn ecs_ua_deep_push(a: EcsUaDeep, entity: i64) -> EcsUaDeep {
    if a.len >= a.capacity { return a; };
    if ecs_ua_deep_contains(a, entity) { return a; };
    if a.len == 0 { return ecs_ua_deep_rebuild(entity, a.e1, a.e2, a.e3, a.e4, a.e5, a.e6, a.e7, 1, a.capacity); };
    if a.len == 1 { return ecs_ua_deep_rebuild(a.e0, entity, a.e2, a.e3, a.e4, a.e5, a.e6, a.e7, 2, a.capacity); };
    if a.len == 2 { return ecs_ua_deep_rebuild(a.e0, a.e1, entity, a.e3, a.e4, a.e5, a.e6, a.e7, 3, a.capacity); };
    if a.len == 3 { return ecs_ua_deep_rebuild(a.e0, a.e1, a.e2, entity, a.e4, a.e5, a.e6, a.e7, 4, a.capacity); };
    if a.len == 4 { return ecs_ua_deep_rebuild(a.e0, a.e1, a.e2, a.e3, entity, a.e5, a.e6, a.e7, 5, a.capacity); };
    if a.len == 5 { return ecs_ua_deep_rebuild(a.e0, a.e1, a.e2, a.e3, a.e4, entity, a.e6, a.e7, 6, a.capacity); };
    if a.len == 6 { return ecs_ua_deep_rebuild(a.e0, a.e1, a.e2, a.e3, a.e4, a.e5, entity, a.e7, 7, a.capacity); };
    if a.len == 7 { return ecs_ua_deep_rebuild(a.e0, a.e1, a.e2, a.e3, a.e4, a.e5, a.e6, entity, 8, a.capacity); };
    return a;
}

struct EcsUaGetDeep { ok: bool, value: i64 }
fn ecs_ua_get_ok(g: EcsUaGetDeep) -> bool { return g.ok; }
fn ecs_ua_get_value(g: EcsUaGetDeep) -> i64 { return g.value; }

fn ecs_ua_deep_get(a: EcsUaDeep, idx: i32) -> EcsUaGetDeep {
    if idx < 0 { return EcsUaGetDeep { ok: false, value: -1 }; };
    if idx >= a.len { return EcsUaGetDeep { ok: false, value: -1 }; };
    return EcsUaGetDeep { ok: true, value: ecs_ua_deep_at(a, idx) };
}

fn ecs_ua_deep_first(a: EcsUaDeep) -> EcsUaGetDeep {
    if a.len == 0 { return EcsUaGetDeep { ok: false, value: -1 }; };
    return EcsUaGetDeep { ok: true, value: a.e0 };
}

fn ecs_ua_deep_last(a: EcsUaDeep) -> EcsUaGetDeep {
    if a.len == 0 { return EcsUaGetDeep { ok: false, value: -1 }; };
    return EcsUaGetDeep { ok: true, value: ecs_ua_deep_at(a, a.len - 1) };
}

fn ecs_ua_deep_index_of(a: EcsUaDeep, entity: i64) -> i32 {
    if a.len >= 1 { if a.e0 == entity { return 0; }; };
    if a.len >= 2 { if a.e1 == entity { return 1; }; };
    if a.len >= 3 { if a.e2 == entity { return 2; }; };
    if a.len >= 4 { if a.e3 == entity { return 3; }; };
    if a.len >= 5 { if a.e4 == entity { return 4; }; };
    if a.len >= 6 { if a.e5 == entity { return 5; }; };
    if a.len >= 7 { if a.e6 == entity { return 6; }; };
    if a.len >= 8 { if a.e7 == entity { return 7; }; };
    return -1;
}

fn ecs_ua_deep_clear(a: EcsUaDeep) -> EcsUaDeep {
    return ecs_ua_deep_new(a.capacity);
}
