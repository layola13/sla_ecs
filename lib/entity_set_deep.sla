// Deepened Bevy ECS EntitySet / UniqueEntity surface.
// Mirrors src/entity/entity_set.rs core concepts:
//   ContainsEntity, EntityEquivalent uniqueness,
//   EntitySet fixed unique collection, insert/contains/remove,
//   EntitySetIterator collect uniqueness check,
//   UniqueEntityVec append-if-unique.
// Shallow lib/entity_set.sla retained (large HashMap-based).
// Fixed capacity: 8 entities.

struct EcsEsDeep {
    len: i32,
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
}

fn ecs_es_deep_new() -> EcsEsDeep {
    return EcsEsDeep {
        len: 0, e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
    };
}

fn ecs_es_deep_len(s: EcsEsDeep) -> i32 { return s.len; }
fn ecs_es_deep_is_empty(s: EcsEsDeep) -> bool {
    if s.len == 0 { return true; };
    return false;
}

fn ecs_es_deep_at(s: EcsEsDeep, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return 0;
}

fn ecs_es_deep_contains(s: EcsEsDeep, entity: i64) -> bool {
    if s.len >= 1 { if s.e0 == entity { return true; }; };
    if s.len >= 2 { if s.e1 == entity { return true; }; };
    if s.len >= 3 { if s.e2 == entity { return true; }; };
    if s.len >= 4 { if s.e3 == entity { return true; }; };
    if s.len >= 5 { if s.e4 == entity { return true; }; };
    if s.len >= 6 { if s.e5 == entity { return true; }; };
    if s.len >= 7 { if s.e6 == entity { return true; }; };
    if s.len >= 8 { if s.e7 == entity { return true; }; };
    return false;
}

// insert returns (inserted, set)
struct EcsEsInsertDeep {
    inserted: bool,
    set: EcsEsDeep,
}
fn ecs_es_insert_inserted(r: EcsEsInsertDeep) -> bool { return r.inserted; }
fn ecs_es_insert_set(r: EcsEsInsertDeep) -> EcsEsDeep { return r.set; }

fn ecs_es_deep_insert(s: EcsEsDeep, entity: i64) -> EcsEsInsertDeep {
    let n = s.len;
    let e0 = s.e0; let e1 = s.e1; let e2 = s.e2; let e3 = s.e3;
    let e4 = s.e4; let e5 = s.e5; let e6 = s.e6; let e7 = s.e7;
    let has = false;
    if n >= 1 { if e0 == entity { has = true; }; };
    if n >= 2 { if e1 == entity { has = true; }; };
    if n >= 3 { if e2 == entity { has = true; }; };
    if n >= 4 { if e3 == entity { has = true; }; };
    if n >= 5 { if e4 == entity { has = true; }; };
    if n >= 6 { if e5 == entity { has = true; }; };
    if n >= 7 { if e6 == entity { has = true; }; };
    if n >= 8 { if e7 == entity { has = true; }; };
    if has {
        return EcsEsInsertDeep { inserted: false, set: EcsEsDeep { len: n, e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 } };
    };
    if n >= 8 {
        return EcsEsInsertDeep { inserted: false, set: EcsEsDeep { len: n, e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 } };
    };
    if n == 0 { e0 = entity; };
    if n == 1 { e1 = entity; };
    if n == 2 { e2 = entity; };
    if n == 3 { e3 = entity; };
    if n == 4 { e4 = entity; };
    if n == 5 { e5 = entity; };
    if n == 6 { e6 = entity; };
    if n == 7 { e7 = entity; };
    let s2 = EcsEsDeep {
        len: n + 1, e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
    };
    return EcsEsInsertDeep { inserted: true, set: s2 };
}

// remove by entity (swap-remove style)
fn ecs_es_deep_remove(s: EcsEsDeep, entity: i64) -> EcsEsDeep {
    let idx = -1;
    let e0 = s.e0; let e1 = s.e1; let e2 = s.e2; let e3 = s.e3;
    let e4 = s.e4; let e5 = s.e5; let e6 = s.e6; let e7 = s.e7;
    let n = s.len;
    if n >= 1 { if e0 == entity { idx = 0; }; };
    if n >= 2 { if e1 == entity { idx = 1; }; };
    if n >= 3 { if e2 == entity { idx = 2; }; };
    if n >= 4 { if e3 == entity { idx = 3; }; };
    if n >= 5 { if e4 == entity { idx = 4; }; };
    if n >= 6 { if e5 == entity { idx = 5; }; };
    if n >= 7 { if e6 == entity { idx = 6; }; };
    if n >= 8 { if e7 == entity { idx = 7; }; };
    if idx < 0 {
        return EcsEsDeep { len: n, e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7 };
    };
    let last = n - 1;
    let last_e = e0;
    if last == 1 { last_e = e1; };
    if last == 2 { last_e = e2; };
    if last == 3 { last_e = e3; };
    if last == 4 { last_e = e4; };
    if last == 5 { last_e = e5; };
    if last == 6 { last_e = e6; };
    if last == 7 { last_e = e7; };
    if idx == 0 { e0 = last_e; };
    if idx == 1 { e1 = last_e; };
    if idx == 2 { e2 = last_e; };
    if idx == 3 { e3 = last_e; };
    if idx == 4 { e4 = last_e; };
    if idx == 5 { e5 = last_e; };
    if idx == 6 { e6 = last_e; };
    if idx == 7 { e7 = last_e; };
    // clear last slot
    if last == 0 { e0 = 0; };
    if last == 1 { e1 = 0; };
    if last == 2 { e2 = 0; };
    if last == 3 { e3 = 0; };
    if last == 4 { e4 = 0; };
    if last == 5 { e5 = 0; };
    if last == 6 { e6 = 0; };
    if last == 7 { e7 = 0; };
    return EcsEsDeep {
        len: last, e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
    };
}

// uniqueness check for an ordered list (EntitySetIterator property)
fn ecs_es_deep_list_is_unique(e0: i64, e1: i64, e2: i64, e3: i64, n: i32) -> bool {
    if n >= 2 { if e0 == e1 { return false; }; };
    if n >= 3 {
        if e0 == e2 { return false; };
        if e1 == e2 { return false; };
    };
    if n >= 4 {
        if e0 == e3 { return false; };
        if e1 == e3 { return false; };
        if e2 == e3 { return false; };
    };
    return true;
}

// collect_set from list: only if unique
struct EcsEsCollectDeep {
    ok: bool,
    set: EcsEsDeep,
}
fn ecs_es_collect_ok(r: EcsEsCollectDeep) -> bool { return r.ok; }
fn ecs_es_collect_set(r: EcsEsCollectDeep) -> EcsEsDeep { return r.set; }

fn ecs_es_deep_collect4(e0: i64, e1: i64, e2: i64, e3: i64, n: i32) -> EcsEsCollectDeep {
    if ecs_es_deep_list_is_unique(e0, e1, e2, e3, n) != true {
        return EcsEsCollectDeep { ok: false, set: ecs_es_deep_new() };
    };
    let s = ecs_es_deep_new();
    if n >= 1 {
        let r = ecs_es_deep_insert(s, e0);
        s = ecs_es_insert_set(r);
    };
    if n >= 2 {
        let r = ecs_es_deep_insert(s, e1);
        s = ecs_es_insert_set(r);
    };
    if n >= 3 {
        let r = ecs_es_deep_insert(s, e2);
        s = ecs_es_insert_set(r);
    };
    if n >= 4 {
        let r = ecs_es_deep_insert(s, e3);
        s = ecs_es_insert_set(r);
    };
    return EcsEsCollectDeep { ok: true, set: s };
}

// UniqueEntityVec: ordered unique list (append only if missing)
struct EcsUevDeep {
    set: EcsEsDeep,
}
fn ecs_uev_deep_new() -> EcsUevDeep {
    return EcsUevDeep { set: ecs_es_deep_new() };
}
fn ecs_uev_deep_len(v: EcsUevDeep) -> i32 { return ecs_es_deep_len(v.set); }
fn ecs_uev_deep_push(v: EcsUevDeep, entity: i64) -> EcsUevDeep {
    let r = ecs_es_deep_insert(v.set, entity);
    return EcsUevDeep { set: ecs_es_insert_set(r) };
}
fn ecs_uev_deep_contains(v: EcsUevDeep, entity: i64) -> bool {
    return ecs_es_deep_contains(v.set, entity);
}
fn ecs_uev_deep_at(v: EcsUevDeep, idx: i32) -> i64 {
    return ecs_es_deep_at(v.set, idx);
}

// EntityEquivalent wrapper: entity id is the entity
fn ecs_es_deep_entity_of(entity: i64) -> i64 { return entity; }
fn ecs_es_deep_eq(a: i64, b: i64) -> bool {
    if a == b { return true; };
    return false;
}

// intersection of two sets
fn ecs_es_deep_intersection(a: EcsEsDeep, b: EcsEsDeep) -> EcsEsDeep {
    let alen = a.len;
    let a0 = a.e0; let a1 = a.e1; let a2 = a.e2; let a3 = a.e3;
    let a4 = a.e4; let a5 = a.e5; let a6 = a.e6; let a7 = a.e7;
    let blen = b.len;
    let b0 = b.e0; let b1 = b.e1; let b2 = b.e2; let b3 = b.e3;
    let b4 = b.e4; let b5 = b.e5; let b6 = b.e6; let b7 = b.e7;
    let out = ecs_es_deep_new();
    if alen >= 1 {
        let ok = false;
        if blen >= 1 { if b0 == a0 { ok = true; }; };
        if blen >= 2 { if b1 == a0 { ok = true; }; };
        if blen >= 3 { if b2 == a0 { ok = true; }; };
        if blen >= 4 { if b3 == a0 { ok = true; }; };
        if blen >= 5 { if b4 == a0 { ok = true; }; };
        if blen >= 6 { if b5 == a0 { ok = true; }; };
        if blen >= 7 { if b6 == a0 { ok = true; }; };
        if blen >= 8 { if b7 == a0 { ok = true; }; };
        if ok {
            let r = ecs_es_deep_insert(out, a0);
            out = ecs_es_insert_set(r);
        };
    };
    if alen >= 2 {
        let ok = false;
        if blen >= 1 { if b0 == a1 { ok = true; }; };
        if blen >= 2 { if b1 == a1 { ok = true; }; };
        if blen >= 3 { if b2 == a1 { ok = true; }; };
        if blen >= 4 { if b3 == a1 { ok = true; }; };
        if blen >= 5 { if b4 == a1 { ok = true; }; };
        if blen >= 6 { if b5 == a1 { ok = true; }; };
        if blen >= 7 { if b6 == a1 { ok = true; }; };
        if blen >= 8 { if b7 == a1 { ok = true; }; };
        if ok {
            let r = ecs_es_deep_insert(out, a1);
            out = ecs_es_insert_set(r);
        };
    };
    if alen >= 3 {
        let ok = false;
        if blen >= 1 { if b0 == a2 { ok = true; }; };
        if blen >= 2 { if b1 == a2 { ok = true; }; };
        if blen >= 3 { if b2 == a2 { ok = true; }; };
        if blen >= 4 { if b3 == a2 { ok = true; }; };
        if blen >= 5 { if b4 == a2 { ok = true; }; };
        if blen >= 6 { if b5 == a2 { ok = true; }; };
        if blen >= 7 { if b6 == a2 { ok = true; }; };
        if blen >= 8 { if b7 == a2 { ok = true; }; };
        if ok {
            let r = ecs_es_deep_insert(out, a2);
            out = ecs_es_insert_set(r);
        };
    };
    if alen >= 4 {
        let ok = false;
        if blen >= 1 { if b0 == a3 { ok = true; }; };
        if blen >= 2 { if b1 == a3 { ok = true; }; };
        if blen >= 3 { if b2 == a3 { ok = true; }; };
        if blen >= 4 { if b3 == a3 { ok = true; }; };
        if blen >= 5 { if b4 == a3 { ok = true; }; };
        if blen >= 6 { if b5 == a3 { ok = true; }; };
        if blen >= 7 { if b6 == a3 { ok = true; }; };
        if blen >= 8 { if b7 == a3 { ok = true; }; };
        if ok {
            let r = ecs_es_deep_insert(out, a3);
            out = ecs_es_insert_set(r);
        };
    };
    return out;
}
