// Deepened Bevy ECS deferred command queue for the hierarchy (ChildOf / Children) facade.
// (shallow lib/hierarchy_commands.sla deep;
//  src/hierarchy.rs EntityCommands / EntityWorldMut pub methods on ChildOf.)
//
// Mirrors the shallow GenericHierarchyCommands queue but replaces the inner
// RelationshipCommands (generic Vec<RelationshipCommand> + Vec<RelationshipCommandEntityList>
// pool + boxed entity lists) with a fixed-cap-8 kind-discriminated command queue and a
// parallel cap-8x cap-4 entity-list pool. Avoids generic types, Vec, and boxed lists.
//
// Kinds (mirror shallow pub method surface on EntityCommands/EntityWorldMut for ChildOf):
//   ADD_CHILD=1, INSERT_CHILD=2, DETACH_CHILD=3, DETACH_ALL_CHILDREN=4,
//   REPLACE_CHILDREN=5, REPLACE_DIFF=6, DESPAWN_CHILDREN=7, DESPAWN=8.
// ADD_CHILD / INSERT_CHILD / DETACH_CHILD carry a single primary child (slot field) +
// (INSERT_CHILD only) an insertion index. REPLACE_CHILDREN references one list (ridx).
// REPLACE_DIFF references three lists (uidx unrelate / ridx relate / nidx newly).
// DETACH_ALL_CHILDREN / DESPAWN_CHILDREN / DESPAWN carry no side payload.
//
// Critical SLA constraints observed (see progress.md / tasks.md cookbook):
//  - field-assign on struct-by-value params is SLA-legal on SA (Batch 374); set_slot uses
//    the flat `if idx == N { c.kN = k; ...; };` form. Per Batch 378 finding, SA SWALLOWS
//    `buf = some_fn(buf, x)` inside `if cond { ... }` and `while` bodies, so accumulators
//    use flat `let`-ladders + short-circuit _push_when helpers.
//  - Tuple-return callsites replaced with wrapper structs (Batch 373 avoidance rule):
//    EcsHierCmdApplyDeep { world, commands } for apply, accessed via scalar wrappers.
//  - Avoid `let _ = x;` (SA rejects) and struct-literal-in-tests with non-trivial init.

const ECS_HIER_CAP_DEEP: i32 = 8;
const ECS_HIER_LIST_CAP_DEEP: i32 = 4;

const ECS_HIER_ADD_CHILD: i32 = 1;
const ECS_HIER_INSERT_CHILD: i32 = 2;
const ECS_HIER_DETACH_CHILD: i32 = 3;
const ECS_HIER_DETACH_ALL_CHILDREN: i32 = 4;
const ECS_HIER_REPLACE_CHILDREN: i32 = 5;
const ECS_HIER_REPLACE_DIFF: i32 = 6;
const ECS_HIER_DESPAWN_CHILDREN: i32 = 7;
const ECS_HIER_DESPAWN: i32 = 8;

// Result wrapper for apply (avoids tuple-return destructuring in tests -- Batch 373 rule).
struct EcsHierCmdApplyDeep {
    world: EcsHierWorldDeep,
    commands: EcsHierCmdStateDeep,
}

fn ecs_hier_cmd_apply_world(r: EcsHierCmdApplyDeep) -> EcsHierWorldDeep { return r.world; }
fn ecs_hier_cmd_apply_commands(r: EcsHierCmdApplyDeep) -> EcsHierCmdStateDeep { return r.commands; }

// Result wrapper for reserve_entity / spawn_child (avoids tuple-return destructuring).
struct EcsHierReserveDeep {
    world: EcsHierWorldDeep,
    commands: EcsHierCmdsDeep,
    entity: i64,
}

fn ecs_hier_reserve_world(r: EcsHierReserveDeep) -> EcsHierWorldDeep { return r.world; }
fn ecs_hier_reserve_commands(r: EcsHierReserveDeep) -> EcsHierCmdsDeep { return r.commands; }
fn ecs_hier_reserve_entity(r: EcsHierReserveDeep) -> i64 { return r.entity; }

// ── Hierarchy world (parent → children) ─────────────────────────────────────
// cap-8 parents × cap-4 children. parent_id0..7 i64, child lists ch0_0..ch0_3 .. ch7_0..ch7_3,
// per-parent counts cnt0..7 i32, slot_count i32, plus an alive bit per entity in an alive0..7 i64
// ring (entity ids 1..8 → slot 0..7) tracked lazily; despawn marks alive=0.
struct EcsHierWorldDeep {
    par0: i64, par1: i64, par2: i64, par3: i64, par4: i64, par5: i64, par6: i64, par7: i64,
    cnt0: i32, cnt1: i32, cnt2: i32, cnt3: i32, cnt4: i32, cnt5: i32, cnt6: i32, cnt7: i32,
    ch0_0: i64, ch0_1: i64, ch0_2: i64, ch0_3: i64,
    ch1_0: i64, ch1_1: i64, ch1_2: i64, ch1_3: i64,
    ch2_0: i64, ch2_1: i64, ch2_2: i64, ch2_3: i64,
    ch3_0: i64, ch3_1: i64, ch3_2: i64, ch3_3: i64,
    ch4_0: i64, ch4_1: i64, ch4_2: i64, ch4_3: i64,
    ch5_0: i64, ch5_1: i64, ch5_2: i64, ch5_3: i64,
    ch6_0: i64, ch6_1: i64, ch6_2: i64, ch6_3: i64,
    ch7_0: i64, ch7_1: i64, ch7_2: i64, ch7_3: i64,
    slot_count: i32,
    next_entity: i64,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32, alive4: i32, alive5: i32, alive6: i32, alive7: i32,
}

fn ecs_hier_world_deep_new() -> EcsHierWorldDeep {
    let w = EcsHierWorldDeep {
        par0: -1, par1: -1, par2: -1, par3: -1, par4: -1, par5: -1, par6: -1, par7: -1,
        cnt0: 0, cnt1: 0, cnt2: 0, cnt3: 0, cnt4: 0, cnt5: 0, cnt6: 0, cnt7: 0,
        ch0_0: 0, ch0_1: 0, ch0_2: 0, ch0_3: 0,
        ch1_0: 0, ch1_1: 0, ch1_2: 0, ch1_3: 0,
        ch2_0: 0, ch2_1: 0, ch2_2: 0, ch2_3: 0,
        ch3_0: 0, ch3_1: 0, ch3_2: 0, ch3_3: 0,
        ch4_0: 0, ch4_1: 0, ch4_2: 0, ch4_3: 0,
        ch5_0: 0, ch5_1: 0, ch5_2: 0, ch5_3: 0,
        ch6_0: 0, ch6_1: 0, ch6_2: 0, ch6_3: 0,
        ch7_0: 0, ch7_1: 0, ch7_2: 0, ch7_3: 0,
        slot_count: 0,
        next_entity: 1,
        alive0: 0, alive1: 0, alive2: 0, alive3: 0, alive4: 0, alive5: 0, alive6: 0, alive7: 0,
    };
    return w;
}

fn _ecs_hier_world_deep_alived_index(w: EcsHierWorldDeep, e: i64) -> i32 {
    if e == 1 { return w.alive0; };
    if e == 2 { return w.alive1; };
    if e == 3 { return w.alive2; };
    if e == 4 { return w.alive3; };
    if e == 5 { return w.alive4; };
    if e == 6 { return w.alive5; };
    if e == 7 { return w.alive6; };
    if e == 8 { return w.alive7; };
    return 0;
}

fn ecs_hier_world_deep_is_alive(w: EcsHierWorldDeep, e: i64) -> bool {
    return _ecs_hier_world_deep_alived_index(w, e) == 1;
}

// ── Deferred command queue (cap-8) ──────────────────────────────────────────
struct EcsHierCmdsDeep {
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    t0: i64, t1: i64, t2: i64, t3: i64, t4: i64, t5: i64, t6: i64, t7: i64,
    c0: i64, c1: i64, c2: i64, c3: i64, c4: i64, c5: i64, c6: i64, c7: i64,
    i0: i32, i1: i32, i2: i32, i3: i32, i4: i32, i5: i32, i6: i32, i7: i32,
    u0: i32, u1: i32, u2: i32, u3: i32, u4: i32, u5: i32, u6: i32, u7: i32,
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    n0: i32, n1: i32, n2: i32, n3: i32, n4: i32, n5: i32, n6: i32, n7: i32,
    count: i32,
}

fn ecs_hier_commands_deep_new() -> EcsHierCmdsDeep {
    let c = EcsHierCmdsDeep {
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        t0: -1, t1: -1, t2: -1, t3: -1, t4: -1, t5: -1, t6: -1, t7: -1,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        i0: 0, i1: 0, i2: 0, i3: 0, i4: 0, i5: 0, i6: 0, i7: 0,
        u0: -1, u1: -1, u2: -1, u3: -1, u4: -1, u5: -1, u6: -1, u7: -1,
        r0: -1, r1: -1, r2: -1, r3: -1, r4: -1, r5: -1, r6: -1, r7: -1,
        n0: -1, n1: -1, n2: -1, n3: -1, n4: -1, n5: -1, n6: -1, n7: -1,
        count: 0,
    };
    return c;
}

fn ecs_hier_commands_deep_len(c: EcsHierCmdsDeep) -> i32 { return c.count; }

fn ecs_hier_commands_deep_kind_at(c: EcsHierCmdsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.k0; };
    if idx == 1 { return c.k1; };
    if idx == 2 { return c.k2; };
    if idx == 3 { return c.k3; };
    if idx == 4 { return c.k4; };
    if idx == 5 { return c.k5; };
    if idx == 6 { return c.k6; };
    return c.k7;
}

fn ecs_hier_commands_deep_target_at(c: EcsHierCmdsDeep, idx: i32) -> i64 {
    if idx == 0 { return c.t0; };
    if idx == 1 { return c.t1; };
    if idx == 2 { return c.t2; };
    if idx == 3 { return c.t3; };
    if idx == 4 { return c.t4; };
    if idx == 5 { return c.t5; };
    if idx == 6 { return c.t6; };
    return c.t7;
}

fn ecs_hier_commands_deep_child_at(c: EcsHierCmdsDeep, idx: i32) -> i64 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    return c.c7;
}

fn ecs_hier_commands_deep_index_at(c: EcsHierCmdsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.i0; };
    if idx == 1 { return c.i1; };
    if idx == 2 { return c.i2; };
    if idx == 3 { return c.i3; };
    if idx == 4 { return c.i4; };
    if idx == 5 { return c.i5; };
    if idx == 6 { return c.i6; };
    return c.i7;
}

fn ecs_hier_commands_deep_uidx_at(c: EcsHierCmdsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.u0; };
    if idx == 1 { return c.u1; };
    if idx == 2 { return c.u2; };
    if idx == 3 { return c.u3; };
    if idx == 4 { return c.u4; };
    if idx == 5 { return c.u5; };
    if idx == 6 { return c.u6; };
    return c.u7;
}

fn ecs_hier_commands_deep_ridx_at(c: EcsHierCmdsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.r0; };
    if idx == 1 { return c.r1; };
    if idx == 2 { return c.r2; };
    if idx == 3 { return c.r3; };
    if idx == 4 { return c.r4; };
    if idx == 5 { return c.r5; };
    if idx == 6 { return c.r6; };
    return c.r7;
}

fn ecs_hier_commands_deep_nidx_at(c: EcsHierCmdsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.n0; };
    if idx == 1 { return c.n1; };
    if idx == 2 { return c.n2; };
    if idx == 3 { return c.n3; };
    if idx == 4 { return c.n4; };
    if idx == 5 { return c.n5; };
    if idx == 6 { return c.n6; };
    return c.n7;
}

// ── Entity-list pool (cap-8 lists × cap-4 entities) ─────────────────────────
struct EcsHierListPoolDeep {
    e0_0: i64, e0_1: i64, e0_2: i64, e0_3: i64,
    e1_0: i64, e1_1: i64, e1_2: i64, e1_3: i64,
    e2_0: i64, e2_1: i64, e2_2: i64, e2_3: i64,
    e3_0: i64, e3_1: i64, e3_2: i64, e3_3: i64,
    e4_0: i64, e4_1: i64, e4_2: i64, e4_3: i64,
    e5_0: i64, e5_1: i64, e5_2: i64, e5_3: i64,
    e6_0: i64, e6_1: i64, e6_2: i64, e6_3: i64,
    e7_0: i64, e7_1: i64, e7_2: i64, e7_3: i64,
    n0: i32, n1: i32, n2: i32, n3: i32, n4: i32, n5: i32, n6: i32, n7: i32,
    pool_count: i32,
}

fn ecs_hier_list_pool_deep_new() -> EcsHierListPoolDeep {
    let p = EcsHierListPoolDeep {
        e0_0: 0, e0_1: 0, e0_2: 0, e0_3: 0,
        e1_0: 0, e1_1: 0, e1_2: 0, e1_3: 0,
        e2_0: 0, e2_1: 0, e2_2: 0, e2_3: 0,
        e3_0: 0, e3_1: 0, e3_2: 0, e3_3: 0,
        e4_0: 0, e4_1: 0, e4_2: 0, e4_3: 0,
        e5_0: 0, e5_1: 0, e5_2: 0, e5_3: 0,
        e6_0: 0, e6_1: 0, e6_2: 0, e6_3: 0,
        e7_0: 0, e7_1: 0, e7_2: 0, e7_3: 0,
        n0: 0, n1: 0, n2: 0, n3: 0, n4: 0, n5: 0, n6: 0, n7: 0,
        pool_count: 0,
    };
    return p;
}

fn _ecs_hier_list_pool_deep_push_slot(p: EcsHierListPoolDeep, list_idx: i32, e: i64) -> EcsHierListPoolDeep {
    if list_idx == 0 {
        if p.n0 == 0 { p.e0_0 = e; p.n0 = 1; return p; };
        if p.n0 == 1 { p.e0_1 = e; p.n0 = 2; return p; };
        if p.n0 == 2 { p.e0_2 = e; p.n0 = 3; return p; };
        if p.n0 == 3 { p.e0_3 = e; p.n0 = 4; return p; };
        return p;
    };
    if list_idx == 1 {
        if p.n1 == 0 { p.e1_0 = e; p.n1 = 1; return p; };
        if p.n1 == 1 { p.e1_1 = e; p.n1 = 2; return p; };
        if p.n1 == 2 { p.e1_2 = e; p.n1 = 3; return p; };
        if p.n1 == 3 { p.e1_3 = e; p.n1 = 4; return p; };
        return p;
    };
    if list_idx == 2 {
        if p.n2 == 0 { p.e2_0 = e; p.n2 = 1; return p; };
        if p.n2 == 1 { p.e2_1 = e; p.n2 = 2; return p; };
        if p.n2 == 2 { p.e2_2 = e; p.n2 = 3; return p; };
        if p.n2 == 3 { p.e2_3 = e; p.n2 = 4; return p; };
        return p;
    };
    if list_idx == 3 {
        if p.n3 == 0 { p.e3_0 = e; p.n3 = 1; return p; };
        if p.n3 == 1 { p.e3_1 = e; p.n3 = 2; return p; };
        if p.n3 == 2 { p.e3_2 = e; p.n3 = 3; return p; };
        if p.n3 == 3 { p.e3_3 = e; p.n3 = 4; return p; };
        return p;
    };
    if list_idx == 4 {
        if p.n4 == 0 { p.e4_0 = e; p.n4 = 1; return p; };
        if p.n4 == 1 { p.e4_1 = e; p.n4 = 2; return p; };
        if p.n4 == 2 { p.e4_2 = e; p.n4 = 3; return p; };
        if p.n4 == 3 { p.e4_3 = e; p.n4 = 4; return p; };
        return p;
    };
    if list_idx == 5 {
        if p.n5 == 0 { p.e5_0 = e; p.n5 = 1; return p; };
        if p.n5 == 1 { p.e5_1 = e; p.n5 = 2; return p; };
        if p.n5 == 2 { p.e5_2 = e; p.n5 = 3; return p; };
        if p.n5 == 3 { p.e5_3 = e; p.n5 = 4; return p; };
        return p;
    };
    if list_idx == 6 {
        if p.n6 == 0 { p.e6_0 = e; p.n6 = 1; return p; };
        if p.n6 == 1 { p.e6_1 = e; p.n6 = 2; return p; };
        if p.n6 == 2 { p.e6_2 = e; p.n6 = 3; return p; };
        if p.n6 == 3 { p.e6_3 = e; p.n6 = 4; return p; };
        return p;
    };
    if p.n7 == 0 { p.e7_0 = e; p.n7 = 1; return p; };
    if p.n7 == 1 { p.e7_1 = e; p.n7 = 2; return p; };
    if p.n7 == 2 { p.e7_2 = e; p.n7 = 3; return p; };
    if p.n7 == 3 { p.e7_3 = e; p.n7 = 4; return p; };
    return p;
}

fn _ecs_hier_list_pool_deep_len(p: EcsHierListPoolDeep, list_idx: i32) -> i32 {
    if list_idx == 0 { return p.n0; };
    if list_idx == 1 { return p.n1; };
    if list_idx == 2 { return p.n2; };
    if list_idx == 3 { return p.n3; };
    if list_idx == 4 { return p.n4; };
    if list_idx == 5 { return p.n5; };
    if list_idx == 6 { return p.n6; };
    return p.n7;
}

fn _ecs_hier_list_pool_deep_at(p: EcsHierListPoolDeep, list_idx: i32, k: i32) -> i64 {
    if list_idx == 0 {
        if k == 0 { return p.e0_0; };
        if k == 1 { return p.e0_1; };
        if k == 2 { return p.e0_2; };
        return p.e0_3;
    };
    if list_idx == 1 {
        if k == 0 { return p.e1_0; };
        if k == 1 { return p.e1_1; };
        if k == 2 { return p.e1_2; };
        return p.e1_3;
    };
    if list_idx == 2 {
        if k == 0 { return p.e2_0; };
        if k == 1 { return p.e2_1; };
        if k == 2 { return p.e2_2; };
        return p.e2_3;
    };
    if list_idx == 3 {
        if k == 0 { return p.e3_0; };
        if k == 1 { return p.e3_1; };
        if k == 2 { return p.e3_2; };
        return p.e3_3;
    };
    if list_idx == 4 {
        if k == 0 { return p.e4_0; };
        if k == 1 { return p.e4_1; };
        if k == 2 { return p.e4_2; };
        return p.e4_3;
    };
    if list_idx == 5 {
        if k == 0 { return p.e5_0; };
        if k == 1 { return p.e5_1; };
        if k == 2 { return p.e5_2; };
        return p.e5_3;
    };
    if list_idx == 6 {
        if k == 0 { return p.e6_0; };
        if k == 1 { return p.e6_1; };
        if k == 2 { return p.e6_2; };
        return p.e6_3;
    };
    if k == 0 { return p.e7_0; };
    if k == 1 { return p.e7_1; };
    if k == 2 { return p.e7_2; };
    return p.e7_3;
}

fn _ecs_hier_list_pool_deep_alloc(p: EcsHierListPoolDeep) -> EcsHierListPoolDeep {
    // Allocate a new list slot by bumping pool_count — caller then pushes entities into it.
    if p.pool_count < ECS_HIER_CAP_DEEP { p.pool_count = p.pool_count + 1; };
    return p;
}

// ── Combined command state (queue + list pool) ──────────────────────────────
// SA structs pass by value; queue + pool must be updated together so each push command
// returns one struct that both the apply walker and tests observe.
struct EcsHierCmdStateDeep {
    queue: EcsHierCmdsDeep,
    pool: EcsHierListPoolDeep,
}

fn ecs_hier_cmd_state_deep_new() -> EcsHierCmdStateDeep {
    let s = EcsHierCmdStateDeep {
        queue: ecs_hier_commands_deep_new(),
        pool: ecs_hier_list_pool_deep_new(),
    };
    return s;
}

fn ecs_hier_cmd_state_deep_len(s: EcsHierCmdStateDeep) -> i32 { return ecs_hier_commands_deep_len(s.queue); }
fn ecs_hier_cmd_state_deep_kind_at(s: EcsHierCmdStateDeep, idx: i32) -> i32 { return ecs_hier_commands_deep_kind_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_target_at(s: EcsHierCmdStateDeep, idx: i32) -> i64 { return ecs_hier_commands_deep_target_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_child_at(s: EcsHierCmdStateDeep, idx: i32) -> i64 { return ecs_hier_commands_deep_child_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_index_at(s: EcsHierCmdStateDeep, idx: i32) -> i32 { return ecs_hier_commands_deep_index_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_uidx_at(s: EcsHierCmdStateDeep, idx: i32) -> i32 { return ecs_hier_commands_deep_uidx_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_ridx_at(s: EcsHierCmdStateDeep, idx: i32) -> i32 { return ecs_hier_commands_deep_ridx_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_nidx_at(s: EcsHierCmdStateDeep, idx: i32) -> i32 { return ecs_hier_commands_deep_nidx_at(s.queue, idx); }
fn ecs_hier_cmd_state_deep_list_len(s: EcsHierCmdStateDeep, list_idx: i32) -> i32 { return _ecs_hier_list_pool_deep_len(s.pool, list_idx); }
fn ecs_hier_cmd_state_deep_list_at(s: EcsHierCmdStateDeep, list_idx: i32, k: i32) -> i64 { return _ecs_hier_list_pool_deep_at(s.pool, list_idx, k); }

// Single-slot set on the queue portion (field-assign on struct-by-value; Batch 374/366 form).
fn _ecs_hier_cmds_deep_set_slot(q: EcsHierCmdsDeep, idx: i32, k: i32, t: i64, ch: i64, ins: i32, u: i32, r: i32, n: i32) -> EcsHierCmdsDeep {
    if idx == 0 { q.k0 = k; q.t0 = t; q.c0 = ch; q.i0 = ins; q.u0 = u; q.r0 = r; q.n0 = n; return q; };
    if idx == 1 { q.k1 = k; q.t1 = t; q.c1 = ch; q.i1 = ins; q.u1 = u; q.r1 = r; q.n1 = n; return q; };
    if idx == 2 { q.k2 = k; q.t2 = t; q.c2 = ch; q.i2 = ins; q.u2 = u; q.r2 = r; q.n2 = n; return q; };
    if idx == 3 { q.k3 = k; q.t3 = t; q.c3 = ch; q.i3 = ins; q.u3 = u; q.r3 = r; q.n3 = n; return q; };
    if idx == 4 { q.k4 = k; q.t4 = t; q.c4 = ch; q.i4 = ins; q.u4 = u; q.r4 = r; q.n4 = n; return q; };
    if idx == 5 { q.k5 = k; q.t5 = t; q.c5 = ch; q.i5 = ins; q.u5 = u; q.r5 = r; q.n5 = n; return q; };
    if idx == 6 { q.k6 = k; q.t6 = t; q.c6 = ch; q.i6 = ins; q.u6 = u; q.r6 = r; q.n6 = n; return q; };
    q.k7 = k; q.t7 = t; q.c7 = ch; q.i7 = ins; q.u7 = u; q.r7 = r; q.n7 = n;
    return q;
}

// ── Public push commands ────────────────────────────────────────────────────
// Each mirrors a src/hierarchy.rs EntityCommands/EntityWorldMut pub method on ChildOf.
// Cap-8 reject is silent (state unchanged) per the shallow `if cmd_count >= CAP { return s; }` guards.

fn ecs_hier_cmds_deep_add_child(s: EcsHierCmdStateDeep, parent: i64, child: i64) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_ADD_CHILD, parent, child, 0, -1, -1, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_insert_child(s: EcsHierCmdStateDeep, parent: i64, index: i32, child: i64) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_INSERT_CHILD, parent, child, index, -1, -1, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_detach_child(s: EcsHierCmdStateDeep, parent: i64, child: i64) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_DETACH_CHILD, parent, child, 0, -1, -1, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_detach_all_children(s: EcsHierCmdStateDeep, parent: i64) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_DETACH_ALL_CHILDREN, parent, 0, 0, -1, -1, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_replace_children(s: EcsHierCmdStateDeep, parent: i64, ridx: i32) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_REPLACE_CHILDREN, parent, 0, 0, -1, ridx, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_replace_diff(s: EcsHierCmdStateDeep, parent: i64, uidx: i32, ridx: i32, nidx: i32) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_REPLACE_DIFF, parent, 0, 0, uidx, ridx, nidx);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_despawn_children(s: EcsHierCmdStateDeep, parent: i64) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_DESPAWN_CHILDREN, parent, 0, 0, -1, -1, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

fn ecs_hier_cmds_deep_despawn(s: EcsHierCmdStateDeep, entity: i64) -> EcsHierCmdStateDeep {
    if s.queue.count >= ECS_HIER_CAP_DEEP { return s; };
    let q = _ecs_hier_cmds_deep_set_slot(s.queue, s.queue.count, ECS_HIER_DESPAWN, entity, 0, 0, -1, -1, -1);
    q.count = q.count + 1;
    s.queue = q;
    return s;
}

// ── List-pool push helper (push entity into a freshly-allocated list slot) ───
fn ecs_hier_cmds_deep_push_list_entity(s: EcsHierCmdStateDeep, list_idx: i32, e: i64) -> EcsHierCmdStateDeep {
    let p = _ecs_hier_list_pool_deep_push_slot(s.pool, list_idx, e);
    s.pool = p;
    return s;
}

fn ecs_hier_cmds_deep_alloc_list(s: EcsHierCmdStateDeep) -> EcsHierCmdStateDeep {
    let p = _ecs_hier_list_pool_deep_alloc(s.pool);
    s.pool = p;
    return s;
}

// ── World mutation helpers (struct-by-value field-assign — Batch 374 form) ──

fn _ecs_hier_world_deep_set_alive(w: EcsHierWorldDeep, e: i64, v: i32) -> EcsHierWorldDeep {
    if e == 1 { w.alive0 = v; return w; };
    if e == 2 { w.alive1 = v; return w; };
    if e == 3 { w.alive2 = v; return w; };
    if e == 4 { w.alive3 = v; return w; };
    if e == 5 { w.alive4 = v; return w; };
    if e == 6 { w.alive5 = v; return w; };
    if e == 7 { w.alive6 = v; return w; };
    if e == 8 { w.alive7 = v; return w; };
    return w;
}

fn ecs_hier_world_deep_spawn(w: EcsHierWorldDeep) -> (EcsHierWorldDeep, i64) {
    let e = w.next_entity;
    w.next_entity = w.next_entity + 1;
    w = _ecs_hier_world_deep_set_alive(w, e, 1);
    return (w, e);
}

fn _ecs_hier_world_deep_parent_index(w: EcsHierWorldDeep, parent: i64) -> i32 {
    if w.par0 == parent { return 0; };
    if w.par1 == parent { return 1; };
    if w.par2 == parent { return 2; };
    if w.par3 == parent { return 3; };
    if w.par4 == parent { return 4; };
    if w.par5 == parent { return 5; };
    if w.par6 == parent { return 6; };
    if w.par7 == parent { return 7; };
    return -1;
}

// Append a child to parent's list — cascade-of-return (Batch 377 shape) inside each parent slot.
fn _ecs_hier_world_deep_add_child_into(w: EcsHierWorldDeep, idx: i32, child: i64) -> EcsHierWorldDeep {
    if idx == 0 {
        if w.cnt0 == 0 { w.ch0_0 = child; w.cnt0 = 1; return w; };
        if w.cnt0 == 1 { w.ch0_1 = child; w.cnt0 = 2; return w; };
        if w.cnt0 == 2 { w.ch0_2 = child; w.cnt0 = 3; return w; };
        if w.cnt0 == 3 { w.ch0_3 = child; w.cnt0 = 4; return w; };
        return w;
    };
    if idx == 1 {
        if w.cnt1 == 0 { w.ch1_0 = child; w.cnt1 = 1; return w; };
        if w.cnt1 == 1 { w.ch1_1 = child; w.cnt1 = 2; return w; };
        if w.cnt1 == 2 { w.ch1_2 = child; w.cnt1 = 3; return w; };
        if w.cnt1 == 3 { w.ch1_3 = child; w.cnt1 = 4; return w; };
        return w;
    };
    if idx == 2 {
        if w.cnt2 == 0 { w.ch2_0 = child; w.cnt2 = 1; return w; };
        if w.cnt2 == 1 { w.ch2_1 = child; w.cnt2 = 2; return w; };
        if w.cnt2 == 2 { w.ch2_2 = child; w.cnt2 = 3; return w; };
        if w.cnt2 == 3 { w.ch2_3 = child; w.cnt2 = 4; return w; };
        return w;
    };
    if idx == 3 {
        if w.cnt3 == 0 { w.ch3_0 = child; w.cnt3 = 1; return w; };
        if w.cnt3 == 1 { w.ch3_1 = child; w.cnt3 = 2; return w; };
        if w.cnt3 == 2 { w.ch3_2 = child; w.cnt3 = 3; return w; };
        if w.cnt3 == 3 { w.ch3_3 = child; w.cnt3 = 4; return w; };
        return w;
    };
    if idx == 4 {
        if w.cnt4 == 0 { w.ch4_0 = child; w.cnt4 = 1; return w; };
        if w.cnt4 == 1 { w.ch4_1 = child; w.cnt4 = 2; return w; };
        if w.cnt4 == 2 { w.ch4_2 = child; w.cnt4 = 3; return w; };
        if w.cnt4 == 3 { w.ch4_3 = child; w.cnt4 = 4; return w; };
        return w;
    };
    if idx == 5 {
        if w.cnt5 == 0 { w.ch5_0 = child; w.cnt5 = 1; return w; };
        if w.cnt5 == 1 { w.ch5_1 = child; w.cnt5 = 2; return w; };
        if w.cnt5 == 2 { w.ch5_2 = child; w.cnt5 = 3; return w; };
        if w.cnt5 == 3 { w.ch5_3 = child; w.cnt5 = 4; return w; };
        return w;
    };
    if idx == 6 {
        if w.cnt6 == 0 { w.ch6_0 = child; w.cnt6 = 1; return w; };
        if w.cnt6 == 1 { w.ch6_1 = child; w.cnt6 = 2; return w; };
        if w.cnt6 == 2 { w.ch6_2 = child; w.cnt6 = 3; return w; };
        if w.cnt6 == 3 { w.ch6_3 = child; w.cnt6 = 4; return w; };
        return w;
    };
    if w.cnt7 == 0 { w.ch7_0 = child; w.cnt7 = 1; return w; };
    if w.cnt7 == 1 { w.ch7_1 = child; w.cnt7 = 2; return w; };
    if w.cnt7 == 2 { w.ch7_2 = child; w.cnt7 = 3; return w; };
    if w.cnt7 == 3 { w.ch7_3 = child; w.cnt7 = 4; return w; };
    return w;
}

fn _ecs_hier_world_deep_set_parent_slot(w: EcsHierWorldDeep, idx: i32, parent: i64) -> EcsHierWorldDeep {
    if idx == 0 { w.par0 = parent; return w; };
    if idx == 1 { w.par1 = parent; return w; };
    if idx == 2 { w.par2 = parent; return w; };
    if idx == 3 { w.par3 = parent; return w; };
    if idx == 4 { w.par4 = parent; return w; };
    if idx == 5 { w.par5 = parent; return w; };
    if idx == 6 { w.par6 = parent; return w; };
    w.par7 = parent;
    return w;
}

fn _ecs_hier_world_deep_register_parent(w: EcsHierWorldDeep, parent: i64) -> EcsHierWorldDeep {
    let idx = _ecs_hier_world_deep_parent_index(w, parent);
    if idx >= 0 { return w; };
    if w.slot_count < ECS_HIER_CAP_DEEP {
        let slot = w.slot_count;
        w = _ecs_hier_world_deep_set_parent_slot(w, slot, parent);
        w.slot_count = w.slot_count + 1;
    };
    return w;
}

fn _ecs_hier_world_deep_child_count_slot(w: EcsHierWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cnt0; };
    if idx == 1 { return w.cnt1; };
    if idx == 2 { return w.cnt2; };
    if idx == 3 { return w.cnt3; };
    if idx == 4 { return w.cnt4; };
    if idx == 5 { return w.cnt5; };
    if idx == 6 { return w.cnt6; };
    return w.cnt7;
}

fn _ecs_hier_world_deep_child_slot_at(w: EcsHierWorldDeep, idx: i32, k: i32) -> i64 {
    if idx == 0 {
        if k == 0 { return w.ch0_0; };
        if k == 1 { return w.ch0_1; };
        if k == 2 { return w.ch0_2; };
        return w.ch0_3;
    };
    if idx == 1 {
        if k == 0 { return w.ch1_0; };
        if k == 1 { return w.ch1_1; };
        if k == 2 { return w.ch1_2; };
        return w.ch1_3;
    };
    if idx == 2 {
        if k == 0 { return w.ch2_0; };
        if k == 1 { return w.ch2_1; };
        if k == 2 { return w.ch2_2; };
        return w.ch2_3;
    };
    if idx == 3 {
        if k == 0 { return w.ch3_0; };
        if k == 1 { return w.ch3_1; };
        if k == 2 { return w.ch3_2; };
        return w.ch3_3;
    };
    if idx == 4 {
        if k == 0 { return w.ch4_0; };
        if k == 1 { return w.ch4_1; };
        if k == 2 { return w.ch4_2; };
        return w.ch4_3;
    };
    if idx == 5 {
        if k == 0 { return w.ch5_0; };
        if k == 1 { return w.ch5_1; };
        if k == 2 { return w.ch5_2; };
        return w.ch5_3;
    };
    if idx == 6 {
        if k == 0 { return w.ch6_0; };
        if k == 1 { return w.ch6_1; };
        if k == 2 { return w.ch6_2; };
        return w.ch6_3;
    };
    if k == 0 { return w.ch7_0; };
    if k == 1 { return w.ch7_1; };
    if k == 2 { return w.ch7_2; };
    return w.ch7_3;
}

fn ecs_hier_world_deep_child_count(w: EcsHierWorldDeep, parent: i64) -> i32 {
    let idx = _ecs_hier_world_deep_parent_index(w, parent);
    if idx < 0 { return 0; };
    return _ecs_hier_world_deep_child_count_slot(w, idx);
}

fn ecs_hier_world_deep_child_at(w: EcsHierWorldDeep, parent: i64, k: i32) -> i64 {
    let idx = _ecs_hier_world_deep_parent_index(w, parent);
    if idx < 0 { return 0; };
    if k < 0 { return 0; };
    let cnt = _ecs_hier_world_deep_child_count_slot(w, idx);
    if k >= cnt { return 0; };
    return _ecs_hier_world_deep_child_slot_at(w, idx, k);
}

fn ecs_hier_world_deep_has_parent(w: EcsHierWorldDeep, child: i64) -> bool {
    // Walk every registered parent's child list for the entity.
    if w.par0 != -1 {
        if w.cnt0 > 0 {
            if w.ch0_0 == child { return true; };
            if w.cnt0 > 1 { if w.ch0_1 == child { return true; }; };
            if w.cnt0 > 2 { if w.ch0_2 == child { return true; }; };
            if w.cnt0 > 3 { if w.ch0_3 == child { return true; }; };
        };
    };
    if w.par1 != -1 {
        if w.cnt1 > 0 {
            if w.ch1_0 == child { return true; };
            if w.cnt1 > 1 { if w.ch1_1 == child { return true; }; };
            if w.cnt1 > 2 { if w.ch1_2 == child { return true; }; };
            if w.cnt1 > 3 { if w.ch1_3 == child { return true; }; };
        };
    };
    if w.par2 != -1 {
        if w.cnt2 > 0 {
            if w.ch2_0 == child { return true; };
            if w.cnt2 > 1 { if w.ch2_1 == child { return true; }; };
            if w.cnt2 > 2 { if w.ch2_2 == child { return true; }; };
            if w.cnt2 > 3 { if w.ch2_3 == child { return true; }; };
        };
    };
    if w.par3 != -1 {
        if w.cnt3 > 0 {
            if w.ch3_0 == child { return true; };
            if w.cnt3 > 1 { if w.ch3_1 == child { return true; }; };
            if w.cnt3 > 2 { if w.ch3_2 == child { return true; }; };
            if w.cnt3 > 3 { if w.ch3_3 == child { return true; }; };
        };
    };
    if w.par4 != -1 {
        if w.cnt4 > 0 {
            if w.ch4_0 == child { return true; };
            if w.cnt4 > 1 { if w.ch4_1 == child { return true; }; };
            if w.cnt4 > 2 { if w.ch4_2 == child { return true; }; };
            if w.cnt4 > 3 { if w.ch4_3 == child { return true; }; };
        };
    };
    if w.par5 != -1 {
        if w.cnt5 > 0 {
            if w.ch5_0 == child { return true; };
            if w.cnt5 > 1 { if w.ch5_1 == child { return true; }; };
            if w.cnt5 > 2 { if w.ch5_2 == child { return true; }; };
            if w.cnt5 > 3 { if w.ch5_3 == child { return true; }; };
        };
    };
    if w.par6 != -1 {
        if w.cnt6 > 0 {
            if w.ch6_0 == child { return true; };
            if w.cnt6 > 1 { if w.ch6_1 == child { return true; }; };
            if w.cnt6 > 2 { if w.ch6_2 == child { return true; }; };
            if w.cnt6 > 3 { if w.ch6_3 == child { return true; }; };
        };
    };
    if w.par7 != -1 {
        if w.cnt7 > 0 {
            if w.ch7_0 == child { return true; };
            if w.cnt7 > 1 { if w.ch7_1 == child { return true; }; };
            if w.cnt7 > 2 { if w.ch7_2 == child { return true; }; };
            if w.cnt7 > 3 { if w.ch7_3 == child { return true; }; };
        };
    };
    return false;
}

// ── World mutations (insert / remove / replace / clear / despawn) ───────────
// Each operates on a parent slot idx. Cascade-of-return within branches.

fn _ecs_hier_world_deep_clear_slot(w: EcsHierWorldDeep, idx: i32) -> EcsHierWorldDeep {
    if idx == 0 { w.cnt0 = 0; w.ch0_0 = 0; w.ch0_1 = 0; w.ch0_2 = 0; w.ch0_3 = 0; return w; };
    if idx == 1 { w.cnt1 = 0; w.ch1_0 = 0; w.ch1_1 = 0; w.ch1_2 = 0; w.ch1_3 = 0; return w; };
    if idx == 2 { w.cnt2 = 0; w.ch2_0 = 0; w.ch2_1 = 0; w.ch2_2 = 0; w.ch2_3 = 0; return w; };
    if idx == 3 { w.cnt3 = 0; w.ch3_0 = 0; w.ch3_1 = 0; w.ch3_2 = 0; w.ch3_3 = 0; return w; };
    if idx == 4 { w.cnt4 = 0; w.ch4_0 = 0; w.ch4_1 = 0; w.ch4_2 = 0; w.ch4_3 = 0; return w; };
    if idx == 5 { w.cnt5 = 0; w.ch5_0 = 0; w.ch5_1 = 0; w.ch5_2 = 0; w.ch5_3 = 0; return w; };
    if idx == 6 { w.cnt6 = 0; w.ch6_0 = 0; w.ch6_1 = 0; w.ch6_2 = 0; w.ch6_3 = 0; return w; };
    w.cnt7 = 0; w.ch7_0 = 0; w.ch7_1 = 0; w.ch7_2 = 0; w.ch7_3 = 0;
    return w;
}

fn _ecs_hier_world_deep_remove_child_slot(w: EcsHierWorldDeep, idx: i32, child: i64) -> EcsHierWorldDeep {
    // Find the child in the slot; if found, shift the remaining children down (swap-remove tail fill)
    // to preserve order of the non-removed children per the shallow remove_related semantics.
    let cnt = _ecs_hier_world_deep_child_count_slot(w, idx);
    let pos = _ecs_hier_world_deep_index_of_child(w, idx, cnt, child);
    if pos < 0 { return w; };
    if idx == 0 {
        if pos == 0 { if cnt > 1 { w.ch0_0 = w.ch0_1; }; if cnt > 2 { w.ch0_1 = w.ch0_2; }; if cnt > 3 { w.ch0_2 = w.ch0_3; }; };
        if pos == 1 { if cnt > 2 { w.ch0_1 = w.ch0_2; }; if cnt > 3 { w.ch0_2 = w.ch0_3; }; };
        if pos == 2 { if cnt > 3 { w.ch0_2 = w.ch0_3; }; };
        w.cnt0 = cnt - 1;
        return w;
    };
    if idx == 1 {
        if pos == 0 { if cnt > 1 { w.ch1_0 = w.ch1_1; }; if cnt > 2 { w.ch1_1 = w.ch1_2; }; if cnt > 3 { w.ch1_2 = w.ch1_3; }; };
        if pos == 1 { if cnt > 2 { w.ch1_1 = w.ch1_2; }; if cnt > 3 { w.ch1_2 = w.ch1_3; }; };
        if pos == 2 { if cnt > 3 { w.ch1_2 = w.ch1_3; }; };
        w.cnt1 = cnt - 1;
        return w;
    };
    if idx == 2 {
        if pos == 0 { if cnt > 1 { w.ch2_0 = w.ch2_1; }; if cnt > 2 { w.ch2_1 = w.ch2_2; }; if cnt > 3 { w.ch2_2 = w.ch2_3; }; };
        if pos == 1 { if cnt > 2 { w.ch2_1 = w.ch2_2; }; if cnt > 3 { w.ch2_2 = w.ch2_3; }; };
        if pos == 2 { if cnt > 3 { w.ch2_2 = w.ch2_3; }; };
        w.cnt2 = cnt - 1;
        return w;
    };
    if idx == 3 {
        if pos == 0 { if cnt > 1 { w.ch3_0 = w.ch3_1; }; if cnt > 2 { w.ch3_1 = w.ch3_2; }; if cnt > 3 { w.ch3_2 = w.ch3_3; }; };
        if pos == 1 { if cnt > 2 { w.ch3_1 = w.ch3_2; }; if cnt > 3 { w.ch3_2 = w.ch3_3; }; };
        if pos == 2 { if cnt > 3 { w.ch3_2 = w.ch3_3; }; };
        w.cnt3 = cnt - 1;
        return w;
    };
    if idx == 4 {
        if pos == 0 { if cnt > 1 { w.ch4_0 = w.ch4_1; }; if cnt > 2 { w.ch4_1 = w.ch4_2; }; if cnt > 3 { w.ch4_2 = w.ch4_3; }; };
        if pos == 1 { if cnt > 2 { w.ch4_1 = w.ch4_2; }; if cnt > 3 { w.ch4_2 = w.ch4_3; }; };
        if pos == 2 { if cnt > 3 { w.ch4_2 = w.ch4_3; }; };
        w.cnt4 = cnt - 1;
        return w;
    };
    if idx == 5 {
        if pos == 0 { if cnt > 1 { w.ch5_0 = w.ch5_1; }; if cnt > 2 { w.ch5_1 = w.ch5_2; }; if cnt > 3 { w.ch5_2 = w.ch5_3; }; };
        if pos == 1 { if cnt > 2 { w.ch5_1 = w.ch5_2; }; if cnt > 3 { w.ch5_2 = w.ch5_3; }; };
        if pos == 2 { if cnt > 3 { w.ch5_2 = w.ch5_3; }; };
        w.cnt5 = cnt - 1;
        return w;
    };
    if idx == 6 {
        if pos == 0 { if cnt > 1 { w.ch6_0 = w.ch6_1; }; if cnt > 2 { w.ch6_1 = w.ch6_2; }; if cnt > 3 { w.ch6_2 = w.ch6_3; }; };
        if pos == 1 { if cnt > 2 { w.ch6_1 = w.ch6_2; }; if cnt > 3 { w.ch6_2 = w.ch6_3; }; };
        if pos == 2 { if cnt > 3 { w.ch6_2 = w.ch6_3; }; };
        w.cnt6 = cnt - 1;
        return w;
    };
    if pos == 0 { if cnt > 1 { w.ch7_0 = w.ch7_1; }; if cnt > 2 { w.ch7_1 = w.ch7_2; }; if cnt > 3 { w.ch7_2 = w.ch7_3; }; };
    if pos == 1 { if cnt > 2 { w.ch7_1 = w.ch7_2; }; if cnt > 3 { w.ch7_2 = w.ch7_3; }; };
    if pos == 2 { if cnt > 3 { w.ch7_2 = w.ch7_3; }; };
    w.cnt7 = cnt - 1;
    return w;
}

fn _ecs_hier_world_deep_index_of_child(w: EcsHierWorldDeep, idx: i32, cnt: i32, child: i64) -> i32 {
    if cnt <= 0 { return -1; };
    if _ecs_hier_world_deep_child_slot_at(w, idx, 0) == child { return 0; };
    if cnt > 1 { if _ecs_hier_world_deep_child_slot_at(w, idx, 1) == child { return 1; }; };
    if cnt > 2 { if _ecs_hier_world_deep_child_slot_at(w, idx, 2) == child { return 2; }; };
    if cnt > 3 { if _ecs_hier_world_deep_child_slot_at(w, idx, 3) == child { return 3; }; };
    return -1;
}

fn _ecs_hier_world_deep_despawn_entity(w: EcsHierWorldDeep, e: i64) -> EcsHierWorldDeep {
    w = _ecs_hier_world_deep_set_alive(w, e, 0);
    return w;
}

// Insert child at a specific index within slot idx (shift existing children right, then drop).
// Fully unrolled per-slot cascade — no nested if/else chains (SA parse-safe).
fn _ecs_hier_world_deep_insert_child_slot(w: EcsHierWorldDeep, idx: i32, ins: i32, child: i64) -> EcsHierWorldDeep {
    let cnt = _ecs_hier_world_deep_child_count_slot(w, idx);
    if cnt >= ECS_HIER_LIST_CAP_DEEP { return w; };
    if ins < 0 { return w; };
    if ins > cnt { return w; };
    if idx == 0 {
        if ins <= 3 { if cnt > 2 { w.ch0_3 = w.ch0_2; }; if cnt > 1 { w.ch0_2 = w.ch0_1; }; if cnt > 0 { w.ch0_1 = w.ch0_0; }; };
        if ins == 0 { w.ch0_0 = child; w.cnt0 = cnt + 1; return w; };
        if ins == 1 { w.ch0_1 = child; w.cnt0 = cnt + 1; return w; };
        if ins == 2 { w.ch0_2 = child; w.cnt0 = cnt + 1; return w; };
        w.ch0_3 = child; w.cnt0 = cnt + 1; return w;
    };
    if idx == 1 {
        if ins <= 3 { if cnt > 2 { w.ch1_3 = w.ch1_2; }; if cnt > 1 { w.ch1_2 = w.ch1_1; }; if cnt > 0 { w.ch1_1 = w.ch1_0; }; };
        if ins == 0 { w.ch1_0 = child; w.cnt1 = cnt + 1; return w; };
        if ins == 1 { w.ch1_1 = child; w.cnt1 = cnt + 1; return w; };
        if ins == 2 { w.ch1_2 = child; w.cnt1 = cnt + 1; return w; };
        w.ch1_3 = child; w.cnt1 = cnt + 1; return w;
    };
    if idx == 2 {
        if ins <= 3 { if cnt > 2 { w.ch2_3 = w.ch2_2; }; if cnt > 1 { w.ch2_2 = w.ch2_1; }; if cnt > 0 { w.ch2_1 = w.ch2_0; }; };
        if ins == 0 { w.ch2_0 = child; w.cnt2 = cnt + 1; return w; };
        if ins == 1 { w.ch2_1 = child; w.cnt2 = cnt + 1; return w; };
        if ins == 2 { w.ch2_2 = child; w.cnt2 = cnt + 1; return w; };
        w.ch2_3 = child; w.cnt2 = cnt + 1; return w;
    };
    if idx == 3 {
        if ins <= 3 { if cnt > 2 { w.ch3_3 = w.ch3_2; }; if cnt > 1 { w.ch3_2 = w.ch3_1; }; if cnt > 0 { w.ch3_1 = w.ch3_0; }; };
        if ins == 0 { w.ch3_0 = child; w.cnt3 = cnt + 1; return w; };
        if ins == 1 { w.ch3_1 = child; w.cnt3 = cnt + 1; return w; };
        if ins == 2 { w.ch3_2 = child; w.cnt3 = cnt + 1; return w; };
        w.ch3_3 = child; w.cnt3 = cnt + 1; return w;
    };
    if idx == 4 {
        if ins <= 3 { if cnt > 2 { w.ch4_3 = w.ch4_2; }; if cnt > 1 { w.ch4_2 = w.ch4_1; }; if cnt > 0 { w.ch4_1 = w.ch4_0; }; };
        if ins == 0 { w.ch4_0 = child; w.cnt4 = cnt + 1; return w; };
        if ins == 1 { w.ch4_1 = child; w.cnt4 = cnt + 1; return w; };
        if ins == 2 { w.ch4_2 = child; w.cnt4 = cnt + 1; return w; };
        w.ch4_3 = child; w.cnt4 = cnt + 1; return w;
    };
    if idx == 5 {
        if ins <= 3 { if cnt > 2 { w.ch5_3 = w.ch5_2; }; if cnt > 1 { w.ch5_2 = w.ch5_1; }; if cnt > 0 { w.ch5_1 = w.ch5_0; }; };
        if ins == 0 { w.ch5_0 = child; w.cnt5 = cnt + 1; return w; };
        if ins == 1 { w.ch5_1 = child; w.cnt5 = cnt + 1; return w; };
        if ins == 2 { w.ch5_2 = child; w.cnt5 = cnt + 1; return w; };
        w.ch5_3 = child; w.cnt5 = cnt + 1; return w;
    };
    if idx == 6 {
        if ins <= 3 { if cnt > 2 { w.ch6_3 = w.ch6_2; }; if cnt > 1 { w.ch6_2 = w.ch6_1; }; if cnt > 0 { w.ch6_1 = w.ch6_0; }; };
        if ins == 0 { w.ch6_0 = child; w.cnt6 = cnt + 1; return w; };
        if ins == 1 { w.ch6_1 = child; w.cnt6 = cnt + 1; return w; };
        if ins == 2 { w.ch6_2 = child; w.cnt6 = cnt + 1; return w; };
        w.ch6_3 = child; w.cnt6 = cnt + 1; return w;
    };
    if ins <= 3 { if cnt > 2 { w.ch7_3 = w.ch7_2; }; if cnt > 1 { w.ch7_2 = w.ch7_1; }; if cnt > 0 { w.ch7_1 = w.ch7_0; }; };
    if ins == 0 { w.ch7_0 = child; w.cnt7 = cnt + 1; return w; };
    if ins == 1 { w.ch7_1 = child; w.cnt7 = cnt + 1; return w; };
    if ins == 2 { w.ch7_2 = child; w.cnt7 = cnt + 1; return w; };
    w.ch7_3 = child; w.cnt7 = cnt + 1;
    return w;
}

// Replace children in slot idx with the entities in pool list `ridx`.
fn _ecs_hier_world_deep_replace_children_slot(s: EcsHierWorldDeep, idx: i32, pool: EcsHierListPoolDeep, ridx: i32) -> EcsHierWorldDeep {
    let n = _ecs_hier_list_pool_deep_len(pool, ridx);
    let w = _ecs_hier_world_deep_clear_slot(s, idx);
    if n <= 0 { return w; };
    let e0 = _ecs_hier_list_pool_deep_at(pool, ridx, 0);
    let w1 = _ecs_hier_world_deep_add_child_into(w, idx, e0);
    if n > 1 {
        let e1 = _ecs_hier_list_pool_deep_at(pool, ridx, 1);
        let w2 = _ecs_hier_world_deep_add_child_into(w1, idx, e1);
        if n > 2 {
            let e2 = _ecs_hier_list_pool_deep_at(pool, ridx, 2);
            let w3 = _ecs_hier_world_deep_add_child_into(w2, idx, e2);
            if n > 3 {
                let e3 = _ecs_hier_list_pool_deep_at(pool, ridx, 3);
                let w4 = _ecs_hier_world_deep_add_child_into(w3, idx, e3);
                return w4;
            };
            return w3;
        };
        return w2;
    };
    return w1;
}

// Detach a child from whatever parent's slot currently holds it.
fn _ecs_hier_world_deep_detach_child_from_any(w: EcsHierWorldDeep, child: i64) -> EcsHierWorldDeep {
    if w.par0 != -1 {
        let cnt0 = w.cnt0;
        let pos0 = _ecs_hier_world_deep_index_of_child(w, 0, cnt0, child);
        if pos0 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 0, child); };
    };
    if w.par1 != -1 {
        let cnt1 = w.cnt1;
        let pos1 = _ecs_hier_world_deep_index_of_child(w, 1, cnt1, child);
        if pos1 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 1, child); };
    };
    if w.par2 != -1 {
        let cnt2 = w.cnt2;
        let pos2 = _ecs_hier_world_deep_index_of_child(w, 2, cnt2, child);
        if pos2 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 2, child); };
    };
    if w.par3 != -1 {
        let cnt3 = w.cnt3;
        let pos3 = _ecs_hier_world_deep_index_of_child(w, 3, cnt3, child);
        if pos3 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 3, child); };
    };
    if w.par4 != -1 {
        let cnt4 = w.cnt4;
        let pos4 = _ecs_hier_world_deep_index_of_child(w, 4, cnt4, child);
        if pos4 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 4, child); };
    };
    if w.par5 != -1 {
        let cnt5 = w.cnt5;
        let pos5 = _ecs_hier_world_deep_index_of_child(w, 5, cnt5, child);
        if pos5 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 5, child); };
    };
    if w.par6 != -1 {
        let cnt6 = w.cnt6;
        let pos6 = _ecs_hier_world_deep_index_of_child(w, 6, cnt6, child);
        if pos6 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 6, child); };
    };
    if w.par7 != -1 {
        let cnt7 = w.cnt7;
        let pos7 = _ecs_hier_world_deep_index_of_child(w, 7, cnt7, child);
        if pos7 >= 0 { return _ecs_hier_world_deep_remove_child_slot(w, 7, child); };
    };
    return w;
}

// Despawn children of slot idx: mark each child not-alive, then clear the slot.
fn _ecs_hier_world_deep_despawn_children_slot(w: EcsHierWorldDeep, idx: i32) -> EcsHierWorldDeep {
    let cnt = _ecs_hier_world_deep_child_count_slot(w, idx);
    if cnt <= 0 { return w; };
    let e0 = _ecs_hier_world_deep_child_slot_at(w, idx, 0);
    let w1 = _ecs_hier_world_deep_despawn_entity(w, e0);
    if cnt > 1 {
        let e1 = _ecs_hier_world_deep_child_slot_at(w1, idx, 1);
        let w2 = _ecs_hier_world_deep_despawn_entity(w1, e1);
        if cnt > 2 {
            let e2 = _ecs_hier_world_deep_child_slot_at(w2, idx, 2);
            let w3 = _ecs_hier_world_deep_despawn_entity(w2, e2);
            if cnt > 3 {
                let e3 = _ecs_hier_world_deep_child_slot_at(w3, idx, 3);
                let w4 = _ecs_hier_world_deep_despawn_entity(w3, e3);
                let w5 = _ecs_hier_world_deep_clear_slot(w4, idx);
                return w5;
            };
            let w4b = _ecs_hier_world_deep_clear_slot(w3, idx);
            return w4b;
        };
        let w3b = _ecs_hier_world_deep_clear_slot(w2, idx);
        return w3b;
    };
    let w2b = _ecs_hier_world_deep_clear_slot(w1, idx);
    return w2b;
}

// Apply a single command at queue index `qi` against world `wt` using pool `pool`.
// Returns the updated world. Unrolled per-kind cascade-of-return (no tuples in/out).
fn _ecs_hier_world_deep_apply_cmd(wt: EcsHierWorldDeep, s: EcsHierCmdStateDeep, qi: i32) -> EcsHierWorldDeep {
    let pool = s.pool;
    let kind = ecs_hier_commands_deep_kind_at(s.queue, qi);
    if kind == ECS_HIER_ADD_CHILD {
        let parent = ecs_hier_commands_deep_target_at(s.queue, qi);
        let child = ecs_hier_commands_deep_child_at(s.queue, qi);
        let w1 = _ecs_hier_world_deep_register_parent(wt, parent);
        let idx = _ecs_hier_world_deep_parent_index(w1, parent);
        let w2 = _ecs_hier_world_deep_add_child_into(w1, idx, child);
        return w2;
    };
    if kind == ECS_HIER_INSERT_CHILD {
        let parent = ecs_hier_commands_deep_target_at(s.queue, qi);
        let child = ecs_hier_commands_deep_child_at(s.queue, qi);
        let ins = ecs_hier_commands_deep_index_at(s.queue, qi);
        let w1 = _ecs_hier_world_deep_register_parent(wt, parent);
        let idx = _ecs_hier_world_deep_parent_index(w1, parent);
        let w2 = _ecs_hier_world_deep_insert_child_slot(w1, idx, ins, child);
        return w2;
    };
    if kind == ECS_HIER_DETACH_CHILD {
        let child = ecs_hier_commands_deep_child_at(s.queue, qi);
        let w1 = _ecs_hier_world_deep_detach_child_from_any(wt, child);
        return w1;
    };
    if kind == ECS_HIER_DETACH_ALL_CHILDREN {
        let parent = ecs_hier_commands_deep_target_at(s.queue, qi);
        let idx = _ecs_hier_world_deep_parent_index(wt, parent);
        if idx < 0 { return wt; };
        let w1 = _ecs_hier_world_deep_clear_slot(wt, idx);
        return w1;
    };
    if kind == ECS_HIER_REPLACE_CHILDREN {
        let parent = ecs_hier_commands_deep_target_at(s.queue, qi);
        let ridx = ecs_hier_commands_deep_ridx_at(s.queue, qi);
        let w1 = _ecs_hier_world_deep_register_parent(wt, parent);
        let idx = _ecs_hier_world_deep_parent_index(w1, parent);
        let w2 = _ecs_hier_world_deep_replace_children_slot(w1, idx, pool, ridx);
        return w2;
    };
    if kind == ECS_HIER_REPLACE_DIFF {
        let parent = ecs_hier_commands_deep_target_at(s.queue, qi);
        let uidx = ecs_hier_commands_deep_uidx_at(s.queue, qi);
        let ridx = ecs_hier_commands_deep_ridx_at(s.queue, qi);
        let nidx = ecs_hier_commands_deep_nidx_at(s.queue, qi);
        // Mirror shallow replace_related_with_difference: remove unrelate entities, then add relate list.
        // newly_related_entities are a subset of relate; tracked but produce the same alive result as relate here.
        let w1 = _ecs_hier_world_deep_register_parent(wt, parent);
        let idx = _ecs_hier_world_deep_parent_index(w1, parent);
        let w2 = _ecs_hier_world_deep_diff_unrelate(w1, idx, pool, uidx);
        let w3 = _ecs_hier_world_deep_diff_relate(w2, idx, pool, ridx);
        let w4 = _ecs_hier_world_deep_diff_newly(w3, pool, nidx);
        return w4;
    };
    if kind == ECS_HIER_DESPAWN_CHILDREN {
        let parent = ecs_hier_commands_deep_target_at(s.queue, qi);
        let idx = _ecs_hier_world_deep_parent_index(wt, parent);
        if idx < 0 { return wt; };
        let w1 = _ecs_hier_world_deep_despawn_children_slot(wt, idx);
        return w1;
    };
    if kind == ECS_HIER_DESPAWN {
        let entity = ecs_hier_commands_deep_target_at(s.queue, qi);
        let w1 = _ecs_hier_world_deep_despawn_entity(wt, entity);
        return w1;
    };
    return wt;
}

// REPLACE_DIFF helpers — flat let-ladder unrolled over the pool list length.
fn _ecs_hier_world_deep_diff_unrelate(w: EcsHierWorldDeep, idx: i32, pool: EcsHierListPoolDeep, uidx: i32) -> EcsHierWorldDeep {
    let n = _ecs_hier_list_pool_deep_len(pool, uidx);
    if n <= 0 { return w; };
    let e0 = _ecs_hier_list_pool_deep_at(pool, uidx, 0);
    let w1 = _ecs_hier_world_deep_remove_child_slot(w, idx, e0);
    if n > 1 {
        let e1 = _ecs_hier_list_pool_deep_at(pool, uidx, 1);
        let w2 = _ecs_hier_world_deep_remove_child_slot(w1, idx, e1);
        if n > 2 {
            let e2 = _ecs_hier_list_pool_deep_at(pool, uidx, 2);
            let w3 = _ecs_hier_world_deep_remove_child_slot(w2, idx, e2);
            if n > 3 {
                let e3 = _ecs_hier_list_pool_deep_at(pool, uidx, 3);
                let w4 = _ecs_hier_world_deep_remove_child_slot(w3, idx, e3);
                return w4;
            };
            return w3;
        };
        return w2;
    };
    return w1;
}

fn _ecs_hier_world_deep_diff_relate(w: EcsHierWorldDeep, idx: i32, pool: EcsHierListPoolDeep, ridx: i32) -> EcsHierWorldDeep {
    // relate = ensure these entities are children of idx (skip already-present to avoid dupes).
    let n = _ecs_hier_list_pool_deep_len(pool, ridx);
    if n <= 0 { return w; };
    let e0 = _ecs_hier_list_pool_deep_at(pool, ridx, 0);
    let cnt0 = _ecs_hier_world_deep_child_count_slot(w, idx);
    let p0 = _ecs_hier_world_deep_index_of_child(w, idx, cnt0, e0);
    let w1 = _ecs_hier_world_deep_diff_relate_push(w, idx, e0, p0);
    if n > 1 {
        let e1 = _ecs_hier_list_pool_deep_at(pool, ridx, 1);
        let cnt1 = _ecs_hier_world_deep_child_count_slot(w1, idx);
        let p1 = _ecs_hier_world_deep_index_of_child(w1, idx, cnt1, e1);
        let w2 = _ecs_hier_world_deep_diff_relate_push(w1, idx, e1, p1);
        if n > 2 {
            let e2 = _ecs_hier_list_pool_deep_at(pool, ridx, 2);
            let cnt2 = _ecs_hier_world_deep_child_count_slot(w2, idx);
            let p2 = _ecs_hier_world_deep_index_of_child(w2, idx, cnt2, e2);
            let w3 = _ecs_hier_world_deep_diff_relate_push(w2, idx, e2, p2);
            if n > 3 {
                let e3 = _ecs_hier_list_pool_deep_at(pool, ridx, 3);
                let cnt3 = _ecs_hier_world_deep_child_count_slot(w3, idx);
                let p3 = _ecs_hier_world_deep_index_of_child(w3, idx, cnt3, e3);
                let w4 = _ecs_hier_world_deep_diff_relate_push(w3, idx, e3, p3);
                return w4;
            };
            return w3;
        };
        return w2;
    };
    return w1;
}

fn _ecs_hier_world_deep_diff_relate_push(w: EcsHierWorldDeep, idx: i32, e: i64, present: i32) -> EcsHierWorldDeep {
    if present >= 0 { return w; };
    return _ecs_hier_world_deep_add_child_into(w, idx, e);
}

fn _ecs_hier_world_deep_diff_newly(w: EcsHierWorldDeep, pool: EcsHierListPoolDeep, nidx: i32) -> EcsHierWorldDeep {
    // newly_related_entities are marked alive (mirror shallow: they're spawned/related together).
    let n = _ecs_hier_list_pool_deep_len(pool, nidx);
    if n <= 0 { return w; };
    let e0 = _ecs_hier_list_pool_deep_at(pool, nidx, 0);
    let w1 = _ecs_hier_world_deep_set_alive(w, e0, 1);
    if n > 1 {
        let e1 = _ecs_hier_list_pool_deep_at(pool, nidx, 1);
        let w2 = _ecs_hier_world_deep_set_alive(w1, e1, 1);
        if n > 2 {
            let e2 = _ecs_hier_list_pool_deep_at(pool, nidx, 2);
            let w3 = _ecs_hier_world_deep_set_alive(w2, e2, 1);
            if n > 3 {
                let e3 = _ecs_hier_list_pool_deep_at(pool, nidx, 3);
                let w4 = _ecs_hier_world_deep_set_alive(w3, e3, 1);
                return w4;
            };
            return w3;
        };
        return w2;
    };
    return w1;
}

// Apply the entire command queue to the world (flat let-ladder over queue slots, no while loop —
// Batch 378 rule: SA swallows field-assigns inside while bodies; the world accumulator must be a
// flat b1..bN rebinding ladder read off as the final one).
fn _ecs_hier_cmds_deep_state_cleared(s: EcsHierCmdStateDeep) -> EcsHierCmdStateDeep {
    s.queue.count = 0;
    return s;
}

fn ecs_hier_commands_deep_apply(world: EcsHierWorldDeep, s: EcsHierCmdStateDeep) -> EcsHierCmdApplyDeep {
    let qcnt = ecs_hier_commands_deep_len(s.queue);
    if qcnt <= 0 {
        let r = EcsHierCmdApplyDeep { world: world, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w0 = _ecs_hier_world_deep_apply_cmd(world, s, 0);
    if qcnt == 1 {
        let r = EcsHierCmdApplyDeep { world: w0, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w1 = _ecs_hier_world_deep_apply_cmd(w0, s, 1);
    if qcnt == 2 {
        let r = EcsHierCmdApplyDeep { world: w1, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w2 = _ecs_hier_world_deep_apply_cmd(w1, s, 2);
    if qcnt == 3 {
        let r = EcsHierCmdApplyDeep { world: w2, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w3 = _ecs_hier_world_deep_apply_cmd(w2, s, 3);
    if qcnt == 4 {
        let r = EcsHierCmdApplyDeep { world: w3, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w4 = _ecs_hier_world_deep_apply_cmd(w3, s, 4);
    if qcnt == 5 {
        let r = EcsHierCmdApplyDeep { world: w4, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w5 = _ecs_hier_world_deep_apply_cmd(w4, s, 5);
    if qcnt == 6 {
        let r = EcsHierCmdApplyDeep { world: w5, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w6 = _ecs_hier_world_deep_apply_cmd(w5, s, 6);
    if qcnt == 7 {
        let r = EcsHierCmdApplyDeep { world: w6, commands: _ecs_hier_cmds_deep_state_cleared(s) };
        return r;
    };
    let w7 = _ecs_hier_world_deep_apply_cmd(w6, s, 7);
    let r = EcsHierCmdApplyDeep { world: w7, commands: _ecs_hier_cmds_deep_state_cleared(s) };
    return r;
}

// reserve_entity and spawn_child facade entry points (wrapper structs, Batch 373 rule).
fn ecs_hier_commands_deep_reserve_entity(world: EcsHierWorldDeep, s: EcsHierCmdStateDeep) -> EcsHierReserveDeep {
    let pair = ecs_hier_world_deep_spawn(world);
    let w = pair.0;
    let e = pair.1;
    let r = EcsHierReserveDeep { world: w, commands: _ecs_hier_cmds_deep_state_cleared(s).queue, entity: e };
    return r;
}

fn ecs_hier_cmd_reserve_world(r: EcsHierReserveDeep) -> EcsHierWorldDeep { return r.world; }
fn ecs_hier_cmd_reserve_commands(r: EcsHierReserveDeep) -> EcsHierCmdsDeep { return r.commands; }
fn ecs_hier_cmd_reserve_entity(r: EcsHierReserveDeep) -> i64 { return r.entity; }

// clear — reset the queue count to 0 (pool persists; shallow clear keeps entity_lists).
fn ecs_hier_commands_deep_clear(s: EcsHierCmdStateDeep) -> EcsHierCmdStateDeep {
    s.queue.count = 0;
    return s;
}

fn ecs_hier_cmds_deep_clear(s: EcsHierCmdStateDeep) -> EcsHierCmdStateDeep {
    s.queue.count = 0;
    return s;
}
