// Bevy ECS FilteredResourcesBuilder + FilteredResourcesMutBuilder —
// src/world/filtered_resource.rs (gaps not in lib/filtered_resource.sla or lib/system_builder.sla).
// Covers: new(world) + access + add_read_all + add_read*by_id + (mut-builder) add_write_all + add_write*by_id + build.
// We model the by-type *<R>* variants as their by-id equivalents (sla has no generics over types).

@import "lib/query_access_ops.sla"

// === FilteredResourcesBuilder (read-only) ===
struct EcsFilteredResourcesBuilder {
    world_id: i32,
    access: EcsAccessOps,
}

fn ecs_fr_builder_new(world_id: i32) -> EcsFilteredResourcesBuilder {
    let b = EcsFilteredResourcesBuilder { world_id: world_id, access: ecs_access_ops_new() };
    return b;
}

fn ecs_fr_builder_world_id(b: EcsFilteredResourcesBuilder) -> i32 {
    return b.world_id;
}

fn ecs_fr_builder_access(b: EcsFilteredResourcesBuilder) -> EcsAccessOps {
    return b.access;
}

// add_read_all: marks the access as reading all resources.
// Bevy: self.access.read_all(); we record the sentinel id=-1 read.
fn ecs_fr_builder_add_read_all(b: EcsFilteredResourcesBuilder) -> EcsFilteredResourcesBuilder {
    b.access = ecs_access_ops_add_read(b.access, -1);
    return b;
}

// add_read<R> (modelled via id with the type-id passed as the "component id" param).
fn ecs_fr_builder_add_read(b: EcsFilteredResourcesBuilder, component_id: i32) -> EcsFilteredResourcesBuilder {
    b.access = ecs_access_ops_add_read(b.access, component_id);
    return b;
}

fn ecs_fr_builder_add_read_by_id(b: EcsFilteredResourcesBuilder, component_id: i32) -> EcsFilteredResourcesBuilder {
    return ecs_fr_builder_add_read(b, component_id);
}

// build: yields the accumulated Access.
fn ecs_fr_builder_build(b: EcsFilteredResourcesBuilder) -> EcsAccessOps {
    return b.access;
}

// Convenience: bounded reads count for testing.
fn ecs_fr_builder_reads_count(b: EcsFilteredResourcesBuilder) -> i32 {
    return ecs_access_ops_reads_count(b.access);
}

// === FilteredResourcesMutBuilder (read+write) ===
struct EcsFilteredResourcesMutBuilder {
    world_id: i32,
    access: EcsAccessOps,
}

fn ecs_frm_builder_new(world_id: i32) -> EcsFilteredResourcesMutBuilder {
    let b = EcsFilteredResourcesMutBuilder { world_id: world_id, access: ecs_access_ops_new() };
    return b;
}

fn ecs_frm_builder_world_id(b: EcsFilteredResourcesMutBuilder) -> i32 {
    return b.world_id;
}

fn ecs_frm_builder_access(b: EcsFilteredResourcesMutBuilder) -> EcsAccessOps {
    return b.access;
}

fn ecs_frm_builder_add_read_all(b: EcsFilteredResourcesMutBuilder) -> EcsFilteredResourcesMutBuilder {
    b.access = ecs_access_ops_add_read(b.access, -1);
    return b;
}

fn ecs_frm_builder_add_read(b: EcsFilteredResourcesMutBuilder, component_id: i32) -> EcsFilteredResourcesMutBuilder {
    b.access = ecs_access_ops_add_read(b.access, component_id);
    return b;
}

fn ecs_frm_builder_add_read_by_id(b: EcsFilteredResourcesMutBuilder, component_id: i32) -> EcsFilteredResourcesMutBuilder {
    return ecs_frm_builder_add_read(b, component_id);
}

fn ecs_frm_builder_add_write_all(b: EcsFilteredResourcesMutBuilder) -> EcsFilteredResourcesMutBuilder {
    b.access = ecs_access_ops_add_write(b.access, -1);
    return b;
}

fn ecs_frm_builder_add_write(b: EcsFilteredResourcesMutBuilder, component_id: i32) -> EcsFilteredResourcesMutBuilder {
    b.access = ecs_access_ops_add_write(b.access, component_id);
    return b;
}

fn ecs_frm_builder_add_write_by_id(b: EcsFilteredResourcesMutBuilder, component_id: i32) -> EcsFilteredResourcesMutBuilder {
    return ecs_frm_builder_add_write(b, component_id);
}

fn ecs_frm_builder_build(b: EcsFilteredResourcesMutBuilder) -> EcsAccessOps {
    return b.access;
}

fn ecs_frm_builder_reads_count(b: EcsFilteredResourcesMutBuilder) -> i32 {
    return ecs_access_ops_reads_count(b.access);
}

fn ecs_frm_builder_writes_count(b: EcsFilteredResourcesMutBuilder) -> i32 {
    return ecs_access_ops_writes_count(b.access);
}
