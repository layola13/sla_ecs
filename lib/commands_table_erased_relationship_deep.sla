// full-field set_slot: per-branch scalar assign (no struct reuse — i32 fields).
fn ecs_tbl_rel_commands_set_slot(c: EcsTblRelCommandsDeep, idx: i32, k: i32, e: i32, rk: i32, tg: i32, cmp: i32, v: i32, rl: i32, ur: i32, nw: i32) -> EcsTblRelCommandsDeep {
    if idx == 0 { c.k0 = k; c.e0 = e; c.rk0 = rk; c.tg0 = tg; c.c0 = cmp; c.v0 = v; c.rl0 = rl; c.ur0 = ur; c.nw0 = nw; };
    if idx == 1 { c.k1 = k; c.e1 = e; c.rk1 = rk; c.tg1 = tg; c.c1 = cmp; c.v1 = v; c.rl1 = rl; c.ur1 = ur; c.nw1 = nw; };
    if idx == 2 { c.k2 = k; c.e2 = e; c.rk2 = rk; c.tg2 = tg; c.c2 = cmp; c.v2 = v; c.rl2 = rl; c.ur2 = ur; c.nw2 = nw; };
    if idx == 3 { c.k3 = k; c.e3 = e; c.rk3 = rk; c.tg3 = tg; c.c3 = cmp; c.v3 = v; c.rl3 = rl; c.ur3 = ur; c.nw3 = nw; };
    if idx == 4 { c.k4 = k; c.e4 = e; c.rk4 = rk; c.tg4 = tg; c.c4 = cmp; c.v4 = v; c.rl4 = rl; c.ur4 = ur; c.nw4 = nw; };
    if idx == 5 { c.k5 = k; c.e5 = e; c.rk5 = rk; c.tg5 = tg; c.c5 = cmp; c.v5 = v; c.rl5 = rl; c.ur5 = ur; c.nw5 = nw; };
    if idx == 6 { c.k6 = k; c.e6 = e; c.rk6 = rk; c.tg6 = tg; c.c6 = cmp; c.v6 = v; c.rl6 = rl; c.ur6 = ur; c.nw6 = nw; };
    if idx == 7 { c.k7 = k; c.e7 = e; c.rk7 = rk; c.tg7 = tg; c.c7 = cmp; c.v7 = v; c.rl7 = rl; c.ur7 = ur; c.nw7 = nw; };
    return c;
}

fn ecs_tbl_rel_commands_set_pt(c: EcsTblRelCommandsDeep, idx: i32, value: i32) -> EcsTblRelCommandsDeep {
    if idx == 0 { c.pt0 = value; };
    if idx == 1 { c.pt1 = value; };
    if idx == 2 { c.pt2 = value; };
    if idx == 3 { c.pt3 = value; };
    if idx == 4 { c.pt4 = value; };
    if idx == 5 { c.pt5 = value; };
    if idx == 6 { c.pt6 = value; };
    if idx == 7 { c.pt7 = value; };
    return c;
}

