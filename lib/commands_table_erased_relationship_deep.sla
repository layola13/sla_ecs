fn ecs_tbl_rel_commands_pcomp_count(c: EcsTblRelCommandsDeep) -> i32 { return c.pcomp_count; }
fn ecs_tbl_rel_commands_pres_count(c: EcsTblRelCommandsDeep) -> i32 { return c.pres_count; }
fn ecs_tbl_rel_commands_pmsg_count(c: EcsTblRelCommandsDeep) -> i32 { return c.pmsg_count; }
fn ecs_tbl_rel_commands_lcount(c: EcsTblRelCommandsDeep) -> i32 { return c.lcount; }

// shared entity-list side storage: cap-2 lists each cap-4 entries (entity ids).
// populate list slot Lk with cap-4 ids (e0,e1,e2,e3) and per-list count lc.
fn ecs_tbl_rel_commands_set_list(c: EcsTblRelCommandsDeep, lk: i32, e0: i32, e1: i32, e2: i32, e3: i32, lc: i32) -> EcsTblRelCommandsDeep {
    if lk == 0 {
        c.le00 = e0; c.le01 = e1; c.le02 = e2; c.le03 = e3;
        c.lc0 = lc;
    };
    if lk == 1 {
        c.le10 = e0; c.le11 = e1; c.le12 = e2; c.le13 = e3;
        c.lc1 = lc;
    };
    if lk == 2 {
        c.le20 = e0; c.le21 = e1; c.le22 = e2; c.le23 = e3;
        c.lc2 = lc;
    };
    if lk == 3 {
        c.le30 = e0; c.le31 = e1; c.le32 = e2; c.le33 = e3;
        c.lc3 = lc;
    };
    return c;
}

fn ecs_tbl_rel_commands_list_count_at(c: EcsTblRelCommandsDeep, lk: i32) -> i32 {
    if lk == 0 { return c.lc0; };
    if lk == 1 { return c.lc1; };
    if lk == 2 { return c.lc2; };
    if lk == 3 { return c.lc3; };
    return 0;
}

struct EcsTblRelListEntryDeep { has: i32, entity_id: i32 }

fn ecs_tbl_rel_commands_list_at(c: EcsTblRelCommandsDeep, lk: i32, i: i32) -> EcsTblRelListEntryDeep {
    if lk == 0 {
        if i == 0 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le00 }; };
        if i == 1 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le01 }; };
        if i == 2 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le02 }; };
        if i == 3 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le03 }; };
    };
    if lk == 1 {
        if i == 0 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le10 }; };
        if i == 1 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le11 }; };
        if i == 2 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le12 }; };
        if i == 3 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le13 }; };
    };
    if lk == 2 {
        if i == 0 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le20 }; };
        if i == 1 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le21 }; };
        if i == 2 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le22 }; };
        if i == 3 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le23 }; };
    };
    if lk == 3 {
        if i == 0 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le30 }; };
        if i == 1 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le31 }; };
        if i == 2 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le32 }; };
        if i == 3 { return EcsTblRelListEntryDeep { has: 1, entity_id: c.le33 }; };
    };
    return EcsTblRelListEntryDeep { has: 0, entity_id: 0 };
}

fn ecs_tbl_rel_list_entry_has(e: EcsTblRelListEntryDeep) -> i32 { return e.has; }
fn ecs_tbl_rel_list_entry_entity(e: EcsTblRelListEntryDeep) -> i32 { return e.entity_id; }

// push a cap-4 entity-id list into the shared side storage; returns (queue, list_index).
fn ecs_tbl_rel_commands_store_list(c: EcsTblRelCommandsDeep, e0: i32, e1: i32, e2: i32, e3: i32, lc: i32) -> (EcsTblRelCommandsDeep, i32) {
    if c.lcount >= ECS_CMD_TBL_REL_LISTS_CAP_DEEP { return (c, -1); };
    let slot: i32 = c.lcount;
    c = ecs_tbl_rel_commands_set_list(c, slot, e0, e1, e2, e3, lc);
    c.lcount = c.lcount + 1;
    return (c, slot);
}

fn ecs_tbl_rel_commands_reserve_entity(c: EcsTblRelCommandsDeep) -> (EcsTblRelCommandsDeep, i32) {
    return (c, 0);
}

fn ecs_tbl_rel_commands_insert(c: EcsTblRelCommandsDeep, entity_id: i32, component_id: i32, type_id: i32, value: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    if c.pcomp_count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    let slot: i32 = c.pcomp_count;
    c = ecs_tbl_rel_commands_set_pt(c, slot, type_id);
    c = ecs_tbl_rel_commands_set_pv(c, slot, value);
    c.pcomp_count = c.pcomp_count + 1;
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_INSERT_COMPONENT, entity_id, 0, 0, component_id, slot, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_set_related(c: EcsTblRelCommandsDeep, relationship_kind_id: i32, source: i32, target: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_SET_RELATED, source, relationship_kind_id, target, 0, -1, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_set_related_at(c: EcsTblRelCommandsDeep, relationship_kind_id: i32, source: i32, target: i32, index: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_SET_RELATED_AT, source, relationship_kind_id, target, 0, index, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_remove_related(c: EcsTblRelCommandsDeep, relationship_kind_id: i32, target: i32, e0: i32, e1: i32, e2: i32, e3: i32, lc: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    let (after, related_index) = ecs_tbl_rel_commands_store_list(c, e0, e1, e2, e3, lc);
    if related_index < 0 { return c; };
    c = after;
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_REMOVE_RELATED, 0, relationship_kind_id, target, 0, -1, related_index, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_detach_all_related(c: EcsTblRelCommandsDeep, relationship_kind_id: i32, target: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_DETACH_ALL_RELATED, 0, relationship_kind_id, target, 0, -1, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_replace_related(c: EcsTblRelCommandsDeep, relationship_kind_id: i32, target: i32, e0: i32, e1: i32, e2: i32, e3: i32, lc: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    let (after, related_index) = ecs_tbl_rel_commands_store_list(c, e0, e1, e2, e3, lc);
    if related_index < 0 { return c; };
    c = after;
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_REPLACE_RELATED, 0, relationship_kind_id, target, 0, -1, related_index, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_replace_related_with_difference(
    c: EcsTblRelCommandsDeep,
    relationship_kind_id: i32, target: i32,
    un0: i32, un1: i32, un2: i32, un3: i32, unc: i32,
    re0: i32, re1: i32, re2: i32, re3: i32, rec: i32,
    ne0: i32, ne1: i32, ne2: i32, ne3: i32, nec: i32
) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    let (c1, unrelate_index) = ecs_tbl_rel_commands_store_list(c, un0, un1, un2, un3, unc);
    if unrelate_index < 0 { return c1; };
    let (c2, relate_index) = ecs_tbl_rel_commands_store_list(c1, re0, re1, re2, re3, rec);
    if relate_index < 0 { return c2; };
    let (c3, newly_index) = ecs_tbl_rel_commands_store_list(c2, ne0, ne1, ne2, ne3, nec);
    if newly_index < 0 { return c3; };
    c = c3;
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_REPLACE_RELATED_WITH_DIFFERENCE, 0, relationship_kind_id, target, 0, -1, relate_index, unrelate_index, newly_index);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_despawn(c: EcsTblRelCommandsDeep, entity_id: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_DESPAWN, entity_id, 0, 0, 0, -1, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_despawn_related(c: EcsTblRelCommandsDeep, relationship_kind_id: i32, target: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_DESPAWN_RELATED, 0, relationship_kind_id, target, 0, -1, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_insert_resource(c: EcsTblRelCommandsDeep, value: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    if c.pres_count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    let slot: i32 = c.pres_count;
    c = ecs_tbl_rel_commands_set_pres(c, slot, value);
    c.pres_count = c.pres_count + 1;
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_INSERT_RESOURCE, 0, 0, 0, 0, slot, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_write_message(c: EcsTblRelCommandsDeep, value: i32) -> EcsTblRelCommandsDeep {
    if c.count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    if c.pmsg_count >= ECS_CMD_TBL_REL_CAP_DEEP { return c; };
    let slot: i32 = c.pmsg_count;
    c = ecs_tbl_rel_commands_set_pmsg(c, slot, value);
    c.pmsg_count = c.pmsg_count + 1;
    c = ecs_tbl_rel_commands_set_slot(c, c.count, ECS_CMD_TBL_REL_WRITE_MESSAGE, 0, 0, 0, 0, slot, -1, -1, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_rel_commands_count_by_kind(c: EcsTblRelCommandsDeep, kind: i32) -> i32 {
    let i: i32 = 0;
    let out: i32 = 0;
    while i < c.count {
        if ecs_tbl_rel_commands_kind_at(c, i) == kind { out = out + 1; };
        i = i + 1;
    }
    return out;
}

// resolve_value: scalar payload for INSERT_COMPONENT (pv), INSERT_RESOURCE (pres),
// WRITE_MESSAGE (pmsg); otherwise 0 (incl. all relationship kinds and DESPAWN).
fn ecs_tbl_rel_commands_resolve_value(c: EcsTblRelCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_rel_commands_kind_at(c, idx);
    let vidx: i32 = ecs_tbl_rel_commands_idx_at(c, idx);
    if kind == ECS_CMD_TBL_REL_INSERT_COMPONENT {
        return ecs_tbl_rel_commands_pv_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_REL_INSERT_RESOURCE {
        return ecs_tbl_rel_commands_pres_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_REL_WRITE_MESSAGE {
        return ecs_tbl_rel_commands_pmsg_at(c, vidx);
    };
    return 0;
}

fn ecs_tbl_rel_commands_resolve_type(c: EcsTblRelCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_rel_commands_kind_at(c, idx);
    if kind == ECS_CMD_TBL_REL_INSERT_COMPONENT {
        let vidx: i32 = ecs_tbl_rel_commands_idx_at(c, idx);
        return ecs_tbl_rel_commands_pt_at(c, vidx);
    };
    return 0;
}

fn ecs_tbl_rel_commands_clear(c: EcsTblRelCommandsDeep) -> EcsTblRelCommandsDeep {
    return ecs_tbl_rel_commands_new();
}
