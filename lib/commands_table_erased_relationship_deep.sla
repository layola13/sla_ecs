// Deepened Bevy ECS ordered deferred command queue for TableErasedRelationshipWorld
// (shallow lib/commands_table_erased_relationship.sla deep;
//  src/system/commands/table_erased_relationship.rs observer-aware deferred queue).
//
// Mirrors the shallow queue but replaces the generic `TableErasedRelationshipCommands<R, M>`
// and boxed ErasedComponentValue / shared TableErasedRelationshipCommandEntityList array with
// fixed-cap kind-discriminated storage and parallel scalar side arrays. Avoids generic types,
// fn-ptr world-application, and boxed erased pointers (ecs_box_drop<T> :: erased component).
//
// Kinds (mirror shallow):
//   INSERT_COMPONENT=1, SET_RELATED=2, DESPAWN=3, INSERT_RESOURCE=4, WRITE_MESSAGE=5,
//   SET_RELATED_AT=6, REMOVE_RELATED=7, DETACH_ALL_RELATED=8, REPLACE_RELATED=9,
//   REPLACE_RELATED_WITH_DIFFERENCE=10, DESPAWN_RELATED=11.
//
// Per-slot command carries scalar fields: eN entity, rkN relationship_kind_id, tgN target,
// cN component_id, vN value_index, rlN related_index, urN unrelate_index, nwN newly_index, kN kind.
// INSERT_COMPONENT side payload uses parallel pt/pv cap-8 sharing pcomp_count.
// INSERT_RESOURCE uses pres cap-8; WRITE_MESSAGE uses pmsg cap-8.
// Relationship list-bearing commands (REMOVE_RELATED, REPLACE_RELATED,
// REPLACE_RELATED_WITH_DIFFERENCE) point to a shared `entity_lists` side storage:
// cap-2 lists each holding cap-4 entity ids (leL0_0..3 with leLcN count and lcount).
// The three command list fields (rlN, urN, nwN) all index this shared side storage.

const ECS_CMD_TBL_REL_CAP_DEEP: i32 = 8;
const ECS_CMD_TBL_REL_LIST_CAP_DEEP: i32 = 4;
const ECS_CMD_TBL_REL_LISTS_CAP_DEEP: i32 = 4;
const ECS_CMD_TBL_REL_INSERT_COMPONENT: i32 = 1;
const ECS_CMD_TBL_REL_SET_RELATED: i32 = 2;
const ECS_CMD_TBL_REL_DESPAWN: i32 = 3;
const ECS_CMD_TBL_REL_INSERT_RESOURCE: i32 = 4;
const ECS_CMD_TBL_REL_WRITE_MESSAGE: i32 = 5;
const ECS_CMD_TBL_REL_SET_RELATED_AT: i32 = 6;
const ECS_CMD_TBL_REL_REMOVE_RELATED: i32 = 7;
const ECS_CMD_TBL_REL_DETACH_ALL_RELATED: i32 = 8;
const ECS_CMD_TBL_REL_REPLACE_RELATED: i32 = 9;
const ECS_CMD_TBL_REL_REPLACE_RELATED_WITH_DIFFERENCE: i32 = 10;
const ECS_CMD_TBL_REL_DESPAWN_RELATED: i32 = 11;

struct EcsTblRelCommandDeep {
    kind: i32,
    entity_id: i32,
    relationship_kind_id: i32,
    target_id: i32,
    component_id: i32,
    value_index: i32,
    related_index: i32,
    unrelate_index: i32,
    newly_index: i32,
}

fn ecs_tbl_rel_command(kind: i32, entity_id: i32, relationship_kind_id: i32, target_id: i32, component_id: i32, value_index: i32) -> EcsTblRelCommandDeep {
    return EcsTblRelCommandDeep { kind: kind, entity_id: entity_id, relationship_kind_id: relationship_kind_id, target_id: target_id, component_id: component_id, value_index: value_index, related_index: -1, unrelate_index: -1, newly_index: -1 };
}

fn ecs_tbl_rel_command_lists(kind: i32, relationship_kind_id: i32, target_id: i32, related_index: i32, unrelate_index: i32, newly_index: i32) -> EcsTblRelCommandDeep {
    return EcsTblRelCommandDeep { kind: kind, entity_id: 0, relationship_kind_id: relationship_kind_id, target_id: target_id, component_id: 0, value_index: -1, related_index: related_index, unrelate_index: unrelate_index, newly_index: newly_index };
}

fn ecs_tbl_rel_command_kind(c: EcsTblRelCommandDeep) -> i32 { return c.kind; }
fn ecs_tbl_rel_command_entity_id(c: EcsTblRelCommandDeep) -> i32 { return c.entity_id; }
fn ecs_tbl_rel_command_relationship_kind_id(c: EcsTblRelCommandDeep) -> i32 { return c.relationship_kind_id; }
fn ecs_tbl_rel_command_target_id(c: EcsTblRelCommandDeep) -> i32 { return c.target_id; }
fn ecs_tbl_rel_command_component_id(c: EcsTblRelCommandDeep) -> i32 { return c.component_id; }
fn ecs_tbl_rel_command_value_index(c: EcsTblRelCommandDeep) -> i32 { return c.value_index; }
fn ecs_tbl_rel_command_related_index(c: EcsTblRelCommandDeep) -> i32 { return c.related_index; }
fn ecs_tbl_rel_command_unrelate_index(c: EcsTblRelCommandDeep) -> i32 { return c.unrelate_index; }
fn ecs_tbl_rel_command_newly_index(c: EcsTblRelCommandDeep) -> i32 { return c.newly_index; }

struct EcsTblRelCommandsDeep {
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    rk0: i32, rk1: i32, rk2: i32, rk3: i32, rk4: i32, rk5: i32, rk6: i32, rk7: i32,
    tg0: i32, tg1: i32, tg2: i32, tg3: i32, tg4: i32, tg5: i32, tg6: i32, tg7: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32,
    rl0: i32, rl1: i32, rl2: i32, rl3: i32, rl4: i32, rl5: i32, rl6: i32, rl7: i32,
    ur0: i32, ur1: i32, ur2: i32, ur3: i32, ur4: i32, ur5: i32, ur6: i32, ur7: i32,
    nw0: i32, nw1: i32, nw2: i32, nw3: i32, nw4: i32, nw5: i32, nw6: i32, nw7: i32,
    // INSERT_COMPONENT side parallel pt/pv cap-8
    pt0: i32, pt1: i32, pt2: i32, pt3: i32, pt4: i32, pt5: i32, pt6: i32, pt7: i32,
    pv0: i32, pv1: i32, pv2: i32, pv3: i32, pv4: i32, pv5: i32, pv6: i32, pv7: i32,
    pcomp_count: i32,
    // resource side cap-8
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    pres_count: i32,
    // message side cap-8
    m0: i32, m1: i32, m2: i32, m3: i32, m4: i32, m5: i32, m6: i32, m7: i32,
    pmsg_count: i32,
    // shared entity-lists side storage: cap-4 lists, each list holds cap-4 entity ids.
    le00: i32, le01: i32, le02: i32, le03: i32,
    le10: i32, le11: i32, le12: i32, le13: i32,
    le20: i32, le21: i32, le22: i32, le23: i32,
    le30: i32, le31: i32, le32: i32, le33: i32,
    lc0: i32, lc1: i32, lc2: i32, lc3: i32,
    lcount: i32,
    count: i32,
}

fn ecs_tbl_rel_commands_new() -> EcsTblRelCommandsDeep {
    let c = EcsTblRelCommandsDeep {
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        rk0: 0, rk1: 0, rk2: 0, rk3: 0, rk4: 0, rk5: 0, rk6: 0, rk7: 0,
        tg0: 0, tg1: 0, tg2: 0, tg3: 0, tg4: 0, tg5: 0, tg6: 0, tg7: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0,
        rl0: -1, rl1: -1, rl2: -1, rl3: -1, rl4: -1, rl5: -1, rl6: -1, rl7: -1,
        ur0: -1, ur1: -1, ur2: -1, ur3: -1, ur4: -1, ur5: -1, ur6: -1, ur7: -1,
        nw0: -1, nw1: -1, nw2: -1, nw3: -1, nw4: -1, nw5: -1, nw6: -1, nw7: -1,
        pt0: 0, pt1: 0, pt2: 0, pt3: 0, pt4: 0, pt5: 0, pt6: 0, pt7: 0,
        pv0: 0, pv1: 0, pv2: 0, pv3: 0, pv4: 0, pv5: 0, pv6: 0, pv7: 0,
        pcomp_count: 0,
        r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0,
        pres_count: 0,
        m0: 0, m1: 0, m2: 0, m3: 0, m4: 0, m5: 0, m6: 0, m7: 0,
        pmsg_count: 0,
        le00: 0, le01: 0, le02: 0, le03: 0,
        le10: 0, le11: 0, le12: 0, le13: 0,
        le20: 0, le21: 0, le22: 0, le23: 0,
        le30: 0, le31: 0, le32: 0, le33: 0,
        lc0: 0, lc1: 0, lc2: 0, lc3: 0,
        lcount: 0,
        count: 0,
    };
    return c;
}

fn ecs_tbl_rel_commands_len(c: EcsTblRelCommandsDeep) -> i32 { return c.count; }

// per-slot read accessors: kind/entity/rk/target/component/value/related/unrelate/newly
fn ecs_tbl_rel_commands_kind_at(c: EcsTblRelCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.k0; };
    if idx == 1 { return c.k1; };
    if idx == 2 { return c.k2; };
    if idx == 3 { return c.k3; };
    if idx == 4 { return c.k4; };
    if idx == 5 { return c.k5; };
    if idx == 6 { return c.k6; };
    if idx == 7 { return c.k7; };
    return 0;
}

