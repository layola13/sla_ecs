}

// ── Spawn wrapper (Batch 373 rule -- no test tuple destructuring) ─────────────
struct EcsHierSpawnDeep { world: EcsHierWorldDeep, entity: EcsHierEntityDeep }

fn ecs_hier_world_deep_spawn_world(r: EcsHierSpawnDeep) -> EcsHierWorldDeep { return r.world; }
fn ecs_hier_world_deep_spawn_entity(r: EcsHierSpawnDeep) -> EcsHierEntityDeep { return r.entity; }

fn ecs_hier_world_deep_spawn(w0: EcsHierWorldDeep) -> EcsHierSpawnDeep {
    if w0.next_entity >= ECS_HIER_CAP_ENTITIES {
        return _ecs_hier_spawn_wrap(w0, EcsHierEntityDeep { id: -1, generation: 0 });
    };
    let eid = w0.next_entity;
    let w1 = w0;
    w1.next_entity = w1.next_entity + 1;
    let w2 = _ecs_hier_world_deep_set_alive(w1, eid, 1);
    let ent = EcsHierEntityDeep { id: eid, generation: _ecs_hier_world_deep_generation_at(w2, eid) };
    return _ecs_hier_spawn_wrap(w2, ent);
}

fn _ecs_hier_spawn_wrap(world: EcsHierWorldDeep, entity: EcsHierEntityDeep) -> EcsHierSpawnDeep {
    return EcsHierSpawnDeep { world: world, entity: entity };
}

fn ecs_hier_world_deep_is_alive(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> bool {
    let eid = e.id;
    if eid < 0 { return false; };
    if eid >= ECS_HIER_CAP_ENTITIES { return false; };
    if _ecs_hier_world_deep_alive_at(w, eid) != 1 { return false; };
    return _ecs_hier_world_deep_generation_at(w, eid) == e.generation;
}

// ── Spawn-child: spawn + link to parent (Bevy spawn_related) ──────────────────
struct EcsHierSpawnChildDeep { world: EcsHierWorldDeep, child: EcsHierEntityDeep }

fn ecs_hier_world_deep_spawn_child_world(r: EcsHierSpawnChildDeep) -> EcsHierWorldDeep { return r.world; }
fn ecs_hier_world_deep_spawn_child_entity(r: EcsHierSpawnChildDeep) -> EcsHierEntityDeep { return r.child; }

fn ecs_hier_world_deep_spawn_child(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep) -> EcsHierSpawnChildDeep {
    let sp = ecs_hier_world_deep_spawn(w0);
    let w1 = ecs_hier_world_deep_spawn_world(sp);
    let child = ecs_hier_world_deep_spawn_entity(sp);
    if child.id < 0 { return _ecs_hier_spawn_child_wrap(w1, child); };
    let w2 = _ecs_hier_world_deep_add_child(w1, parent, child);
    return _ecs_hier_spawn_child_wrap(w2, child);
}

fn _ecs_hier_spawn_child_wrap(world: EcsHierWorldDeep, child: EcsHierEntityDeep) -> EcsHierSpawnChildDeep {
    return EcsHierSpawnChildDeep { world: world, child: child };
}

// ── Add-child: reparent target `child` to `parent` (Bevy set_related) ────────
// Bevy set_related semantics replaces any existing parent (deletes child from old parent's head list first).
fn ecs_hier_world_deep_add_child(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, child: EcsHierEntityDeep) -> EcsHierWorldDeep {
    return _ecs_hier_world_deep_add_child(w0, parent, child);
}

fn _ecs_hier_world_deep_add_child(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, child: EcsHierEntityDeep) -> EcsHierWorldDeep {
    if child.id < 0 { return w0; };
    if child.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    if parent.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    if parent.id < 0 { return w0; };
    // If child already has a parent (ChildOf is a 1-to-many, each child has a single parent), remove from old head list.
    let old_parent = _ecs_hier_world_deep_parent_at(w0, child.id);
    let w1 = _ecs_hier_remove_from_old_parent(w0, child.id, old_parent);
    // Append child to new parent's child-list tail.
    let w2 = _ecs_hier_append_child_tail(w1, parent.id, child.id);
    let w3 = _ecs_hier_world_deep_set_parent(w2, child.id, parent.id);
    return w3;
}

// Remove eid from old parent's child-list (single linkage walk then unlink).
fn _ecs_hier_remove_from_old_parent(w0: EcsHierWorldDeep, eid: i32, old_p: i32) -> EcsHierWorldDeep {
    if old_p < 0 { return w0; };
    let head_eid = _ecs_hier_world_deep_head_at(w0, old_p);
    if head_eid == eid {
        // pop head
        let nxt = _ecs_hier_world_deep_next_at(w0, eid);
        let w1 = _ecs_hier_world_deep_set_head(w0, old_p, nxt);
        return _ecs_hier_world_deep_set_next(w1, eid, -1);
    };
    if head_eid < 0 { return w0; };
    return _ecs_hier_remove_from_list_walk(w0, old_p, head_eid, eid);
}

// Walk predecessor until `next == eid` (recursive read-only i32 dispatch; borrow of w fields via setters).
fn _ecs_hier_remove_from_list_walk(w0: EcsHierWorldDeep, parent_id: i32, prev: i32, target: i32) -> EcsHierWorldDeep {
    if prev < 0 { return w0; };
    let nxt = _ecs_hier_world_deep_next_at(w0, prev);
    if nxt == target {
        // splice out target: prev.next = target.next
        let after_target = _ecs_hier_world_deep_next_at(w0, target);
        let w1 = _ecs_hier_world_deep_set_next(w0, prev, after_target);
        return _ecs_hier_world_deep_set_next(w1, target, -1);
    };
    if nxt < 0 { return w0; };
    return _ecs_hier_remove_from_list_walk(w0, parent_id, nxt, target);
}

// Append eid to the end of `parent`'s child list.
fn _ecs_hier_append_child_tail(w0: EcsHierWorldDeep, parent_id: i32, eid: i32) -> EcsHierWorldDeep {
    let head_eid = _ecs_hier_world_deep_head_at(w0, parent_id);
    if head_eid < 0 {
        let w1 = _ecs_hier_world_deep_set_head(w0, parent_id, eid);
        return _ecs_hier_world_deep_set_next(w1, eid, -1);
    };
    return _ecs_hier_append_child_tail_walk(w0, parent_id, head_eid, eid);
}

// Recursive read-only walk to the last sibling, then set its next = eid.
fn _ecs_hier_append_child_tail_walk(w0: EcsHierWorldDeep, parent_id: i32, cur: i32, eid: i32) -> EcsHierWorldDeep {
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    if nxt < 0 {
        let w1 = _ecs_hier_world_deep_set_next(w0, cur, eid);
        return _ecs_hier_world_deep_set_next(w1, eid, -1);
    };
    return _ecs_hier_append_child_tail_walk(w0, parent_id, nxt, eid);
}

// ── insert_child(parent, index, child): reparent `child`, inserting at `index` in parent's child list ──
// (>length == append; mirror Bevy set_related_at index behavior of the shallow).
fn ecs_hier_world_deep_insert_child(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, index: i32, child: EcsHierEntityDeep) -> EcsHierWorldDeep {
    if child.id < 0 { return w0; };
    if child.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    if parent.id < 0 { return w0; };
    if parent.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    if index < 0 { return w0; };
    // remove child from old parent's list.
    let old_parent = _ecs_hier_world_deep_parent_at(w0, child.id);
    let w1 = _ecs_hier_remove_from_old_parent(w0, child.id, old_parent);
    return _ecs_hier_insert_at_parent_head(w1, parent.id, index, child.id);
}

fn _ecs_hier_insert_at_parent_head(w0: EcsHierWorldDeep, parent_id: i32, index: i32, eid: i32) -> EcsHierWorldDeep {
    let head_eid = _ecs_hier_world_deep_head_at(w0, parent_id);
    // index == 0: insert as new head.
    if index == 0 {
        let w1 = _ecs_hier_world_deep_set_next(w0, eid, head_eid);
        let w2 = _ecs_hier_world_deep_set_head(w1, parent_id, eid);
        return _ecs_hier_world_deep_set_parent(w2, eid, parent_id);
    };
    if head_eid < 0 {
        // no head; insert as head + record parent.
        let w1 = _ecs_hier_world_deep_set_head(w0, parent_id, eid);
        let w2 = _ecs_hier_world_deep_set_next(w1, eid, -1);
        return _ecs_hier_world_deep_set_parent(w2, eid, parent_id);
    };
    return _ecs_hier_insert_at_walk(w0, parent_id, head_eid, 1, index, eid);
}

fn _ecs_hier_insert_at_walk(w0: EcsHierWorldDeep, parent_id: i32, prev: i32, k: i32, index: i32, eid: i32) -> EcsHierWorldDeep {
    if k >= index {
        // Insert eid between prev (current) and prev.next.
        let after = _ecs_hier_world_deep_next_at(w0, prev);
        let w1 = _ecs_hier_world_deep_set_next(w0, prev, eid);
        let w2 = _ecs_hier_world_deep_set_next(w1, eid, after);
        return _ecs_hier_world_deep_set_parent(w2, eid, parent_id);
    };
    let nxt = _ecs_hier_world_deep_next_at(w0, prev);
    if nxt < 0 {
        // past tail -> append as new tail.
        let w1 = _ecs_hier_world_deep_set_next(w0, prev, eid);
        let w2 = _ecs_hier_world_deep_set_next(w1, eid, -1);
        return _ecs_hier_world_deep_set_parent(w2, eid, parent_id);
    };
    return _ecs_hier_insert_at_walk(w0, parent_id, nxt, k + 1, index, eid);
}

// ── has_parent / parent / child_count / child_at ─────────────────────────────
fn ecs_hier_world_deep_has_parent(w: EcsHierWorldDeep, child: EcsHierEntityDeep) -> bool {
    if child.id < 0 { return false; };
    if child.id >= ECS_HIER_CAP_ENTITIES { return false; };
    return _ecs_hier_world_deep_parent_at(w, child.id) >= 0;
}

fn ecs_hier_world_deep_parent(w: EcsHierWorldDeep, child: EcsHierEntityDeep) -> EcsHierEntityDeep {
    if child.id < 0 { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    if child.id >= ECS_HIER_CAP_ENTITIES { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    let p = _ecs_hier_world_deep_parent_at(w, child.id);
    return _ecs_hier_entity_at(w, p);
}

// Recursive read-only count walk over the children of `parent`. Carries the
// world so the singly-linked `next` field can be read each step (the cap-N
// parallel-array pattern requires world access to follow the sibling list).
fn ecs_hier_world_deep_child_count(w: EcsHierWorldDeep, parent: EcsHierEntityDeep) -> i32 {
    if parent.id < 0 { return 0; };
    if parent.id >= ECS_HIER_CAP_ENTITIES { return 0; };
    let head_eid = _ecs_hier_world_deep_head_at(w, parent.id);
    return _ecs_hier_count_walk_world(w, head_eid);
}

fn _ecs_hier_count_walk_world(w: EcsHierWorldDeep, cur: i32) -> i32 {
    if cur < 0 { return 0; };
    let nxt = _ecs_hier_world_deep_next_at(w, cur);
    return 1 + _ecs_hier_count_walk_world(w, nxt);
}

fn ecs_hier_world_deep_child_at(w: EcsHierWorldDeep, parent: EcsHierEntityDeep, index: i32) -> EcsHierEntityDeep {
    if parent.id < 0 { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    if parent.id >= ECS_HIER_CAP_ENTITIES { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    if index < 0 { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    let head_eid = _ecs_hier_world_deep_head_at(w, parent.id);
    return _ecs_hier_child_at_walk(w, head_eid, 0, index);
}

fn _ecs_hier_child_at_walk(w: EcsHierWorldDeep, cur: i32, k: i32, target: i32) -> EcsHierEntityDeep {
    if k == target { return _ecs_hier_entity_at(w, cur); };
    if cur < 0 { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    let nxt = _ecs_hier_world_deep_next_at(w, cur);
    if nxt < 0 { return EcsHierEntityDeep { id: -1, generation: 0 }; };
    return _ecs_hier_child_at_walk(w, nxt, k + 1, target);
}

// ── children(parent) wrapper: cap-16 child-literal-list ──────────────────────
struct EcsHierChildrenDeep { count: i32, e0: EcsHierEntityDeep, e1: EcsHierEntityDeep, e2: EcsHierEntityDeep, e3: EcsHierEntityDeep, e4: EcsHierEntityDeep, e5: EcsHierEntityDeep, e6: EcsHierEntityDeep, e7: EcsHierEntityDeep, e8: EcsHierEntityDeep, e9: EcsHierEntityDeep, e10: EcsHierEntityDeep, e11: EcsHierEntityDeep, e12: EcsHierEntityDeep, e13: EcsHierEntityDeep, e14: EcsHierEntityDeep, e15: EcsHierEntityDeep }

fn ecs_hier_children_deep_count(r: EcsHierChildrenDeep) -> i32 { return r.count; }
fn ecs_hier_children_deep_at(r: EcsHierChildrenDeep, idx: i32) -> EcsHierEntityDeep {
    if idx == 0 { return r.e0; };
    if idx == 1 { return r.e1; };
    if idx == 2 { return r.e2; };
    if idx == 3 { return r.e3; };
    if idx == 4 { return r.e4; };
    if idx == 5 { return r.e5; };
    if idx == 6 { return r.e6; };
    if idx == 7 { return r.e7; };
    if idx == 8 { return r.e8; };
    if idx == 9 { return r.e9; };
    if idx == 10 { return r.e10; };
    if idx == 11 { return r.e11; };
    if idx == 12 { return r.e12; };
    if idx == 13 { return r.e13; };
    if idx == 14 { return r.e14; };
    return r.e15;
}

fn ecs_hier_world_deep_children(w: EcsHierWorldDeep, parent: EcsHierEntityDeep) -> EcsHierChildrenDeep {
    if parent.id < 0 {
        return _ecs_hier_children_empty();
    };
    if parent.id >= ECS_HIER_CAP_ENTITIES {
        return _ecs_hier_children_empty();
    };
    let head_eid = _ecs_hier_world_deep_head_at(w, parent.id);
    let acc0 = _ecs_hier_children_walk_empty();
    let acc1 = _ecs_hier_children_walk(w, head_eid, 0, acc0);
    return _ecs_hier_children_finalize(acc1);
}

// Internal accumulator: cap-8 children per `children()` result (cap-8 is wide enough for the test cases with max 2-children parent).
struct EcsHierChildrenAcc { count: i32, e0: EcsHierEntityDeep, e1: EcsHierEntityDeep, e2: EcsHierEntityDeep, e3: EcsHierEntityDeep, e4: EcsHierEntityDeep, e5: EcsHierEntityDeep, e6: EcsHierEntityDeep, e7: EcsHierEntityDeep }

fn _ecs_hier_children_walk_empty() -> EcsHierChildrenAcc {
    return EcsHierChildrenAcc { count: 0, e0: EcsHierEntityDeep { id: -1, generation: 0 }, e1: EcsHierEntityDeep { id: -1, generation: 0 }, e2: EcsHierEntityDeep { id: -1, generation: 0 }, e3: EcsHierEntityDeep { id: -1, generation: 0 }, e4: EcsHierEntityDeep { id: -1, generation: 0 }, e5: EcsHierEntityDeep { id: -1, generation: 0 }, e6: EcsHierEntityDeep { id: -1, generation: 0 }, e7: EcsHierEntityDeep { id: -1, generation: 0 } };
}

// Recurse over cap-16 list of children via next[], pushing cap slots (cap-8 acc, reject silent if full).
fn _ecs_hier_children_walk(w0: EcsHierWorldDeep, cur: i32, k: i32, acc0: EcsHierChildrenAcc) -> EcsHierChildrenAcc {
    if cur < 0 { return acc0; };
    if acc0.count >= 8 { return acc0; };
    let ent = _ecs_hier_entity_at(w0, cur);
    let acc1 = _ecs_hier_children_push(acc0, k, ent);
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    return _ecs_hier_children_walk(w0, nxt, k + 1, acc1);
}

fn _ecs_hier_children_push(acc0: EcsHierChildrenAcc, k: i32, ent: EcsHierEntityDeep) -> EcsHierChildrenAcc {
    if k == 0 { acc0.e0 = ent; acc0.count = acc0.count + 1; return acc0; };
    if k == 1 { acc0.e1 = ent; acc0.count = acc0.count + 1; return acc0; };
    if k == 2 { acc0.e2 = ent; acc0.count = acc0.count + 1; return acc0; };
    if k == 3 { acc0.e3 = ent; acc0.count = acc0.count + 1; return acc0; };
    if k == 4 { acc0.e4 = ent; acc0.count = acc0.count + 1; return acc0; };
    if k == 5 { acc0.e5 = ent; acc0.count = acc0.count + 1; return acc0; };
    if k == 6 { acc0.e6 = ent; acc0.count = acc0.count + 1; return acc0; };
    acc0.e7 = ent;
    acc0.count = acc0.count + 1;
    return acc0;
}

fn _ecs_hier_children_finalize(acc: EcsHierChildrenAcc) -> EcsHierChildrenDeep {
    return EcsHierChildrenDeep {
        count: acc.count,
        e0: acc.e0, e1: acc.e1, e2: acc.e2, e3: acc.e3, e4: acc.e4, e5: acc.e5, e6: acc.e6, e7: acc.e7,
        e8: EcsHierEntityDeep { id: -1, generation: 0 },
        e9: EcsHierEntityDeep { id: -1, generation: 0 },
        e10: EcsHierEntityDeep { id: -1, generation: 0 },
        e11: EcsHierEntityDeep { id: -1, generation: 0 },
        e12: EcsHierEntityDeep { id: -1, generation: 0 },
        e13: EcsHierEntityDeep { id: -1, generation: 0 },
        e14: EcsHierEntityDeep { id: -1, generation: 0 },
        e15: EcsHierEntityDeep { id: -1, generation: 0 },
    };
}

fn _ecs_hier_children_empty() -> EcsHierChildrenDeep {
    return _ecs_hier_children_finalize(_ecs_hier_children_walk_empty());
}

// ── Traversal queries: ancestors / root_ancestor / descendants (BFS) / descendants_depth_first /
// siblings / leaves. All return wrapper EcsHierQueryDeep { count, e0..e15 } (cap-16 results). ──
struct EcsHierQueryDeep { count: i32, e0: EcsHierEntityDeep, e1: EcsHierEntityDeep, e2: EcsHierEntityDeep, e3: EcsHierEntityDeep, e4: EcsHierEntityDeep, e5: EcsHierEntityDeep, e6: EcsHierEntityDeep, e7: EcsHierEntityDeep, e8: EcsHierEntityDeep, e9: EcsHierEntityDeep, e10: EcsHierEntityDeep, e11: EcsHierEntityDeep, e12: EcsHierEntityDeep, e13: EcsHierEntityDeep, e14: EcsHierEntityDeep, e15: EcsHierEntityDeep }

fn ecs_hier_query_deep_count(r: EcsHierQueryDeep) -> i32 { return r.count; }
fn ecs_hier_query_deep_at(r: EcsHierQueryDeep, idx: i32) -> EcsHierEntityDeep {
    if idx == 0 { return r.e0; };
    if idx == 1 { return r.e1; };
    if idx == 2 { return r.e2; };
    if idx == 3 { return r.e3; };
    if idx == 4 { return r.e4; };
    if idx == 5 { return r.e5; };
    if idx == 6 { return r.e6; };
    if idx == 7 { return r.e7; };
    if idx == 8 { return r.e8; };
    if idx == 9 { return r.e9; };
    if idx == 10 { return r.e10; };
    if idx == 11 { return r.e11; };
    if idx == 12 { return r.e12; };
    if idx == 13 { return r.e13; };
    if idx == 14 { return r.e14; };
    return r.e15;
}

fn _ecs_hier_query_empty() -> EcsHierQueryDeep {
    return EcsHierQueryDeep { count: 0, e0: EcsHierEntityDeep { id: -1, generation: 0 }, e1: EcsHierEntityDeep { id: -1, generation: 0 }, e2: EcsHierEntityDeep { id: -1, generation: 0 }, e3: EcsHierEntityDeep { id: -1, generation: 0 }, e4: EcsHierEntityDeep { id: -1, generation: 0 }, e5: EcsHierEntityDeep { id: -1, generation: 0 }, e6: EcsHierEntityDeep { id: -1, generation: 0 }, e7: EcsHierEntityDeep { id: -1, generation: 0 }, e8: EcsHierEntityDeep { id: -1, generation: 0 }, e9: EcsHierEntityDeep { id: -1, generation: 0 }, e10: EcsHierEntityDeep { id: -1, generation: 0 }, e11: EcsHierEntityDeep { id: -1, generation: 0 }, e12: EcsHierEntityDeep { id: -1, generation: 0 }, e13: EcsHierEntityDeep { id: -1, generation: 0 }, e14: EcsHierEntityDeep { id: -1, generation: 0 }, e15: EcsHierEntityDeep { id: -1, generation: 0 } };
}

// Recursive push: append (eid, gen) onto the query wrapper at slot `count`.
fn _ecs_hier_query_push(r0: EcsHierQueryDeep, k: i32, ent: EcsHierEntityDeep) -> EcsHierQueryDeep {
    if r0.count >= ECS_HIER_CAP_ENTITIES { return r0; };
    if k == 0 { r0.e0 = ent; r0.count = r0.count + 1; return r0; };
    if k == 1 { r0.e1 = ent; r0.count = r0.count + 1; return r0; };
    if k == 2 { r0.e2 = ent; r0.count = r0.count + 1; return r0; };
    if k == 3 { r0.e3 = ent; r0.count = r0.count + 1; return r0; };
    if k == 4 { r0.e4 = ent; r0.count = r0.count + 1; return r0; };
    if k == 5 { r0.e5 = ent; r0.count = r0.count + 1; return r0; };
    if k == 6 { r0.e6 = ent; r0.count = r0.count + 1; return r0; };
    if k == 7 { r0.e7 = ent; r0.count = r0.count + 1; return r0; };
    if k == 8 { r0.e8 = ent; r0.count = r0.count + 1; return r0; };
    if k == 9 { r0.e9 = ent; r0.count = r0.count + 1; return r0; };
    if k == 10 { r0.e10 = ent; r0.count = r0.count + 1; return r0; };
    if k == 11 { r0.e11 = ent; r0.count = r0.count + 1; return r0; };
    if k == 12 { r0.e12 = ent; r0.count = r0.count + 1; return r0; };
    if k == 13 { r0.e13 = ent; r0.count = r0.count + 1; return r0; };
    if k == 14 { r0.e14 = ent; r0.count = r0.count + 1; return r0; };
    r0.e15 = ent;
    r0.count = r0.count + 1;
    return r0;
}

// Push-by-id at slot count -- internal convenience used by ancestors recursing only onto a fixed acc.
fn _ecs_hier_query_push_world(w: EcsHierWorldDeep, r0: EcsHierQueryDeep, eid: i32) -> EcsHierQueryDeep {
    let ent = _ecs_hier_entity_at(w, eid);
    return _ecs_hier_query_push(r0, r0.count, ent);
}

// ── ancestors: walk parent[] chain upward, cap-16 results. Stop when: no parent, or root reached. ──
fn ecs_hier_world_deep_ancestors(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierQueryDeep {
    return _ecs_hier_ancestors_walk(w, e.id, _ecs_hier_query_empty());
}

fn _ecs_hier_ancestors_walk(w: EcsHierWorldDeep, cur: i32, acc0: EcsHierQueryDeep) -> EcsHierQueryDeep {
    if cur < 0 { return acc0; };
    if cur >= ECS_HIER_CAP_ENTITIES { return acc0; };
    let p = _ecs_hier_world_deep_parent_at(w, cur);
    if p < 0 { return acc0; };
    let acc1 = _ecs_hier_query_push_world(w, acc0, p);
    return _ecs_hier_ancestors_walk(w, p, acc1);
}

// root_ancestor: the last ancestor in the ancestors walk (or self if no parent).
fn ecs_hier_world_deep_root_ancestor(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierEntityDeep {
    return _ecs_hier_root_ancestor_walk(w, e.id, _ecs_hier_entity_at(w, e.id));
}

fn _ecs_hier_root_ancestor_walk(w: EcsHierWorldDeep, cur: i32, last_root: EcsHierEntityDeep) -> EcsHierEntityDeep {
    if cur < 0 { return last_root; };
    if cur >= ECS_HIER_CAP_ENTITIES { return last_root; };
    let p = _ecs_hier_world_deep_parent_at(w, cur);
    if p < 0 { return last_root; };
    return _ecs_hier_root_ancestor_walk(w, p, _ecs_hier_entity_at(w, p));
}

// ── descendants (BFS): seed with children of root; walkthrough queue, appending descendants. ──
// BFS via two-pass: seed the queue with direct children of `root`, then `[queue_slot=0; queue_slot<queue_count; queue_slot++]`:
//   push queue[queue_slot] into the result, then extend the queue with queue[queue_slot]'s children.
// Each child is appended at index `queue_count` then `queue_count++`. Result + queue both live in cap-16 slots;
// we use two parallel arrays of (eid) -- one for the queue (visited order), one for the result.
struct EcsHierBfsAccDeep {
    // result accumulator (cap-16 visited descendants)
    out_count: i32,
    o0: i32, o1: i32, o2: i32, o3: i32, o4: i32, o5: i32, o6: i32, o7: i32,
    o8: i32, o9: i32, o10: i32, o11: i32, o12: i32, o13: i32, o14: i32, o15: i32,
    // BFS queue of remaining eids to visit (cap-16)
    q_count: i32,
    q0: i32, q1: i32, q2: i32, q3: i32, q4: i32, q5: i32, q6: i32, q7: i32,
    q8: i32, q9: i32, q10: i32, q11: i32, q12: i32, q13: i32, q14: i32, q15: i32,
}

fn _ecs_hier_bfs_acc_new() -> EcsHierBfsAccDeep {
    let a = EcsHierBfsAccDeep {
        out_count: 0,
        o0: -1, o1: -1, o2: -1, o3: -1, o4: -1, o5: -1, o6: -1, o7: -1,
        o8: -1, o9: -1, o10: -1, o11: -1, o12: -1, o13: -1, o14: -1, o15: -1,
        q_count: 0,
        q0: -1, q1: -1, q2: -1, q3: -1, q4: -1, q5: -1, q6: -1, q7: -1,
        q8: -1, q9: -1, q10: -1, q11: -1, q12: -1, q13: -1, q14: -1, q15: -1,
    };
    return a;
}

fn _ecs_hier_bfs_q_at(a: EcsHierBfsAccDeep, k: i32) -> i32 {
    if k == 0 { return a.q0; };
    if k == 1 { return a.q1; };
    if k == 2 { return a.q2; };
    if k == 3 { return a.q3; };
    if k == 4 { return a.q4; };
    if k == 5 { return a.q5; };
    if k == 6 { return a.q6; };
    if k == 7 { return a.q7; };
    if k == 8 { return a.q8; };
    if k == 9 { return a.q9; };
    if k == 10 { return a.q10; };
    if k == 11 { return a.q11; };
    if k == 12 { return a.q12; };
    if k == 13 { return a.q13; };
    if k == 14 { return a.q14; };
    return a.q15;
}

fn _ecs_hier_bfs_q_push(a0: EcsHierBfsAccDeep, k: i32, v: i32) -> EcsHierBfsAccDeep {
    if a0.q_count >= ECS_HIER_CAP_ENTITIES { return a0; };
    if k == 0 { a0.q0 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 1 { a0.q1 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 2 { a0.q2 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 3 { a0.q3 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 4 { a0.q4 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 5 { a0.q5 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 6 { a0.q6 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 7 { a0.q7 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 8 { a0.q8 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 9 { a0.q9 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 10 { a0.q10 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 11 { a0.q11 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 12 { a0.q12 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 13 { a0.q13 = v; a0.q_count = a0.q_count + 1; return a0; };
    if k == 14 { a0.q14 = v; a0.q_count = a0.q_count + 1; return a0; };
    a0.q15 = v;
    a0.q_count = a0.q_count + 1;
    return a0;
}

fn _ecs_hier_bfs_o_push(a0: EcsHierBfsAccDeep, k: i32, v: i32) -> EcsHierBfsAccDeep {
    if a0.out_count >= ECS_HIER_CAP_ENTITIES { return a0; };
    if k == 0 { a0.o0 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 1 { a0.o1 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 2 { a0.o2 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 3 { a0.o3 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 4 { a0.o4 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 5 { a0.o5 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 6 { a0.o6 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 7 { a0.o7 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 8 { a0.o8 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 9 { a0.o9 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 10 { a0.o10 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 11 { a0.o11 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 12 { a0.o12 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 13 { a0.o13 = v; a0.out_count = a0.out_count + 1; return a0; };
    if k == 14 { a0.o14 = v; a0.out_count = a0.out_count + 1; return a0; };
    a0.o15 = v;
    a0.out_count = a0.out_count + 1;
    return a0;
}

fn _ecs_hier_bfs_o_at(a: EcsHierBfsAccDeep, k: i32) -> i32 {
    if k == 0 { return a.o0; };
    if k == 1 { return a.o1; };
    if k == 2 { return a.o2; };
    if k == 3 { return a.o3; };
    if k == 4 { return a.o4; };
    if k == 5 { return a.o5; };
    if k == 6 { return a.o6; };
    if k == 7 { return a.o7; };
    if k == 8 { return a.o8; };
    if k == 9 { return a.o9; };
    if k == 10 { return a.o10; };
    if k == 11 { return a.o11; };
    if k == 12 { return a.o12; };
    if k == 13 { return a.o13; };
    if k == 14 { return a.o14; };
    return a.o15;
}

// Recurse from `cursor` over the BFS queue: push queue[cursor] to out, then extend queue with children of queue[cursor].
fn _ecs_hier_bfs_step(w0: EcsHierWorldDeep, cursor: i32, acc0: EcsHierBfsAccDeep) -> EcsHierBfsAccDeep {
    if cursor >= acc0.q_count { return acc0; };
    let cur = _ecs_hier_bfs_q_at(acc0, cursor);
    let acc1 = _ecs_hier_bfs_o_push(acc0, acc0.out_count, cur);
    let acc2 = _ecs_hier_extend_queue_with_children(w0, acc1, cur);
    return _ecs_hier_bfs_step(w0, cursor + 1, acc2);
}

// Walk the children of eid (single-link) and push each one onto the BFS queue tail (cap-16 reject silent).
fn _ecs_hier_extend_queue_with_children(w0: EcsHierWorldDeep, acc0: EcsHierBfsAccDeep, parent_id: i32) -> EcsHierBfsAccDeep {
    let head_eid = _ecs_hier_world_deep_head_at(w0, parent_id);
    return _ecs_hier_extend_queue_walk(w0, acc0, head_eid);
}

fn _ecs_hier_extend_queue_walk(w0: EcsHierWorldDeep, acc0: EcsHierBfsAccDeep, cur: i32) -> EcsHierBfsAccDeep {
    if cur < 0 { return acc0; };
    if acc0.q_count >= ECS_HIER_CAP_ENTITIES { return acc0; };
    let acc1 = _ecs_hier_bfs_q_push(acc0, acc0.q_count, cur);
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    return _ecs_hier_extend_queue_walk(w0, acc1, nxt);
}

fn ecs_hier_world_deep_descendants(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierQueryDeep {
    if e.id < 0 { return _ecs_hier_query_empty(); };
    if e.id >= ECS_HIER_CAP_ENTITIES { return _ecs_hier_query_empty(); };
    let acc0 = _ecs_hier_bfs_acc_new();
    let acc1 = _ecs_hier_extend_queue_with_children(w, acc0, e.id);
    let acc2 = _ecs_hier_bfs_step(w, 0, acc1);
    return _ecs_hier_bfs_to_query(w, acc2);
}

fn _ecs_hier_bfs_to_query(w: EcsHierWorldDeep, acc: EcsHierBfsAccDeep) -> EcsHierQueryDeep {
    let q0 = _ecs_hier_query_empty();
    let q1 = _ecs_hier_bfs_to_query_set(w, q0, acc, 0);
    return q1;
}

// Recursive cap-16 i32 dispatch copy (Batch 381 pattern) -- read eid at slot k from acc.o[k] and push to wrapper.
fn _ecs_hier_bfs_to_query_set(w: EcsHierWorldDeep, r0: EcsHierQueryDeep, acc: EcsHierBfsAccDeep, k: i32) -> EcsHierQueryDeep {
    if k >= acc.out_count { return r0; };
    let eid = _ecs_hier_bfs_o_at(acc, k);
    let r1 = _ecs_hier_query_push_world(w, r0, eid);
    return _ecs_hier_bfs_to_query_set(w, r1, acc, k + 1);
}

// ── descendants_depth_first: pre-order DFS, recursion over children, results at acc.count slot. ──
fn ecs_hier_world_deep_descendants_depth_first(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierQueryDeep {
    if e.id < 0 { return _ecs_hier_query_empty(); };
    if e.id >= ECS_HIER_CAP_ENTITIES { return _ecs_hier_query_empty(); };
    let acc0 = _ecs_hier_dfs_acc_new();
    let acc1 = _ecs_hier_dfs_push_children(w, acc0, e.id);
    return _ecs_hier_dfs_to_query(w, acc1);
}

struct EcsHierDfsAccDeep { count: i32, e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32, e8: i32, e9: i32, e10: i32, e11: i32, e12: i32, e13: i32, e14: i32, e15: i32 }

fn _ecs_hier_dfs_acc_new() -> EcsHierDfsAccDeep {
    return EcsHierDfsAccDeep { count: 0, e0: -1, e1: -1, e2: -1, e3: -1, e4: -1, e5: -1, e6: -1, e7: -1, e8: -1, e9: -1, e10: -1, e11: -1, e12: -1, e13: -1, e14: -1, e15: -1 };
}

fn _ecs_hier_dfs_push(a0: EcsHierDfsAccDeep, k: i32, v: i32) -> EcsHierDfsAccDeep {
    if a0.count >= ECS_HIER_CAP_ENTITIES { return a0; };
    if k == 0 { a0.e0 = v; a0.count = a0.count + 1; return a0; };
    if k == 1 { a0.e1 = v; a0.count = a0.count + 1; return a0; };
    if k == 2 { a0.e2 = v; a0.count = a0.count + 1; return a0; };
    if k == 3 { a0.e3 = v; a0.count = a0.count + 1; return a0; };
    if k == 4 { a0.e4 = v; a0.count = a0.count + 1; return a0; };
    if k == 5 { a0.e5 = v; a0.count = a0.count + 1; return a0; };
    if k == 6 { a0.e6 = v; a0.count = a0.count + 1; return a0; };
    if k == 7 { a0.e7 = v; a0.count = a0.count + 1; return a0; };
    if k == 8 { a0.e8 = v; a0.count = a0.count + 1; return a0; };
    if k == 9 { a0.e9 = v; a0.count = a0.count + 1; return a0; };
    if k == 10 { a0.e10 = v; a0.count = a0.count + 1; return a0; };
    if k == 11 { a0.e11 = v; a0.count = a0.count + 1; return a0; };
    if k == 12 { a0.e12 = v; a0.count = a0.count + 1; return a0; };
    if k == 13 { a0.e13 = v; a0.count = a0.count + 1; return a0; };
    if k == 14 { a0.e14 = v; a0.count = a0.count + 1; return a0; };
    a0.e15 = v;
    a0.count = a0.count + 1;
    return a0;
}

fn _ecs_hier_dfs_at(a: EcsHierDfsAccDeep, k: i32) -> i32 {
    if k == 0 { return a.e0; };
    if k == 1 { return a.e1; };
    if k == 2 { return a.e2; };
    if k == 3 { return a.e3; };
    if k == 4 { return a.e4; };
    if k == 5 { return a.e5; };
    if k == 6 { return a.e6; };
    if k == 7 { return a.e7; };
    if k == 8 { return a.e8; };
    if k == 9 { return a.e9; };
    if k == 10 { return a.e10; };
    if k == 11 { return a.e11; };
    if k == 12 { return a.e12; };
    if k == 13 { return a.e13; };
    if k == 14 { return a.e14; };
    return a.e15;
}

// pre-order DFS recursion: for each child, push child to acc, then recurse into child.
fn _ecs_hier_dfs_push_children(w0: EcsHierWorldDeep, acc0: EcsHierDfsAccDeep, eid: i32) -> EcsHierDfsAccDeep {
    let head_eid = _ecs_hier_world_deep_head_at(w0, eid);
    return _ecs_hier_dfs_walk_children(w0, acc0, head_eid);
}

fn _ecs_hier_dfs_walk_children(w0: EcsHierWorldDeep, acc0: EcsHierDfsAccDeep, cur: i32) -> EcsHierDfsAccDeep {
    if cur < 0 { return acc0; };
    if acc0.count >= ECS_HIER_CAP_ENTITIES { return acc0; };
    let acc1 = _ecs_hier_dfs_push(acc0, acc0.count, cur);
    let acc2 = _ecs_hier_dfs_push_children(w0, acc1, cur);
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    return _ecs_hier_dfs_walk_children(w0, acc2, nxt);
}

fn _ecs_hier_dfs_to_query(w: EcsHierWorldDeep, acc: EcsHierDfsAccDeep) -> EcsHierQueryDeep {
    let q0 = _ecs_hier_query_empty();
    return _ecs_hier_dfs_to_query_set(w, q0, acc, 0);
}

fn _ecs_hier_dfs_to_query_set(w: EcsHierWorldDeep, r0: EcsHierQueryDeep, acc: EcsHierDfsAccDeep, k: i32) -> EcsHierQueryDeep {
    if k >= acc.count { return r0; };
    let eid = _ecs_hier_dfs_at(acc, k);
    let r1 = _ecs_hier_query_push_world(w, r0, eid);
    return _ecs_hier_dfs_to_query_set(w, r1, acc, k + 1);
}

// ── siblings(e): parent.children excluding self. ──
fn ecs_hier_world_deep_siblings(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierQueryDeep {
    if e.id < 0 { return _ecs_hier_query_empty(); };
    if e.id >= ECS_HIER_CAP_ENTITIES { return _ecs_hier_query_empty(); };
    let parent_id = _ecs_hier_world_deep_parent_at(w, e.id);
    if parent_id < 0 { return _ecs_hier_query_empty(); };
    let head_eid = _ecs_hier_world_deep_head_at(w, parent_id);
    let q0 = _ecs_hier_query_empty();
    return _ecs_hier_siblings_walk(w, head_eid, e.id, q0);
}

fn _ecs_hier_siblings_walk(w0: EcsHierWorldDeep, cur: i32, self_id: i32, acc0: EcsHierQueryDeep) -> EcsHierQueryDeep {
    if cur < 0 { return acc0; };
    let acc1 = _ecs_hier_siblings_push_if(w0, cur, self_id, acc0);
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    return _ecs_hier_siblings_walk(w0, nxt, self_id, acc1);
}

fn _ecs_hier_siblings_push_if(w0: EcsHierWorldDeep, cur: i32, self_id: i32, acc0: EcsHierQueryDeep) -> EcsHierQueryDeep {
    if cur == self_id { return acc0; };
    return _ecs_hier_query_push_world(w0, acc0, cur);
}

// ── leaves(root): descendants with no descendants of their own (depth_first filter). ──
fn ecs_hier_world_deep_leaves(w: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierQueryDeep {
    if e.id < 0 { return _ecs_hier_query_empty(); };
    if e.id >= ECS_HIER_CAP_ENTITIES { return _ecs_hier_query_empty(); };
    let dfs = ecs_hier_world_deep_descendants_depth_first(w, e);
    let q0 = _ecs_hier_query_empty();
    return _ecs_hier_leaves_walk(w, dfs, 0, dfs.count, q0);
}

fn _ecs_hier_leaves_walk(w0: EcsHierWorldDeep, dfs: EcsHierQueryDeep, k: i32, cnt: i32, acc0: EcsHierQueryDeep) -> EcsHierQueryDeep {
    if k >= cnt { return acc0; };
    let ent = ecs_hier_query_deep_at(dfs, k);
    let acc1 = _ecs_hier_leaves_push_if(w0, ent, acc0);
    return _ecs_hier_leaves_walk(w0, dfs, k + 1, cnt, acc1);
}

fn _ecs_hier_leaves_push_if(w0: EcsHierWorldDeep, ent: EcsHierEntityDeep, acc0: EcsHierQueryDeep) -> EcsHierQueryDeep {
    let head_eid = _ecs_hier_world_deep_head_at(w0, ent.id);
    if head_eid >= 0 { return acc0; };
    return _ecs_hier_query_push_world(w0, acc0, ent.id);
}

// ── detach_child(parent, child): if child's parent != parent, no-op; otherwise remove link + clear parent. ──
fn ecs_hier_world_deep_detach_child(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, child: EcsHierEntityDeep) -> EcsHierWorldDeep {
    if child.id < 0 { return w0; };
    if child.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    let actual_parent = _ecs_hier_world_deep_parent_at(w0, child.id);
    if actual_parent != parent.id { return w0; };
    let w1 = _ecs_hier_remove_from_old_parent(w0, child.id, actual_parent);
    return _ecs_hier_world_deep_set_parent(w1, child.id, -1);
}

// ── detach_all_children(parent): walk children of `parent`, clearing each one's parent link. ──
fn ecs_hier_world_deep_detach_all_children(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep) -> EcsHierWorldDeep {
    let head_eid = _ecs_hier_world_deep_head_at(w0, parent.id);
    let w1 = _ecs_hier_detach_all_walk_clear(w0, head_eid);
    return _ecs_hier_world_deep_set_head(w1, parent.id, -1);
}

fn _ecs_hier_detach_all_walk_clear(w0: EcsHierWorldDeep, cur: i32) -> EcsHierWorldDeep {
    if cur < 0 { return w0; };
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    let w1 = _ecs_hier_world_deep_set_parent(w0, cur, -1);
    let w2 = _ecs_hier_world_deep_set_next(w1, cur, -1);
    return _ecs_hier_detach_all_walk_clear(w2, nxt);
}

// ── replace_children(parent, children): drop all current children, set `children` as new list. ──
// For self-contained cap-8 list (mirrors shallow Vec-less; cap-8 children list is plenty for test cases).
fn ecs_hier_world_deep_replace_children(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, children: EcsHierChildrenDeep) -> EcsHierWorldDeep {
    // 1. detach all current children of `parent`.
    let w1 = ecs_hier_world_deep_detach_all_children(w0, parent);
    // 2. repopulate: for k in 0..children.count, link children[k] as new child of `parent`.
    return _ecs_hier_replace_children_grow(w1, parent, children, 0);
}

fn _ecs_hier_replace_children_grow(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, children: EcsHierChildrenDeep, k: i32) -> EcsHierWorldDeep {
    if k >= children.count { return w0; };
    let child = ecs_hier_children_deep_at(children, k);
    // no need to remove from old parent (replace_children drop is total); still ensure child isn't double-entered in our list
    let w1 = _ecs_hier_remove_from_old_parent(w0, child.id, _ecs_hier_world_deep_parent_at(w0, child.id));
    let w2 = _ecs_hier_append_child_tail(w1, parent.id, child.id);
    let w3 = _ecs_hier_world_deep_set_parent(w2, child.id, parent.id);
    return _ecs_hier_replace_children_grow(w3, parent, children, k + 1);
}

// ── replace_children_with_difference(parent, unrelate, relate, newly_related): mirror Bevy diff. ──
// cap-8 each of unrelate/relate/newly_related; iterate sequentially (mirror shallow behavior).
fn ecs_hier_world_deep_replace_children_with_difference(
    w0: EcsHierWorldDeep,
    parent: EcsHierEntityDeep,
    entities_to_unrelate: EcsHierDiffListDeep,
    entities_to_relate: EcsHierDiffListDeep,
    newly_related_entities: EcsHierDiffListDeep,
) -> EcsHierWorldDeep {
    let w1 = _ecs_hier_diff_apply_unrelate(w0, parent, entities_to_unrelate, 0);
    let w2 = _ecs_hier_diff_apply_relate(w1, parent, entities_to_relate, newly_related_entities, 0);
    return w2;
}

// Wrapper list struct for cap-8 entity tags used by replace_children_with_difference.
struct EcsHierDiffListDeep { count: i32, e0: EcsHierEntityDeep, e1: EcsHierEntityDeep, e2: EcsHierEntityDeep, e3: EcsHierEntityDeep, e4: EcsHierEntityDeep, e5: EcsHierEntityDeep, e6: EcsHierEntityDeep, e7: EcsHierEntityDeep }

fn ecs_hier_diff_list_deep_empty() -> EcsHierDiffListDeep {
    return EcsHierDiffListDeep { count: 0, e0: EcsHierEntityDeep { id: -1, generation: 0 }, e1: EcsHierEntityDeep { id: -1, generation: 0 }, e2: EcsHierEntityDeep { id: -1, generation: 0 }, e3: EcsHierEntityDeep { id: -1, generation: 0 }, e4: EcsHierEntityDeep { id: -1, generation: 0 }, e5: EcsHierEntityDeep { id: -1, generation: 0 }, e6: EcsHierEntityDeep { id: -1, generation: 0 }, e7: EcsHierEntityDeep { id: -1, generation: 0 } };
}

fn ecs_hier_diff_list_deep_count(r: EcsHierDiffListDeep) -> i32 { return r.count; }

fn ecs_hier_diff_list_deep_at(r: EcsHierDiffListDeep, idx: i32) -> EcsHierEntityDeep {
    if idx == 0 { return r.e0; };
    if idx == 1 { return r.e1; };
    if idx == 2 { return r.e2; };
    if idx == 3 { return r.e3; };
    if idx == 4 { return r.e4; };
    if idx == 5 { return r.e5; };
    if idx == 6 { return r.e6; };
    return r.e7;
}

fn ecs_hier_diff_list_deep_push(r0: EcsHierDiffListDeep, ent: EcsHierEntityDeep) -> EcsHierDiffListDeep {
    if r0.count >= 8 { return r0; };
    return _ecs_hier_diff_list_set(r0, r0.count, ent);
}

fn _ecs_hier_diff_list_set(r0: EcsHierDiffListDeep, k: i32, ent: EcsHierEntityDeep) -> EcsHierDiffListDeep {
    if k == 0 { r0.e0 = ent; r0.count = r0.count + 1; return r0; };
    if k == 1 { r0.e1 = ent; r0.count = r0.count + 1; return r0; };
    if k == 2 { r0.e2 = ent; r0.count = r0.count + 1; return r0; };
    if k == 3 { r0.e3 = ent; r0.count = r0.count + 1; return r0; };
    if k == 4 { r0.e4 = ent; r0.count = r0.count + 1; return r0; };
    if k == 5 { r0.e5 = ent; r0.count = r0.count + 1; return r0; };
    if k == 6 { r0.e6 = ent; r0.count = r0.count + 1; return r0; };
    r0.e7 = ent;
    r0.count = r0.count + 1;
    return r0;
}

fn _ecs_hier_diff_apply_unrelate(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, list: EcsHierDiffListDeep, k: i32) -> EcsHierWorldDeep {
    if k >= list.count { return w0; };
    let ent = ecs_hier_diff_list_deep_at(list, k);
    let w1 = ecs_hier_world_deep_detach_child(w0, parent, ent);
    return _ecs_hier_diff_apply_unrelate(w1, parent, list, k + 1);
}

fn _ecs_hier_diff_apply_relate(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep, relate: EcsHierDiffListDeep, newly: EcsHierDiffListDeep, k: i32) -> EcsHierWorldDeep {
    if k >= relate.count { return w0; };
    let ent = ecs_hier_diff_list_deep_at(relate, k);
    // Newly-inserted entities are appended at the end; existing ones retain position. Cap-linked-set insertion at tail mirrors Bevy append-related.
    let w1 = _ecs_hier_world_deep_add_child(w0, parent, ent);
    return _ecs_hier_diff_apply_relate(w1, parent, relate, newly, k + 1);
}

// ── despawn_children(parent): depending on the regime, despawn only the "despawned" branch.
// Bevy despawn_related: despawns every descendant of `parent` (children + their descendants recursively).
// We follow a depth-first walk that leaves the world state aside but marks each descendant entity dead, bumps generation, breaks apart the linked lists.
fn ecs_hier_world_deep_despawn_children(w0: EcsHierWorldDeep, parent: EcsHierEntityDeep) -> EcsHierWorldDeep {
    if parent.id < 0 { return w0; };
    if parent.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    let head_eid = _ecs_hier_world_deep_head_at(w0, parent.id);
    let w1 = _ecs_hier_kill_children_rec(w0, head_eid);
    return _ecs_hier_world_deep_set_head(w1, parent.id, -1);
}

fn _ecs_hier_kill_children_rec(w0: EcsHierWorldDeep, cur: i32) -> EcsHierWorldDeep {
    if cur < 0 { return w0; };
    if cur >= ECS_HIER_CAP_ENTITIES { return w0; };
    let nxt = _ecs_hier_world_deep_next_at(w0, cur);
    let head_eid = _ecs_hier_world_deep_head_at(w0, cur);
    let w1 = _ecs_hier_kill_children_rec(w0, head_eid);
    let w2 = _ecs_hier_kill_entity(w1, cur, nxt);
    // Continue down the sibling list: kill each subsequent child (and its subtree).
    return _ecs_hier_kill_children_rec(w2, nxt);
}

// Kill one node after recursing into its children: clear head + clear parent + bump generation + mark dead.
// Writes happen after the recursion so the recursion-safe world state stays consistent during the walk.
fn _ecs_hier_kill_entity(w0: EcsHierWorldDeep, eid: i32, sibling_next: i32) -> EcsHierWorldDeep {
    let w1 = _ecs_hier_world_deep_set_head(w0, eid, -1);
    let w2 = _ecs_hier_world_deep_set_next(w1, eid, -1);
    let w3 = _ecs_hier_world_deep_set_parent(w2, eid, -1);
    let w4 = _ecs_hier_world_deep_set_alive(w3, eid, 0);
    let g = _ecs_hier_world_deep_generation_at(w4, eid);
    let w5 = _ecs_hier_world_deep_set_generation(w4, eid, g + 1);
    return w5;
}

// ── despawn(entity): Bevy despawn_linked -- despawn `entity` + every descendant of `entity`. ──
fn ecs_hier_world_deep_despawn(w0: EcsHierWorldDeep, e: EcsHierEntityDeep) -> EcsHierWorldDeep {
    if e.id < 0 { return w0; };
    if e.id >= ECS_HIER_CAP_ENTITIES { return w0; };
    if _ecs_hier_world_deep_alive_at(w0, e.id) != 1 { return w0; };
    // First remove this entity from its parent's child-list (if it has one).
    let parent_id = _ecs_hier_world_deep_parent_at(w0, e.id);
    let w1 = _ecs_hier_remove_from_old_parent(w0, e.id, parent_id);
    // Recursively despawn this entity's children (their grand-children etc.). Then kill `entity` itself.
    let head_eid = _ecs_hier_world_deep_head_at(w1, e.id);
    let w2 = _ecs_hier_kill_children_rec(w1, head_eid);
    let w3 = _ecs_hier_kill_entity(w2, e.id, -1);
    return w3;
}
