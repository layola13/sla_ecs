// Deepened Bevy ECS typed ChildOf hierarchy adapter (Batch 384).
// Mirror of the shallow `lib/hierarchy_relationship_adapter.sla` `GenericHierarchyWorld` surface
// on a self-contained cap-16 entity registry + linked-sibling ChildOf relation: NO `@import "relationship.sla"`.
// Mirror of Bevy src/hierarchy.rs (ChildOf + HierarchySystemParam) typed facade;
// the relation is a one-to-many ChildOf with `parent[entity] = parent_id (-1 = root)`,
// and children form a singly-linked sibling list via `head[entity]`/`next[entity]`.
//
// Constraints per cookbook (Batch 373-383):
//   - no Vec, no `while` traversals on test-asserted surfaces, no `let mut` i32 rebind, no `let _`,
//   - no `let w = fn(w, ...)` chained rebinds (RegisterRedefinition dodge -- sequential w0/w1/w2),
//   - tuple-return callsites replaced by wrapper structs (Batch 373 rule) with scalar accessors,
//   - cascade-of-return field-assign at top-level function scope (Batch 377),
//   - flat `let` ladder / recursive read-only i32 dispatch for accumulator walks (Batch 381/382),
//   - apply RESETS queue convention not applicable (no deferred queue here).

const ECS_HIER_CAP_ENTITIES: i32 = 16;

// ── Entity wrapper (mirrors shallow `Entity` { id, gen }) ─────────────────────
struct EcsHierEntityDeep { id: i32, generation: i32 }

fn ecs_hier_entity_eq_deep(a: EcsHierEntityDeep, b: EcsHierEntityDeep) -> bool {
    if a.id != b.id { return false; };
    if a.generation != b.generation { return false; };
    return true;
}

fn ecs_hier_entity_id_deep(a: EcsHierEntityDeep) -> i32 { return a.id; }
fn ecs_hier_entity_gen_deep(a: EcsHierEntityDeep) -> i32 { return a.generation; }

// Public constructor mirroring the shallow `Entity { id, gen }`. Exposed so deep tests can
// build arbitrary entity wrappers (out-of-range / stale-generation probes) without struct-literal construction.
fn ecs_hier_entity_new(id: i32, generation: i32) -> EcsHierEntityDeep { return EcsHierEntityDeep { id: id, generation: generation }; }

fn _ecs_hier_entity_at(w: EcsHierWorldDeep, eid: i32) -> EcsHierEntityDeep {
    return EcsHierEntityDeep { id: eid, generation: _ecs_hier_world_deep_generation_at(w, eid) };
}

// ── World (cap-16 entity registry + linked-sibling ChildOf relation) ───────────
struct EcsHierWorldDeep {
    parent0: i32, parent1: i32, parent2: i32, parent3: i32, parent4: i32, parent5: i32, parent6: i32, parent7: i32,
    parent8: i32, parent9: i32, parent10: i32, parent11: i32, parent12: i32, parent13: i32, parent14: i32, parent15: i32,
    head0: i32, head1: i32, head2: i32, head3: i32, head4: i32, head5: i32, head6: i32, head7: i32,
    head8: i32, head9: i32, head10: i32, head11: i32, head12: i32, head13: i32, head14: i32, head15: i32,
    next0: i32, next1: i32, next2: i32, next3: i32, next4: i32, next5: i32, next6: i32, next7: i32,
    next8: i32, next9: i32, next10: i32, next11: i32, next12: i32, next13: i32, next14: i32, next15: i32,
    gen0: i32, gen1: i32, gen2: i32, gen3: i32, gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    gen8: i32, gen9: i32, gen10: i32, gen11: i32, gen12: i32, gen13: i32, gen14: i32, gen15: i32,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32, alive4: i32, alive5: i32, alive6: i32, alive7: i32,
    alive8: i32, alive9: i32, alive10: i32, alive11: i32, alive12: i32, alive13: i32, alive14: i32, alive15: i32,
    next_entity: i32,
}

fn ecs_hier_world_deep_new() -> EcsHierWorldDeep {
    let w = EcsHierWorldDeep {
        parent0: -1, parent1: -1, parent2: -1, parent3: -1, parent4: -1, parent5: -1, parent6: -1, parent7: -1,
        parent8: -1, parent9: -1, parent10: -1, parent11: -1, parent12: -1, parent13: -1, parent14: -1, parent15: -1,
        head0: -1, head1: -1, head2: -1, head3: -1, head4: -1, head5: -1, head6: -1, head7: -1,
        head8: -1, head9: -1, head10: -1, head11: -1, head12: -1, head13: -1, head14: -1, head15: -1,
        next0: -1, next1: -1, next2: -1, next3: -1, next4: -1, next5: -1, next6: -1, next7: -1,
        next8: -1, next9: -1, next10: -1, next11: -1, next12: -1, next13: -1, next14: -1, next15: -1,
        gen0: 0, gen1: 0, gen2: 0, gen3: 0, gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        gen8: 0, gen9: 0, gen10: 0, gen11: 0, gen12: 0, gen13: 0, gen14: 0, gen15: 0,
        alive0: 0, alive1: 0, alive2: 0, alive3: 0, alive4: 0, alive5: 0, alive6: 0, alive7: 0,
        alive8: 0, alive9: 0, alive10: 0, alive11: 0, alive12: 0, alive13: 0, alive14: 0, alive15: 0,
        next_entity: 0,
    };
    return w;
}

// ── per-entity field accessors (cap-16 cascade-of-return) ──────────────────────
fn _ecs_hier_world_deep_parent_at(w: EcsHierWorldDeep, k: i32) -> i32 {
    if k == 0 { return w.parent0; };
    if k == 1 { return w.parent1; };
    if k == 2 { return w.parent2; };
    if k == 3 { return w.parent3; };
    if k == 4 { return w.parent4; };
    if k == 5 { return w.parent5; };
    if k == 6 { return w.parent6; };
    if k == 7 { return w.parent7; };
    if k == 8 { return w.parent8; };
    if k == 9 { return w.parent9; };
    if k == 10 { return w.parent10; };
    if k == 11 { return w.parent11; };
    if k == 12 { return w.parent12; };
    if k == 13 { return w.parent13; };
    if k == 14 { return w.parent14; };
    return w.parent15;
}

fn _ecs_hier_world_deep_set_parent(w0: EcsHierWorldDeep, k: i32, v: i32) -> EcsHierWorldDeep {
    if k == 0 { w0.parent0 = v; return w0; };
    if k == 1 { w0.parent1 = v; return w0; };
    if k == 2 { w0.parent2 = v; return w0; };
    if k == 3 { w0.parent3 = v; return w0; };
    if k == 4 { w0.parent4 = v; return w0; };
    if k == 5 { w0.parent5 = v; return w0; };
    if k == 6 { w0.parent6 = v; return w0; };
    if k == 7 { w0.parent7 = v; return w0; };
    if k == 8 { w0.parent8 = v; return w0; };
    if k == 9 { w0.parent9 = v; return w0; };
    if k == 10 { w0.parent10 = v; return w0; };
    if k == 11 { w0.parent11 = v; return w0; };
    if k == 12 { w0.parent12 = v; return w0; };
    if k == 13 { w0.parent13 = v; return w0; };
    if k == 14 { w0.parent14 = v; return w0; };
    w0.parent15 = v;
    return w0;
}

fn _ecs_hier_world_deep_head_at(w: EcsHierWorldDeep, k: i32) -> i32 {
    if k == 0 { return w.head0; };
    if k == 1 { return w.head1; };
    if k == 2 { return w.head2; };
    if k == 3 { return w.head3; };
    if k == 4 { return w.head4; };
    if k == 5 { return w.head5; };
    if k == 6 { return w.head6; };
    if k == 7 { return w.head7; };
    if k == 8 { return w.head8; };
    if k == 9 { return w.head9; };
    if k == 10 { return w.head10; };
    if k == 11 { return w.head11; };
    if k == 12 { return w.head12; };
    if k == 13 { return w.head13; };
    if k == 14 { return w.head14; };
    return w.head15;
}

fn _ecs_hier_world_deep_set_head(w0: EcsHierWorldDeep, k: i32, v: i32) -> EcsHierWorldDeep {
    if k == 0 { w0.head0 = v; return w0; };
    if k == 1 { w0.head1 = v; return w0; };
    if k == 2 { w0.head2 = v; return w0; };
    if k == 3 { w0.head3 = v; return w0; };
    if k == 4 { w0.head4 = v; return w0; };
    if k == 5 { w0.head5 = v; return w0; };
    if k == 6 { w0.head6 = v; return w0; };
    if k == 7 { w0.head7 = v; return w0; };
    if k == 8 { w0.head8 = v; return w0; };
    if k == 9 { w0.head9 = v; return w0; };
    if k == 10 { w0.head10 = v; return w0; };
    if k == 11 { w0.head11 = v; return w0; };
    if k == 12 { w0.head12 = v; return w0; };
    if k == 13 { w0.head13 = v; return w0; };
    if k == 14 { w0.head14 = v; return w0; };
    w0.head15 = v;
    return w0;
}

fn _ecs_hier_world_deep_next_at(w: EcsHierWorldDeep, k: i32) -> i32 {
    if k == 0 { return w.next0; };
    if k == 1 { return w.next1; };
    if k == 2 { return w.next2; };
    if k == 3 { return w.next3; };
    if k == 4 { return w.next4; };
    if k == 5 { return w.next5; };
    if k == 6 { return w.next6; };
    if k == 7 { return w.next7; };
