    if k == 0 { w0.next0 = v; return w0; };
    if k == 1 { w0.next1 = v; return w0; };
    if k == 2 { w0.next2 = v; return w0; };
    if k == 3 { w0.next3 = v; return w0; };
    if k == 4 { w0.next4 = v; return w0; };
    if k == 5 { w0.next5 = v; return w0; };
    if k == 6 { w0.next6 = v; return w0; };
    if k == 7 { w0.next7 = v; return w0; };
    if k == 8 { w0.next8 = v; return w0; };
    if k == 9 { w0.next9 = v; return w0; };
    if k == 10 { w0.next10 = v; return w0; };
    if k == 11 { w0.next11 = v; return w0; };
    if k == 12 { w0.next12 = v; return w0; };
    if k == 13 { w0.next13 = v; return w0; };
    if k == 14 { w0.next14 = v; return w0; };
