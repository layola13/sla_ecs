// Deepened Bevy ECS Entity identity + EntityAllocator (fixed cap-16) with FIFO free-queue.
// Stand-in for shallow lib/entity.sla (Vec/array-backed). Operations:
//   entity_new, entity_placeholder, entity_index, entity_generation, entity_eq,
//   entity_to_bits, entity_from_bits, allocator_new, alloc_entity, is_alive,
//   free_entity (generation bump), allocator_id_is_free, allocator_len, allocator_next_id.
// FIFO free-queue semantics: pop oldest freed id first (matches shallow free_ids[next_free_count]).

const ECS_ENTITY_CAP_DEEP: i32 = 16;
const ECS_ENTITY_GEN_MULTIPLIER: i64 = 4294967296;

struct EcsEntityDeep { id: i32, gen: i32 }

fn ecs_entity_new(id: i32, gen: i32) -> EcsEntityDeep { return EcsEntityDeep { id: id, gen: gen }; }

fn ecs_entity_placeholder() -> EcsEntityDeep { return EcsEntityDeep { id: 0, gen: -1 }; }

fn ecs_entity_index(e: EcsEntityDeep) -> i32 { return e.id; }
fn ecs_entity_generation(e: EcsEntityDeep) -> i32 { return e.gen; }

fn ecs_entity_eq(a: EcsEntityDeep, b: EcsEntityDeep) -> bool {
    if a.id != b.id { return false; };
    if a.gen != b.gen { return false; };
    return true;
}

fn ecs_entity_lt(a: EcsEntityDeep, b: EcsEntityDeep) -> bool {
    // Bevy Entity derives Ord as ((id, gen)) lexicographic ordering: id first, then gen.
    if a.id != b.id { return a.id < b.id; };
    return a.gen < b.gen;
}

fn ecs_entity_to_bits(e: EcsEntityDeep) -> i64 {
    let gen_part = e.gen as i64;
    let id_part = e.id as i64;
    return gen_part * ECS_ENTITY_GEN_MULTIPLIER + id_part;
}

fn ecs_entity_from_bits(bits: i64) -> EcsEntityDeep {
    let gen64 = bits / ECS_ENTITY_GEN_MULTIPLIER;
    let id64 = bits - gen64 * ECS_ENTITY_GEN_MULTIPLIER;
    return EcsEntityDeep { id: id64 as i32, gen: gen64 as i32 };
}

struct EcsEntityAllocatorDeep {
    g0: i32, g1: i32, g2: i32, g3: i32, g4: i32, g5: i32, g6: i32, g7: i32,
    g8: i32, g9: i32, g10: i32, g11: i32, g12: i32, g13: i32, g14: i32, g15: i32,
    // FIFO free-queue: oldest freed id is at index 0, newest at free_count-1.
    f0: i32, f1: i32, f2: i32, f3: i32, f4: i32, f5: i32, f6: i32, f7: i32,
    f8: i32, f9: i32, f10: i32, f11: i32, f12: i32, f13: i32, f14: i32, f15: i32,
    free_count: i32,
    next_id: i32,
}

fn ecs_alloc_new() -> EcsEntityAllocatorDeep {
    let a = EcsEntityAllocatorDeep {
        g0: 0, g1: 0, g2: 0, g3: 0, g4: 0, g5: 0, g6: 0, g7: 0,
        g8: 0, g9: 0, g10: 0, g11: 0, g12: 0, g13: 0, g14: 0, g15: 0,
        f0: 0, f1: 0, f2: 0, f3: 0, f4: 0, f5: 0, f6: 0, f7: 0,
        f8: 0, f9: 0, f10: 0, f11: 0, f12: 0, f13: 0, f14: 0, f15: 0,
        free_count: 0,
        next_id: 1,
    };
    return a;
}

fn ecs_alloc_next_id(a: EcsEntityAllocatorDeep) -> i32 { return a.next_id; }
fn ecs_alloc_free_count(a: EcsEntityAllocatorDeep) -> i32 { return a.free_count; }
fn ecs_alloc_len(a: EcsEntityAllocatorDeep) -> i32 {
    let alloced = a.next_id - 1;
    return alloced - a.free_count;
}

fn ecs_alloc_gen_at(a: EcsEntityAllocatorDeep, id: i32) -> i32 {
    if id == 0 { return a.g0; };
    if id == 1 { return a.g1; };
    if id == 2 { return a.g2; };
    if id == 3 { return a.g3; };
    if id == 4 { return a.g4; };
    if id == 5 { return a.g5; };
    if id == 6 { return a.g6; };
    if id == 7 { return a.g7; };
    if id == 8 { return a.g8; };
    if id == 9 { return a.g9; };
    if id == 10 { return a.g10; };
    if id == 11 { return a.g11; };
    if id == 12 { return a.g12; };
    if id == 13 { return a.g13; };
    if id == 14 { return a.g14; };
    if id == 15 { return a.g15; };
    return 0;
}

fn ecs_alloc_set_gen(a: EcsEntityAllocatorDeep, id: i32, g: i32) -> EcsEntityAllocatorDeep {
    if id == 0 { a.g0 = g; };
    if id == 1 { a.g1 = g; };
    if id == 2 { a.g2 = g; };
    if id == 3 { a.g3 = g; };
    if id == 4 { a.g4 = g; };
    if id == 5 { a.g5 = g; };
    if id == 6 { a.g6 = g; };
    if id == 7 { a.g7 = g; };
    if id == 8 { a.g8 = g; };
    if id == 9 { a.g9 = g; };
    if id == 10 { a.g10 = g; };
    if id == 11 { a.g11 = g; };
    if id == 12 { a.g12 = g; };
    if id == 13 { a.g13 = g; };
    if id == 14 { a.g14 = g; };
    if id == 15 { a.g15 = g; };
    return a;
}

fn ecs_alloc_free_at(a: EcsEntityAllocatorDeep, idx: i32) -> i32 {
    if idx == 0 { return a.f0; };
    if idx == 1 { return a.f1; };
    if idx == 2 { return a.f2; };
    if idx == 3 { return a.f3; };
    if idx == 4 { return a.f4; };
    if idx == 5 { return a.f5; };
    if idx == 6 { return a.f6; };
    if idx == 7 { return a.f7; };
    if idx == 8 { return a.f8; };
    if idx == 9 { return a.f9; };
    if idx == 10 { return a.f10; };
    if idx == 11 { return a.f11; };
    if idx == 12 { return a.f12; };
    if idx == 13 { return a.f13; };
    if idx == 14 { return a.f14; };
    if idx == 15 { return a.f15; };
    return 0;
}

// FIFO free-queue append (push newest to back).
fn ecs_alloc_push_free(a: EcsEntityAllocatorDeep, id: i32) -> EcsEntityAllocatorDeep {
    let slot = a.free_count;
    if slot == 0 { a.f0 = id; };
    if slot == 1 { a.f1 = id; };
    if slot == 2 { a.f2 = id; };
    if slot == 3 { a.f3 = id; };
    if slot == 4 { a.f4 = id; };
    if slot == 5 { a.f5 = id; };
    if slot == 6 { a.f6 = id; };
    if slot == 7 { a.f7 = id; };
    if slot == 8 { a.f8 = id; };
    if slot == 9 { a.f9 = id; };
    if slot == 10 { a.f10 = id; };
    if slot == 11 { a.f11 = id; };
    if slot == 12 { a.f12 = id; };
    if slot == 13 { a.f13 = id; };
    if slot == 14 { a.f14 = id; };
    if slot == 15 { a.f15 = id; };
    a.free_count = a.free_count + 1;
    return a;
}

// Shift free-queue f[1..free_count] -> f[0..free_count-1]; do not modify free_count here.
fn ecs_alloc_shift_free(a: EcsEntityAllocatorDeep, new_count: i32) -> EcsEntityAllocatorDeep {
    let i: i32 = 0;
    while i < new_count {
        let shifted = ecs_alloc_free_at(a, i + 1);
        if i == 0 { a.f0 = shifted; };
        if i == 1 { a.f1 = shifted; };
        if i == 2 { a.f2 = shifted; };
        if i == 3 { a.f3 = shifted; };
        if i == 4 { a.f4 = shifted; };
        if i == 5 { a.f5 = shifted; };
        if i == 6 { a.f6 = shifted; };
        if i == 7 { a.f7 = shifted; };
        if i == 8 { a.f8 = shifted; };
        if i == 9 { a.f9 = shifted; };
        if i == 10 { a.f10 = shifted; };
        if i == 11 { a.f11 = shifted; };
        if i == 12 { a.f12 = shifted; };
        if i == 13 { a.f13 = shifted; };
        if i == 14 { a.f14 = shifted; };
        i = i + 1;
    }
    return a;
}

// Zero out slot idx in the free-queue.
fn ecs_alloc_clear_free_at(a: EcsEntityAllocatorDeep, idx: i32) -> EcsEntityAllocatorDeep {
    if idx == 0 { a.f0 = 0; };
    if idx == 1 { a.f1 = 0; };
    if idx == 2 { a.f2 = 0; };
    if idx == 3 { a.f3 = 0; };
    if idx == 4 { a.f4 = 0; };
    if idx == 5 { a.f5 = 0; };
    if idx == 6 { a.f6 = 0; };
    if idx == 7 { a.f7 = 0; };
    if idx == 8 { a.f8 = 0; };
    if idx == 9 { a.f9 = 0; };
    if idx == 10 { a.f10 = 0; };
    if idx == 11 { a.f11 = 0; };
    if idx == 12 { a.f12 = 0; };
    if idx == 13 { a.f13 = 0; };
    if idx == 14 { a.f14 = 0; };
    if idx == 15 { a.f15 = 0; };
    return a;
}

// FIFO pop (oldest freed id first). Pops index 0; shifts the rest forward by one.
fn ecs_alloc_pop_free(a: EcsEntityAllocatorDeep) -> EcsEntityAllocatorDeep {
    if a.free_count == 0 { return a; };
    let new_count = a.free_count - 1;
    a = ecs_alloc_shift_free(a, new_count);
    a = ecs_alloc_clear_free_at(a, new_count);
    a.free_count = new_count;
    return a;
}

struct EcsAllocResultDeep { alloc: EcsEntityAllocatorDeep, entity: EcsEntityDeep }
fn ecs_alloc_result_new(a: EcsEntityAllocatorDeep, e: EcsEntityDeep) -> EcsAllocResultDeep {
    return EcsAllocResultDeep { alloc: a, entity: e };
}
fn ecs_alloc_result_alloc(r: EcsAllocResultDeep) -> EcsEntityAllocatorDeep { return r.alloc; }
fn ecs_alloc_result_entity(r: EcsAllocResultDeep) -> EcsEntityDeep { return r.entity; }

fn ecs_alloc_entity(a: EcsEntityAllocatorDeep) -> EcsAllocResultDeep {
    if a.free_count > 0 {
        let id = ecs_alloc_free_at(a, 0);
        let g = ecs_alloc_gen_at(a, id);
        let a1 = ecs_alloc_pop_free(a);
        return ecs_alloc_result_new(a1, ecs_entity_new(id, g));
    };
    let id = a.next_id;
    if id >= ECS_ENTITY_CAP_DEEP { panic(136000); };
    a.next_id = id + 1;
    return ecs_alloc_result_new(a, ecs_entity_new(id, ecs_alloc_gen_at(a, id)));
}

fn ecs_alloc_id_is_free(a: EcsEntityAllocatorDeep, id: i32) -> bool {
    let i: i32 = 0;
    while i < a.free_count {
        if ecs_alloc_free_at(a, i) == id { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_is_alive(a: EcsEntityAllocatorDeep, e: EcsEntityDeep) -> bool {
    if e.id <= 0 { return false; };
    if e.id >= ECS_ENTITY_CAP_DEEP { return false; };
    if e.id >= a.next_id { return false; };
    if ecs_alloc_id_is_free(a, e.id) { return false; };
    return ecs_alloc_gen_at(a, e.id) == e.gen;
}

fn ecs_free_entity(a: EcsEntityAllocatorDeep, e: EcsEntityDeep) -> EcsEntityAllocatorDeep {
    if ecs_is_alive(a, e) != true { return a; };
    let g = ecs_alloc_gen_at(a, e.id);
    let a1 = ecs_alloc_set_gen(a, e.id, g + 1);
    let a2 = ecs_alloc_push_free(a1, e.id);
    return a2;
}
