// ── Column val/added/changed accessors. Each column has 8 per-row val + 8 per-row added + 8 per
//    row changed fields. `slot_at(col, row)` → (col, row): we use explicit per-row field indexing
//    for each column via two-level cascade-of-return helpers.

fn _ecs_av_col_val_at(w: EcsAvWorldDeep, col: i32, row: i32) -> i32 {
    if col == 0 {
        if row == 0 { return w.col0_val0; };
        if row == 1 { return w.col0_val1; };
        if row == 2 { return w.col0_val2; };
        if row == 3 { return w.col0_val3; };
        if row == 4 { return w.col0_val4; };
        if row == 5 { return w.col0_val5; };
        if row == 6 { return w.col0_val6; };
        return w.col0_val7;
    };
    if col == 1 {
        if row == 0 { return w.col1_val0; };
        if row == 1 { return w.col1_val1; };
        if row == 2 { return w.col1_val2; };
        if row == 3 { return w.col1_val3; };
        if row == 4 { return w.col1_val4; };
        if row == 5 { return w.col1_val5; };
        if row == 6 { return w.col1_val6; };
        return w.col1_val7;
    };
    if col == 2 {
        if row == 0 { return w.col2_val0; };
        if row == 1 { return w.col2_val1; };
        if row == 2 { return w.col2_val2; };
        if row == 3 { return w.col2_val3; };
        if row == 4 { return w.col2_val4; };
        if row == 5 { return w.col2_val5; };
        if row == 6 { return w.col2_val6; };
        return w.col2_val7;
    };
    if row == 0 { return w.col3_val0; };
    if row == 1 { return w.col3_val1; };
    if row == 2 { return w.col3_val2; };
    if row == 3 { return w.col3_val3; };
    if row == 4 { return w.col3_val4; };
    if row == 5 { return w.col3_val5; };
    if row == 6 { return w.col3_val6; };
    return w.col3_val7;
}

fn _ecs_av_col_set_val(w0: EcsAvWorldDeep, col: i32, row: i32, value: i32) -> EcsAvWorldDeep {
    if col == 0 {
        if row == 0 { w0.col0_val0 = value; return w0; };
        if row == 1 { w0.col0_val1 = value; return w0; };
