        w0.col2_val7 = value; return w0;
    };
    if row == 0 { w0.col3_val0 = value; return w0; };
    if row == 1 { w0.col3_val1 = value; return w0; };
    if row == 2 { w0.col3_val2 = value; return w0; };
    if row == 3 { w0.col3_val3 = value; return w0; };
    if row == 4 { w0.col3_val4 = value; return w0; };
