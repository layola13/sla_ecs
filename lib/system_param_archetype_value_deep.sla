fn _ecs_av_pres_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cmd_pres0; };
    if idx == 1 { return w.cmd_pres1; };
    if idx == 2 { return w.cmd_pres2; };
    if idx == 3 { return w.cmd_pres3; };
    if idx == 4 { return w.cmd_pres4; };
    if idx == 5 { return w.cmd_pres5; };
