fn _ecs_av_pcomp_set(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.cmd_pcomp0 = value; return w0; };
    if idx == 1 { w0.cmd_pcomp1 = value; return w0; };
    if idx == 2 { w0.cmd_pcomp2 = value; return w0; };
    if idx == 3 { w0.cmd_pcomp3 = value; return w0; };
