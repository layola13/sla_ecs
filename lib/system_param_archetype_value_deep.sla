}

fn _ecs_av_pmsg_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cmd_pmsg0; };
    if idx == 1 { return w.cmd_pmsg1; };
    if idx == 2 { return w.cmd_pmsg2; };
    if idx == 3 { return w.cmd_pmsg3; };
    if idx == 4 { return w.cmd_pmsg4; };
