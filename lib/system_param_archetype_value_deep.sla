// ── Command queue methods. We thread the world+commands together (the shallow models
//    ArchetypeValueCommandsParam as a (world, commands) pair). reserve_entity spawns eagerly and
//    returns the entity-id; subsequent queue-ops append to the side-value arrays and update
//    cmd_kind / cmd_eid / cmd_cid at the next cmd_count slot. apply walks sequentially.

struct EcsAvCmdDeepSp { world: EcsAvWorldDeep, count: i32 }

fn ecs_av_commands_reserve_entity(c0: EcsAvCommandsDeep) -> EcsAvCmdDeepSp {
    let sp = ecs_av_world_deep_spawn(c0.world);
    let w1 = ecs_av_spawn_world_deep(sp);
    let e = ecs_av_spawn_entity_deep(sp);
    // world is mutated in place by spawn; bubble entity id forward through the wrapper
    let sp2 = EcsAvCmdDeepSp { world: w1, count: e.id };
    return sp2;
}

// `_ecs_av_queue_side` appends a new command (kind + eid + cid + side-value) and returns the
// world with updated cmd_count + side-count.
fn _ecs_av_queue_pcomp(w0: EcsAvWorldDeep, kind: i32, eid: i32, cid: i32, value: i32) -> EcsAvWorldDeep {
    if w0.cmd_count >= ECS_AV_CAP_ENTITIES - 1 { return w0; };
    if w0.pcomp_count >= ECS_AV_CAP_ENTITIES - 1 { return w0; };
    let cmd_idx = w0.cmd_count;
    let pcomp_idx = w0.pcomp_count;
    let w1 = _ecs_av_cmd_set_kind(w0, cmd_idx, kind);
    let w2 = _ecs_av_cmd_set_eid(w1, cmd_idx, eid);
    let w3 = _ecs_av_cmd_set_cid(w2, cmd_idx, cid);
    let w4 = _ecs_av_pcomp_set(w3, pcomp_idx, value);
    // Store pcomp idx into freeform slot:
    let w5 = _ecs_av_cmd_set_cid(w4, cmd_idx, cid);
    w5.cmd_count = w5.cmd_count + 1;
    w5.pcomp_count = w5.pcomp_count + 1;
    return w5;
}

fn _ecs_av_queue_pres(w0: EcsAvWorldDeep, value: i32) -> EcsAvWorldDeep {
    if w0.cmd_count >= ECS_AV_CAP_ENTITIES - 1 { return w0; };
    if w0.pres_count >= ECS_AV_CAP_ENTITIES - 1 { return w0; };
    let cmd_idx = w0.cmd_count;
    let pres_idx = w0.pres_count;
    let w1 = _ecs_av_cmd_set_kind(w0, cmd_idx, ECS_AV_CMD_INSERT_RESOURCE);
    let w2 = _ecs_av_cmd_set_eid(w1, cmd_idx, pres_idx);
    let w3 = _ecs_av_pres_set(w2, pres_idx, value);
    w3.cmd_count = w3.cmd_count + 1;
    w3.pres_count = w3.pres_count + 1;
    return w3;
}

fn _ecs_av_queue_pmsg(w0: EcsAvWorldDeep, value: i32) -> EcsAvWorldDeep {
    if w0.cmd_count >= ECS_AV_CAP_ENTITIES - 1 { return w0; };
    if w0.pmsg_count >= ECS_AV_CAP_ENTITIES - 1 { return w0; };
    let cmd_idx = w0.cmd_count;
    let pmsg_idx = w0.pmsg_count;
    let w1 = _ecs_av_cmd_set_kind(w0, cmd_idx, ECS_AV_CMD_WRITE_MESSAGE);
    let w2 = _ecs_av_cmd_set_eid(w1, cmd_idx, pmsg_idx);
    let w3 = _ecs_av_pmsg_set(w2, pmsg_idx, value);
    w3.cmd_count = w3.cmd_count + 1;
    w3.pmsg_count = w3.pmsg_count + 1;
    return w3;
}

fn ecs_av_commands_insert(c0: EcsAvCommandsDeep, eid: i32, comp_id: i32, value: EcsAvData) -> EcsAvCommandsDeep {
    let w1 = _ecs_av_queue_pcomp(c0.world, ECS_AV_CMD_INSERT_COMPONENT, eid, comp_id, value.amount);
    return EcsAvCommandsDeep { count: c0.count + 1, world: w1 };
}

fn ecs_av_commands_insert_resource(c0: EcsAvCommandsDeep, value: EcsAvTime) -> EcsAvCommandsDeep {
    let w1 = _ecs_av_queue_pres(c0.world, value.tick);
    return EcsAvCommandsDeep { count: c0.count + 1, world: w1 };
}

fn ecs_av_commands_write_message(c0: EcsAvCommandsDeep, value: EcsAvEvent) -> EcsAvCommandsDeep {
    let w1 = _ecs_av_queue_pmsg(c0.world, value.amount);
    return EcsAvCommandsDeep { count: c0.count + 1, world: w1 };
}

// Apply: walk cmd queue in order; for each item, dispatch by kind and apply to the world via the
// public world surface.
fn _ecs_av_commands_apply_walk(w0: EcsAvWorldDeep, idx: i32) -> EcsAvWorldDeep {
    if idx >= w0.cmd_count { return w0; };
    if idx >= ECS_AV_CAP_ENTITIES { return w0; };
    let kind = _ecs_av_cmd_kind_at(w0, idx);
    if kind == ECS_AV_CMD_INSERT_COMPONENT {
        let eid = _ecs_av_cmd_eid_at(w0, idx);
        let cid = _ecs_av_cmd_cid_at(w0, idx);
        let pcomp_idx = _ecs_av_cmd_eid_at(w0, idx);
        // For INSERT_COMPONENT we stored pcomp at index = pcomp_idx via _cmd_eid; pull from pcomp[pcomp_idx]
        let _discard = 0;
        let value = _ecs_av_pcomp_at(w0, pcomp_idx);
        let w1 = ecs_av_world_deep_insert(w0, ecs_av_entity_new(eid, 0), cid, ecs_av_data_new(value));
        // The above pushes the INSERT_COMPONENT's value via the public insert surface.
        return _ecs_av_commands_apply_walk(w1, idx + 1);
    };
    if kind == ECS_AV_CMD_INSERT_RESOURCE {
        let pres_idx = _ecs_av_cmd_eid_at(w0, idx);
        let value = _ecs_av_pres_at(w0, pres_idx);
        let w1 = ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(value));
        return _ecs_av_commands_apply_walk(w1, idx + 1);
    };
    if kind == ECS_AV_CMD_WRITE_MESSAGE {
        let pmsg_idx = _ecs_av_cmd_eid_at(w0, idx);
        let value = _ecs_av_pmsg_at(w0, pmsg_idx);
        let w1 = ecs_av_world_deep_write_message(w0, ecs_av_event_new(value));
        return _ecs_av_commands_apply_walk(w1, idx + 1);
    };
    return _ecs_av_commands_apply_walk(w0, idx + 1);
}

fn ecs_av_commands_apply(w0: EcsAvWorldDeep) -> EcsAvWorldDeep {
    let w1 = _ecs_av_commands_apply_walk(w0, 0);
    // Clear the queue post-apply (so subsequent applies are no-ops; matches shallow's cleared).
    w1.cmd_count = 0;
    w1.pcomp_count = 0;
    w1.pres_count = 0;
    w1.pmsg_count = 0;
    return w1;
}

// ── System-parameter adapter buses. The shallow hands a fn-pointer callback to each *_system bus;
//    SA cannot pass fns as values, so each bus here hard-codes the corresponding shallow system
//    call body (mirrors the 7 system_* callbacks: movement, time_message, res_mut,
//    reader_resmut, commands, writer, count_query). Plus the schedule wrapper that runs the
//    movement-pair + time-message adapters in sequence.


// ── query_mut: single-component mut query. Returns the same cap-8 EcsAvQueryDeep shape as the
//    read query, but items carry the (col, row) slot encoded as the entity's archetype row pointer.
//    write(world, comp_id, entity, value) re-inserts the value via the public insert surface
//    -- alike the pair_write_first writeback path (re-write of an existing value bumps changed).
fn ecs_av_world_deep_query_mut(w: EcsAvWorldDeep, comp_id: i32) -> EcsAvQueryDeep {
    return ecs_av_world_deep_query(w, comp_id);
}

fn ecs_av_world_deep_write(w0: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32, value: EcsAvData) -> EcsAvWorldDeep {
    return ecs_av_world_deep_insert(w0, e, comp_id, value);
}

// bus 1: archetype_value_run_pair_mut_system + archetype_param_movement_system.
//    For each pair-query row, the movement body writes first.value = first.value + second.value,
//    then the bus writes first.value back via pair_write_first.
fn _ecs_av_apply_pair_mut_walk(w0: EcsAvWorldDeep, q: EcsAvPairQueryMutDeep, idx: i32) -> EcsAvWorldDeep {
    if idx >= q.count { return w0; };
    let p = ecs_av_pair_query_mut_at(q, idx);
    let next_val = ecs_av_data_new(p.first.amount + p.second.amount);
    let w1 = ecs_av_world_deep_pair_write_first(w0, p, next_val);
    return _ecs_av_apply_pair_mut_walk(w1, q, idx + 1);
}

fn ecs_av_run_pair_mut_system(w0: EcsAvWorldDeep, first_comp_id: i32, second_comp_id: i32) -> EcsAvWorldDeep {
    let q = ecs_av_world_deep_query_pair_mut_first(w0, first_comp_id, second_comp_id);
    return _ecs_av_apply_pair_mut_walk(w0, q, 0);
}

// bus 2: archetype_value_run_resource_message_system + archetype_param_time_message_system.
//    The body writes resource.tick = resource.tick + 1 and event.amount = resource.tick + 4
//    (BEFORE the +1 bump -- the shallow computes `param.resource.tick + 4` from the OLD tick;
//    actually re-reading the shallow body: `ArchetypeParamTime { tick: param.resource.tick + 1 }`
//    and `ArchetypeParamEvent { amount: param.resource.tick + 4 }`. The resource attribute is the
//    ORIGINAL resource.tick (before bump) for the event amount, while the resource is bumped by 1.
//    Then after the body runs, the bus inserts the resource, and if should_write_message, writes
//    the message. See lib/system_param_archetype_value.sla:165.)
fn ecs_av_run_resource_message_system(w0: EcsAvWorldDeep, default_message: EcsAvEvent) -> EcsAvWorldDeep {
    let old_tick = w0.res_time_tick;
    let new_tick = old_tick + 1;
    let new_event_amount = old_tick + 4;
    let w1 = ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(new_tick));
    return ecs_av_world_deep_write_message(w1, ecs_av_event_new(new_event_amount));
}

// bus 3: archetype_value_run_res_mut_system + archetype_param_res_mut_system.
//    The body writes resource.value.tick = resource.value.tick + 2; the bus then writes back via
//    res_mut_write. (`res.value.tick` increments by 2.)
fn ecs_av_run_res_mut_system(w0: EcsAvWorldDeep) -> EcsAvWorldDeep {
    let old_tick = w0.res_time_tick;
    let new_tick = old_tick + 2;
    return ecs_av_world_deep_res_mut_write(w0, ecs_av_time_new(new_tick));
}

// bus 4: archetype_value_run_message_reader_res_mut_system + archetype_param_reader_resmut_system.
//    The body: if read.has_value, res.value.tick = res.value.tick + read.value.amount; the bus
//    writes resource back to world and returns the updated world + the new reader.
struct EcsAvRunReaderDeep { world: EcsAvWorldDeep, reader: EcsAvReaderDeep }
fn ecs_av_run_reader_world(r: EcsAvRunReaderDeep) -> EcsAvWorldDeep { return r.world; }
fn ecs_av_run_reader_reader(r: EcsAvRunReaderDeep) -> EcsAvReaderDeep { return r.reader; }

fn ecs_av_run_message_reader_res_mut_system(w0: EcsAvWorldDeep, reader: EcsAvReaderDeep, default_message: EcsAvEvent) -> EcsAvRunReaderDeep {
    let read = ecs_av_world_deep_read_message(w0, reader, default_message);
    let r1 = ecs_av_read_reader(read);
    if ecs_av_read_has_value(read) == true {
        let old_tick = w0.res_time_tick;
        let event_amount = ecs_av_event_amount(ecs_av_read_value(read));
        let new_tick = old_tick + event_amount;
        let w1 = ecs_av_world_deep_res_mut_write(w0, ecs_av_time_new(new_tick));
        return EcsAvRunReaderDeep { world: w1, reader: r1 };
    };
    return EcsAvRunReaderDeep { world: w0, reader: r1 };
}


// ── Reserve-helper used by Test 5. Spawn eagerly and bubble the new (world, eid) pair so the bus
//    can drive the queued insert at the right entity-id. Mirrors the shallow's
//    `archetype_value_commands_param_reserve_entity` flow's spawn-half.
struct EcsAvReserveWrapperDeep { world: EcsAvWorldDeep, eid: i32 }
fn ecs_av_actor_reserve_for_commands(w0: EcsAvWorldDeep) -> EcsAvReserveWrapperDeep {
    let sp = ecs_av_world_deep_spawn(w0);
    let w1 = ecs_av_spawn_world_deep(sp);
    let e = ecs_av_spawn_entity_deep(sp);
    return EcsAvReserveWrapperDeep { world: w1, eid: e.id };
}
fn ecs_av_actor_reserve_world(r: EcsAvReserveWrapperDeep) -> EcsAvWorldDeep { return r.world; }
fn ecs_av_actor_reserve_eid(r: EcsAvReserveWrapperDeep) -> i32 { return r.eid; }

// bus 5: archetype_value_run_commands_system + archetype_param_commands_system.
//    The body increments the commands param: reserve_entity (spawns e eid), insert value amount=12,
//    insert_resource tick=7, write_message amount=4. The bus then applies the queue to the world.
//    All recipe inputs are hard-coded (no world/callback args) because the system body is fixed.
fn ecs_av_run_commands_system(w0: EcsAvWorldDeep, health_comp_id: i32, entity_eid: i32) -> EcsAvWorldDeep {
    // The shallow's archetype_param_commands_system captures entity_id from reserve_entity's
    // return. We bubble it up as an explicit arg: tests pass `health_comp_id` and the eid of the
    // just-reserved entity. The bus owns the apply loop.
    let c0 = ecs_av_commands_new(w0);
    let c1 = ecs_av_commands_insert(c0, entity_eid, health_comp_id, ecs_av_data_new(12));
    let c2 = ecs_av_commands_insert_resource(c1, ecs_av_time_new(7));
    let c3 = ecs_av_commands_write_message(c2, ecs_av_event_new(4));
    return ecs_av_commands_apply(c3.world);
}

// bus 6: archetype_value_run_message_writer_system + archetype_param_writer_system.
//    The body sends amount=2 then amount=8 to a writer queue; apply writes them to the world's
//    message slot in order.
fn ecs_av_run_message_writer_system(w0: EcsAvWorldDeep) -> EcsAvWorldDeep {
    let w1 = ecs_av_world_deep_write_message(w0, ecs_av_event_new(2));
    return ecs_av_world_deep_write_message(w1, ecs_av_event_new(8));
}

// bus 7-10: archetype_value_run_with_query_resource_system + archetype_param_count_query_system.
//    The body sets resource.tick = len(query.items); the bus writes the resource back. We compute
//    the count and write directly.
fn ecs_av_run_with_query_resource_system(w0: EcsAvWorldDeep, comp_id: i32, with_comp_id: i32) -> EcsAvWorldDeep {
    let q = ecs_av_world_deep_query_with(w0, comp_id, with_comp_id);
    let cnt = ecs_av_query_deep_count(q);
    return ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(cnt));
}

fn ecs_av_run_without_query_resource_system(w0: EcsAvWorldDeep, comp_id: i32, without_comp_id: i32) -> EcsAvWorldDeep {
    let q = ecs_av_world_deep_query_without(w0, comp_id, without_comp_id);
    let cnt = ecs_av_query_deep_count(q);
    return ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(cnt));
}

fn ecs_av_run_added_query_resource_system(w0: EcsAvWorldDeep, comp_id: i32, since_tick: i32) -> EcsAvWorldDeep {
    let q = ecs_av_world_deep_query_added(w0, comp_id, since_tick);
    let cnt = ecs_av_query_deep_count(q);
    return ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(cnt));
}

fn ecs_av_run_changed_query_resource_system(w0: EcsAvWorldDeep, comp_id: i32, since_tick: i32) -> EcsAvWorldDeep {
    let q = ecs_av_world_deep_query_changed(w0, comp_id, since_tick);
    let cnt = ecs_av_query_deep_count(q);
    return ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(cnt));
}

// bus 11 (schedule wrapper): archetype_value_schedule_run applied to two systems in order --
//    movement-pair then time-message. The shallow test 8 builds a schedule over
//    archetype_param_pair_adapter_system and archetype_param_resource_adapter_system and runs
//    them sequentially; we collapse that into a direct sequential run here (the deep's
//    schedule_archetype_value module remains a NO-OP-deep per its own batch; this batch's adapter
//    just runs both bodies explicitly). The first arg `pair_first_comp_id` and `pair_second_comp_id`
//    pick the pair components (the test uses pos.id and vel.id which the schedule record stored).
fn ecs_av_schedule_run_movement_resource(w0: EcsAvWorldDeep, pair_first_comp_id: i32, pair_second_comp_id: i32) -> EcsAvWorldDeep {
    let w1 = ecs_av_run_pair_mut_system(w0, pair_first_comp_id, pair_second_comp_id);
    return ecs_av_run_resource_message_system(w1, ecs_av_event_default());
}
