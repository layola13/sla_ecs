// Self-contained deep for shallow lib/system_param_archetype_value.sla (Batch 387).
//
// Mirrors shallow `ArchetypeValueWorld<T,R,M>` + the system-parameter "run_*_system" adapter set
// that injects query/resource/message/command parameters into system callbacks. The shallow passes
// `run: fn(...) -> ...` callbacks to each bus (e.g. `archetype_value_run_pair_mut_system`); SA cannot
// pass functions as values, so this deep inlines each system_* body directly inside a dedicated
// run_***_psa helper (no fn-ptr passing). One file holds the whole world + command queue +
// adapters -- self-contained (no `@import`), matching the Batch 386 pattern.
//
// Storage (mirrors shallow `archetype_value` shape):
//   - cap-8 entity slots: alive[], gen[], loc_arch[], loc_row[]
//   - cap-4 component columns (per-component: a flat row-addressable value + added/changed ticks)
//   - cap-8 archetype slots (each with a {component-id set, alive-entity rows})
//   - one resource slot (EcsAvTime) + cap-16 message slot (EcsAvEvent)
//   - one command queue (cap-8 kind-discriminated deferred ops with cap-8 side-value arrays)
//
// Concrete typed plugs: EcsAvData{amount} (the component value), EcsAvTime{tick} (the resource
// value), EcsAvEvent{amount} (the message value). Wrapper structs follow the Batch 373 rule:
// EcsAvRegisterDeep{world, info}, EcsAvSpawnDeep{world, entity}, EcsAvCompInfoDeep{id},
// EcsAvEntityDeep{id, generation}. ALL accessor helpers use scalar returns (no tuple destructuring
// in tests).

const ECS_AV_CAP_ENTITIES: i32 = 8;
const ECS_AV_CAP_COMPONENTS: i32 = 4;
const ECS_AV_CAP_ARCH: i32 = 8;
const ECS_AV_CAP_ROWS: i32 = 8;
const ECS_AV_CAP_MSGS: i32 = 16;
const ECS_AV_TICK_NONE: i32 = 999999;
const ECS_AV_CMD_INSERT_COMPONENT: i32 = 1;
const ECS_AV_CMD_DESPAWN: i32 = 2;
const ECS_AV_CMD_INSERT_RESOURCE: i32 = 3;
const ECS_AV_CMD_WRITE_MESSAGE: i32 = 4;

// ── Concrete typed plugs (mirror shallow ArchetypeParamData / Time / Event). ────────────────
struct EcsAvData { amount: i32 }
struct EcsAvTime { tick: i32 }
struct EcsAvEvent { amount: i32 }

fn ecs_av_data_new(amount: i32) -> EcsAvData { return EcsAvData { amount: amount }; }
fn ecs_av_time_new(tick: i32) -> EcsAvTime { return EcsAvTime { tick: tick }; }
fn ecs_av_event_new(amount: i32) -> EcsAvEvent { return EcsAvEvent { amount: amount }; }
fn ecs_av_data_amount(v: EcsAvData) -> i32 { return v.amount; }
fn ecs_av_time_tick(r: EcsAvTime) -> i32 { return r.tick; }
fn ecs_av_event_amount(m: EcsAvEvent) -> i32 { return m.amount; }

fn ecs_av_time_default() -> EcsAvTime { return ecs_av_time_new(0); }
fn ecs_av_event_default() -> EcsAvEvent { return ecs_av_event_new(0); }

// ── Entity / component info / register wrapper structs. ────────────────────────────────────
struct EcsAvEntityDeep { id: i32, generation: i32 }
fn ecs_av_entity_new(id: i32, generation: i32) -> EcsAvEntityDeep {
    return EcsAvEntityDeep { id: id, generation: generation };
}
fn ecs_av_entity_id_deep(e: EcsAvEntityDeep) -> i32 { return e.id; }
fn ecs_av_entity_gen_deep(e: EcsAvEntityDeep) -> i32 { return e.generation; }

struct EcsAvCompInfoDeep { id: i32 }
fn ecs_av_comp_info_id_deep(r: EcsAvCompInfoDeep) -> i32 { return r.id; }
fn ecs_av_comp_info_new(id: i32) -> EcsAvCompInfoDeep { return EcsAvCompInfoDeep { id: id }; }

struct EcsAvRegisterDeep { world: EcsAvWorldDeep, info: EcsAvCompInfoDeep }
fn ecs_av_register_world_deep(r: EcsAvRegisterDeep) -> EcsAvWorldDeep { return r.world; }
fn ecs_av_register_info_deep(r: EcsAvRegisterDeep) -> EcsAvCompInfoDeep { return r.info; }

struct EcsAvSpawnDeep { world: EcsAvWorldDeep, entity: EcsAvEntityDeep }
fn ecs_av_spawn_world_deep(r: EcsAvSpawnDeep) -> EcsAvWorldDeep { return r.world; }
fn ecs_av_spawn_entity_deep(r: EcsAvSpawnDeep) -> EcsAvEntityDeep { return r.entity; }

// ── Archetype storage. Each arch has up to ECS_AV_CAP_COMPONENTS columns x ECS_AV_CAP_ROWS rows.
//    Per column: the component_id (>=1 once assigned), a per-row present bitmask (only meaningful
//    for sparse set; for the table-style archetype used by this exercise a present-row entry implies
//    the row index is occupied), flat val/added/changed triplets at (col * CAP_ROWS + row).
//    cap-8 "used entity rows" (via row_count).
struct EcsAvArchDeep {
    id: i32,
    used: i32,
    row_count: i32,
    comp_count: i32,
    comp_id0: i32, comp_id1: i32, comp_id2: i32, comp_id3: i32,
    // per-row entity id occupying that row.
    row_eid0: i32, row_eid1: i32, row_eid2: i32, row_eid3: i32,
    row_eid4: i32, row_eid5: i32, row_eid6: i32, row_eid7: i32,
}

fn _ecs_av_arch_empty(id: i32) -> EcsAvArchDeep {
    return EcsAvArchDeep {
        id: id, used: 0, row_count: 0, comp_count: 0,
        comp_id0: 0, comp_id1: 0, comp_id2: 0, comp_id3: 0,
        row_eid0: -1, row_eid1: -1, row_eid2: -1, row_eid3: -1,
        row_eid4: -1, row_eid5: -1, row_eid6: -1, row_eid7: -1
    };
}

fn _ecs_av_arch_comp_id_at_at(a: EcsAvArchDeep, col: i32) -> i32 {
    if col == 0 { return a.comp_id0; };
    if col == 1 { return a.comp_id1; };
    if col == 2 { return a.comp_id2; };
    return a.comp_id3;
}

fn _ecs_av_arch_set_comp_id_get(a0: EcsAvArchDeep, col: i32, value: i32) -> EcsAvArchDeep {
    if col == 0 { a0.comp_id0 = value; return a0; };
    if col == 1 { a0.comp_id1 = value; return a0; };
    if col == 2 { a0.comp_id2 = value; return a0; };
    a0.comp_id3 = value;
    return a0;
}

fn _ecs_av_arch_eid_at(a: EcsAvArchDeep, row: i32) -> i32 {
    if row == 0 { return a.row_eid0; };
    if row == 1 { return a.row_eid1; };
    if row == 2 { return a.row_eid2; };
    if row == 3 { return a.row_eid3; };
    if row == 4 { return a.row_eid4; };
    if row == 5 { return a.row_eid5; };
    if row == 6 { return a.row_eid6; };
    return a.row_eid7;
}

fn _ecs_av_arch_set_eid_at(a0: EcsAvArchDeep, row: i32, value: i32) -> EcsAvArchDeep {
    if row == 0 { a0.row_eid0 = value; return a0; };
    if row == 1 { a0.row_eid1 = value; return a0; };
    if row == 2 { a0.row_eid2 = value; return a0; };
    if row == 3 { a0.row_eid3 = value; return a0; };
    if row == 4 { a0.row_eid4 = value; return a0; };
    if row == 5 { a0.row_eid5 = value; return a0; };
    if row == 6 { a0.row_eid6 = value; return a0; };
    a0.row_eid7 = value;
    return a0;
}

// ── Component value column. Each column is indexed by component_id (>=1). For each registered
//    component we keep three flat ECS_AV_CAP_ROWS-element arrays (value/added/changed), addressed
//    by row index armed by the archetype-slot row the entity occupies. Storage shape mirrors the
//    shallow `world.value_columns` (column-major) but is unrolled into scalar per-row fields to
//    satisfy SA's struct field-set model (Batch 386 pattern): col{0,1,2,3}_val{0..7},
//    col{0,1,2,3}_added{0..7}, col{0,1,2,3}_changed{0..7}.
struct EcsAvWorldDeep {
    arch0: EcsAvArchDeep, arch1: EcsAvArchDeep, arch2: EcsAvArchDeep, arch3: EcsAvArchDeep,
    arch4: EcsAvArchDeep, arch5: EcsAvArchDeep, arch6: EcsAvArchDeep, arch7: EcsAvArchDeep,
    arch_count: i32,
    gen0: i32, gen1: i32, gen2: i32, gen3: i32,
    gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32,
    alive4: i32, alive5: i32, alive6: i32, alive7: i32,
    loc_arch0: i32, loc_arch1: i32, loc_arch2: i32, loc_arch3: i32,
    loc_arch4: i32, loc_arch5: i32, loc_arch6: i32, loc_arch7: i32,
    loc_row0: i32, loc_row1: i32, loc_row2: i32, loc_row3: i32,
    loc_row4: i32, loc_row5: i32, loc_row6: i32, loc_row7: i32,
    next_entity: i32, entity_count: i32,
    change_tick: i32,
    comp0_id: i32, comp1_id: i32, comp2_id: i32, comp3_id: i32,
    comp_count: i32,
    col0_val0: i32, col0_val1: i32, col0_val2: i32, col0_val3: i32,
    col0_val4: i32, col0_val5: i32, col0_val6: i32, col0_val7: i32,
    col0_added0: i32, col0_added1: i32, col0_added2: i32, col0_added3: i32,
    col0_added4: i32, col0_added5: i32, col0_added6: i32, col0_added7: i32,
    col0_changed0: i32, col0_changed1: i32, col0_changed2: i32, col0_changed3: i32,
    col0_changed4: i32, col0_changed5: i32, col0_changed6: i32, col0_changed7: i32,
    col1_val0: i32, col1_val1: i32, col1_val2: i32, col1_val3: i32,
    col1_val4: i32, col1_val5: i32, col1_val6: i32, col1_val7: i32,
    col1_added0: i32, col1_added1: i32, col1_added2: i32, col1_added3: i32,
    col1_added4: i32, col1_added5: i32, col1_added6: i32, col1_added7: i32,
    col1_changed0: i32, col1_changed1: i32, col1_changed2: i32, col1_changed3: i32,
    col1_changed4: i32, col1_changed5: i32, col1_changed6: i32, col1_changed7: i32,
    col2_val0: i32, col2_val1: i32, col2_val2: i32, col2_val3: i32,
    col2_val4: i32, col2_val5: i32, col2_val6: i32, col2_val7: i32,
    col2_added0: i32, col2_added1: i32, col2_added2: i32, col2_added3: i32,
    col2_added4: i32, col2_added5: i32, col2_added6: i32, col2_added7: i32,
    col2_changed0: i32, col2_changed1: i32, col2_changed2: i32, col2_changed3: i32,
    col2_changed4: i32, col2_changed5: i32, col2_changed6: i32, col2_changed7: i32,
    col3_val0: i32, col3_val1: i32, col3_val2: i32, col3_val3: i32,
    col3_val4: i32, col3_val5: i32, col3_val6: i32, col3_val7: i32,
    col3_added0: i32, col3_added1: i32, col3_added2: i32, col3_added3: i32,
    col3_added4: i32, col3_added5: i32, col3_added6: i32, col3_added7: i32,
    col3_changed0: i32, col3_changed1: i32, col3_changed2: i32, col3_changed3: i32,
    col3_changed4: i32, col3_changed5: i32, col3_changed6: i32, col3_changed7: i32,
    res_time_tick: i32, res_time_set: i32,
    res_added_tick: i32, res_changed_tick: i32,
    // cap-16 message slot (amount per message).
    msg0: i32, msg1: i32, msg2: i32, msg3: i32, msg4: i32, msg5: i32, msg6: i32, msg7: i32,
    msg8: i32, msg9: i32, msg10: i32, msg11: i32, msg12: i32, msg13: i32, msg14: i32, msg15: i32,
    msg_count: i32,
    // command queue (cap-8) + side value arrays (cap-8 each for component/resource/message vals)
    cmd_kind0: i32, cmd_kind1: i32, cmd_kind2: i32, cmd_kind3: i32,
    cmd_kind4: i32, cmd_kind5: i32, cmd_kind6: i32, cmd_kind7: i32,
    cmd_eid0: i32, cmd_eid1: i32, cmd_eid2: i32, cmd_eid3: i32,
    cmd_eid4: i32, cmd_eid5: i32, cmd_eid6: i32, cmd_eid7: i32,
    cmd_cid0: i32, cmd_cid1: i32, cmd_cid2: i32, cmd_cid3: i32,
    cmd_cid4: i32, cmd_cid5: i32, cmd_cid6: i32, cmd_cid7: i32,
    cmd_count: i32,
    cmd_pcomp0: i32, cmd_pcomp1: i32, cmd_pcomp2: i32, cmd_pcomp3: i32,
    cmd_pcomp4: i32, cmd_pcomp5: i32, cmd_pcomp6: i32, cmd_pcomp7: i32,
    pcomp_count: i32,
    cmd_pres0: i32, cmd_pres1: i32, cmd_pres2: i32, cmd_pres3: i32,
    cmd_pres4: i32, cmd_pres5: i32, cmd_pres6: i32, cmd_pres7: i32,
    pres_count: i32,
    cmd_pmsg0: i32, cmd_pmsg1: i32, cmd_pmsg2: i32, cmd_pmsg3: i32,
    cmd_pmsg4: i32, cmd_pmsg5: i32, cmd_pmsg6: i32, cmd_pmsg7: i32,
    pmsg_count: i32
}

fn ecs_av_world_deep_new() -> EcsAvWorldDeep {
    let a0 = _ecs_av_arch_empty(0);
    a0.used = 1;
    return EcsAvWorldDeep {
        arch0: a0, arch1: _ecs_av_arch_empty(1), arch2: _ecs_av_arch_empty(2), arch3: _ecs_av_arch_empty(3),
        arch4: _ecs_av_arch_empty(4), arch5: _ecs_av_arch_empty(5), arch6: _ecs_av_arch_empty(6), arch7: _ecs_av_arch_empty(7),
        arch_count: 1,
        gen0: 0, gen1: 0, gen2: 0, gen3: 0,
        gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        alive0: 0, alive1: 0, alive2: 0, alive3: 0,
        alive4: 0, alive5: 0, alive6: 0, alive7: 0,
        loc_arch0: -1, loc_arch1: -1, loc_arch2: -1, loc_arch3: -1,
        loc_arch4: -1, loc_arch5: -1, loc_arch6: -1, loc_arch7: -1,
        loc_row0: -1, loc_row1: -1, loc_row2: -1, loc_row3: -1,
        loc_row4: -1, loc_row5: -1, loc_row6: -1, loc_row7: -1,
        next_entity: 0, entity_count: 0, change_tick: 0,
        comp0_id: 0, comp1_id: 0, comp2_id: 0, comp3_id: 0,
        comp_count: 0,
        col0_val0: 0, col0_val1: 0, col0_val2: 0, col0_val3: 0,
        col0_val4: 0, col0_val5: 0, col0_val6: 0, col0_val7: 0,
        col0_added0: ECS_AV_TICK_NONE, col0_added1: ECS_AV_TICK_NONE, col0_added2: ECS_AV_TICK_NONE, col0_added3: ECS_AV_TICK_NONE,
        col0_added4: ECS_AV_TICK_NONE, col0_added5: ECS_AV_TICK_NONE, col0_added6: ECS_AV_TICK_NONE, col0_added7: ECS_AV_TICK_NONE,
        col0_changed0: ECS_AV_TICK_NONE, col0_changed1: ECS_AV_TICK_NONE, col0_changed2: ECS_AV_TICK_NONE, col0_changed3: ECS_AV_TICK_NONE,
        col0_changed4: ECS_AV_TICK_NONE, col0_changed5: ECS_AV_TICK_NONE, col0_changed6: ECS_AV_TICK_NONE, col0_changed7: ECS_AV_TICK_NONE,
        col1_val0: 0, col1_val1: 0, col1_val2: 0, col1_val3: 0,
        col1_val4: 0, col1_val5: 0, col1_val6: 0, col1_val7: 0,
        col1_added0: ECS_AV_TICK_NONE, col1_added1: ECS_AV_TICK_NONE, col1_added2: ECS_AV_TICK_NONE, col1_added3: ECS_AV_TICK_NONE,
        col1_added4: ECS_AV_TICK_NONE, col1_added5: ECS_AV_TICK_NONE, col1_added6: ECS_AV_TICK_NONE, col1_added7: ECS_AV_TICK_NONE,
        col1_changed0: ECS_AV_TICK_NONE, col1_changed1: ECS_AV_TICK_NONE, col1_changed2: ECS_AV_TICK_NONE, col1_changed3: ECS_AV_TICK_NONE,
        col1_changed4: ECS_AV_TICK_NONE, col1_changed5: ECS_AV_TICK_NONE, col1_changed6: ECS_AV_TICK_NONE, col1_changed7: ECS_AV_TICK_NONE,
        col2_val0: 0, col2_val1: 0, col2_val2: 0, col2_val3: 0,
        col2_val4: 0, col2_val5: 0, col2_val6: 0, col2_val7: 0,
        col2_added0: ECS_AV_TICK_NONE, col2_added1: ECS_AV_TICK_NONE, col2_added2: ECS_AV_TICK_NONE, col2_added3: ECS_AV_TICK_NONE,
        col2_added4: ECS_AV_TICK_NONE, col2_added5: ECS_AV_TICK_NONE, col2_added6: ECS_AV_TICK_NONE, col2_added7: ECS_AV_TICK_NONE,
        col2_changed0: ECS_AV_TICK_NONE, col2_changed1: ECS_AV_TICK_NONE, col2_changed2: ECS_AV_TICK_NONE, col2_changed3: ECS_AV_TICK_NONE,
        col2_changed4: ECS_AV_TICK_NONE, col2_changed5: ECS_AV_TICK_NONE, col2_changed6: ECS_AV_TICK_NONE, col2_changed7: ECS_AV_TICK_NONE,
        col3_val0: 0, col3_val1: 0, col3_val2: 0, col3_val3: 0,
        col3_val4: 0, col3_val5: 0, col3_val6: 0, col3_val7: 0,
        col3_added0: ECS_AV_TICK_NONE, col3_added1: ECS_AV_TICK_NONE, col3_added2: ECS_AV_TICK_NONE, col3_added3: ECS_AV_TICK_NONE,
        col3_added4: ECS_AV_TICK_NONE, col3_added5: ECS_AV_TICK_NONE, col3_added6: ECS_AV_TICK_NONE, col3_added7: ECS_AV_TICK_NONE,
        col3_changed0: ECS_AV_TICK_NONE, col3_changed1: ECS_AV_TICK_NONE, col3_changed2: ECS_AV_TICK_NONE, col3_changed3: ECS_AV_TICK_NONE,
        col3_changed4: ECS_AV_TICK_NONE, col3_changed5: ECS_AV_TICK_NONE, col3_changed6: ECS_AV_TICK_NONE, col3_changed7: ECS_AV_TICK_NONE,
        res_time_tick: 0, res_time_set: 0,
        res_added_tick: ECS_AV_TICK_NONE, res_changed_tick: ECS_AV_TICK_NONE,
        msg0: ECS_AV_TICK_NONE, msg1: ECS_AV_TICK_NONE, msg2: ECS_AV_TICK_NONE, msg3: ECS_AV_TICK_NONE,
        msg4: ECS_AV_TICK_NONE, msg5: ECS_AV_TICK_NONE, msg6: ECS_AV_TICK_NONE, msg7: ECS_AV_TICK_NONE,
        msg8: ECS_AV_TICK_NONE, msg9: ECS_AV_TICK_NONE, msg10: ECS_AV_TICK_NONE, msg11: ECS_AV_TICK_NONE,
        msg12: ECS_AV_TICK_NONE, msg13: ECS_AV_TICK_NONE, msg14: ECS_AV_TICK_NONE, msg15: ECS_AV_TICK_NONE,
        msg_count: 0,
        cmd_kind0: 0, cmd_kind1: 0, cmd_kind2: 0, cmd_kind3: 0,
        cmd_kind4: 0, cmd_kind5: 0, cmd_kind6: 0, cmd_kind7: 0,
        cmd_eid0: 0, cmd_eid1: 0, cmd_eid2: 0, cmd_eid3: 0,
        cmd_eid4: 0, cmd_eid5: 0, cmd_eid6: 0, cmd_eid7: 0,
        cmd_cid0: 0, cmd_cid1: 0, cmd_cid2: 0, cmd_cid3: 0,
        cmd_cid4: 0, cmd_cid5: 0, cmd_cid6: 0, cmd_cid7: 0,
        cmd_count: 0,
        cmd_pcomp0: 0, cmd_pcomp1: 0, cmd_pcomp2: 0, cmd_pcomp3: 0,
        cmd_pcomp4: 0, cmd_pcomp5: 0, cmd_pcomp6: 0, cmd_pcomp7: 0,
        pcomp_count: 0,
        cmd_pres0: 0, cmd_pres1: 0, cmd_pres2: 0, cmd_pres3: 0,
        cmd_pres4: 0, cmd_pres5: 0, cmd_pres6: 0, cmd_pres7: 0,
        pres_count: 0,
        cmd_pmsg0: 0, cmd_pmsg1: 0, cmd_pmsg2: 0, cmd_pmsg3: 0,
        cmd_pmsg4: 0, cmd_pmsg5: 0, cmd_pmsg6: 0, cmd_pmsg7: 0,
        pmsg_count: 0
    };
}

// ── World primitive accessors (field-per-slot unroll, Batch 386 pattern). ───────────────────
fn _ecs_av_world_arch_at(w: EcsAvWorldDeep, idx: i32) -> EcsAvArchDeep {
    if idx == 0 { return w.arch0; };
    if idx == 1 { return w.arch1; };
    if idx == 2 { return w.arch2; };
    if idx == 3 { return w.arch3; };
    if idx == 4 { return w.arch4; };
    if idx == 5 { return w.arch5; };
    if idx == 6 { return w.arch6; };
    return w.arch7;
}

fn _ecs_av_world_set_arch(w0: EcsAvWorldDeep, idx: i32, a: EcsAvArchDeep) -> EcsAvWorldDeep {
    if idx == 0 { w0.arch0 = a; return w0; };
    if idx == 1 { w0.arch1 = a; return w0; };
    if idx == 2 { w0.arch2 = a; return w0; };
    if idx == 3 { w0.arch3 = a; return w0; };
    if idx == 4 { w0.arch4 = a; return w0; };
    if idx == 5 { w0.arch5 = a; return w0; };
    if idx == 6 { w0.arch6 = a; return w0; };
    w0.arch7 = a;
    return w0;
}

fn _ecs_av_world_alive_at(w: EcsAvWorldDeep, eid: i32) -> i32 {
    if eid == 0 { return w.alive0; };
    if eid == 1 { return w.alive1; };
    if eid == 2 { return w.alive2; };
    if eid == 3 { return w.alive3; };
    if eid == 4 { return w.alive4; };
    if eid == 5 { return w.alive5; };
    if eid == 6 { return w.alive6; };
    return w.alive7;
}

fn _ecs_av_world_set_alive(w0: EcsAvWorldDeep, eid: i32, value: i32) -> EcsAvWorldDeep {
    if eid == 0 { w0.alive0 = value; return w0; };
    if eid == 1 { w0.alive1 = value; return w0; };
    if eid == 2 { w0.alive2 = value; return w0; };
    if eid == 3 { w0.alive3 = value; return w0; };
    if eid == 4 { w0.alive4 = value; return w0; };
    if eid == 5 { w0.alive5 = value; return w0; };
    if eid == 6 { w0.alive6 = value; return w0; };
    w0.alive7 = value;
    return w0;
}

fn _ecs_av_world_gen_at(w: EcsAvWorldDeep, eid: i32) -> i32 {
    if eid == 0 { return w.gen0; };
    if eid == 1 { return w.gen1; };
    if eid == 2 { return w.gen2; };
    if eid == 3 { return w.gen3; };
    if eid == 4 { return w.gen4; };
    if eid == 5 { return w.gen5; };
    if eid == 6 { return w.gen6; };
    return w.gen7;
}

