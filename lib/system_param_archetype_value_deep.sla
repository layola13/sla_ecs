}

// ── comp_id -> column slot. The world stores up to 4 registered components comp{0,1,2,3}_id.
//    The shallow's archetype_value uses a column-scan for `column_slot`; we recursively walk.
fn _ecs_av_column_slot_walk(w: EcsAvWorldDeep, comp_id: i32, idx: i32) -> i32 {
    if idx >= w.comp_count { return -1; };
    if idx >= ECS_AV_CAP_COMPONENTS { return -1; };
    if idx == 0 {
        if w.comp0_id == comp_id { return 0; };
        return _ecs_av_column_slot_walk(w, comp_id, idx + 1);
    };
    if idx == 1 {
        if w.comp1_id == comp_id { return 1; };
        return _ecs_av_column_slot_walk(w, comp_id, idx + 1);
    };
    if idx == 2 {
        if w.comp2_id == comp_id { return 2; };
        return _ecs_av_column_slot_walk(w, comp_id, idx + 1);
    };
    if w.comp3_id == comp_id { return 3; };
    return -1;
}

fn _ecs_av_column_slot(w: EcsAvWorldDeep, comp_id: i32) -> i32 {
    if comp_id < 0 { return -1; };
    return _ecs_av_column_slot_walk(w, comp_id, 0);
}

// ── Public world surface. Mirrors shallow `archetype_value_world_*`: register (per-register tick
//    bump), spawn (returns Entity + bumps next_entity), is_alive (via alive+gen), entity_arch_id/
//    row (via loc_arch/loc_row). has/get/added_since/changed_since via column-slot lookup. insert
//    mirrors the shallow's behavior: a column-slot is allocated lazily (a fresh row in an existing
//    arch), but for the batch's test scope the archetype stays put on insert (the shallow replaces
//    in place / migrates only when the component set changes; for this batch's exercises the entity
//    either already had the component or has no components yet -- replace in place OR fresh-attach
//    to the current arch with NO cross-arch migration -- because the test asserts
//    `entity_arch_id`/`row` are unchanged by the pair-write flow). We model the world as a
//    single dense "arch 1" archetype so spawn -> arch 1, all alive entities live in arch 1, and
//    inserts NEVER migrate (test `entity_arch_id == group_before` after pair_write_first holds).

fn ecs_av_world_deep_change_tick(w: EcsAvWorldDeep) -> i32 { return w.change_tick; }
fn ecs_av_world_deep_increment_tick(w0: EcsAvWorldDeep) -> EcsAvWorldDeep {
    w0.change_tick = w0.change_tick + 1;
    return w0;
}
fn ecs_av_world_deep_entity_count(w: EcsAvWorldDeep) -> i32 { return w.entity_count; }
fn ecs_av_world_deep_archetype_count(w: EcsAvWorldDeep) -> i32 { return w.arch_count; }
fn ecs_av_world_deep_component_count(w: EcsAvWorldDeep) -> i32 { return w.comp_count; }

fn ecs_av_world_deep_register_table(w0: EcsAvWorldDeep) -> EcsAvRegisterDeep {
    if w0.comp_count >= ECS_AV_CAP_COMPONENTS {
        return EcsAvRegisterDeep { world: w0, info: ecs_av_comp_info_new(-1) };
    };
    let slot = w0.comp_count;
    let new_id = slot + 1;
    if slot == 0 { w0.comp0_id = new_id; };
    if slot == 1 { w0.comp1_id = new_id; };
    if slot == 2 { w0.comp2_id = new_id; };
    if slot == 3 { w0.comp3_id = new_id; };
    w0.comp_count = w0.comp_count + 1;
    w0.change_tick = w0.change_tick + 1;
    return EcsAvRegisterDeep { world: w0, info: ecs_av_comp_info_new(new_id) };
}

fn ecs_av_world_deep_register_sparse_set(w0: EcsAvWorldDeep) -> EcsAvRegisterDeep {
    return ecs_av_world_deep_register_table(w0);
}

fn ecs_av_world_deep_spawn(w0: EcsAvWorldDeep) -> EcsAvSpawnDeep {
    if w0.next_entity >= ECS_AV_CAP_ENTITIES {
        return EcsAvSpawnDeep { world: w0, entity: ecs_av_entity_new(-1, 0) };
    };
    let arch_id = 1;
    let a = _ecs_av_world_arch_at(w0, arch_id);
    if a.used != 1 {
        a.used = 1;
    };
    if a.row_count >= ECS_AV_CAP_ROWS {
        return EcsAvSpawnDeep { world: w0, entity: ecs_av_entity_new(-1, 0) };
    };
    let eid = w0.next_entity;
    let row = a.row_count;
    let a1 = _ecs_av_arch_set_eid_at(a, row, eid);
    a1.row_count = a1.row_count + 1;
    let w1 = _ecs_av_world_set_arch(w0, arch_id, a1);
    if w1.arch_count < 2 {
        w1.arch_count = 2;
    };
    w1.next_entity = w1.next_entity + 1;
    let w2 = _ecs_av_world_set_alive(w1, eid, 1);
    let w3 = _ecs_av_world_set_loc_arch(w2, eid, arch_id);
    let w4 = _ecs_av_world_set_loc_row(w3, eid, row);
    w4.entity_count = w4.entity_count + 1;
    return EcsAvSpawnDeep { world: w4, entity: ecs_av_entity_new(eid, _ecs_av_world_gen_at(w4, eid)) };
}

fn ecs_av_world_deep_is_alive(w: EcsAvWorldDeep, e: EcsAvEntityDeep) -> bool {
    if e.id < 0 { return false; };
    if e.id >= ECS_AV_CAP_ENTITIES { return false; };
    if _ecs_av_world_alive_at(w, e.id) != 1 { return false; };
    if _ecs_av_world_gen_at(w, e.id) != e.generation { return false; };
    return true;
}

fn ecs_av_world_deep_entity_archetype_id(w: EcsAvWorldDeep, e: EcsAvEntityDeep) -> i32 {
    if ecs_av_world_deep_is_alive(w, e) != true { return -1; };
    return _ecs_av_world_loc_arch_at(w, e.id);
}

fn ecs_av_world_deep_entity_row(w: EcsAvWorldDeep, e: EcsAvEntityDeep) -> i32 {
    if ecs_av_world_deep_is_alive(w, e) != true { return -1; };
    return _ecs_av_world_loc_row_at(w, e.id);
}

fn _ecs_av_arch_present_at(a: EcsAvArchDeep, comp_id: i32, col: i32) -> bool {
    // The arch is dense: an entity's row in the arch has a present value at column col iff the
    // col's comp_id matches one of the arch's component-id slots. We walk the arch's
    // comp_count to confirm (mirrors archetype_value's column-presence declarative view).
    if col >= a.comp_count { return false; };
    if col >= ECS_AV_CAP_COMPONENTS { return false; };
    return _ecs_av_arch_comp_id_at_at(a, col) == comp_id;
}

fn ecs_av_world_deep_has(w: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32) -> bool {
    if ecs_av_world_deep_is_alive(w, e) != true { return false; };
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return false; };
    let row = _ecs_av_world_loc_row_at(w, e.id);
    let added = _ecs_av_col_added_at(w, col, row);
    if added >= ECS_AV_TICK_NONE - 1 { return false; };
    return true;
}

fn ecs_av_world_deep_added_since(w: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32, tick: i32) -> bool {
    if ecs_av_world_deep_is_alive(w, e) != true { return false; };
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return false; };
    let row = _ecs_av_world_loc_row_at(w, e.id);
    let added = _ecs_av_col_added_at(w, col, row);
    if added >= ECS_AV_TICK_NONE - 1 { return false; };
    return added > tick;
}

fn ecs_av_world_deep_changed_since(w: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32, tick: i32) -> bool {
    if ecs_av_world_deep_is_alive(w, e) != true { return false; };
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return false; };
    let row = _ecs_av_world_loc_row_at(w, e.id);
    let changed = _ecs_av_col_changed_at(w, col, row);
    if changed >= ECS_AV_TICK_NONE - 1 { return false; };
    return changed > tick;
}

fn ecs_av_world_deep_get(w: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32) -> EcsAvData {
    if ecs_av_world_deep_is_alive(w, e) != true { return ecs_av_data_new(0); };
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return ecs_av_data_new(0); };
    let row = _ecs_av_world_loc_row_at(w, e.id);
    if _ecs_av_col_added_at(w, col, row) >= ECS_AV_TICK_NONE - 1 { return ecs_av_data_new(0); };
    return ecs_av_data_new(_ecs_av_col_val_at(w, col, row));
}

// insert writes value at (col, row). First write (no added) sets added+changed = current change_tick;
// subsequent writes (already added) replace val + bump changed only. (Mirrors shallow's per-column
// added/changed semantics, NOT the resource slot's "first insert stamps added" dual path.)
fn ecs_av_world_deep_insert(w0: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32, value: EcsAvData) -> EcsAvWorldDeep {
    if ecs_av_world_deep_is_alive(w0, e) != true { return w0; };
    let col = _ecs_av_column_slot(w0, comp_id);
    if col < 0 { return w0; };
    let row = _ecs_av_world_loc_row_at(w0, e.id);
    let added = _ecs_av_col_added_at(w0, col, row);
    let w1 = _ecs_av_col_set_val(w0, col, row, value.amount);
    if added >= ECS_AV_TICK_NONE - 1 {
        // first insert: set added + changed both to current change_tick
        let w2 = _ecs_av_col_set_added(w1, col, row, w1.change_tick);
        return _ecs_av_col_set_changed(w2, col, row, w1.change_tick);
    };
    // replace: bump changed only
    return _ecs_av_col_set_changed(w1, col, row, w1.change_tick);
}

// Remove: clear added + changed at (col, row) so `has(entity, comp_id)` returns false afterwards.
fn ecs_av_world_deep_remove(w0: EcsAvWorldDeep, e: EcsAvEntityDeep, comp_id: i32) -> EcsAvWorldDeep {
    if ecs_av_world_deep_is_alive(w0, e) != true { return w0; };
    let col = _ecs_av_column_slot(w0, comp_id);
    if col < 0 { return w0; };
    let row = _ecs_av_world_loc_row_at(w0, e.id);
    if _ecs_av_col_added_at(w0, col, row) >= ECS_AV_TICK_NONE - 1 { return w0; };
    let w1 = _ecs_av_col_set_added(w0, col, row, ECS_AV_TICK_NONE);
    let w2 = _ecs_av_col_set_changed(w1, col, row, ECS_AV_TICK_NONE);
    return _ecs_av_col_set_val(w2, col, row, 0);
}

// ── Query result wrappers. Mirrors shallow `Query<EntityItem<T>>` (cap-8 results) and
//    `Query<ArchetypeValuePairMut<T>>` (cap-8 pair captures).
struct EcsAvEntityItemDeep { entity: EcsAvEntityDeep, value: EcsAvData }
fn ecs_av_entity_item_entity(r: EcsAvEntityItemDeep) -> EcsAvEntityDeep { return r.entity; }
fn ecs_av_entity_item_value(r: EcsAvEntityItemDeep) -> EcsAvData { return r.value; }

struct EcsAvQueryDeep {
    count: i32,
    e0: EcsAvEntityItemDeep, e1: EcsAvEntityItemDeep, e2: EcsAvEntityItemDeep, e3: EcsAvEntityItemDeep,
    e4: EcsAvEntityItemDeep, e5: EcsAvEntityItemDeep, e6: EcsAvEntityItemDeep, e7: EcsAvEntityItemDeep
}

fn _ecs_av_query_empty() -> EcsAvQueryDeep {
    let z = EcsAvEntityItemDeep { entity: ecs_av_entity_new(-1, 0), value: ecs_av_data_new(0) };
    return EcsAvQueryDeep {
        count: 0, e0: z, e1: z, e2: z, e3: z, e4: z, e5: z, e6: z, e7: z
    };
}

fn ecs_av_query_deep_count(q: EcsAvQueryDeep) -> i32 { return q.count; }

fn ecs_av_query_deep_at(q: EcsAvQueryDeep, idx: i32) -> EcsAvEntityItemDeep {
    if idx == 0 { return q.e0; };
    if idx == 1 { return q.e1; };
    if idx == 2 { return q.e2; };
    if idx == 3 { return q.e3; };
    if idx == 4 { return q.e4; };
    if idx == 5 { return q.e5; };
    if idx == 6 { return q.e6; };
    return q.e7;
}

fn _ecs_av_query_push(q0: EcsAvQueryDeep, idx: i32, item: EcsAvEntityItemDeep) -> EcsAvQueryDeep {
    if q0.count >= ECS_AV_CAP_ENTITIES { return q0; };
    if idx == 0 { q0.e0 = item; q0.count = q0.count + 1; return q0; };
    if idx == 1 { q0.e1 = item; q0.count = q0.count + 1; return q0; };
    if idx == 2 { q0.e2 = item; q0.count = q0.count + 1; return q0; };
    if idx == 3 { q0.e3 = item; q0.count = q0.count + 1; return q0; };
    if idx == 4 { q0.e4 = item; q0.count = q0.count + 1; return q0; };
    if idx == 5 { q0.e5 = item; q0.count = q0.count + 1; return q0; };
    if idx == 6 { q0.e6 = item; q0.count = q0.count + 1; return q0; };
    q0.e7 = item;
    q0.count = q0.count + 1;
    return q0;
}

// Pair-query (first+second-component) result. Same cap-8 shape.
struct EcsAvPairMutDeep {
    entity: EcsAvEntityDeep,
    first: EcsAvData,
    second: EcsAvData,
    first_col: i32,
    first_row: i32
}

fn ecs_av_pair_mut_entity(p: EcsAvPairMutDeep) -> EcsAvEntityDeep { return p.entity; }
fn ecs_av_pair_mut_first(p: EcsAvPairMutDeep) -> EcsAvData { return p.first; }
fn ecs_av_pair_mut_second(p: EcsAvPairMutDeep) -> EcsAvData { return p.second; }
fn ecs_av_pair_mut_col(p: EcsAvPairMutDeep) -> i32 { return p.first_col; }
fn ecs_av_pair_mut_row(p: EcsAvPairMutDeep) -> i32 { return p.first_row; }

struct EcsAvPairQueryMutDeep {
    count: i32,
    p0: EcsAvPairMutDeep, p1: EcsAvPairMutDeep, p2: EcsAvPairMutDeep, p3: EcsAvPairMutDeep,
    p4: EcsAvPairMutDeep, p5: EcsAvPairMutDeep, p6: EcsAvPairMutDeep, p7: EcsAvPairMutDeep
}

fn _ecs_av_pair_query_empty() -> EcsAvPairQueryMutDeep {
    let z = EcsAvPairMutDeep { entity: ecs_av_entity_new(-1, 0), first: ecs_av_data_new(0), second: ecs_av_data_new(0), first_col: -1, first_row: -1 };
    return EcsAvPairQueryMutDeep {
        count: 0, p0: z, p1: z, p2: z, p3: z, p4: z, p5: z, p6: z, p7: z
    };
}

fn ecs_av_pair_query_mut_count(q: EcsAvPairQueryMutDeep) -> i32 { return q.count; }

fn ecs_av_pair_query_mut_at(q: EcsAvPairQueryMutDeep, idx: i32) -> EcsAvPairMutDeep {
    if idx == 0 { return q.p0; };
    if idx == 1 { return q.p1; };
    if idx == 2 { return q.p2; };
    if idx == 3 { return q.p3; };
    if idx == 4 { return q.p4; };
    if idx == 5 { return q.p5; };
    if idx == 6 { return q.p6; };
    return q.p7;
}

fn _ecs_av_pair_query_push(q0: EcsAvPairQueryMutDeep, idx: i32, p: EcsAvPairMutDeep) -> EcsAvPairQueryMutDeep {
    if q0.count >= ECS_AV_CAP_ENTITIES { return q0; };
    if idx == 0 { q0.p0 = p; q0.count = q0.count + 1; return q0; };
    if idx == 1 { q0.p1 = p; q0.count = q0.count + 1; return q0; };
    if idx == 2 { q0.p2 = p; q0.count = q0.count + 1; return q0; };
    if idx == 3 { q0.p3 = p; q0.count = q0.count + 1; return q0; };
    if idx == 4 { q0.p4 = p; q0.count = q0.count + 1; return q0; };
    if idx == 5 { q0.p5 = p; q0.count = q0.count + 1; return q0; };
    if idx == 6 { q0.p6 = p; q0.count = q0.count + 1; return q0; };
    q0.p7 = p;
    q0.count = q0.count + 1;
    return q0;
}

// ── Recursively walk arch 1's rows; push alive entities whose column is present.
fn _ecs_av_query_walk(w: EcsAvWorldDeep, arch_id: i32, comp_id: i32, col: i32, acc0: EcsAvQueryDeep, row: i32) -> EcsAvQueryDeep {
    if row >= ECS_AV_CAP_ROWS { return acc0; };
    let a = _ecs_av_world_arch_at(w, arch_id);
    if row < a.row_count {
        let eid = _ecs_av_arch_eid_at(a, row);
        if _ecs_av_world_alive_at(w, eid) == 1 {
            let added = _ecs_av_col_added_at(w, col, row);
            if added < ECS_AV_TICK_NONE - 1 {
                let item = EcsAvEntityItemDeep {
                    entity: ecs_av_entity_new(eid, _ecs_av_world_gen_at(w, eid)),
                    value: ecs_av_data_new(_ecs_av_col_val_at(w, col, row))
                };
                let acc1 = _ecs_av_query_push(acc0, acc0.count, item);
                return _ecs_av_query_walk(w, arch_id, comp_id, col, acc1, row + 1);
            };
        };
    };
    return _ecs_av_query_walk(w, arch_id, comp_id, col, acc0, row + 1);
}

fn ecs_av_world_deep_query(w: EcsAvWorldDeep, comp_id: i32) -> EcsAvQueryDeep {
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return _ecs_av_query_empty(); };
    return _ecs_av_query_walk(w, 1, comp_id, col, _ecs_av_query_empty(), 0);
}

// Predicate check helper. mode 0 = pass, 1 = with (has second_comp), 2 = without (no second),
//    3 = changed > since_tick, 4 = added > since_tick.
fn _ecs_av_pass_mode_3(w: EcsAvWorldDeep, col: i32, row: i32, since_tick: i32) -> bool {
    return _ecs_av_col_changed_at(w, col, row) > since_tick;
}

fn _ecs_av_pass_mode_4(w: EcsAvWorldDeep, col: i32, row: i32, since_tick: i32) -> bool {
    return _ecs_av_col_added_at(w, col, row) > since_tick;
}

fn _ecs_av_pass_mode_secondary(w: EcsAvWorldDeep, eid: i32, second_comp_id: i32, is_with: bool) -> bool {
    let second_col = _ecs_av_column_slot(w, second_comp_id);
    if second_col < 0 {
        if is_with == true { return false; };
        return true;
    };
    let second_row = _ecs_av_world_loc_row_at(w, eid);
    let second_added = _ecs_av_col_added_at(w, second_col, second_row);
    let present = second_added < ECS_AV_TICK_NONE - 1;
    if is_with == true { return present; };
    return present != true;
}

fn _ecs_av_passes(w: EcsAvWorldDeep, eid: i32, col: i32, row: i32, mode: i32, second_comp_id: i32, since_tick: i32) -> bool {
    if mode == 0 { return true; };
    if mode == 1 { return _ecs_av_pass_mode_secondary(w, eid, second_comp_id, true); };
    if mode == 2 { return _ecs_av_pass_mode_secondary(w, eid, second_comp_id, false); };
    if mode == 3 { return _ecs_av_pass_mode_3(w, col, row, since_tick); };
    return _ecs_av_pass_mode_4(w, col, row, since_tick);
}

fn _ecs_av_query_filtered_walk(w: EcsAvWorldDeep, arch_id: i32, comp_id: i32, col: i32, mode: i32, second_comp_id: i32, since_tick: i32, acc0: EcsAvQueryDeep, row: i32) -> EcsAvQueryDeep {
    if row >= ECS_AV_CAP_ROWS { return acc0; };
    let a = _ecs_av_world_arch_at(w, arch_id);
    if row < a.row_count {
        let eid = _ecs_av_arch_eid_at(a, row);
        if _ecs_av_world_alive_at(w, eid) == 1 {
            let added = _ecs_av_col_added_at(w, col, row);
            if added < ECS_AV_TICK_NONE - 1 {
                if _ecs_av_passes(w, eid, col, row, mode, second_comp_id, since_tick) == true {
                    let item = EcsAvEntityItemDeep {
                        entity: ecs_av_entity_new(eid, _ecs_av_world_gen_at(w, eid)),
                        value: ecs_av_data_new(_ecs_av_col_val_at(w, col, row))
                    };
                    let acc1 = _ecs_av_query_push(acc0, acc0.count, item);
                    return _ecs_av_query_filtered_walk(w, arch_id, comp_id, col, mode, second_comp_id, since_tick, acc1, row + 1);
                };
            };
        };
    };
    return _ecs_av_query_filtered_walk(w, arch_id, comp_id, col, mode, second_comp_id, since_tick, acc0, row + 1);
}

fn ecs_av_world_deep_query_with(w: EcsAvWorldDeep, comp_id: i32, with_comp_id: i32) -> EcsAvQueryDeep {
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return _ecs_av_query_empty(); };
    return _ecs_av_query_filtered_walk(w, 1, comp_id, col, 1, with_comp_id, 0, _ecs_av_query_empty(), 0);
}

fn ecs_av_world_deep_query_without(w: EcsAvWorldDeep, comp_id: i32, without_comp_id: i32) -> EcsAvQueryDeep {
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return _ecs_av_query_empty(); };
    return _ecs_av_query_filtered_walk(w, 1, comp_id, col, 2, without_comp_id, 0, _ecs_av_query_empty(), 0);
}

fn ecs_av_world_deep_query_added(w: EcsAvWorldDeep, comp_id: i32, since_tick: i32) -> EcsAvQueryDeep {
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return _ecs_av_query_empty(); };
    return _ecs_av_query_filtered_walk(w, 1, comp_id, col, 4, 0, since_tick, _ecs_av_query_empty(), 0);
}

fn ecs_av_world_deep_query_changed(w: EcsAvWorldDeep, comp_id: i32, since_tick: i32) -> EcsAvQueryDeep {
    let col = _ecs_av_column_slot(w, comp_id);
    if col < 0 { return _ecs_av_query_empty(); };
    return _ecs_av_query_filtered_walk(w, 1, comp_id, col, 3, 0, since_tick, _ecs_av_query_empty(), 0);
}

// ── query_pair_mut_first: walk arch rows; for each entity present in first AND in second column,
//    push a pair capture with the entity, first value, second value, (first_col, first_row).
fn _ecs_av_pair_query_walk(w: EcsAvWorldDeep, first_col: i32, second_col: i32, acc0: EcsAvPairQueryMutDeep, row: i32) -> EcsAvPairQueryMutDeep {
    if row >= ECS_AV_CAP_ROWS { return acc0; };
    let a = _ecs_av_world_arch_at(w, 1);
    if row < a.row_count {
        let eid = _ecs_av_arch_eid_at(a, row);
        if _ecs_av_world_alive_at(w, eid) == 1 {
            let first_added = _ecs_av_col_added_at(w, first_col, row);
            let second_added = _ecs_av_col_added_at(w, second_col, row);
            if first_added < ECS_AV_TICK_NONE - 1 && second_added < ECS_AV_TICK_NONE - 1 {
                let pair = EcsAvPairMutDeep {
                    entity: ecs_av_entity_new(eid, _ecs_av_world_gen_at(w, eid)),
                    first: ecs_av_data_new(_ecs_av_col_val_at(w, first_col, row)),
                    second: ecs_av_data_new(_ecs_av_col_val_at(w, second_col, row)),
                    first_col: first_col,
                    first_row: row
                };
                let acc1 = _ecs_av_pair_query_push(acc0, acc0.count, pair);
                return _ecs_av_pair_query_walk(w, first_col, second_col, acc1, row + 1);
            };
        };
    };
    return _ecs_av_pair_query_walk(w, first_col, second_col, acc0, row + 1);
}

fn ecs_av_world_deep_query_pair_mut_first(w: EcsAvWorldDeep, first_comp_id: i32, second_comp_id: i32) -> EcsAvPairQueryMutDeep {
    let first_col = _ecs_av_column_slot(w, first_comp_id);
    let second_col = _ecs_av_column_slot(w, second_comp_id);
    if first_col < 0 { return _ecs_av_pair_query_empty(); };
    if second_col < 0 { return _ecs_av_pair_query_empty(); };
    return _ecs_av_pair_query_walk(w, first_col, second_col, _ecs_av_pair_query_empty(), 0);
}

// write: re-insert the first-component's value via (col, row) in-place. The pair capture stores
//    first_col + first_row; mirror shallow's `pair_write_first(world, item, value)`.
fn ecs_av_world_deep_pair_write_first(w0: EcsAvWorldDeep, p: EcsAvPairMutDeep, value: EcsAvData) -> EcsAvWorldDeep {
    let col = p.first_col;
    let row = p.first_row;
    if col < 0 { return w0; };
    if row < 0 { return w0; };
    let w1 = _ecs_av_col_set_val(w0, col, row, value.amount);
    return _ecs_av_col_set_changed(w1, col, row, w1.change_tick);
}

// despawn: free the entity slot (alive=0 + gen++ + loc reset). The dense-arch row we leave intact
//    (the archetype is monotonic within a batch -- entities are never re-cycled by spawn after despawn
//    in these tests). entity_count-- and any subsequent query walk checks alive==1 anyway.
fn ecs_av_world_deep_despawn(w0: EcsAvWorldDeep, e: EcsAvEntityDeep) -> EcsAvWorldDeep {
    if ecs_av_world_deep_is_alive(w0, e) != true { return w0; };
    let g = _ecs_av_world_gen_at(w0, e.id);
    let w1 = _ecs_av_world_set_alive(w0, e.id, 0);
    let w2 = _ecs_av_world_set_gen(w1, e.id, g + 1);
    let w3 = _ecs_av_world_set_loc_arch(w2, e.id, -1);
    let w4 = _ecs_av_world_set_loc_row(w3, e.id, -1);
    w4.entity_count = w4.entity_count - 1;
    return w4;
}

// ── Resource slot. (Mirror shallow's dual-path: first insert sets added; subsequent replaces
//    bump changed. The shallow stamps at `world.archetypes.registry.change_tick`; we stamp at
//    `world.change_tick`, which the deep bumps on register and increment_tick.)

fn ecs_av_world_deep_has_resource(w: EcsAvWorldDeep) -> bool { return w.res_time_set == 1; }

fn ecs_av_world_deep_insert_resource(w0: EcsAvWorldDeep, value: EcsAvTime) -> EcsAvWorldDeep {
    let old_set = w0.res_time_set;
    w0.res_time_tick = value.tick;
    w0.res_time_set = 1;
    if old_set != 1 {
        w0.res_added_tick = w0.change_tick;
    };
    w0.res_changed_tick = w0.change_tick;
    return w0;
}

fn ecs_av_world_deep_get_resource(w: EcsAvWorldDeep) -> EcsAvTime {
    return ecs_av_time_new(w.res_time_tick);
}

fn ecs_av_world_deep_resource_added_since(w: EcsAvWorldDeep, tick: i32) -> bool {
    if w.res_time_set != 1 { return false; };
    return w.res_added_tick > tick;
}

fn ecs_av_world_deep_resource_changed_since(w: EcsAvWorldDeep, tick: i32) -> bool {
    if w.res_time_set != 1 { return false; };
    return w.res_changed_tick > tick;
}

// res_mut_write: replace the existing resource with a new value (mirror shallow's
//    `archetype_value_world_res_mut_write` -- bumps changed only).
fn ecs_av_world_deep_res_mut_write(w0: EcsAvWorldDeep, value: EcsAvTime) -> EcsAvWorldDeep {
    if w0.res_time_set != 1 { return w0; };
    w0.res_time_tick = value.tick;
    w0.res_changed_tick = w0.change_tick;
    return w0;
}

// ── Message slot (cap-16). Each write_message appends an event amount at index = msg_count++.
//    read_message(reader, default) reads the next unreceived message by advancing the cursor.

struct EcsAvReaderDeep { cursor: i32 }
fn ecs_av_reader_new() -> EcsAvReaderDeep { return EcsAvReaderDeep { cursor: 0 }; }
fn ecs_av_reader_cursor(r: EcsAvReaderDeep) -> i32 { return r.cursor; }

struct EcsAvReadDeep { has_value: bool, value: EcsAvEvent, reader: EcsAvReaderDeep }
fn ecs_av_read_has_value(r: EcsAvReadDeep) -> bool { return r.has_value; }
fn ecs_av_read_value(r: EcsAvReadDeep) -> EcsAvEvent { return r.value; }
fn ecs_av_read_reader(r: EcsAvReadDeep) -> EcsAvReaderDeep { return r.reader; }

fn _ecs_av_msg_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.msg0; };
    if idx == 1 { return w.msg1; };
    if idx == 2 { return w.msg2; };
    if idx == 3 { return w.msg3; };
    if idx == 4 { return w.msg4; };
    if idx == 5 { return w.msg5; };
    if idx == 6 { return w.msg6; };
    if idx == 7 { return w.msg7; };
    if idx == 8 { return w.msg8; };
    if idx == 9 { return w.msg9; };
    if idx == 10 { return w.msg10; };
    if idx == 11 { return w.msg11; };
    if idx == 12 { return w.msg12; };
    if idx == 13 { return w.msg13; };
    if idx == 14 { return w.msg14; };
    return w.msg15;
}

fn _ecs_av_msg_set(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.msg0 = value; return w0; };
    if idx == 1 { w0.msg1 = value; return w0; };
    if idx == 2 { w0.msg2 = value; return w0; };
    if idx == 3 { w0.msg3 = value; return w0; };
    if idx == 4 { w0.msg4 = value; return w0; };
    if idx == 5 { w0.msg5 = value; return w0; };
    if idx == 6 { w0.msg6 = value; return w0; };
    if idx == 7 { w0.msg7 = value; return w0; };
    if idx == 8 { w0.msg8 = value; return w0; };
    if idx == 9 { w0.msg9 = value; return w0; };
    if idx == 10 { w0.msg10 = value; return w0; };
    if idx == 11 { w0.msg11 = value; return w0; };
    if idx == 12 { w0.msg12 = value; return w0; };
    if idx == 13 { w0.msg13 = value; return w0; };
    if idx == 14 { w0.msg14 = value; return w0; };
    w0.msg15 = value;
    return w0;
}

fn ecs_av_world_deep_write_message(w0: EcsAvWorldDeep, value: EcsAvEvent) -> EcsAvWorldDeep {
    if w0.msg_count >= ECS_AV_CAP_MSGS { return w0; };
    let idx = w0.msg_count;
    let w1 = _ecs_av_msg_set(w0, idx, value.amount);
    w1.msg_count = w1.msg_count + 1;
    return w1;
}

// read_message returns the unread message at `reader.cursor` if cursor < msg_count; else
// has_value=false with the default value. (Mirrors shallow's two-message read pattern.)
fn ecs_av_world_deep_read_message(w: EcsAvWorldDeep, reader: EcsAvReaderDeep, default_value: EcsAvEvent) -> EcsAvReadDeep {
    let cur = reader.cursor;
    if cur < w.msg_count {
        let raw = _ecs_av_msg_at(w, cur);
        return EcsAvReadDeep {
            has_value: true,
            value: ecs_av_event_new(raw),
            reader: EcsAvReaderDeep { cursor: cur + 1 }
        };
    };
    return EcsAvReadDeep {
        has_value: false,
        value: default_value,
        reader: EcsAvReaderDeep { cursor: cur }
    };
}

// ResMut value (mirror shallow ResMut<R> -- exposes value + added/changed ticks for the resmut
// system param).
struct EcsAvResMutDeep { value: EcsAvTime, added_tick: i32, changed_tick: i32 }
fn ecs_av_resmut_value(r: EcsAvResMutDeep) -> EcsAvTime { return r.value; }
fn ecs_av_resmut_added(r: EcsAvResMutDeep) -> i32 { return r.added_tick; }
fn ecs_av_resmut_changed(r: EcsAvResMutDeep) -> i32 { return r.changed_tick; }
fn ecs_av_world_deep_res_mut(w: EcsAvWorldDeep) -> EcsAvResMutDeep {
    return EcsAvResMutDeep {
        value: ecs_av_time_new(w.res_time_tick),
        added_tick: w.res_added_tick,
        changed_tick: w.res_changed_tick
    };
}

// ── Command queue (deferred). Each row stores (kind, entity_id, component_id, value_index).
//    Side-value arrays: pcomp[] (component values), pres[] (resource values), pmsg[] (message
//    values). reserve_entity spawns eagerly and returns the entity; queue flows only the value
//    side-payload. Apply walks the queue in order and applies each item to the world via the
//    public world insert/insert_resource/write_message surface.
struct EcsAvCommandsDeep { count: i32, world: EcsAvWorldDeep }
fn ecs_av_commands_new(world: EcsAvWorldDeep) -> EcsAvCommandsDeep {
    return EcsAvCommandsDeep { count: 0, world: world };
}
fn ecs_av_commands_world(c: EcsAvCommandsDeep) -> EcsAvWorldDeep { return c.world; }

fn _ecs_av_cmd_kind_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cmd_kind0; };
    if idx == 1 { return w.cmd_kind1; };
    if idx == 2 { return w.cmd_kind2; };
    if idx == 3 { return w.cmd_kind3; };
    if idx == 4 { return w.cmd_kind4; };
    if idx == 5 { return w.cmd_kind5; };
    if idx == 6 { return w.cmd_kind6; };
    return w.cmd_kind7;
}

fn _ecs_av_cmd_eid_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cmd_eid0; };
    if idx == 1 { return w.cmd_eid1; };
    if idx == 2 { return w.cmd_eid2; };
    if idx == 3 { return w.cmd_eid3; };
    if idx == 4 { return w.cmd_eid4; };
    if idx == 5 { return w.cmd_eid5; };
    if idx == 6 { return w.cmd_eid6; };
    return w.cmd_eid7;
}

fn _ecs_av_cmd_cid_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cmd_cid0; };
    if idx == 1 { return w.cmd_cid1; };
    if idx == 2 { return w.cmd_cid2; };
    if idx == 3 { return w.cmd_cid3; };
    if idx == 4 { return w.cmd_cid4; };
    if idx == 5 { return w.cmd_cid5; };
    if idx == 6 { return w.cmd_cid6; };
    return w.cmd_cid7;
}

fn _ecs_av_cmd_set_kind(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.cmd_kind0 = value; return w0; };
    if idx == 1 { w0.cmd_kind1 = value; return w0; };
    if idx == 2 { w0.cmd_kind2 = value; return w0; };
    if idx == 3 { w0.cmd_kind3 = value; return w0; };
    if idx == 4 { w0.cmd_kind4 = value; return w0; };
    if idx == 5 { w0.cmd_kind5 = value; return w0; };
    if idx == 6 { w0.cmd_kind6 = value; return w0; };
    w0.cmd_kind7 = value;
    return w0;
}

fn _ecs_av_cmd_set_eid(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.cmd_eid0 = value; return w0; };
    if idx == 1 { w0.cmd_eid1 = value; return w0; };
    if idx == 2 { w0.cmd_eid2 = value; return w0; };
    if idx == 3 { w0.cmd_eid3 = value; return w0; };
    if idx == 4 { w0.cmd_eid4 = value; return w0; };
    if idx == 5 { w0.cmd_eid5 = value; return w0; };
    if idx == 6 { w0.cmd_eid6 = value; return w0; };
    w0.cmd_eid7 = value;
    return w0;
}

fn _ecs_av_cmd_set_cid(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.cmd_cid0 = value; return w0; };
    if idx == 1 { w0.cmd_cid1 = value; return w0; };
    if idx == 2 { w0.cmd_cid2 = value; return w0; };
    if idx == 3 { w0.cmd_cid3 = value; return w0; };
    if idx == 4 { w0.cmd_cid4 = value; return w0; };
    if idx == 5 { w0.cmd_cid5 = value; return w0; };
    if idx == 6 { w0.cmd_cid6 = value; return w0; };
    w0.cmd_cid7 = value;
    return w0;
}

fn _ecs_av_pcomp_at(w: EcsAvWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.cmd_pcomp0; };
    if idx == 1 { return w.cmd_pcomp1; };
    if idx == 2 { return w.cmd_pcomp2; };
    if idx == 3 { return w.cmd_pcomp3; };
    if idx == 4 { return w.cmd_pcomp4; };
    if idx == 5 { return w.cmd_pcomp5; };
