}

fn _ecs_av_pres_set(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.cmd_pres0 = value; return w0; };
    if idx == 1 { w0.cmd_pres1 = value; return w0; };
    if idx == 2 { w0.cmd_pres2 = value; return w0; };
    if idx == 3 { w0.cmd_pres3 = value; return w0; };
    if idx == 4 { w0.cmd_pres4 = value; return w0; };
    if idx == 5 { w0.cmd_pres5 = value; return w0; };
    if idx == 6 { w0.cmd_pres6 = value; return w0; };
