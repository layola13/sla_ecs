fn _ecs_av_pmsg_set(w0: EcsAvWorldDeep, idx: i32, value: i32) -> EcsAvWorldDeep {
    if idx == 0 { w0.cmd_pmsg0 = value; return w0; };
    if idx == 1 { w0.cmd_pmsg1 = value; return w0; };
    if idx == 2 { w0.cmd_pmsg2 = value; return w0; };
    if idx == 3 { w0.cmd_pmsg3 = value; return w0; };
    if idx == 4 { w0.cmd_pmsg4 = value; return w0; };
    if idx == 5 { w0.cmd_pmsg5 = value; return w0; };
    if idx == 6 { w0.cmd_pmsg6 = value; return w0; };
