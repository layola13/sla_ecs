    if slot == 11 { a0.changed_t11 = value; return a0; };
    if slot == 12 { a0.changed_t12 = value; return a0; };
    if slot == 13 { a0.changed_t13 = value; return a0; };
    if slot == 14 { a0.changed_t14 = value; return a0; };
    a0.changed_t15 = value;
    return a0;
}

// ── World: cap-4 archetypes, cap-8 entity registry, cap-4 registered component ids, tick,
//    resource slot, message slot.  Entity location table is (arch_id, row).  Generations and
//    alive flags are per-entity (cap-8).  Messages form a circular cap-8 buffer with a cursor.
struct EcsAVWorldDeep {
    // cap-4 archetype slots.
    arch_count: i32,
    arch0: EcsAVArchDeep, arch1: EcsAVArchDeep, arch2: EcsAVArchDeep, arch3: EcsAVArchDeep,
    // cap-8 entity location/generation/alive.
    loc_arch0: i32, loc_arch1: i32, loc_arch2: i32, loc_arch3: i32, loc_arch4: i32, loc_arch5: i32, loc_arch6: i32, loc_arch7: i32,
    loc_row0: i32, loc_row1: i32, loc_row2: i32, loc_row3: i32, loc_row4: i32, loc_row5: i32, loc_row6: i32, loc_row7: i32,
    gen0: i32, gen1: i32, gen2: i32, gen3: i32, gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32, alive4: i32, alive5: i32, alive6: i32, alive7: i32,
    entity_count: i32,
    // cap-4 registered component ids (id starts at 1; 0 is reserved sentinel for "none").
    comp_count: i32,
    reg_id0: i32, reg_id1: i32, reg_id2: i32, reg_id3: i32,
    reg_kind0: i32, reg_kind1: i32, reg_kind2: i32, reg_kind3: i32,
    change_tick: i32,
    // Resource slot (single Time plug).
    res_has: i32,
    res_tick: i32,
    res_added_tick: i32,
    res_changed_tick: i32,
    // Message slot (cap-8 circular).
    msg_head: i32,
    msg_tail: i32,
    msg0: i32, msg1: i32, msg2: i32, msg3: i32, msg4: i32, msg5: i32, msg6: i32, msg7: i32,
    msg_cursor0: i32, msg_cursor1: i32, msg_cursor2: i32, msg_cursor3: i32, msg_cursor4: i32, msg_cursor5: i32, msg_cursor6: i32, msg_cursor7: i32
}

fn _ecs_av_world_arch_zeros() -> EcsAVArchDeep {
    return _ecs_av_arch_empty(0, 0);
}

fn ecs_av_world_deep_new() -> EcsAVWorldDeep {
    let a0 = _ecs_av_arch_empty(0, 0);
    return EcsAVWorldDeep {
        arch_count: 1,
        arch0: a0, arch1: _ecs_av_arch_empty(1, 0), arch2: _ecs_av_arch_empty(2, 0), arch3: _ecs_av_arch_empty(3, 0),
        loc_arch0: -1, loc_arch1: -1, loc_arch2: -1, loc_arch3: -1, loc_arch4: -1, loc_arch5: -1, loc_arch6: -1, loc_arch7: -1,
        loc_row0: -1, loc_row1: -1, loc_row2: -1, loc_row3: -1, loc_row4: -1, loc_row5: -1, loc_row6: -1, loc_row7: -1,
        gen0: 0, gen1: 0, gen2: 0, gen3: 0, gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        alive0: 0, alive1: 0, alive2: 0, alive3: 0, alive4: 0, alive5: 0, alive6: 0, alive7: 0,
        entity_count: 0,
        comp_count: 0,
        reg_id0: 0, reg_id1: 0, reg_id2: 0, reg_id3: 0,
        reg_kind0: 0, reg_kind1: 0, reg_kind2: 0, reg_kind3: 0,
        change_tick: 0,
        res_has: 0,
        res_tick: 0,
        res_added_tick: 0,
        res_changed_tick: 0,
        msg_head: 0, msg_tail: 0,
        msg0: 0, msg1: 0, msg2: 0, msg3: 0, msg4: 0, msg5: 0, msg6: 0, msg7: 0,
        msg_cursor0: 0, msg_cursor1: 0, msg_cursor2: 0, msg_cursor3: 0, msg_cursor4: 0, msg_cursor5: 0, msg_cursor6: 0, msg_cursor7: 0
    };
}

// ── World archetype (cap-4 slot) accessors. ──────────────────────────────────────────────────
fn _ecs_av_world_arch_at(w: EcsAVWorldDeep, idx: i32) -> EcsAVArchDeep {
    if idx == 0 { return w.arch0; };
    if idx == 1 { return w.arch1; };
    if idx == 2 { return w.arch2; };
    return w.arch3;
}

fn _ecs_av_world_set_arch(w0: EcsAVWorldDeep, idx: i32, arch: EcsAVArchDeep) -> EcsAVWorldDeep {
    if idx == 0 { w0.arch0 = arch; return w0; };
    if idx == 1 { w0.arch1 = arch; return w0; };
    if idx == 2 { w0.arch2 = arch; return w0; };
    w0.arch3 = arch;
    return w0;
}

// ── World entity (cap-8 slot) accessors. ───────────────────────────────────────────────────
fn _ecs_av_world_gen_at(w: EcsAVWorldDeep, eid: i32) -> i32 {
    if eid == 0 { return w.gen0; };
    if eid == 1 { return w.gen1; };
    if eid == 2 { return w.gen2; };
    if eid == 3 { return w.gen3; };
    if eid == 4 { return w.gen4; };
    if eid == 5 { return w.gen5; };
    if eid == 6 { return w.gen6; };
    return w.gen7;
}

fn _ecs_av_world_set_gen(w0: EcsAVWorldDeep, eid: i32, value: i32) -> EcsAVWorldDeep {
    if eid == 0 { w0.gen0 = value; return w0; };
    if eid == 1 { w0.gen1 = value; return w0; };
    if eid == 2 { w0.gen2 = value; return w0; };
    if eid == 3 { w0.gen3 = value; return w0; };
    if eid == 4 { w0.gen4 = value; return w0; };
    if eid == 5 { w0.gen5 = value; return w0; };
    if eid == 6 { w0.gen6 = value; return w0; };
    w0.gen7 = value;
    return w0;
}

fn _ecs_av_world_alive_at(w: EcsAVWorldDeep, eid: i32) -> i32 {
    if eid == 0 { return w.alive0; };
    if eid == 1 { return w.alive1; };
    if eid == 2 { return w.alive2; };
    if eid == 3 { return w.alive3; };
    if eid == 4 { return w.alive4; };
    if eid == 5 { return w.alive5; };
    if eid == 6 { return w.alive6; };
