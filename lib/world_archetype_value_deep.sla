// Deep bed for lib/world_archetype_value.sla (Batch 388).
// Mirrors shallow `lib/world_archetype_value.sla`'s `ArchetypeValueWorld<T, R, M>` as a
// SELF-CONTAINED fixed-cap variant (NO `@import`) using concrete typed columns based on
// `ArchetypeValueData { amount }`, `ArchetypeValueTime { tick }` (resource), and
// `ArchetypeValueEvent { amount }` (message).  Storage is archetype-grouped: each archetype
// carries cap-4 component columns x cap-4 entity rows of typed values, and each entity has a
// (archetype_id, row) location. Inserting/removing a component migrates the entity between
// archetypes, preserving its existing component values from the old archetype and adding the
// new component's value. Mirrors Bevy's archetype-store: an entity moves on component change.
//
// Storage layout: cap-4 archetypes, cap-4 component ids per archetype, cap-4 entity rows per
// archetype, cap-8 entity ids overall.  Per-archetype value array is flat 4*4 = 16 i32 slots
// (indexed by col*4 + row).  `present_mask` per column (i32 bitmask over rows).  Per-archetype
// `added_t0..15` and `changed_t0..15` likewise flat cap-16 indexed col*4 + row.  Resource slot +
// message slot + monotone `change_tick`.  Wrapper structs expose scalar accessors (no tuple-
// return destructuring in tests).

const ECS_AV_CAP_ARCH: i32 = 4;
const ECS_AV_CAP_COMPONENTS_PER_ARCH: i32 = 4;
const ECS_AV_CAP_ROWS_PER_ARCH: i32 = 4;
const ECS_AV_CAP_ENTITIES: i32 = 8;
const ECS_AV_CAP_MESSAGES: i32 = 8;
const ECS_AV_TICK_NONE: i32 = 999999;

struct EcsAVEntityDeep { id: i32, generation: i32 }

fn ecs_av_entity_eq_deep(a: EcsAVEntityDeep, b: EcsAVEntityDeep) -> bool {
    if a.id != b.id { return false; };
    if a.generation != b.generation { return false; };
    return true;
}

fn ecs_av_entity_id_deep(a: EcsAVEntityDeep) -> i32 { return a.id; }
fn ecs_av_entity_gen_deep(a: EcsAVEntityDeep) -> i32 { return a.generation; }
fn ecs_av_entity_new(id: i32, generation: i32) -> EcsAVEntityDeep {
    return EcsAVEntityDeep { id: id, generation: generation };
}

// ── Concrete typed plugs (mirror the shallow ArchetypeValueData / Time / Event). ─────────────
struct EcsAVDataDeep { amount: i32 }
struct EcsAVTimeDeep { tick: i32 }
struct EcsAVEventDeep { amount: i32 }

fn ecs_av_data_deep_new(amount: i32) -> EcsAVDataDeep { return EcsAVDataDeep { amount: amount }; }
fn ecs_av_data_deep_amount(r: EcsAVDataDeep) -> i32 { return r.amount; }
fn ecs_av_time_deep_new(tick: i32) -> EcsAVTimeDeep { return EcsAVTimeDeep { tick: tick }; }
fn ecs_av_time_deep_tick(r: EcsAVTimeDeep) -> i32 { return r.tick; }
fn ecs_av_event_deep_new(amount: i32) -> EcsAVEventDeep { return EcsAVEventDeep { amount: amount }; }
fn ecs_av_event_deep_amount(r: EcsAVEventDeep) -> i32 { return r.amount; }
struct EcsAVResDeep { value: i32, added_tick: i32, changed_tick: i32 }
struct EcsAVResMutDeep { value: i32, added_tick: i32, changed_tick: i32 }


// ── ComponentInfo { id } wrapper. ───────────────────────────────────────────────────────────
struct EcsAVCompInfoDeep { id: i32 }
fn ecs_av_comp_info_id_deep(r: EcsAVCompInfoDeep) -> i32 { return r.id; }
fn ecs_av_comp_info_new(id: i32) -> EcsAVCompInfoDeep { return EcsAVCompInfoDeep { id: id }; }

// ── Register wrapper { world, info }. ───────────────────────────────────────────────────────
struct EcsAVRegisterDeep { world: EcsAVWorldDeep, info: EcsAVCompInfoDeep }
fn ecs_av_register_world_deep(r: EcsAVRegisterDeep) -> EcsAVWorldDeep { return r.world; }
fn ecs_av_register_info_deep(r: EcsAVRegisterDeep) -> EcsAVCompInfoDeep { return r.info; }

// ── Spawn wrapper { world, entity }. ─────────────────────────────────────────────────────────
struct EcsAVSpawnDeep { world: EcsAVWorldDeep, entity: EcsAVEntityDeep }
fn ecs_av_spawn_world_deep(r: EcsAVSpawnDeep) -> EcsAVWorldDeep { return r.world; }
fn ecs_av_spawn_entity_deep(r: EcsAVSpawnDeep) -> EcsAVEntityDeep { return r.entity; }

// ── Per-archetype storage: cap-4 component columns x cap-4 entity rows of typed values, plus
//    `present_mask` per column (i32 bitmask over rows), `row_count`, and a per-row entity id.
//    `vals0..15` / `added_t0..15` / `changed_t0..15` are flat col*4+row indexed.
struct EcsAVArchDeep {
    id: i32,
    used: i32,
    kind_v: i32,
    comp_count: i32,
    comp_id0: i32, comp_id1: i32, comp_id2: i32, comp_id3: i32,
    present0: i32, present1: i32, present2: i32, present3: i32,
    row_count: i32,
    eid0: i32, eid1: i32, eid2: i32, eid3: i32,
    vals0: i32, vals1: i32, vals2: i32, vals3: i32, vals4: i32, vals5: i32, vals6: i32, vals7: i32,
    vals8: i32, vals9: i32, vals10: i32, vals11: i32, vals12: i32, vals13: i32, vals14: i32, vals15: i32,
    added_t0: i32, added_t1: i32, added_t2: i32, added_t3: i32, added_t4: i32, added_t5: i32, added_t6: i32, added_t7: i32,
    added_t8: i32, added_t9: i32, added_t10: i32, added_t11: i32, added_t12: i32, added_t13: i32, added_t14: i32, added_t15: i32,
    changed_t0: i32, changed_t1: i32, changed_t2: i32, changed_t3: i32, changed_t4: i32, changed_t5: i32, changed_t6: i32, changed_t7: i32,
    changed_t8: i32, changed_t9: i32, changed_t10: i32, changed_t11: i32, changed_t12: i32, changed_t13: i32, changed_t14: i32, changed_t15: i32
}

fn _ecs_av_arch_empty(id: i32, kind_v: i32) -> EcsAVArchDeep {
    return EcsAVArchDeep {
        id: id, used: 0, kind_v: kind_v, comp_count: 0,
        comp_id0: -1, comp_id1: -1, comp_id2: -1, comp_id3: -1,
        present0: 0, present1: 0, present2: 0, present3: 0,
        row_count: 0,
        eid0: -1, eid1: -1, eid2: -1, eid3: -1,
        vals0: 0, vals1: 0, vals2: 0, vals3: 0, vals4: 0, vals5: 0, vals6: 0, vals7: 0,
        vals8: 0, vals9: 0, vals10: 0, vals11: 0, vals12: 0, vals13: 0, vals14: 0, vals15: 0,
        added_t0: ECS_AV_TICK_NONE, added_t1: ECS_AV_TICK_NONE, added_t2: ECS_AV_TICK_NONE, added_t3: ECS_AV_TICK_NONE, added_t4: ECS_AV_TICK_NONE, added_t5: ECS_AV_TICK_NONE, added_t6: ECS_AV_TICK_NONE, added_t7: ECS_AV_TICK_NONE,
        added_t8: ECS_AV_TICK_NONE, added_t9: ECS_AV_TICK_NONE, added_t10: ECS_AV_TICK_NONE, added_t11: ECS_AV_TICK_NONE, added_t12: ECS_AV_TICK_NONE, added_t13: ECS_AV_TICK_NONE, added_t14: ECS_AV_TICK_NONE, added_t15: ECS_AV_TICK_NONE,
        changed_t0: ECS_AV_TICK_NONE, changed_t1: ECS_AV_TICK_NONE, changed_t2: ECS_AV_TICK_NONE, changed_t3: ECS_AV_TICK_NONE, changed_t4: ECS_AV_TICK_NONE, changed_t5: ECS_AV_TICK_NONE, changed_t6: ECS_AV_TICK_NONE, changed_t7: ECS_AV_TICK_NONE,
        changed_t8: ECS_AV_TICK_NONE, changed_t9: ECS_AV_TICK_NONE, changed_t10: ECS_AV_TICK_NONE, changed_t11: ECS_AV_TICK_NONE, changed_t12: ECS_AV_TICK_NONE, changed_t13: ECS_AV_TICK_NONE, changed_t14: ECS_AV_TICK_NONE, changed_t15: ECS_AV_TICK_NONE
    };
}

// ── Per-archetype slot helpers (4-case cascade-of-return). ──────────────────────────────────
fn _ecs_av_arch_comp_id_at(a: EcsAVArchDeep, col: i32) -> i32 {
    if col == 0 { return a.comp_id0; };
    if col == 1 { return a.comp_id1; };
    if col == 2 { return a.comp_id2; };
    return a.comp_id3;
}

fn _ecs_av_arch_set_comp_id(a0: EcsAVArchDeep, col: i32, value: i32) -> EcsAVArchDeep {
    if col == 0 { a0.comp_id0 = value; return a0; };
    if col == 1 { a0.comp_id1 = value; return a0; };
    if col == 2 { a0.comp_id2 = value; return a0; };
    a0.comp_id3 = value;
    return a0;
}

fn _ecs_av_arch_present_at(a: EcsAVArchDeep, col: i32) -> i32 {
    if col == 0 { return a.present0; };
    if col == 1 { return a.present1; };
    if col == 2 { return a.present2; };
    return a.present3;
}

fn _ecs_av_arch_set_present(a0: EcsAVArchDeep, col: i32, value: i32) -> EcsAVArchDeep {
    if col == 0 { a0.present0 = value; return a0; };
    if col == 1 { a0.present1 = value; return a0; };
    if col == 2 { a0.present2 = value; return a0; };
    a0.present3 = value;
    return a0;
}

fn _ecs_av_arch_eid_at(a: EcsAVArchDeep, row: i32) -> i32 {
    if row == 0 { return a.eid0; };
    if row == 1 { return a.eid1; };
    if row == 2 { return a.eid2; };
    return a.eid3;
}

fn _ecs_av_arch_set_eid(a0: EcsAVArchDeep, row: i32, value: i32) -> EcsAVArchDeep {
    if row == 0 { a0.eid0 = value; return a0; };
    if row == 1 { a0.eid1 = value; return a0; };
    if row == 2 { a0.eid2 = value; return a0; };
    a0.eid3 = value;
    return a0;
}

fn _ecs_av_arch_val_at(a: EcsAVArchDeep, slot: i32) -> i32 {
    if slot == 0 { return a.vals0; };
    if slot == 1 { return a.vals1; };
    if slot == 2 { return a.vals2; };
    if slot == 3 { return a.vals3; };
    if slot == 4 { return a.vals4; };
    if slot == 5 { return a.vals5; };
    if slot == 6 { return a.vals6; };
    if slot == 7 { return a.vals7; };
    if slot == 8 { return a.vals8; };
    if slot == 9 { return a.vals9; };
    if slot == 10 { return a.vals10; };
    if slot == 11 { return a.vals11; };
    if slot == 12 { return a.vals12; };
    if slot == 13 { return a.vals13; };
    if slot == 14 { return a.vals14; };
    return a.vals15;
}

fn _ecs_av_arch_set_val(a0: EcsAVArchDeep, slot: i32, value: i32) -> EcsAVArchDeep {
    if slot == 0 { a0.vals0 = value; return a0; };
    if slot == 1 { a0.vals1 = value; return a0; };
    if slot == 2 { a0.vals2 = value; return a0; };
    if slot == 3 { a0.vals3 = value; return a0; };
    if slot == 4 { a0.vals4 = value; return a0; };
    if slot == 5 { a0.vals5 = value; return a0; };
    if slot == 6 { a0.vals6 = value; return a0; };
    if slot == 7 { a0.vals7 = value; return a0; };
    if slot == 8 { a0.vals8 = value; return a0; };
    if slot == 9 { a0.vals9 = value; return a0; };
    if slot == 10 { a0.vals10 = value; return a0; };
    if slot == 11 { a0.vals11 = value; return a0; };
    if slot == 12 { a0.vals12 = value; return a0; };
    if slot == 13 { a0.vals13 = value; return a0; };
    if slot == 14 { a0.vals14 = value; return a0; };
    a0.vals15 = value;
    return a0;
}

fn _ecs_av_arch_added_at(a: EcsAVArchDeep, slot: i32) -> i32 {
    if slot == 0 { return a.added_t0; };
    if slot == 1 { return a.added_t1; };
    if slot == 2 { return a.added_t2; };
    if slot == 3 { return a.added_t3; };
    if slot == 4 { return a.added_t4; };
    if slot == 5 { return a.added_t5; };
    if slot == 6 { return a.added_t6; };
    if slot == 7 { return a.added_t7; };
