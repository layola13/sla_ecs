// Deepened Bevy ECS query Access / FilteredAccess surface.
// Mirrors src/query/access.rs core:
//   Access read/write/archetypal sets, inverted flags,
//   is_compatible, get_conflicts first id,
//   FilteredAccess with/without filters + required.
// Shallow lib/query_access.sla retained.
// Fixed capacity: 4 reads, 4 writes, 4 archetypal, 4 with, 4 without.

struct EcsAccessDeep {
    read_len: i32,
    r0: i32, r1: i32, r2: i32, r3: i32,
    write_len: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    arch_len: i32,
    a0: i32, a1: i32, a2: i32, a3: i32,
    reads_inverted: bool,
    writes_inverted: bool,
}

fn ecs_access_deep_new() -> EcsAccessDeep {
    return EcsAccessDeep {
        read_len: 0, r0: -1, r1: -1, r2: -1, r3: -1,
        write_len: 0, w0: -1, w1: -1, w2: -1, w3: -1,
        arch_len: 0, a0: -1, a1: -1, a2: -1, a3: -1,
        reads_inverted: false, writes_inverted: false,
    };
}

fn ecs_access_deep_read_len(a: EcsAccessDeep) -> i32 { return a.read_len; }
fn ecs_access_deep_write_len(a: EcsAccessDeep) -> i32 { return a.write_len; }
fn ecs_access_deep_arch_len(a: EcsAccessDeep) -> i32 { return a.arch_len; }
fn ecs_access_deep_reads_inverted(a: EcsAccessDeep) -> bool { return a.reads_inverted; }
fn ecs_access_deep_writes_inverted(a: EcsAccessDeep) -> bool { return a.writes_inverted; }

fn ecs_access_deep_has_read(a: EcsAccessDeep, id: i32) -> bool {
    if a.read_len >= 1 { if a.r0 == id { return true; }; };
    if a.read_len >= 2 { if a.r1 == id { return true; }; };
    if a.read_len >= 3 { if a.r2 == id { return true; }; };
    if a.read_len >= 4 { if a.r3 == id { return true; }; };
    return false;
}
fn ecs_access_deep_has_write(a: EcsAccessDeep, id: i32) -> bool {
    if a.write_len >= 1 { if a.w0 == id { return true; }; };
    if a.write_len >= 2 { if a.w1 == id { return true; }; };
    if a.write_len >= 3 { if a.w2 == id { return true; }; };
    if a.write_len >= 4 { if a.w3 == id { return true; }; };
    return false;
}

fn ecs_access_deep_add_read(a: EcsAccessDeep, id: i32) -> EcsAccessDeep {
    if ecs_access_deep_has_read(a, id) { return a; };
    if a.read_len >= 4 { return a; };
    if a.read_len == 0 {
        return EcsAccessDeep {
            read_len: 1, r0: id, r1: a.r1, r2: a.r2, r3: a.r3,
            write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
            arch_len: a.arch_len, a0: a.a0, a1: a.a1, a2: a.a2, a3: a.a3,
            reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
        };
    };
    if a.read_len == 1 {
        return EcsAccessDeep {
            read_len: 2, r0: a.r0, r1: id, r2: a.r2, r3: a.r3,
            write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
            arch_len: a.arch_len, a0: a.a0, a1: a.a1, a2: a.a2, a3: a.a3,
            reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
        };
    };
    if a.read_len == 2 {
        return EcsAccessDeep {
            read_len: 3, r0: a.r0, r1: a.r1, r2: id, r3: a.r3,
            write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
            arch_len: a.arch_len, a0: a.a0, a1: a.a1, a2: a.a2, a3: a.a3,
            reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
        };
    };
    return EcsAccessDeep {
        read_len: 4, r0: a.r0, r1: a.r1, r2: a.r2, r3: id,
        write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
        arch_len: a.arch_len, a0: a.a0, a1: a.a1, a2: a.a2, a3: a.a3,
        reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
    };
}

fn ecs_access_deep_add_write(a: EcsAccessDeep, id: i32) -> EcsAccessDeep {
    // write implies read
    let base = ecs_access_deep_add_read(a, id);
    if ecs_access_deep_has_write(base, id) { return base; };
    if base.write_len >= 4 { return base; };
    if base.write_len == 0 {
        return EcsAccessDeep {
            read_len: base.read_len, r0: base.r0, r1: base.r1, r2: base.r2, r3: base.r3,
            write_len: 1, w0: id, w1: base.w1, w2: base.w2, w3: base.w3,
            arch_len: base.arch_len, a0: base.a0, a1: base.a1, a2: base.a2, a3: base.a3,
            reads_inverted: base.reads_inverted, writes_inverted: base.writes_inverted,
        };
    };
    if base.write_len == 1 {
        return EcsAccessDeep {
            read_len: base.read_len, r0: base.r0, r1: base.r1, r2: base.r2, r3: base.r3,
            write_len: 2, w0: base.w0, w1: id, w2: base.w2, w3: base.w3,
            arch_len: base.arch_len, a0: base.a0, a1: base.a1, a2: base.a2, a3: base.a3,
            reads_inverted: base.reads_inverted, writes_inverted: base.writes_inverted,
        };
    };
    if base.write_len == 2 {
        return EcsAccessDeep {
            read_len: base.read_len, r0: base.r0, r1: base.r1, r2: base.r2, r3: base.r3,
            write_len: 3, w0: base.w0, w1: base.w1, w2: id, w3: base.w3,
            arch_len: base.arch_len, a0: base.a0, a1: base.a1, a2: base.a2, a3: base.a3,
            reads_inverted: base.reads_inverted, writes_inverted: base.writes_inverted,
        };
    };
    return EcsAccessDeep {
        read_len: base.read_len, r0: base.r0, r1: base.r1, r2: base.r2, r3: base.r3,
        write_len: 4, w0: base.w0, w1: base.w1, w2: base.w2, w3: id,
        arch_len: base.arch_len, a0: base.a0, a1: base.a1, a2: base.a2, a3: base.a3,
        reads_inverted: base.reads_inverted, writes_inverted: base.writes_inverted,
    };
}

fn ecs_access_deep_add_archetypal(a: EcsAccessDeep, id: i32) -> EcsAccessDeep {
    if a.arch_len >= 1 { if a.a0 == id { return a; }; };
    if a.arch_len >= 2 { if a.a1 == id { return a; }; };
    if a.arch_len >= 3 { if a.a2 == id { return a; }; };
    if a.arch_len >= 4 { if a.a3 == id { return a; }; };
    if a.arch_len >= 4 { return a; };
    if a.arch_len == 0 {
        return EcsAccessDeep {
            read_len: a.read_len, r0: a.r0, r1: a.r1, r2: a.r2, r3: a.r3,
            write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
            arch_len: 1, a0: id, a1: a.a1, a2: a.a2, a3: a.a3,
            reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
        };
    };
    if a.arch_len == 1 {
        return EcsAccessDeep {
            read_len: a.read_len, r0: a.r0, r1: a.r1, r2: a.r2, r3: a.r3,
            write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
            arch_len: 2, a0: a.a0, a1: id, a2: a.a2, a3: a.a3,
            reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
        };
    };
    if a.arch_len == 2 {
        return EcsAccessDeep {
            read_len: a.read_len, r0: a.r0, r1: a.r1, r2: a.r2, r3: a.r3,
            write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
            arch_len: 3, a0: a.a0, a1: a.a1, a2: id, a3: a.a3,
            reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
        };
    };
    return EcsAccessDeep {
        read_len: a.read_len, r0: a.r0, r1: a.r1, r2: a.r2, r3: a.r3,
        write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
        arch_len: 4, a0: a.a0, a1: a.a1, a2: a.a2, a3: id,
        reads_inverted: a.reads_inverted, writes_inverted: a.writes_inverted,
    };
}

fn ecs_access_deep_set_reads_all(a: EcsAccessDeep) -> EcsAccessDeep {
    return EcsAccessDeep {
        read_len: a.read_len, r0: a.r0, r1: a.r1, r2: a.r2, r3: a.r3,
        write_len: a.write_len, w0: a.w0, w1: a.w1, w2: a.w2, w3: a.w3,
        arch_len: a.arch_len, a0: a.a0, a1: a.a1, a2: a.a2, a3: a.a3,
        reads_inverted: true, writes_inverted: a.writes_inverted,
    };
}

// Compatible if neither writes something the other reads/writes (non-inverted model).
fn ecs_access_deep_is_compatible(a: EcsAccessDeep, b: EcsAccessDeep) -> bool {
    // a writes vs b reads
    if a.write_len >= 1 { if ecs_access_deep_has_read(b, a.w0) { return false; }; };
    if a.write_len >= 2 { if ecs_access_deep_has_read(b, a.w1) { return false; }; };
    if a.write_len >= 3 { if ecs_access_deep_has_read(b, a.w2) { return false; }; };
    if a.write_len >= 4 { if ecs_access_deep_has_read(b, a.w3) { return false; }; };
    // b writes vs a reads
    if b.write_len >= 1 { if ecs_access_deep_has_read(a, b.w0) { return false; }; };
    if b.write_len >= 2 { if ecs_access_deep_has_read(a, b.w1) { return false; }; };
    if b.write_len >= 3 { if ecs_access_deep_has_read(a, b.w2) { return false; }; };
    if b.write_len >= 4 { if ecs_access_deep_has_read(a, b.w3) { return false; }; };
    // inverted reads-all conflicts with any write in other
    if a.reads_inverted {
        if b.write_len > 0 { return false; };
    };
    if b.reads_inverted {
        if a.write_len > 0 { return false; };
    };
    return true;
}

struct EcsAccessConflictDeep {
    has: bool,
    component_id: i32,
}
fn ecs_access_conflict_has(c: EcsAccessConflictDeep) -> bool { return c.has; }
fn ecs_access_conflict_id(c: EcsAccessConflictDeep) -> i32 { return c.component_id; }

fn ecs_access_deep_get_conflicts(a: EcsAccessDeep, b: EcsAccessDeep) -> EcsAccessConflictDeep {
    if a.write_len >= 1 { if ecs_access_deep_has_read(b, a.w0) {
        return EcsAccessConflictDeep { has: true, component_id: a.w0 };
    }; };
    if a.write_len >= 2 { if ecs_access_deep_has_read(b, a.w1) {
        return EcsAccessConflictDeep { has: true, component_id: a.w1 };
    }; };
    if a.write_len >= 3 { if ecs_access_deep_has_read(b, a.w2) {
        return EcsAccessConflictDeep { has: true, component_id: a.w2 };
    }; };
    if a.write_len >= 4 { if ecs_access_deep_has_read(b, a.w3) {
        return EcsAccessConflictDeep { has: true, component_id: a.w3 };
    }; };
    if b.write_len >= 1 { if ecs_access_deep_has_read(a, b.w0) {
        return EcsAccessConflictDeep { has: true, component_id: b.w0 };
    }; };
    if b.write_len >= 2 { if ecs_access_deep_has_read(a, b.w1) {
        return EcsAccessConflictDeep { has: true, component_id: b.w1 };
    }; };
    if b.write_len >= 3 { if ecs_access_deep_has_read(a, b.w2) {
        return EcsAccessConflictDeep { has: true, component_id: b.w2 };
    }; };
    if b.write_len >= 4 { if ecs_access_deep_has_read(a, b.w3) {
        return EcsAccessConflictDeep { has: true, component_id: b.w3 };
    }; };
    return EcsAccessConflictDeep { has: false, component_id: -1 };
}

// FilteredAccess = Access + with/without filters
struct EcsFilteredAccessDeep {
    access: EcsAccessDeep,
    with_len: i32,
    f0: i32, f1: i32, f2: i32, f3: i32,
    without_len: i32,
    n0: i32, n1: i32, n2: i32, n3: i32,
}

fn ecs_fa_deep_new() -> EcsFilteredAccessDeep {
    return EcsFilteredAccessDeep {
        access: ecs_access_deep_new(),
        with_len: 0, f0: -1, f1: -1, f2: -1, f3: -1,
        without_len: 0, n0: -1, n1: -1, n2: -1, n3: -1,
    };
}

fn ecs_fa_deep_access(f: EcsFilteredAccessDeep) -> EcsAccessDeep { return f.access; }
fn ecs_fa_deep_with_len(f: EcsFilteredAccessDeep) -> i32 { return f.with_len; }
fn ecs_fa_deep_without_len(f: EcsFilteredAccessDeep) -> i32 { return f.without_len; }

fn ecs_fa_deep_add_read(f: EcsFilteredAccessDeep, id: i32) -> EcsFilteredAccessDeep {
    return EcsFilteredAccessDeep {
        access: ecs_access_deep_add_read(f.access, id),
        with_len: f.with_len, f0: f.f0, f1: f.f1, f2: f.f2, f3: f.f3,
        without_len: f.without_len, n0: f.n0, n1: f.n1, n2: f.n2, n3: f.n3,
    };
}
fn ecs_fa_deep_add_write(f: EcsFilteredAccessDeep, id: i32) -> EcsFilteredAccessDeep {
    return EcsFilteredAccessDeep {
        access: ecs_access_deep_add_write(f.access, id),
        with_len: f.with_len, f0: f.f0, f1: f.f1, f2: f.f2, f3: f.f3,
        without_len: f.without_len, n0: f.n0, n1: f.n1, n2: f.n2, n3: f.n3,
    };
}

fn ecs_fa_deep_and_with(f: EcsFilteredAccessDeep, id: i32) -> EcsFilteredAccessDeep {
    if f.with_len >= 4 { return f; };
    if f.with_len == 0 {
        return EcsFilteredAccessDeep {
            access: f.access, with_len: 1, f0: id, f1: f.f1, f2: f.f2, f3: f.f3,
            without_len: f.without_len, n0: f.n0, n1: f.n1, n2: f.n2, n3: f.n3,
        };
    };
    if f.with_len == 1 {
        return EcsFilteredAccessDeep {
            access: f.access, with_len: 2, f0: f.f0, f1: id, f2: f.f2, f3: f.f3,
            without_len: f.without_len, n0: f.n0, n1: f.n1, n2: f.n2, n3: f.n3,
        };
    };
    if f.with_len == 2 {
        return EcsFilteredAccessDeep {
            access: f.access, with_len: 3, f0: f.f0, f1: f.f1, f2: id, f3: f.f3,
            without_len: f.without_len, n0: f.n0, n1: f.n1, n2: f.n2, n3: f.n3,
        };
    };
    return EcsFilteredAccessDeep {
        access: f.access, with_len: 4, f0: f.f0, f1: f.f1, f2: f.f2, f3: id,
        without_len: f.without_len, n0: f.n0, n1: f.n1, n2: f.n2, n3: f.n3,
    };
}

fn ecs_fa_deep_and_without(f: EcsFilteredAccessDeep, id: i32) -> EcsFilteredAccessDeep {
    if f.without_len >= 4 { return f; };
    if f.without_len == 0 {
        return EcsFilteredAccessDeep {
            access: f.access, with_len: f.with_len, f0: f.f0, f1: f.f1, f2: f.f2, f3: f.f3,
            without_len: 1, n0: id, n1: f.n1, n2: f.n2, n3: f.n3,
        };
    };
    if f.without_len == 1 {
        return EcsFilteredAccessDeep {
            access: f.access, with_len: f.with_len, f0: f.f0, f1: f.f1, f2: f.f2, f3: f.f3,
            without_len: 2, n0: f.n0, n1: id, n2: f.n2, n3: f.n3,
        };
    };
    if f.without_len == 2 {
        return EcsFilteredAccessDeep {
            access: f.access, with_len: f.with_len, f0: f.f0, f1: f.f1, f2: f.f2, f3: f.f3,
            without_len: 3, n0: f.n0, n1: f.n1, n2: id, n3: f.n3,
        };
    };
    return EcsFilteredAccessDeep {
        access: f.access, with_len: f.with_len, f0: f.f0, f1: f.f1, f2: f.f2, f3: f.f3,
        without_len: 4, n0: f.n0, n1: f.n1, n2: f.n2, n3: id,
    };
}

// FilteredAccess compatibility: access compatible AND filters not disjoint-impossible.
// Bevy can allow conflicting access if filters make them disjoint; model:
// if A with X and B without X, they are disjoint => compatible even if access conflicts.
fn ecs_fa_deep_filters_disjoint(a: EcsFilteredAccessDeep, b: EcsFilteredAccessDeep) -> bool {
    // a with vs b without
    if a.with_len >= 1 {
        if b.without_len >= 1 { if a.f0 == b.n0 { return true; }; };
        if b.without_len >= 2 { if a.f0 == b.n1 { return true; }; };
        if b.without_len >= 3 { if a.f0 == b.n2 { return true; }; };
        if b.without_len >= 4 { if a.f0 == b.n3 { return true; }; };
    };
    // b with vs a without
    if b.with_len >= 1 {
        if a.without_len >= 1 { if b.f0 == a.n0 { return true; }; };
        if a.without_len >= 2 { if b.f0 == a.n1 { return true; }; };
        if a.without_len >= 3 { if b.f0 == a.n2 { return true; }; };
        if a.without_len >= 4 { if b.f0 == a.n3 { return true; }; };
    };
    return false;
}

fn ecs_fa_deep_is_compatible(a: EcsFilteredAccessDeep, b: EcsFilteredAccessDeep) -> bool {
    if ecs_fa_deep_filters_disjoint(a, b) { return true; };
    return ecs_access_deep_is_compatible(a.access, b.access);
}
