// Bevy ECS never.rs parity.
// SLA does not currently expose a true uninhabited type, so this module models
// Never as an opaque marker facade with no public constructor helpers.

struct EcsNever {}

fn ecs_never_type_id() -> i64 {
    return 78001;
}

fn ecs_never_is_uninhabited() -> bool {
    return true;
}

fn ecs_never_can_construct() -> bool {
    return false;
}

fn ecs_never_debug_name_id() -> i64 {
    return ecs_never_type_id();
}

fn ecs_never_absurd_i32(n: EcsNever) -> i32 {
    let _unused = n;
    panic(78010);
    return 0;
}

fn ecs_never_absurd_bool(n: EcsNever) -> bool {
    let _unused = n;
    panic(78011);
    return false;
}

@test "never facade metadata"() {
    if ecs_never_type_id() != 78001 { panic(78021); };
    if ecs_never_debug_name_id() != ecs_never_type_id() { panic(78022); };
}

@test "never facade is uninhabited marker"() {
    if ecs_never_is_uninhabited() != true { panic(78023); };
    if ecs_never_can_construct() != false { panic(78024); };
}
