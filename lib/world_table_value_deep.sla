// Deep bed for lib/world_table_value.sla (Batch 386).
// Mirrors shallow `lib/world_table_value.sla`'s `TableValueWorld<T, R, M>` as a SELF-CONTAINED
// fixed-cap variant (no @import) using concrete typed columns based on `TableValueData { amount }`,
// `TableValueTime { tick }` (resource), `TableValueEvent { amount }` (message).  Storage is archetype-
// grouped: each archetype carries cap-4 component columns x cap-4 entity rows of typed values, and
// each entity has a (archetype_id, row) location.  Inserting/removing a component migrates the entity
// between archetypes, preserving its existing values from the old archetype and adding the new
// component's value.  Mirrors Bevy's archetype-table storage where entity moves on component change.
//
// Storage layout: cap-4 archetypes, cap-4 component ids per archetype, cap-4 entity rows per
// archetype, cap-8 entity ids overall.  Per-archetype value array is flat 4*4 = 16 i32 slots
// (indexed by col*4 + row).  present_mask per column (i32 bitmask over rows).  Per-archetype
// `added_t0..15` and `changed_t0..15` likewise flat cap-16 indexed col*4 + row.  Resource slot +
// message slot + monotone change_tick.  Wrapper structs expose scalar accessors (no tuple-return
// destructuring in tests).

const ECS_TV_CAP_ARCH: i32 = 4;
const ECS_TV_CAP_COMPONENTS_PER_ARCH: i32 = 4;
const ECS_TV_CAP_ROWS_PER_ARCH: i32 = 4;
const ECS_TV_CAP_ENTITIES: i32 = 8;
const ECS_TV_TICK_NONE: i32 = 999999;

struct EcsTVEntityDeep { id: i32, generation: i32 }

fn ecs_tv_entity_eq_deep(a: EcsTVEntityDeep, b: EcsTVEntityDeep) -> bool {
    if a.id != b.id { return false; };
    if a.generation != b.generation { return false; };
    return true;
}

fn ecs_tv_entity_id_deep(a: EcsTVEntityDeep) -> i32 { return a.id; }
fn ecs_tv_entity_gen_deep(a: EcsTVEntityDeep) -> i32 { return a.generation; }
fn ecs_tv_entity_new(id: i32, generation: i32) -> EcsTVEntityDeep {
    return EcsTVEntityDeep { id: id, generation: generation };
}

// ── Concrete typed plugs (mirror the shallow's TableValueData / Time / Event). ────────────────
struct EcsTVDataDeep { amount: i32 }
struct EcsTVTimeDeep { tick: i32 }
struct EcsTVEventDeep { amount: i32 }

fn ecs_tv_data_deep_new(amount: i32) -> EcsTVDataDeep { return EcsTVDataDeep { amount: amount }; }
fn ecs_tv_data_deep_amount(r: EcsTVDataDeep) -> i32 { return r.amount; }
fn ecs_tv_time_deep_new(tick: i32) -> EcsTVTimeDeep { return EcsTVTimeDeep { tick: tick }; }
fn ecs_tv_time_deep_tick(r: EcsTVTimeDeep) -> i32 { return r.tick; }
fn ecs_tv_event_deep_new(amount: i32) -> EcsTVEventDeep { return EcsTVEventDeep { amount: amount }; }
fn ecs_tv_event_deep_amount(r: EcsTVEventDeep) -> i32 { return r.amount; }

// ── ComponentInfo { id } wrapper (mirrors shallow ComponentInfo). ────────────────────────────
struct EcsTVCompInfoDeep { id: i32 }
fn ecs_tv_comp_info_id_deep(r: EcsTVCompInfoDeep) -> i32 { return r.id; }
fn ecs_tv_comp_info_new(id: i32) -> EcsTVCompInfoDeep { return EcsTVCompInfoDeep { id: id }; }

// ── Register wrapper { world, info }. ────────────────────────────────────────────────────────
struct EcsTVRegisterDeep { world: EcsTVWorldDeep, info: EcsTVCompInfoDeep }
fn ecs_tv_register_world_deep(r: EcsTVRegisterDeep) -> EcsTVWorldDeep { return r.world; }
fn ecs_tv_register_info_deep(r: EcsTVRegisterDeep) -> EcsTVCompInfoDeep { return r.info; }

// ── Spawn wrapper { world, entity }. ────────────────────────────────────────────────────────
struct EcsTVSpawnDeep { world: EcsTVWorldDeep, entity: EcsTVEntityDeep }
fn ecs_tv_spawn_world_deep(r: EcsTVSpawnDeep) -> EcsTVWorldDeep { return r.world; }
fn ecs_tv_spawn_entity_deep(r: EcsTVSpawnDeep) -> EcsTVEntityDeep { return r.entity; }

// ── Per-archetype storage: cap-4 component columns x cap-4 entity rows of typed values, plus
//    present_mask per column (i32 bitmask over rows), row_count, and a per-row entity id. The value
//    arrays `vals0..15` / `added_t0..15` / `changed_t0..15` are flat col*4+row indexed.
struct EcsTVArchDeep {
    id: i32,
    used: i32,
    comp_count: i32,
    comp_id0: i32, comp_id1: i32, comp_id2: i32, comp_id3: i32,
    present0: i32, present1: i32, present2: i32, present3: i32,
    row_count: i32,
    eid0: i32, eid1: i32, eid2: i32, eid3: i32,
    // Per-(col,row) typed value cap-16 (4 cols x 4 rows). Indexed col*4 + row.
    vals0: i32, vals1: i32, vals2: i32, vals3: i32, vals4: i32, vals5: i32, vals6: i32, vals7: i32,
    vals8: i32, vals9: i32, vals10: i32, vals11: i32, vals12: i32, vals13: i32, vals14: i32, vals15: i32,
    added_t0: i32, added_t1: i32, added_t2: i32, added_t3: i32, added_t4: i32, added_t5: i32, added_t6: i32, added_t7: i32,
    added_t8: i32, added_t9: i32, added_t10: i32, added_t11: i32, added_t12: i32, added_t13: i32, added_t14: i32, added_t15: i32,
    changed_t0: i32, changed_t1: i32, changed_t2: i32, changed_t3: i32, changed_t4: i32, changed_t5: i32, changed_t6: i32, changed_t7: i32,
    changed_t8: i32, changed_t9: i32, changed_t10: i32, changed_t11: i32, changed_t12: i32, changed_t13: i32, changed_t14: i32, changed_t15: i32
}

fn _ecs_tv_arch_empty(id: i32) -> EcsTVArchDeep {
    return EcsTVArchDeep {
        id: id, used: 0, comp_count: 0,
        comp_id0: -1, comp_id1: -1, comp_id2: -1, comp_id3: -1,
        present0: 0, present1: 0, present2: 0, present3: 0,
        row_count: 0,
        eid0: -1, eid1: -1, eid2: -1, eid3: -1,
        vals0: 0, vals1: 0, vals2: 0, vals3: 0, vals4: 0, vals5: 0, vals6: 0, vals7: 0,
        vals8: 0, vals9: 0, vals10: 0, vals11: 0, vals12: 0, vals13: 0, vals14: 0, vals15: 0,
        added_t0: ECS_TV_TICK_NONE, added_t1: ECS_TV_TICK_NONE, added_t2: ECS_TV_TICK_NONE, added_t3: ECS_TV_TICK_NONE, added_t4: ECS_TV_TICK_NONE, added_t5: ECS_TV_TICK_NONE, added_t6: ECS_TV_TICK_NONE, added_t7: ECS_TV_TICK_NONE,
        added_t8: ECS_TV_TICK_NONE, added_t9: ECS_TV_TICK_NONE, added_t10: ECS_TV_TICK_NONE, added_t11: ECS_TV_TICK_NONE, added_t12: ECS_TV_TICK_NONE, added_t13: ECS_TV_TICK_NONE, added_t14: ECS_TV_TICK_NONE, added_t15: ECS_TV_TICK_NONE,
        changed_t0: ECS_TV_TICK_NONE, changed_t1: ECS_TV_TICK_NONE, changed_t2: ECS_TV_TICK_NONE, changed_t3: ECS_TV_TICK_NONE, changed_t4: ECS_TV_TICK_NONE, changed_t5: ECS_TV_TICK_NONE, changed_t6: ECS_TV_TICK_NONE, changed_t7: ECS_TV_TICK_NONE,
        changed_t8: ECS_TV_TICK_NONE, changed_t9: ECS_TV_TICK_NONE, changed_t10: ECS_TV_TICK_NONE, changed_t11: ECS_TV_TICK_NONE, changed_t12: ECS_TV_TICK_NONE, changed_t13: ECS_TV_TICK_NONE, changed_t14: ECS_TV_TICK_NONE, changed_t15: ECS_TV_TICK_NONE
    };
}

// Per-archetype slot helpers (4-case cascade-of-return, well within the SA's expansion budget).
fn _ecs_tv_arch_comp_id_at(a: EcsTVArchDeep, col: i32) -> i32 {
    if col == 0 { return a.comp_id0; };
    if col == 1 { return a.comp_id1; };
    if col == 2 { return a.comp_id2; };
    return a.comp_id3;
}

fn _ecs_tv_arch_set_comp_id(a0: EcsTVArchDeep, col: i32, value: i32) -> EcsTVArchDeep {
    if col == 0 { a0.comp_id0 = value; return a0; };
    if col == 1 { a0.comp_id1 = value; return a0; };
    if col == 2 { a0.comp_id2 = value; return a0; };
    a0.comp_id3 = value;
    return a0;
}

fn _ecs_tv_arch_present_at(a: EcsTVArchDeep, col: i32) -> i32 {
    if col == 0 { return a.present0; };
    if col == 1 { return a.present1; };
    if col == 2 { return a.present2; };
    return a.present3;
}

fn _ecs_tv_arch_set_present(a0: EcsTVArchDeep, col: i32, value: i32) -> EcsTVArchDeep {
    if col == 0 { a0.present0 = value; return a0; };
    if col == 1 { a0.present1 = value; return a0; };
    if col == 2 { a0.present2 = value; return a0; };
    a0.present3 = value;
    return a0;
}

fn _ecs_tv_arch_eid_at(a: EcsTVArchDeep, row: i32) -> i32 {
    if row == 0 { return a.eid0; };
    if row == 1 { return a.eid1; };
    if row == 2 { return a.eid2; };
    return a.eid3;
}

fn _ecs_tv_arch_set_eid(a0: EcsTVArchDeep, row: i32, value: i32) -> EcsTVArchDeep {
    if row == 0 { a0.eid0 = value; return a0; };
    if row == 1 { a0.eid1 = value; return a0; };
    if row == 2 { a0.eid2 = value; return a0; };
    a0.eid3 = value;
    return a0;
}

// vals0..15 + added_t + changed_t getters/setters are 16-case cascades.  col*4 + row indexing means
// we look up by flat index `slot`. We dispatch on slot 0..15.
fn _ecs_tv_arch_val_at(a: EcsTVArchDeep, slot: i32) -> i32 {
    if slot == 0 { return a.vals0; };
    if slot == 1 { return a.vals1; };
    if slot == 2 { return a.vals2; };
    if slot == 3 { return a.vals3; };
    if slot == 4 { return a.vals4; };
    if slot == 5 { return a.vals5; };
    if slot == 6 { return a.vals6; };
    if slot == 7 { return a.vals7; };
    if slot == 8 { return a.vals8; };
    if slot == 9 { return a.vals9; };
    if slot == 10 { return a.vals10; };
    if slot == 11 { return a.vals11; };
    if slot == 12 { return a.vals12; };
    if slot == 13 { return a.vals13; };
    if slot == 14 { return a.vals14; };
    return a.vals15;
}

fn _ecs_tv_arch_set_val(a0: EcsTVArchDeep, slot: i32, value: i32) -> EcsTVArchDeep {
    if slot == 0 { a0.vals0 = value; return a0; };
    if slot == 1 { a0.vals1 = value; return a0; };
    if slot == 2 { a0.vals2 = value; return a0; };
    if slot == 3 { a0.vals3 = value; return a0; };
    if slot == 4 { a0.vals4 = value; return a0; };
    if slot == 5 { a0.vals5 = value; return a0; };
    if slot == 6 { a0.vals6 = value; return a0; };
    if slot == 7 { a0.vals7 = value; return a0; };
    if slot == 8 { a0.vals8 = value; return a0; };
    if slot == 9 { a0.vals9 = value; return a0; };
    if slot == 10 { a0.vals10 = value; return a0; };
    if slot == 11 { a0.vals11 = value; return a0; };
    if slot == 12 { a0.vals12 = value; return a0; };
    if slot == 13 { a0.vals13 = value; return a0; };
    if slot == 14 { a0.vals14 = value; return a0; };
    a0.vals15 = value;
    return a0;
}

fn _ecs_tv_arch_added_at(a: EcsTVArchDeep, slot: i32) -> i32 {
    if slot == 0 { return a.added_t0; };
    if slot == 1 { return a.added_t1; };
    if slot == 2 { return a.added_t2; };
    if slot == 3 { return a.added_t3; };
    if slot == 4 { return a.added_t4; };
    if slot == 5 { return a.added_t5; };
    if slot == 6 { return a.added_t6; };
    if slot == 7 { return a.added_t7; };
    if slot == 8 { return a.added_t8; };
    if slot == 9 { return a.added_t9; };
    if slot == 10 { return a.added_t10; };
    if slot == 11 { return a.added_t11; };
    if slot == 12 { return a.added_t12; };
    if slot == 13 { return a.added_t13; };
    if slot == 14 { return a.added_t14; };
    return a.added_t15;
}

fn _ecs_tv_arch_set_added(a0: EcsTVArchDeep, slot: i32, value: i32) -> EcsTVArchDeep {
    if slot == 0 { a0.added_t0 = value; return a0; };
    if slot == 1 { a0.added_t1 = value; return a0; };
    if slot == 2 { a0.added_t2 = value; return a0; };
    if slot == 3 { a0.added_t3 = value; return a0; };
    if slot == 4 { a0.added_t4 = value; return a0; };
    if slot == 5 { a0.added_t5 = value; return a0; };
    if slot == 6 { a0.added_t6 = value; return a0; };
    if slot == 7 { a0.added_t7 = value; return a0; };
    if slot == 8 { a0.added_t8 = value; return a0; };
    if slot == 9 { a0.added_t9 = value; return a0; };
    if slot == 10 { a0.added_t10 = value; return a0; };
    if slot == 11 { a0.added_t11 = value; return a0; };
    if slot == 12 { a0.added_t12 = value; return a0; };
    if slot == 13 { a0.added_t13 = value; return a0; };
    if slot == 14 { a0.added_t14 = value; return a0; };
    a0.added_t15 = value;
    return a0;
}

fn _ecs_tv_arch_changed_at(a: EcsTVArchDeep, slot: i32) -> i32 {
    if slot == 0 { return a.changed_t0; };
    if slot == 1 { return a.changed_t1; };
    if slot == 2 { return a.changed_t2; };
    if slot == 3 { return a.changed_t3; };
    if slot == 4 { return a.changed_t4; };
    if slot == 5 { return a.changed_t5; };
    if slot == 6 { return a.changed_t6; };
    if slot == 7 { return a.changed_t7; };
    if slot == 8 { return a.changed_t8; };
    if slot == 9 { return a.changed_t9; };
    if slot == 10 { return a.changed_t10; };
    if slot == 11 { return a.changed_t11; };
    if slot == 12 { return a.changed_t12; };
    if slot == 13 { return a.changed_t13; };
    if slot == 14 { return a.changed_t14; };
    return a.changed_t15;
}

fn _ecs_tv_arch_set_changed(a0: EcsTVArchDeep, slot: i32, value: i32) -> EcsTVArchDeep {
    if slot == 0 { a0.changed_t0 = value; return a0; };
    if slot == 1 { a0.changed_t1 = value; return a0; };
    if slot == 2 { a0.changed_t2 = value; return a0; };
    if slot == 3 { a0.changed_t3 = value; return a0; };
    if slot == 4 { a0.changed_t4 = value; return a0; };
    if slot == 5 { a0.changed_t5 = value; return a0; };
    if slot == 6 { a0.changed_t6 = value; return a0; };
    if slot == 7 { a0.changed_t7 = value; return a0; };
    if slot == 8 { a0.changed_t8 = value; return a0; };
    if slot == 9 { a0.changed_t9 = value; return a0; };
    if slot == 10 { a0.changed_t10 = value; return a0; };
    if slot == 11 { a0.changed_t11 = value; return a0; };
    if slot == 12 { a0.changed_t12 = value; return a0; };
    if slot == 13 { a0.changed_t13 = value; return a0; };
    if slot == 14 { a0.changed_t14 = value; return a0; };
    a0.changed_t15 = value;
    return a0;
}

// ── World: cap-4 archetypes, cap-8 entity registry, cap-4 registered component ids, tick,
//    resource slot, message slot. ────────────────────────────────────────────────────────────
struct EcsTVWorldDeep {
    arch0: EcsTVArchDeep, arch1: EcsTVArchDeep, arch2: EcsTVArchDeep, arch3: EcsTVArchDeep,
    arch_count: i32,
    // cap-8 entity row: gen + alive + (arch_id, row) location.
    gen0: i32, gen1: i32, gen2: i32, gen3: i32, gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32, alive4: i32, alive5: i32, alive6: i32, alive7: i32,
    loc_arch0: i32, loc_arch1: i32, loc_arch2: i32, loc_arch3: i32, loc_arch4: i32, loc_arch5: i32, loc_arch6: i32, loc_arch7: i32,
    loc_row0: i32, loc_row1: i32, loc_row2: i32, loc_row3: i32, loc_row4: i32, loc_row5: i32, loc_row6: i32, loc_row7: i32,
    next_entity: i32, entity_count: i32,
    change_tick: i32,
    comp_count: i32,
    res_time_tick: i32, res_time_set: i32,
    res_added_tick: i32, res_changed_tick: i32,
    msg_event_amount: i32, msg_count: i32
}

fn _ecs_tv_world_arch_zeros() -> EcsTVArchDeep {
    return _ecs_tv_arch_empty(0);
}

fn ecs_tv_world_deep_new() -> EcsTVWorldDeep {
    // Archetype 0 is the empty archetype (inhabited by freshly-spawned entities with no components).
    let a0 = _ecs_tv_arch_empty(0);
    a0.used = 1;
    a0.row_count = 0;
    return EcsTVWorldDeep {
        arch0: a0, arch1: _ecs_tv_arch_empty(1), arch2: _ecs_tv_arch_empty(2), arch3: _ecs_tv_arch_empty(3),
        arch_count: 1,
        gen0: 0, gen1: 0, gen2: 0, gen3: 0, gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        alive0: 0, alive1: 0, alive2: 0, alive3: 0, alive4: 0, alive5: 0, alive6: 0, alive7: 0,
        loc_arch0: -1, loc_arch1: -1, loc_arch2: -1, loc_arch3: -1, loc_arch4: -1, loc_arch5: -1, loc_arch6: -1, loc_arch7: -1,
        loc_row0: -1, loc_row1: -1, loc_row2: -1, loc_row3: -1, loc_row4: -1, loc_row5: -1, loc_row6: -1, loc_row7: -1,
        next_entity: 0, entity_count: 0, change_tick: 0, comp_count: 0,
        res_time_tick: 0, res_time_set: 0,
        res_added_tick: ECS_TV_TICK_NONE, res_changed_tick: ECS_TV_TICK_NONE,
        msg_event_amount: 0, msg_count: 0
    };
}

// ── World archetype (cap-4 slot) accessors. ──────────────────────────────────────────────────
fn _ecs_tv_world_arch_at(w: EcsTVWorldDeep, idx: i32) -> EcsTVArchDeep {
    if idx == 0 { return w.arch0; };
    if idx == 1 { return w.arch1; };
    if idx == 2 { return w.arch2; };
    return w.arch3;
}

fn _ecs_tv_world_set_arch(w0: EcsTVWorldDeep, idx: i32, arch: EcsTVArchDeep) -> EcsTVWorldDeep {
    if idx == 0 { w0.arch0 = arch; return w0; };
    if idx == 1 { w0.arch1 = arch; return w0; };
    if idx == 2 { w0.arch2 = arch; return w0; };
    w0.arch3 = arch;
    return w0;
}

// ── World entity (cap-8 slot) accessors. ───────────────────────────────────────────────────
fn _ecs_tv_world_gen_at(w: EcsTVWorldDeep, eid: i32) -> i32 {
    if eid == 0 { return w.gen0; };
    if eid == 1 { return w.gen1; };
    if eid == 2 { return w.gen2; };
    if eid == 3 { return w.gen3; };
    if eid == 4 { return w.gen4; };
    if eid == 5 { return w.gen5; };
    if eid == 6 { return w.gen6; };
    return w.gen7;
}

