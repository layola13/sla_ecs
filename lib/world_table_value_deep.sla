    if eid == 2 { w0.gen2 = value; return w0; };
    if eid == 3 { w0.gen3 = value; return w0; };
    if eid == 4 { w0.gen4 = value; return w0; };
    if eid == 5 { w0.gen5 = value; return w0; };
