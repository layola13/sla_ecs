// Deepened Bevy ECS schedule::stepping surface.
// Mirrors src/schedule/stepping.rs: Action queue (updates apply next frame),
// SystemBehavior AlwaysRun/NeverRun/Break/Continue, schedule order, cursor,
// skipped_systems bitmasks, begin_frame/next_frame, step/continue/waiting.
// Shallow lib/stepping.sla retained.

// === Action ===
const ECS_ST_ACTION_RUN_ALL: i32 = 0;
const ECS_ST_ACTION_WAITING: i32 = 1;
const ECS_ST_ACTION_CONTINUE: i32 = 2;
const ECS_ST_ACTION_STEP: i32 = 3;

// === SystemBehavior ===
const ECS_ST_BEH_CONTINUE: i32 = 0; // default
const ECS_ST_BEH_ALWAYS: i32 = 1;
const ECS_ST_BEH_NEVER: i32 = 2;
const ECS_ST_BEH_BREAK: i32 = 3;

// fixed capacities
const ECS_ST_MAX_SCHEDULES: i32 = 4;
const ECS_ST_MAX_SYSTEMS: i32 = 8; // systems per schedule
const ECS_ST_MAX_UPDATES: i32 = 16;

// Update kinds queued until next_frame/begin_frame
const ECS_ST_UPD_SET_ACTION: i32 = 1;
const ECS_ST_UPD_ADD_SCHEDULE: i32 = 2;
const ECS_ST_UPD_REMOVE_SCHEDULE: i32 = 3;
const ECS_ST_UPD_CLEAR_SCHEDULE: i32 = 4;
const ECS_ST_UPD_SET_BEHAVIOR: i32 = 5;
const ECS_ST_UPD_CLEAR_BEHAVIOR: i32 = 6;

struct EcsSteppingDeep {
    // current action for this frame
    action: i32,
    // pending updates (kind, a, b, c)
    u0k: i32, u0a: i32, u0b: i32, u0c: i32,
    u1k: i32, u1a: i32, u1b: i32, u1c: i32,
    u2k: i32, u2a: i32, u2b: i32, u2c: i32,
    u3k: i32, u3a: i32, u3b: i32, u3c: i32,
    u4k: i32, u4a: i32, u4b: i32, u4c: i32,
    u5k: i32, u5a: i32, u5b: i32, u5c: i32,
    u6k: i32, u6a: i32, u6b: i32, u6c: i32,
    u7k: i32, u7a: i32, u7b: i32, u7c: i32,
    u8k: i32, u8a: i32, u8b: i32, u8c: i32,
    u9k: i32, u9a: i32, u9b: i32, u9c: i32,
    u10k: i32, u10a: i32, u10b: i32, u10c: i32,
    u11k: i32, u11a: i32, u11b: i32, u11c: i32,
    u12k: i32, u12a: i32, u12b: i32, u12c: i32,
    u13k: i32, u13a: i32, u13b: i32, u13c: i32,
    u14k: i32, u14a: i32, u14b: i32, u14c: i32,
    u15k: i32, u15a: i32, u15b: i32, u15c: i32,
    update_len: i32,
    // schedule order: labels present in stepping (0..3 slots; -1 empty)
    s0: i32, s1: i32, s2: i32, s3: i32,
    schedule_count: i32,
    // system counts per schedule label 0..3 (for synthetic schedules)
    sc0: i32, sc1: i32, sc2: i32, sc3: i32,
    // behaviors: 4 schedules * 8 systems packed as beh[sched][sys]
    // store as b00..b37
    b00: i32, b01: i32, b02: i32, b03: i32, b04: i32, b05: i32, b06: i32, b07: i32,
    b10: i32, b11: i32, b12: i32, b13: i32, b14: i32, b15: i32, b16: i32, b17: i32,
    b20: i32, b21: i32, b22: i32, b23: i32, b24: i32, b25: i32, b26: i32, b27: i32,
    b30: i32, b31: i32, b32: i32, b33: i32, b34: i32, b35: i32, b36: i32, b37: i32,
    // cursor
    cursor_schedule: i32, // index in schedule_order, or -1 none
    cursor_system: i32,
    // last skip mask for schedule just processed (bits 0..7)
    last_skip_mask: i64,
    last_skip_valid: bool,
    frame_count: i64,
}

fn ecs_st_deep_new() -> EcsSteppingDeep {
    return EcsSteppingDeep {
        action: ECS_ST_ACTION_RUN_ALL,
        u0k: 0, u0a: 0, u0b: 0, u0c: 0,
        u1k: 0, u1a: 0, u1b: 0, u1c: 0,
        u2k: 0, u2a: 0, u2b: 0, u2c: 0,
        u3k: 0, u3a: 0, u3b: 0, u3c: 0,
        u4k: 0, u4a: 0, u4b: 0, u4c: 0,
        u5k: 0, u5a: 0, u5b: 0, u5c: 0,
        u6k: 0, u6a: 0, u6b: 0, u6c: 0,
        u7k: 0, u7a: 0, u7b: 0, u7c: 0,
        u8k: 0, u8a: 0, u8b: 0, u8c: 0,
        u9k: 0, u9a: 0, u9b: 0, u9c: 0,
        u10k: 0, u10a: 0, u10b: 0, u10c: 0,
        u11k: 0, u11a: 0, u11b: 0, u11c: 0,
        u12k: 0, u12a: 0, u12b: 0, u12c: 0,
        u13k: 0, u13a: 0, u13b: 0, u13c: 0,
        u14k: 0, u14a: 0, u14b: 0, u14c: 0,
        u15k: 0, u15a: 0, u15b: 0, u15c: 0,
        update_len: 0,
        s0: -1, s1: -1, s2: -1, s3: -1,
        schedule_count: 0,
        sc0: 2, sc1: 2, sc2: 2, sc3: 2,
        b00: 0, b01: 0, b02: 0, b03: 0, b04: 0, b05: 0, b06: 0, b07: 0,
        b10: 0, b11: 0, b12: 0, b13: 0, b14: 0, b15: 0, b16: 0, b17: 0,
        b20: 0, b21: 0, b22: 0, b23: 0, b24: 0, b25: 0, b26: 0, b27: 0,
        b30: 0, b31: 0, b32: 0, b33: 0, b34: 0, b35: 0, b36: 0, b37: 0,
        cursor_schedule: 0,
        cursor_system: 0,
        last_skip_mask: 0,
        last_skip_valid: false,
        frame_count: 0,
    };
}

fn ecs_st_deep_action(s: EcsSteppingDeep) -> i32 { return s.action; }
fn ecs_st_deep_is_enabled(s: EcsSteppingDeep) -> bool { return s.action != ECS_ST_ACTION_RUN_ALL; }
fn ecs_st_deep_schedule_count(s: EcsSteppingDeep) -> i32 { return s.schedule_count; }
fn ecs_st_deep_update_len(s: EcsSteppingDeep) -> i32 { return s.update_len; }
fn ecs_st_deep_cursor_schedule(s: EcsSteppingDeep) -> i32 { return s.cursor_schedule; }
fn ecs_st_deep_cursor_system(s: EcsSteppingDeep) -> i32 { return s.cursor_system; }
fn ecs_st_deep_last_skip_mask(s: EcsSteppingDeep) -> i64 { return s.last_skip_mask; }
fn ecs_st_deep_last_skip_valid(s: EcsSteppingDeep) -> bool { return s.last_skip_valid; }
fn ecs_st_deep_frame_count(s: EcsSteppingDeep) -> i64 { return s.frame_count; }

fn ecs_st_deep_set_system_count(s: EcsSteppingDeep, label: i32, count: i32) -> EcsSteppingDeep {
    if count < 0 { count = 0; };
    if count > ECS_ST_MAX_SYSTEMS { count = ECS_ST_MAX_SYSTEMS; };
    if label == 0 { s.sc0 = count; };
    if label == 1 { s.sc1 = count; };
    if label == 2 { s.sc2 = count; };
    if label == 3 { s.sc3 = count; };
    return s;
}

fn ecs_st_deep_system_count(s: EcsSteppingDeep, label: i32) -> i32 {
    if label == 0 { return s.sc0; };
    if label == 1 { return s.sc1; };
    if label == 2 { return s.sc2; };
    if label == 3 { return s.sc3; };
    return 0;
}

fn ecs_st_deep_order_at(s: EcsSteppingDeep, i: i32) -> i32 {
    if i == 0 { return s.s0; };
    if i == 1 { return s.s1; };
    if i == 2 { return s.s2; };
    if i == 3 { return s.s3; };
    return -1;
}

fn ecs_st_deep_set_order_at(s: EcsSteppingDeep, i: i32, label: i32) -> EcsSteppingDeep {
    if i == 0 { s.s0 = label; };
    if i == 1 { s.s1 = label; };
    if i == 2 { s.s2 = label; };
    if i == 3 { s.s3 = label; };
    return s;
}

fn ecs_st_deep_find_order_index(s: EcsSteppingDeep, label: i32) -> i32 {
    let i: i32 = 0;
    while i < s.schedule_count {
        if ecs_st_deep_order_at(s, i) == label { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_st_deep_get_beh(s: EcsSteppingDeep, label: i32, sys: i32) -> i32 {
    if label == 0 {
        if sys == 0 { return s.b00; };
        if sys == 1 { return s.b01; };
        if sys == 2 { return s.b02; };
        if sys == 3 { return s.b03; };
        if sys == 4 { return s.b04; };
        if sys == 5 { return s.b05; };
        if sys == 6 { return s.b06; };
        if sys == 7 { return s.b07; };
    };
    if label == 1 {
        if sys == 0 { return s.b10; };
        if sys == 1 { return s.b11; };
        if sys == 2 { return s.b12; };
        if sys == 3 { return s.b13; };
        if sys == 4 { return s.b14; };
        if sys == 5 { return s.b15; };
        if sys == 6 { return s.b16; };
        if sys == 7 { return s.b17; };
    };
    if label == 2 {
        if sys == 0 { return s.b20; };
        if sys == 1 { return s.b21; };
        if sys == 2 { return s.b22; };
        if sys == 3 { return s.b23; };
        if sys == 4 { return s.b24; };
        if sys == 5 { return s.b25; };
        if sys == 6 { return s.b26; };
        if sys == 7 { return s.b27; };
    };
    if label == 3 {
        if sys == 0 { return s.b30; };
        if sys == 1 { return s.b31; };
        if sys == 2 { return s.b32; };
        if sys == 3 { return s.b33; };
        if sys == 4 { return s.b34; };
        if sys == 5 { return s.b35; };
        if sys == 6 { return s.b36; };
        if sys == 7 { return s.b37; };
    };
    return ECS_ST_BEH_CONTINUE;
}

fn ecs_st_deep_set_beh(s: EcsSteppingDeep, label: i32, sys: i32, beh: i32) -> EcsSteppingDeep {
    if label == 0 {
        if sys == 0 { s.b00 = beh; };
        if sys == 1 { s.b01 = beh; };
        if sys == 2 { s.b02 = beh; };
        if sys == 3 { s.b03 = beh; };
        if sys == 4 { s.b04 = beh; };
        if sys == 5 { s.b05 = beh; };
        if sys == 6 { s.b06 = beh; };
        if sys == 7 { s.b07 = beh; };
    };
    if label == 1 {
        if sys == 0 { s.b10 = beh; };
        if sys == 1 { s.b11 = beh; };
        if sys == 2 { s.b12 = beh; };
        if sys == 3 { s.b13 = beh; };
        if sys == 4 { s.b14 = beh; };
        if sys == 5 { s.b15 = beh; };
        if sys == 6 { s.b16 = beh; };
        if sys == 7 { s.b17 = beh; };
    };
    if label == 2 {
        if sys == 0 { s.b20 = beh; };
        if sys == 1 { s.b21 = beh; };
        if sys == 2 { s.b22 = beh; };
        if sys == 3 { s.b23 = beh; };
        if sys == 4 { s.b24 = beh; };
        if sys == 5 { s.b25 = beh; };
        if sys == 6 { s.b26 = beh; };
        if sys == 7 { s.b27 = beh; };
    };
    if label == 3 {
        if sys == 0 { s.b30 = beh; };
        if sys == 1 { s.b31 = beh; };
        if sys == 2 { s.b32 = beh; };
        if sys == 3 { s.b33 = beh; };
        if sys == 4 { s.b34 = beh; };
        if sys == 5 { s.b35 = beh; };
        if sys == 6 { s.b36 = beh; };
        if sys == 7 { s.b37 = beh; };
    };
    return s;
}

fn ecs_st_deep_clear_beh_schedule(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    let i: i32 = 0;
    while i < ECS_ST_MAX_SYSTEMS {
        s = ecs_st_deep_set_beh(s, label, i, ECS_ST_BEH_CONTINUE);
        i = i + 1;
    }
    return s;
}

fn ecs_st_deep_push_update(s: EcsSteppingDeep, kind: i32, a: i32, b: i32, c: i32) -> EcsSteppingDeep {
    if s.update_len >= ECS_ST_MAX_UPDATES { return s; };
    let i = s.update_len;
    if i == 0 { s.u0k = kind; s.u0a = a; s.u0b = b; s.u0c = c; };
    if i == 1 { s.u1k = kind; s.u1a = a; s.u1b = b; s.u1c = c; };
    if i == 2 { s.u2k = kind; s.u2a = a; s.u2b = b; s.u2c = c; };
    if i == 3 { s.u3k = kind; s.u3a = a; s.u3b = b; s.u3c = c; };
    if i == 4 { s.u4k = kind; s.u4a = a; s.u4b = b; s.u4c = c; };
    if i == 5 { s.u5k = kind; s.u5a = a; s.u5b = b; s.u5c = c; };
    if i == 6 { s.u6k = kind; s.u6a = a; s.u6b = b; s.u6c = c; };
    if i == 7 { s.u7k = kind; s.u7a = a; s.u7b = b; s.u7c = c; };
    if i == 8 { s.u8k = kind; s.u8a = a; s.u8b = b; s.u8c = c; };
    if i == 9 { s.u9k = kind; s.u9a = a; s.u9b = b; s.u9c = c; };
    if i == 10 { s.u10k = kind; s.u10a = a; s.u10b = b; s.u10c = c; };
    if i == 11 { s.u11k = kind; s.u11a = a; s.u11b = b; s.u11c = c; };
    if i == 12 { s.u12k = kind; s.u12a = a; s.u12b = b; s.u12c = c; };
    if i == 13 { s.u13k = kind; s.u13a = a; s.u13b = b; s.u13c = c; };
    if i == 14 { s.u14k = kind; s.u14a = a; s.u14b = b; s.u14c = c; };
    if i == 15 { s.u15k = kind; s.u15a = a; s.u15b = b; s.u15c = c; };
    s.update_len = s.update_len + 1;
    return s;
}

fn ecs_st_deep_get_update(s: EcsSteppingDeep, i: i32) -> (i32, i32, i32, i32) {
    if i == 0 { return (s.u0k, s.u0a, s.u0b, s.u0c); };
    if i == 1 { return (s.u1k, s.u1a, s.u1b, s.u1c); };
    if i == 2 { return (s.u2k, s.u2a, s.u2b, s.u2c); };
    if i == 3 { return (s.u3k, s.u3a, s.u3b, s.u3c); };
    if i == 4 { return (s.u4k, s.u4a, s.u4b, s.u4c); };
    if i == 5 { return (s.u5k, s.u5a, s.u5b, s.u5c); };
    if i == 6 { return (s.u6k, s.u6a, s.u6b, s.u6c); };
    if i == 7 { return (s.u7k, s.u7a, s.u7b, s.u7c); };
    if i == 8 { return (s.u8k, s.u8a, s.u8b, s.u8c); };
    if i == 9 { return (s.u9k, s.u9a, s.u9b, s.u9c); };
    if i == 10 { return (s.u10k, s.u10a, s.u10b, s.u10c); };
    if i == 11 { return (s.u11k, s.u11a, s.u11b, s.u11c); };
    if i == 12 { return (s.u12k, s.u12a, s.u12b, s.u12c); };
    if i == 13 { return (s.u13k, s.u13a, s.u13b, s.u13c); };
    if i == 14 { return (s.u14k, s.u14a, s.u14b, s.u14c); };
    if i == 15 { return (s.u15k, s.u15a, s.u15b, s.u15c); };
    return (0, 0, 0, 0);
}

// Public API that queues updates (Bevy applies at begin_frame / next_frame)
fn ecs_st_deep_enable(s: EcsSteppingDeep) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_ACTION, ECS_ST_ACTION_WAITING, 0, 0);
}

fn ecs_st_deep_disable(s: EcsSteppingDeep) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_ACTION, ECS_ST_ACTION_RUN_ALL, 0, 0);
}

fn ecs_st_deep_step_frame(s: EcsSteppingDeep) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_ACTION, ECS_ST_ACTION_STEP, 0, 0);
}

fn ecs_st_deep_continue_frame(s: EcsSteppingDeep) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_ACTION, ECS_ST_ACTION_CONTINUE, 0, 0);
}

fn ecs_st_deep_add_schedule(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_ADD_SCHEDULE, label, 0, 0);
}

fn ecs_st_deep_remove_schedule(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_REMOVE_SCHEDULE, label, 0, 0);
}

fn ecs_st_deep_clear_schedule(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_CLEAR_SCHEDULE, label, 0, 0);
}

fn ecs_st_deep_always_run_node(s: EcsSteppingDeep, label: i32, sys: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_BEHAVIOR, label, sys, ECS_ST_BEH_ALWAYS);
}

fn ecs_st_deep_never_run_node(s: EcsSteppingDeep, label: i32, sys: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_BEHAVIOR, label, sys, ECS_ST_BEH_NEVER);
}

fn ecs_st_deep_set_breakpoint_node(s: EcsSteppingDeep, label: i32, sys: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_SET_BEHAVIOR, label, sys, ECS_ST_BEH_BREAK);
}

fn ecs_st_deep_clear_node(s: EcsSteppingDeep, label: i32, sys: i32) -> EcsSteppingDeep {
    return ecs_st_deep_push_update(s, ECS_ST_UPD_CLEAR_BEHAVIOR, label, sys, 0);
}

fn ecs_st_deep_apply_add_schedule(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    if ecs_st_deep_find_order_index(s, label) >= 0 { return s; };
    if s.schedule_count >= ECS_ST_MAX_SCHEDULES { return s; };
    s = ecs_st_deep_set_order_at(s, s.schedule_count, label);
    s.schedule_count = s.schedule_count + 1;
    return s;
}

fn ecs_st_deep_apply_remove_schedule(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    let idx = ecs_st_deep_find_order_index(s, label);
    if idx < 0 { return s; };
    // swap remove
    let last = s.schedule_count - 1;
    let last_label = ecs_st_deep_order_at(s, last);
    s = ecs_st_deep_set_order_at(s, idx, last_label);
    s = ecs_st_deep_set_order_at(s, last, -1);
    s.schedule_count = last;
    s = ecs_st_deep_clear_beh_schedule(s, label);
    return s;
}

fn ecs_st_deep_reset_cursor(s: EcsSteppingDeep) -> EcsSteppingDeep {
    s.cursor_schedule = 0;
    s.cursor_system = 0;
    return s;
}

// Apply queued updates (Bepping begin_frame / next_frame)
fn ecs_st_deep_next_frame(s: EcsSteppingDeep) -> EcsSteppingDeep {
    let reset_cursor = false;
    let i: i32 = 0;
    while i < s.update_len {
        let u = ecs_st_deep_get_update(s, i);
        let kind = u.0;
        let a = u.1;
        let b = u.2;
        let c = u.3;
        if kind == ECS_ST_UPD_SET_ACTION {
            if a == ECS_ST_ACTION_RUN_ALL {
                reset_cursor = true;
            };
            s.action = a;
        };
        if kind == ECS_ST_UPD_ADD_SCHEDULE {
            s = ecs_st_deep_apply_add_schedule(s, a);
        };
        if kind == ECS_ST_UPD_REMOVE_SCHEDULE {
            s = ecs_st_deep_apply_remove_schedule(s, a);
            reset_cursor = true;
        };
        if kind == ECS_ST_UPD_CLEAR_SCHEDULE {
            s = ecs_st_deep_clear_beh_schedule(s, a);
        };
        if kind == ECS_ST_UPD_SET_BEHAVIOR {
            s = ecs_st_deep_set_beh(s, a, b, c);
        };
        if kind == ECS_ST_UPD_CLEAR_BEHAVIOR {
            s = ecs_st_deep_set_beh(s, a, b, ECS_ST_BEH_CONTINUE);
        };
        i = i + 1;
    }
    s.update_len = 0;
    if reset_cursor {
        s = ecs_st_deep_reset_cursor(s);
    };
    // if cursor past end of order, reset
    if s.cursor_schedule >= s.schedule_count {
        s = ecs_st_deep_reset_cursor(s);
    };
    s.frame_count = s.frame_count + 1;
    return s;
}

fn ecs_st_deep_begin_frame(s: EcsSteppingDeep) -> EcsSteppingDeep {
    return ecs_st_deep_next_frame(s);
}

fn ecs_st_deep_cursor_ready(s: EcsSteppingDeep) -> bool {
    if s.action == ECS_ST_ACTION_RUN_ALL { return false; };
    if s.schedule_count <= 0 { return false; };
    if s.cursor_schedule < 0 || s.cursor_schedule >= s.schedule_count { return false; };
    return true;
}

// bit helpers for skip mask
fn ecs_st_deep_bit(i: i32) -> i64 {
    let b: i64 = 1;
    let n: i32 = 0;
    while n < i {
        b = b * 2;
        n = n + 1;
    }
    return b;
}

fn ecs_st_deep_mask_has(mask: i64, i: i32) -> bool {
    let b = ecs_st_deep_bit(i);
    return (mask / b) % 2 == 1;
}

fn ecs_st_deep_mask_set(mask: i64, i: i32) -> i64 {
    if ecs_st_deep_mask_has(mask, i) { return mask; };
    return mask + ecs_st_deep_bit(i);
}

// Compute skip list for one schedule label during current action.
// start = cursor system index if this is the cursor schedule; else 0 and treat as Waiting.
// Returns (stepping, skip_mask, ran_any, next_system_or_done)
// next_system: if >=0 remaining in schedule; if -1 schedule finished
fn ecs_st_deep_skipped_for_label(
    s: EcsSteppingDeep,
    label: i32,
    start: i32,
    is_cursor_schedule: bool
) -> (EcsSteppingDeep, i64, bool, i32) {
    let n = ecs_st_deep_system_count(s, label);
    let action = s.action;
    if is_cursor_schedule != true {
        // non-cursor schedules while stepping: Waiting semantics (only AlwaysRun)
        // Bevy uses Waiting action for non-cursor schedules
        action = ECS_ST_ACTION_WAITING;
        start = 0;
    };
    let skip: i64 = 0;
    let pos = start;
    let ran_any = false;
    let next_sys: i32 = -1;
    let i: i32 = 0;
    while i < n {
        let beh = ecs_st_deep_get_beh(s, label, i);
        // NeverRun always skipped; advance cursor past it
        if beh == ECS_ST_BEH_NEVER {
            skip = ecs_st_deep_mask_set(skip, i);
            if i == pos { pos = pos + 1; };
        };
        // AlwaysRun always executes; advance cursor past it so STEP can still
        // run the next steppable system in the same frame (Bevy step_always_run)
        if beh == ECS_ST_BEH_ALWAYS {
            ran_any = true;
            if i == pos { pos = pos + 1; };
        };
        if beh != ECS_ST_BEH_NEVER {
            if beh != ECS_ST_BEH_ALWAYS {
                if action == ECS_ST_ACTION_WAITING {
                    skip = ecs_st_deep_mask_set(skip, i);
                };
                if action == ECS_ST_ACTION_STEP {
                    if i < pos {
                        skip = ecs_st_deep_mask_set(skip, i);
                    };
                    if i == pos {
                        // run this one, then switch to waiting for rest
                        ran_any = true;
                        pos = pos + 1;
                        action = ECS_ST_ACTION_WAITING;
                    };
                    if i > pos {
                        // after step, waiting
                        skip = ecs_st_deep_mask_set(skip, i);
                    };
                };
                if action == ECS_ST_ACTION_CONTINUE {
                    if i < pos {
                        skip = ecs_st_deep_mask_set(skip, i);
                    };
                    if i >= pos {
                        if beh == ECS_ST_BEH_BREAK {
                            // stop before breakpoint unless it's the first system of continue
                            if i == start {
                                ran_any = true;
                                pos = i + 1;
                            };
                            if i != start {
                                skip = ecs_st_deep_mask_set(skip, i);
                                // stop continue for remaining
                                action = ECS_ST_ACTION_WAITING;
                            };
                        };
                        if beh != ECS_ST_BEH_BREAK {
                            ran_any = true;
                            pos = i + 1;
                        };
                    };
                };
                if action == ECS_ST_ACTION_RUN_ALL {
                    // nothing skipped by stepping
                    ran_any = true;
                    pos = i + 1;
                };
            };
        };
        i = i + 1;
    }
    // next system index for cursor advance within schedule
    if pos >= n {
        next_sys = -1;
    };
    if pos < n {
        next_sys = pos;
    };
    return (s, skip, ran_any, next_sys);
}

// skipped_systems for a schedule label; updates cursor when it is the cursor schedule
// returns None (last_skip_valid=false) when stepping disabled or schedule not added
fn ecs_st_deep_skipped_systems(s: EcsSteppingDeep, label: i32) -> EcsSteppingDeep {
    if s.action == ECS_ST_ACTION_RUN_ALL {
        s.last_skip_valid = false;
        s.last_skip_mask = 0;
        return s;
    };
    let order_idx = ecs_st_deep_find_order_index(s, label);
    if order_idx < 0 {
        s.last_skip_valid = false;
        s.last_skip_mask = 0;
        return s;
    };
    let is_cursor = order_idx == s.cursor_schedule;
    let start = 0;
    if is_cursor {
        start = s.cursor_system;
    };
    let r = ecs_st_deep_skipped_for_label(s, label, start, is_cursor);
    s = r.0;
    s.last_skip_mask = r.1;
    s.last_skip_valid = true;
    // advance cursor if this is cursor schedule
    if is_cursor {
        let next = r.3;
        if next >= 0 {
            s.cursor_system = next;
        };
        if next < 0 {
            // advance to next schedule
            s.cursor_schedule = s.cursor_schedule + 1;
            s.cursor_system = 0;
            if s.cursor_schedule >= s.schedule_count {
                s = ecs_st_deep_reset_cursor(s);
            };
        };
        // after a Step frame, Bevy typically returns to Waiting for subsequent frames
        // (step action is single-shot via updates). Here action remains until next_frame
        // queues a new action; tests will call step_frame each time.
    };
    return s;
}

// helpers for tests
fn ecs_st_deep_will_run(s: EcsSteppingDeep, sys: i32) -> bool {
    if s.last_skip_valid != true { return true; }; // disabled => all run
    return ecs_st_deep_mask_has(s.last_skip_mask, sys) != true;
}

fn ecs_st_deep_behavior_of(s: EcsSteppingDeep, label: i32, sys: i32) -> i32 {
    return ecs_st_deep_get_beh(s, label, sys);
}

// cursor option: returns (ready, schedule_label, system)
fn ecs_st_deep_cursor(s: EcsSteppingDeep) -> (bool, i32, i32) {
    if ecs_st_deep_cursor_ready(s) != true {
        return (false, -1, -1);
    };
    let label = ecs_st_deep_order_at(s, s.cursor_schedule);
    return (true, label, s.cursor_system);
}
