// Deepened Bevy-style sparse-set component storage.
// Dense values + sparse entity->dense_slot map, capacity-4.
// Shallow lib/sparse_store.sla retained.

struct EcsSparseStoreDeep {
    // dense
    de0: i32, dx0: i32, dy0: i32,
    de1: i32, dx1: i32, dy1: i32,
    de2: i32, dx2: i32, dy2: i32,
    de3: i32, dx3: i32, dy3: i32,
    // sparse: entity_id + dense_slot per entry
    se0: i32, ss0: i32,
    se1: i32, ss1: i32,
    se2: i32, ss2: i32,
    se3: i32, ss3: i32,
    count: i32,
}

struct EcsSparseGetDeep {
    ok: bool,
    x: i32,
    y: i32,
}

fn ecs_ssd_new() -> EcsSparseStoreDeep {
    return EcsSparseStoreDeep {
        de0: 0, dx0: 0, dy0: 0, de1: 0, dx1: 0, dy1: 0, de2: 0, dx2: 0, dy2: 0, de3: 0, dx3: 0, dy3: 0,
        se0: 0, ss0: 0, se1: 0, ss1: 0, se2: 0, ss2: 0, se3: 0, ss3: 0,
        count: 0,
    };
}

fn ecs_ssd_rebuild(
    de0: i32, dx0: i32, dy0: i32, de1: i32, dx1: i32, dy1: i32, de2: i32, dx2: i32, dy2: i32, de3: i32, dx3: i32, dy3: i32,
    se0: i32, ss0: i32, se1: i32, ss1: i32, se2: i32, ss2: i32, se3: i32, ss3: i32,
    count: i32
) -> EcsSparseStoreDeep {
    return EcsSparseStoreDeep {
        de0: de0, dx0: dx0, dy0: dy0, de1: de1, dx1: dx1, dy1: dy1, de2: de2, dx2: dx2, dy2: dy2, de3: de3, dx3: dx3, dy3: dy3,
        se0: se0, ss0: ss0, se1: se1, ss1: ss1, se2: se2, ss2: ss2, se3: se3, ss3: ss3,
        count: count,
    };
}

fn ecs_ssd_count(s: EcsSparseStoreDeep) -> i32 { return s.count; }
fn ecs_ssd_is_empty(s: EcsSparseStoreDeep) -> bool { return s.count == 0; }

fn ecs_ssd_sparse_slot_of(s: EcsSparseStoreDeep, eid: i32) -> i32 {
    if s.count >= 1 { if s.se0 == eid { return 0; }; };
    if s.count >= 2 { if s.se1 == eid { return 1; }; };
    if s.count >= 3 { if s.se2 == eid { return 2; }; };
    if s.count >= 4 { if s.se3 == eid { return 3; }; };
    return -1;
}

fn ecs_ssd_dense_slot_of(s: EcsSparseStoreDeep, eid: i32) -> i32 {
    let sparse_slot = ecs_ssd_sparse_slot_of(s, eid);
    if sparse_slot < 0 { return -1; };
    if sparse_slot == 0 { return s.ss0; };
    if sparse_slot == 1 { return s.ss1; };
    if sparse_slot == 2 { return s.ss2; };
    if sparse_slot == 3 { return s.ss3; };
    return -1;
}

fn ecs_ssd_has(s: EcsSparseStoreDeep, eid: i32) -> bool {
    return ecs_ssd_sparse_slot_of(s, eid) >= 0;
}

fn ecs_ssd_get(s: EcsSparseStoreDeep, eid: i32) -> EcsSparseGetDeep {
    let dense = ecs_ssd_dense_slot_of(s, eid);
    if dense < 0 { return EcsSparseGetDeep { ok: false, x: 0, y: 0 }; };
    if dense == 0 { return EcsSparseGetDeep { ok: true, x: s.dx0, y: s.dy0 }; };
    if dense == 1 { return EcsSparseGetDeep { ok: true, x: s.dx1, y: s.dy1 }; };
    if dense == 2 { return EcsSparseGetDeep { ok: true, x: s.dx2, y: s.dy2 }; };
    if dense == 3 { return EcsSparseGetDeep { ok: true, x: s.dx3, y: s.dy3 }; };
    return EcsSparseGetDeep { ok: false, x: 0, y: 0 };
}

fn ecs_ssd_get_ok(g: EcsSparseGetDeep) -> bool { return g.ok; }
fn ecs_ssd_get_x(g: EcsSparseGetDeep) -> i32 { return g.x; }
fn ecs_ssd_get_y(g: EcsSparseGetDeep) -> i32 { return g.y; }

fn ecs_ssd_write(s: EcsSparseStoreDeep, dense_slot: i32, x: i32, y: i32) -> EcsSparseStoreDeep {
    if dense_slot < 0 { return s; };
    if dense_slot >= s.count { return s; };
    let de0 = s.de0; let dx0 = s.dx0; let dy0 = s.dy0;
    let de1 = s.de1; let dx1 = s.dx1; let dy1 = s.dy1;
    let de2 = s.de2; let dx2 = s.dx2; let dy2 = s.dy2;
    let de3 = s.de3; let dx3 = s.dx3; let dy3 = s.dy3;
    let se0 = s.se0; let ss0 = s.ss0; let se1 = s.se1; let ss1 = s.ss1;
    let se2 = s.se2; let ss2 = s.ss2; let se3 = s.se3; let ss3 = s.ss3;
    let c = s.count;
    if dense_slot == 0 { dx0 = x; dy0 = y; };
    if dense_slot == 1 { dx1 = x; dy1 = y; };
    if dense_slot == 2 { dx2 = x; dy2 = y; };
    if dense_slot == 3 { dx3 = x; dy3 = y; };
    return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, c);
}

fn ecs_ssd_insert(s: EcsSparseStoreDeep, eid: i32, x: i32, y: i32) -> EcsSparseStoreDeep {
    if ecs_ssd_has(s, eid) { return s; };
    if s.count >= 4 { return s; };
    let de0 = s.de0; let dx0 = s.dx0; let dy0 = s.dy0;
    let de1 = s.de1; let dx1 = s.dx1; let dy1 = s.dy1;
    let de2 = s.de2; let dx2 = s.dx2; let dy2 = s.dy2;
    let de3 = s.de3; let dx3 = s.dx3; let dy3 = s.dy3;
    let se0 = s.se0; let ss0 = s.ss0; let se1 = s.se1; let ss1 = s.ss1;
    let se2 = s.se2; let ss2 = s.ss2; let se3 = s.se3; let ss3 = s.ss3;
    let dense_slot = s.count;
    if dense_slot == 0 {
        de0 = eid; dx0 = x; dy0 = y; se0 = eid; ss0 = 0;
        return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, 1);
    };
    if dense_slot == 1 {
        de1 = eid; dx1 = x; dy1 = y; se1 = eid; ss1 = 1;
        return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, 2);
    };
    if dense_slot == 2 {
        de2 = eid; dx2 = x; dy2 = y; se2 = eid; ss2 = 2;
        return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, 3);
    };
    if dense_slot == 3 {
        de3 = eid; dx3 = x; dy3 = y; se3 = eid; ss3 = 3;
        return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, 4);
    };
    return s;
}

fn ecs_ssd_set_sparse_dense(s: EcsSparseStoreDeep, sparse_slot: i32, dense_slot: i32) -> EcsSparseStoreDeep {
    let de0 = s.de0; let dx0 = s.dx0; let dy0 = s.dy0;
    let de1 = s.de1; let dx1 = s.dx1; let dy1 = s.dy1;
    let de2 = s.de2; let dx2 = s.dx2; let dy2 = s.dy2;
    let de3 = s.de3; let dx3 = s.dx3; let dy3 = s.dy3;
    let se0 = s.se0; let ss0 = s.ss0; let se1 = s.se1; let ss1 = s.ss1;
    let se2 = s.se2; let ss2 = s.ss2; let se3 = s.se3; let ss3 = s.ss3;
    let c = s.count;
    if sparse_slot == 0 { ss0 = dense_slot; };
    if sparse_slot == 1 { ss1 = dense_slot; };
    if sparse_slot == 2 { ss2 = dense_slot; };
    if sparse_slot == 3 { ss3 = dense_slot; };
    return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, c);
}

fn ecs_ssd_remove(s: EcsSparseStoreDeep, eid: i32) -> EcsSparseStoreDeep {
    let sparse_slot = ecs_ssd_sparse_slot_of(s, eid);
    if sparse_slot < 0 { return s; };
    let dense_slot = ecs_ssd_dense_slot_of(s, eid);
    let last = s.count - 1;
    let de0 = s.de0; let dx0 = s.dx0; let dy0 = s.dy0;
    let de1 = s.de1; let dx1 = s.dx1; let dy1 = s.dy1;
    let de2 = s.de2; let dx2 = s.dx2; let dy2 = s.dy2;
    let de3 = s.de3; let dx3 = s.dx3; let dy3 = s.dy3;
    let se0 = s.se0; let ss0 = s.ss0; let se1 = s.se1; let ss1 = s.ss1;
    let se2 = s.se2; let ss2 = s.ss2; let se3 = s.se3; let ss3 = s.ss3;

    // capture last dense entity/value
    let last_e = 0;
    let last_x = 0;
    let last_y = 0;
    if last == 0 { last_e = de0; last_x = dx0; last_y = dy0; };
    if last == 1 { last_e = de1; last_x = dx1; last_y = dy1; };
    if last == 2 { last_e = de2; last_x = dx2; last_y = dy2; };
    if last == 3 { last_e = de3; last_x = dx3; last_y = dy3; };

    if dense_slot != last {
        // move last dense into dense_slot
        if dense_slot == 0 { de0 = last_e; dx0 = last_x; dy0 = last_y; };
        if dense_slot == 1 { de1 = last_e; dx1 = last_x; dy1 = last_y; };
        if dense_slot == 2 { de2 = last_e; dx2 = last_x; dy2 = last_y; };
        if dense_slot == 3 { de3 = last_e; dx3 = last_x; dy3 = last_y; };
        // update moved entity's sparse dense_slot
        if se0 == last_e { ss0 = dense_slot; };
        if se1 == last_e { ss1 = dense_slot; };
        if se2 == last_e { ss2 = dense_slot; };
        if se3 == last_e { ss3 = dense_slot; };
    };

    // clear last dense
    if last == 0 { de0 = 0; dx0 = 0; dy0 = 0; };
    if last == 1 { de1 = 0; dx1 = 0; dy1 = 0; };
    if last == 2 { de2 = 0; dx2 = 0; dy2 = 0; };
    if last == 3 { de3 = 0; dx3 = 0; dy3 = 0; };

    // remove sparse entry by compacting: move last sparse into sparse_slot then clear last
    let last_se = 0;
    let last_ss = 0;
    if last == 0 { last_se = se0; last_ss = ss0; };
    if last == 1 { last_se = se1; last_ss = ss1; };
    if last == 2 { last_se = se2; last_ss = ss2; };
    if last == 3 { last_se = se3; last_ss = ss3; };

    if sparse_slot != last {
        if sparse_slot == 0 { se0 = last_se; ss0 = last_ss; };
        if sparse_slot == 1 { se1 = last_se; ss1 = last_ss; };
        if sparse_slot == 2 { se2 = last_se; ss2 = last_ss; };
        if sparse_slot == 3 { se3 = last_se; ss3 = last_ss; };
    };
    if last == 0 { se0 = 0; ss0 = 0; };
    if last == 1 { se1 = 0; ss1 = 0; };
    if last == 2 { se2 = 0; ss2 = 0; };
    if last == 3 { se3 = 0; ss3 = 0; };

    return ecs_ssd_rebuild(de0, dx0, dy0, de1, dx1, dy1, de2, dx2, dy2, de3, dx3, dy3, se0, ss0, se1, ss1, se2, ss2, se3, ss3, last);
}

fn ecs_ssd_clear(s: EcsSparseStoreDeep) -> EcsSparseStoreDeep {
    return ecs_ssd_new();
}

fn ecs_ssd_dense_entity_at(s: EcsSparseStoreDeep, dense_slot: i32) -> i32 {
    if dense_slot == 0 { return s.de0; };
    if dense_slot == 1 { return s.de1; };
    if dense_slot == 2 { return s.de2; };
    if dense_slot == 3 { return s.de3; };
    return -1;
}
