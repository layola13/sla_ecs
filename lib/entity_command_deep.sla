fn ecs_ec_deep_cmd_with_caller(cmd: EcsEntityCommandDeep, caller_id: i64) -> EcsEntityCommandDeep {
    cmd.caller_id = caller_id;
    return cmd;
}

fn ecs_ec_deep_add_component(w: EcsEntityCmdWorldDeep, e: i64, cid: i64, value: i64, mode: i32) -> EcsEntityCmdWorldDeep {
    if ecs_ec_deep_has(w, e, cid) {
        if mode == ECS_EC_DEEP_INSERT_KEEP {
            return w;
        };
    };
    let m = ecs_ec_deep_get_mask(w, e);
    let b = ecs_ec_deep_bit(cid);
    if (m / b) % 2 == 0 {
        m = m + b;
    };
    w = ecs_ec_deep_set_mask(w, e, m);
    // store value on entity primary slot for any component write (simplified)
    w = ecs_ec_deep_set_value(w, e, value);
    return w;
}

fn ecs_ec_deep_remove_component(w: EcsEntityCmdWorldDeep, e: i64, cid: i64) -> EcsEntityCmdWorldDeep {
    let m = ecs_ec_deep_get_mask(w, e);
    let b = ecs_ec_deep_bit(cid);
    if (m / b) % 2 == 1 {
        m = m - b;
    };
    w = ecs_ec_deep_set_mask(w, e, m);
    return w;
}

// required component of cid is (cid+1)%8 when requires_enabled
fn ecs_ec_deep_required_of(cid: i64) -> i64 {
    return (cid + 1) % 8;
}

fn ecs_ec_deep_remove_with_requires_impl(w: EcsEntityCmdWorldDeep, e: i64, cid: i64) -> EcsEntityCmdWorldDeep {
    w = ecs_ec_deep_remove_component(w, e, cid);
    if w.requires_enabled {
        let req = ecs_ec_deep_required_of(cid);
        w = ecs_ec_deep_remove_component(w, e, req);
    };
    return w;
}

fn ecs_ec_deep_or_masks(a: i64, b: i64) -> i64 {
    // bit-or for 8 bits without bitwise ops: rebuild
    let out: i64 = 0;
    let i: i64 = 0;
    while i < 8 {
        let bit = ecs_ec_deep_bit(i);
        let in_a = (a / bit) % 2 == 1;
        let in_b = (b / bit) % 2 == 1;
        if in_a || in_b {
            out = out + bit;
        };
        i = i + 1;
    }
    return out;
}

fn ecs_ec_deep_and_masks(a: i64, b: i64) -> i64 {
    let out: i64 = 0;
    let i: i64 = 0;
    while i < 8 {
        let bit = ecs_ec_deep_bit(i);
        let in_a = (a / bit) % 2 == 1;
        let in_b = (b / bit) % 2 == 1;
        if in_a && in_b {
            out = out + bit;
        };
        i = i + 1;
    }
    return out;
}

fn ecs_ec_deep_not_mask(m: i64) -> i64 {
    let out: i64 = 0;
    let i: i64 = 0;
    while i < 8 {
        let bit = ecs_ec_deep_bit(i);
        if (m / bit) % 2 == 0 {
            out = out + bit;
        };
        i = i + 1;
    }
    return out;
}

// EntityCommand::apply — entity must be occupied
fn ecs_ec_deep_apply(w: EcsEntityCmdWorldDeep, entity: i64, cmd: EcsEntityCommandDeep) -> EcsEntityCmdWorldDeep {
    if ecs_ec_deep_occupied(w, entity) != true {
        w.last_error = ECS_EC_DEEP_ENTITY_FETCH;
        return w;
    };
    w.last_error = ECS_EC_DEEP_OK;
    w.last_command_failed_code = 0;

    if cmd.kind == ECS_EC_DEEP_KIND_INSERT {
        w = ecs_ec_deep_add_component(w, entity, cmd.component_id, cmd.value, cmd.mode);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_INSERT_FROM_WORLD {
        // FromWorld only invoked if insert will actually happen
        let will_skip = false;
        if cmd.mode == ECS_EC_DEEP_INSERT_KEEP {
            if ecs_ec_deep_has(w, entity, cmd.component_id) {
                will_skip = true;
            };
        };
        if will_skip != true {
            w.from_world_calls = w.from_world_calls + 1;
            let v = ecs_ec_deep_from_world_value(w, cmd.component_id);
            w = ecs_ec_deep_add_component(w, entity, cmd.component_id, v, cmd.mode);
        };
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_INSERT_WITH {
        let will_skip = false;
        if cmd.mode == ECS_EC_DEEP_INSERT_KEEP {
            if ecs_ec_deep_has(w, entity, cmd.component_id) {
                will_skip = true;
            };
        };
        if will_skip != true {
            // value already produced by "fn" (cmd.value)
            w = ecs_ec_deep_add_component(w, entity, cmd.component_id, cmd.value, cmd.mode);
        };
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_REMOVE || cmd.kind == ECS_EC_DEEP_KIND_REMOVE_BY_ID {
        w = ecs_ec_deep_remove_component(w, entity, cmd.component_id);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_REMOVE_WITH_REQUIRES {
        w = ecs_ec_deep_remove_with_requires_impl(w, entity, cmd.component_id);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_CLEAR {
        w = ecs_ec_deep_set_mask(w, entity, 0);
        w = ecs_ec_deep_set_value(w, entity, 0);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_RETAIN {
        let m = ecs_ec_deep_get_mask(w, entity);
        let kept = ecs_ec_deep_and_masks(m, cmd.retain_mask);
        w = ecs_ec_deep_set_mask(w, entity, kept);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_DESPAWN {
        w = ecs_ec_deep_set_occupied(w, entity, false);
        w = ecs_ec_deep_set_mask(w, entity, 0);
        w = ecs_ec_deep_set_value(w, entity, 0);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_OBSERVE {
        w.observer_count = w.observer_count + 1;
        w.last_observer_id = cmd.target;
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_CLONE_OPT_OUT {
        if ecs_ec_deep_occupied(w, cmd.target) != true {
            // Bevy panics on missing target for some clone/move; model as command failed
            w.last_error = ECS_EC_DEEP_COMMAND_FAILED;
            w.last_command_failed_code = 1;
            return w;
        };
        let src = ecs_ec_deep_get_mask(w, entity);
        let deny = cmd.filter_mask;
        let allow = ecs_ec_deep_and_masks(src, ecs_ec_deep_not_mask(deny));
        let dst = ecs_ec_deep_get_mask(w, cmd.target);
        let merged = ecs_ec_deep_or_masks(dst, allow);
        w = ecs_ec_deep_set_mask(w, cmd.target, merged);
        w = ecs_ec_deep_set_value(w, cmd.target, ecs_ec_deep_get_value(w, entity));
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_CLONE_OPT_IN || cmd.kind == ECS_EC_DEEP_KIND_CLONE_COMPONENTS {
        if ecs_ec_deep_occupied(w, cmd.target) != true {
            w.last_error = ECS_EC_DEEP_COMMAND_FAILED;
            w.last_command_failed_code = 1;
            return w;
        };
        let src = ecs_ec_deep_get_mask(w, entity);
        let allow = ecs_ec_deep_and_masks(src, cmd.filter_mask);
        let dst = ecs_ec_deep_get_mask(w, cmd.target);
        let merged = ecs_ec_deep_or_masks(dst, allow);
        w = ecs_ec_deep_set_mask(w, cmd.target, merged);
        w = ecs_ec_deep_set_value(w, cmd.target, ecs_ec_deep_get_value(w, entity));
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_MOVE_COMPONENTS {
        if ecs_ec_deep_occupied(w, cmd.target) != true {
            w.last_error = ECS_EC_DEEP_COMMAND_FAILED;
            w.last_command_failed_code = 1;
            return w;
        };
        let src = ecs_ec_deep_get_mask(w, entity);
        let move_m = ecs_ec_deep_and_masks(src, cmd.filter_mask);
        let dst = ecs_ec_deep_get_mask(w, cmd.target);
        let merged = ecs_ec_deep_or_masks(dst, move_m);
        w = ecs_ec_deep_set_mask(w, cmd.target, merged);
        w = ecs_ec_deep_set_value(w, cmd.target, ecs_ec_deep_get_value(w, entity));
        // remove moved bits from source
        let remain = ecs_ec_deep_and_masks(src, ecs_ec_deep_not_mask(move_m));
        w = ecs_ec_deep_set_mask(w, entity, remain);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_LOG {
        w.log_entity = entity;
        w.log_component_count = ecs_ec_deep_component_count(w, entity);
        return w;
    };
    if cmd.kind == ECS_EC_DEEP_KIND_CUSTOM_FAIL {
        w.last_error = ECS_EC_DEEP_COMMAND_FAILED;
        w.last_command_failed_code = cmd.fail_code;
        return w;
    };
    return w;
}

// with_entity: EntityCommand -> Command on world for a fixed entity
// returns world after command; fetch missing entity => EntityFetchError
fn ecs_ec_deep_with_entity(w: EcsEntityCmdWorldDeep, entity: i64, cmd: EcsEntityCommandDeep) -> EcsEntityCmdWorldDeep {
    return ecs_ec_deep_apply(w, entity, cmd);
}

// Closure-style EntityCommand: FnOnce(EntityWorldMut) modeled as custom apply of insert
fn ecs_ec_deep_apply_fn_insert(w: EcsEntityCmdWorldDeep, entity: i64, component_id: i64, value: i64) -> EcsEntityCmdWorldDeep {
    let cmd = ecs_ec_deep_cmd_insert(component_id, value, ECS_EC_DEEP_INSERT_REPLACE);
    return ecs_ec_deep_apply(w, entity, cmd);
}

fn ecs_ec_deep_error_is_ok(code: i32) -> bool { return code == ECS_EC_DEEP_OK; }
fn ecs_ec_deep_error_is_fetch(code: i32) -> bool { return code == ECS_EC_DEEP_ENTITY_FETCH; }
fn ecs_ec_deep_error_is_failed(code: i32) -> bool { return code == ECS_EC_DEEP_COMMAND_FAILED; }
