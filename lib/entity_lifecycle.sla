// Bevy ECS entity_disabling + lifecycle: DefaultQueryFilters + ComponentHooks +
// RemovedComponents surface. Mirrors src/entity_disabling.rs + src/lifecycle.rs.

// === DefaultQueryFilters (entity_disabling.rs) ===
struct EcsDefaultQueryFilters {
    disabling: Vec<i32>,
}

fn ecs_dqf_empty() -> EcsDefaultQueryFilters {
    let f = EcsDefaultQueryFilters { disabling: Vec::new() };
    return f;
}

fn ecs_dqf_register_disabling_component(f: EcsDefaultQueryFilters, component_id: i32) -> EcsDefaultQueryFilters {
    f.disabling.push(component_id);
    return f;
}

fn ecs_dqf_disabling_count(f: EcsDefaultQueryFilters) -> i32 {
    return len(f.disabling) as i32;
}

fn ecs_dqf_is_disabling(f: EcsDefaultQueryFilters, component_id: i32) -> bool {
    let idx: i32 = 0;
    let n: i32 = len(f.disabling) as i32;
    while idx < n {
        if f.disabling[idx] == component_id {
            return true;
        };
        idx = idx + 1;
    }
    return false;
}

// disabling_ids() — primitives-only API: (count, first_id) since freshly-built Vec leaks when consumed in test bodies.
fn ecs_dqf_disabling_first(f: EcsDefaultQueryFilters) -> (bool, i32) {
    if len(f.disabling) as i32 == 0 {
        return (false, 0);
    };
    return (true, f.disabling[0]);
}

// === ComponentHooks (lifecycle.rs) ===
// Each hook slot stores a tagged hook-id (0 = absent).
struct EcsComponentHooks {
    on_add: i32,
    on_insert: i32,
    on_discard: i32,
    on_remove: i32,
    on_despawn: i32,
}

fn ecs_component_hooks_new() -> EcsComponentHooks {
    let h = EcsComponentHooks { on_add: 0, on_insert: 0, on_discard: 0, on_remove: 0, on_despawn: 0 };
    return h;
}

fn ecs_component_hooks_on_add(h: EcsComponentHooks, hook_id: i32) -> EcsComponentHooks {
    h.on_add = hook_id;
    return h;
}

fn ecs_component_hooks_on_insert(h: EcsComponentHooks, hook_id: i32) -> EcsComponentHooks {
    h.on_insert = hook_id;
    return h;
}

fn ecs_component_hooks_on_discard(h: EcsComponentHooks, hook_id: i32) -> EcsComponentHooks {
    h.on_discard = hook_id;
    return h;
}

fn ecs_component_hooks_on_remove(h: EcsComponentHooks, hook_id: i32) -> EcsComponentHooks {
    h.on_remove = hook_id;
    return h;
}

fn ecs_component_hooks_on_despawn(h: EcsComponentHooks, hook_id: i32) -> EcsComponentHooks {
    h.on_despawn = hook_id;
    return h;
}

fn ecs_component_hooks_has_on_add(h: EcsComponentHooks) -> bool { return h.on_add != 0; }
fn ecs_component_hooks_has_on_insert(h: EcsComponentHooks) -> bool { return h.on_insert != 0; }
fn ecs_component_hooks_has_on_discard(h: EcsComponentHooks) -> bool { return h.on_discard != 0; }
fn ecs_component_hooks_has_on_remove(h: EcsComponentHooks) -> bool { return h.on_remove != 0; }
fn ecs_component_hooks_has_on_despawn(h: EcsComponentHooks) -> bool { return h.on_despawn != 0; }

fn ecs_component_hooks_on_add_id(h: EcsComponentHooks) -> i32 { return h.on_add; }
fn ecs_component_hooks_on_insert_id(h: EcsComponentHooks) -> i32 { return h.on_insert; }
fn ecs_component_hooks_on_discard_id(h: EcsComponentHooks) -> i32 { return h.on_discard; }
fn ecs_component_hooks_on_remove_id(h: EcsComponentHooks) -> i32 { return h.on_remove; }
fn ecs_component_hooks_on_despawn_id(h: EcsComponentHooks) -> i32 { return h.on_despawn; }

// try_on_*: returns (ok, hooks). ok if slot was empty (hook == 0) and we set it; otherwise ok=false and hooks unchanged.
fn ecs_component_hooks_try_on_add(h: EcsComponentHooks, hook_id: i32) -> (bool, EcsComponentHooks) {
    if h.on_add != 0 {
        return (false, h);
    };
    h.on_add = hook_id;
    return (true, h);
}

fn ecs_component_hooks_try_on_insert(h: EcsComponentHooks, hook_id: i32) -> (bool, EcsComponentHooks) {
    if h.on_insert != 0 {
        return (false, h);
    };
    h.on_insert = hook_id;
    return (true, h);
}

fn ecs_component_hooks_try_on_discard(h: EcsComponentHooks, hook_id: i32) -> (bool, EcsComponentHooks) {
    if h.on_discard != 0 {
        return (false, h);
    };
    h.on_discard = hook_id;
    return (true, h);
}

fn ecs_component_hooks_try_on_remove(h: EcsComponentHooks, hook_id: i32) -> (bool, EcsComponentHooks) {
    if h.on_remove != 0 {
        return (false, h);
    };
    h.on_remove = hook_id;
    return (true, h);
}

fn ecs_component_hooks_try_on_despawn(h: EcsComponentHooks, hook_id: i32) -> (bool, EcsComponentHooks) {
    if h.on_despawn != 0 {
        return (false, h);
    };
    h.on_despawn = hook_id;
    return (true, h);
}

// === RemovedComponents (simplified) — primitive-return API to avoid the fresh-Vec leak ===
// Tracks (component_id, entity) removal entries with a flat cursor.
struct EcsRemovedComponents {
    component_id: i32,
    removed_entities: Vec<i32>,
    cursor: i32,
}

fn ecs_removed_components_new(component_id: i32) -> EcsRemovedComponents {
    let r = EcsRemovedComponents { component_id: component_id, removed_entities: Vec::new(), cursor: 0 };
    return r;
}

fn ecs_removed_components_write(r: EcsRemovedComponents, entity: i32) -> EcsRemovedComponents {
    r.removed_entities.push(entity);
    return r;
}

fn ecs_removed_components_component_id(r: EcsRemovedComponents) -> i32 {
    return r.component_id;
}

fn ecs_removed_components_len(r: EcsRemovedComponents) -> i32 {
    return len(r.removed_entities) as i32;
}

fn ecs_removed_components_is_empty(r: EcsRemovedComponents) -> bool {
    return len(r.removed_entities) as i32 == 0;
}

fn ecs_removed_components_clear(r: EcsRemovedComponents) -> EcsRemovedComponents {
    r.removed_entities = Vec::new();
    r.cursor = 0;
    return r;
}

// read(): advances cursor and returns (had, entity) for the next unread removal.
fn ecs_removed_components_read(r: EcsRemovedComponents) -> (bool, i32, EcsRemovedComponents) {
    let n: i32 = len(r.removed_entities) as i32;
    if r.cursor >= n {
        return (false, 0, r);
    };
    let e = r.removed_entities[r.cursor];
    r.cursor = r.cursor + 1;
    return (true, e, r);
}

// read_with_id(): returns (had, component_id, entity, r)
fn ecs_removed_components_read_with_id(r: EcsRemovedComponents) -> (bool, i32, i32, EcsRemovedComponents) {
    let n: i32 = len(r.removed_entities) as i32;
    if r.cursor >= n {
        return (false, 0, 0, r);
    };
    let e = r.removed_entities[r.cursor];
    r.cursor = r.cursor + 1;
    return (true, r.component_id, e, r);
}

fn ecs_removed_components_cursor(r: EcsRemovedComponents) -> i32 {
    return r.cursor;
}

fn ecs_removed_components_reset_cursor(r: EcsRemovedComponents) -> EcsRemovedComponents {
    r.cursor = 0;
    return r;
}

// messages(): primitives-only — (has_messages, count, first_entity)
fn ecs_removed_components_messages(r: EcsRemovedComponents) -> (bool, i32, i32) {
    if len(r.removed_entities) as i32 == 0 {
        return (false, 0, 0);
    };
    return (true, len(r.removed_entities) as i32, r.removed_entities[0]);
}
