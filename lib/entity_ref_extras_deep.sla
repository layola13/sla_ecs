// Deepened Bevy ECS EntityRef extras.
// Mirrors src/world/entity_access/entity_ref.rs residual surface.
// Fixed capacity: 4 components. Shallow lib/entity_ref_extras.sla retained.

struct EcsEreDeep {
    entity_id: i32,
    archetype_id: i32,
    location_archetype: i32,
    location_table_row: i32,
    spawn_tick: i32,
    spawned_by_id: i32,
    c0: i32, t0: i32, v0: i32, a0: i32, ch0: i32, by0: i32,
    c1: i32, t1: i32, v1: i32, a1: i32, ch1: i32, by1: i32,
    c2: i32, t2: i32, v2: i32, a2: i32, ch2: i32, by2: i32,
    c3: i32, t3: i32, v3: i32, a3: i32, ch3: i32, by3: i32,
    clen: i32,
}

fn ecs_ere_deep_new(entity_id: i32) -> EcsEreDeep {
    return EcsEreDeep {
        entity_id: entity_id, archetype_id: 0, location_archetype: 0, location_table_row: 0,
        spawn_tick: 0, spawned_by_id: 0,
        c0: -1, t0: 0, v0: 0, a0: 0, ch0: 0, by0: 0,
        c1: -1, t1: 0, v1: 0, a1: 0, ch1: 0, by1: 0,
        c2: -1, t2: 0, v2: 0, a2: 0, ch2: 0, by2: 0,
        c3: -1, t3: 0, v3: 0, a3: 0, ch3: 0, by3: 0,
        clen: 0,
    };
}

fn ecs_ere_deep_id(r: EcsEreDeep) -> i32 { return r.entity_id; }
fn ecs_ere_deep_archetype(r: EcsEreDeep) -> i32 { return r.archetype_id; }
fn ecs_ere_deep_spawn_tick(r: EcsEreDeep) -> i32 { return r.spawn_tick; }
fn ecs_ere_deep_spawned_by(r: EcsEreDeep) -> i32 { return r.spawned_by_id; }
fn ecs_ere_deep_clen(r: EcsEreDeep) -> i32 { return r.clen; }

fn ecs_ere_deep_rebuild(
    entity_id: i32, archetype_id: i32, location_archetype: i32, location_table_row: i32,
    spawn_tick: i32, spawned_by_id: i32,
    c0: i32, t0: i32, v0: i32, a0: i32, ch0: i32, by0: i32,
    c1: i32, t1: i32, v1: i32, a1: i32, ch1: i32, by1: i32,
    c2: i32, t2: i32, v2: i32, a2: i32, ch2: i32, by2: i32,
    c3: i32, t3: i32, v3: i32, a3: i32, ch3: i32, by3: i32,
    clen: i32
) -> EcsEreDeep {
    return EcsEreDeep {
        entity_id: entity_id, archetype_id: archetype_id, location_archetype: location_archetype,
        location_table_row: location_table_row, spawn_tick: spawn_tick, spawned_by_id: spawned_by_id,
        c0: c0, t0: t0, v0: v0, a0: a0, ch0: ch0, by0: by0,
        c1: c1, t1: t1, v1: v1, a1: a1, ch1: ch1, by1: by1,
        c2: c2, t2: t2, v2: v2, a2: a2, ch2: ch2, by2: by2,
        c3: c3, t3: t3, v3: v3, a3: a3, ch3: ch3, by3: by3,
        clen: clen,
    };
}

fn ecs_ere_deep_set_location(r: EcsEreDeep, archetype: i32, table_row: i32) -> EcsEreDeep {
    return ecs_ere_deep_rebuild(r.entity_id, archetype, archetype, table_row, r.spawn_tick, r.spawned_by_id, r.c0, r.t0, r.v0, r.a0, r.ch0, r.by0, r.c1, r.t1, r.v1, r.a1, r.ch1, r.by1, r.c2, r.t2, r.v2, r.a2, r.ch2, r.by2, r.c3, r.t3, r.v3, r.a3, r.ch3, r.by3, r.clen);
}

fn ecs_ere_deep_set_spawn(r: EcsEreDeep, tick: i32, by: i32) -> EcsEreDeep {
    return ecs_ere_deep_rebuild(r.entity_id, r.archetype_id, r.location_archetype, r.location_table_row, tick, by, r.c0, r.t0, r.v0, r.a0, r.ch0, r.by0, r.c1, r.t1, r.v1, r.a1, r.ch1, r.by1, r.c2, r.t2, r.v2, r.a2, r.ch2, r.by2, r.c3, r.t3, r.v3, r.a3, r.ch3, r.by3, r.clen);
}

struct EcsEreLocDeep {
    archetype: i32,
    table_row: i32,
}

fn ecs_ere_deep_location(r: EcsEreDeep) -> EcsEreLocDeep {
    return EcsEreLocDeep { archetype: r.location_archetype, table_row: r.location_table_row };
}

fn ecs_ere_loc_archetype(l: EcsEreLocDeep) -> i32 { return l.archetype; }
fn ecs_ere_loc_table_row(l: EcsEreLocDeep) -> i32 { return l.table_row; }

fn ecs_ere_deep_insert(r: EcsEreDeep, cid: i32, tid: i32, value: i32, tick: i32, by: i32) -> EcsEreDeep {
    if r.clen == 0 {
        return ecs_ere_deep_rebuild(r.entity_id, r.archetype_id, r.location_archetype, r.location_table_row, r.spawn_tick, r.spawned_by_id, cid, tid, value, tick, tick, by, r.c1, r.t1, r.v1, r.a1, r.ch1, r.by1, r.c2, r.t2, r.v2, r.a2, r.ch2, r.by2, r.c3, r.t3, r.v3, r.a3, r.ch3, r.by3, 1);
    };
    if r.clen == 1 {
        return ecs_ere_deep_rebuild(r.entity_id, r.archetype_id, r.location_archetype, r.location_table_row, r.spawn_tick, r.spawned_by_id, r.c0, r.t0, r.v0, r.a0, r.ch0, r.by0, cid, tid, value, tick, tick, by, r.c2, r.t2, r.v2, r.a2, r.ch2, r.by2, r.c3, r.t3, r.v3, r.a3, r.ch3, r.by3, 2);
    };
    if r.clen == 2 {
        return ecs_ere_deep_rebuild(r.entity_id, r.archetype_id, r.location_archetype, r.location_table_row, r.spawn_tick, r.spawned_by_id, r.c0, r.t0, r.v0, r.a0, r.ch0, r.by0, r.c1, r.t1, r.v1, r.a1, r.ch1, r.by1, cid, tid, value, tick, tick, by, r.c3, r.t3, r.v3, r.a3, r.ch3, r.by3, 3);
    };
    if r.clen == 3 {
        return ecs_ere_deep_rebuild(r.entity_id, r.archetype_id, r.location_archetype, r.location_table_row, r.spawn_tick, r.spawned_by_id, r.c0, r.t0, r.v0, r.a0, r.ch0, r.by0, r.c1, r.t1, r.v1, r.a1, r.ch1, r.by1, r.c2, r.t2, r.v2, r.a2, r.ch2, r.by2, cid, tid, value, tick, tick, by, 4);
    };
    return r;
}

fn ecs_ere_deep_contains_id(r: EcsEreDeep, cid: i32) -> bool {
    if r.clen >= 1 { if r.c0 == cid { return true; }; };
    if r.clen >= 2 { if r.c1 == cid { return true; }; };
    if r.clen >= 3 { if r.c2 == cid { return true; }; };
    if r.clen >= 4 { if r.c3 == cid { return true; }; };
    return false;
}

fn ecs_ere_deep_contains_type_id(r: EcsEreDeep, tid: i32) -> bool {
    if r.clen >= 1 { if r.t0 == tid { return true; }; };
    if r.clen >= 2 { if r.t1 == tid { return true; }; };
    if r.clen >= 3 { if r.t2 == tid { return true; }; };
    if r.clen >= 4 { if r.t3 == tid { return true; }; };
    return false;
}

struct EcsEreValDeep {
    ok: bool,
    value: i32,
}

fn ecs_ere_val_ok(v: EcsEreValDeep) -> bool { return v.ok; }
fn ecs_ere_val_value(v: EcsEreValDeep) -> i32 { return v.value; }

fn ecs_ere_deep_get_by_id(r: EcsEreDeep, cid: i32) -> EcsEreValDeep {
    if r.clen >= 1 { if r.c0 == cid { return EcsEreValDeep { ok: true, value: r.v0 }; }; };
    if r.clen >= 2 { if r.c1 == cid { return EcsEreValDeep { ok: true, value: r.v1 }; }; };
    if r.clen >= 3 { if r.c2 == cid { return EcsEreValDeep { ok: true, value: r.v2 }; }; };
    if r.clen >= 4 { if r.c3 == cid { return EcsEreValDeep { ok: true, value: r.v3 }; }; };
    return EcsEreValDeep { ok: false, value: 0 };
}

struct EcsEreTicksDeep {
    ok: bool,
    added: i32,
    changed: i32,
    by: i32,
}

fn ecs_ere_ticks_ok(t: EcsEreTicksDeep) -> bool { return t.ok; }
fn ecs_ere_ticks_added(t: EcsEreTicksDeep) -> i32 { return t.added; }
fn ecs_ere_ticks_changed(t: EcsEreTicksDeep) -> i32 { return t.changed; }
fn ecs_ere_ticks_by(t: EcsEreTicksDeep) -> i32 { return t.by; }

fn ecs_ere_deep_get_change_ticks_by_id(r: EcsEreDeep, cid: i32) -> EcsEreTicksDeep {
    if r.clen >= 1 { if r.c0 == cid { return EcsEreTicksDeep { ok: true, added: r.a0, changed: r.ch0, by: r.by0 }; }; };
    if r.clen >= 2 { if r.c1 == cid { return EcsEreTicksDeep { ok: true, added: r.a1, changed: r.ch1, by: r.by1 }; }; };
    if r.clen >= 3 { if r.c2 == cid { return EcsEreTicksDeep { ok: true, added: r.a2, changed: r.ch2, by: r.by2 }; }; };
    if r.clen >= 4 { if r.c3 == cid { return EcsEreTicksDeep { ok: true, added: r.a3, changed: r.ch3, by: r.by3 }; }; };
    return EcsEreTicksDeep { ok: false, added: 0, changed: 0, by: 0 };
}

// into_filtered: just returns entity id + clen as filtered proxy
struct EcsEreFiltDeep {
    entity_id: i32,
    clen: i32,
}

fn ecs_ere_deep_into_filtered(r: EcsEreDeep) -> EcsEreFiltDeep {
    return EcsEreFiltDeep { entity_id: r.entity_id, clen: r.clen };
}

fn ecs_ere_filt_id(f: EcsEreFiltDeep) -> i32 { return f.entity_id; }
fn ecs_ere_filt_clen(f: EcsEreFiltDeep) -> i32 { return f.clen; }
