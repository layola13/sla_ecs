// Deep self-contained Bevy ECS reflect::type_data module.
// Mirrors lib/reflect_type_data.sla (98 lines, no @import). The shallow module nests
// `EcsReflectFromWorldFns`/`EcsReflectEventFns`/`EcsReflectMapEntities` as nested
// @derive(copy) struct fields of wrapper structs (`EcsReflectFromWorld { fns: ... }`).
// Accessing `r.fns.from_world_fn` triggers the SA MemoryLeak (see docs/issue.md); the
// deep module flattens those nested fields inline into the wrapper dicts:
//   EcsReflectFromWorldDeep { from_world_fn: i64 }
//   EcsReflectEventDeep { trigger_fn, create_observer_fn, register_event_key_fn }
//   EcsReflectMapEntitiesDeep { map_entities_fn: i64 }
// and carries the accessor signatures directly on the deep struct (no child indirection).
// All structs carry @derive(copy). No @import.

// === ReflectFromWorld ===
@derive(copy)
struct EcsReflectFromWorldDeep {
    from_world_fn: i64,
}

fn ecs_reflect_from_world_deep_fns_new(fn_handle: i64) -> EcsReflectFromWorldDeep {
    return EcsReflectFromWorldDeep { from_world_fn: fn_handle };
}

fn ecs_reflect_from_world_deep_new(fns: EcsReflectFromWorldDeep) -> EcsReflectFromWorldDeep {
    return EcsReflectFromWorldDeep { from_world_fn: fns.from_world_fn };
}

fn ecs_reflect_from_world_deep_from_world(r: EcsReflectFromWorldDeep) -> i64 { return r.from_world_fn; }

// fn_pointers: returns the flattened Fns-companion (the struct itself).
fn ecs_reflect_from_world_deep_fn_pointers(r: EcsReflectFromWorldDeep) -> EcsReflectFromWorldDeep {
    return r;
}

// === ReflectEvent ===
@derive(copy)
struct EcsReflectEventDeep {
    trigger_fn: i64,
    create_observer_fn: i64,
    register_event_key_fn: i64,
}

fn ecs_reflect_event_deep_fns_new(trigger_fn: i64, create_observer_fn: i64, register_fn: i64) -> EcsReflectEventDeep {
    return EcsReflectEventDeep {
        trigger_fn: trigger_fn,
        create_observer_fn: create_observer_fn,
        register_event_key_fn: register_fn,
    };
}

fn ecs_reflect_event_deep_new(fns: EcsReflectEventDeep) -> EcsReflectEventDeep {
    return EcsReflectEventDeep {
        trigger_fn: fns.trigger_fn,
        create_observer_fn: fns.create_observer_fn,
        register_event_key_fn: fns.register_event_key_fn,
    };
}

fn ecs_reflect_event_deep_trigger(r: EcsReflectEventDeep) -> i64 { return r.trigger_fn; }
fn ecs_reflect_event_deep_create_observer(r: EcsReflectEventDeep) -> i64 { return r.create_observer_fn; }
fn ecs_reflect_event_deep_register_event_key(r: EcsReflectEventDeep) -> i64 { return r.register_event_key_fn; }

// fn_pointers: returns the flattened Fns-companion (the struct itself).
fn ecs_reflect_event_deep_fn_pointers(r: EcsReflectEventDeep) -> EcsReflectEventDeep {
    return r;
}

// === ReflectMapEntities ===
@derive(copy)
struct EcsReflectMapEntitiesDeep {
    map_entities_fn: i64,
}

fn ecs_reflect_map_entities_deep_new(fn_handle: i64) -> EcsReflectMapEntitiesDeep {
    return EcsReflectMapEntitiesDeep { map_entities_fn: fn_handle };
}

fn ecs_reflect_map_entities_deep_call(r: EcsReflectMapEntitiesDeep) -> i64 { return r.map_entities_fn; }

// === ReflectCommandExt ===
// Commands for inserting/removing components by reflection.
@derive(copy)
struct EcsReflectCommandDeep {
    kind: i32,
    type_path_handle: i64,
    component_handle: i64,
}

fn ecs_reflect_command_deep_insert(type_path: i64, component: i64) -> EcsReflectCommandDeep {
    return EcsReflectCommandDeep { kind: 0, type_path_handle: type_path, component_handle: component };
}

fn ecs_reflect_command_deep_remove(type_path: i64) -> EcsReflectCommandDeep {
    return EcsReflectCommandDeep { kind: 1, type_path_handle: type_path, component_handle: 0 };
}

fn ecs_reflect_command_deep_take(type_path: i64) -> EcsReflectCommandDeep {
    return EcsReflectCommandDeep { kind: 2, type_path_handle: type_path, component_handle: 0 };
}

fn ecs_reflect_command_deep_kind(c: EcsReflectCommandDeep) -> i32 { return c.kind; }
fn ecs_reflect_command_deep_type_path(c: EcsReflectCommandDeep) -> i64 { return c.type_path_handle; }
fn ecs_reflect_command_deep_component(c: EcsReflectCommandDeep) -> i64 { return c.component_handle; }

const ECS_REFLECT_CMD_INSERT: i32 = 0;
const ECS_REFLECT_CMD_REMOVE: i32 = 1;
const ECS_REFLECT_CMD_TAKE: i32 = 2;

fn ecs_reflect_command_deep_is_insert(c: EcsReflectCommandDeep) -> bool { return c.kind == ECS_REFLECT_CMD_INSERT; }
fn ecs_reflect_command_deep_is_remove(c: EcsReflectCommandDeep) -> bool { return c.kind == ECS_REFLECT_CMD_REMOVE; }
fn ecs_reflect_command_deep_is_take(c: EcsReflectCommandDeep) -> bool { return c.kind == ECS_REFLECT_CMD_TAKE; }
