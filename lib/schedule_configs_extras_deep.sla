// Deepened Bevy ECS ScheduleConfigs extras.
// Mirrors src/schedule/config.rs chain/run_if/ambiguous_with gaps.
// Fixed 4 systems + 4 ambiguous ids. Shallow retained.

struct EcsSceDeep {
    s0: i32, s1: i32, s2: i32, s3: i32,
    slen: i32,
    chain: bool,
    apply_deferred_on_edges: bool,
    before_id_ignore_deferred: i32,
    after_id_ignore_deferred: i32,
    distributive_conditions: i32,
    collective_conditions: i32,
    a0: i32, a1: i32, a2: i32, a3: i32,
    alen: i32,
    ambiguous_with_all: bool,
}

fn ecs_sce_deep_new() -> EcsSceDeep {
    return EcsSceDeep {
        s0: -1, s1: -1, s2: -1, s3: -1, slen: 0,
        chain: false, apply_deferred_on_edges: true,
        before_id_ignore_deferred: -1, after_id_ignore_deferred: -1,
        distributive_conditions: 0, collective_conditions: 0,
        a0: -1, a1: -1, a2: -1, a3: -1, alen: 0,
        ambiguous_with_all: false,
    };
}

fn ecs_sce_deep_rebuild(
    s0: i32, s1: i32, s2: i32, s3: i32, slen: i32,
    chain: bool, apply_deferred_on_edges: bool,
    before_id_ignore_deferred: i32, after_id_ignore_deferred: i32,
    distributive_conditions: i32, collective_conditions: i32,
    a0: i32, a1: i32, a2: i32, a3: i32, alen: i32,
    ambiguous_with_all: bool
) -> EcsSceDeep {
    return EcsSceDeep {
        s0: s0, s1: s1, s2: s2, s3: s3, slen: slen,
        chain: chain, apply_deferred_on_edges: apply_deferred_on_edges,
        before_id_ignore_deferred: before_id_ignore_deferred,
        after_id_ignore_deferred: after_id_ignore_deferred,
        distributive_conditions: distributive_conditions,
        collective_conditions: collective_conditions,
        a0: a0, a1: a1, a2: a2, a3: a3, alen: alen,
        ambiguous_with_all: ambiguous_with_all,
    };
}

fn ecs_sce_deep_len(c: EcsSceDeep) -> i32 { return c.slen; }
fn ecs_sce_deep_is_chain(c: EcsSceDeep) -> bool { return c.chain; }
fn ecs_sce_deep_applies_deferred(c: EcsSceDeep) -> bool { return c.apply_deferred_on_edges; }
fn ecs_sce_deep_distributive(c: EcsSceDeep) -> i32 { return c.distributive_conditions; }
fn ecs_sce_deep_collective(c: EcsSceDeep) -> i32 { return c.collective_conditions; }
fn ecs_sce_deep_before(c: EcsSceDeep) -> i32 { return c.before_id_ignore_deferred; }
fn ecs_sce_deep_after(c: EcsSceDeep) -> i32 { return c.after_id_ignore_deferred; }
fn ecs_sce_deep_amb_count(c: EcsSceDeep) -> i32 { return c.alen; }
fn ecs_sce_deep_amb_all(c: EcsSceDeep) -> bool { return c.ambiguous_with_all; }

fn ecs_sce_deep_system_at(c: EcsSceDeep, i: i32) -> i32 {
    if i == 0 { return c.s0; };
    if i == 1 { return c.s1; };
    if i == 2 { return c.s2; };
    if i == 3 { return c.s3; };
    return -1;
}

fn ecs_sce_deep_add(c: EcsSceDeep, system_id: i32) -> EcsSceDeep {
    if c.slen == 0 {
        return ecs_sce_deep_rebuild(system_id, c.s1, c.s2, c.s3, 1, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
    };
    if c.slen == 1 {
        return ecs_sce_deep_rebuild(c.s0, system_id, c.s2, c.s3, 2, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
    };
    if c.slen == 2 {
        return ecs_sce_deep_rebuild(c.s0, c.s1, system_id, c.s3, 3, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
    };
    if c.slen == 3 {
        return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, system_id, 4, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
    };
    return c;
}

fn ecs_sce_deep_chain(c: EcsSceDeep) -> EcsSceDeep {
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, true, true, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
}

fn ecs_sce_deep_chain_ignore_deferred(c: EcsSceDeep) -> EcsSceDeep {
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, true, false, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
}

fn ecs_sce_deep_distributive_run_if(c: EcsSceDeep, condition_id: i32) -> EcsSceDeep {
    let _ = condition_id;
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions + c.slen, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
}

fn ecs_sce_deep_run_if(c: EcsSceDeep, condition_id: i32) -> EcsSceDeep {
    let _ = condition_id;
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions + 1, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
}

fn ecs_sce_deep_before_ignore_deferred(c: EcsSceDeep, set_id: i32) -> EcsSceDeep {
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, set_id, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
}

fn ecs_sce_deep_after_ignore_deferred(c: EcsSceDeep, set_id: i32) -> EcsSceDeep {
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, set_id, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, c.ambiguous_with_all);
}

fn ecs_sce_deep_ambiguous_with(c: EcsSceDeep, set_id: i32) -> EcsSceDeep {
    if c.alen == 0 {
        return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, set_id, c.a1, c.a2, c.a3, 1, c.ambiguous_with_all);
    };
    if c.alen == 1 {
        return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, set_id, c.a2, c.a3, 2, c.ambiguous_with_all);
    };
    if c.alen == 2 {
        return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, set_id, c.a3, 3, c.ambiguous_with_all);
    };
    if c.alen == 3 {
        return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, set_id, 4, c.ambiguous_with_all);
    };
    return c;
}

fn ecs_sce_deep_ambiguous_with_all(c: EcsSceDeep) -> EcsSceDeep {
    return ecs_sce_deep_rebuild(c.s0, c.s1, c.s2, c.s3, c.slen, c.chain, c.apply_deferred_on_edges, c.before_id_ignore_deferred, c.after_id_ignore_deferred, c.distributive_conditions, c.collective_conditions, c.a0, c.a1, c.a2, c.a3, c.alen, true);
}

fn ecs_sce_deep_amb_at(c: EcsSceDeep, i: i32) -> i32 {
    if i == 0 { return c.a0; };
    if i == 1 { return c.a1; };
    if i == 2 { return c.a2; };
    if i == 3 { return c.a3; };
    return -1;
}

fn ecs_sce_deep_into_configs(c: EcsSceDeep) -> EcsSceDeep { return c; }
