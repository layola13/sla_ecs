// Deepened Bevy ECS EntityIndexSet (IndexSet<Entity> - insertion-ordered, dedup) fixed cap-8.
// Stand-in for shallow lib/entity_collections.sla subset (EntityIndexSet). Operations:
//   new, len, is_empty, contains, insert (dedup, returns (inserted_bool, set)),
//   swap_remove (O(1) order-changing), shift_remove (preserves order),
//   get_index, clear, with_capacity (no-op parity), any-into-iter marker.
// Fixed-cap array of i64 entity-bit values + count.

const ECS_ENTITY_INDEX_SET_CAP_DEEP: i32 = 8;

struct EcsEntityIndexSetDeep {
    i0: i64, i1: i64, i2: i64, i3: i64, i4: i64, i5: i64, i6: i64, i7: i64,
    count: i32,
}

struct EcsEntityIndexSetOpDeep {
    set: EcsEntityIndexSetDeep,
    inserted: i32,
}

struct EcsEntityIndexSetEntryDeep {
    set: EcsEntityIndexSetDeep,
    found: i32,
    value: i64,
}

fn ecs_entity_index_set_new() -> EcsEntityIndexSetDeep {
    let s = EcsEntityIndexSetDeep {
        i0: 0, i1: 0, i2: 0, i3: 0, i4: 0, i5: 0, i6: 0, i7: 0,
        count: 0,
    };
    return s;
}

fn ecs_entity_index_set_with_capacity(_n: i64) -> EcsEntityIndexSetDeep {
    return ecs_entity_index_set_new();
}

fn ecs_entity_index_set_len(s: EcsEntityIndexSetDeep) -> i32 { return s.count; }
fn ecs_entity_index_set_is_empty(s: EcsEntityIndexSetDeep) -> bool { return s.count == 0; }

fn ecs_entity_index_set_at(s: EcsEntityIndexSetDeep, idx: i32) -> i64 {
    if idx == 0 { return s.i0; };
    if idx == 1 { return s.i1; };
    if idx == 2 { return s.i2; };
    if idx == 3 { return s.i3; };
    if idx == 4 { return s.i4; };
    if idx == 5 { return s.i5; };
    if idx == 6 { return s.i6; };
    if idx == 7 { return s.i7; };
    return 0;
}

fn ecs_entity_index_set_set_at(s: EcsEntityIndexSetDeep, idx: i32, val: i64) -> EcsEntityIndexSetDeep {
    if idx == 0 { s.i0 = val; };
    if idx == 1 { s.i1 = val; };
    if idx == 2 { s.i2 = val; };
    if idx == 3 { s.i3 = val; };
    if idx == 4 { s.i4 = val; };
    if idx == 5 { s.i5 = val; };
    if idx == 6 { s.i6 = val; };
    if idx == 7 { s.i7 = val; };
    return s;
}

fn ecs_entity_index_set_contains(s: EcsEntityIndexSetDeep, item: i64) -> bool {
    let i: i32 = 0;
    while i < s.count {
        if ecs_entity_index_set_at(s, i) == item { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_entity_index_set_get_index(s: EcsEntityIndexSetDeep, item: i64) -> i32 {
    let i: i32 = 0;
    while i < s.count {
        if ecs_entity_index_set_at(s, i) == item { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_op_result_new(set: EcsEntityIndexSetDeep, inserted: i32) -> EcsEntityIndexSetOpDeep {
    return EcsEntityIndexSetOpDeep { set: set, inserted: inserted };
}
fn ecs_entity_index_set_op_set(r: EcsEntityIndexSetOpDeep) -> EcsEntityIndexSetDeep { return r.set; }
fn ecs_entity_index_set_op_inserted(r: EcsEntityIndexSetOpDeep) -> i32 { return r.inserted; }

fn ecs_entry_result_new(set: EcsEntityIndexSetDeep, found: i32, value: i64) -> EcsEntityIndexSetEntryDeep {
    return EcsEntityIndexSetEntryDeep { set: set, found: found, value: value };
}
fn ecs_entity_index_set_entry_set(r: EcsEntityIndexSetEntryDeep) -> EcsEntityIndexSetDeep { return r.set; }
fn ecs_entity_index_set_entry_found(r: EcsEntityIndexSetEntryDeep) -> i32 { return r.found; }
fn ecs_entity_index_set_entry_value(r: EcsEntityIndexSetEntryDeep) -> i64 { return r.value; }

fn ecs_entity_index_set_insert(s: EcsEntityIndexSetDeep, item: i64) -> EcsEntityIndexSetOpDeep {
    if ecs_entity_index_set_contains(s, item) { return ecs_op_result_new(s, 0); };
    if s.count >= ECS_ENTITY_INDEX_SET_CAP_DEEP { return ecs_op_result_new(s, 0); };
    s = ecs_entity_index_set_set_at(s, s.count, item);
    s.count = s.count + 1;
    return ecs_op_result_new(s, 1);
}

// swap_remove: O(1) removal that swaps last into removed slot (changes iteration order).
fn ecs_entity_index_set_swap_remove(s: EcsEntityIndexSetDeep, item: i64) -> EcsEntityIndexSetOpDeep {
    let idx = ecs_entity_index_set_get_index(s, item);
    if idx < 0 { return ecs_op_result_new(s, 0); };
    let last = s.count - 1;
    if idx != last {
        let last_val = ecs_entity_index_set_at(s, last);
        s = ecs_entity_index_set_set_at(s, idx, last_val);
    };
    s = ecs_entity_index_set_set_at(s, last, 0);
    s.count = s.count - 1;
    return ecs_op_result_new(s, 1);
}

// shift_remove: O(n) removal preserving insertion order (matches IndexSet::shift_remove).
fn ecs_entity_index_set_shift_remove(s: EcsEntityIndexSetDeep, item: i64) -> EcsEntityIndexSetOpDeep {
    let idx = ecs_entity_index_set_get_index(s, item);
    if idx < 0 { return ecs_op_result_new(s, 0); };
    let last = s.count - 1;
    // Shift elements after idx left by one.
    let j: i32 = idx;
    while j < last {
        let shifted = ecs_entity_index_set_at(s, j + 1);
        s = ecs_entity_index_set_set_at(s, j, shifted);
        j = j + 1;
    }
    s = ecs_entity_index_set_set_at(s, last, 0);
    s.count = s.count - 1;
    return ecs_op_result_new(s, 1);
}

fn ecs_entity_index_set_clear(s: EcsEntityIndexSetDeep) -> EcsEntityIndexSetDeep {
    return ecs_entity_index_set_new();
}

// any marker: returns true if any element matches predicate id-equivalence (item == elem).
fn ecs_entity_index_set_any(s: EcsEntityIndexSetDeep, item: i64) -> bool {
    return ecs_entity_index_set_contains(s, item);
}

// into_iter marker: returns the same set (samples are tested via at-index accessors).
fn ecs_entity_index_set_into_iter(s: EcsEntityIndexSetDeep) -> EcsEntityIndexSetDeep {
    return s;
}
