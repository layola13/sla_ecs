// Bevy ECS entity_set.rs iterator/equivalence surface.
// Covers ContainsEntity / EntityEquivalent value wrappers, UniqueEntityIter,
// EntitySetIterator::collect_set, and FromEntitySetIterator-style construction.

struct EcsEntityEquivalentValue {
    entity: i64,
    wrapper_kind: i32,
}

struct EcsUniqueEntityIter {
    items: Vec<i64>,
    front: i64,
    back: i64,
    trusted_unique: i32,
}

struct EcsUniqueEntityIterNext {
    iter: EcsUniqueEntityIter,
    has: i32,
    entity: i64,
}

struct EcsEntitySetCollect {
    items: Vec<i64>,
    inserted_count: i64,
    first_entity: i64,
    trusted_unique: i32,
}

fn ecs_contains_entity_direct(entity: i64) -> EcsEntityEquivalentValue {
    return EcsEntityEquivalentValue { entity: entity, wrapper_kind: 0 };
}

fn ecs_contains_entity_ref(value: EcsEntityEquivalentValue) -> EcsEntityEquivalentValue {
    return EcsEntityEquivalentValue { entity: value.entity, wrapper_kind: 1 };
}

fn ecs_contains_entity_mut(value: EcsEntityEquivalentValue) -> EcsEntityEquivalentValue {
    return EcsEntityEquivalentValue { entity: value.entity, wrapper_kind: 2 };
}

fn ecs_contains_entity_box(value: EcsEntityEquivalentValue) -> EcsEntityEquivalentValue {
    return EcsEntityEquivalentValue { entity: value.entity, wrapper_kind: 3 };
}

fn ecs_contains_entity_rc(value: EcsEntityEquivalentValue) -> EcsEntityEquivalentValue {
    return EcsEntityEquivalentValue { entity: value.entity, wrapper_kind: 4 };
}

fn ecs_contains_entity_arc(value: EcsEntityEquivalentValue) -> EcsEntityEquivalentValue {
    return EcsEntityEquivalentValue { entity: value.entity, wrapper_kind: 5 };
}

fn ecs_entity_equivalent_entity(value: EcsEntityEquivalentValue) -> i64 { return value.entity; }

fn ecs_entity_equivalent_same(a: EcsEntityEquivalentValue, b: EcsEntityEquivalentValue) -> bool {
    return a.entity == b.entity;
}

fn ecs_entity_equivalent_cmp(a: EcsEntityEquivalentValue, b: EcsEntityEquivalentValue) -> i32 {
    if a.entity < b.entity { return -1; };
    if a.entity > b.entity { return 1; };
    return 0;
}

fn ecs_unique_entity_iter_from_vec_unchecked(items: Vec<i64>) -> EcsUniqueEntityIter {
    return EcsUniqueEntityIter { items: items, front: 0, back: len(items) as i64, trusted_unique: 1 };
}

fn ecs_unique_entity_iter_from_entity_set_iter(items: Vec<i64>) -> EcsUniqueEntityIter {
    return ecs_unique_entity_iter_from_vec_unchecked(items);
}

fn ecs_unique_entity_iter_empty() -> EcsUniqueEntityIter {
    let items: Vec<i64> = Vec::new();
    return ecs_unique_entity_iter_from_vec_unchecked(items);
}

fn ecs_unique_entity_iter_remaining(iter: EcsUniqueEntityIter) -> i64 {
    let remaining = iter.back - iter.front;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_unique_entity_iter_is_empty(iter: EcsUniqueEntityIter) -> bool {
    return ecs_unique_entity_iter_remaining(iter) == 0;
}

fn ecs_unique_entity_iter_next(iter: EcsUniqueEntityIter) -> EcsUniqueEntityIterNext {
    if iter.front >= iter.back {
        return EcsUniqueEntityIterNext { iter: iter, has: 0, entity: -1 };
    };
    let entity = iter.items[iter.front];
    iter.front = iter.front + 1;
    return EcsUniqueEntityIterNext { iter: iter, has: 1, entity: entity };
}

fn ecs_unique_entity_iter_next_back(iter: EcsUniqueEntityIter) -> EcsUniqueEntityIterNext {
    if iter.front >= iter.back {
        return EcsUniqueEntityIterNext { iter: iter, has: 0, entity: -1 };
    };
    iter.back = iter.back - 1;
    let entity = iter.items[iter.back];
    return EcsUniqueEntityIterNext { iter: iter, has: 1, entity: entity };
}

fn ecs_unique_entity_iter_into_inner(iter: EcsUniqueEntityIter) -> Vec<i64> {
    return iter.items;
}

fn ecs_entity_set_collect_set(iter: EcsUniqueEntityIter) -> EcsEntitySetCollect {
    let out: Vec<i64> = Vec::new();
    let i = iter.front;
    while i < iter.back {
        out.push(iter.items[i]);
        i = i + 1;
    }
    let inserted = len(out) as i64;
    let first = -1;
    if inserted > 0 { first = out[0]; };
    return EcsEntitySetCollect { items: out, inserted_count: inserted, first_entity: first, trusted_unique: iter.trusted_unique };
}

fn ecs_from_entity_set_iter_hashset(iter: EcsUniqueEntityIter) -> EcsEntitySetCollect {
    // Bevy HashSet FromEntitySetIterator uses insert_unique_unchecked. The model preserves
    // the iterator payload exactly instead of deduplicating an arbitrary iterator.
    return ecs_entity_set_collect_set(iter);
}

fn ecs_entity_set_collect_len(collected: EcsEntitySetCollect) -> i64 { return len(collected.items) as i64; }

fn ecs_entity_set_collect_at(collected: EcsEntitySetCollect, index: i64) -> i64 {
    if index < 0 { return -1; };
    if index >= len(collected.items) as i64 { return -1; };
    return collected.items[index];
}

fn ecs_entity_set_collect_contains(collected: EcsEntitySetCollect, entity: i64) -> bool {
    let i: i64 = 0;
    let n = len(collected.items) as i64;
    while i < n {
        if collected.items[i] == entity { return true; };
        i = i + 1;
    }
    return false;
}

