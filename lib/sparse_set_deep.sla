// Deepened Bevy ECS sparse_set surface.
// Mirrors src/storage/sparse_set.rs:
//   SparseArray contains/get/insert/remove/clear
//   SparseSet dense+indices+sparse: insert overwrite, get_or_insert, swap-remove, capacity
//   ComponentSparseSet entity->value+added/changed ticks, get_with_ticks
//   SparseSets multi ComponentId registry
// Shallow lib/sparse_set.sla retained.

// === SparseArray (index -> dense pos or -1), capacity 16 ===
struct EcsSaDeep {
    // sparse slots: -1 empty else dense index
    s0: i32, s1: i32, s2: i32, s3: i32,
    s4: i32, s5: i32, s6: i32, s7: i32,
    s8: i32, s9: i32, s10: i32, s11: i32,
    s12: i32, s13: i32, s14: i32, s15: i32,
    bound: i32, // highest index+1 ever used
}

fn ecs_sa_new() -> EcsSaDeep {
    return EcsSaDeep {
        s0: -1, s1: -1, s2: -1, s3: -1, s4: -1, s5: -1, s6: -1, s7: -1,
        s8: -1, s9: -1, s10: -1, s11: -1, s12: -1, s13: -1, s14: -1, s15: -1,
        bound: 0,
    };
}

fn ecs_sa_get_slot(a: EcsSaDeep, index: i32) -> i32 {
    if index == 0 { return a.s0; };
    if index == 1 { return a.s1; };
    if index == 2 { return a.s2; };
    if index == 3 { return a.s3; };
    if index == 4 { return a.s4; };
    if index == 5 { return a.s5; };
    if index == 6 { return a.s6; };
    if index == 7 { return a.s7; };
    if index == 8 { return a.s8; };
    if index == 9 { return a.s9; };
    if index == 10 { return a.s10; };
    if index == 11 { return a.s11; };
    if index == 12 { return a.s12; };
    if index == 13 { return a.s13; };
    if index == 14 { return a.s14; };
    if index == 15 { return a.s15; };
    return -1;
}

fn ecs_sa_set_slot(a: EcsSaDeep, index: i32, val: i32) -> EcsSaDeep {
    let b = a.bound;
    if index + 1 > b { b = index + 1; };
    if index == 0 { return EcsSaDeep { s0: val, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 1 { return EcsSaDeep { s0: a.s0, s1: val, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 2 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: val, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 3 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: val, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 4 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: val, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 5 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: val, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 6 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: val, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 7 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: val, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 8 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: val, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 9 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: val, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 10 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: val, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 11 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: val, s12: a.s12, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 12 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: val, s13: a.s13, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 13 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: val, s14: a.s14, s15: a.s15, bound: b }; };
    if index == 14 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: val, s15: a.s15, bound: b }; };
    if index == 15 { return EcsSaDeep { s0: a.s0, s1: a.s1, s2: a.s2, s3: a.s3, s4: a.s4, s5: a.s5, s6: a.s6, s7: a.s7, s8: a.s8, s9: a.s9, s10: a.s10, s11: a.s11, s12: a.s12, s13: a.s13, s14: a.s14, s15: val, bound: b }; };
    return a;
}

fn ecs_sa_contains(a: EcsSaDeep, index: i32) -> bool {
    if index < 0 || index >= 16 { return false; };
    return ecs_sa_get_slot(a, index) >= 0;
}

fn ecs_sa_get(a: EcsSaDeep, index: i32) -> (bool, i32) {
    if index < 0 || index >= 16 { return (false, -1); };
    let v = ecs_sa_get_slot(a, index);
    if v < 0 { return (false, -1); };
    return (true, v);
}

fn ecs_sa_insert(a: EcsSaDeep, index: i32, dense_pos: i32) -> EcsSaDeep {
    return ecs_sa_set_slot(a, index, dense_pos);
}

fn ecs_sa_remove(a: EcsSaDeep, index: i32) -> (EcsSaDeep, bool, i32) {
    let g = ecs_sa_get(a, index);
    if g.0 != true { return (a, false, -1); };
    a = ecs_sa_set_slot(a, index, -1);
    return (a, true, g.1);
}

fn ecs_sa_clear(a: EcsSaDeep) -> EcsSaDeep {
    return ecs_sa_new();
}

// === SparseSet dense capacity 8 ===
struct EcsSsDeep {
    sparse: EcsSaDeep,
    // dense values
    d0: i64, d1: i64, d2: i64, d3: i64, d4: i64, d5: i64, d6: i64, d7: i64,
    // dense indices (keys)
    i0: i32, i1: i32, i2: i32, i3: i32, i4: i32, i5: i32, i6: i32, i7: i32,
    len: i32,
    capacity: i32,
}

fn ecs_ss_new() -> EcsSsDeep {
    return EcsSsDeep {
        sparse: ecs_sa_new(),
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        i0: 0, i1: 0, i2: 0, i3: 0, i4: 0, i5: 0, i6: 0, i7: 0,
        len: 0, capacity: 8,
    };
}

fn ecs_ss_with_capacity(cap: i32) -> EcsSsDeep {
    let s = ecs_ss_new();
    return EcsSsDeep {
        sparse: s.sparse,
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        i0: 0, i1: 0, i2: 0, i3: 0, i4: 0, i5: 0, i6: 0, i7: 0,
        len: 0, capacity: cap,
    };
}

fn ecs_ss_len(s: EcsSsDeep) -> i32 { return s.len; }
fn ecs_ss_is_empty(s: EcsSsDeep) -> bool { return s.len == 0; }
fn ecs_ss_capacity(s: EcsSsDeep) -> i32 { return s.capacity; }

fn ecs_ss_dense_at(s: EcsSsDeep, pos: i32) -> i64 {
    if pos == 0 { return s.d0; };
    if pos == 1 { return s.d1; };
    if pos == 2 { return s.d2; };
    if pos == 3 { return s.d3; };
    if pos == 4 { return s.d4; };
    if pos == 5 { return s.d5; };
    if pos == 6 { return s.d6; };
    if pos == 7 { return s.d7; };
    return 0;
}

fn ecs_ss_index_at(s: EcsSsDeep, pos: i32) -> i32 {
    if pos == 0 { return s.i0; };
    if pos == 1 { return s.i1; };
    if pos == 2 { return s.i2; };
    if pos == 3 { return s.i3; };
    if pos == 4 { return s.i4; };
    if pos == 5 { return s.i5; };
    if pos == 6 { return s.i6; };
    if pos == 7 { return s.i7; };
    return 0;
}

fn ecs_ss_set_dense(s: EcsSsDeep, pos: i32, val: i64, key: i32) -> EcsSsDeep {
    if pos == 0 {
        return EcsSsDeep { sparse: s.sparse, d0: val, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7, i0: key, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 1 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: val, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7, i0: s.i0, i1: key, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 2 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: s.d1, d2: val, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7, i0: s.i0, i1: s.i1, i2: key, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 3 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: s.d1, d2: s.d2, d3: val, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7, i0: s.i0, i1: s.i1, i2: s.i2, i3: key, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 4 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: val, d5: s.d5, d6: s.d6, d7: s.d7, i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: key, i5: s.i5, i6: s.i6, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 5 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: val, d6: s.d6, d7: s.d7, i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: key, i6: s.i6, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 6 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: val, d7: s.d7, i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: key, i7: s.i7, len: s.len, capacity: s.capacity };
    };
    if pos == 7 {
        return EcsSsDeep { sparse: s.sparse, d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: val, i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: key, len: s.len, capacity: s.capacity };
    };
    return s;
}

fn ecs_ss_contains(s: EcsSsDeep, index: i32) -> bool {
    return ecs_sa_contains(s.sparse, index);
}

fn ecs_ss_get(s: EcsSsDeep, index: i32) -> (bool, i64) {
    let g = ecs_sa_get(s.sparse, index);
    if g.0 != true { return (false, 0); };
    return (true, ecs_ss_dense_at(s, g.1));
}

fn ecs_ss_insert(s: EcsSsDeep, index: i32, value: i64) -> EcsSsDeep {
    let g = ecs_sa_get(s.sparse, index);
    if g.0 {
        // overwrite dense
        let key = ecs_ss_index_at(s, g.1);
        return ecs_ss_set_dense(s, g.1, value, key);
    };
    if s.len >= 8 { return s; };
    let pos = s.len;
    s = ecs_ss_set_dense(s, pos, value, index);
    let sparse = ecs_sa_insert(s.sparse, index, pos);
    return EcsSsDeep {
        sparse: sparse,
        d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7,
        i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7,
        len: pos + 1, capacity: s.capacity,
    };
}

fn ecs_ss_get_or_insert_with(s: EcsSsDeep, index: i32, default_val: i64) -> (EcsSsDeep, i64) {
    let g = ecs_ss_get(s, index);
    if g.0 { return (s, g.1); };
    s = ecs_ss_insert(s, index, default_val);
    return (s, default_val);
}

fn ecs_ss_remove(s: EcsSsDeep, index: i32) -> (EcsSsDeep, bool, i64) {
    let g = ecs_sa_get(s.sparse, index);
    if g.0 != true { return (s, false, 0); };
    let pos = g.1;
    let val = ecs_ss_dense_at(s, pos);
    let last = s.len - 1;
    if pos != last {
        let last_val = ecs_ss_dense_at(s, last);
        let last_key = ecs_ss_index_at(s, last);
        s = ecs_ss_set_dense(s, pos, last_val, last_key);
        s = EcsSsDeep {
            sparse: ecs_sa_insert(s.sparse, last_key, pos),
            d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7,
            i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7,
            len: s.len, capacity: s.capacity,
        };
    };
    let sparse = ecs_sa_set_slot(s.sparse, index, -1);
    return (EcsSsDeep {
        sparse: sparse,
        d0: s.d0, d1: s.d1, d2: s.d2, d3: s.d3, d4: s.d4, d5: s.d5, d6: s.d6, d7: s.d7,
        i0: s.i0, i1: s.i1, i2: s.i2, i3: s.i3, i4: s.i4, i5: s.i5, i6: s.i6, i7: s.i7,
        len: last, capacity: s.capacity,
    }, true, val);
}

fn ecs_ss_clear(s: EcsSsDeep) -> EcsSsDeep {
    return EcsSsDeep {
        sparse: ecs_sa_clear(s.sparse),
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        i0: 0, i1: 0, i2: 0, i3: 0, i4: 0, i5: 0, i6: 0, i7: 0,
        len: 0, capacity: s.capacity,
    };
}

fn ecs_ss_index_at_dense(s: EcsSsDeep, pos: i32) -> i32 { return ecs_ss_index_at(s, pos); }

// === ComponentSparseSet (entity index -> value + ticks), capacity 4 ===
struct EcsCssDeep {
    e0: i64, v0: i64, a0: i32, c0: i32, by0: i32,
    e1: i64, v1: i64, a1: i32, c1: i32, by1: i32,
    e2: i64, v2: i64, a2: i32, c2: i32, by2: i32,
    e3: i64, v3: i64, a3: i32, c3: i32, by3: i32,
    len: i32,
    drop_id: i32,
}

fn ecs_css_new(drop_id: i32) -> EcsCssDeep {
    return EcsCssDeep {
        e0: 0, v0: 0, a0: 0, c0: 0, by0: 0,
        e1: 0, v1: 0, a1: 0, c1: 0, by1: 0,
        e2: 0, v2: 0, a2: 0, c2: 0, by2: 0,
        e3: 0, v3: 0, a3: 0, c3: 0, by3: 0,
        len: 0, drop_id: drop_id,
    };
}

fn ecs_css_len(c: EcsCssDeep) -> i32 { return c.len; }
fn ecs_css_is_empty(c: EcsCssDeep) -> bool { return c.len == 0; }
fn ecs_css_drop_id(c: EcsCssDeep) -> i32 { return c.drop_id; }

fn ecs_css_find(c: EcsCssDeep, entity: i64) -> i32 {
    if c.len >= 1 && c.e0 == entity { return 0; };
    if c.len >= 2 && c.e1 == entity { return 1; };
    if c.len >= 3 && c.e2 == entity { return 2; };
    if c.len >= 4 && c.e3 == entity { return 3; };
    return -1;
}

fn ecs_css_contains(c: EcsCssDeep, entity: i64) -> bool {
    return ecs_css_find(c, entity) >= 0;
}

fn ecs_css_get(c: EcsCssDeep, entity: i64) -> (bool, i64) {
    let i = ecs_css_find(c, entity);
    if i == 0 { return (true, c.v0); };
    if i == 1 { return (true, c.v1); };
    if i == 2 { return (true, c.v2); };
    if i == 3 { return (true, c.v3); };
    return (false, 0);
}

fn ecs_css_get_with_ticks(c: EcsCssDeep, entity: i64) -> (bool, i64, i32, i32, i32) {
    let i = ecs_css_find(c, entity);
    if i == 0 { return (true, c.v0, c.a0, c.c0, c.by0); };
    if i == 1 { return (true, c.v1, c.a1, c.c1, c.by1); };
    if i == 2 { return (true, c.v2, c.a2, c.c2, c.by2); };
    if i == 3 { return (true, c.v3, c.a3, c.c3, c.by3); };
    return (false, 0, 0, 0, 0);
}

fn ecs_css_insert(c: EcsCssDeep, entity: i64, value: i64, tick: i32, changed_by: i32) -> EcsCssDeep {
    let i = ecs_css_find(c, entity);
    if i == 0 {
        return EcsCssDeep {
            e0: entity, v0: value, a0: c.a0, c0: tick, by0: changed_by,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: c.len, drop_id: c.drop_id,
        };
    };
    if i == 1 {
        return EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: entity, v1: value, a1: c.a1, c1: tick, by1: changed_by,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: c.len, drop_id: c.drop_id,
        };
    };
    if i == 2 {
        return EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: entity, v2: value, a2: c.a2, c2: tick, by2: changed_by,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: c.len, drop_id: c.drop_id,
        };
    };
    if i == 3 {
        return EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: entity, v3: value, a3: c.a3, c3: tick, by3: changed_by,
            len: c.len, drop_id: c.drop_id,
        };
    };
    let n = c.len;
    if n == 0 {
        return EcsCssDeep {
            e0: entity, v0: value, a0: tick, c0: tick, by0: changed_by,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: 1, drop_id: c.drop_id,
        };
    };
    if n == 1 {
        return EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: entity, v1: value, a1: tick, c1: tick, by1: changed_by,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: 2, drop_id: c.drop_id,
        };
    };
    if n == 2 {
        return EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: entity, v2: value, a2: tick, c2: tick, by2: changed_by,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: 3, drop_id: c.drop_id,
        };
    };
    if n == 3 {
        return EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: entity, v3: value, a3: tick, c3: tick, by3: changed_by,
            len: 4, drop_id: c.drop_id,
        };
    };
    return c;
}

fn ecs_css_remove(c: EcsCssDeep, entity: i64) -> (EcsCssDeep, bool, i64) {
    let i = ecs_css_find(c, entity);
    if i < 0 { return (c, false, 0); };
    let val = 0;
    if i == 0 { val = c.v0; };
    if i == 1 { val = c.v1; };
    if i == 2 { val = c.v2; };
    if i == 3 { val = c.v3; };
    // swap with last
    let last = c.len - 1;
    let le = 0; let lv = 0; let la = 0; let lc = 0; let lby = 0;
    if last == 0 { le = c.e0; lv = c.v0; la = c.a0; lc = c.c0; lby = c.by0; };
    if last == 1 { le = c.e1; lv = c.v1; la = c.a1; lc = c.c1; lby = c.by1; };
    if last == 2 { le = c.e2; lv = c.v2; la = c.a2; lc = c.c2; lby = c.by2; };
    if last == 3 { le = c.e3; lv = c.v3; la = c.a3; lc = c.c3; lby = c.by3; };
    if i == 0 {
        c = EcsCssDeep {
            e0: le, v0: lv, a0: la, c0: lc, by0: lby,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: last, drop_id: c.drop_id,
        };
    };
    if i == 1 {
        c = EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: le, v1: lv, a1: la, c1: lc, by1: lby,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: last, drop_id: c.drop_id,
        };
    };
    if i == 2 {
        c = EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: le, v2: lv, a2: la, c2: lc, by2: lby,
            e3: c.e3, v3: c.v3, a3: c.a3, c3: c.c3, by3: c.by3,
            len: last, drop_id: c.drop_id,
        };
    };
    if i == 3 {
        c = EcsCssDeep {
            e0: c.e0, v0: c.v0, a0: c.a0, c0: c.c0, by0: c.by0,
            e1: c.e1, v1: c.v1, a1: c.a1, c1: c.c1, by1: c.by1,
            e2: c.e2, v2: c.v2, a2: c.a2, c2: c.c2, by2: c.by2,
            e3: le, v3: lv, a3: la, c3: lc, by3: lby,
            len: last, drop_id: c.drop_id,
        };
    };
    return (c, true, val);
}

// === SparseSets registry: up to 4 component sparse sets by component_id ===
struct EcsSparseSetsDeep {
    id0: i32, set0: EcsCssDeep, has0: bool,
    id1: i32, set1: EcsCssDeep, has1: bool,
    id2: i32, set2: EcsCssDeep, has2: bool,
    id3: i32, set3: EcsCssDeep, has3: bool,
    len: i32,
}

fn ecs_sparse_sets_new() -> EcsSparseSetsDeep {
    return EcsSparseSetsDeep {
        id0: 0, set0: ecs_css_new(0), has0: false,
        id1: 0, set1: ecs_css_new(0), has1: false,
        id2: 0, set2: ecs_css_new(0), has2: false,
        id3: 0, set3: ecs_css_new(0), has3: false,
        len: 0,
    };
}

fn ecs_sparse_sets_len(s: EcsSparseSetsDeep) -> i32 { return s.len; }
fn ecs_sparse_sets_is_empty(s: EcsSparseSetsDeep) -> bool { return s.len == 0; }

fn ecs_sparse_sets_get(s: EcsSparseSetsDeep, component_id: i32) -> (bool, EcsCssDeep) {
    if s.has0 && s.id0 == component_id { return (true, s.set0); };
    if s.has1 && s.id1 == component_id { return (true, s.set1); };
    if s.has2 && s.id2 == component_id { return (true, s.set2); };
    if s.has3 && s.id3 == component_id { return (true, s.set3); };
    return (false, ecs_css_new(0));
}

fn ecs_sparse_sets_get_or_insert(s: EcsSparseSetsDeep, component_id: i32, drop_id: i32) -> (EcsSparseSetsDeep, EcsCssDeep) {
    let g = ecs_sparse_sets_get(s, component_id);
    if g.0 { return (s, g.1); };
    let set = ecs_css_new(drop_id);
    if s.len == 0 {
        s = EcsSparseSetsDeep {
            id0: component_id, set0: set, has0: true,
            id1: s.id1, set1: s.set1, has1: s.has1,
            id2: s.id2, set2: s.set2, has2: s.has2,
            id3: s.id3, set3: s.set3, has3: s.has3,
            len: 1,
        };
        return (s, set);
    };
    if s.len == 1 {
        s = EcsSparseSetsDeep {
            id0: s.id0, set0: s.set0, has0: s.has0,
            id1: component_id, set1: set, has1: true,
            id2: s.id2, set2: s.set2, has2: s.has2,
            id3: s.id3, set3: s.set3, has3: s.has3,
            len: 2,
        };
        return (s, set);
    };
    if s.len == 2 {
        s = EcsSparseSetsDeep {
            id0: s.id0, set0: s.set0, has0: s.has0,
            id1: s.id1, set1: s.set1, has1: s.has1,
            id2: component_id, set2: set, has2: true,
            id3: s.id3, set3: s.set3, has3: s.has3,
            len: 3,
        };
        return (s, set);
    };
    if s.len == 3 {
        s = EcsSparseSetsDeep {
            id0: s.id0, set0: s.set0, has0: s.has0,
            id1: s.id1, set1: s.set1, has1: s.has1,
            id2: s.id2, set2: s.set2, has2: s.has2,
            id3: component_id, set3: set, has3: true,
            len: 4,
        };
        return (s, set);
    };
    return (s, set);
}

fn ecs_sparse_sets_set(s: EcsSparseSetsDeep, component_id: i32, set: EcsCssDeep) -> EcsSparseSetsDeep {
    if s.has0 && s.id0 == component_id {
        return EcsSparseSetsDeep {
            id0: s.id0, set0: set, has0: true,
            id1: s.id1, set1: s.set1, has1: s.has1,
            id2: s.id2, set2: s.set2, has2: s.has2,
            id3: s.id3, set3: s.set3, has3: s.has3,
            len: s.len,
        };
    };
    if s.has1 && s.id1 == component_id {
        return EcsSparseSetsDeep {
            id0: s.id0, set0: s.set0, has0: s.has0,
            id1: s.id1, set1: set, has1: true,
            id2: s.id2, set2: s.set2, has2: s.has2,
            id3: s.id3, set3: s.set3, has3: s.has3,
            len: s.len,
        };
    };
    if s.has2 && s.id2 == component_id {
        return EcsSparseSetsDeep {
            id0: s.id0, set0: s.set0, has0: s.has0,
            id1: s.id1, set1: s.set1, has1: s.has1,
            id2: s.id2, set2: set, has2: true,
            id3: s.id3, set3: s.set3, has3: s.has3,
            len: s.len,
        };
    };
    if s.has3 && s.id3 == component_id {
        return EcsSparseSetsDeep {
            id0: s.id0, set0: s.set0, has0: s.has0,
            id1: s.id1, set1: s.set1, has1: s.has1,
            id2: s.id2, set2: s.set2, has2: s.has2,
            id3: s.id3, set3: set, has3: true,
            len: s.len,
        };
    };
    let r = ecs_sparse_sets_get_or_insert(s, component_id, set.drop_id);
    return ecs_sparse_sets_set(r.0, component_id, set);
}
