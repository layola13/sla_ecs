fn _ecs_table_deep_get_col_data(t: EcsTableDeep, col_idx: i64, row_idx: i32) -> i64 {
    if col_idx == 0 {
        if row_idx == 0 { return t.col0_data0; };
        if row_idx == 1 { return t.col0_data1; };
        if row_idx == 2 { return t.col0_data2; };
        if row_idx == 3 { return t.col0_data3; };
