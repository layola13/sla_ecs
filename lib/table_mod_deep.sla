// Deepened Bevy ECS storage Table / Tables collection (src/storage/table/mod.rs).
// Shallow: lib/table_mod.sla (Vec-backed Table + TableId + TableRow + Tables collection).
//
// The deep variant mirrors the shallow surface with a fixed-cap structured storage: cap-4
// component columns × cap-8 entity rows (parallel-array flattened — per column 8 data cells +
// 8 added-tick cells + 8 changed-tick cells, plus a component-id per column). No Vec, no
// recursion. Tuple-return callsites (allocate, get, set, get_added_tick, get_changed_tick,
// swap_remove, get_entity_at_row, tables_get, tables_create) are exposed as scalar wrapper
// structs — Batch 373 observation: `let (a, b) = tuple_fn()` destructuring retroactively corrupts
// prior assertions on the SA backend. Field-assign on struct-by-value params is SLA-legal on SA
// (verified in Batch 374) so allocate/set/swap_remove use direct field-assign (no slot-view
// rebuild). Cap reject is silent (returns the struct unchanged, ok=false) to mirror the
// `if row < 0 / row >= n` guards returning `(t, false)`.
//
// Intentional leave-outs: no Vec backing (replaced by fixed-cap slot buffer); no real heap
// allocation; columns are zero-initialised data (drop fn always reported as present — N/A here,
// get_drop_for mirrors the shallow's has_column predicate).
//
// Field layout (cap-4 cols x cap-8 rows):
//   id: i32, capacity: i64
//   entity0..entity7: i64, entity_count: i32
//   comp_id0..comp_id3: i32, column_count: i32
//   col0_data0..col0_data7 i64, col0_added0..col0_added7 i64, col0_changed0..col0_changed7 i64
//   col1_data0..col1_data7 i64, col1_added0..col1_added7 i64, col1_changed0..col1_changed7 i64
//   col2_data0..col2_data7 i64, col2_added0..col2_added7 i64, col2_changed0..col2_changed7 i64
//   col3_data0..col3_data7 i64, col3_added0..col3_added7 i64, col3_changed0..col3_changed7 i64

const ECS_TABLE_DEEP_COL_CAP: i32 = 4;
const ECS_TABLE_DEEP_ROW_CAP: i32 = 8;
const ECS_TABLES_DEEP_CAP: i32 = 8;

struct EcsTableIdDeep { value: i32 }

fn ecs_table_id_deep_new(value: i32) -> EcsTableIdDeep {
    return EcsTableIdDeep { value: value };
}
fn ecs_table_id_deep_value(id: EcsTableIdDeep) -> i32 { return id.value; }
fn ecs_table_id_deep_index(id: EcsTableIdDeep) -> i32 { return id.value; }

struct EcsTableRowDeep { value: i32 }

fn ecs_table_row_deep_new(value: i32) -> EcsTableRowDeep {
    return EcsTableRowDeep { value: value };
}
fn ecs_table_row_deep_value(r: EcsTableRowDeep) -> i32 { return r.value; }
fn ecs_table_row_deep_index(r: EcsTableRowDeep) -> i32 { return r.value; }

struct EcsTableDeep {
    id: i32,
    capacity: i64,
    entity0: i64, entity1: i64, entity2: i64, entity3: i64,
    entity4: i64, entity5: i64, entity6: i64, entity7: i64,
    entity_count: i32,
    comp_id0: i32, comp_id1: i32, comp_id2: i32, comp_id3: i32,
    column_count: i32,
    col0_data0: i64, col0_data1: i64, col0_data2: i64, col0_data3: i64, col0_data4: i64, col0_data5: i64, col0_data6: i64, col0_data7: i64,
    col0_added0: i64, col0_added1: i64, col0_added2: i64, col0_added3: i64, col0_added4: i64, col0_added5: i64, col0_added6: i64, col0_added7: i64,
    col0_changed0: i64, col0_changed1: i64, col0_changed2: i64, col0_changed3: i64, col0_changed4: i64, col0_changed5: i64, col0_changed6: i64, col0_changed7: i64,
    col1_data0: i64, col1_data1: i64, col1_data2: i64, col1_data3: i64, col1_data4: i64, col1_data5: i64, col1_data6: i64, col1_data7: i64,
    col1_added0: i64, col1_added1: i64, col1_added2: i64, col1_added3: i64, col1_added4: i64, col1_added5: i64, col1_added6: i64, col1_added7: i64,
    col1_changed0: i64, col1_changed1: i64, col1_changed2: i64, col1_changed3: i64, col1_changed4: i64, col1_changed5: i64, col1_changed6: i64, col1_changed7: i64,
    col2_data0: i64, col2_data1: i64, col2_data2: i64, col2_data3: i64, col2_data4: i64, col2_data5: i64, col2_data6: i64, col2_data7: i64,
    col2_added0: i64, col2_added1: i64, col2_added2: i64, col2_added3: i64, col2_added4: i64, col2_added5: i64, col2_added6: i64, col2_added7: i64,
    col2_changed0: i64, col2_changed1: i64, col2_changed2: i64, col2_changed3: i64, col2_changed4: i64, col2_changed5: i64, col2_changed6: i64, col2_changed7: i64,
    col3_data0: i64, col3_data1: i64, col3_data2: i64, col3_data3: i64, col3_data4: i64, col3_data5: i64, col3_data6: i64, col3_data7: i64,
    col3_added0: i64, col3_added1: i64, col3_added2: i64, col3_added3: i64, col3_added4: i64, col3_added5: i64, col3_added6: i64, col3_added7: i64,
    col3_changed0: i64, col3_changed1: i64, col3_changed2: i64, col3_changed3: i64, col3_changed4: i64, col3_changed5: i64, col3_changed6: i64, col3_changed7: i64,
}

fn _ecs_table_deep_zeros() -> EcsTableDeep {
    return EcsTableDeep {
        id: 0, capacity: 0,
        entity0: 0, entity1: 0, entity2: 0, entity3: 0,
        entity4: 0, entity5: 0, entity6: 0, entity7: 0,
        entity_count: 0,
        comp_id0: 0, comp_id1: 0, comp_id2: 0, comp_id3: 0,
        column_count: 0,
        col0_data0: 0, col0_data1: 0, col0_data2: 0, col0_data3: 0, col0_data4: 0, col0_data5: 0, col0_data6: 0, col0_data7: 0,
        col0_added0: 0, col0_added1: 0, col0_added2: 0, col0_added3: 0, col0_added4: 0, col0_added5: 0, col0_added6: 0, col0_added7: 0,
        col0_changed0: 0, col0_changed1: 0, col0_changed2: 0, col0_changed3: 0, col0_changed4: 0, col0_changed5: 0, col0_changed6: 0, col0_changed7: 0,
        col1_data0: 0, col1_data1: 0, col1_data2: 0, col1_data3: 0, col1_data4: 0, col1_data5: 0, col1_data6: 0, col1_data7: 0,
        col1_added0: 0, col1_added1: 0, col1_added2: 0, col1_added3: 0, col1_added4: 0, col1_added5: 0, col1_added6: 0, col1_added7: 0,
        col1_changed0: 0, col1_changed1: 0, col1_changed2: 0, col1_changed3: 0, col1_changed4: 0, col1_changed5: 0, col1_changed6: 0, col1_changed7: 0,
        col2_data0: 0, col2_data1: 0, col2_data2: 0, col2_data3: 0, col2_data4: 0, col2_data5: 0, col2_data6: 0, col2_data7: 0,
        col2_added0: 0, col2_added1: 0, col2_added2: 0, col2_added3: 0, col2_added4: 0, col2_added5: 0, col2_added6: 0, col2_added7: 0,
        col2_changed0: 0, col2_changed1: 0, col2_changed2: 0, col2_changed3: 0, col2_changed4: 0, col2_changed5: 0, col2_changed6: 0, col2_changed7: 0,
        col3_data0: 0, col3_data1: 0, col3_data2: 0, col3_data3: 0, col3_data4: 0, col3_data5: 0, col3_data6: 0, col3_data7: 0,
        col3_added0: 0, col3_added1: 0, col3_added2: 0, col3_added3: 0, col3_added4: 0, col3_added5: 0, col3_added6: 0, col3_added7: 0,
        col3_changed0: 0, col3_changed1: 0, col3_changed2: 0, col3_changed3: 0, col3_changed4: 0, col3_changed5: 0, col3_changed6: 0, col3_changed7: 0,
    };
}

fn ecs_table_deep_new(id: i32, capacity: i64) -> EcsTableDeep {
    let t = _ecs_table_deep_zeros();
    t.id = id;
    t.capacity = capacity;
    return t;
}

fn ecs_table_deep_id(t: EcsTableDeep) -> i32 { return t.id; }
fn ecs_table_deep_entity_count(t: EcsTableDeep) -> i64 { return t.entity_count as i64; }
fn ecs_table_deep_entity_capacity(t: EcsTableDeep) -> i64 { return t.capacity; }
fn ecs_table_deep_component_count(t: EcsTableDeep) -> i64 { return t.column_count as i64; }
fn ecs_table_deep_is_empty(t: EcsTableDeep) -> bool { return t.entity_count == 0; }

// get entity by row — returns i64 directly (used by some readers); -1 sentinel for out-of-range.
fn ecs_table_deep_entity_at(t: EcsTableDeep, idx: i32) -> i64 {
    if idx < 0 { return -1; };
    if idx >= t.entity_count { return -1; };
    if idx == 0 { return t.entity0; };
    if idx == 1 { return t.entity1; };
    if idx == 2 { return t.entity2; };
    if idx == 3 { return t.entity3; };
    if idx == 4 { return t.entity4; };
    if idx == 5 { return t.entity5; };
    if idx == 6 { return t.entity6; };
    return t.entity7;
}

// add_column: store component_id into the next column slot — cap-4 reject mirrors the silent
// (push would never reject in the shallow, but our cap-4 boundary returns the table unchanged).
fn ecs_table_deep_add_column(t: EcsTableDeep, component_id: i32) -> EcsTableDeep {
    if t.column_count >= ECS_TABLE_DEEP_COL_CAP { return t; };
    if t.column_count == 0 { t.comp_id0 = component_id; };
    if t.column_count == 1 { t.comp_id1 = component_id; };
    if t.column_count == 2 { t.comp_id2 = component_id; };
    if t.column_count == 3 { t.comp_id3 = component_id; };
    t.column_count = t.column_count + 1;
    return t;
}

fn ecs_table_deep_has_column(t: EcsTableDeep, component_id: i32) -> bool {
    if t.column_count > 0 && t.comp_id0 == component_id { return true; };
    if t.column_count > 1 && t.comp_id1 == component_id { return true; };
    if t.column_count > 2 && t.comp_id2 == component_id { return true; };
    if t.column_count > 3 && t.comp_id3 == component_id { return true; };
    return false;
}

fn ecs_table_deep_get_column_index(t: EcsTableDeep, component_id: i32) -> i64 {
    if t.column_count > 0 && t.comp_id0 == component_id { return 0; };
    if t.column_count > 1 && t.comp_id1 == component_id { return 1; };
    if t.column_count > 2 && t.comp_id2 == component_id { return 2; };
    if t.column_count > 3 && t.comp_id3 == component_id { return 3; };
    return -1;
}

// set column-cell helper: write the data cell for (col_idx, row_idx). col_idx 0..3, row_idx 0..7.
fn _ecs_table_deep_set_col_data(t: EcsTableDeep, col_idx: i64, row_idx: i32, value: i64) -> EcsTableDeep {
    if col_idx == 0 {
        if row_idx == 0 { t.col0_data0 = value; };
        if row_idx == 1 { t.col0_data1 = value; };
        if row_idx == 2 { t.col0_data2 = value; };
        if row_idx == 3 { t.col0_data3 = value; };
        if row_idx == 4 { t.col0_data4 = value; };
        if row_idx == 5 { t.col0_data5 = value; };
        if row_idx == 6 { t.col0_data6 = value; };
        if row_idx == 7 { t.col0_data7 = value; };
    };
    if col_idx == 1 {
        if row_idx == 0 { t.col1_data0 = value; };
        if row_idx == 1 { t.col1_data1 = value; };
        if row_idx == 2 { t.col1_data2 = value; };
        if row_idx == 3 { t.col1_data3 = value; };
        if row_idx == 4 { t.col1_data4 = value; };
        if row_idx == 5 { t.col1_data5 = value; };
        if row_idx == 6 { t.col1_data6 = value; };
        if row_idx == 7 { t.col1_data7 = value; };
    };
    if col_idx == 2 {
        if row_idx == 0 { t.col2_data0 = value; };
        if row_idx == 1 { t.col2_data1 = value; };
        if row_idx == 2 { t.col2_data2 = value; };
        if row_idx == 3 { t.col2_data3 = value; };
        if row_idx == 4 { t.col2_data4 = value; };
        if row_idx == 5 { t.col2_data5 = value; };
        if row_idx == 6 { t.col2_data6 = value; };
        if row_idx == 7 { t.col2_data7 = value; };
    };
    if col_idx == 3 {
        if row_idx == 0 { t.col3_data0 = value; };
        if row_idx == 1 { t.col3_data1 = value; };
        if row_idx == 2 { t.col3_data2 = value; };
        if row_idx == 3 { t.col3_data3 = value; };
        if row_idx == 4 { t.col3_data4 = value; };
        if row_idx == 5 { t.col3_data5 = value; };
        if row_idx == 6 { t.col3_data6 = value; };
        if row_idx == 7 { t.col3_data7 = value; };
    };
    return t;
}

