        if row_idx == 2 { t.col1_added2 = value; };
        if row_idx == 3 { t.col1_added3 = value; };
        if row_idx == 4 { t.col1_added4 = value; };
        if row_idx == 5 { t.col1_added5 = value; };
        if row_idx == 6 { t.col1_added6 = value; };
