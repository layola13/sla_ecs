fn _ecs_table_deep_get_col_changed(t: EcsTableDeep, col_idx: i64, row_idx: i32) -> i64 {
    if col_idx == 0 {
        if row_idx == 0 { return t.col0_changed0; };
        if row_idx == 1 { return t.col0_changed1; };
        if row_idx == 2 { return t.col0_changed2; };
        if row_idx == 3 { return t.col0_changed3; };
        if row_idx == 4 { return t.col0_changed4; };
        if row_idx == 5 { return t.col0_changed5; };
        if row_idx == 6 { return t.col0_changed6; };
        if row_idx == 7 { return t.col0_changed7; };
    };
    if col_idx == 1 {
        if row_idx == 0 { return t.col1_changed0; };
        if row_idx == 1 { return t.col1_changed1; };
        if row_idx == 2 { return t.col1_changed2; };
        if row_idx == 3 { return t.col1_changed3; };
        if row_idx == 4 { return t.col1_changed4; };
        if row_idx == 5 { return t.col1_changed5; };
        if row_idx == 6 { return t.col1_changed6; };
        if row_idx == 7 { return t.col1_changed7; };
    };
    if col_idx == 2 {
        if row_idx == 0 { return t.col2_changed0; };
        if row_idx == 1 { return t.col2_changed1; };
        if row_idx == 2 { return t.col2_changed2; };
        if row_idx == 3 { return t.col2_changed3; };
        if row_idx == 4 { return t.col2_changed4; };
        if row_idx == 5 { return t.col2_changed5; };
        if row_idx == 6 { return t.col2_changed6; };
        if row_idx == 7 { return t.col2_changed7; };
    };
    if col_idx == 3 {
        if row_idx == 0 { return t.col3_changed0; };
        if row_idx == 1 { return t.col3_changed1; };
        if row_idx == 2 { return t.col3_changed2; };
        if row_idx == 3 { return t.col3_changed3; };
        if row_idx == 4 { return t.col3_changed4; };
        if row_idx == 5 { return t.col3_changed5; };
        if row_idx == 6 { return t.col3_changed6; };
        if row_idx == 7 { return t.col3_changed7; };
    };
    return 0;
}

// Set entity slot — field-assign helper for allocate / swap_remove.
fn _ecs_table_deep_set_entity(t: EcsTableDeep, idx: i32, value: i64) -> EcsTableDeep {
    if idx == 0 { t.entity0 = value; };
    if idx == 1 { t.entity1 = value; };
    if idx == 2 { t.entity2 = value; };
    if idx == 3 { t.entity3 = value; };
    if idx == 4 { t.entity4 = value; };
    if idx == 5 { t.entity5 = value; };
    if idx == 6 { t.entity6 = value; };
    if idx == 7 { t.entity7 = value; };
    return t;
}

fn _ecs_table_deep_get_entity(t: EcsTableDeep, idx: i32) -> i64 {
    if idx == 0 { return t.entity0; };
    if idx == 1 { return t.entity1; };
    if idx == 2 { return t.entity2; };
    if idx == 3 { return t.entity3; };
    if idx == 4 { return t.entity4; };
    if idx == 5 { return t.entity5; };
    if idx == 6 { return t.entity6; };
    return t.entity7;
}

// allocate: add an entity; initialise each existing column's next row (data 0, added=tick,
// changed=tick). Cap-8 reject mirrors the entity_count < row_cap precondition (the shallow would
// also panic at a Vec index OOB on `t.entities.push` overflow — we reject silently with ok=false
// and a -1 row).
struct EcsTableAllocateDeep { new_table: EcsTableDeep, row: i32, ok: bool }

fn ecs_table_allocate_deep(t: EcsTableDeep, entity: i64, tick: i64) -> EcsTableAllocateDeep {
    if t.entity_count >= ECS_TABLE_DEEP_ROW_CAP {
        return EcsTableAllocateDeep { new_table: t, row: -1, ok: false };
    };
    let row = t.entity_count;
    t = _ecs_table_deep_set_entity(t, row, entity);
    // Initialise every in-use column at this row.
    let col_idx: i64 = 0;
    while col_idx < ECS_TABLE_DEEP_COL_CAP as i64 && col_idx < t.column_count as i64 {
        t = _ecs_table_deep_set_col_data(t, col_idx, row, 0);
        t = _ecs_table_deep_set_col_added(t, col_idx, row, tick);
        t = _ecs_table_deep_set_col_changed(t, col_idx, row, tick);
        col_idx = col_idx + 1;
    }
    t.entity_count = t.entity_count + 1;
    return EcsTableAllocateDeep { new_table: t, row: row, ok: true };
}

fn ecs_table_allocate_deep_new_table(r: EcsTableAllocateDeep) -> EcsTableDeep { return r.new_table; }
fn ecs_table_allocate_deep_row(r: EcsTableAllocateDeep) -> i32 { return r.row; }
fn ecs_table_allocate_deep_ok(r: EcsTableAllocateDeep) -> bool { return r.ok; }

// get: get component data at (component_id, row).
struct EcsTableGetResultDeep { valid: bool, value: i64 }

fn ecs_table_get_deep(t: EcsTableDeep, component_id: i32, row: i32) -> EcsTableGetResultDeep {
    let col_idx = ecs_table_deep_get_column_index(t, component_id);
    if col_idx < 0 { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    if row < 0 { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    if row >= t.entity_count { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    let v = _ecs_table_deep_get_col_data(t, col_idx, row);
    return EcsTableGetResultDeep { valid: true, value: v };
}

fn ecs_table_get_deep_valid(r: EcsTableGetResultDeep) -> bool { return r.valid; }
fn ecs_table_get_deep_value(r: EcsTableGetResultDeep) -> i64 { return r.value; }

// set: set component data at (component_id, row, data, tick). Bumps changed_tick only (matches
// the shallow — added_tick preserved on writes).
struct EcsTableSetResultDeep { new_table: EcsTableDeep, ok: bool }

fn ecs_table_set_deep(t: EcsTableDeep, component_id: i32, row: i32, data: i64, tick: i64) -> EcsTableSetResultDeep {
    let col_idx = ecs_table_deep_get_column_index(t, component_id);
    if col_idx < 0 { return EcsTableSetResultDeep { new_table: t, ok: false }; };
    if row < 0 { return EcsTableSetResultDeep { new_table: t, ok: false }; };
    if row >= t.entity_count { return EcsTableSetResultDeep { new_table: t, ok: false }; };
    t = _ecs_table_deep_set_col_data(t, col_idx, row, data);
    t = _ecs_table_deep_set_col_changed(t, col_idx, row, tick);
    return EcsTableSetResultDeep { new_table: t, ok: true };
}

fn ecs_table_set_deep_new_table(r: EcsTableSetResultDeep) -> EcsTableDeep { return r.new_table; }
fn ecs_table_set_deep_ok(r: EcsTableSetResultDeep) -> bool { return r.ok; }

// get_added_tick / get_changed_tick.
fn ecs_table_get_added_tick_deep(t: EcsTableDeep, component_id: i32, row: i32) -> EcsTableGetResultDeep {
    let col_idx = ecs_table_deep_get_column_index(t, component_id);
    if col_idx < 0 { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    if row < 0 { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    if row >= t.entity_count { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    let v = _ecs_table_deep_get_col_added(t, col_idx, row);
    return EcsTableGetResultDeep { valid: true, value: v };
}

fn ecs_table_get_changed_tick_deep(t: EcsTableDeep, component_id: i32, row: i32) -> EcsTableGetResultDeep {
    let col_idx = ecs_table_deep_get_column_index(t, component_id);
    if col_idx < 0 { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    if row < 0 { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    if row >= t.entity_count { return EcsTableGetResultDeep { valid: false, value: 0 }; };
    let v = _ecs_table_deep_get_col_changed(t, col_idx, row);
    return EcsTableGetResultDeep { valid: true, value: v };
}

// get_drop_for: true iff the column exists (mirrors shallow has_column).
fn ecs_table_get_drop_for_deep(t: EcsTableDeep, component_id: i32) -> bool {
    return ecs_table_deep_has_column(t, component_id);
}

// get_entity_at_row: wrapper result.
struct EcsTableEntityResultDeep { valid: bool, value: i64 }

fn ecs_table_get_entity_at_row_deep(t: EcsTableDeep, row: i32) -> EcsTableEntityResultDeep {
    if row < 0 { return EcsTableEntityResultDeep { valid: false, value: 0 }; };
    if row >= t.entity_count { return EcsTableEntityResultDeep { valid: false, value: 0 }; };
    let v = _ecs_table_deep_get_entity(t, row);
    return EcsTableEntityResultDeep { valid: true, value: v };
}

fn ecs_table_get_entity_at_row_deep_valid(r: EcsTableEntityResultDeep) -> bool { return r.valid; }
fn ecs_table_get_entity_at_row_deep_value(r: EcsTableEntityResultDeep) -> i64 { return r.value; }

// swap_remove: remove the row by relocating the tail into it, then truncate the tail for every
// in-use column and the entity list.
struct EcsTableSwapRemoveDeep { new_table: EcsTableDeep, ok: bool }

fn ecs_table_swap_remove_deep(t: EcsTableDeep, row: i32) -> EcsTableSwapRemoveDeep {
    let n = t.entity_count;
    if row < 0 { return EcsTableSwapRemoveDeep { new_table: t, ok: false }; };
    if row >= n { return EcsTableSwapRemoveDeep { new_table: t, ok: false }; };
    let last_idx = n - 1;
    if row != last_idx {
        // Relocate the entity id.
        let src = _ecs_table_deep_get_entity(t, last_idx);
        t = _ecs_table_deep_set_entity(t, row, src);
        let col_idx: i64 = 0;
        while col_idx < ECS_TABLE_DEEP_COL_CAP as i64 && col_idx < t.column_count as i64 {
            let d = _ecs_table_deep_get_col_data(t, col_idx, last_idx);
            let a = _ecs_table_deep_get_col_added(t, col_idx, last_idx);
            let ch = _ecs_table_deep_get_col_changed(t, col_idx, last_idx);
            t = _ecs_table_deep_set_col_data(t, col_idx, row, d);
            t = _ecs_table_deep_set_col_added(t, col_idx, row, a);
            t = _ecs_table_deep_set_col_changed(t, col_idx, row, ch);
            col_idx = col_idx + 1;
        }
    };
    // Zero the released tail slot for every column and entity slot.
    t = _ecs_table_deep_set_entity(t, last_idx, 0);
    let col_idx2: i64 = 0;
    while col_idx2 < ECS_TABLE_DEEP_COL_CAP as i64 && col_idx2 < t.column_count as i64 {
        t = _ecs_table_deep_set_col_data(t, col_idx2, last_idx, 0);
        t = _ecs_table_deep_set_col_added(t, col_idx2, last_idx, 0);
        t = _ecs_table_deep_set_col_changed(t, col_idx2, last_idx, 0);
        col_idx2 = col_idx2 + 1;
    }
    t.entity_count = t.entity_count - 1;
    return EcsTableSwapRemoveDeep { new_table: t, ok: true };
}

fn ecs_table_swap_remove_deep_new_table(r: EcsTableSwapRemoveDeep) -> EcsTableDeep { return r.new_table; }
fn ecs_table_swap_remove_deep_ok(r: EcsTableSwapRemoveDeep) -> bool { return r.ok; }

// === Tables collection ===
struct EcsTablesDeep {
    next_id: i32,
    table0: EcsTableDeep, table1: EcsTableDeep, table2: EcsTableDeep, table3: EcsTableDeep,
    table4: EcsTableDeep, table5: EcsTableDeep, table6: EcsTableDeep, table7: EcsTableDeep,
    count: i32,
}

fn _ecs_tables_deep_empty() -> EcsTablesDeep {
    let t0 = _ecs_table_deep_zeros();
    let t1 = _ecs_table_deep_zeros();
    let t2 = _ecs_table_deep_zeros();
    let t3 = _ecs_table_deep_zeros();
    let t4 = _ecs_table_deep_zeros();
    let t5 = _ecs_table_deep_zeros();
    let t6 = _ecs_table_deep_zeros();
    let t7 = _ecs_table_deep_zeros();
    return EcsTablesDeep {
        next_id: 0,
        table0: t0, table1: t1, table2: t2, table3: t3,
        table4: t4, table5: t5, table6: t6, table7: t7,
        count: 0,
    };
}

fn ecs_tables_deep_new() -> EcsTablesDeep {
    return _ecs_tables_deep_empty();
}

fn _ecs_tables_deep_get_at(ts: EcsTablesDeep, idx: i32) -> EcsTableDeep {
    if idx == 0 { return ts.table0; };
    if idx == 1 { return ts.table1; };
    if idx == 2 { return ts.table2; };
    if idx == 3 { return ts.table3; };
    if idx == 4 { return ts.table4; };
    if idx == 5 { return ts.table5; };
    if idx == 6 { return ts.table6; };
    return ts.table7;
}

// Set the table slot at idx — each branch consumes new_table and returns immediately so
// the move-checker treats each subsequent reference as unreachable (cascade-of-return pattern).
fn _ecs_tables_deep_set_table(ts: EcsTablesDeep, idx: i32, new_table: EcsTableDeep) -> EcsTablesDeep {
    if idx == 0 { ts.table0 = new_table; return ts; };
    if idx == 1 { ts.table1 = new_table; return ts; };
    if idx == 2 { ts.table2 = new_table; return ts; };
    if idx == 3 { ts.table3 = new_table; return ts; };
    if idx == 4 { ts.table4 = new_table; return ts; };
    if idx == 5 { ts.table5 = new_table; return ts; };
    if idx == 6 { ts.table6 = new_table; return ts; };
    ts.table7 = new_table;
    return ts;
}

fn ecs_tables_deep_len(ts: EcsTablesDeep) -> i64 { return ts.count as i64; }
fn ecs_tables_deep_is_empty(ts: EcsTablesDeep) -> bool { return ts.count == 0; }
fn ecs_tables_deep_count(ts: EcsTablesDeep) -> i64 { return ts.count as i64; }

struct EcsTablesGetResultDeep { valid: bool, table: EcsTableDeep }

fn ecs_tables_deep_get(ts: EcsTablesDeep, id: i32) -> EcsTablesGetResultDeep {
    let i: i32 = 0;
    while i < ts.count {
        let ti = _ecs_tables_deep_get_at(ts, i);
        if ecs_table_deep_id(ti) == id {
            return EcsTablesGetResultDeep { valid: true, table: ti };
        };
        i = i + 1;
    }
    return EcsTablesGetResultDeep { valid: false, table: ecs_table_deep_new(0, 0) };
}

fn ecs_tables_deep_get_valid(r: EcsTablesGetResultDeep) -> bool { return r.valid; }
fn ecs_tables_deep_get_table(r: EcsTablesGetResultDeep) -> EcsTableDeep { return r.table; }

struct EcsTablesCreateDeep { new_tables: EcsTablesDeep, id: i32, ok: bool }

fn ecs_tables_deep_create(ts: EcsTablesDeep, capacity: i64) -> EcsTablesCreateDeep {
    if ts.count >= ECS_TABLES_DEEP_CAP {
        return EcsTablesCreateDeep { new_tables: ts, id: -1, ok: false };
    };
    let id = ts.next_id;
    let new_table = ecs_table_deep_new(id, capacity);
    ts = _ecs_tables_deep_set_table(ts, ts.count, new_table);
    ts.count = ts.count + 1;
    ts.next_id = ts.next_id + 1;
    return EcsTablesCreateDeep { new_tables: ts, id: id, ok: true };
}

fn ecs_tables_deep_create_new_tables(r: EcsTablesCreateDeep) -> EcsTablesDeep { return r.new_tables; }
fn ecs_tables_deep_create_id(r: EcsTablesCreateDeep) -> i32 { return r.id; }
fn ecs_tables_deep_create_ok(r: EcsTablesCreateDeep) -> bool { return r.ok; }
