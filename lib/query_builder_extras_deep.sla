// Deepened Bevy ECS QueryBuilder extras.
// Mirrors src/query/builder.rs residual:
//   data/ref/mut by id, with/without by id
//   optional / or groups / access view
// Fixed capacity: 4 data, 4 with, 4 without. Shallow lib/query_builder_extras.sla retained.

struct EcsQbDeep {
    world_id: i64,
    // data ids + write flags
    d0: i32, dw0: bool,
    d1: i32, dw1: bool,
    d2: i32, dw2: bool,
    d3: i32, dw3: bool,
    dlen: i32,
    // with
    w0: i32, w1: i32, w2: i32, w3: i32, wlen: i32,
    // without
    x0: i32, x1: i32, x2: i32, x3: i32, xlen: i32,
    or_groups: i32,
    optional_count: i32,
}

fn ecs_qb_deep_new(world_id: i64) -> EcsQbDeep {
    return EcsQbDeep {
        world_id: world_id,
        d0: -1, dw0: false, d1: -1, dw1: false, d2: -1, dw2: false, d3: -1, dw3: false, dlen: 0,
        w0: -1, w1: -1, w2: -1, w3: -1, wlen: 0,
        x0: -1, x1: -1, x2: -1, x3: -1, xlen: 0,
        or_groups: 0, optional_count: 0,
    };
}

fn ecs_qb_deep_world(q: EcsQbDeep) -> i64 { return q.world_id; }
fn ecs_qb_deep_dlen(q: EcsQbDeep) -> i32 { return q.dlen; }
fn ecs_qb_deep_wlen(q: EcsQbDeep) -> i32 { return q.wlen; }
fn ecs_qb_deep_xlen(q: EcsQbDeep) -> i32 { return q.xlen; }
fn ecs_qb_deep_or_groups(q: EcsQbDeep) -> i32 { return q.or_groups; }
fn ecs_qb_deep_optional_count(q: EcsQbDeep) -> i32 { return q.optional_count; }

fn ecs_qb_deep_rebuild(
    world_id: i64,
    d0: i32, dw0: bool, d1: i32, dw1: bool, d2: i32, dw2: bool, d3: i32, dw3: bool, dlen: i32,
    w0: i32, w1: i32, w2: i32, w3: i32, wlen: i32,
    x0: i32, x1: i32, x2: i32, x3: i32, xlen: i32,
    or_groups: i32, optional_count: i32
) -> EcsQbDeep {
    return EcsQbDeep {
        world_id: world_id,
        d0: d0, dw0: dw0, d1: d1, dw1: dw1, d2: d2, dw2: dw2, d3: d3, dw3: dw3, dlen: dlen,
        w0: w0, w1: w1, w2: w2, w3: w3, wlen: wlen,
        x0: x0, x1: x1, x2: x2, x3: x3, xlen: xlen,
        or_groups: or_groups, optional_count: optional_count,
    };
}

fn ecs_qb_deep_data(q: EcsQbDeep, id: i32, write: bool) -> EcsQbDeep {
    if q.dlen == 0 {
        return ecs_qb_deep_rebuild(q.world_id, id, write, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, 1, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    if q.dlen == 1 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, id, write, q.d2, q.dw2, q.d3, q.dw3, 2, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    if q.dlen == 2 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, id, write, q.d3, q.dw3, 3, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    if q.dlen == 3 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, id, write, 4, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    return q;
}

fn ecs_qb_deep_ref_id(q: EcsQbDeep, id: i32) -> EcsQbDeep { return ecs_qb_deep_data(q, id, false); }
fn ecs_qb_deep_mut_id(q: EcsQbDeep, id: i32) -> EcsQbDeep { return ecs_qb_deep_data(q, id, true); }

fn ecs_qb_deep_with_id(q: EcsQbDeep, id: i32) -> EcsQbDeep {
    if q.wlen >= 1 { if q.w0 == id { return q; }; };
    if q.wlen >= 2 { if q.w1 == id { return q; }; };
    if q.wlen >= 3 { if q.w2 == id { return q; }; };
    if q.wlen >= 4 { if q.w3 == id { return q; }; };
    if q.wlen == 0 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, id, q.w1, q.w2, q.w3, 1, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    if q.wlen == 1 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, id, q.w2, q.w3, 2, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    if q.wlen == 2 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, id, q.w3, 3, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    if q.wlen == 3 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, id, 4, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count);
    };
    return q;
}

fn ecs_qb_deep_without_id(q: EcsQbDeep, id: i32) -> EcsQbDeep {
    if q.xlen >= 1 { if q.x0 == id { return q; }; };
    if q.xlen >= 2 { if q.x1 == id { return q; }; };
    if q.xlen >= 3 { if q.x2 == id { return q; }; };
    if q.xlen >= 4 { if q.x3 == id { return q; }; };
    if q.xlen == 0 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, q.w3, q.wlen, id, q.x1, q.x2, q.x3, 1, q.or_groups, q.optional_count);
    };
    if q.xlen == 1 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, id, q.x2, q.x3, 2, q.or_groups, q.optional_count);
    };
    if q.xlen == 2 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, id, q.x3, 3, q.or_groups, q.optional_count);
    };
    if q.xlen == 3 {
        return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, id, 4, q.or_groups, q.optional_count);
    };
    return q;
}

fn ecs_qb_deep_optional(q: EcsQbDeep) -> EcsQbDeep {
    return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups, q.optional_count + 1);
}

fn ecs_qb_deep_or(q: EcsQbDeep) -> EcsQbDeep {
    return ecs_qb_deep_rebuild(q.world_id, q.d0, q.dw0, q.d1, q.dw1, q.d2, q.dw2, q.d3, q.dw3, q.dlen, q.w0, q.w1, q.w2, q.w3, q.wlen, q.x0, q.x1, q.x2, q.x3, q.xlen, q.or_groups + 1, q.optional_count);
}

fn ecs_qb_deep_data_is_write(q: EcsQbDeep, idx: i32) -> bool {
    if idx == 0 { return q.dw0; };
    if idx == 1 { return q.dw1; };
    if idx == 2 { return q.dw2; };
    if idx == 3 { return q.dw3; };
    return false;
}

fn ecs_qb_deep_data_id_at(q: EcsQbDeep, idx: i32) -> i32 {
    if idx == 0 { return q.d0; };
    if idx == 1 { return q.d1; };
    if idx == 2 { return q.d2; };
    if idx == 3 { return q.d3; };
    return -1;
}

fn ecs_qb_deep_with_at(q: EcsQbDeep, idx: i32) -> i32 {
    if idx == 0 { return q.w0; };
    if idx == 1 { return q.w1; };
    if idx == 2 { return q.w2; };
    if idx == 3 { return q.w3; };
    return -1;
}

fn ecs_qb_deep_without_at(q: EcsQbDeep, idx: i32) -> i32 {
    if idx == 0 { return q.x0; };
    if idx == 1 { return q.x1; };
    if idx == 2 { return q.x2; };
    if idx == 3 { return q.x3; };
    return -1;
}

// access view: count reads/writes
struct EcsQbAccessDeep {
    read_count: i32,
    write_count: i32,
    with_count: i32,
    without_count: i32,
}

fn ecs_qb_access_reads(a: EcsQbAccessDeep) -> i32 { return a.read_count; }
fn ecs_qb_access_writes(a: EcsQbAccessDeep) -> i32 { return a.write_count; }
fn ecs_qb_access_with(a: EcsQbAccessDeep) -> i32 { return a.with_count; }
fn ecs_qb_access_without(a: EcsQbAccessDeep) -> i32 { return a.without_count; }

fn ecs_qb_deep_access(q: EcsQbDeep) -> EcsQbAccessDeep {
    let reads = 0;
    let writes = 0;
    if q.dlen >= 1 {
        if q.dw0 { writes = writes + 1; } else { reads = reads + 1; };
    };
    if q.dlen >= 2 {
        if q.dw1 { writes = writes + 1; } else { reads = reads + 1; };
    };
    if q.dlen >= 3 {
        if q.dw2 { writes = writes + 1; } else { reads = reads + 1; };
    };
    if q.dlen >= 4 {
        if q.dw3 { writes = writes + 1; } else { reads = reads + 1; };
    };
    return EcsQbAccessDeep {
        read_count: reads, write_count: writes, with_count: q.wlen, without_count: q.xlen,
    };
}
