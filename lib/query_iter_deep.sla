// Deepened Bevy ECS query iterator surface.
// Mirrors src/query/iter.rs core:
//   QueryIter next/size_hint/nth/last/count
//   QueryManyIter set/find/next
//   QueryContiguousIter next
//   sort_by_value (stable-ish selection sort on values)
// Shallow lib/query_iter.sla retained.
// Fixed capacity: 8 entities.

struct EcsQiDeep {
    len: i32,
    cursor: i32,
    e0: i64, v0: i32,
    e1: i64, v1: i32,
    e2: i64, v2: i32,
    e3: i64, v3: i32,
    e4: i64, v4: i32,
    e5: i64, v5: i32,
    e6: i64, v6: i32,
    e7: i64, v7: i32,
}

fn ecs_qi_deep_new() -> EcsQiDeep {
    return EcsQiDeep {
        len: 0, cursor: 0,
        e0: 0, v0: 0, e1: 0, v1: 0, e2: 0, v2: 0, e3: 0, v3: 0,
        e4: 0, v4: 0, e5: 0, v5: 0, e6: 0, v6: 0, e7: 0, v7: 0,
    };
}

fn ecs_qi_deep_len(it: EcsQiDeep) -> i32 { return it.len; }
fn ecs_qi_deep_cursor(it: EcsQiDeep) -> i32 { return it.cursor; }
fn ecs_qi_deep_is_empty(it: EcsQiDeep) -> bool {
    if it.len == 0 { return true; };
    return false;
}
fn ecs_qi_deep_remaining(it: EcsQiDeep) -> i32 {
    if it.cursor >= it.len { return 0; };
    return it.len - it.cursor;
}

fn ecs_qi_deep_push(it: EcsQiDeep, entity: i64, value: i32) -> EcsQiDeep {
    if it.len >= 8 { return it; };
    let n = it.len;
    let e0 = it.e0; let v0 = it.v0; let e1 = it.e1; let v1 = it.v1;
    let e2 = it.e2; let v2 = it.v2; let e3 = it.e3; let v3 = it.v3;
    let e4 = it.e4; let v4 = it.v4; let e5 = it.e5; let v5 = it.v5;
    let e6 = it.e6; let v6 = it.v6; let e7 = it.e7; let v7 = it.v7;
    if n == 0 { e0 = entity; v0 = value; };
    if n == 1 { e1 = entity; v1 = value; };
    if n == 2 { e2 = entity; v2 = value; };
    if n == 3 { e3 = entity; v3 = value; };
    if n == 4 { e4 = entity; v4 = value; };
    if n == 5 { e5 = entity; v5 = value; };
    if n == 6 { e6 = entity; v6 = value; };
    if n == 7 { e7 = entity; v7 = value; };
    return EcsQiDeep {
        len: n + 1, cursor: it.cursor,
        e0: e0, v0: v0, e1: e1, v1: v1, e2: e2, v2: v2, e3: e3, v3: v3,
        e4: e4, v4: v4, e5: e5, v5: v5, e6: e6, v6: v6, e7: e7, v7: v7,
    };
}

fn ecs_qi_deep_entity_at(it: EcsQiDeep, idx: i32) -> i64 {
    if idx == 0 { return it.e0; };
    if idx == 1 { return it.e1; };
    if idx == 2 { return it.e2; };
    if idx == 3 { return it.e3; };
    if idx == 4 { return it.e4; };
    if idx == 5 { return it.e5; };
    if idx == 6 { return it.e6; };
    if idx == 7 { return it.e7; };
    return 0;
}
fn ecs_qi_deep_value_at(it: EcsQiDeep, idx: i32) -> i32 {
    if idx == 0 { return it.v0; };
    if idx == 1 { return it.v1; };
    if idx == 2 { return it.v2; };
    if idx == 3 { return it.v3; };
    if idx == 4 { return it.v4; };
    if idx == 5 { return it.v5; };
    if idx == 6 { return it.v6; };
    if idx == 7 { return it.v7; };
    return 0;
}

struct EcsQiNextDeep {
    had: bool,
    entity: i64,
    value: i32,
    iter: EcsQiDeep,
}
fn ecs_qi_next_had(r: EcsQiNextDeep) -> bool { return r.had; }
fn ecs_qi_next_entity(r: EcsQiNextDeep) -> i64 { return r.entity; }
fn ecs_qi_next_value(r: EcsQiNextDeep) -> i32 { return r.value; }
fn ecs_qi_next_iter(r: EcsQiNextDeep) -> EcsQiDeep { return r.iter; }

fn ecs_qi_deep_next(it: EcsQiDeep) -> EcsQiNextDeep {
    if it.cursor >= it.len {
        return EcsQiNextDeep { had: false, entity: 0, value: 0, iter: it };
    };
    let cur = it.cursor;
    let ent = ecs_qi_deep_entity_at(it, cur);
    let val = ecs_qi_deep_value_at(it, cur);
    let it2 = EcsQiDeep {
        len: it.len, cursor: cur + 1,
        e0: it.e0, v0: it.v0, e1: it.e1, v1: it.v1, e2: it.e2, v2: it.v2, e3: it.e3, v3: it.v3,
        e4: it.e4, v4: it.v4, e5: it.e5, v5: it.v5, e6: it.e6, v6: it.v6, e7: it.e7, v7: it.v7,
    };
    return EcsQiNextDeep { had: true, entity: ent, value: val, iter: it2 };
}

fn ecs_qi_deep_size_hint_lower(it: EcsQiDeep) -> i32 { return ecs_qi_deep_remaining(it); }
fn ecs_qi_deep_size_hint_upper(it: EcsQiDeep) -> i32 { return ecs_qi_deep_remaining(it); }

fn ecs_qi_deep_nth(it: EcsQiDeep, n: i32) -> EcsQiNextDeep {
    let target = it.cursor + n;
    if target >= it.len {
        return EcsQiNextDeep { had: false, entity: 0, value: 0, iter: it };
    };
    let ent = ecs_qi_deep_entity_at(it, target);
    let val = ecs_qi_deep_value_at(it, target);
    let it2 = EcsQiDeep {
        len: it.len, cursor: target + 1,
        e0: it.e0, v0: it.v0, e1: it.e1, v1: it.v1, e2: it.e2, v2: it.v2, e3: it.e3, v3: it.v3,
        e4: it.e4, v4: it.v4, e5: it.e5, v5: it.v5, e6: it.e6, v6: it.v6, e7: it.e7, v7: it.v7,
    };
    return EcsQiNextDeep { had: true, entity: ent, value: val, iter: it2 };
}

struct EcsQiLastDeep {
    had: bool,
    entity: i64,
    value: i32,
}
fn ecs_qi_last_had(r: EcsQiLastDeep) -> bool { return r.had; }
fn ecs_qi_last_entity(r: EcsQiLastDeep) -> i64 { return r.entity; }
fn ecs_qi_last_value(r: EcsQiLastDeep) -> i32 { return r.value; }

fn ecs_qi_deep_last(it: EcsQiDeep) -> EcsQiLastDeep {
    if it.len == 0 {
        return EcsQiLastDeep { had: false, entity: 0, value: 0 };
    };
    let idx = it.len - 1;
    return EcsQiLastDeep {
        had: true,
        entity: ecs_qi_deep_entity_at(it, idx),
        value: ecs_qi_deep_value_at(it, idx),
    };
}

// sort by value ascending (selection sort, rebuild)
fn ecs_qi_deep_sort_by_value(it: EcsQiDeep) -> EcsQiDeep {
    // extract to locals then selection-sort via repeated min extraction into new iter
    // fixed 8-pass rebuild
    let lenv = it.len;
    let e0 = it.e0; let v0 = it.v0; let e1 = it.e1; let v1 = it.v1;
    let e2 = it.e2; let v2 = it.v2; let e3 = it.e3; let v3 = it.v3;
    let e4 = it.e4; let v4 = it.v4; let e5 = it.e5; let v5 = it.v5;
    let e6 = it.e6; let v6 = it.v6; let e7 = it.e7; let v7 = it.v7;
    let used0 = false; let used1 = false; let used2 = false; let used3 = false;
    let used4 = false; let used5 = false; let used6 = false; let used7 = false;
    let out = ecs_qi_deep_new();
    let placed = 0;
    while placed < lenv {
        let best_set = false;
        let best_e: i64 = 0;
        let best_v: i32 = 0;
        let best_i: i32 = -1;
        if lenv >= 1 { if used0 != true {
            best_set = true; best_e = e0; best_v = v0; best_i = 0;
        }; };
        if lenv >= 2 { if used1 != true {
            if best_set != true {
                best_set = true; best_e = e1; best_v = v1; best_i = 1;
            } else {
                if v1 < best_v { best_e = e1; best_v = v1; best_i = 1; };
            };
        }; };
        if lenv >= 3 { if used2 != true {
            if best_set != true {
                best_set = true; best_e = e2; best_v = v2; best_i = 2;
            } else {
                if v2 < best_v { best_e = e2; best_v = v2; best_i = 2; };
            };
        }; };
        if lenv >= 4 { if used3 != true {
            if best_set != true {
                best_set = true; best_e = e3; best_v = v3; best_i = 3;
            } else {
                if v3 < best_v { best_e = e3; best_v = v3; best_i = 3; };
            };
        }; };
        if lenv >= 5 { if used4 != true {
            if best_set != true {
                best_set = true; best_e = e4; best_v = v4; best_i = 4;
            } else {
                if v4 < best_v { best_e = e4; best_v = v4; best_i = 4; };
            };
        }; };
        if lenv >= 6 { if used5 != true {
            if best_set != true {
                best_set = true; best_e = e5; best_v = v5; best_i = 5;
            } else {
                if v5 < best_v { best_e = e5; best_v = v5; best_i = 5; };
            };
        }; };
        if lenv >= 7 { if used6 != true {
            if best_set != true {
                best_set = true; best_e = e6; best_v = v6; best_i = 6;
            } else {
                if v6 < best_v { best_e = e6; best_v = v6; best_i = 6; };
            };
        }; };
        if lenv >= 8 { if used7 != true {
            if best_set != true {
                best_set = true; best_e = e7; best_v = v7; best_i = 7;
            } else {
                if v7 < best_v { best_e = e7; best_v = v7; best_i = 7; };
            };
        }; };
        if best_set != true { return out; };
        if best_i == 0 { used0 = true; };
        if best_i == 1 { used1 = true; };
        if best_i == 2 { used2 = true; };
        if best_i == 3 { used3 = true; };
        if best_i == 4 { used4 = true; };
        if best_i == 5 { used5 = true; };
        if best_i == 6 { used6 = true; };
        if best_i == 7 { used7 = true; };
        out = ecs_qi_deep_push(out, best_e, best_v);
        placed = placed + 1;
    }
    return out;
}

// QueryManyIter: targets + found values
struct EcsQmiDeep {
    target_len: i32,
    t0: i64, t1: i64, t2: i64, t3: i64,
    found0: bool, v0: i32,
    found1: bool, v1: i32,
    found2: bool, v2: i32,
    found3: bool, v3: i32,
    cursor: i32,
}

fn ecs_qmi_deep_new() -> EcsQmiDeep {
    return EcsQmiDeep {
        target_len: 0, t0: 0, t1: 0, t2: 0, t3: 0,
        found0: false, v0: 0, found1: false, v1: 0, found2: false, v2: 0, found3: false, v3: 0,
        cursor: 0,
    };
}
fn ecs_qmi_deep_push_target(m: EcsQmiDeep, entity: i64) -> EcsQmiDeep {
    if m.target_len >= 4 { return m; };
    if m.target_len == 0 {
        return EcsQmiDeep {
            target_len: 1, t0: entity, t1: m.t1, t2: m.t2, t3: m.t3,
            found0: false, v0: 0, found1: m.found1, v1: m.v1, found2: m.found2, v2: m.v2, found3: m.found3, v3: m.v3,
            cursor: m.cursor,
        };
    };
    if m.target_len == 1 {
        return EcsQmiDeep {
            target_len: 2, t0: m.t0, t1: entity, t2: m.t2, t3: m.t3,
            found0: m.found0, v0: m.v0, found1: false, v1: 0, found2: m.found2, v2: m.v2, found3: m.found3, v3: m.v3,
            cursor: m.cursor,
        };
    };
    if m.target_len == 2 {
        return EcsQmiDeep {
            target_len: 3, t0: m.t0, t1: m.t1, t2: entity, t3: m.t3,
            found0: m.found0, v0: m.v0, found1: m.found1, v1: m.v1, found2: false, v2: 0, found3: m.found3, v3: m.v3,
            cursor: m.cursor,
        };
    };
    return EcsQmiDeep {
        target_len: 4, t0: m.t0, t1: m.t1, t2: m.t2, t3: entity,
        found0: m.found0, v0: m.v0, found1: m.found1, v1: m.v1, found2: m.found2, v2: m.v2, found3: false, v3: 0,
        cursor: m.cursor,
    };
}

fn ecs_qmi_deep_set_found(m: EcsQmiDeep, entity: i64, value: i32) -> EcsQmiDeep {
    if m.target_len >= 1 { if m.t0 == entity {
        return EcsQmiDeep {
            target_len: m.target_len, t0: m.t0, t1: m.t1, t2: m.t2, t3: m.t3,
            found0: true, v0: value, found1: m.found1, v1: m.v1, found2: m.found2, v2: m.v2, found3: m.found3, v3: m.v3,
            cursor: m.cursor,
        };
    }; };
    if m.target_len >= 2 { if m.t1 == entity {
        return EcsQmiDeep {
            target_len: m.target_len, t0: m.t0, t1: m.t1, t2: m.t2, t3: m.t3,
            found0: m.found0, v0: m.v0, found1: true, v1: value, found2: m.found2, v2: m.v2, found3: m.found3, v3: m.v3,
            cursor: m.cursor,
        };
    }; };
    if m.target_len >= 3 { if m.t2 == entity {
        return EcsQmiDeep {
            target_len: m.target_len, t0: m.t0, t1: m.t1, t2: m.t2, t3: m.t3,
            found0: m.found0, v0: m.v0, found1: m.found1, v1: m.v1, found2: true, v2: value, found3: m.found3, v3: m.v3,
            cursor: m.cursor,
        };
    }; };
    if m.target_len >= 4 { if m.t3 == entity {
        return EcsQmiDeep {
            target_len: m.target_len, t0: m.t0, t1: m.t1, t2: m.t2, t3: m.t3,
            found0: m.found0, v0: m.v0, found1: m.found1, v1: m.v1, found2: m.found2, v2: m.v2, found3: true, v3: value,
            cursor: m.cursor,
        };
    }; };
    return m;
}

struct EcsQmiNextDeep {
    had: bool,
    entity: i64,
    value: i32,
    iter: EcsQmiDeep,
}
fn ecs_qmi_next_had(r: EcsQmiNextDeep) -> bool { return r.had; }
fn ecs_qmi_next_entity(r: EcsQmiNextDeep) -> i64 { return r.entity; }
fn ecs_qmi_next_value(r: EcsQmiNextDeep) -> i32 { return r.value; }
fn ecs_qmi_next_iter(r: EcsQmiNextDeep) -> EcsQmiDeep { return r.iter; }

fn ecs_qmi_deep_next(m: EcsQmiDeep) -> EcsQmiNextDeep {
    // advance to next found target
    let cur = m.cursor;
    while cur < m.target_len {
        let found = false;
        let ent: i64 = 0;
        let val: i32 = 0;
        if cur == 0 { if m.found0 { found = true; ent = m.t0; val = m.v0; }; };
        if cur == 1 { if m.found1 { found = true; ent = m.t1; val = m.v1; }; };
        if cur == 2 { if m.found2 { found = true; ent = m.t2; val = m.v2; }; };
        if cur == 3 { if m.found3 { found = true; ent = m.t3; val = m.v3; }; };
        if found {
            let m2 = EcsQmiDeep {
                target_len: m.target_len, t0: m.t0, t1: m.t1, t2: m.t2, t3: m.t3,
                found0: m.found0, v0: m.v0, found1: m.found1, v1: m.v1, found2: m.found2, v2: m.v2, found3: m.found3, v3: m.v3,
                cursor: cur + 1,
            };
            return EcsQmiNextDeep { had: true, entity: ent, value: val, iter: m2 };
        };
        cur = cur + 1;
    }
    let m3 = EcsQmiDeep {
        target_len: m.target_len, t0: m.t0, t1: m.t1, t2: m.t2, t3: m.t3,
        found0: m.found0, v0: m.v0, found1: m.found1, v1: m.v1, found2: m.found2, v2: m.v2, found3: m.found3, v3: m.v3,
        cursor: m.target_len,
    };
    return EcsQmiNextDeep { had: false, entity: 0, value: 0, iter: m3 };
}

fn ecs_qmi_deep_found_count(m: EcsQmiDeep) -> i32 {
    let n = 0;
    if m.target_len >= 1 { if m.found0 { n = n + 1; }; };
    if m.target_len >= 2 { if m.found1 { n = n + 1; }; };
    if m.target_len >= 3 { if m.found2 { n = n + 1; }; };
    if m.target_len >= 4 { if m.found3 { n = n + 1; }; };
    return n;
}
