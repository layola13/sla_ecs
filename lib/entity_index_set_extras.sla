// Bevy ECS EntityIndexSet ordered set, slice, range, and iterator extras.
// Mirrors src/entity/index_set.rs surfaces not covered by lib/entity_collections.sla.

struct EcsEntityIndexSetExtras { items: Vec<i64> }
struct EcsEntityIndexSetSlice { items: Vec<i64>, boxed: i32 }
struct EcsEntityIndexSetIter { items: Vec<i64>, front: i64, back: i64, trusted_unique: i32 }
struct EcsEntityIndexSetIntoIter { items: Vec<i64>, front: i64, back: i64, trusted_unique: i32 }
struct EcsEntityIndexSetDrain { items: Vec<i64>, front: i64, back: i64, trusted_unique: i32 }

struct EcsEisInsertResult { inserted: i32, set: EcsEntityIndexSetExtras }
struct EcsEisValueResult { has: i32, value: i64 }
struct EcsEisSliceResult { has: i32, slice: EcsEntityIndexSetSlice }
struct EcsEisSplitResult { left: EcsEntityIndexSetSlice, right: EcsEntityIndexSetSlice }
struct EcsEisSplitValueResult { has: i32, value: i64, rest: EcsEntityIndexSetSlice }
struct EcsEisIterNext { iter: EcsEntityIndexSetIter, has: i32, value: i64 }
struct EcsEisIntoIterNext { iter: EcsEntityIndexSetIntoIter, has: i32, value: i64 }
struct EcsEisDrainNext { drain: EcsEntityIndexSetDrain, has: i32, value: i64 }
struct EcsEisDrainResult { set: EcsEntityIndexSetExtras, drain: EcsEntityIndexSetDrain }

fn ecs_eis_new() -> EcsEntityIndexSetExtras {
    return EcsEntityIndexSetExtras { items: Vec::new() };
}

fn ecs_eis_from_index_set(items: Vec<i64>) -> EcsEntityIndexSetExtras {
    return ecs_eis_from_iter(items);
}

fn ecs_eis_into_inner(set: EcsEntityIndexSetExtras) -> Vec<i64> {
    return set.items;
}

fn ecs_eis_len(set: EcsEntityIndexSetExtras) -> i64 { return len(set.items) as i64; }
fn ecs_eis_slice_len(slice: EcsEntityIndexSetSlice) -> i64 { return len(slice.items) as i64; }

fn ecs_eis_contains(set: EcsEntityIndexSetExtras, value: i64) -> bool {
    let index: i64 = 0;
    let count = len(set.items) as i64;
    while index < count {
        if set.items[index] == value { return true; };
        index = index + 1;
    }
    return false;
}

fn ecs_eis_insert(set: EcsEntityIndexSetExtras, value: i64) -> EcsEisInsertResult {
    if ecs_eis_contains(set, value) { return EcsEisInsertResult { inserted: 0, set: set }; };
    set.items.push(value);
    return EcsEisInsertResult { inserted: 1, set: set };
}

fn ecs_eis_from_iter(items: Vec<i64>) -> EcsEntityIndexSetExtras {
    let set = ecs_eis_new();
    let index: i64 = 0;
    let count = len(items) as i64;
    while index < count {
        let inserted = ecs_eis_insert(set, items[index]);
        set = inserted.set;
        index = index + 1;
    }
    return set;
}

fn ecs_eis_as_slice(set: EcsEntityIndexSetExtras) -> EcsEntityIndexSetSlice {
    return EcsEntityIndexSetSlice { items: set.items, boxed: 0 };
}

fn ecs_eis_slice_new() -> EcsEntityIndexSetSlice {
    return EcsEntityIndexSetSlice { items: Vec::new(), boxed: 0 };
}

fn ecs_eis_boxed_default() -> EcsEntityIndexSetSlice {
    return EcsEntityIndexSetSlice { items: Vec::new(), boxed: 1 };
}

fn ecs_eis_into_boxed_slice(set: EcsEntityIndexSetExtras) -> EcsEntityIndexSetSlice {
    return EcsEntityIndexSetSlice { items: set.items, boxed: 1 };
}

fn ecs_eis_boxed_clone(slice: EcsEntityIndexSetSlice) -> EcsEntityIndexSetSlice {
    return EcsEntityIndexSetSlice { items: slice.items, boxed: 1 };
}

fn ecs_eis_boxed_into_inner(slice: EcsEntityIndexSetSlice) -> EcsEntityIndexSetSlice {
    return EcsEntityIndexSetSlice { items: slice.items, boxed: 0 };
}

fn ecs_eis_slice_at(slice: EcsEntityIndexSetSlice, index: i64) -> EcsEisValueResult {
    if index < 0 { return EcsEisValueResult { has: 0, value: -1 }; };
    if index >= len(slice.items) as i64 { return EcsEisValueResult { has: 0, value: -1 }; };
    return EcsEisValueResult { has: 1, value: slice.items[index] };
}

fn ecs_eis_slice_range(slice: EcsEntityIndexSetSlice, start: i64, end: i64) -> EcsEisSliceResult {
    let count = len(slice.items) as i64;
    if start < 0 { return EcsEisSliceResult { has: 0, slice: ecs_eis_slice_new() }; };
    if end < start { return EcsEisSliceResult { has: 0, slice: ecs_eis_slice_new() }; };
    if end > count { return EcsEisSliceResult { has: 0, slice: ecs_eis_slice_new() }; };
    let out: Vec<i64> = Vec::new();
    let index = start;
    while index < end {
        out.push(slice.items[index]);
        index = index + 1;
    }
    return EcsEisSliceResult { has: 1, slice: EcsEntityIndexSetSlice { items: out, boxed: slice.boxed } };
}

fn ecs_eis_get_range(set: EcsEntityIndexSetExtras, start: i64, end: i64) -> EcsEisSliceResult {
    return ecs_eis_slice_range(ecs_eis_as_slice(set), start, end);
}

fn ecs_eis_slice_range_from(slice: EcsEntityIndexSetSlice, start: i64) -> EcsEisSliceResult {
    return ecs_eis_slice_range(slice, start, len(slice.items) as i64);
}

fn ecs_eis_slice_range_to(slice: EcsEntityIndexSetSlice, end: i64) -> EcsEisSliceResult {
    return ecs_eis_slice_range(slice, 0, end);
}

fn ecs_eis_slice_range_inclusive(slice: EcsEntityIndexSetSlice, start: i64, end_inclusive: i64) -> EcsEisSliceResult {
    return ecs_eis_slice_range(slice, start, end_inclusive + 1);
}

fn ecs_eis_index_range(set: EcsEntityIndexSetExtras, start: i64, end: i64) -> EcsEisSliceResult {
    return ecs_eis_get_range(set, start, end);
}

fn ecs_eis_index_value(set: EcsEntityIndexSetExtras, index: i64) -> EcsEisValueResult {
    return ecs_eis_slice_at(ecs_eis_as_slice(set), index);
}

fn ecs_eis_slice_split_at_clamped(slice: EcsEntityIndexSetSlice, cut: i64) -> EcsEisSplitResult {
    let left: Vec<i64> = Vec::new();
    let right: Vec<i64> = Vec::new();
    let index: i64 = 0;
    let count = len(slice.items) as i64;
    while index < count {
        if index < cut { left.push(slice.items[index]); };
        if index >= cut { right.push(slice.items[index]); };
        index = index + 1;
    }
    return EcsEisSplitResult {
        left: EcsEntityIndexSetSlice { items: left, boxed: slice.boxed },
        right: EcsEntityIndexSetSlice { items: right, boxed: slice.boxed },
    };
}

fn ecs_eis_slice_split_at(slice: EcsEntityIndexSetSlice, index: i64) -> EcsEisSplitResult {
    let count = len(slice.items) as i64;
    if index <= 0 { return ecs_eis_slice_split_at_clamped(slice, 0); };
    if index >= count { return ecs_eis_slice_split_at_clamped(slice, count); };
    return ecs_eis_slice_split_at_clamped(slice, index);
}

fn ecs_eis_slice_split_first(slice: EcsEntityIndexSetSlice) -> EcsEisSplitValueResult {
    let first = ecs_eis_slice_at(slice, 0);
    if first.has == 0 { return EcsEisSplitValueResult { has: 0, value: -1, rest: ecs_eis_slice_new() }; };
    let split = ecs_eis_slice_split_at(slice, 1);
    return EcsEisSplitValueResult { has: 1, value: first.value, rest: split.right };
}

fn ecs_eis_slice_split_last(slice: EcsEntityIndexSetSlice) -> EcsEisSplitValueResult {
    let last = ecs_eis_slice_at(slice, (len(slice.items) as i64) - 1);
    if last.has == 0 { return EcsEisSplitValueResult { has: 0, value: -1, rest: ecs_eis_slice_new() }; };
    let split = ecs_eis_slice_split_at(slice, (len(slice.items) as i64) - 1);
    return EcsEisSplitValueResult { has: 1, value: last.value, rest: split.left };
}

fn ecs_eis_slice_eq(a: EcsEntityIndexSetSlice, b: EcsEntityIndexSetSlice) -> bool {
    if len(a.items) != len(b.items) { return false; };
    let index: i64 = 0;
    let count = len(a.items) as i64;
    while index < count {
        if a.items[index] != b.items[index] { return false; };
        index = index + 1;
    }
    return true;
}

fn ecs_eis_slice_cmp(a: EcsEntityIndexSetSlice, b: EcsEntityIndexSetSlice) -> i32 {
    let min_count = len(a.items) as i64;
    if (len(b.items) as i64) < min_count { min_count = len(b.items) as i64; };
    let index: i64 = 0;
    while index < min_count {
        if a.items[index] < b.items[index] { return -1; };
        if a.items[index] > b.items[index] { return 1; };
        index = index + 1;
    }
    if len(a.items) < len(b.items) { return -1; };
    if len(a.items) > len(b.items) { return 1; };
    return 0;
}

fn ecs_eis_slice_hash(slice: EcsEntityIndexSetSlice) -> i64 {
    let hash_value: i64 = 19;
    let index: i64 = 0;
    let count = len(slice.items) as i64;
    while index < count {
        hash_value = (hash_value * 37) + slice.items[index];
        index = index + 1;
    }
    return hash_value;
}

fn ecs_eis_eq(a: EcsEntityIndexSetExtras, b: EcsEntityIndexSetExtras) -> bool {
    if len(a.items) != len(b.items) { return false; };
    let index: i64 = 0;
    let count = len(a.items) as i64;
    while index < count {
        if ecs_eis_contains(b, a.items[index]) != true { return false; };
        index = index + 1;
    }
    return true;
}

fn ecs_eis_intersection(a: EcsEntityIndexSetExtras, b: EcsEntityIndexSetExtras) -> EcsEntityIndexSetExtras {
    let out = ecs_eis_new();
    let index: i64 = 0;
    let count = len(a.items) as i64;
    while index < count {
        if ecs_eis_contains(b, a.items[index]) {
            let inserted = ecs_eis_insert(out, a.items[index]);
            out = inserted.set;
        };
        index = index + 1;
    }
    return out;
}

fn ecs_eis_union(a: EcsEntityIndexSetExtras, b: EcsEntityIndexSetExtras) -> EcsEntityIndexSetExtras {
    let out = ecs_eis_from_iter(a.items);
    let index: i64 = 0;
    let count = len(b.items) as i64;
    while index < count {
        let inserted = ecs_eis_insert(out, b.items[index]);
        out = inserted.set;
        index = index + 1;
    }
    return out;
}

fn ecs_eis_difference(a: EcsEntityIndexSetExtras, b: EcsEntityIndexSetExtras) -> EcsEntityIndexSetExtras {
    let out = ecs_eis_new();
    let index: i64 = 0;
    let count = len(a.items) as i64;
    while index < count {
        if ecs_eis_contains(b, a.items[index]) != true {
            let inserted = ecs_eis_insert(out, a.items[index]);
            out = inserted.set;
        };
        index = index + 1;
    }
    return out;
}

fn ecs_eis_symmetric_difference(a: EcsEntityIndexSetExtras, b: EcsEntityIndexSetExtras) -> EcsEntityIndexSetExtras {
    return ecs_eis_union(ecs_eis_difference(a, b), ecs_eis_difference(b, a));
}

fn ecs_eis_iter_from_slice(slice: EcsEntityIndexSetSlice) -> EcsEntityIndexSetIter {
    let count = len(slice.items) as i64;
    return EcsEntityIndexSetIter { items: slice.items, front: 0, back: count, trusted_unique: 1 };
}

fn ecs_eis_iter(set: EcsEntityIndexSetExtras) -> EcsEntityIndexSetIter {
    return ecs_eis_iter_from_slice(ecs_eis_as_slice(set));
}

fn ecs_eis_iter_default() -> EcsEntityIndexSetIter {
    return EcsEntityIndexSetIter { items: Vec::new(), front: 0, back: 0, trusted_unique: 1 };
}

fn ecs_eis_iter_clone(iter: EcsEntityIndexSetIter) -> EcsEntityIndexSetIter {
    return EcsEntityIndexSetIter { items: iter.items, front: iter.front, back: iter.back, trusted_unique: iter.trusted_unique };
}

fn ecs_eis_iter_remaining(iter: EcsEntityIndexSetIter) -> i64 {
    let remaining = iter.back - iter.front;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_eis_iter_next(iter: EcsEntityIndexSetIter) -> EcsEisIterNext {
    if iter.front >= iter.back { return EcsEisIterNext { iter: iter, has: 0, value: -1 }; };
    let value = iter.items[iter.front];
    iter.front = iter.front + 1;
    return EcsEisIterNext { iter: iter, has: 1, value: value };
}

fn ecs_eis_iter_next_back(iter: EcsEntityIndexSetIter) -> EcsEisIterNext {
    if iter.front >= iter.back { return EcsEisIterNext { iter: iter, has: 0, value: -1 }; };
    iter.back = iter.back - 1;
    let value = iter.items[iter.back];
    return EcsEisIterNext { iter: iter, has: 1, value: value };
}

fn ecs_eis_iter_as_slice(iter: EcsEntityIndexSetIter) -> EcsEntityIndexSetSlice {
    let out: Vec<i64> = Vec::new();
    let index = iter.front;
    while index < iter.back {
        out.push(iter.items[index]);
        index = index + 1;
    }
    return EcsEntityIndexSetSlice { items: out, boxed: 0 };
}

fn ecs_eis_into_iter(set: EcsEntityIndexSetExtras) -> EcsEntityIndexSetIntoIter {
    let count = len(set.items) as i64;
    return EcsEntityIndexSetIntoIter { items: set.items, front: 0, back: count, trusted_unique: 1 };
}

fn ecs_eis_into_iter_default() -> EcsEntityIndexSetIntoIter {
    return EcsEntityIndexSetIntoIter { items: Vec::new(), front: 0, back: 0, trusted_unique: 1 };
}

fn ecs_eis_into_iter_clone(iter: EcsEntityIndexSetIntoIter) -> EcsEntityIndexSetIntoIter {
    return EcsEntityIndexSetIntoIter { items: iter.items, front: iter.front, back: iter.back, trusted_unique: iter.trusted_unique };
}

fn ecs_eis_into_iter_next(iter: EcsEntityIndexSetIntoIter) -> EcsEisIntoIterNext {
    if iter.front >= iter.back { return EcsEisIntoIterNext { iter: iter, has: 0, value: -1 }; };
    let value = iter.items[iter.front];
    iter.front = iter.front + 1;
    return EcsEisIntoIterNext { iter: iter, has: 1, value: value };
}

fn ecs_eis_into_iter_next_back(iter: EcsEntityIndexSetIntoIter) -> EcsEisIntoIterNext {
    if iter.front >= iter.back { return EcsEisIntoIterNext { iter: iter, has: 0, value: -1 }; };
    iter.back = iter.back - 1;
    let value = iter.items[iter.back];
    return EcsEisIntoIterNext { iter: iter, has: 1, value: value };
}

fn ecs_eis_into_iter_as_slice(iter: EcsEntityIndexSetIntoIter) -> EcsEntityIndexSetSlice {
    let out: Vec<i64> = Vec::new();
    let index = iter.front;
    while index < iter.back {
        out.push(iter.items[index]);
        index = index + 1;
    }
    return EcsEntityIndexSetSlice { items: out, boxed: 0 };
}

fn ecs_eis_drain_clamped(set: EcsEntityIndexSetExtras, start: i64, end: i64) -> EcsEisDrainResult {
    let kept: Vec<i64> = Vec::new();
    let drained: Vec<i64> = Vec::new();
    let index: i64 = 0;
    let count = len(set.items) as i64;
    while index < count {
        if index >= start { if index < end { drained.push(set.items[index]); }; };
        if index < start { kept.push(set.items[index]); };
        if index >= end { kept.push(set.items[index]); };
        index = index + 1;
    }
    let drained_count = len(drained) as i64;
    return EcsEisDrainResult {
        set: EcsEntityIndexSetExtras { items: kept },
        drain: EcsEntityIndexSetDrain { items: drained, front: 0, back: drained_count, trusted_unique: 1 },
    };
}

fn ecs_eis_drain(set: EcsEntityIndexSetExtras, start: i64, end: i64) -> EcsEisDrainResult {
    let count = len(set.items) as i64;
    if start <= 0 {
        if end >= count { return ecs_eis_drain_clamped(set, 0, count); };
        if end < 0 { return ecs_eis_drain_clamped(set, 0, 0); };
        return ecs_eis_drain_clamped(set, 0, end);
    };
    if start >= count { return ecs_eis_drain_clamped(set, count, count); };
    if end <= start { return ecs_eis_drain_clamped(set, start, start); };
    if end >= count { return ecs_eis_drain_clamped(set, start, count); };
    return ecs_eis_drain_clamped(set, start, end);
}

fn ecs_eis_drain_next(drain: EcsEntityIndexSetDrain) -> EcsEisDrainNext {
    if drain.front >= drain.back { return EcsEisDrainNext { drain: drain, has: 0, value: -1 }; };
    let value = drain.items[drain.front];
    drain.front = drain.front + 1;
    return EcsEisDrainNext { drain: drain, has: 1, value: value };
}

fn ecs_eis_drain_next_back(drain: EcsEntityIndexSetDrain) -> EcsEisDrainNext {
    if drain.front >= drain.back { return EcsEisDrainNext { drain: drain, has: 0, value: -1 }; };
    drain.back = drain.back - 1;
    let value = drain.items[drain.back];
    return EcsEisDrainNext { drain: drain, has: 1, value: value };
}

fn ecs_eis_drain_as_slice(drain: EcsEntityIndexSetDrain) -> EcsEntityIndexSetSlice {
    let out: Vec<i64> = Vec::new();
    let index = drain.front;
    while index < drain.back {
        out.push(drain.items[index]);
        index = index + 1;
    }
    return EcsEntityIndexSetSlice { items: out, boxed: 0 };
}
