fn ecs_wrt_query_mut_a_b(w: EcsWrtWorld) -> EcsWrtPairQuery {
    let q0 = EcsWrtPairQuery { count: 0, eid0: 0, slot0: 0, ax0: 0, ay0: 0, bx0: 0, by0: 0, eid1: 0, slot1: 0, ax1: 0, ay1: 0, bx1: 0, by1: 0, eid2: 0, slot2: 0, ax2: 0, ay2: 0, bx2: 0, by2: 0, eid3: 0, slot3: 0, ax3: 0, ay3: 0, bx3: 0, by3: 0, eid4: 0, slot4: 0, ax4: 0, ay4: 0, bx4: 0, by4: 0, eid5: 0, slot5: 0, ax5: 0, ay5: 0, bx5: 0, by5: 0, eid6: 0, slot6: 0, ax6: 0, ay6: 0, bx6: 0, by6: 0, eid7: 0, slot7: 0, ax7: 0, ay7: 0, bx7: 0, by7: 0, eid8: 0, slot8: 0, ax8: 0, ay8: 0, bx8: 0, by8: 0, eid9: 0, slot9: 0, ax9: 0, ay9: 0, bx9: 0, by9: 0, eid10: 0, slot10: 0, ax10: 0, ay10: 0, bx10: 0, by10: 0, eid11: 0, slot11: 0, ax11: 0, ay11: 0, bx11: 0, by11: 0, eid12: 0, slot12: 0, ax12: 0, ay12: 0, bx12: 0, by12: 0, eid13: 0, slot13: 0, ax13: 0, ay13: 0, bx13: 0, by13: 0, eid14: 0, slot14: 0, ax14: 0, ay14: 0, bx14: 0, by14: 0, eid15: 0, slot15: 0, ax15: 0, ay15: 0, bx15: 0, by15: 0 };
    let i: i32 = 0;
    while i < w.a_count {
        let eid = _ecs_wrt_a_eid_at(w, i);
        let e = EcsWrtEntity { id: eid, generation: _ecs_wrt_gen_at(w, eid) };
        if ecs_wrt_is_alive(w, e) {
            let bslot = _ecs_wrt_b_slot_of(w, eid);
            if bslot >= 0 {
                let out = q0.count; q0 = _ecs_wrt_pq_set_eid(q0, out, eid); q0 = _ecs_wrt_pq_set_slot(q0, out, i);
                q0 = _ecs_wrt_pq_set_ax(q0, out, _ecs_wrt_a_x_at(w, i)); q0 = _ecs_wrt_pq_set_ay(q0, out, _ecs_wrt_a_y_at(w, i));
                q0 = _ecs_wrt_pq_set_bx(q0, out, _ecs_wrt_b_x_at(w, bslot)); q0 = _ecs_wrt_pq_set_by(q0, out, _ecs_wrt_b_y_at(w, bslot));
                q0.count = out + 1;
            };
        };
        i = i + 1;
    }
    return q0;
}

fn ecs_wrt_pair_write_a(w0: EcsWrtWorld, e: EcsWrtEntity, a_slot: i32, x: i32, y: i32) -> EcsWrtWorld {
    if ecs_wrt_is_alive(w0, e) != true { return w0; };
    if a_slot < 0 { return w0; };
    w0 = _ecs_wrt_set_a_x(w0, a_slot, x); w0 = _ecs_wrt_set_a_y(w0, a_slot, y); w0 = _ecs_wrt_set_a_changed_t(w0, a_slot, w0.change_tick); return w0;
}

fn ecs_wrt_insert_resource(w0: EcsWrtWorld, tick: i32) -> EcsWrtWorld { w0.res_has = 1; w0.res_tick = tick; return w0; }
fn ecs_wrt_get_resource(w: EcsWrtWorld) -> EcsWrtTime { return EcsWrtTime { tick: w.res_tick }; }
struct EcsWrtMessageReader { cursor: i32 }
struct EcsWrtRead { has_value: i32, amount: i32, cursor: i32 }
fn ecs_wrt_message_reader_new() -> EcsWrtMessageReader { return EcsWrtMessageReader { cursor: 0 }; }
fn ecs_wrt_message_reader_with_cursor(cursor: i32) -> EcsWrtMessageReader { return EcsWrtMessageReader { cursor: cursor }; }
fn ecs_wrt_read_has_value(r: EcsWrtRead) -> i32 { return r.has_value; }
fn ecs_wrt_read_amount(r: EcsWrtRead) -> i32 { return r.amount; }
fn ecs_wrt_read_cursor(r: EcsWrtRead) -> i32 { return r.cursor; }
fn ecs_wrt_write_message(w0: EcsWrtWorld, amount: i32) -> EcsWrtWorld { if w0.msg_tail >= ECS_WRT_CAP { panic(8703); }; w0 = _ecs_wrt_set_msg(w0, w0.msg_tail, amount); w0.msg_tail = w0.msg_tail + 1; return w0; }
fn ecs_wrt_read_message(w: EcsWrtWorld, reader: EcsWrtMessageReader) -> EcsWrtRead { if reader.cursor < w.msg_tail { return EcsWrtRead { has_value: 1, amount: _ecs_wrt_msg_at(w, reader.cursor), cursor: reader.cursor + 1 }; }; return EcsWrtRead { has_value: 0, amount: 0, cursor: reader.cursor }; }
