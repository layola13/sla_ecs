// Deep bed for lib/world_registry_typed.sla (Batch 394).
// Self-contained fixed-cap mirror of RegistryTypedWorld<A,B,R,M>.
// Shallow composes RegistryWorld + DynamicComponentStore<A/B> + Query wrappers; deep inlines
// a cap-16 entity allocator, A/B registry membership columns with added/changed ticks, typed
// A/B stores, a resource slot, and cap-16 message queue. No @import, no generics, no tuple destructuring.

const ECS_WRT_CAP: i32 = 16;
const ECS_WRT_A_ID: i32 = 0;
const ECS_WRT_B_ID: i32 = 1;

struct EcsWrtEntity { id: i32, generation: i32 }
fn ecs_wrt_entity_id(e: EcsWrtEntity) -> i32 { return e.id; }
fn ecs_wrt_entity_gen(e: EcsWrtEntity) -> i32 { return e.generation; }
fn ecs_wrt_entity_new(id: i32, gen: i32) -> EcsWrtEntity { return EcsWrtEntity { id: id, generation: gen }; }

struct EcsWrtPos { x: i32, y: i32 }
struct EcsWrtVel { x: i32, y: i32 }
struct EcsWrtTime { tick: i32 }
struct EcsWrtEvent { amount: i32 }
fn ecs_wrt_pos_new(x: i32, y: i32) -> EcsWrtPos { return EcsWrtPos { x: x, y: y }; }
fn ecs_wrt_pos_x(p: EcsWrtPos) -> i32 { return p.x; }
fn ecs_wrt_pos_y(p: EcsWrtPos) -> i32 { return p.y; }
fn ecs_wrt_vel_new(x: i32, y: i32) -> EcsWrtVel { return EcsWrtVel { x: x, y: y }; }
fn ecs_wrt_vel_x(v: EcsWrtVel) -> i32 { return v.x; }
fn ecs_wrt_vel_y(v: EcsWrtVel) -> i32 { return v.y; }
fn ecs_wrt_time_new(t: i32) -> EcsWrtTime { return EcsWrtTime { tick: t }; }
fn ecs_wrt_time_tick(t: EcsWrtTime) -> i32 { return t.tick; }
fn ecs_wrt_event_new(a: i32) -> EcsWrtEvent { return EcsWrtEvent { amount: a }; }
fn ecs_wrt_event_amount(e: EcsWrtEvent) -> i32 { return e.amount; }

