fn _ecs_wrt_a_slot_of(w: EcsWrtWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.a_count {
        if _ecs_wrt_a_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_wrt_b_slot_of(w: EcsWrtWorld, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.b_count {
        if _ecs_wrt_b_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_wrt_id_is_free(w: EcsWrtWorld, id: i32) -> bool {
    let i: i32 = 0;
    while i < w.free_count { if _ecs_wrt_free_id_at(w, i) == id { return true; }; i = i + 1; }
    return false;
}

struct EcsWrtSpawn { world: EcsWrtWorld, entity: EcsWrtEntity }
fn ecs_wrt_spawn_world(s: EcsWrtSpawn) -> EcsWrtWorld { return s.world; }
fn ecs_wrt_spawn_entity(s: EcsWrtSpawn) -> EcsWrtEntity { return s.entity; }

fn ecs_wrt_world_spawn(w0: EcsWrtWorld) -> EcsWrtSpawn {
    if w0.free_count > 0 {
        let nf = w0.free_count - 1;
        let id = _ecs_wrt_free_id_at(w0, nf);
        w0.free_count = nf;
        w0 = _ecs_wrt_set_free_id(w0, nf, 0);
        let gen = _ecs_wrt_gen_at(w0, id);
        return EcsWrtSpawn { world: w0, entity: EcsWrtEntity { id: id, generation: gen } };
    };
    if w0.next_id >= ECS_WRT_CAP { return EcsWrtSpawn { world: w0, entity: EcsWrtEntity { id: -1, generation: 0 } }; };
    let id = w0.next_id;
    w0.next_id = id + 1;
    let gen = _ecs_wrt_gen_at(w0, id);
    return EcsWrtSpawn { world: w0, entity: EcsWrtEntity { id: id, generation: gen } };
}

fn ecs_wrt_is_alive(w: EcsWrtWorld, e: EcsWrtEntity) -> bool {
    if e.id <= 0 { return false; };
    if e.id >= ECS_WRT_CAP { return false; };
    if e.id >= w.next_id { return false; };
    if _ecs_wrt_id_is_free(w, e.id) { return false; };
    return _ecs_wrt_gen_at(w, e.id) == e.generation;
}

fn ecs_wrt_world_entity_count(w: EcsWrtWorld) -> i32 { return w.next_id - w.free_count - 1; }

fn ecs_wrt_insert_a(w0: EcsWrtWorld, e: EcsWrtEntity, x: i32, y: i32) -> EcsWrtWorld {
    if ecs_wrt_is_alive(w0, e) != true { panic(8701); };
    let slot = _ecs_wrt_a_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_wrt_set_a_x(w0, slot, x);
        w0 = _ecs_wrt_set_a_y(w0, slot, y);
        w0 = _ecs_wrt_set_a_changed_t(w0, slot, w0.change_tick);
        return w0;
    };
    let ns = w0.a_count;
    if ns >= ECS_WRT_CAP { panic(8702); };
    w0 = _ecs_wrt_set_a_eid(w0, ns, e.id);
    w0 = _ecs_wrt_set_a_x(w0, ns, x);
    w0 = _ecs_wrt_set_a_y(w0, ns, y);
    w0 = _ecs_wrt_set_a_added_t(w0, ns, w0.change_tick);
    w0 = _ecs_wrt_set_a_changed_t(w0, ns, w0.change_tick);
    w0.a_count = ns + 1;
    return w0;
}

fn ecs_wrt_has_a(w: EcsWrtWorld, e: EcsWrtEntity) -> bool {
    if ecs_wrt_is_alive(w, e) != true { return false; };
    return _ecs_wrt_a_slot_of(w, e.id) >= 0;
}

fn ecs_wrt_get_a(w: EcsWrtWorld, e: EcsWrtEntity) -> EcsWrtPos {
    if ecs_wrt_has_a(w, e) != true { panic(8901); };
    let slot = _ecs_wrt_a_slot_of(w, e.id);
    return EcsWrtPos { x: _ecs_wrt_a_x_at(w, slot), y: _ecs_wrt_a_y_at(w, slot) };
}

fn ecs_wrt_remove_a(w0: EcsWrtWorld, e: EcsWrtEntity) -> EcsWrtWorld {
    let slot = _ecs_wrt_a_slot_of(w0, e.id);
    if slot < 0 { return w0; };
    let last = w0.a_count - 1;
    if slot != last {
        let last_eid = _ecs_wrt_a_eid_at(w0, last);
