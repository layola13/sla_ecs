// Deepened Bevy ECS deferred command queue for DynamicWorld
// (shallow lib/commands_dynamic.sla deep; src/system/commands/dynamic.rs).
//
// Mirrors the shallow `Commands<A, B, R, M>` queue but replaces the generic params with a
// fixed-cap-8 kind-discriminated command queue and scalar side-payload slots. Avoids generic
// type params and fn-ptr world-application: this library owns the command queue and introspects
// it; applying to a world would compose with the world-facade module separately.
//
// Kinds (mirror shallow): INSERT_A=1, INSERT_B=2, DESPAWN=3, INSERT_RESOURCE=4, WRITE_MESSAGE=5.
// Side payloads: a_values (pa), b_values (pb), resource_values (pres), message_values (pmsg),
// each cap-8 i32 scalar. The vidx slot of an INSERT_A/INSERT_B/INSERT_RESOURCE/WRITE_MESSAGE
// command stores the index into its corresponding side array. The cN slot discriminates A (1)
// vs B (2) component-id for INSERT_A/INSERT_B respectively (mirrors the shallow's separate
// a_values/b_values columns distinguished by kind).
// Operations: new, command builder, insert_a (queue+a value), insert_b (queue+b value), despawn,
// insert_resource, write_message, len, count_by_kind, resolve_value, resolve_component,
// clear, per-slot accessors.

const ECS_CMD_DYN_CAP_DEEP: i32 = 8;
const ECS_CMD_DYN_INSERT_A: i32 = 1;
const ECS_CMD_DYN_INSERT_B: i32 = 2;
const ECS_CMD_DYN_DESPAWN: i32 = 3;
const ECS_CMD_DYN_INSERT_RESOURCE: i32 = 4;
const ECS_CMD_DYN_WRITE_MESSAGE: i32 = 5;
const ECS_CMD_DYN_COMPONENT_A: i32 = 11;
const ECS_CMD_DYN_COMPONENT_B: i32 = 12;

struct EcsDynCommandDeep {
    kind: i32,
    entity_id: i32,
    component_id: i32,
    value_index: i32,
}

fn ecs_dyn_command(kind: i32, entity_id: i32, component_id: i32, value_index: i32) -> EcsDynCommandDeep {
    return EcsDynCommandDeep { kind: kind, entity_id: entity_id, component_id: component_id, value_index: value_index };
}

fn ecs_dyn_command_kind(c: EcsDynCommandDeep) -> i32 { return c.kind; }
fn ecs_dyn_command_entity_id(c: EcsDynCommandDeep) -> i32 { return c.entity_id; }
fn ecs_dyn_command_component_id(c: EcsDynCommandDeep) -> i32 { return c.component_id; }
fn ecs_dyn_command_value_index(c: EcsDynCommandDeep) -> i32 { return c.value_index; }

struct EcsDynCommandsDeep {
    // command list cap-8 with scalar field storage
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32,
    pa_count: i32, pb_count: i32, pres_count: i32, pmsg_count: i32,
    pa0: i32, pa1: i32, pa2: i32, pa3: i32, pa4: i32, pa5: i32, pa6: i32, pa7: i32,
    pb0: i32, pb1: i32, pb2: i32, pb3: i32, pb4: i32, pb5: i32, pb6: i32, pb7: i32,
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    m0: i32, m1: i32, m2: i32, m3: i32, m4: i32, m5: i32, m6: i32, m7: i32,
    count: i32,
}

fn ecs_dyn_commands_new() -> EcsDynCommandsDeep {
    let c = EcsDynCommandsDeep {
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0,
        pa_count: 0, pb_count: 0, pres_count: 0, pmsg_count: 0,
        pa0: 0, pa1: 0, pa2: 0, pa3: 0, pa4: 0, pa5: 0, pa6: 0, pa7: 0,
        pb0: 0, pb1: 0, pb2: 0, pb3: 0, pb4: 0, pb5: 0, pb6: 0, pb7: 0,
        r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0,
        m0: 0, m1: 0, m2: 0, m3: 0, m4: 0, m5: 0, m6: 0, m7: 0,
        count: 0,
    };
    return c;
}

fn ecs_dyn_commands_len(c: EcsDynCommandsDeep) -> i32 { return c.count; }

// per-slot read accessors
fn ecs_dyn_commands_kind_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.k0; };
    if idx == 1 { return c.k1; };
    if idx == 2 { return c.k2; };
    if idx == 3 { return c.k3; };
    if idx == 4 { return c.k4; };
    if idx == 5 { return c.k5; };
    if idx == 6 { return c.k6; };
    if idx == 7 { return c.k7; };
    return 0;
}

fn ecs_dyn_commands_entity_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    return 0;
}

fn ecs_dyn_commands_cmp_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    if idx == 7 { return c.c7; };
    return 0;
}

fn ecs_dyn_commands_idx_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.v0; };
    if idx == 1 { return c.v1; };
    if idx == 2 { return c.v2; };
    if idx == 3 { return c.v3; };
    if idx == 4 { return c.v4; };
    if idx == 5 { return c.v5; };
    if idx == 6 { return c.v6; };
    if idx == 7 { return c.v7; };
    return 0;
}

// side payload setters/readers (pa — A component values)
fn ecs_dyn_commands_set_pa(c: EcsDynCommandsDeep, idx: i32, value: i32) -> EcsDynCommandsDeep {
    if idx == 0 { c.pa0 = value; };
    if idx == 1 { c.pa1 = value; };
    if idx == 2 { c.pa2 = value; };
    if idx == 3 { c.pa3 = value; };
    if idx == 4 { c.pa4 = value; };
    if idx == 5 { c.pa5 = value; };
    if idx == 6 { c.pa6 = value; };
    if idx == 7 { c.pa7 = value; };
    return c;
}

fn ecs_dyn_commands_pa_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.pa0; };
    if idx == 1 { return c.pa1; };
    if idx == 2 { return c.pa2; };
    if idx == 3 { return c.pa3; };
    if idx == 4 { return c.pa4; };
    if idx == 5 { return c.pa5; };
    if idx == 6 { return c.pa6; };
    if idx == 7 { return c.pa7; };
    return 0;
}

// pb — B component values
fn ecs_dyn_commands_set_pb(c: EcsDynCommandsDeep, idx: i32, value: i32) -> EcsDynCommandsDeep {
    if idx == 0 { c.pb0 = value; };
    if idx == 1 { c.pb1 = value; };
    if idx == 2 { c.pb2 = value; };
    if idx == 3 { c.pb3 = value; };
    if idx == 4 { c.pb4 = value; };
    if idx == 5 { c.pb5 = value; };
    if idx == 6 { c.pb6 = value; };
    if idx == 7 { c.pb7 = value; };
    return c;
}

fn ecs_dyn_commands_pb_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.pb0; };
    if idx == 1 { return c.pb1; };
    if idx == 2 { return c.pb2; };
    if idx == 3 { return c.pb3; };
    if idx == 4 { return c.pb4; };
    if idx == 5 { return c.pb5; };
    if idx == 6 { return c.pb6; };
    if idx == 7 { return c.pb7; };
    return 0;
}

// pres — resource values
fn ecs_dyn_commands_set_pres(c: EcsDynCommandsDeep, idx: i32, value: i32) -> EcsDynCommandsDeep {
    if idx == 0 { c.r0 = value; };
    if idx == 1 { c.r1 = value; };
    if idx == 2 { c.r2 = value; };
    if idx == 3 { c.r3 = value; };
    if idx == 4 { c.r4 = value; };
    if idx == 5 { c.r5 = value; };
    if idx == 6 { c.r6 = value; };
    if idx == 7 { c.r7 = value; };
    return c;
}

fn ecs_dyn_commands_pres_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.r0; };
    if idx == 1 { return c.r1; };
    if idx == 2 { return c.r2; };
    if idx == 3 { return c.r3; };
    if idx == 4 { return c.r4; };
    if idx == 5 { return c.r5; };
    if idx == 6 { return c.r6; };
    if idx == 7 { return c.r7; };
    return 0;
}

// pmsg — message values
fn ecs_dyn_commands_set_pmsg(c: EcsDynCommandsDeep, idx: i32, value: i32) -> EcsDynCommandsDeep {
    if idx == 0 { c.m0 = value; };
    if idx == 1 { c.m1 = value; };
    if idx == 2 { c.m2 = value; };
    if idx == 3 { c.m3 = value; };
    if idx == 4 { c.m4 = value; };
    if idx == 5 { c.m5 = value; };
    if idx == 6 { c.m6 = value; };
    if idx == 7 { c.m7 = value; };
    return c;
}

fn ecs_dyn_commands_pmsg_at(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.m0; };
    if idx == 1 { return c.m1; };
    if idx == 2 { return c.m2; };
    if idx == 3 { return c.m3; };
    if idx == 4 { return c.m4; };
    if idx == 5 { return c.m5; };
    if idx == 6 { return c.m6; };
    if idx == 7 { return c.m7; };
    return 0;
}

fn ecs_dyn_commands_pa_count(c: EcsDynCommandsDeep) -> i32 { return c.pa_count; }
fn ecs_dyn_commands_pb_count(c: EcsDynCommandsDeep) -> i32 { return c.pb_count; }
fn ecs_dyn_commands_pres_count(c: EcsDynCommandsDeep) -> i32 { return c.pres_count; }
fn ecs_dyn_commands_pmsg_count(c: EcsDynCommandsDeep) -> i32 { return c.pmsg_count; }

// set command slot fields (k/e/c/v) — per-branch scalar assign.
fn ecs_dyn_commands_set_slot(c: EcsDynCommandsDeep, idx: i32, k: i32, e: i32, cmp: i32, v: i32) -> EcsDynCommandsDeep {
    if idx == 0 { c.k0 = k; c.e0 = e; c.c0 = cmp; c.v0 = v; };
    if idx == 1 { c.k1 = k; c.e1 = e; c.c1 = cmp; c.v1 = v; };
    if idx == 2 { c.k2 = k; c.e2 = e; c.c2 = cmp; c.v2 = v; };
    if idx == 3 { c.k3 = k; c.e3 = e; c.c3 = cmp; c.v3 = v; };
    if idx == 4 { c.k4 = k; c.e4 = e; c.c4 = cmp; c.v4 = v; };
    if idx == 5 { c.k5 = k; c.e5 = e; c.c5 = cmp; c.v5 = v; };
    if idx == 6 { c.k6 = k; c.e6 = e; c.c6 = cmp; c.v6 = v; };
    if idx == 7 { c.k7 = k; c.e7 = e; c.c7 = cmp; c.v7 = v; };
    return c;
}

// reserve_entity: returns next placeholder id (mirrors shallow that spawns a world entity;
// deep variant returns the next id without a world arg). Placeholder 0 indicates no actual
// allocation in this isolated queue.
fn ecs_dyn_commands_reserve_entity(c: EcsDynCommandsDeep) -> (EcsDynCommandsDeep, i32) {
    return (c, 0);
}

// insert_a: queue INSERT_A command + side payload (A component value).
fn ecs_dyn_commands_insert_a(c: EcsDynCommandsDeep, entity_id: i32, value: i32) -> EcsDynCommandsDeep {
    if c.count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    if c.pa_count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    let slot: i32 = c.pa_count;
    c = ecs_dyn_commands_set_pa(c, slot, value);
    c.pa_count = c.pa_count + 1;
    c = ecs_dyn_commands_set_slot(c, c.count, ECS_CMD_DYN_INSERT_A, entity_id, ECS_CMD_DYN_COMPONENT_A, slot);
    c.count = c.count + 1;
    return c;
}

// insert_b: queue INSERT_B command + side payload (B component value).
fn ecs_dyn_commands_insert_b(c: EcsDynCommandsDeep, entity_id: i32, value: i32) -> EcsDynCommandsDeep {
    if c.count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    if c.pb_count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    let slot: i32 = c.pb_count;
    c = ecs_dyn_commands_set_pb(c, slot, value);
    c.pb_count = c.pb_count + 1;
    c = ecs_dyn_commands_set_slot(c, c.count, ECS_CMD_DYN_INSERT_B, entity_id, ECS_CMD_DYN_COMPONENT_B, slot);
    c.count = c.count + 1;
    return c;
}

// despawn command (no payload).
fn ecs_dyn_commands_despawn(c: EcsDynCommandsDeep, entity_id: i32) -> EcsDynCommandsDeep {
    if c.count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    c = ecs_dyn_commands_set_slot(c, c.count, ECS_CMD_DYN_DESPAWN, entity_id, 0, -1);
    c.count = c.count + 1;
    return c;
}

// insert_resource: side payload slot for resource value.
fn ecs_dyn_commands_insert_resource(c: EcsDynCommandsDeep, value: i32) -> EcsDynCommandsDeep {
    if c.count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    if c.pres_count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    let slot: i32 = c.pres_count;
    c = ecs_dyn_commands_set_pres(c, slot, value);
    c.pres_count = c.pres_count + 1;
    c = ecs_dyn_commands_set_slot(c, c.count, ECS_CMD_DYN_INSERT_RESOURCE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// write_message: side payload slot for message value.
fn ecs_dyn_commands_write_message(c: EcsDynCommandsDeep, value: i32) -> EcsDynCommandsDeep {
    if c.count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    if c.pmsg_count >= ECS_CMD_DYN_CAP_DEEP { return c; };
    let slot: i32 = c.pmsg_count;
    c = ecs_dyn_commands_set_pmsg(c, slot, value);
    c.pmsg_count = c.pmsg_count + 1;
    c = ecs_dyn_commands_set_slot(c, c.count, ECS_CMD_DYN_WRITE_MESSAGE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// count commands by kind (introspection analogue).
fn ecs_dyn_commands_count_by_kind(c: EcsDynCommandsDeep, kind: i32) -> i32 {
    let i: i32 = 0;
    let out: i32 = 0;
    while i < c.count {
        if ecs_dyn_commands_kind_at(c, i) == kind { out = out + 1; };
        i = i + 1;
    }
    return out;
}

// resolve side payload by command: read the correct side array index depending on kind.
fn ecs_dyn_commands_resolve_value(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_dyn_commands_kind_at(c, idx);
    let vidx: i32 = ecs_dyn_commands_idx_at(c, idx);
    if kind == ECS_CMD_DYN_INSERT_A {
        return ecs_dyn_commands_pa_at(c, vidx);
    };
    if kind == ECS_CMD_DYN_INSERT_B {
        return ecs_dyn_commands_pb_at(c, vidx);
    };
    if kind == ECS_CMD_DYN_INSERT_RESOURCE {
        return ecs_dyn_commands_pres_at(c, vidx);
    };
    if kind == ECS_CMD_DYN_WRITE_MESSAGE {
        return ecs_dyn_commands_pmsg_at(c, vidx);
    };
    return 0;
}

// resolve_component: returns the component-id discriminator for INSERT_A/INSERT_B (A vs B),
// 0 for non-component kinds. Lets downstream consumers distinguish which component column an
// insert targeted without re-reading the kind.
fn ecs_dyn_commands_resolve_component(c: EcsDynCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_dyn_commands_kind_at(c, idx);
    if kind == ECS_CMD_DYN_INSERT_A {
        return ecs_dyn_commands_cmp_at(c, idx);
    };
    if kind == ECS_CMD_DYN_INSERT_B {
        return ecs_dyn_commands_cmp_at(c, idx);
    };
    return 0;
}

fn ecs_dyn_commands_clear(c: EcsDynCommandsDeep) -> EcsDynCommandsDeep {
    return ecs_dyn_commands_new();
}
