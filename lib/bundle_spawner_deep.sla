// Deepened Bevy ECS bundle spawner/inserter/remover.
// Fixed spawned/target slots capacity-4 (src/bundle/spawner.rs + insert.rs).
// Shallow lib/bundle_spawner.sla retained.

struct EcsBsdSpawner {
    world_id: i64,
    change_tick: i32,
    e0: i64, e1: i64, e2: i64, e3: i64,
    len: i32,
    reserved_capacity: i64,
}

struct EcsBsdInsert {
    world_id: i64,
    change_tick: i32,
    bundle_type_id: i32,
    t0: i64, t1: i64, t2: i64, t3: i64,
    len: i32,
}

struct EcsBsdInserter {
    world_id: i64,
    change_tick: i32,
    bundle_type_id: i32,
    inserted_count: i64,
}

struct EcsBsdRemover {
    world_id: i64,
    change_tick: i32,
    bundle_type_id: i32,
    removed_count: i64,
}

fn ecs_bsd_spawner_new(world_id: i64, change_tick: i32) -> EcsBsdSpawner {
    return EcsBsdSpawner {
        world_id: world_id, change_tick: change_tick,
        e0: 0, e1: 0, e2: 0, e3: 0, len: 0, reserved_capacity: 0,
    };
}

fn ecs_bsd_spawner_world(s: EcsBsdSpawner) -> i64 { return s.world_id; }
fn ecs_bsd_spawner_tick(s: EcsBsdSpawner) -> i32 { return s.change_tick; }
fn ecs_bsd_spawner_len(s: EcsBsdSpawner) -> i32 { return s.len; }
fn ecs_bsd_spawner_is_empty(s: EcsBsdSpawner) -> bool { return s.len == 0; }
fn ecs_bsd_spawner_reserved(s: EcsBsdSpawner) -> i64 { return s.reserved_capacity; }

fn ecs_bsd_spawner_rebuild(
    world_id: i64, change_tick: i32,
    e0: i64, e1: i64, e2: i64, e3: i64,
    len: i32, reserved_capacity: i64
) -> EcsBsdSpawner {
    return EcsBsdSpawner {
        world_id: world_id, change_tick: change_tick,
        e0: e0, e1: e1, e2: e2, e3: e3,
        len: len, reserved_capacity: reserved_capacity,
    };
}

fn ecs_bsd_spawner_reserve(s: EcsBsdSpawner, additional: i64) -> EcsBsdSpawner {
    return ecs_bsd_spawner_rebuild(
        s.world_id, s.change_tick, s.e0, s.e1, s.e2, s.e3, s.len, s.reserved_capacity + additional
    );
}

fn ecs_bsd_spawner_spawn(s: EcsBsdSpawner, entity: i64) -> EcsBsdSpawner {
    let e0 = s.e0; let e1 = s.e1; let e2 = s.e2; let e3 = s.e3;
    let ln = s.len;
    if ln >= 4 { return s; };
    if ln == 0 {
        return ecs_bsd_spawner_rebuild(s.world_id, s.change_tick, entity, 0, 0, 0, 1, s.reserved_capacity);
    };
    if ln == 1 {
        return ecs_bsd_spawner_rebuild(s.world_id, s.change_tick, e0, entity, 0, 0, 2, s.reserved_capacity);
    };
    if ln == 2 {
        return ecs_bsd_spawner_rebuild(s.world_id, s.change_tick, e0, e1, entity, 0, 3, s.reserved_capacity);
    };
    if ln == 3 {
        return ecs_bsd_spawner_rebuild(s.world_id, s.change_tick, e0, e1, e2, entity, 4, s.reserved_capacity);
    };
    return s;
}

fn ecs_bsd_spawner_get(s: EcsBsdSpawner, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    return -1;
}

fn ecs_bsd_spawner_spawn_batch4(s: EcsBsdSpawner, a: i64, b: i64, c: i64, d: i64) -> EcsBsdSpawner {
    s = ecs_bsd_spawner_spawn(s, a);
    s = ecs_bsd_spawner_spawn(s, b);
    s = ecs_bsd_spawner_spawn(s, c);
    s = ecs_bsd_spawner_spawn(s, d);
    return s;
}

// InsertBundle
fn ecs_bsd_insert_new(world_id: i64, change_tick: i32, bundle_type_id: i32) -> EcsBsdInsert {
    return EcsBsdInsert {
        world_id: world_id, change_tick: change_tick, bundle_type_id: bundle_type_id,
        t0: 0, t1: 0, t2: 0, t3: 0, len: 0,
    };
}

fn ecs_bsd_insert_rebuild(
    world_id: i64, change_tick: i32, bundle_type_id: i32,
    t0: i64, t1: i64, t2: i64, t3: i64, len: i32
) -> EcsBsdInsert {
    return EcsBsdInsert {
        world_id: world_id, change_tick: change_tick, bundle_type_id: bundle_type_id,
        t0: t0, t1: t1, t2: t2, t3: t3, len: len,
    };
}

fn ecs_bsd_insert_len(ib: EcsBsdInsert) -> i32 { return ib.len; }
fn ecs_bsd_insert_is_empty(ib: EcsBsdInsert) -> bool { return ib.len == 0; }
fn ecs_bsd_insert_bundle_type(ib: EcsBsdInsert) -> i32 { return ib.bundle_type_id; }
fn ecs_bsd_insert_world(ib: EcsBsdInsert) -> i64 { return ib.world_id; }

fn ecs_bsd_insert_target(ib: EcsBsdInsert, entity: i64) -> EcsBsdInsert {
    let t0 = ib.t0; let t1 = ib.t1; let t2 = ib.t2; let t3 = ib.t3;
    let ln = ib.len;
    if ln >= 4 { return ib; };
    if ln == 0 {
        return ecs_bsd_insert_rebuild(ib.world_id, ib.change_tick, ib.bundle_type_id, entity, 0, 0, 0, 1);
    };
    if ln == 1 {
        return ecs_bsd_insert_rebuild(ib.world_id, ib.change_tick, ib.bundle_type_id, t0, entity, 0, 0, 2);
    };
    if ln == 2 {
        return ecs_bsd_insert_rebuild(ib.world_id, ib.change_tick, ib.bundle_type_id, t0, t1, entity, 0, 3);
    };
    if ln == 3 {
        return ecs_bsd_insert_rebuild(ib.world_id, ib.change_tick, ib.bundle_type_id, t0, t1, t2, entity, 4);
    };
    return ib;
}

fn ecs_bsd_insert_get(ib: EcsBsdInsert, idx: i32) -> i64 {
    if idx == 0 { return ib.t0; };
    if idx == 1 { return ib.t1; };
    if idx == 2 { return ib.t2; };
    if idx == 3 { return ib.t3; };
    return -1;
}

// BundleInserter
fn ecs_bsd_inserter_new(world_id: i64, change_tick: i32, bundle_type_id: i32) -> EcsBsdInserter {
    return EcsBsdInserter {
        world_id: world_id, change_tick: change_tick, bundle_type_id: bundle_type_id, inserted_count: 0,
    };
}

fn ecs_bsd_inserter_insert(bi: EcsBsdInserter) -> EcsBsdInserter {
    return EcsBsdInserter {
        world_id: bi.world_id, change_tick: bi.change_tick, bundle_type_id: bi.bundle_type_id,
        inserted_count: bi.inserted_count + 1,
    };
}

fn ecs_bsd_inserter_insert_batch(bi: EcsBsdInserter, count: i64) -> EcsBsdInserter {
    return EcsBsdInserter {
        world_id: bi.world_id, change_tick: bi.change_tick, bundle_type_id: bi.bundle_type_id,
        inserted_count: bi.inserted_count + count,
    };
}

fn ecs_bsd_inserter_count(bi: EcsBsdInserter) -> i64 { return bi.inserted_count; }
fn ecs_bsd_inserter_bundle_type(bi: EcsBsdInserter) -> i32 { return bi.bundle_type_id; }

// BundleRemover
fn ecs_bsd_remover_new(world_id: i64, change_tick: i32, bundle_type_id: i32) -> EcsBsdRemover {
    return EcsBsdRemover {
        world_id: world_id, change_tick: change_tick, bundle_type_id: bundle_type_id, removed_count: 0,
    };
}

fn ecs_bsd_remover_remove(br: EcsBsdRemover) -> EcsBsdRemover {
    return EcsBsdRemover {
        world_id: br.world_id, change_tick: br.change_tick, bundle_type_id: br.bundle_type_id,
        removed_count: br.removed_count + 1,
    };
}

fn ecs_bsd_remover_count(br: EcsBsdRemover) -> i64 { return br.removed_count; }
fn ecs_bsd_remover_bundle_type(br: EcsBsdRemover) -> i32 { return br.bundle_type_id; }
