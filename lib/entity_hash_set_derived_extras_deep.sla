// Deepened Bevy ECS EntityHashSet derived/wrapper extras.
// Constructor kinds + insert/contains/iter/set ops capacity-8.
// Shallow lib/entity_hash_set_derived_extras.sla retained.

struct EcsEhsdDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    capacity_hint: i32,
    constructed_kind: i32,
}

fn ecs_ehsd_new() -> EcsEhsdDeep {
    return EcsEhsdDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: 0, constructed_kind: 1,
    };
}
fn ecs_ehsd_default() -> EcsEhsdDeep {
    return EcsEhsdDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: 0, constructed_kind: 2,
    };
}
fn ecs_ehsd_with_capacity(capacity: i32) -> EcsEhsdDeep {
    let c = capacity;
    if c < 0 { c = 0; };
    return EcsEhsdDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity_hint: c, constructed_kind: 3,
    };
}

fn ecs_ehsd_len(s: EcsEhsdDeep) -> i32 { return s.len; }
fn ecs_ehsd_kind(s: EcsEhsdDeep) -> i32 { return s.constructed_kind; }
fn ecs_ehsd_capacity(s: EcsEhsdDeep) -> i32 { return s.capacity_hint; }
fn ecs_ehsd_is_empty(s: EcsEhsdDeep) -> bool { return s.len == 0; }

fn ecs_ehsd_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, capacity_hint: i32, constructed_kind: i32
) -> EcsEhsdDeep {
    return EcsEhsdDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
        len: len, capacity_hint: capacity_hint, constructed_kind: constructed_kind,
    };
}

fn ecs_ehsd_clone(s: EcsEhsdDeep) -> EcsEhsdDeep {
    return ecs_ehsd_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, s.e7, s.len, s.capacity_hint, 4);
}

fn ecs_ehsd_from_hash_set(s: EcsEhsdDeep) -> EcsEhsdDeep {
    return ecs_ehsd_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, s.e7, s.len, s.capacity_hint, 6);
}

fn ecs_ehsd_contains(s: EcsEhsdDeep, value: i64) -> bool {
    if s.len >= 1 { if s.e0 == value { return true; }; };
    if s.len >= 2 { if s.e1 == value { return true; }; };
    if s.len >= 3 { if s.e2 == value { return true; }; };
    if s.len >= 4 { if s.e3 == value { return true; }; };
    if s.len >= 5 { if s.e4 == value { return true; }; };
    if s.len >= 6 { if s.e5 == value { return true; }; };
    if s.len >= 7 { if s.e6 == value { return true; }; };
    if s.len >= 8 { if s.e7 == value { return true; }; };
    return false;
}

struct EcsEhsdInsDeep {
    inserted: bool,
    set: EcsEhsdDeep,
}
fn ecs_ehsd_ins_inserted(r: EcsEhsdInsDeep) -> bool { return r.inserted; }
fn ecs_ehsd_ins_set(r: EcsEhsdInsDeep) -> EcsEhsdDeep { return r.set; }

fn ecs_ehsd_insert(s: EcsEhsdDeep, value: i64) -> EcsEhsdInsDeep {
    if ecs_ehsd_contains(s, value) {
        return EcsEhsdInsDeep { inserted: false, set: s };
    };
    let e0 = s.e0; let e1 = s.e1; let e2 = s.e2; let e3 = s.e3;
    let e4 = s.e4; let e5 = s.e5; let e6 = s.e6; let e7 = s.e7;
    let ln = s.len; let cap = s.capacity_hint; let kind = s.constructed_kind;
    if ln >= 8 {
        return EcsEhsdInsDeep { inserted: false, set: s };
    };
    if ln == 0 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(value, 0, 0, 0, 0, 0, 0, 0, 1, cap, kind) };
    };
    if ln == 1 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, value, 0, 0, 0, 0, 0, 0, 2, cap, kind) };
    };
    if ln == 2 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, e1, value, 0, 0, 0, 0, 0, 3, cap, kind) };
    };
    if ln == 3 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, e1, e2, value, 0, 0, 0, 0, 4, cap, kind) };
    };
    if ln == 4 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, e1, e2, e3, value, 0, 0, 0, 5, cap, kind) };
    };
    if ln == 5 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, e1, e2, e3, e4, value, 0, 0, 6, cap, kind) };
    };
    if ln == 6 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, e1, e2, e3, e4, e5, value, 0, 7, cap, kind) };
    };
    if ln == 7 {
        return EcsEhsdInsDeep { inserted: true, set: ecs_ehsd_rebuild(e0, e1, e2, e3, e4, e5, e6, value, 8, cap, kind) };
    };
    return EcsEhsdInsDeep { inserted: false, set: s };
}

fn ecs_ehsd_at(s: EcsEhsdDeep, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return -1;
}

fn ecs_ehsd_eq(a: EcsEhsdDeep, b: EcsEhsdDeep) -> bool {
    if a.len != b.len { return false; };
    if a.len >= 1 { if ecs_ehsd_contains(b, a.e0) != true { return false; }; };
    if a.len >= 2 { if ecs_ehsd_contains(b, a.e1) != true { return false; }; };
    if a.len >= 3 { if ecs_ehsd_contains(b, a.e2) != true { return false; }; };
    if a.len >= 4 { if ecs_ehsd_contains(b, a.e3) != true { return false; }; };
    if a.len >= 5 { if ecs_ehsd_contains(b, a.e4) != true { return false; }; };
    if a.len >= 6 { if ecs_ehsd_contains(b, a.e5) != true { return false; }; };
    if a.len >= 7 { if ecs_ehsd_contains(b, a.e6) != true { return false; }; };
    if a.len >= 8 { if ecs_ehsd_contains(b, a.e7) != true { return false; }; };
    return true;
}

fn ecs_ehsd_union(a: EcsEhsdDeep, b: EcsEhsdDeep) -> EcsEhsdDeep {
    let out = a;
    if b.len >= 1 { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, b.e0)); };
    if b.len >= 2 { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, b.e1)); };
    if b.len >= 3 { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, b.e2)); };
    if b.len >= 4 { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, b.e3)); };
    return out;
}

fn ecs_ehsd_intersection(a: EcsEhsdDeep, b: EcsEhsdDeep) -> EcsEhsdDeep {
    let out = ecs_ehsd_new();
    if a.len >= 1 { if ecs_ehsd_contains(b, a.e0) { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, a.e0)); }; };
    if a.len >= 2 { if ecs_ehsd_contains(b, a.e1) { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, a.e1)); }; };
    if a.len >= 3 { if ecs_ehsd_contains(b, a.e2) { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, a.e2)); }; };
    if a.len >= 4 { if ecs_ehsd_contains(b, a.e3) { out = ecs_ehsd_ins_set(ecs_ehsd_insert(out, a.e3)); }; };
    return out;
}

// iter
struct EcsEhsdIterDeep {
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    cursor: i32,
    debug_kind: i32,
}

fn ecs_ehsd_iter(s: EcsEhsdDeep) -> EcsEhsdIterDeep {
    return EcsEhsdIterDeep {
        e0: s.e0, e1: s.e1, e2: s.e2, e3: s.e3, e4: s.e4, e5: s.e5, e6: s.e6, e7: s.e7,
        len: s.len, cursor: 0, debug_kind: 10,
    };
}

fn ecs_ehsd_iter_remaining(i: EcsEhsdIterDeep) -> i32 { return i.len - i.cursor; }
fn ecs_ehsd_iter_debug(i: EcsEhsdIterDeep) -> i32 { return i.debug_kind; }

struct EcsEhsdNextDeep {
    iter: EcsEhsdIterDeep,
    has: bool,
    value: i64,
}
fn ecs_ehsd_next_has(n: EcsEhsdNextDeep) -> bool { return n.has; }
fn ecs_ehsd_next_value(n: EcsEhsdNextDeep) -> i64 { return n.value; }
fn ecs_ehsd_next_iter(n: EcsEhsdNextDeep) -> EcsEhsdIterDeep { return n.iter; }

fn ecs_ehsd_iter_next(i: EcsEhsdIterDeep) -> EcsEhsdNextDeep {
    if i.cursor >= i.len {
        return EcsEhsdNextDeep { iter: i, has: false, value: -1 };
    };
    let value = -1;
    if i.cursor == 0 { value = i.e0; };
    if i.cursor == 1 { value = i.e1; };
    if i.cursor == 2 { value = i.e2; };
    if i.cursor == 3 { value = i.e3; };
    if i.cursor == 4 { value = i.e4; };
    if i.cursor == 5 { value = i.e5; };
    if i.cursor == 6 { value = i.e6; };
    if i.cursor == 7 { value = i.e7; };
    let i2 = EcsEhsdIterDeep {
        e0: i.e0, e1: i.e1, e2: i.e2, e3: i.e3, e4: i.e4, e5: i.e5, e6: i.e6, e7: i.e7,
        len: i.len, cursor: i.cursor + 1, debug_kind: i.debug_kind,
    };
    return EcsEhsdNextDeep { iter: i2, has: true, value: value };
}
