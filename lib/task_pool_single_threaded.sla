// Bevy single_threaded_task_pool observable model over explicit i32 tasks.
//
// In Bevy's single-threaded fallback, TaskPool::spawn and spawn_local enqueue
// work on the local executor and then tick it to completion. Scope lanes are
// all executed on the same thread. This module models those synchronous
// semantics without pretending to implement Rust Future polling.
@import "task_executor.sla"

struct EcsSingleThreadedTaskPoolI32 {
    executor: EcsTaskExecutorI32,
    spawn_count: i64,
    local_spawn_count: i64,
    scope_count: i64,
    total_tick_count: i64,
}

struct EcsSingleThreadedTaskPoolSpawnResultI32 {
    pool: EcsSingleThreadedTaskPoolI32,
    handle: EcsTaskHandleI32,
    spawned: bool,
}

struct EcsSingleThreadedScopeTaskSetI32 {
    values: Vec<i32>,
    lanes: Vec<i64>,
}

struct EcsSingleThreadedScopeRunResultI32 {
    pool: EcsSingleThreadedTaskPoolI32,
    result_values: Vec<i32>,
    result_lanes: Vec<i64>,
    spawn_count: i64,
    local_count: i64,
    external_count: i64,
    ticked_count: i64,
}

fn ecs_single_threaded_task_pool_i32_new(capacity: i64) -> EcsSingleThreadedTaskPoolI32 {
    return EcsSingleThreadedTaskPoolI32 { executor: ecs_local_task_executor_i32_new(capacity), spawn_count: 0, local_spawn_count: 0, scope_count: 0, total_tick_count: 0 };
}

fn ecs_single_threaded_task_pool_thread_num_i32(pool: EcsSingleThreadedTaskPoolI32) -> i64 {
    return 1;
}

fn ecs_single_threaded_task_pool_spawn_result_i32(pool: EcsSingleThreadedTaskPoolI32, handle: EcsTaskHandleI32, spawned: bool) -> EcsSingleThreadedTaskPoolSpawnResultI32 {
    return EcsSingleThreadedTaskPoolSpawnResultI32 { pool: pool, handle: handle, spawned: spawned };
}

fn ecs_single_threaded_task_pool_spawn_i32(pool: EcsSingleThreadedTaskPoolI32, value: i32) -> EcsSingleThreadedTaskPoolSpawnResultI32 {
    let spawn = ecs_task_executor_spawn_i32(pool.executor, value);
    pool.executor = spawn.executor;
    if spawn.spawned != true {
        return ecs_single_threaded_task_pool_spawn_result_i32(pool, spawn.handle, false);
    };
    let run = ecs_task_executor_run_until_idle_i32(pool.executor);
    pool.executor = run.executor;
    pool.spawn_count = pool.spawn_count + 1;
    pool.total_tick_count = pool.total_tick_count + run.ticked_count;
    return ecs_single_threaded_task_pool_spawn_result_i32(pool, spawn.handle, true);
}

fn ecs_single_threaded_task_pool_spawn_local_i32(pool: EcsSingleThreadedTaskPoolI32, value: i32) -> EcsSingleThreadedTaskPoolSpawnResultI32 {
    let spawn = ecs_task_executor_spawn_local_i32(pool.executor, value);
    pool.executor = spawn.executor;
    if spawn.spawned != true {
        return ecs_single_threaded_task_pool_spawn_result_i32(pool, spawn.handle, false);
    };
    let run = ecs_task_executor_run_until_idle_i32(pool.executor);
    pool.executor = run.executor;
    pool.local_spawn_count = pool.local_spawn_count + 1;
    pool.total_tick_count = pool.total_tick_count + run.ticked_count;
    return ecs_single_threaded_task_pool_spawn_result_i32(pool, spawn.handle, true);
}

fn ecs_single_threaded_task_pool_with_local_executor_try_tick_i32(pool: EcsSingleThreadedTaskPoolI32) -> EcsTaskExecutorTickResultI32 {
    return ecs_task_executor_try_tick_i32(pool.executor);
}

fn ecs_single_threaded_scope_task_set_i32_new() -> EcsSingleThreadedScopeTaskSetI32 {
    let values: Vec<i32> = Vec::new();
    let lanes: Vec<i64> = Vec::new();
    return EcsSingleThreadedScopeTaskSetI32 { values: values, lanes: lanes };
}

fn ecs_single_threaded_scope_task_set_push_i32(tasks: EcsSingleThreadedScopeTaskSetI32, value: i32, lane: i64) -> EcsSingleThreadedScopeTaskSetI32 {
    tasks.values.push(value);
    tasks.lanes.push(lane);
    return tasks;
}

fn ecs_single_threaded_scope_task_set_spawn_i32(tasks: EcsSingleThreadedScopeTaskSetI32, value: i32) -> EcsSingleThreadedScopeTaskSetI32 {
    return ecs_single_threaded_scope_task_set_push_i32(tasks, value, 0);
}

fn ecs_single_threaded_scope_task_set_spawn_on_scope_i32(tasks: EcsSingleThreadedScopeTaskSetI32, value: i32) -> EcsSingleThreadedScopeTaskSetI32 {
    return ecs_single_threaded_scope_task_set_push_i32(tasks, value, 1);
}

fn ecs_single_threaded_scope_task_set_spawn_on_external_i32(tasks: EcsSingleThreadedScopeTaskSetI32, value: i32) -> EcsSingleThreadedScopeTaskSetI32 {
    return ecs_single_threaded_scope_task_set_push_i32(tasks, value, 2);
}

fn ecs_single_threaded_scope_run_result_i32(pool: EcsSingleThreadedTaskPoolI32, result_values: Vec<i32>, result_lanes: Vec<i64>, spawn_count: i64, local_count: i64, external_count: i64, ticked_count: i64) -> EcsSingleThreadedScopeRunResultI32 {
    return EcsSingleThreadedScopeRunResultI32 { pool: pool, result_values: result_values, result_lanes: result_lanes, spawn_count: spawn_count, local_count: local_count, external_count: external_count, ticked_count: ticked_count };
}

fn ecs_single_threaded_task_pool_scope_run_i32(pool: EcsSingleThreadedTaskPoolI32, tasks: EcsSingleThreadedScopeTaskSetI32) -> EcsSingleThreadedScopeRunResultI32 {
    let result_values: Vec<i32> = Vec::new();
    let result_lanes: Vec<i64> = Vec::new();
    let spawn_count: i64 = 0;
    let local_count: i64 = 0;
    let external_count: i64 = 0;
    let ticked_count: i64 = 0;
    let i: i64 = 0;
    let n = len(tasks.values) as i64;
    while i < n {
        let lane = tasks.lanes[i];
        let spawn = ecs_task_executor_spawn_local_i32(pool.executor, tasks.values[i]);
        pool.executor = spawn.executor;
        if spawn.spawned {
            let run = ecs_task_executor_run_until_idle_i32(pool.executor);
            pool.executor = run.executor;
            ticked_count = ticked_count + run.ticked_count;
            result_values.push(tasks.values[i]);
            result_lanes.push(lane);
            if lane == 0 { spawn_count = spawn_count + 1; };
            if lane == 1 { local_count = local_count + 1; };
            if lane == 2 { external_count = external_count + 1; };
        };
        i = i + 1;
    }
    pool.scope_count = pool.scope_count + 1;
    pool.total_tick_count = pool.total_tick_count + ticked_count;
    return ecs_single_threaded_scope_run_result_i32(pool, result_values, result_lanes, spawn_count, local_count, external_count, ticked_count);
}

@test "single threaded task pool reports one thread"() {
    let pool = ecs_single_threaded_task_pool_i32_new(4);
    if ecs_single_threaded_task_pool_thread_num_i32(pool) != 1 { panic(31710); };
}

@test "single threaded task pool spawn completes immediately"() {
    let pool = ecs_single_threaded_task_pool_i32_new(4);
    let spawn = ecs_single_threaded_task_pool_spawn_i32(pool, 10);
    if spawn.spawned != true { panic(31720); };
    if ecs_task_registry_is_finished_i32(spawn.pool.executor.registry, spawn.handle) != true { panic(31721); };
    if spawn.pool.spawn_count != 1 { panic(31722); };
    if spawn.pool.total_tick_count != 1 { panic(31723); };
}

@test "single threaded task pool spawn local completes immediately"() {
    let pool = ecs_single_threaded_task_pool_i32_new(4);
    let spawn = ecs_single_threaded_task_pool_spawn_local_i32(pool, 20);
    if spawn.spawned != true { panic(31730); };
    if ecs_task_registry_is_finished_i32(spawn.pool.executor.registry, spawn.handle) != true { panic(31731); };
    if spawn.pool.local_spawn_count != 1 { panic(31732); };
}

@test "single threaded local executor try tick is false when empty"() {
    let pool = ecs_single_threaded_task_pool_i32_new(4);
    let tick = ecs_single_threaded_task_pool_with_local_executor_try_tick_i32(pool);
    if tick.ticked { panic(31740); };
}

@test "single threaded scope runs all lanes in insertion order"() {
    let pool = ecs_single_threaded_task_pool_i32_new(8);
    let t0 = ecs_single_threaded_scope_task_set_i32_new();
    let t1 = ecs_single_threaded_scope_task_set_spawn_i32(t0, 1);
    let t2 = ecs_single_threaded_scope_task_set_spawn_on_scope_i32(t1, 2);
    let t3 = ecs_single_threaded_scope_task_set_spawn_on_external_i32(t2, 3);
    let run = ecs_single_threaded_task_pool_scope_run_i32(pool, t3);
    if len(run.result_values) != 3 { panic(31750); };
    if run.result_values[0] != 1 { panic(31751); };
    if run.result_values[1] != 2 { panic(31752); };
    if run.result_values[2] != 3 { panic(31753); };
    if run.result_lanes[0] != 0 { panic(31754); };
    if run.result_lanes[1] != 1 { panic(31755); };
    if run.result_lanes[2] != 2 { panic(31756); };
    if run.spawn_count != 1 { panic(31757); };
    if run.local_count != 1 { panic(31758); };
    if run.external_count != 1 { panic(31759); };
    if run.ticked_count != 3 { panic(31760); };
}
