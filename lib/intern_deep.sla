// Deepened Bevy ECS intern surface.
// Mirrors src/intern.rs: Internable (leak/ref_eq/ref_hash), Interner (double-checked
// insert), Interned pointer-equality (not value equality across different interners).
// Shallow lib/intern.sla retained.

// Fixed capacity for leaked static slots per interner
const ECS_IN_CAP: i32 = 16;

// === Internable value model ===
// Values are i64 payloads; "static ref" is a stable slot index within an interner.
// ref_eq is pointer equality (same interner + same slot), not payload equality.

struct EcsInternableDeep {
    payload: i64,
    // after leak: interner_id + slot form the static identity
    leaked: bool,
    interner_id: i64,
    slot: i32,
}

fn ecs_in_value(payload: i64) -> EcsInternableDeep {
    return EcsInternableDeep {
        payload: payload,
        leaked: false,
        interner_id: 0,
        slot: -1,
    };
}

fn ecs_in_payload(v: EcsInternableDeep) -> i64 { return v.payload; }
fn ecs_in_is_leaked(v: EcsInternableDeep) -> bool { return v.leaked; }
fn ecs_in_slot(v: EcsInternableDeep) -> i32 { return v.slot; }

// Internable::ref_eq — pointer equality of static refs
fn ecs_in_ref_eq(a: EcsInternableDeep, b: EcsInternableDeep) -> bool {
    if a.leaked != true { return false; };
    if b.leaked != true { return false; };
    if a.interner_id != b.interner_id { return false; };
    return a.slot == b.slot;
}

// Internable::ref_hash — hash of pointer identity (interner_id, slot)
fn ecs_in_ref_hash(v: EcsInternableDeep) -> i64 {
    if v.leaked != true {
        // uninterned: hash payload only (not used for Interned)
        return v.payload;
    };
    // combine interner_id and slot
    return (v.interner_id * 1000003) + (v.slot as i64);
}

// value equality (content) — NOT used by Interned PartialEq
fn ecs_in_value_eq(a: EcsInternableDeep, b: EcsInternableDeep) -> bool {
    return a.payload == b.payload;
}

// === Interner ===
// Each interner has a unique interner_id so equal values from different interners
// produce unequal Interned handles (Bevy docs guarantee).
struct EcsInternerDeep {
    interner_id: i64,
    // leaked payloads by slot
    p0: i64, p1: i64, p2: i64, p3: i64,
    p4: i64, p5: i64, p6: i64, p7: i64,
    p8: i64, p9: i64, p10: i64, p11: i64,
    p12: i64, p13: i64, p14: i64, p15: i64,
    len: i32,
    leak_count: i64, // how many times leak path ran
    hit_count: i64,  // how many times existing entry returned
}

fn ecs_in_interner_new(interner_id: i64) -> EcsInternerDeep {
    return EcsInternerDeep {
        interner_id: interner_id,
        p0: 0, p1: 0, p2: 0, p3: 0,
        p4: 0, p5: 0, p6: 0, p7: 0,
        p8: 0, p9: 0, p10: 0, p11: 0,
        p12: 0, p13: 0, p14: 0, p15: 0,
        len: 0,
        leak_count: 0,
        hit_count: 0,
    };
}

fn ecs_in_interner_default() -> EcsInternerDeep {
    return ecs_in_interner_new(1);
}

fn ecs_in_interner_id(i: EcsInternerDeep) -> i64 { return i.interner_id; }
fn ecs_in_interner_len(i: EcsInternerDeep) -> i32 { return i.len; }
fn ecs_in_interner_leak_count(i: EcsInternerDeep) -> i64 { return i.leak_count; }
fn ecs_in_interner_hit_count(i: EcsInternerDeep) -> i64 { return i.hit_count; }

fn ecs_in_get_payload_at(i: EcsInternerDeep, slot: i32) -> i64 {
    if slot == 0 { return i.p0; };
    if slot == 1 { return i.p1; };
    if slot == 2 { return i.p2; };
    if slot == 3 { return i.p3; };
    if slot == 4 { return i.p4; };
    if slot == 5 { return i.p5; };
    if slot == 6 { return i.p6; };
    if slot == 7 { return i.p7; };
    if slot == 8 { return i.p8; };
    if slot == 9 { return i.p9; };
    if slot == 10 { return i.p10; };
    if slot == 11 { return i.p11; };
    if slot == 12 { return i.p12; };
    if slot == 13 { return i.p13; };
    if slot == 14 { return i.p14; };
    if slot == 15 { return i.p15; };
    return 0;
}

fn ecs_in_set_payload_at(i: EcsInternerDeep, slot: i32, payload: i64) -> EcsInternerDeep {
    if slot == 0 { i.p0 = payload; };
    if slot == 1 { i.p1 = payload; };
    if slot == 2 { i.p2 = payload; };
    if slot == 3 { i.p3 = payload; };
    if slot == 4 { i.p4 = payload; };
    if slot == 5 { i.p5 = payload; };
    if slot == 6 { i.p6 = payload; };
    if slot == 7 { i.p7 = payload; };
    if slot == 8 { i.p8 = payload; };
    if slot == 9 { i.p9 = payload; };
    if slot == 10 { i.p10 = payload; };
    if slot == 11 { i.p11 = payload; };
    if slot == 12 { i.p12 = payload; };
    if slot == 13 { i.p13 = payload; };
    if slot == 14 { i.p14 = payload; };
    if slot == 15 { i.p15 = payload; };
    return i;
}

fn ecs_in_find_slot(i: EcsInternerDeep, payload: i64) -> i32 {
    let s: i32 = 0;
    while s < i.len {
        if ecs_in_get_payload_at(i, s) == payload { return s; };
        s = s + 1;
    }
    return -1;
}

// Internable::leak modeled as allocating a new static slot
fn ecs_in_leak(i: EcsInternerDeep, payload: i64) -> (EcsInternerDeep, EcsInternableDeep) {
    if i.len >= ECS_IN_CAP {
        // capacity full: return last slot (shouldn't happen in tests)
        let v = EcsInternableDeep {
            payload: payload,
            leaked: true,
            interner_id: i.interner_id,
            slot: i.len - 1,
        };
        return (i, v);
    };
    let slot = i.len;
    i = ecs_in_set_payload_at(i, slot, payload);
    i.len = i.len + 1;
    i.leak_count = i.leak_count + 1;
    let v = EcsInternableDeep {
        payload: payload,
        leaked: true,
        interner_id: i.interner_id,
        slot: slot,
    };
    return (i, v);
}

// Interner::intern — double-checked style: find or leak+insert
fn ecs_in_intern(i: EcsInternerDeep, payload: i64) -> (EcsInternerDeep, EcsInternedDeep) {
    let found = ecs_in_find_slot(i, payload);
    if found >= 0 {
        i.hit_count = i.hit_count + 1;
        let v = EcsInternableDeep {
            payload: payload,
            leaked: true,
            interner_id: i.interner_id,
            slot: found,
        };
        return (i, ecs_in_interned_from_static(v));
    };
    let leaked = ecs_in_leak(i, payload);
    i = leaked.0;
    return (i, ecs_in_interned_from_static(leaked.1));
}

// === Interned ===
// Equality and hash by static ref identity only
struct EcsInternedDeep {
    payload: i64,
    interner_id: i64,
    slot: i32,
}

fn ecs_in_interned_from_static(v: EcsInternableDeep) -> EcsInternedDeep {
    return EcsInternedDeep {
        payload: v.payload,
        interner_id: v.interner_id,
        slot: v.slot,
    };
}

// Construct Interned without interner (two different static leaks of same content)
fn ecs_in_interned_raw(payload: i64, interner_id: i64, slot: i32) -> EcsInternedDeep {
    return EcsInternedDeep {
        payload: payload,
        interner_id: interner_id,
        slot: slot,
    };
}

fn ecs_in_interned_payload(x: EcsInternedDeep) -> i64 { return x.payload; }
fn ecs_in_interned_interner_id(x: EcsInternedDeep) -> i64 { return x.interner_id; }
fn ecs_in_interned_slot(x: EcsInternedDeep) -> i32 { return x.slot; }

// PartialEq/Eq for Interned: pointer equality
fn ecs_in_interned_eq(a: EcsInternedDeep, b: EcsInternedDeep) -> bool {
    if a.interner_id != b.interner_id { return false; };
    return a.slot == b.slot;
}

fn ecs_in_interned_ne(a: EcsInternedDeep, b: EcsInternedDeep) -> bool {
    return ecs_in_interned_eq(a, b) != true;
}

// Hash for Interned: ref_hash of static identity
fn ecs_in_interned_hash(a: EcsInternedDeep) -> i64 {
    return (a.interner_id * 1000003) + (a.slot as i64);
}

// Clone/Copy: bitwise copy
fn ecs_in_interned_clone(a: EcsInternedDeep) -> EcsInternedDeep {
    return EcsInternedDeep {
        payload: a.payload,
        interner_id: a.interner_id,
        slot: a.slot,
    };
}

// From<&Interned> for Interned
fn ecs_in_interned_from_ref(a: EcsInternedDeep) -> EcsInternedDeep {
    return ecs_in_interned_clone(a);
}

// Deref to payload
fn ecs_in_interned_deref(a: EcsInternedDeep) -> i64 {
    return a.payload;
}

// same_interned_instance: clone equality
fn ecs_in_same_instance(a: EcsInternedDeep, b: EcsInternedDeep) -> bool {
    return ecs_in_interned_eq(a, b);
}

// same content different pointers (raw different slots)
fn ecs_in_same_content_diff_ptr(a: EcsInternedDeep, b: EcsInternedDeep) -> bool {
    if a.payload != b.payload { return false; };
    return ecs_in_interned_eq(a, b) != true;
}

// reconstruct static internable from interned handle
fn ecs_in_from_interned(x: EcsInternedDeep) -> EcsInternableDeep {
    return EcsInternableDeep {
        payload: x.payload,
        leaked: true,
        interner_id: x.interner_id,
        slot: x.slot,
    };
}

