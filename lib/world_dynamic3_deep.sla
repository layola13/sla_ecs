// ecs_wd3_query_a_with_c: iterate A store; if entity alive AND has_c(eid); push a (x,y).
fn ecs_wd3_query_a_with_c(w: EcsWD3World) -> EcsWD3QueryA {
    let q0 = EcsWD3QueryA { count: 0, a_x0: 0, a_x1: 0, a_x2: 0, a_x3: 0, a_x4: 0, a_x5: 0, a_x6: 0, a_x7: 0, a_x8: 0, a_x9: 0, a_x10: 0, a_x11: 0, a_x12: 0, a_x13: 0, a_x14: 0, a_x15: 0, a_y0: 0, a_y1: 0, a_y2: 0, a_y3: 0, a_y4: 0, a_y5: 0, a_y6: 0, a_y7: 0, a_y8: 0, a_y9: 0, a_y10: 0, a_y11: 0, a_y12: 0, a_y13: 0, a_y14: 0, a_y15: 0 };
    let i: i32 = 0;
    while i < w.a_count {
        let eid = _ecs_wd3_a_eid_at(w, i);
        let gen = _ecs_wd3_gen_at(w, eid);
        let e = EcsWD3Entity { id: eid, generation: gen };
        if ecs_wd3_is_alive(w, e) {
            if ecs_wd3_has_c(w, e) {
                let out = q0.count;
                q0 = _ecs_wd3_qa_set_x(q0, out, _ecs_wd3_a_x_at(w, i));
                q0 = _ecs_wd3_qa_set_y(q0, out, _ecs_wd3_a_y_at(w, i));
                q0.count = out + 1;
            };
        };
        i = i + 1;
    }
    return q0;
}

// ecs_wd3_query_a_without_c: iterate A store; if entity alive AND NOT has_c(eid); push a (x,y).
fn ecs_wd3_query_a_without_c(w: EcsWD3World) -> EcsWD3QueryA {
    let q0 = EcsWD3QueryA { count: 0, a_x0: 0, a_x1: 0, a_x2: 0, a_x3: 0, a_x4: 0, a_x5: 0, a_x6: 0, a_x7: 0, a_x8: 0, a_x9: 0, a_x10: 0, a_x11: 0, a_x12: 0, a_x13: 0, a_x14: 0, a_x15: 0, a_y0: 0, a_y1: 0, a_y2: 0, a_y3: 0, a_y4: 0, a_y5: 0, a_y6: 0, a_y7: 0, a_y8: 0, a_y9: 0, a_y10: 0, a_y11: 0, a_y12: 0, a_y13: 0, a_y14: 0, a_y15: 0 };
    let i: i32 = 0;
    while i < w.a_count {
        let eid = _ecs_wd3_a_eid_at(w, i);
        let gen = _ecs_wd3_gen_at(w, eid);
        let e = EcsWD3Entity { id: eid, generation: gen };
        if ecs_wd3_is_alive(w, e) {
            if ecs_wd3_has_c(w, e) != true {
                let out = q0.count;
                q0 = _ecs_wd3_qa_set_x(q0, out, _ecs_wd3_a_x_at(w, i));
                q0 = _ecs_wd3_qa_set_y(q0, out, _ecs_wd3_a_y_at(w, i));
                q0.count = out + 1;
            };
        };
        i = i + 1;
    }
    return q0;
}

