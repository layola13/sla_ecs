        c_changed_t0: 0, c_changed_t1: 0, c_changed_t2: 0, c_changed_t3: 0, c_changed_t4: 0, c_changed_t5: 0, c_changed_t6: 0, c_changed_t7: 0,
        c_changed_t8: 0, c_changed_t9: 0, c_changed_t10: 0, c_changed_t11: 0, c_changed_t12: 0, c_changed_t13: 0, c_changed_t14: 0, c_changed_t15: 0,
        res_has: 0, res_tick: 0, res_added_t: 0, res_changed_t: 0,
        msg_tail: 0,
        msg0: 0, msg1: 0, msg2: 0, msg3: 0, msg4: 0, msg5: 0, msg6: 0, msg7: 0,
        msg8: 0, msg9: 0, msg10: 0, msg11: 0, msg12: 0, msg13: 0, msg14: 0, msg15: 0,
        change_tick: 1,
    };
}

fn ecs_wd3_world_change_tick(w: EcsWD3World) -> i32 { return w.change_tick; }

fn ecs_wd3_increment_tick(w0: EcsWD3World) -> EcsWD3World {
    w0.change_tick = w0.change_tick + 1;
    return w0;
}

// ── Allocator slot accessors (gen, free_id, occupied). ────────────────────────────────────
fn _ecs_wd3_gen_at(w: EcsWD3World, id: i32) -> i32 {
    if id == 0 { return w.gen0; };
    if id == 1 { return w.gen1; };
    if id == 2 { return w.gen2; };
    if id == 3 { return w.gen3; };
    if id == 4 { return w.gen4; };
    if id == 5 { return w.gen5; };
    if id == 6 { return w.gen6; };
    if id == 7 { return w.gen7; };
    if id == 8 { return w.gen8; };
    if id == 9 { return w.gen9; };
    if id == 10 { return w.gen10; };
    if id == 11 { return w.gen11; };
    if id == 12 { return w.gen12; };
    if id == 13 { return w.gen13; };
    if id == 14 { return w.gen14; };
    return w.gen15;
}

fn _ecs_wd3_set_gen(w0: EcsWD3World, id: i32, value: i32) -> EcsWD3World {
    if id == 0 { w0.gen0 = value; return w0; };
    if id == 1 { w0.gen1 = value; return w0; };
    if id == 2 { w0.gen2 = value; return w0; };
    if id == 3 { w0.gen3 = value; return w0; };
    if id == 4 { w0.gen4 = value; return w0; };
    if id == 5 { w0.gen5 = value; return w0; };
    if id == 6 { w0.gen6 = value; return w0; };
    if id == 7 { w0.gen7 = value; return w0; };
    if id == 8 { w0.gen8 = value; return w0; };
    if id == 9 { w0.gen9 = value; return w0; };
    if id == 10 { w0.gen10 = value; return w0; };
    if id == 11 { w0.gen11 = value; return w0; };
    if id == 12 { w0.gen12 = value; return w0; };
    if id == 13 { w0.gen13 = value; return w0; };
    if id == 14 { w0.gen14 = value; return w0; };
    w0.gen15 = value;
    return w0;
}

fn _ecs_wd3_free_id_at(w: EcsWD3World, idx: i32) -> i32 {
    if idx == 0 { return w.free_id0; };
    if idx == 1 { return w.free_id1; };
    if idx == 2 { return w.free_id2; };
    if idx == 3 { return w.free_id3; };
    if idx == 4 { return w.free_id4; };
    if idx == 5 { return w.free_id5; };
    if idx == 6 { return w.free_id6; };
    if idx == 7 { return w.free_id7; };
    if idx == 8 { return w.free_id8; };
    if idx == 9 { return w.free_id9; };
    if idx == 10 { return w.free_id10; };
    if idx == 11 { return w.free_id11; };
    if idx == 12 { return w.free_id12; };
    if idx == 13 { return w.free_id13; };
    if idx == 14 { return w.free_id14; };
    return w.free_id15;
}

fn _ecs_wd3_set_free_id(w0: EcsWD3World, idx: i32, value: i32) -> EcsWD3World {
    if idx == 0 { w0.free_id0 = value; return w0; };
    if idx == 1 { w0.free_id1 = value; return w0; };
    if idx == 2 { w0.free_id2 = value; return w0; };
    if idx == 3 { w0.free_id3 = value; return w0; };
    if idx == 4 { w0.free_id4 = value; return w0; };
    if idx == 5 { w0.free_id5 = value; return w0; };
    if idx == 6 { w0.free_id6 = value; return w0; };
    if idx == 7 { w0.free_id7 = value; return w0; };
    if idx == 8 { w0.free_id8 = value; return w0; };
    if idx == 9 { w0.free_id9 = value; return w0; };
    if idx == 10 { w0.free_id10 = value; return w0; };
    if idx == 11 { w0.free_id11 = value; return w0; };
    if idx == 12 { w0.free_id12 = value; return w0; };
    if idx == 13 { w0.free_id13 = value; return w0; };
    if idx == 14 { w0.free_id14 = value; return w0; };
    w0.free_id15 = value;
