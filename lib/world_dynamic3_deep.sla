fn _ecs_wd3_q_set_a_slot(q0: EcsWD3TripleQuery, idx: i32, value: i32) -> EcsWD3TripleQuery {
    if idx == 0 { q0.a_slot0 = value; return q0; };
    if idx == 1 { q0.a_slot1 = value; return q0; };
    if idx == 2 { q0.a_slot2 = value; return q0; };
    if idx == 3 { q0.a_slot3 = value; return q0; };
    if idx == 4 { q0.a_slot4 = value; return q0; };
    if idx == 5 { q0.a_slot5 = value; return q0; };
    if idx == 6 { q0.a_slot6 = value; return q0; };
    if idx == 7 { q0.a_slot7 = value; return q0; };
    if idx == 8 { q0.a_slot8 = value; return q0; };
    if idx == 9 { q0.a_slot9 = value; return q0; };
    if idx == 10 { q0.a_slot10 = value; return q0; };
