    if idx == 0 { return q.a_x0; };
    if idx == 1 { return q.a_x1; };
    if idx == 2 { return q.a_x2; };
    if idx == 3 { return q.a_x3; };
    if idx == 4 { return q.a_x4; };
    if idx == 5 { return q.a_x5; };
    if idx == 6 { return q.a_x6; };
    if idx == 7 { return q.a_x7; };
