// ecs_wd3_query_a_b_c: iterate A store; find b_slot + c_slot by eid; emit triple if both found
// AND entity alive (gen matches). Returns EcsWD3TripleQuery.
fn ecs_wd3_query_a_b_c(w: EcsWD3World) -> EcsWD3TripleQuery {
    let q0 = EcsWD3TripleQuery { count: 0, e_id0: 0, e_id1: 0, e_id2: 0, e_id3: 0, e_id4: 0, e_id5: 0, e_id6: 0, e_id7: 0, e_id8: 0, e_id9: 0, e_id10: 0, e_id11: 0, e_id12: 0, e_id13: 0, e_id14: 0, e_id15: 0, e_gen0: 0, e_gen1: 0, e_gen2: 0, e_gen3: 0, e_gen4: 0, e_gen5: 0, e_gen6: 0, e_gen7: 0, e_gen8: 0, e_gen9: 0, e_gen10: 0, e_gen11: 0, e_gen12: 0, e_gen13: 0, e_gen14: 0, e_gen15: 0, a_slot0: 0, a_slot1: 0, a_slot2: 0, a_slot3: 0, a_slot4: 0, a_slot5: 0, a_slot6: 0, a_slot7: 0, a_slot8: 0, a_slot9: 0, a_slot10: 0, a_slot11: 0, a_slot12: 0, a_slot13: 0, a_slot14: 0, a_slot15: 0, b_slot0: 0, b_slot1: 0, b_slot2: 0, b_slot3: 0, b_slot4: 0, b_slot5: 0, b_slot6: 0, b_slot7: 0, b_slot8: 0, b_slot9: 0, b_slot10: 0, b_slot11: 0, b_slot12: 0, b_slot13: 0, b_slot14: 0, b_slot15: 0, c_slot0: 0, c_slot1: 0, c_slot2: 0, c_slot3: 0, c_slot4: 0, c_slot5: 0, c_slot6: 0, c_slot7: 0, c_slot8: 0, c_slot9: 0, c_slot10: 0, c_slot11: 0, c_slot12: 0, c_slot13: 0, c_slot14: 0, c_slot15: 0, a_x0: 0, a_x1: 0, a_x2: 0, a_x3: 0, a_x4: 0, a_x5: 0, a_x6: 0, a_x7: 0, a_x8: 0, a_x9: 0, a_x10: 0, a_x11: 0, a_x12: 0, a_x13: 0, a_x14: 0, a_x15: 0, a_y0: 0, a_y1: 0, a_y2: 0, a_y3: 0, a_y4: 0, a_y5: 0, a_y6: 0, a_y7: 0, a_y8: 0, a_y9: 0, a_y10: 0, a_y11: 0, a_y12: 0, a_y13: 0, a_y14: 0, a_y15: 0, b_x0: 0, b_x1: 0, b_x2: 0, b_x3: 0, b_x4: 0, b_x5: 0, b_x6: 0, b_x7: 0, b_x8: 0, b_x9: 0, b_x10: 0, b_x11: 0, b_x12: 0, b_x13: 0, b_x14: 0, b_x15: 0, b_y0: 0, b_y1: 0, b_y2: 0, b_y3: 0, b_y4: 0, b_y5: 0, b_y6: 0, b_y7: 0, b_y8: 0, b_y9: 0, b_y10: 0, b_y11: 0, b_y12: 0, b_y13: 0, b_y14: 0, b_y15: 0, c_team0: 0, c_team1: 0, c_team2: 0, c_team3: 0, c_team4: 0, c_team5: 0, c_team6: 0, c_team7: 0, c_team8: 0, c_team9: 0, c_team10: 0, c_team11: 0, c_team12: 0, c_team13: 0, c_team14: 0, c_team15: 0 };
    let i: i32 = 0;
    while i < w.a_count {
        let eid = _ecs_wd3_a_eid_at(w, i);
        let gen = _ecs_wd3_gen_at(w, eid);
        let e = EcsWD3Entity { id: eid, generation: gen };
        if ecs_wd3_is_alive(w, e) {
            let b_slot = _ecs_wd3_b_slot_of(w, eid);
            let c_slot = _ecs_wd3_c_slot_of(w, eid);
            if b_slot >= 0 {
                if c_slot >= 0 {
                    let out = q0.count;
                    q0 = _ecs_wd3_q_set_e_id(q0, out, eid);
                    q0 = _ecs_wd3_q_set_e_gen(q0, out, gen);
                    q0 = _ecs_wd3_q_set_a_slot(q0, out, i);
                    q0 = _ecs_wd3_q_set_b_slot(q0, out, b_slot);
                    q0 = _ecs_wd3_q_set_c_slot(q0, out, c_slot);
                    q0 = _ecs_wd3_q_set_a_x(q0, out, _ecs_wd3_a_x_at(w, i));
                    q0 = _ecs_wd3_q_set_a_y(q0, out, _ecs_wd3_a_y_at(w, i));
                    q0 = _ecs_wd3_q_set_b_x(q0, out, _ecs_wd3_b_x_at(w, b_slot));
                    q0 = _ecs_wd3_q_set_b_y(q0, out, _ecs_wd3_b_y_at(w, b_slot));
                    q0 = _ecs_wd3_q_set_c_team(q0, out, _ecs_wd3_c_team_at(w, c_slot));
                    q0.count = out + 1;
                };
            };
        };
        i = i + 1;
    }
    return q0;
}

// ── QueryA (A-only flat list) used by query_a_with_c and query_a_without_c. ─────────────────
struct EcsWD3QueryA {
    count: i32,
    a_x0: i32, a_x1: i32, a_x2: i32, a_x3: i32, a_x4: i32, a_x5: i32, a_x6: i32, a_x7: i32, a_x8: i32, a_x9: i32, a_x10: i32, a_x11: i32, a_x12: i32, a_x13: i32, a_x14: i32, a_x15: i32,
    a_y0: i32, a_y1: i32, a_y2: i32, a_y3: i32, a_y4: i32, a_y5: i32, a_y6: i32, a_y7: i32, a_y8: i32, a_y9: i32, a_y10: i32, a_y11: i32, a_y12: i32, a_y13: i32, a_y14: i32, a_y15: i32,
}

