// ── Entity allocator ops. ────────────────────────────────────────────────────────────────
fn ecs_wd3_allocator_next_id(w: EcsWD3World) -> i32 { return w.next_id; }
fn ecs_wd3_allocator_free_count(w: EcsWD3World) -> i32 { return w.free_count; }

fn _ecs_wd3_id_is_free(w: EcsWD3World, id: i32) -> bool {
    let i: i32 = 0;
    while i < w.free_count {
        if _ecs_wd3_free_id_at(w, i) == id { return true; };
        i = i + 1;
    }
    return false;
}

// EcsWD3Spawn wraps (World, Entity) — replaces tuple destructuring.
struct EcsWD3Spawn { world: EcsWD3World, entity: EcsWD3Entity }
fn ecs_wd3_spawn_world(s: EcsWD3Spawn) -> EcsWD3World { return s.world; }
fn ecs_wd3_spawn_entity(s: EcsWD3Spawn) -> EcsWD3Entity { return s.entity; }

// ecs_wd3_alloc_entity pops a free id (decrements free_count, clears slot) or bumps next_id;
// returns sentinel EcsWD3Entity{id:-1,generation:0} at cap (NO panic — Batch 388/389/390 #2/#3).
fn ecs_wd3_alloc_entity(w0: EcsWD3World) -> EcsWD3Spawn {
    if w0.free_count > 0 {
        let next_free_count = w0.free_count - 1;
        let id = _ecs_wd3_free_id_at(w0, next_free_count);
        w0.free_count = next_free_count;
        w0 = _ecs_wd3_set_free_id(w0, next_free_count, 0);
        let gen = _ecs_wd3_gen_at(w0, id);
        return EcsWD3Spawn { world: w0, entity: EcsWD3Entity { id: id, generation: gen } };
    };
    if w0.next_id >= ECS_WD3_CAP {
        return EcsWD3Spawn { world: w0, entity: EcsWD3Entity { id: -1, generation: 0 } };
    };
    let id = w0.next_id;
    w0.next_id = id + 1;
    let gen = _ecs_wd3_gen_at(w0, id);
    return EcsWD3Spawn { world: w0, entity: EcsWD3Entity { id: id, generation: gen } };
}

// ecs_wd3_is_alive: id in (0, 16), below next_id, not in free list, gen matches.
fn ecs_wd3_is_alive(w: EcsWD3World, e: EcsWD3Entity) -> bool {
    if e.id <= 0 { return false; };
    if e.id >= ECS_WD3_CAP { return false; };
    if e.id >= w.next_id { return false; };
    if _ecs_wd3_id_is_free(w, e.id) { return false; };
    return _ecs_wd3_gen_at(w, e.id) == e.generation;
}

// ecs_wd3_free_entity bumps generation of id and pushes id onto free_ids; no-op if not alive.
fn ecs_wd3_free_entity(w0: EcsWD3World, e: EcsWD3Entity) -> EcsWD3World {
    if ecs_wd3_is_alive(w0, e) != true { return w0; };
    let cur_gen = _ecs_wd3_gen_at(w0, e.id);
    w0 = _ecs_wd3_set_gen(w0, e.id, cur_gen + 1);
    let pos = w0.free_count;
    w0 = _ecs_wd3_set_free_id(w0, pos, e.id);
    w0.free_count = pos + 1;
    return w0;
}

// ecs_wd3_world_spawn is the public spawn: returns EcsWD3Spawn wrapper.
fn ecs_wd3_world_spawn(w0: EcsWD3World) -> EcsWD3Spawn {
    return ecs_wd3_alloc_entity(w0);
}

// ── Per-store slot lookup (linear scan of *_eid slots). Returns slot index >= 0 or -1. ──────
fn _ecs_wd3_a_slot_of(w: EcsWD3World, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.a_count {
        if _ecs_wd3_a_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_wd3_b_slot_of(w: EcsWD3World, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.b_count {
        if _ecs_wd3_b_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

fn _ecs_wd3_c_slot_of(w: EcsWD3World, eid: i32) -> i32 {
    let i: i32 = 0;
    while i < w.c_count {
        if _ecs_wd3_c_eid_at(w, i) == eid { return i; };
        i = i + 1;
    }
    return -1;
}

// ── World component operations: insert / write / remove / get / has. ───────────────────────
fn ecs_wd3_insert_a(w0: EcsWD3World, e: EcsWD3Entity, x: i32, y: i32) -> EcsWD3World {
    if ecs_wd3_is_alive(w0, e) != true { panic(8101); };
    let slot = _ecs_wd3_a_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_wd3_a_set_x(w0, slot, x);
        w0 = _ecs_wd3_a_set_y(w0, slot, y);
        w0 = _ecs_wd3_a_set_changed(w0, slot, w0.change_tick);
        return w0;
    };
    let new_slot = w0.a_count;
    if new_slot >= ECS_WD3_CAP { panic(8101); };
    w0 = _ecs_wd3_a_set_eid(w0, new_slot, e.id);
    w0 = _ecs_wd3_a_set_x(w0, new_slot, x);
    w0 = _ecs_wd3_a_set_y(w0, new_slot, y);
    w0 = _ecs_wd3_a_set_added(w0, new_slot, w0.change_tick);
    w0 = _ecs_wd3_a_set_changed(w0, new_slot, w0.change_tick);
    w0.a_count = new_slot + 1;
    return w0;
}

fn ecs_wd3_insert_b(w0: EcsWD3World, e: EcsWD3Entity, x: i32, y: i32) -> EcsWD3World {
    if ecs_wd3_is_alive(w0, e) != true { panic(8102); };
    let slot = _ecs_wd3_b_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_wd3_b_set_x(w0, slot, x);
        w0 = _ecs_wd3_b_set_y(w0, slot, y);
        w0 = _ecs_wd3_b_set_changed(w0, slot, w0.change_tick);
        return w0;
    };
    let new_slot = w0.b_count;
    if new_slot >= ECS_WD3_CAP { panic(8102); };
    w0 = _ecs_wd3_b_set_eid(w0, new_slot, e.id);
    w0 = _ecs_wd3_b_set_x(w0, new_slot, x);
    w0 = _ecs_wd3_b_set_y(w0, new_slot, y);
    w0 = _ecs_wd3_b_set_added(w0, new_slot, w0.change_tick);
    w0 = _ecs_wd3_b_set_changed(w0, new_slot, w0.change_tick);
    w0.b_count = new_slot + 1;
    return w0;
}

fn ecs_wd3_insert_c(w0: EcsWD3World, e: EcsWD3Entity, team: i32) -> EcsWD3World {
    if ecs_wd3_is_alive(w0, e) != true { panic(8103); };
    let slot = _ecs_wd3_c_slot_of(w0, e.id);
    if slot >= 0 {
        w0 = _ecs_wd3_c_set_team(w0, slot, team);
        w0 = _ecs_wd3_c_set_changed(w0, slot, w0.change_tick);
        return w0;
    };
    let new_slot = w0.c_count;
    if new_slot >= ECS_WD3_CAP { panic(8103); };
    w0 = _ecs_wd3_c_set_eid(w0, new_slot, e.id);
    w0 = _ecs_wd3_c_set_team(w0, new_slot, team);
    w0 = _ecs_wd3_c_set_added(w0, new_slot, w0.change_tick);
    w0 = _ecs_wd3_c_set_changed(w0, new_slot, w0.change_tick);
    w0.c_count = new_slot + 1;
    return w0;
}

fn ecs_wd3_has_a(w: EcsWD3World, e: EcsWD3Entity) -> bool {
    if ecs_wd3_is_alive(w, e) != true { return false; };
    return _ecs_wd3_a_slot_of(w, e.id) >= 0;
}

fn ecs_wd3_has_b(w: EcsWD3World, e: EcsWD3Entity) -> bool {
    if ecs_wd3_is_alive(w, e) != true { return false; };
    return _ecs_wd3_b_slot_of(w, e.id) >= 0;
}

fn ecs_wd3_has_c(w: EcsWD3World, e: EcsWD3Entity) -> bool {
    if ecs_wd3_is_alive(w, e) != true { return false; };
    return _ecs_wd3_c_slot_of(w, e.id) >= 0;
}

fn ecs_wd3_get_a(w: EcsWD3World, e: EcsWD3Entity) -> EcsWD3Pos {
    if ecs_wd3_has_a(w, e) != true { panic(8104); };
    let slot = _ecs_wd3_a_slot_of(w, e.id);
    return EcsWD3Pos { x: _ecs_wd3_a_x_at(w, slot), y: _ecs_wd3_a_y_at(w, slot) };
}

fn ecs_wd3_get_c(w: EcsWD3World, e: EcsWD3Entity) -> EcsWD3Player {
    if ecs_wd3_has_c(w, e) != true { panic(8105); };
    let slot = _ecs_wd3_c_slot_of(w, e.id);
    return EcsWD3Player { team: _ecs_wd3_c_team_at(w, slot) };
}

fn ecs_wd3_write_c(w0: EcsWD3World, e: EcsWD3Entity, team: i32) -> EcsWD3World {
    if ecs_wd3_has_c(w0, e) != true { panic(8106); };
    let slot = _ecs_wd3_c_slot_of(w0, e.id);
    if slot < 0 { panic(8106); };
    w0 = _ecs_wd3_c_set_team(w0, slot, team);
    w0 = _ecs_wd3_c_set_changed(w0, slot, w0.change_tick);
    return w0;
}

fn ecs_wd3_remove_a(w0: EcsWD3World, e: EcsWD3Entity) -> EcsWD3World {
    let slot = _ecs_wd3_a_slot_of(w0, e.id);
    if slot < 0 { return w0; };
    let last = w0.a_count - 1;
    if slot != last {
        let last_eid = _ecs_wd3_a_eid_at(w0, last);
        let last_x = _ecs_wd3_a_x_at(w0, last);
        let last_y = _ecs_wd3_a_y_at(w0, last);
        let last_added = _ecs_wd3_a_added_at(w0, last);
        let last_changed = _ecs_wd3_a_changed_at(w0, last);
        w0 = _ecs_wd3_a_set_eid(w0, slot, last_eid);
        w0 = _ecs_wd3_a_set_x(w0, slot, last_x);
        w0 = _ecs_wd3_a_set_y(w0, slot, last_y);
        w0 = _ecs_wd3_a_set_added(w0, slot, last_added);
        w0 = _ecs_wd3_a_set_changed(w0, slot, last_changed);
    };
    w0 = _ecs_wd3_a_set_eid(w0, last, 0);
    w0 = _ecs_wd3_a_set_x(w0, last, 0);
    w0 = _ecs_wd3_a_set_y(w0, last, 0);
    w0 = _ecs_wd3_a_set_added(w0, last, 0);
    w0 = _ecs_wd3_a_set_changed(w0, last, 0);
    w0.a_count = last;
    return w0;
}

fn ecs_wd3_remove_b(w0: EcsWD3World, e: EcsWD3Entity) -> EcsWD3World {
    let slot = _ecs_wd3_b_slot_of(w0, e.id);
    if slot < 0 { return w0; };
    let last = w0.b_count - 1;
    if slot != last {
        let last_eid = _ecs_wd3_b_eid_at(w0, last);
        let last_x = _ecs_wd3_b_x_at(w0, last);
        let last_y = _ecs_wd3_b_y_at(w0, last);
        let last_added = _ecs_wd3_b_added_at(w0, last);
        let last_changed = _ecs_wd3_b_changed_at(w0, last);
        w0 = _ecs_wd3_b_set_eid(w0, slot, last_eid);
        w0 = _ecs_wd3_b_set_x(w0, slot, last_x);
        w0 = _ecs_wd3_b_set_y(w0, slot, last_y);
        w0 = _ecs_wd3_b_set_added(w0, slot, last_added);
        w0 = _ecs_wd3_b_set_changed(w0, slot, last_changed);
    };
    w0 = _ecs_wd3_b_set_eid(w0, last, 0);
    w0 = _ecs_wd3_b_set_x(w0, last, 0);
    w0 = _ecs_wd3_b_set_y(w0, last, 0);
    w0 = _ecs_wd3_b_set_added(w0, last, 0);
    w0 = _ecs_wd3_b_set_changed(w0, last, 0);
    w0.b_count = last;
    return w0;
}

fn ecs_wd3_remove_c(w0: EcsWD3World, e: EcsWD3Entity) -> EcsWD3World {
    let slot = _ecs_wd3_c_slot_of(w0, e.id);
    if slot < 0 { return w0; };
    let last = w0.c_count - 1;
    if slot != last {
        let last_eid = _ecs_wd3_c_eid_at(w0, last);
        let last_team = _ecs_wd3_c_team_at(w0, last);
        let last_added = _ecs_wd3_c_added_at(w0, last);
        let last_changed = _ecs_wd3_c_changed_at(w0, last);
        w0 = _ecs_wd3_c_set_eid(w0, slot, last_eid);
        w0 = _ecs_wd3_c_set_team(w0, slot, last_team);
        w0 = _ecs_wd3_c_set_added(w0, slot, last_added);
        w0 = _ecs_wd3_c_set_changed(w0, slot, last_changed);
    };
    w0 = _ecs_wd3_c_set_eid(w0, last, 0);
    w0 = _ecs_wd3_c_set_team(w0, last, 0);
    w0 = _ecs_wd3_c_set_added(w0, last, 0);
    w0 = _ecs_wd3_c_set_changed(w0, last, 0);
    w0.c_count = last;
    return w0;
}

// ecs_wd3_spawn_abc: spawn + insert_a + insert_b + insert_c. Returns EcsWD3Spawn wrapper.
fn ecs_wd3_spawn_abc(w0: EcsWD3World, ax: i32, ay: i32, bx: i32, by: i32, team: i32) -> EcsWD3Spawn {
    let sp = ecs_wd3_alloc_entity(w0);
    let w1 = ecs_wd3_spawn_world(sp);
    let e = ecs_wd3_spawn_entity(sp);
    let w2 = ecs_wd3_insert_a(w1, e, ax, ay);
    let w3 = ecs_wd3_insert_b(w2, e, bx, by);
    let w4 = ecs_wd3_insert_c(w3, e, team);
    return EcsWD3Spawn { world: w4, entity: e };
}

// ecs_wd3_despawn: remove_a + remove_b + remove_c + free_entity; no-op if not alive.
fn ecs_wd3_despawn(w0: EcsWD3World, e: EcsWD3Entity) -> EcsWD3World {
    if ecs_wd3_is_alive(w0, e) != true { return w0; };
    w0 = ecs_wd3_remove_a(w0, e);
    w0 = ecs_wd3_remove_b(w0, e);
    w0 = ecs_wd3_remove_c(w0, e);
    w0 = ecs_wd3_free_entity(w0, e);
    return w0;
}

// ecs_wd3_c_added_since / c_changed_since: strict-greater-than (stamp > tick).
fn ecs_wd3_c_added_since(w: EcsWD3World, e: EcsWD3Entity, tick: i32) -> bool {
    let slot = _ecs_wd3_c_slot_of(w, e.id);
    if slot < 0 { return false; };
    return _ecs_wd3_c_added_at(w, slot) > tick;
}

fn ecs_wd3_c_changed_since(w: EcsWD3World, e: EcsWD3Entity, tick: i32) -> bool {
    let slot = _ecs_wd3_c_slot_of(w, e.id);
    if slot < 0 { return false; };
    return _ecs_wd3_c_changed_at(w, slot) > tick;
}

// ── Resource slot (single EcsWD3Time plug) operations. ────────────────────────────────────
fn ecs_wd3_insert_resource(w0: EcsWD3World, tick: i32) -> EcsWD3World {
    w0.res_has = 1;
    w0.res_tick = tick;
    w0.res_added_t = w0.change_tick;
    w0.res_changed_t = w0.change_tick;
    return w0;
}

fn ecs_wd3_has_resource(w: EcsWD3World) -> bool { return w.res_has == 1; }

fn ecs_wd3_get_resource(w: EcsWD3World) -> EcsWD3Time {
    if w.res_has != 1 { panic(8107); };
    return EcsWD3Time { tick: w.res_tick };
}

fn ecs_wd3_remove_resource(w0: EcsWD3World) -> EcsWD3World {
    w0.res_has = 0;
    return w0;
}

// ── Message queue (cap-16 EcsWD3Event plug) operations. ──────────────────────────────────
struct EcsWD3Read { has_value: i32, amount: i32, cursor: i32 }
fn ecs_wd3_read_has_value(r: EcsWD3Read) -> i32 { return r.has_value; }
fn ecs_wd3_read_amount(r: EcsWD3Read) -> i32 { return r.amount; }
fn ecs_wd3_read_cursor(r: EcsWD3Read) -> i32 { return r.cursor; }

struct EcsWD3MessageReader { cursor: i32 }
fn ecs_wd3_message_reader_new() -> EcsWD3MessageReader { return EcsWD3MessageReader { cursor: 0 }; }
fn ecs_wd3_message_reader_cursor(r: EcsWD3MessageReader) -> i32 { return r.cursor; }
fn ecs_wd3_message_reader_with_cursor(cursor: i32) -> EcsWD3MessageReader {
    return EcsWD3MessageReader { cursor: cursor };
}

fn ecs_wd3_write_message(w0: EcsWD3World, amount: i32) -> EcsWD3World {
    if w0.msg_tail >= ECS_WD3_CAP { panic(8108); };
    w0 = _ecs_wd3_set_msg(w0, w0.msg_tail, amount);
    w0.msg_tail = w0.msg_tail + 1;
    return w0;
}

fn ecs_wd3_read_message(w: EcsWD3World, reader: EcsWD3MessageReader) -> EcsWD3Read {
    if reader.cursor < w.msg_tail {
        let amt = _ecs_wd3_msg_at(w, reader.cursor);
        return EcsWD3Read { has_value: 1, amount: amt, cursor: reader.cursor + 1 };
    };
    return EcsWD3Read { has_value: 0, amount: 0, cursor: reader.cursor };
}

fn ecs_wd3_message_count(w: EcsWD3World) -> i32 { return w.msg_tail; }

// ── Triple query over A × B × C. ────────────────────────────────────────────────────────
// Iterates A store, finds B-slot and C-slot by eid, emits an item (entity, a_slot, b_slot,
// c_slot, a: Pos, b: Vel, c: Player). Each item is a flat scalar slot family per index.

struct EcsWD3TripleQuery {
    count: i32,
    e_id0: i32, e_id1: i32, e_id2: i32, e_id3: i32, e_id4: i32, e_id5: i32, e_id6: i32, e_id7: i32, e_id8: i32, e_id9: i32, e_id10: i32, e_id11: i32, e_id12: i32, e_id13: i32, e_id14: i32, e_id15: i32,
    e_gen0: i32, e_gen1: i32, e_gen2: i32, e_gen3: i32, e_gen4: i32, e_gen5: i32, e_gen6: i32, e_gen7: i32, e_gen8: i32, e_gen9: i32, e_gen10: i32, e_gen11: i32, e_gen12: i32, e_gen13: i32, e_gen14: i32, e_gen15: i32,
    a_slot0: i32, a_slot1: i32, a_slot2: i32, a_slot3: i32, a_slot4: i32, a_slot5: i32, a_slot6: i32, a_slot7: i32, a_slot8: i32, a_slot9: i32, a_slot10: i32, a_slot11: i32, a_slot12: i32, a_slot13: i32, a_slot14: i32, a_slot15: i32,
    b_slot0: i32, b_slot1: i32, b_slot2: i32, b_slot3: i32, b_slot4: i32, b_slot5: i32, b_slot6: i32, b_slot7: i32, b_slot8: i32, b_slot9: i32, b_slot10: i32, b_slot11: i32, b_slot12: i32, b_slot13: i32, b_slot14: i32, b_slot15: i32,
    c_slot0: i32, c_slot1: i32, c_slot2: i32, c_slot3: i32, c_slot4: i32, c_slot5: i32, c_slot6: i32, c_slot7: i32, c_slot8: i32, c_slot9: i32, c_slot10: i32, c_slot11: i32, c_slot12: i32, c_slot13: i32, c_slot14: i32, c_slot15: i32,
    a_x0: i32, a_x1: i32, a_x2: i32, a_x3: i32, a_x4: i32, a_x5: i32, a_x6: i32, a_x7: i32, a_x8: i32, a_x9: i32, a_x10: i32, a_x11: i32, a_x12: i32, a_x13: i32, a_x14: i32, a_x15: i32,
    a_y0: i32, a_y1: i32, a_y2: i32, a_y3: i32, a_y4: i32, a_y5: i32, a_y6: i32, a_y7: i32, a_y8: i32, a_y9: i32, a_y10: i32, a_y11: i32, a_y12: i32, a_y13: i32, a_y14: i32, a_y15: i32,
    b_x0: i32, b_x1: i32, b_x2: i32, b_x3: i32, b_x4: i32, b_x5: i32, b_x6: i32, b_x7: i32, b_x8: i32, b_x9: i32, b_x10: i32, b_x11: i32, b_x12: i32, b_x13: i32, b_x14: i32, b_x15: i32,
    b_y0: i32, b_y1: i32, b_y2: i32, b_y3: i32, b_y4: i32, b_y5: i32, b_y6: i32, b_y7: i32, b_y8: i32, b_y9: i32, b_y10: i32, b_y11: i32, b_y12: i32, b_y13: i32, b_y14: i32, b_y15: i32,
    c_team0: i32, c_team1: i32, c_team2: i32, c_team3: i32, c_team4: i32, c_team5: i32, c_team6: i32, c_team7: i32, c_team8: i32, c_team9: i32, c_team10: i32, c_team11: i32, c_team12: i32, c_team13: i32, c_team14: i32, c_team15: i32,
}

fn ecs_wd3_pair_query_count(q: EcsWD3TripleQuery) -> i32 { return q.count; }

fn ecs_wd3_pair_query_entity_at(q: EcsWD3TripleQuery, idx: i32) -> EcsWD3Entity {
    return EcsWD3Entity { id: _ecs_wd3_q_e_id_at(q, idx), generation: _ecs_wd3_q_e_gen_at(q, idx) };
}

fn ecs_wd3_pair_query_a_at(q: EcsWD3TripleQuery, idx: i32) -> EcsWD3Pos {
    return EcsWD3Pos { x: _ecs_wd3_q_a_x_at(q, idx), y: _ecs_wd3_q_a_y_at(q, idx) };
}

fn ecs_wd3_pair_query_b_at(q: EcsWD3TripleQuery, idx: i32) -> EcsWD3Vel {
