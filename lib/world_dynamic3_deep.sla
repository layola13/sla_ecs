// Deep bed for lib/world_dynamic3.sla (Batch 391).
// Mirrors shallow lib/world_dynamic3.sla's generically-typed DynamicWorld3<A,B,C,R,M> (Vec/
// dyn_store-backed dynamic 3-column variant of DynamicWorld with cap-N growable entity
// allocation) as a SELF-CONTAINED fixed-cap variant (NO `@import`) baking the entity allocator
// + 3 component stores + per-store added/changed tick arrays + ResourceSlot + Messages queue +
// change_tick. Shallow uses Vec growth + generics + `impl QueryIter { fn self }` method-call
// syntax + `for pos in query { ... }` iteration; the deep replaces each Vec with `field0..15`
// cap-16 scalar slot families (SA has no fixed-array in `_deep.sla`), replaces `impl ... { fn
// self }` with free functions per Batch 388 #7, and tests use `while` loops (no for-in) and
// wrapper-struct accessors per Batch 373.
//
// Concrete typed plugs: `EcsWD3Pos{x,y}` (A), `EcsWD3Vel{x,y}` (B), `EcsWD3Player{team}` (C),
// `EcsWD3Time{tick}` (resource R), `EcsWD3Event{amount}` (message M). change_tick starts at 1
// (mirrors shallow `dynamic_world3_new` which sets `change_tick: 1`). Cap is fixed at 16
// entities (the shallow can grow via Vec::push but cap-16 here still leaves room beyond the
// shallow's small embedded test scenarios and exercises cap-reject).
//
// Shallow surfaces 3 @test at panic 8101-8224 (shallow's resort-style guard panics 8101/8104/
// 8105/8106 against non-alive/non-component, plus test asserts 8200-8224). Wrapper structs
// (EcsWD3Spawn/EcsWD3TripleQuery/EcsWD3QueryA) replace tuple-return and Vec-return ops so
// tests never destructure tuples (`let (w, e) = spawn`) nor use Vec members directly.

const ECS_WD3_CAP: i32 = 16;

// ── Entity wrapper { id, generation } (cap-16 + 32-bit gen each). ────────────────────────────
struct EcsWD3Entity { id: i32, generation: i32 }
fn ecs_wd3_entity_eq(a: EcsWD3Entity, b: EcsWD3Entity) -> bool {
    if a.id != b.id { return false; };
    if a.generation != b.generation { return false; };
    return true;
}
fn ecs_wd3_entity_id(a: EcsWD3Entity) -> i32 { return a.id; }
fn ecs_wd3_entity_gen(a: EcsWD3Entity) -> i32 { return a.generation; }
fn ecs_wd3_entity_new(id: i32, gen: i32) -> EcsWD3Entity { return EcsWD3Entity { id: id, generation: gen }; }

// ── Concrete typed plugs. ─────────────────────────────────────────────────────────────────
struct EcsWD3Pos { x: i32, y: i32 }
struct EcsWD3Vel { x: i32, y: i32 }
struct EcsWD3Player { team: i32 }
struct EcsWD3Time { tick: i32 }
struct EcsWD3Event { amount: i32 }
fn ecs_wd3_pos_new(x: i32, y: i32) -> EcsWD3Pos { return EcsWD3Pos { x: x, y: y }; }
fn ecs_wd3_pos_x(p: EcsWD3Pos) -> i32 { return p.x; }
fn ecs_wd3_pos_y(p: EcsWD3Pos) -> i32 { return p.y; }
fn ecs_wd3_vel_new(x: i32, y: i32) -> EcsWD3Vel { return EcsWD3Vel { x: x, y: y }; }
fn ecs_wd3_vel_x(v: EcsWD3Vel) -> i32 { return v.x; }
fn ecs_wd3_vel_y(v: EcsWD3Vel) -> i32 { return v.y; }
fn ecs_wd3_player_new(team: i32) -> EcsWD3Player { return EcsWD3Player { team: team }; }
fn ecs_wd3_player_team(p: EcsWD3Player) -> i32 { return p.team; }
fn ecs_wd3_time_new(t: i32) -> EcsWD3Time { return EcsWD3Time { tick: t }; }
fn ecs_wd3_time_tick(t: EcsWD3Time) -> i32 { return t.tick; }
fn ecs_wd3_event_new(a: i32) -> EcsWD3Event { return EcsWD3Event { amount: a }; }
fn ecs_wd3_event_amount(e: EcsWD3Event) -> i32 { return e.amount; }

// ── World: cap-16 entity allocator + 3 component stores (cap-16 each, slot-addressed by
//    entity_id) + per-store added/changed tick arrays cap-16 + 1 resource slot + cap-16
//    message queue + change_tick.
struct EcsWD3World {
    // Entity allocator state (flat-scalar: next_id + free_count + generations[16] + free_ids[16]
    // + occupied[16]). Mirrors DynamicEntityAllocator free_ids + generations + occupied.
    next_id: i32,
    free_count: i32,
    gen0: i32, gen1: i32, gen2: i32, gen3: i32, gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    gen8: i32, gen9: i32, gen10: i32, gen11: i32, gen12: i32, gen13: i32, gen14: i32, gen15: i32,
    free_id0: i32, free_id1: i32, free_id2: i32, free_id3: i32, free_id4: i32, free_id5: i32, free_id6: i32, free_id7: i32,
    free_id8: i32, free_id9: i32, free_id10: i32, free_id11: i32, free_id12: i32, free_id13: i32, free_id14: i32, free_id15: i32,
    occ0: i32, occ1: i32, occ2: i32, occ3: i32, occ4: i32, occ5: i32, occ6: i32, occ7: i32,
    occ8: i32, occ9: i32, occ10: i32, occ11: i32, occ12: i32, occ13: i32, occ14: i32, occ15: i32,
    // A component store (EcsWD3Pos): count + per-slot (eid, x, y, added_t, changed_t) cap-16.
    a_count: i32,
    a_eid0: i32, a_eid1: i32, a_eid2: i32, a_eid3: i32, a_eid4: i32, a_eid5: i32, a_eid6: i32, a_eid7: i32,
    a_eid8: i32, a_eid9: i32, a_eid10: i32, a_eid11: i32, a_eid12: i32, a_eid13: i32, a_eid14: i32, a_eid15: i32,
    a_x0: i32, a_x1: i32, a_x2: i32, a_x3: i32, a_x4: i32, a_x5: i32, a_x6: i32, a_x7: i32,
    a_x8: i32, a_x9: i32, a_x10: i32, a_x11: i32, a_x12: i32, a_x13: i32, a_x14: i32, a_x15: i32,
    a_y0: i32, a_y1: i32, a_y2: i32, a_y3: i32, a_y4: i32, a_y5: i32, a_y6: i32, a_y7: i32,
    a_y8: i32, a_y9: i32, a_y10: i32, a_y11: i32, a_y12: i32, a_y13: i32, a_y14: i32, a_y15: i32,
    a_added_t0: i32, a_added_t1: i32, a_added_t2: i32, a_added_t3: i32, a_added_t4: i32, a_added_t5: i32, a_added_t6: i32, a_added_t7: i32,
    a_added_t8: i32, a_added_t9: i32, a_added_t10: i32, a_added_t11: i32, a_added_t12: i32, a_added_t13: i32, a_added_t14: i32, a_added_t15: i32,
    a_changed_t0: i32, a_changed_t1: i32, a_changed_t2: i32, a_changed_t3: i32, a_changed_t4: i32, a_changed_t5: i32, a_changed_t6: i32, a_changed_t7: i32,
    a_changed_t8: i32, a_changed_t9: i32, a_changed_t10: i32, a_changed_t11: i32, a_changed_t12: i32, a_changed_t13: i32, a_changed_t14: i32, a_changed_t15: i32,
    // B component store (EcsWD3Vel): count + per-slot (eid, x, y, added_t, changed_t) cap-16.
    b_count: i32,
    b_eid0: i32, b_eid1: i32, b_eid2: i32, b_eid3: i32, b_eid4: i32, b_eid5: i32, b_eid6: i32, b_eid7: i32,
    b_eid8: i32, b_eid9: i32, b_eid10: i32, b_eid11: i32, b_eid12: i32, b_eid13: i32, b_eid14: i32, b_eid15: i32,
    b_x0: i32, b_x1: i32, b_x2: i32, b_x3: i32, b_x4: i32, b_x5: i32, b_x6: i32, b_x7: i32,
    b_x8: i32, b_x9: i32, b_x10: i32, b_x11: i32, b_x12: i32, b_x13: i32, b_x14: i32, b_x15: i32,
    b_y0: i32, b_y1: i32, b_y2: i32, b_y3: i32, b_y4: i32, b_y5: i32, b_y6: i32, b_y7: i32,
    b_y8: i32, b_y9: i32, b_y10: i32, b_y11: i32, b_y12: i32, b_y13: i32, b_y14: i32, b_y15: i32,
    b_added_t0: i32, b_added_t1: i32, b_added_t2: i32, b_added_t3: i32, b_added_t4: i32, b_added_t5: i32, b_added_t6: i32, b_added_t7: i32,
    b_added_t8: i32, b_added_t9: i32, b_added_t10: i32, b_added_t11: i32, b_added_t12: i32, b_added_t13: i32, b_added_t14: i32, b_added_t15: i32,
    b_changed_t0: i32, b_changed_t1: i32, b_changed_t2: i32, b_changed_t3: i32, b_changed_t4: i32, b_changed_t5: i32, b_changed_t6: i32, b_changed_t7: i32,
    b_changed_t8: i32, b_changed_t9: i32, b_changed_t10: i32, b_changed_t11: i32, b_changed_t12: i32, b_changed_t13: i32, b_changed_t14: i32, b_changed_t15: i32,
    // C component store (EcsWD3Player): count + per-slot (eid, team, added_t, changed_t) cap-16.
    c_count: i32,
    c_eid0: i32, c_eid1: i32, c_eid2: i32, c_eid3: i32, c_eid4: i32, c_eid5: i32, c_eid6: i32, c_eid7: i32,
    c_eid8: i32, c_eid9: i32, c_eid10: i32, c_eid11: i32, c_eid12: i32, c_eid13: i32, c_eid14: i32, c_eid15: i32,
    c_team0: i32, c_team1: i32, c_team2: i32, c_team3: i32, c_team4: i32, c_team5: i32, c_team6: i32, c_team7: i32,
    c_team8: i32, c_team9: i32, c_team10: i32, c_team11: i32, c_team12: i32, c_team13: i32, c_team14: i32, c_team15: i32,
    c_added_t0: i32, c_added_t1: i32, c_added_t2: i32, c_added_t3: i32, c_added_t4: i32, c_added_t5: i32, c_added_t6: i32, c_added_t7: i32,
    c_added_t8: i32, c_added_t9: i32, c_added_t10: i32, c_added_t11: i32, c_added_t12: i32, c_added_t13: i32, c_added_t14: i32, c_added_t15: i32,
    c_changed_t0: i32, c_changed_t1: i32, c_changed_t2: i32, c_changed_t3: i32, c_changed_t4: i32, c_changed_t5: i32, c_changed_t6: i32, c_changed_t7: i32,
    c_changed_t8: i32, c_changed_t9: i32, c_changed_t10: i32, c_changed_t11: i32, c_changed_t12: i32, c_changed_t13: i32, c_changed_t14: i32, c_changed_t15: i32,
    // Resource slot (single EcsWD3Time): has-flag + tick + added_t + changed_t.
    res_has: i32,
    res_tick: i32,
    res_added_t: i32,
    res_changed_t: i32,
    // Message slot (cap-16): tail + per-slot amount.
    msg_tail: i32,
    msg0: i32, msg1: i32, msg2: i32, msg3: i32, msg4: i32, msg5: i32, msg6: i32, msg7: i32,
    msg8: i32, msg9: i32, msg10: i32, msg11: i32, msg12: i32, msg13: i32, msg14: i32, msg15: i32,
    // Monotone change tick (starts at 1).
    change_tick: i32,
}

fn ecs_wd3_world_new() -> EcsWD3World {
    return EcsWD3World {
        next_id: 1, free_count: 0,
        gen0: 0, gen1: 0, gen2: 0, gen3: 0, gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        gen8: 0, gen9: 0, gen10: 0, gen11: 0, gen12: 0, gen13: 0, gen14: 0, gen15: 0,
        free_id0: 0, free_id1: 0, free_id2: 0, free_id3: 0, free_id4: 0, free_id5: 0, free_id6: 0, free_id7: 0,
        free_id8: 0, free_id9: 0, free_id10: 0, free_id11: 0, free_id12: 0, free_id13: 0, free_id14: 0, free_id15: 0,
        occ0: 0, occ1: 0, occ2: 0, occ3: 0, occ4: 0, occ5: 0, occ6: 0, occ7: 0,
        occ8: 0, occ9: 0, occ10: 0, occ11: 0, occ12: 0, occ13: 0, occ14: 0, occ15: 0,
        a_count: 0,
        a_eid0: 0, a_eid1: 0, a_eid2: 0, a_eid3: 0, a_eid4: 0, a_eid5: 0, a_eid6: 0, a_eid7: 0,
        a_eid8: 0, a_eid9: 0, a_eid10: 0, a_eid11: 0, a_eid12: 0, a_eid13: 0, a_eid14: 0, a_eid15: 0,
        a_x0: 0, a_x1: 0, a_x2: 0, a_x3: 0, a_x4: 0, a_x5: 0, a_x6: 0, a_x7: 0,
        a_x8: 0, a_x9: 0, a_x10: 0, a_x11: 0, a_x12: 0, a_x13: 0, a_x14: 0, a_x15: 0,
        a_y0: 0, a_y1: 0, a_y2: 0, a_y3: 0, a_y4: 0, a_y5: 0, a_y6: 0, a_y7: 0,
        a_y8: 0, a_y9: 0, a_y10: 0, a_y11: 0, a_y12: 0, a_y13: 0, a_y14: 0, a_y15: 0,
        a_added_t0: 0, a_added_t1: 0, a_added_t2: 0, a_added_t3: 0, a_added_t4: 0, a_added_t5: 0, a_added_t6: 0, a_added_t7: 0,
        a_added_t8: 0, a_added_t9: 0, a_added_t10: 0, a_added_t11: 0, a_added_t12: 0, a_added_t13: 0, a_added_t14: 0, a_added_t15: 0,
