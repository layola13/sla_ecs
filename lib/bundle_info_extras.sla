// Bevy ECS bundle::info extension — BundleId::index, contributed_components,
// iter_explicit/iter_contributed/iter_required, Bundles registry surface (is_empty / iter / get_id).
// Mirrors src/bundle/info.rs (the gaps not in lib/bundle_info.sla).

// === BundleId::index() ===
struct EcsBundleIdV2 {
    raw_index: i32,
}

fn ecs_bundle_id_v2_new(index: i32) -> EcsBundleIdV2 {
    let id = EcsBundleIdV2 { raw_index: index };
    return id;
}

fn ecs_bundle_id_v2_index(id: EcsBundleIdV2) -> i32 {
    return id.raw_index;
}

// === BundleInfo contributed_components explicit/required split ===
// contributed = [explicit...][required...]  (order per Bevy)
struct EcsBundleInfoV2 {
    bundle_id: i32,
    contributed_component_ids: Vec<i32>,
    explicit_count: i32,
}

fn ecs_bundle_info_v2_new(bundle_id: i32, explicit_ids: Vec<i32>, required_ids: Vec<i32>) -> EcsBundleInfoV2 {
    let contributed = Vec::new();
    let idx = 0;
    let n_explicit = len(explicit_ids);
    while idx < n_explicit {
        let cid = explicit_ids[idx];
        contributed.push(cid);
        idx = idx + 1;
    }
    let idx2 = 0;
    let n_required = len(required_ids);
    while idx2 < n_required {
        let rid = required_ids[idx2];
        contributed.push(rid);
        idx2 = idx2 + 1;
    }
    let info = EcsBundleInfoV2 { bundle_id: bundle_id, contributed_component_ids: contributed, explicit_count: n_explicit };
    return info;
}

fn ecs_bundle_info_v2_explicit_count(info: EcsBundleInfoV2) -> i32 {
    return info.explicit_count;
}

fn ecs_bundle_info_v2_explicit_components_len(info: EcsBundleInfoV2) -> i32 {
    return len(info.contributed_component_ids) - info.explicit_count;
}

// explicit_components(): the first explicit_count entries
fn ecs_bundle_info_v2_explicit_components(info: EcsBundleInfoV2) -> Vec<i32> {
    let out = Vec::new();
    let idx = 0;
    while idx < info.explicit_count {
        let cid = info.contributed_component_ids[idx];
        out.push(cid);
        idx = idx + 1;
    }
    return out;
}

// required_components(): entries after explicit_count
fn ecs_bundle_info_v2_required_components(info: EcsBundleInfoV2) -> Vec<i32> {
    let out = Vec::new();
    let idx = info.explicit_count;
    let n = len(info.contributed_component_ids);
    while idx < n {
        let cid = info.contributed_component_ids[idx];
        out.push(cid);
        idx = idx + 1;
    }
    return out;
}

// contributed_components(): all entries (explicit then required)
fn ecs_bundle_info_v2_contributed_components(info: EcsBundleInfoV2) -> Vec<i32> {
    return info.contributed_component_ids;
}

fn ecs_bundle_info_v2_id(info: EcsBundleInfoV2) -> i32 {
    return info.bundle_id;
}

// iter_explicit_components() → equivalent: returns the explicit ids vec
fn ecs_bundle_info_v2_iter_explicit_components(info: EcsBundleInfoV2) -> Vec<i32> {
    return ecs_bundle_info_v2_explicit_components(info);
}

// iter_contributed_components() → equivalent: returns the contributed ids vec
fn ecs_bundle_info_v2_iter_contributed_components(info: EcsBundleInfoV2) -> Vec<i32> {
    return ecs_bundle_info_v2_contributed_components(info);
}

// iter_required_components() → equivalent: returns the required ids vec
fn ecs_bundle_info_v2_iter_required_components(info: EcsBundleInfoV2) -> Vec<i32> {
    return ecs_bundle_info_v2_required_components(info);
}

// === Bundles registry ===
struct EcsBundles {
    bundles: Vec<EcsBundleInfoV2>,
    type_to_id: Vec<i32>,
}

fn ecs_bundles_new() -> EcsBundles {
    let b = EcsBundles { bundles: Vec::new(), type_to_id: Vec::new() };
    return b;
}

fn ecs_bundles_len(b: EcsBundles) -> i32 {
    return len(b.bundles);
}

fn ecs_bundles_is_empty(b: EcsBundles) -> bool {
    return len(b.bundles) == 0;
}

fn ecs_bundles_register(b: EcsBundles, bundle_id: i32, explicit_ids: Vec<i32>, required_ids: Vec<i32>) -> EcsBundles {
    let info = ecs_bundle_info_v2_new(bundle_id, explicit_ids, required_ids);
    b.bundles.push(info);
    return b;
}

// get(bundle_id): returns (found, index_into_bundles)
fn ecs_bundles_get(b: EcsBundles, bundle_id: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(b.bundles) as i32;
    while idx < n {
        let info = b.bundles[idx];
        if info.bundle_id == bundle_id {
            return (true, idx);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

// iter(): returns a copy of all BundleInfo entries
fn ecs_bundles_iter(b: EcsBundles) -> Vec<EcsBundleInfoV2> {
    return b.bundles;
}

// get_id(type_id): returns BundleId corresponding to the type, if registered.
// Here type_to_id pairs (type_id, bundle_id) — encoded as: even index = type_id, odd index = bundle_id.
fn ecs_bundles_register_type(b: EcsBundles, type_id: i32, bundle_id: i32) -> EcsBundles {
    b.type_to_id.push(type_id);
    b.type_to_id.push(bundle_id);
    return b;
}

fn ecs_bundles_get_id(b: EcsBundles, type_id: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(b.type_to_id) as i32;
    while idx < n {
        let tid = b.type_to_id[idx];
        if tid == type_id {
            let bid = b.type_to_id[idx + 1];
            return (true, bid);
        };
        idx = idx + 2;
    }
    return (false, 0);
}
