// Bevy ECS IntoScheduleConfigs / ScheduleConfigs gaps — chain/chain_ignore_deferred/distributive_run_if/
// ambiguous_with/ambiguous_with_all/before_ignore_deferred/after_ignore_deferred. Mirrors src/schedule/config.rs
// (gaps not in lib/schedule_config.sla).
//
// SLA constraints: no closures/generics over types. The condition and set use plain i32 ids.

// A ScheduleConfigs-group model: per-config list + chain flag + apply_deferred on edges flag +
// per-config ignore-deferred flags + ambiguous_with ids + ambiguous_with_all flag + collective vs distributive conditions.
struct EcsScheduleConfigsV2 {
    system_ids: Vec<i32>,
    chain: bool,
    apply_deferred_on_edges: bool,
    // per-index: was a before_ignore_deferred applied to a target set id? -1 = none
    before_id_ignore_deferred: i32,
    after_id_ignore_deferred: i32,
    // distributed conditions: we record a count of distributed conditions per config (M of distributive_run_if)
    distributive_conditions: i32,
    collective_conditions: i32,
    ambiguous_with_ids: Vec<i32>,
    ambiguous_with_all: bool,
}

fn ecs_schedule_configs_v2_new() -> EcsScheduleConfigsV2 {
    let c = EcsScheduleConfigsV2 { system_ids: Vec::new(), chain: false, apply_deferred_on_edges: true, before_id_ignore_deferred: -1, after_id_ignore_deferred: -1, distributive_conditions: 0, collective_conditions: 0, ambiguous_with_ids: Vec::new(), ambiguous_with_all: false };
    return c;
}

fn ecs_schedule_configs_v2_add(c: EcsScheduleConfigsV2, system_id: i32) -> EcsScheduleConfigsV2 {
    c.system_ids.push(system_id);
    return c;
}

fn ecs_schedule_configs_v2_len(c: EcsScheduleConfigsV2) -> i32 {
    return len(c.system_ids) as i32;
}

fn ecs_schedule_configs_v2_system_at(c: EcsScheduleConfigsV2, i: i32) -> i32 {
    let n: i32 = len(c.system_ids) as i32;
    if i < 0 || i >= n { return -1; };
    return c.system_ids[i];
}

// chain(): treat as a sequence — chain=true + apply_deferred on edges true (the default Bevy semantic).
fn ecs_schedule_configs_v2_chain(c: EcsScheduleConfigsV2) -> EcsScheduleConfigsV2 {
    c.chain = true;
    c.apply_deferred_on_edges = true;
    return c;
}

// chain_ignore_deferred(): chain but does NOT apply deferred on edges.
fn ecs_schedule_configs_v2_chain_ignore_deferred(c: EcsScheduleConfigsV2) -> EcsScheduleConfigsV2 {
    c.chain = true;
    c.apply_deferred_on_edges = false;
    return c;
}

fn ecs_schedule_configs_v2_is_chain(c: EcsScheduleConfigsV2) -> bool {
    return c.chain;
}

fn ecs_schedule_configs_v2_applies_deferred_on_edges(c: EcsScheduleConfigsV2) -> bool {
    return c.apply_deferred_on_edges;
}

// distributive_run_if(cond): the condition applies to every individual config.
// We model this by incrementing distributive_conditions for every config.
fn ecs_schedule_configs_v2_distributive_run_if(c: EcsScheduleConfigsV2, condition_id: i32) -> EcsScheduleConfigsV2 {
    let _ = condition_id;
    let n: i32 = len(c.system_ids) as i32;
    c.distributive_conditions = c.distributive_conditions + n;
    return c;
}

fn ecs_schedule_configs_v2_distributive_conditions(c: EcsScheduleConfigsV2) -> i32 {
    return c.distributive_conditions;
}

// collective run_if (Bevy's run_if): the condition evaluated once for the whole group.
fn ecs_schedule_configs_v2_run_if(c: EcsScheduleConfigsV2, condition_id: i32) -> EcsScheduleConfigsV2 {
    let _ = condition_id;
    c.collective_conditions = c.collective_conditions + 1;
    return c;
}

fn ecs_schedule_configs_v2_collective_conditions(c: EcsScheduleConfigsV2) -> i32 {
    return c.collective_conditions;
}

// before_ignore_deferred(set): add a "before" ordering vs set that does not insert ApplyDeferred.
// We record the set id (single-target model; multis ignored in the facade).
fn ecs_schedule_configs_v2_before_ignore_deferred(c: EcsScheduleConfigsV2, set_id: i32) -> EcsScheduleConfigsV2 {
    c.before_id_ignore_deferred = set_id;
    return c;
}

fn ecs_schedule_configs_v2_after_ignore_deferred(c: EcsScheduleConfigsV2, set_id: i32) -> EcsScheduleConfigsV2 {
    c.after_id_ignore_deferred = set_id;
    return c;
}

fn ecs_schedule_configs_v2_before_id_ignore_deferred(c: EcsScheduleConfigsV2) -> i32 {
    return c.before_id_ignore_deferred;
}

fn ecs_schedule_configs_v2_after_id_ignore_deferred(c: EcsScheduleConfigsV2) -> i32 {
    return c.after_id_ignore_deferred;
}

// ambiguous_with(set): record a set-id we are ambiguous with.
fn ecs_schedule_configs_v2_ambiguous_with(c: EcsScheduleConfigsV2, set_id: i32) -> EcsScheduleConfigsV2 {
    c.ambiguous_with_ids.push(set_id);
    return c;
}

// ambiguous_with_all(): clear the ids list and flag all.
fn ecs_schedule_configs_v2_ambiguous_with_all(c: EcsScheduleConfigsV2) -> EcsScheduleConfigsV2 {
    c.ambiguous_with_all = true;
    return c;
}

fn ecs_schedule_configs_v2_ambiguous_with_ids_count(c: EcsScheduleConfigsV2) -> i32 {
    return len(c.ambiguous_with_ids) as i32;
}

fn ecs_schedule_configs_v2_ambiguous_with_at(c: EcsScheduleConfigsV2, i: i32) -> i32 {
    let n: i32 = len(c.ambiguous_with_ids) as i32;
    if i < 0 || i >= n { return -1; };
    return c.ambiguous_with_ids[i];
}

fn ecs_schedule_configs_v2_is_ambiguous_with_all(c: EcsScheduleConfigsV2) -> bool {
    return c.ambiguous_with_all;
}

// into_configs(): in Bevy this is the identity for ScheduleConfigs. We model this as a copy-echo.
fn ecs_schedule_configs_v2_into_configs(c: EcsScheduleConfigsV2) -> EcsScheduleConfigsV2 {
    return c;
}
