// Deep self-contained mirror of lib/reflect.sla.
// The shallow module uses a Reflect trait plus real fn-pointer fields over ErasedComponentValue.
// This deep slice keeps the API shape but lowers fn pointers to stable i64 handles and folds
// ErasedComponentValue into a flat scalar value record. No @import, no nested fn table field.

@derive(copy)
struct EcsReflectValueDeep {
    type_id: i32,
    raw: i64,
}

fn ecs_reflect_value_deep_new(type_id: i32, raw: i64) -> EcsReflectValueDeep {
    return EcsReflectValueDeep { type_id: type_id, raw: raw };
}

fn ecs_reflect_value_deep_type_id(v: EcsReflectValueDeep) -> i32 { return v.type_id; }
fn ecs_reflect_value_deep_raw(v: EcsReflectValueDeep) -> i64 { return v.raw; }

fn ecs_reflect_deep_reflect_type_id(v: EcsReflectValueDeep) -> i32 {
    return v.type_id;
}

fn ecs_reflect_deep_clone_value(v: EcsReflectValueDeep) -> EcsReflectValueDeep {
    return EcsReflectValueDeep { type_id: v.type_id, raw: v.raw };
}

@derive(copy)
struct EcsReflectComponentFnsDeep {
    insert_fn: i64,
    apply_fn: i64,
    remove_fn: i64,
    take_fn: i64,
    contains_fn: i64,
    reflect_fn: i64,
    copy_fn: i64,
    register_component_fn: i64,
}

fn ecs_reflect_component_fns_deep_new(
    insert_fn: i64,
    apply_fn: i64,
    remove_fn: i64,
    take_fn: i64,
    contains_fn: i64,
    reflect_fn: i64,
    copy_fn: i64,
    register_component_fn: i64,
) -> EcsReflectComponentFnsDeep {
    return EcsReflectComponentFnsDeep {
        insert_fn: insert_fn,
        apply_fn: apply_fn,
        remove_fn: remove_fn,
        take_fn: take_fn,
        contains_fn: contains_fn,
        reflect_fn: reflect_fn,
        copy_fn: copy_fn,
        register_component_fn: register_component_fn,
    };
}

fn ecs_reflect_component_fns_deep_insert(f: EcsReflectComponentFnsDeep) -> i64 { return f.insert_fn; }
fn ecs_reflect_component_fns_deep_apply(f: EcsReflectComponentFnsDeep) -> i64 { return f.apply_fn; }
fn ecs_reflect_component_fns_deep_remove(f: EcsReflectComponentFnsDeep) -> i64 { return f.remove_fn; }
fn ecs_reflect_component_fns_deep_take(f: EcsReflectComponentFnsDeep) -> i64 { return f.take_fn; }
fn ecs_reflect_component_fns_deep_contains(f: EcsReflectComponentFnsDeep) -> i64 { return f.contains_fn; }
fn ecs_reflect_component_fns_deep_reflect(f: EcsReflectComponentFnsDeep) -> i64 { return f.reflect_fn; }
fn ecs_reflect_component_fns_deep_copy(f: EcsReflectComponentFnsDeep) -> i64 { return f.copy_fn; }
fn ecs_reflect_component_fns_deep_register_component(f: EcsReflectComponentFnsDeep) -> i64 { return f.register_component_fn; }

@derive(copy)
struct EcsReflectRootComponentDeep {
    component_type_id: i32,
    insert_fn: i64,
    apply_fn: i64,
    remove_fn: i64,
    take_fn: i64,
    contains_fn: i64,
    reflect_fn: i64,
    copy_fn: i64,
    register_component_fn: i64,
}

fn ecs_reflect_component_deep_new(type_id: i32, fns: EcsReflectComponentFnsDeep) -> EcsReflectRootComponentDeep {
    return EcsReflectRootComponentDeep {
        component_type_id: type_id,
        insert_fn: fns.insert_fn,
        apply_fn: fns.apply_fn,
        remove_fn: fns.remove_fn,
        take_fn: fns.take_fn,
        contains_fn: fns.contains_fn,
        reflect_fn: fns.reflect_fn,
        copy_fn: fns.copy_fn,
        register_component_fn: fns.register_component_fn,
    };
}

fn ecs_reflect_component_deep_type_id(rc: EcsReflectRootComponentDeep) -> i32 {
    return rc.component_type_id;
}

fn ecs_reflect_component_deep_fn_pointers(rc: EcsReflectRootComponentDeep) -> EcsReflectComponentFnsDeep {
    return EcsReflectComponentFnsDeep {
        insert_fn: rc.insert_fn,
        apply_fn: rc.apply_fn,
        remove_fn: rc.remove_fn,
        take_fn: rc.take_fn,
        contains_fn: rc.contains_fn,
        reflect_fn: rc.reflect_fn,
        copy_fn: rc.copy_fn,
        register_component_fn: rc.register_component_fn,
    };
}

fn ecs_reflect_component_deep_insert(rc: EcsReflectRootComponentDeep, type_id: i32) -> EcsReflectValueDeep {
    return EcsReflectValueDeep { type_id: type_id, raw: rc.insert_fn + (type_id as i64) };
}

fn ecs_reflect_component_deep_apply(
    rc: EcsReflectRootComponentDeep,
    target: EcsReflectValueDeep,
    source: EcsReflectValueDeep,
) -> EcsReflectValueDeep {
    return EcsReflectValueDeep {
        type_id: target.type_id,
        raw: rc.apply_fn + target.raw + source.raw,
    };
}

fn ecs_reflect_component_deep_remove(rc: EcsReflectRootComponentDeep, entity_row: i32) -> i32 {
    return (rc.remove_fn as i32) + entity_row;
}

fn ecs_reflect_component_deep_take(rc: EcsReflectRootComponentDeep, entity_row: i32) -> EcsReflectValueDeep {
    return EcsReflectValueDeep {
        type_id: rc.component_type_id,
        raw: rc.take_fn + (entity_row as i64),
    };
}

fn ecs_reflect_component_deep_contains(rc: EcsReflectRootComponentDeep, entity_row: i32) -> bool {
    return rc.contains_fn == (entity_row as i64);
}

fn ecs_reflect_component_deep_reflect(rc: EcsReflectRootComponentDeep, entity_row: i32) -> EcsReflectValueDeep {
    return EcsReflectValueDeep {
        type_id: rc.component_type_id,
        raw: rc.reflect_fn + (entity_row as i64),
    };
}

fn ecs_reflect_component_deep_copy(rc: EcsReflectRootComponentDeep, source_value: EcsReflectValueDeep) -> EcsReflectValueDeep {
    return EcsReflectValueDeep {
        type_id: source_value.type_id,
        raw: rc.copy_fn + source_value.raw,
    };
}

fn ecs_reflect_component_deep_register(rc: EcsReflectRootComponentDeep) -> i32 {
    return rc.register_component_fn as i32;
}
