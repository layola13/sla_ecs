// Bevy ECS EventKey + World event registration facade.
// Mirrors src/event/mod.rs.

// === EventKey (ComponentId-typed alias) ===
struct EcsEventKey {
    component_id: i32,
}

fn ecs_event_key_new(component_id: i32) -> EcsEventKey {
    let k = EcsEventKey { component_id: component_id };
    return k;
}

fn ecs_event_key_component_id(k: EcsEventKey) -> i32 {
    return k.component_id;
}

// === World event registry facade ===
// Maps type_id -> EventKey (ComponentId). register_event_key<E> allocates a new ComponentId
// for that event type (modeled by an arbitrary type_id tag), event_key<E> looks it up.
struct EcsEventRegistryEntry {
    type_id: i64,
    component_id: i32,
}

struct EcsEventRegistry {
    entries: Vec<EcsEventRegistryEntry>,
    next_component_id: i32,
}

fn ecs_event_registry_new() -> EcsEventRegistry {
    let r = EcsEventRegistry { entries: Vec::new(), next_component_id: 1 };
    return r;
}

// register_event_key<E>: returns EventKey; allocates a new ComponentId if type not seen before.
fn ecs_event_registry_register_event_key(r: EcsEventRegistry, type_id: i64) -> (EcsEventRegistry, EcsEventKey) {
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].type_id == type_id {
            let k = ecs_event_key_new(r.entries[idx].component_id);
            return (r, k);
        };
        idx = idx + 1;
    }
    let cid = r.next_component_id;
    r.next_component_id = r.next_component_id + 1;
    let e = EcsEventRegistryEntry { type_id: type_id, component_id: cid };
    r.entries.push(e);
    let k = ecs_event_key_new(cid);
    return (r, k);
}

// event_key<E>: returns (found, key) without registering.
fn ecs_event_registry_event_key(r: EcsEventRegistry, type_id: i64) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].type_id == type_id {
            return (true, r.entries[idx].component_id);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

fn ecs_event_registry_len(r: EcsEventRegistry) -> i32 {
    return len(r.entries) as i32;
}

fn ecs_event_registry_is_empty(r: EcsEventRegistry) -> bool {
    return len(r.entries) as i32 == 0;
}

// remove_event_key<E>: forgets a registered event (no direct Bevy equiv; supports cleanup).
fn ecs_event_registry_remove_event_key(r: EcsEventRegistry, type_id: i64) -> (bool, EcsEventRegistry) {
    let out = Vec::new();
    let mut removed: bool = false;
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].type_id != type_id {
            out.push(r.entries[idx]);
        };
        if r.entries[idx].type_id == type_id {
            removed = true;
        };
        idx = idx + 1;
    }
    r.entries = out;
    return (removed, r);
}

fn ecs_event_registry_next_component_id(r: EcsEventRegistry) -> i32 {
    return r.next_component_id;
}
