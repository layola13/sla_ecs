// Bevy ECS EntityHashSet wrapper operations from src/entity/hash_set.rs.
// Basic membership is already covered elsewhere; this module covers set algebra,
// assign variants, extend/from-iterator construction, iter/into_iter/drain, and extract_if.

struct EcsEntityHashSetOps {
    items: Vec<i64>,
}

struct EcsEntityHashSetDrainResult {
    set: EcsEntityHashSetOps,
    drained: Vec<i64>,
}

struct EcsEntityHashSetExtractResult {
    set: EcsEntityHashSetOps,
    extracted: Vec<i64>,
}

fn ecs_ehs_ops_new() -> EcsEntityHashSetOps {
    return EcsEntityHashSetOps { items: Vec::new() };
}

fn ecs_ehs_ops_len(set: EcsEntityHashSetOps) -> i64 { return len(set.items) as i64; }

fn ecs_ehs_ops_is_empty(set: EcsEntityHashSetOps) -> bool { return len(set.items) == 0; }

fn ecs_ehs_ops_contains(set: EcsEntityHashSetOps, entity: i64) -> bool {
    let i: i64 = 0;
    let n = len(set.items) as i64;
    while i < n {
        if set.items[i] == entity { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_ehs_ops_insert(set: EcsEntityHashSetOps, entity: i64) -> EcsEntityHashSetOps {
    if ecs_ehs_ops_contains(set, entity) { return set; };
    set.items.push(entity);
    return set;
}

fn ecs_ehs_ops_from_vec(values: Vec<i64>) -> EcsEntityHashSetOps {
    let set = ecs_ehs_ops_new();
    let i: i64 = 0;
    let n = len(values) as i64;
    while i < n {
        set = ecs_ehs_ops_insert(set, values[i]);
        i = i + 1;
    }
    return set;
}

fn ecs_ehs_ops_extend(set: EcsEntityHashSetOps, values: Vec<i64>) -> EcsEntityHashSetOps {
    let i: i64 = 0;
    let n = len(values) as i64;
    while i < n {
        set = ecs_ehs_ops_insert(set, values[i]);
        i = i + 1;
    }
    return set;
}

fn ecs_ehs_ops_at(set: EcsEntityHashSetOps, index: i64) -> i64 {
    if index < 0 { return -1; };
    if index >= len(set.items) as i64 { return -1; };
    return set.items[index];
}

fn ecs_ehs_ops_union(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    let out = ecs_ehs_ops_new();
    let i: i64 = 0;
    let left_len = len(left.items) as i64;
    while i < left_len {
        out = ecs_ehs_ops_insert(out, left.items[i]);
        i = i + 1;
    }
    let j: i64 = 0;
    let right_len = len(right.items) as i64;
    while j < right_len {
        out = ecs_ehs_ops_insert(out, right.items[j]);
        j = j + 1;
    }
    return out;
}

fn ecs_ehs_ops_intersection(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    let out = ecs_ehs_ops_new();
    let i: i64 = 0;
    let n = len(left.items) as i64;
    while i < n {
        if ecs_ehs_ops_contains(right, left.items[i]) { out = ecs_ehs_ops_insert(out, left.items[i]); };
        i = i + 1;
    }
    return out;
}

fn ecs_ehs_ops_difference(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    let out = ecs_ehs_ops_new();
    let i: i64 = 0;
    let n = len(left.items) as i64;
    while i < n {
        if ecs_ehs_ops_contains(right, left.items[i]) != true { out = ecs_ehs_ops_insert(out, left.items[i]); };
        i = i + 1;
    }
    return out;
}

fn ecs_ehs_ops_symmetric_difference(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    let left_only = ecs_ehs_ops_difference(left, right);
    let right_only = ecs_ehs_ops_difference(right, left);
    return ecs_ehs_ops_union(left_only, right_only);
}

fn ecs_ehs_ops_bitand_assign(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    return ecs_ehs_ops_intersection(left, right);
}

fn ecs_ehs_ops_bitor_assign(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    return ecs_ehs_ops_union(left, right);
}

fn ecs_ehs_ops_bitxor_assign(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    return ecs_ehs_ops_symmetric_difference(left, right);
}

fn ecs_ehs_ops_sub_assign(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> EcsEntityHashSetOps {
    return ecs_ehs_ops_difference(left, right);
}

fn ecs_ehs_ops_is_disjoint(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> bool {
    return ecs_ehs_ops_len(ecs_ehs_ops_intersection(left, right)) == 0;
}

fn ecs_ehs_ops_is_subset(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> bool {
    let i: i64 = 0;
    let n = len(left.items) as i64;
    while i < n {
        if ecs_ehs_ops_contains(right, left.items[i]) != true { return false; };
        i = i + 1;
    }
    return true;
}

fn ecs_ehs_ops_is_superset(left: EcsEntityHashSetOps, right: EcsEntityHashSetOps) -> bool {
    return ecs_ehs_ops_is_subset(right, left);
}

fn ecs_ehs_ops_iter_count(set: EcsEntityHashSetOps) -> i64 { return len(set.items) as i64; }

fn ecs_ehs_ops_into_iter_sum(set: EcsEntityHashSetOps) -> i64 {
    let sum: i64 = 0;
    let i: i64 = 0;
    let n = len(set.items) as i64;
    while i < n {
        sum = sum + set.items[i];
        i = i + 1;
    }
    return sum;
}

fn ecs_ehs_ops_drain(set: EcsEntityHashSetOps) -> EcsEntityHashSetDrainResult {
    let drained = set.items;
    let empty_items: Vec<i64> = Vec::new();
    let empty = EcsEntityHashSetOps { items: empty_items };
    return EcsEntityHashSetDrainResult { set: empty, drained: drained };
}

fn ecs_ehs_ops_extract_if(set: EcsEntityHashSetOps, predicate_kind: i32, threshold: i64) -> EcsEntityHashSetExtractResult {
    let kept: Vec<i64> = Vec::new();
    let extracted: Vec<i64> = Vec::new();
    let i: i64 = 0;
    let n = len(set.items) as i64;
    while i < n {
        let entity = set.items[i];
        let remove = false;
        if predicate_kind == 0 { if (entity % 2) == 0 { remove = true; }; };
        if predicate_kind == 1 { if entity > threshold { remove = true; }; };
        if remove { extracted.push(entity); };
        if remove != true { kept.push(entity); };
        i = i + 1;
    }
    let out = EcsEntityHashSetOps { items: kept };
    return EcsEntityHashSetExtractResult { set: out, extracted: extracted };
}

fn ecs_ehs_vec_len(values: Vec<i64>) -> i64 { return len(values) as i64; }

fn ecs_ehs_vec_at(values: Vec<i64>, index: i64) -> i64 {
    if index < 0 { return -1; };
    if index >= len(values) as i64 { return -1; };
    return values[index];
}

