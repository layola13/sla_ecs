// Bevy ECS ObserverDescriptor extras: with_event_keys + event_keys/components/entities accessors +
// Observer run state surface (last_trigger_id, despawned_watched_entities). Mirrors src/observer/distributed_storage.rs.

// === ObserverDescriptor v2 with ticks-less event_keys/components/entities Vecs ===
struct EcsObserverDescriptorV2 {
    event_keys: Vec<i32>,
    components: Vec<i32>,
    entities: Vec<i64>,
}

fn ecs_observer_descriptor_v2_new() -> EcsObserverDescriptorV2 {
    let d = EcsObserverDescriptorV2 { event_keys: Vec::new(), components: Vec::new(), entities: Vec::new() };
    return d;
}

fn ecs_observer_descriptor_v2_with_event_key(d: EcsObserverDescriptorV2, event_key: i32) -> EcsObserverDescriptorV2 {
    d.event_keys.push(event_key);
    return d;
}

fn ecs_observer_descriptor_v2_with_component(d: EcsObserverDescriptorV2, component_id: i32) -> EcsObserverDescriptorV2 {
    d.components.push(component_id);
    return d;
}

fn ecs_observer_descriptor_v2_with_entity(d: EcsObserverDescriptorV2, entity: i64) -> EcsObserverDescriptorV2 {
    d.entities.push(entity);
    return d;
}

fn ecs_observer_descriptor_v2_event_key_count(d: EcsObserverDescriptorV2) -> i32 {
    return len(d.event_keys) as i32;
}

fn ecs_observer_descriptor_v2_event_key_at(d: EcsObserverDescriptorV2, idx: i32) -> (bool, i32) {
    let n: i32 = len(d.event_keys) as i32;
    if idx < 0 || idx >= n {
        return (false, 0);
    };
    return (true, d.event_keys[idx]);
}

fn ecs_observer_descriptor_v2_component_count(d: EcsObserverDescriptorV2) -> i32 {
    return len(d.components) as i32;
}

fn ecs_observer_descriptor_v2_component_at(d: EcsObserverDescriptorV2, idx: i32) -> (bool, i32) {
    let n: i32 = len(d.components) as i32;
    if idx < 0 || idx >= n {
        return (false, 0);
    };
    return (true, d.components[idx]);
}

fn ecs_observer_descriptor_v2_entity_count(d: EcsObserverDescriptorV2) -> i32 {
    return len(d.entities) as i32;
}

fn ecs_observer_descriptor_v2_entity_at(d: EcsObserverDescriptorV2, idx: i32) -> (bool, i64) {
    let n: i32 = len(d.entities) as i32;
    if idx < 0 || idx >= n {
        return (false, 0);
    };
    return (true, d.entities[idx]);
}

// === Observer run state ===
struct EcsObserverRunState {
    last_trigger_id: i32,
    despawned_watched_entities: i32,
}

fn ecs_observer_run_state_new() -> EcsObserverRunState {
    let r = EcsObserverRunState { last_trigger_id: 0, despawned_watched_entities: 0 };
    return r;
}

fn ecs_observer_run_state_last_trigger_id(r: EcsObserverRunState) -> i32 {
    return r.last_trigger_id;
}

fn ecs_observer_run_state_despawned_watched_entities(r: EcsObserverRunState) -> i32 {
    return r.despawned_watched_entities;
}

fn ecs_observer_run_state_run(r: EcsObserverRunState) -> EcsObserverRunState {
    r.last_trigger_id = r.last_trigger_id + 1;
    return r;
}

fn ecs_observer_run_state_record_despawned(r: EcsObserverRunState) -> EcsObserverRunState {
    r.despawned_watched_entities = r.despawned_watched_entities + 1;
    return r;
}

fn ecs_observer_run_state_reset(r: EcsObserverRunState) -> EcsObserverRunState {
    r.last_trigger_id = 0;
    r.despawned_watched_entities = 0;
    return r;
}

// === Combined Observer (descriptor + run state) ===
struct EcsObserverV2 {
    descriptor: EcsObserverDescriptorV2,
    run_state: EcsObserverRunState,
    error_handler_id: i32,
    name_id: i64,
}

fn ecs_observer_v2_new() -> EcsObserverV2 {
    let d = EcsObserverDescriptorV2 { event_keys: Vec::new(), components: Vec::new(), entities: Vec::new() };
    let rs = ecs_observer_run_state_new();
    let o = EcsObserverV2 { descriptor: d, run_state: rs, error_handler_id: 0, name_id: 0 };
    return o;
}

fn ecs_observer_v2_with_event_key(o: EcsObserverV2, event_key: i32) -> EcsObserverV2 {
    o.descriptor = ecs_observer_descriptor_v2_with_event_key(o.descriptor, event_key);
    return o;
}

fn ecs_observer_v2_with_component(o: EcsObserverV2, component_id: i32) -> EcsObserverV2 {
    o.descriptor = ecs_observer_descriptor_v2_with_component(o.descriptor, component_id);
    return o;
}

fn ecs_observer_v2_with_entity(o: EcsObserverV2, entity: i64) -> EcsObserverV2 {
    o.descriptor = ecs_observer_descriptor_v2_with_entity(o.descriptor, entity);
    return o;
}

fn ecs_observer_v2_with_error_handler(o: EcsObserverV2, error_handler_id: i32) -> EcsObserverV2 {
    o.error_handler_id = error_handler_id;
    return o;
}

fn ecs_observer_v2_with_name(o: EcsObserverV2, name_id: i64) -> EcsObserverV2 {
    o.name_id = name_id;
    return o;
}

fn ecs_observer_v2_run(o: EcsObserverV2) -> EcsObserverV2 {
    o.run_state = ecs_observer_run_state_run(o.run_state);
    return o;
}

fn ecs_observer_v2_error_handler_id(o: EcsObserverV2) -> i32 {
    return o.error_handler_id;
}

fn ecs_observer_v2_name_id(o: EcsObserverV2) -> i64 {
    return o.name_id;
}

fn ecs_observer_v2_last_trigger_id(o: EcsObserverV2) -> i32 {
    return ecs_observer_run_state_last_trigger_id(o.run_state);
}

fn ecs_observer_v2_despawned_watched_entities(o: EcsObserverV2) -> i32 {
    return ecs_observer_run_state_despawned_watched_entities(o.run_state);
}

fn ecs_observer_v2_describe_counts(o: EcsObserverV2) -> (i32, i32, i32) {
    // (event_key_count, component_count, entity_count) - primitives-only covered_summary
    let ekc = ecs_observer_descriptor_v2_event_key_count(o.descriptor);
    let cc = ecs_observer_descriptor_v2_component_count(o.descriptor);
    let ec = ecs_observer_descriptor_v2_entity_count(o.descriptor);
    return (ekc, cc, ec);
}
