// Deep self-contained Bevy ECS reflect::misc module.
// Mirrors lib/reflect_misc.sla (100 lines, no @import) with fixed-cap (cap-16) scalar slot
// families instead of Vec<i32>. All structs carry @derive(copy). Booleans stored as i32 (0/1).
// No tuple-returning fns; no nested @derive(copy) struct fields.

const ECS_REFLECT_MISC_DEEP_CAP: i32 = 16;

// === ReflectEvent ===
@derive(copy)
struct EcsReflectEventDeep {
    event_id: i32,
    trigger_count: i64,
}

fn ecs_reflect_event_deep_new(event_id: i32) -> EcsReflectEventDeep {
    return EcsReflectEventDeep { event_id: event_id, trigger_count: 0 };
}

fn ecs_reflect_event_deep_id(e: EcsReflectEventDeep) -> i32 { return e.event_id; }

fn ecs_reflect_event_deep_trigger(e: EcsReflectEventDeep) -> EcsReflectEventDeep {
    e.trigger_count = e.trigger_count + 1;
    return e;
}

fn ecs_reflect_event_deep_trigger_count(e: EcsReflectEventDeep) -> i64 { return e.trigger_count; }

// === ReflectMessage ===
@derive(copy)
struct EcsReflectMessageDeep {
    message_id: i32,
    sent_count: i64,
}

fn ecs_reflect_message_deep_new(message_id: i32) -> EcsReflectMessageDeep {
    return EcsReflectMessageDeep { message_id: message_id, sent_count: 0 };
}

fn ecs_reflect_message_deep_id(m: EcsReflectMessageDeep) -> i32 { return m.message_id; }

fn ecs_reflect_message_deep_send(m: EcsReflectMessageDeep) -> EcsReflectMessageDeep {
    m.sent_count = m.sent_count + 1;
    return m;
}

fn ecs_reflect_message_deep_sent_count(m: EcsReflectMessageDeep) -> i64 { return m.sent_count; }

// === FromWorld ===
@derive(copy)
struct EcsFromWorldDeep {
    world_id: i64,
    value: i64,
}

fn ecs_from_world_deep_new(world_id: i64) -> EcsFromWorldDeep {
    return EcsFromWorldDeep { world_id: world_id, value: 0 };
}

fn ecs_from_world_deep_from_world(world_id: i64, default_value: i64) -> EcsFromWorldDeep {
    return EcsFromWorldDeep { world_id: world_id, value: default_value };
}

fn ecs_from_world_deep_value(f: EcsFromWorldDeep) -> i64 { return f.value; }
fn ecs_from_world_deep_world_id(f: EcsFromWorldDeep) -> i64 { return f.world_id; }

// === ReflectMapEntities ===
@derive(copy)
struct EcsReflectMapEntitiesDeep {
    remap_count: i64,
}

fn ecs_reflect_map_entities_deep_new() -> EcsReflectMapEntitiesDeep {
    return EcsReflectMapEntitiesDeep { remap_count: 0 };
}

fn ecs_reflect_map_entities_deep_remap(m: EcsReflectMapEntitiesDeep, count: i64) -> EcsReflectMapEntitiesDeep {
    m.remap_count = m.remap_count + count;
    return m;
}

fn ecs_reflect_map_entities_deep_count(m: EcsReflectMapEntitiesDeep) -> i64 { return m.remap_count; }

// === ReflectEntityCommands: cap-16 commands slot family ===
@derive(copy)
struct EcsReflectEntityCommandsDeep {
    cmd0: i32, cmd1: i32, cmd2: i32, cmd3: i32, cmd4: i32, cmd5: i32, cmd6: i32, cmd7: i32,
    cmd8: i32, cmd9: i32, cmd10: i32, cmd11: i32, cmd12: i32, cmd13: i32, cmd14: i32, cmd15: i32,
    command_count: i32,
}

fn ecs_reflect_entity_commands_deep_new() -> EcsReflectEntityCommandsDeep {
    return EcsReflectEntityCommandsDeep {
        cmd0: 0, cmd1: 0, cmd2: 0, cmd3: 0, cmd4: 0, cmd5: 0, cmd6: 0, cmd7: 0,
        cmd8: 0, cmd9: 0, cmd10: 0, cmd11: 0, cmd12: 0, cmd13: 0, cmd14: 0, cmd15: 0,
        command_count: 0,
    };
}

fn _erecmd_at(c: EcsReflectEntityCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.cmd0; };
    if idx == 1 { return c.cmd1; };
    if idx == 2 { return c.cmd2; };
    if idx == 3 { return c.cmd3; };
    if idx == 4 { return c.cmd4; };
    if idx == 5 { return c.cmd5; };
    if idx == 6 { return c.cmd6; };
    if idx == 7 { return c.cmd7; };
    if idx == 8 { return c.cmd8; };
    if idx == 9 { return c.cmd9; };
    if idx == 10 { return c.cmd10; };
    if idx == 11 { return c.cmd11; };
    if idx == 12 { return c.cmd12; };
    if idx == 13 { return c.cmd13; };
    if idx == 14 { return c.cmd14; };
    if idx == 15 { return c.cmd15; };
    panic(146950);
}

fn _erecmd_set(c: EcsReflectEntityCommandsDeep, idx: i32, v: i32) -> EcsReflectEntityCommandsDeep {
    if idx == 0 { c.cmd0 = v; return c; };
    if idx == 1 { c.cmd1 = v; return c; };
    if idx == 2 { c.cmd2 = v; return c; };
    if idx == 3 { c.cmd3 = v; return c; };
    if idx == 4 { c.cmd4 = v; return c; };
    if idx == 5 { c.cmd5 = v; return c; };
    if idx == 6 { c.cmd6 = v; return c; };
    if idx == 7 { c.cmd7 = v; return c; };
    if idx == 8 { c.cmd8 = v; return c; };
    if idx == 9 { c.cmd9 = v; return c; };
    if idx == 10 { c.cmd10 = v; return c; };
    if idx == 11 { c.cmd11 = v; return c; };
    if idx == 12 { c.cmd12 = v; return c; };
    if idx == 13 { c.cmd13 = v; return c; };
    if idx == 14 { c.cmd14 = v; return c; };
    if idx == 15 { c.cmd15 = v; return c; };
    panic(146951);
}

fn ecs_reflect_entity_commands_deep_push(c: EcsReflectEntityCommandsDeep, kind: i32) -> EcsReflectEntityCommandsDeep {
    if c.command_count < ECS_REFLECT_MISC_DEEP_CAP {
        c = _erecmd_set(c, c.command_count, kind);
        c.command_count = c.command_count + 1;
    };
    return c;
}

fn ecs_reflect_entity_commands_deep_count(c: EcsReflectEntityCommandsDeep) -> i64 { return c.command_count as i64; }

fn ecs_reflect_entity_commands_deep_at(c: EcsReflectEntityCommandsDeep, idx: i64) -> i32 {
    return _erecmd_at(c, idx as i32);
}
