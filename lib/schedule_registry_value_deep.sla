// Deepened Bevy ECS registry-value schedule (shallow lib/schedule_registry_value.sla deep).
// Records cap-8 systems. Each system's access mask stores up to cap-4 read component-ids and
// cap-4 write component-ids plus resource/messages flags. Conflict detection compares
// write-component sets against read/write sets of the other system, then resource/messages
// write/read/write hazard matrix — keyed by registry component id so conflict tracking no
// longer depends on the old A/B component shape.
// Intentional leave-outs: no system fn-ptr execution (harness analogue); no generic types.

const ECS_REG_VALUE_CAP_DEEP: i32 = 8;
const ECS_REG_VALUE_LIST_CAP_DEEP: i32 = 4;

struct EcsRegValueSystemAccessDeep {
    r0: i32, r1: i32, r2: i32, r3: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    reads_resource: i32,
    writes_resource: i32,
    reads_messages: i32,
    writes_messages: i32,
    len_reads: i32,
    len_writes: i32,
}

fn ecs_reg_value_access_none() -> EcsRegValueSystemAccessDeep {
    return EcsRegValueSystemAccessDeep {
        r0: 0, r1: 0, r2: 0, r3: 0,
        w0: 0, w1: 0, w2: 0, w3: 0,
        reads_resource: 0, writes_resource: 0,
        reads_messages: 0, writes_messages: 0,
        len_reads: 0, len_writes: 0,
    };
}

fn ecs_reg_value_access_build(
    r0: i32, r1: i32, r2: i32, r3: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    reads_resource: i32, writes_resource: i32,
    reads_messages: i32, writes_messages: i32,
    len_reads: i32, len_writes: i32
) -> EcsRegValueSystemAccessDeep {
    return EcsRegValueSystemAccessDeep {
        r0: r0, r1: r1, r2: r2, r3: r3,
        w0: w0, w1: w1, w2: w2, w3: w3,
        reads_resource: reads_resource, writes_resource: writes_resource,
        reads_messages: reads_messages, writes_messages: writes_messages,
        len_reads: len_reads, len_writes: len_writes,
    };
}

// append a read component_id into the reads list.
fn ecs_reg_value_access_read_component(a: EcsRegValueSystemAccessDeep, cid: i32) -> EcsRegValueSystemAccessDeep {
    if a.len_reads >= ECS_REG_VALUE_LIST_CAP_DEEP { return a; };
    let idx = a.len_reads;
    if idx == 0 { a.r0 = cid; };
    if idx == 1 { a.r1 = cid; };
    if idx == 2 { a.r2 = cid; };
    if idx == 3 { a.r3 = cid; };
    a.len_reads = a.len_reads + 1;
    return a;
}

fn ecs_reg_value_access_write_component(a: EcsRegValueSystemAccessDeep, cid: i32) -> EcsRegValueSystemAccessDeep {
    if a.len_writes >= ECS_REG_VALUE_LIST_CAP_DEEP { return a; };
    let idx = a.len_writes;
    if idx == 0 { a.w0 = cid; };
    if idx == 1 { a.w1 = cid; };
    if idx == 2 { a.w2 = cid; };
    if idx == 3 { a.w3 = cid; };
    a.len_writes = a.len_writes + 1;
    return a;
}

fn ecs_reg_value_access_read_resource(a: EcsRegValueSystemAccessDeep) -> EcsRegValueSystemAccessDeep {
    a.reads_resource = 1;
    return a;
}

fn ecs_reg_value_access_write_resource(a: EcsRegValueSystemAccessDeep) -> EcsRegValueSystemAccessDeep {
    a.writes_resource = 1;
    return a;
}

fn ecs_reg_value_access_read_messages(a: EcsRegValueSystemAccessDeep) -> EcsRegValueSystemAccessDeep {
    a.reads_messages = 1;
    return a;
}

fn ecs_reg_value_access_write_messages(a: EcsRegValueSystemAccessDeep) -> EcsRegValueSystemAccessDeep {
    a.writes_messages = 1;
    return a;
}

fn ecs_reg_value_read_at(a: EcsRegValueSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.r0; };
    if idx == 1 { return a.r1; };
    if idx == 2 { return a.r2; };
    if idx == 3 { return a.r3; };
    return 0;
}

fn ecs_reg_value_write_at(a: EcsRegValueSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.w0; };
    if idx == 1 { return a.w1; };
    if idx == 2 { return a.w2; };
    if idx == 3 { return a.w3; };
    return 0;
}

fn ecs_reg_value_len_reads(a: EcsRegValueSystemAccessDeep) -> i32 { return a.len_reads; }
fn ecs_reg_value_len_writes(a: EcsRegValueSystemAccessDeep) -> i32 { return a.len_writes; }
fn ecs_reg_value_reads_resource(a: EcsRegValueSystemAccessDeep) -> i32 { return a.reads_resource; }
fn ecs_reg_value_writes_resource(a: EcsRegValueSystemAccessDeep) -> i32 { return a.writes_resource; }
fn ecs_reg_value_reads_messages(a: EcsRegValueSystemAccessDeep) -> i32 { return a.reads_messages; }
fn ecs_reg_value_writes_messages(a: EcsRegValueSystemAccessDeep) -> i32 { return a.writes_messages; }

fn ecs_reg_value_read_list_has(a: EcsRegValueSystemAccessDeep, cid: i32) -> bool {
    let i: i32 = 0;
    while i < a.len_reads {
        if ecs_reg_value_read_at(a, i) == cid { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_reg_value_write_list_has(a: EcsRegValueSystemAccessDeep, cid: i32) -> bool {
    let i: i32 = 0;
    while i < a.len_writes {
        if ecs_reg_value_write_at(a, i) == cid { return true; };
        i = i + 1;
    }
    return false;
}

// Component-conflicts: any write on one system overlaps read OR write on the other.
// Single condense: collect each side's writes, then test read-list-then-write-list membership
// in the opposite-side readers and writers.
fn ecs_reg_value_component_conflicts(left: EcsRegValueSystemAccessDeep, right: EcsRegValueSystemAccessDeep) -> bool {
    let i: i32 = 0;
    while i < left.len_writes {
        let cid = ecs_reg_value_write_at(left, i);
        if ecs_reg_value_read_list_has(right, cid) { return true; };
        if ecs_reg_value_write_list_has(right, cid) { return true; };
        i = i + 1;
    }
    let j: i32 = 0;
    while j < right.len_writes {
        let cid = ecs_reg_value_write_at(right, j);
        if ecs_reg_value_read_list_has(left, cid) { return true; };
        if ecs_reg_value_write_list_has(left, cid) { return true; };
        j = j + 1;
    }
    return false;
}

// Resource/message hazards: a writer on one side conflicts with a reader OR writer on the other,
// and symmetrically. Written as a small per-arena helper to avoid duplicating the matrix body
// verbatim across the two arenas.
fn ecs_reg_value_arena_conflicts(l_read: i32, l_write: i32, r_read: i32, r_write: i32) -> bool {
    if l_write != 0 {
        if r_read != 0 { return true; };
        if r_write != 0 { return true; };
    };
    if r_write != 0 {
        if l_read != 0 { return true; };
    };
    return false;
}

fn ecs_reg_value_access_conflicts(left: EcsRegValueSystemAccessDeep, right: EcsRegValueSystemAccessDeep) -> bool {
    if ecs_reg_value_component_conflicts(left, right) { return true; };
    if ecs_reg_value_arena_conflicts(left.reads_resource, left.writes_resource, right.reads_resource, right.writes_resource) { return true; };
    if ecs_reg_value_arena_conflicts(left.reads_messages, left.writes_messages, right.reads_messages, right.writes_messages) { return true; };
    return false;
}

// === Schedule with 8 slots ===

struct EcsRegValueScheduleDeep {
    s0: EcsRegValueSystemAccessDeep, s1: EcsRegValueSystemAccessDeep,
    s2: EcsRegValueSystemAccessDeep, s3: EcsRegValueSystemAccessDeep,
    s4: EcsRegValueSystemAccessDeep, s5: EcsRegValueSystemAccessDeep,
    s6: EcsRegValueSystemAccessDeep, s7: EcsRegValueSystemAccessDeep,
    count: i32,
    conflict_count: i32,
}

fn ecs_reg_value_schedule_default() -> EcsRegValueScheduleDeep {
    let s = EcsRegValueScheduleDeep {
        s0: ecs_reg_value_access_none(),
        s1: ecs_reg_value_access_none(),
        s2: ecs_reg_value_access_none(),
        s3: ecs_reg_value_access_none(),
        s4: ecs_reg_value_access_none(),
        s5: ecs_reg_value_access_none(),
        s6: ecs_reg_value_access_none(),
        s7: ecs_reg_value_access_none(),
        count: 0,
        conflict_count: 0,
    };
    return s;
}

fn ecs_reg_value_schedule_len(s: EcsRegValueScheduleDeep) -> i32 { return s.count; }
fn ecs_reg_value_schedule_conflict_count(s: EcsRegValueScheduleDeep) -> i32 { return s.conflict_count; }

// Per-slot access store uses scalar capture (UseAfterMove safety).
fn ecs_reg_value_access_set_a(s: EcsRegValueScheduleDeep, idx: i32, a: EcsRegValueSystemAccessDeep) -> EcsRegValueScheduleDeep {
    let r0 = ecs_reg_value_read_at(a, 0);
    let r1 = ecs_reg_value_read_at(a, 1);
    let r2 = ecs_reg_value_read_at(a, 2);
    let r3 = ecs_reg_value_read_at(a, 3);
    let w0 = ecs_reg_value_write_at(a, 0);
    let w1 = ecs_reg_value_write_at(a, 1);
    let w2 = ecs_reg_value_write_at(a, 2);
    let w3 = ecs_reg_value_write_at(a, 3);
    let rr = a.reads_resource;
    let wr = a.writes_resource;
    let rm = a.reads_messages;
    let wm = a.writes_messages;
    let lr = a.len_reads;
    let lw = a.len_writes;
    if idx == 0 { s.s0 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 1 { s.s1 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 2 { s.s2 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 3 { s.s3 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 4 { s.s4 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 5 { s.s5 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 6 { s.s6 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    if idx == 7 { s.s7 = ecs_reg_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, rr, wr, rm, wm, lr, lw); };
    return s;
}

fn ecs_reg_value_access_at(s: EcsRegValueScheduleDeep, idx: i32) -> EcsRegValueSystemAccessDeep {
    if idx == 0 { return s.s0; };
    if idx == 1 { return s.s1; };
    if idx == 2 { return s.s2; };
    if idx == 3 { return s.s3; };
    if idx == 4 { return s.s4; };
    if idx == 5 { return s.s5; };
    if idx == 6 { return s.s6; };
    if idx == 7 { return s.s7; };
    return ecs_reg_value_access_none();
}

fn ecs_reg_value_schedule_add_systems(s: EcsRegValueScheduleDeep, access: EcsRegValueSystemAccessDeep) -> EcsRegValueScheduleDeep {
    if s.count >= ECS_REG_VALUE_CAP_DEEP { return s; };
    // Tally conflicts against all current systems (bidirectional scan).
    let i: i32 = 0;
    while i < s.count {
        let other = ecs_reg_value_access_at(s, i);
        if ecs_reg_value_access_conflicts(access, other) { s.conflict_count = s.conflict_count + 1; };
        i = i + 1;
    }
    let slot = s.count;
    s = ecs_reg_value_access_set_a(s, slot, access);
    s.count = s.count + 1;
    return s;
}

fn ecs_reg_value_schedule_clear(s: EcsRegValueScheduleDeep) -> EcsRegValueScheduleDeep {
    return ecs_reg_value_schedule_default();
}
