// Deepened Bevy ECS System trait extras.
// Mirrors src/system/system.rs residual System surface.
// Fixed default set slots: 4. Shallow lib/system_trait_extras.sla retained.

const ECS_STE_NON_SEND: i32 = 8;
const ECS_STE_HAS_DEFERRED: i32 = 4;

struct EcsSteDeep {
    type_id: i64,
    flags_bits: i32,
    last_run: i64,
    run_count: i64,
    deferred_count: i32,
    s0: i64, s1: i64, s2: i64, s3: i64,
    slen: i32,
}

fn ecs_ste_deep_new(type_id: i64) -> EcsSteDeep {
    return EcsSteDeep {
        type_id: type_id, flags_bits: 0, last_run: 0, run_count: 0, deferred_count: 0,
        s0: 0, s1: 0, s2: 0, s3: 0, slen: 0,
    };
}

fn ecs_ste_deep_type_id(s: EcsSteDeep) -> i64 { return s.type_id; }
fn ecs_ste_deep_last_run(s: EcsSteDeep) -> i64 { return s.last_run; }
fn ecs_ste_deep_run_count(s: EcsSteDeep) -> i64 { return s.run_count; }
fn ecs_ste_deep_deferred_count(s: EcsSteDeep) -> i32 { return s.deferred_count; }
fn ecs_ste_deep_flags(s: EcsSteDeep) -> i32 { return s.flags_bits; }

fn ecs_ste_deep_rebuild(
    type_id: i64, flags_bits: i32, last_run: i64, run_count: i64, deferred_count: i32,
    s0: i64, s1: i64, s2: i64, s3: i64, slen: i32
) -> EcsSteDeep {
    return EcsSteDeep {
        type_id: type_id, flags_bits: flags_bits, last_run: last_run, run_count: run_count,
        deferred_count: deferred_count, s0: s0, s1: s1, s2: s2, s3: s3, slen: slen,
    };
}

fn ecs_ste_deep_is_send(s: EcsSteDeep) -> bool {
    return (s.flags_bits & ECS_STE_NON_SEND) == 0;
}

fn ecs_ste_deep_set_non_send(s: EcsSteDeep) -> EcsSteDeep {
    return ecs_ste_deep_rebuild(s.type_id, s.flags_bits | ECS_STE_NON_SEND, s.last_run, s.run_count, s.deferred_count, s.s0, s.s1, s.s2, s.s3, s.slen);
}

fn ecs_ste_deep_refresh_hotpatch(s: EcsSteDeep) -> EcsSteDeep {
    return s;
}

fn ecs_ste_deep_queue_deferred(s: EcsSteDeep, cmds: i32) -> EcsSteDeep {
    return ecs_ste_deep_rebuild(s.type_id, s.flags_bits | ECS_STE_HAS_DEFERRED, s.last_run, s.run_count, s.deferred_count + cmds, s.s0, s.s1, s.s2, s.s3, s.slen);
}

fn ecs_ste_deep_check_change_tick(s: EcsSteDeep, tick: i64) -> EcsSteDeep {
    return ecs_ste_deep_rebuild(s.type_id, s.flags_bits, tick, s.run_count, s.deferred_count, s.s0, s.s1, s.s2, s.s3, s.slen);
}

fn ecs_ste_deep_set_last_run(s: EcsSteDeep, last_run: i64) -> EcsSteDeep {
    return ecs_ste_deep_rebuild(s.type_id, s.flags_bits, last_run, s.run_count, s.deferred_count, s.s0, s.s1, s.s2, s.s3, s.slen);
}

fn ecs_ste_deep_add_default_set(s: EcsSteDeep, set_id: i64) -> EcsSteDeep {
    if s.slen == 0 { return ecs_ste_deep_rebuild(s.type_id, s.flags_bits, s.last_run, s.run_count, s.deferred_count, set_id, s.s1, s.s2, s.s3, 1); };
    if s.slen == 1 { return ecs_ste_deep_rebuild(s.type_id, s.flags_bits, s.last_run, s.run_count, s.deferred_count, s.s0, set_id, s.s2, s.s3, 2); };
    if s.slen == 2 { return ecs_ste_deep_rebuild(s.type_id, s.flags_bits, s.last_run, s.run_count, s.deferred_count, s.s0, s.s1, set_id, s.s3, 3); };
    if s.slen == 3 { return ecs_ste_deep_rebuild(s.type_id, s.flags_bits, s.last_run, s.run_count, s.deferred_count, s.s0, s.s1, s.s2, set_id, 4); };
    return s;
}

struct EcsSteSetsDeep {
    count: i32,
    first_id: i64,
}

fn ecs_ste_deep_default_sets(s: EcsSteDeep) -> EcsSteSetsDeep {
    return EcsSteSetsDeep { count: s.slen, first_id: s.s0 };
}

fn ecs_ste_sets_count(r: EcsSteSetsDeep) -> i32 { return r.count; }
fn ecs_ste_sets_first(r: EcsSteSetsDeep) -> i64 { return r.first_id; }

struct EcsSteRunDeep {
    system: EcsSteDeep,
    ran_count: i64,
    queued_deferred: i32,
    last_run: i64,
}

fn ecs_ste_run_system(r: EcsSteRunDeep) -> EcsSteDeep { return r.system; }
fn ecs_ste_run_count(r: EcsSteRunDeep) -> i64 { return r.ran_count; }
fn ecs_ste_run_queued(r: EcsSteRunDeep) -> i32 { return r.queued_deferred; }
fn ecs_ste_run_last(r: EcsSteRunDeep) -> i64 { return r.last_run; }

fn ecs_ste_deep_run_readonly(s: EcsSteDeep, input: i64) -> EcsSteRunDeep {
    let s2 = ecs_ste_deep_rebuild(s.type_id, s.flags_bits, s.last_run, s.run_count + 1, s.deferred_count, s.s0, s.s1, s.s2, s.s3, s.slen);
    return EcsSteRunDeep { system: s2, ran_count: s2.run_count, queued_deferred: 0, last_run: s2.last_run };
}

fn ecs_ste_deep_run_without_applying_deferred(s: EcsSteDeep, input: i64) -> EcsSteRunDeep {
    let s2 = ecs_ste_deep_rebuild(s.type_id, s.flags_bits | ECS_STE_HAS_DEFERRED, s.last_run, s.run_count + 1, s.deferred_count + 1, s.s0, s.s1, s.s2, s.s3, s.slen);
    return EcsSteRunDeep { system: s2, ran_count: s2.run_count, queued_deferred: s2.deferred_count, last_run: s2.last_run };
}

fn ecs_ste_deep_has_deferred(s: EcsSteDeep) -> bool {
    return (s.flags_bits & ECS_STE_HAS_DEFERRED) != 0;
}
