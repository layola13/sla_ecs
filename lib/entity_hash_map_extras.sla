// Bevy ECS EntityHashMap wrapper extras from src/entity/hash_map.rs.
// Covers keys/into_keys iterator wrappers, Extend/FromIterator construction,
// into_inner/from_hash_map shape, and EntityEquivalent indexing semantics.

struct EcsEntityHashMapPair {
    key: i64,
    value: i32,
}

struct EcsEntityHashMapExtras {
    entries: Vec<EcsEntityHashMapPair>,
}

struct EcsEntityHashMapKeys {
    keys: Vec<i64>,
    cursor: i64,
    trusted_unique: i32,
}

struct EcsEntityHashMapKeyNext {
    iter: EcsEntityHashMapKeys,
    has: i32,
    key: i64,
}

struct EcsEntityHashMapGetResult {
    has: i32,
    value: i32,
}

fn ecs_ehm_new() -> EcsEntityHashMapExtras {
    return EcsEntityHashMapExtras { entries: Vec::new() };
}

fn ecs_ehm_with_capacity(_capacity: i64) -> EcsEntityHashMapExtras {
    return ecs_ehm_new();
}

fn ecs_ehm_len(map: EcsEntityHashMapExtras) -> i64 { return len(map.entries) as i64; }

fn ecs_ehm_is_empty(map: EcsEntityHashMapExtras) -> bool { return len(map.entries) == 0; }

fn ecs_ehm_insert(map: EcsEntityHashMapExtras, key: i64, value: i32) -> EcsEntityHashMapExtras {
    let i: i64 = 0;
    let n = len(map.entries) as i64;
    while i < n {
        if map.entries[i].key == key {
            map.entries[i].value = value;
            return map;
        };
        i = i + 1;
    }
    map.entries.push(EcsEntityHashMapPair { key: key, value: value });
    return map;
}

fn ecs_ehm_from_pairs(pairs: Vec<EcsEntityHashMapPair>) -> EcsEntityHashMapExtras {
    let map = ecs_ehm_new();
    let i: i64 = 0;
    let n = len(pairs) as i64;
    while i < n {
        map = ecs_ehm_insert(map, pairs[i].key, pairs[i].value);
        i = i + 1;
    }
    return map;
}

fn ecs_ehm_from_hash_map(inner: EcsEntityHashMapExtras) -> EcsEntityHashMapExtras { return inner; }

fn ecs_ehm_into_inner(map: EcsEntityHashMapExtras) -> Vec<EcsEntityHashMapPair> { return map.entries; }

fn ecs_ehm_extend_pairs(map: EcsEntityHashMapExtras, pairs: Vec<EcsEntityHashMapPair>) -> EcsEntityHashMapExtras {
    let i: i64 = 0;
    let n = len(pairs) as i64;
    while i < n {
        map = ecs_ehm_insert(map, pairs[i].key, pairs[i].value);
        i = i + 1;
    }
    return map;
}

fn ecs_ehm_extend_refs(map: EcsEntityHashMapExtras, keys: Vec<i64>, values: Vec<i64>) -> EcsEntityHashMapExtras {
    let i: i64 = 0;
    let key_count = len(keys) as i64;
    let value_count = len(values) as i64;
    while i < key_count {
        if i < value_count {
            let key = keys[i];
            let value = values[i] as i32;
            map = ecs_ehm_insert(map, key, value);
        };
        i = i + 1;
    }
    return map;
}

fn ecs_ehm_get(map: EcsEntityHashMapExtras, key: i64) -> EcsEntityHashMapGetResult {
    let i: i64 = 0;
    let n = len(map.entries) as i64;
    while i < n {
        if map.entries[i].key == key { return EcsEntityHashMapGetResult { has: 1, value: map.entries[i].value }; };
        i = i + 1;
    }
    return EcsEntityHashMapGetResult { has: 0, value: 0 };
}

fn ecs_ehm_index_entity_equivalent(map: EcsEntityHashMapExtras, equivalent_entity: i64) -> i32 {
    let got = ecs_ehm_get(map, equivalent_entity);
    if got.has == 0 { return -1; };
    return got.value;
}

fn ecs_ehm_keys(map: EcsEntityHashMapExtras) -> EcsEntityHashMapKeys {
    let keys: Vec<i64> = Vec::new();
    let i: i64 = 0;
    let n = len(map.entries) as i64;
    while i < n {
        keys.push(map.entries[i].key);
        i = i + 1;
    }
    return EcsEntityHashMapKeys { keys: keys, cursor: 0, trusted_unique: 1 };
}

fn ecs_ehm_into_keys(map: EcsEntityHashMapExtras) -> EcsEntityHashMapKeys {
    return ecs_ehm_keys(map);
}

fn ecs_ehm_keys_default() -> EcsEntityHashMapKeys {
    let keys: Vec<i64> = Vec::new();
    return EcsEntityHashMapKeys { keys: keys, cursor: 0, trusted_unique: 1 };
}

fn ecs_ehm_keys_clone(iter: EcsEntityHashMapKeys) -> EcsEntityHashMapKeys {
    return EcsEntityHashMapKeys { keys: iter.keys, cursor: iter.cursor, trusted_unique: iter.trusted_unique };
}

fn ecs_ehm_keys_remaining(iter: EcsEntityHashMapKeys) -> i64 {
    let remaining = (len(iter.keys) as i64) - iter.cursor;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_ehm_keys_next(iter: EcsEntityHashMapKeys) -> EcsEntityHashMapKeyNext {
    if iter.cursor >= len(iter.keys) as i64 {
        return EcsEntityHashMapKeyNext { iter: iter, has: 0, key: -1 };
    };
    let key = iter.keys[iter.cursor];
    iter.cursor = iter.cursor + 1;
    return EcsEntityHashMapKeyNext { iter: iter, has: 1, key: key };
}

fn ecs_ehm_keys_collect_sum(iter: EcsEntityHashMapKeys) -> i64 {
    let sum: i64 = 0;
    let i = iter.cursor;
    let n = len(iter.keys) as i64;
    while i < n {
        sum = sum + iter.keys[i];
        i = i + 1;
    }
    return sum;
}

fn ecs_ehm_pair(key: i64, value: i32) -> EcsEntityHashMapPair {
    return EcsEntityHashMapPair { key: key, value: value };
}

fn ecs_ehm_pair_vec_len(values: Vec<EcsEntityHashMapPair>) -> i64 { return len(values) as i64; }

fn ecs_ehm_pair_vec_key_at(values: Vec<EcsEntityHashMapPair>, index: i64) -> i64 {
    if index < 0 { return -1; };
    if index >= len(values) as i64 { return -1; };
    return values[index].key;
}
