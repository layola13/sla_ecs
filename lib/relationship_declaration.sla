// Explicit relationship declaration helpers for derive-like relationship pairs.
//
// Bevy relationship derive ties a source relationship component to a target
// collection component. SLA currently has no compiler macro that can synthesize
// that pair, so this module keeps the declaration as library-owned data and
// validates duplicate ids, collisions, and conflicting component pairs.
@import "sa_std/vec.sa"

const ECS_RELATIONSHIP_DECL_TARGET_MANY: i32 = 0;
const ECS_RELATIONSHIP_DECL_TARGET_ONE: i32 = 1;
const ECS_RELATIONSHIP_DECL_OK: i32 = 0;
const ECS_RELATIONSHIP_DECL_ERR_RELATIONSHIP_ID: i32 = 1;
const ECS_RELATIONSHIP_DECL_ERR_SOURCE_ID: i32 = 2;
const ECS_RELATIONSHIP_DECL_ERR_TARGET_ID: i32 = 3;
const ECS_RELATIONSHIP_DECL_ERR_TARGET_MODE: i32 = 4;
const ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT: i32 = 5;
const ECS_RELATIONSHIP_DECL_ERR_ONE_TO_ONE_ORDERED: i32 = 6;

struct EcsRelationshipDeclaration {
    relationship_type_id: i32,
    source_component_type_id: i32,
    target_component_type_id: i32,
    target_mode: i32,
    linked_spawn: bool,
    allow_self: bool,
    ordered: bool,
    valid: bool,
    error_code: i32,
}

struct EcsRelationshipDeclarationRegistry {
    declarations: Vec<EcsRelationshipDeclaration>,
}

struct EcsRelationshipDeclarationRegisterResult {
    registry: EcsRelationshipDeclarationRegistry,
    inserted: bool,
    duplicate: bool,
    id_collision: bool,
    pair_conflict: bool,
    invalid: bool,
    existing_index: i64,
    error_code: i32,
}

fn ecs_relationship_declaration_error(relationship_type_id: i32, source_component_type_id: i32, target_component_type_id: i32, target_mode: i32, linked_spawn: bool, allow_self: bool, ordered: bool, error_code: i32) -> EcsRelationshipDeclaration {
    return EcsRelationshipDeclaration { relationship_type_id: relationship_type_id, source_component_type_id: source_component_type_id, target_component_type_id: target_component_type_id, target_mode: target_mode, linked_spawn: linked_spawn, allow_self: allow_self, ordered: ordered, valid: false, error_code: error_code };
}

fn ecs_relationship_declaration_new(relationship_type_id: i32, source_component_type_id: i32, target_component_type_id: i32, target_mode: i32, linked_spawn: bool, allow_self: bool, ordered: bool) -> EcsRelationshipDeclaration {
    if relationship_type_id <= 0 {
        return ecs_relationship_declaration_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_RELATIONSHIP_ID);
    };
    if source_component_type_id <= 0 {
        return ecs_relationship_declaration_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_SOURCE_ID);
    };
    if target_component_type_id <= 0 {
        return ecs_relationship_declaration_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_TARGET_ID);
    };
    if target_mode != ECS_RELATIONSHIP_DECL_TARGET_MANY {
        if target_mode != ECS_RELATIONSHIP_DECL_TARGET_ONE {
            return ecs_relationship_declaration_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_TARGET_MODE);
        };
    };
    if source_component_type_id == target_component_type_id {
        return ecs_relationship_declaration_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT);
    };
    if target_mode == ECS_RELATIONSHIP_DECL_TARGET_ONE {
        if ordered {
            return ecs_relationship_declaration_error(relationship_type_id, source_component_type_id, target_component_type_id, target_mode, linked_spawn, allow_self, ordered, ECS_RELATIONSHIP_DECL_ERR_ONE_TO_ONE_ORDERED);
        };
    };
    return EcsRelationshipDeclaration { relationship_type_id: relationship_type_id, source_component_type_id: source_component_type_id, target_component_type_id: target_component_type_id, target_mode: target_mode, linked_spawn: linked_spawn, allow_self: allow_self, ordered: ordered, valid: true, error_code: ECS_RELATIONSHIP_DECL_OK };
}

fn ecs_relationship_declaration_many(relationship_type_id: i32, source_component_type_id: i32, target_component_type_id: i32, linked_spawn: bool, allow_self: bool, ordered: bool) -> EcsRelationshipDeclaration {
    return ecs_relationship_declaration_new(relationship_type_id, source_component_type_id, target_component_type_id, ECS_RELATIONSHIP_DECL_TARGET_MANY, linked_spawn, allow_self, ordered);
}

fn ecs_relationship_declaration_one(relationship_type_id: i32, source_component_type_id: i32, target_component_type_id: i32, linked_spawn: bool, allow_self: bool) -> EcsRelationshipDeclaration {
    return ecs_relationship_declaration_new(relationship_type_id, source_component_type_id, target_component_type_id, ECS_RELATIONSHIP_DECL_TARGET_ONE, linked_spawn, allow_self, false);
}

fn ecs_relationship_declaration_same(left: EcsRelationshipDeclaration, right: EcsRelationshipDeclaration) -> bool {
    if left.relationship_type_id != right.relationship_type_id { return false; };
    if left.source_component_type_id != right.source_component_type_id { return false; };
    if left.target_component_type_id != right.target_component_type_id { return false; };
    if left.target_mode != right.target_mode { return false; };
    if left.linked_spawn != right.linked_spawn { return false; };
    if left.allow_self != right.allow_self { return false; };
    if left.ordered != right.ordered { return false; };
    return true;
}

fn ecs_relationship_declaration_same_pair(left: EcsRelationshipDeclaration, right: EcsRelationshipDeclaration) -> bool {
    if left.source_component_type_id != right.source_component_type_id { return false; };
    if left.target_component_type_id != right.target_component_type_id { return false; };
    return true;
}

fn ecs_relationship_declaration_registry_new() -> EcsRelationshipDeclarationRegistry {
    let declarations: Vec<EcsRelationshipDeclaration> = Vec::new();
    return EcsRelationshipDeclarationRegistry { declarations: declarations };
}

fn ecs_relationship_declaration_registry_len(registry: EcsRelationshipDeclarationRegistry) -> i64 {
    return len(registry.declarations) as i64;
}

fn ecs_relationship_declaration_find_type_id(registry: EcsRelationshipDeclarationRegistry, relationship_type_id: i32) -> i64 {
    let i: i64 = 0;
    let n = len(registry.declarations) as i64;
    while i < n {
        if registry.declarations[i].relationship_type_id == relationship_type_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_relationship_declaration_find_pair(registry: EcsRelationshipDeclarationRegistry, declaration: EcsRelationshipDeclaration) -> i64 {
    let i: i64 = 0;
    let n = len(registry.declarations) as i64;
    while i < n {
        if ecs_relationship_declaration_same_pair(registry.declarations[i], declaration) { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_relationship_declaration_register_result(registry: EcsRelationshipDeclarationRegistry, inserted: bool, duplicate: bool, id_collision: bool, pair_conflict: bool, invalid: bool, existing_index: i64, error_code: i32) -> EcsRelationshipDeclarationRegisterResult {
    return EcsRelationshipDeclarationRegisterResult { registry: registry, inserted: inserted, duplicate: duplicate, id_collision: id_collision, pair_conflict: pair_conflict, invalid: invalid, existing_index: existing_index, error_code: error_code };
}

fn ecs_relationship_declaration_registry_register(registry: EcsRelationshipDeclarationRegistry, declaration: EcsRelationshipDeclaration) -> EcsRelationshipDeclarationRegisterResult {
    if declaration.valid != true {
        return ecs_relationship_declaration_register_result(registry, false, false, false, false, true, -1, declaration.error_code);
    };
    let existing_type = ecs_relationship_declaration_find_type_id(registry, declaration.relationship_type_id);
    if existing_type >= 0 {
        if ecs_relationship_declaration_same(registry.declarations[existing_type], declaration) {
            return ecs_relationship_declaration_register_result(registry, false, true, false, false, false, existing_type, ECS_RELATIONSHIP_DECL_OK);
        };
        return ecs_relationship_declaration_register_result(registry, false, false, true, false, false, existing_type, ECS_RELATIONSHIP_DECL_OK);
    };
    let existing_pair = ecs_relationship_declaration_find_pair(registry, declaration);
    if existing_pair >= 0 {
        return ecs_relationship_declaration_register_result(registry, false, false, false, true, false, existing_pair, ECS_RELATIONSHIP_DECL_OK);
    };
    registry.declarations.push(declaration);
    return ecs_relationship_declaration_register_result(registry, true, false, false, false, false, -1, ECS_RELATIONSHIP_DECL_OK);
}

@test "relationship declaration many records target collection shape"() {
    let declaration = ecs_relationship_declaration_many(100, 101, 102, true, false, true);
    if declaration.valid != true { panic(32910); };
    if declaration.target_mode != ECS_RELATIONSHIP_DECL_TARGET_MANY { panic(32911); };
    if declaration.linked_spawn != true { panic(32912); };
    if declaration.allow_self { panic(32913); };
    if declaration.ordered != true { panic(32914); };
}

@test "relationship declaration one rejects ordered target collection"() {
    let declaration = ecs_relationship_declaration_new(200, 201, 202, ECS_RELATIONSHIP_DECL_TARGET_ONE, false, false, true);
    if declaration.valid { panic(32920); };
    if declaration.error_code != ECS_RELATIONSHIP_DECL_ERR_ONE_TO_ONE_ORDERED { panic(32921); };
}

@test "relationship declaration rejects invalid ids and same pair component"() {
    let bad_source = ecs_relationship_declaration_many(1, 0, 3, false, false, false);
    if bad_source.error_code != ECS_RELATIONSHIP_DECL_ERR_SOURCE_ID { panic(32930); };
    let same = ecs_relationship_declaration_many(1, 3, 3, false, false, false);
    if same.error_code != ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT { panic(32931); };
}

@test "relationship declaration registry inserts unique declaration"() {
    let registry = ecs_relationship_declaration_registry_new();
    let declaration = ecs_relationship_declaration_many(10, 11, 12, true, false, true);
    let result = ecs_relationship_declaration_registry_register(registry, declaration);
    if result.inserted != true { panic(32940); };
    if ecs_relationship_declaration_registry_len(result.registry) != 1 { panic(32941); };
}

@test "relationship declaration registry reports duplicate declaration"() {
    let registry = ecs_relationship_declaration_registry_new();
    let declaration = ecs_relationship_declaration_many(20, 21, 22, true, false, true);
    let first = ecs_relationship_declaration_registry_register(registry, declaration);
    let again = ecs_relationship_declaration_many(20, 21, 22, true, false, true);
    let second = ecs_relationship_declaration_registry_register(first.registry, again);
    if second.duplicate != true { panic(32950); };
    if second.inserted { panic(32951); };
    if second.existing_index != 0 { panic(32952); };
}

@test "relationship declaration registry reports id collision"() {
    let registry = ecs_relationship_declaration_registry_new();
    let first = ecs_relationship_declaration_many(30, 31, 32, true, false, true);
    let second = ecs_relationship_declaration_many(30, 33, 34, true, false, true);
    let inserted = ecs_relationship_declaration_registry_register(registry, first);
    let collision = ecs_relationship_declaration_registry_register(inserted.registry, second);
    if collision.id_collision != true { panic(32960); };
    if collision.inserted { panic(32961); };
    if ecs_relationship_declaration_registry_len(collision.registry) != 1 { panic(32962); };
}

@test "relationship declaration registry reports component pair conflict"() {
    let registry = ecs_relationship_declaration_registry_new();
    let first = ecs_relationship_declaration_many(40, 41, 42, true, false, true);
    let second = ecs_relationship_declaration_many(43, 41, 42, true, false, true);
    let inserted = ecs_relationship_declaration_registry_register(registry, first);
    let conflict = ecs_relationship_declaration_registry_register(inserted.registry, second);
    if conflict.pair_conflict != true { panic(32970); };
    if conflict.id_collision { panic(32971); };
    if conflict.existing_index != 0 { panic(32972); };
}

@test "relationship declaration registry rejects invalid declaration"() {
    let registry = ecs_relationship_declaration_registry_new();
    let invalid = ecs_relationship_declaration_many(50, 51, 51, true, false, true);
    let result = ecs_relationship_declaration_registry_register(registry, invalid);
    if result.invalid != true { panic(32980); };
    if result.error_code != ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT { panic(32981); };
    if ecs_relationship_declaration_registry_len(result.registry) != 0 { panic(32982); };
}
