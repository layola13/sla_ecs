// Bevy ECS change detection (src/change_detection/params.rs):
// Res, ResMut, NonSend, NonSendMut, Ref, Mut, MutUntyped
// System parameter wrappers that provide change detection.

// === Ref (immutable reference with change detection) ===
struct EcsRef {
    data: i64,
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_ref_new(data: i64, added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsRef {
    return EcsRef { data: data, added_tick: added_tick, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_ref_data(r: EcsRef) -> i64 { return r.data; }
fn ecs_ref_is_added(r: EcsRef) -> bool { return r.added_tick >= r.last_run; }
fn ecs_ref_is_changed(r: EcsRef) -> bool { return r.changed_tick >= r.last_run; }
fn ecs_ref_ticks_since_startup(r: EcsRef) -> i64 { return r.this_run; }
fn ecs_ref_added_tick(r: EcsRef) -> i64 { return r.added_tick; }
fn ecs_ref_changed_tick(r: EcsRef) -> i64 { return r.changed_tick; }
fn ecs_ref_last_run(r: EcsRef) -> i64 { return r.last_run; }
fn ecs_ref_this_run(r: EcsRef) -> i64 { return r.this_run; }

// === Mut (mutable reference with change detection) ===
struct EcsMut {
    data: i64,
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_mut_new(data: i64, added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsMut {
    return EcsMut { data: data, added_tick: added_tick, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_mut_data(m: EcsMut) -> i64 { return m.data; }
fn ecs_mut_set_data(m: EcsMut, data: i64) -> EcsMut {
    m.data = data;
    m.changed_tick = m.this_run;
    return m;
}
fn ecs_mut_set_changed(m: EcsMut) -> EcsMut {
    m.changed_tick = m.this_run;
    return m;
}
fn ecs_mut_is_added(m: EcsMut) -> bool { return m.added_tick >= m.last_run; }
fn ecs_mut_is_changed(m: EcsMut) -> bool { return m.changed_tick >= m.last_run; }
fn ecs_mut_added_tick(m: EcsMut) -> i64 { return m.added_tick; }
fn ecs_mut_changed_tick(m: EcsMut) -> i64 { return m.changed_tick; }
fn ecs_mut_last_run(m: EcsMut) -> i64 { return m.last_run; }
fn ecs_mut_this_run(m: EcsMut) -> i64 { return m.this_run; }

// reborrow: create a Ref from a Mut (downgrade mutability)
fn ecs_mut_reborrow(m: EcsMut) -> EcsRef {
    return EcsRef { data: m.data, added_tick: m.added_tick, changed_tick: m.changed_tick, last_run: m.last_run, this_run: m.this_run };
}

// map: transform the data while preserving change detection
fn ecs_mut_map(m: EcsMut, new_data: i64) -> EcsMut {
    return EcsMut { data: new_data, added_tick: m.added_tick, changed_tick: m.changed_tick, last_run: m.last_run, this_run: m.this_run };
}

// === MutUntyped (mutable reference without type info) ===
struct EcsMutUntyped {
    data: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_mut_untyped_new(data: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsMutUntyped {
    return EcsMutUntyped { data: data, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_mut_untyped_data(m: EcsMutUntyped) -> i64 { return m.data; }
fn ecs_mut_untyped_set_changed(m: EcsMutUntyped) -> EcsMutUntyped {
    m.changed_tick = m.this_run;
    return m;
}
fn ecs_mut_untyped_is_changed(m: EcsMutUntyped) -> bool { return m.changed_tick >= m.last_run; }
fn ecs_mut_untyped_changed_tick(m: EcsMutUntyped) -> i64 { return m.changed_tick; }

// === Res (immutable resource reference) ===
struct EcsRes {
    data: i64,
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_res_new(data: i64, added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsRes {
    return EcsRes { data: data, added_tick: added_tick, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_res_data(r: EcsRes) -> i64 { return r.data; }
fn ecs_res_is_added(r: EcsRes) -> bool { return r.added_tick >= r.last_run; }
fn ecs_res_is_changed(r: EcsRes) -> bool { return r.changed_tick >= r.last_run; }
fn ecs_res_added_tick(r: EcsRes) -> i64 { return r.added_tick; }
fn ecs_res_changed_tick(r: EcsRes) -> i64 { return r.changed_tick; }

// === ResMut (mutable resource reference) ===
struct EcsResMut {
    data: i64,
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_res_mut_new(data: i64, added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsResMut {
    return EcsResMut { data: data, added_tick: added_tick, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_res_mut_data(r: EcsResMut) -> i64 { return r.data; }
fn ecs_res_mut_set_data(r: EcsResMut, data: i64) -> EcsResMut {
    r.data = data;
    r.changed_tick = r.this_run;
    return r;
}
fn ecs_res_mut_set_changed(r: EcsResMut) -> EcsResMut {
    r.changed_tick = r.this_run;
    return r;
}
fn ecs_res_mut_is_added(r: EcsResMut) -> bool { return r.added_tick >= r.last_run; }
fn ecs_res_mut_is_changed(r: EcsResMut) -> bool { return r.changed_tick >= r.last_run; }
fn ecs_res_mut_changed_tick(r: EcsResMut) -> i64 { return r.changed_tick; }
fn ecs_res_mut_added_tick(r: EcsResMut) -> i64 { return r.added_tick; }

// into_inner: consume and return the data
fn ecs_res_mut_into_inner(r: EcsResMut) -> i64 { return r.data; }
fn ecs_mut_into_inner(m: EcsMut) -> i64 { return m.data; }

// === NonSend (immutable non-Send resource reference) ===
struct EcsNonSendParam {
    data: i64,
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_non_send_param_new(data: i64, added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsNonSendParam {
    return EcsNonSendParam { data: data, added_tick: added_tick, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_non_send_param_data(r: EcsNonSendParam) -> i64 { return r.data; }
fn ecs_non_send_param_is_added(r: EcsNonSendParam) -> bool { return r.added_tick >= r.last_run; }
fn ecs_non_send_param_is_changed(r: EcsNonSendParam) -> bool { return r.changed_tick >= r.last_run; }

// === NonSendMut (mutable non-Send resource reference) ===
struct EcsNonSendMut {
    data: i64,
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
}

fn ecs_non_send_mut_new(data: i64, added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64) -> EcsNonSendMut {
    return EcsNonSendMut { data: data, added_tick: added_tick, changed_tick: changed_tick, last_run: last_run, this_run: this_run };
}

fn ecs_non_send_mut_data(r: EcsNonSendMut) -> i64 { return r.data; }
fn ecs_non_send_mut_set_data(r: EcsNonSendMut, data: i64) -> EcsNonSendMut {
    r.data = data;
    r.changed_tick = r.this_run;
    return r;
}
fn ecs_non_send_mut_set_changed(r: EcsNonSendMut) -> EcsNonSendMut {
    r.changed_tick = r.this_run;
    return r;
}
fn ecs_non_send_mut_is_added(r: EcsNonSendMut) -> bool { return r.added_tick >= r.last_run; }
fn ecs_non_send_mut_is_changed(r: EcsNonSendMut) -> bool { return r.changed_tick >= r.last_run; }
fn ecs_non_send_mut_into_inner(r: EcsNonSendMut) -> i64 { return r.data; }
