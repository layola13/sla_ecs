// add_schedule / try_schedule_scope / schedule_scope / try_run_schedule / run_schedule / get_schedule / contains_schedule / remove_schedule
fn ecs_world_mod_deep_add_schedule(w: EcsWorldDeep, label_id: i32, schedule_id: i64) -> EcsWorldDeep {
    let i: i32 = 0;
    while i < w.sln {
        if _sl_at(w, i) == label_id {
            w = _sl_set(w, i, label_id);
            w = _sid_set(w, i, schedule_id);
            w.last_schedule_found = 0;
            return w;
        };
        i = i + 1;
    }
    if w.sln < ECS_WM_DEEP_CAP {
        w = _sl_set(w, w.sln, label_id);
        w = _sid_set(w, w.sln, schedule_id);
        w.sln = w.sln + 1;
    };
    w.last_schedule_found = 1;
    w.last_schedule_id = schedule_id;
    return w;
}
fn ecs_world_mod_deep_last_add_schedule_found(w: EcsWorldDeep) -> bool { return w.last_schedule_found != 0; }
fn ecs_world_mod_deep_last_schedule_id(w: EcsWorldDeep) -> i64 { return w.last_schedule_id; }

fn ecs_world_mod_deep_get_schedule(w: EcsWorldDeep, label_id: i32) -> EcsWorldDeep {
    let i: i32 = 0;
    while i < w.sln {
        if _sl_at(w, i) == label_id {
            w.last_schedule_found = 1;
            w.last_schedule_id = _sid_at(w, i);
            return w;
        };
        i = i + 1;
    }
    w.last_schedule_found = 0;
    w.last_schedule_id = 0;
    return w;
}
fn ecs_world_mod_deep_last_schedule_found(w: EcsWorldDeep) -> bool { return w.last_schedule_found != 0; }

fn ecs_world_mod_deep_contains_schedule(w: EcsWorldDeep, label_id: i32) -> bool {
    let i: i32 = 0;
    while i < w.sln {
        if _sl_at(w, i) == label_id { return true; };
        i = i + 1;
    }
    return false;
}
fn ecs_world_mod_deep_try_schedule_scope(w: EcsWorldDeep, label_id: i32) -> EcsWorldDeep {
    w = ecs_world_mod_deep_get_schedule(w, label_id);
    return w;
}
fn ecs_world_mod_deep_schedule_scope(w: EcsWorldDeep, label_id: i32) -> EcsWorldDeep {
    w = ecs_world_mod_deep_get_schedule(w, label_id);
    return w;
}
fn ecs_world_mod_deep_try_run_schedule(w: EcsWorldDeep, label_id: i32) -> EcsWorldDeep {
    w = ecs_world_mod_deep_try_schedule_scope(w, label_id);
    w.last_schedule_scope_run_ok = w.last_schedule_found;
    return w;
}
fn ecs_world_mod_deep_last_schedule_scope_run_ok(w: EcsWorldDeep) -> bool { return w.last_schedule_scope_run_ok != 0; }
fn ecs_world_mod_deep_run_schedule(w: EcsWorldDeep, label_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_try_run_schedule(w, label_id);
}
fn ecs_world_mod_deep_remove_schedule(w: EcsWorldDeep, label_id: i32) -> EcsWorldDeep {
    let i: i32 = 0;
    while i < w.sln {
        if _sl_at(w, i) == label_id {
            w = _sl_set(w, i, (0 - 1));
            w = _sid_set(w, i, 0);
            w.last_schedule_found = 1;
            return w;
        };
        i = i + 1;
    }
    w.last_schedule_found = 0;
    return w;
}

