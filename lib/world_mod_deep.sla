    if idx == 0 { w.c0 = v; return w; };
    if idx == 1 { w.c1 = v; return w; };
    if idx == 2 { w.c2 = v; return w; };
    if idx == 3 { w.c3 = v; return w; };
    if idx == 4 { w.c4 = v; return w; };
    if idx == 5 { w.c5 = v; return w; };
    if idx == 6 { w.c6 = v; return w; };
    if idx == 7 { w.c7 = v; return w; };
    if idx == 8 { w.c8 = v; return w; };
    if idx == 9 { w.c9 = v; return w; };
    if idx == 10 { w.c10 = v; return w; };
    if idx == 11 { w.c11 = v; return w; };
    if idx == 12 { w.c12 = v; return w; };
    if idx == 13 { w.c13 = v; return w; };
    if idx == 14 { w.c14 = v; return w; };
