// register_non_send_with_descriptor / init_resource / insert_resource / init_non_send_resource / init_non_send
fn ecs_world_mod_deep_register_non_send_with_descriptor(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    let existing = ecs_world_mod_deep_contains_non_send(w, non_send_id);
    if existing {
        w.last_register_non_send_id = (0 - 1);
        return w;
    };
    let cid = w.nsn;
    w = _ns_push(w, non_send_id);
    w.last_register_non_send_id = cid;
    return w;
}
fn ecs_world_mod_deep_last_register_non_send_id(w: EcsWorldDeep) -> i32 { return w.last_register_non_send_id; }

fn ecs_world_mod_deep_init_resource(w: EcsWorldDeep, resource_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_register_resource(w, resource_id);
}
fn ecs_world_mod_deep_insert_resource(w: EcsWorldDeep, resource_id: i32, value: i64) -> EcsWorldDeep {
    let rid = ecs_world_mod_deep_resource_id(w, resource_id);
    if rid == (0 - 1) {
        w = ecs_world_mod_deep_register_resource(w, resource_id);
        w.last_insert_resource_was_new = 1;
        return w;
    };
    w.last_insert_resource_was_new = 0;
    return w;
}
fn ecs_world_mod_deep_last_insert_resource_was_new(w: EcsWorldDeep) -> bool { return w.last_insert_resource_was_new != 0; }
fn ecs_world_mod_deep_init_non_send_resource(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_register_non_send_with_descriptor(w, non_send_id);
}
fn ecs_world_mod_deep_init_non_send(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_init_non_send_resource(w, non_send_id);
}
fn ecs_world_mod_deep_insert_non_send_resource(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    if ecs_world_mod_deep_contains_non_send(w, non_send_id) {
        w.last_insert_resource_was_new = 0;
        return w;
    };
    w = _ns_push(w, non_send_id);
    w.last_insert_resource_was_new = 1;
    return w;
}
fn ecs_world_mod_deep_insert_non_send(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_insert_non_send_resource(w, non_send_id);
}

// remove_resource / remove_non_send_resource / remove_non_send
fn ecs_world_mod_deep_remove_resource(w: EcsWorldDeep, resource_id: i32) -> EcsWorldDeep {
    let rid = ecs_world_mod_deep_resource_id(w, resource_id);
    if rid == (0 - 1) {
        w.last_remove_resource_found = 0;
        w.last_remove_resource_entity = 0;
        return w;
    };
    w = _r_set(w, rid, (0 - 1));
    w.last_remove_resource_found = 1;
    w.last_remove_resource_entity = 0;
    return w;
}
fn ecs_world_mod_deep_last_remove_resource_found(w: EcsWorldDeep) -> bool { return w.last_remove_resource_found != 0; }
fn ecs_world_mod_deep_last_remove_resource_entity(w: EcsWorldDeep) -> i64 { return w.last_remove_resource_entity; }
fn ecs_world_mod_deep_remove_non_send_resource(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    let i: i32 = 0;
    while i < w.nsn {
        if _ns_at(w, i) == non_send_id {
            w = _ns_set(w, i, (0 - 1));
            w.last_remove_non_send_found = 1;
            return w;
        };
        i = i + 1;
    }
    w.last_remove_non_send_found = 0;
    return w;
}
fn ecs_world_mod_deep_last_remove_non_send_found(w: EcsWorldDeep) -> bool { return w.last_remove_non_send_found != 0; }
fn ecs_world_mod_deep_remove_non_send(w: EcsWorldDeep, non_send_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_remove_non_send_resource(w, non_send_id);
}

