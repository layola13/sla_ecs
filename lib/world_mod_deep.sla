}
fn ecs_world_mod_deep_get_required_components(w: EcsWorldDeep, component_id: i32) -> EcsWorldDeep {
    let cid = ecs_world_mod_deep_component_id(w, component_id);
    if cid == (0 - 1) {
        w.last_bool = 0;
        w.last_i64_value = 0;
    } else {
        w.last_bool = 1;
        w.last_i64_value = 0;
    };
    return w;
}
fn ecs_world_mod_deep_last_get_required_components_found(w: EcsWorldDeep) -> bool { return w.last_bool != 0; }
fn ecs_world_mod_deep_last_get_required_components_count(w: EcsWorldDeep) -> i64 { return w.last_i64_value; }
