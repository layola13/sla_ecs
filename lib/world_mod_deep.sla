    if idx == 14 { w.spawn_batch_s14 = v; return w; };
    if idx == 15 { w.spawn_batch_s15 = v; return w; };
    return w;
}
fn _esbi_world_at_get(w: EcsWorldDeep, idx: i64) -> i64 {
    if idx == 0 { return w.spawn_batch_s0; };
