// spawn_batch inline helpers — pushed onto spawn_batch_s* family directly on EcsWorldDeep.
fn _esbi_world_set(w: EcsWorldDeep, idx: i64, v: i64) -> EcsWorldDeep {
    if idx == 0 { w.spawn_batch_s0 = v; return w; };
    if idx == 1 { w.spawn_batch_s1 = v; return w; };
    if idx == 2 { w.spawn_batch_s2 = v; return w; };
    if idx == 3 { w.spawn_batch_s3 = v; return w; };
