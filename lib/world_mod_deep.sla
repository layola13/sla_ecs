// inspect_entity: returns (found, count)
fn ecs_world_mod_deep_inspect_entity(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    let valid = ecs_world_mod_deep_entity_valid(w, entity);
    if valid {
        w.last_bool = 1;
        w.last_i64_value = w.entity_count;
    } else {
        w.last_bool = 0;
        w.last_i64_value = 0;
    };
    return w;
}
