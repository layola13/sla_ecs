    return w;
}
fn ecs_world_mod_deep_last_clear(w: EcsWorldDeep) -> i64 { return w.last_clear; }

// query / query_filtered / try_query / try_query_filtered — return -1 opaque id.
fn ecs_world_mod_deep_query(w: EcsWorldDeep) -> EcsWorldDeep {
    w.last_query_value = (0 - 1);
    w.last_query_found = 1;
    return w;
}
fn ecs_world_mod_deep_last_query_value(w: EcsWorldDeep) -> i64 { return w.last_query_value; }
fn ecs_world_mod_deep_last_query_found(w: EcsWorldDeep) -> bool { return w.last_query_found != 0; }
fn ecs_world_mod_deep_query_filtered(w: EcsWorldDeep) -> EcsWorldDeep {
    return ecs_world_mod_deep_query(w);
}
fn ecs_world_mod_deep_try_query(w: EcsWorldDeep) -> EcsWorldDeep {
