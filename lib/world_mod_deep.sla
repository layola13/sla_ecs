    let rid = ecs_world_mod_deep_resource_id(w, resource_id);
    if rid != (0 - 1) {
        w.last_get_resource_or_insert_was_new = 0;
        w.last_get_resource_or_insert_value = _re_at(w, rid);
        return w;
    };
    w = ecs_world_mod_deep_init_resource(w, resource_id);
    w.last_get_resource_or_insert_was_new = 1;
    w.last_get_resource_or_insert_value = 0;
    return w;
}

