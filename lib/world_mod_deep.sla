// Deep self-contained Bevy ECS World (world/mod.rs) — comprehensive semantic surface.
// Mirrors lib/world_mod.sla (870 lines, no @import). All Vec<T> fields become cap-16 scalar
// slot families (Vec<i32> → i32 slots, Vec<i64> → i64 slots). Three nested @derive(copy)
// struct fields (id, last_check_change_ticks, spawn_batch) are flattened inline to dodge the
// SA MemoryLeak (see docs/issue.md). Booleans stored as i32 (0/1). All structs carry
// @derive(copy). Tuple-returning fns return the mutated container with last_* counterparts.

const ECS_WM_DEEP_CAP: i32 = 16;

// === EcsWorldIdDeep (flat scalar mirror) ===
@derive(copy)
struct EcsWorldIdDeep { value: i64 }
fn ecs_world_id_deep_new(value: i64) -> EcsWorldIdDeep { return EcsWorldIdDeep { value: value }; }
fn ecs_world_id_deep_get(id: EcsWorldIdDeep) -> i64 { return id.value; }
fn ecs_world_id_deep_eq(a: EcsWorldIdDeep, b: EcsWorldIdDeep) -> bool { return a.value == b.value; }

// === EcsEntityLocationDeep (flat scalar mirror) ===
@derive(copy)
struct EcsEntityLocationDeep { archetype_id: i64, table_id: i64, table_row: i64 }
fn ecs_entity_location_deep_new(archetype_id: i64, table_id: i64, table_row: i64) -> EcsEntityLocationDeep {
    return EcsEntityLocationDeep { archetype_id: archetype_id, table_id: table_id, table_row: table_row };
}
fn ecs_entity_location_deep_archetype(l: EcsEntityLocationDeep) -> i64 { return l.archetype_id; }
fn ecs_entity_location_deep_table(l: EcsEntityLocationDeep) -> i64 { return l.table_id; }
fn ecs_entity_location_deep_row(l: EcsEntityLocationDeep) -> i64 { return l.table_row; }

// === EcsCheckChangeTicksDeep (flat scalar mirror) ===
@derive(copy)
struct EcsCheckChangeTicksDeep { max_age: i64, checked: i32 }
fn ecs_check_change_ticks_deep_new(max_age: i64) -> EcsCheckChangeTicksDeep {
    return EcsCheckChangeTicksDeep { max_age: max_age, checked: 1 };
}
fn ecs_check_change_ticks_deep_max_age(c: EcsCheckChangeTicksDeep) -> i64 { return c.max_age; }
fn ecs_check_change_ticks_deep_checked(c: EcsCheckChangeTicksDeep) -> bool { return c.checked != 0; }

// === EcsWorldScheduleEntryDeep (flat scalar mirror — used inside schedules slot family) ===
@derive(copy)
struct EcsWorldScheduleEntryDeep { label_id: i32, schedule_id: i64 }

// === EcsSpawnBatchIterDeep header (cap-16 spawned + pos + total) — kept as separate struct,
//     since it has its own accessor API and is returned by-value without nesting a wrapper. ===
@derive(copy)
struct EcsSpawnBatchIterDeep {
    s0: i64, s1: i64, s2: i64, s3: i64, s4: i64, s5: i64, s6: i64, s7: i64,
    s8: i64, s9: i64, s10: i64, s11: i64, s12: i64, s13: i64, s14: i64, s15: i64,
    pos: i64, total: i64,
    last_next_present: i32,
    last_next_entity: i64,
}
fn ecs_spawn_batch_iter_deep_new() -> EcsSpawnBatchIterDeep {
    return EcsSpawnBatchIterDeep {
        s0: 0, s1: 0, s2: 0, s3: 0, s4: 0, s5: 0, s6: 0, s7: 0,
        s8: 0, s9: 0, s10: 0, s11: 0, s12: 0, s13: 0, s14: 0, s15: 0,
        pos: 0, total: 0,
        last_next_present: 0, last_next_entity: 0,
    };
}
fn _esbi_at(it: EcsSpawnBatchIterDeep, idx: i64) -> i64 {
    if idx == 0 { return it.s0; };
    if idx == 1 { return it.s1; };
    if idx == 2 { return it.s2; };
    if idx == 3 { return it.s3; };
    if idx == 4 { return it.s4; };
    if idx == 5 { return it.s5; };
    if idx == 6 { return it.s6; };
    if idx == 7 { return it.s7; };
    if idx == 8 { return it.s8; };
    if idx == 9 { return it.s9; };
    if idx == 10 { return it.s10; };
    if idx == 11 { return it.s11; };
    if idx == 12 { return it.s12; };
    if idx == 13 { return it.s13; };
    if idx == 14 { return it.s14; };
    if idx == 15 { return it.s15; };
    panic(147270);
}
fn _esbi_set(it: EcsSpawnBatchIterDeep, idx: i64, v: i64) -> EcsSpawnBatchIterDeep {
    if idx == 0 { it.s0 = v; return it; };
    if idx == 1 { it.s1 = v; return it; };
    if idx == 2 { it.s2 = v; return it; };
    if idx == 3 { it.s3 = v; return it; };
    if idx == 4 { it.s4 = v; return it; };
    if idx == 5 { it.s5 = v; return it; };
    if idx == 6 { it.s6 = v; return it; };
    if idx == 7 { it.s7 = v; return it; };
    if idx == 8 { it.s8 = v; return it; };
    if idx == 9 { it.s9 = v; return it; };
    if idx == 10 { it.s10 = v; return it; };
    if idx == 11 { it.s11 = v; return it; };
    if idx == 12 { it.s12 = v; return it; };
    if idx == 13 { it.s13 = v; return it; };
    if idx == 14 { it.s14 = v; return it; };
    if idx == 15 { it.s15 = v; return it; };
    panic(147271);
}
fn ecs_spawn_batch_iter_deep_push(it: EcsSpawnBatchIterDeep, entity: i64) -> EcsSpawnBatchIterDeep {
    if it.total < ECS_WM_DEEP_CAP as i64 {
        it = _esbi_set(it, it.total, entity);
        it.total = it.total + 1;
    };
    return it;
}
fn ecs_spawn_batch_iter_deep_len(it: EcsSpawnBatchIterDeep) -> i64 { return it.total; }
fn ecs_spawn_batch_iter_deep_next(it: EcsSpawnBatchIterDeep) -> EcsSpawnBatchIterDeep {
    if it.pos < it.total {
        it.last_next_present = 1;
        it.last_next_entity = _esbi_at(it, it.pos);
        it.pos = it.pos + 1;
    } else {
        it.last_next_present = 0;
        it.last_next_entity = 0;
    };
    return it;
}
fn ecs_spawn_batch_iter_deep_next_present(it: EcsSpawnBatchIterDeep) -> bool { return it.last_next_present != 0; }
fn ecs_spawn_batch_iter_deep_next_entity(it: EcsSpawnBatchIterDeep) -> i64 { return it.last_next_entity; }

// === EcsWorldDeep ===
// Flatten id (i64 value), last_check_change_ticks (i64 max_age + i32 checked),
// spawn_batch (cap-16 s slots + pos + total + last_next_* companions). Carry them inline.
// Replace each Vec<i*> field with its cap-16 i32/i64 slot family plus a count.
@derive(copy)
struct EcsWorldDeep {
    id_value: i64,
    change_tick: i64,
    last_change_tick: i64,
    last_check_change_ticks_max_age: i64,
    last_check_change_ticks_checked: i32,
    entity_count: i64,
    // entities (cap-16 i64 slot family)
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    e8: i64, e9: i64, e10: i64, e11: i64, e12: i64, e13: i64, e14: i64, e15: i64,
    en: i32,
    // components (cap-16 i32 slot family)
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    c8: i32, c9: i32, c10: i32, c11: i32, c12: i32, c13: i32, c14: i32, c15: i32,
    cn: i32,
    // resources (cap-16 i32 slot family)
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    r8: i32, r9: i32, r10: i32, r11: i32, r12: i32, r13: i32, r14: i32, r15: i32,
    rn: i32,
    // resource_entities (cap-16 i64 slot family)
    re0: i64, re1: i64, re2: i64, re3: i64, re4: i64, re5: i64, re6: i64, re7: i64,
    re8: i64, re9: i64, re10: i64, re11: i64, re12: i64, re13: i64, re14: i64, re15: i64,
    // non_sends (cap-16 i32 slot family)
    ns0: i32, ns1: i32, ns2: i32, ns3: i32, ns4: i32, ns5: i32, ns6: i32, ns7: i32,
    ns8: i32, ns9: i32, ns10: i32, ns11: i32, ns12: i32, ns13: i32, ns14: i32, ns15: i32,
    nsn: i32,
    // removed_components (cap-16 i32 slot family)
    rm0: i32, rm1: i32, rm2: i32, rm3: i32, rm4: i32, rm5: i32, rm6: i32, rm7: i32,
    rm8: i32, rm9: i32, rm10: i32, rm11: i32, rm12: i32, rm13: i32, rm14: i32, rm15: i32,
    rmn: i32,
    // removed_entities (cap-16 i64 slot family)
    rme0: i64, rme1: i64, rme2: i64, rme3: i64, rme4: i64, rme5: i64, rme6: i64, rme7: i64,
    rme8: i64, rme9: i64, rme10: i64, rme11: i64, rme12: i64, rme13: i64, rme14: i64, rme15: i64,
    rmen: i32,
    // observers (cap-16 i64 slot family)
    ob0: i64, ob1: i64, ob2: i64, ob3: i64, ob4: i64, ob5: i64, ob6: i64, ob7: i64,
    ob8: i64, ob9: i64, ob10: i64, ob11: i64, ob12: i64, ob13: i64, ob14: i64, ob15: i64,
    obn: i32,
    // schedules (cap-16 schedule label+id pairs)
    sl0: i32, sl1: i32, sl2: i32, sl3: i32, sl4: i32, sl5: i32, sl6: i32, sl7: i32,
    sl8: i32, sl9: i32, sl10: i32, sl11: i32, sl12: i32, sl13: i32, sl14: i32, sl15: i32,
    sid0: i64, sid1: i64, sid2: i64, sid3: i64, sid4: i64, sid5: i64, sid6: i64, sid7: i64,
    sid8: i64, sid9: i64, sid10: i64, sid11: i64, sid12: i64, sid13: i64, sid14: i64, sid15: i64,
    sln: i32,
    next_entity: i64,
    last_clear: i64,
    spawn_batch_s0: i64, spawn_batch_s1: i64, spawn_batch_s2: i64, spawn_batch_s3: i64,
    spawn_batch_s4: i64, spawn_batch_s5: i64, spawn_batch_s6: i64, spawn_batch_s7: i64,
    spawn_batch_s8: i64, spawn_batch_s9: i64, spawn_batch_s10: i64, spawn_batch_s11: i64,
    spawn_batch_s12: i64, spawn_batch_s13: i64, spawn_batch_s14: i64, spawn_batch_s15: i64,
    spawn_batch_pos: i64,
    spawn_batch_total: i64,
    apply_final_deferred: i32,
    // Tuple-replacement companions for all the multi-result fns.
    last_bool: i32,
    last_int_value: i32,
    last_i64_value: i64,
    last_i64_2: i64,
    // Despawn / spawn_at: result flag
    last_despawn_found: i32,
    last_spawn_at_created: i32,
    last_spawn_at_entity: i64,
    last_next_next_present: i32,
    // resource change-ticks (bool, mt, lmt)
    last_resource_change_found: i32,
    last_resource_change_tick: i64,
    last_resource_change_last: i64,
    // resource get
    last_resource_found: i32,
    last_resource_entity: i64,
    // modify_component/resource
    last_modify_ok: i32,
    last_modify_value: i64,
    // non_send resource
    last_non_send_found: i32,
    last_non_send_id: i32,
    // get (component lookup)
    last_get_found: i32,
    last_get_value: i64,
    // entity get
    last_entity_found: i32,
    last_entity_value: i64,
    // query (returns -1 opaque id)
    last_query_value: i64,
    last_query_found: i32,
    // schedule-related
    last_schedule_found: i32,
    last_schedule_id: i64,
    last_schedule_scope_run_ok: i32,
    last_remove_resource_entity: i64,
    last_register_component_id: i32,
    last_register_resource_id: i32,
    last_register_non_send_id: i32,
    last_insert_resource_was_new: i32,
    last_get_resource_or_insert_was_new: i32,
    last_get_resource_or_insert_value: i64,
    last_remove_resource_found: i32,
    last_remove_non_send_found: i32,
    last_insert_batch_count: i64,
    last_register_bundle_id: i64,
    last_register_dynamic_bundle_count: i64,
    last_fallback_error_code: i32,
    last_write_message_id: i64,
    last_write_message_batch_count: i64,
    last_write_message_default: i64,
}

fn ecs_world_mod_deep_new() -> EcsWorldDeep {
    return EcsWorldDeep {
        id_value: 0, change_tick: 1, last_change_tick: 0,
        last_check_change_ticks_max_age: 0, last_check_change_ticks_checked: 0,
        entity_count: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        e8: 0, e9: 0, e10: 0, e11: 0, e12: 0, e13: 0, e14: 0, e15: 0, en: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        c8: 0, c9: 0, c10: 0, c11: 0, c12: 0, c13: 0, c14: 0, c15: 0, cn: 0,
        r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0,
        r8: 0, r9: 0, r10: 0, r11: 0, r12: 0, r13: 0, r14: 0, r15: 0, rn: 0,
        re0: 0, re1: 0, re2: 0, re3: 0, re4: 0, re5: 0, re6: 0, re7: 0,
        re8: 0, re9: 0, re10: 0, re11: 0, re12: 0, re13: 0, re14: 0, re15: 0,
        ns0: 0, ns1: 0, ns2: 0, ns3: 0, ns4: 0, ns5: 0, ns6: 0, ns7: 0,
        ns8: 0, ns9: 0, ns10: 0, ns11: 0, ns12: 0, ns13: 0, ns14: 0, ns15: 0, nsn: 0,
        rm0: 0, rm1: 0, rm2: 0, rm3: 0, rm4: 0, rm5: 0, rm6: 0, rm7: 0,
        rm8: 0, rm9: 0, rm10: 0, rm11: 0, rm12: 0, rm13: 0, rm14: 0, rm15: 0, rmn: 0,
        rme0: 0, rme1: 0, rme2: 0, rme3: 0, rme4: 0, rme5: 0, rme6: 0, rme7: 0,
        rme8: 0, rme9: 0, rme10: 0, rme11: 0, rme12: 0, rme13: 0, rme14: 0, rme15: 0, rmen: 0,
        ob0: 0, ob1: 0, ob2: 0, ob3: 0, ob4: 0, ob5: 0, ob6: 0, ob7: 0,
        ob8: 0, ob9: 0, ob10: 0, ob11: 0, ob12: 0, ob13: 0, ob14: 0, ob15: 0, obn: 0,
        sl0: 0, sl1: 0, sl2: 0, sl3: 0, sl4: 0, sl5: 0, sl6: 0, sl7: 0,
        sl8: 0, sl9: 0, sl10: 0, sl11: 0, sl12: 0, sl13: 0, sl14: 0, sl15: 0,
        sid0: 0, sid1: 0, sid2: 0, sid3: 0, sid4: 0, sid5: 0, sid6: 0, sid7: 0,
        sid8: 0, sid9: 0, sid10: 0, sid11: 0, sid12: 0, sid13: 0, sid14: 0, sid15: 0, sln: 0,
        next_entity: 1, last_clear: 0,
        spawn_batch_s0: 0, spawn_batch_s1: 0, spawn_batch_s2: 0, spawn_batch_s3: 0,
        spawn_batch_s4: 0, spawn_batch_s5: 0, spawn_batch_s6: 0, spawn_batch_s7: 0,
        spawn_batch_s8: 0, spawn_batch_s9: 0, spawn_batch_s10: 0, spawn_batch_s11: 0,
        spawn_batch_s12: 0, spawn_batch_s13: 0, spawn_batch_s14: 0, spawn_batch_s15: 0,
        spawn_batch_pos: 0, spawn_batch_total: 0,
        apply_final_deferred: 1,
        last_bool: 0, last_int_value: 0, last_i64_value: 0, last_i64_2: 0,
        last_despawn_found: 0, last_spawn_at_created: 0, last_spawn_at_entity: 0, last_next_next_present: 0,
        last_resource_change_found: 0, last_resource_change_tick: 0, last_resource_change_last: 0,
        last_resource_found: 0, last_resource_entity: 0,
        last_modify_ok: 0, last_modify_value: 0,
        last_non_send_found: 0, last_non_send_id: 0,
        last_get_found: 0, last_get_value: 0,
        last_entity_found: 0, last_entity_value: 0,
        last_query_value: (0 - 1), last_query_found: 0,
        last_schedule_found: 0, last_schedule_id: 0, last_schedule_scope_run_ok: 0,
        last_remove_resource_entity: 0,
        last_register_component_id: 0, last_register_resource_id: 0, last_register_non_send_id: 0,
        last_insert_resource_was_new: 0, last_get_resource_or_insert_was_new: 0, last_get_resource_or_insert_value: 0,
        last_remove_resource_found: 0, last_remove_non_send_found: 0,
        last_insert_batch_count: 0, last_register_bundle_id: 0, last_register_dynamic_bundle_count: 0, last_fallback_error_code: 0,
        last_write_message_id: 0, last_write_message_batch_count: 0, last_write_message_default: 0,
    };
}

// === slot-family helpers ===
fn _e_at(w: EcsWorldDeep, idx: i32) -> i64 {
    if idx == 0 { return w.e0; };
    if idx == 1 { return w.e1; };
    if idx == 2 { return w.e2; };
    if idx == 3 { return w.e3; };
    if idx == 4 { return w.e4; };
    if idx == 5 { return w.e5; };
    if idx == 6 { return w.e6; };
    if idx == 7 { return w.e7; };
    if idx == 8 { return w.e8; };
    if idx == 9 { return w.e9; };
    if idx == 10 { return w.e10; };
    if idx == 11 { return w.e11; };
    if idx == 12 { return w.e12; };
    if idx == 13 { return w.e13; };
    if idx == 14 { return w.e14; };
    if idx == 15 { return w.e15; };
    panic(147272);
}
fn _e_set(w: EcsWorldDeep, idx: i32, v: i64) -> EcsWorldDeep {
    if idx == 0 { w.e0 = v; return w; };
    if idx == 1 { w.e1 = v; return w; };
    if idx == 2 { w.e2 = v; return w; };
    if idx == 3 { w.e3 = v; return w; };
    if idx == 4 { w.e4 = v; return w; };
    if idx == 5 { w.e5 = v; return w; };
    if idx == 6 { w.e6 = v; return w; };
    if idx == 7 { w.e7 = v; return w; };
    if idx == 8 { w.e8 = v; return w; };
    if idx == 9 { w.e9 = v; return w; };
    if idx == 10 { w.e10 = v; return w; };
    if idx == 11 { w.e11 = v; return w; };
    if idx == 12 { w.e12 = v; return w; };
    if idx == 13 { w.e13 = v; return w; };
    if idx == 14 { w.e14 = v; return w; };
    if idx == 15 { w.e15 = v; return w; };
    panic(147273);
}
fn _e_push(w: EcsWorldDeep, v: i64) -> EcsWorldDeep {
    if w.en < ECS_WM_DEEP_CAP {
        w = _e_set(w, w.en, v);
        w.en = w.en + 1;
    };
    return w;
}

fn _c_at(w: EcsWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.c0; };
    if idx == 1 { return w.c1; };
    if idx == 2 { return w.c2; };
    if idx == 3 { return w.c3; };
    if idx == 4 { return w.c4; };
    if idx == 5 { return w.c5; };
    if idx == 6 { return w.c6; };
    if idx == 7 { return w.c7; };
    if idx == 8 { return w.c8; };
    if idx == 9 { return w.c9; };
    if idx == 10 { return w.c10; };
    if idx == 11 { return w.c11; };
    if idx == 12 { return w.c12; };
    if idx == 13 { return w.c13; };
    if idx == 14 { return w.c14; };
