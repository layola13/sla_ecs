    panic(147275);
}
fn _c_push(w: EcsWorldDeep, v: i32) -> EcsWorldDeep {
    if w.cn < ECS_WM_DEEP_CAP {
        w = _c_set(w, w.cn, v);
        w.cn = w.cn + 1;
