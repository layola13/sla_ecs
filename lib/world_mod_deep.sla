    w.nsn = 0;
    return w;
}
fn ecs_world_mod_deep_clear_all(w: EcsWorldDeep) -> EcsWorldDeep {
    w = ecs_world_mod_deep_clear_entities(w);
    w = ecs_world_mod_deep_clear_resources(w);
    w = ecs_world_mod_deep_clear_non_send(w);
    return w;
}

