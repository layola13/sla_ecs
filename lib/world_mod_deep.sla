fn ecs_world_mod_deep_removed(w: EcsWorldDeep, component_id: i32) -> i64 {
    let cid = ecs_world_mod_deep_component_id(w, component_id);
    if cid == (0 - 1) { return 0; };
    return w.rmen as i64;
}
fn ecs_world_mod_deep_removed_with_id(w: EcsWorldDeep, component_id: i32) -> i64 {
