}

fn _r_at(w: EcsWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.r0; };
    if idx == 1 { return w.r1; };
    if idx == 2 { return w.r2; };
    if idx == 3 { return w.r3; };
    if idx == 4 { return w.r4; };
    if idx == 5 { return w.r5; };
    if idx == 6 { return w.r6; };
    if idx == 7 { return w.r7; };
    if idx == 8 { return w.r8; };
    if idx == 9 { return w.r9; };
    if idx == 10 { return w.r10; };
    if idx == 11 { return w.r11; };
    if idx == 12 { return w.r12; };
    if idx == 13 { return w.r13; };
    if idx == 14 { return w.r14; };
    if idx == 15 { return w.r15; };
    panic(147276);
}
fn _r_set(w: EcsWorldDeep, idx: i32, v: i32) -> EcsWorldDeep {
    if idx == 0 { w.r0 = v; return w; };
    if idx == 1 { w.r1 = v; return w; };
    if idx == 2 { w.r2 = v; return w; };
    if idx == 3 { w.r3 = v; return w; };
    if idx == 4 { w.r4 = v; return w; };
    if idx == 5 { w.r5 = v; return w; };
    if idx == 6 { w.r6 = v; return w; };
    if idx == 7 { w.r7 = v; return w; };
    if idx == 8 { w.r8 = v; return w; };
    if idx == 9 { w.r9 = v; return w; };
