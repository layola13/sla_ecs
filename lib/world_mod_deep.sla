    w = ecs_world_mod_deep_register_component(w, component_id);
    w = ecs_world_mod_deep_register_component(w, required_id);
    w.last_bool = 1;
    return w;
}
fn ecs_world_mod_deep_last_register_required_components(w: EcsWorldDeep) -> bool { return w.last_bool != 0; }
fn ecs_world_mod_deep_register_required_components_with(w: EcsWorldDeep, component_id: i32, required_id: i32) -> EcsWorldDeep {
