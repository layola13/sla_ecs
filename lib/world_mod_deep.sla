// insert_batch / insert_batch_if_new / try_insert_batch / try_insert_batch_if_new
fn ecs_world_mod_deep_insert_batch(w: EcsWorldDeep, count: i64) -> EcsWorldDeep {
    let i: i64 = 0;
    while i < count {
        w = ecs_world_mod_deep_spawn_empty(w);
        i = i + 1;
    }
    w.last_insert_batch_count = count;
    return w;
}
