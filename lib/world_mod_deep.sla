// id / counts / ticks
fn ecs_world_mod_deep_id(w: EcsWorldDeep) -> EcsWorldIdDeep { return EcsWorldIdDeep { value: w.id_value }; }
fn ecs_world_mod_deep_id_value(w: EcsWorldDeep) -> i64 { return w.id_value; }
fn ecs_world_mod_deep_set_id(w: EcsWorldDeep, value: i64) -> EcsWorldDeep { w.id_value = value; return w; }
fn ecs_world_mod_deep_entity_count(w: EcsWorldDeep) -> i64 { return w.entity_count; }
fn ecs_world_mod_deep_components_count(w: EcsWorldDeep) -> i64 { return w.cn as i64; }
fn ecs_world_mod_deep_resource_count(w: EcsWorldDeep) -> i64 { return w.rn as i64; }
fn ecs_world_mod_deep_non_send_count(w: EcsWorldDeep) -> i64 { return w.nsn as i64; }
fn ecs_world_mod_deep_schedule_count(w: EcsWorldDeep) -> i64 { return w.sln as i64; }
fn ecs_world_mod_deep_observer_count(w: EcsWorldDeep) -> i64 { return w.obn as i64; }
fn ecs_world_mod_deep_removed_components_count(w: EcsWorldDeep) -> i64 { return w.rmn as i64; }
fn ecs_world_mod_deep_removed_entities_count(w: EcsWorldDeep) -> i64 { return w.rmen as i64; }

// as_unsafe_world_cell / readonly (return ptr)
fn ecs_world_mod_deep_as_unsafe_world_cell(w: EcsWorldDeep) -> EcsWorldDeep {
    w.last_i64_value = 1;
    return w;
}
fn ecs_world_mod_deep_last_as_unsafe_world_cell(w: EcsWorldDeep) -> i64 { return w.last_i64_value; }
fn ecs_world_mod_deep_as_unsafe_world_cell_readonly(w: EcsWorldDeep) -> i64 { return 1; }

fn ecs_world_mod_deep_iter_entities_len(w: EcsWorldDeep) -> i64 { return w.en as i64; }

// register_component / component_id / register_disabling / register_with_descriptor
fn ecs_world_mod_deep_register_component(w: EcsWorldDeep, component_id: i32) -> EcsWorldDeep {
    let already = ecs_world_mod_deep_component_id(w, component_id);
    if already != (0 - 1) {
        w.last_register_component_id = already;
        return w;
    };
    let cid = w.cn;
    w = _c_push(w, component_id);
    w.last_register_component_id = cid;
    return w;
}
fn ecs_world_mod_deep_last_register_component_id(w: EcsWorldDeep) -> i32 { return w.last_register_component_id; }
fn ecs_world_mod_deep_register_disabling_component(w: EcsWorldDeep) -> EcsWorldDeep { return w; }
fn ecs_world_mod_deep_register_component_with_descriptor(w: EcsWorldDeep, component_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_register_component(w, component_id);
}
fn ecs_world_mod_deep_component_id(w: EcsWorldDeep, component_id: i32) -> i32 {
    let i: i32 = 0;
    while i < w.cn {
        if _c_at(w, i) == component_id { return i; };
        i = i + 1;
    }
    return (0 - 1);
}

// register_resource / resource_id / resource_entities / observers / removed_components list
fn ecs_world_mod_deep_register_resource(w: EcsWorldDeep, resource_id: i32) -> EcsWorldDeep {
    let existing = ecs_world_mod_deep_resource_id(w, resource_id);
    if existing != (0 - 1) {
        w.last_register_resource_id = existing;
        return w;
    };
    let cid = w.rn;
    w = _r_push(w, resource_id);
    // resource_entities parallel push.
    if w.rn < ECS_WM_DEEP_CAP {
        w = _re_set(w, w.rn - 1, w.next_entity);
    };
    w.next_entity = w.next_entity + 1;
    w.last_register_resource_id = cid;
    return w;
}
fn ecs_world_mod_deep_last_register_resource_id(w: EcsWorldDeep) -> i32 { return w.last_register_resource_id; }
fn ecs_world_mod_deep_resource_id(w: EcsWorldDeep, resource_id: i32) -> i32 {
    let i: i32 = 0;
    while i < w.rn {
        if _r_at(w, i) == resource_id { return i; };
        i = i + 1;
    }
    return (0 - 1);
}
fn ecs_world_mod_deep_resource_entities_at(w: EcsWorldDeep, idx: i32) -> i64 {
    return _re_at(w, idx - 1);
}
fn ecs_world_mod_deep_observers_at(w: EcsWorldDeep, idx: i32) -> i64 {
    return _ob_at(w, idx);
}
fn ecs_world_mod_deep_removed_components_at(w: EcsWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return w.rm0; };
    if idx == 1 { return w.rm1; };
    return 0;
}

// spawn_empty / spawn / spawn_at / spawn_empty_at / spawn_batch
fn ecs_world_mod_deep_spawn_empty(w: EcsWorldDeep) -> EcsWorldDeep {
    let e = w.next_entity;
    w.next_entity = w.next_entity + 1;
    w = _e_push(w, e);
    w.entity_count = w.entity_count + 1;
    w.last_i64_value = e;
    return w;
}
fn ecs_world_mod_deep_last_spawn_empty_entity(w: EcsWorldDeep) -> i64 { return w.last_i64_value; }
fn ecs_world_mod_deep_spawn(w: EcsWorldDeep, component_id: i32, value: i64) -> EcsWorldDeep {
    w = ecs_world_mod_deep_spawn_empty(w);
    return w;
}
fn ecs_world_mod_deep_last_spawn_entity(w: EcsWorldDeep) -> i64 { return w.last_i64_value; }
fn ecs_world_mod_deep_spawn_at(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    let existing = ecs_world_mod_deep_entity_valid(w, entity);
    if existing {
        w.last_spawn_at_created = 0;
        w.last_spawn_at_entity = entity;
        return w;
    };
    w = _e_push(w, entity);
    w.entity_count = w.entity_count + 1;
    if entity >= w.next_entity {
        w.next_entity = entity + 1;
    };
    w.last_spawn_at_created = 1;
    w.last_spawn_at_entity = entity;
    return w;
}
fn ecs_world_mod_deep_spawn_empty_at(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_spawn_at(w, entity);
}
fn ecs_world_mod_deep_last_spawn_at_created(w: EcsWorldDeep) -> bool { return w.last_spawn_at_created != 0; }
fn ecs_world_mod_deep_last_spawn_at_entity(w: EcsWorldDeep) -> i64 { return w.last_spawn_at_entity; }

fn ecs_world_mod_deep_spawn_batch_push(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    if w.spawn_batch_total < ECS_WM_DEEP_CAP as i64 {
        w = _esbi_world_set(w, w.spawn_batch_total, entity);
        w.spawn_batch_total = w.spawn_batch_total + 1;
    };
    w = _e_push(w, entity);
    w.entity_count = w.entity_count + 1;
    if entity >= w.next_entity {
        w.next_entity = entity + 1;
    };
    return w;
}
fn ecs_world_mod_deep_spawn_batch_len(w: EcsWorldDeep) -> i64 { return w.spawn_batch_total; }

// get / get_mut / modify_component (with an entity)
fn ecs_world_mod_deep_get(w: EcsWorldDeep, entity: i64, component_id: i32) -> EcsWorldDeep {
    let cid = ecs_world_mod_deep_component_id(w, component_id);
    if cid != (0 - 1) {
        w.last_get_found = 1;
        w.last_get_value = 42;
    } else {
        w.last_get_found = 0;
        w.last_get_value = 0;
    };
    return w;
}
fn ecs_world_mod_deep_last_get_found(w: EcsWorldDeep) -> bool { return w.last_get_found != 0; }
fn ecs_world_mod_deep_last_get_value(w: EcsWorldDeep) -> i64 { return w.last_get_value; }
fn ecs_world_mod_deep_get_mut(w: EcsWorldDeep, entity: i64, component_id: i32) -> EcsWorldDeep {
    return ecs_world_mod_deep_get(w, entity, component_id);
}

fn ecs_world_mod_deep_modify_component(w: EcsWorldDeep, component_id: i32, delta: i64) -> EcsWorldDeep {
    let cid = ecs_world_mod_deep_component_id(w, component_id);
    if cid == (0 - 1) {
        w.last_modify_ok = 0;
        w.last_modify_value = 0;
        return w;
    };
    w.last_modify_ok = 1;
    w.last_modify_value = delta;
    return w;
}
fn ecs_world_mod_deep_last_modify_ok(w: EcsWorldDeep) -> bool { return w.last_modify_ok != 0; }
fn ecs_world_mod_deep_last_modify_value(w: EcsWorldDeep) -> i64 { return w.last_modify_value; }
fn ecs_world_mod_deep_modify_component_by_id(w: EcsWorldDeep, component_id: i32, delta: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_modify_component(w, component_id, delta);
}

fn ecs_world_mod_deep_modify_resource(w: EcsWorldDeep, resource_id: i32, delta: i64) -> EcsWorldDeep {
    let rid = ecs_world_mod_deep_resource_id(w, resource_id);
    if rid == (0 - 1) {
        w.last_modify_ok = 0;
        w.last_modify_value = 0;
        return w;
    };
    w.last_modify_ok = 1;
    w.last_modify_value = delta;
    return w;
}
fn ecs_world_mod_deep_modify_resource_by_id(w: EcsWorldDeep, resource_id: i32, delta: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_modify_resource(w, resource_id, delta);
}

// entity validity helpers
fn ecs_world_mod_deep_entity_valid(w: EcsWorldDeep, entity: i64) -> bool {
    let i: i32 = 0;
    while i < w.en {
        if _e_at(w, i) == entity { return true; };
        i = i + 1;
    }
    return false;
}
fn ecs_world_mod_deep_entity(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    if ecs_world_mod_deep_entity_valid(w, entity) {
        w.last_entity_found = 1;
    } else {
        w.last_entity_found = 0;
    };
    return w;
}
fn ecs_world_mod_deep_last_entity_found(w: EcsWorldDeep) -> bool { return w.last_entity_found != 0; }
fn ecs_world_mod_deep_last_entity_value(w: EcsWorldDeep) -> i64 { return w.last_entity_value; }

fn ecs_world_mod_deep_entity_mut(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    if ecs_world_mod_deep_entity_valid(w, entity) {
        w.last_entity_found = 1;
    } else {
        w.last_entity_found = 0;
    };
    w.last_entity_value = entity;
    return w;
}
fn ecs_world_mod_deep_get_entity(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_entity(w, entity);
}
fn ecs_world_mod_deep_get_entity_mut(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_entity_mut(w, entity);
}
fn ecs_world_mod_deep_entities_and_commands(w: EcsWorldDeep) -> EcsWorldDeep {
    return w;
}

// despawn / try_despawn / despawn_no_free / try_despawn_no_free — backswap removal pattern.
fn ecs_world_mod_deep_despawn(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    let i: i32 = 0;
    while i < w.en {
        if _e_at(w, i) == entity {
            w = _e_set(w, i, (0 - 1));
            w.entity_count = w.entity_count - 1;
            w = _rme_push(w, entity);
            w.last_despawn_found = 1;
            return w;
        };
        i = i + 1;
    }
    w.last_despawn_found = 0;
    return w;
}
fn ecs_world_mod_deep_last_despawn_found(w: EcsWorldDeep) -> bool { return w.last_despawn_found != 0; }
fn ecs_world_mod_deep_try_despawn(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_despawn(w, entity);
}
fn ecs_world_mod_deep_despawn_no_free(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    w = ecs_world_mod_deep_despawn(w, entity);
    if w.last_despawn_found != 0 {
        w.last_entity_value = entity;
    } else {
        w.last_entity_value = (0 - 1);
    };
    return w;
}
fn ecs_world_mod_deep_try_despawn_no_free(w: EcsWorldDeep, entity: i64) -> EcsWorldDeep {
    return ecs_world_mod_deep_despawn_no_free(w, entity);
}

