    if rid == (0 - 1) {
        w.last_resource_change_found = 0;
        w.last_resource_change_tick = 0;
        w.last_resource_change_last = 0;
        return w;
    };
    w.last_resource_change_found = 1;
    w.last_resource_change_tick = w.change_tick;
    w.last_resource_change_last = w.last_change_tick;
    return w;
}
