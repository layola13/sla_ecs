fn ecs_world_mod_deep_resource(w: EcsWorldDeep, resource_id: i32) -> EcsWorldDeep {
    let rid = ecs_world_mod_deep_resource_id(w, resource_id);
    if rid == (0 - 1) {
        w.last_resource_found = 0;
        w.last_resource_entity = 0;
        return w;
    };
    w.last_resource_found = 1;
    w.last_resource_entity = _re_at(w, rid);
    return w;
}
