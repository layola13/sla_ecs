// Deepened Bevy ECS query error surface.
// Mirrors src/query/error.rs:
//   QueryEntityError { QueryDoesNotMatch(Entity, ArchetypeId), NotSpawned(EntityNotSpawnedError), AliasedMutability(Entity) }
//   QuerySingleError { NoEntities(DebugName), MultipleEntities(DebugName) }
//   QueryNotDenseError(DebugName)
// Nested EntityNotSpawnedError from src/entity/mod.rs:
//   Invalid(entity, current_generation) | ValidButNotSpawned(entity, location_token)
// Shallow lib/query_error.sla retained (legacy ENTITY_NOT_FOUND / ALIEN_ENTITY names).

// === QueryEntityError kinds (Bevy order) ===
const ECS_QE_KIND_QUERY_DOES_NOT_MATCH: i32 = 0;
const ECS_QE_KIND_NOT_SPAWNED: i32 = 1;
const ECS_QE_KIND_ALIASED_MUTABILITY: i32 = 2;

// Nested EntityNotSpawnedError kinds
const ECS_QE_NS_INVALID: i32 = 0;
const ECS_QE_NS_VALID_BUT_NOT_SPAWNED: i32 = 1;

// QuerySingleError kinds
const ECS_QE_SINGLE_NO_ENTITIES: i32 = 0;
const ECS_QE_SINGLE_MULTIPLE_ENTITIES: i32 = 1;

// Display-code bases (stable numeric stand-ins for Display/Debug strings)
const ECS_QE_DISP_DOES_NOT_MATCH: i64 = 1000000000;
const ECS_QE_DISP_NOT_SPAWNED: i64 = 2000000000;
const ECS_QE_DISP_ALIASED: i64 = 3000000000;
const ECS_QE_DISP_SINGLE_NONE: i64 = 4000000000;
const ECS_QE_DISP_SINGLE_MULTI: i64 = 5000000000;
const ECS_QE_DISP_NOT_DENSE: i64 = 6000000000;

// === EntityNotSpawnedError deep ===
// Invalid: generation mismatch / never valid entity.
// ValidButNotSpawned: generation ok but index not currently spawned.
struct EcsEntityNotSpawnedErrorDeep {
    kind: i32,
    entity: i64,
    // Invalid: current generation of the index (mismatch detail)
    current_generation: i64,
    // ValidButNotSpawned: last despawn location token (MaybeLocation stand-in; 0 = none)
    location: i64,
}

fn ecs_qe_ns_invalid(entity: i64, current_generation: i64) -> EcsEntityNotSpawnedErrorDeep {
    return EcsEntityNotSpawnedErrorDeep {
        kind: ECS_QE_NS_INVALID,
        entity: entity,
        current_generation: current_generation,
        location: 0,
    };
}

fn ecs_qe_ns_valid_but_not_spawned(entity: i64, location: i64) -> EcsEntityNotSpawnedErrorDeep {
    return EcsEntityNotSpawnedErrorDeep {
        kind: ECS_QE_NS_VALID_BUT_NOT_SPAWNED,
        entity: entity,
        current_generation: 0,
        location: location,
    };
}

fn ecs_qe_ns_kind(e: EcsEntityNotSpawnedErrorDeep) -> i32 { return e.kind; }
fn ecs_qe_ns_entity(e: EcsEntityNotSpawnedErrorDeep) -> i64 { return e.entity; }
fn ecs_qe_ns_current_generation(e: EcsEntityNotSpawnedErrorDeep) -> i64 { return e.current_generation; }
fn ecs_qe_ns_location(e: EcsEntityNotSpawnedErrorDeep) -> i64 { return e.location; }
fn ecs_qe_ns_is_invalid(e: EcsEntityNotSpawnedErrorDeep) -> bool { return e.kind == ECS_QE_NS_INVALID; }
fn ecs_qe_ns_is_valid_but_not_spawned(e: EcsEntityNotSpawnedErrorDeep) -> bool {
    return e.kind == ECS_QE_NS_VALID_BUT_NOT_SPAWNED;
}

// EntityNotSpawnedError::entity()
fn ecs_qe_ns_entity_method(e: EcsEntityNotSpawnedErrorDeep) -> i64 { return e.entity; }

fn ecs_qe_ns_eq(a: EcsEntityNotSpawnedErrorDeep, b: EcsEntityNotSpawnedErrorDeep) -> bool {
    if a.kind != b.kind { return false; };
    if a.entity != b.entity { return false; };
    if a.current_generation != b.current_generation { return false; };
    return a.location == b.location;
}

// Display stand-in: encode kind + entity
fn ecs_qe_ns_display_code(e: EcsEntityNotSpawnedErrorDeep) -> i64 {
    if e.kind == ECS_QE_NS_INVALID {
        return 1000000 + e.entity;
    };
    return 2000000 + e.entity;
}

// === QueryEntityError deep ===
// Fields unused by a given variant are zeroed.
struct EcsQueryEntityErrorDeep {
    kind: i32,
    entity: i64,
    // QueryDoesNotMatch only
    archetype_id: i64,
    // NotSpawned only
    not_spawned_kind: i32,
    not_spawned_generation: i64,
    not_spawned_location: i64,
}

fn ecs_qe_query_does_not_match(entity: i64, archetype_id: i64) -> EcsQueryEntityErrorDeep {
    return EcsQueryEntityErrorDeep {
        kind: ECS_QE_KIND_QUERY_DOES_NOT_MATCH,
        entity: entity,
        archetype_id: archetype_id,
        not_spawned_kind: 0,
        not_spawned_generation: 0,
        not_spawned_location: 0,
    };
}

fn ecs_qe_not_spawned(ns: EcsEntityNotSpawnedErrorDeep) -> EcsQueryEntityErrorDeep {
    return EcsQueryEntityErrorDeep {
        kind: ECS_QE_KIND_NOT_SPAWNED,
        entity: ns.entity,
        archetype_id: 0,
        not_spawned_kind: ns.kind,
        not_spawned_generation: ns.current_generation,
        not_spawned_location: ns.location,
    };
}

// From EntityNotSpawnedError convenience (#[from])
fn ecs_qe_from_not_spawned(ns: EcsEntityNotSpawnedErrorDeep) -> EcsQueryEntityErrorDeep {
    return ecs_qe_not_spawned(ns);
}

fn ecs_qe_not_spawned_invalid(entity: i64, current_generation: i64) -> EcsQueryEntityErrorDeep {
    return ecs_qe_not_spawned(ecs_qe_ns_invalid(entity, current_generation));
}

fn ecs_qe_not_spawned_valid(entity: i64, location: i64) -> EcsQueryEntityErrorDeep {
    return ecs_qe_not_spawned(ecs_qe_ns_valid_but_not_spawned(entity, location));
}

fn ecs_qe_aliased_mutability(entity: i64) -> EcsQueryEntityErrorDeep {
    return EcsQueryEntityErrorDeep {
        kind: ECS_QE_KIND_ALIASED_MUTABILITY,
        entity: entity,
        archetype_id: 0,
        not_spawned_kind: 0,
        not_spawned_generation: 0,
        not_spawned_location: 0,
    };
}

fn ecs_qe_kind(e: EcsQueryEntityErrorDeep) -> i32 { return e.kind; }
fn ecs_qe_entity(e: EcsQueryEntityErrorDeep) -> i64 { return e.entity; }
fn ecs_qe_archetype_id(e: EcsQueryEntityErrorDeep) -> i64 { return e.archetype_id; }

fn ecs_qe_is_query_does_not_match(e: EcsQueryEntityErrorDeep) -> bool {
    return e.kind == ECS_QE_KIND_QUERY_DOES_NOT_MATCH;
}
fn ecs_qe_is_not_spawned(e: EcsQueryEntityErrorDeep) -> bool {
    return e.kind == ECS_QE_KIND_NOT_SPAWNED;
}
fn ecs_qe_is_aliased_mutability(e: EcsQueryEntityErrorDeep) -> bool {
    return e.kind == ECS_QE_KIND_ALIASED_MUTABILITY;
}

// Extract nested NotSpawned payload (only meaningful when kind == NotSpawned)
fn ecs_qe_not_spawned_payload(e: EcsQueryEntityErrorDeep) -> EcsEntityNotSpawnedErrorDeep {
    if e.not_spawned_kind == ECS_QE_NS_VALID_BUT_NOT_SPAWNED {
        return ecs_qe_ns_valid_but_not_spawned(e.entity, e.not_spawned_location);
    };
    return ecs_qe_ns_invalid(e.entity, e.not_spawned_generation);
}

// Entity extraction used by Query docs:
//   QueryEntityError::NotSpawned(error) => error.entity()
//   QueryEntityError::QueryDoesNotMatch(entity, _) => entity
//   QueryEntityError::AliasedMutability(entity) => entity
fn ecs_qe_entity_any(e: EcsQueryEntityErrorDeep) -> i64 { return e.entity; }

fn ecs_qe_eq(a: EcsQueryEntityErrorDeep, b: EcsQueryEntityErrorDeep) -> bool {
    if a.kind != b.kind { return false; };
    if a.entity != b.entity { return false; };
    if a.archetype_id != b.archetype_id { return false; };
    if a.not_spawned_kind != b.not_spawned_kind { return false; };
    if a.not_spawned_generation != b.not_spawned_generation { return false; };
    return a.not_spawned_location == b.not_spawned_location;
}

// Display stand-ins matching Bevy error messages' primary payloads
fn ecs_qe_display_code(e: EcsQueryEntityErrorDeep) -> i64 {
    if e.kind == ECS_QE_KIND_QUERY_DOES_NOT_MATCH {
        // "The query does not match entity {entity}" + archetype detail
        return ECS_QE_DISP_DOES_NOT_MATCH + e.entity * 1000 + e.archetype_id;
    };
    if e.kind == ECS_QE_KIND_NOT_SPAWNED {
        // Nested display + entity
        let nested = ecs_qe_ns_display_code(ecs_qe_not_spawned_payload(e));
        return ECS_QE_DISP_NOT_SPAWNED + nested;
    };
    // AliasedMutability
    return ECS_QE_DISP_ALIASED + e.entity;
}

// Classify into query_state_read_api style codes: 0/1/2
fn ecs_qe_flat_code(e: EcsQueryEntityErrorDeep) -> i32 {
    return e.kind;
}

// === QuerySingleError deep ===
// Bevy carries DebugName (type name of the query), not a match count.
struct EcsQuerySingleErrorDeep {
    kind: i32,
    debug_name: i64,
}

fn ecs_qe_single_no_entities(debug_name: i64) -> EcsQuerySingleErrorDeep {
    return EcsQuerySingleErrorDeep {
        kind: ECS_QE_SINGLE_NO_ENTITIES,
        debug_name: debug_name,
    };
}

fn ecs_qe_single_multiple_entities(debug_name: i64) -> EcsQuerySingleErrorDeep {
    return EcsQuerySingleErrorDeep {
        kind: ECS_QE_SINGLE_MULTIPLE_ENTITIES,
        debug_name: debug_name,
    };
}

fn ecs_qe_single_kind(e: EcsQuerySingleErrorDeep) -> i32 { return e.kind; }
fn ecs_qe_single_debug_name(e: EcsQuerySingleErrorDeep) -> i64 { return e.debug_name; }
fn ecs_qe_single_is_no_entities(e: EcsQuerySingleErrorDeep) -> bool {
    return e.kind == ECS_QE_SINGLE_NO_ENTITIES;
}
fn ecs_qe_single_is_multiple(e: EcsQuerySingleErrorDeep) -> bool {
    return e.kind == ECS_QE_SINGLE_MULTIPLE_ENTITIES;
}

fn ecs_qe_single_eq(a: EcsQuerySingleErrorDeep, b: EcsQuerySingleErrorDeep) -> bool {
    if a.kind != b.kind { return false; };
    return a.debug_name == b.debug_name;
}

// "No entities fit the query {name}" / "Multiple entities fit the query {name}"
fn ecs_qe_single_display_code(e: EcsQuerySingleErrorDeep) -> i64 {
    if e.kind == ECS_QE_SINGLE_NO_ENTITIES {
        return ECS_QE_DISP_SINGLE_NONE + e.debug_name;
    };
    return ECS_QE_DISP_SINGLE_MULTI + e.debug_name;
}

// Fold helper used by single()/single_mut() logic:
// count==0 -> NoEntities; count==1 -> Ok path (caller handles); count>1 -> Multiple
fn ecs_qe_single_from_count(count: i64, debug_name: i64) -> (bool, EcsQuerySingleErrorDeep) {
    // returns (is_err, error). is_err=false means exactly one match (no error).
    if count == 0 {
        return (true, ecs_qe_single_no_entities(debug_name));
    };
    if count == 1 {
        return (false, ecs_qe_single_no_entities(debug_name));
    };
    return (true, ecs_qe_single_multiple_entities(debug_name));
}

// === QueryNotDenseError deep ===
// "Cannot contiguously iterate non-dense query {name}"
struct EcsQueryNotDenseErrorDeep {
    debug_name: i64,
}

fn ecs_qe_not_dense(debug_name: i64) -> EcsQueryNotDenseErrorDeep {
    return EcsQueryNotDenseErrorDeep { debug_name: debug_name };
}

// Bevy: .ok_or(QueryNotDenseError(DebugName::type_name::<Self>())) when is_dense is false
fn ecs_qe_not_dense_from_is_dense(is_dense: bool, debug_name: i64) -> (bool, EcsQueryNotDenseErrorDeep) {
    // returns (is_err, error). is_err=false means dense (ok to contiguous_iter).
    if is_dense {
        return (false, ecs_qe_not_dense(debug_name));
    };
    return (true, ecs_qe_not_dense(debug_name));
}

fn ecs_qe_not_dense_name(e: EcsQueryNotDenseErrorDeep) -> i64 { return e.debug_name; }
fn ecs_qe_not_dense_eq(a: EcsQueryNotDenseErrorDeep, b: EcsQueryNotDenseErrorDeep) -> bool {
    return a.debug_name == b.debug_name;
}
fn ecs_qe_not_dense_display_code(e: EcsQueryNotDenseErrorDeep) -> i64 {
    return ECS_QE_DISP_NOT_DENSE + e.debug_name;
}

// === get_many_mut alias detection helper ===
// Models the early return Err(AliasedMutability(entities[i])) when entity appears twice.
// entities: fixed 8-slot stand-in; count is used length.
struct EcsQueryEntityList8 {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    count: i32,
}

fn ecs_qe_entity_list8_empty() -> EcsQueryEntityList8 {
    return EcsQueryEntityList8 {
        e0: 0, e1: 0, e2: 0, e3: 0,
        e4: 0, e5: 0, e6: 0, e7: 0,
        count: 0,
    };
}

fn ecs_qe_entity_list8_push(l: EcsQueryEntityList8, entity: i64) -> EcsQueryEntityList8 {
    if l.count >= 8 { return l; };
    if l.count == 0 { l.e0 = entity; };
    if l.count == 1 { l.e1 = entity; };
    if l.count == 2 { l.e2 = entity; };
    if l.count == 3 { l.e3 = entity; };
    if l.count == 4 { l.e4 = entity; };
    if l.count == 5 { l.e5 = entity; };
    if l.count == 6 { l.e6 = entity; };
    if l.count == 7 { l.e7 = entity; };
    l.count = l.count + 1;
    return l;
}

fn ecs_qe_entity_list8_get(l: EcsQueryEntityList8, idx: i32) -> i64 {
    if idx == 0 { return l.e0; };
    if idx == 1 { return l.e1; };
    if idx == 2 { return l.e2; };
    if idx == 3 { return l.e3; };
    if idx == 4 { return l.e4; };
    if idx == 5 { return l.e5; };
    if idx == 6 { return l.e6; };
    if idx == 7 { return l.e7; };
    return 0;
}

// Returns (has_alias, error). On alias, error is AliasedMutability of the later duplicate entity.
fn ecs_qe_detect_aliased_mutability(l: EcsQueryEntityList8) -> (bool, EcsQueryEntityErrorDeep) {
    let i: i32 = 0;
    while i < l.count {
        let j: i32 = 0;
        while j < i {
            if ecs_qe_entity_list8_get(l, i) == ecs_qe_entity_list8_get(l, j) {
                return (true, ecs_qe_aliased_mutability(ecs_qe_entity_list8_get(l, i)));
            };
            j = j + 1;
        }
        i = i + 1;
    }
    return (false, ecs_qe_aliased_mutability(0));
}

// World-query get classification helper (Bevy query.get path):
// spawned=false -> NotSpawned; spawned && !matches -> QueryDoesNotMatch; else Ok (is_err=false)
fn ecs_qe_classify_get(
    entity: i64,
    spawned: bool,
    matches: bool,
    archetype_id: i64,
    ns_kind: i32,
    ns_generation: i64,
    ns_location: i64
) -> (bool, EcsQueryEntityErrorDeep) {
    if spawned != true {
        if ns_kind == ECS_QE_NS_VALID_BUT_NOT_SPAWNED {
            return (true, ecs_qe_not_spawned_valid(entity, ns_location));
        };
        return (true, ecs_qe_not_spawned_invalid(entity, ns_generation));
    };
    if matches != true {
        return (true, ecs_qe_query_does_not_match(entity, archetype_id));
    };
    return (false, ecs_qe_query_does_not_match(entity, archetype_id));
}
