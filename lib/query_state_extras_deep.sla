// Deepened Bevy ECS QueryState extras + StorageSwitch + fetch wrappers.
// Mirrors src/query/state.rs + fetch.rs residual surface.
// Fixed capacity: 4 reads, 4 writes, 4 tables, 4 archetypes.
// Shallow lib/query_state_extras.sla retained.

const ECS_QSE_TABLE: i32 = 0;
const ECS_QSE_SPARSE: i32 = 1;

// StorageSwitch scalar model
struct EcsQseSwitchDeep {
    table_val: i64,
    sparse_val: i64,
}

fn ecs_qse_switch_new(table_val: i64, sparse_val: i64) -> EcsQseSwitchDeep {
    return EcsQseSwitchDeep { table_val: table_val, sparse_val: sparse_val };
}

fn ecs_qse_switch_table(s: EcsQseSwitchDeep) -> i64 { return s.table_val; }
fn ecs_qse_switch_sparse(s: EcsQseSwitchDeep) -> i64 { return s.sparse_val; }

fn ecs_qse_switch_extract(s: EcsQseSwitchDeep, storage_type: i32) -> i64 {
    if storage_type == ECS_QSE_TABLE { return s.table_val; };
    return s.sparse_val;
}

// Fetch wrappers
struct EcsQseFetchDeep {
    kind: i32, // 0=read 1=write 2=ref
    value: i64,
}

fn ecs_qse_read_fetch(value: i64) -> EcsQseFetchDeep {
    return EcsQseFetchDeep { kind: 0, value: value };
}
fn ecs_qse_write_fetch(value: i64) -> EcsQseFetchDeep {
    return EcsQseFetchDeep { kind: 1, value: value };
}
fn ecs_qse_ref_fetch(value: i64) -> EcsQseFetchDeep {
    return EcsQseFetchDeep { kind: 2, value: value };
}

fn ecs_qse_fetch_kind(f: EcsQseFetchDeep) -> i32 { return f.kind; }
fn ecs_qse_fetch_get(f: EcsQseFetchDeep) -> i64 { return f.value; }

fn ecs_qse_fetch_set(f: EcsQseFetchDeep, value: i64) -> EcsQseFetchDeep {
    if f.kind != 1 { return f; };
    return EcsQseFetchDeep { kind: 1, value: value };
}

fn ecs_qse_fetch_is_write(f: EcsQseFetchDeep) -> bool { return f.kind == 1; }

// QueryState extras
struct EcsQseDeep {
    world_id: i32,
    generation: i32,
    is_readonly: bool,
    r0: i32, r1: i32, r2: i32, r3: i32, rlen: i32,
    w0: i32, w1: i32, w2: i32, w3: i32, wlen: i32,
    t0: i32, t1: i32, t2: i32, t3: i32, tlen: i32,
    a0: i32, a1: i32, a2: i32, a3: i32, alen: i32,
}

fn ecs_qse_deep_new(world_id: i32) -> EcsQseDeep {
    return EcsQseDeep {
        world_id: world_id, generation: 0, is_readonly: false,
        r0: -1, r1: -1, r2: -1, r3: -1, rlen: 0,
        w0: -1, w1: -1, w2: -1, w3: -1, wlen: 0,
        t0: -1, t1: -1, t2: -1, t3: -1, tlen: 0,
        a0: -1, a1: -1, a2: -1, a3: -1, alen: 0,
    };
}

fn ecs_qse_deep_world(s: EcsQseDeep) -> i32 { return s.world_id; }
fn ecs_qse_deep_generation(s: EcsQseDeep) -> i32 { return s.generation; }
fn ecs_qse_deep_is_readonly(s: EcsQseDeep) -> bool { return s.is_readonly; }
fn ecs_qse_deep_rlen(s: EcsQseDeep) -> i32 { return s.rlen; }
fn ecs_qse_deep_wlen(s: EcsQseDeep) -> i32 { return s.wlen; }
fn ecs_qse_deep_tlen(s: EcsQseDeep) -> i32 { return s.tlen; }
fn ecs_qse_deep_alen(s: EcsQseDeep) -> i32 { return s.alen; }

fn ecs_qse_deep_rebuild(
    world_id: i32, generation: i32, is_readonly: bool,
    r0: i32, r1: i32, r2: i32, r3: i32, rlen: i32,
    w0: i32, w1: i32, w2: i32, w3: i32, wlen: i32,
    t0: i32, t1: i32, t2: i32, t3: i32, tlen: i32,
    a0: i32, a1: i32, a2: i32, a3: i32, alen: i32
) -> EcsQseDeep {
    return EcsQseDeep {
        world_id: world_id, generation: generation, is_readonly: is_readonly,
        r0: r0, r1: r1, r2: r2, r3: r3, rlen: rlen,
        w0: w0, w1: w1, w2: w2, w3: w3, wlen: wlen,
        t0: t0, t1: t1, t2: t2, t3: t3, tlen: tlen,
        a0: a0, a1: a1, a2: a2, a3: a3, alen: alen,
    };
}

fn ecs_qse_deep_add_read(s: EcsQseDeep, cid: i32) -> EcsQseDeep {
    if s.rlen == 0 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, cid, s.r1, s.r2, s.r3, 1, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    if s.rlen == 1 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, cid, s.r2, s.r3, 2, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    if s.rlen == 2 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, cid, s.r3, 3, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    if s.rlen == 3 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, cid, 4, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    return s;
}

fn ecs_qse_deep_add_write(s: EcsQseDeep, cid: i32) -> EcsQseDeep {
    let s2 = ecs_qse_deep_add_read(s, cid);
    if s2.wlen == 0 {
        return ecs_qse_deep_rebuild(s2.world_id, s2.generation, s2.is_readonly, s2.r0, s2.r1, s2.r2, s2.r3, s2.rlen, cid, s2.w1, s2.w2, s2.w3, 1, s2.t0, s2.t1, s2.t2, s2.t3, s2.tlen, s2.a0, s2.a1, s2.a2, s2.a3, s2.alen);
    };
    if s2.wlen == 1 {
        return ecs_qse_deep_rebuild(s2.world_id, s2.generation, s2.is_readonly, s2.r0, s2.r1, s2.r2, s2.r3, s2.rlen, s2.w0, cid, s2.w2, s2.w3, 2, s2.t0, s2.t1, s2.t2, s2.t3, s2.tlen, s2.a0, s2.a1, s2.a2, s2.a3, s2.alen);
    };
    if s2.wlen == 2 {
        return ecs_qse_deep_rebuild(s2.world_id, s2.generation, s2.is_readonly, s2.r0, s2.r1, s2.r2, s2.r3, s2.rlen, s2.w0, s2.w1, cid, s2.w3, 3, s2.t0, s2.t1, s2.t2, s2.t3, s2.tlen, s2.a0, s2.a1, s2.a2, s2.a3, s2.alen);
    };
    if s2.wlen == 3 {
        return ecs_qse_deep_rebuild(s2.world_id, s2.generation, s2.is_readonly, s2.r0, s2.r1, s2.r2, s2.r3, s2.rlen, s2.w0, s2.w1, s2.w2, cid, 4, s2.t0, s2.t1, s2.t2, s2.t3, s2.tlen, s2.a0, s2.a1, s2.a2, s2.a3, s2.alen);
    };
    return s2;
}

fn ecs_qse_deep_as_readonly(s: EcsQseDeep) -> EcsQseDeep {
    return ecs_qse_deep_rebuild(s.world_id, s.generation, true, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, 0, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
}

fn ecs_qse_deep_add_table(s: EcsQseDeep, table_id: i32) -> EcsQseDeep {
    if s.tlen == 0 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, table_id, s.t1, s.t2, s.t3, 1, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    if s.tlen == 1 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, table_id, s.t2, s.t3, 2, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    if s.tlen == 2 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, table_id, s.t3, 3, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    if s.tlen == 3 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, table_id, 4, s.a0, s.a1, s.a2, s.a3, s.alen);
    };
    return s;
}

fn ecs_qse_deep_add_archetype(s: EcsQseDeep, archetype_id: i32) -> EcsQseDeep {
    if s.alen == 0 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, archetype_id, s.a1, s.a2, s.a3, 1);
    };
    if s.alen == 1 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, archetype_id, s.a2, s.a3, 2);
    };
    if s.alen == 2 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, archetype_id, s.a3, 3);
    };
    if s.alen == 3 {
        return ecs_qse_deep_rebuild(s.world_id, s.generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, archetype_id, 4);
    };
    return s;
}

struct EcsQseValDeep {
    ok: bool,
    state: EcsQseDeep,
}

fn ecs_qse_val_ok(v: EcsQseValDeep) -> bool { return v.ok; }
fn ecs_qse_val_state(v: EcsQseValDeep) -> EcsQseDeep { return v.state; }

fn ecs_qse_deep_validate_world(s: EcsQseDeep, world_id: i32) -> EcsQseValDeep {
    if s.world_id == world_id {
        return EcsQseValDeep { ok: true, state: s };
    };
    let s2 = ecs_qse_deep_rebuild(s.world_id, s.generation + 1, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
    return EcsQseValDeep { ok: false, state: s2 };
}

fn ecs_qse_deep_has_access(s: EcsQseDeep, cid: i32) -> bool {
    if s.rlen >= 1 { if s.r0 == cid { return true; }; };
    if s.rlen >= 2 { if s.r1 == cid { return true; }; };
    if s.rlen >= 3 { if s.r2 == cid { return true; }; };
    if s.rlen >= 4 { if s.r3 == cid { return true; }; };
    return false;
}

fn ecs_qse_deep_has_write(s: EcsQseDeep, cid: i32) -> bool {
    if s.is_readonly { return false; };
    if s.wlen >= 1 { if s.w0 == cid { return true; }; };
    if s.wlen >= 2 { if s.w1 == cid { return true; }; };
    if s.wlen >= 3 { if s.w2 == cid { return true; }; };
    if s.wlen >= 4 { if s.w3 == cid { return true; }; };
    return false;
}

// matches if any access id is in set (set = up to 4 ids packed)
fn ecs_qse_deep_matches_set(s: EcsQseDeep, c0: i32, c1: i32, c2: i32, c3: i32, clen: i32) -> bool {
    if clen >= 1 { if ecs_qse_deep_has_access(s, c0) { return true; }; };
    if clen >= 2 { if ecs_qse_deep_has_access(s, c1) { return true; }; };
    if clen >= 3 { if ecs_qse_deep_has_access(s, c2) { return true; }; };
    if clen >= 4 { if ecs_qse_deep_has_access(s, c3) { return true; }; };
    return false;
}

fn ecs_qse_deep_transmute(s: EcsQseDeep, new_generation: i32) -> EcsQseDeep {
    return ecs_qse_deep_rebuild(s.world_id, new_generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
}

fn ecs_qse_deep_join(s: EcsQseDeep, other_generation: i32) -> EcsQseDeep {
    return ecs_qse_deep_rebuild(s.world_id, s.generation + other_generation, s.is_readonly, s.r0, s.r1, s.r2, s.r3, s.rlen, s.w0, s.w1, s.w2, s.w3, s.wlen, s.t0, s.t1, s.t2, s.t3, s.tlen, s.a0, s.a1, s.a2, s.a3, s.alen);
}

fn ecs_qse_deep_table_at(s: EcsQseDeep, idx: i32) -> i32 {
    if idx == 0 { return s.t0; };
    if idx == 1 { return s.t1; };
    if idx == 2 { return s.t2; };
    if idx == 3 { return s.t3; };
    return -1;
}

fn ecs_qse_deep_archetype_at(s: EcsQseDeep, idx: i32) -> i32 {
    if idx == 0 { return s.a0; };
    if idx == 1 { return s.a1; };
    if idx == 2 { return s.a2; };
    if idx == 3 { return s.a3; };
    return -1;
}
