// Deep self-contained mirror of lib/task_scope_executor_drive.sla.
// Models Bevy TaskPool::scope_with_executor_inner branch selection and observable
// executor tick accounting over scalar task counts. No @import, no futures/wakers.

const ECS_SCOPE_DRIVE_DEEP_EXECUTE_SCOPE: i32 = 0;
const ECS_SCOPE_DRIVE_DEEP_GLOBAL_SCOPE: i32 = 1;
const ECS_SCOPE_DRIVE_DEEP_EXTERNAL_SCOPE: i32 = 2;
const ECS_SCOPE_DRIVE_DEEP_GLOBAL_EXTERNAL_SCOPE: i32 = 3;

@derive(copy)
struct EcsScopeExecutorDriveInputDeep {
    worker_count: i64,
    tick_task_pool_executor: i32,
    use_external_executor: i32,
    external_executor_is_scope: i32,
    pool_scope_tasks: i64,
    scope_executor_tasks: i64,
    external_executor_tasks: i64,
    unrelated_global_tasks: i64,
    executor_panic_count: i64,
}

@derive(copy)
struct EcsScopeExecutorDriveResultDeep {
    branch: i32,
    forced_pool_tick: i32,
    external_ticker_available: i32,
    ticked_pool_executor: i32,
    ticked_scope_executor: i32,
    ticked_external_executor: i32,
    pool_scope_completed_by_scope_ticks: i64,
    pool_scope_completed_by_workers: i64,
    scope_tick_count: i64,
    external_tick_count: i64,
    global_scope_tick_count: i64,
    unrelated_global_tick_count: i64,
    worker_completion_count: i64,
    executor_restart_count: i64,
    latency_tick_count: i64,
    completed_scope_tasks: i64,
}

fn _scope_drive_deep_nonnegative(v: i64) -> i64 {
    if v < 0 { return 0; };
    return v;
}

fn ecs_scope_executor_drive_input_deep(
    worker_count: i64,
    tick_task_pool_executor: bool,
    use_external_executor: bool,
    external_executor_is_scope: bool,
    pool_scope_tasks: i64,
    scope_executor_tasks: i64,
    external_executor_tasks: i64,
    unrelated_global_tasks: i64,
    executor_panic_count: i64,
) -> EcsScopeExecutorDriveInputDeep {
    let tick: i32 = 0;
    if tick_task_pool_executor { tick = 1; };
    let use_external: i32 = 0;
    if use_external_executor { use_external = 1; };
    let external_is_scope: i32 = 0;
    if external_executor_is_scope { external_is_scope = 1; };
    return EcsScopeExecutorDriveInputDeep {
        worker_count: _scope_drive_deep_nonnegative(worker_count),
        tick_task_pool_executor: tick,
        use_external_executor: use_external,
        external_executor_is_scope: external_is_scope,
        pool_scope_tasks: _scope_drive_deep_nonnegative(pool_scope_tasks),
        scope_executor_tasks: _scope_drive_deep_nonnegative(scope_executor_tasks),
        external_executor_tasks: _scope_drive_deep_nonnegative(external_executor_tasks),
        unrelated_global_tasks: _scope_drive_deep_nonnegative(unrelated_global_tasks),
        executor_panic_count: _scope_drive_deep_nonnegative(executor_panic_count),
    };
}

fn ecs_scope_executor_drive_result_deep(
    branch: i32,
    forced_pool_tick: bool,
    external_ticker_available: bool,
    ticked_pool_executor: bool,
    ticked_scope_executor: bool,
    ticked_external_executor: bool,
    pool_scope_completed_by_scope_ticks: i64,
    pool_scope_completed_by_workers: i64,
    scope_tick_count: i64,
    external_tick_count: i64,
    global_scope_tick_count: i64,
    unrelated_global_tick_count: i64,
    worker_completion_count: i64,
    executor_restart_count: i64,
    latency_tick_count: i64,
    completed_scope_tasks: i64,
) -> EcsScopeExecutorDriveResultDeep {
    let forced: i32 = 0;
    if forced_pool_tick { forced = 1; };
    let external: i32 = 0;
    if external_ticker_available { external = 1; };
    let ticked_pool: i32 = 0;
    if ticked_pool_executor { ticked_pool = 1; };
    let ticked_scope: i32 = 0;
    if ticked_scope_executor { ticked_scope = 1; };
    let ticked_external: i32 = 0;
    if ticked_external_executor { ticked_external = 1; };
    return EcsScopeExecutorDriveResultDeep {
        branch: branch,
        forced_pool_tick: forced,
        external_ticker_available: external,
        ticked_pool_executor: ticked_pool,
        ticked_scope_executor: ticked_scope,
        ticked_external_executor: ticked_external,
        pool_scope_completed_by_scope_ticks: pool_scope_completed_by_scope_ticks,
        pool_scope_completed_by_workers: pool_scope_completed_by_workers,
        scope_tick_count: scope_tick_count,
        external_tick_count: external_tick_count,
        global_scope_tick_count: global_scope_tick_count,
        unrelated_global_tick_count: unrelated_global_tick_count,
        worker_completion_count: worker_completion_count,
        executor_restart_count: executor_restart_count,
        latency_tick_count: latency_tick_count,
        completed_scope_tasks: completed_scope_tasks,
    };
}

fn ecs_scope_executor_drive_select_branch_deep(external_ticker_available: bool, tick_pool_executor: bool) -> i32 {
    if external_ticker_available {
        if tick_pool_executor { return ECS_SCOPE_DRIVE_DEEP_GLOBAL_EXTERNAL_SCOPE; };
        return ECS_SCOPE_DRIVE_DEEP_EXTERNAL_SCOPE;
    };
    if tick_pool_executor { return ECS_SCOPE_DRIVE_DEEP_GLOBAL_SCOPE; };
    return ECS_SCOPE_DRIVE_DEEP_EXECUTE_SCOPE;
}

fn ecs_scope_executor_drive_deep(input: EcsScopeExecutorDriveInputDeep) -> EcsScopeExecutorDriveResultDeep {
    let tick_input = input.tick_task_pool_executor != 0;
    let forced_pool_tick = input.worker_count == 0 && input.pool_scope_tasks > 0 && tick_input != true;
    let tick_pool_executor = tick_input || forced_pool_tick;
    let external_ticker_available = input.use_external_executor != 0 && input.external_executor_is_scope == 0;
    let branch = ecs_scope_executor_drive_select_branch_deep(external_ticker_available, tick_pool_executor);

    let scope_tick_count = input.scope_executor_tasks;
    if external_ticker_available != true {
        scope_tick_count = scope_tick_count + input.external_executor_tasks;
    };
    let external_tick_count: i64 = 0;
    if external_ticker_available {
        external_tick_count = input.external_executor_tasks;
    };

    let global_scope_tick_count: i64 = 0;
    let unrelated_global_tick_count: i64 = 0;
    let pool_scope_completed_by_scope_ticks: i64 = 0;
    let pool_scope_completed_by_workers: i64 = 0;
    let worker_completion_count: i64 = 0;
    if tick_pool_executor {
        global_scope_tick_count = input.pool_scope_tasks;
        unrelated_global_tick_count = input.unrelated_global_tasks;
        pool_scope_completed_by_scope_ticks = input.pool_scope_tasks;
    } else {
        pool_scope_completed_by_workers = input.pool_scope_tasks;
        worker_completion_count = input.pool_scope_tasks;
    };

    let ticked_pool_executor = global_scope_tick_count > 0 || unrelated_global_tick_count > 0;
    let ticked_scope_executor = scope_tick_count > 0;
    let ticked_external_executor = external_tick_count > 0;
    let latency_tick_count = scope_tick_count + external_tick_count + global_scope_tick_count + unrelated_global_tick_count;
    let completed_scope_tasks = input.pool_scope_tasks + input.scope_executor_tasks + input.external_executor_tasks;

    return ecs_scope_executor_drive_result_deep(
        branch,
        forced_pool_tick,
        external_ticker_available,
        ticked_pool_executor,
        ticked_scope_executor,
        ticked_external_executor,
        pool_scope_completed_by_scope_ticks,
        pool_scope_completed_by_workers,
        scope_tick_count,
        external_tick_count,
        global_scope_tick_count,
        unrelated_global_tick_count,
        worker_completion_count,
        input.executor_panic_count,
        latency_tick_count,
        completed_scope_tasks,
    );
}

fn ecs_scope_executor_drive_deep_branch(r: EcsScopeExecutorDriveResultDeep) -> i32 { return r.branch; }
fn ecs_scope_executor_drive_deep_forced_pool_tick(r: EcsScopeExecutorDriveResultDeep) -> bool { return r.forced_pool_tick != 0; }
fn ecs_scope_executor_drive_deep_external_ticker_available(r: EcsScopeExecutorDriveResultDeep) -> bool { return r.external_ticker_available != 0; }
fn ecs_scope_executor_drive_deep_ticked_pool_executor(r: EcsScopeExecutorDriveResultDeep) -> bool { return r.ticked_pool_executor != 0; }
fn ecs_scope_executor_drive_deep_ticked_scope_executor(r: EcsScopeExecutorDriveResultDeep) -> bool { return r.ticked_scope_executor != 0; }
fn ecs_scope_executor_drive_deep_ticked_external_executor(r: EcsScopeExecutorDriveResultDeep) -> bool { return r.ticked_external_executor != 0; }
fn ecs_scope_executor_drive_deep_pool_completed_by_scope_ticks(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.pool_scope_completed_by_scope_ticks; }
fn ecs_scope_executor_drive_deep_pool_completed_by_workers(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.pool_scope_completed_by_workers; }
fn ecs_scope_executor_drive_deep_scope_tick_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.scope_tick_count; }
fn ecs_scope_executor_drive_deep_external_tick_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.external_tick_count; }
fn ecs_scope_executor_drive_deep_global_scope_tick_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.global_scope_tick_count; }
fn ecs_scope_executor_drive_deep_unrelated_global_tick_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.unrelated_global_tick_count; }
fn ecs_scope_executor_drive_deep_worker_completion_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.worker_completion_count; }
fn ecs_scope_executor_drive_deep_executor_restart_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.executor_restart_count; }
fn ecs_scope_executor_drive_deep_latency_tick_count(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.latency_tick_count; }
fn ecs_scope_executor_drive_deep_completed_scope_tasks(r: EcsScopeExecutorDriveResultDeep) -> i64 { return r.completed_scope_tasks; }
