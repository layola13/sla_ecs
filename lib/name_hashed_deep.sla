// Deepened Bevy ECS Name + HashedStr.
// Mirrors src/name.rs:
//   HashedStr new/set/as_str/pre_hash/eq
//   Name new/set/mutate/as_str/pre_hash/eq
//   NameOrEntity name/entity variants
// Shallow lib/name_hashed.sla retained.

struct EcsNhHashDeep {
    value: i64,
    hash: i64,
}

fn ecs_nh_hash_fn(value: i64) -> i64 {
    // FNV-ish simple mix: value * 16777619 xor value
    return (value * 16777619) - value;
}

fn ecs_nh_hashed_new(value: i64) -> EcsNhHashDeep {
    return EcsNhHashDeep { value: value, hash: ecs_nh_hash_fn(value) };
}

fn ecs_nh_hashed_value(h: EcsNhHashDeep) -> i64 { return h.value; }
fn ecs_nh_hashed_pre_hash(h: EcsNhHashDeep) -> i64 { return h.hash; }

fn ecs_nh_hashed_set(h: EcsNhHashDeep, value: i64) -> EcsNhHashDeep {
    return EcsNhHashDeep { value: value, hash: ecs_nh_hash_fn(value) };
}

fn ecs_nh_hashed_eq(a: EcsNhHashDeep, b: EcsNhHashDeep) -> bool {
    if a.hash != b.hash { return false; };
    return a.value == b.value;
}

fn ecs_nh_hashed_eq_str(a: EcsNhHashDeep, value: i64) -> bool {
    return a.value == value;
}

struct EcsNhNameDeep {
    value: i64,
    hash: i64,
}

fn ecs_nh_name_new(value: i64) -> EcsNhNameDeep {
    return EcsNhNameDeep { value: value, hash: ecs_nh_hash_fn(value) };
}

fn ecs_nh_name_as_str(n: EcsNhNameDeep) -> i64 { return n.value; }
fn ecs_nh_name_pre_hash(n: EcsNhNameDeep) -> i64 { return n.hash; }

fn ecs_nh_name_set(n: EcsNhNameDeep, value: i64) -> EcsNhNameDeep {
    return EcsNhNameDeep { value: value, hash: ecs_nh_hash_fn(value) };
}

fn ecs_nh_name_mutate(n: EcsNhNameDeep, offset: i64) -> EcsNhNameDeep {
    return ecs_nh_name_set(n, n.value + offset);
}

fn ecs_nh_name_eq(a: EcsNhNameDeep, b: EcsNhNameDeep) -> bool {
    if a.hash != b.hash { return false; };
    return a.value == b.value;
}

fn ecs_nh_name_from_hashed(h: EcsNhHashDeep) -> EcsNhNameDeep {
    return EcsNhNameDeep { value: h.value, hash: h.hash };
}

fn ecs_nh_name_to_hashed(n: EcsNhNameDeep) -> EcsNhHashDeep {
    return EcsNhHashDeep { value: n.value, hash: n.hash };
}

const ECS_NH_KIND_NAME: i32 = 0;
const ECS_NH_KIND_ENTITY: i32 = 1;

struct EcsNhNoeDeep {
    kind: i32,
    value: i64,
}

fn ecs_nh_noe_name(value: i64) -> EcsNhNoeDeep {
    return EcsNhNoeDeep { kind: ECS_NH_KIND_NAME, value: value };
}

fn ecs_nh_noe_entity(entity: i64) -> EcsNhNoeDeep {
    return EcsNhNoeDeep { kind: ECS_NH_KIND_ENTITY, value: entity };
}

fn ecs_nh_noe_kind(n: EcsNhNoeDeep) -> i32 { return n.kind; }
fn ecs_nh_noe_value(n: EcsNhNoeDeep) -> i64 { return n.value; }
fn ecs_nh_noe_is_name(n: EcsNhNoeDeep) -> bool { return n.kind == ECS_NH_KIND_NAME; }
fn ecs_nh_noe_is_entity(n: EcsNhNoeDeep) -> bool { return n.kind == ECS_NH_KIND_ENTITY; }

fn ecs_nh_noe_eq(a: EcsNhNoeDeep, b: EcsNhNoeDeep) -> bool {
    if a.kind != b.kind { return false; };
    return a.value == b.value;
}

// display helper: prefer name, else entity id
fn ecs_nh_noe_display(n: EcsNhNoeDeep) -> i64 {
    return n.value;
}

fn ecs_nh_kind_name() -> i32 { return ECS_NH_KIND_NAME; }
fn ecs_nh_kind_entity() -> i32 { return ECS_NH_KIND_ENTITY; }
