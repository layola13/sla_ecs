// Deepened Bevy ECS Storages container.
// Mirrors src/storage/mod.rs Storages + prepare_component dispatch,
// and integrates fixed-slot SparseSets/Tables/NonSends counters.
// Shallow lib/storages.sla retained.
// StorageType: Table=0, SparseSet=1. NonSend tracked separately.

struct EcsStDeep {
    // prepared components capacity 8
    p_len: i32,
    p_id0: i32, p_k0: i32,
    p_id1: i32, p_k1: i32,
    p_id2: i32, p_k2: i32,
    p_id3: i32, p_k3: i32,
    p_id4: i32, p_k4: i32,
    p_id5: i32, p_k5: i32,
    p_id6: i32, p_k6: i32,
    p_id7: i32, p_k7: i32,
    sparse_set_count: i32,
    table_count: i32,
    non_send_count: i32,
    // sparse set insertion order ids (component ids prepared as SparseSet)
    ss_len: i32,
    ss0: i32, ss1: i32, ss2: i32, ss3: i32,
}

fn ecs_st_storage_table() -> i32 { return 0; }
fn ecs_st_storage_sparse() -> i32 { return 1; }

fn ecs_st_new() -> EcsStDeep {
    return EcsStDeep {
        p_len: 0,
        p_id0: -1, p_k0: -1, p_id1: -1, p_k1: -1, p_id2: -1, p_k2: -1, p_id3: -1, p_k3: -1,
        p_id4: -1, p_k4: -1, p_id5: -1, p_k5: -1, p_id6: -1, p_k6: -1, p_id7: -1, p_k7: -1,
        sparse_set_count: 0, table_count: 0, non_send_count: 0,
        ss_len: 0, ss0: -1, ss1: -1, ss2: -1, ss3: -1,
    };
}

fn ecs_st_sparse_set_count(s: EcsStDeep) -> i32 { return s.sparse_set_count; }
fn ecs_st_table_count(s: EcsStDeep) -> i32 { return s.table_count; }
fn ecs_st_non_send_count(s: EcsStDeep) -> i32 { return s.non_send_count; }
fn ecs_st_prepared_len(s: EcsStDeep) -> i32 { return s.p_len; }

fn ecs_st_is_prepared(s: EcsStDeep, component_id: i32) -> bool {
    if s.p_len >= 1 { if s.p_id0 == component_id { return true; }; };
    if s.p_len >= 2 { if s.p_id1 == component_id { return true; }; };
    if s.p_len >= 3 { if s.p_id2 == component_id { return true; }; };
    if s.p_len >= 4 { if s.p_id3 == component_id { return true; }; };
    if s.p_len >= 5 { if s.p_id4 == component_id { return true; }; };
    if s.p_len >= 6 { if s.p_id5 == component_id { return true; }; };
    if s.p_len >= 7 { if s.p_id6 == component_id { return true; }; };
    if s.p_len >= 8 { if s.p_id7 == component_id { return true; }; };
    return false;
}

fn ecs_st_get_prepared_kind(s: EcsStDeep, component_id: i32) -> (bool, i32) {
    if s.p_len >= 1 { if s.p_id0 == component_id { return (true, s.p_k0); }; };
    if s.p_len >= 2 { if s.p_id1 == component_id { return (true, s.p_k1); }; };
    if s.p_len >= 3 { if s.p_id2 == component_id { return (true, s.p_k2); }; };
    if s.p_len >= 4 { if s.p_id3 == component_id { return (true, s.p_k3); }; };
    if s.p_len >= 5 { if s.p_id4 == component_id { return (true, s.p_k4); }; };
    if s.p_len >= 6 { if s.p_id5 == component_id { return (true, s.p_k5); }; };
    if s.p_len >= 7 { if s.p_id6 == component_id { return (true, s.p_k6); }; };
    if s.p_len >= 8 { if s.p_id7 == component_id { return (true, s.p_k7); }; };
    return (false, -1);
}

fn ecs_st_append_prepared(s: EcsStDeep, component_id: i32, kind: i32) -> EcsStDeep {
    if s.p_len >= 8 { return s; };
    if s.p_len == 0 {
        return EcsStDeep {
            p_len: 1, p_id0: component_id, p_k0: kind,
            p_id1: s.p_id1, p_k1: s.p_k1, p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: s.ss_len, ss0: s.ss0, ss1: s.ss1, ss2: s.ss2, ss3: s.ss3,
        };
    };
    if s.p_len == 1 {
        return EcsStDeep {
            p_len: 2, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: component_id, p_k1: kind,
            p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: s.ss_len, ss0: s.ss0, ss1: s.ss1, ss2: s.ss2, ss3: s.ss3,
        };
    };
    if s.p_len == 2 {
        return EcsStDeep {
            p_len: 3, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
            p_id2: component_id, p_k2: kind, p_id3: s.p_id3, p_k3: s.p_k3,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: s.ss_len, ss0: s.ss0, ss1: s.ss1, ss2: s.ss2, ss3: s.ss3,
        };
    };
    if s.p_len == 3 {
        return EcsStDeep {
            p_len: 4, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
            p_id2: s.p_id2, p_k2: s.p_k2, p_id3: component_id, p_k3: kind,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: s.ss_len, ss0: s.ss0, ss1: s.ss1, ss2: s.ss2, ss3: s.ss3,
        };
    };
    return s;
}

fn ecs_st_push_sparse_id(s: EcsStDeep, component_id: i32) -> EcsStDeep {
    if s.ss_len >= 4 { return s; };
    if s.ss_len == 0 {
        return EcsStDeep {
            p_len: s.p_len, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
            p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: 1, ss0: component_id, ss1: s.ss1, ss2: s.ss2, ss3: s.ss3,
        };
    };
    if s.ss_len == 1 {
        return EcsStDeep {
            p_len: s.p_len, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
            p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: 2, ss0: s.ss0, ss1: component_id, ss2: s.ss2, ss3: s.ss3,
        };
    };
    if s.ss_len == 2 {
        return EcsStDeep {
            p_len: s.p_len, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
            p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
            p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
            sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
            ss_len: 3, ss0: s.ss0, ss1: s.ss1, ss2: component_id, ss3: s.ss3,
        };
    };
    return EcsStDeep {
        p_len: s.p_len, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
        p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
        p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
        sparse_set_count: s.sparse_set_count, table_count: s.table_count, non_send_count: s.non_send_count,
        ss_len: 4, ss0: s.ss0, ss1: s.ss1, ss2: s.ss2, ss3: component_id,
    };
}

fn ecs_st_with_counts(s: EcsStDeep, sparse: i32, table: i32, non_send: i32) -> EcsStDeep {
    return EcsStDeep {
        p_len: s.p_len, p_id0: s.p_id0, p_k0: s.p_k0, p_id1: s.p_id1, p_k1: s.p_k1,
        p_id2: s.p_id2, p_k2: s.p_k2, p_id3: s.p_id3, p_k3: s.p_k3,
        p_id4: s.p_id4, p_k4: s.p_k4, p_id5: s.p_id5, p_k5: s.p_k5, p_id6: s.p_id6, p_k6: s.p_k6, p_id7: s.p_id7, p_k7: s.p_k7,
        sparse_set_count: sparse, table_count: table, non_send_count: non_send,
        ss_len: s.ss_len, ss0: s.ss0, ss1: s.ss1, ss2: s.ss2, ss3: s.ss3,
    };
}

// prepare_component: Table no-op on sparse; SparseSet get_or_insert
fn ecs_st_prepare_component(s: EcsStDeep, component_id: i32, storage_type: i32) -> (EcsStDeep, i32) {
    if ecs_st_is_prepared(s, component_id) {
        return (s, storage_type);
    };
    let out = ecs_st_append_prepared(s, component_id, storage_type);
    if storage_type == ecs_st_storage_sparse() {
        let sc = out.sparse_set_count + 1;
        let tc = out.table_count;
        let nc = out.non_send_count;
        let out2 = ecs_st_with_counts(out, sc, tc, nc);
        let out3 = ecs_st_push_sparse_id(out2, component_id);
        return (out3, storage_type);
    };
    // Table: record prepare only (table_count not bumped by prepare)
    return (out, storage_type);
}

// register_table_component: models Tables creating a column path / table growth bookkeeping
fn ecs_st_register_table(s: EcsStDeep) -> EcsStDeep {
    return ecs_st_with_counts(s, s.sparse_set_count, s.table_count + 1, s.non_send_count);
}

fn ecs_st_register_non_send(s: EcsStDeep) -> EcsStDeep {
    return ecs_st_with_counts(s, s.sparse_set_count, s.table_count, s.non_send_count + 1);
}

struct EcsStSparseGet {
    found: bool,
    index: i32,
}

fn ecs_st_sparse_get_found(r: EcsStSparseGet) -> bool { return r.found; }
fn ecs_st_sparse_get_index(r: EcsStSparseGet) -> i32 { return r.index; }

struct EcsStSparseIter {
    ok: bool,
    component_id: i32,
    index: i32,
}

fn ecs_st_sparse_iter_ok(r: EcsStSparseIter) -> bool { return r.ok; }
fn ecs_st_sparse_iter_cid(r: EcsStSparseIter) -> i32 { return r.component_id; }
fn ecs_st_sparse_iter_index(r: EcsStSparseIter) -> i32 { return r.index; }

fn ecs_st_sparse_sets_is_empty(s: EcsStDeep) -> bool {
    if s.sparse_set_count == 0 { return true; };
    return false;
}
fn ecs_st_tables_is_empty(s: EcsStDeep) -> bool {
    if s.table_count == 0 { return true; };
    return false;
}
fn ecs_st_non_sends_is_empty(s: EcsStDeep) -> bool {
    if s.non_send_count == 0 { return true; };
    return false;
}

// SparseSets::get -> insertion index among sparse prepared
fn ecs_st_sparse_get(s: EcsStDeep, component_id: i32) -> EcsStSparseGet {
    if s.ss_len >= 1 {
        if s.ss0 == component_id {
            return EcsStSparseGet { found: true, index: 0 };
        };
    };
    if s.ss_len >= 2 {
        if s.ss1 == component_id {
            return EcsStSparseGet { found: true, index: 1 };
        };
    };
    if s.ss_len >= 3 {
        if s.ss2 == component_id {
            return EcsStSparseGet { found: true, index: 2 };
        };
    };
    if s.ss_len >= 4 {
        if s.ss3 == component_id {
            return EcsStSparseGet { found: true, index: 3 };
        };
    };
    return EcsStSparseGet { found: false, index: -1 };
}

fn ecs_st_sparse_iter_at(s: EcsStDeep, index: i32) -> EcsStSparseIter {
    if index < 0 || index >= s.ss_len {
        return EcsStSparseIter { ok: false, component_id: -1, index: -1 };
    };
    if index == 0 {
        return EcsStSparseIter { ok: true, component_id: s.ss0, index: 0 };
    };
    if index == 1 {
        return EcsStSparseIter { ok: true, component_id: s.ss1, index: 1 };
    };
    if index == 2 {
        return EcsStSparseIter { ok: true, component_id: s.ss2, index: 2 };
    };
    if index == 3 {
        return EcsStSparseIter { ok: true, component_id: s.ss3, index: 3 };
    };
    return EcsStSparseIter { ok: false, component_id: -1, index: -1 };
}

fn ecs_st_sparse_len(s: EcsStDeep) -> i32 { return s.ss_len; }
