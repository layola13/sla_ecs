fn _ecs_sto_id_lists_conflict(left: EcsStoAccess, left_is_rel: i32, right: EcsStoAccess) -> bool {
    let i: i32 = 0;
    if left_is_rel == 0 {
        while i < left.wc_count { let id = _ecs_sto_wc_at(left, i); if _ecs_sto_list_has(right, 0, id) { return true; }; if _ecs_sto_list_has(right, 1, id) { return true; }; i = i + 1; }
        i = 0; while i < right.wc_count { let id = _ecs_sto_wc_at(right, i); if _ecs_sto_list_has(left, 0, id) { return true; }; if _ecs_sto_list_has(left, 1, id) { return true; }; i = i + 1; }
