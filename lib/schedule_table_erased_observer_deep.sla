    return false;
}
fn ecs_sto_access_conflicts(left: EcsStoAccess, right: EcsStoAccess) -> bool {
    if _ecs_sto_id_lists_conflict(left, 0, right) { return true; };
    if _ecs_sto_id_lists_conflict(left, 1, right) { return true; };
    if left.writes_resource == 1 { if right.reads_resource == 1 { return true; }; if right.writes_resource == 1 { return true; }; };
    if right.writes_resource == 1 { if left.reads_resource == 1 { return true; }; if left.writes_resource == 1 { return true; }; };
    if left.writes_messages == 1 { if right.reads_messages == 1 { return true; }; if right.writes_messages == 1 { return true; }; };
    if right.writes_messages == 1 { if left.reads_messages == 1 { return true; }; if left.writes_messages == 1 { return true; }; };
    return false;
}

