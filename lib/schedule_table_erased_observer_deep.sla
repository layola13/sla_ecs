fn _ecs_sto_list_has(a: EcsStoAccess, fam: i32, id: i32) -> bool {
    let i: i32 = 0;
    if fam == 0 { while i < a.rc_count { if _ecs_sto_rc_at(a, i) == id { return true; }; i = i + 1; } return false; };
