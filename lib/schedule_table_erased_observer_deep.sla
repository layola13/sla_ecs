fn ecs_sto_schedule_system_batch(s: EcsStoSchedule, idx: i32) -> i32 {
    if idx < 0 { return -1; }; if idx >= s.count { return -1; };
    if idx == 0 { return s.batch0; };
    if idx == 1 { return s.batch1; };
    if idx == 2 { return s.batch2; };
    if idx == 3 { return s.batch3; };
    if idx == 4 { return s.batch4; };
    if idx == 5 { return s.batch5; };
    if idx == 6 { return s.batch6; };
    return s.batch7;
}
fn ecs_sto_schedule_kind_at(s: EcsStoSchedule, idx: i32) -> i32 {
    if idx < 0 { return -1; }; if idx >= s.count { return -1; };
    if idx == 0 { return s.kind0; };
    if idx == 1 { return s.kind1; };
    if idx == 2 { return s.kind2; };
    if idx == 3 { return s.kind3; };
    if idx == 4 { return s.kind4; };
    if idx == 5 { return s.kind5; };
    if idx == 6 { return s.kind6; };
    return s.kind7;
}
fn ecs_sto_schedule_batch_width(s: EcsStoSchedule, batch_id: i32) -> i32 { let c: i32 = 0; let i: i32 = 0; while i < s.count { if ecs_sto_schedule_system_batch(s, i) == batch_id { c = c + 1; }; i = i + 1; } return c; }
fn ecs_sto_schedule_max_parallel_width(s: EcsStoSchedule) -> i32 { let max: i32 = 0; let b: i32 = 0; while b < s.batch_count { let w = ecs_sto_schedule_batch_width(s, b); if w > max { max = w; }; b = b + 1; } return max; }
fn _ecs_sto_schedule_batch_accepts(s: EcsStoSchedule, batch_id: i32, a: EcsStoAccess) -> bool { let i: i32 = 0; while i < s.count { if ecs_sto_schedule_system_batch(s, i) == batch_id { if ecs_sto_access_conflicts(_ecs_sto_schedule_access_at(s, i), a) { return false; }; }; i = i + 1; } return true; }
fn _ecs_sto_schedule_choose_batch(s: EcsStoSchedule, a: EcsStoAccess) -> i32 { let b: i32 = 0; while b < s.batch_count { if _ecs_sto_schedule_batch_accepts(s, b, a) { return b; }; b = b + 1; } return s.batch_count; }
fn ecs_sto_schedule_add_system(s: EcsStoSchedule, kind: i32, a: EcsStoAccess) -> EcsStoSchedule {
    let i: i32 = 0; while i < s.count { if ecs_sto_access_conflicts(_ecs_sto_schedule_access_at(s, i), a) { s.conflict_count = s.conflict_count + 1; }; i = i + 1; }
    let batch = _ecs_sto_schedule_choose_batch(s, a);
    if batch == s.batch_count { s.batch_count = s.batch_count + 1; };
    if s.count >= ECS_STO_CAP { return s; };
    s = _ecs_sto_schedule_set_slot(s, s.count, kind, batch, a);
    s.count = s.count + 1; return s;
}
fn _ecs_sto_run_system(kind: i32, w: EcsStoWorld) -> EcsStoWorld {
    if kind == ECS_STO_SYS_MOVE { w.pos_x = w.pos_x + w.vel_x; return w; };
    if kind == ECS_STO_SYS_OBS_COUNT { w.resource_tick = w.observer_count; return w; };
    if kind == ECS_STO_SYS_MESSAGE { w.message_count = w.message_count + 1; w.last_message = w.change_tick; return w; };
    if kind == ECS_STO_SYS_TRIGGER_PING { w.observer_count = 1; w.observed = 1; return w; };
    return w;
}
fn ecs_sto_schedule_run(s: EcsStoSchedule, w: EcsStoWorld) -> EcsStoWorld { w.change_tick = w.change_tick + 1; let i: i32 = 0; while i < s.count { w = _ecs_sto_run_system(ecs_sto_schedule_kind_at(s, i), w); i = i + 1; } return w; }
fn ecs_sto_schedule_run_planned(s: EcsStoSchedule, w: EcsStoWorld) -> EcsStoWorld { w.change_tick = w.change_tick + 1; let b: i32 = 0; while b < s.batch_count { let i: i32 = 0; while i < s.count { if ecs_sto_schedule_system_batch(s, i) == b { w = _ecs_sto_run_system(ecs_sto_schedule_kind_at(s, i), w); }; i = i + 1; } b = b + 1; } return w; }
