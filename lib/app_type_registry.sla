// Bevy ECS reflect::AppTypeRegistry / AppFunctionRegistry shape parity.
// This is a descriptor registry for ECS-facing reflection type data, not a full
// bevy_reflect runtime type system.

const ECS_APP_TYPE_DATA_COMPONENT: i32 = 1;
const ECS_APP_TYPE_DATA_RESOURCE: i32 = 2;
const ECS_APP_TYPE_DATA_EVENT: i32 = 3;
const ECS_APP_TYPE_DATA_MESSAGE: i32 = 4;
const ECS_APP_TYPE_DATA_BUNDLE: i32 = 5;
const ECS_APP_TYPE_DATA_FROM_WORLD: i32 = 6;
const ECS_APP_TYPE_DATA_MAP_ENTITIES: i32 = 7;

@derive(copy)
struct EcsAppTypeDescriptor {
    type_id: i64,
    type_path: i64,
    short_type_path: i64,
    has_component: bool,
    component_data: i64,
    has_resource: bool,
    resource_data: i64,
    has_event: bool,
    event_data: i64,
    has_message: bool,
    message_data: i64,
    has_bundle: bool,
    bundle_data: i64,
    has_from_world: bool,
    from_world_data: i64,
    has_map_entities: bool,
    map_entities_data: i64,
}

@derive(copy)
struct EcsAppTypeDescriptorResult {
    has: bool,
    descriptor: EcsAppTypeDescriptor,
}

@derive(copy)
struct EcsAppTypeDataResult {
    has: bool,
    data: i64,
}

struct EcsAppTypeRegistry {
    types: Vec<EcsAppTypeDescriptor>,
}

fn ecs_app_type_descriptor_new(type_id: i64, type_path: i64, short_type_path: i64) -> EcsAppTypeDescriptor {
    return EcsAppTypeDescriptor {
        type_id: type_id,
        type_path: type_path,
        short_type_path: short_type_path,
        has_component: false,
        component_data: 0,
        has_resource: false,
        resource_data: 0,
        has_event: false,
        event_data: 0,
        has_message: false,
        message_data: 0,
        has_bundle: false,
        bundle_data: 0,
        has_from_world: false,
        from_world_data: 0,
        has_map_entities: false,
        map_entities_data: 0,
    };
}

fn ecs_app_type_descriptor_type_id(d: EcsAppTypeDescriptor) -> i64 { return d.type_id; }
fn ecs_app_type_descriptor_type_path(d: EcsAppTypeDescriptor) -> i64 { return d.type_path; }
fn ecs_app_type_descriptor_short_type_path(d: EcsAppTypeDescriptor) -> i64 { return d.short_type_path; }

fn ecs_app_type_descriptor_with_type_data(d: EcsAppTypeDescriptor, kind: i32, data: i64) -> EcsAppTypeDescriptor {
    if kind == ECS_APP_TYPE_DATA_COMPONENT { d.has_component = true; d.component_data = data; return d; };
    if kind == ECS_APP_TYPE_DATA_RESOURCE { d.has_resource = true; d.resource_data = data; return d; };
    if kind == ECS_APP_TYPE_DATA_EVENT { d.has_event = true; d.event_data = data; return d; };
    if kind == ECS_APP_TYPE_DATA_MESSAGE { d.has_message = true; d.message_data = data; return d; };
    if kind == ECS_APP_TYPE_DATA_BUNDLE { d.has_bundle = true; d.bundle_data = data; return d; };
    if kind == ECS_APP_TYPE_DATA_FROM_WORLD { d.has_from_world = true; d.from_world_data = data; return d; };
    if kind == ECS_APP_TYPE_DATA_MAP_ENTITIES { d.has_map_entities = true; d.map_entities_data = data; return d; };
    return d;
}

fn ecs_app_type_descriptor_has_type_data(d: EcsAppTypeDescriptor, kind: i32) -> bool {
    if kind == ECS_APP_TYPE_DATA_COMPONENT { return d.has_component; };
    if kind == ECS_APP_TYPE_DATA_RESOURCE { return d.has_resource; };
    if kind == ECS_APP_TYPE_DATA_EVENT { return d.has_event; };
    if kind == ECS_APP_TYPE_DATA_MESSAGE { return d.has_message; };
    if kind == ECS_APP_TYPE_DATA_BUNDLE { return d.has_bundle; };
    if kind == ECS_APP_TYPE_DATA_FROM_WORLD { return d.has_from_world; };
    if kind == ECS_APP_TYPE_DATA_MAP_ENTITIES { return d.has_map_entities; };
    return false;
}

fn ecs_app_type_descriptor_type_data(d: EcsAppTypeDescriptor, kind: i32) -> EcsAppTypeDataResult {
    if kind == ECS_APP_TYPE_DATA_COMPONENT { return EcsAppTypeDataResult { has: d.has_component, data: d.component_data }; };
    if kind == ECS_APP_TYPE_DATA_RESOURCE { return EcsAppTypeDataResult { has: d.has_resource, data: d.resource_data }; };
    if kind == ECS_APP_TYPE_DATA_EVENT { return EcsAppTypeDataResult { has: d.has_event, data: d.event_data }; };
    if kind == ECS_APP_TYPE_DATA_MESSAGE { return EcsAppTypeDataResult { has: d.has_message, data: d.message_data }; };
    if kind == ECS_APP_TYPE_DATA_BUNDLE { return EcsAppTypeDataResult { has: d.has_bundle, data: d.bundle_data }; };
    if kind == ECS_APP_TYPE_DATA_FROM_WORLD { return EcsAppTypeDataResult { has: d.has_from_world, data: d.from_world_data }; };
    if kind == ECS_APP_TYPE_DATA_MAP_ENTITIES { return EcsAppTypeDataResult { has: d.has_map_entities, data: d.map_entities_data }; };
    return EcsAppTypeDataResult { has: false, data: 0 };
}

fn ecs_app_type_descriptor_empty_result() -> EcsAppTypeDescriptorResult {
    return EcsAppTypeDescriptorResult { has: false, descriptor: ecs_app_type_descriptor_new(0, 0, 0) };
}

fn ecs_app_type_registry_new() -> EcsAppTypeRegistry {
    return EcsAppTypeRegistry { types: Vec::new() };
}

fn ecs_app_type_registry_len(r: EcsAppTypeRegistry) -> i64 { return len(r.types) as i64; }
fn ecs_app_type_registry_is_empty(r: EcsAppTypeRegistry) -> bool { return len(r.types) == 0; }

fn ecs_app_type_registry_find_index(r: EcsAppTypeRegistry, type_id: i64) -> i64 {
    let i = 0;
    let cnt = len(r.types) as i64;
    while i < cnt {
        if r.types[i].type_id == type_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_app_type_registry_contains(r: EcsAppTypeRegistry, type_id: i64) -> bool {
    return ecs_app_type_registry_find_index(r, type_id) >= 0;
}

fn ecs_app_type_registry_register_or_replace(r: EcsAppTypeRegistry, d: EcsAppTypeDescriptor) -> EcsAppTypeRegistry {
    let index = ecs_app_type_registry_find_index(r, d.type_id);
    if index >= 0 {
        r.types[index] = d;
        return r;
    };
    r.types.push(d);
    return r;
}

fn ecs_app_type_registry_get(r: EcsAppTypeRegistry, type_id: i64) -> EcsAppTypeDescriptorResult {
    let index = ecs_app_type_registry_find_index(r, type_id);
    if index < 0 { return ecs_app_type_descriptor_empty_result(); };
    return EcsAppTypeDescriptorResult { has: true, descriptor: r.types[index] };
}

fn ecs_app_type_registry_at(r: EcsAppTypeRegistry, index: i64) -> EcsAppTypeDescriptorResult {
    if index < 0 { return ecs_app_type_descriptor_empty_result(); };
    if index >= len(r.types) as i64 { return ecs_app_type_descriptor_empty_result(); };
    return EcsAppTypeDescriptorResult { has: true, descriptor: r.types[index] };
}

fn ecs_app_type_registry_register_type_data(r: EcsAppTypeRegistry, type_id: i64, kind: i32, data: i64) -> EcsAppTypeRegistry {
    let found = ecs_app_type_registry_get(r, type_id);
    if found.has != true { return r; };
    let d = ecs_app_type_descriptor_with_type_data(found.descriptor, kind, data);
    return ecs_app_type_registry_register_or_replace(r, d);
}

fn ecs_app_type_registry_has_type_data(r: EcsAppTypeRegistry, type_id: i64, kind: i32) -> bool {
    let found = ecs_app_type_registry_get(r, type_id);
    if found.has != true { return false; };
    return ecs_app_type_descriptor_has_type_data(found.descriptor, kind);
}

fn ecs_app_type_registry_type_data(r: EcsAppTypeRegistry, type_id: i64, kind: i32) -> EcsAppTypeDataResult {
    let found = ecs_app_type_registry_get(r, type_id);
    if found.has != true { return EcsAppTypeDataResult { has: false, data: 0 }; };
    return ecs_app_type_descriptor_type_data(found.descriptor, kind);
}

@derive(copy)
struct EcsAppFunctionDescriptor {
    function_id: i64,
    name: i64,
    function_handle: i64,
}

@derive(copy)
struct EcsAppFunctionDescriptorResult {
    has: bool,
    descriptor: EcsAppFunctionDescriptor,
}

struct EcsAppFunctionRegistry {
    functions: Vec<EcsAppFunctionDescriptor>,
}

fn ecs_app_function_descriptor_new(function_id: i64, name: i64, function_handle: i64) -> EcsAppFunctionDescriptor {
    return EcsAppFunctionDescriptor { function_id: function_id, name: name, function_handle: function_handle };
}

fn ecs_app_function_descriptor_empty_result() -> EcsAppFunctionDescriptorResult {
    return EcsAppFunctionDescriptorResult { has: false, descriptor: ecs_app_function_descriptor_new(0, 0, 0) };
}

fn ecs_app_function_registry_new() -> EcsAppFunctionRegistry {
    return EcsAppFunctionRegistry { functions: Vec::new() };
}

fn ecs_app_function_registry_len(r: EcsAppFunctionRegistry) -> i64 { return len(r.functions) as i64; }
fn ecs_app_function_registry_is_empty(r: EcsAppFunctionRegistry) -> bool { return len(r.functions) == 0; }

fn ecs_app_function_registry_find_index(r: EcsAppFunctionRegistry, function_id: i64) -> i64 {
    let i = 0;
    let cnt = len(r.functions) as i64;
    while i < cnt {
        if r.functions[i].function_id == function_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_app_function_registry_contains(r: EcsAppFunctionRegistry, function_id: i64) -> bool {
    return ecs_app_function_registry_find_index(r, function_id) >= 0;
}

fn ecs_app_function_registry_register_or_replace(r: EcsAppFunctionRegistry, d: EcsAppFunctionDescriptor) -> EcsAppFunctionRegistry {
    let index = ecs_app_function_registry_find_index(r, d.function_id);
    if index >= 0 {
        r.functions[index] = d;
        return r;
    };
    r.functions.push(d);
    return r;
}

fn ecs_app_function_registry_get(r: EcsAppFunctionRegistry, function_id: i64) -> EcsAppFunctionDescriptorResult {
    let index = ecs_app_function_registry_find_index(r, function_id);
    if index < 0 { return ecs_app_function_descriptor_empty_result(); };
    return EcsAppFunctionDescriptorResult { has: true, descriptor: r.functions[index] };
}

fn ecs_app_function_registry_at(r: EcsAppFunctionRegistry, index: i64) -> EcsAppFunctionDescriptorResult {
    if index < 0 { return ecs_app_function_descriptor_empty_result(); };
    if index >= len(r.functions) as i64 { return ecs_app_function_descriptor_empty_result(); };
    return EcsAppFunctionDescriptorResult { has: true, descriptor: r.functions[index] };
}
