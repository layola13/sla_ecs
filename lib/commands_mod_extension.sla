// Bevy ECS system::commands extensions (Commands + EntityCommands) — remainder
// of methods not covered in commands_world.sla / entity_commands_conditional.sla.
// Mirrors src/system/commands/mod.rs.

// === Commands-side extensions ===
struct EcsCmdExtCurState {
    last_system_id: i64,
    last_observed_entity: i64,
    last_cwd_queue_len: i64,
}

fn EcsCmdExtCurState_new() -> EcsCmdExtCurState {
    return EcsCmdExtCurState { last_system_id: 0, last_observed_entity: 0, last_cwd_queue_len: 0 };
}

// new_from_entities: alternate entry where the queue is bound to existing entities set.
// Returns the same struct but uses different world-id tracking marker `bound_entities`.
fn ecs_commands_ext_new_from_entities(world_marker: i64) -> EcsCmdExtCurState {
    let s = EcsCmdExtCurState_new();
    s.last_observed_entity = world_marker;
    return s;
}

fn ecs_commands_ext_get_spawned_entity(state: EcsCmdExtCurState, requested: i64) -> (EcsCmdExtCurState, i64, bool, bool) {
    // (state, spawned_entity, is_spawn_request, was_found)
    if requested < 0 {
        state.last_observed_entity = requested;
        return (state, requested, true, false);
    };
    state.last_observed_entity = requested;
    return (state, requested, false, true);
}

// rebound_to: returns a new state with last_system_id preserved
fn ecs_commands_ext_rebound_to(state: EcsCmdExtCurState) -> EcsCmdExtCurState { return state; }

// reborrow
fn ecs_commands_ext_reborrow(state: EcsCmdExtCurState) -> EcsCmdExtCurState { return state; }

// register_boxed_system: reserves a system id
fn ecs_commands_ext_register_boxed_system(state: EcsCmdExtCurState) -> (EcsCmdExtCurState, i64) {
    state.last_system_id = state.last_system_id + 1;
    return (state, state.last_system_id);
}

// unregister_system_cached: returns (state, found); present -> removed
fn ecs_commands_ext_unregister_system_cached(state: EcsCmdExtCurState, id: i64) -> (EcsCmdExtCurState, bool, i64) {
    if id == state.last_system_id {
        state.last_system_id = state.last_system_id - 1;
        return (state, true, id);
    };
    return (state, false, id);
}

// run_system_cached: returns the cached id; default sentinel = invalid = -1
fn ecs_commands_ext_run_system_cached(state: EcsCmdExtCurState, id: i64) -> (EcsCmdExtCurState, i64) {
    if id > 0 && id <= state.last_system_id {
        return (state, id);
    };
    return (state, -1);
}

// run_system_cached_with: returns (state, id, input) (input is opaque)
fn ecs_commands_ext_run_system_cached_with(state: EcsCmdExtCurState, id: i64, input: i64) -> (EcsCmdExtCurState, i64, i64) {
    let r = ecs_commands_ext_run_system_cached(state, id);
    return (r.0, r.1, input);
}

// trigger(event_id): adds a command to trigger an event; tracks count
fn ecs_commands_ext_trigger(state: EcsCmdExtCurState, event_id: i32) -> (EcsCmdExtCurState, i32) {
    state.last_cwd_queue_len = state.last_cwd_queue_len + 1;
    return (state, event_id);
}

// trigger_with
fn ecs_commands_ext_trigger_with(state: EcsCmdExtCurState, event_id: i32, payload: i64) -> (EcsCmdExtCurState, i32) {
    state.last_cwd_queue_len = state.last_cwd_queue_len + 1;
    return (state, event_id);
}

// add_observer(ObserverEntity)
fn ecs_commands_ext_add_observer(state: EcsCmdExtCurState, observer_entity: i64) -> (EcsCmdExtCurState, bool) {
    state.last_observed_entity = observer_entity;
    state.last_cwd_queue_len = state.last_cwd_queue_len + 1;
    return (state, true);
}

// write_message: returns pending count
fn ecs_commands_ext_write_message(state: EcsCmdExtCurState, message_id: i32) -> (EcsCmdExtCurState, i32) {
    state.last_cwd_queue_len = state.last_cwd_queue_len + 1;
    return (state, message_id);
}

// run_schedule
fn ecs_commands_ext_run_schedule(state: EcsCmdExtCurState, label: i32) -> (EcsCmdExtCurState, bool) {
    if label < 0 { return (state, false); };
    state.last_cwd_queue_len = state.last_cwd_queue_len + 1;
    return (state, true);
}

// get_spawned_entity
fn ecs_commands_ext_get_spawned_entity_2(state: EcsCmdExtCurState, requested: i64) -> (EcsCmdExtCurState, i64, bool, bool) {
    return ecs_commands_ext_get_spawned_entity(state, requested);
}

// === EntityCommands-side extensions ===
struct EcsEntityCmdExtState {
    entity: i64,
    is_spawned: bool,
    pending_commands: i64,
    pending_observes: i64,
    last_event: i64,
    cloned_to: i64,
}

fn EcsEntityCmdExtState_new(entity: i64, is_spawned: bool) -> EcsEntityCmdExtState {
    return EcsEntityCmdExtState { entity: entity, is_spawned: is_spawned, pending_commands: 0, pending_observes: 0, last_event: 0, cloned_to: -1 };
}

fn ecs_ecmd_ext_id(state: EcsEntityCmdExtState) -> i64 { return state.entity; }
fn ecs_ecmd_ext_entity(state: EcsEntityCmdExtState) -> i64 { return state.entity; }
fn ecs_ecmd_ext_is_spawned(state: EcsEntityCmdExtState) -> bool { return state.is_spawned; }
fn ecs_ecmd_ext_get_pending(state: EcsEntityCmdExtState) -> i64 { return state.pending_commands; }
fn ecs_ecmd_ext_pending_observes(state: EcsEntityCmdExtState) -> i64 { return state.pending_observes; }
fn ecs_ecmd_ext_cloned_to(state: EcsEntityCmdExtState) -> i64 { return state.cloned_to; }
fn ecs_ecmd_ext_reborrow(state: EcsEntityCmdExtState) -> EcsEntityCmdExtState { return state; }

// entry (returns new Context placeholder)
fn ecs_ecmd_ext_entry(state: EcsEntityCmdExtState, component_id: i32) -> (EcsEntityCmdExtState, i32) {
    state.pending_commands = state.pending_commands + 1;
    return (state, component_id);
}

// queue_handled
fn ecs_ecmd_ext_queue_handled(state: EcsEntityCmdExtState, command_id: i32) -> (EcsEntityCmdExtState, bool) {
    state.pending_commands = state.pending_commands + 1;
    return (state, true);
}

// queue_silenced
fn ecs_ecmd_ext_queue_silenced(state: EcsEntityCmdExtState, command_id: i32) -> (EcsEntityCmdExtState, bool) {
    state.pending_commands = state.pending_commands + 1;
    return (state, false);
}

// log_components
fn ecs_ecmd_ext_log_components(state: EcsEntityCmdExtState, components: Vec<i32>) -> (EcsEntityCmdExtState, i64) {
    state.pending_commands = state.pending_commands + 1;
    return (state, len(components) as i64);
}

// commands (returns the same state)
fn ecs_ecmd_ext_commands(state: EcsEntityCmdExtState) -> EcsEntityCmdExtState {
    state.pending_commands = state.pending_commands + 1;
    return state;
}

// commands_mut
fn ecs_ecmd_ext_commands_mut(state: EcsEntityCmdExtState) -> EcsEntityCmdExtState {
    state.pending_commands = state.pending_commands + 1;
    return state;
}

// observe(observer_entity)
fn ecs_ecmd_ext_observe(state: EcsEntityCmdExtState, observer_entity: i64) -> (EcsEntityCmdExtState, bool) {
    state.pending_observes = state.pending_observes + 1;
    state.last_event = observer_entity;
    return (state, true);
}

// trigger(event_id): returns state with queued event
fn ecs_ecmd_ext_trigger(state: EcsEntityCmdExtState, event_id: i64) -> (EcsEntityCmdExtState, i64) {
    state.last_event = event_id;
    state.pending_commands = state.pending_commands + 1;
    return (state, event_id);
}

// clone_with_opt_out(target, excluded_components): returns new target_entity set + skip count
fn ecs_ecmd_ext_clone_with_opt_out(state: EcsEntityCmdExtState, target: i64, excluded: Vec<i32>) -> (EcsEntityCmdExtState, i64) {
    state.cloned_to = target;
    state.pending_commands = state.pending_commands + 1;
    return (state, len(excluded) as i64);
}

// clone_with_opt_in(target, included): returns count + sets
fn ecs_ecmd_ext_clone_with_opt_in(state: EcsEntityCmdExtState, target: i64, included: Vec<i32>) -> (EcsEntityCmdExtState, i64) {
    state.cloned_to = target;
    state.pending_commands = state.pending_commands + 1;
    return (state, len(included) as i64);
}

// clone_and_spawn(implicit): creates a new EntityCommands via target
fn ecs_ecmd_ext_clone_and_spawn(state: EcsEntityCmdExtState, new_target: i64) -> (EcsEntityCmdExtState, i64, bool) {
    state.cloned_to = new_target;
    state.pending_commands = state.pending_commands + 1;
    // The freshly-spawned entity is by definition spawned=true
    return (state, new_target, true);
}

// clone_and_spawn_with_opt_out
fn ecs_ecmd_ext_clone_and_spawn_with_opt_out(state: EcsEntityCmdExtState, new_target: i64, excluded: Vec<i32>) -> (EcsEntityCmdExtState, i64) {
    state.cloned_to = new_target;
    state.pending_commands = state.pending_commands + 1;
    return (state, len(excluded) as i64);
}

// clone_and_spawn_with_opt_in
fn ecs_ecmd_ext_clone_and_spawn_with_opt_in(state: EcsEntityCmdExtState, new_target: i64, included: Vec<i32>) -> (EcsEntityCmdExtState, i64) {
    state.cloned_to = new_target;
    state.pending_commands = state.pending_commands + 1;
    return (state, len(included) as i64);
}

// clone_components (move components only — does NOT despawn source; returns count moved)
fn ecs_ecmd_ext_clone_components(state: EcsEntityCmdExtState, target: i64, component_ids: Vec<i32>) -> (EcsEntityCmdExtState, i64) {
    state.cloned_to = target;
    state.pending_commands = state.pending_commands + 1;
    return (state, len(component_ids) as i64);
}

// move_components: clones to target + despawns source (queue despawn)
fn ecs_ecmd_ext_move_components(state: EcsEntityCmdExtState, target: i64, component_ids: Vec<i32>) -> (EcsEntityCmdExtState, i64, bool) {
    state.cloned_to = target;
    state.pending_commands = state.pending_commands + 1;
    state.is_spawned = false;
    return (state, len(component_ids) as i64, true);
}
