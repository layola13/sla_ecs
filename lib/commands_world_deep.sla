fn _ecs_cmd_e_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    if idx == 8 { return c.e8; };
    if idx == 9 { return c.e9; };
    if idx == 10 { return c.e10; };
    if idx == 11 { return c.e11; };
    if idx == 12 { return c.e12; };
    if idx == 13 { return c.e13; };
    if idx == 14 { return c.e14; };
    return c.e15;
}

fn _ecs_cmd_set_e(c0: EcsCmdWorldDeep, idx: i32, value: i32) -> EcsCmdWorldDeep {
    if idx == 0 { c0.e0 = value; return c0; };
    if idx == 1 { c0.e1 = value; return c0; };
    if idx == 2 { c0.e2 = value; return c0; };
    if idx == 3 { c0.e3 = value; return c0; };
    if idx == 4 { c0.e4 = value; return c0; };
    if idx == 5 { c0.e5 = value; return c0; };
    if idx == 6 { c0.e6 = value; return c0; };
    if idx == 7 { c0.e7 = value; return c0; };
    if idx == 8 { c0.e8 = value; return c0; };
    if idx == 9 { c0.e9 = value; return c0; };
    if idx == 10 { c0.e10 = value; return c0; };
    if idx == 11 { c0.e11 = value; return c0; };
    if idx == 12 { c0.e12 = value; return c0; };
    if idx == 13 { c0.e13 = value; return c0; };
