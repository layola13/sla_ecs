// Deep bed for lib/commands_world.sla (Batch 390).
// Mirrors shallow lib/commands_world.sla's mutable Commands context (entity table, flat
// (entity, comp_id, comp_value) component table, resource table, registered-systems list,
// command queue, schedule label list) as a SELF-CONTAINED fixed-cap variant (NO `@import`) that
// reifies each shallow `Vec<...>` + count pair into a flat scalar slot family cap-N (SA has no
// fixed-array support in `_deep.sla`). Shallow uses generics / Vec / Vec-index `[i]` style and
// tuple-return ops; the deep replaces each `[T; N]` with `field0..fieldN-1` scalar slot families
// and each `(c, x)` tuple-return with a wrapper struct (EcsCmdSpawn / EcsCmdGetVal /
// EcsCmdBool / EcsCmdRegister) per Batch 373 rule (NO tuple-return destructuring in tests).
//
// Following the Batch 368/380 convention the Vec-parameterized BATCH APIs (insert_batch,
// spawn_batch, append[Vec<i32>]) are OMITTED in the deep — repeat the single-element ops to
// exercise equivalent scripts. This leaves the deep with a slightly trimmed surface but still
// covers spawn_empty / spawn / entity / get_entity / insert_entity / has_component /
// get_component / insert_resource / init_resource / insert_resource_if_neq / remove_resource /
// get_resource / resource_count / register_system / unregister_system / run_system /
// system_count / run_schedule / queue / queue_handled / queue_silenced / write_message /
// entity_count / queue_len / schedule_count / component_count.
//
// Caps (chosen to leave room beyond any realistic test scenario but exercise cap-reject for the
// cap-aware variants): entity table cap-16; component table cap-32; resource table cap-8;
// registered-systems cap-8; command queue cap-16; schedule label list cap-8. Spawn-cap reject
// returns EcsCmdSpawn { commands: w (unchanged), entity_id: -1 } sentinel following the Batch
// 388/389 NO-PANIC convention.

const ECS_CMD_WD_CAP_ENTITIES: i32 = 16;
const ECS_CMD_WD_CAP_COMPONENTS: i32 = 32;
const ECS_CMD_WD_CAP_RESOURCES: i32 = 8;
const ECS_CMD_WD_CAP_SYSTEMS: i32 = 8;
const ECS_CMD_WD_CAP_QUEUE: i32 = 16;
const ECS_CMD_WD_CAP_SCHEDULE: i32 = 8;
const ECS_CMD_WD_NO_ID: i32 = -300;          // sentinel "no id" (positive: avoids SA codegen rejecting negative top-level consts as Batch 389 #3 established).
const ECS_CMD_WD_INSERT_MODE_REPLACE: i32 = 0;
const ECS_CMD_WD_INSERT_MODE_KEEP: i32 = 1;
const ECS_CMD_WD_QUEUE: i32 = 0;
const ECS_CMD_WD_QUEUE_HANDLED: i32 = 1;
const ECS_CMD_WD_QUEUE_SILENCED: i32 = 2;

// ── Wrapper structs (NO tuple-return destructuring in tests). ──────────────────────────────
struct EcsCmdSpawn { commands: EcsCmdWorldDeep, entity_id: i32 }
fn ecs_cmd_spawn_commands(s: EcsCmdSpawn) -> EcsCmdWorldDeep { return s.commands; }
fn ecs_cmd_spawn_entity_id(s: EcsCmdSpawn) -> i32 { return s.entity_id; }

struct EcsCmdGetVal { found: i32, value: i32 }
fn ecs_cmd_get_val_found(g: EcsCmdGetVal) -> i32 { return g.found; }
fn ecs_cmd_get_val_value(g: EcsCmdGetVal) -> i32 { return g.value; }

struct EcsCmdBool { commands: EcsCmdWorldDeep, ok: i32 }
fn ecs_cmd_bool_commands(b: EcsCmdBool) -> EcsCmdWorldDeep { return b.commands; }
fn ecs_cmd_bool_ok(b: EcsCmdBool) -> i32 { return b.ok; }

struct EcsCmdRegister { commands: EcsCmdWorldDeep, system_id: i32 }
fn ecs_cmd_register_commands(r: EcsCmdRegister) -> EcsCmdWorldDeep { return r.commands; }
fn ecs_cmd_register_system_id(r: EcsCmdRegister) -> i32 { return r.system_id; }

// ── Mutable Commands context (cap-N flat scalar slot families). ───────────────────────────
struct EcsCmdWorldDeep {
    next_entity: i32,
    // entity table (cap-16): e * entity_id
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    e8: i32, e9: i32, e10: i32, e11: i32, e12: i32, e13: i32, e14: i32, e15: i32,
    e_count: i32,
    // component table (cap-32): per-row (entity_id, component_id, value)
    ce0: i32, ce1: i32, ce2: i32, ce3: i32, ce4: i32, ce5: i32, ce6: i32, ce7: i32,
    ce8: i32, ce9: i32, ce10: i32, ce11: i32, ce12: i32, ce13: i32, ce14: i32, ce15: i32,
    ce16: i32, ce17: i32, ce18: i32, ce19: i32, ce20: i32, ce21: i32, ce22: i32, ce23: i32,
    ce24: i32, ce25: i32, ce26: i32, ce27: i32, ce28: i32, ce29: i32, ce30: i32, ce31: i32,
    cc0: i32, cc1: i32, cc2: i32, cc3: i32, cc4: i32, cc5: i32, cc6: i32, cc7: i32,
    cc8: i32, cc9: i32, cc10: i32, cc11: i32, cc12: i32, cc13: i32, cc14: i32, cc15: i32,
    cc16: i32, cc17: i32, cc18: i32, cc19: i32, cc20: i32, cc21: i32, cc22: i32, cc23: i32,
    cc24: i32, cc25: i32, cc26: i32, cc27: i32, cc28: i32, cc29: i32, cc30: i32, cc31: i32,
    cv0: i32, cv1: i32, cv2: i32, cv3: i32, cv4: i32, cv5: i32, cv6: i32, cv7: i32,
    cv8: i32, cv9: i32, cv10: i32, cv11: i32, cv12: i32, cv13: i32, cv14: i32, cv15: i32,
    cv16: i32, cv17: i32, cv18: i32, cv19: i32, cv20: i32, cv21: i32, cv22: i32, cv23: i32,
    cv24: i32, cv25: i32, cv26: i32, cv27: i32, cv28: i32, cv29: i32, cv30: i32, cv31: i32,
    c_count: i32,
    // resource table (cap-8): per-slot (id, value)
    ri0: i32, ri1: i32, ri2: i32, ri3: i32, ri4: i32, ri5: i32, ri6: i32, ri7: i32,
    rv0: i32, rv1: i32, rv2: i32, rv3: i32, rv4: i32, rv5: i32, rv6: i32, rv7: i32,
    r_count: i32,
    // registered systems (cap-8): system id list + next_system_id
    rs0: i32, rs1: i32, rs2: i32, rs3: i32, rs4: i32, rs5: i32, rs6: i32, rs7: i32,
    rs_count: i32,
    next_system_id: i32,
    // command queue (cap-16): i32 code entries
    cq0: i32, cq1: i32, cq2: i32, cq3: i32, cq4: i32, cq5: i32, cq6: i32, cq7: i32,
    cq8: i32, cq9: i32, cq10: i32, cq11: i32, cq12: i32, cq13: i32, cq14: i32, cq15: i32,
    cq_count: i32,
    // schedule labels (cap-8): i32 label entries
    sl0: i32, sl1: i32, sl2: i32, sl3: i32, sl4: i32, sl5: i32, sl6: i32, sl7: i32,
    sl_count: i32,
}

fn ecs_commands_world_new() -> EcsCmdWorldDeep {
    return EcsCmdWorldDeep {
        next_entity: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        e8: 0, e9: 0, e10: 0, e11: 0, e12: 0, e13: 0, e14: 0, e15: 0,
        e_count: 0,
        ce0: 0, ce1: 0, ce2: 0, ce3: 0, ce4: 0, ce5: 0, ce6: 0, ce7: 0,
