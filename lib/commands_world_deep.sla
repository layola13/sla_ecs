        cc24: 0, cc25: 0, cc26: 0, cc27: 0, cc28: 0, cc29: 0, cc30: 0, cc31: 0,
        cv0: 0, cv1: 0, cv2: 0, cv3: 0, cv4: 0, cv5: 0, cv6: 0, cv7: 0,
        cv8: 0, cv9: 0, cv10: 0, cv11: 0, cv12: 0, cv13: 0, cv14: 0, cv15: 0,
        cv16: 0, cv17: 0, cv18: 0, cv19: 0, cv20: 0, cv21: 0, cv22: 0, cv23: 0,
        cv24: 0, cv25: 0, cv26: 0, cv27: 0, cv28: 0, cv29: 0, cv30: 0, cv31: 0,
        c_count: 0,
        ri0: 0, ri1: 0, ri2: 0, ri3: 0, ri4: 0, ri5: 0, ri6: 0, ri7: 0,
        rv0: 0, rv1: 0, rv2: 0, rv3: 0, rv4: 0, rv5: 0, rv6: 0, rv7: 0,
        r_count: 0,
        rs0: 0, rs1: 0, rs2: 0, rs3: 0, rs4: 0, rs5: 0, rs6: 0, rs7: 0,
        rs_count: 0,
        next_system_id: 1,
        cq0: 0, cq1: 0, cq2: 0, cq3: 0, cq4: 0, cq5: 0, cq6: 0, cq7: 0,
        cq8: 0, cq9: 0, cq10: 0, cq11: 0, cq12: 0, cq13: 0, cq14: 0, cq15: 0,
        cq_count: 0,
        sl0: 0, sl1: 0, sl2: 0, sl3: 0, sl4: 0, sl5: 0, sl6: 0, sl7: 0,
        sl_count: 0,
    };
}

