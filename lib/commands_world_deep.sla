    if idx == 4 { c0.ri4 = value; return c0; };
    if idx == 5 { c0.ri5 = value; return c0; };
    if idx == 6 { c0.ri6 = value; return c0; };
    c0.ri7 = value;
    return c0;
}

fn _ecs_cmd_rv_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return c.rv0; };
    if idx == 1 { return c.rv1; };
    if idx == 2 { return c.rv2; };
    if idx == 3 { return c.rv3; };
    if idx == 4 { return c.rv4; };
    if idx == 5 { return c.rv5; };
    if idx == 6 { return c.rv6; };
    return c.rv7;
}

fn _ecs_cmd_set_rv(c0: EcsCmdWorldDeep, idx: i32, value: i32) -> EcsCmdWorldDeep {
    if idx == 0 { c0.rv0 = value; return c0; };
    if idx == 1 { c0.rv1 = value; return c0; };
    if idx == 2 { c0.rv2 = value; return c0; };
    if idx == 3 { c0.rv3 = value; return c0; };
    if idx == 4 { c0.rv4 = value; return c0; };
    if idx == 5 { c0.rv5 = value; return c0; };
    if idx == 6 { c0.rv6 = value; return c0; };
    c0.rv7 = value;
    return c0;
}

// ── Registered-systems scalar accessor helpers (cap-8). ────────────────────────────────────
fn _ecs_cmd_rs_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return c.rs0; };
    if idx == 1 { return c.rs1; };
    if idx == 2 { return c.rs2; };
    if idx == 3 { return c.rs3; };
    if idx == 4 { return c.rs4; };
    if idx == 5 { return c.rs5; };
    if idx == 6 { return c.rs6; };
    return c.rs7;
}

fn _ecs_cmd_set_rs(c0: EcsCmdWorldDeep, idx: i32, value: i32) -> EcsCmdWorldDeep {
    if idx == 0 { c0.rs0 = value; return c0; };
    if idx == 1 { c0.rs1 = value; return c0; };
    if idx == 2 { c0.rs2 = value; return c0; };
    if idx == 3 { c0.rs3 = value; return c0; };
    if idx == 4 { c0.rs4 = value; return c0; };
    if idx == 5 { c0.rs5 = value; return c0; };
    if idx == 6 { c0.rs6 = value; return c0; };
    c0.rs7 = value;
    return c0;
}

// ── Command queue scalar accessor helpers (cap-16). ────────────────────────────────────────
fn _ecs_cmd_cq_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return c.cq0; };
    if idx == 1 { return c.cq1; };
    if idx == 2 { return c.cq2; };
    if idx == 3 { return c.cq3; };
    if idx == 4 { return c.cq4; };
    if idx == 5 { return c.cq5; };
    if idx == 6 { return c.cq6; };
    if idx == 7 { return c.cq7; };
    if idx == 8 { return c.cq8; };
    if idx == 9 { return c.cq9; };
    if idx == 10 { return c.cq10; };
    if idx == 11 { return c.cq11; };
    if idx == 12 { return c.cq12; };
    if idx == 13 { return c.cq13; };
    if idx == 14 { return c.cq14; };
    return c.cq15;
}

fn _ecs_cmd_set_cq(c0: EcsCmdWorldDeep, idx: i32, value: i32) -> EcsCmdWorldDeep {
    if idx == 0 { c0.cq0 = value; return c0; };
    if idx == 1 { c0.cq1 = value; return c0; };
    if idx == 2 { c0.cq2 = value; return c0; };
    if idx == 3 { c0.cq3 = value; return c0; };
    if idx == 4 { c0.cq4 = value; return c0; };
    if idx == 5 { c0.cq5 = value; return c0; };
    if idx == 6 { c0.cq6 = value; return c0; };
    if idx == 7 { c0.cq7 = value; return c0; };
    if idx == 8 { c0.cq8 = value; return c0; };
    if idx == 9 { c0.cq9 = value; return c0; };
    if idx == 10 { c0.cq10 = value; return c0; };
    if idx == 11 { c0.cq11 = value; return c0; };
    if idx == 12 { c0.cq12 = value; return c0; };
    if idx == 13 { c0.cq13 = value; return c0; };
    if idx == 14 { c0.cq14 = value; return c0; };
    c0.cq15 = value;
    return c0;
}

// ── Schedule label scalar accessor helpers (cap-8). ─────────────────────────────────────────
fn _ecs_cmd_sl_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx == 0 { return c.sl0; };
    if idx == 1 { return c.sl1; };
    if idx == 2 { return c.sl2; };
    if idx == 3 { return c.sl3; };
    if idx == 4 { return c.sl4; };
    if idx == 5 { return c.sl5; };
    if idx == 6 { return c.sl6; };
    return c.sl7;
}

fn _ecs_cmd_set_sl(c0: EcsCmdWorldDeep, idx: i32, value: i32) -> EcsCmdWorldDeep {
    if idx == 0 { c0.sl0 = value; return c0; };
    if idx == 1 { c0.sl1 = value; return c0; };
    if idx == 2 { c0.sl2 = value; return c0; };
    if idx == 3 { c0.sl3 = value; return c0; };
    if idx == 4 { c0.sl4 = value; return c0; };
    if idx == 5 { c0.sl5 = value; return c0; };
    if idx == 6 { c0.sl6 = value; return c0; };
    c0.sl7 = value;
    return c0;
}

// ── Internal: enqueue a command-code onto the queue if cap-room allows (otherwise no-op). ───
fn _ecs_cmd_enqueue(c0: EcsCmdWorldDeep, code: i32) -> EcsCmdWorldDeep {
    if c0.cq_count >= ECS_CMD_WD_CAP_QUEUE { return c0; };
    let slot = c0.cq_count;
    c0 = _ecs_cmd_set_cq(c0, slot, code);
    c0.cq_count = slot + 1;
    return c0;
}

// ── Stats: counts return the relevant cap-slot family live count. ──────────────────────────
fn ecs_commands_entity_count(c: EcsCmdWorldDeep) -> i32 { return c.e_count; }
fn ecs_commands_component_count(c: EcsCmdWorldDeep) -> i32 { return c.c_count; }
fn ecs_commands_resource_count(c: EcsCmdWorldDeep) -> i32 { return c.r_count; }
fn ecs_commands_system_count(c: EcsCmdWorldDeep) -> i32 { return c.rs_count; }
fn ecs_commands_queue_len(c: EcsCmdWorldDeep) -> i32 { return c.cq_count; }
fn ecs_commands_schedule_count(c: EcsCmdWorldDeep) -> i32 { return c.sl_count; }
fn ecs_commands_next_entity_id(c: EcsCmdWorldDeep) -> i32 { return c.next_entity; }
fn ecs_commands_next_system_id(c: EcsCmdWorldDeep) -> i32 { return c.next_system_id; }

// ── spawn_empty: append a new entity id to the entity table + queue a queue-code. ──────────
// At cap returns EcsCmdSpawn { commands: w unchanged, entity_id: -1 } sentinel (Batch 388/389
// no-panic convention).
fn ecs_commands_spawn_empty(c0: EcsCmdWorldDeep) -> EcsCmdSpawn {
    if c0.e_count >= ECS_CMD_WD_CAP_ENTITIES {
        return EcsCmdSpawn { commands: c0, entity_id: -1 };
    };
    let entity_id = c0.next_entity;
    let slot = c0.e_count;
    c0 = _ecs_cmd_set_e(c0, slot, entity_id);
    c0.e_count = slot + 1;
    c0.next_entity = entity_id + 1;
    c0 = _ecs_cmd_enqueue(c0, ECS_CMD_WD_QUEUE);
    return EcsCmdSpawn { commands: c0, entity_id: entity_id };
}

// ── spawn: spawn_empty then insert_entity (initial component). Returns EcsCmdSpawn. ─────────
fn ecs_commands_spawn(c0: EcsCmdWorldDeep, component_id: i32, value: i32) -> EcsCmdSpawn {
    let sp = ecs_commands_spawn_empty(c0);
    let c1 = ecs_cmd_spawn_commands(sp);
    let entity_id = ecs_cmd_spawn_entity_id(sp);
    if entity_id < 0 { return sp; };
    let c2 = ecs_commands_insert_entity(c1, entity_id, component_id, value);
    return EcsCmdSpawn { commands: c2, entity_id: entity_id };
}

// ── entity: returns the entity-table index for an entity_id, or -1 if not present. ─────────
fn ecs_commands_entity(c: EcsCmdWorldDeep, entity_id: i32) -> i32 {
    let i: i32 = 0;
    while i < c.e_count {
        if _ecs_cmd_e_at(c, i) == entity_id { return i; };
        i = i + 1;
    }
    return -1;
}

// ── get_entity: returns EcsCmdGetVal { found: 1/0, value: idx_or_-1 }. ─────────────────────
fn ecs_commands_get_entity(c: EcsCmdWorldDeep, entity_id: i32) -> EcsCmdGetVal {
    let idx = ecs_commands_entity(c, entity_id);
    if idx >= 0 { return EcsCmdGetVal { found: 1, value: idx }; };
    return EcsCmdGetVal { found: 0, value: -1 };
}

// ── insert_entity: insert a (entity_id, component_id, value) row; overwrite if the (entity_id,
//    component_id) pair already exists; else append. No-op at cap when the pair is new.
fn ecs_commands_insert_entity(c0: EcsCmdWorldDeep, entity_id: i32, component_id: i32, value: i32) -> EcsCmdWorldDeep {
    let i: i32 = 0;
    while i < c0.c_count {
        if _ecs_cmd_ce_at(c0, i) == entity_id {
            if _ecs_cmd_cc_at(c0, i) == component_id {
                c0 = _ecs_cmd_set_cv(c0, i, value);
                return c0;
            };
        };
        i = i + 1;
    }
    if c0.c_count >= ECS_CMD_WD_CAP_COMPONENTS { return c0; };
    let slot = c0.c_count;
    c0 = _ecs_cmd_set_ce(c0, slot, entity_id);
    c0 = _ecs_cmd_set_cc(c0, slot, component_id);
    c0 = _ecs_cmd_set_cv(c0, slot, value);
    c0.c_count = slot + 1;
    return c0;
}

// ── has_component: returns true iff an (entity_id, component_id) row exists. ──────────────
fn ecs_commands_has_component(c: EcsCmdWorldDeep, entity_id: i32, component_id: i32) -> bool {
    let i: i32 = 0;
    while i < c.c_count {
        if _ecs_cmd_ce_at(c, i) == entity_id {
            if _ecs_cmd_cc_at(c, i) == component_id { return true; };
        };
        i = i + 1;
    }
    return false;
}

// ── get_component: returns EcsCmdGetVal { found: 1/0, value: row_value_or_0 }. ─────────────
fn ecs_commands_get_component(c: EcsCmdWorldDeep, entity_id: i32, component_id: i32) -> EcsCmdGetVal {
    let i: i32 = 0;
    while i < c.c_count {
        if _ecs_cmd_ce_at(c, i) == entity_id {
            if _ecs_cmd_cc_at(c, i) == component_id {
                return EcsCmdGetVal { found: 1, value: _ecs_cmd_cv_at(c, i) };
            };
        };
        i = i + 1;
    }
    return EcsCmdGetVal { found: 0, value: 0 };
}

// ── Resources ──────────────────────────────────────────────────────────────────────────────
// insert_resource: overwrite value if resource_id exists; else append. No-op at cap if new.
fn ecs_commands_insert_resource(c0: EcsCmdWorldDeep, resource_id: i32, value: i32) -> EcsCmdWorldDeep {
    let i: i32 = 0;
    while i < c0.r_count {
        if _ecs_cmd_ri_at(c0, i) == resource_id {
            c0 = _ecs_cmd_set_rv(c0, i, value);
            return c0;
        };
        i = i + 1;
    }
    if c0.r_count >= ECS_CMD_WD_CAP_RESOURCES { return c0; };
    let slot = c0.r_count;
    c0 = _ecs_cmd_set_ri(c0, slot, resource_id);
    c0 = _ecs_cmd_set_rv(c0, slot, value);
    c0.r_count = slot + 1;
    return c0;
}

// init_resource: idempotent init-to-zero if missing; no-op if already present.
fn ecs_commands_init_resource(c0: EcsCmdWorldDeep, resource_id: i32) -> EcsCmdWorldDeep {
    let i: i32 = 0;
    while i < c0.r_count {
        if _ecs_cmd_ri_at(c0, i) == resource_id { return c0; };
        i = i + 1;
    }
    if c0.r_count >= ECS_CMD_WD_CAP_RESOURCES { return c0; };
    let slot = c0.r_count;
    c0 = _ecs_cmd_set_ri(c0, slot, resource_id);
    c0 = _ecs_cmd_set_rv(c0, slot, 0);
    c0.r_count = slot + 1;
    return c0;
}

// insert_resource_if_neq: overwrite value only if the existing value differs; else append.
fn ecs_commands_insert_resource_if_neq(c0: EcsCmdWorldDeep, resource_id: i32, value: i32) -> EcsCmdWorldDeep {
    let i: i32 = 0;
    while i < c0.r_count {
        if _ecs_cmd_ri_at(c0, i) == resource_id {
            if _ecs_cmd_rv_at(c0, i) != value {
                c0 = _ecs_cmd_set_rv(c0, i, value);
            };
            return c0;
        };
        i = i + 1;
    }
    if c0.r_count >= ECS_CMD_WD_CAP_RESOURCES { return c0; };
    let slot = c0.r_count;
    c0 = _ecs_cmd_set_ri(c0, slot, resource_id);
    c0 = _ecs_cmd_set_rv(c0, slot, value);
    c0.r_count = slot + 1;
    return c0;
}

// remove_resource: swap-remove; no-op if not present. Mirrors shallow's swap-remove.
fn ecs_commands_remove_resource(c0: EcsCmdWorldDeep, resource_id: i32) -> EcsCmdWorldDeep {
    let i: i32 = 0;
    while i < c0.r_count {
        if _ecs_cmd_ri_at(c0, i) == resource_id {
            let last = c0.r_count - 1;
            if i != last {
                let last_ri = _ecs_cmd_ri_at(c0, last);
                let last_rv = _ecs_cmd_rv_at(c0, last);
                c0 = _ecs_cmd_set_ri(c0, i, last_ri);
                c0 = _ecs_cmd_set_rv(c0, i, last_rv);
            };
            c0 = _ecs_cmd_set_ri(c0, last, 0);
            c0 = _ecs_cmd_set_rv(c0, last, 0);
            c0.r_count = last;
            return c0;
        };
        i = i + 1;
    }
    return c0;
}

// get_resource: returns EcsCmdGetVal { found: 1/0, value: row_value_or_0 }.
fn ecs_commands_get_resource(c: EcsCmdWorldDeep, resource_id: i32) -> EcsCmdGetVal {
    let i: i32 = 0;
    while i < c.r_count {
        if _ecs_cmd_ri_at(c, i) == resource_id {
            return EcsCmdGetVal { found: 1, value: _ecs_cmd_rv_at(c, i) };
        };
        i = i + 1;
    }
    return EcsCmdGetVal { found: 0, value: 0 };
}

// ── System registration ─────────────────────────────────────────────────────────────────
// register_system: returns EcsCmdRegister { commands: updated, system_id: next_id }. At cap
// returns EcsCmdRegister { commands: w unchanged, system_id: -1 } sentinel.
fn ecs_commands_register_system(c0: EcsCmdWorldDeep) -> EcsCmdRegister {
    if c0.rs_count >= ECS_CMD_WD_CAP_SYSTEMS {
        return EcsCmdRegister { commands: c0, system_id: -1 };
    };
    let system_id = c0.next_system_id;
    let slot = c0.rs_count;
    c0 = _ecs_cmd_set_rs(c0, slot, system_id);
    c0.rs_count = slot + 1;
    c0.next_system_id = system_id + 1;
    return EcsCmdRegister { commands: c0, system_id: system_id };
}

// unregister_system: swap-remove; returns EcsCmdBool { commands, ok }.
fn ecs_commands_unregister_system(c0: EcsCmdWorldDeep, system_id: i32) -> EcsCmdBool {
    let i: i32 = 0;
    while i < c0.rs_count {
        if _ecs_cmd_rs_at(c0, i) == system_id {
            let last = c0.rs_count - 1;
            if i != last {
                let last_rs = _ecs_cmd_rs_at(c0, last);
                c0 = _ecs_cmd_set_rs(c0, i, last_rs);
            };
            c0 = _ecs_cmd_set_rs(c0, last, 0);
            c0.rs_count = last;
            return EcsCmdBool { commands: c0, ok: 1 };
        };
        i = i + 1;
    }
    return EcsCmdBool { commands: c0, ok: 0 };
}

// run_system: enqueue ECS_CMD_WD_QUEUE onto the queue + return EcsCmdBool { ok: 1 }; else ok=0.
fn ecs_commands_run_system(c0: EcsCmdWorldDeep, system_id: i32) -> EcsCmdBool {
    let i: i32 = 0;
    while i < c0.rs_count {
        if _ecs_cmd_rs_at(c0, i) == system_id {
            c0 = _ecs_cmd_enqueue(c0, ECS_CMD_WD_QUEUE);
            return EcsCmdBool { commands: c0, ok: 1 };
        };
        i = i + 1;
    }
    return EcsCmdBool { commands: c0, ok: 0 };
}

// ── run_schedule: append label to schedule_labels list; no-op at cap. ────────────────────
fn ecs_commands_run_schedule(c0: EcsCmdWorldDeep, label: i32) -> EcsCmdWorldDeep {
    if c0.sl_count >= ECS_CMD_WD_CAP_SCHEDULE { return c0; };
    let slot = c0.sl_count;
    c0 = _ecs_cmd_set_sl(c0, slot, label);
    c0.sl_count = slot + 1;
    return c0;
}

// ── Queue / queue_handled / queue_silenced: enqueue the matching code. ─────────────────────
fn ecs_commands_queue(c0: EcsCmdWorldDeep) -> EcsCmdWorldDeep {
    return _ecs_cmd_enqueue(c0, ECS_CMD_WD_QUEUE);
}

fn ecs_commands_queue_handled(c0: EcsCmdWorldDeep) -> EcsCmdWorldDeep {
    return _ecs_cmd_enqueue(c0, ECS_CMD_WD_QUEUE_HANDLED);
}

fn ecs_commands_queue_silenced(c0: EcsCmdWorldDeep) -> EcsCmdWorldDeep {
    return _ecs_cmd_enqueue(c0, ECS_CMD_WD_QUEUE_SILENCED);
}

// ── write_message: enqueue the message_id code (mirrors shallow which pushes message_id to the
//    command queue — the id is the discriminator).
fn ecs_commands_write_message(c0: EcsCmdWorldDeep, message_id: i32) -> EcsCmdWorldDeep {
    return _ecs_cmd_enqueue(c0, message_id);
}

// ── queue code introspection (used by tests for queue ordering asserts). ──────────────────
fn ecs_commands_queue_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx < 0 { return -1; };
    if idx >= c.cq_count { return -1; };
    return _ecs_cmd_cq_at(c, idx);
}

// ── schedule label introspection (returned label at idx). ─────────────────────────────────
fn ecs_commands_schedule_at(c: EcsCmdWorldDeep, idx: i32) -> i32 {
    if idx < 0 { return -1; };
    if idx >= c.sl_count { return -1; };
    return _ecs_cmd_sl_at(c, idx);
}
