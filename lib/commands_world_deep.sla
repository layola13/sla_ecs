        ce16: 0, ce17: 0, ce18: 0, ce19: 0, ce20: 0, ce21: 0, ce22: 0, ce23: 0,
        ce24: 0, ce25: 0, ce26: 0, ce27: 0, ce28: 0, ce29: 0, ce30: 0, ce31: 0,
        cc0: 0, cc1: 0, cc2: 0, cc3: 0, cc4: 0, cc5: 0, cc6: 0, cc7: 0,
