}
fn _si_set(a: EcsWorldEntityAllocatorDeep, idx: i32, v: i32) -> EcsWorldEntityAllocatorDeep {
    if idx == 0 { a.si0 = v; return a; };
    if idx == 1 { a.si1 = v; return a; };
    if idx == 2 { a.si2 = v; return a; };
    if idx == 3 { a.si3 = v; return a; };
    if idx == 4 { a.si4 = v; return a; };
    if idx == 5 { a.si5 = v; return a; };
    if idx == 6 { a.si6 = v; return a; };
    if idx == 7 { a.si7 = v; return a; };
    if idx == 8 { a.si8 = v; return a; };
    if idx == 9 { a.si9 = v; return a; };
    if idx == 10 { a.si10 = v; return a; };
    if idx == 11 { a.si11 = v; return a; };
    if idx == 12 { a.si12 = v; return a; };
    if idx == 13 { a.si13 = v; return a; };
    if idx == 14 { a.si14 = v; return a; };
    if idx == 15 { a.si15 = v; return a; };
    panic(147138);
}
fn _si_push(a: EcsWorldEntityAllocatorDeep, v: i32) -> EcsWorldEntityAllocatorDeep {
    let i: i32 = a.si_n;
    if i >= ECS_WE_DEEP_CAP { return a; };
    a = _si_set(a, i, v);
    a.si_n = a.si_n + 1;
    return a;
}
// _si_remove_at: compact-by-backshift (slot i removed).
fn _si_remove_at(a: EcsWorldEntityAllocatorDeep, idx: i32) -> EcsWorldEntityAllocatorDeep {
    if idx < 0 || idx >= a.si_n { return a; };
    let j: i32 = idx;
    while j < a.si_n - 1 {
        a = _si_set(a, j, _si_at(a, j + 1));
        j = j + 1;
    }
    a = _si_set(a, a.si_n - 1, 0);
    a.si_n = a.si_n - 1;
    return a;
}

fn ecs_world_entity_allocator_deep_alloc(a: EcsWorldEntityAllocatorDeep) -> EcsWorldEntityAllocatorDeep {
    let idx: i32 = a.next_index;
    if a.fi_n > 0 {
        // Pop front of the free list (compact-backshift).
        idx = _fi_at(a, 0);
        let k: i32 = 0;
        while k < a.fi_n - 1 {
            if k == 0 { a.fi0 = _fi_at(a, 1); };
            if k == 1 { a.fi1 = _fi_at(a, 2); };
            if k == 2 { a.fi2 = _fi_at(a, 3); };
            if k == 3 { a.fi3 = _fi_at(a, 4); };
            if k == 4 { a.fi4 = _fi_at(a, 5); };
            if k == 5 { a.fi5 = _fi_at(a, 6); };
            if k == 6 { a.fi6 = _fi_at(a, 7); };
            if k == 7 { a.fi7 = _fi_at(a, 8); };
            if k == 8 { a.fi8 = _fi_at(a, 9); };
            if k == 9 { a.fi9 = _fi_at(a, 10); };
            if k == 10 { a.fi10 = _fi_at(a, 11); };
            if k == 11 { a.fi11 = _fi_at(a, 12); };
            if k == 12 { a.fi12 = _fi_at(a, 13); };
            if k == 13 { a.fi13 = _fi_at(a, 14); };
            if k == 14 { a.fi14 = _fi_at(a, 15); };
            k = k + 1;
        }
        if a.fi_n > 0 {
            if a.fi_n - 1 == 0 { a.fi0 = 0; };
            if a.fi_n - 1 == 1 { a.fi1 = 0; };
            if a.fi_n - 1 == 2 { a.fi2 = 0; };
            if a.fi_n - 1 == 3 { a.fi3 = 0; };
            if a.fi_n - 1 == 4 { a.fi4 = 0; };
            if a.fi_n - 1 == 5 { a.fi5 = 0; };
            if a.fi_n - 1 == 6 { a.fi6 = 0; };
            if a.fi_n - 1 == 7 { a.fi7 = 0; };
            if a.fi_n - 1 == 8 { a.fi8 = 0; };
            if a.fi_n - 1 == 9 { a.fi9 = 0; };
            if a.fi_n - 1 == 10 { a.fi10 = 0; };
            if a.fi_n - 1 == 11 { a.fi11 = 0; };
            if a.fi_n - 1 == 12 { a.fi12 = 0; };
            if a.fi_n - 1 == 13 { a.fi13 = 0; };
            if a.fi_n - 1 == 14 { a.fi14 = 0; };
            if a.fi_n - 1 == 15 { a.fi15 = 0; };
        };
        a.fi_n = a.fi_n - 1;
    } else {
        a.next_index = a.next_index + 1;
    };
    a = _si_push(a, idx);
    a.last_alloc_idx = idx;
    a.last_alloc_generation = a.generation;
    return a;
}

fn ecs_world_entity_allocator_deep_alloc_idx(a: EcsWorldEntityAllocatorDeep) -> i32 { return a.last_alloc_idx; }
fn ecs_world_entity_allocator_deep_alloc_gen(a: EcsWorldEntityAllocatorDeep) -> i32 { return a.last_alloc_generation; }
fn ecs_world_entity_allocator_deep_alloc_allocator(a: EcsWorldEntityAllocatorDeep) -> EcsWorldEntityAllocatorDeep { return a; }

fn ecs_world_entity_allocator_deep_free_push(a: EcsWorldEntityAllocatorDeep, idx: i32) -> EcsWorldEntityAllocatorDeep {
    // helper: push onto fi slot family.
    let i: i32 = a.fi_n;
    if i >= ECS_WE_DEEP_CAP { return a; };
    if i == 0 { a.fi0 = idx; };
    if i == 1 { a.fi1 = idx; };
    if i == 2 { a.fi2 = idx; };
    if i == 3 { a.fi3 = idx; };
    if i == 4 { a.fi4 = idx; };
    if i == 5 { a.fi5 = idx; };
    if i == 6 { a.fi6 = idx; };
    if i == 7 { a.fi7 = idx; };
    if i == 8 { a.fi8 = idx; };
    if i == 9 { a.fi9 = idx; };
    if i == 10 { a.fi10 = idx; };
    if i == 11 { a.fi11 = idx; };
    if i == 12 { a.fi12 = idx; };
    if i == 13 { a.fi13 = idx; };
    if i == 14 { a.fi14 = idx; };
    if i == 15 { a.fi15 = idx; };
    a.fi_n = a.fi_n + 1;
    return a;
}

fn ecs_world_entity_allocator_deep_free(a: EcsWorldEntityAllocatorDeep, idx: i32) -> EcsWorldEntityAllocatorDeep {
    a = ecs_world_entity_allocator_deep_free_push(a, idx);
    let n: i32 = a.si_n;
    let i: i32 = 0;
    while i < n {
        if _si_at(a, i) == idx {
            a = _si_remove_at(a, i);
            return a;
        };
        i = i + 1;
    }
    return a;
}

fn ecs_world_entity_allocator_deep_is_spawned(a: EcsWorldEntityAllocatorDeep, idx: i32) -> bool {
    let n: i32 = a.si_n;
    let i: i32 = 0;
    while i < n {
        if _si_at(a, i) == idx { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_world_entity_allocator_deep_check_can_spawn_at(a: EcsWorldEntityAllocatorDeep, idx: i32) -> i32 {
    if ecs_world_entity_allocator_deep_is_spawned(a, idx) { return ecs_spawn_err_already_spawned_deep(); };
    return (0 - 1);
}

fn ecs_world_entity_allocator_deep_spawned_count(a: EcsWorldEntityAllocatorDeep) -> i32 {
    return a.si_n;
}

