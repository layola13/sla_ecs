fn _fac_st_at(f: EcsWorldSpawnFacadeDeep, idx: i32) -> i32 {
    if idx == 0 { return f.st0; };
    if idx == 1 { return f.st1; };
    if idx == 2 { return f.st2; };
    if idx == 3 { return f.st3; };
    if idx == 4 { return f.st4; };
    if idx == 5 { return f.st5; };
    if idx == 6 { return f.st6; };
    if idx == 7 { return f.st7; };
    if idx == 8 { return f.st8; };
    if idx == 9 { return f.st9; };
    if idx == 10 { return f.st10; };
    if idx == 11 { return f.st11; };
    if idx == 12 { return f.st12; };
    if idx == 13 { return f.st13; };
    if idx == 14 { return f.st14; };
    if idx == 15 { return f.st15; };
    panic(147146);
}

fn _fac_is_spawned(f: EcsWorldSpawnFacadeDeep, idx: i32) -> bool {
    let n: i32 = f.si_n;
    let i: i32 = 0;
    while i < n {
        if _fac_si_at(f, i) == idx { return true; };
        i = i + 1;
    }
    return false;
}

fn _fac_can_spawn_at(f: EcsWorldSpawnFacadeDeep, idx: i32) -> i32 {
    if _fac_is_spawned(f, idx) { return ecs_spawn_err_already_spawned_deep(); };
    return (0 - 1);
}

fn ecs_world_spawn_facade_deep_spawn_at(f: EcsWorldSpawnFacadeDeep, entity_idx: i32, type_id: i32) -> EcsWorldSpawnFacadeDeep {
    let check: i32 = _fac_can_spawn_at(f, entity_idx);
    if check != (0 - 1) {
        f.last_spawn_at_ok = 0;
        f.last_spawn_at_error_code = check;
        f.last_spawn_at_entity_idx = (0 - 1);
        return f;
    };
    f = _fac_si_push(f, entity_idx);
    // parallel push onto spawned_types (cap-guarded).
    let n: i32 = f.si_n; // current count post-push (mirrors si_n)
    if n > 0 { f = _fac_st_set(f, n - 1, type_id); };
    f.last_spawn_at_ok = 1;
    f.last_spawn_at_error_code = (0 - 1);
    f.last_spawn_at_entity_idx = entity_idx;
    return f;
}

fn ecs_world_spawn_facade_deep_spawn_empty_at(f: EcsWorldSpawnFacadeDeep, entity_idx: i32) -> EcsWorldSpawnFacadeDeep {
    return ecs_world_spawn_facade_deep_spawn_at(f, entity_idx, 0);
}

fn ecs_spawn_at_deep_facade(r: EcsWorldSpawnFacadeDeep) -> EcsWorldSpawnFacadeDeep { return r; }
fn ecs_spawn_at_deep_ok(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_spawn_at_ok; }
fn ecs_spawn_at_deep_error_code(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_spawn_at_error_code; }
fn ecs_spawn_at_deep_entity_idx(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_spawn_at_entity_idx; }

// spawn_batch: receives the type_ids via callers pushing one-by-one through an explicit API
// (since SLA lacks Vec parameterization on fns; we expose spawn_batch as a slice receiver
// via an add_type helper alongside spawn_batch_finish). Instead of accepting Vec<i32>,
// callers use `ecs_world_spawn_facade_deep_spawn_batch_step(...)` per type, then
// `ecs_world_spawn_facade_deep_spawn_batch_finish()` to materialise the result.
fn ecs_world_spawn_facade_deep_spawn_batch_step(f: EcsWorldSpawnFacadeDeep, type_id: i32) -> EcsWorldSpawnFacadeDeep {
    // allocates one entity and records the type_id on the parallel spawned_types slot.
    let idx: i32 = f.next_index;
    if f.fi_n > 0 {
        // pop_front (compact-backshift)
        idx = f.fi0;
        let k: i32 = 0;
        while k < f.fi_n - 1 {
            if k == 0 { f.fi0 = f.fi1; };
            if k == 1 { f.fi1 = f.fi2; };
            if k == 2 { f.fi2 = f.fi3; };
            if k == 3 { f.fi3 = f.fi4; };
            if k == 4 { f.fi4 = f.fi5; };
            if k == 5 { f.fi5 = f.fi6; };
            if k == 6 { f.fi6 = f.fi7; };
            if k == 7 { f.fi7 = f.fi8; };
            if k == 8 { f.fi8 = f.fi9; };
            if k == 9 { f.fi9 = f.fi10; };
            if k == 10 { f.fi10 = f.fi11; };
            if k == 11 { f.fi11 = f.fi12; };
            if k == 12 { f.fi12 = f.fi13; };
            if k == 13 { f.fi13 = f.fi14; };
            if k == 14 { f.fi14 = f.fi15; };
            k = k + 1;
        }
        // zero out the freed slot.
        let last_fi: i32 = f.fi_n - 1;
        if last_fi == 0 { f.fi0 = 0; };
        if last_fi == 1 { f.fi1 = 0; };
        if last_fi == 2 { f.fi2 = 0; };
        if last_fi == 3 { f.fi3 = 0; };
        if last_fi == 4 { f.fi4 = 0; };
        if last_fi == 5 { f.fi5 = 0; };
        if last_fi == 6 { f.fi6 = 0; };
        if last_fi == 7 { f.fi7 = 0; };
        if last_fi == 8 { f.fi8 = 0; };
        if last_fi == 9 { f.fi9 = 0; };
        if last_fi == 10 { f.fi10 = 0; };
        if last_fi == 11 { f.fi11 = 0; };
        if last_fi == 12 { f.fi12 = 0; };
        if last_fi == 13 { f.fi13 = 0; };
        if last_fi == 14 { f.fi14 = 0; };
        if last_fi == 15 { f.fi15 = 0; };
        f.fi_n = f.fi_n - 1;
    } else {
        f.next_index = f.next_index + 1;
    };
    f = _fac_si_push(f, idx);
    let n: i32 = f.si_n;
    if n > 0 { f = _fac_st_set(f, n - 1, type_id); };
    // record first-allocated when this is the first batch step.
    if f.last_spawn_batch_count == 0 {
        f.last_spawn_batch_first = idx;
    };
    f.last_spawn_batch_count = f.last_spawn_batch_count + 1;
    return f;
}

fn ecs_world_spawn_facade_deep_spawn_batch_finish(f: EcsWorldSpawnFacadeDeep) -> EcsWorldSpawnFacadeDeep {
    // Materialise/reset the batch companion so the next batch starts fresh.
    return f;
}

fn ecs_spawn_batch_deep_facade(r: EcsWorldSpawnFacadeDeep) -> EcsWorldSpawnFacadeDeep { return r; }
fn ecs_spawn_batch_deep_count(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_spawn_batch_count; }
fn ecs_spawn_batch_deep_first(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_spawn_batch_first; }

// Spawn-facade accessors.
fn ecs_world_spawn_facade_deep_spawn_at_ok(f: EcsWorldSpawnFacadeDeep) -> i32 { return f.last_spawn_at_ok; }
fn ecs_world_spawn_facade_deep_spawned_count(f: EcsWorldSpawnFacadeDeep) -> i32 { return f.si_n; }
fn ecs_world_spawn_facade_deep_next_index(f: EcsWorldSpawnFacadeDeep) -> i32 { return f.next_index; }

// === EcsWorldComponentsQueueDeep (cap-16 queued_type_ids + queued_storage_kinds parallel) ===
@derive(copy)
struct EcsWorldComponentsQueueDeep {
    qt0: i32, qt1: i32, qt2: i32, qt3: i32, qt4: i32, qt5: i32, qt6: i32, qt7: i32,
    qt8: i32, qt9: i32, qt10: i32, qt11: i32, qt12: i32, qt13: i32, qt14: i32, qt15: i32,
    sk0: i32, sk1: i32, sk2: i32, sk3: i32, sk4: i32, sk5: i32, sk6: i32, sk7: i32,
    sk8: i32, sk9: i32, sk10: i32, sk11: i32, sk12: i32, sk13: i32, sk14: i32, sk15: i32,
    count: i32,
    last_at_found: i32,
    last_at_type_id: i32,
    last_at_storage_kind: i32,
    last_apply_applied: i32,
}

fn ecs_world_components_queue_deep_new() -> EcsWorldComponentsQueueDeep {
    return EcsWorldComponentsQueueDeep {
        qt0: 0, qt1: 0, qt2: 0, qt3: 0, qt4: 0, qt5: 0, qt6: 0, qt7: 0,
        qt8: 0, qt9: 0, qt10: 0, qt11: 0, qt12: 0, qt13: 0, qt14: 0, qt15: 0,
        sk0: 0, sk1: 0, sk2: 0, sk3: 0, sk4: 0, sk5: 0, sk6: 0, sk7: 0,
        sk8: 0, sk9: 0, sk10: 0, sk11: 0, sk12: 0, sk13: 0, sk14: 0, sk15: 0,
        count: 0,
        last_at_found: 0, last_at_type_id: 0, last_at_storage_kind: 0,
        last_apply_applied: 0,
    };
}

fn _cqt_at(q: EcsWorldComponentsQueueDeep, idx: i32) -> i32 {
    if idx == 0 { return q.qt0; };
    if idx == 1 { return q.qt1; };
    if idx == 2 { return q.qt2; };
    if idx == 3 { return q.qt3; };
    if idx == 4 { return q.qt4; };
    if idx == 5 { return q.qt5; };
    if idx == 6 { return q.qt6; };
    if idx == 7 { return q.qt7; };
    if idx == 8 { return q.qt8; };
    if idx == 9 { return q.qt9; };
    if idx == 10 { return q.qt10; };
    if idx == 11 { return q.qt11; };
    if idx == 12 { return q.qt12; };
    if idx == 13 { return q.qt13; };
    if idx == 14 { return q.qt14; };
    if idx == 15 { return q.qt15; };
    panic(147147);
}
fn _csk_at(q: EcsWorldComponentsQueueDeep, idx: i32) -> i32 {
    if idx == 0 { return q.sk0; };
    if idx == 1 { return q.sk1; };
    if idx == 2 { return q.sk2; };
    if idx == 3 { return q.sk3; };
    if idx == 4 { return q.sk4; };
    if idx == 5 { return q.sk5; };
    if idx == 6 { return q.sk6; };
    if idx == 7 { return q.sk7; };
    if idx == 8 { return q.sk8; };
    if idx == 9 { return q.sk9; };
    if idx == 10 { return q.sk10; };
    if idx == 11 { return q.sk11; };
    if idx == 12 { return q.sk12; };
    if idx == 13 { return q.sk13; };
    if idx == 14 { return q.sk14; };
    if idx == 15 { return q.sk15; };
    panic(147148);
}
fn _cqt_set(q: EcsWorldComponentsQueueDeep, idx: i32, v: i32) -> EcsWorldComponentsQueueDeep {
    if idx == 0 { q.qt0 = v; return q; };
    if idx == 1 { q.qt1 = v; return q; };
    if idx == 2 { q.qt2 = v; return q; };
    if idx == 3 { q.qt3 = v; return q; };
    if idx == 4 { q.qt4 = v; return q; };
    if idx == 5 { q.qt5 = v; return q; };
    if idx == 6 { q.qt6 = v; return q; };
    if idx == 7 { q.qt7 = v; return q; };
    if idx == 8 { q.qt8 = v; return q; };
    if idx == 9 { q.qt9 = v; return q; };
    if idx == 10 { q.qt10 = v; return q; };
    if idx == 11 { q.qt11 = v; return q; };
    if idx == 12 { q.qt12 = v; return q; };
    if idx == 13 { q.qt13 = v; return q; };
    if idx == 14 { q.qt14 = v; return q; };
    if idx == 15 { q.qt15 = v; return q; };
    panic(147149);
}
fn _csk_set(q: EcsWorldComponentsQueueDeep, idx: i32, v: i32) -> EcsWorldComponentsQueueDeep {
    if idx == 0 { q.sk0 = v; return q; };
    if idx == 1 { q.sk1 = v; return q; };
    if idx == 2 { q.sk2 = v; return q; };
    if idx == 3 { q.sk3 = v; return q; };
    if idx == 4 { q.sk4 = v; return q; };
    if idx == 5 { q.sk5 = v; return q; };
    if idx == 6 { q.sk6 = v; return q; };
    if idx == 7 { q.sk7 = v; return q; };
    if idx == 8 { q.sk8 = v; return q; };
    if idx == 9 { q.sk9 = v; return q; };
    if idx == 10 { q.sk10 = v; return q; };
    if idx == 11 { q.sk11 = v; return q; };
    if idx == 12 { q.sk12 = v; return q; };
    if idx == 13 { q.sk13 = v; return q; };
    if idx == 14 { q.sk14 = v; return q; };
    if idx == 15 { q.sk15 = v; return q; };
    panic(147150);
}

fn ecs_world_components_queue_deep_at(q: EcsWorldComponentsQueueDeep, idx: i32) -> EcsWorldComponentsQueueDeep {
    if idx < 0 || idx >= q.count {
        q.last_at_found = 0;
        q.last_at_type_id = 0;
        q.last_at_storage_kind = 0;
        return q;
    };
    q.last_at_found = 1;
    q.last_at_type_id = _cqt_at(q, idx);
    q.last_at_storage_kind = _csk_at(q, idx);
    return q;
}
fn ecs_queue_at_deep_found(q: EcsWorldComponentsQueueDeep) -> bool { return q.last_at_found == 1; }
fn ecs_queue_at_deep_type_id(q: EcsWorldComponentsQueueDeep) -> i32 { return q.last_at_type_id; }
fn ecs_queue_at_deep_storage_kind(q: EcsWorldComponentsQueueDeep) -> i32 { return q.last_at_storage_kind; }
fn ecs_world_components_queue_deep_len(q: EcsWorldComponentsQueueDeep) -> i32 { return q.count; }

fn ecs_world_components_queue_deep_enqueue(q: EcsWorldComponentsQueueDeep, type_id: i32, storage_kind: i32) -> EcsWorldComponentsQueueDeep {
    if q.count < ECS_WE_DEEP_CAP {
        q = _cqt_set(q, q.count, type_id);
        q = _csk_set(q, q.count, storage_kind);
        q.count = q.count + 1;
    };
    return q;
}

fn ecs_world_components_queue_deep_apply(q: EcsWorldComponentsQueueDeep) -> EcsWorldComponentsQueueDeep {
    let n: i32 = q.count;
    let i: i32 = 0;
    while i < n {
        // pop_front (compact-backshift)
        let k: i32 = 0;
        while k < q.count - 1 {
            q = _cqt_set(q, k, _cqt_at(q, k + 1));
            q = _csk_set(q, k, _csk_at(q, k + 1));
            k = k + 1;
        }
        if q.count > 0 {
            q = _cqt_set(q, q.count - 1, 0);
            q = _csk_set(q, q.count - 1, 0);
            q.count = q.count - 1;
        };
        i = i + 1;
    }
    q.last_apply_applied = n;
    return q;
}
fn ecs_queue_apply_deep_queue(q: EcsWorldComponentsQueueDeep) -> EcsWorldComponentsQueueDeep { return q; }
fn ecs_queue_apply_deep_applied(q: EcsWorldComponentsQueueDeep) -> i32 { return q.last_apply_applied; }

// === EcsUnsafeWorldCellDeep (scalar mirror) ===
@derive(copy)
struct EcsUnsafeWorldCellDeep {
    world_ptr: i64,
    readonly: i32,
}

fn ecs_world_unsafe_cell_deep_new(world_ptr: i64) -> EcsUnsafeWorldCellDeep {
    return EcsUnsafeWorldCellDeep { world_ptr: world_ptr, readonly: 0 };
}
fn ecs_world_unsafe_cell_deep_readonly(world_ptr: i64) -> EcsUnsafeWorldCellDeep {
    return EcsUnsafeWorldCellDeep { world_ptr: world_ptr, readonly: 1 };
}
fn ecs_world_unsafe_cell_deep_ptr(c: EcsUnsafeWorldCellDeep) -> i64 { return c.world_ptr; }
fn ecs_world_unsafe_cell_deep_is_readonly(c: EcsUnsafeWorldCellDeep) -> bool { return c.readonly != 0; }

// === modify_component / modify_resource ===
fn ecs_world_modify_component_deep(facade: EcsWorldSpawnFacadeDeep, entity_idx: i32, type_id: i32, mutator_handle: i32, new_value: i32) -> EcsWorldSpawnFacadeDeep {
    if _fac_is_spawned(facade, entity_idx) != true {
        facade.last_modify_ok = 0;
        facade.last_modify_error_code = ecs_entity_fetch_err_not_spawned_deep();
        facade.last_modify_present = 0;
        return facade;
    };
    let n: i32 = facade.si_n;
    let i: i32 = 0;
    let mut_idx: i32 = (0 - 1);
    while i < n {
        if _fac_si_at(facade, i) == entity_idx {
            if _fac_st_at(facade, i) == type_id {
                mut_idx = i;
            };
        };
        i = i + 1;
    }
    let _ = mutator_handle;
    if mut_idx < 0 {
        facade.last_modify_ok = 1;
        facade.last_modify_error_code = (0 - 1);
        facade.last_modify_present = 0;
        return facade;
    };
    facade = _fac_st_set(facade, mut_idx, new_value);
    facade.last_modify_ok = 1;
    facade.last_modify_error_code = (0 - 1);
    facade.last_modify_present = 1;
    return facade;
}

fn ecs_modify_deep_facade(r: EcsWorldSpawnFacadeDeep) -> EcsWorldSpawnFacadeDeep { return r; }
fn ecs_modify_deep_ok(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_modify_ok; }
fn ecs_modify_deep_error_code(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_modify_error_code; }
fn ecs_modify_deep_present(r: EcsWorldSpawnFacadeDeep) -> i32 { return r.last_modify_present; }
fn ecs_world_spawn_facade_deep_type_at(f: EcsWorldSpawnFacadeDeep, idx: i32) -> i32 {
    return _fac_st_at(f, idx);
}

// modify_resource / by_id aliases (resources structure carries the lookup; the mutation lands
// on the spawn facade).
fn ecs_world_modify_resource_deep(re: EcsWorldResourceEntitiesDeep, facade: EcsWorldSpawnFacadeDeep, component_id: i32, mutator_handle: i32, new_value: i32) -> EcsWorldSpawnFacadeDeep {
    re = ecs_world_resource_entities_deep_get(re, component_id);
    if re.last_get_found != 1 {
        facade.last_modify_ok = 1;
        facade.last_modify_error_code = (0 - 1);
        facade.last_modify_present = 0;
        return facade;
    };
    let ent_idx = re.last_get_entity_idx;
    return ecs_world_modify_component_deep(facade, ent_idx, component_id, mutator_handle, new_value);
}

fn ecs_world_modify_component_by_id_deep(facade: EcsWorldSpawnFacadeDeep, entity_idx: i32, component_id: i32, mutator_handle: i32, new_value: i32) -> EcsWorldSpawnFacadeDeep {
    return ecs_world_modify_component_deep(facade, entity_idx, component_id, mutator_handle, new_value);
}
fn ecs_world_modify_resource_by_id_deep(re: EcsWorldResourceEntitiesDeep, facade: EcsWorldSpawnFacadeDeep, component_id: i32, mutator_handle: i32, new_value: i32) -> EcsWorldSpawnFacadeDeep {
    return ecs_world_modify_resource_deep(re, facade, component_id, mutator_handle, new_value);
}
