        fi0: 0, fi1: 0, fi2: 0, fi3: 0, fi4: 0, fi5: 0, fi6: 0, fi7: 0,
        fi8: 0, fi9: 0, fi10: 0, fi11: 0, fi12: 0, fi13: 0, fi14: 0, fi15: 0,
        fi_n: 0,
        si0: 0, si1: 0, si2: 0, si3: 0, si4: 0, si5: 0, si6: 0, si7: 0,
        si8: 0, si9: 0, si10: 0, si11: 0, si12: 0, si13: 0, si14: 0, si15: 0,
        si_n: 0,
        last_alloc_idx: 0,
        last_alloc_generation: 1,
    };
}

fn _fi_at(a: EcsWorldEntityAllocatorDeep, idx: i32) -> i32 {
    if idx == 0 { return a.fi0; };
    if idx == 1 { return a.fi1; };
    if idx == 2 { return a.fi2; };
    if idx == 3 { return a.fi3; };
    if idx == 4 { return a.fi4; };
    if idx == 5 { return a.fi5; };
    if idx == 6 { return a.fi6; };
    if idx == 7 { return a.fi7; };
    if idx == 8 { return a.fi8; };
    if idx == 9 { return a.fi9; };
    if idx == 10 { return a.fi10; };
    if idx == 11 { return a.fi11; };
    if idx == 12 { return a.fi12; };
    if idx == 13 { return a.fi13; };
    if idx == 14 { return a.fi14; };
    if idx == 15 { return a.fi15; };
    panic(147136);
}
fn _si_at(a: EcsWorldEntityAllocatorDeep, idx: i32) -> i32 {
    if idx == 0 { return a.si0; };
    if idx == 1 { return a.si1; };
    if idx == 2 { return a.si2; };
    if idx == 3 { return a.si3; };
    if idx == 4 { return a.si4; };
    if idx == 5 { return a.si5; };
    if idx == 6 { return a.si6; };
    if idx == 7 { return a.si7; };
    if idx == 8 { return a.si8; };
    if idx == 9 { return a.si9; };
    if idx == 10 { return a.si10; };
    if idx == 11 { return a.si11; };
    if idx == 12 { return a.si12; };
    if idx == 13 { return a.si13; };
    if idx == 14 { return a.si14; };
    if idx == 15 { return a.si15; };
