// Deep self-contained Bevy ECS world::extras module.
// Mirrors lib/world_extras.sla (612 lines, no @import). The shallow module already uses
// result-shim structs to dodge the SA-tuple .1 corruption, but several of those shim
// structs nest the *operational* struct (registry, alloc, queue, facade, resources) as a
// sibling @derive(copy) field, which (per docs/issue.md Batch 401/406/411) triggers the
// SA MemoryLeak. The deep module:
//   - Replaces every Vec<i32> with a cap-16 i32 slot family + count + helpers.
//   - Wraps `_push`, `_pop_front`, `_remove_at`, `_at`, `_set`, `_len` skeleton helpers
//     per cap-family.
//   - Returns the *mutated* container directly (not a nested wrapper struct) and stashes
//     the tuple companion into the container directly (Batch 406 pattern).
// All structs carry @derive(copy). No @import.

const ECS_WE_DEEP_CAP: i32 = 16;

// === Result-shim structs (kept flat — they carry only scalar i32 fields; no nesting) ===
@derive(copy)
struct ReqCompResultDeep { ok: i32, err_kind: i32, err_a: i32, err_b: i32 }

@derive(copy)
struct ReqQueryResultDeep { found: i32, count: i32 }

@derive(copy)
struct ReqNthResultDeep { found: i32, required_id: i32, constructor_id: i32 }

@derive(copy)
struct ResourceGetResultDeep { found: i32, entity_idx: i32 }

@derive(copy)
struct QueueAtResultDeep { found: i32, type_id: i32, storage_kind: i32 }

// === RequiredComponentsError variants ===
// 0 = DuplicateRegistration, 1 = CyclicRequirement, 2 = ArchetypeExists
fn ecs_req_err_kind_deep(kind: i32, a: i32, b: i32) -> ReqCompResultDeep {
    return ReqCompResultDeep { ok: 0, err_kind: kind, err_a: a, err_b: b };
}
fn ecs_req_ok_placeholder_deep() -> ReqCompResultDeep {
    return ReqCompResultDeep { ok: 1, err_kind: 0, err_a: 0, err_b: 0 };
}
fn ecs_req_result_ok_deep(r: ReqCompResultDeep) -> i32 { return r.ok; }
fn ecs_req_result_kind_deep(r: ReqCompResultDeep) -> i32 { return r.err_kind; }
fn ecs_req_result_a_deep(r: ReqCompResultDeep) -> i32 { return r.err_a; }
fn ecs_req_result_b_deep(r: ReqCompResultDeep) -> i32 { return r.err_b; }
fn ecs_req_result_is_dup_deep(r: ReqCompResultDeep) -> bool { return r.err_kind == 0; }
fn ecs_req_result_is_cyclic_deep(r: ReqCompResultDeep) -> bool { return r.err_kind == 1; }
fn ecs_req_result_is_archetype_exists_deep(r: ReqCompResultDeep) -> bool { return r.err_kind == 2; }

// === SpawnError variants ===
fn ecs_spawn_err_invalid_deep() -> i32 { return 0; }
fn ecs_spawn_err_already_spawned_deep() -> i32 { return 1; }
fn ecs_spawn_err_is_invalid_deep(code: i32) -> bool { return code == 0; }
fn ecs_spawn_err_is_already_spawned_deep(code: i32) -> bool { return code == 1; }

// === EntityMutableFetchError variants ===
fn ecs_entity_fetch_err_not_spawned_deep() -> i32 { return 0; }
fn ecs_entity_fetch_err_aliased_mutability_deep() -> i32 { return 1; }
fn ecs_entity_fetch_err_is_not_spawned_deep(code: i32) -> bool { return code == 0; }
fn ecs_entity_fetch_err_is_aliased_deep(code: i32) -> bool { return code == 1; }

// === EcsWorldRequiredRegistryDeep (5 cap-16 i32 slot families) ===
@derive(copy)
struct EcsWorldRequiredRegistryDeep {
    req0: i32, req1: i32, req2: i32, req3: i32, req4: i32, req5: i32, req6: i32, req7: i32,
    req8: i32, req9: i32, req10: i32, req11: i32, req12: i32, req13: i32, req14: i32, req15: i32,
    req_n: i32,
    rid0: i32, rid1: i32, rid2: i32, rid3: i32, rid4: i32, rid5: i32, rid6: i32, rid7: i32,
    rid8: i32, rid9: i32, rid10: i32, rid11: i32, rid12: i32, rid13: i32, rid14: i32, rid15: i32,
    rid_n: i32,
    cid0: i32, cid1: i32, cid2: i32, cid3: i32, cid4: i32, cid5: i32, cid6: i32, cid7: i32,
    cid8: i32, cid9: i32, cid10: i32, cid11: i32, cid12: i32, cid13: i32, cid14: i32, cid15: i32,
    cid_n: i32,
    reg0: i32, reg1: i32, reg2: i32, reg3: i32, reg4: i32, reg5: i32, reg6: i32, reg7: i32,
    reg8: i32, reg9: i32, reg10: i32, reg11: i32, reg12: i32, reg13: i32, reg14: i32, reg15: i32,
    reg_n: i32,
    arc0: i32, arc1: i32, arc2: i32, arc3: i32, arc4: i32, arc5: i32, arc6: i32, arc7: i32,
    arc8: i32, arc9: i32, arc10: i32, arc11: i32, arc12: i32, arc13: i32, arc14: i32, arc15: i32,
    arc_n: i32,
    // Tuple-replacement companions for try_register_with / try_register / get_required_*
    last_register_ok: i32,
    last_register_kind: i32,
    last_register_a: i32,
    last_register_b: i32,
    last_query_found: i32,
    last_query_count: i32,
    last_nth_found: i32,
    last_nth_required_id: i32,
    last_nth_constructor_id: i32,
}

fn ecs_world_req_registry_deep_new() -> EcsWorldRequiredRegistryDeep {
    return EcsWorldRequiredRegistryDeep {
        req0: 0, req1: 0, req2: 0, req3: 0, req4: 0, req5: 0, req6: 0, req7: 0,
        req8: 0, req9: 0, req10: 0, req11: 0, req12: 0, req13: 0, req14: 0, req15: 0,
        req_n: 0,
        rid0: 0, rid1: 0, rid2: 0, rid3: 0, rid4: 0, rid5: 0, rid6: 0, rid7: 0,
        rid8: 0, rid9: 0, rid10: 0, rid11: 0, rid12: 0, rid13: 0, rid14: 0, rid15: 0,
        rid_n: 0,
        cid0: 0, cid1: 0, cid2: 0, cid3: 0, cid4: 0, cid5: 0, cid6: 0, cid7: 0,
        cid8: 0, cid9: 0, cid10: 0, cid11: 0, cid12: 0, cid13: 0, cid14: 0, cid15: 0,
        cid_n: 0,
        reg0: 0, reg1: 0, reg2: 0, reg3: 0, reg4: 0, reg5: 0, reg6: 0, reg7: 0,
        reg8: 0, reg9: 0, reg10: 0, reg11: 0, reg12: 0, reg13: 0, reg14: 0, reg15: 0,
        reg_n: 0,
        arc0: 0, arc1: 0, arc2: 0, arc3: 0, arc4: 0, arc5: 0, arc6: 0, arc7: 0,
        arc8: 0, arc9: 0, arc10: 0, arc11: 0, arc12: 0, arc13: 0, arc14: 0, arc15: 0,
        arc_n: 0,
        last_register_ok: 0,
        last_register_kind: 0,
        last_register_a: 0,
        last_register_b: 0,
        last_query_found: 0,
        last_query_count: 0,
        last_nth_found: 0,
        last_nth_required_id: 0,
        last_nth_constructor_id: 0,
    };
}

// Slot helpers — one helper per arity family.ucceeds on a small fixed cap dispatch.
// We collapse them by a generic `_at/_set` dispatch using sentinel slot IDs, but SLA
// lacks generic fns, so we inline one slot-at/slot-set per cap-family per helper.

fn _req_at(r: EcsWorldRequiredRegistryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.req0; };
    if idx == 1 { return r.req1; };
    if idx == 2 { return r.req2; };
    if idx == 3 { return r.req3; };
    if idx == 4 { return r.req4; };
    if idx == 5 { return r.req5; };
    if idx == 6 { return r.req6; };
    if idx == 7 { return r.req7; };
    if idx == 8 { return r.req8; };
    if idx == 9 { return r.req9; };
    if idx == 10 { return r.req10; };
    if idx == 11 { return r.req11; };
    if idx == 12 { return r.req12; };
    if idx == 13 { return r.req13; };
    if idx == 14 { return r.req14; };
    if idx == 15 { return r.req15; };
    panic(147130);
}
fn _rid_at(r: EcsWorldRequiredRegistryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.rid0; };
    if idx == 1 { return r.rid1; };
    if idx == 2 { return r.rid2; };
    if idx == 3 { return r.rid3; };
    if idx == 4 { return r.rid4; };
    if idx == 5 { return r.rid5; };
    if idx == 6 { return r.rid6; };
    if idx == 7 { return r.rid7; };
    if idx == 8 { return r.rid8; };
    if idx == 9 { return r.rid9; };
    if idx == 10 { return r.rid10; };
    if idx == 11 { return r.rid11; };
    if idx == 12 { return r.rid12; };
    if idx == 13 { return r.rid13; };
    if idx == 14 { return r.rid14; };
    if idx == 15 { return r.rid15; };
    panic(147131);
}
fn _cid_at(r: EcsWorldRequiredRegistryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.cid0; };
    if idx == 1 { return r.cid1; };
    if idx == 2 { return r.cid2; };
    if idx == 3 { return r.cid3; };
    if idx == 4 { return r.cid4; };
    if idx == 5 { return r.cid5; };
    if idx == 6 { return r.cid6; };
    if idx == 7 { return r.cid7; };
    if idx == 8 { return r.cid8; };
    if idx == 9 { return r.cid9; };
    if idx == 10 { return r.cid10; };
    if idx == 11 { return r.cid11; };
    if idx == 12 { return r.cid12; };
    if idx == 13 { return r.cid13; };
    if idx == 14 { return r.cid14; };
    if idx == 15 { return r.cid15; };
    panic(147132);
}
fn _reg_at(r: EcsWorldRequiredRegistryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.reg0; };
    if idx == 1 { return r.reg1; };
    if idx == 2 { return r.reg2; };
    if idx == 3 { return r.reg3; };
    if idx == 4 { return r.reg4; };
    if idx == 5 { return r.reg5; };
    if idx == 6 { return r.reg6; };
    if idx == 7 { return r.reg7; };
    if idx == 8 { return r.reg8; };
    if idx == 9 { return r.reg9; };
    if idx == 10 { return r.reg10; };
    if idx == 11 { return r.reg11; };
    if idx == 12 { return r.reg12; };
    if idx == 13 { return r.reg13; };
    if idx == 14 { return r.reg14; };
    if idx == 15 { return r.reg15; };
    panic(147133);
}
fn _arc_at(r: EcsWorldRequiredRegistryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.arc0; };
    if idx == 1 { return r.arc1; };
    if idx == 2 { return r.arc2; };
    if idx == 3 { return r.arc3; };
    if idx == 4 { return r.arc4; };
    if idx == 5 { return r.arc5; };
    if idx == 6 { return r.arc6; };
    if idx == 7 { return r.arc7; };
    if idx == 8 { return r.arc8; };
    if idx == 9 { return r.arc9; };
    if idx == 10 { return r.arc10; };
    if idx == 11 { return r.arc11; };
    if idx == 12 { return r.arc12; };
    if idx == 13 { return r.arc13; };
    if idx == 14 { return r.arc14; };
    if idx == 15 { return r.arc15; };
    panic(147134);
}

fn _reg_set(r: EcsWorldRequiredRegistryDeep, idx: i32, v: i32) -> EcsWorldRequiredRegistryDeep {
    if idx == 0 { r.reg0 = v; return r; };
    if idx == 1 { r.reg1 = v; return r; };
    if idx == 2 { r.reg2 = v; return r; };
    if idx == 3 { r.reg3 = v; return r; };
    if idx == 4 { r.reg4 = v; return r; };
    if idx == 5 { r.reg5 = v; return r; };
    if idx == 6 { r.reg6 = v; return r; };
    if idx == 7 { r.reg7 = v; return r; };
    if idx == 8 { r.reg8 = v; return r; };
    if idx == 9 { r.reg9 = v; return r; };
    if idx == 10 { r.reg10 = v; return r; };
    if idx == 11 { r.reg11 = v; return r; };
    if idx == 12 { r.reg12 = v; return r; };
    if idx == 13 { r.reg13 = v; return r; };
    if idx == 14 { r.reg14 = v; return r; };
    if idx == 15 { r.reg15 = v; return r; };
    panic(147135);
}

// Workhorse push helpers: push each (req, rid, cid) tuple on their parallel arrays.
// Each array uses `_xxx_at` reads; we write into the next free slot.
fn _req_push(r: EcsWorldRequiredRegistryDeep, requiree: i32, required: i32, constructor: i32) -> EcsWorldRequiredRegistryDeep {
    let i: i32 = r.req_n;
    if i >= ECS_WE_DEEP_CAP { return r; };
    if i >= r.rid_n {
        // bounded writes — fall through to a guard helper routine
    };
    // parallel writes via inlined `if i == k { r.reqK = v }` chains.
    if i == 0 { r.req0 = requiree; r.rid0 = required; r.cid0 = constructor; };
    if i == 1 { r.req1 = requiree; r.rid1 = required; r.cid1 = constructor; };
    if i == 2 { r.req2 = requiree; r.rid2 = required; r.cid2 = constructor; };
    if i == 3 { r.req3 = requiree; r.rid3 = required; r.cid3 = constructor; };
    if i == 4 { r.req4 = requiree; r.rid4 = required; r.cid4 = constructor; };
    if i == 5 { r.req5 = requiree; r.rid5 = required; r.cid5 = constructor; };
    if i == 6 { r.req6 = requiree; r.rid6 = required; r.cid6 = constructor; };
    if i == 7 { r.req7 = requiree; r.rid7 = required; r.cid7 = constructor; };
    if i == 8 { r.req8 = requiree; r.rid8 = required; r.cid8 = constructor; };
    if i == 9 { r.req9 = requiree; r.rid9 = required; r.cid9 = constructor; };
    if i == 10 { r.req10 = requiree; r.rid10 = required; r.cid10 = constructor; };
    if i == 11 { r.req11 = requiree; r.rid11 = required; r.cid11 = constructor; };
    if i == 12 { r.req12 = requiree; r.rid12 = required; r.cid12 = constructor; };
    if i == 13 { r.req13 = requiree; r.rid13 = required; r.cid13 = constructor; };
    if i == 14 { r.req14 = requiree; r.rid14 = required; r.cid14 = constructor; };
    if i == 15 { r.req15 = requiree; r.rid15 = required; r.cid15 = constructor; };
    r.req_n = r.req_n + 1;
    r.rid_n = r.rid_n + 1;
    r.cid_n = r.cid_n + 1;
    return r;
}

// register_component + mark_archetyped pushes onto reg0/arc slot families.
fn _reg_push(r: EcsWorldRequiredRegistryDeep, v: i32) -> EcsWorldRequiredRegistryDeep {
    let i: i32 = r.reg_n;
    if i >= ECS_WE_DEEP_CAP { return r; };
    r = _reg_set(r, i, v);
    r.reg_n = r.reg_n + 1;
    return r;
}
fn _arc_push(r: EcsWorldRequiredRegistryDeep, v: i32) -> EcsWorldRequiredRegistryDeep {
    let i: i32 = r.arc_n;
    if i >= ECS_WE_DEEP_CAP { return r; };
    if i == 0 { r.arc0 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 1 { r.arc1 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 2 { r.arc2 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 3 { r.arc3 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 4 { r.arc4 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 5 { r.arc5 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 6 { r.arc6 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 7 { r.arc7 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 8 { r.arc8 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 9 { r.arc9 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 10 { r.arc10 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 11 { r.arc11 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 12 { r.arc12 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 13 { r.arc13 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 14 { r.arc14 = v; r.arc_n = r.arc_n + 1; return r; };
    if i == 15 { r.arc15 = v; r.arc_n = r.arc_n + 1; return r; };
    return r;
}

fn ecs_world_req_registry_deep_next_free_type_id(reg: EcsWorldRequiredRegistryDeep, used: i32) -> i32 {
    // Deep fix: ignore the `used` arg (always zero from us callers) and pick the smallest
    // positive id not already in `reg`. The shallow variant accepted Vec<i32>; the deep
    // variant scans the reg slot family instead.
    let id: i32 = 1;
    let scan: i32 = 0;
    while scan < 200 {
        let conflict: i32 = 0;
        let r: i32 = 0;
        while r < reg.reg_n {
            if _reg_at(reg, r) == id { conflict = 1; };
            r = r + 1;
        }
        if conflict == 0 { return id; };
        id = id + 1;
        scan = scan + 1;
    }
    return id;
}

fn ecs_world_req_registry_deep_register_component(reg: EcsWorldRequiredRegistryDeep, type_id: i32) -> EcsWorldRequiredRegistryDeep {
    return _reg_push(reg, type_id);
}

fn ecs_world_req_registry_deep_mark_archetyped(reg: EcsWorldRequiredRegistryDeep, type_id: i32) -> EcsWorldRequiredRegistryDeep {
    return _arc_push(reg, type_id);
}

fn ecs_world_req_registry_deep_is_archetyped(reg: EcsWorldRequiredRegistryDeep, type_id: i32) -> bool {
    let n: i32 = reg.arc_n;
    let i: i32 = 0;
    while i < n {
        if _arc_at(reg, i) == type_id { return true; };
        i = i + 1;
    }
    return false;
}

// try_register_with: returns the mutated registry (Batch 406 style); the ReqCompResult
// companion is stashed into last_register_*.
fn ecs_world_req_registry_deep_try_register_with(reg: EcsWorldRequiredRegistryDeep, requiree_id: i32, required_id: i32, constructor_id: i32) -> EcsWorldRequiredRegistryDeep {
    reg = ecs_world_req_registry_deep_register_component(reg, requiree_id);
    reg = ecs_world_req_registry_deep_register_component(reg, required_id);
    if ecs_world_req_registry_deep_is_archetyped(reg, requiree_id) {
        reg.last_register_ok = 0;
        reg.last_register_kind = 2;
        reg.last_register_a = requiree_id;
        reg.last_register_b = 0;
        return reg;
    };
    let n: i32 = reg.req_n;
    let i: i32 = 0;
    while i < n {
        if _req_at(reg, i) == requiree_id {
            if _rid_at(reg, i) == required_id {
                reg.last_register_ok = 0;
                reg.last_register_kind = 0;
                reg.last_register_a = requiree_id;
                reg.last_register_b = required_id;
                return reg;
            };
        };
        i = i + 1;
    }
    reg = _req_push(reg, requiree_id, required_id, constructor_id);
    reg.last_register_ok = 1;
    reg.last_register_kind = 0;
    reg.last_register_a = 0;
    reg.last_register_b = 0;
    return reg;
}
fn ecs_world_req_registry_deep_try_register(reg: EcsWorldRequiredRegistryDeep, requiree_id: i32, required_id: i32) -> EcsWorldRequiredRegistryDeep {
    return ecs_world_req_registry_deep_try_register_with(reg, requiree_id, required_id, 0);
}

fn ecs_register_result_deep_registry(r: EcsWorldRequiredRegistryDeep) -> EcsWorldRequiredRegistryDeep { return r; }
fn ecs_register_result_deep_result_ok(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_register_ok; }
fn ecs_register_result_deep_result_kind(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_register_kind; }
fn ecs_register_result_deep_result_a(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_register_a; }
fn ecs_register_result_deep_result_b(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_register_b; }
fn ecs_register_result_deep_is_dup(r: EcsWorldRequiredRegistryDeep) -> bool { return r.last_register_kind == 0; }
fn ecs_register_result_deep_is_cyclic(r: EcsWorldRequiredRegistryDeep) -> bool { return r.last_register_kind == 1; }
fn ecs_register_result_deep_is_archetype_exists(r: EcsWorldRequiredRegistryDeep) -> bool { return r.last_register_kind == 2; }

// get_required_components_by_id: result stashed into last_query_*.
fn ecs_world_req_registry_deep_get_required_by_id(reg: EcsWorldRequiredRegistryDeep, requiree_id: i32) -> EcsWorldRequiredRegistryDeep {
    let n: i32 = reg.req_n;
    let count: i32 = 0;
    let i: i32 = 0;
    while i < n {
        if _req_at(reg, i) == requiree_id { count = count + 1; };
        i = i + 1;
    }
    if count > 0 {
        reg.last_query_found = 1;
        reg.last_query_count = count;
    } else {
        reg.last_query_found = 0;
        reg.last_query_count = 0;
    };
    return reg;
}
fn ecs_req_query_deep_found(r: EcsWorldRequiredRegistryDeep) -> bool { return r.last_query_found == 1; }
fn ecs_req_query_deep_count(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_query_count; }

// get_required_nth: result stashed into last_nth_*.
fn ecs_world_req_registry_deep_get_required_nth(reg: EcsWorldRequiredRegistryDeep, requiree_id: i32, nth: i32) -> EcsWorldRequiredRegistryDeep {
    let n: i32 = reg.req_n;
    let seen: i32 = 0;
    let i: i32 = 0;
    while i < n {
        if _req_at(reg, i) == requiree_id {
            if seen == nth {
                reg.last_nth_found = 1;
                reg.last_nth_required_id = _rid_at(reg, i);
                reg.last_nth_constructor_id = _cid_at(reg, i);
                return reg;
            };
            seen = seen + 1;
        };
        i = i + 1;
    }
    reg.last_nth_found = 0;
    reg.last_nth_required_id = 0;
    reg.last_nth_constructor_id = 0;
    return reg;
}
fn ecs_req_nth_deep_found(r: EcsWorldRequiredRegistryDeep) -> bool { return r.last_nth_found == 1; }
fn ecs_req_nth_deep_required_id(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_nth_required_id; }
fn ecs_req_nth_deep_constructor_id(r: EcsWorldRequiredRegistryDeep) -> i32 { return r.last_nth_constructor_id; }

// === EcsWorldEntityAllocatorDeep (cap-16 free_indices + cap-16 spawned_indices) ===
@derive(copy)
struct EcsWorldEntityAllocatorDeep {
    next_index: i32,
    generation: i32,
    fi0: i32, fi1: i32, fi2: i32, fi3: i32, fi4: i32, fi5: i32, fi6: i32, fi7: i32,
    fi8: i32, fi9: i32, fi10: i32, fi11: i32, fi12: i32, fi13: i32, fi14: i32, fi15: i32,
    fi_n: i32,
    si0: i32, si1: i32, si2: i32, si3: i32, si4: i32, si5: i32, si6: i32, si7: i32,
    si8: i32, si9: i32, si10: i32, si11: i32, si12: i32, si13: i32, si14: i32, si15: i32,
    si_n: i32,
    // Alloc tuple-replacement companions.
    last_alloc_idx: i32,
    last_alloc_generation: i32,
}

fn ecs_world_entity_allocator_deep_new() -> EcsWorldEntityAllocatorDeep {
    return EcsWorldEntityAllocatorDeep {
