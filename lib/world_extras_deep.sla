    if idx == 13 { r.eid13 = v; return r; };
    if idx == 14 { r.eid14 = v; return r; };
    if idx == 15 { r.eid15 = v; return r; };
    panic(147142);
}

fn ecs_world_resource_entities_deep_insert(re: EcsWorldResourceEntitiesDeep, component_id: i32, entity_idx: i32) -> EcsWorldResourceEntitiesDeep {
    let n: i32 = re.count;
    let i: i32 = 0;
    while i < n {
        if _rcid_at(re, i) == component_id {
            re = _reid_set(re, i, entity_idx);
            return re;
        };
        i = i + 1;
    }
    if n < ECS_WE_DEEP_CAP {
        re = _rcid_set(re, n, component_id);
        re = _reid_set(re, n, entity_idx);
        re.count = re.count + 1;
    };
    return re;
}

fn ecs_world_resource_entities_deep_get(re: EcsWorldResourceEntitiesDeep, component_id: i32) -> EcsWorldResourceEntitiesDeep {
    let n: i32 = re.count;
    let i: i32 = 0;
    while i < n {
        if _rcid_at(re, i) == component_id {
            re.last_get_found = 1;
            re.last_get_entity_idx = _reid_at(re, i);
            return re;
        };
        i = i + 1;
    }
    re.last_get_found = 0;
    re.last_get_entity_idx = 0;
    return re;
}

fn ecs_world_resource_entities_deep_get_found(r: EcsWorldResourceEntitiesDeep) -> bool { return r.last_get_found == 1; }
fn ecs_world_resource_entities_deep_get_entity_idx(r: EcsWorldResourceEntitiesDeep) -> i32 { return r.last_get_entity_idx; }
fn ecs_world_resource_entities_deep_len(re: EcsWorldResourceEntitiesDeep) -> i32 { return re.count; }

