// Deep self-contained Bevy ECS system::system_registry templates — mirrors
// lib/system_registry_template.sla (312 lines). Self-contained fixed-cap (cap-16) scalar-slot
// families. No @import. All structs carry @derive(copy). Booleans are stored as i32 (0/1).
// Nested @derive(copy) sub-structs are flattened inline to avoid the SA backend MemoryLeak
// (see docs/issue.md).

const ECS_SYS_DEEP_CAP: i32 = 16;

// === SystemHandleOrValue (flat) ===
const ECS_SYS_HOV_DEEP_HANDLE: i32 = 0;
const ECS_SYS_HOV_DEEP_VALUE: i32 = 1;

@derive(copy)
struct EcsSystemHandleOrValueDeep {
    kind: i32,
    handle: i64,
    has_system_value: i32,
    system_id: i64,
}

fn ecs_sys_hov_deep_handle(handle_entity: i64) -> EcsSystemHandleOrValueDeep {
    return EcsSystemHandleOrValueDeep { kind: ECS_SYS_HOV_DEEP_HANDLE, handle: handle_entity, has_system_value: 0, system_id: 0 };
}

fn ecs_sys_hov_deep_value(system_id: i64) -> EcsSystemHandleOrValueDeep {
    return EcsSystemHandleOrValueDeep { kind: ECS_SYS_HOV_DEEP_VALUE, handle: 0, has_system_value: 1, system_id: system_id };
}

fn ecs_sys_hov_deep_is_handle(v: EcsSystemHandleOrValueDeep) -> bool { return v.kind == ECS_SYS_HOV_DEEP_HANDLE; }
fn ecs_sys_hov_deep_is_value(v: EcsSystemHandleOrValueDeep) -> bool { return v.kind == ECS_SYS_HOV_DEEP_VALUE; }
fn ecs_sys_hov_deep_handle_entity(v: EcsSystemHandleOrValueDeep) -> i64 { return v.handle; }
fn ecs_sys_hov_deep_system_id(v: EcsSystemHandleOrValueDeep) -> i64 { return v.system_id; }
fn ecs_sys_hov_deep_has_value(v: EcsSystemHandleOrValueDeep) -> bool { return v.has_system_value != 0; }

// === SystemHandleValue (flat: ref_count + inlined inner fields) ===
@derive(copy)
struct EcsSystemHandleValueDeep {
    ref_count: i64,
    inner_kind: i32,
    inner_handle: i64,
    inner_has_system_value: i32,
    inner_system_id: i64,
}

fn ecs_system_handle_value_deep_new(system_id: i64) -> EcsSystemHandleValueDeep {
    return EcsSystemHandleValueDeep {
        ref_count: 1,
        inner_kind: ECS_SYS_HOV_DEEP_VALUE,
        inner_handle: 0,
        inner_has_system_value: 1,
        inner_system_id: system_id,
    };
}

fn ecs_system_handle_value_deep_clone(v: EcsSystemHandleValueDeep) -> EcsSystemHandleValueDeep {
    v.ref_count = v.ref_count + 1;
    return v;
}

fn ecs_system_handle_value_deep_drop_clone(v: EcsSystemHandleValueDeep) -> EcsSystemHandleValueDeep {
    if v.ref_count > 0 {
        v.ref_count = v.ref_count - 1;
    };
    return v;
}

fn ecs_system_handle_value_deep_ref_count(v: EcsSystemHandleValueDeep) -> i64 { return v.ref_count; }
fn ecs_system_handle_value_deep_inner_kind(v: EcsSystemHandleValueDeep) -> i32 { return v.inner_kind; }
fn ecs_system_handle_value_deep_has_value(v: EcsSystemHandleValueDeep) -> bool { return v.inner_has_system_value != 0; }
fn ecs_system_handle_value_deep_handle(v: EcsSystemHandleValueDeep) -> i64 { return v.inner_handle; }

// build: for Value variant, register the system and convert to Handle in-place
fn ecs_system_handle_value_deep_build(v: EcsSystemHandleValueDeep, assigned_entity: i64) -> EcsSystemHandleValueDeep {
    if v.inner_kind == ECS_SYS_HOV_DEEP_VALUE && v.inner_has_system_value != 0 {
        v.inner_kind = ECS_SYS_HOV_DEEP_HANDLE;
        v.inner_handle = assigned_entity;
        v.inner_has_system_value = 0;
    };
    return v;
}

// === SystemHandleTemplate (flat: kind + handle + inlined value fields) ===
const ECS_SYS_TEMPLATE_DEEP_HANDLE: i32 = 0;
const ECS_SYS_TEMPLATE_DEEP_VALUE: i32 = 1;

@derive(copy)
struct EcsSystemHandleTemplateDeep {
    kind: i32,
    handle: i64,
    // Inlined EcsSystemHandleValueDeep fields.
    value_ref_count: i64,
    value_inner_kind: i32,
    value_inner_handle: i64,
    value_inner_has_system_value: i32,
    value_inner_system_id: i64,
    // Inline companion for the build's tuple-return replacement (avoids the SA MemoryLeak).
    last_build_entity: i64,
}

fn ecs_system_template_deep_handle_weak(entity: i64) -> EcsSystemHandleTemplateDeep {
    return EcsSystemHandleTemplateDeep {
        kind: ECS_SYS_TEMPLATE_DEEP_HANDLE, handle: entity,
        value_ref_count: 1,
        value_inner_kind: ECS_SYS_HOV_DEEP_VALUE,
        value_inner_handle: 0,
        value_inner_has_system_value: 1,
        value_inner_system_id: 0,
        last_build_entity: (0 - 1),
    };
}

fn ecs_system_template_deep_value(system_id: i64) -> EcsSystemHandleTemplateDeep {
    return EcsSystemHandleTemplateDeep {
        kind: ECS_SYS_TEMPLATE_DEEP_VALUE, handle: 0,
        value_ref_count: 1,
        value_inner_kind: ECS_SYS_HOV_DEEP_VALUE,
        value_inner_handle: 0,
        value_inner_has_system_value: 1,
        value_inner_system_id: system_id,
        last_build_entity: (0 - 1),
    };
}

fn ecs_system_template_deep_is_handle(t: EcsSystemHandleTemplateDeep) -> bool { return t.kind == ECS_SYS_TEMPLATE_DEEP_HANDLE; }
fn ecs_system_template_deep_is_value(t: EcsSystemHandleTemplateDeep) -> bool { return t.kind == ECS_SYS_TEMPLATE_DEEP_VALUE; }
fn ecs_system_template_deep_handle(t: EcsSystemHandleTemplateDeep) -> i64 { return t.handle; }
fn ecs_system_template_deep_value_ref_count(t: EcsSystemHandleTemplateDeep) -> i64 { return t.value_ref_count; }
fn ecs_system_template_deep_default() -> EcsSystemHandleTemplateDeep {
    return ecs_system_template_deep_handle_weak((0 - 1));
}

fn ecs_system_template_deep_clone(t: EcsSystemHandleTemplateDeep) -> EcsSystemHandleTemplateDeep {
    if t.kind == ECS_SYS_TEMPLATE_DEEP_HANDLE {
        return ecs_system_template_deep_handle_weak(t.handle);
    };
    let t2 = t;
    t2.value_ref_count = t2.value_ref_count + 1;
    return t2;
}

fn ecs_system_template_deep_from_handle(handle_entity: i64) -> EcsSystemHandleTemplateDeep {
    return ecs_system_template_deep_handle_weak(handle_entity);
}

fn ecs_system_template_deep_from_boxed(system_id: i64) -> EcsSystemHandleTemplateDeep {
    return ecs_system_template_deep_value(system_id);
}

fn ecs_system_template_deep_from_id(id_entity: i64) -> EcsSystemHandleTemplateDeep {
    return ecs_system_template_deep_handle_weak(id_entity);
}

// Accessor for build's tuple-companion entity (stored inline on the template).
fn ecs_template_deep_last_build_entity(t: EcsSystemHandleTemplateDeep) -> i64 {
    return t.last_build_entity;
}

// build_template: for Value variant, lazily register (consuming the value system), modifies the
// template in place and returns the mutated template with last_build_entity populated. For Handle
// variant, leaves the template unchanged and stores t.handle in last_build_entity.
fn ecs_system_template_deep_build(t: EcsSystemHandleTemplateDeep, assigned_entity: i64) -> EcsSystemHandleTemplateDeep {
    if t.kind == ECS_SYS_TEMPLATE_DEEP_HANDLE {
        t.last_build_entity = t.handle;
        return t;
    };
    let v = EcsSystemHandleValueDeep {
        ref_count: t.value_ref_count,
        inner_kind: t.value_inner_kind,
        inner_handle: t.value_inner_handle,
        inner_has_system_value: t.value_inner_has_system_value,
        inner_system_id: t.value_inner_system_id,
    };
    let v2 = ecs_system_handle_value_deep_build(v, assigned_entity);
    t.kind = ECS_SYS_TEMPLATE_DEEP_HANDLE;
    t.handle = assigned_entity;
    t.value_ref_count = v2.ref_count;
    t.value_inner_kind = v2.inner_kind;
    t.value_inner_handle = v2.inner_handle;
    t.value_inner_has_system_value = v2.inner_has_system_value;
    t.value_inner_system_id = v2.inner_system_id;
    t.last_build_entity = assigned_entity;
    return t;
}

fn ecs_system_value_deep_new(system_id: i64) -> EcsSystemHandleTemplateDeep {
    return ecs_system_template_deep_value(system_id);
}

// === CachedSystemId ===
@derive(copy)
struct EcsCachedSystemIdDeep {
    entity: i64,
    type_id: i32,
}

fn ecs_cached_system_id_deep_new(entity: i64, type_id: i32) -> EcsCachedSystemIdDeep {
    return EcsCachedSystemIdDeep { entity: entity, type_id: type_id };
}

fn ecs_cached_system_id_deep_entity(c: EcsCachedSystemIdDeep) -> i64 { return c.entity; }
fn ecs_cached_system_id_deep_type_id(c: EcsCachedSystemIdDeep) -> i32 { return c.type_id; }

// === Cap-16 i32 list for type_ids ===
@derive(copy)
struct EcsSysIdListDeepDeep {
    t0: i32, t1: i32, t2: i32, t3: i32, t4: i32, t5: i32, t6: i32, t7: i32,
    t8: i32, t9: i32, t10: i32, t11: i32, t12: i32, t13: i32, t14: i32, t15: i32,
    tn: i32,
}

fn _ecssysidlist_deep_at(list: EcsSysIdListDeepDeep, idx: i32) -> i32 {
    if idx == 0 { return list.t0; };
    if idx == 1 { return list.t1; };
    if idx == 2 { return list.t2; };
    if idx == 3 { return list.t3; };
    if idx == 4 { return list.t4; };
    if idx == 5 { return list.t5; };
    if idx == 6 { return list.t6; };
    if idx == 7 { return list.t7; };
    if idx == 8 { return list.t8; };
    if idx == 9 { return list.t9; };
    if idx == 10 { return list.t10; };
    if idx == 11 { return list.t11; };
    if idx == 12 { return list.t12; };
    if idx == 13 { return list.t13; };
    if idx == 14 { return list.t14; };
    if idx == 15 { return list.t15; };
    panic(146000);
}

fn _ecssysidlist_deep_set(list: EcsSysIdListDeepDeep, idx: i32, value: i32) -> EcsSysIdListDeepDeep {
    if idx == 0 { list.t0 = value; return list; };
    if idx == 1 { list.t1 = value; return list; };
    if idx == 2 { list.t2 = value; return list; };
    if idx == 3 { list.t3 = value; return list; };
    if idx == 4 { list.t4 = value; return list; };
    if idx == 5 { list.t5 = value; return list; };
    if idx == 6 { list.t6 = value; return list; };
    if idx == 7 { list.t7 = value; return list; };
    if idx == 8 { list.t8 = value; return list; };
    if idx == 9 { list.t9 = value; return list; };
    if idx == 10 { list.t10 = value; return list; };
    if idx == 11 { list.t11 = value; return list; };
    if idx == 12 { list.t12 = value; return list; };
    if idx == 13 { list.t13 = value; return list; };
    if idx == 14 { list.t14 = value; return list; };
    if idx == 15 { list.t15 = value; return list; };
    panic(146001);
}

// === Cap-16 i64 entity list (entities parallel to type_ids) ===
@derive(copy)
struct EcsSysEntListDeepDeep {
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    e8: i64, e9: i64, e10: i64, e11: i64, e12: i64, e13: i64, e14: i64, e15: i64,
    en: i32,
}

fn _ecssysentlist_deep_at(list: EcsSysEntListDeepDeep, idx: i32) -> i64 {
    if idx == 0 { return list.e0; };
    if idx == 1 { return list.e1; };
    if idx == 2 { return list.e2; };
    if idx == 3 { return list.e3; };
    if idx == 4 { return list.e4; };
    if idx == 5 { return list.e5; };
    if idx == 6 { return list.e6; };
    if idx == 7 { return list.e7; };
    if idx == 8 { return list.e8; };
    if idx == 9 { return list.e9; };
    if idx == 10 { return list.e10; };
    if idx == 11 { return list.e11; };
    if idx == 12 { return list.e12; };
    if idx == 13 { return list.e13; };
    if idx == 14 { return list.e14; };
    if idx == 15 { return list.e15; };
    panic(146002);
}

fn _ecssysentlist_deep_set(list: EcsSysEntListDeepDeep, idx: i32, value: i64) -> EcsSysEntListDeepDeep {
    if idx == 0 { list.e0 = value; return list; };
    if idx == 1 { list.e1 = value; return list; };
    if idx == 2 { list.e2 = value; return list; };
    if idx == 3 { list.e3 = value; return list; };
    if idx == 4 { list.e4 = value; return list; };
    if idx == 5 { list.e5 = value; return list; };
    if idx == 6 { list.e6 = value; return list; };
    if idx == 7 { list.e7 = value; return list; };
    if idx == 8 { list.e8 = value; return list; };
    if idx == 9 { list.e9 = value; return list; };
    if idx == 10 { list.e10 = value; return list; };
    if idx == 11 { list.e11 = value; return list; };
    if idx == 12 { list.e12 = value; return list; };
    if idx == 13 { list.e13 = value; return list; };
    if idx == 14 { list.e14 = value; return list; };
    if idx == 15 { list.e15 = value; return list; };
