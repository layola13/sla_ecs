fn table_erased_relationship_world_linked_despawn_order_append<R, M>(world: TableErasedRelationshipWorld<R, M>, entity: Entity, result: RelationshipEntityQuery) -> RelationshipEntityQuery {
    let k: i64 = 0;
    let kind_count = len(world.relationships.kinds) as i64;
    while k < kind_count {
        let kind = world.relationships.kinds[k];
        if kind.linked_spawn {
            let sources = relationship_world_sources(world.relationships, kind.id, entity);
            let i: i64 = 0;
            let cnt = len(sources.items) as i64;
            while i < cnt {
                result = table_erased_relationship_world_linked_despawn_order_append<R, M>(world, sources.items[i], result);
                i = i + 1;
            }
        };
        k = k + 1;
    }
    if relationship_entity_query_contains(result, entity) != true {
        result.items.push(entity_new(entity.id, entity.gen));
    };
    return result;
}

fn table_erased_relationship_world_linked_despawn_order<R, M>(world: TableErasedRelationshipWorld<R, M>, entity: Entity) -> RelationshipEntityQuery {
    let result = relationship_entity_query_new();
    return table_erased_relationship_world_linked_despawn_order_append<R, M>(world, entity, result);
}

fn table_erased_relationship_world_despawn<R, M>(world: TableErasedRelationshipWorld<R, M>, entity: Entity) -> TableErasedRelationshipWorld<R, M> {
    if table_erased_relationship_world_is_alive<R, M>(world, entity) != true { return world; };
    let order = table_erased_relationship_world_linked_despawn_order<R, M>(world, entity);
    let i: i64 = 0;
    let cnt = len(order.items) as i64;
    while i < cnt {
        world.table = table_erased_world_despawn<R, M>(world.table, order.items[i]);
        i = i + 1;
    }
    world.relationships = relationship_world_despawn(world.relationships, entity);
    return world;
}

fn table_erased_relationship_world_despawn_related<R, M>(world: TableErasedRelationshipWorld<R, M>, kind_id: i32, target: Entity) -> TableErasedRelationshipWorld<R, M> {
    let sources = relationship_world_sources(world.relationships, kind_id, target);
    let i: i64 = 0;
    let cnt = len(sources.items) as i64;
    while i < cnt {
        world = table_erased_relationship_world_despawn<R, M>(world, entity_new(sources.items[i].id, sources.items[i].gen));
        i = i + 1;
    }
    return world;
}

fn table_erased_relationship_test_world_new() -> TableErasedRelationshipWorld<TableErasedTime, TableErasedEvent> {
    return table_erased_relationship_world_new<TableErasedTime, TableErasedEvent>(table_erased_time_default(), table_erased_event_default());
}

@test "table erased relationship world exposes message reader cursor helpers"() {
    let raw = table_erased_relationship_test_world_new();
    let (raw_kind_world, kind) = table_erased_relationship_world_register_many<TableErasedTime, TableErasedEvent>(raw, true, false);
    let (raw_child_world, parent) = table_erased_relationship_world_spawn<TableErasedTime, TableErasedEvent>(raw_kind_world);
    let (raw_related_world, child) = table_erased_relationship_world_spawn<TableErasedTime, TableErasedEvent>(raw_child_world);
    let w0 = table_erased_relationship_world_set_related<TableErasedTime, TableErasedEvent>(raw_related_world, kind.id, child, parent);
    let w_tick = table_erased_relationship_world_increment_tick<TableErasedTime, TableErasedEvent>(w0);
    let w_res = table_erased_relationship_world_insert_resource<TableErasedTime, TableErasedEvent>(w_tick, TableErasedTime { tick: 9 });
    if table_erased_relationship_world_has_resource<TableErasedTime, TableErasedEvent>(w_res) != true { panic(12306); };
    if table_erased_relationship_world_get_resource<TableErasedTime, TableErasedEvent>(w_res).tick != 9 { panic(12307); };
    if table_erased_relationship_world_resource_added_since<TableErasedTime, TableErasedEvent>(w_res, 0) != true { panic(12308); };
    let res = table_erased_relationship_world_res<TableErasedTime, TableErasedEvent>(w_res);
    if res.value.tick != 9 { panic(12309); };
    let res_mut = table_erased_relationship_world_res_mut<TableErasedTime, TableErasedEvent>(w_res);
    let w_res_written = table_erased_relationship_world_res_mut_write<TableErasedTime, TableErasedEvent>(w_res, res_mut, TableErasedTime { tick: 10 });
    if table_erased_relationship_world_resource_changed_since<TableErasedTime, TableErasedEvent>(w_res_written, 0) != true { panic(12310); };
    if table_erased_relationship_world_get_resource<TableErasedTime, TableErasedEvent>(w_res_written).tick != 10 { panic(12311); };
    let w_removed = table_erased_relationship_world_remove_resource<TableErasedTime, TableErasedEvent>(w_res_written);
    if table_erased_relationship_world_has_resource<TableErasedTime, TableErasedEvent>(w_removed) { panic(12312); };
    let (w_default, default_id) = table_erased_relationship_world_write_default_message<TableErasedTime, TableErasedEvent>(w_removed, TableErasedEvent { amount: 4 });
    if default_id != 0 { panic(12313); };
    let (w_typed, typed_id) = table_erased_relationship_world_write_message_with_message_id<TableErasedTime, TableErasedEvent>(w_default, TableErasedEvent { amount: 6 });
    if message_id_typed_value<TableErasedEvent>(typed_id) != 1 { panic(12314); };
    let writer0 = message_writer_new<TableErasedEvent>();
    let writer1 = message_writer_send<TableErasedEvent>(writer0, TableErasedEvent { amount: 8 });
    let writer2 = message_writer_send<TableErasedEvent>(writer1, TableErasedEvent { amount: 10 });
    let (w_batch, first_batch, batch_count) = table_erased_relationship_world_write_message_batch<TableErasedTime, TableErasedEvent>(w_typed, writer2);
    if first_batch != 2 { panic(12315); };
    if batch_count != 2 { panic(12316); };
    let (w_id, raw_id) = table_erased_relationship_world_write_message_with_id<TableErasedTime, TableErasedEvent>(w_batch, TableErasedEvent { amount: 12 });
    if raw_id != 4 { panic(12317); };
