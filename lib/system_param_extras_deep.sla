// Deepened Bevy ECS system_param extras.
// Mirrors src/system/system_param.rs Local + StaticSystemParam + ValidationError.
// Scalar rebuild model. Shallow lib/system_param_extras.sla retained.

struct EcsSpeLocalDeep {
    value: i64,
    initialized: bool,
}

fn ecs_spe_local_from_world(initial: i64) -> EcsSpeLocalDeep {
    return EcsSpeLocalDeep { value: initial, initialized: true };
}

fn ecs_spe_local_uninit() -> EcsSpeLocalDeep {
    return EcsSpeLocalDeep { value: 0, initialized: false };
}

fn ecs_spe_local_get(l: EcsSpeLocalDeep) -> i64 { return l.value; }
fn ecs_spe_local_is_initialized(l: EcsSpeLocalDeep) -> bool { return l.initialized; }

fn ecs_spe_local_set(l: EcsSpeLocalDeep, value: i64) -> EcsSpeLocalDeep {
    return EcsSpeLocalDeep { value: value, initialized: true };
}

struct EcsSpeStaticDeep {
    inner: i64,
}

fn ecs_spe_static_new(inner: i64) -> EcsSpeStaticDeep {
    return EcsSpeStaticDeep { inner: inner };
}

fn ecs_spe_static_into_inner(p: EcsSpeStaticDeep) -> i64 { return p.inner; }
fn ecs_spe_static_get(p: EcsSpeStaticDeep) -> i64 { return p.inner; }

fn ecs_spe_static_set(p: EcsSpeStaticDeep, value: i64) -> EcsSpeStaticDeep {
    return EcsSpeStaticDeep { inner: value };
}

struct EcsSpeVeDeep {
    skipped: bool,
    message: i64,
    param: i32,
    field: i32,
}

fn ecs_spe_ve_empty() -> EcsSpeVeDeep {
    return EcsSpeVeDeep { skipped: false, message: 0, param: 0, field: 0 };
}

fn ecs_spe_ve_new(type_id: i32, skipped: bool, message: i64, field: i32) -> EcsSpeVeDeep {
    return EcsSpeVeDeep { skipped: skipped, message: message, param: type_id, field: field };
}

fn ecs_spe_ve_skipped(type_id: i32, message: i64) -> EcsSpeVeDeep {
    return EcsSpeVeDeep { skipped: true, message: message, param: type_id, field: 0 };
}

fn ecs_spe_ve_invalid(type_id: i32, message: i64) -> EcsSpeVeDeep {
    return EcsSpeVeDeep { skipped: false, message: message, param: type_id, field: 0 };
}

fn ecs_spe_ve_is_skipped(e: EcsSpeVeDeep) -> bool { return e.skipped; }
fn ecs_spe_ve_message(e: EcsSpeVeDeep) -> i64 { return e.message; }
fn ecs_spe_ve_param(e: EcsSpeVeDeep) -> i32 { return e.param; }
fn ecs_spe_ve_field(e: EcsSpeVeDeep) -> i32 { return e.field; }

fn ecs_spe_ve_is_empty(e: EcsSpeVeDeep) -> bool {
    if e.skipped { return false; };
    if e.message != 0 { return false; };
    if e.param != 0 { return false; };
    if e.field != 0 { return false; };
    return true;
}

struct EcsSpeVeDispDeep {
    param_short: i32,
    has_field: bool,
    message: i64,
}

fn ecs_spe_ve_display(e: EcsSpeVeDeep) -> EcsSpeVeDispDeep {
    let has_field = false;
    if e.field != 0 { has_field = true; };
    return EcsSpeVeDispDeep { param_short: e.param, has_field: has_field, message: e.message };
}

fn ecs_spe_ve_disp_param(d: EcsSpeVeDispDeep) -> i32 { return d.param_short; }
fn ecs_spe_ve_disp_has_field(d: EcsSpeVeDispDeep) -> bool { return d.has_field; }
fn ecs_spe_ve_disp_message(d: EcsSpeVeDispDeep) -> i64 { return d.message; }

// should_skip system gate: skipped validation => skip
fn ecs_spe_should_skip(e: EcsSpeVeDeep) -> bool { return e.skipped; }

// is_hard_error: invalid (not skipped) with message
fn ecs_spe_is_hard_error(e: EcsSpeVeDeep) -> bool {
    if e.skipped { return false; };
    if e.message == 0 { return false; };
    return true;
}

fn ecs_spe_ve_eq(a: EcsSpeVeDeep, b: EcsSpeVeDeep) -> bool {
    if a.skipped != b.skipped { return false; };
    if a.message != b.message { return false; };
    if a.param != b.param { return false; };
    if a.field != b.field { return false; };
    return true;
}

// Local + Static combined apply helper
fn ecs_spe_apply_local_to_static(l: EcsSpeLocalDeep, p: EcsSpeStaticDeep) -> EcsSpeStaticDeep {
    if l.initialized != true { return p; };
    return ecs_spe_static_set(p, l.value);
}
