// Bevy ECS component::register — ComponentIdRegistrator iterator + ComponentsQueuedRegistrator
// facade. Mirrors src/component/register.rs.

// === ComponentIdRegistrator: an atomic-counter-style iterator allocating fresh ComponentIds ===
struct EcsComponentIdRegistrator {
    next_id: i32,
    num_queued: i32,
    as_queued: bool,
}

fn ecs_registrator_new(start_id: i32) -> EcsComponentIdRegistrator {
    let r = EcsComponentIdRegistrator { next_id: start_id, num_queued: 0, as_queued: false };
    return r;
}

fn ecs_registrator_peek(r: EcsComponentIdRegistrator) -> i32 {
    return r.next_id;
}

// next(): returns the current id, then advances by 1 (atomic fetch_add equivalent).
fn ecs_registrator_next(r: EcsComponentIdRegistrator) -> (i32, EcsComponentIdRegistrator) {
    let id = r.next_id;
    r.next_id = r.next_id + 1;
    return (id, r);
}

fn ecs_registrator_peek_mut(r: EcsComponentIdRegistrator) -> i32 {
    return r.next_id;
}

// next_mut(): same as next but returned through path-with-mut (here equivalent to next).
fn ecs_registrator_next_mut(r: EcsComponentIdRegistrator) -> (i32, EcsComponentIdRegistrator) {
    return ecs_registrator_next(r);
}

// len: number of ids remaining between current and ... continue reserves for queued - we model a cap.
// Bevy's len returns remaining outstanding queued ops; here `num_queued` is the outstanding count.
fn ecs_registrator_len(r: EcsComponentIdRegistrator) -> i32 {
    return r.num_queued;
}

fn ecs_registrator_is_empty(r: EcsComponentIdRegistrator) -> bool {
    return r.num_queued == 0;
}

// as_queued: returns a ComponentsQueuedRegistrator view, marking mode.
fn ecs_registrator_as_queued(r: EcsComponentIdRegistrator) -> EcsComponentIdRegistrator {
    r.as_queued = true;
    return r;
}

// any_queued_mut: true iff queue has ops awaiting apply
fn ecs_registrator_any_queued_mut(r: EcsComponentIdRegistrator) -> bool {
    return r.num_queued > 0;
}

fn ecs_registrator_num_queued_mut(r: EcsComponentIdRegistrator) -> i32 {
    return r.num_queued;
}

// === queue_register_* API ===
// queue_register_component<E>: registers a queued op keyed by type_id, returns its future id.
fn ecs_registrator_queue_register_component(r: EcsComponentIdRegistrator, type_id: i64) -> (i32, EcsComponentIdRegistrator) {
    let id = r.next_id;
    r.next_id = r.next_id + 1;
    r.num_queued = r.num_queued + 1;
    let _ = type_id;
    return (id, r);
}

// queue_register_resource<E>: resources allocate ids but mark the registration differently; here:
// just deduplicates since resources shouldn't double-register.
fn ecs_registrator_queue_register_resource(r: EcsComponentIdRegistrator, type_id: i64) -> (i32, EcsComponentIdRegistrator) {
    let id = r.next_id;
    r.next_id = r.next_id + 1;
    r.num_queued = r.num_queued + 1;
    let _ = type_id;
    return (id, r);
}

// queue_register_non_send
fn ecs_registrator_queue_register_non_send(r: EcsComponentIdRegistrator, type_id: i64) -> (i32, EcsComponentIdRegistrator) {
    let id = r.next_id;
    r.next_id = r.next_id + 1;
    r.num_queued = r.num_queued + 1;
    let _ = type_id;
    return (id, r);
}

// apply_queued_registrations: drains the queue (resets num_queued to 0).
fn ecs_registrator_apply_queued_registrations(r: EcsComponentIdRegistrator) -> EcsComponentIdRegistrator {
    if ecs_registrator_any_queued_mut(r) {
        r.num_queued = 0;
    };
    return r;
}

// === register_component_with_descriptor<ClientComponents> style facade over the registrator ===
struct EcsComponentDescriptorTiny {
    storage_type: i32,
    is_resource: bool,
}

fn ecs_descriptor_tiny_new(storage_type: i32, is_resource: bool) -> EcsComponentDescriptorTiny {
    let d = EcsComponentDescriptorTiny { storage_type: storage_type, is_resource: is_resource };
    return d;
}

fn ecs_descriptor_tiny_storage_type(d: EcsComponentDescriptorTiny) -> i32 { return d.storage_type; }
fn ecs_descriptor_tiny_is_resource(d: EcsComponentDescriptorTiny) -> bool { return d.is_resource; }

fn ecs_registrator_register_with_descriptor(r: EcsComponentIdRegistrator, descriptor: EcsComponentDescriptorTiny) -> (i32, EcsComponentIdRegistrator) {
    let id = r.next_id;
    r.next_id = r.next_id + 1;
    let _ = descriptor;
    return (id, r);
}
