// Deepened Bevy ECS ScheduleBuildSettings + LogLevel + Metadata.
// Mirrors src/schedule/schedule.rs build config. Shallow retained.

const ECS_SBS_LOG_IGNORE: i32 = 0;
const ECS_SBS_LOG_WARN: i32 = 1;
const ECS_SBS_LOG_ERROR: i32 = 2;

fn ecs_sbs_log_ignore() -> i32 { return ECS_SBS_LOG_IGNORE; }
fn ecs_sbs_log_warn() -> i32 { return ECS_SBS_LOG_WARN; }
fn ecs_sbs_log_error() -> i32 { return ECS_SBS_LOG_ERROR; }

fn ecs_sbs_log_is_ignore(l: i32) -> bool { return l == ECS_SBS_LOG_IGNORE; }
fn ecs_sbs_log_is_warn(l: i32) -> bool { return l == ECS_SBS_LOG_WARN; }
fn ecs_sbs_log_is_error(l: i32) -> bool { return l == ECS_SBS_LOG_ERROR; }

struct EcsSbsDeep {
    ambiguity_detection: i32,
    hierarchy_detection: i32,
    auto_insert_apply_deferred: bool,
    use_shortnames: bool,
    report_sets: bool,
}

fn ecs_sbs_deep_default() -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: ECS_SBS_LOG_IGNORE,
        hierarchy_detection: ECS_SBS_LOG_WARN,
        auto_insert_apply_deferred: true,
        use_shortnames: true,
        report_sets: true,
    };
}

fn ecs_sbs_deep_new(ambiguity: i32, hierarchy: i32, auto_insert: bool, shortnames: bool, report: bool) -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: ambiguity,
        hierarchy_detection: hierarchy,
        auto_insert_apply_deferred: auto_insert,
        use_shortnames: shortnames,
        report_sets: report,
    };
}

fn ecs_sbs_deep_ambiguity(s: EcsSbsDeep) -> i32 { return s.ambiguity_detection; }
fn ecs_sbs_deep_hierarchy(s: EcsSbsDeep) -> i32 { return s.hierarchy_detection; }
fn ecs_sbs_deep_auto_insert(s: EcsSbsDeep) -> bool { return s.auto_insert_apply_deferred; }
fn ecs_sbs_deep_shortnames(s: EcsSbsDeep) -> bool { return s.use_shortnames; }
fn ecs_sbs_deep_report_sets(s: EcsSbsDeep) -> bool { return s.report_sets; }

fn ecs_sbs_deep_set_ambiguity(s: EcsSbsDeep, level: i32) -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: level,
        hierarchy_detection: s.hierarchy_detection,
        auto_insert_apply_deferred: s.auto_insert_apply_deferred,
        use_shortnames: s.use_shortnames,
        report_sets: s.report_sets,
    };
}

fn ecs_sbs_deep_set_hierarchy(s: EcsSbsDeep, level: i32) -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: s.ambiguity_detection,
        hierarchy_detection: level,
        auto_insert_apply_deferred: s.auto_insert_apply_deferred,
        use_shortnames: s.use_shortnames,
        report_sets: s.report_sets,
    };
}

fn ecs_sbs_deep_set_auto_insert(s: EcsSbsDeep, on: bool) -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: s.ambiguity_detection,
        hierarchy_detection: s.hierarchy_detection,
        auto_insert_apply_deferred: on,
        use_shortnames: s.use_shortnames,
        report_sets: s.report_sets,
    };
}

fn ecs_sbs_deep_set_shortnames(s: EcsSbsDeep, on: bool) -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: s.ambiguity_detection,
        hierarchy_detection: s.hierarchy_detection,
        auto_insert_apply_deferred: s.auto_insert_apply_deferred,
        use_shortnames: on,
        report_sets: s.report_sets,
    };
}

fn ecs_sbs_deep_set_report_sets(s: EcsSbsDeep, on: bool) -> EcsSbsDeep {
    return EcsSbsDeep {
        ambiguity_detection: s.ambiguity_detection,
        hierarchy_detection: s.hierarchy_detection,
        auto_insert_apply_deferred: s.auto_insert_apply_deferred,
        use_shortnames: s.use_shortnames,
        report_sets: on,
    };
}

fn ecs_sbs_deep_eq(a: EcsSbsDeep, b: EcsSbsDeep) -> bool {
    if a.ambiguity_detection != b.ambiguity_detection { return false; };
    if a.hierarchy_detection != b.hierarchy_detection { return false; };
    if a.auto_insert_apply_deferred != b.auto_insert_apply_deferred { return false; };
    if a.use_shortnames != b.use_shortnames { return false; };
    if a.report_sets != b.report_sets { return false; };
    return true;
}

// ScheduleBuildMetadata counters
struct EcsSbmDeep {
    ambiguity_count: i64,
    hierarchy_count: i64,
    warning_count: i64,
    edges_added: i64,
}

fn ecs_sbm_deep_new() -> EcsSbmDeep {
    return EcsSbmDeep { ambiguity_count: 0, hierarchy_count: 0, warning_count: 0, edges_added: 0 };
}

fn ecs_sbm_deep_ambiguity(m: EcsSbmDeep) -> i64 { return m.ambiguity_count; }
fn ecs_sbm_deep_hierarchy(m: EcsSbmDeep) -> i64 { return m.hierarchy_count; }
fn ecs_sbm_deep_warnings(m: EcsSbmDeep) -> i64 { return m.warning_count; }
fn ecs_sbm_deep_edges(m: EcsSbmDeep) -> i64 { return m.edges_added; }

fn ecs_sbm_deep_note_ambiguity(m: EcsSbmDeep) -> EcsSbmDeep {
    return EcsSbmDeep {
        ambiguity_count: m.ambiguity_count + 1,
        hierarchy_count: m.hierarchy_count,
        warning_count: m.warning_count + 1,
        edges_added: m.edges_added,
    };
}

fn ecs_sbm_deep_note_hierarchy(m: EcsSbmDeep) -> EcsSbmDeep {
    return EcsSbmDeep {
        ambiguity_count: m.ambiguity_count,
        hierarchy_count: m.hierarchy_count + 1,
        warning_count: m.warning_count + 1,
        edges_added: m.edges_added,
    };
}

fn ecs_sbm_deep_add_edge(m: EcsSbmDeep, n: i64) -> EcsSbmDeep {
    return EcsSbmDeep {
        ambiguity_count: m.ambiguity_count,
        hierarchy_count: m.hierarchy_count,
        warning_count: m.warning_count,
        edges_added: m.edges_added + n,
    };
}

// apply settings log level to decide if warning should be recorded
fn ecs_sbs_deep_should_warn(level: i32) -> bool {
    if level == ECS_SBS_LOG_WARN { return true; };
    if level == ECS_SBS_LOG_ERROR { return true; };
    return false;
}

fn ecs_sbs_deep_should_error(level: i32) -> bool {
    return level == ECS_SBS_LOG_ERROR;
}
