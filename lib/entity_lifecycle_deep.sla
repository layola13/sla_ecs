// Deepened Bevy ECS entity disabling + lifecycle surface.
// Mirrors src/entity_disabling.rs + lifecycle hooks / RemovedComponentMessages:
//   DefaultQueryFilters register/is_disabling
//   ComponentHooks on_add/insert/discard/remove/despawn + try_*
//   RemovedComponents write/read/clear/cursor
// Shallow lib/entity_lifecycle.sla retained.
// Fixed capacity: 4 disabling ids, 8 removal entries.

struct EcsDqfDeep {
    len: i32,
    c0: i32, c1: i32, c2: i32, c3: i32,
}

fn ecs_dqf_deep_new() -> EcsDqfDeep {
    return EcsDqfDeep { len: 0, c0: -1, c1: -1, c2: -1, c3: -1 };
}

fn ecs_dqf_deep_len(f: EcsDqfDeep) -> i32 { return f.len; }

fn ecs_dqf_deep_register(f: EcsDqfDeep, component_id: i32) -> EcsDqfDeep {
    if f.len >= 1 { if f.c0 == component_id { return f; }; };
    if f.len >= 2 { if f.c1 == component_id { return f; }; };
    if f.len >= 3 { if f.c2 == component_id { return f; }; };
    if f.len >= 4 { if f.c3 == component_id { return f; }; };
    if f.len >= 4 { return f; };
    let n = f.len;
    if n == 0 {
        return EcsDqfDeep { len: 1, c0: component_id, c1: f.c1, c2: f.c2, c3: f.c3 };
    };
    if n == 1 {
        return EcsDqfDeep { len: 2, c0: f.c0, c1: component_id, c2: f.c2, c3: f.c3 };
    };
    if n == 2 {
        return EcsDqfDeep { len: 3, c0: f.c0, c1: f.c1, c2: component_id, c3: f.c3 };
    };
    return EcsDqfDeep { len: 4, c0: f.c0, c1: f.c1, c2: f.c2, c3: component_id };
}

fn ecs_dqf_deep_is_disabling(f: EcsDqfDeep, component_id: i32) -> bool {
    if f.len >= 1 { if f.c0 == component_id { return true; }; };
    if f.len >= 2 { if f.c1 == component_id { return true; }; };
    if f.len >= 3 { if f.c2 == component_id { return true; }; };
    if f.len >= 4 { if f.c3 == component_id { return true; }; };
    return false;
}

fn ecs_dqf_deep_first(f: EcsDqfDeep) -> (bool, i32) {
    if f.len <= 0 { return (false, -1); };
    return (true, f.c0);
}

// query should exclude entity if it has any disabling component not mentioned in query
fn ecs_dqf_deep_entity_disabled(f: EcsDqfDeep, has0: i32, has1: i32, has_len: i32, mention0: i32, mention1: i32, mention_len: i32) -> bool {
    // if entity has disabling component and query does not mention it -> disabled
    if has_len >= 1 {
        if ecs_dqf_deep_is_disabling(f, has0) {
            let mentioned = false;
            if mention_len >= 1 { if mention0 == has0 { mentioned = true; }; };
            if mention_len >= 2 { if mention1 == has0 { mentioned = true; }; };
            if mentioned != true { return true; };
        };
    };
    if has_len >= 2 {
        if ecs_dqf_deep_is_disabling(f, has1) {
            let mentioned = false;
            if mention_len >= 1 { if mention0 == has1 { mentioned = true; }; };
            if mention_len >= 2 { if mention1 == has1 { mentioned = true; }; };
            if mentioned != true { return true; };
        };
    };
    return false;
}

// ComponentHooks
struct EcsHooksDeep {
    on_add: i32,
    on_insert: i32,
    on_discard: i32,
    on_remove: i32,
    on_despawn: i32,
}

fn ecs_hooks_deep_new() -> EcsHooksDeep {
    return EcsHooksDeep { on_add: 0, on_insert: 0, on_discard: 0, on_remove: 0, on_despawn: 0 };
}

fn ecs_hooks_deep_on_add(h: EcsHooksDeep, id: i32) -> EcsHooksDeep {
    return EcsHooksDeep { on_add: id, on_insert: h.on_insert, on_discard: h.on_discard, on_remove: h.on_remove, on_despawn: h.on_despawn };
}
fn ecs_hooks_deep_on_insert(h: EcsHooksDeep, id: i32) -> EcsHooksDeep {
    return EcsHooksDeep { on_add: h.on_add, on_insert: id, on_discard: h.on_discard, on_remove: h.on_remove, on_despawn: h.on_despawn };
}
fn ecs_hooks_deep_on_discard(h: EcsHooksDeep, id: i32) -> EcsHooksDeep {
    return EcsHooksDeep { on_add: h.on_add, on_insert: h.on_insert, on_discard: id, on_remove: h.on_remove, on_despawn: h.on_despawn };
}
fn ecs_hooks_deep_on_remove(h: EcsHooksDeep, id: i32) -> EcsHooksDeep {
    return EcsHooksDeep { on_add: h.on_add, on_insert: h.on_insert, on_discard: h.on_discard, on_remove: id, on_despawn: h.on_despawn };
}
fn ecs_hooks_deep_on_despawn(h: EcsHooksDeep, id: i32) -> EcsHooksDeep {
    return EcsHooksDeep { on_add: h.on_add, on_insert: h.on_insert, on_discard: h.on_discard, on_remove: h.on_remove, on_despawn: id };
}

fn ecs_hooks_deep_has_on_add(h: EcsHooksDeep) -> bool { if h.on_add != 0 { return true; }; return false; }
fn ecs_hooks_deep_has_on_insert(h: EcsHooksDeep) -> bool { if h.on_insert != 0 { return true; }; return false; }
fn ecs_hooks_deep_has_on_discard(h: EcsHooksDeep) -> bool { if h.on_discard != 0 { return true; }; return false; }
fn ecs_hooks_deep_has_on_remove(h: EcsHooksDeep) -> bool { if h.on_remove != 0 { return true; }; return false; }
fn ecs_hooks_deep_has_on_despawn(h: EcsHooksDeep) -> bool { if h.on_despawn != 0 { return true; }; return false; }

fn ecs_hooks_deep_try_on_add(h: EcsHooksDeep, id: i32) -> (bool, EcsHooksDeep) {
    if h.on_add != 0 { return (false, h); };
    return (true, ecs_hooks_deep_on_add(h, id));
}
fn ecs_hooks_deep_try_on_insert(h: EcsHooksDeep, id: i32) -> (bool, EcsHooksDeep) {
    if h.on_insert != 0 { return (false, h); };
    return (true, ecs_hooks_deep_on_insert(h, id));
}
fn ecs_hooks_deep_try_on_remove(h: EcsHooksDeep, id: i32) -> (bool, EcsHooksDeep) {
    if h.on_remove != 0 { return (false, h); };
    return (true, ecs_hooks_deep_on_remove(h, id));
}

// flags bits from hooks
fn ecs_hooks_deep_to_flags(h: EcsHooksDeep) -> i32 {
    let f = 0;
    if h.on_add != 0 { f = f | 1; };
    if h.on_insert != 0 { f = f | 2; };
    if h.on_discard != 0 { f = f | 4; };
    if h.on_remove != 0 { f = f | 8; };
    if h.on_despawn != 0 { f = f | 16; };
    return f;
}

// RemovedComponents fixed 8
struct EcsRemovedDeep {
    component_id: i32,
    len: i32,
    cursor: i32,
    e0: i32, e1: i32, e2: i32, e3: i32,
    e4: i32, e5: i32, e6: i32, e7: i32,
}

fn ecs_removed_deep_new(component_id: i32) -> EcsRemovedDeep {
    return EcsRemovedDeep {
        component_id: component_id, len: 0, cursor: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
    };
}

fn ecs_removed_deep_len(r: EcsRemovedDeep) -> i32 { return r.len; }
fn ecs_removed_deep_is_empty(r: EcsRemovedDeep) -> bool {
    if r.len == 0 { return true; };
    return false;
}
fn ecs_removed_deep_component_id(r: EcsRemovedDeep) -> i32 { return r.component_id; }
fn ecs_removed_deep_cursor(r: EcsRemovedDeep) -> i32 { return r.cursor; }

fn ecs_removed_deep_write(r: EcsRemovedDeep, entity: i32) -> EcsRemovedDeep {
    if r.len >= 8 { return r; };
    let n = r.len;
    let e0 = r.e0; let e1 = r.e1; let e2 = r.e2; let e3 = r.e3;
    let e4 = r.e4; let e5 = r.e5; let e6 = r.e6; let e7 = r.e7;
    if n == 0 { e0 = entity; };
    if n == 1 { e1 = entity; };
    if n == 2 { e2 = entity; };
    if n == 3 { e3 = entity; };
    if n == 4 { e4 = entity; };
    if n == 5 { e5 = entity; };
    if n == 6 { e6 = entity; };
    if n == 7 { e7 = entity; };
    return EcsRemovedDeep {
        component_id: r.component_id, len: n + 1, cursor: r.cursor,
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
    };
}

fn ecs_removed_deep_at(r: EcsRemovedDeep, idx: i32) -> i32 {
    if idx == 0 { return r.e0; };
    if idx == 1 { return r.e1; };
    if idx == 2 { return r.e2; };
    if idx == 3 { return r.e3; };
    if idx == 4 { return r.e4; };
    if idx == 5 { return r.e5; };
    if idx == 6 { return r.e6; };
    if idx == 7 { return r.e7; };
    return 0;
}

// Result struct avoids flaky (bool, i32, struct) triple-tuple returns on SA/SAB.
struct EcsRemovedDeepRead {
    had: bool,
    entity: i32,
    removed: EcsRemovedDeep,
}

fn ecs_removed_deep_read_had(rd: EcsRemovedDeepRead) -> bool { return rd.had; }
fn ecs_removed_deep_read_entity(rd: EcsRemovedDeepRead) -> i32 { return rd.entity; }
fn ecs_removed_deep_read_state(rd: EcsRemovedDeepRead) -> EcsRemovedDeep { return rd.removed; }

fn ecs_removed_deep_read(r: EcsRemovedDeep) -> EcsRemovedDeepRead {
    if r.cursor >= r.len {
        return EcsRemovedDeepRead { had: false, entity: 0, removed: r };
    };
    let cur = r.cursor;
    let ent = ecs_removed_deep_at(r, cur);
    let r2 = EcsRemovedDeep {
        component_id: r.component_id, len: r.len, cursor: cur + 1,
        e0: r.e0, e1: r.e1, e2: r.e2, e3: r.e3, e4: r.e4, e5: r.e5, e6: r.e6, e7: r.e7,
    };
    return EcsRemovedDeepRead { had: true, entity: ent, removed: r2 };
}

fn ecs_removed_deep_clear(r: EcsRemovedDeep) -> EcsRemovedDeep {
    return ecs_removed_deep_new(r.component_id);
}

fn ecs_removed_deep_reset_cursor(r: EcsRemovedDeep) -> EcsRemovedDeep {
    return EcsRemovedDeep {
        component_id: r.component_id, len: r.len, cursor: 0,
        e0: r.e0, e1: r.e1, e2: r.e2, e3: r.e3, e4: r.e4, e5: r.e5, e6: r.e6, e7: r.e7,
    };
}

fn ecs_removed_deep_has_unread(r: EcsRemovedDeep) -> bool {
    if r.cursor < r.len { return true; };
    return false;
}
