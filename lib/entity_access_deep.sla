fn ecs_ea_deep_remove_slot3(e: EcsEaDeep) -> EcsEaDeep {
    return ecs_ea_deep_rebuild(
        e.entity, e.archetype_id, e.location_row, e.spawned_by, e.spawn_tick, e.spawned,
        e.c0, e.v0, e.add0, e.ch0,
        e.c1, e.v1, e.add1, e.ch1,
        e.c2, e.v2, e.add2, e.ch2,
        -1, 0, 0, 0,
        3, e.readonly, e.filtered, e.access, e.change_tick
    );
}

fn ecs_ea_deep_remove(e: EcsEaDeep, cid: i32) -> EcsEaSetDeep {
    if e.spawned != true { return ecs_ea_set_fail(e, ECS_EA_ERR_DESPAWNED); };
    if e.readonly { return ecs_ea_set_fail(e, ECS_EA_ERR_NO_WRITE); };
    if e.len >= 1 {
        if e.c0 == cid { return ecs_ea_set_ok_ent(ecs_ea_deep_remove_slot0(e)); };
    };
    if e.len >= 2 {
        if e.c1 == cid { return ecs_ea_set_ok_ent(ecs_ea_deep_remove_slot1(e)); };
    };
    if e.len >= 3 {
        if e.c2 == cid { return ecs_ea_set_ok_ent(ecs_ea_deep_remove_slot2(e)); };
    };
    if e.len >= 4 {
        if e.c3 == cid { return ecs_ea_set_ok_ent(ecs_ea_deep_remove_slot3(e)); };
    };
    return ecs_ea_set_ok_ent(e);
}

fn ecs_ea_deep_clear(e: EcsEaDeep) -> EcsEaSetDeep {
    if e.spawned != true { return ecs_ea_set_fail(e, ECS_EA_ERR_DESPAWNED); };
    if e.readonly { return ecs_ea_set_fail(e, ECS_EA_ERR_NO_WRITE); };
    return ecs_ea_set_ok_ent(ecs_ea_deep_rebuild(
        e.entity, e.archetype_id, e.location_row, e.spawned_by, e.spawn_tick, e.spawned,
        -1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0,
        0, e.readonly, e.filtered, e.access, e.change_tick
    ));
}

// retain: keep only components whose cid is in keep mask (bit per cid 0..30)
fn ecs_ea_deep_retain(e: EcsEaDeep, keep_bits: i64) -> EcsEaSetDeep {
    if e.spawned != true { return ecs_ea_set_fail(e, ECS_EA_ERR_DESPAWNED); };
    if e.readonly { return ecs_ea_set_fail(e, ECS_EA_ERR_NO_WRITE); };
    let nc0: i32 = -1; let nv0: i64 = 0; let na0: i64 = 0; let nch0: i64 = 0;
    let nc1: i32 = -1; let nv1: i64 = 0; let na1: i64 = 0; let nch1: i64 = 0;
    let nc2: i32 = -1; let nv2: i64 = 0; let na2: i64 = 0; let nch2: i64 = 0;
    let nc3: i32 = -1; let nv3: i64 = 0; let na3: i64 = 0; let nch3: i64 = 0;
    let nlen: i32 = 0;
    // slot0
    if e.len >= 1 {
        let bit0 = ecs_ea_bit_for(e.c0);
        if ecs_ea_bits_has(keep_bits, bit0) {
            // place at nlen==0
            return ecs_ea_deep_retain_cont(e, keep_bits, e.c0, e.v0, e.add0, e.ch0, 1);
        };
    };
    return ecs_ea_deep_retain_cont(e, keep_bits, -1, 0, 0, 0, 0);
}

// helper continues retain after deciding slot0 keep; uses rebuild path for simplicity via sequential insert
fn ecs_ea_deep_retain_cont(
    e: EcsEaDeep, keep_bits: i64,
    c0: i32, v0: i64, a0: i64, ch0: i64, nlen: i32
) -> EcsEaSetDeep {
    let out = ecs_ea_deep_rebuild(
        e.entity, e.archetype_id, e.location_row, e.spawned_by, e.spawn_tick, e.spawned,
        c0, v0, a0, ch0,
        -1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0,
        nlen, e.readonly, e.filtered, e.access, e.change_tick
    );
    // re-scan original slots 1..3 (and 0 if skipped) via original e fields
    let cur = out;
    // process original slots in order
    let cur2 = ecs_ea_deep_retain_push_if(cur, e, 0, keep_bits, c0);
    let cur3 = ecs_ea_deep_retain_push_if(cur2, e, 1, keep_bits, c0);
    let cur4 = ecs_ea_deep_retain_push_if(cur3, e, 2, keep_bits, c0);
    let cur5 = ecs_ea_deep_retain_push_if(cur4, e, 3, keep_bits, c0);
    return ecs_ea_set_ok_ent(cur5);
}

// if slot already placed as c0 seed, skip re-add of same; otherwise push if keep
fn ecs_ea_deep_retain_push_if(cur: EcsEaDeep, src: EcsEaDeep, slot: i32, keep_bits: i64, seed_c: i32) -> EcsEaDeep {
    let cid: i32 = -1;
    let val: i64 = 0;
    let ad: i64 = 0;
    let ch: i64 = 0;
    let present = false;
    if slot == 0 {
        if src.len >= 1 {
            cid = src.c0; val = src.v0; ad = src.add0; ch = src.ch0; // present
            // mark present via cid >= 0
        };
    };
    if slot == 1 {
        if src.len >= 2 {
            cid = src.c1; val = src.v1; ad = src.add1; ch = src.ch1;
        };
    };
    if slot == 2 {
        if src.len >= 3 {
            cid = src.c2; val = src.v2; ad = src.add2; ch = src.ch2;
        };
    };
    if slot == 3 {
        if src.len >= 4 {
            cid = src.c3; val = src.v3; ad = src.add3; ch = src.ch3;
        };
    };
    if cid < 0 { return cur; };
    // if this was the seed already in cur, skip
    if seed_c == cid {
        if cur.len >= 1 {
            if cur.c0 == cid { return cur; };
        };
    };
    let bit = ecs_ea_bit_for(cid);
    if ecs_ea_bits_has(keep_bits, bit) != true { return cur; };
    // append into cur
    if cur.len == 0 {
        return ecs_ea_deep_rebuild(
            cur.entity, cur.archetype_id, cur.location_row, cur.spawned_by, cur.spawn_tick, cur.spawned,
            cid, val, ad, ch,
            -1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0,
            1, cur.readonly, cur.filtered, cur.access, cur.change_tick
        );
    };
    if cur.len == 1 {
        return ecs_ea_deep_rebuild(
            cur.entity, cur.archetype_id, cur.location_row, cur.spawned_by, cur.spawn_tick, cur.spawned,
            cur.c0, cur.v0, cur.add0, cur.ch0,
            cid, val, ad, ch,
            -1, 0, 0, 0, -1, 0, 0, 0,
            2, cur.readonly, cur.filtered, cur.access, cur.change_tick
        );
    };
    if cur.len == 2 {
        return ecs_ea_deep_rebuild(
            cur.entity, cur.archetype_id, cur.location_row, cur.spawned_by, cur.spawn_tick, cur.spawned,
            cur.c0, cur.v0, cur.add0, cur.ch0,
            cur.c1, cur.v1, cur.add1, cur.ch1,
            cid, val, ad, ch,
            -1, 0, 0, 0,
            3, cur.readonly, cur.filtered, cur.access, cur.change_tick
        );
    };
    if cur.len == 3 {
        return ecs_ea_deep_rebuild(
            cur.entity, cur.archetype_id, cur.location_row, cur.spawned_by, cur.spawn_tick, cur.spawned,
            cur.c0, cur.v0, cur.add0, cur.ch0,
            cur.c1, cur.v1, cur.add1, cur.ch1,
            cur.c2, cur.v2, cur.add2, cur.ch2,
            cid, val, ad, ch,
            4, cur.readonly, cur.filtered, cur.access, cur.change_tick
        );
    };
    return cur;
}

fn ecs_ea_deep_despawn(e: EcsEaDeep) -> EcsEaDeep {
    return ecs_ea_deep_rebuild(
        e.entity, e.archetype_id, e.location_row, e.spawned_by, e.spawn_tick, false,
        -1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0, -1, 0, 0, 0,
        0, e.readonly, e.filtered, e.access, e.change_tick
    );
}

// ComponentEntry view over entity bag
struct EcsEaEntryDeep {
    kind: i32,
    component_id: i32,
    value: i64,
    entity: EcsEaDeep,
}

fn ecs_ea_entry_kind(en: EcsEaEntryDeep) -> i32 { return en.kind; }
fn ecs_ea_entry_is_occupied(en: EcsEaEntryDeep) -> bool { return en.kind == ECS_EA_OCCUPIED; }
fn ecs_ea_entry_is_vacant(en: EcsEaEntryDeep) -> bool { return en.kind == ECS_EA_VACANT; }
fn ecs_ea_entry_component_id(en: EcsEaEntryDeep) -> i32 { return en.component_id; }
fn ecs_ea_entry_value(en: EcsEaEntryDeep) -> i64 { return en.value; }
fn ecs_ea_entry_entity(en: EcsEaEntryDeep) -> EcsEaDeep { return en.entity; }

fn ecs_ea_deep_entry(e: EcsEaDeep, cid: i32) -> EcsEaEntryDeep {
    let g = ecs_ea_deep_get_raw(e, cid);
    if g.ok {
        return EcsEaEntryDeep {
            kind: ECS_EA_OCCUPIED, component_id: cid, value: g.value, entity: e,
        };
    };
    return EcsEaEntryDeep {
        kind: ECS_EA_VACANT, component_id: cid, value: 0, entity: e,
    };
}

fn ecs_ea_entry_or_insert(en: EcsEaEntryDeep, default: i64) -> EcsEaEntryDeep {
    if en.kind == ECS_EA_OCCUPIED {
        return en;
    };
    let r = ecs_ea_deep_insert(en.entity, en.component_id, default);
    let e2 = r.entity;
    return EcsEaEntryDeep {
        kind: ECS_EA_OCCUPIED, component_id: en.component_id, value: default, entity: e2,
    };
}

fn ecs_ea_entry_or_default(en: EcsEaEntryDeep) -> EcsEaEntryDeep {
    return ecs_ea_entry_or_insert(en, 0);
}

fn ecs_ea_entry_insert(en: EcsEaEntryDeep, value: i64) -> EcsEaEntryDeep {
    let r = ecs_ea_deep_insert(en.entity, en.component_id, value);
    let e2 = r.entity;
    return EcsEaEntryDeep {
        kind: ECS_EA_OCCUPIED, component_id: en.component_id, value: value, entity: e2,
    };
}

fn ecs_ea_entry_and_modify(en: EcsEaEntryDeep, delta: i64) -> EcsEaEntryDeep {
    if en.kind != ECS_EA_OCCUPIED {
        return en;
    };
    let nv = en.value + delta;
    let r = ecs_ea_deep_set(en.entity, en.component_id, nv);
    let e2 = r.entity;
    return EcsEaEntryDeep {
        kind: ECS_EA_OCCUPIED, component_id: en.component_id, value: nv, entity: e2,
    };
}

struct EcsEaTakeDeep {
    ok: bool,
    value: i64,
    entity: EcsEaDeep,
}

fn ecs_ea_take_ok(t: EcsEaTakeDeep) -> bool { return t.ok; }
fn ecs_ea_take_value(t: EcsEaTakeDeep) -> i64 { return t.value; }
fn ecs_ea_take_entity(t: EcsEaTakeDeep) -> EcsEaDeep { return t.entity; }

fn ecs_ea_entry_take(en: EcsEaEntryDeep) -> EcsEaTakeDeep {
    if en.kind != ECS_EA_OCCUPIED {
        return EcsEaTakeDeep { ok: false, value: 0, entity: en.entity };
    };
    let val = en.value;
    let r = ecs_ea_deep_remove(en.entity, en.component_id);
    return EcsEaTakeDeep { ok: true, value: val, entity: r.entity };
}
