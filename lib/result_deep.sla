// Deepened Bevy-style Result helpers for ECS error codes.
// Mirrors lib/result.sla + common Result combinators used across ECS.
// Scalar i32 payload model. Shallow lib/result.sla retained.

struct EcsResDeep {
    is_ok: bool,
    ok_value: i32,
    err_code: i32,
}

fn ecs_res_ok(value: i32) -> EcsResDeep {
    return EcsResDeep { is_ok: true, ok_value: value, err_code: 0 };
}

fn ecs_res_err(code: i32) -> EcsResDeep {
    return EcsResDeep { is_ok: false, ok_value: 0, err_code: code };
}

fn ecs_res_is_ok(r: EcsResDeep) -> bool { return r.is_ok; }
fn ecs_res_is_err(r: EcsResDeep) -> bool {
    if r.is_ok { return false; };
    return true;
}

fn ecs_res_ok_value(r: EcsResDeep) -> i32 { return r.ok_value; }
fn ecs_res_err_code(r: EcsResDeep) -> i32 { return r.err_code; }

fn ecs_res_unwrap_or(r: EcsResDeep, default: i32) -> i32 {
    if r.is_ok { return r.ok_value; };
    return default;
}

fn ecs_res_map(r: EcsResDeep, delta: i32) -> EcsResDeep {
    if r.is_ok != true { return r; };
    return ecs_res_ok(r.ok_value + delta);
}

fn ecs_res_map_err(r: EcsResDeep, delta: i32) -> EcsResDeep {
    if r.is_ok { return r; };
    return ecs_res_err(r.err_code + delta);
}

fn ecs_res_and_then(r: EcsResDeep, next_ok: i32) -> EcsResDeep {
    if r.is_ok != true { return r; };
    return ecs_res_ok(next_ok);
}

fn ecs_res_or_else(r: EcsResDeep, fallback: i32) -> EcsResDeep {
    if r.is_ok { return r; };
    return ecs_res_ok(fallback);
}

fn ecs_res_eq(a: EcsResDeep, b: EcsResDeep) -> bool {
    if a.is_ok != b.is_ok { return false; };
    if a.is_ok { return a.ok_value == b.ok_value; };
    return a.err_code == b.err_code;
}

// inspect-style counters via rebuild of value+flag
struct EcsResInspectDeep {
    result: EcsResDeep,
    ok_seen: bool,
    err_seen: bool,
}

fn ecs_res_inspect_ok(r: EcsResDeep) -> EcsResInspectDeep {
    if r.is_ok {
        return EcsResInspectDeep { result: r, ok_seen: true, err_seen: false };
    };
    return EcsResInspectDeep { result: r, ok_seen: false, err_seen: false };
}

fn ecs_res_inspect_err(r: EcsResDeep) -> EcsResInspectDeep {
    if r.is_ok {
        return EcsResInspectDeep { result: r, ok_seen: false, err_seen: false };
    };
    return EcsResInspectDeep { result: r, ok_seen: false, err_seen: true };
}

fn ecs_res_inspect_result(i: EcsResInspectDeep) -> EcsResDeep { return i.result; }
fn ecs_res_inspect_ok_seen(i: EcsResInspectDeep) -> bool { return i.ok_seen; }
fn ecs_res_inspect_err_seen(i: EcsResInspectDeep) -> bool { return i.err_seen; }

// transpose Option-like: err_code == -1 means None
fn ecs_res_from_option(has: bool, value: i32) -> EcsResDeep {
    if has { return ecs_res_ok(value); };
    return ecs_res_err(-1);
}

fn ecs_res_is_none_err(r: EcsResDeep) -> bool {
    if r.is_ok { return false; };
    return r.err_code == -1;
}

// flatten: if outer ok and value encodes nested err via negative convention
fn ecs_res_flatten_pair(outer_ok: bool, outer_val: i32, outer_err: i32) -> EcsResDeep {
    if outer_ok != true { return ecs_res_err(outer_err); };
    // treat outer_val < 0 as nested err code = -outer_val
    if outer_val < 0 { return ecs_res_err(0 - outer_val); };
    return ecs_res_ok(outer_val);
}
