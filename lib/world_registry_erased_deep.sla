// Deep tests bed for lib/world_registry_erased.sla (Batch 385).
// Mirrors shallow `lib/world_registry_erased.sla`'s `RegistryErasedWorld<R, M>` registry world as a
// SELF-CONTAINED fixed-cap variant (no `@import` -- the registry/column storage, resource slot,
// message slot, and typed (pos/vel/marker) component columns are all inlined). The erased "any
// concrete type" surface is reified here as three concrete typed columns keyed by `type_id`
// (ERASED_TEST_POS_TYPE, ERASED_TEST_VEL_TYPE, ERASED_TEST_MARKER_TYPE) -- matching the shallow's
// two `@test`s which exercise only these three types + the ErasedTestTime resource + ErasedTestEvent
// message. Wrapper structs expose scalar accessors (no tuple-return destructuring in tests).
//
// Storage:
// - cap-16 entities, each with a generation + alive-bit, monotone `next_entity`.
// - cap-8 component columns: each carries (comp_id, type_id, storage_kind, present_bit per entity,
//   added_tick per entity, changed_tick per entity).
// - Per-typed component storage: since only Pos/Vel/Marker concrete types are exercised, the world
// carries cap-8 typed-column snapshots for each type. A column slot index (0..7) maps to a typed
// store keyed by the column's type_id; each typed store cap-16 entity rows of (x, y) or (value).
// - One resource slot (ErasedTestTime) + one message slot (ErasedTestEvent) + a message counter.
// - A monotone change_tick that register/insert/despawn/increment_tick advance, matching shallow.

const ECS_REG_CAP_ENTITIES: i32 = 16;
const ECS_REG_CAP_COLUMNS: i32 = 8;
const ECS_REG_TYPE_POS: i32 = 101;
const ECS_REG_TYPE_VEL: i32 = 102;
const ECS_REG_TYPE_MARKER: i32 = 103;
const ECS_REG_STORAGE_TABLE: i32 = 0;
const ECS_REG_STORAGE_SPARSE: i32 = 1;
const ECS_REG_TICK_NONE: i32 = 999999;

struct EcsRegEntityDeep { id: i32, generation: i32 }

fn ecs_reg_entity_eq_deep(a: EcsRegEntityDeep, b: EcsRegEntityDeep) -> bool {
    if a.id != b.id { return false; };
    if a.generation != b.generation { return false; };
    return true;
}

fn ecs_reg_entity_id_deep(a: EcsRegEntityDeep) -> i32 { return a.id; }
fn ecs_reg_entity_gen_deep(a: EcsRegEntityDeep) -> i32 { return a.generation; }

fn ecs_reg_entity_new(id: i32, generation: i32) -> EcsRegEntityDeep {
    return EcsRegEntityDeep { id: id, generation: generation };
}

// ── Typed concrete component structs (mirrors shallow ErasedTestPos / ErasedTestVel /
//    ErasedTestMarker + the resource ErasedTestTime + message ErasedTestEvent). ──────────────
struct EcsRegPosDeep { x: i32, y: i32 }
struct EcsRegVelDeep { x: i32, y: i32 }
struct EcsRegMarkerDeep { value: i32 }

fn ecs_reg_pos_deep_new(x: i32, y: i32) -> EcsRegPosDeep { return EcsRegPosDeep { x: x, y: y }; }
fn ecs_reg_vel_deep_new(x: i32, y: i32) -> EcsRegVelDeep { return EcsRegVelDeep { x: x, y: y }; }
fn ecs_reg_marker_deep_new(value: i32) -> EcsRegMarkerDeep { return EcsRegMarkerDeep { value: value }; }

fn ecs_reg_pos_deep_x(r: EcsRegPosDeep) -> i32 { return r.x; }
fn ecs_reg_pos_deep_y(r: EcsRegPosDeep) -> i32 { return r.y; }
fn ecs_reg_vel_deep_x(r: EcsRegVelDeep) -> i32 { return r.x; }
fn ecs_reg_vel_deep_y(r: EcsRegVelDeep) -> i32 { return r.y; }
fn ecs_reg_marker_deep_value(r: EcsRegMarkerDeep) -> i32 { return r.value; }

struct EcsRegTimeDeep { tick: i32 }
struct EcsRegEventDeep { amount: i32 }

fn ecs_reg_time_deep_new(tick: i32) -> EcsRegTimeDeep { return EcsRegTimeDeep { tick: tick }; }
fn ecs_reg_time_deep_tick(r: EcsRegTimeDeep) -> i32 { return r.tick; }
fn ecs_reg_event_deep_new(amount: i32) -> EcsRegEventDeep { return EcsRegEventDeep { amount: amount }; }
fn ecs_reg_event_deep_amount(r: EcsRegEventDeep) -> i32 { return r.amount; }

// ── Component-info wrapper (mirrors shallow `ComponentInfo { id }`). ────────────────────────
struct EcsRegCompInfoDeep { id: i32 }
fn ecs_reg_comp_info_id_deep(r: EcsRegCompInfoDeep) -> i32 { return r.id; }

// ── Register wrapper (returns world + info so tests can chain register calls without tuple
//    destructuring -- Batch 373 rule). Mirrors Batch 383 `_w`-suffix register pattern. ──────
struct EcsRegRegisterDeep { world: EcsRegWorldDeep, info: EcsRegCompInfoDeep }
fn ecs_reg_register_world_deep(r: EcsRegRegisterDeep) -> EcsRegWorldDeep { return r.world; }
fn ecs_reg_register_info_deep(r: EcsRegRegisterDeep) -> EcsRegCompInfoDeep { return r.info; }

// ── Spawn wrapper (mirrors shallow `(world, entity)` registry_world_spawn). ─────────────────
struct EcsRegSpawnDeep { world: EcsRegWorldDeep, entity: EcsRegEntityDeep }
fn ecs_reg_spawn_world_deep(r: EcsRegSpawnDeep) -> EcsRegWorldDeep { return r.world; }
fn ecs_reg_spawn_entity_deep(r: EcsRegSpawnDeep) -> EcsRegEntityDeep { return r.entity; }

// ── World: cap-16 entities x cap-8 columns. Each column has per-entity:
//   present0..7 bitmasks (cap-8 columns, i32 bitmask over cap-16 entities),
//   added_tick0..7 (per-column flat cap-16 per-entity), changed_tick0..7 likewise.
// Typed storage is kept in three parallel arrays per type (cap-8 columns * cap-16 entity rows);
// each typed-cell holds a (x, y) or (value) -- represented as a single i32 pair stored as
// (valLo, valHi) for Pos/Vel (where valLo = x, valHi = y), and a single val (= value) for Marker.
// Per-column-per-entity typed storage is itself a cap-16 array per column; since we have cap-8
// columns max and cap-4 typed-column slots per type suffice for the test (3 columns), we lay out
// per-column typed arrays keyed entirely by column index (0..7) -- one massive parallel block per
// type, each carrying cap-8 columns x cap-16 rows. To keep the struct literal sane, we use a flat
// naming: `pos_x_{col}_{eid}` is dense but unwieldy; instead we expose `pos_col0_x0 .. pos_col0_x15`
// blocks for col 0..7 -> that is cap-8 * cap-16 = 128 fields per type. Compactly we keep typed storage
// INSIDE per-column wrapper structs `EcsRegColDeepPos { x0..x15, y0..y15 }` (one per col) and have the
// world hold `pos_col0..pos_col7` EcsRegColDeepPos slots, Vel likewise, Marker single-valued per col.
//
// Field-assign on the world's typed slots is done in cascade-of-return cascade helpers.
struct EcsRegColDeepPos {
    x0: i32, x1: i32, x2: i32, x3: i32, x4: i32, x5: i32, x6: i32, x7: i32,
    x8: i32, x9: i32, x10: i32, x11: i32, x12: i32, x13: i32, x14: i32, x15: i32,
    y0: i32, y1: i32, y2: i32, y3: i32, y4: i32, y5: i32, y6: i32, y7: i32,
    y8: i32, y9: i32, y10: i32, y11: i32, y12: i32, y13: i32, y14: i32, y15: i32
}

fn _ecs_reg_col_pos_empty() -> EcsRegColDeepPos {
    return EcsRegColDeepPos {
        x0: 0, x1: 0, x2: 0, x3: 0, x4: 0, x5: 0, x6: 0, x7: 0,
        x8: 0, x9: 0, x10: 0, x11: 0, x12: 0, x13: 0, x14: 0, x15: 0,
        y0: 0, y1: 0, y2: 0, y3: 0, y4: 0, y5: 0, y6: 0, y7: 0,
        y8: 0, y9: 0, y10: 0, y11: 0, y12: 0, y13: 0, y14: 0, y15: 0
    };
}

fn _ecs_reg_col_pos_x_at(col: EcsRegColDeepPos, eid: i32) -> i32 {
    if eid == 0 { return col.x0; };
    if eid == 1 { return col.x1; };
    if eid == 2 { return col.x2; };
    if eid == 3 { return col.x3; };
    if eid == 4 { return col.x4; };
    if eid == 5 { return col.x5; };
    if eid == 6 { return col.x6; };
    if eid == 7 { return col.x7; };
    if eid == 8 { return col.x8; };
    if eid == 9 { return col.x9; };
    if eid == 10 { return col.x10; };
    if eid == 11 { return col.x11; };
    if eid == 12 { return col.x12; };
    if eid == 13 { return col.x13; };
    if eid == 14 { return col.x14; };
    return col.x15;
}

fn _ecs_reg_col_pos_y_at(col: EcsRegColDeepPos, eid: i32) -> i32 {
    if eid == 0 { return col.y0; };
    if eid == 1 { return col.y1; };
    if eid == 2 { return col.y2; };
    if eid == 3 { return col.y3; };
    if eid == 4 { return col.y4; };
    if eid == 5 { return col.y5; };
    if eid == 6 { return col.y6; };
    if eid == 7 { return col.y7; };
    if eid == 8 { return col.y8; };
    if eid == 9 { return col.y9; };
    if eid == 10 { return col.y10; };
    if eid == 11 { return col.y11; };
    if eid == 12 { return col.y12; };
    if eid == 13 { return col.y13; };
    if eid == 14 { return col.y14; };
    return col.y15;
}

fn _ecs_reg_col_pos_set_x(col0: EcsRegColDeepPos, eid: i32, value: i32) -> EcsRegColDeepPos {
    if eid == 0 { col0.x0 = value; return col0; };
    if eid == 1 { col0.x1 = value; return col0; };
    if eid == 2 { col0.x2 = value; return col0; };
    if eid == 3 { col0.x3 = value; return col0; };
    if eid == 4 { col0.x4 = value; return col0; };
    if eid == 5 { col0.x5 = value; return col0; };
    if eid == 6 { col0.x6 = value; return col0; };
    if eid == 7 { col0.x7 = value; return col0; };
    if eid == 8 { col0.x8 = value; return col0; };
    if eid == 9 { col0.x9 = value; return col0; };
    if eid == 10 { col0.x10 = value; return col0; };
    if eid == 11 { col0.x11 = value; return col0; };
    if eid == 12 { col0.x12 = value; return col0; };
    if eid == 13 { col0.x13 = value; return col0; };
    if eid == 14 { col0.x14 = value; return col0; };
    col0.x15 = value;
    return col0;
