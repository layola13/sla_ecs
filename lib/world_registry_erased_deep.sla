    if eid == 2 { col0.y2 = value; return col0; };
    if eid == 3 { col0.y3 = value; return col0; };
    if eid == 4 { col0.y4 = value; return col0; };
    if eid == 5 { col0.y5 = value; return col0; };
    if eid == 6 { col0.y6 = value; return col0; };
    if eid == 7 { col0.y7 = value; return col0; };
    if eid == 8 { col0.y8 = value; return col0; };
    if eid == 9 { col0.y9 = value; return col0; };
    if eid == 10 { col0.y10 = value; return col0; };
    if eid == 11 { col0.y11 = value; return col0; };
    if eid == 12 { col0.y12 = value; return col0; };
    if eid == 13 { col0.y13 = value; return col0; };
    if eid == 14 { col0.y14 = value; return col0; };
    col0.y15 = value;
    return col0;
}

