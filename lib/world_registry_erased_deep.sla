// ── Bit helpers for the per-column `present` bitmask over cap-16 entities. ───────────────────
fn _ecs_reg_bit_mask(eid: i32) -> i32 {
    if eid == 0 { return 1; };
    if eid == 1 { return 2; };
    if eid == 2 { return 4; };
    if eid == 3 { return 8; };
    if eid == 4 { return 16; };
    if eid == 5 { return 32; };
    if eid == 6 { return 64; };
    if eid == 7 { return 128; };
    if eid == 8 { return 256; };
    if eid == 9 { return 512; };
    if eid == 10 { return 1024; };
    if eid == 11 { return 2048; };
    if eid == 12 { return 4096; };
    if eid == 13 { return 8192; };
    if eid == 14 { return 16384; };
    return 32768;
}

fn _ecs_reg_bit_clear_mask(eid: i32) -> i32 {
    // signed-NOT forms: present' = present & ~mask.
    if eid == 0 { return -2; };
    if eid == 1 { return -3; };
    if eid == 2 { return -5; };
    if eid == 3 { return -9; };
    if eid == 4 { return -17; };
    if eid == 5 { return -33; };
    if eid == 6 { return -65; };
    if eid == 7 { return -129; };
    if eid == 8 { return -257; };
    if eid == 9 { return -513; };
    if eid == 10 { return -1025; };
    if eid == 11 { return -2049; };
    if eid == 12 { return -4097; };
    if eid == 13 { return -8193; };
    if eid == 14 { return -16385; };
    return -32769;
}

fn _ecs_reg_bit_set(present: i32, eid: i32) -> i32 { return present | _ecs_reg_bit_mask(eid); }
fn _ecs_reg_bit_clear(present: i32, eid: i32) -> i32 { return present & _ecs_reg_bit_clear_mask(eid); }
fn _ecs_reg_bit_has(present: i32, eid: i32) -> bool {
    if (present & _ecs_reg_bit_mask(eid)) != 0 { return true; };
    return false;
}

// ── Look up a column index by component id (recursive read-only scan of cap-8 column slots). ───
fn _ecs_reg_world_deep_find_col(w: EcsRegWorldDeep, comp_id: i32, col: i32) -> i32 {
    if col >= w.comp_count { return -1; };
    if _ecs_reg_world_deep_comp_id_at(w, col) == comp_id { return col; };
    return _ecs_reg_world_deep_find_col(w, comp_id, col + 1);
}

fn ecs_reg_world_deep_component_count(w: EcsRegWorldDeep) -> i32 { return w.comp_count; }
fn ecs_reg_world_deep_entity_count(w: EcsRegWorldDeep) -> i32 { return w.entity_count; }
fn ecs_reg_world_deep_change_tick(w: EcsRegWorldDeep) -> i32 { return w.change_tick; }
fn ecs_reg_world_deep_increment_tick(w0: EcsRegWorldDeep) -> EcsRegWorldDeep {
    w0.change_tick = w0.change_tick + 1;
    return w0;
}

// ── Spawn: allocate next_entity++ slot, mark alive + entity_count++. cap-16 silent reject. ────
fn ecs_reg_world_deep_spawn(w0: EcsRegWorldDeep) -> EcsRegSpawnDeep {
    if w0.next_entity >= ECS_REG_CAP_ENTITIES {
        return _ecs_reg_spawn_wrap(w0, ecs_reg_entity_new(-1, 0));
    };
    let eid = w0.next_entity;
    w0.next_entity = w0.next_entity + 1;
    let w1 = _ecs_reg_world_deep_set_alive(w0, eid, 1);
    w1.entity_count = w1.entity_count + 1;
    return _ecs_reg_spawn_wrap(w1, ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w1, eid)));
}

fn _ecs_reg_spawn_wrap(world: EcsRegWorldDeep, entity: EcsRegEntityDeep) -> EcsRegSpawnDeep {
    return EcsRegSpawnDeep { world: world, entity: entity };
}

// Spawn `count` entities sequentially, returning the world. Used by tests to fill the cap-16 entity
// pool without writing 16 explicit let-ladder chains.
fn ecs_reg_world_deep_spawn_many(w0: EcsRegWorldDeep, count: i32) -> EcsRegWorldDeep {
    if count <= 0 { return w0; };
    let sp = ecs_reg_world_deep_spawn(w0);
    let w1 = ecs_reg_spawn_world_deep(sp);
    return ecs_reg_world_deep_spawn_many(w1, count - 1);
}

// Register `count` pos-typed columns sequentially, returning the world. Used by tests to fill cap-8.
fn ecs_reg_world_deep_register_many(w0: EcsRegWorldDeep, count: i32) -> EcsRegWorldDeep {
    if count <= 0 { return w0; };
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    return ecs_reg_world_deep_register_many(w1, count - 1);
}


fn ecs_reg_world_deep_is_alive(w: EcsRegWorldDeep, e: EcsRegEntityDeep) -> bool {
    if e.id < 0 { return false; };
    if e.id >= ECS_REG_CAP_ENTITIES { return false; };
    if _ecs_reg_world_deep_alive_at(w, e.id) != 1 { return false; };
    if _ecs_reg_world_deep_gen_at(w, e.id) != e.generation { return false; };
    return true;
}

// ── Register: append a new column in the next free slot. cap-8 silent reject (returns info.id=-1).
// The shallow registers at increment_tick time; the test asserts the components' ids are stable.
//   register_table(w, type)        -> (world, ComponentInfo { id = comp_count })
//   register_sparse_set(w, type)   -> (world, ComponentInfo { id = comp_count })
// We bump change_tick to match shallow's "register advances tick" framing. ─────────────────────
fn _ecs_reg_world_deep_register(w0: EcsRegWorldDeep, type_id: i32, storage: i32) -> EcsRegRegisterDeep {
    let cap = ECS_REG_CAP_COLUMNS;
    if w0.comp_count >= cap {
        return _ecs_reg_register_wrap(w0, ecs_reg_comp_info_new(-1));
    };
    let slot = w0.comp_count;
    let w1 = _ecs_reg_world_deep_set_comp_id(w0, slot, slot);
    let w2 = _ecs_reg_world_deep_set_type_id(w1, slot, type_id);
    let w3 = _ecs_reg_world_deep_set_storage(w2, slot, storage);
    let w4 = _ecs_reg_world_deep_set_present(w3, slot, 0);
    w4.comp_count = w4.comp_count + 1;
    w4.change_tick = w4.change_tick + 1;
    return _ecs_reg_register_wrap(w4, ecs_reg_comp_info_new(slot));
}

fn ecs_reg_comp_info_new(id: i32) -> EcsRegCompInfoDeep { return EcsRegCompInfoDeep { id: id }; }

fn _ecs_reg_register_wrap(world: EcsRegWorldDeep, info: EcsRegCompInfoDeep) -> EcsRegRegisterDeep {
    return EcsRegRegisterDeep { world: world, info: info };
}

fn ecs_reg_world_deep_register_table(w0: EcsRegWorldDeep, type_id: i32) -> EcsRegRegisterDeep {
    return _ecs_reg_world_deep_register(w0, type_id, ECS_REG_STORAGE_TABLE);
}

fn ecs_reg_world_deep_register_sparse_set(w0: EcsRegWorldDeep, type_id: i32) -> EcsRegRegisterDeep {
    return _ecs_reg_world_deep_register(w0, type_id, ECS_REG_STORAGE_SPARSE);
}

// ── Has: present bit set in the column matched by comp_id (and entity alive). ─────────────────
fn ecs_reg_world_deep_has(w: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32) -> bool {
    if ecs_reg_world_deep_is_alive(w, e) != true { return false; };
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return false; };
    return _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, col), e.id);
}

// ── Per-type insert: writes the typed value into the matched column's typed-slot, sets the
//    present bit, sets added[ent]=tick IF NOT already present (mirrors shallow insert semantics
//    where insert into absent records added_tick; replace when already present), sets changed[ent].
// Updates changed_only (when already_present==true) OR both added+changed (when first insertion).
// Two distinct entrypoints to avoid the Batch 378 SA-swallow bug for field-assign inside an if-guard:
// `set_changed_only` writes only `changed`; `set_added_and_changed` writes both.  We dispatch
// externally instead of branching internally so neither branch is an if-guard field-assign chain.
fn _ecs_reg_world_deep_insert_set_tick(w0: EcsRegWorldDeep, col: i32, eid: i32, tick: i32, was_present: bool) -> EcsRegWorldDeep {
    if was_present != true {
        return _ecs_reg_world_deep_set_added_and_changed(w0, col, eid, tick);
    };
    return _ecs_reg_world_deep_set_changed_only(w0, col, eid, tick);
}

fn _ecs_reg_world_deep_set_added_and_changed(w0: EcsRegWorldDeep, col: i32, eid: i32, tick: i32) -> EcsRegWorldDeep {
    let cur_added = _ecs_reg_world_deep_added_at(w0, col);
    let added_upd = _ecs_reg_col_ticke_set(cur_added, eid, tick);
    let w1 = _ecs_reg_world_deep_set_added(w0, col, added_upd);
    let cur_changed = _ecs_reg_world_deep_changed_at(w1, col);
    let changed_upd = _ecs_reg_col_ticke_set(cur_changed, eid, tick);
    return _ecs_reg_world_deep_set_changed(w1, col, changed_upd);
}

fn _ecs_reg_world_deep_set_changed_only(w0: EcsRegWorldDeep, col: i32, eid: i32, tick: i32) -> EcsRegWorldDeep {
    let cur_changed = _ecs_reg_world_deep_changed_at(w0, col);
    let changed_upd = _ecs_reg_col_ticke_set(cur_changed, eid, tick);
    return _ecs_reg_world_deep_set_changed(w0, col, changed_upd);
}

fn ecs_reg_world_deep_insert_pos(w0: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32, value: EcsRegPosDeep) -> EcsRegWorldDeep {
    if ecs_reg_world_deep_is_alive(w0, e) != true { return w0; };
    let col = _ecs_reg_world_deep_find_col(w0, comp_id, 0);
    if col < 0 { return w0; };
    let was_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w0, col), e.id);
    let cur_col = _ecs_reg_world_deep_pos_col_at(w0, col);
    let with_x = _ecs_reg_col_pos_set_x(cur_col, e.id, value.x);
    let with_y = _ecs_reg_col_pos_set_y(with_x, e.id, value.y);
    let w1 = _ecs_reg_world_deep_set_pos_col(w0, col, with_y);
    let present = _ecs_reg_bit_set(_ecs_reg_world_deep_present_at(w1, col), e.id);
    let w2 = _ecs_reg_world_deep_set_present(w1, col, present);
    return _ecs_reg_world_deep_insert_set_tick(w2, col, e.id, w0.change_tick, was_present);
}

fn ecs_reg_world_deep_insert_vel(w0: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32, value: EcsRegVelDeep) -> EcsRegWorldDeep {
    if ecs_reg_world_deep_is_alive(w0, e) != true { return w0; };
    let col = _ecs_reg_world_deep_find_col(w0, comp_id, 0);
    if col < 0 { return w0; };
    let was_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w0, col), e.id);
    let cur_col = _ecs_reg_world_deep_vel_col_at(w0, col);
    let with_x = _ecs_reg_col_vel_set_x(cur_col, e.id, value.x);
    let with_y = _ecs_reg_col_vel_set_y(with_x, e.id, value.y);
    let w1 = _ecs_reg_world_deep_set_vel_col(w0, col, with_y);
    let present = _ecs_reg_bit_set(_ecs_reg_world_deep_present_at(w1, col), e.id);
    let w2 = _ecs_reg_world_deep_set_present(w1, col, present);
    return _ecs_reg_world_deep_insert_set_tick(w2, col, e.id, w0.change_tick, was_present);
}

fn ecs_reg_world_deep_insert_marker(w0: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32, value: EcsRegMarkerDeep) -> EcsRegWorldDeep {
    if ecs_reg_world_deep_is_alive(w0, e) != true { return w0; };
    let col = _ecs_reg_world_deep_find_col(w0, comp_id, 0);
    if col < 0 { return w0; };
    let was_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w0, col), e.id);
    let cur_col = _ecs_reg_world_deep_marker_col_at(w0, col);
    let with_v = _ecs_reg_col_marker_set_v(cur_col, e.id, value.value);
    let w1 = _ecs_reg_world_deep_set_marker_col(w0, col, with_v);
    let present = _ecs_reg_bit_set(_ecs_reg_world_deep_present_at(w1, col), e.id);
    let w2 = _ecs_reg_world_deep_set_present(w1, col, present);
    return _ecs_reg_world_deep_insert_set_tick(w2, col, e.id, w0.change_tick, was_present);
}

// ── Per-type get: read the typed value from the matched column's typed-slot. ──────────────────
fn ecs_reg_world_deep_get_pos(w: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32) -> EcsRegPosDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return ecs_reg_pos_deep_new(0, 0); };
    let slot = _ecs_reg_world_deep_pos_col_at(w, col);
    return ecs_reg_pos_deep_new(_ecs_reg_col_pos_x_at(slot, e.id), _ecs_reg_col_pos_y_at(slot, e.id));
}

fn ecs_reg_world_deep_get_vel(w: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32) -> EcsRegVelDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return ecs_reg_vel_deep_new(0, 0); };
    let slot = _ecs_reg_world_deep_vel_col_at(w, col);
    return ecs_reg_vel_deep_new(_ecs_reg_col_vel_x_at(slot, e.id), _ecs_reg_col_vel_y_at(slot, e.id));
}

fn ecs_reg_world_deep_get_marker(w: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32) -> EcsRegMarkerDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return ecs_reg_marker_deep_new(0); };
    let slot = _ecs_reg_world_deep_marker_col_at(w, col);
    return ecs_reg_marker_deep_new(_ecs_reg_col_marker_v_at(slot, e.id));
}

// ── Remove: clear the present bit + clear the changed/added tick for the entity. Writes the typed
//    slot back to 0 for tidiness (matching shallow's Vec retain drop semantics). ───────────────
fn ecs_reg_world_deep_remove(w0: EcsRegWorldDeep, e: EcsRegEntityDeep, comp_id: i32) -> EcsRegWorldDeep {
    if ecs_reg_world_deep_is_alive(w0, e) != true { return w0; };
    let col = _ecs_reg_world_deep_find_col(w0, comp_id, 0);
    if col < 0 { return w0; };
    let present = _ecs_reg_bit_clear(_ecs_reg_world_deep_present_at(w0, col), e.id);
    let w1 = _ecs_reg_world_deep_set_present(w0, col, present);
    let cur_added = _ecs_reg_world_deep_added_at(w1, col);
    let cur_changed = _ecs_reg_world_deep_changed_at(w1, col);
    let added_upd = _ecs_reg_col_ticke_set(cur_added, e.id, ECS_REG_TICK_NONE);
    let changed_upd = _ecs_reg_col_ticke_set(cur_changed, e.id, ECS_REG_TICK_NONE);
    let w2 = _ecs_reg_world_deep_set_added(w1, col, added_upd);
    let w3 = _ecs_reg_world_deep_set_changed(w2, col, changed_upd);
    let type_id = _ecs_reg_world_deep_type_id_at(w3, col);
    if type_id == ECS_REG_TYPE_POS {
        let cur_col = _ecs_reg_world_deep_pos_col_at(w3, col);
        let cleared = _ecs_reg_col_pos_set_y(_ecs_reg_col_pos_set_x(cur_col, e.id, 0), e.id, 0);
        return _ecs_reg_world_deep_set_pos_col(w3, col, cleared);
    };
    if type_id == ECS_REG_TYPE_VEL {
        let cur_col = _ecs_reg_world_deep_vel_col_at(w3, col);
        let cleared = _ecs_reg_col_vel_set_y(_ecs_reg_col_vel_set_x(cur_col, e.id, 0), e.id, 0);
        return _ecs_reg_world_deep_set_vel_col(w3, col, cleared);
    };
    let cur_col = _ecs_reg_world_deep_marker_col_at(w3, col);
    let cleared = _ecs_reg_col_marker_set_v(cur_col, e.id, 0);
    return _ecs_reg_world_deep_set_marker_col(w3, col, cleared);
}

// ── Despawn: alive=0, gen+1, entity_count--. Removes all present components for the entity before
//    death so subsequent `has` checks return false. ───────────────────────────────────────────
fn _ecs_reg_world_deep_despawn_cols(w0: EcsRegWorldDeep, e: EcsRegEntityDeep, col: i32) -> EcsRegWorldDeep {
    if col >= ECS_REG_CAP_COLUMNS { return w0; };
    if col >= w0.comp_count { return w0; };
    if _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w0, col), e.id) {
        let comp_id = _ecs_reg_world_deep_comp_id_at(w0, col);
        let w1 = ecs_reg_world_deep_remove(w0, e, comp_id);
        return _ecs_reg_world_deep_despawn_cols(w1, e, col + 1);
    };
    return _ecs_reg_world_deep_despawn_cols(w0, e, col + 1);
}

fn ecs_reg_world_deep_despawn(w0: EcsRegWorldDeep, e: EcsRegEntityDeep) -> EcsRegWorldDeep {
    if ecs_reg_world_deep_is_alive(w0, e) != true { return w0; };
    let w1 = _ecs_reg_world_deep_despawn_cols(w0, e, 0);
    let w2 = _ecs_reg_world_deep_set_alive(w1, e.id, 0);
    let g = _ecs_reg_world_deep_gen_at(w2, e.id);
    let w3 = _ecs_reg_world_deep_set_gen(w2, e.id, g + 1);
    w3.entity_count = w3.entity_count - 1;
    return w3;
}

// ── Query results: cap-16 matched entities. Mirrors shallow `Query<EntityItem<T>>`. ──────────
struct EcsRegQueryDeep { count: i32, e0: EcsRegEntityDeep, e1: EcsRegEntityDeep, e2: EcsRegEntityDeep, e3: EcsRegEntityDeep, e4: EcsRegEntityDeep, e5: EcsRegEntityDeep, e6: EcsRegEntityDeep, e7: EcsRegEntityDeep, e8: EcsRegEntityDeep, e9: EcsRegEntityDeep, e10: EcsRegEntityDeep, e11: EcsRegEntityDeep, e12: EcsRegEntityDeep, e13: EcsRegEntityDeep, e14: EcsRegEntityDeep, e15: EcsRegEntityDeep }

fn _ecs_reg_query_empty() -> EcsRegQueryDeep {
    return EcsRegQueryDeep {
        count: 0,
        e0: ecs_reg_entity_new(-1, 0), e1: ecs_reg_entity_new(-1, 0), e2: ecs_reg_entity_new(-1, 0), e3: ecs_reg_entity_new(-1, 0),
        e4: ecs_reg_entity_new(-1, 0), e5: ecs_reg_entity_new(-1, 0), e6: ecs_reg_entity_new(-1, 0), e7: ecs_reg_entity_new(-1, 0),
        e8: ecs_reg_entity_new(-1, 0), e9: ecs_reg_entity_new(-1, 0), e10: ecs_reg_entity_new(-1, 0), e11: ecs_reg_entity_new(-1, 0),
        e12: ecs_reg_entity_new(-1, 0), e13: ecs_reg_entity_new(-1, 0), e14: ecs_reg_entity_new(-1, 0), e15: ecs_reg_entity_new(-1, 0)
    };
}

fn ecs_reg_query_deep_count(r: EcsRegQueryDeep) -> i32 { return r.count; }

fn ecs_reg_query_deep_at(r: EcsRegQueryDeep, idx: i32) -> EcsRegEntityDeep {
    if idx == 0 { return r.e0; };
    if idx == 1 { return r.e1; };
    if idx == 2 { return r.e2; };
    if idx == 3 { return r.e3; };
    if idx == 4 { return r.e4; };
    if idx == 5 { return r.e5; };
    if idx == 6 { return r.e6; };
    if idx == 7 { return r.e7; };
    if idx == 8 { return r.e8; };
    if idx == 9 { return r.e9; };
    if idx == 10 { return r.e10; };
    if idx == 11 { return r.e11; };
    if idx == 12 { return r.e12; };
    if idx == 13 { return r.e13; };
    if idx == 14 { return r.e14; };
    return r.e15;
}

fn _ecs_reg_query_push(r0: EcsRegQueryDeep, k: i32, ent: EcsRegEntityDeep) -> EcsRegQueryDeep {
    if r0.count >= ECS_REG_CAP_ENTITIES { return r0; };
    if k == 0 { r0.e0 = ent; r0.count = r0.count + 1; return r0; };
    if k == 1 { r0.e1 = ent; r0.count = r0.count + 1; return r0; };
    if k == 2 { r0.e2 = ent; r0.count = r0.count + 1; return r0; };
    if k == 3 { r0.e3 = ent; r0.count = r0.count + 1; return r0; };
    if k == 4 { r0.e4 = ent; r0.count = r0.count + 1; return r0; };
    if k == 5 { r0.e5 = ent; r0.count = r0.count + 1; return r0; };
    if k == 6 { r0.e6 = ent; r0.count = r0.count + 1; return r0; };
    if k == 7 { r0.e7 = ent; r0.count = r0.count + 1; return r0; };
    if k == 8 { r0.e8 = ent; r0.count = r0.count + 1; return r0; };
    if k == 9 { r0.e9 = ent; r0.count = r0.count + 1; return r0; };
    if k == 10 { r0.e10 = ent; r0.count = r0.count + 1; return r0; };
    if k == 11 { r0.e11 = ent; r0.count = r0.count + 1; return r0; };
    if k == 12 { r0.e12 = ent; r0.count = r0.count + 1; return r0; };
    if k == 13 { r0.e13 = ent; r0.count = r0.count + 1; return r0; };
    if k == 14 { r0.e14 = ent; r0.count = r0.count + 1; return r0; };
    r0.e15 = ent;
    r0.count = r0.count + 1;
    return r0;
}

// Recursive entity scan: walk every alive entity slot 0..15 and push into the acc when the predicate
// matches. Uses (orig_w) so inserts at the world snapshot before the scan are visible. ──────────
fn _ecs_reg_query_scan(w: EcsRegWorldDeep, acc0: EcsRegQueryDeep, eid: i32, col: i32) -> EcsRegQueryDeep {
    if eid >= ECS_REG_CAP_ENTITIES { return acc0; };
    if _ecs_reg_world_deep_alive_at(w, eid) != 1 { return _ecs_reg_query_scan(w, acc0, eid + 1, col); };
    if _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, col), eid) {
        let ent = ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w, eid));
        let acc1 = _ecs_reg_query_push(acc0, acc0.count, ent);
        return _ecs_reg_query_scan(w, acc1, eid + 1, col);
    };
    return _ecs_reg_query_scan(w, acc0, eid + 1, col);
}

// query: all alive entities with the component.
fn ecs_reg_world_deep_query(w: EcsRegWorldDeep, comp_id: i32) -> EcsRegQueryDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return _ecs_reg_query_empty(); };
    return _ecs_reg_query_scan(w, _ecs_reg_query_empty(), 0, col);
}

// query_without: all alive entities WITH comp_id but WITHOUT without_comp_id.
fn _ecs_reg_query_without_scan(w: EcsRegWorldDeep, acc0: EcsRegQueryDeep, eid: i32, col: i32, without_col: i32) -> EcsRegQueryDeep {
    if eid >= ECS_REG_CAP_ENTITIES { return acc0; };
    if _ecs_reg_world_deep_alive_at(w, eid) != 1 { return _ecs_reg_query_without_scan(w, acc0, eid + 1, col, without_col); };
    let with = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, col), eid);
    let without_present = if without_col < 0 { false; } else { _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, without_col), eid); };
    if with == true {
        if without_present != true {
            let ent = ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w, eid));
            let acc1 = _ecs_reg_query_push(acc0, acc0.count, ent);
            return _ecs_reg_query_without_scan(w, acc1, eid + 1, col, without_col);
        };
    };
    return _ecs_reg_query_without_scan(w, acc0, eid + 1, col, without_col);
}

fn ecs_reg_world_deep_query_without(w: EcsRegWorldDeep, comp_id: i32, without_comp_id: i32) -> EcsRegQueryDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return _ecs_reg_query_empty(); };
    let without_col = _ecs_reg_world_deep_find_col(w, without_comp_id, 0);
    return _ecs_reg_query_without_scan(w, _ecs_reg_query_empty(), 0, col, without_col);
}

// query_added_since: all alive entities whose added_tick for the column is > since_tick.
fn _ecs_reg_query_added_scan(w: EcsRegWorldDeep, acc0: EcsRegQueryDeep, eid: i32, col: i32, since_tick: i32) -> EcsRegQueryDeep {
    if eid >= ECS_REG_CAP_ENTITIES { return acc0; };
    if _ecs_reg_world_deep_alive_at(w, eid) != 1 { return _ecs_reg_query_added_scan(w, acc0, eid + 1, col, since_tick); };
    let added = _ecs_reg_col_ticke_at(_ecs_reg_world_deep_added_at(w, col), eid);
    if added > since_tick {
        let ent = ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w, eid));
        let acc1 = _ecs_reg_query_push(acc0, acc0.count, ent);
        return _ecs_reg_query_added_scan(w, acc1, eid + 1, col, since_tick);
    };
    return _ecs_reg_query_added_scan(w, acc0, eid + 1, col, since_tick);
}

fn ecs_reg_world_deep_query_added(w: EcsRegWorldDeep, comp_id: i32, since_tick: i32) -> EcsRegQueryDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return _ecs_reg_query_empty(); };
    return _ecs_reg_query_added_scan(w, _ecs_reg_query_empty(), 0, col, since_tick);
}

// query_changed_since: all alive entities whose changed_tick for the column is > since_tick.
fn _ecs_reg_query_changed_scan(w: EcsRegWorldDeep, acc0: EcsRegQueryDeep, eid: i32, col: i32, since_tick: i32) -> EcsRegQueryDeep {
    if eid >= ECS_REG_CAP_ENTITIES { return acc0; };
    if _ecs_reg_world_deep_alive_at(w, eid) != 1 { return _ecs_reg_query_changed_scan(w, acc0, eid + 1, col, since_tick); };
    let changed = _ecs_reg_col_ticke_at(_ecs_reg_world_deep_changed_at(w, col), eid);
    if changed > since_tick {
        let ent = ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w, eid));
        let acc1 = _ecs_reg_query_push(acc0, acc0.count, ent);
        return _ecs_reg_query_changed_scan(w, acc1, eid + 1, col, since_tick);
    };
    return _ecs_reg_query_changed_scan(w, acc0, eid + 1, col, since_tick);
}

fn ecs_reg_world_deep_query_changed(w: EcsRegWorldDeep, comp_id: i32, since_tick: i32) -> EcsRegQueryDeep {
    let col = _ecs_reg_world_deep_find_col(w, comp_id, 0);
    if col < 0 { return _ecs_reg_query_empty(); };
    return _ecs_reg_query_changed_scan(w, _ecs_reg_query_empty(), 0, col, since_tick);
}

// ── Pair query: all alive entities WITH both first_col AND second_col. Pair is exposed as the
//    shallow's `(first, second)` plus the matched entity; since SLA tests can't tuple-destructure,
//    we surface triple-pairfield structs EcsRegPairDeep with scalar field accessors `_entity`,
//    `_first_*`, `_second_*` and the pair query wraps them in EcsRegPairQueryDeep { count, p0..p15 }.
struct EcsRegPairDeepPosVel {
    entity: EcsRegEntityDeep,
    first: EcsRegPosDeep,
    second: EcsRegVelDeep
}

fn ecs_reg_pair_deep_pos_vel_entity(p: EcsRegPairDeepPosVel) -> EcsRegEntityDeep { return p.entity; }
fn ecs_reg_pair_deep_pos_vel_first(p: EcsRegPairDeepPosVel) -> EcsRegPosDeep { return p.first; }
fn ecs_reg_pair_deep_pos_vel_second(p: EcsRegPairDeepPosVel) -> EcsRegVelDeep { return p.second; }

struct EcsRegPairQueryDeepPosVel {
    count: i32,
    p0: EcsRegPairDeepPosVel, p1: EcsRegPairDeepPosVel, p2: EcsRegPairDeepPosVel, p3: EcsRegPairDeepPosVel,
    p4: EcsRegPairDeepPosVel, p5: EcsRegPairDeepPosVel, p6: EcsRegPairDeepPosVel, p7: EcsRegPairDeepPosVel,
    p8: EcsRegPairDeepPosVel, p9: EcsRegPairDeepPosVel, p10: EcsRegPairDeepPosVel, p11: EcsRegPairDeepPosVel,
    p12: EcsRegPairDeepPosVel, p13: EcsRegPairDeepPosVel, p14: EcsRegPairDeepPosVel, p15: EcsRegPairDeepPosVel
}

fn _ecs_reg_pair_query_empty() -> EcsRegPairQueryDeepPosVel {
    let z = EcsRegPairDeepPosVel { entity: ecs_reg_entity_new(-1, 0), first: ecs_reg_pos_deep_new(0, 0), second: ecs_reg_vel_deep_new(0, 0) };
    return EcsRegPairQueryDeepPosVel {
        count: 0,
        p0: z, p1: z, p2: z, p3: z, p4: z, p5: z, p6: z, p7: z, p8: z, p9: z, p10: z, p11: z, p12: z, p13: z, p14: z, p15: z
    };
}

fn ecs_reg_pair_query_deep_count(r: EcsRegPairQueryDeepPosVel) -> i32 { return r.count; }
fn ecs_reg_pair_query_deep_at(r: EcsRegPairQueryDeepPosVel, idx: i32) -> EcsRegPairDeepPosVel {
    if idx == 0 { return r.p0; };
    if idx == 1 { return r.p1; };
    if idx == 2 { return r.p2; };
    if idx == 3 { return r.p3; };
    if idx == 4 { return r.p4; };
    if idx == 5 { return r.p5; };
    if idx == 6 { return r.p6; };
    if idx == 7 { return r.p7; };
    if idx == 8 { return r.p8; };
    if idx == 9 { return r.p9; };
    if idx == 10 { return r.p10; };
    if idx == 11 { return r.p11; };
    if idx == 12 { return r.p12; };
    if idx == 13 { return r.p13; };
    if idx == 14 { return r.p14; };
    return r.p15;
}

// `query_pair` walks alive entities with both first_col+ttype=pos and second_col type=vel. Test 2
// uses position (id=0) + velocity (id=1).
fn _ecs_reg_pair_pos_vel_scan(w: EcsRegWorldDeep, acc0: EcsRegPairQueryDeepPosVel, eid: i32, first_col: i32, second_col: i32, without_col: i32) -> EcsRegPairQueryDeepPosVel {
    if eid >= ECS_REG_CAP_ENTITIES { return acc0; };
    if _ecs_reg_world_deep_alive_at(w, eid) != 1 { return _ecs_reg_pair_pos_vel_scan(w, acc0, eid + 1, first_col, second_col, without_col); };
    let first_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, first_col), eid);
    let second_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, second_col), eid);
    let first_ok = first_present == true;
    let second_ok = second_present == true;
    let without_present = if without_col < 0 { false; } else { _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, without_col), eid); };
    let without_ok = without_present != true;
    if first_ok == true {
        if second_ok == true {
            if without_ok == true {
                let pos = _ecs_reg_world_deep_pos_col_at(w, first_col);
                let vel = _ecs_reg_world_deep_vel_col_at(w, second_col);
                let pair = EcsRegPairDeepPosVel {
                    entity: ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w, eid)),
                    first: ecs_reg_pos_deep_new(_ecs_reg_col_pos_x_at(pos, eid), _ecs_reg_col_pos_y_at(pos, eid)),
                    second: ecs_reg_vel_deep_new(_ecs_reg_col_vel_x_at(vel, eid), _ecs_reg_col_vel_y_at(vel, eid))
                };
                return _ecs_reg_pair_pos_vel_push(acc0, acc0.count, pair, eid);
            };
        };
    };
    return _ecs_reg_pair_pos_vel_scan(w, acc0, eid + 1, first_col, second_col, without_col);
}

fn _ecs_reg_pair_pos_vel_push(r0: EcsRegPairQueryDeepPosVel, k: i32, pair: EcsRegPairDeepPosVel, eid: i32) -> EcsRegPairQueryDeepPosVel {
    if r0.count >= ECS_REG_CAP_ENTITIES { return r0; };
    if k == 0 { r0.p0 = pair; r0.count = r0.count + 1; return r0; };
    if k == 1 { r0.p1 = pair; r0.count = r0.count + 1; return r0; };
    if k == 2 { r0.p2 = pair; r0.count = r0.count + 1; return r0; };
    if k == 3 { r0.p3 = pair; r0.count = r0.count + 1; return r0; };
    if k == 4 { r0.p4 = pair; r0.count = r0.count + 1; return r0; };
    if k == 5 { r0.p5 = pair; r0.count = r0.count + 1; return r0; };
    if k == 6 { r0.p6 = pair; r0.count = r0.count + 1; return r0; };
    if k == 7 { r0.p7 = pair; r0.count = r0.count + 1; return r0; };
    if k == 8 { r0.p8 = pair; r0.count = r0.count + 1; return r0; };
    if k == 9 { r0.p9 = pair; r0.count = r0.count + 1; return r0; };
    if k == 10 { r0.p10 = pair; r0.count = r0.count + 1; return r0; };
    if k == 11 { r0.p11 = pair; r0.count = r0.count + 1; return r0; };
    if k == 12 { r0.p12 = pair; r0.count = r0.count + 1; return r0; };
    if k == 13 { r0.p13 = pair; r0.count = r0.count + 1; return r0; };
    if k == 14 { r0.p14 = pair; r0.count = r0.count + 1; return r0; };
    r0.p15 = pair;
    r0.count = r0.count + 1;
    return r0;
}

fn ecs_reg_world_deep_query_pair_pos_vel(w: EcsRegWorldDeep, first_comp_id: i32, second_comp_id: i32) -> EcsRegPairQueryDeepPosVel {
    let first_col = _ecs_reg_world_deep_find_col(w, first_comp_id, 0);
    let second_col = _ecs_reg_world_deep_find_col(w, second_comp_id, 0);
    if first_col < 0 { return _ecs_reg_pair_query_empty(); };
    if second_col < 0 { return _ecs_reg_pair_query_empty(); };
    return _ecs_reg_pair_pos_vel_scan(w, _ecs_reg_pair_query_empty(), 0, first_col, second_col, -1);
}

fn ecs_reg_world_deep_query_pair_pos_vel_without(w: EcsRegWorldDeep, first_comp_id: i32, second_comp_id: i32, without_comp_id: i32) -> EcsRegPairQueryDeepPosVel {
    let first_col = _ecs_reg_world_deep_find_col(w, first_comp_id, 0);
    let second_col = _ecs_reg_world_deep_find_col(w, second_comp_id, 0);
    if first_col < 0 { return _ecs_reg_pair_query_empty(); };
    if second_col < 0 { return _ecs_reg_pair_query_empty(); };
    let without_col = _ecs_reg_world_deep_find_col(w, without_comp_id, 0);
    return _ecs_reg_pair_pos_vel_scan(w, _ecs_reg_pair_query_empty(), 0, first_col, second_col, without_col);
}

// ── Pair_mutable view (mirrors RegistryErasedPairMut<A, B>): exposes the same pair result plus
//    the entity/component ids captured at query time. Tests then call `pair_write_first` to
//    write back via the captured ids. ──────────────────────────────────────────────────────────
struct EcsRegPairMutDeepPosVel {
    entity: EcsRegEntityDeep,
    first: EcsRegPosDeep,
    second: EcsRegVelDeep,
    first_comp_id: i32
}

fn ecs_reg_pair_mut_pos_vel_entity(p: EcsRegPairMutDeepPosVel) -> EcsRegEntityDeep { return p.entity; }
fn ecs_reg_pair_mut_pos_vel_first(p: EcsRegPairMutDeepPosVel) -> EcsRegPosDeep { return p.first; }
fn ecs_reg_pair_mut_pos_vel_second(p: EcsRegPairMutDeepPosVel) -> EcsRegVelDeep { return p.second; }
fn ecs_reg_pair_mut_pos_vel_first_comp_id(p: EcsRegPairMutDeepPosVel) -> i32 { return p.first_comp_id; }

struct EcsRegPairMutQueryDeepPosVel {
    count: i32,
    p0: EcsRegPairMutDeepPosVel, p1: EcsRegPairMutDeepPosVel, p2: EcsRegPairMutDeepPosVel, p3: EcsRegPairMutDeepPosVel,
    p4: EcsRegPairMutDeepPosVel, p5: EcsRegPairMutDeepPosVel, p6: EcsRegPairMutDeepPosVel, p7: EcsRegPairMutDeepPosVel,
    p8: EcsRegPairMutDeepPosVel, p9: EcsRegPairMutDeepPosVel, p10: EcsRegPairMutDeepPosVel, p11: EcsRegPairMutDeepPosVel,
    p12: EcsRegPairMutDeepPosVel, p13: EcsRegPairMutDeepPosVel, p14: EcsRegPairMutDeepPosVel, p15: EcsRegPairMutDeepPosVel
}

fn _ecs_reg_pair_mut_query_empty() -> EcsRegPairMutQueryDeepPosVel {
    let z = EcsRegPairMutDeepPosVel { entity: ecs_reg_entity_new(-1, 0), first: ecs_reg_pos_deep_new(0, 0), second: ecs_reg_vel_deep_new(0, 0), first_comp_id: -1 };
    return EcsRegPairMutQueryDeepPosVel {
        count: 0,
        p0: z, p1: z, p2: z, p3: z, p4: z, p5: z, p6: z, p7: z, p8: z, p9: z, p10: z, p11: z, p12: z, p13: z, p14: z, p15: z
    };
}

fn ecs_reg_pair_mut_query_deep_count(r: EcsRegPairMutQueryDeepPosVel) -> i32 { return r.count; }
fn ecs_reg_pair_mut_query_deep_at(r: EcsRegPairMutQueryDeepPosVel, idx: i32) -> EcsRegPairMutDeepPosVel {
    if idx == 0 { return r.p0; };
    if idx == 1 { return r.p1; };
    if idx == 2 { return r.p2; };
    if idx == 3 { return r.p3; };
    if idx == 4 { return r.p4; };
    if idx == 5 { return r.p5; };
    if idx == 6 { return r.p6; };
    if idx == 7 { return r.p7; };
    if idx == 8 { return r.p8; };
    if idx == 9 { return r.p9; };
    if idx == 10 { return r.p10; };
    if idx == 11 { return r.p11; };
    if idx == 12 { return r.p12; };
    if idx == 13 { return r.p13; };
    if idx == 14 { return r.p14; };
    return r.p15;
}

fn _ecs_reg_pair_mut_pos_vel_push(r0: EcsRegPairMutQueryDeepPosVel, k: i32, pair: EcsRegPairMutDeepPosVel) -> EcsRegPairMutQueryDeepPosVel {
    if r0.count >= ECS_REG_CAP_ENTITIES { return r0; };
    if k == 0 { r0.p0 = pair; r0.count = r0.count + 1; return r0; };
    if k == 1 { r0.p1 = pair; r0.count = r0.count + 1; return r0; };
    if k == 2 { r0.p2 = pair; r0.count = r0.count + 1; return r0; };
    if k == 3 { r0.p3 = pair; r0.count = r0.count + 1; return r0; };
    if k == 4 { r0.p4 = pair; r0.count = r0.count + 1; return r0; };
    if k == 5 { r0.p5 = pair; r0.count = r0.count + 1; return r0; };
    if k == 6 { r0.p6 = pair; r0.count = r0.count + 1; return r0; };
    if k == 7 { r0.p7 = pair; r0.count = r0.count + 1; return r0; };
    if k == 8 { r0.p8 = pair; r0.count = r0.count + 1; return r0; };
    if k == 9 { r0.p9 = pair; r0.count = r0.count + 1; return r0; };
    if k == 10 { r0.p10 = pair; r0.count = r0.count + 1; return r0; };
    if k == 11 { r0.p11 = pair; r0.count = r0.count + 1; return r0; };
    if k == 12 { r0.p12 = pair; r0.count = r0.count + 1; return r0; };
    if k == 13 { r0.p13 = pair; r0.count = r0.count + 1; return r0; };
    if k == 14 { r0.p14 = pair; r0.count = r0.count + 1; return r0; };
    r0.p15 = pair;
    r0.count = r0.count + 1;
    return r0;
}

fn ecs_reg_world_deep_query_pair_mut_pos_vel(w: EcsRegWorldDeep, first_comp_id: i32, second_comp_id: i32) -> EcsRegPairMutQueryDeepPosVel {
    let first_col = _ecs_reg_world_deep_find_col(w, first_comp_id, 0);
    let second_col = _ecs_reg_world_deep_find_col(w, second_comp_id, 0);
    let acc0 = _ecs_reg_pair_mut_query_empty();
    if first_col < 0 { return acc0; };
    if second_col < 0 { return acc0; };
    return _ecs_reg_pair_mut_pos_vel_scan(w, acc0, 0, first_col, second_col);
}

fn _ecs_reg_pair_mut_pos_vel_scan(w: EcsRegWorldDeep, acc0: EcsRegPairMutQueryDeepPosVel, eid: i32, first_col: i32, second_col: i32) -> EcsRegPairMutQueryDeepPosVel {
    if eid >= ECS_REG_CAP_ENTITIES { return acc0; };
    if _ecs_reg_world_deep_alive_at(w, eid) != 1 { return _ecs_reg_pair_mut_pos_vel_scan(w, acc0, eid + 1, first_col, second_col); };
    let first_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, first_col), eid);
    let second_present = _ecs_reg_bit_has(_ecs_reg_world_deep_present_at(w, second_col), eid);
    if first_present == true {
        if second_present == true {
            let pos = _ecs_reg_world_deep_pos_col_at(w, first_col);
            let vel = _ecs_reg_world_deep_vel_col_at(w, second_col);
            let pair = EcsRegPairMutDeepPosVel {
                entity: ecs_reg_entity_new(eid, _ecs_reg_world_deep_gen_at(w, eid)),
                first: ecs_reg_pos_deep_new(_ecs_reg_col_pos_x_at(pos, eid), _ecs_reg_col_pos_y_at(pos, eid)),
                second: ecs_reg_vel_deep_new(_ecs_reg_col_vel_x_at(vel, eid), _ecs_reg_col_vel_y_at(vel, eid)),
                first_comp_id: _ecs_reg_world_deep_comp_id_at(w, first_col)
            };
            return _ecs_reg_pair_mut_pos_vel_push(acc0, acc0.count, pair);
        };
    };
    return _ecs_reg_pair_mut_pos_vel_scan(w, acc0, eid + 1, first_col, second_col);
}

// ── Pair write-back: write the new pos value into the captured first_comp_id column for the
//    captured entity. Bumps change_tick (write_message tests read change_tick post-write). ─────
fn ecs_reg_world_deep_pair_write_first_pos_vel(w0: EcsRegWorldDeep, item: EcsRegPairMutDeepPosVel, value: EcsRegPosDeep) -> EcsRegWorldDeep {
    return ecs_reg_world_deep_insert_pos(w0, item.entity, item.first_comp_id, value);
}

// ── Resource: single typed ErasedTestTime slot. insert/get/set. ───────────────────────────────
fn ecs_reg_world_deep_insert_resource(w0: EcsRegWorldDeep, value: EcsRegTimeDeep) -> EcsRegWorldDeep {
    w0.res_time_tick = value.tick;
    w0.res_time_set = 1;
    return w0;
}

fn ecs_reg_world_deep_get_resource(w: EcsRegWorldDeep) -> EcsRegTimeDeep {
    return ecs_reg_time_deep_new(w.res_time_tick);
}

// ── Message: single typed ErasedTestEvent slot with a monotone count. read returns the latest.
fn ecs_reg_world_deep_write_message(w0: EcsRegWorldDeep, value: EcsRegEventDeep) -> EcsRegWorldDeep {
    w0.msg_event_amount = value.amount;
    w0.msg_count = w0.msg_count + 1;
    return w0;
}

// Mirrors shallow MessageRead<M> wrapper. A fresh reader sees the current amount + count minus the
// reader's start position; we expose the single latest message via `message_read_count`/`amount`.
struct EcsRegMessageReadDeep { amount: i32, count: i32 }

fn ecs_reg_message_read_amount(r: EcsRegMessageReadDeep) -> i32 { return r.amount; }
fn ecs_reg_message_read_count(r: EcsRegMessageReadDeep) -> i32 { return r.count; }

fn ecs_reg_world_deep_read_message(w: EcsRegWorldDeep, default_value: EcsRegEventDeep) -> EcsRegMessageReadDeep {
    if w.msg_count == 0 {
        return EcsRegMessageReadDeep { amount: default_value.amount, count: 0 };
    };
    return EcsRegMessageReadDeep { amount: w.msg_event_amount, count: w.msg_count };
}

