// ── The world. cap-16 entities, cap-8 component columns. Per column:
//   comp_id (the registered component id), type_id (101=pos/102=vel/103=marker),
//   storage (0=table, 1=sparse), present (i32 bitmask over cap-16 entity slots),
//   added_tick (single i32 shared across the column -- the tick the column was registered at),
//   changed_tick (single i32 shared -- the tick the latest insert/replace touched any entity).
// Per-entity additions/changes are tracked per-entity via `added_tick_e_{col}_{eid}` flat blocks;
// we expose them as cap-8 columns each with cap-16 flat per-entity added->tick i32 fields held in
// EcsRegColTick structs (one per column for added, one per column for changed). The shared
// `added_tick`/`changed_tick` per column are convenience shortcuts NOT used by the test (the test
// queries query_added_since(tick=0) and query_changed_since(tick=before) -- comparing per-entity tick).
struct EcsRegColTickE {
    t0: i32, t1: i32, t2: i32, t3: i32, t4: i32, t5: i32, t6: i32, t7: i32,
    t8: i32, t9: i32, t10: i32, t11: i32, t12: i32, t13: i32, t14: i32, t15: i32
}

fn _ecs_reg_col_ticke_empty() -> EcsRegColTickE {
    return EcsRegColTickE {
        t0: 0, t1: 0, t2: 0, t3: 0, t4: 0, t5: 0, t6: 0, t7: 0,
        t8: 0, t9: 0, t10: 0, t11: 0, t12: 0, t13: 0, t14: 0, t15: 0
    };
}

fn _ecs_reg_col_ticke_at(col: EcsRegColTickE, eid: i32) -> i32 {
    if eid == 0 { return col.t0; };
    if eid == 1 { return col.t1; };
    if eid == 2 { return col.t2; };
    if eid == 3 { return col.t3; };
    if eid == 4 { return col.t4; };
    if eid == 5 { return col.t5; };
    if eid == 6 { return col.t6; };
    if eid == 7 { return col.t7; };
    if eid == 8 { return col.t8; };
    if eid == 9 { return col.t9; };
    if eid == 10 { return col.t10; };
    if eid == 11 { return col.t11; };
    if eid == 12 { return col.t12; };
    if eid == 13 { return col.t13; };
    if eid == 14 { return col.t14; };
    return col.t15;
}

fn _ecs_reg_col_ticke_set(col0: EcsRegColTickE, eid: i32, value: i32) -> EcsRegColTickE {
    if eid == 0 { col0.t0 = value; return col0; };
    if eid == 1 { col0.t1 = value; return col0; };
    if eid == 2 { col0.t2 = value; return col0; };
    if eid == 3 { col0.t3 = value; return col0; };
    if eid == 4 { col0.t4 = value; return col0; };
    if eid == 5 { col0.t5 = value; return col0; };
    if eid == 6 { col0.t6 = value; return col0; };
    if eid == 7 { col0.t7 = value; return col0; };
    if eid == 8 { col0.t8 = value; return col0; };
    if eid == 9 { col0.t9 = value; return col0; };
    if eid == 10 { col0.t10 = value; return col0; };
    if eid == 11 { col0.t11 = value; return col0; };
    if eid == 12 { col0.t12 = value; return col0; };
    if eid == 13 { col0.t13 = value; return col0; };
    if eid == 14 { col0.t14 = value; return col0; };
    col0.t15 = value;
    return col0;
}

// ── The world. cap-16 entities, cap-8 columns. ───────────────────────────────────────────────
struct EcsRegWorldDeep {
    // Entity registry (cap-16).
    gen0: i32, gen1: i32, gen2: i32, gen3: i32, gen4: i32, gen5: i32, gen6: i32, gen7: i32,
    gen8: i32, gen9: i32, gen10: i32, gen11: i32, gen12: i32, gen13: i32, gen14: i32, gen15: i32,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32, alive4: i32, alive5: i32, alive6: i32, alive7: i32,
    alive8: i32, alive9: i32, alive10: i32, alive11: i32, alive12: i32, alive13: i32, alive14: i32, alive15: i32,
    next_entity: i32,
    entity_count: i32,
    change_tick: i32,
    // Component columns (cap-8). Each registered column gets a free slot 0..7.
    comp_count: i32,
    comp_id0: i32, comp_id1: i32, comp_id2: i32, comp_id3: i32, comp_id4: i32, comp_id5: i32, comp_id6: i32, comp_id7: i32,
    type_id0: i32, type_id1: i32, type_id2: i32, type_id3: i32, type_id4: i32, type_id5: i32, type_id6: i32, type_id7: i32,
    storage0: i32, storage1: i32, storage2: i32, storage3: i32, storage4: i32, storage5: i32, storage6: i32, storage7: i32,
    present0: i32, present1: i32, present2: i32, present3: i32, present4: i32, present5: i32, present6: i32, present7: i32,
    // Per-entity added-tick / changed-tick per column.
    added0: EcsRegColTickE, added1: EcsRegColTickE, added2: EcsRegColTickE, added3: EcsRegColTickE,
    added4: EcsRegColTickE, added5: EcsRegColTickE, added6: EcsRegColTickE, added7: EcsRegColTickE,
    changed0: EcsRegColTickE, changed1: EcsRegColTickE, changed2: EcsRegColTickE, changed3: EcsRegColTickE,
    changed4: EcsRegColTickE, changed5: EcsRegColTickE, changed6: EcsRegColTickE, changed7: EcsRegColTickE,
    // Typed storage slots (cap-8 columns per type).
    pos_col0: EcsRegColDeepPos, pos_col1: EcsRegColDeepPos, pos_col2: EcsRegColDeepPos, pos_col3: EcsRegColDeepPos,
    pos_col4: EcsRegColDeepPos, pos_col5: EcsRegColDeepPos, pos_col6: EcsRegColDeepPos, pos_col7: EcsRegColDeepPos,
    vel_col0: EcsRegColDeepVel, vel_col1: EcsRegColDeepVel, vel_col2: EcsRegColDeepVel, vel_col3: EcsRegColDeepVel,
    vel_col4: EcsRegColDeepVel, vel_col5: EcsRegColDeepVel, vel_col6: EcsRegColDeepVel, vel_col7: EcsRegColDeepVel,
    marker_col0: EcsRegColDeepMarker, marker_col1: EcsRegColDeepMarker, marker_col2: EcsRegColDeepMarker, marker_col3: EcsRegColDeepMarker,
    marker_col4: EcsRegColDeepMarker, marker_col5: EcsRegColDeepMarker, marker_col6: EcsRegColDeepMarker, marker_col7: EcsRegColDeepMarker,
    // Resource slot (single typed resource: ErasedTestTime).
    res_time_tick: i32,
    res_time_set: i32,
    // Message slot (single typed message: ErasedTestEvent) and a counter.
    msg_event_amount: i32,
    msg_count: i32
}

fn ecs_reg_world_deep_new() -> EcsRegWorldDeep {
    return EcsRegWorldDeep {
        gen0: 0, gen1: 0, gen2: 0, gen3: 0, gen4: 0, gen5: 0, gen6: 0, gen7: 0,
        gen8: 0, gen9: 0, gen10: 0, gen11: 0, gen12: 0, gen13: 0, gen14: 0, gen15: 0,
