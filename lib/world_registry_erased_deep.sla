        next_entity: 0, entity_count: 0, change_tick: 0,
        comp_count: 0,
        comp_id0: -1, comp_id1: -1, comp_id2: -1, comp_id3: -1, comp_id4: -1, comp_id5: -1, comp_id6: -1, comp_id7: -1,
        type_id0: -1, type_id1: -1, type_id2: -1, type_id3: -1, type_id4: -1, type_id5: -1, type_id6: -1, type_id7: -1,
        storage0: -1, storage1: -1, storage2: -1, storage3: -1, storage4: -1, storage5: -1, storage6: -1, storage7: -1,
        present0: 0, present1: 0, present2: 0, present3: 0, present4: 0, present5: 0, present6: 0, present7: 0,
        added0: _ecs_reg_col_ticke_empty(), added1: _ecs_reg_col_ticke_empty(), added2: _ecs_reg_col_ticke_empty(), added3: _ecs_reg_col_ticke_empty(),
        added4: _ecs_reg_col_ticke_empty(), added5: _ecs_reg_col_ticke_empty(), added6: _ecs_reg_col_ticke_empty(), added7: _ecs_reg_col_ticke_empty(),
