fn ecs_tbl_obs_commands_pcomp_count(c: EcsTblObsCommandsDeep) -> i32 { return c.pcomp_count; }
fn ecs_tbl_obs_commands_pres_count(c: EcsTblObsCommandsDeep) -> i32 { return c.pres_count; }
fn ecs_tbl_obs_commands_pmsg_count(c: EcsTblObsCommandsDeep) -> i32 { return c.pmsg_count; }
fn ecs_tbl_obs_commands_pcev_count(c: EcsTblObsCommandsDeep) -> i32 { return c.pcev_count; }

fn ecs_tbl_obs_commands_reserve_entity(c: EcsTblObsCommandsDeep) -> (EcsTblObsCommandsDeep, i32) {
    return (c, 0);
}

fn ecs_tbl_obs_commands_insert(c: EcsTblObsCommandsDeep, entity_id: i32, component_id: i32, type_id: i32, value: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    if c.pcomp_count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    let slot: i32 = c.pcomp_count;
    c = ecs_tbl_obs_commands_set_pt(c, slot, type_id);
    c = ecs_tbl_obs_commands_set_pv(c, slot, value);
    c.pcomp_count = c.pcomp_count + 1;
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_INSERT_COMPONENT, entity_id, component_id, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_obs_commands_remove(c: EcsTblObsCommandsDeep, entity_id: i32, component_id: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_REMOVE_COMPONENT, entity_id, component_id, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_obs_commands_despawn(c: EcsTblObsCommandsDeep, entity_id: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_DESPAWN, entity_id, 0, -1);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_obs_commands_insert_resource(c: EcsTblObsCommandsDeep, value: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    if c.pres_count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    let slot: i32 = c.pres_count;
    c = ecs_tbl_obs_commands_set_pres(c, slot, value);
    c.pres_count = c.pres_count + 1;
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_INSERT_RESOURCE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_obs_commands_write_message(c: EcsTblObsCommandsDeep, value: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    if c.pmsg_count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    let slot: i32 = c.pmsg_count;
    c = ecs_tbl_obs_commands_set_pmsg(c, slot, value);
    c.pmsg_count = c.pmsg_count + 1;
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_WRITE_MESSAGE, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// trigger(type_id, value): no target entity. Mirrors shallow `trigger` with `entity_placeholder()`.
fn ecs_tbl_obs_commands_trigger(c: EcsTblObsCommandsDeep, type_id: i32, value: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    if c.pcev_count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    let slot: i32 = c.pcev_count;
    c = ecs_tbl_obs_commands_set_et(c, slot, type_id);
    c = ecs_tbl_obs_commands_set_ev(c, slot, value);
    c.pcev_count = c.pcev_count + 1;
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_TRIGGER_EVENT, 0, 0, slot);
    c.count = c.count + 1;
    return c;
}

// trigger_entity(entity_id, type_id, value): trigger carrying a target entity (shallow
// `trigger_entity` variant that sets the entity_id into the command slot instead of placeholder).
fn ecs_tbl_obs_commands_trigger_entity(c: EcsTblObsCommandsDeep, entity_id: i32, type_id: i32, value: i32) -> EcsTblObsCommandsDeep {
    if c.count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    if c.pcev_count >= ECS_CMD_TBL_OBS_CAP_DEEP { return c; };
    let slot: i32 = c.pcev_count;
    c = ecs_tbl_obs_commands_set_et(c, slot, type_id);
    c = ecs_tbl_obs_commands_set_ev(c, slot, value);
    c.pcev_count = c.pcev_count + 1;
    c = ecs_tbl_obs_commands_set_slot(c, c.count, ECS_CMD_TBL_OBS_TRIGGER_EVENT, entity_id, 0, slot);
    c.count = c.count + 1;
    return c;
}

fn ecs_tbl_obs_commands_count_by_kind(c: EcsTblObsCommandsDeep, kind: i32) -> i32 {
    let i: i32 = 0;
    let out: i32 = 0;
    while i < c.count {
        if ecs_tbl_obs_commands_kind_at(c, i) == kind { out = out + 1; };
        i = i + 1;
    }
    return out;
}

// resolve_value: kind-indexed scalar side-array readout.
fn ecs_tbl_obs_commands_resolve_value(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_obs_commands_kind_at(c, idx);
    let vidx: i32 = ecs_tbl_obs_commands_idx_at(c, idx);
    if kind == ECS_CMD_TBL_OBS_INSERT_COMPONENT {
        return ecs_tbl_obs_commands_pv_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_OBS_INSERT_RESOURCE {
        return ecs_tbl_obs_commands_pres_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_OBS_WRITE_MESSAGE {
        return ecs_tbl_obs_commands_pmsg_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_OBS_TRIGGER_EVENT {
        return ecs_tbl_obs_commands_ev_at(c, vidx);
    };
    return 0;
}

// resolve_type: returns the int type_id for INSERT_COMPONENT, else the event_type for TRIGGER_EVENT,
// else 0. Lets observers and trigger downstream ops distinguish component-type id from event-type id.
fn ecs_tbl_obs_commands_resolve_type(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    let kind: i32 = ecs_tbl_obs_commands_kind_at(c, idx);
    let vidx: i32 = ecs_tbl_obs_commands_idx_at(c, idx);
    if kind == ECS_CMD_TBL_OBS_INSERT_COMPONENT {
        return ecs_tbl_obs_commands_pt_at(c, vidx);
    };
    if kind == ECS_CMD_TBL_OBS_TRIGGER_EVENT {
        return ecs_tbl_obs_commands_et_at(c, vidx);
    };
    return 0;
}

fn ecs_tbl_obs_commands_clear(c: EcsTblObsCommandsDeep) -> EcsTblObsCommandsDeep {
    return ecs_tbl_obs_commands_new();
}
