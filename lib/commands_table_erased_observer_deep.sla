// Deepened Bevy ECS deferred command queue for TableErasedObserverWorld
// (shallow lib/commands_table_erased_observer.sla deep;
//  src/system/commands/table_erased_observer.rs observer-aware deferred queue).
//
// Mirrors the shallow queue but replaces the generic `TableErasedObserverCommands<R, M>` + boxed
// ErasedComponentValue / ErasedEventValue side arrays with fixed-cap-8 kind-discriminated storage
// and parallel scalar side arrays. Avoids generic types, fn-ptr world-application, and boxed
// erased pointers (ecs_box_drop<T> / erased component / erased event).
//
// Kinds (mirror shallow):
//   INSERT_COMPONENT=1, REMOVE_COMPONENT=2, DESPAWN=3, INSERT_RESOURCE=4,
//   WRITE_MESSAGE=5, TRIGGER_EVENT=6.
// INSERT_COMPONENT side payload uses parallel `pt` + `pv` cap-8 arrays sharing pcomp_count.
// INSERT_RESOURCE uses pres cap-8; WRITE_MESSAGE uses pmsg cap-8.
// TRIGGER_EVENT carries a parallel `et` (event type_id) + `ev` (scalar value) side array cap-8
// (the erased-event interior we can observe from the deep isolated harness). REMOVE_COMPONENT and
// DESPAWN carry no side payload.

const ECS_CMD_TBL_OBS_CAP_DEEP: i32 = 8;
const ECS_CMD_TBL_OBS_INSERT_COMPONENT: i32 = 1;
const ECS_CMD_TBL_OBS_REMOVE_COMPONENT: i32 = 2;
const ECS_CMD_TBL_OBS_DESPAWN: i32 = 3;
const ECS_CMD_TBL_OBS_INSERT_RESOURCE: i32 = 4;
const ECS_CMD_TBL_OBS_WRITE_MESSAGE: i32 = 5;
const ECS_CMD_TBL_OBS_TRIGGER_EVENT: i32 = 6;

struct EcsTblObsCommandDeep {
    kind: i32,
    entity_id: i32,
    component_id: i32,
    value_index: i32,
}

fn ecs_tbl_obs_command(kind: i32, entity_id: i32, component_id: i32, value_index: i32) -> EcsTblObsCommandDeep {
    return EcsTblObsCommandDeep { kind: kind, entity_id: entity_id, component_id: component_id, value_index: value_index };
}

fn ecs_tbl_obs_command_kind(c: EcsTblObsCommandDeep) -> i32 { return c.kind; }
fn ecs_tbl_obs_command_entity_id(c: EcsTblObsCommandDeep) -> i32 { return c.entity_id; }
fn ecs_tbl_obs_command_component_id(c: EcsTblObsCommandDeep) -> i32 { return c.component_id; }
fn ecs_tbl_obs_command_value_index(c: EcsTblObsCommandDeep) -> i32 { return c.value_index; }

struct EcsTblObsCommandsDeep {
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    v0: i32, v1: i32, v2: i32, v3: i32, v4: i32, v5: i32, v6: i32, v7: i32,
    // INSERT_COMPONENT side arrays: parallel pt/pv cap-8 sharing pcomp_count
    pt0: i32, pt1: i32, pt2: i32, pt3: i32, pt4: i32, pt5: i32, pt6: i32, pt7: i32,
    pv0: i32, pv1: i32, pv2: i32, pv3: i32, pv4: i32, pv5: i32, pv6: i32, pv7: i32,
    pcomp_count: i32,
    // resource side array cap-8
    r0: i32, r1: i32, r2: i32, r3: i32, r4: i32, r5: i32, r6: i32, r7: i32,
    pres_count: i32,
    // message side array cap-8
    m0: i32, m1: i32, m2: i32, m3: i32, m4: i32, m5: i32, m6: i32, m7: i32,
    pmsg_count: i32,
    // event side arrays: parallel et/ev cap-8 sharing pcev_count
    et0: i32, et1: i32, et2: i32, et3: i32, et4: i32, et5: i32, et6: i32, et7: i32,
    ev0: i32, ev1: i32, ev2: i32, ev3: i32, ev4: i32, ev5: i32, ev6: i32, ev7: i32,
    pcev_count: i32,
    count: i32,
}

fn ecs_tbl_obs_commands_new() -> EcsTblObsCommandsDeep {
    let c = EcsTblObsCommandsDeep {
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        c0: 0, c1: 0, c2: 0, c3: 0, c4: 0, c5: 0, c6: 0, c7: 0,
        v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0,
        pt0: 0, pt1: 0, pt2: 0, pt3: 0, pt4: 0, pt5: 0, pt6: 0, pt7: 0,
        pv0: 0, pv1: 0, pv2: 0, pv3: 0, pv4: 0, pv5: 0, pv6: 0, pv7: 0,
        pcomp_count: 0,
        r0: 0, r1: 0, r2: 0, r3: 0, r4: 0, r5: 0, r6: 0, r7: 0,
        pres_count: 0,
        m0: 0, m1: 0, m2: 0, m3: 0, m4: 0, m5: 0, m6: 0, m7: 0,
        pmsg_count: 0,
        et0: 0, et1: 0, et2: 0, et3: 0, et4: 0, et5: 0, et6: 0, et7: 0,
        ev0: 0, ev1: 0, ev2: 0, ev3: 0, ev4: 0, ev5: 0, ev6: 0, ev7: 0,
        pcev_count: 0,
        count: 0,
    };
    return c;
}

fn ecs_tbl_obs_commands_len(c: EcsTblObsCommandsDeep) -> i32 { return c.count; }

fn ecs_tbl_obs_commands_kind_at(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.k0; };
    if idx == 1 { return c.k1; };
    if idx == 2 { return c.k2; };
    if idx == 3 { return c.k3; };
    if idx == 4 { return c.k4; };
    if idx == 5 { return c.k5; };
    if idx == 6 { return c.k6; };
    if idx == 7 { return c.k7; };
    return 0;
}

fn ecs_tbl_obs_commands_entity_at(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    return 0;
}

fn ecs_tbl_obs_commands_cmp_at(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.c0; };
    if idx == 1 { return c.c1; };
    if idx == 2 { return c.c2; };
    if idx == 3 { return c.c3; };
    if idx == 4 { return c.c4; };
    if idx == 5 { return c.c5; };
    if idx == 6 { return c.c6; };
    if idx == 7 { return c.c7; };
    return 0;
}

fn ecs_tbl_obs_commands_idx_at(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.v0; };
    if idx == 1 { return c.v1; };
    if idx == 2 { return c.v2; };
    if idx == 3 { return c.v3; };
    if idx == 4 { return c.v4; };
    if idx == 5 { return c.v5; };
    if idx == 6 { return c.v6; };
    if idx == 7 { return c.v7; };
    return 0;
}

fn ecs_tbl_obs_commands_set_slot(c: EcsTblObsCommandsDeep, idx: i32, k: i32, e: i32, cmp: i32, v: i32) -> EcsTblObsCommandsDeep {
    if idx == 0 { c.k0 = k; c.e0 = e; c.c0 = cmp; c.v0 = v; };
    if idx == 1 { c.k1 = k; c.e1 = e; c.c1 = cmp; c.v1 = v; };
    if idx == 2 { c.k2 = k; c.e2 = e; c.c2 = cmp; c.v2 = v; };
    if idx == 3 { c.k3 = k; c.e3 = e; c.c3 = cmp; c.v3 = v; };
    if idx == 4 { c.k4 = k; c.e4 = e; c.c4 = cmp; c.v4 = v; };
    if idx == 5 { c.k5 = k; c.e5 = e; c.c5 = cmp; c.v5 = v; };
    if idx == 6 { c.k6 = k; c.e6 = e; c.c6 = cmp; c.v6 = v; };
    if idx == 7 { c.k7 = k; c.e7 = e; c.c7 = cmp; c.v7 = v; };
    return c;
}

// pt/pv setters/readers (cap-8)
fn ecs_tbl_obs_commands_set_pt(c: EcsTblObsCommandsDeep, idx: i32, value: i32) -> EcsTblObsCommandsDeep {
    if idx == 0 { c.pt0 = value; };
    if idx == 1 { c.pt1 = value; };
    if idx == 2 { c.pt2 = value; };
    if idx == 3 { c.pt3 = value; };
    if idx == 4 { c.pt4 = value; };
    if idx == 5 { c.pt5 = value; };
    if idx == 6 { c.pt6 = value; };
    if idx == 7 { c.pt7 = value; };
    return c;
}

fn ecs_tbl_obs_commands_pt_at(c: EcsTblObsCommandsDeep, idx: i32) -> i32 {
    if idx == 0 { return c.pt0; };
    if idx == 1 { return c.pt1; };
    if idx == 2 { return c.pt2; };
    if idx == 3 { return c.pt3; };
    if idx == 4 { return c.pt4; };
    if idx == 5 { return c.pt5; };
    if idx == 6 { return c.pt6; };
    if idx == 7 { return c.pt7; };
    return 0;
}

fn ecs_tbl_obs_commands_set_pv(c: EcsTblObsCommandsDeep, idx: i32, value: i32) -> EcsTblObsCommandsDeep {
