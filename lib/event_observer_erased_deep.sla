// Deepened Bevy ECS erased-event observer registry (src/observer/... Event type-id dispatch).
// Stand-in for shallow lib/event_observer_erased.sla (Vec-backed + box/unsafe). Deep variant
// uses no raw pointers, no generics, no fn-ptr. Observers are keyed by integer event-type-id
// and dispatched via a kind switch (callback_kind) so SLA can read kind->behavior deterministically.
// Operations: new, add (cap-8), count, trigger (whole-world event), trigger_entity (targeted event),
// last_event_type_id/last_entity_id/result_sum/trigger_count accessors, clear. event types are
// realized via discrimination constants ECS_EVT_SPEAK/ECS_EVT_EXPLODE and payload builders.
// Shallow lib/event_observer_erased.sla retained.

const ECS_EVT_SPEAK_DEEP: i32 = 129101;
const ECS_EVT_EXPLODE_DEEP: i32 = 129102;
const ECS_OBSERVER_CAP_DEEP: i32 = 8;

// observer callback kinds (used by dispatch selector switch on `kind`)
const ECS_OBSERVER_KIND_SPEAK: i32 = 1;
const ECS_OBSERVER_KIND_EXPLODE: i32 = 2;

struct EcsErasedEventValueDeep {
    type_id: i32,
    payload: i32,
}

fn ecs_erased_event_value_new(type_id: i32, payload: i32) -> EcsErasedEventValueDeep {
    return EcsErasedEventValueDeep { type_id: type_id, payload: payload };
}
fn ecs_erased_event_value_type_id(v: EcsErasedEventValueDeep) -> i32 { return v.type_id; }
fn ecs_erased_event_value_payload(v: EcsErasedEventValueDeep) -> i32 { return v.payload; }

struct EcsErasedEventObserverDeep {
    type_id: i32,
    kind: i32,
}

fn ecs_erased_observer_new(type_id: i32, kind: i32) -> EcsErasedEventObserverDeep {
    return EcsErasedEventObserverDeep { type_id: type_id, kind: kind };
}
fn ecs_erased_observer_type_id(o: EcsErasedEventObserverDeep) -> i32 { return o.type_id; }
fn ecs_erased_observer_kind(o: EcsErasedEventObserverDeep) -> i32 { return o.kind; }

// Dispatch selector mimicking the erased observer callback for a kind at a target.
// speak: returns payload + target (or payload if target < 0).
// explode: returns payload + target (always adds target).
// Other kinds: returns 0.
fn ecs_erased_observer_run(kind: i32, payload: i32, target: i32) -> i32 {
    if kind == ECS_OBSERVER_KIND_SPEAK {
        if target < 0 { return payload; };
        return payload + target;
    };
    if kind == ECS_OBSERVER_KIND_EXPLODE {
        return payload + target;
    };
    return 0;
}

struct EcsErasedObserversDeep {
    t0: i32, t1: i32, t2: i32, t3: i32, t4: i32, t5: i32, t6: i32, t7: i32,
    k0: i32, k1: i32, k2: i32, k3: i32, k4: i32, k5: i32, k6: i32, k7: i32,
    count: i32,
    trigger_count: i32,
    last_event_type_id: i32,
    last_entity_id: i32,
    result_sum: i32,
}

fn ecs_erased_observers_new() -> EcsErasedObserversDeep {
    let o = EcsErasedObserversDeep {
        t0: 0, t1: 0, t2: 0, t3: 0, t4: 0, t5: 0, t6: 0, t7: 0,
        k0: 0, k1: 0, k2: 0, k3: 0, k4: 0, k5: 0, k6: 0, k7: 0,
        count: 0,
        trigger_count: 0,
        last_event_type_id: 0,
        last_entity_id: -1,
        result_sum: 0,
    };
    return o;
}

fn ecs_erased_observers_count(o: EcsErasedObserversDeep) -> i32 { return o.count; }
fn ecs_erased_observers_trigger_count(o: EcsErasedObserversDeep) -> i32 { return o.trigger_count; }
fn ecs_erased_observers_last_event_type_id(o: EcsErasedObserversDeep) -> i32 { return o.last_event_type_id; }
fn ecs_erased_observers_last_entity_id(o: EcsErasedObserversDeep) -> i32 { return o.last_entity_id; }
fn ecs_erased_observers_result_sum(o: EcsErasedObserversDeep) -> i32 { return o.result_sum; }

fn ecs_erased_observers_type_at(o: EcsErasedObserversDeep, idx: i32) -> i32 {
    if idx == 0 { return o.t0; };
    if idx == 1 { return o.t1; };
    if idx == 2 { return o.t2; };
    if idx == 3 { return o.t3; };
    if idx == 4 { return o.t4; };
    if idx == 5 { return o.t5; };
    if idx == 6 { return o.t6; };
    if idx == 7 { return o.t7; };
    return 0;
}

fn ecs_erased_observers_kind_at(o: EcsErasedObserversDeep, idx: i32) -> i32 {
    if idx == 0 { return o.k0; };
    if idx == 1 { return o.k1; };
    if idx == 2 { return o.k2; };
    if idx == 3 { return o.k3; };
    if idx == 4 { return o.k4; };
    if idx == 5 { return o.k5; };
    if idx == 6 { return o.k6; };
    if idx == 7 { return o.k7; };
    return 0;
}

fn ecs_erased_observers_set_type(o: EcsErasedObserversDeep, idx: i32, t: i32) -> EcsErasedObserversDeep {
    if idx == 0 { o.t0 = t; };
    if idx == 1 { o.t1 = t; };
    if idx == 2 { o.t2 = t; };
    if idx == 3 { o.t3 = t; };
    if idx == 4 { o.t4 = t; };
    if idx == 5 { o.t5 = t; };
    if idx == 6 { o.t6 = t; };
    if idx == 7 { o.t7 = t; };
    return o;
}

fn ecs_erased_observers_set_kind(o: EcsErasedObserversDeep, idx: i32, k: i32) -> EcsErasedObserversDeep {
    if idx == 0 { o.k0 = k; };
    if idx == 1 { o.k1 = k; };
    if idx == 2 { o.k2 = k; };
    if idx == 3 { o.k3 = k; };
    if idx == 4 { o.k4 = k; };
    if idx == 5 { o.k5 = k; };
    if idx == 6 { o.k6 = k; };
    if idx == 7 { o.k7 = k; };
    return o;
}

fn ecs_erased_observers_add(o: EcsErasedObserversDeep, observer: EcsErasedEventObserverDeep) -> EcsErasedObserversDeep {
    if o.count >= ECS_OBSERVER_CAP_DEEP { return o; };
    let slot = o.count;
    let t = ecs_erased_observer_type_id(observer);
    let k = ecs_erased_observer_kind(observer);
    o = ecs_erased_observers_set_type(o, slot, t);
    o = ecs_erased_observers_set_kind(o, slot, k);
    o.count = o.count + 1;
    return o;
}

// trigger: fan-out to all observers whose type_id matches event.type_id; target < 0 means whole-world.
// Mirrors shallow `erased_observers_trigger_value` for a value built via the payload builder.
fn ecs_erased_observers_trigger(o: EcsErasedObserversDeep, value: EcsErasedEventValueDeep, target: i32) -> EcsErasedObserversDeep {
    let i: i32 = 0;
    while i < o.count {
        let t = ecs_erased_observers_type_at(o, i);
        if t == value.type_id {
            let k = ecs_erased_observers_kind_at(o, i);
            let result = ecs_erased_observer_run(k, value.payload, target);
            o.trigger_count = o.trigger_count + 1;
            o.last_event_type_id = value.type_id;
            o.last_entity_id = target;
            o.result_sum = o.result_sum + result;
        };
        i = i + 1;
    }
    return o;
}

// trigger_entity: target >= 0 (copied from entity id). "Entity" stand-in is just the target id.
fn ecs_erased_observers_trigger_entity(o: EcsErasedObserversDeep, value: EcsErasedEventValueDeep, target: i32) -> EcsErasedObserversDeep {
    return ecs_erased_observers_trigger(o, value, target);
}

fn ecs_erased_observers_clear(o: EcsErasedObserversDeep) -> EcsErasedObserversDeep {
    return ecs_erased_observers_new();
}
