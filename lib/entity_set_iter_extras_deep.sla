// Deepened Bevy ECS entity set iterator extras.
// ContainsEntity wrappers + UniqueEntityIter + collect_set.
// Fixed capacity 8. Shallow retained.

struct EcsEsiEqDeep {
    entity: i64,
    wrapper_kind: i32,
}

fn ecs_esi_direct(entity: i64) -> EcsEsiEqDeep {
    return EcsEsiEqDeep { entity: entity, wrapper_kind: 0 };
}
fn ecs_esi_ref(v: EcsEsiEqDeep) -> EcsEsiEqDeep {
    return EcsEsiEqDeep { entity: v.entity, wrapper_kind: 1 };
}
fn ecs_esi_mut(v: EcsEsiEqDeep) -> EcsEsiEqDeep {
    return EcsEsiEqDeep { entity: v.entity, wrapper_kind: 2 };
}
fn ecs_esi_box(v: EcsEsiEqDeep) -> EcsEsiEqDeep {
    return EcsEsiEqDeep { entity: v.entity, wrapper_kind: 3 };
}
fn ecs_esi_rc(v: EcsEsiEqDeep) -> EcsEsiEqDeep {
    return EcsEsiEqDeep { entity: v.entity, wrapper_kind: 4 };
}
fn ecs_esi_arc(v: EcsEsiEqDeep) -> EcsEsiEqDeep {
    return EcsEsiEqDeep { entity: v.entity, wrapper_kind: 5 };
}

fn ecs_esi_entity(v: EcsEsiEqDeep) -> i64 { return v.entity; }
fn ecs_esi_kind(v: EcsEsiEqDeep) -> i32 { return v.wrapper_kind; }

fn ecs_esi_same(a: EcsEsiEqDeep, b: EcsEsiEqDeep) -> bool {
    return a.entity == b.entity;
}

fn ecs_esi_cmp(a: EcsEsiEqDeep, b: EcsEsiEqDeep) -> i32 {
    if a.entity < b.entity { return 0 - 1; };
    if a.entity > b.entity { return 1; };
    return 0;
}

struct EcsEsiIterDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    front: i32,
    back: i32,
    trusted_unique: i32,
}

fn ecs_esi_iter_empty() -> EcsEsiIterDeep {
    return EcsEsiIterDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, front: 0, back: 0, trusted_unique: 1,
    };
}

fn ecs_esi_iter_rebuild(
    e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32, front: i32, back: i32, trusted_unique: i32
) -> EcsEsiIterDeep {
    return EcsEsiIterDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7,
        len: len, front: front, back: back, trusted_unique: trusted_unique,
    };
}

fn ecs_esi_iter_from4(a: i64, b: i64, c: i64, d: i64, n: i32) -> EcsEsiIterDeep {
    return ecs_esi_iter_rebuild(a, b, c, d, 0, 0, 0, 0, n, 0, n, 1);
}

fn ecs_esi_iter_remaining(it: EcsEsiIterDeep) -> i32 {
    if it.back < it.front { return 0; };
    return it.back - it.front;
}

fn ecs_esi_iter_is_empty(it: EcsEsiIterDeep) -> bool {
    return ecs_esi_iter_remaining(it) == 0;
}

fn ecs_esi_iter_at(it: EcsEsiIterDeep, idx: i32) -> i64 {
    if idx == 0 { return it.e0; };
    if idx == 1 { return it.e1; };
    if idx == 2 { return it.e2; };
    if idx == 3 { return it.e3; };
    if idx == 4 { return it.e4; };
    if idx == 5 { return it.e5; };
    if idx == 6 { return it.e6; };
    if idx == 7 { return it.e7; };
    return -1;
}

struct EcsEsiNextDeep {
    iter: EcsEsiIterDeep,
    has: bool,
    entity: i64,
}

fn ecs_esi_next_has(n: EcsEsiNextDeep) -> bool { return n.has; }
fn ecs_esi_next_entity(n: EcsEsiNextDeep) -> i64 { return n.entity; }
fn ecs_esi_next_iter(n: EcsEsiNextDeep) -> EcsEsiIterDeep { return n.iter; }

fn ecs_esi_iter_next(it: EcsEsiIterDeep) -> EcsEsiNextDeep {
    if it.front >= it.back {
        return EcsEsiNextDeep { iter: it, has: false, entity: -1 };
    };
    let entity = ecs_esi_iter_at(it, it.front);
    let it2 = ecs_esi_iter_rebuild(it.e0, it.e1, it.e2, it.e3, it.e4, it.e5, it.e6, it.e7, it.len, it.front + 1, it.back, it.trusted_unique);
    return EcsEsiNextDeep { iter: it2, has: true, entity: entity };
}

fn ecs_esi_iter_next_back(it: EcsEsiIterDeep) -> EcsEsiNextDeep {
    if it.front >= it.back {
        return EcsEsiNextDeep { iter: it, has: false, entity: -1 };
    };
    let idx = it.back - 1;
    let entity = ecs_esi_iter_at(it, idx);
    let it2 = ecs_esi_iter_rebuild(it.e0, it.e1, it.e2, it.e3, it.e4, it.e5, it.e6, it.e7, it.len, it.front, idx, it.trusted_unique);
    return EcsEsiNextDeep { iter: it2, has: true, entity: entity };
}

struct EcsEsiCollectDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    first_entity: i64,
    trusted_unique: i32,
}

fn ecs_esi_collect_len(c: EcsEsiCollectDeep) -> i32 { return c.len; }
fn ecs_esi_collect_first(c: EcsEsiCollectDeep) -> i64 { return c.first_entity; }
fn ecs_esi_collect_trusted(c: EcsEsiCollectDeep) -> i32 { return c.trusted_unique; }

fn ecs_esi_collect_at(c: EcsEsiCollectDeep, idx: i32) -> i64 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    return -1;
}

fn ecs_esi_collect_contains(c: EcsEsiCollectDeep, entity: i64) -> bool {
    if c.len >= 1 { if c.e0 == entity { return true; }; };
    if c.len >= 2 { if c.e1 == entity { return true; }; };
    if c.len >= 3 { if c.e2 == entity { return true; }; };
    if c.len >= 4 { if c.e3 == entity { return true; }; };
    if c.len >= 5 { if c.e4 == entity { return true; }; };
    if c.len >= 6 { if c.e5 == entity { return true; }; };
    if c.len >= 7 { if c.e6 == entity { return true; }; };
    if c.len >= 8 { if c.e7 == entity { return true; }; };
    return false;
}

fn ecs_esi_collect_set(it: EcsEsiIterDeep) -> EcsEsiCollectDeep {
    // collect remaining [front, back)
    let n = ecs_esi_iter_remaining(it);
    let e0 = 0;
    let e1 = 0;
    let e2 = 0;
    let e3 = 0;
    let first = -1;
    if n >= 1 {
        e0 = ecs_esi_iter_at(it, it.front);
        first = e0;
    };
    if n >= 2 { e1 = ecs_esi_iter_at(it, it.front + 1); };
    if n >= 3 { e2 = ecs_esi_iter_at(it, it.front + 2); };
    if n >= 4 { e3 = ecs_esi_iter_at(it, it.front + 3); };
    if n > 4 { n = 4; };
    return EcsEsiCollectDeep {
        e0: e0, e1: e1, e2: e2, e3: e3, e4: 0, e5: 0, e6: 0, e7: 0,
        len: n, first_entity: first, trusted_unique: it.trusted_unique,
    };
}

fn ecs_esi_from_entity_set_iter(it: EcsEsiIterDeep) -> EcsEsiCollectDeep {
    return ecs_esi_collect_set(it);
}
