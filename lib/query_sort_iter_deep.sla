// Deepened Bevy ECS QueryIter sort family.
// Mirrors src/query/iter.rs sort/sort_unstable/sort_by_key/sort_by_cached_key:
//   pre-consume gate, ascending selection sort, key cache flag, sorted cursor next.
// Shallow lib/query_sort_iter.sla retained.
// Fixed capacity: 8 entries.

struct EcsQsiDeep {
    len: i32,
    consumed: bool,
    e0: i32, k0: i32,
    e1: i32, k1: i32,
    e2: i32, k2: i32,
    e3: i32, k3: i32,
    e4: i32, k4: i32,
    e5: i32, k5: i32,
    e6: i32, k6: i32,
    e7: i32, k7: i32,
}

fn ecs_qsi_deep_new() -> EcsQsiDeep {
    return EcsQsiDeep {
        len: 0, consumed: false,
        e0: 0, k0: 0, e1: 0, k1: 0, e2: 0, k2: 0, e3: 0, k3: 0,
        e4: 0, k4: 0, e5: 0, k5: 0, e6: 0, k6: 0, e7: 0, k7: 0,
    };
}
fn ecs_qsi_deep_len(q: EcsQsiDeep) -> i32 { return q.len; }
fn ecs_qsi_deep_is_empty(q: EcsQsiDeep) -> bool {
    if q.len == 0 { return true; };
    return false;
}
fn ecs_qsi_deep_is_consumed(q: EcsQsiDeep) -> bool { return q.consumed; }

fn ecs_qsi_deep_push(q: EcsQsiDeep, entity: i32, key: i32) -> EcsQsiDeep {
    if q.consumed { return q; };
    if q.len >= 8 { return q; };
    let n = q.len;
    let e0 = q.e0; let k0 = q.k0; let e1 = q.e1; let k1 = q.k1;
    let e2 = q.e2; let k2 = q.k2; let e3 = q.e3; let k3 = q.k3;
    let e4 = q.e4; let k4 = q.k4; let e5 = q.e5; let k5 = q.k5;
    let e6 = q.e6; let k6 = q.k6; let e7 = q.e7; let k7 = q.k7;
    if n == 0 { e0 = entity; k0 = key; };
    if n == 1 { e1 = entity; k1 = key; };
    if n == 2 { e2 = entity; k2 = key; };
    if n == 3 { e3 = entity; k3 = key; };
    if n == 4 { e4 = entity; k4 = key; };
    if n == 5 { e5 = entity; k5 = key; };
    if n == 6 { e6 = entity; k6 = key; };
    if n == 7 { e7 = entity; k7 = key; };
    return EcsQsiDeep {
        len: n + 1, consumed: false,
        e0: e0, k0: k0, e1: e1, k1: k1, e2: e2, k2: k2, e3: e3, k3: k3,
        e4: e4, k4: k4, e5: e5, k5: k5, e6: e6, k6: k6, e7: e7, k7: k7,
    };
}

fn ecs_qsi_deep_mark_consumed(q: EcsQsiDeep) -> EcsQsiDeep {
    return EcsQsiDeep {
        len: q.len, consumed: true,
        e0: q.e0, k0: q.k0, e1: q.e1, k1: q.k1, e2: q.e2, k2: q.k2, e3: q.e3, k3: q.k3,
        e4: q.e4, k4: q.k4, e5: q.e5, k5: q.k5, e6: q.e6, k6: q.k6, e7: q.e7, k7: q.k7,
    };
}

// Sorted result
struct EcsQsortedDeep {
    ok: bool,
    cached: bool,
    len: i32,
    cursor: i32,
    e0: i32, k0: i32,
    e1: i32, k1: i32,
    e2: i32, k2: i32,
    e3: i32, k3: i32,
    e4: i32, k4: i32,
    e5: i32, k5: i32,
    e6: i32, k6: i32,
    e7: i32, k7: i32,
}

fn ecs_qsorted_ok(s: EcsQsortedDeep) -> bool { return s.ok; }
fn ecs_qsorted_cached(s: EcsQsortedDeep) -> bool { return s.cached; }
fn ecs_qsorted_len(s: EcsQsortedDeep) -> i32 { return s.len; }
fn ecs_qsorted_cursor(s: EcsQsortedDeep) -> i32 { return s.cursor; }

fn ecs_qsorted_entity_at(s: EcsQsortedDeep, idx: i32) -> i32 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return 0;
}
fn ecs_qsorted_key_at(s: EcsQsortedDeep, idx: i32) -> i32 {
    if idx == 0 { return s.k0; };
    if idx == 1 { return s.k1; };
    if idx == 2 { return s.k2; };
    if idx == 3 { return s.k3; };
    if idx == 4 { return s.k4; };
    if idx == 5 { return s.k5; };
    if idx == 6 { return s.k6; };
    if idx == 7 { return s.k7; };
    return 0;
}

fn ecs_qsorted_fail() -> EcsQsortedDeep {
    return EcsQsortedDeep {
        ok: false, cached: false, len: 0, cursor: 0,
        e0: 0, k0: 0, e1: 0, k1: 0, e2: 0, k2: 0, e3: 0, k3: 0,
        e4: 0, k4: 0, e5: 0, k5: 0, e6: 0, k6: 0, e7: 0, k7: 0,
    };
}

// ascending selection sort into sorted iter; descending if desc=true
fn ecs_qsi_deep_sort_impl(q: EcsQsiDeep, desc: bool, cached: bool) -> EcsQsortedDeep {
    if q.consumed { return ecs_qsorted_fail(); };
    let lenv = q.len;
    let e0 = q.e0; let k0 = q.k0; let e1 = q.e1; let k1 = q.k1;
    let e2 = q.e2; let k2 = q.k2; let e3 = q.e3; let k3 = q.k3;
    let e4 = q.e4; let k4 = q.k4; let e5 = q.e5; let k5 = q.k5;
    let e6 = q.e6; let k6 = q.k6; let e7 = q.e7; let k7 = q.k7;
    let used0 = false; let used1 = false; let used2 = false; let used3 = false;
    let used4 = false; let used5 = false; let used6 = false; let used7 = false;
    let se0 = 0; let sk0 = 0; let se1 = 0; let sk1 = 0;
    let se2 = 0; let sk2 = 0; let se3 = 0; let sk3 = 0;
    let se4 = 0; let sk4 = 0; let se5 = 0; let sk5 = 0;
    let se6 = 0; let sk6 = 0; let se7 = 0; let sk7 = 0;
    let placed = 0;
    while placed < lenv {
        let best_set = false;
        let best_e = 0;
        let best_k = 0;
        let best_i = -1;
        if lenv >= 1 { if used0 != true {
            best_set = true; best_e = e0; best_k = k0; best_i = 0;
        }; };
        if lenv >= 2 { if used1 != true {
            if best_set != true {
                best_set = true; best_e = e1; best_k = k1; best_i = 1;
            } else {
                let take = false;
                if desc {
                    if k1 > best_k { take = true; };
                } else {
                    if k1 < best_k { take = true; };
                };
                if take { best_e = e1; best_k = k1; best_i = 1; };
            };
        }; };
        if lenv >= 3 { if used2 != true {
            if best_set != true {
                best_set = true; best_e = e2; best_k = k2; best_i = 2;
            } else {
                let take = false;
                if desc {
                    if k2 > best_k { take = true; };
                } else {
                    if k2 < best_k { take = true; };
                };
                if take { best_e = e2; best_k = k2; best_i = 2; };
            };
        }; };
        if lenv >= 4 { if used3 != true {
            if best_set != true {
                best_set = true; best_e = e3; best_k = k3; best_i = 3;
            } else {
                let take = false;
                if desc {
                    if k3 > best_k { take = true; };
                } else {
                    if k3 < best_k { take = true; };
                };
                if take { best_e = e3; best_k = k3; best_i = 3; };
            };
        }; };
        if lenv >= 5 { if used4 != true {
            if best_set != true {
                best_set = true; best_e = e4; best_k = k4; best_i = 4;
            } else {
                let take = false;
                if desc {
                    if k4 > best_k { take = true; };
                } else {
                    if k4 < best_k { take = true; };
                };
                if take { best_e = e4; best_k = k4; best_i = 4; };
            };
        }; };
        if lenv >= 6 { if used5 != true {
            if best_set != true {
                best_set = true; best_e = e5; best_k = k5; best_i = 5;
            } else {
                let take = false;
                if desc {
                    if k5 > best_k { take = true; };
                } else {
                    if k5 < best_k { take = true; };
                };
                if take { best_e = e5; best_k = k5; best_i = 5; };
            };
        }; };
        if lenv >= 7 { if used6 != true {
            if best_set != true {
                best_set = true; best_e = e6; best_k = k6; best_i = 6;
            } else {
                let take = false;
                if desc {
                    if k6 > best_k { take = true; };
                } else {
                    if k6 < best_k { take = true; };
                };
                if take { best_e = e6; best_k = k6; best_i = 6; };
            };
        }; };
        if lenv >= 8 { if used7 != true {
            if best_set != true {
                best_set = true; best_e = e7; best_k = k7; best_i = 7;
            } else {
                let take = false;
                if desc {
                    if k7 > best_k { take = true; };
                } else {
                    if k7 < best_k { take = true; };
                };
                if take { best_e = e7; best_k = k7; best_i = 7; };
            };
        }; };
        if best_set != true { return ecs_qsorted_fail(); };
        if best_i == 0 { used0 = true; };
        if best_i == 1 { used1 = true; };
        if best_i == 2 { used2 = true; };
        if best_i == 3 { used3 = true; };
        if best_i == 4 { used4 = true; };
        if best_i == 5 { used5 = true; };
        if best_i == 6 { used6 = true; };
        if best_i == 7 { used7 = true; };
        if placed == 0 { se0 = best_e; sk0 = best_k; };
        if placed == 1 { se1 = best_e; sk1 = best_k; };
        if placed == 2 { se2 = best_e; sk2 = best_k; };
        if placed == 3 { se3 = best_e; sk3 = best_k; };
        if placed == 4 { se4 = best_e; sk4 = best_k; };
        if placed == 5 { se5 = best_e; sk5 = best_k; };
        if placed == 6 { se6 = best_e; sk6 = best_k; };
        if placed == 7 { se7 = best_e; sk7 = best_k; };
        placed = placed + 1;
    }
    return EcsQsortedDeep {
        ok: true, cached: cached, len: lenv, cursor: 0,
        e0: se0, k0: sk0, e1: se1, k1: sk1, e2: se2, k2: sk2, e3: se3, k3: sk3,
        e4: se4, k4: sk4, e5: se5, k5: sk5, e6: se6, k6: sk6, e7: se7, k7: sk7,
    };
}

fn ecs_qsi_deep_sort(q: EcsQsiDeep) -> EcsQsortedDeep {
    return ecs_qsi_deep_sort_impl(q, false, false);
}
fn ecs_qsi_deep_sort_unstable(q: EcsQsiDeep) -> EcsQsortedDeep {
    return ecs_qsi_deep_sort_impl(q, false, false);
}
fn ecs_qsi_deep_sort_desc(q: EcsQsiDeep) -> EcsQsortedDeep {
    return ecs_qsi_deep_sort_impl(q, true, false);
}
fn ecs_qsi_deep_sort_by_key(q: EcsQsiDeep) -> EcsQsortedDeep {
    return ecs_qsi_deep_sort_impl(q, false, false);
}
fn ecs_qsi_deep_sort_by_cached_key(q: EcsQsiDeep) -> EcsQsortedDeep {
    return ecs_qsi_deep_sort_impl(q, false, true);
}

struct EcsQsortedNextDeep {
    had: bool,
    entity: i32,
    key: i32,
    iter: EcsQsortedDeep,
}
fn ecs_qsorted_next_had(r: EcsQsortedNextDeep) -> bool { return r.had; }
fn ecs_qsorted_next_entity(r: EcsQsortedNextDeep) -> i32 { return r.entity; }
fn ecs_qsorted_next_key(r: EcsQsortedNextDeep) -> i32 { return r.key; }
fn ecs_qsorted_next_iter(r: EcsQsortedNextDeep) -> EcsQsortedDeep { return r.iter; }

fn ecs_qsorted_next(s: EcsQsortedDeep) -> EcsQsortedNextDeep {
    let ok = s.ok;
    let cached = s.cached;
    let lenv = s.len;
    let cur = s.cursor;
    let e0 = s.e0; let k0 = s.k0; let e1 = s.e1; let k1 = s.k1;
    let e2 = s.e2; let k2 = s.k2; let e3 = s.e3; let k3 = s.k3;
    let e4 = s.e4; let k4 = s.k4; let e5 = s.e5; let k5 = s.k5;
    let e6 = s.e6; let k6 = s.k6; let e7 = s.e7; let k7 = s.k7;
    let s_same = EcsQsortedDeep {
        ok: ok, cached: cached, len: lenv, cursor: cur,
        e0: e0, k0: k0, e1: e1, k1: k1, e2: e2, k2: k2, e3: e3, k3: k3,
        e4: e4, k4: k4, e5: e5, k5: k5, e6: e6, k6: k6, e7: e7, k7: k7,
    };
    if ok != true {
        return EcsQsortedNextDeep { had: false, entity: 0, key: 0, iter: s_same };
    };
    if cur >= lenv {
        return EcsQsortedNextDeep { had: false, entity: 0, key: 0, iter: s_same };
    };
    let ent = e0;
    let key = k0;
    if cur == 1 { ent = e1; key = k1; };
    if cur == 2 { ent = e2; key = k2; };
    if cur == 3 { ent = e3; key = k3; };
    if cur == 4 { ent = e4; key = k4; };
    if cur == 5 { ent = e5; key = k5; };
    if cur == 6 { ent = e6; key = k6; };
    if cur == 7 { ent = e7; key = k7; };
    let s2 = EcsQsortedDeep {
        ok: ok, cached: cached, len: lenv, cursor: cur + 1,
        e0: e0, k0: k0, e1: e1, k1: k1, e2: e2, k2: k2, e3: e3, k3: k3,
        e4: e4, k4: k4, e5: e5, k5: k5, e6: e6, k6: k6, e7: e7, k7: k7,
    };
    return EcsQsortedNextDeep { had: true, entity: ent, key: key, iter: s2 };
}
