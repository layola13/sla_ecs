// Deepened Bevy ECS EntityRefExcept / EntityMutExcept.
// Mirrors src/world/entity_access/except.rs:
//   EntityRefExcept: get/get_ref/get_by_id/contains/get_change_ticks/into_filtered
//   EntityMutExcept: get/get_mut/reborrow/into_readonly/as_readonly/into_filtered
//   bundle_contains_component exclusion set (B)
//   PartialEq/Ord by entity id
// Fixed: 4 entity component slots + 4 excluded ids. Shallow lib/entity_access_except.sla retained.

// Exclusion bundle B: up to 4 component ids
struct EcsExceptBundleDeep {
    e0: i32, e1: i32, e2: i32, e3: i32,
    n: i32,
}

fn ecs_except_bundle_deep_new() -> EcsExceptBundleDeep {
    return EcsExceptBundleDeep { e0: -1, e1: -1, e2: -1, e3: -1, n: 0 };
}

fn ecs_except_bundle_deep_len(b: EcsExceptBundleDeep) -> i32 { return b.n; }

fn ecs_except_bundle_deep_add(b: EcsExceptBundleDeep, id: i32) -> EcsExceptBundleDeep {
    if b.n >= 4 { return b; };
    if b.n == 0 {
        return EcsExceptBundleDeep { e0: id, e1: b.e1, e2: b.e2, e3: b.e3, n: 1 };
    };
    if b.n == 1 {
        return EcsExceptBundleDeep { e0: b.e0, e1: id, e2: b.e2, e3: b.e3, n: 2 };
    };
    if b.n == 2 {
        return EcsExceptBundleDeep { e0: b.e0, e1: b.e1, e2: id, e3: b.e3, n: 3 };
    };
    return EcsExceptBundleDeep { e0: b.e0, e1: b.e1, e2: b.e2, e3: id, n: 4 };
}

fn ecs_except_bundle_contains(b: EcsExceptBundleDeep, id: i32) -> bool {
    if b.n >= 1 {
        if b.e0 == id { return true; };
    };
    if b.n >= 2 {
        if b.e1 == id { return true; };
    };
    if b.n >= 3 {
        if b.e2 == id { return true; };
    };
    if b.n >= 4 {
        if b.e3 == id { return true; };
    };
    return false;
}

// Entity component storage
struct EcsExceptEntityDeep {
    entity: i64,
    spawned_by: i64,
    spawn_tick: i64,
    c0: i32, v0: i64, t0: i64,
    c1: i32, v1: i64, t1: i64,
    c2: i32, v2: i64, t2: i64,
    c3: i32, v3: i64, t3: i64,
    len: i32,
}

fn ecs_except_entity_deep_new(entity: i64) -> EcsExceptEntityDeep {
    return EcsExceptEntityDeep {
        entity: entity, spawned_by: 0, spawn_tick: 0,
        c0: -1, v0: 0, t0: 0, c1: -1, v1: 0, t1: 0,
        c2: -1, v2: 0, t2: 0, c3: -1, v3: 0, t3: 0, len: 0,
    };
}

fn ecs_except_entity_deep_with_spawn(e: EcsExceptEntityDeep, spawned_by: i64, spawn_tick: i64) -> EcsExceptEntityDeep {
    return EcsExceptEntityDeep {
        entity: e.entity, spawned_by: spawned_by, spawn_tick: spawn_tick,
        c0: e.c0, v0: e.v0, t0: e.t0, c1: e.c1, v1: e.v1, t1: e.t1,
        c2: e.c2, v2: e.v2, t2: e.t2, c3: e.c3, v3: e.v3, t3: e.t3, len: e.len,
    };
}

fn ecs_except_entity_deep_id(e: EcsExceptEntityDeep) -> i64 { return e.entity; }
fn ecs_except_entity_deep_spawned_by(e: EcsExceptEntityDeep) -> i64 { return e.spawned_by; }
fn ecs_except_entity_deep_spawn_tick(e: EcsExceptEntityDeep) -> i64 { return e.spawn_tick; }

fn ecs_except_entity_deep_insert(e: EcsExceptEntityDeep, cid: i32, value: i64, tick: i64) -> EcsExceptEntityDeep {
    if e.len >= 1 {
        if e.c0 == cid {
            return EcsExceptEntityDeep {
                entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
                c0: e.c0, v0: value, t0: tick, c1: e.c1, v1: e.v1, t1: e.t1,
                c2: e.c2, v2: e.v2, t2: e.t2, c3: e.c3, v3: e.v3, t3: e.t3, len: e.len,
            };
        };
    };
    if e.len >= 2 {
        if e.c1 == cid {
            return EcsExceptEntityDeep {
                entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
                c0: e.c0, v0: e.v0, t0: e.t0, c1: e.c1, v1: value, t1: tick,
                c2: e.c2, v2: e.v2, t2: e.t2, c3: e.c3, v3: e.v3, t3: e.t3, len: e.len,
            };
        };
    };
    if e.len >= 3 {
        if e.c2 == cid {
            return EcsExceptEntityDeep {
                entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
                c0: e.c0, v0: e.v0, t0: e.t0, c1: e.c1, v1: e.v1, t1: e.t1,
                c2: e.c2, v2: value, t2: tick, c3: e.c3, v3: e.v3, t3: e.t3, len: e.len,
            };
        };
    };
    if e.len >= 4 {
        if e.c3 == cid {
            return EcsExceptEntityDeep {
                entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
                c0: e.c0, v0: e.v0, t0: e.t0, c1: e.c1, v1: e.v1, t1: e.t1,
                c2: e.c2, v2: e.v2, t2: e.t2, c3: e.c3, v3: value, t3: tick, len: e.len,
            };
        };
    };
    if e.len == 0 {
        return EcsExceptEntityDeep {
            entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
            c0: cid, v0: value, t0: tick, c1: e.c1, v1: e.v1, t1: e.t1,
            c2: e.c2, v2: e.v2, t2: e.t2, c3: e.c3, v3: e.v3, t3: e.t3, len: 1,
        };
    };
    if e.len == 1 {
        return EcsExceptEntityDeep {
            entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
            c0: e.c0, v0: e.v0, t0: e.t0, c1: cid, v1: value, t1: tick,
            c2: e.c2, v2: e.v2, t2: e.t2, c3: e.c3, v3: e.v3, t3: e.t3, len: 2,
        };
    };
    if e.len == 2 {
        return EcsExceptEntityDeep {
            entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
            c0: e.c0, v0: e.v0, t0: e.t0, c1: e.c1, v1: e.v1, t1: e.t1,
            c2: cid, v2: value, t2: tick, c3: e.c3, v3: e.v3, t3: e.t3, len: 3,
        };
    };
    if e.len == 3 {
        return EcsExceptEntityDeep {
            entity: e.entity, spawned_by: e.spawned_by, spawn_tick: e.spawn_tick,
            c0: e.c0, v0: e.v0, t0: e.t0, c1: e.c1, v1: e.v1, t1: e.t1,
            c2: e.c2, v2: e.v2, t2: e.t2, c3: cid, v3: value, t3: tick, len: 4,
        };
    };
    return e;
}

struct EcsExceptGet {
    found: bool,
    value: i64,
    tick: i64,
}

fn ecs_except_get_found(r: EcsExceptGet) -> bool { return r.found; }
fn ecs_except_get_value(r: EcsExceptGet) -> i64 { return r.value; }
fn ecs_except_get_tick(r: EcsExceptGet) -> i64 { return r.tick; }

fn ecs_except_entity_deep_raw_get(e: EcsExceptEntityDeep, cid: i32) -> EcsExceptGet {
    if e.len >= 1 {
        if e.c0 == cid { return EcsExceptGet { found: true, value: e.v0, tick: e.t0 }; };
    };
    if e.len >= 2 {
        if e.c1 == cid { return EcsExceptGet { found: true, value: e.v1, tick: e.t1 }; };
    };
    if e.len >= 3 {
        if e.c2 == cid { return EcsExceptGet { found: true, value: e.v2, tick: e.t2 }; };
    };
    if e.len >= 4 {
        if e.c3 == cid { return EcsExceptGet { found: true, value: e.v3, tick: e.t3 }; };
    };
    return EcsExceptGet { found: false, value: 0, tick: 0 };
}

fn ecs_except_entity_deep_contains(e: EcsExceptEntityDeep, cid: i32) -> bool {
    let g = ecs_except_entity_deep_raw_get(e, cid);
    return ecs_except_get_found(g);
}

// EntityRefExcept
struct EcsEntityRefExceptDeep {
    entity: EcsExceptEntityDeep,
    excl: EcsExceptBundleDeep,
}

fn ecs_entity_ref_except_deep_new(entity: EcsExceptEntityDeep, excl: EcsExceptBundleDeep) -> EcsEntityRefExceptDeep {
    return EcsEntityRefExceptDeep { entity: entity, excl: excl };
}

fn ecs_entity_ref_except_deep_id(v: EcsEntityRefExceptDeep) -> i64 {
    return ecs_except_entity_deep_id(v.entity);
}
fn ecs_entity_ref_except_deep_spawned_by(v: EcsEntityRefExceptDeep) -> i64 {
    return ecs_except_entity_deep_spawned_by(v.entity);
}
fn ecs_entity_ref_except_deep_spawn_tick(v: EcsEntityRefExceptDeep) -> i64 {
    return ecs_except_entity_deep_spawn_tick(v.entity);
}

// contains: storage only (not exclusion-gated in Bevy)
fn ecs_entity_ref_except_deep_contains(v: EcsEntityRefExceptDeep, cid: i32) -> bool {
    return ecs_except_entity_deep_contains(v.entity, cid);
}
fn ecs_entity_ref_except_deep_contains_id(v: EcsEntityRefExceptDeep, cid: i32) -> bool {
    return ecs_entity_ref_except_deep_contains(v, cid);
}
fn ecs_entity_ref_except_deep_contains_type_id(v: EcsEntityRefExceptDeep, tid: i32) -> bool {
    return ecs_entity_ref_except_deep_contains(v, tid);
}

// get: None if excluded or missing
fn ecs_entity_ref_except_deep_get(v: EcsEntityRefExceptDeep, cid: i32) -> EcsExceptGet {
    if ecs_except_bundle_contains(v.excl, cid) {
        return EcsExceptGet { found: false, value: 0, tick: 0 };
    };
    return ecs_except_entity_deep_raw_get(v.entity, cid);
}

fn ecs_entity_ref_except_deep_get_ref(v: EcsEntityRefExceptDeep, cid: i32) -> EcsExceptGet {
    return ecs_entity_ref_except_deep_get(v, cid);
}

fn ecs_entity_ref_except_deep_get_by_id(v: EcsEntityRefExceptDeep, cid: i32) -> EcsExceptGet {
    return ecs_entity_ref_except_deep_get(v, cid);
}

fn ecs_entity_ref_except_deep_get_change_ticks(v: EcsEntityRefExceptDeep, cid: i32) -> EcsExceptGet {
    return ecs_entity_ref_except_deep_get(v, cid);
}

// into_filtered: model as FilteredEntityRef with inverted access (all except B)
// access read_bits: ids present and not excluded — simplified flag: excluded mask
struct EcsExceptFilteredDeep {
    entity: EcsExceptEntityDeep,
    excl: EcsExceptBundleDeep,
    writable: bool,
}

fn ecs_except_filtered_deep_id(f: EcsExceptFilteredDeep) -> i64 {
    return ecs_except_entity_deep_id(f.entity);
}
fn ecs_except_filtered_deep_writable(f: EcsExceptFilteredDeep) -> bool { return f.writable; }

fn ecs_entity_ref_except_deep_into_filtered(v: EcsEntityRefExceptDeep) -> EcsExceptFilteredDeep {
    return EcsExceptFilteredDeep { entity: v.entity, excl: v.excl, writable: false };
}

fn ecs_except_filtered_deep_get(f: EcsExceptFilteredDeep, cid: i32) -> EcsExceptGet {
    if ecs_except_bundle_contains(f.excl, cid) {
        return EcsExceptGet { found: false, value: 0, tick: 0 };
    };
    return ecs_except_entity_deep_raw_get(f.entity, cid);
}

fn ecs_entity_ref_except_deep_eq(a: EcsEntityRefExceptDeep, b: EcsEntityRefExceptDeep) -> bool {
    if ecs_entity_ref_except_deep_id(a) == ecs_entity_ref_except_deep_id(b) { return true; };
    return false;
}

fn ecs_entity_ref_except_deep_cmp(a: EcsEntityRefExceptDeep, b: EcsEntityRefExceptDeep) -> i32 {
    let aid = ecs_entity_ref_except_deep_id(a);
    let bid = ecs_entity_ref_except_deep_id(b);
    if aid < bid { return -1; };
    if aid > bid { return 1; };
    return 0;
}

// EntityMutExcept
struct EcsEntityMutExceptDeep {
    entity: EcsExceptEntityDeep,
    excl: EcsExceptBundleDeep,
}

fn ecs_entity_mut_except_deep_new(entity: EcsExceptEntityDeep, excl: EcsExceptBundleDeep) -> EcsEntityMutExceptDeep {
    return EcsEntityMutExceptDeep { entity: entity, excl: excl };
}

fn ecs_entity_mut_except_deep_id(v: EcsEntityMutExceptDeep) -> i64 {
    return ecs_except_entity_deep_id(v.entity);
}

fn ecs_entity_mut_except_deep_contains(v: EcsEntityMutExceptDeep, cid: i32) -> bool {
    return ecs_except_entity_deep_contains(v.entity, cid);
}

fn ecs_entity_mut_except_deep_get(v: EcsEntityMutExceptDeep, cid: i32) -> EcsExceptGet {
    if ecs_except_bundle_contains(v.excl, cid) {
        return EcsExceptGet { found: false, value: 0, tick: 0 };
    };
    return ecs_except_entity_deep_raw_get(v.entity, cid);
}

fn ecs_entity_mut_except_deep_get_mut(v: EcsEntityMutExceptDeep, cid: i32) -> EcsExceptGet {
    return ecs_entity_mut_except_deep_get(v, cid);
}

struct EcsExceptMutSet {
    view: EcsEntityMutExceptDeep,
    ok: bool,
}

fn ecs_except_mut_set_view(r: EcsExceptMutSet) -> EcsEntityMutExceptDeep { return r.view; }
fn ecs_except_mut_set_ok(r: EcsExceptMutSet) -> bool { return r.ok; }

fn ecs_entity_mut_except_deep_set(v: EcsEntityMutExceptDeep, cid: i32, value: i64, tick: i64) -> EcsExceptMutSet {
    if ecs_except_bundle_contains(v.excl, cid) {
        return EcsExceptMutSet { view: v, ok: false };
    };
    if ecs_except_entity_deep_contains(v.entity, cid) != true {
        return EcsExceptMutSet { view: v, ok: false };
    };
    let e2 = ecs_except_entity_deep_insert(v.entity, cid, value, tick);
    let v2 = EcsEntityMutExceptDeep { entity: e2, excl: v.excl };
    return EcsExceptMutSet { view: v2, ok: true };
}

fn ecs_entity_mut_except_deep_reborrow(v: EcsEntityMutExceptDeep) -> EcsEntityMutExceptDeep {
    return EcsEntityMutExceptDeep { entity: v.entity, excl: v.excl };
}

fn ecs_entity_mut_except_deep_into_readonly(v: EcsEntityMutExceptDeep) -> EcsEntityRefExceptDeep {
    return EcsEntityRefExceptDeep { entity: v.entity, excl: v.excl };
}

fn ecs_entity_mut_except_deep_as_readonly(v: EcsEntityMutExceptDeep) -> EcsEntityRefExceptDeep {
    return ecs_entity_mut_except_deep_into_readonly(v);
}

fn ecs_entity_mut_except_deep_into_filtered(v: EcsEntityMutExceptDeep) -> EcsExceptFilteredDeep {
    return EcsExceptFilteredDeep { entity: v.entity, excl: v.excl, writable: true };
}

fn ecs_entity_mut_except_deep_eq(a: EcsEntityMutExceptDeep, b: EcsEntityMutExceptDeep) -> bool {
    if ecs_entity_mut_except_deep_id(a) == ecs_entity_mut_except_deep_id(b) { return true; };
    return false;
}

fn ecs_entity_mut_except_deep_cmp(a: EcsEntityMutExceptDeep, b: EcsEntityMutExceptDeep) -> i32 {
    let aid = ecs_entity_mut_except_deep_id(a);
    let bid = ecs_entity_mut_except_deep_id(b);
    if aid < bid { return -1; };
    if aid > bid { return 1; };
    return 0;
}
