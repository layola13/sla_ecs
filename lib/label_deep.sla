// Deepened Bevy ECS label surface.
// Mirrors src/label.rs: DynEq / DynHash object-safe equality+hash, define_label!
// style intern() via Interner, dyn_clone, Interned label identity.
// Shallow lib/label.sla trait wrappers retained.

// Type tags for dyn downcast simulation
const ECS_LB_TYPE_A: i32 = 1;
const ECS_LB_TYPE_B: i32 = 2;
const ECS_LB_TYPE_C: i32 = 3;

// === DynEq / DynHash value ===
struct EcsDynLabelDeep {
    type_id: i32,
    value_id: i64,
}

fn ecs_lb_dyn_new(type_id: i32, value_id: i64) -> EcsDynLabelDeep {
    return EcsDynLabelDeep { type_id: type_id, value_id: value_id };
}

fn ecs_lb_dyn_type(d: EcsDynLabelDeep) -> i32 { return d.type_id; }
fn ecs_lb_dyn_value(d: EcsDynLabelDeep) -> i64 { return d.value_id; }

// DynEq: only equal if same type and value
fn ecs_lb_dyn_eq(a: EcsDynLabelDeep, b: EcsDynLabelDeep) -> bool {
    if a.type_id != b.type_id { return false; };
    return a.value_id == b.value_id;
}

// DynHash: hash value then type_id (Bevy hashes T then TypeId)
fn ecs_lb_dyn_hash(d: EcsDynLabelDeep) -> i64 {
    return (d.value_id * 1315423911) + (d.type_id as i64);
}

// dyn_clone: copy
fn ecs_lb_dyn_clone(d: EcsDynLabelDeep) -> EcsDynLabelDeep {
    return EcsDynLabelDeep { type_id: d.type_id, value_id: d.value_id };
}

// === Label interner (per label-trait interner) ===
const ECS_LB_CAP: i32 = 16;

struct EcsLabelInternerDeep {
    interner_id: i64,
    // stored type_id/value_id pairs
    t0: i32, v0: i64, t1: i32, v1: i64, t2: i32, v2: i64, t3: i32, v3: i64,
    t4: i32, v4: i64, t5: i32, v5: i64, t6: i32, v6: i64, t7: i32, v7: i64,
    t8: i32, v8: i64, t9: i32, v9: i64, t10: i32, v10: i64, t11: i32, v11: i64,
    t12: i32, v12: i64, t13: i32, v13: i64, t14: i32, v14: i64, t15: i32, v15: i64,
    len: i32,
}

fn ecs_lb_interner_new(interner_id: i64) -> EcsLabelInternerDeep {
    return EcsLabelInternerDeep {
        interner_id: interner_id,
        t0: 0, v0: 0, t1: 0, v1: 0, t2: 0, v2: 0, t3: 0, v3: 0,
        t4: 0, v4: 0, t5: 0, v5: 0, t6: 0, v6: 0, t7: 0, v7: 0,
        t8: 0, v8: 0, t9: 0, v9: 0, t10: 0, v10: 0, t11: 0, v11: 0,
        t12: 0, v12: 0, t13: 0, v13: 0, t14: 0, v14: 0, t15: 0, v15: 0,
        len: 0,
    };
}

fn ecs_lb_interner_len(i: EcsLabelInternerDeep) -> i32 { return i.len; }
fn ecs_lb_interner_id(i: EcsLabelInternerDeep) -> i64 { return i.interner_id; }

fn ecs_lb_get_type(i: EcsLabelInternerDeep, s: i32) -> i32 {
    if s == 0 { return i.t0; };
    if s == 1 { return i.t1; };
    if s == 2 { return i.t2; };
    if s == 3 { return i.t3; };
    if s == 4 { return i.t4; };
    if s == 5 { return i.t5; };
    if s == 6 { return i.t6; };
    if s == 7 { return i.t7; };
    if s == 8 { return i.t8; };
    if s == 9 { return i.t9; };
    if s == 10 { return i.t10; };
    if s == 11 { return i.t11; };
    if s == 12 { return i.t12; };
    if s == 13 { return i.t13; };
    if s == 14 { return i.t14; };
    if s == 15 { return i.t15; };
    return 0;
}

fn ecs_lb_get_value(i: EcsLabelInternerDeep, s: i32) -> i64 {
    if s == 0 { return i.v0; };
    if s == 1 { return i.v1; };
    if s == 2 { return i.v2; };
    if s == 3 { return i.v3; };
    if s == 4 { return i.v4; };
    if s == 5 { return i.v5; };
    if s == 6 { return i.v6; };
    if s == 7 { return i.v7; };
    if s == 8 { return i.v8; };
    if s == 9 { return i.v9; };
    if s == 10 { return i.v10; };
    if s == 11 { return i.v11; };
    if s == 12 { return i.v12; };
    if s == 13 { return i.v13; };
    if s == 14 { return i.v14; };
    if s == 15 { return i.v15; };
    return 0;
}

fn ecs_lb_set_slot(i: EcsLabelInternerDeep, s: i32, type_id: i32, value_id: i64) -> EcsLabelInternerDeep {
    if s == 0 { i.t0 = type_id; i.v0 = value_id; };
    if s == 1 { i.t1 = type_id; i.v1 = value_id; };
    if s == 2 { i.t2 = type_id; i.v2 = value_id; };
    if s == 3 { i.t3 = type_id; i.v3 = value_id; };
    if s == 4 { i.t4 = type_id; i.v4 = value_id; };
    if s == 5 { i.t5 = type_id; i.v5 = value_id; };
    if s == 6 { i.t6 = type_id; i.v6 = value_id; };
    if s == 7 { i.t7 = type_id; i.v7 = value_id; };
    if s == 8 { i.t8 = type_id; i.v8 = value_id; };
    if s == 9 { i.t9 = type_id; i.v9 = value_id; };
    if s == 10 { i.t10 = type_id; i.v10 = value_id; };
    if s == 11 { i.t11 = type_id; i.v11 = value_id; };
    if s == 12 { i.t12 = type_id; i.v12 = value_id; };
    if s == 13 { i.t13 = type_id; i.v13 = value_id; };
    if s == 14 { i.t14 = type_id; i.v14 = value_id; };
    if s == 15 { i.t15 = type_id; i.v15 = value_id; };
    return i;
}

fn ecs_lb_find(i: EcsLabelInternerDeep, type_id: i32, value_id: i64) -> i32 {
    let s: i32 = 0;
    while s < i.len {
        if ecs_lb_get_type(i, s) == type_id {
            if ecs_lb_get_value(i, s) == value_id { return s; };
        };
        s = s + 1;
    }
    return -1;
}

// Interned label handle (pointer identity = interner + slot)
struct EcsInternedLabelDeep {
    interner_id: i64,
    slot: i32,
    type_id: i32,
    value_id: i64,
}

fn ecs_lb_interned_eq(a: EcsInternedLabelDeep, b: EcsInternedLabelDeep) -> bool {
    if a.interner_id != b.interner_id { return false; };
    return a.slot == b.slot;
}

fn ecs_lb_interned_type(l: EcsInternedLabelDeep) -> i32 { return l.type_id; }
fn ecs_lb_interned_value(l: EcsInternedLabelDeep) -> i64 { return l.value_id; }
fn ecs_lb_interned_slot(l: EcsInternedLabelDeep) -> i32 { return l.slot; }
fn ecs_lb_interned_interner(l: EcsInternedLabelDeep) -> i64 { return l.interner_id; }

// Label::intern
fn ecs_lb_intern(i: EcsLabelInternerDeep, label: EcsDynLabelDeep) -> (EcsLabelInternerDeep, EcsInternedLabelDeep) {
    let found = ecs_lb_find(i, label.type_id, label.value_id);
    if found >= 0 {
        let h = EcsInternedLabelDeep {
            interner_id: i.interner_id,
            slot: found,
            type_id: label.type_id,
            value_id: label.value_id,
        };
        return (i, h);
    };
    if i.len >= ECS_LB_CAP {
        // full: return last
        let h = EcsInternedLabelDeep {
            interner_id: i.interner_id,
            slot: i.len - 1,
            type_id: label.type_id,
            value_id: label.value_id,
        };
        return (i, h);
    };
    let slot = i.len;
    i = ecs_lb_set_slot(i, slot, label.type_id, label.value_id);
    i.len = i.len + 1;
    let h = EcsInternedLabelDeep {
        interner_id: i.interner_id,
        slot: slot,
        type_id: label.type_id,
        value_id: label.value_id,
    };
    return (i, h);
}

// Interned forwards dyn methods to stored identity
fn ecs_lb_interned_dyn_eq(a: EcsInternedLabelDeep, b: EcsInternedLabelDeep) -> bool {
    // Interned equality is pointer-based, not dyn value
    return ecs_lb_interned_eq(a, b);
}

fn ecs_lb_interned_dyn_hash(a: EcsInternedLabelDeep) -> i64 {
    return (a.interner_id * 1000003) + (a.slot as i64);
}

// ScheduleLabel / SystemSet convenience constructors
fn ecs_lb_schedule_label(value_id: i64) -> EcsDynLabelDeep {
    return ecs_lb_dyn_new(ECS_LB_TYPE_A, value_id);
}

fn ecs_lb_system_set(value_id: i64) -> EcsDynLabelDeep {
    return ecs_lb_dyn_new(ECS_LB_TYPE_B, value_id);
}

// different concrete types with same value_id are not dyn_eq
fn ecs_lb_cross_type_eq(a_val: i64, b_val: i64) -> bool {
    let a = ecs_lb_dyn_new(ECS_LB_TYPE_A, a_val);
    let b = ecs_lb_dyn_new(ECS_LB_TYPE_B, b_val);
    return ecs_lb_dyn_eq(a, b);
}
