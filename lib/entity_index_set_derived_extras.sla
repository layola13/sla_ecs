// Bevy ECS EntityIndexSet derived/wrapper surface extras.
// Complements the index_set extras batches with constructor/default/clone/debug,
// explicit Extend variants, array-style construction, PartialEq<IndexSet>, and
// iterator size-hint/debug marker behavior.

struct EcsEis4Set { items: Vec<i64>, capacity_hint: i64, constructed_kind: i32 }
struct EcsEis4Iter { items: Vec<i64>, front: i64, back: i64, debug_kind: i32, trusted_unique: i32 }
struct EcsEis4SizeHint { lower: i64, upper: i64 }
struct EcsEis4InsertResult { inserted: i32, set: EcsEis4Set }
struct EcsEis4NextResult { iter: EcsEis4Iter, has: i32, value: i64 }

fn ecs_eis4_new() -> EcsEis4Set {
    return EcsEis4Set { items: Vec::new(), capacity_hint: 0, constructed_kind: 1 };
}

fn ecs_eis4_default() -> EcsEis4Set {
    return EcsEis4Set { items: Vec::new(), capacity_hint: 0, constructed_kind: 2 };
}

fn ecs_eis4_with_capacity(capacity: i64) -> EcsEis4Set {
    let hint = capacity;
    if hint < 0 { hint = 0; };
    return EcsEis4Set { items: Vec::new(), capacity_hint: hint, constructed_kind: 3 };
}

fn ecs_eis4_clone(set: EcsEis4Set) -> EcsEis4Set {
    return EcsEis4Set { items: set.items, capacity_hint: set.capacity_hint, constructed_kind: 4 };
}

fn ecs_eis4_debug_kind(set: EcsEis4Set) -> i32 {
    return set.constructed_kind;
}

fn ecs_eis4_len(set: EcsEis4Set) -> i64 { return len(set.items) as i64; }

fn ecs_eis4_contains(set: EcsEis4Set, value: i64) -> bool {
    let found = false;
    let index: i64 = 0;
    while index < (len(set.items) as i64) {
        if set.items[index] == value { found = true; };
        index = index + 1;
    }
    return found;
}

fn ecs_eis4_insert(set: EcsEis4Set, value: i64) -> EcsEis4InsertResult {
    let duplicate = false;
    let index: i64 = 0;
    while index < (len(set.items) as i64) {
        if set.items[index] == value { duplicate = true; };
        index = index + 1;
    }
    if duplicate { return EcsEis4InsertResult { inserted: 0, set: set }; };
    set.items.push(value);
    return EcsEis4InsertResult { inserted: 1, set: set };
}

fn ecs_eis4_extend_owned(set: EcsEis4Set, values: Vec<i64>) -> EcsEis4Set {
    let index: i64 = 0;
    while index < (len(values) as i64) {
        let inserted = ecs_eis4_insert(set, values[index]);
        set = inserted.set;
        index = index + 1;
    }
    return set;
}

fn ecs_eis4_extend_refs(set: EcsEis4Set, values: Vec<i64>) -> EcsEis4Set {
    return ecs_eis4_extend_owned(set, values);
}

fn ecs_eis4_from_iter(values: Vec<i64>) -> EcsEis4Set {
    let set = ecs_eis4_new();
    return ecs_eis4_extend_owned(set, values);
}

fn ecs_eis4_from_array4(a: i64, b: i64, c: i64, d: i64) -> EcsEis4Set {
    let values: Vec<i64> = Vec::new();
    values.push(a);
    values.push(b);
    values.push(c);
    values.push(d);
    let set = ecs_eis4_extend_owned(ecs_eis4_new(), values);
    return EcsEis4Set { items: set.items, capacity_hint: 4, constructed_kind: 5 };
}

fn ecs_eis4_eq_inner(set: EcsEis4Set, inner_values: Vec<i64>) -> bool {
    let inner = ecs_eis4_from_iter(inner_values);
    if len(set.items) != len(inner.items) { return false; };
    let all_found = true;
    let index: i64 = 0;
    while index < (len(set.items) as i64) {
        let found = false;
        let inner_index: i64 = 0;
        while inner_index < (len(inner.items) as i64) {
            if inner.items[inner_index] == set.items[index] { found = true; };
            inner_index = inner_index + 1;
        }
        if found != true { all_found = false; };
        index = index + 1;
    }
    return all_found;
}

fn ecs_eis4_iter(set: EcsEis4Set) -> EcsEis4Iter {
    let count = len(set.items) as i64;
    return EcsEis4Iter { items: set.items, front: 0, back: count, debug_kind: 10, trusted_unique: 1 };
}

fn ecs_eis4_into_iter(set: EcsEis4Set) -> EcsEis4Iter {
    let count = len(set.items) as i64;
    return EcsEis4Iter { items: set.items, front: 0, back: count, debug_kind: 20, trusted_unique: 1 };
}

fn ecs_eis4_drain(set: EcsEis4Set, start: i64, end: i64) -> EcsEis4Iter {
    let drained: Vec<i64> = Vec::new();
    let range_start = start;
    let range_end = end;
    if range_start < 0 { range_start = 0; };
    if range_end > (len(set.items) as i64) { range_end = len(set.items) as i64; };
    if range_end < range_start { range_end = range_start + 0; };
    let index = range_start + 0;
    while index < range_end {
        drained.push(set.items[index]);
        index = index + 1;
    }
    let drained_count = len(drained) as i64;
    return EcsEis4Iter { items: drained, front: 0, back: drained_count, debug_kind: 30, trusted_unique: 1 };
}

fn ecs_eis4_iter_remaining(iter: EcsEis4Iter) -> i64 {
    let remaining = iter.back - iter.front;
    if remaining < 0 { return 0; };
    return remaining;
}

fn ecs_eis4_size_hint(iter: EcsEis4Iter) -> EcsEis4SizeHint {
    let remaining = ecs_eis4_iter_remaining(iter);
    return EcsEis4SizeHint { lower: remaining, upper: remaining };
}

fn ecs_eis4_iter_debug_kind(iter: EcsEis4Iter) -> i32 {
    return iter.debug_kind;
}

fn ecs_eis4_iter_next(iter: EcsEis4Iter) -> EcsEis4NextResult {
    if iter.front >= iter.back { return EcsEis4NextResult { iter: iter, has: 0, value: -1 }; };
    let value = iter.items[iter.front];
    iter.front = iter.front + 1;
    return EcsEis4NextResult { iter: iter, has: 1, value: value };
}

fn ecs_eis4_iter_next_back(iter: EcsEis4Iter) -> EcsEis4NextResult {
    if iter.front >= iter.back { return EcsEis4NextResult { iter: iter, has: 0, value: -1 }; };
    iter.back = iter.back - 1;
    let value = iter.items[iter.back];
    return EcsEis4NextResult { iter: iter, has: 1, value: value };
}
