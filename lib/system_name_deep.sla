// Deepened Bevy ECS SystemName surface.
// Mirrors src/system/system_name.rs:
//   SystemName(DebugName) — Display/Debug stand-in, name()
//   SystemParam: State=(), init_state no-op, init_access no component access,
//     get_param -> SystemName(system_meta.name), ReadOnlySystemParam
//   ExclusiveSystemParam: same empty state, get_param from SystemMeta
//   with_name on SystemMeta / IntoSystem stand-in for closures
// Shallow lib/system_name.sla retained.

// === DebugName ===
struct EcsSnDebugNameDeep {
    name_id: i64,
    // optional module path / crate stand-in
    path_id: i64,
}

fn ecs_sn_debug_name(name_id: i64) -> EcsSnDebugNameDeep {
    return EcsSnDebugNameDeep { name_id: name_id, path_id: 0 };
}

fn ecs_sn_debug_name_full(name_id: i64, path_id: i64) -> EcsSnDebugNameDeep {
    return EcsSnDebugNameDeep { name_id: name_id, path_id: path_id };
}

fn ecs_sn_debug_name_id(d: EcsSnDebugNameDeep) -> i64 { return d.name_id; }
fn ecs_sn_debug_path_id(d: EcsSnDebugNameDeep) -> i64 { return d.path_id; }

fn ecs_sn_debug_eq(a: EcsSnDebugNameDeep, b: EcsSnDebugNameDeep) -> bool {
    return a.name_id == b.name_id;
}

// Display stand-in: prefer path+name encoding
fn ecs_sn_debug_display_code(d: EcsSnDebugNameDeep) -> i64 {
    if d.path_id == 0 {
        return d.name_id;
    };
    return d.path_id * 1000000 + d.name_id;
}

// ends_with helper for tests (name suffix match)
fn ecs_sn_debug_ends_with(d: EcsSnDebugNameDeep, suffix: i64) -> bool {
    // model: name_id % 10000 == suffix, or exact match
    if d.name_id == suffix { return true; };
    let modv = d.name_id - (d.name_id / 10000) * 10000;
    return modv == suffix;
}

// === SystemMeta name holder ===
struct EcsSnSystemMetaDeep {
    name: EcsSnDebugNameDeep,
    // access touch counter (should stay 0 for SystemName)
    access_mutations: i64,
}

fn ecs_sn_meta_new(name_id: i64) -> EcsSnSystemMetaDeep {
    return EcsSnSystemMetaDeep {
        name: ecs_sn_debug_name(name_id),
        access_mutations: 0,
    };
}

fn ecs_sn_meta_with_path(name_id: i64, path_id: i64) -> EcsSnSystemMetaDeep {
    return EcsSnSystemMetaDeep {
        name: ecs_sn_debug_name_full(name_id, path_id),
        access_mutations: 0,
    };
}

fn ecs_sn_meta_name(m: EcsSnSystemMetaDeep) -> EcsSnDebugNameDeep { return m.name; }

// IntoSystem::with_name stand-in
fn ecs_sn_meta_with_name(m: EcsSnSystemMetaDeep, name_id: i64) -> EcsSnSystemMetaDeep {
    m.name = ecs_sn_debug_name_full(name_id, m.name.path_id);
    return m;
}

fn ecs_sn_meta_access_mutations(m: EcsSnSystemMetaDeep) -> i64 { return m.access_mutations; }

// === SystemName ===
struct EcsSystemNameDeep {
    name: EcsSnDebugNameDeep,
}

fn ecs_sn_new(name_id: i64) -> EcsSystemNameDeep {
    return EcsSystemNameDeep { name: ecs_sn_debug_name(name_id) };
}

fn ecs_sn_from_debug(d: EcsSnDebugNameDeep) -> EcsSystemNameDeep {
    return EcsSystemNameDeep { name: d };
}

// SystemName::name()
fn ecs_sn_name(s: EcsSystemNameDeep) -> EcsSnDebugNameDeep {
    return s.name;
}

fn ecs_sn_name_id(s: EcsSystemNameDeep) -> i64 { return s.name.name_id; }

fn ecs_sn_eq(a: EcsSystemNameDeep, b: EcsSystemNameDeep) -> bool {
    return ecs_sn_debug_eq(a.name, b.name);
}

fn ecs_sn_display_code(s: EcsSystemNameDeep) -> i64 {
    return ecs_sn_debug_display_code(s.name);
}

// Into conversion stand-in (derive Into)
fn ecs_sn_into_debug(s: EcsSystemNameDeep) -> EcsSnDebugNameDeep {
    return s.name;
}

// === SystemParam model ===
struct EcsSnParamStateDeep {
    dummy: i32,
}

fn ecs_sn_sp_init_state() -> EcsSnParamStateDeep {
    return EcsSnParamStateDeep { dummy: 0 };
}

// init_access: no FilteredAccessSet mutation
fn ecs_sn_sp_init_access(m: EcsSnSystemMetaDeep) -> EcsSnSystemMetaDeep {
    // deliberately does not increment access_mutations
    return m;
}

fn ecs_sn_sp_touches_components() -> bool {
    return false;
}

fn ecs_sn_sp_is_read_only() -> bool {
    return true;
}

// get_param: Ok(SystemName(system_meta.name))
fn ecs_sn_sp_get_param(
    _state: EcsSnParamStateDeep,
    m: EcsSnSystemMetaDeep
) -> (bool, EcsSystemNameDeep) {
    return (true, ecs_sn_from_debug(m.name));
}

// === ExclusiveSystemParam model ===
fn ecs_sn_esp_init() -> EcsSnParamStateDeep {
    return ecs_sn_sp_init_state();
}

fn ecs_sn_esp_get_param(
    _state: EcsSnParamStateDeep,
    m: EcsSnSystemMetaDeep
) -> (bool, EcsSystemNameDeep) {
    return (true, ecs_sn_from_debug(m.name));
}

// === Run helpers (regular vs exclusive systems) ===
fn ecs_sn_run_regular(m: EcsSnSystemMetaDeep) -> EcsSystemNameDeep {
    let state = ecs_sn_sp_init_state();
    m = ecs_sn_sp_init_access(m);
    let r = ecs_sn_sp_get_param(state, m);
    return r.1;
}

fn ecs_sn_run_exclusive(m: EcsSnSystemMetaDeep) -> EcsSystemNameDeep {
    let state = ecs_sn_esp_init();
    let r = ecs_sn_esp_get_param(state, m);
    return r.1;
}

// Closure with_name: system name equals provided name exactly
fn ecs_sn_run_closure_with_name(name_id: i64) -> EcsSystemNameDeep {
    let m = ecs_sn_meta_new(0);
    m = ecs_sn_meta_with_name(m, name_id);
    return ecs_sn_run_regular(m);
}

fn ecs_sn_run_exclusive_closure_with_name(name_id: i64) -> EcsSystemNameDeep {
    let m = ecs_sn_meta_new(0);
    m = ecs_sn_meta_with_name(m, name_id);
    return ecs_sn_run_exclusive(m);
}

// Logger-style SystemParam bundle using SystemName
struct EcsSnLoggerDeep {
    system_name: EcsSystemNameDeep,
    log_count: i64,
    last_message: i64,
}

fn ecs_sn_logger_from_meta(m: EcsSnSystemMetaDeep) -> EcsSnLoggerDeep {
    let sn = ecs_sn_run_regular(m);
    return EcsSnLoggerDeep {
        system_name: sn,
        log_count: 0,
        last_message: 0,
    };
}

fn ecs_sn_logger_log(l: EcsSnLoggerDeep, message: i64) -> EcsSnLoggerDeep {
    l.log_count = l.log_count + 1;
    l.last_message = message;
    return l;
}

fn ecs_sn_logger_name_id(l: EcsSnLoggerDeep) -> i64 {
    return ecs_sn_name_id(l.system_name);
}

fn ecs_sn_logger_log_count(l: EcsSnLoggerDeep) -> i64 { return l.log_count; }
fn ecs_sn_logger_last_message(l: EcsSnLoggerDeep) -> i64 { return l.last_message; }

// Combined display: "system_name: message" code
fn ecs_sn_logger_display_code(l: EcsSnLoggerDeep) -> i64 {
    return ecs_sn_display_code(l.system_name) * 1000 + l.last_message;
}
