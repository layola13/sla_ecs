// Bevy ECS query::builder extras — id-by-id variants + World mut access + access() view.
// Mirrors src/query/builder.rs (gaps not in lib/query_builder.sla).

struct EcsQueryBuilder2 {
    world_id: i64,
    data_ids: Vec<i32>,
    data_writes: Vec<bool>,
    filter_with: Vec<i32>,
    filter_without: Vec<i32>,
    or_groups: i32,
    optional_count: i32,
    archetype_filter_count: i32,
}

fn ecs_query_builder2_new(world_id: i64) -> EcsQueryBuilder2 {
    let qb = EcsQueryBuilder2 { world_id: world_id, data_ids: Vec::new(), data_writes: Vec::new(), filter_with: Vec::new(), filter_without: Vec::new(), or_groups: 0, optional_count: 0, archetype_filter_count: 0 };
    return qb;
}

fn ecs_query_builder2_world(qb: EcsQueryBuilder2) -> i64 {
    return qb.world_id;
}

// world_mut: returns the same builder with the world_id bumped to a new mutator-supplied id
// (we model mutability by tagging a "mut" sentinel via the +sign but keep the address).
fn ecs_query_builder2_world_mut(qb: EcsQueryBuilder2, new_world_id: i64) -> EcsQueryBuilder2 {
    qb.world_id = new_world_id;
    return qb;
}

fn ecs_query_builder2_data(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.data_ids.push(id);
    qb.data_writes.push(false);
    return qb;
}

// with<T>: add a With() filter (typed variant)
fn ecs_query_builder2_with(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.filter_with.push(id);
    return qb;
}

// with_id(id): the explicit-ComponentId variant — same as with<T>. Specified for parity.
fn ecs_query_builder2_with_id(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.filter_with.push(id);
    return qb;
}

// without<T>: add a Without() filter (typed variant)
fn ecs_query_builder2_without(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.filter_without.push(id);
    return qb;
}

// without_id(id): explicit-ComponentId variant
fn ecs_query_builder2_without_id(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.filter_without.push(id);
    return qb;
}

// ref_id/mut_id: read / write data ids
fn ecs_query_builder2_ref_id(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.data_ids.push(id);
    qb.data_writes.push(false);
    return qb;
}

fn ecs_query_builder2_mut_id(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.data_ids.push(id);
    qb.data_writes.push(true);
    return qb;
}

fn ecs_query_builder2_filter(qb: EcsQueryBuilder2, id: i32) -> EcsQueryBuilder2 {
    qb.filter_with.push(id);
    return qb;
}

fn ecs_query_builder2_optional(qb: EcsQueryBuilder2) -> EcsQueryBuilder2 {
    qb.optional_count = qb.optional_count + 1;
    return qb;
}

fn ecs_query_builder2_and(qb: EcsQueryBuilder2) -> EcsQueryBuilder2 {
    qb.or_groups = qb.or_groups + 1;
    return qb;
}

// or(): adds a new or-group; subsequent with/without calls extend the new group
fn ecs_query_builder2_or(qb: EcsQueryBuilder2) -> EcsQueryBuilder2 {
    qb.or_groups = qb.or_groups + 1;
    return qb;
}

fn ecs_query_builder2_extend_access_count(qb: EcsQueryBuilder2, n: i32) -> EcsQueryBuilder2 {
    // extends the data set: ensures filter_with roughly matches a fresh FilteredAccess of size n
    qb.archetype_filter_count = qb.archetype_filter_count + n;
    return qb;
}

// access(): returns (data_count, with_count, without_count, or_groups) — primitives-only view of FilteredAccess.
fn ecs_query_builder2_access(qb: EcsQueryBuilder2) -> (i32, i32, i32, i32) {
    let dc = len(qb.data_ids) as i32;
    let wc = len(qb.filter_with) as i32;
    let woc = len(qb.filter_without) as i32;
    return (dc, wc, woc, qb.or_groups);
}

// count accessors
fn ecs_query_builder2_data_count(qb: EcsQueryBuilder2) -> i32 { return len(qb.data_ids) as i32; }
fn ecs_query_builder2_with_count(qb: EcsQueryBuilder2) -> i32 { return len(qb.filter_with) as i32; }
fn ecs_query_builder2_without_count(qb: EcsQueryBuilder2) -> i32 { return len(qb.filter_without) as i32; }
fn ecs_query_builder2_or_groups(qb: EcsQueryBuilder2) -> i32 { return qb.or_groups; }
fn ecs_query_builder2_optional_count(qb: EcsQueryBuilder2) -> i32 { return qb.optional_count; }

// transmute<tag>: reset data + filter (simulating transmutation to NewD)
fn ecs_query_builder2_transmute(qb: EcsQueryBuilder2) -> EcsQueryBuilder2 {
    qb.data_ids = Vec::new();
    qb.data_writes = Vec::new();
    return qb;
}

// transmute_filtered<NewD, NewF>: reset everything but keep optional_count
fn ecs_query_builder2_transmute_filtered(qb: EcsQueryBuilder2) -> EcsQueryBuilder2 {
    qb.data_ids = Vec::new();
    qb.data_writes = Vec::new();
    qb.filter_with = Vec::new();
    qb.filter_without = Vec::new();
    return qb;
}

// build: returns (state_query_id, what)
// We model the returned QueryState via a single per-builder kosab index; state id = world_id + total_entries
fn ecs_query_builder2_build_id(qb: EcsQueryBuilder2) -> i64 {
    let tot = len(qb.data_ids) as i64 + len(qb.filter_with) as i64 + len(qb.filter_without) as i64;
    let bid = qb.world_id + tot;
    return bid;
}

fn ecs_query_builder2_build(qb: EcsQueryBuilder2) -> i64 {
    return ecs_query_builder2_build_id(qb);
}
