fn ecs_eis3_deep_drain_result_set_len(r: EcsEis3DrainResultDeep) -> i32 { return r.s_vn; }
fn ecs_eis3_deep_drain_result_set_at(r: EcsEis3DrainResultDeep, index: i32) -> i64 {
    if index == 0 { return r.s_v0; };
    if index == 1 { return r.s_v1; };
    if index == 2 { return r.s_v2; };
    if index == 3 { return r.s_v3; };
    if index == 4 { return r.s_v4; };
    if index == 5 { return r.s_v5; };
    if index == 6 { return r.s_v6; };
    if index == 7 { return r.s_v7; };
    panic(144609);
}
fn ecs_eis3_deep_drain_result_drain_count(r: EcsEis3DrainResultDeep) -> i64 { return r.d_back - r.d_front; }

fn _ecs_eis3_drain_result_make(kept_slice: EcsEis3SliceDeep, drained: EcsEis3SliceDeep) -> EcsEis3DrainResultDeep {
    let d_front = drained.s_vn as i64;
    let d_back__drained = drained.s_vn as i64;
    return EcsEis3DrainResultDeep {
        s_v0: kept_slice.s_v0, s_v1: kept_slice.s_v1, s_v2: kept_slice.s_v2, s_v3: kept_slice.s_v3,
        s_v4: kept_slice.s_v4, s_v5: kept_slice.s_v5, s_v6: kept_slice.s_v6, s_v7: kept_slice.s_v7,
        s_vn: kept_slice.s_vn,
        d_v0: drained.s_v0, d_v1: drained.s_v1, d_v2: drained.s_v2, d_v3: drained.s_v3,
        d_v4: drained.s_v4, d_v5: drained.s_v5, d_v6: drained.s_v6, d_v7: drained.s_v7,
        d_vn: drained.s_vn, d_front: 0, d_back: d_front,
        d_trusted_unique: 1, d_inner_exposed: 0,
    };
}

fn _ecs_eis3_drain_clamped(set: EcsEis3SetDeep, start: i64, end: i64) -> EcsEis3DrainResultDeep {
    let count = set.vn as i64;
    let kept_size = count - (end - start);
    let kept = ecs_eis3_deep_empty_slice();
    kept.s_vn = kept_size as i32;
    let drained = ecs_eis3_deep_empty_slice();
    drained.s_vn = (end - start) as i32;
    // Fill kept: everything before start, then everything from end..count
    let kept_idx: i32 = 0;
    let src: i64 = 0;
    while src < start {
        let v = _ecs_eis3_set_at(set, src as i32);
        kept = _ecs_eis3_slice_set(kept, kept_idx, v);
        src = src + 1;
        kept_idx = kept_idx + 1;
    }
    let drain_idx: i32 = 0;
    src = start;
    while src < end {
        let v = _ecs_eis3_set_at(set, src as i32);
        drained = _ecs_eis3_slice_set(drained, drain_idx, v);
        src = src + 1;
        drain_idx = drain_idx + 1;
    }
    src = end;
    while src < count {
        let v = _ecs_eis3_set_at(set, src as i32);
        kept = _ecs_eis3_slice_set(kept, kept_idx, v);
        src = src + 1;
        kept_idx = kept_idx + 1;
    }
    return _ecs_eis3_drain_result_make(kept, drained);
}

fn ecs_eis3_deep_drain(set: EcsEis3SetDeep, start: i64, end: i64) -> EcsEis3DrainResultDeep {
    let count = set.vn as i64;
    if start <= 0 {
        if end >= count { return _ecs_eis3_drain_clamped(set, 0, count); };
        if end < 0 { return _ecs_eis3_drain_clamped(set, 0, 0); };
        return _ecs_eis3_drain_clamped(set, 0, end);
    };
    if start >= count { return _ecs_eis3_drain_clamped(set, count, count); };
    if end <= start { return _ecs_eis3_drain_clamped(set, start, start); };
    if end >= count { return _ecs_eis3_drain_clamped(set, start, count); };
    return _ecs_eis3_drain_clamped(set, start, end);
}

