// Deep self-contained Bevy ECS EntityIndexSet bound/inner/set-op iterator extras.
// Mirrors lib/entity_index_set_iter_extras.sla (320 lines).
// Fixed-cap (cap-8) scalar slot families. No @import.
// All wrapper structs that previously held a nested iterator or set now flat-field
// their contents to dodge the SA MemoryLeak bug where nested @derive(copy) struct
// access leaves stuck registers.

const ECS_EIS3_DEEP_CAP: i32 = 8;

// === EcsEis3SetDeep (cap-8 flat) ===
@derive(copy)
struct EcsEis3SetDeep {
    v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64,
    vn: i32,
}

@derive(copy)
struct EcsEis3BoundDeep {
    kind: i32,
    value: i64,
}

@derive(copy)
struct EcsEis3SliceDeep {
    s_v0: i64, s_v1: i64, s_v2: i64, s_v3: i64, s_v4: i64, s_v5: i64, s_v6: i64, s_v7: i64,
    s_vn: i32,
    boxed: i32,
    mutable_view: i32,
    inner_view: i32,
}

@derive(copy)
struct EcsEis3InnerInfoDeep {
    len: i64,
    boxed: i32,
    mutable_view: i32,
    inner_view: i32,
}

// === Helper: read set slot value ===
fn _ecs_eis3_set_at(set: EcsEis3SetDeep, index: i32) -> i64 {
    if index == 0 { return set.v0; };
    if index == 1 { return set.v1; };
    if index == 2 { return set.v2; };
    if index == 3 { return set.v3; };
    if index == 4 { return set.v4; };
    if index == 5 { return set.v5; };
    if index == 6 { return set.v6; };
    if index == 7 { return set.v7; };
    panic(144600);
}

fn _ecs_eis3_set_set(set: EcsEis3SetDeep, index: i32, value: i64) -> EcsEis3SetDeep {
    if index == 0 { set.v0 = value; return set; };
    if index == 1 { set.v1 = value; return set; };
    if index == 2 { set.v2 = value; return set; };
    if index == 3 { set.v3 = value; return set; };
    if index == 4 { set.v4 = value; return set; };
    if index == 5 { set.v5 = value; return set; };
    if index == 6 { set.v6 = value; return set; };
    if index == 7 { set.v7 = value; return set; };
    panic(144601);
}

fn _ecs_eis3_slice_at(slice: EcsEis3SliceDeep, index: i32) -> i64 {
    if index == 0 { return slice.s_v0; };
    if index == 1 { return slice.s_v1; };
    if index == 2 { return slice.s_v2; };
    if index == 3 { return slice.s_v3; };
    if index == 4 { return slice.s_v4; };
    if index == 5 { return slice.s_v5; };
    if index == 6 { return slice.s_v6; };
    if index == 7 { return slice.s_v7; };
    panic(144602);
}

// === Public API ===
fn ecs_eis3_deep_bound_unbounded() -> EcsEis3BoundDeep {
    return EcsEis3BoundDeep { kind: 0, value: 0 };
}

fn ecs_eis3_deep_bound_included(value: i64) -> EcsEis3BoundDeep {
    return EcsEis3BoundDeep { kind: 1, value: value };
}

fn ecs_eis3_deep_bound_excluded(value: i64) -> EcsEis3BoundDeep {
    return EcsEis3BoundDeep { kind: 2, value: value };
}

fn ecs_eis3_deep_bound_kind(bound: EcsEis3BoundDeep) -> i32 {
    return bound.kind;
}

fn ecs_eis3_deep_bound_value(bound: EcsEis3BoundDeep) -> i64 {
    return bound.value;
}

fn ecs_eis3_deep_new() -> EcsEis3SetDeep {
    return EcsEis3SetDeep { v0: 0, v1: 0, v2: 0, v3: 0, v4: 0, v5: 0, v6: 0, v7: 0, vn: 0 };
}

fn ecs_eis3_deep_len(set: EcsEis3SetDeep) -> i64 {
    return set.vn as i64;
}

fn ecs_eis3_deep_slice_len(slice: EcsEis3SliceDeep) -> i64 {
    return slice.s_vn as i64;
}

fn ecs_eis3_deep_contains(set: EcsEis3SetDeep, value: i64) -> bool {
    let index: i32 = 0;
    let count = set.vn;
    while index < count {
        if _ecs_eis3_set_at(set, index) == value { return true; };
        index = index + 1;
    }
    return false;
}

// InsertResult flattened: { inserted, v0..v7, vn }
@derive(copy)
struct EcsEis3InsertResultDeep {
    inserted: i32,
    v0: i64, v1: i64, v2: i64, v3: i64, v4: i64, v5: i64, v6: i64, v7: i64,
    vn: i32,
}

fn ecs_eis3_deep_insert(set: EcsEis3SetDeep, value: i64) -> EcsEis3InsertResultDeep {
    if ecs_eis3_deep_contains(set, value) {
        return EcsEis3InsertResultDeep {
            inserted: 0, v0: set.v0, v1: set.v1, v2: set.v2, v3: set.v3,
            v4: set.v4, v5: set.v5, v6: set.v6, v7: set.v7, vn: set.vn,
        };
    };
    if set.vn >= ECS_EIS3_DEEP_CAP {
        return EcsEis3InsertResultDeep {
            inserted: 0, v0: set.v0, v1: set.v1, v2: set.v2, v3: set.v3,
            v4: set.v4, v5: set.v5, v6: set.v6, v7: set.v7, vn: set.vn,
        };
    };
    set = _ecs_eis3_set_set(set, set.vn, value);
    set.vn = set.vn + 1;
    return EcsEis3InsertResultDeep {
        inserted: 1, v0: set.v0, v1: set.v1, v2: set.v2, v3: set.v3,
        v4: set.v4, v5: set.v5, v6: set.v6, v7: set.v7, vn: set.vn,
    };
}

fn ecs_eis3_deep_insert_result_inserted(r: EcsEis3InsertResultDeep) -> i32 {
    return r.inserted;
}

fn ecs_eis3_deep_insert_result_len(r: EcsEis3InsertResultDeep) -> i32 {
    return r.vn;
}

fn ecs_eis3_deep_insert_result_set_from(r: EcsEis3InsertResultDeep) -> EcsEis3SetDeep {
    return EcsEis3SetDeep {
        v0: r.v0, v1: r.v1, v2: r.v2, v3: r.v3,
        v4: r.v4, v5: r.v5, v6: r.v6, v7: r.v7, vn: r.vn,
    };
}

// Helper: build set from result (used by ECS workflows)
fn _ecs_eis3_deep_apply_insert(prev_set: EcsEis3SetDeep, r: EcsEis3InsertResultDeep) -> EcsEis3SetDeep {
    return EcsEis3SetDeep {
        v0: r.v0, v1: r.v1, v2: r.v2, v3: r.v3,
        v4: r.v4, v5: r.v5, v6: r.v6, v7: r.v7, vn: r.vn,
    };
}

// === Slice ===
fn ecs_eis3_deep_as_slice(set: EcsEis3SetDeep) -> EcsEis3SliceDeep {
    return EcsEis3SliceDeep {
        s_v0: set.v0, s_v1: set.v1, s_v2: set.v2, s_v3: set.v3,
        s_v4: set.v4, s_v5: set.v5, s_v6: set.v6, s_v7: set.v7,
        s_vn: set.vn, boxed: 0, mutable_view: 0, inner_view: 0,
    };
}

fn ecs_eis3_deep_empty_slice() -> EcsEis3SliceDeep {
    return EcsEis3SliceDeep {
        s_v0: 0, s_v1: 0, s_v2: 0, s_v3: 0, s_v4: 0, s_v5: 0, s_v6: 0, s_v7: 0,
        s_vn: 0, boxed: 0, mutable_view: 0, inner_view: 0,
    };
}

fn ecs_eis3_deep_from_slice_unchecked_mut(slice: EcsEis3SliceDeep) -> EcsEis3SliceDeep {
    return EcsEis3SliceDeep {
        s_v0: slice.s_v0, s_v1: slice.s_v1, s_v2: slice.s_v2, s_v3: slice.s_v3,
        s_v4: slice.s_v4, s_v5: slice.s_v5, s_v6: slice.s_v6, s_v7: slice.s_v7,
        s_vn: slice.s_vn, boxed: slice.boxed, mutable_view: 1, inner_view: slice.inner_view,
    };
}

fn _ecs_eis3_slice_set(slice: EcsEis3SliceDeep, index: i32, value: i64) -> EcsEis3SliceDeep {
    if index == 0 { slice.s_v0 = value; return slice; };
    if index == 1 { slice.s_v1 = value; return slice; };
    if index == 2 { slice.s_v2 = value; return slice; };
    if index == 3 { slice.s_v3 = value; return slice; };
    if index == 4 { slice.s_v4 = value; return slice; };
    if index == 5 { slice.s_v5 = value; return slice; };
    if index == 6 { slice.s_v6 = value; return slice; };
    if index == 7 { slice.s_v7 = value; return slice; };
    panic(144603);
}

fn ecs_eis3_deep_slice_as_inner(slice: EcsEis3SliceDeep) -> EcsEis3InnerInfoDeep {
    return EcsEis3InnerInfoDeep {
        len: slice.s_vn as i64, boxed: slice.boxed, mutable_view: slice.mutable_view, inner_view: 1,
    };
}

fn ecs_eis3_deep_boxed_as_inner(slice: EcsEis3SliceDeep) -> EcsEis3InnerInfoDeep {
    return EcsEis3InnerInfoDeep {
        len: slice.s_vn as i64, boxed: 1, mutable_view: slice.mutable_view, inner_view: 1,
    };
}

fn ecs_eis3_deep_inner_info_len(i: EcsEis3InnerInfoDeep) -> i64 { return i.len; }
fn ecs_eis3_deep_inner_info_boxed(i: EcsEis3InnerInfoDeep) -> i32 { return i.boxed; }
fn ecs_eis3_deep_inner_info_mutable_view(i: EcsEis3InnerInfoDeep) -> i32 { return i.mutable_view; }
fn ecs_eis3_deep_inner_info_inner_view(i: EcsEis3InnerInfoDeep) -> i32 { return i.inner_view; }

// === Bound start/end ===
fn ecs_eis3_deep_bound_start(bound: EcsEis3BoundDeep) -> i64 {
    if bound.kind == 0 { return 0; };
    if bound.kind == 1 { return bound.value; };
    return bound.value + 1;
}

fn ecs_eis3_deep_bound_end(bound: EcsEis3BoundDeep, count: i64) -> i64 {
    if bound.kind == 0 { return count; };
    if bound.kind == 1 { return bound.value + 1; };
    return bound.value;
}

// RangeResult flattened: { has, s_v0..s_v7, s_vn, boxed, mutable_view, inner_view }
@derive(copy)
struct EcsEis3RangeResultDeep {
    has: i32,
    s_v0: i64, s_v1: i64, s_v2: i64, s_v3: i64, s_v4: i64, s_v5: i64, s_v6: i64, s_v7: i64,
    s_vn: i32,
    boxed: i32,
    mutable_view: i32,
    inner_view: i32,
}

fn ecs_eis3_deep_range_result_has(r: EcsEis3RangeResultDeep) -> i32 {
    return r.has;
}

fn ecs_eis3_deep_range_result_len(r: EcsEis3RangeResultDeep) -> i32 {
    return r.s_vn;
}

fn ecs_eis3_deep_range_result_at(r: EcsEis3RangeResultDeep, index: i32) -> i64 {
    if index == 0 { return r.s_v0; };
    if index == 1 { return r.s_v1; };
    if index == 2 { return r.s_v2; };
    if index == 3 { return r.s_v3; };
    if index == 4 { return r.s_v4; };
    if index == 5 { return r.s_v5; };
    if index == 6 { return r.s_v6; };
    if index == 7 { return r.s_v7; };
    panic(144604);
}

fn _ecs_eis3_range_result_from_slice(has: i32, slice: EcsEis3SliceDeep) -> EcsEis3RangeResultDeep {
    return EcsEis3RangeResultDeep {
        has: has,
        s_v0: slice.s_v0, s_v1: slice.s_v1, s_v2: slice.s_v2, s_v3: slice.s_v3,
        s_v4: slice.s_v4, s_v5: slice.s_v5, s_v6: slice.s_v6, s_v7: slice.s_v7,
        s_vn: slice.s_vn, boxed: slice.boxed, mutable_view: slice.mutable_view, inner_view: slice.inner_view,
    };
}

fn ecs_eis3_deep_slice_range(slice: EcsEis3SliceDeep, start: i64, end: i64) -> EcsEis3RangeResultDeep {
    let count = slice.s_vn as i64;
    if start < 0 { return _ecs_eis3_range_result_from_slice(0, ecs_eis3_deep_empty_slice()); };
    if end < start { return _ecs_eis3_range_result_from_slice(0, ecs_eis3_deep_empty_slice()); };
    if end > count { return _ecs_eis3_range_result_from_slice(0, ecs_eis3_deep_empty_slice()); };
    let out = ecs_eis3_deep_empty_slice();
    out.s_vn = (end - start) as i32;
    let idx: i32 = 0;
    let src_idx: i64 = start;
    while src_idx < end {
        let v = _ecs_eis3_slice_at(slice, src_idx as i32);
        out = _ecs_eis3_slice_set(out, idx, v);
        src_idx = src_idx + 1;
        idx = idx + 1;
    }
    return _ecs_eis3_range_result_from_slice(1, out);
}

fn ecs_eis3_deep_slice_bound_range(slice: EcsEis3SliceDeep, start_bound: EcsEis3BoundDeep, end_bound: EcsEis3BoundDeep) -> EcsEis3RangeResultDeep {
    let count = slice.s_vn as i64;
    return ecs_eis3_deep_slice_range(slice, ecs_eis3_deep_bound_start(start_bound), ecs_eis3_deep_bound_end(end_bound, count));
}

fn ecs_eis3_deep_set_bound_range(set: EcsEis3SetDeep, start_bound: EcsEis3BoundDeep, end_bound: EcsEis3BoundDeep) -> EcsEis3RangeResultDeep {
    return ecs_eis3_deep_slice_bound_range(ecs_eis3_deep_as_slice(set), start_bound, end_bound);
}

fn ecs_eis3_deep_slice_boxed(set: EcsEis3SetDeep) -> EcsEis3SliceDeep {
    return EcsEis3SliceDeep {
        s_v0: set.v0, s_v1: set.v1, s_v2: set.v2, s_v3: set.v3,
        s_v4: set.v4, s_v5: set.v5, s_v6: set.v6, s_v7: set.v7,
        s_vn: set.vn, boxed: 1, mutable_view: 0, inner_view: 0,
    };
}

// === Iter (flat-front/back, slot families) ===
@derive(copy)
struct EcsEis3IterDeep {
    i_v0: i64, i_v1: i64, i_v2: i64, i_v3: i64, i_v4: i64, i_v5: i64, i_v6: i64, i_v7: i64,
    i_vn: i32,
    front: i64,
    back: i64,
    trusted_unique: i32,
    inner_exposed: i32,
}

fn _ecs_eis3_iter_at(iter: EcsEis3IterDeep, index: i32) -> i64 {
    if index == 0 { return iter.i_v0; };
    if index == 1 { return iter.i_v1; };
    if index == 2 { return iter.i_v2; };
    if index == 3 { return iter.i_v3; };
    if index == 4 { return iter.i_v4; };
    if index == 5 { return iter.i_v5; };
    if index == 6 { return iter.i_v6; };
    if index == 7 { return iter.i_v7; };
    panic(144605);
}

fn ecs_eis3_deep_iter_from_slice(slice: EcsEis3SliceDeep) -> EcsEis3IterDeep {
    let count = slice.s_vn as i64;
    return EcsEis3IterDeep {
        i_v0: slice.s_v0, i_v1: slice.s_v1, i_v2: slice.s_v2, i_v3: slice.s_v3,
        i_v4: slice.s_v4, i_v5: slice.s_v5, i_v6: slice.s_v6, i_v7: slice.s_v7,
        i_vn: slice.s_vn, front: 0, back: count, trusted_unique: 1, inner_exposed: 0,
    };
}

fn ecs_eis3_deep_iter(set: EcsEis3SetDeep) -> EcsEis3IterDeep {
    return ecs_eis3_deep_iter_from_slice(ecs_eis3_deep_as_slice(set));
}

fn ecs_eis3_deep_iter_front(iter: EcsEis3IterDeep) -> i64 { return iter.front; }
fn ecs_eis3_deep_iter_back(iter: EcsEis3IterDeep) -> i64 { return iter.back; }
fn ecs_eis3_deep_iter_len(iter: EcsEis3IterDeep) -> i64 { return iter.back - iter.front; }
fn ecs_eis3_deep_iter_trusted_unique(iter: EcsEis3IterDeep) -> i32 { return iter.trusted_unique; }
fn ecs_eis3_deep_iter_inner_exposed(iter: EcsEis3IterDeep) -> i32 { return iter.inner_exposed; }

// IterNext flattened: { has, value, then-mut-iter's snapshot }
@derive(copy)
struct EcsEis3IterNextDeep {
    has: i32,
    value: i64,
    i_v0: i64, i_v1: i64, i_v2: i64, i_v3: i64, i_v4: i64, i_v5: i64, i_v6: i64, i_v7: i64,
    i_vn: i32,
    front: i64,
    back: i64,
    trusted_unique: i32,
    inner_exposed: i32,
}

fn ecs_eis3_deep_iter_next_has(n: EcsEis3IterNextDeep) -> i32 { return n.has; }
fn ecs_eis3_deep_iter_next_value(n: EcsEis3IterNextDeep) -> i64 { return n.value; }
fn ecs_eis3_deep_iter_next_front(n: EcsEis3IterNextDeep) -> i64 { return n.front; }
fn ecs_eis3_deep_iter_next_back(n: EcsEis3IterNextDeep) -> i64 { return n.back; }
fn ecs_eis3_deep_iter_next_remaining(n: EcsEis3IterNextDeep) -> i64 { return n.back - n.front; }

fn ecs_eis3_deep_iter_next(iter: EcsEis3IterDeep) -> EcsEis3IterNextDeep {
    if iter.front >= iter.back {
        return EcsEis3IterNextDeep {
            has: 0, value: -1,
            i_v0: iter.i_v0, i_v1: iter.i_v1, i_v2: iter.i_v2, i_v3: iter.i_v3,
            i_v4: iter.i_v4, i_v5: iter.i_v5, i_v6: iter.i_v6, i_v7: iter.i_v7,
            i_vn: iter.i_vn, front: iter.front, back: iter.back,
            trusted_unique: iter.trusted_unique, inner_exposed: iter.inner_exposed,
        };
    };
    let v = _ecs_eis3_iter_at(iter, iter.front as i32);
    iter.front = iter.front + 1;
    return EcsEis3IterNextDeep {
        has: 1, value: v,
        i_v0: iter.i_v0, i_v1: iter.i_v1, i_v2: iter.i_v2, i_v3: iter.i_v3,
        i_v4: iter.i_v4, i_v5: iter.i_v5, i_v6: iter.i_v6, i_v7: iter.i_v7,
        i_vn: iter.i_vn, front: iter.front, back: iter.back,
        trusted_unique: iter.trusted_unique, inner_exposed: iter.inner_exposed,
    };
}

// Step the iterator using the Next wrapper as the state carrier.
fn ecs_eis3_deep_iter_next_from_next(prev: EcsEis3IterNextDeep) -> EcsEis3IterNextDeep {
    let iter = EcsEis3IterDeep {
        i_v0: prev.i_v0, i_v1: prev.i_v1, i_v2: prev.i_v2, i_v3: prev.i_v3,
        i_v4: prev.i_v4, i_v5: prev.i_v5, i_v6: prev.i_v6, i_v7: prev.i_v7,
        i_vn: prev.i_vn, front: prev.front, back: prev.back,
        trusted_unique: prev.trusted_unique, inner_exposed: prev.inner_exposed,
    };
    return ecs_eis3_deep_iter_next(iter);
}

fn ecs_eis3_deep_iter_into_inner(iter: EcsEis3IterDeep) -> EcsEis3IterDeep {
    return EcsEis3IterDeep {
        i_v0: iter.i_v0, i_v1: iter.i_v1, i_v2: iter.i_v2, i_v3: iter.i_v3,
        i_v4: iter.i_v4, i_v5: iter.i_v5, i_v6: iter.i_v6, i_v7: iter.i_v7,
        i_vn: iter.i_vn, front: iter.front, back: iter.back,
        trusted_unique: iter.trusted_unique, inner_exposed: 1,
    };
}

// IntoIter (same shape as Iter)
@derive(copy)
struct EcsEis3IntoIterDeep {
    i_v0: i64, i_v1: i64, i_v2: i64, i_v3: i64, i_v4: i64, i_v5: i64, i_v6: i64, i_v7: i64,
    i_vn: i32,
    front: i64,
    back: i64,
    trusted_unique: i32,
    inner_exposed: i32,
}

fn _ecs_eis3_into_iter_set(iter: EcsEis3IntoIterDeep, index: i32, v: i64) -> EcsEis3IntoIterDeep {
    if index == 0 { iter.i_v0 = v; return iter; };
    if index == 1 { iter.i_v1 = v; return iter; };
    if index == 2 { iter.i_v2 = v; return iter; };
    if index == 3 { iter.i_v3 = v; return iter; };
    if index == 4 { iter.i_v4 = v; return iter; };
    if index == 5 { iter.i_v5 = v; return iter; };
    if index == 6 { iter.i_v6 = v; return iter; };
    if index == 7 { iter.i_v7 = v; return iter; };
    panic(144606);
}

fn _ecs_eis3_into_iter_at(iter: EcsEis3IntoIterDeep, index: i32) -> i64 {
    if index == 0 { return iter.i_v0; };
    if index == 1 { return iter.i_v1; };
    if index == 2 { return iter.i_v2; };
    if index == 3 { return iter.i_v3; };
    if index == 4 { return iter.i_v4; };
    if index == 5 { return iter.i_v5; };
    if index == 6 { return iter.i_v6; };
    if index == 7 { return iter.i_v7; };
    panic(144607);
}

fn ecs_eis3_deep_boxed_into_iter(slice: EcsEis3SliceDeep) -> EcsEis3IntoIterDeep {
    return EcsEis3IntoIterDeep {
        i_v0: slice.s_v0, i_v1: slice.s_v1, i_v2: slice.s_v2, i_v3: slice.s_v3,
        i_v4: slice.s_v4, i_v5: slice.s_v5, i_v6: slice.s_v6, i_v7: slice.s_v7,
        i_vn: slice.s_vn, front: 0, back: slice.s_vn as i64, trusted_unique: 1, inner_exposed: 0,
    };
}

@derive(copy)
struct EcsEis3IntoIterNextDeep {
    has: i32,
    value: i64,
    i_v0: i64, i_v1: i64, i_v2: i64, i_v3: i64, i_v4: i64, i_v5: i64, i_v6: i64, i_v7: i64,
    i_vn: i32,
    front: i64,
    back: i64,
    trusted_unique: i32,
    inner_exposed: i32,
}

