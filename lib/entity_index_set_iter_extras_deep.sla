    s_v0: i64, s_v1: i64, s_v2: i64, s_v3: i64, s_v4: i64, s_v5: i64, s_v6: i64, s_v7: i64,
    s_vn: i32,
    o_v0: i64, o_v1: i64, o_v2: i64, o_v3: i64, o_v4: i64, o_v5: i64, o_v6: i64, o_v7: i64,
    o_vn: i32,
    o_front: i64,
    o_back: i64,
    o_trusted_unique: i32,
    o_op_kind: i32,
}

fn ecs_eis3_deep_splice_result_set_len(r: EcsEis3SpliceResultDeep) -> i32 { return r.s_vn; }
fn ecs_eis3_deep_splice_result_set_at(r: EcsEis3SpliceResultDeep, index: i32) -> i64 {
    if index == 0 { return r.s_v0; };
    if index == 1 { return r.s_v1; };
    if index == 2 { return r.s_v2; };
    if index == 3 { return r.s_v3; };
    if index == 4 { return r.s_v4; };
    if index == 5 { return r.s_v5; };
    if index == 6 { return r.s_v6; };
    if index == 7 { return r.s_v7; };
    panic(144611);
}
fn ecs_eis3_deep_splice_result_removed_count(r: EcsEis3SpliceResultDeep) -> i64 { return r.o_back - r.o_front; }
fn ecs_eis3_deep_splice_result_op_kind(r: EcsEis3SpliceResultDeep) -> i32 { return r.o_op_kind; }

fn ecs_eis3_deep_splice_unique(set: EcsEis3SetDeep, start: i64, end: i64, replacement: EcsEis3SetDeep) -> EcsEis3SpliceResultDeep {
    let drained = ecs_eis3_deep_drain(set, start, end);
    let out = ecs_eis3_deep_new();
    let kept_count = drained.s_vn as i64;
    let src_index: i64 = 0;
    let out_index: i32 = 0;
    while src_index < start {
        if src_index < kept_count {
            let v = ecs_eis3_deep_drain_result_set_at(drained, src_index as i32);
            let ins = ecs_eis3_deep_insert(out, v);
            out = _ecs_eis3_deep_apply_insert(out, ins);
        };
        src_index = src_index + 1;
    }
    // Insert replacement range
    let rep_index: i32 = 0;
    let rep_count = replacement.vn;
    while rep_index < rep_count {
        let v = _ecs_eis3_set_at(replacement, rep_index);
        let ins = ecs_eis3_deep_insert(out, v);
        out = _ecs_eis3_deep_apply_insert(out, ins);
        rep_index = rep_index + 1;
    }
    let tail_index = start;
    while tail_index < kept_count {
        let v = ecs_eis3_deep_drain_result_set_at(drained, tail_index as i32);
        let ins = ecs_eis3_deep_insert(out, v);
        out = _ecs_eis3_deep_apply_insert(out, ins);
        tail_index = tail_index + 1;
    }
    // The "removed" OpIter captures the drained elements.
    let op_iter_back = drained.d_vn as i64;
    return EcsEis3SpliceResultDeep {
        s_v0: out.v0, s_v1: out.v1, s_v2: out.v2, s_v3: out.v3,
        s_v4: out.v4, s_v5: out.v5, s_v6: out.v6, s_v7: out.v7,
        s_vn: out.vn,
        o_v0: drained.d_v0, o_v1: drained.d_v1, o_v2: drained.d_v2, o_v3: drained.d_v3,
        o_v4: drained.d_v4, o_v5: drained.d_v5, o_v6: drained.d_v6, o_v7: drained.d_v7,
        o_vn: drained.d_vn, o_front: 0, o_back: op_iter_back,
        o_trusted_unique: 1, o_op_kind: 5,
    };
}

fn _ecs_eis3_set_v8() -> i32 { panic(144612); return 0; }
