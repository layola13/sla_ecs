fn ecs_eis3_deep_collect_op_iter(iter: EcsEis3OpIterDeep) -> EcsEis3SetDeep {
    let out = ecs_eis3_deep_new();
    let index = iter.front;
    while index < iter.back {
        let v = _ecs_eis3_op_iter_at(iter, index as i32);
        let ins = ecs_eis3_deep_insert(out, v);
        out = _ecs_eis3_deep_apply_insert(out, ins);
        index = index + 1;
    }
    return out;
}

fn ecs_eis3_deep_difference_set(left_set: EcsEis3SetDeep, right_set: EcsEis3SetDeep) -> EcsEis3SetDeep {
    let out = ecs_eis3_deep_new();
    let index: i32 = 0;
    let count = left_set.vn;
    while index < count {
        let v = _ecs_eis3_set_at(left_set, index);
        if ecs_eis3_deep_contains(right_set, v) != true {
            let ins = ecs_eis3_deep_insert(out, v);
            out = _ecs_eis3_deep_apply_insert(out, ins);
        };
        index = index + 1;
    }
    return out;
}

fn ecs_eis3_deep_intersection_iter(left_set: EcsEis3SetDeep, right_set: EcsEis3SetDeep) -> EcsEis3OpIterDeep {
    let out = ecs_eis3_deep_new();
    let index: i32 = 0;
    let count = left_set.vn;
    while index < count {
        let v = _ecs_eis3_set_at(left_set, index);
        if ecs_eis3_deep_contains(right_set, v) {
            let ins = ecs_eis3_deep_insert(out, v);
            out = _ecs_eis3_deep_apply_insert(out, ins);
        };
        index = index + 1;
    }
    return ecs_eis3_deep_op_iter_from_set(out, 1);
}

fn ecs_eis3_deep_union_iter(left_set: EcsEis3SetDeep, right_set: EcsEis3SetDeep) -> EcsEis3OpIterDeep {
    let mut out = ecs_eis3_deep_new();
    let left_index: i32 = 0;
    let left_count = left_set.vn;
    while left_index < left_count {
        let v = _ecs_eis3_set_at(left_set, left_index);
        let ins = ecs_eis3_deep_insert(out, v);
        out = _ecs_eis3_deep_apply_insert(out, ins);
        left_index = left_index + 1;
    }
    let right_index: i32 = 0;
    let right_count = right_set.vn;
    while right_index < right_count {
        let v = _ecs_eis3_set_at(right_set, right_index);
        let ins = ecs_eis3_deep_insert(out, v);
        out = _ecs_eis3_deep_apply_insert(out, ins);
        right_index = right_index + 1;
    }
    return ecs_eis3_deep_op_iter_from_set(out, 2);
}

fn ecs_eis3_deep_difference_iter(left_set: EcsEis3SetDeep, right_set: EcsEis3SetDeep) -> EcsEis3OpIterDeep {
    return ecs_eis3_deep_op_iter_from_set(ecs_eis3_deep_difference_set(left_set, right_set), 3);
}

fn ecs_eis3_deep_symmetric_difference_iter(left_set: EcsEis3SetDeep, right_set: EcsEis3SetDeep) -> EcsEis3OpIterDeep {
    let out = ecs_eis3_deep_new();
    let left_index: i32 = 0;
    let left_count = left_set.vn;
    while left_index < left_count {
        let v = _ecs_eis3_set_at(left_set, left_index);
        if ecs_eis3_deep_contains(right_set, v) != true {
            let ins = ecs_eis3_deep_insert(out, v);
            out = _ecs_eis3_deep_apply_insert(out, ins);
        };
        left_index = left_index + 1;
    }
    let right_index: i32 = 0;
    let right_count = right_set.vn;
    while right_index < right_count {
        let v = _ecs_eis3_set_at(right_set, right_index);
        if ecs_eis3_deep_contains(left_set, v) != true {
            let ins = ecs_eis3_deep_insert(out, v);
            out = _ecs_eis3_deep_apply_insert(out, ins);
        };
        right_index = right_index + 1;
    }
    return ecs_eis3_deep_op_iter_from_set(out, 4);
}

