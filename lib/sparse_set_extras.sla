// Bevy ECS storage::sparse_set extension — ComponentSparseSet tick/change accessors + SparseSets
// collection facade. Mirrors src/storage/sparse_set.rs.

// === ComponentSparseSet with tick tracking ===
// Each entry stores value + added_tick + changed_tick + changed_by_id + column_drop_id.
struct EcsCssEntry {
    entity_index: i32,
    value: i64,
    added_tick: i32,
    changed_tick: i32,
    changed_by_id: i32,
}

struct EcsComponentSparseSetV2 {
    entries: Vec<EcsCssEntry>,
    drop_id: i32,        // component drop function id (0 => None)
    clear: bool,
}

fn ecs_css_v2_new(drop_id: i32) -> EcsComponentSparseSetV2 {
    let s = EcsComponentSparseSetV2 { entries: Vec::new(), drop_id: drop_id, clear: false };
    return s;
}

fn ecs_css_v2_len(s: EcsComponentSparseSetV2) -> i32 {
    return len(s.entries) as i32;
}

fn ecs_css_v2_is_empty(s: EcsComponentSparseSetV2) -> bool {
    return len(s.entries) as i32 == 0;
}

fn ecs_css_v2_contains(s: EcsComponentSparseSetV2, entity_index: i32) -> bool {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index == entity_index {
            return true;
        };
        idx = idx + 1;
    }
    return false;
}

fn ecs_css_v2_insert(s: EcsComponentSparseSetV2, entity_index: i32, value: i64, tick: i32, changed_by: i32) -> EcsComponentSparseSetV2 {
    let e = EcsCssEntry { entity_index: entity_index, value: value, added_tick: tick, changed_tick: tick, changed_by_id: changed_by };
    s.entries.push(e);
    return s;
}

fn ecs_css_v2_remove(s: EcsComponentSparseSetV2, entity_index: i32) -> EcsComponentSparseSetV2 {
    let out = Vec::new();
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index != entity_index {
            out.push(s.entries[idx]);
        };
        idx = idx + 1;
    }
    s.entries = out;
    return s;
}

fn ecs_css_v2_get(s: EcsComponentSparseSetV2, entity_index: i32) -> (bool, i64) {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index == entity_index {
            return (true, s.entries[idx].value);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

fn ecs_css_v2_get_added_tick(s: EcsComponentSparseSetV2, entity_index: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index == entity_index {
            return (true, s.entries[idx].added_tick);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

fn ecs_css_v2_get_changed_tick(s: EcsComponentSparseSetV2, entity_index: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index == entity_index {
            return (true, s.entries[idx].changed_tick);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

// get_ticks: (found, added_tick, changed_tick)
fn ecs_css_v2_get_ticks(s: EcsComponentSparseSetV2, entity_index: i32) -> (bool, i32, i32) {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index == entity_index {
            return (true, s.entries[idx].added_tick, s.entries[idx].changed_tick);
        };
        idx = idx + 1;
    }
    return (false, 0, 0);
}

fn ecs_css_v2_get_changed_by(s: EcsComponentSparseSetV2, entity_index: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].entity_index == entity_index {
            return (true, s.entries[idx].changed_by_id);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

fn ecs_css_v2_get_drop(s: EcsComponentSparseSetV2) -> (bool, i32) {
    if s.drop_id != 0 {
        return (true, s.drop_id);
    };
    return (false, 0);
}

// === ImmutableSparseSet<I, V> (the generic, non-component variant) ===
struct EcsImmSparseSetEntry {
    index: i64,
    value: i64,
}

struct EcsImmutableSparseSetV2 {
    entries: Vec<EcsImmSparseSetEntry>,
    capacity: i32,
}

fn ecs_imm_sparse_set_with_capacity(capacity: i32) -> EcsImmutableSparseSetV2 {
    let s = EcsImmutableSparseSetV2 { entries: Vec::new(), capacity: capacity };
    return s;
}

fn ecs_imm_sparse_set_capacity(s: EcsImmutableSparseSetV2) -> i32 { return s.capacity; }
fn ecs_imm_sparse_set_len(s: EcsImmutableSparseSetV2) -> i32 { return len(s.entries) as i32; }
fn ecs_imm_sparse_set_is_empty(s: EcsImmutableSparseSetV2) -> bool { return len(s.entries) as i32 == 0; }

fn ecs_imm_sparse_set_contains(s: EcsImmutableSparseSetV2, index: i64) -> bool {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].index == index {
            return true;
        };
        idx = idx + 1;
    }
    return false;
}

fn ecs_imm_sparse_set_insert(s: EcsImmutableSparseSetV2, index: i64, value: i64) -> EcsImmutableSparseSetV2 {
    let e = EcsImmSparseSetEntry { index: index, value: value };
    s.entries.push(e);
    return s;
}

fn ecs_imm_sparse_set_get(s: EcsImmutableSparseSetV2, index: i64) -> (bool, i64) {
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].index == index {
            return (true, s.entries[idx].value);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

// get_or_insert_with: if index absent, insert computed default (here caller-supplied default value).
fn ecs_imm_sparse_set_get_or_insert_with(s: EcsImmutableSparseSetV2, index: i64, default_value: i64) -> (EcsImmutableSparseSetV2, i64) {
    let found = ecs_imm_sparse_set_contains(s, index);
    if found == true {
        let r = ecs_imm_sparse_set_get(s, index);
        let v = r.1;
        let _ok = r.0;
        return (s, v);
    };
    let s2 = ecs_imm_sparse_set_insert(s, index, default_value);
    return (s2, default_value);
}

fn ecs_imm_sparse_set_remove(s: EcsImmutableSparseSetV2, index: i64) -> (EcsImmutableSparseSetV2, bool) {
    let out = Vec::new();
    let mut removed: bool = false;
    let idx: i32 = 0;
    let n: i32 = len(s.entries) as i32;
    while idx < n {
        if s.entries[idx].index != index {
            out.push(s.entries[idx]);
        };
        if s.entries[idx].index == index {
            removed = true;
        };
        idx = idx + 1;
    }
    s.entries = out;
    return (s, removed);
}

fn ecs_imm_sparse_set_clear(s: EcsImmutableSparseSetV2) -> EcsImmutableSparseSetV2 {
    s.entries = Vec::new();
    return s;
}

// === SparseSets collection ===
// Per-component-id registries storing a ComponentSparseSet-style entry batch.
struct EcsSparseSetsV2 {
    component_ids: Vec<i32>,
    set_lens: Vec<i32>,
    drop_ids: Vec<i32>,
}

fn ecs_sparse_sets_v2_new() -> EcsSparseSetsV2 {
    let s = EcsSparseSetsV2 { component_ids: Vec::new(), set_lens: Vec::new(), drop_ids: Vec::new() };
    return s;
}

fn ecs_sparse_sets_v2_len(s: EcsSparseSetsV2) -> i32 { return len(s.component_ids) as i32; }
fn ecs_sparse_sets_v2_is_empty(s: EcsSparseSetsV2) -> bool { return len(s.component_ids) as i32 == 0; }

// get_or_insert_with: registers a sparse set for a component id and returns its index.
fn ecs_sparse_sets_v2_get_or_insert(s: EcsSparseSetsV2, component_id: i32, drop_id: i32) -> (EcsSparseSetsV2, i32) {
    let idx: i32 = 0;
    let n: i32 = len(s.component_ids) as i32;
    while idx < n {
        if s.component_ids[idx] == component_id {
            return (s, idx);
        };
        idx = idx + 1;
    }
    s.component_ids.push(component_id);
    s.set_lens.push(0);
    s.drop_ids.push(drop_id);
    return (s, len(s.component_ids) as i32 - 1);
}

fn ecs_sparse_sets_v2_get_index(s: EcsSparseSetsV2, component_id: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(s.component_ids) as i32;
    while idx < n {
        if s.component_ids[idx] == component_id {
            return (true, idx);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

fn ecs_sparse_sets_v2_push(s: EcsSparseSetsV2, index: i32) -> EcsSparseSetsV2 {
    if index >= 0 && index < len(s.set_lens) as i32 {
        s.set_lens[index] = s.set_lens[index] + 1;
    };
    return s;
}

fn ecs_sparse_sets_v2_set_len(s: EcsSparseSetsV2, index: i32) -> i32 {
    if index < 0 || index >= len(s.set_lens) as i32 {
        return 0;
    };
    return s.set_lens[index];
}
