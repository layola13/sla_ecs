// Deepened Bevy ECS Never surface.
// Mirrors src/never.rs:
//   type Never = <fn() -> ! as FnRet>::Output
//   FnRet trait naming hack for stable never type
// SLA has no true uninhabited type; model Never as uninhabited facade +
// absurd eliminators + function-return-type metadata used by System/IntoSystem.
// Shallow lib/never.sla retained.

const ECS_NEVER_TYPE_ID: i64 = 78001;
const ECS_NEVER_FN_RET_MARKER: i64 = 78002;

fn ecs_never_deep_type_id() -> i64 { return ECS_NEVER_TYPE_ID; }
fn ecs_never_deep_fn_ret_marker() -> i64 { return ECS_NEVER_FN_RET_MARKER; }

fn ecs_never_deep_is_uninhabited() -> bool { return true; }
fn ecs_never_deep_can_construct() -> bool { return false; }
fn ecs_never_deep_is_zero_sized_model() -> bool { return true; }

// FnRet-like associated output naming: fn() -> R has Output = R;
// for never, Output is Never (uninhabited).
struct EcsNeverFnRetDeep {
    // 0 = ordinary R, 1 = Never output
    output_kind: i32,
    ordinary_type_id: i64,
}

fn ecs_never_fn_ret_ordinary(type_id: i64) -> EcsNeverFnRetDeep {
    return EcsNeverFnRetDeep { output_kind: 0, ordinary_type_id: type_id };
}

fn ecs_never_fn_ret_never() -> EcsNeverFnRetDeep {
    return EcsNeverFnRetDeep { output_kind: 1, ordinary_type_id: ECS_NEVER_TYPE_ID };
}

fn ecs_never_fn_ret_is_never(f: EcsNeverFnRetDeep) -> bool {
    return f.output_kind == 1;
}

fn ecs_never_fn_ret_output_type_id(f: EcsNeverFnRetDeep) -> i64 {
    if f.output_kind == 1 {
        return ECS_NEVER_TYPE_ID;
    };
    return f.ordinary_type_id;
}

// System-facing: panicking closure return type resolves to Never
struct EcsNeverSystemCompatDeep {
    accepts_never_output: bool,
    panicking_ok: bool,
}

fn ecs_never_system_compat_new() -> EcsNeverSystemCompatDeep {
    return EcsNeverSystemCompatDeep {
        accepts_never_output: true,
        panicking_ok: true,
    };
}

fn ecs_never_system_accepts(c: EcsNeverSystemCompatDeep, fn_ret: EcsNeverFnRetDeep) -> bool {
    if ecs_never_fn_ret_is_never(fn_ret) {
        return c.accepts_never_output;
    };
    return true;
}

// Absurd eliminators — only callable if a Never value exists (it cannot)
struct EcsNeverDeep {}

fn ecs_never_deep_absurd_i64(n: EcsNeverDeep) -> i64 {
    let _u = n;
    panic(110600);
    return 0;
}

fn ecs_never_deep_absurd_bool(n: EcsNeverDeep) -> bool {
    let _u = n;
    panic(110601);
    return false;
}

// Match empty: from Never, any type (modeled as type_id passthrough without value)
fn ecs_never_deep_match_empty_type_id(target_type_id: i64) -> i64 {
    // No Never value required for the type-level statement; runtime unreachable
    return target_type_id;
}

fn ecs_never_deep_debug_name_id() -> i64 {
    return ECS_NEVER_TYPE_ID;
}

// Equality of type ids for IntoSystem panic-closure path
fn ecs_never_deep_type_eq(a: i64, b: i64) -> bool {
    return a == b;
}
