// Deepened Bevy ECS EntityMut surface.
// Mirrors src/world/entity_access/entity_mut.rs:
//   reborrow / into_readonly / as_readonly / into_filtered
//   id / location / archetype / spawned_by / spawn_tick
//   contains / contains_id / contains_type_id
//   get / get_ref / get_mut / into_mut / into_borrow / into_ref
//   get_change_ticks / get_change_ticks_by_id / get_by_id
//   insert/remove modeled as storage ops for test setup (EntityMut itself is view-only;
//   value mutation via get_mut/set is the Mut path)
//   PartialEq / Ord by entity id
// Fixed capacity: 4 component slots. Shallow lib/entity_mut.sla retained.

struct EcsEmDeep {
    entity: i64,
    archetype_id: i64,
    location_row: i64,
    spawned_by: i64,
    spawn_tick: i64,
    c0: i32, v0: i64, add0: i64, ch0: i64,
    c1: i32, v1: i64, add1: i64, ch1: i64,
    c2: i32, v2: i64, add2: i64, ch2: i64,
    c3: i32, v3: i64, add3: i64, ch3: i64,
    len: i32,
    // into_filtered write_all marker
    filtered: bool,
}

fn ecs_em_deep_new(entity: i64) -> EcsEmDeep {
    return EcsEmDeep {
        entity: entity, archetype_id: 0, location_row: 0, spawned_by: 0, spawn_tick: 0,
        c0: -1, v0: 0, add0: 0, ch0: 0,
        c1: -1, v1: 0, add1: 0, ch1: 0,
        c2: -1, v2: 0, add2: 0, ch2: 0,
        c3: -1, v3: 0, add3: 0, ch3: 0,
        len: 0, filtered: false,
    };
}

fn ecs_em_deep_id(m: EcsEmDeep) -> i64 { return m.entity; }
fn ecs_em_deep_archetype(m: EcsEmDeep) -> i64 { return m.archetype_id; }
fn ecs_em_deep_location_row(m: EcsEmDeep) -> i64 { return m.location_row; }
fn ecs_em_deep_spawned_by(m: EcsEmDeep) -> i64 { return m.spawned_by; }
fn ecs_em_deep_spawn_tick(m: EcsEmDeep) -> i64 { return m.spawn_tick; }
fn ecs_em_deep_len(m: EcsEmDeep) -> i32 { return m.len; }
fn ecs_em_deep_is_filtered(m: EcsEmDeep) -> bool { return m.filtered; }

fn ecs_em_deep_rebuild(
    entity: i64, archetype_id: i64, location_row: i64, spawned_by: i64, spawn_tick: i64,
    c0: i32, v0: i64, add0: i64, ch0: i64,
    c1: i32, v1: i64, add1: i64, ch1: i64,
    c2: i32, v2: i64, add2: i64, ch2: i64,
    c3: i32, v3: i64, add3: i64, ch3: i64,
    len: i32, filtered: bool
) -> EcsEmDeep {
    return EcsEmDeep {
        entity: entity, archetype_id: archetype_id, location_row: location_row,
        spawned_by: spawned_by, spawn_tick: spawn_tick,
        c0: c0, v0: v0, add0: add0, ch0: ch0,
        c1: c1, v1: v1, add1: add1, ch1: ch1,
        c2: c2, v2: v2, add2: add2, ch2: ch2,
        c3: c3, v3: v3, add3: add3, ch3: ch3,
        len: len, filtered: filtered,
    };
}

fn ecs_em_deep_with_meta(m: EcsEmDeep, archetype_id: i64, location_row: i64, spawned_by: i64, spawn_tick: i64) -> EcsEmDeep {
    return ecs_em_deep_rebuild(
        m.entity, archetype_id, location_row, spawned_by, spawn_tick,
        m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
        m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3,
        m.len, m.filtered
    );
}

fn ecs_em_deep_insert(m: EcsEmDeep, cid: i32, value: i64, add_tick: i64, ch_tick: i64) -> EcsEmDeep {
    if m.len >= 1 {
        if m.c0 == cid {
            return ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, value, add_tick, ch_tick, m.c1, m.v1, m.add1, m.ch1,
                m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, m.len, m.filtered
            );
        };
    };
    if m.len >= 2 {
        if m.c1 == cid {
            return ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, m.v0, m.add0, m.ch0, m.c1, value, add_tick, ch_tick,
                m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, m.len, m.filtered
            );
        };
    };
    if m.len >= 3 {
        if m.c2 == cid {
            return ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
                m.c2, value, add_tick, ch_tick, m.c3, m.v3, m.add3, m.ch3, m.len, m.filtered
            );
        };
    };
    if m.len >= 4 {
        if m.c3 == cid {
            return ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
                m.c2, m.v2, m.add2, m.ch2, m.c3, value, add_tick, ch_tick, m.len, m.filtered
            );
        };
    };
    if m.len == 0 {
        return ecs_em_deep_rebuild(
            m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
            cid, value, add_tick, ch_tick, m.c1, m.v1, m.add1, m.ch1,
            m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, 1, m.filtered
        );
    };
    if m.len == 1 {
        return ecs_em_deep_rebuild(
            m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
            m.c0, m.v0, m.add0, m.ch0, cid, value, add_tick, ch_tick,
            m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, 2, m.filtered
        );
    };
    if m.len == 2 {
        return ecs_em_deep_rebuild(
            m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
            m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
            cid, value, add_tick, ch_tick, m.c3, m.v3, m.add3, m.ch3, 3, m.filtered
        );
    };
    if m.len == 3 {
        return ecs_em_deep_rebuild(
            m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
            m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
            m.c2, m.v2, m.add2, m.ch2, cid, value, add_tick, ch_tick, 4, m.filtered
        );
    };
    return m;
}

struct EcsEmGet {
    found: bool,
    value: i64,
    added: i64,
    changed: i64,
}

fn ecs_em_get_found(r: EcsEmGet) -> bool { return r.found; }
fn ecs_em_get_value(r: EcsEmGet) -> i64 { return r.value; }
fn ecs_em_get_added(r: EcsEmGet) -> i64 { return r.added; }
fn ecs_em_get_changed(r: EcsEmGet) -> i64 { return r.changed; }

fn ecs_em_deep_raw_get(m: EcsEmDeep, cid: i32) -> EcsEmGet {
    if m.len >= 1 {
        if m.c0 == cid { return EcsEmGet { found: true, value: m.v0, added: m.add0, changed: m.ch0 }; };
    };
    if m.len >= 2 {
        if m.c1 == cid { return EcsEmGet { found: true, value: m.v1, added: m.add1, changed: m.ch1 }; };
    };
    if m.len >= 3 {
        if m.c2 == cid { return EcsEmGet { found: true, value: m.v2, added: m.add2, changed: m.ch2 }; };
    };
    if m.len >= 4 {
        if m.c3 == cid { return EcsEmGet { found: true, value: m.v3, added: m.add3, changed: m.ch3 }; };
    };
    return EcsEmGet { found: false, value: 0, added: 0, changed: 0 };
}

fn ecs_em_deep_contains(m: EcsEmDeep, cid: i32) -> bool {
    let g = ecs_em_deep_raw_get(m, cid);
    return ecs_em_get_found(g);
}
fn ecs_em_deep_contains_id(m: EcsEmDeep, cid: i32) -> bool { return ecs_em_deep_contains(m, cid); }
fn ecs_em_deep_contains_type_id(m: EcsEmDeep, tid: i32) -> bool { return ecs_em_deep_contains(m, tid); }

fn ecs_em_deep_get(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }
fn ecs_em_deep_get_ref(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }
fn ecs_em_deep_get_mut(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }
fn ecs_em_deep_get_by_id(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }

fn ecs_em_deep_get_change_ticks(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }
fn ecs_em_deep_get_change_ticks_by_id(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }

// set via mut path: update value + changed tick
struct EcsEmSetResult {
    view: EcsEmDeep,
    ok: bool,
}

fn ecs_em_set_view(r: EcsEmSetResult) -> EcsEmDeep { return r.view; }
fn ecs_em_set_ok(r: EcsEmSetResult) -> bool { return r.ok; }

fn ecs_em_deep_set(m: EcsEmDeep, cid: i32, value: i64, ch_tick: i64) -> EcsEmSetResult {
    if ecs_em_deep_contains(m, cid) != true {
        return EcsEmSetResult { view: m, ok: false };
    };
    let g = ecs_em_deep_raw_get(m, cid);
    let m2 = ecs_em_deep_insert(m, cid, value, ecs_em_get_added(g), ch_tick);
    return EcsEmSetResult { view: m2, ok: true };
}

// into_mut / into_borrow / into_ref: consume view, return component if present
fn ecs_em_deep_into_mut(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }
fn ecs_em_deep_into_borrow(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }
fn ecs_em_deep_into_ref(m: EcsEmDeep, cid: i32) -> EcsEmGet { return ecs_em_deep_raw_get(m, cid); }

fn ecs_em_deep_reborrow(m: EcsEmDeep) -> EcsEmDeep {
    return ecs_em_deep_rebuild(
        m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
        m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
        m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, m.len, m.filtered
    );
}

// EntityRef deep companion from into_readonly / as_readonly
struct EcsEmRefDeep {
    entity: i64,
    archetype_id: i64,
    location_row: i64,
    spawned_by: i64,
    spawn_tick: i64,
    c0: i32, v0: i64, add0: i64, ch0: i64,
    c1: i32, v1: i64, add1: i64, ch1: i64,
    c2: i32, v2: i64, add2: i64, ch2: i64,
    c3: i32, v3: i64, add3: i64, ch3: i64,
    len: i32,
}

fn ecs_em_ref_deep_id(r: EcsEmRefDeep) -> i64 { return r.entity; }
fn ecs_em_ref_deep_len(r: EcsEmRefDeep) -> i32 { return r.len; }

fn ecs_em_deep_into_readonly(m: EcsEmDeep) -> EcsEmRefDeep {
    return EcsEmRefDeep {
        entity: m.entity, archetype_id: m.archetype_id, location_row: m.location_row,
        spawned_by: m.spawned_by, spawn_tick: m.spawn_tick,
        c0: m.c0, v0: m.v0, add0: m.add0, ch0: m.ch0,
        c1: m.c1, v1: m.v1, add1: m.add1, ch1: m.ch1,
        c2: m.c2, v2: m.v2, add2: m.add2, ch2: m.ch2,
        c3: m.c3, v3: m.v3, add3: m.add3, ch3: m.ch3,
        len: m.len,
    };
}

fn ecs_em_deep_as_readonly(m: EcsEmDeep) -> EcsEmRefDeep {
    return ecs_em_deep_into_readonly(m);
}

fn ecs_em_ref_deep_get(r: EcsEmRefDeep, cid: i32) -> EcsEmGet {
    if r.len >= 1 {
        if r.c0 == cid { return EcsEmGet { found: true, value: r.v0, added: r.add0, changed: r.ch0 }; };
    };
    if r.len >= 2 {
        if r.c1 == cid { return EcsEmGet { found: true, value: r.v1, added: r.add1, changed: r.ch1 }; };
    };
    if r.len >= 3 {
        if r.c2 == cid { return EcsEmGet { found: true, value: r.v2, added: r.add2, changed: r.ch2 }; };
    };
    if r.len >= 4 {
        if r.c3 == cid { return EcsEmGet { found: true, value: r.v3, added: r.add3, changed: r.ch3 }; };
    };
    return EcsEmGet { found: false, value: 0, added: 0, changed: 0 };
}

// into_filtered: write_all FilteredEntityMut marker
fn ecs_em_deep_into_filtered(m: EcsEmDeep) -> EcsEmDeep {
    return ecs_em_deep_rebuild(
        m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
        m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
        m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, m.len, true
    );
}

// components list count already via len; component id at index
fn ecs_em_deep_component_at(m: EcsEmDeep, idx: i32) -> i32 {
    if idx == 0 { return m.c0; };
    if idx == 1 { return m.c1; };
    if idx == 2 { return m.c2; };
    if idx == 3 { return m.c3; };
    return -1;
}

fn ecs_em_deep_eq(a: EcsEmDeep, b: EcsEmDeep) -> bool {
    if a.entity == b.entity { return true; };
    return false;
}

fn ecs_em_deep_cmp(a: EcsEmDeep, b: EcsEmDeep) -> i32 {
    if a.entity < b.entity { return -1; };
    if a.entity > b.entity { return 1; };
    return 0;
}

// remove component (swap-remove) for setup / EntityWorldMut-like convenience
struct EcsEmRemoveResult {
    view: EcsEmDeep,
    removed: bool,
    value: i64,
}

fn ecs_em_remove_view(r: EcsEmRemoveResult) -> EcsEmDeep { return r.view; }
fn ecs_em_remove_ok(r: EcsEmRemoveResult) -> bool { return r.removed; }
fn ecs_em_remove_value(r: EcsEmRemoveResult) -> i64 { return r.value; }

fn ecs_em_deep_remove(m: EcsEmDeep, cid: i32) -> EcsEmRemoveResult {
    if m.len >= 1 {
        if m.c0 == cid {
            // move last into slot 0 if needed
            if m.len == 1 {
                let m2 = ecs_em_deep_rebuild(
                    m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                    -1, 0, 0, 0, m.c1, m.v1, m.add1, m.ch1,
                    m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, 0, m.filtered
                );
                return EcsEmRemoveResult { view: m2, removed: true, value: m.v0 };
            };
            if m.len == 2 {
                let m2 = ecs_em_deep_rebuild(
                    m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                    m.c1, m.v1, m.add1, m.ch1, -1, 0, 0, 0,
                    m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, 1, m.filtered
                );
                return EcsEmRemoveResult { view: m2, removed: true, value: m.v0 };
            };
            if m.len == 3 {
                let m2 = ecs_em_deep_rebuild(
                    m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                    m.c2, m.v2, m.add2, m.ch2, m.c1, m.v1, m.add1, m.ch1,
                    -1, 0, 0, 0, m.c3, m.v3, m.add3, m.ch3, 2, m.filtered
                );
                return EcsEmRemoveResult { view: m2, removed: true, value: m.v0 };
            };
            let m2 = ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c3, m.v3, m.add3, m.ch3, m.c1, m.v1, m.add1, m.ch1,
                m.c2, m.v2, m.add2, m.ch2, -1, 0, 0, 0, 3, m.filtered
            );
            return EcsEmRemoveResult { view: m2, removed: true, value: m.v0 };
        };
    };
    if m.len >= 2 {
        if m.c1 == cid {
            if m.len == 2 {
                let m2 = ecs_em_deep_rebuild(
                    m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                    m.c0, m.v0, m.add0, m.ch0, -1, 0, 0, 0,
                    m.c2, m.v2, m.add2, m.ch2, m.c3, m.v3, m.add3, m.ch3, 1, m.filtered
                );
                return EcsEmRemoveResult { view: m2, removed: true, value: m.v1 };
            };
            if m.len == 3 {
                let m2 = ecs_em_deep_rebuild(
                    m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                    m.c0, m.v0, m.add0, m.ch0, m.c2, m.v2, m.add2, m.ch2,
                    -1, 0, 0, 0, m.c3, m.v3, m.add3, m.ch3, 2, m.filtered
                );
                return EcsEmRemoveResult { view: m2, removed: true, value: m.v1 };
            };
            let m2 = ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, m.v0, m.add0, m.ch0, m.c3, m.v3, m.add3, m.ch3,
                m.c2, m.v2, m.add2, m.ch2, -1, 0, 0, 0, 3, m.filtered
            );
            return EcsEmRemoveResult { view: m2, removed: true, value: m.v1 };
        };
    };
    if m.len >= 3 {
        if m.c2 == cid {
            if m.len == 3 {
                let m2 = ecs_em_deep_rebuild(
                    m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                    m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
                    -1, 0, 0, 0, m.c3, m.v3, m.add3, m.ch3, 2, m.filtered
                );
                return EcsEmRemoveResult { view: m2, removed: true, value: m.v2 };
            };
            let m2 = ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
                m.c3, m.v3, m.add3, m.ch3, -1, 0, 0, 0, 3, m.filtered
            );
            return EcsEmRemoveResult { view: m2, removed: true, value: m.v2 };
        };
    };
    if m.len >= 4 {
        if m.c3 == cid {
            let m2 = ecs_em_deep_rebuild(
                m.entity, m.archetype_id, m.location_row, m.spawned_by, m.spawn_tick,
                m.c0, m.v0, m.add0, m.ch0, m.c1, m.v1, m.add1, m.ch1,
                m.c2, m.v2, m.add2, m.ch2, -1, 0, 0, 0, 3, m.filtered
            );
            return EcsEmRemoveResult { view: m2, removed: true, value: m.v3 };
        };
    };
    return EcsEmRemoveResult { view: m, removed: false, value: 0 };
}
