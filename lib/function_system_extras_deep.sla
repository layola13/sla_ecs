// Deepened Bevy ECS function_system extras.
// Mirrors src/system/function_system.rs SystemState + FunctionSystem builders + markers.
// Scalar rebuild model. Shallow lib/function_system_extras.sla retained.

struct EcsFsStateDeep {
    param_id: i64,
    initialized: bool,
    world_id: i64,
    last_run_tick: i32,
    cached_value: i64,
}

fn ecs_fse_state_new(param_id: i64, world_id: i64, change_tick: i32) -> EcsFsStateDeep {
    return EcsFsStateDeep {
        param_id: param_id, initialized: true, world_id: world_id,
        last_run_tick: change_tick, cached_value: 0,
    };
}

fn ecs_fse_state_from_builder(param_id: i64, world_id: i64, change_tick: i32) -> EcsFsStateDeep {
    return ecs_fse_state_new(param_id, world_id, change_tick);
}

fn ecs_fse_state_param(s: EcsFsStateDeep) -> i64 { return s.param_id; }
fn ecs_fse_state_world(s: EcsFsStateDeep) -> i64 { return s.world_id; }
fn ecs_fse_state_tick(s: EcsFsStateDeep) -> i32 { return s.last_run_tick; }
fn ecs_fse_state_initialized(s: EcsFsStateDeep) -> bool { return s.initialized; }
fn ecs_fse_state_cached(s: EcsFsStateDeep) -> i64 { return s.cached_value; }

fn ecs_fse_state_rebuild(param_id: i64, initialized: bool, world_id: i64, last_run_tick: i32, cached_value: i64) -> EcsFsStateDeep {
    return EcsFsStateDeep {
        param_id: param_id, initialized: initialized, world_id: world_id,
        last_run_tick: last_run_tick, cached_value: cached_value,
    };
}

fn ecs_fse_state_set_tick(s: EcsFsStateDeep, tick: i32) -> EcsFsStateDeep {
    return ecs_fse_state_rebuild(s.param_id, s.initialized, s.world_id, tick, s.cached_value);
}

fn ecs_fse_state_set_cached(s: EcsFsStateDeep, value: i64) -> EcsFsStateDeep {
    return ecs_fse_state_rebuild(s.param_id, true, s.world_id, s.last_run_tick, value);
}

fn ecs_fse_state_apply(s: EcsFsStateDeep, applied: i64) -> EcsFsStateDeep {
    return ecs_fse_state_set_cached(s, applied);
}

fn ecs_fse_state_matches_world(s: EcsFsStateDeep, world_id: i64) -> bool {
    return s.world_id == world_id;
}

struct EcsFsDeep {
    name_id: i64,
    last_run_tick: i32,
    initialized: bool,
    exclusive: bool,
    non_send: bool,
    last_output: i64,
    run_count: i64,
    input_value: i64,
}

fn ecs_fse_new(name_id: i64, tick: i32) -> EcsFsDeep {
    return EcsFsDeep {
        name_id: name_id, last_run_tick: tick, initialized: false,
        exclusive: false, non_send: false, last_output: 0, run_count: 0, input_value: 0,
    };
}

fn ecs_fse_rebuild(
    name_id: i64, last_run_tick: i32, initialized: bool, exclusive: bool, non_send: bool,
    last_output: i64, run_count: i64, input_value: i64
) -> EcsFsDeep {
    return EcsFsDeep {
        name_id: name_id, last_run_tick: last_run_tick, initialized: initialized,
        exclusive: exclusive, non_send: non_send, last_output: last_output,
        run_count: run_count, input_value: input_value,
    };
}

fn ecs_fse_build_system(state: EcsFsStateDeep, system_id: i64) -> EcsFsDeep {
    return ecs_fse_new(system_id, state.last_run_tick);
}

fn ecs_fse_build_system_with_input(state: EcsFsStateDeep, system_id: i64, input: i64) -> EcsFsDeep {
    let fs = ecs_fse_new(system_id, state.last_run_tick);
    return ecs_fse_rebuild(fs.name_id, fs.last_run_tick, fs.initialized, fs.exclusive, fs.non_send, fs.last_output, fs.run_count, input);
}

fn ecs_fse_build_any_system(state: EcsFsStateDeep, system_id: i64) -> EcsFsDeep {
    return ecs_fse_build_system(state, system_id);
}

fn ecs_fse_name(fs: EcsFsDeep) -> i64 { return fs.name_id; }
fn ecs_fse_tick(fs: EcsFsDeep) -> i32 { return fs.last_run_tick; }
fn ecs_fse_is_initialized(fs: EcsFsDeep) -> bool { return fs.initialized; }
fn ecs_fse_is_exclusive(fs: EcsFsDeep) -> bool { return fs.exclusive; }
fn ecs_fse_is_non_send(fs: EcsFsDeep) -> bool { return fs.non_send; }
fn ecs_fse_last_output(fs: EcsFsDeep) -> i64 { return fs.last_output; }
fn ecs_fse_run_count(fs: EcsFsDeep) -> i64 { return fs.run_count; }
fn ecs_fse_input(fs: EcsFsDeep) -> i64 { return fs.input_value; }

fn ecs_fse_with_name(fs: EcsFsDeep, new_name: i64) -> EcsFsDeep {
    return ecs_fse_rebuild(new_name, fs.last_run_tick, fs.initialized, fs.exclusive, fs.non_send, fs.last_output, fs.run_count, fs.input_value);
}

fn ecs_fse_initialize(fs: EcsFsDeep) -> EcsFsDeep {
    return ecs_fse_rebuild(fs.name_id, fs.last_run_tick, true, fs.exclusive, fs.non_send, fs.last_output, fs.run_count, fs.input_value);
}

fn ecs_fse_run(fs: EcsFsDeep, output: i64) -> EcsFsDeep {
    return ecs_fse_rebuild(fs.name_id, fs.last_run_tick, fs.initialized, fs.exclusive, fs.non_send, output, fs.run_count + 1, fs.input_value);
}

fn ecs_fse_with_input(fs: EcsFsDeep, input: i64) -> EcsFsDeep {
    return ecs_fse_rebuild(fs.name_id, fs.last_run_tick, fs.initialized, fs.exclusive, fs.non_send, fs.last_output, fs.run_count, input);
}

fn ecs_fse_set_exclusive(fs: EcsFsDeep) -> EcsFsDeep {
    return ecs_fse_rebuild(fs.name_id, fs.last_run_tick, fs.initialized, true, fs.non_send, fs.last_output, fs.run_count, fs.input_value);
}

fn ecs_fse_set_non_send(fs: EcsFsDeep) -> EcsFsDeep {
    return ecs_fse_rebuild(fs.name_id, fs.last_run_tick, fs.initialized, fs.exclusive, true, fs.last_output, fs.run_count, fs.input_value);
}

fn ecs_fse_set_last_run(fs: EcsFsDeep, tick: i32) -> EcsFsDeep {
    return ecs_fse_rebuild(fs.name_id, tick, fs.initialized, fs.exclusive, fs.non_send, fs.last_output, fs.run_count, fs.input_value);
}

// markers
struct EcsFsIsFnDeep { tag: i32 }
struct EcsFsHasInputDeep { tag: i32 }

fn ecs_fse_is_fn_marker() -> EcsFsIsFnDeep { return EcsFsIsFnDeep { tag: 1 }; }
fn ecs_fse_has_input_marker() -> EcsFsHasInputDeep { return EcsFsHasInputDeep { tag: 1 }; }
fn ecs_fse_is_fn_tag(m: EcsFsIsFnDeep) -> i32 { return m.tag; }
fn ecs_fse_has_input_tag(m: EcsFsHasInputDeep) -> i32 { return m.tag; }
