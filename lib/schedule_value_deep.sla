    if idx == 0 { s.sys_ct_0 = v; return s; };
    if idx == 1 { s.sys_ct_1 = v; return s; };
    if idx == 2 { s.sys_ct_2 = v; return s; };
    if idx == 3 { s.sys_ct_3 = v; return s; };
    if idx == 4 { s.sys_ct_4 = v; return s; };
