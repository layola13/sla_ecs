// Deep self-contained Bevy ECS Schedule value struct + lifecycle API.
// Mirrors lib/schedule_value.sla (406 lines) with fixed-cap (cap-16) scalar slot families.
// No @import.
// Per docs/issue.md and Batches 401/402, the nested EcsScheduleExecutable struct is flattened
// inline into EcsSchedule (no nested-struct access), and every returned tuple is replaced by
// a flat wrapper struct whose fields are scalars. All structs carry @derive(copy).

const ECS_SCHEDULE_DEEP_CAP: i32 = 16;
const ECS_SCHED_DEEP_EXEC_MULTI: i32 = 0;
const ECS_SCHED_DEEP_EXEC_SINGLE: i32 = 1;

const ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS: i32 = 0;
const ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY: i32 = 1;
const ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS_ALLOW_BREAKAGES: i32 = 2;
const ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY_ALLOW_BREAKAGES: i32 = 3;

// EcsScheduleDeep: flattened schedule executable fields directly inside (no nested struct).
@derive(copy)
struct EcsScheduleDeep {
    label: i64,
    graph_changed: i32,
    executor_kind: i32,
    apply_final_deferred: i32,
    executor_initialized: i32,
    build_settings_ambiguity: i32,
    build_settings_hierarchy: i32,
    build_settings_auto_insert: i32,

    // EcsScheduleExecutable flattened: per-system and per-set slot families (cap-16)
    sys_ids_0: i64, sys_ids_1: i64, sys_ids_2: i64, sys_ids_3: i64, sys_ids_4: i64, sys_ids_5: i64, sys_ids_6: i64, sys_ids_7: i64,
    sys_ids_8: i64, sys_ids_9: i64, sys_ids_10: i64, sys_ids_11: i64, sys_ids_12: i64, sys_ids_13: i64, sys_ids_14: i64, sys_ids_15: i64,
    sys_ids_n: i32,

    sys_cc_0: i64, sys_cc_1: i64, sys_cc_2: i64, sys_cc_3: i64, sys_cc_4: i64, sys_cc_5: i64, sys_cc_6: i64, sys_cc_7: i64,
    sys_cc_8: i64, sys_cc_9: i64, sys_cc_10: i64, sys_cc_11: i64, sys_cc_12: i64, sys_cc_13: i64, sys_cc_14: i64, sys_cc_15: i64,

    sys_lr_0: i64, sys_lr_1: i64, sys_lr_2: i64, sys_lr_3: i64, sys_lr_4: i64, sys_lr_5: i64, sys_lr_6: i64, sys_lr_7: i64,
    sys_lr_8: i64, sys_lr_9: i64, sys_lr_10: i64, sys_lr_11: i64, sys_lr_12: i64, sys_lr_13: i64, sys_lr_14: i64, sys_lr_15: i64,

    sys_ct_0: i64, sys_ct_1: i64, sys_ct_2: i64, sys_ct_3: i64, sys_ct_4: i64, sys_ct_5: i64, sys_ct_6: i64, sys_ct_7: i64,
    sys_ct_8: i64, sys_ct_9: i64, sys_ct_10: i64, sys_ct_11: i64, sys_ct_12: i64, sys_ct_13: i64, sys_ct_14: i64, sys_ct_15: i64,

    set_ids_0: i64, set_ids_1: i64, set_ids_2: i64, set_ids_3: i64, set_ids_4: i64, set_ids_5: i64, set_ids_6: i64, set_ids_7: i64,
    set_ids_8: i64, set_ids_9: i64, set_ids_10: i64, set_ids_11: i64, set_ids_12: i64, set_ids_13: i64, set_ids_14: i64, set_ids_15: i64,
    set_ids_n: i32,

    set_cc_0: i64, set_cc_1: i64, set_cc_2: i64, set_cc_3: i64, set_cc_4: i64, set_cc_5: i64, set_cc_6: i64, set_cc_7: i64,
    set_cc_8: i64, set_cc_9: i64, set_cc_10: i64, set_cc_11: i64, set_cc_12: i64, set_cc_13: i64, set_cc_14: i64, set_cc_15: i64,

    built_system_count: i64,
    built_set_count: i64,
}

// Helper accessors for the cap-16 slot families. We avoid panic calls inside pure getters —
// lookup helpers panic on out-of-range.
fn _eis_sys_ids_at(s: EcsScheduleDeep, idx: i32) -> i64 {
    if idx == 0 { return s.sys_ids_0; };
    if idx == 1 { return s.sys_ids_1; };
    if idx == 2 { return s.sys_ids_2; };
    if idx == 3 { return s.sys_ids_3; };
    if idx == 4 { return s.sys_ids_4; };
    if idx == 5 { return s.sys_ids_5; };
    if idx == 6 { return s.sys_ids_6; };
    if idx == 7 { return s.sys_ids_7; };
    if idx == 8 { return s.sys_ids_8; };
    if idx == 9 { return s.sys_ids_9; };
    if idx == 10 { return s.sys_ids_10; };
    if idx == 11 { return s.sys_ids_11; };
    if idx == 12 { return s.sys_ids_12; };
    if idx == 13 { return s.sys_ids_13; };
    if idx == 14 { return s.sys_ids_14; };
    if idx == 15 { return s.sys_ids_15; };
    panic(144900);
}

fn _eis_sys_ids_set(s: EcsScheduleDeep, idx: i32, v: i64) -> EcsScheduleDeep {
    if idx == 0 { s.sys_ids_0 = v; return s; };
    if idx == 1 { s.sys_ids_1 = v; return s; };
    if idx == 2 { s.sys_ids_2 = v; return s; };
    if idx == 3 { s.sys_ids_3 = v; return s; };
    if idx == 4 { s.sys_ids_4 = v; return s; };
    if idx == 5 { s.sys_ids_5 = v; return s; };
    if idx == 6 { s.sys_ids_6 = v; return s; };
    if idx == 7 { s.sys_ids_7 = v; return s; };
    if idx == 8 { s.sys_ids_8 = v; return s; };
    if idx == 9 { s.sys_ids_9 = v; return s; };
    if idx == 10 { s.sys_ids_10 = v; return s; };
    if idx == 11 { s.sys_ids_11 = v; return s; };
    if idx == 12 { s.sys_ids_12 = v; return s; };
    if idx == 13 { s.sys_ids_13 = v; return s; };
    if idx == 14 { s.sys_ids_14 = v; return s; };
    if idx == 15 { s.sys_ids_15 = v; return s; };
    panic(144901);
}

fn _eis_sys_cc_set(s: EcsScheduleDeep, idx: i32, v: i64) -> EcsScheduleDeep {
    if idx == 0 { s.sys_cc_0 = v; return s; };
    if idx == 1 { s.sys_cc_1 = v; return s; };
    if idx == 2 { s.sys_cc_2 = v; return s; };
    if idx == 3 { s.sys_cc_3 = v; return s; };
    if idx == 4 { s.sys_cc_4 = v; return s; };
    if idx == 5 { s.sys_cc_5 = v; return s; };
    if idx == 6 { s.sys_cc_6 = v; return s; };
    if idx == 7 { s.sys_cc_7 = v; return s; };
    if idx == 8 { s.sys_cc_8 = v; return s; };
    if idx == 9 { s.sys_cc_9 = v; return s; };
    if idx == 10 { s.sys_cc_10 = v; return s; };
    if idx == 11 { s.sys_cc_11 = v; return s; };
    if idx == 12 { s.sys_cc_12 = v; return s; };
    if idx == 13 { s.sys_cc_13 = v; return s; };
    if idx == 14 { s.sys_cc_14 = v; return s; };
