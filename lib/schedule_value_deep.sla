fn ecs_schedule_deep_new(label: i64) -> EcsScheduleDeep {
    return EcsScheduleDeep {
        label: label,
        graph_changed: 1,
        executor_kind: ECS_SCHED_DEEP_EXEC_MULTI,
        apply_final_deferred: 1,
        executor_initialized: 0,
        build_settings_ambiguity: 0,
        build_settings_hierarchy: 0,
        build_settings_auto_insert: 1,
        sys_ids_0: 0, sys_ids_1: 0, sys_ids_2: 0, sys_ids_3: 0, sys_ids_4: 0, sys_ids_5: 0, sys_ids_6: 0, sys_ids_7: 0,
        sys_ids_8: 0, sys_ids_9: 0, sys_ids_10: 0, sys_ids_11: 0, sys_ids_12: 0, sys_ids_13: 0, sys_ids_14: 0, sys_ids_15: 0,
        sys_ids_n: 0,
        sys_cc_0: 0, sys_cc_1: 0, sys_cc_2: 0, sys_cc_3: 0, sys_cc_4: 0, sys_cc_5: 0, sys_cc_6: 0, sys_cc_7: 0,
        sys_cc_8: 0, sys_cc_9: 0, sys_cc_10: 0, sys_cc_11: 0, sys_cc_12: 0, sys_cc_13: 0, sys_cc_14: 0, sys_cc_15: 0,
        sys_lr_0: 0, sys_lr_1: 0, sys_lr_2: 0, sys_lr_3: 0, sys_lr_4: 0, sys_lr_5: 0, sys_lr_6: 0, sys_lr_7: 0,
        sys_lr_8: 0, sys_lr_9: 0, sys_lr_10: 0, sys_lr_11: 0, sys_lr_12: 0, sys_lr_13: 0, sys_lr_14: 0, sys_lr_15: 0,
        sys_ct_0: 0, sys_ct_1: 0, sys_ct_2: 0, sys_ct_3: 0, sys_ct_4: 0, sys_ct_5: 0, sys_ct_6: 0, sys_ct_7: 0,
        sys_ct_8: 0, sys_ct_9: 0, sys_ct_10: 0, sys_ct_11: 0, sys_ct_12: 0, sys_ct_13: 0, sys_ct_14: 0, sys_ct_15: 0,
        set_ids_0: 0, set_ids_1: 0, set_ids_2: 0, set_ids_3: 0, set_ids_4: 0, set_ids_5: 0, set_ids_6: 0, set_ids_7: 0,
        set_ids_8: 0, set_ids_9: 0, set_ids_10: 0, set_ids_11: 0, set_ids_12: 0, set_ids_13: 0, set_ids_14: 0, set_ids_15: 0,
        set_ids_n: 0,
        set_cc_0: 0, set_cc_1: 0, set_cc_2: 0, set_cc_3: 0, set_cc_4: 0, set_cc_5: 0, set_cc_6: 0, set_cc_7: 0,
        set_cc_8: 0, set_cc_9: 0, set_cc_10: 0, set_cc_11: 0, set_cc_12: 0, set_cc_13: 0, set_cc_14: 0, set_cc_15: 0,
        built_system_count: 0,
        built_set_count: 0,
    };
}

fn ecs_schedule_deep_default() -> EcsScheduleDeep {
    return ecs_schedule_deep_new(0);
}

fn ecs_schedule_deep_is_changed(s: EcsScheduleDeep) -> bool {
    return s.graph_changed != 0;
}

fn ecs_schedule_deep_label(s: EcsScheduleDeep) -> i64 {
    return s.label;
}

fn ecs_schedule_deep_mark_changed(s: EcsScheduleDeep) -> EcsScheduleDeep {
    s.graph_changed = 1;
    s.executor_initialized = 0;
    return s;
}

fn ecs_schedule_deep_set_executor(s: EcsScheduleDeep, executor_kind: i32) -> EcsScheduleDeep {
    s.executor_kind = executor_kind;
    s.executor_initialized = 0;
    return s;
}

fn ecs_schedule_deep_set_apply_final_deferred(s: EcsScheduleDeep, apply_final_deferred: bool) -> EcsScheduleDeep {
    if apply_final_deferred {
        s.apply_final_deferred = 1;
    } else {
        s.apply_final_deferred = 0;
    };
    return s;
}

fn ecs_schedule_deep_add_system(s: EcsScheduleDeep, system_id: i64, condition_count: i64) -> EcsScheduleDeep {
    let idx = s.sys_ids_n;
    if idx >= ECS_SCHEDULE_DEEP_CAP { return ecs_schedule_deep_mark_changed(s); };
    s = _eis_sys_ids_set(s, idx, system_id);
    s = _eis_sys_cc_set(s, idx, condition_count);
    s = _eis_sys_lr_set(s, idx, 0);
    s = _eis_sys_ct_set(s, idx, 0);
    s.sys_ids_n = s.sys_ids_n + 1;
    return ecs_schedule_deep_mark_changed(s);
}

fn ecs_schedule_deep_add_set(s: EcsScheduleDeep, set_id: i64, condition_count: i64) -> EcsScheduleDeep {
    let idx = s.set_ids_n;
    if idx >= ECS_SCHEDULE_DEEP_CAP { return ecs_schedule_deep_mark_changed(s); };
    s = _eis_set_ids_set(s, idx, set_id);
    s = _eis_set_cc_set(s, idx, condition_count);
    s.set_ids_n = s.set_ids_n + 1;
    return ecs_schedule_deep_mark_changed(s);
}

fn ecs_schedule_deep_set_build_settings(s: EcsScheduleDeep, ambiguity_level: i32, hierarchy_level: i32, auto_insert: bool) -> EcsScheduleDeep {
    s.build_settings_ambiguity = ambiguity_level;
    s.build_settings_hierarchy = hierarchy_level;
    if auto_insert { s.build_settings_auto_insert = 1; } else { s.build_settings_auto_insert = 0; };
    return s;
}

fn ecs_schedule_deep_get_build_settings_ambiguity(s: EcsScheduleDeep) -> i32 {
    return s.build_settings_ambiguity;
}

fn ecs_schedule_deep_get_build_settings_hierarchy(s: EcsScheduleDeep) -> i32 {
    return s.build_settings_hierarchy;
}

fn ecs_schedule_deep_get_build_settings_auto_insert(s: EcsScheduleDeep) -> bool {
    return s.build_settings_auto_insert != 0;
}

// Wrapper struct for tuple (EcsSchedule, bool)
@derive(copy)
struct EcsScheduleInitResultDeep {
    graph_changed: i32,
    built_system_count: i64,
    built_set_count: i64,
    initialized: bool,
}

// Alternative initialize that returns the full schedule snapshot (mutated copy),
// mirroring shallow's combined (Schedule, bool) return for callers that need to keep going.
fn ecs_schedule_deep_initialize_inplace(s: EcsScheduleDeep) -> EcsScheduleDeep {
    s.built_system_count = s.sys_ids_n as i64;
    s.built_set_count = s.set_ids_n as i64;
    s.graph_changed = 0;
    s.executor_initialized = 1;
    return s;
}

fn ecs_schedule_deep_initialize(s: EcsScheduleDeep) -> EcsScheduleInitResultDeep {
    s.built_system_count = s.sys_ids_n as i64;
    s.built_set_count = s.set_ids_n as i64;
    s.graph_changed = 0;
    s.executor_initialized = 1;
    return EcsScheduleInitResultDeep {
        graph_changed: s.graph_changed,
        built_system_count: s.built_system_count,
        built_set_count: s.built_set_count,
        initialized: s.executor_initialized != 0,
    };
}

fn ecs_schedule_deep_init_result_initialized(r: EcsScheduleInitResultDeep) -> bool {
    return r.initialized;
}

fn ecs_schedule_deep_init_result_built_system_count(r: EcsScheduleInitResultDeep) -> i64 {
    return r.built_system_count;
}

fn ecs_schedule_deep_init_result_built_set_count(r: EcsScheduleInitResultDeep) -> i64 {
    return r.built_set_count;
}

fn ecs_schedule_deep_init_result_graph_changed(r: EcsScheduleInitResultDeep) -> i32 {
    return r.graph_changed;
}

// Wrapper struct for tuple (EcsSchedule, EcsCheckChangeTicksResult)
@derive(copy)
struct EcsScheduleCheckChangeTicksResultDeep {
    system_count: i64,
    present_tick: i64,
}

fn ecs_schedule_deep_check_change_ticks(s: EcsScheduleDeep, present_tick: i64) -> EcsScheduleCheckChangeTicksResultDeep {
    let n = s.sys_ids_n as i64;
    let idx: i32 = 0;
    while idx < s.sys_ids_n {
        s = _eis_sys_ct_set(s, idx, present_tick);
        idx = idx + 1;
    }
    return EcsScheduleCheckChangeTicksResultDeep {
        system_count: n,
        present_tick: present_tick,
    };
}

fn ecs_schedule_deep_check_change_ticks_system_count(r: EcsScheduleCheckChangeTicksResultDeep) -> i64 {
    return r.system_count;
}

fn ecs_schedule_deep_check_change_ticks_present_tick(r: EcsScheduleCheckChangeTicksResultDeep) -> i64 {
    return r.present_tick;
}

// Wrapper struct for tuple (EcsSchedule, i64) returned by run / apply_deferred
@derive(copy)
struct EcsScheduleRunResultDeep {
    built_system_count: i64,
    initialized: bool,
}

fn ecs_schedule_deep_run(s: EcsScheduleDeep) -> EcsScheduleRunResultDeep {
    let _tick = ecs_schedule_deep_check_change_ticks(s, 1);
    let init = ecs_schedule_deep_initialize(s);
    return EcsScheduleRunResultDeep {
        built_system_count: ecs_schedule_deep_init_result_built_system_count(init),
        initialized: ecs_schedule_deep_init_result_initialized(init),
    };
}

fn ecs_schedule_deep_run_result_built_system_count(r: EcsScheduleRunResultDeep) -> i64 {
    return r.built_system_count;
}

fn ecs_schedule_deep_run_result_initialized(r: EcsScheduleRunResultDeep) -> bool {
    return r.initialized;
}

// Wrapper struct for tuple (EcsSchedule, i64) returned by apply_deferred
@derive(copy)
struct EcsScheduleApplyDeferredResultDeep {
    count: i64,
}

fn ecs_schedule_deep_apply_deferred_result_count(r: EcsScheduleApplyDeferredResultDeep) -> i64 {
    return r.count;
}

fn ecs_schedule_deep_apply_deferred(s: EcsScheduleDeep) -> EcsScheduleApplyDeferredResultDeep {
    let count = s.sys_ids_n as i64;
    return EcsScheduleApplyDeferredResultDeep { count: count };
}

// Wrapper struct for tuple (bool, Vec<i64>) returned by systems()
@derive(copy)
struct EcsScheduleSystemsResultDeep {
    initialized: bool,
    // up to cap-16 ids inlined
    sys_ids_0: i64, sys_ids_1: i64, sys_ids_2: i64, sys_ids_3: i64, sys_ids_4: i64, sys_ids_5: i64, sys_ids_6: i64, sys_ids_7: i64,
    sys_ids_8: i64, sys_ids_9: i64, sys_ids_10: i64, sys_ids_11: i64, sys_ids_12: i64, sys_ids_13: i64, sys_ids_14: i64, sys_ids_15: i64,
    sys_n: i32,
}

fn ecs_schedule_deep_systems(s: EcsScheduleDeep) -> EcsScheduleSystemsResultDeep {
    if s.executor_initialized != 1 {
        return EcsScheduleSystemsResultDeep {
            initialized: false,
            sys_ids_0: 0, sys_ids_1: 0, sys_ids_2: 0, sys_ids_3: 0, sys_ids_4: 0, sys_ids_5: 0, sys_ids_6: 0, sys_ids_7: 0,
            sys_ids_8: 0, sys_ids_9: 0, sys_ids_10: 0, sys_ids_11: 0, sys_ids_12: 0, sys_ids_13: 0, sys_ids_14: 0, sys_ids_15: 0,
            sys_n: 0,
        };
    };
    return EcsScheduleSystemsResultDeep {
        initialized: true,
        sys_ids_0: s.sys_ids_0, sys_ids_1: s.sys_ids_1, sys_ids_2: s.sys_ids_2, sys_ids_3: s.sys_ids_3,
        sys_ids_4: s.sys_ids_4, sys_ids_5: s.sys_ids_5, sys_ids_6: s.sys_ids_6, sys_ids_7: s.sys_ids_7,
        sys_ids_8: s.sys_ids_8, sys_ids_9: s.sys_ids_9, sys_ids_10: s.sys_ids_10, sys_ids_11: s.sys_ids_11,
        sys_ids_12: s.sys_ids_12, sys_ids_13: s.sys_ids_13, sys_ids_14: s.sys_ids_14, sys_ids_15: s.sys_ids_15,
        sys_n: s.sys_ids_n,
    };
}

fn ecs_schedule_deep_systems_result_initialized(r: EcsScheduleSystemsResultDeep) -> bool {
    return r.initialized;
}

fn ecs_schedule_deep_systems_result_len(r: EcsScheduleSystemsResultDeep) -> i32 {
    return r.sys_n;
}

fn ecs_schedule_deep_systems_result_at(r: EcsScheduleSystemsResultDeep, idx: i32) -> i64 {
    if idx == 0 { return r.sys_ids_0; };
    if idx == 1 { return r.sys_ids_1; };
    if idx == 2 { return r.sys_ids_2; };
    if idx == 3 { return r.sys_ids_3; };
    if idx == 4 { return r.sys_ids_4; };
    if idx == 5 { return r.sys_ids_5; };
    if idx == 6 { return r.sys_ids_6; };
    if idx == 7 { return r.sys_ids_7; };
    if idx == 8 { return r.sys_ids_8; };
    if idx == 9 { return r.sys_ids_9; };
    if idx == 10 { return r.sys_ids_10; };
    if idx == 11 { return r.sys_ids_11; };
    if idx == 12 { return r.sys_ids_12; };
    if idx == 13 { return r.sys_ids_13; };
    if idx == 14 { return r.sys_ids_14; };
    if idx == 15 { return r.sys_ids_15; };
    panic(144908);
}

// Wrapper struct for tuple (bool, i64) returned by systems_len()
@derive(copy)
struct EcsScheduleSystemsLenResultDeep {
    initialized: bool,
    count: i64,
}

fn ecs_schedule_deep_systems_len(s: EcsScheduleDeep) -> EcsScheduleSystemsLenResultDeep {
    if s.executor_initialized != 1 {
        return EcsScheduleSystemsLenResultDeep { initialized: false, count: 0 };
    };
    return EcsScheduleSystemsLenResultDeep { initialized: true, count: s.sys_ids_n as i64 };
}

fn ecs_schedule_deep_systems_len_result_initialized(r: EcsScheduleSystemsLenResultDeep) -> bool {
    return r.initialized;
}

fn ecs_schedule_deep_systems_len_result_count(r: EcsScheduleSystemsLenResultDeep) -> i64 {
    return r.count;
}

fn ecs_schedule_deep_graph_system_count(s: EcsScheduleDeep) -> i64 {
    return s.sys_ids_n as i64;
}

fn ecs_schedule_deep_graph_set_count(s: EcsScheduleDeep) -> i64 {
    return s.set_ids_n as i64;
}

fn ecs_schedule_deep_systems_in_set(s: EcsScheduleDeep, set_id: i64) -> i64 {
    let idx: i32 = 0;
    let c: i64 = 0;
    while idx < s.set_ids_n {
        if _eis_set_ids_at(s, idx) == set_id { c = c + 1; };
        idx = idx + 1;
    }
    return c;
}

fn ecs_schedule_deep_systems_in_set_count(s: EcsScheduleDeep, set_id: i64) -> i32 {
    let idx: i32 = 0;
    let c: i32 = 0;
    while idx < s.set_ids_n {
        if _eis_set_ids_at(s, idx) == set_id { c = c + 1; };
        idx = idx + 1;
    }
    return c;
}

fn ecs_schedule_deep_remove_systems_in_set(s: EcsScheduleDeep, set_id: i64) -> EcsScheduleDeep {
    let temp_set_ids_0: i64 = 0; let temp_set_ids_1: i64 = 0; let temp_set_ids_2: i64 = 0; let temp_set_ids_3: i64 = 0;
    let temp_set_ids_4: i64 = 0; let temp_set_ids_5: i64 = 0; let temp_set_ids_6: i64 = 0; let temp_set_ids_7: i64 = 0;
    let temp_set_ids_8: i64 = 0; let temp_set_ids_9: i64 = 0; let temp_set_ids_10: i64 = 0; let temp_set_ids_11: i64 = 0;
    let temp_set_ids_12: i64 = 0; let temp_set_ids_13: i64 = 0; let temp_set_ids_14: i64 = 0; let temp_set_ids_15: i64 = 0;

    let idx: i32 = 0;
    let out_idx: i32 = 0;
    while idx < s.set_ids_n {
        let cur = _eis_set_ids_at(s, idx);
        if cur != set_id {
            if out_idx == 0 { temp_set_ids_0 = cur; };
            if out_idx == 1 { temp_set_ids_1 = cur; };
            if out_idx == 2 { temp_set_ids_2 = cur; };
            if out_idx == 3 { temp_set_ids_3 = cur; };
            if out_idx == 4 { temp_set_ids_4 = cur; };
            if out_idx == 5 { temp_set_ids_5 = cur; };
            if out_idx == 6 { temp_set_ids_6 = cur; };
            if out_idx == 7 { temp_set_ids_7 = cur; };
            if out_idx == 8 { temp_set_ids_8 = cur; };
            if out_idx == 9 { temp_set_ids_9 = cur; };
            if out_idx == 10 { temp_set_ids_10 = cur; };
            if out_idx == 11 { temp_set_ids_11 = cur; };
            if out_idx == 12 { temp_set_ids_12 = cur; };
            if out_idx == 13 { temp_set_ids_13 = cur; };
            if out_idx == 14 { temp_set_ids_14 = cur; };
            if out_idx == 15 { temp_set_ids_15 = cur; };
            out_idx = out_idx + 1;
        };
        idx = idx + 1;
    }

    s.set_ids_0 = temp_set_ids_0; s.set_ids_1 = temp_set_ids_1; s.set_ids_2 = temp_set_ids_2; s.set_ids_3 = temp_set_ids_3;
    s.set_ids_4 = temp_set_ids_4; s.set_ids_5 = temp_set_ids_5; s.set_ids_6 = temp_set_ids_6; s.set_ids_7 = temp_set_ids_7;
    s.set_ids_8 = temp_set_ids_8; s.set_ids_9 = temp_set_ids_9; s.set_ids_10 = temp_set_ids_10; s.set_ids_11 = temp_set_ids_11;
    s.set_ids_12 = temp_set_ids_12; s.set_ids_13 = temp_set_ids_13; s.set_ids_14 = temp_set_ids_14; s.set_ids_15 = temp_set_ids_15;
    s.set_ids_n = out_idx;
    s.built_set_count = out_idx as i64;
    return ecs_schedule_deep_mark_changed(s);
}

fn ecs_schedule_deep_executor_initialized(s: EcsScheduleDeep) -> bool {
    return s.executor_initialized != 0;
}

fn ecs_schedule_deep_apply_final_deferred(s: EcsScheduleDeep) -> bool {
    return s.apply_final_deferred != 0;
}

fn ecs_schedule_deep_executor_kind(s: EcsScheduleDeep) -> i32 {
    return s.executor_kind;
}

fn ecs_cleanup_deep_policy_default() -> i32 {
    return ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS;
}

fn ecs_cleanup_deep_policy_is_remove_set_and_systems(p: i32) -> bool {
    return p == ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS;
}

fn ecs_cleanup_deep_policy_is_remove_systems_only(p: i32) -> bool {
    return p == ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY;
}

fn ecs_cleanup_deep_policy_is_remove_set_and_systems_allow_breakages(p: i32) -> bool {
    return p == ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS_ALLOW_BREAKAGES;
}

fn ecs_cleanup_deep_policy_is_remove_systems_only_allow_breakages(p: i32) -> bool {
    return p == ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY_ALLOW_BREAKAGES;
}

// Wrapper struct for tuple (EcsSchedule, EcsScheduleCleanupResult)
// Cleanup result is itself a flat struct; we put the resulting side-effects on the schedule
// side and the cleanup summary fields into the result. The schedule itself is preserved
// as a separate struct (not nested) to avoid SA MemoryLeak.
@derive(copy)
struct EcsScheduleCleanupResultDeep {
    removed_count: i32,
    transitive_edges_added: i32,
    set_removed: bool,
    ok: bool,
}

// Outcome carries both the summary and the next-schedule snapshot (kept system IDs, set IDs).
// To avoid nesting a ScheduleDeep into the result, we expose the post-removal schedule as
// a separate reconstruction helper that callers pass the resulting scheduling in by IDs.
@derive(copy)
struct EcsScheduleCleanupOutcomeDeep {
    // Next schedule's kept set_ids (afftected + belongings) and counts
    next_set_n: i32,
    next_sys_n: i32,
    removed_count: i32,
    transitive_edges_added: i32,
    set_removed: bool,
    ok: bool,
}

fn ecs_schedule_deep_remove_systems_in_set_with_policy(s: EcsScheduleDeep, set_id: i64, policy: i32) -> EcsScheduleCleanupOutcomeDeep {
    let temp_set_ids_0: i64 = 0; let temp_set_ids_1: i64 = 0; let temp_set_ids_2: i64 = 0; let temp_set_ids_3: i64 = 0;
    let temp_set_ids_4: i64 = 0; let temp_set_ids_5: i64 = 0; let temp_set_ids_6: i64 = 0; let temp_set_ids_7: i64 = 0;
    let temp_set_ids_8: i64 = 0; let temp_set_ids_9: i64 = 0; let temp_set_ids_10: i64 = 0; let temp_set_ids_11: i64 = 0;
    let temp_set_ids_12: i64 = 0; let temp_set_ids_13: i64 = 0; let temp_set_ids_14: i64 = 0; let temp_set_ids_15: i64 = 0;

    let idx: i32 = 0;
    let out_idx: i32 = 0;
    let removed_count: i32 = 0;
    let drop_set: bool = (policy == ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS) || (policy == ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS_ALLOW_BREAKAGES);

    while idx < s.set_ids_n {
        let cur = _eis_set_ids_at(s, idx);
        let matches: bool = cur == set_id;
        if matches != true {
            if out_idx == 0 { temp_set_ids_0 = cur; };
            if out_idx == 1 { temp_set_ids_1 = cur; };
            if out_idx == 2 { temp_set_ids_2 = cur; };
            if out_idx == 3 { temp_set_ids_3 = cur; };
            if out_idx == 4 { temp_set_ids_4 = cur; };
            if out_idx == 5 { temp_set_ids_5 = cur; };
            if out_idx == 6 { temp_set_ids_6 = cur; };
            if out_idx == 7 { temp_set_ids_7 = cur; };
            if out_idx == 8 { temp_set_ids_8 = cur; };
            if out_idx == 9 { temp_set_ids_9 = cur; };
            if out_idx == 10 { temp_set_ids_10 = cur; };
            if out_idx == 11 { temp_set_ids_11 = cur; };
            if out_idx == 12 { temp_set_ids_12 = cur; };
            if out_idx == 13 { temp_set_ids_13 = cur; };
            if out_idx == 14 { temp_set_ids_14 = cur; };
            if out_idx == 15 { temp_set_ids_15 = cur; };
            out_idx = out_idx + 1;
        } else {
            removed_count = removed_count + 1;
            if drop_set != true {
                // RemoveSystemsOnly: keep the set entry by appending it to the temp slots.
                if out_idx == 0 { temp_set_ids_0 = cur; };
                if out_idx == 1 { temp_set_ids_1 = cur; };
                if out_idx == 2 { temp_set_ids_2 = cur; };
                if out_idx == 3 { temp_set_ids_3 = cur; };
                if out_idx == 4 { temp_set_ids_4 = cur; };
                if out_idx == 5 { temp_set_ids_5 = cur; };
                if out_idx == 6 { temp_set_ids_6 = cur; };
                if out_idx == 7 { temp_set_ids_7 = cur; };
                if out_idx == 8 { temp_set_ids_8 = cur; };
                if out_idx == 9 { temp_set_ids_9 = cur; };
                if out_idx == 10 { temp_set_ids_10 = cur; };
                if out_idx == 11 { temp_set_ids_11 = cur; };
                if out_idx == 12 { temp_set_ids_12 = cur; };
                if out_idx == 13 { temp_set_ids_13 = cur; };
                if out_idx == 14 { temp_set_ids_14 = cur; };
                if out_idx == 15 { temp_set_ids_15 = cur; };
                out_idx = out_idx + 1;
            };
        };
        idx = idx + 1;
    }

    s.set_ids_0 = temp_set_ids_0; s.set_ids_1 = temp_set_ids_1; s.set_ids_2 = temp_set_ids_2; s.set_ids_3 = temp_set_ids_3;
    s.set_ids_4 = temp_set_ids_4; s.set_ids_5 = temp_set_ids_5; s.set_ids_6 = temp_set_ids_6; s.set_ids_7 = temp_set_ids_7;
    s.set_ids_8 = temp_set_ids_8; s.set_ids_9 = temp_set_ids_9; s.set_ids_10 = temp_set_ids_10; s.set_ids_11 = temp_set_ids_11;
    s.set_ids_12 = temp_set_ids_12; s.set_ids_13 = temp_set_ids_13; s.set_ids_14 = temp_set_ids_14; s.set_ids_15 = temp_set_ids_15;
    s.set_ids_n = out_idx;
    s.built_set_count = out_idx as i64;

    let need_bridge: bool = (policy == ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS) || (policy == ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY);
    let transitive_edges_added: i32 = 0;
    if need_bridge {
        // No explicit dependency (edges stored in this value model): bridge count stays 0.
    };

    s = ecs_schedule_deep_mark_changed(s);

    return EcsScheduleCleanupOutcomeDeep {
        next_set_n: s.set_ids_n,
        next_sys_n: s.sys_ids_n,
        removed_count: removed_count,
        transitive_edges_added: transitive_edges_added,
        set_removed: drop_set,
        ok: true,
    };
}

