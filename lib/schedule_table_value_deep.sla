// Deepened Bevy ECS table-value schedule (shallow lib/schedule_table_value.sla deep).
// Sequential schedule for TableValueWorld<T, R, M>; systems execute over the archetype table-row
// storage path. Records cap-8 systems. Each system's access mask stores up to cap-4 read
// component-ids and cap-4 write component-ids plus two arena-flag pairs (resource reads/writes
// and messages reads/writes as 0/1 i32). Conflict detection compares write-component sets
// against read/write sets of the other system, then the resource and message arena hazards.
//
// Distinct from Batch 370 (schedule_registry_value_deep): the two-arena hazard is folded into
// a single `arena_hazard` pair-test facts (a writer is dangerous to readers or writers on the
// other side, and symmetrically) and used in a single combined scan, so the access struct stores
// the four arena flags as two parallel 2-wide arenas (viewed through index helpers) rather than
// four separate booleans — letting the hazard matrix be expressed once over a (read_idx, write_idx)
// pair for both arenas.
//
// Intentional leave-outs: no system fn-ptr execution; no generic types.

const ECS_TBL_VALUE_CAP_DEEP: i32 = 8;
const ECS_TBL_VALUE_LIST_CAP_DEEP: i32 = 4;
// arena indices: 0 = resource, 1 = messages.
const ECS_TBL_VALUE_ARENA_RESOURCE: i32 = 0;
const ECS_TBL_VALUE_ARENA_MESSAGES: i32 = 1;

struct EcsTblValueSystemAccessDeep {
    r0: i32, r1: i32, r2: i32, r3: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    // arena flags, indexed by ARENA_RESOURCE (0) and ARENA_MESSAGES (1).
    ar_read_0: i32, ar_read_1: i32,   // reads_resource, reads_messages
    ar_write_0: i32, ar_write_1: i32, // writes_resource, writes_messages
    len_reads: i32,
    len_writes: i32,
}

fn ecs_tbl_value_access_none() -> EcsTblValueSystemAccessDeep {
    return EcsTblValueSystemAccessDeep {
        r0: 0, r1: 0, r2: 0, r3: 0,
        w0: 0, w1: 0, w2: 0, w3: 0,
        ar_read_0: 0, ar_read_1: 0,
        ar_write_0: 0, ar_write_1: 0,
        len_reads: 0, len_writes: 0,
    };
}

fn ecs_tbl_value_access_build(
    r0: i32, r1: i32, r2: i32, r3: i32,
    w0: i32, w1: i32, w2: i32, w3: i32,
    ar_read_0: i32, ar_read_1: i32,
    ar_write_0: i32, ar_write_1: i32,
    len_reads: i32, len_writes: i32
) -> EcsTblValueSystemAccessDeep {
    return EcsTblValueSystemAccessDeep {
        r0: r0, r1: r1, r2: r2, r3: r3,
        w0: w0, w1: w1, w2: w2, w3: w3,
        ar_read_0: ar_read_0, ar_read_1: ar_read_1,
        ar_write_0: ar_write_0, ar_write_1: ar_write_1,
        len_reads: len_reads, len_writes: len_writes,
    };
}

fn ecs_tbl_value_access_read_component(a: EcsTblValueSystemAccessDeep, cid: i32) -> EcsTblValueSystemAccessDeep {
    if a.len_reads >= ECS_TBL_VALUE_LIST_CAP_DEEP { return a; };
    let idx = a.len_reads;
    if idx == 0 { a.r0 = cid; };
    if idx == 1 { a.r1 = cid; };
    if idx == 2 { a.r2 = cid; };
    if idx == 3 { a.r3 = cid; };
    a.len_reads = a.len_reads + 1;
    return a;
}

fn ecs_tbl_value_access_write_component(a: EcsTblValueSystemAccessDeep, cid: i32) -> EcsTblValueSystemAccessDeep {
    if a.len_writes >= ECS_TBL_VALUE_LIST_CAP_DEEP { return a; };
    let idx = a.len_writes;
    if idx == 0 { a.w0 = cid; };
    if idx == 1 { a.w1 = cid; };
    if idx == 2 { a.w2 = cid; };
    if idx == 3 { a.w3 = cid; };
    a.len_writes = a.len_writes + 1;
    return a;
}

fn ecs_tbl_value_access_read_resource(a: EcsTblValueSystemAccessDeep) -> EcsTblValueSystemAccessDeep {
    a.ar_read_0 = 1;
    return a;
}

fn ecs_tbl_value_access_write_resource(a: EcsTblValueSystemAccessDeep) -> EcsTblValueSystemAccessDeep {
    a.ar_write_0 = 1;
    return a;
}

fn ecs_tbl_value_access_read_messages(a: EcsTblValueSystemAccessDeep) -> EcsTblValueSystemAccessDeep {
    a.ar_read_1 = 1;
    return a;
}

fn ecs_tbl_value_access_write_messages(a: EcsTblValueSystemAccessDeep) -> EcsTblValueSystemAccessDeep {
    a.ar_write_1 = 1;
    return a;
}

fn ecs_tbl_value_read_at(a: EcsTblValueSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.r0; };
    if idx == 1 { return a.r1; };
    if idx == 2 { return a.r2; };
    if idx == 3 { return a.r3; };
    return 0;
}

fn ecs_tbl_value_write_at(a: EcsTblValueSystemAccessDeep, idx: i32) -> i32 {
    if idx == 0 { return a.w0; };
    if idx == 1 { return a.w1; };
    if idx == 2 { return a.w2; };
    if idx == 3 { return a.w3; };
    return 0;
}

// arena flag readers by arena index (0=resource, 1=messages).
fn ecs_tbl_value_arena_read(a: EcsTblValueSystemAccessDeep, arena: i32) -> i32 {
    if arena == ECS_TBL_VALUE_ARENA_RESOURCE { return a.ar_read_0; };
    return a.ar_read_1;
}

fn ecs_tbl_value_arena_write(a: EcsTblValueSystemAccessDeep, arena: i32) -> i32 {
    if arena == ECS_TBL_VALUE_ARENA_RESOURCE { return a.ar_write_0; };
    return a.ar_write_1;
}

fn ecs_tbl_value_len_reads(a: EcsTblValueSystemAccessDeep) -> i32 { return a.len_reads; }
fn ecs_tbl_value_len_writes(a: EcsTblValueSystemAccessDeep) -> i32 { return a.len_writes; }
fn ecs_tbl_value_reads_resource(a: EcsTblValueSystemAccessDeep) -> i32 { return a.ar_read_0; }
fn ecs_tbl_value_writes_resource(a: EcsTblValueSystemAccessDeep) -> i32 { return a.ar_write_0; }
fn ecs_tbl_value_reads_messages(a: EcsTblValueSystemAccessDeep) -> i32 { return a.ar_read_1; }
fn ecs_tbl_value_writes_messages(a: EcsTblValueSystemAccessDeep) -> i32 { return a.ar_write_1; }

fn ecs_tbl_value_read_list_has(a: EcsTblValueSystemAccessDeep, cid: i32) -> bool {
    let i: i32 = 0;
    while i < a.len_reads {
        if ecs_tbl_value_read_at(a, i) == cid { return true; };
        i = i + 1;
    }
    return false;
}

fn ecs_tbl_value_write_list_has(a: EcsTblValueSystemAccessDeep, cid: i32) -> bool {
    let i: i32 = 0;
    while i < a.len_writes {
        if ecs_tbl_value_write_at(a, i) == cid { return true; };
        i = i + 1;
    }
    return false;
}

// Component conflict: scan each side's writes for a membership in the other's read OR write list.
fn ecs_tbl_value_component_conflicts(left: EcsTblValueSystemAccessDeep, right: EcsTblValueSystemAccessDeep) -> bool {
    let i: i32 = 0;
    while i < left.len_writes {
        let cid = ecs_tbl_value_write_at(left, i);
        if ecs_tbl_value_read_list_has(right, cid) { return true; };
        if ecs_tbl_value_write_list_has(right, cid) { return true; };
        i = i + 1;
    }
    let j: i32 = 0;
    while j < right.len_writes {
        let cid = ecs_tbl_value_write_at(right, j);
        if ecs_tbl_value_read_list_has(left, cid) { return true; };
        if ecs_tbl_value_write_list_has(left, cid) { return true; };
        j = j + 1;
    }
    return false;
}

// arena hazard over a single (read, write) flag pair on both sides. Folded here for both
// resource and messages — a single expression since the access struct stores arena flags as two
// parallel indexed pairs (no per-arena code duplication as in the registry_value variant).
fn ecs_tbl_value_arena_hazard(la: EcsTblValueSystemAccessDeep, ra: EcsTblValueSystemAccessDeep, arena: i32) -> bool {
    let lr = ecs_tbl_value_arena_read(la, arena);
    let lw = ecs_tbl_value_arena_write(la, arena);
    let rr = ecs_tbl_value_arena_read(ra, arena);
    let rw = ecs_tbl_value_arena_write(ra, arena);
    // a writer is dangerous to a reader OR writer on the other side; and symmetrically.
    if lw != 0 {
        if rr != 0 { return true; };
        if rw != 0 { return true; };
    };
    if rw != 0 {
        if lr != 0 { return true; };
    };
    return false;
}

fn ecs_tbl_value_access_conflicts(left: EcsTblValueSystemAccessDeep, right: EcsTblValueSystemAccessDeep) -> bool {
    if ecs_tbl_value_component_conflicts(left, right) { return true; };
    if ecs_tbl_value_arena_hazard(left, right, ECS_TBL_VALUE_ARENA_RESOURCE) { return true; };
    if ecs_tbl_value_arena_hazard(left, right, ECS_TBL_VALUE_ARENA_MESSAGES) { return true; };
    return false;
}

// === Schedule with 8 slots ===

struct EcsTblValueScheduleDeep {
    s0: EcsTblValueSystemAccessDeep, s1: EcsTblValueSystemAccessDeep,
    s2: EcsTblValueSystemAccessDeep, s3: EcsTblValueSystemAccessDeep,
    s4: EcsTblValueSystemAccessDeep, s5: EcsTblValueSystemAccessDeep,
    s6: EcsTblValueSystemAccessDeep, s7: EcsTblValueSystemAccessDeep,
    count: i32,
    conflict_count: i32,
}

fn ecs_tbl_value_schedule_default() -> EcsTblValueScheduleDeep {
    let s = EcsTblValueScheduleDeep {
        s0: ecs_tbl_value_access_none(),
        s1: ecs_tbl_value_access_none(),
        s2: ecs_tbl_value_access_none(),
        s3: ecs_tbl_value_access_none(),
        s4: ecs_tbl_value_access_none(),
        s5: ecs_tbl_value_access_none(),
        s6: ecs_tbl_value_access_none(),
        s7: ecs_tbl_value_access_none(),
        count: 0,
        conflict_count: 0,
    };
    return s;
}

fn ecs_tbl_value_schedule_len(s: EcsTblValueScheduleDeep) -> i32 { return s.count; }
fn ecs_tbl_value_schedule_conflict_count(s: EcsTblValueScheduleDeep) -> i32 { return s.conflict_count; }

// Per-slot store: scalar capture then per-branch rebuild (UseAfterMove safety on 14-field struct).
fn ecs_tbl_value_access_set_a(s: EcsTblValueScheduleDeep, idx: i32, a: EcsTblValueSystemAccessDeep) -> EcsTblValueScheduleDeep {
    let r0 = ecs_tbl_value_read_at(a, 0);
    let r1 = ecs_tbl_value_read_at(a, 1);
    let r2 = ecs_tbl_value_read_at(a, 2);
    let r3 = ecs_tbl_value_read_at(a, 3);
    let w0 = ecs_tbl_value_write_at(a, 0);
    let w1 = ecs_tbl_value_write_at(a, 1);
    let w2 = ecs_tbl_value_write_at(a, 2);
    let w3 = ecs_tbl_value_write_at(a, 3);
    let arr0 = a.ar_read_0;
    let arr1 = a.ar_read_1;
    let awr0 = a.ar_write_0;
    let awr1 = a.ar_write_1;
    let lr = a.len_reads;
    let lw = a.len_writes;
    if idx == 0 { s.s0 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 1 { s.s1 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 2 { s.s2 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 3 { s.s3 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 4 { s.s4 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 5 { s.s5 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 6 { s.s6 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    if idx == 7 { s.s7 = ecs_tbl_value_access_build(r0, r1, r2, r3, w0, w1, w2, w3, arr0, arr1, awr0, awr1, lr, lw); };
    return s;
}

fn ecs_tbl_value_access_at(s: EcsTblValueScheduleDeep, idx: i32) -> EcsTblValueSystemAccessDeep {
    if idx == 0 { return s.s0; };
    if idx == 1 { return s.s1; };
    if idx == 2 { return s.s2; };
    if idx == 3 { return s.s3; };
    if idx == 4 { return s.s4; };
    if idx == 5 { return s.s5; };
    if idx == 6 { return s.s6; };
    if idx == 7 { return s.s7; };
    return ecs_tbl_value_access_none();
}

fn ecs_tbl_value_schedule_add_systems(s: EcsTblValueScheduleDeep, access: EcsTblValueSystemAccessDeep) -> EcsTblValueScheduleDeep {
    if s.count >= ECS_TBL_VALUE_CAP_DEEP { return s; };
    // Tally conflicts bidirectionally against existing systems.
    let i: i32 = 0;
    while i < s.count {
        let other = ecs_tbl_value_access_at(s, i);
        if ecs_tbl_value_access_conflicts(access, other) { s.conflict_count = s.conflict_count + 1; };
        i = i + 1;
    }
    let slot = s.count;
    s = ecs_tbl_value_access_set_a(s, slot, access);
    s.count = s.count + 1;
    return s;
}

fn ecs_tbl_value_schedule_clear(s: EcsTblValueScheduleDeep) -> EcsTblValueScheduleDeep {
    return ecs_tbl_value_schedule_default();
}
