// Bevy ECS change detection (src/change_detection/traits.rs):
// DetectChanges + DetectChangesMut trait methods not in base change_detection.sla.
// Covers: last_changed, changed_by, set_last_changed, set_last_added, bypass_change_detection,
// set_if_neq, replace_if_neq, clone_from_if_neq.

struct EcsDetectChangesExt {
    added_tick: i64,
    changed_tick: i64,
    last_run: i64,
    this_run: i64,
    changed_by: i64,
    inner_value: i64,
}

fn ecs_detect_ext_new(added_tick: i64, changed_tick: i64, last_run: i64, this_run: i64, inner: i64) -> EcsDetectChangesExt {
    return EcsDetectChangesExt {
        added_tick: added_tick, changed_tick: changed_tick,
        last_run: last_run, this_run: this_run,
        changed_by: 0, inner_value: inner
    };
}

// last_changed: return the tick when this was last changed
fn ecs_detect_ext_last_changed(d: EcsDetectChangesExt) -> i64 { return d.changed_tick; }

// changed_by: return who changed this (location/id handle)
fn ecs_detect_ext_changed_by(d: EcsDetectChangesExt) -> i64 { return d.changed_by; }

// set_last_changed: explicitly set the last changed tick
fn ecs_detect_ext_set_last_changed(d: EcsDetectChangesExt, tick: i64) -> EcsDetectChangesExt {
    d.changed_tick = tick;
    return d;
}

// set_last_added: explicitly set the last added tick
fn ecs_detect_ext_set_last_added(d: EcsDetectChangesExt, tick: i64) -> EcsDetectChangesExt {
    d.added_tick = tick;
    return d;
}

// bypass_change_detection: set inner value without triggering change detection
fn ecs_detect_ext_bypass_change_detection(d: EcsDetectChangesExt, value: i64) -> EcsDetectChangesExt {
    d.inner_value = value;
    return d;
}

fn ecs_detect_ext_inner(d: EcsDetectChangesExt) -> i64 { return d.inner_value; }

// set_if_neq: set the value only if it's different from the current value.
// Returns true if the value was changed.
fn ecs_detect_ext_set_if_neq(d: EcsDetectChangesExt, value: i64) -> (EcsDetectChangesExt, bool) {
    if d.inner_value == value { return (d, false); };
    d.inner_value = value;
    d.changed_tick = d.this_run;
    return (d, true);
}

// replace_if_neq: replace the value only if different, return the old value.
// Returns (changed_ext, was_changed, old_value)
fn ecs_detect_ext_replace_if_neq(d: EcsDetectChangesExt, value: i64) -> (EcsDetectChangesExt, bool, i64) {
    if d.inner_value == value { return (d, false, d.inner_value); };
    let old = d.inner_value;
    d.inner_value = value;
    d.changed_tick = d.this_run;
    return (d, true, old);
}

// clone_from_if_neq: clone from a reference only if different.
// Returns true if the value was changed.
fn ecs_detect_ext_clone_from_if_neq(d: EcsDetectChangesExt, value: i64) -> (EcsDetectChangesExt, bool) {
    if d.inner_value == value { return (d, false); };
    d.inner_value = value;
    d.changed_tick = d.this_run;
    return (d, true);
}

// set_changed_by: set the changed_by field
fn ecs_detect_ext_set_changed_by(d: EcsDetectChangesExt, by: i64) -> EcsDetectChangesExt {
    d.changed_by = by;
    return d;
}

// is_added
fn ecs_detect_ext_is_added(d: EcsDetectChangesExt) -> bool { return d.added_tick >= d.last_run; }

// is_changed
fn ecs_detect_ext_is_changed(d: EcsDetectChangesExt) -> bool { return d.changed_tick >= d.last_run; }

// is_added_after
fn ecs_detect_ext_is_added_after(d: EcsDetectChangesExt, other: i64) -> bool { return d.added_tick > other; }

// is_changed_after
fn ecs_detect_ext_is_changed_after(d: EcsDetectChangesExt, other: i64) -> bool { return d.changed_tick > other; }

// added: return the added tick
fn ecs_detect_ext_added(d: EcsDetectChangesExt) -> i64 { return d.added_tick; }

// this_run: return the current tick
fn ecs_detect_ext_this_run(d: EcsDetectChangesExt) -> i64 { return d.this_run; }

// last_run: return the last run tick
fn ecs_detect_ext_last_run(d: EcsDetectChangesExt) -> i64 { return d.last_run; }
