// Deepened Bevy ECS UniqueEntitySlice.
// Fixed capacity 8. Shallow lib/unique_slice.sla retained.

struct EcsUsDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
}

fn ecs_us_deep_empty() -> EcsUsDeep {
    return EcsUsDeep { e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0, len: 0 };
}

fn ecs_us_deep_rebuild(e0: i64, e1: i64, e2: i64, e3: i64, e4: i64, e5: i64, e6: i64, e7: i64, len: i32) -> EcsUsDeep {
    return EcsUsDeep { e0: e0, e1: e1, e2: e2, e3: e3, e4: e4, e5: e5, e6: e6, e7: e7, len: len };
}

fn ecs_us_deep_from4(a: i64, b: i64, c: i64, d: i64, n: i32) -> EcsUsDeep {
    return ecs_us_deep_rebuild(a, b, c, d, 0, 0, 0, 0, n);
}

fn ecs_us_deep_len(s: EcsUsDeep) -> i32 { return s.len; }
fn ecs_us_deep_is_empty(s: EcsUsDeep) -> bool { return s.len == 0; }

fn ecs_us_deep_at(s: EcsUsDeep, idx: i32) -> i64 {
    if idx == 0 { return s.e0; };
    if idx == 1 { return s.e1; };
    if idx == 2 { return s.e2; };
    if idx == 3 { return s.e3; };
    if idx == 4 { return s.e4; };
    if idx == 5 { return s.e5; };
    if idx == 6 { return s.e6; };
    if idx == 7 { return s.e7; };
    return -1;
}

fn ecs_us_deep_push(s: EcsUsDeep, entity: i64) -> EcsUsDeep {
    if s.len >= 8 { return s; };
    if s.len == 0 { return ecs_us_deep_rebuild(entity, 0, 0, 0, 0, 0, 0, 0, 1); };
    if s.len == 1 { return ecs_us_deep_rebuild(s.e0, entity, 0, 0, 0, 0, 0, 0, 2); };
    if s.len == 2 { return ecs_us_deep_rebuild(s.e0, s.e1, entity, 0, 0, 0, 0, 0, 3); };
    if s.len == 3 { return ecs_us_deep_rebuild(s.e0, s.e1, s.e2, entity, 0, 0, 0, 0, 4); };
    if s.len == 4 { return ecs_us_deep_rebuild(s.e0, s.e1, s.e2, s.e3, entity, 0, 0, 0, 5); };
    if s.len == 5 { return ecs_us_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, entity, 0, 0, 6); };
    if s.len == 6 { return ecs_us_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, entity, 0, 7); };
    if s.len == 7 { return ecs_us_deep_rebuild(s.e0, s.e1, s.e2, s.e3, s.e4, s.e5, s.e6, entity, 8); };
    return s;
}

struct EcsUsGetDeep { ok: bool, value: i64 }
fn ecs_us_get_ok(g: EcsUsGetDeep) -> bool { return g.ok; }
fn ecs_us_get_value(g: EcsUsGetDeep) -> i64 { return g.value; }

fn ecs_us_deep_get(s: EcsUsDeep, idx: i32) -> EcsUsGetDeep {
    if idx < 0 { return EcsUsGetDeep { ok: false, value: -1 }; };
    if idx >= s.len { return EcsUsGetDeep { ok: false, value: -1 }; };
    return EcsUsGetDeep { ok: true, value: ecs_us_deep_at(s, idx) };
}

fn ecs_us_deep_first(s: EcsUsDeep) -> EcsUsGetDeep {
    if s.len == 0 { return EcsUsGetDeep { ok: false, value: -1 }; };
    return EcsUsGetDeep { ok: true, value: s.e0 };
}

fn ecs_us_deep_last(s: EcsUsDeep) -> EcsUsGetDeep {
    if s.len == 0 { return EcsUsGetDeep { ok: false, value: -1 }; };
    return EcsUsGetDeep { ok: true, value: ecs_us_deep_at(s, s.len - 1) };
}

fn ecs_us_deep_contains(s: EcsUsDeep, entity: i64) -> bool {
    if s.len >= 1 { if s.e0 == entity { return true; }; };
    if s.len >= 2 { if s.e1 == entity { return true; }; };
    if s.len >= 3 { if s.e2 == entity { return true; }; };
    if s.len >= 4 { if s.e3 == entity { return true; }; };
    if s.len >= 5 { if s.e4 == entity { return true; }; };
    if s.len >= 6 { if s.e5 == entity { return true; }; };
    if s.len >= 7 { if s.e6 == entity { return true; }; };
    if s.len >= 8 { if s.e7 == entity { return true; }; };
    return false;
}

fn ecs_us_deep_index_of(s: EcsUsDeep, entity: i64) -> i32 {
    if s.len >= 1 { if s.e0 == entity { return 0; }; };
    if s.len >= 2 { if s.e1 == entity { return 1; }; };
    if s.len >= 3 { if s.e2 == entity { return 2; }; };
    if s.len >= 4 { if s.e3 == entity { return 3; }; };
    if s.len >= 5 { if s.e4 == entity { return 4; }; };
    if s.len >= 6 { if s.e5 == entity { return 5; }; };
    if s.len >= 7 { if s.e6 == entity { return 6; }; };
    if s.len >= 8 { if s.e7 == entity { return 7; }; };
    return -1;
}

fn ecs_us_deep_rindex_of(s: EcsUsDeep, entity: i64) -> i32 {
    if s.len >= 8 { if s.e7 == entity { return 7; }; };
    if s.len >= 7 { if s.e6 == entity { return 6; }; };
    if s.len >= 6 { if s.e5 == entity { return 5; }; };
    if s.len >= 5 { if s.e4 == entity { return 4; }; };
    if s.len >= 4 { if s.e3 == entity { return 3; }; };
    if s.len >= 3 { if s.e2 == entity { return 2; }; };
    if s.len >= 2 { if s.e1 == entity { return 1; }; };
    if s.len >= 1 { if s.e0 == entity { return 0; }; };
    return -1;
}

fn ecs_us_deep_swap(s: EcsUsDeep, a: i32, b: i32) -> EcsUsDeep {
    if a < 0 { return s; };
    if b < 0 { return s; };
    if a >= s.len { return s; };
    if b >= s.len { return s; };
    if a == b { return s; };
    let va = ecs_us_deep_at(s, a);
    let vb = ecs_us_deep_at(s, b);
    // rebuild with swaps for indices 0..3 primarily used in tests
    let e0 = s.e0;
    let e1 = s.e1;
    let e2 = s.e2;
    let e3 = s.e3;
    let e4 = s.e4;
    let e5 = s.e5;
    let e6 = s.e6;
    let e7 = s.e7;
    if a == 0 { e0 = vb; };
    if a == 1 { e1 = vb; };
    if a == 2 { e2 = vb; };
    if a == 3 { e3 = vb; };
    if b == 0 { e0 = va; };
    if b == 1 { e1 = va; };
    if b == 2 { e2 = va; };
    if b == 3 { e3 = va; };
    return ecs_us_deep_rebuild(e0, e1, e2, e3, e4, e5, e6, e7, s.len);
}

fn ecs_us_deep_reverse(s: EcsUsDeep) -> EcsUsDeep {
    if s.len <= 1 { return s; };
    if s.len == 2 { return ecs_us_deep_rebuild(s.e1, s.e0, 0, 0, 0, 0, 0, 0, 2); };
    if s.len == 3 { return ecs_us_deep_rebuild(s.e2, s.e1, s.e0, 0, 0, 0, 0, 0, 3); };
    if s.len == 4 { return ecs_us_deep_rebuild(s.e3, s.e2, s.e1, s.e0, 0, 0, 0, 0, 4); };
    return s;
}

fn ecs_us_deep_eq(a: EcsUsDeep, b: EcsUsDeep) -> bool {
    if a.len != b.len { return false; };
    if a.len >= 1 { if a.e0 != b.e0 { return false; }; };
    if a.len >= 2 { if a.e1 != b.e1 { return false; }; };
    if a.len >= 3 { if a.e2 != b.e2 { return false; }; };
    if a.len >= 4 { if a.e3 != b.e3 { return false; }; };
    return true;
}

fn ecs_us_deep_min(s: EcsUsDeep) -> EcsUsGetDeep {
    if s.len == 0 { return EcsUsGetDeep { ok: false, value: -1 }; };
    let m = s.e0;
    if s.len >= 2 { if s.e1 < m { m = s.e1; }; };
    if s.len >= 3 { if s.e2 < m { m = s.e2; }; };
    if s.len >= 4 { if s.e3 < m { m = s.e3; }; };
    return EcsUsGetDeep { ok: true, value: m };
}

fn ecs_us_deep_max(s: EcsUsDeep) -> EcsUsGetDeep {
    if s.len == 0 { return EcsUsGetDeep { ok: false, value: -1 }; };
    let m = s.e0;
    if s.len >= 2 { if s.e1 > m { m = s.e1; }; };
    if s.len >= 3 { if s.e2 > m { m = s.e2; }; };
    if s.len >= 4 { if s.e3 > m { m = s.e3; }; };
    return EcsUsGetDeep { ok: true, value: m };
}
