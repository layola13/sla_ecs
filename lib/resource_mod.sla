// Bevy ECS resource facade: IsResource marker + ResourceEntities tracking.
// Mirrors src/resource.rs.

// === IsResource marker component ===
// Each IsResource entity carries the ComponentId of the actual resource value component.
struct EcsIsResource {
    resource_component_id: i32,
}

fn ecs_is_resource_new(component_id: i32) -> EcsIsResource {
    let m = EcsIsResource { resource_component_id: component_id };
    return m;
}

fn ecs_is_resource_id(m: EcsIsResource) -> i32 {
    return m.resource_component_id;
}

// tests whether two IsResource markers carry the same resource component id.
fn ecs_is_resource_eq(m1: EcsIsResource, m2: EcsIsResource) -> bool {
    return m1.resource_component_id == m2.resource_component_id;
}

// === ResourceEntities — tracks the singleton Entity tied to each registered resource component id ===
struct EcsResourceEntitiesEntry {
    component_id: i32,
    entity: i64,
}

struct EcsResourceEntities {
    entries: Vec<EcsResourceEntitiesEntry>,
}

fn ecs_resource_entities_new() -> EcsResourceEntities {
    let r = EcsResourceEntities { entries: Vec::new() };
    return r;
}

// insert / set: link a resource component id to its singleton entity.
fn ecs_resource_entities_insert(r: EcsResourceEntities, component_id: i32, entity: i64) -> EcsResourceEntities {
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].component_id == component_id {
            r.entries[idx].entity = entity;
            return r;
        };
        idx = idx + 1;
    }
    let e = EcsResourceEntitiesEntry { component_id: component_id, entity: entity };
    r.entries.push(e);
    return r;
}

// get: returns (found, entity) for a given component id.
fn ecs_resource_entities_get(r: EcsResourceEntities, component_id: i32) -> (bool, i64) {
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].component_id == component_id {
            return (true, r.entries[idx].entity);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

fn ecs_resource_entities_len(r: EcsResourceEntities) -> i32 {
    return len(r.entries) as i32;
}

fn ecs_resource_entities_is_empty(r: EcsResourceEntities) -> bool {
    return len(r.entries) as i32 == 0;
}

// iter primitives: per-index accessor (found, component_id, entity)
fn ecs_resource_entities_iter_at(r: EcsResourceEntities, idx: i32) -> (bool, i32, i64) {
    let n: i32 = len(r.entries) as i32;
    if idx < 0 || idx >= n {
        return (false, 0, 0);
    };
    return (true, r.entries[idx].component_id, r.entries[idx].entity);
}

fn ecs_resource_entities_contains(r: EcsResourceEntities, component_id: i32) -> bool {
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].component_id == component_id {
            return true;
        };
        idx = idx + 1;
    }
    return false;
}

fn ecs_resource_entities_remove(r: EcsResourceEntities, component_id: i32) -> (bool, EcsResourceEntities) {
    let out = Vec::new();
    let mut removed: bool = false;
    let idx: i32 = 0;
    let n: i32 = len(r.entries) as i32;
    while idx < n {
        if r.entries[idx].component_id != component_id {
            out.push(r.entries[idx]);
        };
        if r.entries[idx].component_id == component_id {
            removed = true;
        };
        idx = idx + 1;
    }
    r.entries = out;
    return (removed, r);
}

fn ecs_resource_entities_clear(r: EcsResourceEntities) -> EcsResourceEntities {
    r.entries = Vec::new();
    return r;
}

// === ResourceFlags / IS_RESOURCE sentinel ===
// Bevy exposes `pub const IS_RESOURCE` via the Component trait (component.rs). Modelled here as a tag.
const ECS_RESOURCE_FLAG: i32 = 1;

fn ecs_resource_flag_is_resource(flag: i32) -> bool {
    // flag is a single-bit; check parity via modulo 2 of flag value.
    let rem = flag - (flag / 2) * 2;
    return rem != 0;
}

fn ecs_resource_flag_make_resource() -> i32 {
    return ECS_RESOURCE_FLAG;
}

fn ecs_resource_flag_make_non_resource() -> i32 {
    return 0;
}
