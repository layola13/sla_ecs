// Deep self-contained Bevy ECS reflect::component module.
// Mirrors lib/reflect_component.sla (92 lines) with fixed-cap (cap-16) scalar slot families
// instead of Vec<i64>, and tuple-return replacement companions inlined into the mutated struct
// (avoids the SA MemoryLeak — see docs/issue.md).
// No @import. All structs carry @derive(copy). Booleans stored as i32 (0/1).
// Nested tuples flattened: `remove` returns EcsReflectComponentDeep with `last_remove_success`;
// `take` returns it with `last_take_success`+`last_take_value`; `reflect` returns companions
// `last_reflect_present`+`last_reflect_value`. `find` keeps its `i64` return type (no struct
// wrapper needed — `find` returns `(0 - 1)` for not-found which is safe as i64).

const ECS_REFLECT_COMPONENT_DEEP_CAP: i32 = 16;

@derive(copy)
struct EcsReflectComponentDeep {
    component_id: i32,
    // Cap-16 (entity, value) parallel pairs.
    entity0: i64, entity1: i64, entity2: i64, entity3: i64,
    entity4: i64, entity5: i64, entity6: i64, entity7: i64,
    entity8: i64, entity9: i64, entity10: i64, entity11: i64,
    entity12: i64, entity13: i64, entity14: i64, entity15: i64,
    value0: i64, value1: i64, value2: i64, value3: i64,
    value4: i64, value5: i64, value6: i64, value7: i64,
    value8: i64, value9: i64, value10: i64, value11: i64,
    value12: i64, value13: i64, value14: i64, value15: i64,
    count: i32,
    // Companion fields replacing tuple-returns of remove/take/reflect (flattened inline).
    last_remove_success: i32,
    last_take_success: i32,
    last_take_value: i64,
    last_reflect_present: i32,
    last_reflect_value: i64,
}

fn ecs_reflect_component_deep_new(component_id: i32) -> EcsReflectComponentDeep {
    return EcsReflectComponentDeep {
        component_id: component_id,
        entity0: 0, entity1: 0, entity2: 0, entity3: 0,
        entity4: 0, entity5: 0, entity6: 0, entity7: 0,
        entity8: 0, entity9: 0, entity10: 0, entity11: 0,
        entity12: 0, entity13: 0, entity14: 0, entity15: 0,
        value0: 0, value1: 0, value2: 0, value3: 0,
        value4: 0, value5: 0, value6: 0, value7: 0,
        value8: 0, value9: 0, value10: 0, value11: 0,
        value12: 0, value13: 0, value14: 0, value15: 0,
        count: 0,
        last_remove_success: 0,
        last_take_success: 0,
        last_take_value: 0,
        last_reflect_present: 0,
        last_reflect_value: 0,
    };
}

fn ecs_reflect_component_deep_id(r: EcsReflectComponentDeep) -> i32 { return r.component_id; }

fn _ercd_entity_at(r: EcsReflectComponentDeep, idx: i32) -> i64 {
    if idx == 0 { return r.entity0; };
    if idx == 1 { return r.entity1; };
    if idx == 2 { return r.entity2; };
    if idx == 3 { return r.entity3; };
    if idx == 4 { return r.entity4; };
    if idx == 5 { return r.entity5; };
    if idx == 6 { return r.entity6; };
    if idx == 7 { return r.entity7; };
    if idx == 8 { return r.entity8; };
    if idx == 9 { return r.entity9; };
    if idx == 10 { return r.entity10; };
    if idx == 11 { return r.entity11; };
    if idx == 12 { return r.entity12; };
    if idx == 13 { return r.entity13; };
    if idx == 14 { return r.entity14; };
    if idx == 15 { return r.entity15; };
    panic(146800);
}

fn _ercd_entity_set(r: EcsReflectComponentDeep, idx: i32, v: i64) -> EcsReflectComponentDeep {
    if idx == 0 { r.entity0 = v; return r; };
    if idx == 1 { r.entity1 = v; return r; };
    if idx == 2 { r.entity2 = v; return r; };
    if idx == 3 { r.entity3 = v; return r; };
    if idx == 4 { r.entity4 = v; return r; };
    if idx == 5 { r.entity5 = v; return r; };
    if idx == 6 { r.entity6 = v; return r; };
    if idx == 7 { r.entity7 = v; return r; };
    if idx == 8 { r.entity8 = v; return r; };
    if idx == 9 { r.entity9 = v; return r; };
    if idx == 10 { r.entity10 = v; return r; };
    if idx == 11 { r.entity11 = v; return r; };
    if idx == 12 { r.entity12 = v; return r; };
    if idx == 13 { r.entity13 = v; return r; };
    if idx == 14 { r.entity14 = v; return r; };
    if idx == 15 { r.entity15 = v; return r; };
    panic(146801);
}

fn _ercd_value_at(r: EcsReflectComponentDeep, idx: i32) -> i64 {
    if idx == 0 { return r.value0; };
    if idx == 1 { return r.value1; };
    if idx == 2 { return r.value2; };
    if idx == 3 { return r.value3; };
    if idx == 4 { return r.value4; };
    if idx == 5 { return r.value5; };
    if idx == 6 { return r.value6; };
    if idx == 7 { return r.value7; };
    if idx == 8 { return r.value8; };
    if idx == 9 { return r.value9; };
    if idx == 10 { return r.value10; };
    if idx == 11 { return r.value11; };
    if idx == 12 { return r.value12; };
    if idx == 13 { return r.value13; };
    if idx == 14 { return r.value14; };
    if idx == 15 { return r.value15; };
    panic(146802);
}

fn _ercd_value_set(r: EcsReflectComponentDeep, idx: i32, v: i64) -> EcsReflectComponentDeep {
    if idx == 0 { r.value0 = v; return r; };
    if idx == 1 { r.value1 = v; return r; };
    if idx == 2 { r.value2 = v; return r; };
    if idx == 3 { r.value3 = v; return r; };
    if idx == 4 { r.value4 = v; return r; };
    if idx == 5 { r.value5 = v; return r; };
    if idx == 6 { r.value6 = v; return r; };
    if idx == 7 { r.value7 = v; return r; };
    if idx == 8 { r.value8 = v; return r; };
    if idx == 9 { r.value9 = v; return r; };
    if idx == 10 { r.value10 = v; return r; };
    if idx == 11 { r.value11 = v; return r; };
    if idx == 12 { r.value12 = v; return r; };
    if idx == 13 { r.value13 = v; return r; };
    if idx == 14 { r.value14 = v; return r; };
    if idx == 15 { r.value15 = v; return r; };
    panic(146803);
}

// find: returns the slot index of `entity`, or (0 - 1) if absent.
fn ecs_reflect_component_deep_find(r: EcsReflectComponentDeep, entity: i64) -> i32 {
    let i: i32 = 0;
    while i < r.count {
        if _ercd_entity_at(r, i) == entity { return i; };
        i = i + 1;
    }
    return (0 - 1);
}

// insert: set (or add) the component value on an entity. cap-16 enforced on the new-slot path.
fn ecs_reflect_component_deep_insert(r: EcsReflectComponentDeep, entity: i64, value: i64) -> EcsReflectComponentDeep {
    let idx = ecs_reflect_component_deep_find(r, entity);
    if idx >= 0 {
        r = _ercd_value_set(r, idx, value);
        return r;
    };
    if r.count < ECS_REFLECT_COMPONENT_DEEP_CAP {
        r = _ercd_entity_set(r, r.count, entity);
        r = _ercd_value_set(r, r.count, value);
        r.count = r.count + 1;
    };
    return r;
}

// apply: same as insert for this model.
fn ecs_reflect_component_deep_apply(r: EcsReflectComponentDeep, entity: i64, value: i64) -> EcsReflectComponentDeep {
    return ecs_reflect_component_deep_insert(r, entity, value);
}

// apply_or_insert_mapped: insert if absent, apply if present (alias of insert in this model).
fn ecs_reflect_component_deep_apply_or_insert_mapped(r: EcsReflectComponentDeep, entity: i64, value: i64) -> EcsReflectComponentDeep {
    return ecs_reflect_component_deep_insert(r, entity, value);
}

// remove: remove the component from an entity. Result returned via `last_remove_success`.
// Swap-compact uses the same back-swap as the shallow original.
fn ecs_reflect_component_deep_remove(r: EcsReflectComponentDeep, entity: i64) -> EcsReflectComponentDeep {
    let idx = ecs_reflect_component_deep_find(r, entity);
    if idx < 0 {
        r.last_remove_success = 0;
        return r;
    };
    let last = r.count - 1;
    if idx != last {
        r = _ercd_entity_set(r, idx, _ercd_entity_at(r, last));
        r = _ercd_value_set(r, idx, _ercd_value_at(r, last));
    };
    r.count = r.count - 1;
    r.last_remove_success = 1;
    return r;
}

fn ecs_reflect_component_deep_last_remove_success(r: EcsReflectComponentDeep) -> bool { return r.last_remove_success != 0; }

// take: remove and return the value via `last_take_success` + `last_take_value`.
fn ecs_reflect_component_deep_take(r: EcsReflectComponentDeep, entity: i64) -> EcsReflectComponentDeep {
    let idx = ecs_reflect_component_deep_find(r, entity);
    if idx < 0 {
        r.last_take_success = 0;
        r.last_take_value = 0;
        return r;
    };
    let value = _ercd_value_at(r, idx);
    r = ecs_reflect_component_deep_remove(r, entity);
    r.last_take_success = 1;
    r.last_take_value = value;
    return r;
}

fn ecs_reflect_component_deep_last_take_success(r: EcsReflectComponentDeep) -> bool { return r.last_take_success != 0; }
fn ecs_reflect_component_deep_last_take_value(r: EcsReflectComponentDeep) -> i64 { return r.last_take_value; }

// contains
fn ecs_reflect_component_deep_contains(r: EcsReflectComponentDeep, entity: i64) -> bool {
    return ecs_reflect_component_deep_find(r, entity) >= 0;
}

// count: number of entities currently stored.
fn ecs_reflect_component_deep_count(r: EcsReflectComponentDeep) -> i64 { return r.count as i64; }

// reflect: get the value via `last_reflect_present` + `last_reflect_value`.
fn ecs_reflect_component_deep_reflect(r: EcsReflectComponentDeep, entity: i64) -> EcsReflectComponentDeep {
    let idx = ecs_reflect_component_deep_find(r, entity);
    if idx < 0 {
        r.last_reflect_present = 0;
        r.last_reflect_value = 0;
        return r;
    };
    r.last_reflect_present = 1;
    r.last_reflect_value = _ercd_value_at(r, idx);
    return r;
}

fn ecs_reflect_component_deep_last_reflect_present(r: EcsReflectComponentDeep) -> bool { return r.last_reflect_present != 0; }
fn ecs_reflect_component_deep_last_reflect_value(r: EcsReflectComponentDeep) -> i64 { return r.last_reflect_value; }

// copy: copy a component value from `source` to `dest`. Stays a no-op when the source is absent.
fn ecs_reflect_component_deep_copy(r: EcsReflectComponentDeep, source: i64, dest: i64) -> EcsReflectComponentDeep {
    r = ecs_reflect_component_deep_reflect(r, source);
    if r.last_reflect_present == 0 { return r; };
    let value = r.last_reflect_value;
    r.last_reflect_present = 0;
    r.last_reflect_value = 0;
    return ecs_reflect_component_deep_insert(r, dest, value);
}
