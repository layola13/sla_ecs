// Deepened Bevy ECS special system params.
// Mirrors src/system/system_param.rs Deferred/SystemBuffer/RemovedComponents/RunSystemOnce.
// Fixed buffer capacity 8. Shallow lib/system_param_special.sla retained.

struct EcsSpbDeep {
    d0: i64, d1: i64, d2: i64, d3: i64,
    d4: i64, d5: i64, d6: i64, d7: i64,
    len: i32,
    applied: bool,
}

fn ecs_spb_deep_new() -> EcsSpbDeep {
    return EcsSpbDeep {
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        len: 0, applied: false,
    };
}

fn ecs_spb_deep_len(b: EcsSpbDeep) -> i32 { return b.len; }
fn ecs_spb_deep_is_applied(b: EcsSpbDeep) -> bool { return b.applied; }
fn ecs_spb_deep_is_empty(b: EcsSpbDeep) -> bool { return b.len == 0; }

fn ecs_spb_deep_rebuild(
    d0: i64, d1: i64, d2: i64, d3: i64, d4: i64, d5: i64, d6: i64, d7: i64,
    len: i32, applied: bool
) -> EcsSpbDeep {
    return EcsSpbDeep {
        d0: d0, d1: d1, d2: d2, d3: d3, d4: d4, d5: d5, d6: d6, d7: d7,
        len: len, applied: applied,
    };
}

fn ecs_spb_deep_push(b: EcsSpbDeep, value: i64) -> EcsSpbDeep {
    if b.len == 0 { return ecs_spb_deep_rebuild(value, b.d1, b.d2, b.d3, b.d4, b.d5, b.d6, b.d7, 1, false); };
    if b.len == 1 { return ecs_spb_deep_rebuild(b.d0, value, b.d2, b.d3, b.d4, b.d5, b.d6, b.d7, 2, false); };
    if b.len == 2 { return ecs_spb_deep_rebuild(b.d0, b.d1, value, b.d3, b.d4, b.d5, b.d6, b.d7, 3, false); };
    if b.len == 3 { return ecs_spb_deep_rebuild(b.d0, b.d1, b.d2, value, b.d4, b.d5, b.d6, b.d7, 4, false); };
    if b.len == 4 { return ecs_spb_deep_rebuild(b.d0, b.d1, b.d2, b.d3, value, b.d5, b.d6, b.d7, 5, false); };
    if b.len == 5 { return ecs_spb_deep_rebuild(b.d0, b.d1, b.d2, b.d3, b.d4, value, b.d6, b.d7, 6, false); };
    if b.len == 6 { return ecs_spb_deep_rebuild(b.d0, b.d1, b.d2, b.d3, b.d4, b.d5, value, b.d7, 7, false); };
    if b.len == 7 { return ecs_spb_deep_rebuild(b.d0, b.d1, b.d2, b.d3, b.d4, b.d5, b.d6, value, 8, false); };
    return b;
}

fn ecs_spb_deep_get(b: EcsSpbDeep, idx: i32) -> i64 {
    if idx == 0 { return b.d0; };
    if idx == 1 { return b.d1; };
    if idx == 2 { return b.d2; };
    if idx == 3 { return b.d3; };
    if idx == 4 { return b.d4; };
    if idx == 5 { return b.d5; };
    if idx == 6 { return b.d6; };
    if idx == 7 { return b.d7; };
    return 0;
}

fn ecs_spb_deep_apply(b: EcsSpbDeep) -> EcsSpbDeep {
    return ecs_spb_deep_rebuild(b.d0, b.d1, b.d2, b.d3, b.d4, b.d5, b.d6, b.d7, b.len, true);
}

fn ecs_spb_deep_clear(b: EcsSpbDeep) -> EcsSpbDeep {
    return ecs_spb_deep_new();
}

// Deferred wrapper
struct EcsSpdDeep {
    d0: i64, d1: i64, d2: i64, d3: i64,
    d4: i64, d5: i64, d6: i64, d7: i64,
    len: i32,
    applied: bool,
    has_deferred: bool,
}

fn ecs_spd_deep_new() -> EcsSpdDeep {
    return EcsSpdDeep {
        d0: 0, d1: 0, d2: 0, d3: 0, d4: 0, d5: 0, d6: 0, d7: 0,
        len: 0, applied: false, has_deferred: true,
    };
}

fn ecs_spd_deep_has_deferred(d: EcsSpdDeep) -> bool { return d.has_deferred; }
fn ecs_spd_deep_len(d: EcsSpdDeep) -> i32 { return d.len; }
fn ecs_spd_deep_is_applied(d: EcsSpdDeep) -> bool { return d.applied; }

fn ecs_spd_deep_from_buf(b: EcsSpbDeep) -> EcsSpdDeep {
    return EcsSpdDeep {
        d0: b.d0, d1: b.d1, d2: b.d2, d3: b.d3, d4: b.d4, d5: b.d5, d6: b.d6, d7: b.d7,
        len: b.len, applied: b.applied, has_deferred: true,
    };
}

fn ecs_spd_deep_push(d: EcsSpdDeep, value: i64) -> EcsSpdDeep {
    let b = ecs_spb_deep_rebuild(d.d0, d.d1, d.d2, d.d3, d.d4, d.d5, d.d6, d.d7, d.len, false);
    b = ecs_spb_deep_push(b, value);
    return ecs_spd_deep_from_buf(b);
}

fn ecs_spd_deep_apply(d: EcsSpdDeep) -> EcsSpdDeep {
    let b = ecs_spb_deep_rebuild(d.d0, d.d1, d.d2, d.d3, d.d4, d.d5, d.d6, d.d7, d.len, d.applied);
    b = ecs_spb_deep_apply(b);
    return ecs_spd_deep_from_buf(b);
}

fn ecs_spd_deep_reborrow(d: EcsSpdDeep) -> EcsSpdDeep { return d; }

fn ecs_spd_deep_clear(d: EcsSpdDeep) -> EcsSpdDeep {
    return ecs_spd_deep_new();
}

// markers
struct EcsSpexDeep { tag: i32 }
struct EcsSpnsDeep { tag: i32 }
fn ecs_spex_deep_new() -> EcsSpexDeep { return EcsSpexDeep { tag: 1 }; }
fn ecs_spns_deep_new() -> EcsSpnsDeep { return EcsSpnsDeep { tag: 1 }; }
fn ecs_spex_deep_tag(m: EcsSpexDeep) -> i32 { return m.tag; }
fn ecs_spns_deep_tag(m: EcsSpnsDeep) -> i32 { return m.tag; }

// RemovedComponents
struct EcsSprcDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    len: i32,
    read_index: i32,
}

fn ecs_sprc_deep_new() -> EcsSprcDeep {
    return EcsSprcDeep { e0: 0, e1: 0, e2: 0, e3: 0, len: 0, read_index: 0 };
}

fn ecs_sprc_deep_len(r: EcsSprcDeep) -> i32 { return r.len; }
fn ecs_sprc_deep_is_empty(r: EcsSprcDeep) -> bool { return r.read_index >= r.len; }

fn ecs_sprc_deep_rebuild(e0: i64, e1: i64, e2: i64, e3: i64, len: i32, read_index: i32) -> EcsSprcDeep {
    return EcsSprcDeep { e0: e0, e1: e1, e2: e2, e3: e3, len: len, read_index: read_index };
}

fn ecs_sprc_deep_add(r: EcsSprcDeep, entity: i64) -> EcsSprcDeep {
    if r.len == 0 { return ecs_sprc_deep_rebuild(entity, r.e1, r.e2, r.e3, 1, r.read_index); };
    if r.len == 1 { return ecs_sprc_deep_rebuild(r.e0, entity, r.e2, r.e3, 2, r.read_index); };
    if r.len == 2 { return ecs_sprc_deep_rebuild(r.e0, r.e1, entity, r.e3, 3, r.read_index); };
    if r.len == 3 { return ecs_sprc_deep_rebuild(r.e0, r.e1, r.e2, entity, 4, r.read_index); };
    return r;
}

struct EcsSprcNextDeep {
    param: EcsSprcDeep,
    has: bool,
    entity: i64,
}

fn ecs_sprc_next_has(n: EcsSprcNextDeep) -> bool { return n.has; }
fn ecs_sprc_next_entity(n: EcsSprcNextDeep) -> i64 { return n.entity; }
fn ecs_sprc_next_param(n: EcsSprcNextDeep) -> EcsSprcDeep { return n.param; }

fn ecs_sprc_deep_next(r: EcsSprcDeep) -> EcsSprcNextDeep {
    if r.read_index >= r.len {
        return EcsSprcNextDeep { param: r, has: false, entity: 0 };
    };
    let entity = 0;
    if r.read_index == 0 { entity = r.e0; };
    if r.read_index == 1 { entity = r.e1; };
    if r.read_index == 2 { entity = r.e2; };
    if r.read_index == 3 { entity = r.e3; };
    let r2 = ecs_sprc_deep_rebuild(r.e0, r.e1, r.e2, r.e3, r.len, r.read_index + 1);
    return EcsSprcNextDeep { param: r2, has: true, entity: entity };
}

fn ecs_sprc_deep_clear(r: EcsSprcDeep) -> EcsSprcDeep {
    return ecs_sprc_deep_new();
}

// RunSystemOnce
struct EcsSroDeep {
    success: bool,
    output: i64,
}

fn ecs_sro_deep_ok(output: i64) -> EcsSroDeep {
    return EcsSroDeep { success: true, output: output };
}
fn ecs_sro_deep_err() -> EcsSroDeep {
    return EcsSroDeep { success: false, output: 0 };
}
fn ecs_sro_deep_is_ok(r: EcsSroDeep) -> bool { return r.success; }
fn ecs_sro_deep_output(r: EcsSroDeep) -> i64 { return r.output; }

// validation
const ECS_SPV_OK: i32 = 0;
const ECS_SPV_SKIPPED: i32 = 1;
struct EcsSpvDeep { code: i32 }
fn ecs_spv_deep_ok() -> EcsSpvDeep { return EcsSpvDeep { code: ECS_SPV_OK }; }
fn ecs_spv_deep_skipped() -> EcsSpvDeep { return EcsSpvDeep { code: ECS_SPV_SKIPPED }; }
fn ecs_spv_deep_is_ok(e: EcsSpvDeep) -> bool { return e.code == ECS_SPV_OK; }
fn ecs_spv_deep_is_skipped(e: EcsSpvDeep) -> bool { return e.code == ECS_SPV_SKIPPED; }
