// Deepened Bevy ECS relationship source collection surface.
// Mirrors src/relationship/relationship_source_collection.rs:
//   RelationshipSourceCollection: new/with_capacity/reserve/add/remove/iter/len/clear/shrink/extend
//   source_to_remove_before_add (one-to-one)
//   OrderedRelationshipSourceCollection: insert/remove_at/insert_stable/remove_at_stable/
//     sort/insert_sorted/place_most_recent/place/push_front/back
// Collections: Vec (ordered multi), EntityHashSet (unordered unique), UniqueVec
// Shallow lib/relationship_source_collection.sla retained.

const ECS_RSCD_VEC: i32 = 0;
const ECS_RSCD_HASHSET: i32 = 1;
const ECS_RSCD_UNIQUE_VEC: i32 = 2;
const ECS_RSCD_ONE: i32 = 3; // one-to-one (capacity 1)

fn ecs_rscd_vec() -> i32 { return ECS_RSCD_VEC; }
fn ecs_rscd_hashset() -> i32 { return ECS_RSCD_HASHSET; }
fn ecs_rscd_unique_vec() -> i32 { return ECS_RSCD_UNIQUE_VEC; }
fn ecs_rscd_one() -> i32 { return ECS_RSCD_ONE; }

// Fixed capacity 8
struct EcsRscDeep {
    kind: i32,
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    len: i32,
    capacity: i32,
    reserved_extra: i32,
    shrink_count: i32,
}

fn ecs_rscd_new(kind: i32) -> EcsRscDeep {
    return EcsRscDeep {
        kind: kind,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity: 0, reserved_extra: 0, shrink_count: 0,
    };
}

fn ecs_rscd_with_capacity(kind: i32, capacity: i32) -> EcsRscDeep {
    // hashset may ignore capacity; we still record it for vec-like
    let cap = capacity;
    if kind == ECS_RSCD_HASHSET { cap = 0; };
    return EcsRscDeep {
        kind: kind,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity: cap, reserved_extra: 0, shrink_count: 0,
    };
}

fn ecs_rscd_kind(c: EcsRscDeep) -> i32 { return c.kind; }
fn ecs_rscd_len(c: EcsRscDeep) -> i32 { return c.len; }
fn ecs_rscd_is_empty(c: EcsRscDeep) -> bool { return c.len == 0; }
fn ecs_rscd_capacity(c: EcsRscDeep) -> i32 { return c.capacity; }
fn ecs_rscd_shrink_count(c: EcsRscDeep) -> i32 { return c.shrink_count; }

fn ecs_rscd_at(c: EcsRscDeep, idx: i32) -> i64 {
    if idx == 0 { return c.e0; };
    if idx == 1 { return c.e1; };
    if idx == 2 { return c.e2; };
    if idx == 3 { return c.e3; };
    if idx == 4 { return c.e4; };
    if idx == 5 { return c.e5; };
    if idx == 6 { return c.e6; };
    if idx == 7 { return c.e7; };
    return 0;
}

fn ecs_rscd_contains(c: EcsRscDeep, entity: i64) -> bool {
    if c.len >= 1 && c.e0 == entity { return true; };
    if c.len >= 2 && c.e1 == entity { return true; };
    if c.len >= 3 && c.e2 == entity { return true; };
    if c.len >= 4 && c.e3 == entity { return true; };
    if c.len >= 5 && c.e4 == entity { return true; };
    if c.len >= 6 && c.e5 == entity { return true; };
    if c.len >= 7 && c.e6 == entity { return true; };
    if c.len >= 8 && c.e7 == entity { return true; };
    return false;
}

fn ecs_rscd_set_at(c: EcsRscDeep, idx: i32, entity: i64) -> EcsRscDeep {
    if idx == 0 {
        return EcsRscDeep { kind: c.kind, e0: entity, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 1 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: entity, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 2 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: c.e1, e2: entity, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 3 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: entity, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 4 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: entity, e5: c.e5, e6: c.e6, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 5 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: entity, e6: c.e6, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 6 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: entity, e7: c.e7, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    if idx == 7 {
        return EcsRscDeep { kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: entity, len: c.len, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count };
    };
    return c;
}

fn ecs_rscd_push_end(c: EcsRscDeep, entity: i64) -> EcsRscDeep {
    if c.len >= 8 { return c; };
    let n = c.len;
    c = ecs_rscd_set_at(c, n, entity);
    let cap = c.capacity;
    if cap < n + 1 { cap = n + 1; };
    return EcsRscDeep {
        kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7,
        len: n + 1, capacity: cap, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count,
    };
}

fn ecs_rscd_reserve(c: EcsRscDeep, additional: i32) -> EcsRscDeep {
    if c.kind == ECS_RSCD_HASHSET {
        return c; // no-op for some collections
    };
    let need = c.len + additional;
    let cap = c.capacity;
    if need > cap { cap = need; };
    return EcsRscDeep {
        kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7,
        len: c.len, capacity: cap, reserved_extra: c.reserved_extra + additional, shrink_count: c.shrink_count,
    };
}

// add returns (collection, was_added)
fn ecs_rscd_add(c: EcsRscDeep, entity: i64) -> (EcsRscDeep, bool) {
    if c.kind == ECS_RSCD_ONE {
        if c.len == 0 {
            return (ecs_rscd_push_end(c, entity), true);
        };
        // replace: not added if same
        if c.e0 == entity { return (c, false); };
        c = ecs_rscd_set_at(c, 0, entity);
        return (c, true);
    };
    if c.kind == ECS_RSCD_HASHSET || c.kind == ECS_RSCD_UNIQUE_VEC {
        if ecs_rscd_contains(c, entity) { return (c, false); };
        return (ecs_rscd_push_end(c, entity), true);
    };
    // Vec allows multi
    return (ecs_rscd_push_end(c, entity), true);
}

fn ecs_rscd_source_to_remove_before_add(c: EcsRscDeep) -> (bool, i64) {
    if c.kind == ECS_RSCD_ONE && c.len >= 1 {
        return (true, c.e0);
    };
    return (false, 0);
}

fn ecs_rscd_remove(c: EcsRscDeep, entity: i64) -> (EcsRscDeep, bool) {
    // find index
    let idx: i32 = -1;
    if c.len >= 1 && c.e0 == entity { idx = 0; };
    if c.len >= 2 && c.e1 == entity { idx = 1; };
    if c.len >= 3 && c.e2 == entity { idx = 2; };
    if c.len >= 4 && c.e3 == entity { idx = 3; };
    if c.len >= 5 && c.e4 == entity { idx = 4; };
    if c.len >= 6 && c.e5 == entity { idx = 5; };
    if c.len >= 7 && c.e6 == entity { idx = 6; };
    if c.len >= 8 && c.e7 == entity { idx = 7; };
    if idx < 0 { return (c, false); };
    // swap-remove with last
    let last_idx = c.len - 1;
    let last_val = ecs_rscd_at(c, last_idx);
    c = ecs_rscd_set_at(c, idx, last_val);
    c = ecs_rscd_set_at(c, last_idx, 0);
    return (EcsRscDeep {
        kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7,
        len: c.len - 1, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count,
    }, true);
}

fn ecs_rscd_clear(c: EcsRscDeep) -> EcsRscDeep {
    return EcsRscDeep {
        kind: c.kind, e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        len: 0, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count,
    };
}

fn ecs_rscd_shrink_to_fit(c: EcsRscDeep) -> EcsRscDeep {
    return EcsRscDeep {
        kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7,
        len: c.len, capacity: c.len, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count + 1,
    };
}

fn ecs_rscd_extend2(c: EcsRscDeep, a: i64, b: i64) -> EcsRscDeep {
    let r = ecs_rscd_add(c, a);
    c = r.0;
    let r2 = ecs_rscd_add(c, b);
    return r2.0;
}

// Ordered: insert at index (clamp to end)
fn ecs_rscd_insert(c: EcsRscDeep, index: i32, entity: i64) -> EcsRscDeep {
    if c.len >= 8 { return c; };
    if index < 0 { index = 0; };
    if index > c.len { index = c.len; };
    // shift right from end
    let n = c.len;
    // expand len first with placeholder
    c = ecs_rscd_push_end(c, 0);
    let i = n;
    // unrolled shift: while i > index
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    if i > index {
        c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i - 1));
        i = i - 1;
    };
    c = ecs_rscd_set_at(c, index, entity);
    return c;
}

fn ecs_rscd_remove_at(c: EcsRscDeep, index: i32) -> (EcsRscDeep, bool, i64) {
    if index < 0 || index >= c.len { return (c, false, 0); };
    let val = ecs_rscd_at(c, index);
    // shift left
    let i = index;
    let n = c.len;
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    if i + 1 < n { c = ecs_rscd_set_at(c, i, ecs_rscd_at(c, i + 1)); i = i + 1; };
    c = ecs_rscd_set_at(c, n - 1, 0);
    return (EcsRscDeep {
        kind: c.kind, e0: c.e0, e1: c.e1, e2: c.e2, e3: c.e3, e4: c.e4, e5: c.e5, e6: c.e6, e7: c.e7,
        len: n - 1, capacity: c.capacity, reserved_extra: c.reserved_extra, shrink_count: c.shrink_count,
    }, true, val);
}

// remove_at_stable: same as remove_at for our dense array model
fn ecs_rscd_remove_at_stable(c: EcsRscDeep, index: i32) -> (EcsRscDeep, bool, i64) {
    return ecs_rscd_remove_at(c, index);
}

// insert_stable same as insert for dense
fn ecs_rscd_insert_stable(c: EcsRscDeep, index: i32, entity: i64) -> EcsRscDeep {
    return ecs_rscd_insert(c, index, entity);
}

// simple bubble sort ascending (len <= 8)
fn ecs_rscd_sort(c: EcsRscDeep) -> EcsRscDeep {
    let n = c.len;
    // unrolled bubble passes
    let pass = 0;
    if pass < n {
        let i = 0;
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
        };
        pass = pass + 1;
    };
    // second and third passes for more items
    if n > 2 {
        let i = 0;
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
        };
    };
    if n > 3 {
        let i = 0;
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
            i = i + 1;
        };
        if i + 1 < n {
            if ecs_rscd_at(c, i) > ecs_rscd_at(c, i + 1) {
                let a = ecs_rscd_at(c, i); let b = ecs_rscd_at(c, i + 1);
                c = ecs_rscd_set_at(c, i, b); c = ecs_rscd_set_at(c, i + 1, a);
            };
        };
    };
    return c;
}

fn ecs_rscd_insert_sorted(c: EcsRscDeep, entity: i64) -> EcsRscDeep {
    c = ecs_rscd_push_end(c, entity);
    return ecs_rscd_sort(c);
}

fn ecs_rscd_place_most_recent(c: EcsRscDeep, index: i32) -> EcsRscDeep {
    if c.len == 0 { return c; };
    let last = ecs_rscd_at(c, c.len - 1);
    let r = ecs_rscd_remove_at(c, c.len - 1);
    c = r.0;
    return ecs_rscd_insert(c, index, last);
}

fn ecs_rscd_place(c: EcsRscDeep, entity: i64, index: i32) -> EcsRscDeep {
    if ecs_rscd_contains(c, entity) != true { return c; };
    let r = ecs_rscd_remove(c, entity);
    c = r.0;
    return ecs_rscd_insert(c, index, entity);
}

fn ecs_rscd_push_front(c: EcsRscDeep, entity: i64) -> EcsRscDeep {
    return ecs_rscd_insert(c, 0, entity);
}

fn ecs_rscd_push_back(c: EcsRscDeep, entity: i64) -> EcsRscDeep {
    return ecs_rscd_insert(c, 999, entity);
}

fn ecs_rscd_first(c: EcsRscDeep) -> (bool, i64) {
    if c.len == 0 { return (false, 0); };
    return (true, c.e0);
}

fn ecs_rscd_last(c: EcsRscDeep) -> (bool, i64) {
    if c.len == 0 { return (false, 0); };
    return (true, ecs_rscd_at(c, c.len - 1));
}
