// Deepened Bevy ECS Archetypes facade + ComponentIndex.
// Fixed capacity-8 archetype-id slots and capacity-8 component-index entries.
// Shallow lib/archetypes_registry.sla retained.

struct EcsArchRecordDeep {
    column: i32,
    has_column: bool,
}
fn ecs_arrec_table(column: i32) -> EcsArchRecordDeep {
    return EcsArchRecordDeep { column: column, has_column: true };
}
fn ecs_arrec_sparse() -> EcsArchRecordDeep {
    return EcsArchRecordDeep { column: -1, has_column: false };
}
fn ecs_arrec_has_column(r: EcsArchRecordDeep) -> bool { return r.has_column; }
fn ecs_arrec_column(r: EcsArchRecordDeep) -> i32 { return r.column; }

struct EcsCidxEntryDeep {
    component_id: i32,
    archetype_id: i32,
    has_column: bool,
    column: i32,
}

struct EcsArchetypesDeep {
    a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32,
    len: i32,
    generation: i32,
    // component-index capacity-4 entries
    ci0: EcsCidxEntryDeep, ci1: EcsCidxEntryDeep, ci2: EcsCidxEntryDeep, ci3: EcsCidxEntryDeep,
    ci_len: i32,
}

fn ecs_cidx_empty() -> EcsCidxEntryDeep {
    return EcsCidxEntryDeep { component_id: 0, archetype_id: 0, has_column: false, column: -1 };
}

fn ecs_arch_deep_new() -> EcsArchetypesDeep {
    return EcsArchetypesDeep {
        a0: 0, a1: 0, a2: 0, a3: 0, a4: 0, a5: 0, a6: 0, a7: 0,
        len: 1, generation: 0,
        ci0: ecs_cidx_empty(), ci1: ecs_cidx_empty(), ci2: ecs_cidx_empty(), ci3: ecs_cidx_empty(),
        ci_len: 0,
    };
}

fn ecs_arch_deep_rebuild(
    a0: i32, a1: i32, a2: i32, a3: i32, a4: i32, a5: i32, a6: i32, a7: i32,
    len: i32, generation: i32,
    ci0: EcsCidxEntryDeep, ci1: EcsCidxEntryDeep, ci2: EcsCidxEntryDeep, ci3: EcsCidxEntryDeep,
    ci_len: i32
) -> EcsArchetypesDeep {
    return EcsArchetypesDeep {
        a0: a0, a1: a1, a2: a2, a3: a3, a4: a4, a5: a5, a6: a6, a7: a7,
        len: len, generation: generation,
        ci0: ci0, ci1: ci1, ci2: ci2, ci3: ci3, ci_len: ci_len,
    };
}

fn ecs_arch_deep_len(a: EcsArchetypesDeep) -> i32 { return a.len; }
fn ecs_arch_deep_generation(a: EcsArchetypesDeep) -> i32 { return a.generation; }
fn ecs_arch_deep_empty_id() -> i32 { return 0; }

struct EcsArchGetDeep { found: bool, archetype_id: i32 }
fn ecs_arch_get_found(g: EcsArchGetDeep) -> bool { return g.found; }
fn ecs_arch_get_id(g: EcsArchGetDeep) -> i32 { return g.archetype_id; }

fn ecs_arch_deep_get(a: EcsArchetypesDeep, id: i32) -> EcsArchGetDeep {
    if id < 0 { return EcsArchGetDeep { found: false, archetype_id: 0 }; };
    if id >= a.len { return EcsArchGetDeep { found: false, archetype_id: 0 }; };
    let value = 0;
    if id == 0 { value = a.a0; };
    if id == 1 { value = a.a1; };
    if id == 2 { value = a.a2; };
    if id == 3 { value = a.a3; };
    if id == 4 { value = a.a4; };
    if id == 5 { value = a.a5; };
    if id == 6 { value = a.a6; };
    if id == 7 { value = a.a7; };
    return EcsArchGetDeep { found: true, archetype_id: value };
}

struct EcsArchSpawnDeep { archetypes: EcsArchetypesDeep, new_id: i32 }
fn ecs_arch_spawn_archetypes(s: EcsArchSpawnDeep) -> EcsArchetypesDeep { return s.archetypes; }
fn ecs_arch_spawn_id(s: EcsArchSpawnDeep) -> i32 { return s.new_id; }

fn ecs_arch_deep_spawn(a: EcsArchetypesDeep) -> EcsArchSpawnDeep {
    let id = a.len;
    if id >= 8 {
        return EcsArchSpawnDeep { archetypes: a, new_id: -1 };
    };
    let a0 = a.a0; let a1 = a.a1; let a2 = a.a2; let a3 = a.a3;
    let a4 = a.a4; let a5 = a.a5; let a6 = a.a6; let a7 = a.a7;
    let new_len = a.len + 1;
    if id == 1 { a1 = id; };
    if id == 2 { a2 = id; };
    if id == 3 { a3 = id; };
    if id == 4 { a4 = id; };
    if id == 5 { a5 = id; };
    if id == 6 { a6 = id; };
    if id == 7 { a7 = id; };
    let next = ecs_arch_deep_rebuild(
        a0, a1, a2, a3, a4, a5, a6, a7,
        new_len, a.generation + 1, a.ci0, a.ci1, a.ci2, a.ci3, a.ci_len
    );
    return EcsArchSpawnDeep { archetypes: next, new_id: id };
}

fn ecs_arch_deep_clear_entities(a: EcsArchetypesDeep) -> EcsArchetypesDeep {
    return ecs_arch_deep_rebuild(
        a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7,
        a.len, a.generation + 1, a.ci0, a.ci1, a.ci2, a.ci3, a.ci_len
    );
}

fn ecs_arch_deep_iter_at(a: EcsArchetypesDeep, idx: i32) -> i32 {
    if idx == 0 { return a.a0; };
    if idx == 1 { return a.a1; };
    if idx == 2 { return a.a2; };
    if idx == 3 { return a.a3; };
    if idx == 4 { return a.a4; };
    if idx == 5 { return a.a5; };
    if idx == 6 { return a.a6; };
    if idx == 7 { return a.a7; };
    return -1;
}

fn ecs_arch_deep_ci_count(a: EcsArchetypesDeep) -> i32 { return a.ci_len; }

fn ecs_arch_deep_register_table(a: EcsArchetypesDeep, component_id: i32, archetype_id: i32, column: i32) -> EcsArchetypesDeep {
    if a.ci_len >= 4 { return a; };
    let entry = EcsCidxEntryDeep { component_id: component_id, archetype_id: archetype_id, has_column: true, column: column };
    if a.ci_len == 0 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, entry, a.ci1, a.ci2, a.ci3, 1);
    };
    if a.ci_len == 1 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, a.ci0, entry, a.ci2, a.ci3, 2);
    };
    if a.ci_len == 2 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, a.ci0, a.ci1, entry, a.ci3, 3);
    };
    if a.ci_len == 3 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, a.ci0, a.ci1, a.ci2, entry, 4);
    };
    return a;
}

fn ecs_arch_deep_register_sparse(a: EcsArchetypesDeep, component_id: i32, archetype_id: i32) -> EcsArchetypesDeep {
    if a.ci_len >= 4 { return a; };
    let entry = EcsCidxEntryDeep { component_id: component_id, archetype_id: archetype_id, has_column: false, column: -1 };
    if a.ci_len == 0 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, entry, a.ci1, a.ci2, a.ci3, 1);
    };
    if a.ci_len == 1 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, a.ci0, entry, a.ci2, a.ci3, 2);
    };
    if a.ci_len == 2 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, a.ci0, a.ci1, entry, a.ci3, 3);
    };
    if a.ci_len == 3 {
        return ecs_arch_deep_rebuild(a.a0, a.a1, a.a2, a.a3, a.a4, a.a5, a.a6, a.a7, a.len, a.generation, a.ci0, a.ci1, a.ci2, entry, 4);
    };
    return a;
}

struct EcsArchCidxForDeep { found: bool, has_column: bool, column: i32 }
fn ecs_arch_cif_found(c: EcsArchCidxForDeep) -> bool { return c.found; }
fn ecs_arch_cif_has(c: EcsArchCidxForDeep) -> bool { return c.has_column; }
fn ecs_arch_cif_column(c: EcsArchCidxForDeep) -> i32 { return c.column; }

fn ecs_cidx_match(e: EcsCidxEntryDeep, component_id: i32, archetype_id: i32) -> bool {
    if e.component_id != component_id { return false; };
    if e.archetype_id != archetype_id { return false; };
    return true;
}

fn ecs_arch_deep_ci_for(a: EcsArchetypesDeep, component_id: i32, archetype_id: i32) -> EcsArchCidxForDeep {
    if a.ci_len >= 1 { if ecs_cidx_match(a.ci0, component_id, archetype_id) { return EcsArchCidxForDeep { found: true, has_column: a.ci0.has_column, column: a.ci0.column }; }; };
    if a.ci_len >= 2 { if ecs_cidx_match(a.ci1, component_id, archetype_id) { return EcsArchCidxForDeep { found: true, has_column: a.ci1.has_column, column: a.ci1.column }; }; };
    if a.ci_len >= 3 { if ecs_cidx_match(a.ci2, component_id, archetype_id) { return EcsArchCidxForDeep { found: true, has_column: a.ci2.has_column, column: a.ci2.column }; }; };
    if a.ci_len >= 4 { if ecs_cidx_match(a.ci3, component_id, archetype_id) { return EcsArchCidxForDeep { found: true, has_column: a.ci3.has_column, column: a.ci3.column }; }; };
    return EcsArchCidxForDeep { found: false, has_column: false, column: 0 };
}

struct EcsArchCidxWithDeep { count: i32, first_archetype_id: i32 }
fn ecs_arch_ciw_count(c: EcsArchCidxWithDeep) -> i32 { return c.count; }
fn ecs_arch_ciw_first(c: EcsArchCidxWithDeep) -> i32 { return c.first_archetype_id; }

fn ecs_arch_deep_ci_archetypes_with(a: EcsArchetypesDeep, component_id: i32) -> EcsArchCidxWithDeep {
    let count: i32 = 0;
    let first: i32 = 0;
    if a.ci_len >= 1 {
        if a.ci0.component_id == component_id {
            if count == 0 { first = a.ci0.archetype_id; };
            count = count + 1;
        };
    };
    if a.ci_len >= 2 {
        if a.ci1.component_id == component_id {
            if count == 0 { first = a.ci1.archetype_id; };
            count = count + 1;
        };
    };
    if a.ci_len >= 3 {
        if a.ci2.component_id == component_id {
            if count == 0 { first = a.ci2.archetype_id; };
            count = count + 1;
        };
    };
    if a.ci_len >= 4 {
        if a.ci3.component_id == component_id {
            if count == 0 { first = a.ci3.archetype_id; };
            count = count + 1;
        };
    };
    return EcsArchCidxWithDeep { count: count, first_archetype_id: first };
}
