// Deepened Bevy ECS schedule error kinds (core surface).
// Mirrors src/schedule/error.rs + related. Shallow lib/schedule_error.sla retained.

const ECS_SE_BUILD: i32 = 0;
const ECS_SE_SYSTEM: i32 = 1;
const ECS_SE_LOOP: i32 = 2;
const ECS_SE_CYCLE: i32 = 3;
const ECS_SE_HIERARCHY: i32 = 4;
const ECS_SE_AMBIGUITY: i32 = 5;

struct EcsSeDeep {
    kind: i32,
    node_id: i32,
    message_id: i64,
    c0: i32, c1: i32, c2: i32, c3: i32,
    clen: i32,
}

fn ecs_se_deep_build(message_id: i64) -> EcsSeDeep {
    return EcsSeDeep { kind: ECS_SE_BUILD, node_id: -1, message_id: message_id, c0: -1, c1: -1, c2: -1, c3: -1, clen: 0 };
}

fn ecs_se_deep_system(node_id: i32, message_id: i64) -> EcsSeDeep {
    return EcsSeDeep { kind: ECS_SE_SYSTEM, node_id: node_id, message_id: message_id, c0: -1, c1: -1, c2: -1, c3: -1, clen: 0 };
}

fn ecs_se_deep_loop(node_id: i32) -> EcsSeDeep {
    return EcsSeDeep { kind: ECS_SE_LOOP, node_id: node_id, message_id: 0, c0: -1, c1: -1, c2: -1, c3: -1, clen: 0 };
}

fn ecs_se_deep_cycle(c0: i32, c1: i32, c2: i32, c3: i32, clen: i32) -> EcsSeDeep {
    return EcsSeDeep { kind: ECS_SE_CYCLE, node_id: -1, message_id: 0, c0: c0, c1: c1, c2: c2, c3: c3, clen: clen };
}

fn ecs_se_deep_hierarchy(node_id: i32) -> EcsSeDeep {
    return EcsSeDeep { kind: ECS_SE_HIERARCHY, node_id: node_id, message_id: 0, c0: -1, c1: -1, c2: -1, c3: -1, clen: 0 };
}

fn ecs_se_deep_ambiguity(a: i32, b: i32) -> EcsSeDeep {
    return EcsSeDeep { kind: ECS_SE_AMBIGUITY, node_id: -1, message_id: 0, c0: a, c1: b, c2: -1, c3: -1, clen: 2 };
}

fn ecs_se_deep_kind(e: EcsSeDeep) -> i32 { return e.kind; }
fn ecs_se_deep_node(e: EcsSeDeep) -> i32 { return e.node_id; }
fn ecs_se_deep_message(e: EcsSeDeep) -> i64 { return e.message_id; }
fn ecs_se_deep_clen(e: EcsSeDeep) -> i32 { return e.clen; }

fn ecs_se_deep_is_build(e: EcsSeDeep) -> bool { return e.kind == ECS_SE_BUILD; }
fn ecs_se_deep_is_system(e: EcsSeDeep) -> bool { return e.kind == ECS_SE_SYSTEM; }
fn ecs_se_deep_is_loop(e: EcsSeDeep) -> bool { return e.kind == ECS_SE_LOOP; }
fn ecs_se_deep_is_cycle(e: EcsSeDeep) -> bool { return e.kind == ECS_SE_CYCLE; }
fn ecs_se_deep_is_hierarchy(e: EcsSeDeep) -> bool { return e.kind == ECS_SE_HIERARCHY; }
fn ecs_se_deep_is_ambiguity(e: EcsSeDeep) -> bool { return e.kind == ECS_SE_AMBIGUITY; }

fn ecs_se_deep_cycle_at(e: EcsSeDeep, idx: i32) -> i32 {
    if idx == 0 { return e.c0; };
    if idx == 1 { return e.c1; };
    if idx == 2 { return e.c2; };
    if idx == 3 { return e.c3; };
    return -1;
}

fn ecs_se_deep_eq_kind(a: EcsSeDeep, b: EcsSeDeep) -> bool {
    return a.kind == b.kind;
}

// Result wrapper
struct EcsSeResDeep {
    ok: bool,
    err: EcsSeDeep,
}

fn ecs_se_res_ok() -> EcsSeResDeep {
    return EcsSeResDeep { ok: true, err: ecs_se_deep_build(0) };
}

fn ecs_se_res_err(e: EcsSeDeep) -> EcsSeResDeep {
    return EcsSeResDeep { ok: false, err: e };
}

fn ecs_se_res_is_ok(r: EcsSeResDeep) -> bool { return r.ok; }
fn ecs_se_res_err_kind(r: EcsSeResDeep) -> i32 { return r.err.kind; }
fn ecs_se_res_err_val(r: EcsSeResDeep) -> EcsSeDeep { return r.err; }
