// Deepened Bevy ECS archetype surface.
// Mirrors src/archetype.rs:
//   ArchetypeId / ArchetypeRow / ArchetypeEntity
//   ComponentStatus + ArchetypeAfterBundleInsert
//   Edges insert/remove/take caches
//   Archetype component set + flags + entity rows
//   Archetypes registry empty+get_or_create by signature
// Shallow lib/archetype_edges.sla, archetype_info.sla, archetype_registry.sla retained.
// Fixed capacity: 4 edge cache slots, 4 components, 8 entities, 4 archetypes.

// ComponentStatus
fn ecs_ad_status_added() -> i32 { return 0; }
fn ecs_ad_status_existed() -> i32 { return 1; }

// ArchetypeFlags bits
fn ecs_ad_flag_on_add() -> i32 { return 1; }
fn ecs_ad_flag_on_insert() -> i32 { return 2; }
fn ecs_ad_flag_on_discard() -> i32 { return 4; }
fn ecs_ad_flag_on_remove() -> i32 { return 8; }
fn ecs_ad_flag_on_despawn() -> i32 { return 16; }

struct EcsAdId { value: i32 }
fn ecs_ad_id_new(v: i32) -> EcsAdId { return EcsAdId { value: v }; }
fn ecs_ad_id_value(id: EcsAdId) -> i32 { return id.value; }
fn ecs_ad_id_eq(a: EcsAdId, b: EcsAdId) -> bool {
    if a.value == b.value { return true; };
    return false;
}

struct EcsAdRow { value: i32 }
fn ecs_ad_row_new(v: i32) -> EcsAdRow { return EcsAdRow { value: v }; }
fn ecs_ad_row_value(r: EcsAdRow) -> i32 { return r.value; }

struct EcsAdEntity {
    entity: i64,
    table_row: i32,
}
fn ecs_ad_entity_new(entity: i64, table_row: i32) -> EcsAdEntity {
    return EcsAdEntity { entity: entity, table_row: table_row };
}
fn ecs_ad_entity_id(e: EcsAdEntity) -> i64 { return e.entity; }
fn ecs_ad_entity_table_row(e: EcsAdEntity) -> i32 { return e.table_row; }

// After bundle insert result: archetype + up to 4 statuses
struct EcsAdAfterInsert {
    archetype_id: i32,
    // statuses parallel to bundle components
    s0: i32, s1: i32, s2: i32, s3: i32,
    s_len: i32,
    // added component ids
    a0: i32, a1: i32, a2: i32, a3: i32,
    a_len: i32,
}

fn ecs_ad_after_insert_new(archetype_id: i32) -> EcsAdAfterInsert {
    return EcsAdAfterInsert {
        archetype_id: archetype_id,
        s0: 0, s1: 0, s2: 0, s3: 0, s_len: 0,
        a0: -1, a1: -1, a2: -1, a3: -1, a_len: 0,
    };
}

fn ecs_ad_after_insert_id(a: EcsAdAfterInsert) -> i32 { return a.archetype_id; }
fn ecs_ad_after_insert_status_len(a: EcsAdAfterInsert) -> i32 { return a.s_len; }
fn ecs_ad_after_insert_added_len(a: EcsAdAfterInsert) -> i32 { return a.a_len; }

fn ecs_ad_after_insert_push_status(a: EcsAdAfterInsert, status: i32, component_id: i32) -> EcsAdAfterInsert {
    if a.s_len >= 4 { return a; };
    let s0 = a.s0; let s1 = a.s1; let s2 = a.s2; let s3 = a.s3;
    let a0 = a.a0; let a1 = a.a1; let a2 = a.a2; let a3 = a.a3;
    let sl = a.s_len; let al = a.a_len;
    if sl == 0 { s0 = status; };
    if sl == 1 { s1 = status; };
    if sl == 2 { s2 = status; };
    if sl == 3 { s3 = status; };
    sl = sl + 1;
    if status == ecs_ad_status_added() {
        if al == 0 { a0 = component_id; };
        if al == 1 { a1 = component_id; };
        if al == 2 { a2 = component_id; };
        if al == 3 { a3 = component_id; };
        al = al + 1;
    };
    return EcsAdAfterInsert {
        archetype_id: a.archetype_id,
        s0: s0, s1: s1, s2: s2, s3: s3, s_len: sl,
        a0: a0, a1: a1, a2: a2, a3: a3, a_len: al,
    };
}

fn ecs_ad_after_insert_status_at(a: EcsAdAfterInsert, idx: i32) -> i32 {
    if idx == 0 { return a.s0; };
    if idx == 1 { return a.s1; };
    if idx == 2 { return a.s2; };
    if idx == 3 { return a.s3; };
    return -1;
}

fn ecs_ad_after_insert_added_at(a: EcsAdAfterInsert, idx: i32) -> i32 {
    if idx == 0 { return a.a0; };
    if idx == 1 { return a.a1; };
    if idx == 2 { return a.a2; };
    if idx == 3 { return a.a3; };
    return -1;
}

// Edges: insert maps to full AfterInsert; remove/take to optional archetype id
// remove/take: present=false not cached; present=true && has=false => None; has=true => id
struct EcsAdEdges {
    // insert cache 4
    i_len: i32,
    i_b0: i32, i_a0: EcsAdAfterInsert,
    i_b1: i32, i_a1: EcsAdAfterInsert,
    i_b2: i32, i_a2: EcsAdAfterInsert,
    i_b3: i32, i_a3: EcsAdAfterInsert,
    // remove cache
    r_len: i32,
    r_b0: i32, r_has0: bool, r_id0: i32,
    r_b1: i32, r_has1: bool, r_id1: i32,
    r_b2: i32, r_has2: bool, r_id2: i32,
    r_b3: i32, r_has3: bool, r_id3: i32,
    // take cache
    t_len: i32,
    t_b0: i32, t_has0: bool, t_id0: i32,
    t_b1: i32, t_has1: bool, t_id1: i32,
    t_b2: i32, t_has2: bool, t_id2: i32,
    t_b3: i32, t_has3: bool, t_id3: i32,
}

fn ecs_ad_edges_new() -> EcsAdEdges {
    let empty = ecs_ad_after_insert_new(-1);
    return EcsAdEdges {
        i_len: 0,
        i_b0: -1, i_a0: empty, i_b1: -1, i_a1: empty, i_b2: -1, i_a2: empty, i_b3: -1, i_a3: empty,
        r_len: 0,
        r_b0: -1, r_has0: false, r_id0: -1,
        r_b1: -1, r_has1: false, r_id1: -1,
        r_b2: -1, r_has2: false, r_id2: -1,
        r_b3: -1, r_has3: false, r_id3: -1,
        t_len: 0,
        t_b0: -1, t_has0: false, t_id0: -1,
        t_b1: -1, t_has1: false, t_id1: -1,
        t_b2: -1, t_has2: false, t_id2: -1,
        t_b3: -1, t_has3: false, t_id3: -1,
    };
}

fn ecs_ad_edges_insert_count(e: EcsAdEdges) -> i32 { return e.i_len; }
fn ecs_ad_edges_remove_count(e: EcsAdEdges) -> i32 { return e.r_len; }
fn ecs_ad_edges_take_count(e: EcsAdEdges) -> i32 { return e.t_len; }

fn ecs_ad_edges_get_insert(e: EcsAdEdges, bundle_id: i32) -> (bool, EcsAdAfterInsert) {
    if e.i_len >= 1 { if e.i_b0 == bundle_id { return (true, e.i_a0); }; };
    if e.i_len >= 2 { if e.i_b1 == bundle_id { return (true, e.i_a1); }; };
    if e.i_len >= 3 { if e.i_b2 == bundle_id { return (true, e.i_a2); }; };
    if e.i_len >= 4 { if e.i_b3 == bundle_id { return (true, e.i_a3); }; };
    return (false, ecs_ad_after_insert_new(-1));
}

fn ecs_ad_edges_cache_insert(e: EcsAdEdges, bundle_id: i32, after: EcsAdAfterInsert) -> EcsAdEdges {
    // overwrite if exists
    if e.i_len >= 1 {
        if e.i_b0 == bundle_id {
            return EcsAdEdges {
                i_len: e.i_len, i_b0: bundle_id, i_a0: after, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
                r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
                r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
                t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
                t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
            };
        };
    };
    if e.i_len >= 4 { return e; };
    if e.i_len == 0 {
        return EcsAdEdges {
            i_len: 1, i_b0: bundle_id, i_a0: after, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
            r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
            r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
            t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
            t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
        };
    };
    if e.i_len == 1 {
        return EcsAdEdges {
            i_len: 2, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: bundle_id, i_a1: after, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
            r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
            r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
            t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
            t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
        };
    };
    if e.i_len == 2 {
        return EcsAdEdges {
            i_len: 3, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: bundle_id, i_a2: after, i_b3: e.i_b3, i_a3: e.i_a3,
            r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
            r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
            t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
            t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
        };
    };
    return EcsAdEdges {
        i_len: 4, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: bundle_id, i_a3: after,
        r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
        r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
        t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
        t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
    };
}

// get remove: (cached, has_result, archetype_id)
struct EcsAdEdgeOpt {
    cached: bool,
    has: bool,
    id: i32,
}
fn ecs_ad_edge_opt_cached(o: EcsAdEdgeOpt) -> bool { return o.cached; }
fn ecs_ad_edge_opt_has(o: EcsAdEdgeOpt) -> bool { return o.has; }
fn ecs_ad_edge_opt_id(o: EcsAdEdgeOpt) -> i32 { return o.id; }

fn ecs_ad_edges_get_remove(e: EcsAdEdges, bundle_id: i32) -> EcsAdEdgeOpt {
    if e.r_len >= 1 { if e.r_b0 == bundle_id { return EcsAdEdgeOpt { cached: true, has: e.r_has0, id: e.r_id0 }; }; };
    if e.r_len >= 2 { if e.r_b1 == bundle_id { return EcsAdEdgeOpt { cached: true, has: e.r_has1, id: e.r_id1 }; }; };
    if e.r_len >= 3 { if e.r_b2 == bundle_id { return EcsAdEdgeOpt { cached: true, has: e.r_has2, id: e.r_id2 }; }; };
    if e.r_len >= 4 { if e.r_b3 == bundle_id { return EcsAdEdgeOpt { cached: true, has: e.r_has3, id: e.r_id3 }; }; };
    return EcsAdEdgeOpt { cached: false, has: false, id: -1 };
}

fn ecs_ad_edges_cache_remove(e: EcsAdEdges, bundle_id: i32, has: bool, archetype_id: i32) -> EcsAdEdges {
    if e.r_len >= 4 { return e; };
    if e.r_len == 0 {
        return EcsAdEdges {
            i_len: e.i_len, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
            r_len: 1, r_b0: bundle_id, r_has0: has, r_id0: archetype_id,
            r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1, r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
            t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
            t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
        };
    };
    if e.r_len == 1 {
        return EcsAdEdges {
            i_len: e.i_len, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
            r_len: 2, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0,
            r_b1: bundle_id, r_has1: has, r_id1: archetype_id,
            r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
            t_len: e.t_len, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0, t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1,
            t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
        };
    };
    return e;
}

fn ecs_ad_edges_get_take(e: EcsAdEdges, bundle_id: i32) -> EcsAdEdgeOpt {
    if e.t_len >= 1 { if e.t_b0 == bundle_id { return EcsAdEdgeOpt { cached: true, has: e.t_has0, id: e.t_id0 }; }; };
    if e.t_len >= 2 { if e.t_b1 == bundle_id { return EcsAdEdgeOpt { cached: true, has: e.t_has1, id: e.t_id1 }; }; };
    return EcsAdEdgeOpt { cached: false, has: false, id: -1 };
}

fn ecs_ad_edges_cache_take(e: EcsAdEdges, bundle_id: i32, has: bool, archetype_id: i32) -> EcsAdEdges {
    if e.t_len >= 2 { return e; };
    if e.t_len == 0 {
        return EcsAdEdges {
            i_len: e.i_len, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
            r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
            r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
            t_len: 1, t_b0: bundle_id, t_has0: has, t_id0: archetype_id,
            t_b1: e.t_b1, t_has1: e.t_has1, t_id1: e.t_id1, t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
        };
    };
    return EcsAdEdges {
        i_len: e.i_len, i_b0: e.i_b0, i_a0: e.i_a0, i_b1: e.i_b1, i_a1: e.i_a1, i_b2: e.i_b2, i_a2: e.i_a2, i_b3: e.i_b3, i_a3: e.i_a3,
        r_len: e.r_len, r_b0: e.r_b0, r_has0: e.r_has0, r_id0: e.r_id0, r_b1: e.r_b1, r_has1: e.r_has1, r_id1: e.r_id1,
        r_b2: e.r_b2, r_has2: e.r_has2, r_id2: e.r_id2, r_b3: e.r_b3, r_has3: e.r_has3, r_id3: e.r_id3,
        t_len: 2, t_b0: e.t_b0, t_has0: e.t_has0, t_id0: e.t_id0,
        t_b1: bundle_id, t_has1: has, t_id1: archetype_id,
        t_b2: e.t_b2, t_has2: e.t_has2, t_id2: e.t_id2, t_b3: e.t_b3, t_has3: e.t_has3, t_id3: e.t_id3,
    };
}

// Archetype
struct EcsAdArchetype {
    id: i32,
    table_id: i32,
    // components max 4: id + storage(0 table/1 sparse)
    c_len: i32,
    c0: i32, st0: i32,
    c1: i32, st1: i32,
    c2: i32, st2: i32,
    c3: i32, st3: i32,
    flags: i32,
    // entities max 8
    e_len: i32,
    e0: EcsAdEntity, e1: EcsAdEntity, e2: EcsAdEntity, e3: EcsAdEntity,
    edges: EcsAdEdges,
}

fn ecs_ad_archetype_new(id: i32, table_id: i32) -> EcsAdArchetype {
    let empty_e = ecs_ad_entity_new(0, 0);
    return EcsAdArchetype {
        id: id, table_id: table_id,
        c_len: 0, c0: -1, st0: 0, c1: -1, st1: 0, c2: -1, st2: 0, c3: -1, st3: 0,
        flags: 0, e_len: 0,
        e0: empty_e, e1: empty_e, e2: empty_e, e3: empty_e,
        edges: ecs_ad_edges_new(),
    };
}

fn ecs_ad_archetype_id(a: EcsAdArchetype) -> i32 { return a.id; }
fn ecs_ad_archetype_table_id(a: EcsAdArchetype) -> i32 { return a.table_id; }
fn ecs_ad_archetype_len(a: EcsAdArchetype) -> i32 { return a.e_len; }
fn ecs_ad_archetype_component_count(a: EcsAdArchetype) -> i32 { return a.c_len; }
fn ecs_ad_archetype_flags(a: EcsAdArchetype) -> i32 { return a.flags; }
fn ecs_ad_archetype_is_empty(a: EcsAdArchetype) -> bool {
    if a.e_len == 0 { return true; };
    return false;
}

fn ecs_ad_archetype_has_component(a: EcsAdArchetype, component_id: i32) -> bool {
    if a.c_len >= 1 { if a.c0 == component_id { return true; }; };
    if a.c_len >= 2 { if a.c1 == component_id { return true; }; };
    if a.c_len >= 3 { if a.c2 == component_id { return true; }; };
    if a.c_len >= 4 { if a.c3 == component_id { return true; }; };
    return false;
}

fn ecs_ad_archetype_add_component(a: EcsAdArchetype, component_id: i32, storage_type: i32) -> EcsAdArchetype {
    if ecs_ad_archetype_has_component(a, component_id) { return a; };
    if a.c_len >= 4 { return a; };
    let n = a.c_len;
    let c0 = a.c0; let st0 = a.st0; let c1 = a.c1; let st1 = a.st1;
    let c2 = a.c2; let st2 = a.st2; let c3 = a.c3; let st3 = a.st3;
    if n == 0 { c0 = component_id; st0 = storage_type; };
    if n == 1 { c1 = component_id; st1 = storage_type; };
    if n == 2 { c2 = component_id; st2 = storage_type; };
    if n == 3 { c3 = component_id; st3 = storage_type; };
    return EcsAdArchetype {
        id: a.id, table_id: a.table_id,
        c_len: n + 1, c0: c0, st0: st0, c1: c1, st1: st1, c2: c2, st2: st2, c3: c3, st3: st3,
        flags: a.flags, e_len: a.e_len, e0: a.e0, e1: a.e1, e2: a.e2, e3: a.e3, edges: a.edges,
    };
}

fn ecs_ad_archetype_set_flag(a: EcsAdArchetype, bit: i32) -> EcsAdArchetype {
    return EcsAdArchetype {
        id: a.id, table_id: a.table_id,
        c_len: a.c_len, c0: a.c0, st0: a.st0, c1: a.c1, st1: a.st1, c2: a.c2, st2: a.st2, c3: a.c3, st3: a.st3,
        flags: a.flags | bit, e_len: a.e_len, e0: a.e0, e1: a.e1, e2: a.e2, e3: a.e3, edges: a.edges,
    };
}

fn ecs_ad_archetype_has_flag(a: EcsAdArchetype, bit: i32) -> bool {
    if (a.flags & bit) != 0 { return true; };
    return false;
}

fn ecs_ad_archetype_allocate(a: EcsAdArchetype, entity: i64, table_row: i32) -> (EcsAdArchetype, i32) {
    if a.e_len >= 4 { return (a, -1); };
    let row = a.e_len;
    let e0 = a.e0; let e1 = a.e1; let e2 = a.e2; let e3 = a.e3;
    if row == 0 {
        e0 = ecs_ad_entity_new(entity, table_row);
    };
    if row == 1 {
        e1 = ecs_ad_entity_new(entity, table_row);
    };
    if row == 2 {
        e2 = ecs_ad_entity_new(entity, table_row);
    };
    if row == 3 {
        e3 = ecs_ad_entity_new(entity, table_row);
    };
    let a2 = EcsAdArchetype {
        id: a.id, table_id: a.table_id,
        c_len: a.c_len, c0: a.c0, st0: a.st0, c1: a.c1, st1: a.st1, c2: a.c2, st2: a.st2, c3: a.c3, st3: a.st3,
        flags: a.flags, e_len: row + 1, e0: e0, e1: e1, e2: e2, e3: e3, edges: a.edges,
    };
    return (a2, row);
}

fn ecs_ad_archetype_entity_at(a: EcsAdArchetype, row: i32) -> EcsAdEntity {
    if row == 0 { return a.e0; };
    if row == 1 { return a.e1; };
    if row == 2 { return a.e2; };
    if row == 3 { return a.e3; };
    return ecs_ad_entity_new(0, 0);
}

// swap remove entity row
fn ecs_ad_archetype_swap_remove(a: EcsAdArchetype, row: i32) -> EcsAdArchetype {
    if row < 0 || row >= a.e_len { return a; };
    let last = a.e_len - 1;
    let e0 = a.e0; let e1 = a.e1; let e2 = a.e2; let e3 = a.e3;
    if row != last {
        let moved = ecs_ad_archetype_entity_at(a, last);
        let me = ecs_ad_entity_id(moved);
        let mt = ecs_ad_entity_table_row(moved);
        if row == 0 { e0 = ecs_ad_entity_new(me, mt); };
        if row == 1 { e1 = ecs_ad_entity_new(me, mt); };
        if row == 2 { e2 = ecs_ad_entity_new(me, mt); };
        if row == 3 { e3 = ecs_ad_entity_new(me, mt); };
    };
    return EcsAdArchetype {
        id: a.id, table_id: a.table_id,
        c_len: a.c_len, c0: a.c0, st0: a.st0, c1: a.c1, st1: a.st1, c2: a.c2, st2: a.st2, c3: a.c3, st3: a.st3,
        flags: a.flags, e_len: last, e0: e0, e1: e1, e2: e2, e3: e3, edges: a.edges,
    };
}

fn ecs_ad_archetype_set_edges(a: EcsAdArchetype, edges: EcsAdEdges) -> EcsAdArchetype {
    return EcsAdArchetype {
        id: a.id, table_id: a.table_id,
        c_len: a.c_len, c0: a.c0, st0: a.st0, c1: a.c1, st1: a.st1, c2: a.c2, st2: a.st2, c3: a.c3, st3: a.st3,
        flags: a.flags, e_len: a.e_len, e0: a.e0, e1: a.e1, e2: a.e2, e3: a.e3, edges: edges,
    };
}

fn ecs_ad_archetype_edges(a: EcsAdArchetype) -> EcsAdEdges { return a.edges; }

// signature equality for up to 4 sorted component ids
fn ecs_ad_sig_eq(n1: i32, a0: i32, a1: i32, a2: i32, a3: i32, n2: i32, b0: i32, b1: i32, b2: i32, b3: i32) -> bool {
    if n1 != n2 { return false; };
    if n1 >= 1 { if a0 != b0 { return false; }; };
    if n1 >= 2 { if a1 != b1 { return false; }; };
    if n1 >= 3 { if a2 != b2 { return false; }; };
    if n1 >= 4 { if a3 != b3 { return false; }; };
    return true;
}

// Archetypes registry
struct EcsAdArchetypes {
    len: i32, // includes empty archetype 0
    generation: i32,
    a0: EcsAdArchetype,
    a1: EcsAdArchetype,
    a2: EcsAdArchetype,
    a3: EcsAdArchetype,
}

fn ecs_ad_archetypes_new() -> EcsAdArchetypes {
    // Bevy starts with empty archetype id 0
    return EcsAdArchetypes {
        len: 1, generation: 0,
        a0: ecs_ad_archetype_new(0, 0),
        a1: ecs_ad_archetype_new(1, 0),
        a2: ecs_ad_archetype_new(2, 0),
        a3: ecs_ad_archetype_new(3, 0),
    };
}

fn ecs_ad_archetypes_len(a: EcsAdArchetypes) -> i32 { return a.len; }
fn ecs_ad_archetypes_generation(a: EcsAdArchetypes) -> i32 { return a.generation; }
fn ecs_ad_archetypes_empty_id() -> i32 { return 0; }

fn ecs_ad_archetypes_get(a: EcsAdArchetypes, id: i32) -> (bool, EcsAdArchetype) {
    if id < 0 || id >= a.len { return (false, ecs_ad_archetype_new(-1, 0)); };
    if id == 0 { return (true, a.a0); };
    if id == 1 { return (true, a.a1); };
    if id == 2 { return (true, a.a2); };
    if id == 3 { return (true, a.a3); };
    return (false, ecs_ad_archetype_new(-1, 0));
}

fn ecs_ad_archetypes_set(a: EcsAdArchetypes, id: i32, arch: EcsAdArchetype) -> EcsAdArchetypes {
    if id == 0 {
        return EcsAdArchetypes { len: a.len, generation: a.generation, a0: arch, a1: a.a1, a2: a.a2, a3: a.a3 };
    };
    if id == 1 {
        return EcsAdArchetypes { len: a.len, generation: a.generation, a0: a.a0, a1: arch, a2: a.a2, a3: a.a3 };
    };
    if id == 2 {
        return EcsAdArchetypes { len: a.len, generation: a.generation, a0: a.a0, a1: a.a1, a2: arch, a3: a.a3 };
    };
    if id == 3 {
        return EcsAdArchetypes { len: a.len, generation: a.generation, a0: a.a0, a1: a.a1, a2: a.a2, a3: arch };
    };
    return a;
}

fn ecs_ad_archetype_sig_match(arch: EcsAdArchetype, n: i32, c0: i32, c1: i32, c2: i32, c3: i32) -> bool {
    return ecs_ad_sig_eq(arch.c_len, arch.c0, arch.c1, arch.c2, arch.c3, n, c0, c1, c2, c3);
}

fn ecs_ad_archetypes_find(a: EcsAdArchetypes, n: i32, c0: i32, c1: i32, c2: i32, c3: i32) -> i32 {
    if a.len >= 1 {
        if ecs_ad_archetype_sig_match(a.a0, n, c0, c1, c2, c3) { return 0; };
    };
    if a.len >= 2 {
        if ecs_ad_archetype_sig_match(a.a1, n, c0, c1, c2, c3) { return 1; };
    };
    if a.len >= 3 {
        if ecs_ad_archetype_sig_match(a.a2, n, c0, c1, c2, c3) { return 2; };
    };
    if a.len >= 4 {
        if ecs_ad_archetype_sig_match(a.a3, n, c0, c1, c2, c3) { return 3; };
    };
    return -1;
}

fn ecs_ad_archetypes_get_or_create(a: EcsAdArchetypes, n: i32, c0: i32, c1: i32, c2: i32, c3: i32, table_id: i32) -> (EcsAdArchetypes, i32) {
    let found = ecs_ad_archetypes_find(a, n, c0, c1, c2, c3);
    if found >= 0 { return (a, found); };
    if a.len >= 4 { return (a, -1); };
    let id = a.len;
    let gen = a.generation + 1;
    let arch = ecs_ad_archetype_new(id, table_id);
    if n >= 1 {
        arch = ecs_ad_archetype_add_component(arch, c0, 0);
    };
    if n >= 2 {
        arch = ecs_ad_archetype_add_component(arch, c1, 0);
    };
    if n >= 3 {
        arch = ecs_ad_archetype_add_component(arch, c2, 0);
    };
    if n >= 4 {
        arch = ecs_ad_archetype_add_component(arch, c3, 0);
    };
    let a2 = ecs_ad_archetypes_set(a, id, arch);
    let out = EcsAdArchetypes {
        len: id + 1, generation: gen,
        a0: a2.a0, a1: a2.a1, a2: a2.a2, a3: a2.a3,
    };
    return (out, id);
}
