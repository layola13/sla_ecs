// Deepened Bevy ECS resource surface.
// Mirrors src/resource.rs: Resource trait marker, IsResource component hooks
// (on_insert uniqueness, on_discard cache invalidation, on_despawn warning),
// ResourceEntities sparse cache get/insert/remove/iter, conflict cleanup when
// inserting a second resource entity for the same ComponentId.
// Shallow lib/resource.sla + lib/resource_mod.sla retained.

// === status / warning codes ===
const ECS_RD_OK: i32 = 0;
const ECS_RD_WARN_DUPLICATE_INSERT: i32 = 1;
const ECS_RD_WARN_DESPAWN: i32 = 2;
const ECS_RD_ERR_DESPAWNED_CANONICAL: i32 = 3;
const ECS_RD_ERR_NOT_FOUND: i32 = 4;

// fixed capacity for resource component slots and entity table
const ECS_RD_CAP: i32 = 8;

// === IsResource marker ===
struct EcsIsResourceDeep {
    resource_component_id: i64,
}

fn ecs_rd_is_resource_new(component_id: i64) -> EcsIsResourceDeep {
    return EcsIsResourceDeep { resource_component_id: component_id };
}

fn ecs_rd_is_resource_id(m: EcsIsResourceDeep) -> i64 {
    return m.resource_component_id;
}

// === World-like store for resource entities + hooks ===
struct EcsResourceWorldDeep {
    // ResourceEntities cache: component_id -> entity ( -1 empty)
    c0: i64, c1: i64, c2: i64, c3: i64,
    c4: i64, c5: i64, c6: i64, c7: i64,
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    cache_len: i32,
    // entity table: occupied, has_is_resource, is_resource_cid, has_resource_value, value
    o0: bool, o1: bool, o2: bool, o3: bool,
    o4: bool, o5: bool, o6: bool, o7: bool,
    ir0: bool, ir1: bool, ir2: bool, ir3: bool,
    ir4: bool, ir5: bool, ir6: bool, ir7: bool,
    irc0: i64, irc1: i64, irc2: i64, irc3: i64,
    irc4: i64, irc5: i64, irc6: i64, irc7: i64,
    rv0: bool, rv1: bool, rv2: bool, rv3: bool,
    rv4: bool, rv5: bool, rv6: bool, rv7: bool,
    v0: i64, v1: i64, v2: i64, v3: i64,
    v4: i64, v5: i64, v6: i64, v7: i64,
    // bookkeeping
    next_entity: i64,
    warn_count: i64,
    last_warn: i32,
    last_error: i32,
    last_removed_entity: i64,
    despawn_warn_count: i64,
    command_remove_count: i64,
}

fn ecs_rd_world_new() -> EcsResourceWorldDeep {
    return EcsResourceWorldDeep {
        c0: -1, c1: -1, c2: -1, c3: -1,
        c4: -1, c5: -1, c6: -1, c7: -1,
        e0: -1, e1: -1, e2: -1, e3: -1,
        e4: -1, e5: -1, e6: -1, e7: -1,
        cache_len: 0,
        o0: false, o1: false, o2: false, o3: false,
        o4: false, o5: false, o6: false, o7: false,
        ir0: false, ir1: false, ir2: false, ir3: false,
        ir4: false, ir5: false, ir6: false, ir7: false,
        irc0: -1, irc1: -1, irc2: -1, irc3: -1,
        irc4: -1, irc5: -1, irc6: -1, irc7: -1,
        rv0: false, rv1: false, rv2: false, rv3: false,
        rv4: false, rv5: false, rv6: false, rv7: false,
        v0: 0, v1: 0, v2: 0, v3: 0,
        v4: 0, v5: 0, v6: 0, v7: 0,
        next_entity: 1,
        warn_count: 0,
        last_warn: ECS_RD_OK,
        last_error: ECS_RD_OK,
        last_removed_entity: -1,
        despawn_warn_count: 0,
        command_remove_count: 0,
    };
}

fn ecs_rd_warn_count(w: EcsResourceWorldDeep) -> i64 { return w.warn_count; }
fn ecs_rd_last_warn(w: EcsResourceWorldDeep) -> i32 { return w.last_warn; }
fn ecs_rd_last_error(w: EcsResourceWorldDeep) -> i32 { return w.last_error; }
fn ecs_rd_despawn_warn_count(w: EcsResourceWorldDeep) -> i64 { return w.despawn_warn_count; }
fn ecs_rd_command_remove_count(w: EcsResourceWorldDeep) -> i64 { return w.command_remove_count; }
fn ecs_rd_cache_len(w: EcsResourceWorldDeep) -> i32 { return w.cache_len; }
fn ecs_rd_last_removed_entity(w: EcsResourceWorldDeep) -> i64 { return w.last_removed_entity; }

fn ecs_rd_entity_occupied(w: EcsResourceWorldDeep, e: i64) -> bool {
    if e == 0 { return w.o0; };
    if e == 1 { return w.o1; };
    if e == 2 { return w.o2; };
    if e == 3 { return w.o3; };
    if e == 4 { return w.o4; };
    if e == 5 { return w.o5; };
    if e == 6 { return w.o6; };
    if e == 7 { return w.o7; };
    return false;
}

fn ecs_rd_set_occupied(w: EcsResourceWorldDeep, e: i64, v: bool) -> EcsResourceWorldDeep {
    if e == 0 { w.o0 = v; };
    if e == 1 { w.o1 = v; };
    if e == 2 { w.o2 = v; };
    if e == 3 { w.o3 = v; };
    if e == 4 { w.o4 = v; };
    if e == 5 { w.o5 = v; };
    if e == 6 { w.o6 = v; };
    if e == 7 { w.o7 = v; };
    return w;
}

fn ecs_rd_has_is_resource(w: EcsResourceWorldDeep, e: i64) -> bool {
    if e == 0 { return w.ir0; };
    if e == 1 { return w.ir1; };
    if e == 2 { return w.ir2; };
    if e == 3 { return w.ir3; };
    if e == 4 { return w.ir4; };
    if e == 5 { return w.ir5; };
    if e == 6 { return w.ir6; };
    if e == 7 { return w.ir7; };
    return false;
}

fn ecs_rd_set_is_resource(w: EcsResourceWorldDeep, e: i64, present: bool, cid: i64) -> EcsResourceWorldDeep {
    if e == 0 { w.ir0 = present; w.irc0 = cid; };
    if e == 1 { w.ir1 = present; w.irc1 = cid; };
    if e == 2 { w.ir2 = present; w.irc2 = cid; };
    if e == 3 { w.ir3 = present; w.irc3 = cid; };
    if e == 4 { w.ir4 = present; w.irc4 = cid; };
    if e == 5 { w.ir5 = present; w.irc5 = cid; };
    if e == 6 { w.ir6 = present; w.irc6 = cid; };
    if e == 7 { w.ir7 = present; w.irc7 = cid; };
    return w;
}

fn ecs_rd_is_resource_cid(w: EcsResourceWorldDeep, e: i64) -> i64 {
    if e == 0 { return w.irc0; };
    if e == 1 { return w.irc1; };
    if e == 2 { return w.irc2; };
    if e == 3 { return w.irc3; };
    if e == 4 { return w.irc4; };
    if e == 5 { return w.irc5; };
    if e == 6 { return w.irc6; };
    if e == 7 { return w.irc7; };
    return -1;
}

fn ecs_rd_has_value(w: EcsResourceWorldDeep, e: i64) -> bool {
    if e == 0 { return w.rv0; };
    if e == 1 { return w.rv1; };
    if e == 2 { return w.rv2; };
    if e == 3 { return w.rv3; };
    if e == 4 { return w.rv4; };
    if e == 5 { return w.rv5; };
    if e == 6 { return w.rv6; };
    if e == 7 { return w.rv7; };
    return false;
}

fn ecs_rd_set_value(w: EcsResourceWorldDeep, e: i64, present: bool, value: i64) -> EcsResourceWorldDeep {
    if e == 0 { w.rv0 = present; w.v0 = value; };
    if e == 1 { w.rv1 = present; w.v1 = value; };
    if e == 2 { w.rv2 = present; w.v2 = value; };
    if e == 3 { w.rv3 = present; w.v3 = value; };
    if e == 4 { w.rv4 = present; w.v4 = value; };
    if e == 5 { w.rv5 = present; w.v5 = value; };
    if e == 6 { w.rv6 = present; w.v6 = value; };
    if e == 7 { w.rv7 = present; w.v7 = value; };
    return w;
}

fn ecs_rd_get_value(w: EcsResourceWorldDeep, e: i64) -> i64 {
    if e == 0 { return w.v0; };
    if e == 1 { return w.v1; };
    if e == 2 { return w.v2; };
    if e == 3 { return w.v3; };
    if e == 4 { return w.v4; };
    if e == 5 { return w.v5; };
    if e == 6 { return w.v6; };
    if e == 7 { return w.v7; };
    return 0;
}

// cache helpers
fn ecs_rd_cache_find(w: EcsResourceWorldDeep, component_id: i64) -> i32 {
    let i: i32 = 0;
    while i < w.cache_len {
        let cid = -1;
        if i == 0 { cid = w.c0; };
        if i == 1 { cid = w.c1; };
        if i == 2 { cid = w.c2; };
        if i == 3 { cid = w.c3; };
        if i == 4 { cid = w.c4; };
        if i == 5 { cid = w.c5; };
        if i == 6 { cid = w.c6; };
        if i == 7 { cid = w.c7; };
        if cid == component_id { return i; };
        i = i + 1;
    }
    return -1;
}

fn ecs_rd_cache_get(w: EcsResourceWorldDeep, component_id: i64) -> (bool, i64) {
    let idx = ecs_rd_cache_find(w, component_id);
    if idx < 0 { return (false, -1); };
    let ent: i64 = -1;
    if idx == 0 { ent = w.e0; };
    if idx == 1 { ent = w.e1; };
    if idx == 2 { ent = w.e2; };
    if idx == 3 { ent = w.e3; };
    if idx == 4 { ent = w.e4; };
    if idx == 5 { ent = w.e5; };
    if idx == 6 { ent = w.e6; };
    if idx == 7 { ent = w.e7; };
    return (true, ent);
}

fn ecs_rd_cache_set(w: EcsResourceWorldDeep, component_id: i64, entity: i64) -> EcsResourceWorldDeep {
    let idx = ecs_rd_cache_find(w, component_id);
    if idx < 0 {
        if w.cache_len >= ECS_RD_CAP { return w; };
        idx = w.cache_len;
        w.cache_len = w.cache_len + 1;
        if idx == 0 { w.c0 = component_id; };
        if idx == 1 { w.c1 = component_id; };
        if idx == 2 { w.c2 = component_id; };
        if idx == 3 { w.c3 = component_id; };
        if idx == 4 { w.c4 = component_id; };
        if idx == 5 { w.c5 = component_id; };
        if idx == 6 { w.c6 = component_id; };
        if idx == 7 { w.c7 = component_id; };
    };
    if idx == 0 { w.e0 = entity; };
    if idx == 1 { w.e1 = entity; };
    if idx == 2 { w.e2 = entity; };
    if idx == 3 { w.e3 = entity; };
    if idx == 4 { w.e4 = entity; };
    if idx == 5 { w.e5 = entity; };
    if idx == 6 { w.e6 = entity; };
    if idx == 7 { w.e7 = entity; };
    return w;
}

fn ecs_rd_cache_remove(w: EcsResourceWorldDeep, component_id: i64) -> EcsResourceWorldDeep {
    let idx = ecs_rd_cache_find(w, component_id);
    if idx < 0 { return w; };
    let last = w.cache_len - 1;
    // read last
    let last_c: i64 = -1;
    let last_e: i64 = -1;
    if last == 0 { last_c = w.c0; last_e = w.e0; };
    if last == 1 { last_c = w.c1; last_e = w.e1; };
    if last == 2 { last_c = w.c2; last_e = w.e2; };
    if last == 3 { last_c = w.c3; last_e = w.e3; };
    if last == 4 { last_c = w.c4; last_e = w.e4; };
    if last == 5 { last_c = w.c5; last_e = w.e5; };
    if last == 6 { last_c = w.c6; last_e = w.e6; };
    if last == 7 { last_c = w.c7; last_e = w.e7; };
    // write last into idx
    if idx == 0 { w.c0 = last_c; w.e0 = last_e; };
    if idx == 1 { w.c1 = last_c; w.e1 = last_e; };
    if idx == 2 { w.c2 = last_c; w.e2 = last_e; };
    if idx == 3 { w.c3 = last_c; w.e3 = last_e; };
    if idx == 4 { w.c4 = last_c; w.e4 = last_e; };
    if idx == 5 { w.c5 = last_c; w.e5 = last_e; };
    if idx == 6 { w.c6 = last_c; w.e6 = last_e; };
    if idx == 7 { w.c7 = last_c; w.e7 = last_e; };
    // clear last
    if last == 0 { w.c0 = -1; w.e0 = -1; };
    if last == 1 { w.c1 = -1; w.e1 = -1; };
    if last == 2 { w.c2 = -1; w.e2 = -1; };
    if last == 3 { w.c3 = -1; w.e3 = -1; };
    if last == 4 { w.c4 = -1; w.e4 = -1; };
    if last == 5 { w.c5 = -1; w.e5 = -1; };
    if last == 6 { w.c6 = -1; w.e6 = -1; };
    if last == 7 { w.c7 = -1; w.e7 = -1; };
    w.cache_len = last;
    return w;
}

fn ecs_rd_cache_iter_at(w: EcsResourceWorldDeep, idx: i32) -> (bool, i64, i64) {
    if idx < 0 || idx >= w.cache_len { return (false, -1, -1); };
    let cid: i64 = -1;
    let ent: i64 = -1;
    if idx == 0 { cid = w.c0; ent = w.e0; };
    if idx == 1 { cid = w.c1; ent = w.e1; };
    if idx == 2 { cid = w.c2; ent = w.e2; };
    if idx == 3 { cid = w.c3; ent = w.e3; };
    if idx == 4 { cid = w.c4; ent = w.e4; };
    if idx == 5 { cid = w.c5; ent = w.e5; };
    if idx == 6 { cid = w.c6; ent = w.e6; };
    if idx == 7 { cid = w.c7; ent = w.e7; };
    return (true, cid, ent);
}

// spawn empty entity slot 0..7 using next free
fn ecs_rd_spawn_entity(w: EcsResourceWorldDeep) -> (EcsResourceWorldDeep, i64) {
    let e: i64 = 0;
    while e < 8 {
        if ecs_rd_entity_occupied(w, e) != true {
            w = ecs_rd_set_occupied(w, e, true);
            w = ecs_rd_set_is_resource(w, e, false, -1);
            w = ecs_rd_set_value(w, e, false, 0);
            w.last_error = ECS_RD_OK;
            return (w, e);
        };
        e = e + 1;
    }
    w.last_error = ECS_RD_ERR_NOT_FOUND;
    return (w, -1);
}

// remove resource value + IsResource from entity (command cleanup)
fn ecs_rd_entity_strip_resource(w: EcsResourceWorldDeep, e: i64) -> EcsResourceWorldDeep {
    w = ecs_rd_set_is_resource(w, e, false, -1);
    w = ecs_rd_set_value(w, e, false, 0);
    w.command_remove_count = w.command_remove_count + 1;
    w.last_removed_entity = e;
    return w;
}

// IsResource::on_insert
fn ecs_rd_on_insert_is_resource(
    w: EcsResourceWorldDeep,
    entity: i64,
    resource_component_id: i64
) -> EcsResourceWorldDeep {
    let got = ecs_rd_cache_get(w, resource_component_id);
    if got.0 {
        let original = got.1;
        if ecs_rd_entity_occupied(w, original) != true {
            // Bevy panics if canonical resource entity was despawned
            w.last_error = ECS_RD_ERR_DESPAWNED_CANONICAL;
            return w;
        };
        if original != entity {
            // conflict: strip new entity's resource components
            w = ecs_rd_entity_strip_resource(w, entity);
            w.warn_count = w.warn_count + 1;
            w.last_warn = ECS_RD_WARN_DUPLICATE_INSERT;
            w.last_error = ECS_RD_OK;
            return w;
        };
        // same entity re-insert: keep
        w.last_error = ECS_RD_OK;
        return w;
    };
    // first registration
    w = ecs_rd_cache_set(w, resource_component_id, entity);
    w.last_error = ECS_RD_OK;
    return w;
}

// IsResource::on_discard
fn ecs_rd_on_discard_is_resource(
    w: EcsResourceWorldDeep,
    entity: i64,
    resource_component_id: i64
) -> EcsResourceWorldDeep {
    let got = ecs_rd_cache_get(w, resource_component_id);
    if got.0 {
        if got.1 == entity {
            w = ecs_rd_cache_remove(w, resource_component_id);
            // also remove resource value component
            w = ecs_rd_set_value(w, entity, false, 0);
            w.command_remove_count = w.command_remove_count + 1;
        };
    };
    w = ecs_rd_set_is_resource(w, entity, false, -1);
    w.last_error = ECS_RD_OK;
    return w;
}

// IsResource::on_despawn
fn ecs_rd_on_despawn_is_resource(w: EcsResourceWorldDeep, entity: i64) -> EcsResourceWorldDeep {
    w.despawn_warn_count = w.despawn_warn_count + 1;
    w.last_warn = ECS_RD_WARN_DESPAWN;
    // still mark unoccupied
    w = ecs_rd_set_occupied(w, entity, false);
    w = ecs_rd_set_is_resource(w, entity, false, -1);
    w = ecs_rd_set_value(w, entity, false, 0);
    return w;
}

// insert_resource path: spawn entity, attach value + IsResource, run on_insert
fn ecs_rd_insert_resource(
    w: EcsResourceWorldDeep,
    component_id: i64,
    value: i64
) -> (EcsResourceWorldDeep, i64) {
    // if resource already exists on its canonical entity, overwrite value there
    let got = ecs_rd_cache_get(w, component_id);
    if got.0 {
        let ent = got.1;
        if ecs_rd_entity_occupied(w, ent) {
            w = ecs_rd_set_value(w, ent, true, value);
            // ensure IsResource present
            if ecs_rd_has_is_resource(w, ent) != true {
                w = ecs_rd_set_is_resource(w, ent, true, component_id);
                w = ecs_rd_on_insert_is_resource(w, ent, component_id);
            };
            w.last_error = ECS_RD_OK;
            return (w, ent);
        };
    };
    let sp = ecs_rd_spawn_entity(w);
    w = sp.0;
    let ent = sp.1;
    if ent < 0 { return (w, -1); };
    w = ecs_rd_set_value(w, ent, true, value);
    w = ecs_rd_set_is_resource(w, ent, true, component_id);
    w = ecs_rd_on_insert_is_resource(w, ent, component_id);
    return (w, ent);
}

// spawn raw resource entity (may conflict)
fn ecs_rd_spawn_resource_entity(
    w: EcsResourceWorldDeep,
    component_id: i64,
    value: i64
) -> (EcsResourceWorldDeep, i64) {
    let sp = ecs_rd_spawn_entity(w);
    w = sp.0;
    let ent = sp.1;
    if ent < 0 { return (w, -1); };
    w = ecs_rd_set_value(w, ent, true, value);
    w = ecs_rd_set_is_resource(w, ent, true, component_id);
    w = ecs_rd_on_insert_is_resource(w, ent, component_id);
    return (w, ent);
}

// remove IsResource (invalidates resource)
fn ecs_rd_remove_is_resource(w: EcsResourceWorldDeep, entity: i64) -> EcsResourceWorldDeep {
    if ecs_rd_has_is_resource(w, entity) != true {
        w.last_error = ECS_RD_ERR_NOT_FOUND;
        return w;
    };
    let cid = ecs_rd_is_resource_cid(w, entity);
    w = ecs_rd_on_discard_is_resource(w, entity, cid);
    return w;
}

// get_resource by component id
fn ecs_rd_get_resource(w: EcsResourceWorldDeep, component_id: i64) -> (bool, i64, i64) {
    let got = ecs_rd_cache_get(w, component_id);
    if got.0 != true { return (false, -1, 0); };
    let ent = got.1;
    if ecs_rd_entity_occupied(w, ent) != true { return (false, ent, 0); };
    if ecs_rd_has_value(w, ent) != true { return (false, ent, 0); };
    return (true, ent, ecs_rd_get_value(w, ent));
}

// contains resource
fn ecs_rd_contains_resource(w: EcsResourceWorldDeep, component_id: i64) -> bool {
    let g = ecs_rd_get_resource(w, component_id);
    return g.0;
}

// init_resource: insert if missing
fn ecs_rd_init_resource(w: EcsResourceWorldDeep, component_id: i64, default_value: i64) -> (EcsResourceWorldDeep, i64) {
    if ecs_rd_contains_resource(w, component_id) {
        let g = ecs_rd_get_resource(w, component_id);
        return (w, g.1);
    };
    return ecs_rd_insert_resource(w, component_id, default_value);
}

// remove_resource
fn ecs_rd_remove_resource(w: EcsResourceWorldDeep, component_id: i64) -> (EcsResourceWorldDeep, bool) {
    let got = ecs_rd_cache_get(w, component_id);
    if got.0 != true { return (w, false); };
    let ent = got.1;
    w = ecs_rd_remove_is_resource(w, ent);
    return (w, true);
}

// query count of entities with resource value component still present
fn ecs_rd_count_entities_with_resource_value(w: EcsResourceWorldDeep, component_id: i64) -> i32 {
    let n: i32 = 0;
    let e: i64 = 0;
    while e < 8 {
        if ecs_rd_entity_occupied(w, e) {
            if ecs_rd_has_value(w, e) {
                if ecs_rd_has_is_resource(w, e) {
                    if ecs_rd_is_resource_cid(w, e) == component_id {
                        n = n + 1;
                    };
                };
            };
        };
        e = e + 1;
    }
    return n;
}

// Resource trait marker (compile-time in Bevy); runtime tag
fn ecs_rd_resource_trait_marker() -> i32 {
    return 1;
}
