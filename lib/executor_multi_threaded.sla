fn ecs_executor_run_plan_drive_one(p: EcsExecutorRunPlan) -> EcsExecutorRunPlan {
    let next = ecs_executor_run_plan_next_runnable(p);
    if next < 0 {
        if ecs_executor_state_completed_count(p.executor.state) < p.executor.state.system_count { p.stalled = true; };
        return p;
    };
    let spec = ecs_executor_run_plan_spec_at(p, next);
    if spec.should_run != true || ecs_executor_state_is_skipped(p.executor.state, next) {
        return ecs_executor_run_plan_skip_ready(p, next);
    };
    p.executor.state = ecs_executor_state_start_system(p.executor.state, next, spec.is_exclusive, spec.is_local);
    p.run_order.push(next);
    p.executor.systems_run = p.executor.systems_run + 1;
    let deps = ecs_executor_run_plan_dependents_at(p, next);
    if spec.is_apply_deferred {
        p = ecs_executor_run_plan_apply_deferred_barrier(p);
    };
    p.executor.state = ecs_executor_state_complete_system_with_flags(p.executor.state, next, deps, spec.is_exclusive, spec.is_local);
    p = ecs_executor_run_plan_apply_deferred_for(p, next, spec);
    return p;
}

fn ecs_executor_run_plan_drive_ready_batch(p: EcsExecutorRunPlan, max_width: i64) -> EcsExecutorRunPlan {
    let taken = ecs_executor_run_plan_take_ready_batch(p, max_width);
    if len(taken.batch.systems) as i64 == 0 {
        if len(taken.batch.skipped) as i64 == 0 {
            if ecs_executor_state_completed_count(taken.plan.executor.state) < taken.plan.executor.state.system_count { taken.plan.stalled = true; };
        };
        return taken.plan;
    };
    return ecs_executor_run_plan_complete_ready_batch(taken.plan, taken.batch);
}

fn ecs_executor_run_plan_drive_all_batched(p: EcsExecutorRunPlan, max_width: i64) -> EcsExecutorRunPlan {
    let guard: i64 = 0;
    let limit = p.executor.state.system_count * 2 + 1;
    while guard < limit {
        if ecs_executor_state_completed_count(p.executor.state) >= p.executor.state.system_count { return p; };
        let before = ecs_executor_state_completed_count(p.executor.state);
        p = ecs_executor_run_plan_drive_ready_batch(p, max_width);
        let after = ecs_executor_state_completed_count(p.executor.state);
        if after == before { return p; };
        guard = guard + 1;
    }
    p.stalled = true;
    return p;
}

fn ecs_executor_run_plan_drive_all(p: EcsExecutorRunPlan) -> EcsExecutorRunPlan {
    let guard: i64 = 0;
    let limit = p.executor.state.system_count * 2 + 1;
    while guard < limit {
        if ecs_executor_state_completed_count(p.executor.state) >= p.executor.state.system_count { return p; };
        let before = ecs_executor_state_completed_count(p.executor.state);
        p = ecs_executor_run_plan_drive_one(p);
        let after = ecs_executor_state_completed_count(p.executor.state);
        if after == before { return p; };
        guard = guard + 1;
    }
    p.stalled = true;
    return p;
}

fn ecs_executor_run_plan_run_count(p: EcsExecutorRunPlan) -> i64 { return len(p.run_order) as i64; }
fn ecs_executor_run_plan_apply_count(p: EcsExecutorRunPlan) -> i64 { return len(p.apply_order) as i64; }
fn ecs_executor_run_plan_skipped_count(p: EcsExecutorRunPlan) -> i64 { return len(p.skipped_order) as i64; }
fn ecs_executor_run_plan_run_at(p: EcsExecutorRunPlan, index: i64) -> i64 { return p.run_order[index]; }
fn ecs_executor_run_plan_apply_at(p: EcsExecutorRunPlan, index: i64) -> i64 { return p.apply_order[index]; }
fn ecs_executor_run_plan_skipped_at(p: EcsExecutorRunPlan, index: i64) -> i64 { return p.skipped_order[index]; }
fn ecs_executor_run_plan_is_stalled(p: EcsExecutorRunPlan) -> bool { return p.stalled; }
fn ecs_executor_ready_batch_count(batch: EcsExecutorReadyBatch) -> i64 { return len(batch.systems) as i64; }
fn ecs_executor_ready_batch_skipped_count(batch: EcsExecutorReadyBatch) -> i64 { return len(batch.skipped) as i64; }
fn ecs_executor_ready_batch_at(batch: EcsExecutorReadyBatch, index: i64) -> i64 { return batch.systems[index]; }
fn ecs_executor_ready_batch_skipped_at(batch: EcsExecutorReadyBatch, index: i64) -> i64 { return batch.skipped[index]; }
fn ecs_executor_ready_batch_is_exclusive(batch: EcsExecutorReadyBatch) -> bool { return batch.is_exclusive; }
fn ecs_executor_ready_batch_is_local(batch: EcsExecutorReadyBatch) -> bool { return batch.is_local; }
fn ecs_executor_tick_loop_tick_count(r: EcsExecutorTickLoopResult) -> i64 { return r.tick_count; }
fn ecs_executor_tick_loop_lock_failed(r: EcsExecutorTickLoopResult) -> bool { return r.lock_failed; }
fn ecs_executor_tick_loop_batch_count(r: EcsExecutorTickLoopResult) -> i64 { return len(r.batches) as i64; }
fn ecs_executor_tick_loop_pending_completion_count(r: EcsExecutorTickLoopResult) -> i64 { return len(r.pending_completions) as i64; }
fn ecs_executor_tick_loop_pending_completion_at(r: EcsExecutorTickLoopResult, index: i64) -> i64 { return r.pending_completions[index]; }
fn ecs_executor_tick_loop_batch_system_count(r: EcsExecutorTickLoopResult, tick_index: i64) -> i64 { return len(r.batches[tick_index].systems) as i64; }
fn ecs_executor_tick_loop_batch_skipped_count(r: EcsExecutorTickLoopResult, tick_index: i64) -> i64 { return len(r.batches[tick_index].skipped) as i64; }
fn ecs_executor_tick_loop_batch_at(r: EcsExecutorTickLoopResult, tick_index: i64, batch_index: i64) -> i64 { return r.batches[tick_index].systems[batch_index]; }
fn ecs_executor_tick_loop_batch_skipped_at(r: EcsExecutorTickLoopResult, tick_index: i64, skipped_index: i64) -> i64 { return r.batches[tick_index].skipped[skipped_index]; }
