// Deepened Bevy ECS spawn-related hierarchy surface.
// Mirrors src/spawn.rs:
//   Spawn<B>, SpawnableList<R> { spawn, size_hint }
//   SpawnIter, SpawnWith, WithRelated, WithOneRelated
//   SpawnRelatedBundle / SpawnOneRelated
//   Relationship-linked child spawn with size_hint reserve
// Shallow bundle_spawner / spawn_batch retained.

// === World spawn log (fixed capacity 16) ===
struct EcsSpawnWorldDeep {
    next_entity: i64,
    // spawned entity ids
    e0: i64, e1: i64, e2: i64, e3: i64,
    e4: i64, e5: i64, e6: i64, e7: i64,
    e8: i64, e9: i64, e10: i64, e11: i64,
    e12: i64, e13: i64, e14: i64, e15: i64,
    len: i32,
    // parent relationship for each spawned: parent entity or -1
    p0: i64, p1: i64, p2: i64, p3: i64,
    p4: i64, p5: i64, p6: i64, p7: i64,
    p8: i64, p9: i64, p10: i64, p11: i64,
    p12: i64, p13: i64, p14: i64, p15: i64,
    // bundle type id per entity
    b0: i64, b1: i64, b2: i64, b3: i64,
    b4: i64, b5: i64, b6: i64, b7: i64,
    b8: i64, b9: i64, b10: i64, b11: i64,
    b12: i64, b13: i64, b14: i64, b15: i64,
    reserve_hints: i64,
}

fn ecs_spw_new(start: i64) -> EcsSpawnWorldDeep {
    return EcsSpawnWorldDeep {
        next_entity: start,
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        e8: 0, e9: 0, e10: 0, e11: 0, e12: 0, e13: 0, e14: 0, e15: 0,
        len: 0,
        p0: -1, p1: -1, p2: -1, p3: -1, p4: -1, p5: -1, p6: -1, p7: -1,
        p8: -1, p9: -1, p10: -1, p11: -1, p12: -1, p13: -1, p14: -1, p15: -1,
        b0: 0, b1: 0, b2: 0, b3: 0, b4: 0, b5: 0, b6: 0, b7: 0,
        b8: 0, b9: 0, b10: 0, b11: 0, b12: 0, b13: 0, b14: 0, b15: 0,
        reserve_hints: 0,
    };
}

fn ecs_spw_len(w: EcsSpawnWorldDeep) -> i32 { return w.len; }
fn ecs_spw_next(w: EcsSpawnWorldDeep) -> i64 { return w.next_entity; }
fn ecs_spw_reserve_hints(w: EcsSpawnWorldDeep) -> i64 { return w.reserve_hints; }

fn ecs_spw_entity_at(w: EcsSpawnWorldDeep, idx: i32) -> i64 {
    if idx == 0 { return w.e0; };
    if idx == 1 { return w.e1; };
    if idx == 2 { return w.e2; };
    if idx == 3 { return w.e3; };
    if idx == 4 { return w.e4; };
    if idx == 5 { return w.e5; };
    if idx == 6 { return w.e6; };
    if idx == 7 { return w.e7; };
    if idx == 8 { return w.e8; };
    if idx == 9 { return w.e9; };
    if idx == 10 { return w.e10; };
    if idx == 11 { return w.e11; };
    if idx == 12 { return w.e12; };
    if idx == 13 { return w.e13; };
    if idx == 14 { return w.e14; };
    if idx == 15 { return w.e15; };
    return 0;
}

fn ecs_spw_parent_at(w: EcsSpawnWorldDeep, idx: i32) -> i64 {
    if idx == 0 { return w.p0; };
    if idx == 1 { return w.p1; };
    if idx == 2 { return w.p2; };
    if idx == 3 { return w.p3; };
    if idx == 4 { return w.p4; };
    if idx == 5 { return w.p5; };
    if idx == 6 { return w.p6; };
    if idx == 7 { return w.p7; };
    if idx == 8 { return w.p8; };
    if idx == 9 { return w.p9; };
    if idx == 10 { return w.p10; };
    if idx == 11 { return w.p11; };
    if idx == 12 { return w.p12; };
    if idx == 13 { return w.p13; };
    if idx == 14 { return w.p14; };
    if idx == 15 { return w.p15; };
    return -1;
}

fn ecs_spw_bundle_at(w: EcsSpawnWorldDeep, idx: i32) -> i64 {
    if idx == 0 { return w.b0; };
    if idx == 1 { return w.b1; };
    if idx == 2 { return w.b2; };
    if idx == 3 { return w.b3; };
    if idx == 4 { return w.b4; };
    if idx == 5 { return w.b5; };
    if idx == 6 { return w.b6; };
    if idx == 7 { return w.b7; };
    if idx == 8 { return w.b8; };
    if idx == 9 { return w.b9; };
    if idx == 10 { return w.b10; };
    if idx == 11 { return w.b11; };
    if idx == 12 { return w.b12; };
    if idx == 13 { return w.b13; };
    if idx == 14 { return w.b14; };
    if idx == 15 { return w.b15; };
    return 0;
}

fn ecs_spw_push(w: EcsSpawnWorldDeep, entity: i64, parent: i64, bundle: i64) -> EcsSpawnWorldDeep {
    let n = w.len;
    let ne = w.next_entity;
    let rh = w.reserve_hints;
    // scalarize arrays
    let e0=w.e0; let e1=w.e1; let e2=w.e2; let e3=w.e3; let e4=w.e4; let e5=w.e5; let e6=w.e6; let e7=w.e7;
    let e8=w.e8; let e9=w.e9; let e10=w.e10; let e11=w.e11; let e12=w.e12; let e13=w.e13; let e14=w.e14; let e15=w.e15;
    let p0=w.p0; let p1=w.p1; let p2=w.p2; let p3=w.p3; let p4=w.p4; let p5=w.p5; let p6=w.p6; let p7=w.p7;
    let p8=w.p8; let p9=w.p9; let p10=w.p10; let p11=w.p11; let p12=w.p12; let p13=w.p13; let p14=w.p14; let p15=w.p15;
    let b0=w.b0; let b1=w.b1; let b2=w.b2; let b3=w.b3; let b4=w.b4; let b5=w.b5; let b6=w.b6; let b7=w.b7;
    let b8=w.b8; let b9=w.b9; let b10=w.b10; let b11=w.b11; let b12=w.b12; let b13=w.b13; let b14=w.b14; let b15=w.b15;
    if n >= 16 { return w; };
    if n == 0 {
        return EcsSpawnWorldDeep { next_entity: ne, e0: entity, e1:e1,e2:e2,e3:e3,e4:e4,e5:e5,e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 1, p0: parent, p1:p1,p2:p2,p3:p3,p4:p4,p5:p5,p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0: bundle, b1:b1,b2:b2,b3:b3,b4:b4,b5:b5,b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    if n == 1 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0, e1: entity, e2:e2,e3:e3,e4:e4,e5:e5,e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 2, p0:p0, p1: parent, p2:p2,p3:p3,p4:p4,p5:p5,p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0, b1: bundle, b2:b2,b3:b3,b4:b4,b5:b5,b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    if n == 2 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0,e1:e1, e2: entity, e3:e3,e4:e4,e5:e5,e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 3, p0:p0,p1:p1, p2: parent, p3:p3,p4:p4,p5:p5,p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0,b1:b1, b2: bundle, b3:b3,b4:b4,b5:b5,b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    if n == 3 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0,e1:e1,e2:e2, e3: entity, e4:e4,e5:e5,e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 4, p0:p0,p1:p1,p2:p2, p3: parent, p4:p4,p5:p5,p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0,b1:b1,b2:b2, b3: bundle, b4:b4,b5:b5,b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    // remaining via generic path using next free: fall through sequential
    if n == 4 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0,e1:e1,e2:e2,e3:e3, e4: entity, e5:e5,e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 5, p0:p0,p1:p1,p2:p2,p3:p3, p4: parent, p5:p5,p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0,b1:b1,b2:b2,b3:b3, b4: bundle, b5:b5,b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    if n == 5 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0,e1:e1,e2:e2,e3:e3,e4:e4, e5: entity, e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 6, p0:p0,p1:p1,p2:p2,p3:p3,p4:p4, p5: parent, p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0,b1:b1,b2:b2,b3:b3,b4:b4, b5: bundle, b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    if n == 6 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0,e1:e1,e2:e2,e3:e3,e4:e4,e5:e5, e6: entity, e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 7, p0:p0,p1:p1,p2:p2,p3:p3,p4:p4,p5:p5, p6: parent, p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0,b1:b1,b2:b2,b3:b3,b4:b4,b5:b5, b6: bundle, b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    if n == 7 {
        return EcsSpawnWorldDeep { next_entity: ne, e0:e0,e1:e1,e2:e2,e3:e3,e4:e4,e5:e5,e6:e6, e7: entity, e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15, len: 8, p0:p0,p1:p1,p2:p2,p3:p3,p4:p4,p5:p5,p6:p6, p7: parent, p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15, b0:b0,b1:b1,b2:b2,b3:b3,b4:b4,b5:b5,b6:b6, b7: bundle, b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15, reserve_hints: rh };
    };
    return w;
}

fn ecs_spw_alloc(w: EcsSpawnWorldDeep) -> (EcsSpawnWorldDeep, i64) {
    let id = w.next_entity;
    let n = w.len;
    let e0=w.e0; let e1=w.e1; let e2=w.e2; let e3=w.e3; let e4=w.e4; let e5=w.e5; let e6=w.e6; let e7=w.e7;
    let e8=w.e8; let e9=w.e9; let e10=w.e10; let e11=w.e11; let e12=w.e12; let e13=w.e13; let e14=w.e14; let e15=w.e15;
    let p0=w.p0; let p1=w.p1; let p2=w.p2; let p3=w.p3; let p4=w.p4; let p5=w.p5; let p6=w.p6; let p7=w.p7;
    let p8=w.p8; let p9=w.p9; let p10=w.p10; let p11=w.p11; let p12=w.p12; let p13=w.p13; let p14=w.p14; let p15=w.p15;
    let b0=w.b0; let b1=w.b1; let b2=w.b2; let b3=w.b3; let b4=w.b4; let b5=w.b5; let b6=w.b6; let b7=w.b7;
    let b8=w.b8; let b9=w.b9; let b10=w.b10; let b11=w.b11; let b12=w.b12; let b13=w.b13; let b14=w.b14; let b15=w.b15;
    let rh = w.reserve_hints;
    w = EcsSpawnWorldDeep {
        next_entity: id + 1,
        e0:e0,e1:e1,e2:e2,e3:e3,e4:e4,e5:e5,e6:e6,e7:e7,e8:e8,e9:e9,e10:e10,e11:e11,e12:e12,e13:e13,e14:e14,e15:e15,
        len: n,
        p0:p0,p1:p1,p2:p2,p3:p3,p4:p4,p5:p5,p6:p6,p7:p7,p8:p8,p9:p9,p10:p10,p11:p11,p12:p12,p13:p13,p14:p14,p15:p15,
        b0:b0,b1:b1,b2:b2,b3:b3,b4:b4,b5:b5,b6:b6,b7:b7,b8:b8,b9:b9,b10:b10,b11:b11,b12:b12,b13:b13,b14:b14,b15:b15,
        reserve_hints: rh,
    };
    return (w, id);
}

// === Spawn wrappers ===
struct EcsSpawnDeep {
    bundle_id: i64,
}

fn ecs_spawn_new(bundle_id: i64) -> EcsSpawnDeep {
    return EcsSpawnDeep { bundle_id: bundle_id };
}
fn ecs_spawn_bundle(s: EcsSpawnDeep) -> i64 { return s.bundle_id; }
fn ecs_spawn_size_hint(s: EcsSpawnDeep) -> i64 { return 1; }

// Spawn single related child of parent
fn ecs_spawn_list_spawn_one(w: EcsSpawnWorldDeep, parent: i64, bundle_id: i64) -> EcsSpawnWorldDeep {
    let a = ecs_spw_alloc(w);
    w = a.0;
    let child = a.1;
    w = ecs_spw_push(w, child, parent, bundle_id);
    return w;
}

// SpawnIter: up to 4 bundle ids
struct EcsSpawnIterDeep {
    b0: i64, b1: i64, b2: i64, b3: i64,
    len: i32,
}

fn ecs_spawn_iter_new() -> EcsSpawnIterDeep {
    return EcsSpawnIterDeep { b0: 0, b1: 0, b2: 0, b3: 0, len: 0 };
}

fn ecs_spawn_iter_push(it: EcsSpawnIterDeep, bundle_id: i64) -> EcsSpawnIterDeep {
    let n = it.len;
    let b0=it.b0; let b1=it.b1; let b2=it.b2; let b3=it.b3;
    if n == 0 { return EcsSpawnIterDeep { b0: bundle_id, b1: b1, b2: b2, b3: b3, len: 1 }; };
    if n == 1 { return EcsSpawnIterDeep { b0: b0, b1: bundle_id, b2: b2, b3: b3, len: 2 }; };
    if n == 2 { return EcsSpawnIterDeep { b0: b0, b1: b1, b2: bundle_id, b3: b3, len: 3 }; };
    if n == 3 { return EcsSpawnIterDeep { b0: b0, b1: b1, b2: b2, b3: bundle_id, len: 4 }; };
    return it;
}

fn ecs_spawn_iter_size_hint(it: EcsSpawnIterDeep) -> i64 { return it.len as i64; }

fn ecs_spawn_iter_spawn(w: EcsSpawnWorldDeep, parent: i64, it: EcsSpawnIterDeep) -> EcsSpawnWorldDeep {
    let n = it.len;
    let b0=it.b0; let b1=it.b1; let b2=it.b2; let b3=it.b3;
    let hint = n as i64;
    // reserve_hints accumulates size_hint
    let rh = w.reserve_hints + hint;
    // rebuild w with new reserve then spawn
    let a0=ecs_spw_alloc(w); // will fix reserve after
    // simpler: set reserve on world by push path
    w = EcsSpawnWorldDeep {
        next_entity: w.next_entity,
        e0:w.e0,e1:w.e1,e2:w.e2,e3:w.e3,e4:w.e4,e5:w.e5,e6:w.e6,e7:w.e7,e8:w.e8,e9:w.e9,e10:w.e10,e11:w.e11,e12:w.e12,e13:w.e13,e14:w.e14,e15:w.e15,
        len: w.len,
        p0:w.p0,p1:w.p1,p2:w.p2,p3:w.p3,p4:w.p4,p5:w.p5,p6:w.p6,p7:w.p7,p8:w.p8,p9:w.p9,p10:w.p10,p11:w.p11,p12:w.p12,p13:w.p13,p14:w.p14,p15:w.p15,
        b0:w.b0,b1:w.b1,b2:w.b2,b3:w.b3,b4:w.b4,b5:w.b5,b6:w.b6,b7:w.b7,b8:w.b8,b9:w.b9,b10:w.b10,b11:w.b11,b12:w.b12,b13:w.b13,b14:w.b14,b15:w.b15,
        reserve_hints: rh,
    };
    if n >= 1 { w = ecs_spawn_list_spawn_one(w, parent, b0); };
    if n >= 2 { w = ecs_spawn_list_spawn_one(w, parent, b1); };
    if n >= 3 { w = ecs_spawn_list_spawn_one(w, parent, b2); };
    if n >= 4 { w = ecs_spawn_list_spawn_one(w, parent, b3); };
    return w;
}

// SpawnWith: function id produces bundle id from parent
fn ecs_spawn_with(w: EcsSpawnWorldDeep, parent: i64, func_id: i64) -> EcsSpawnWorldDeep {
    let bundle = func_id * 10 + parent;
    return ecs_spawn_list_spawn_one(w, parent, bundle);
}

// WithRelated: attach existing entities as related (no new spawn; log relation as parent links with bundle 0)
struct EcsWithRelatedDeep {
    e0: i64, e1: i64, e2: i64, e3: i64,
    len: i32,
}

fn ecs_with_related_new() -> EcsWithRelatedDeep {
    return EcsWithRelatedDeep { e0: 0, e1: 0, e2: 0, e3: 0, len: 0 };
}

fn ecs_with_related_push(w: EcsWithRelatedDeep, entity: i64) -> EcsWithRelatedDeep {
    let n = w.len;
    let e0=w.e0; let e1=w.e1; let e2=w.e2; let e3=w.e3;
    if n == 0 { return EcsWithRelatedDeep { e0: entity, e1: e1, e2: e2, e3: e3, len: 1 }; };
    if n == 1 { return EcsWithRelatedDeep { e0: e0, e1: entity, e2: e2, e3: e3, len: 2 }; };
    if n == 2 { return EcsWithRelatedDeep { e0: e0, e1: e1, e2: entity, e3: e3, len: 3 }; };
    if n == 3 { return EcsWithRelatedDeep { e0: e0, e1: e1, e2: e2, e3: entity, len: 4 }; };
    return w;
}

fn ecs_with_related_size_hint(w: EcsWithRelatedDeep) -> i64 { return w.len as i64; }

// Record related existing entities under parent (bundle_id = -1 means existing)
fn ecs_with_related_spawn(w: EcsSpawnWorldDeep, parent: i64, rel: EcsWithRelatedDeep) -> EcsSpawnWorldDeep {
    let n = rel.len;
    let e0=rel.e0; let e1=rel.e1; let e2=rel.e2; let e3=rel.e3;
    let rh = w.reserve_hints + (n as i64);
    w = EcsSpawnWorldDeep {
        next_entity: w.next_entity,
        e0:w.e0,e1:w.e1,e2:w.e2,e3:w.e3,e4:w.e4,e5:w.e5,e6:w.e6,e7:w.e7,e8:w.e8,e9:w.e9,e10:w.e10,e11:w.e11,e12:w.e12,e13:w.e13,e14:w.e14,e15:w.e15,
        len: w.len,
        p0:w.p0,p1:w.p1,p2:w.p2,p3:w.p3,p4:w.p4,p5:w.p5,p6:w.p6,p7:w.p7,p8:w.p8,p9:w.p9,p10:w.p10,p11:w.p11,p12:w.p12,p13:w.p13,p14:w.p14,p15:w.p15,
        b0:w.b0,b1:w.b1,b2:w.b2,b3:w.b3,b4:w.b4,b5:w.b5,b6:w.b6,b7:w.b7,b8:w.b8,b9:w.b9,b10:w.b10,b11:w.b11,b12:w.b12,b13:w.b13,b14:w.b14,b15:w.b15,
        reserve_hints: rh,
    };
    if n >= 1 { w = ecs_spw_push(w, e0, parent, -1); };
    if n >= 2 { w = ecs_spw_push(w, e1, parent, -1); };
    if n >= 3 { w = ecs_spw_push(w, e2, parent, -1); };
    if n >= 4 { w = ecs_spw_push(w, e3, parent, -1); };
    return w;
}

fn ecs_with_one_related(w: EcsSpawnWorldDeep, parent: i64, entity: i64) -> EcsSpawnWorldDeep {
    let rel = ecs_with_related_push(ecs_with_related_new(), entity);
    return ecs_with_related_spawn(w, parent, rel);
}

// Count children of parent in world log
fn ecs_spw_count_children(w: EcsSpawnWorldDeep, parent: i64) -> i32 {
    let n = w.len;
    let c: i32 = 0;
    let i: i32 = 0;
    // unroll 8 for simplicity of common tests
    if n >= 1 { if ecs_spw_parent_at(w, 0) == parent { c = c + 1; }; };
    if n >= 2 { if ecs_spw_parent_at(w, 1) == parent { c = c + 1; }; };
    if n >= 3 { if ecs_spw_parent_at(w, 2) == parent { c = c + 1; }; };
    if n >= 4 { if ecs_spw_parent_at(w, 3) == parent { c = c + 1; }; };
    if n >= 5 { if ecs_spw_parent_at(w, 4) == parent { c = c + 1; }; };
    if n >= 6 { if ecs_spw_parent_at(w, 5) == parent { c = c + 1; }; };
    if n >= 7 { if ecs_spw_parent_at(w, 6) == parent { c = c + 1; }; };
    if n >= 8 { if ecs_spw_parent_at(w, 7) == parent { c = c + 1; }; };
    return c;
}
