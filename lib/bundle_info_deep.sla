// Deepened Bevy ECS bundle info surface.
// Mirrors src/bundle/info.rs:
//   BundleId / InsertMode
//   BundleInfo explicit+required contributed split, duplicate reject
//   Bundles: static type map, dynamic component-key map, get/get_id/iter/len
// Shallow lib/bundle_info.sla + lib/bundle_info_extras.sla retained.
// Fixed capacity: 8 contributed component ids, 8 registered bundles, 8 type mappings.

// InsertMode: Replace=0, Keep=1
fn ecs_bi_insert_replace() -> i32 { return 0; }
fn ecs_bi_insert_keep() -> i32 { return 1; }

struct EcsBiId {
    index: i32,
}

fn ecs_bi_id_new(index: i32) -> EcsBiId {
    return EcsBiId { index: index };
}

fn ecs_bi_id_index(id: EcsBiId) -> i32 {
    return id.index;
}

fn ecs_bi_id_valid(id: EcsBiId) -> bool {
    if id.index >= 0 { return true; };
    return false;
}

// BundleInfo: contributed = [explicit...][required...], max 8
struct EcsBiInfo {
    id: i32,
    // -1 unused
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    contrib_len: i32,
    explicit_len: i32,
    // required constructor markers (1 if constructor present for required slot)
    rq0: i32, rq1: i32, rq2: i32, rq3: i32,
    rq_len: i32,
    ok: bool, // false if construction rejected (duplicates)
}

fn ecs_bi_info_empty(id: i32) -> EcsBiInfo {
    return EcsBiInfo {
        id: id,
        c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
        contrib_len: 0, explicit_len: 0,
        rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0,
        ok: true,
    };
}

fn ecs_bi_info_id(info: EcsBiInfo) -> i32 { return info.id; }
fn ecs_bi_info_ok(info: EcsBiInfo) -> bool { return info.ok; }
fn ecs_bi_info_contrib_len(info: EcsBiInfo) -> i32 { return info.contrib_len; }
fn ecs_bi_info_explicit_len(info: EcsBiInfo) -> i32 { return info.explicit_len; }
fn ecs_bi_info_required_len(info: EcsBiInfo) -> i32 {
    return info.contrib_len - info.explicit_len;
}

fn ecs_bi_info_at(info: EcsBiInfo, idx: i32) -> i32 {
    if idx == 0 { return info.c0; };
    if idx == 1 { return info.c1; };
    if idx == 2 { return info.c2; };
    if idx == 3 { return info.c3; };
    if idx == 4 { return info.c4; };
    if idx == 5 { return info.c5; };
    if idx == 6 { return info.c6; };
    if idx == 7 { return info.c7; };
    return -1;
}

fn ecs_bi_info_set_at(info: EcsBiInfo, idx: i32, val: i32) -> EcsBiInfo {
    if idx == 0 {
        return EcsBiInfo {
            id: info.id, c0: val, c1: info.c1, c2: info.c2, c3: info.c3,
            c4: info.c4, c5: info.c5, c6: info.c6, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 1 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: val, c2: info.c2, c3: info.c3,
            c4: info.c4, c5: info.c5, c6: info.c6, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 2 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: info.c1, c2: val, c3: info.c3,
            c4: info.c4, c5: info.c5, c6: info.c6, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 3 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: info.c1, c2: info.c2, c3: val,
            c4: info.c4, c5: info.c5, c6: info.c6, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 4 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: info.c1, c2: info.c2, c3: info.c3,
            c4: val, c5: info.c5, c6: info.c6, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 5 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: info.c1, c2: info.c2, c3: info.c3,
            c4: info.c4, c5: val, c6: info.c6, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 6 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: info.c1, c2: info.c2, c3: info.c3,
            c4: info.c4, c5: info.c5, c6: val, c7: info.c7,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    if idx == 7 {
        return EcsBiInfo {
            id: info.id, c0: info.c0, c1: info.c1, c2: info.c2, c3: info.c3,
            c4: info.c4, c5: info.c5, c6: info.c6, c7: val,
            contrib_len: info.contrib_len, explicit_len: info.explicit_len,
            rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
            ok: info.ok,
        };
    };
    return info;
}

fn ecs_bi_info_contains_before(info: EcsBiInfo, before: i32, val: i32) -> bool {
    if before >= 1 {
        if info.c0 == val { return true; };
    };
    if before >= 2 {
        if info.c1 == val { return true; };
    };
    if before >= 3 {
        if info.c2 == val { return true; };
    };
    if before >= 4 {
        if info.c3 == val { return true; };
    };
    if before >= 5 {
        if info.c4 == val { return true; };
    };
    if before >= 6 {
        if info.c5 == val { return true; };
    };
    if before >= 7 {
        if info.c6 == val { return true; };
    };
    if before >= 8 {
        if info.c7 == val { return true; };
    };
    return false;
}

// Build from explicit ids (up to 4) + required ids (up to 4). Rejects duplicate explicit.
fn ecs_bi_info_new(id: i32, e0: i32, e1: i32, e2: i32, e3: i32, e_len: i32, r0: i32, r1: i32, r2: i32, r3: i32, r_len: i32) -> EcsBiInfo {
    // explicit phase
    let c0 = -1; let c1 = -1; let c2 = -1; let c3 = -1;
    let c4 = -1; let c5 = -1; let c6 = -1; let c7 = -1;
    let el = 0;
    if e_len >= 1 {
        c0 = e0;
        el = 1;
    };
    if e_len >= 2 {
        if c0 == e1 {
            return EcsBiInfo {
                id: id, c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
                contrib_len: 0, explicit_len: 0, rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0, ok: false,
            };
        };
        c1 = e1;
        el = 2;
    };
    if e_len >= 3 {
        if c0 == e2 {
            return EcsBiInfo {
                id: id, c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
                contrib_len: 0, explicit_len: 0, rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0, ok: false,
            };
        };
        if c1 == e2 {
            return EcsBiInfo {
                id: id, c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
                contrib_len: 0, explicit_len: 0, rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0, ok: false,
            };
        };
        c2 = e2;
        el = 3;
    };
    if e_len >= 4 {
        if c0 == e3 {
            return EcsBiInfo {
                id: id, c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
                contrib_len: 0, explicit_len: 0, rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0, ok: false,
            };
        };
        if c1 == e3 {
            return EcsBiInfo {
                id: id, c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
                contrib_len: 0, explicit_len: 0, rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0, ok: false,
            };
        };
        if c2 == e3 {
            return EcsBiInfo {
                id: id, c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
                contrib_len: 0, explicit_len: 0, rq0: 0, rq1: 0, rq2: 0, rq3: 0, rq_len: 0, ok: false,
            };
        };
        c3 = e3;
        el = 4;
    };
    // required phase: append if not in explicit
    let clen = el;
    let rq0m = 0; let rq1m = 0; let rq2m = 0; let rq3m = 0; let rq_len = 0;
    if r_len >= 1 {
        let seen = false;
        if el >= 1 { if c0 == r0 { seen = true; }; };
        if el >= 2 { if c1 == r0 { seen = true; }; };
        if el >= 3 { if c2 == r0 { seen = true; }; };
        if el >= 4 { if c3 == r0 { seen = true; }; };
        if seen != true {
            if clen == 0 { c0 = r0; };
            if clen == 1 { c1 = r0; };
            if clen == 2 { c2 = r0; };
            if clen == 3 { c3 = r0; };
            if clen == 4 { c4 = r0; };
            if clen == 5 { c5 = r0; };
            if clen == 6 { c6 = r0; };
            if clen == 7 { c7 = r0; };
            clen = clen + 1;
            rq0m = 1;
            rq_len = 1;
        };
    };
    if r_len >= 2 {
        let seen = false;
        if el >= 1 { if c0 == r1 { seen = true; }; };
        if el >= 2 { if c1 == r1 { seen = true; }; };
        if el >= 3 { if c2 == r1 { seen = true; }; };
        if el >= 4 { if c3 == r1 { seen = true; }; };
        // also already appended required
        if clen > el {
            if c0 == r1 { seen = true; };
            if c1 == r1 { seen = true; };
            if c2 == r1 { seen = true; };
            if c3 == r1 { seen = true; };
            if c4 == r1 { seen = true; };
        };
        if seen != true {
            if clen == 0 { c0 = r1; };
            if clen == 1 { c1 = r1; };
            if clen == 2 { c2 = r1; };
            if clen == 3 { c3 = r1; };
            if clen == 4 { c4 = r1; };
            if clen == 5 { c5 = r1; };
            if clen == 6 { c6 = r1; };
            if clen == 7 { c7 = r1; };
            clen = clen + 1;
            if rq_len == 0 { rq0m = 1; };
            if rq_len == 1 { rq1m = 1; };
            if rq_len == 2 { rq2m = 1; };
            if rq_len == 3 { rq3m = 1; };
            rq_len = rq_len + 1;
        };
    };
    if r_len >= 3 {
        let seen = false;
        if c0 == r2 { seen = true; };
        if c1 == r2 { seen = true; };
        if c2 == r2 { seen = true; };
        if c3 == r2 { seen = true; };
        if c4 == r2 { seen = true; };
        if c5 == r2 { seen = true; };
        if seen != true {
            if clen == 0 { c0 = r2; };
            if clen == 1 { c1 = r2; };
            if clen == 2 { c2 = r2; };
            if clen == 3 { c3 = r2; };
            if clen == 4 { c4 = r2; };
            if clen == 5 { c5 = r2; };
            if clen == 6 { c6 = r2; };
            if clen == 7 { c7 = r2; };
            clen = clen + 1;
            if rq_len == 0 { rq0m = 1; };
            if rq_len == 1 { rq1m = 1; };
            if rq_len == 2 { rq2m = 1; };
            if rq_len == 3 { rq3m = 1; };
            rq_len = rq_len + 1;
        };
    };
    if r_len >= 4 {
        let seen = false;
        if c0 == r3 { seen = true; };
        if c1 == r3 { seen = true; };
        if c2 == r3 { seen = true; };
        if c3 == r3 { seen = true; };
        if c4 == r3 { seen = true; };
        if c5 == r3 { seen = true; };
        if c6 == r3 { seen = true; };
        if seen != true {
            if clen == 0 { c0 = r3; };
            if clen == 1 { c1 = r3; };
            if clen == 2 { c2 = r3; };
            if clen == 3 { c3 = r3; };
            if clen == 4 { c4 = r3; };
            if clen == 5 { c5 = r3; };
            if clen == 6 { c6 = r3; };
            if clen == 7 { c7 = r3; };
            clen = clen + 1;
            if rq_len == 0 { rq0m = 1; };
            if rq_len == 1 { rq1m = 1; };
            if rq_len == 2 { rq2m = 1; };
            if rq_len == 3 { rq3m = 1; };
            rq_len = rq_len + 1;
        };
    };
    return EcsBiInfo {
        id: id, c0: c0, c1: c1, c2: c2, c3: c3, c4: c4, c5: c5, c6: c6, c7: c7,
        contrib_len: clen, explicit_len: el,
        rq0: rq0m, rq1: rq1m, rq2: rq2m, rq3: rq3m, rq_len: rq_len,
        ok: true,
    };
}
fn ecs_bi_info_explicit_at(info: EcsBiInfo, idx: i32) -> i32 {
    if idx < 0 || idx >= info.explicit_len { return -1; };
    return ecs_bi_info_at(info, idx);
}

fn ecs_bi_info_required_at(info: EcsBiInfo, idx: i32) -> i32 {
    if idx < 0 || idx >= ecs_bi_info_required_len(info) { return -1; };
    return ecs_bi_info_at(info, info.explicit_len + idx);
}

fn ecs_bi_info_contributed_at(info: EcsBiInfo, idx: i32) -> i32 {
    if idx < 0 || idx >= info.contrib_len { return -1; };
    return ecs_bi_info_at(info, idx);
}

fn ecs_bi_info_has_component(info: EcsBiInfo, component_id: i32) -> bool {
    return ecs_bi_info_contains_before(info, info.contrib_len, component_id);
}

// ComponentStatus for insert planning: Added=0, Exists=1
fn ecs_bi_status_added() -> i32 { return 0; }
fn ecs_bi_status_exists() -> i32 { return 1; }

// For each contributed component, status based on whether archetype already has it.
// archetype_mask: bit i set means component_id==i present (ids 0..7)
fn ecs_bi_info_component_status(info: EcsBiInfo, archetype_mask: i32, contrib_idx: i32) -> i32 {
    let cid = ecs_bi_info_contributed_at(info, contrib_idx);
    if cid < 0 { return ecs_bi_status_added(); };
    let bit = 1;
    // shift bit left cid times (unrolled for 0..7)
    if cid == 0 { bit = 1; };
    if cid == 1 { bit = 2; };
    if cid == 2 { bit = 4; };
    if cid == 3 { bit = 8; };
    if cid == 4 { bit = 16; };
    if cid == 5 { bit = 32; };
    if cid == 6 { bit = 64; };
    if cid == 7 { bit = 128; };
    if (archetype_mask & bit) != 0 {
        return ecs_bi_status_exists();
    };
    return ecs_bi_status_added();
}

// Should write component under InsertMode
fn ecs_bi_should_write(status: i32, insert_mode: i32) -> bool {
    if status == ecs_bi_status_added() { return true; };
    if insert_mode == ecs_bi_insert_replace() { return true; };
    return false;
}

// === Bundles registry ===
struct EcsBiBundles {
    len: i32,
    b0: EcsBiInfo, b1: EcsBiInfo, b2: EcsBiInfo, b3: EcsBiInfo,
    b4: EcsBiInfo, b5: EcsBiInfo, b6: EcsBiInfo, b7: EcsBiInfo,
    // type_id -> bundle_id map (8 slots)
    t_len: i32,
    t_type0: i32, t_id0: i32,
    t_type1: i32, t_id1: i32,
    t_type2: i32, t_id2: i32,
    t_type3: i32, t_id3: i32,
    // dynamic key: sorted component list encoded as 4-tuple key + bundle id (4 slots)
    d_len: i32,
    d_k0a: i32, d_k0b: i32, d_k0c: i32, d_k0d: i32, d_k0n: i32, d_id0: i32,
    d_k1a: i32, d_k1b: i32, d_k1c: i32, d_k1d: i32, d_k1n: i32, d_id1: i32,
    d_k2a: i32, d_k2b: i32, d_k2c: i32, d_k2d: i32, d_k2n: i32, d_id2: i32,
    d_k3a: i32, d_k3b: i32, d_k3c: i32, d_k3d: i32, d_k3n: i32, d_id3: i32,
}

fn ecs_bi_bundles_new() -> EcsBiBundles {
    let empty = ecs_bi_info_empty(-1);
    return EcsBiBundles {
        len: 0,
        b0: empty, b1: empty, b2: empty, b3: empty,
        b4: empty, b5: empty, b6: empty, b7: empty,
        t_len: 0,
        t_type0: -1, t_id0: -1,
        t_type1: -1, t_id1: -1,
        t_type2: -1, t_id2: -1,
        t_type3: -1, t_id3: -1,
        d_len: 0,
        d_k0a: -1, d_k0b: -1, d_k0c: -1, d_k0d: -1, d_k0n: 0, d_id0: -1,
        d_k1a: -1, d_k1b: -1, d_k1c: -1, d_k1d: -1, d_k1n: 0, d_id1: -1,
        d_k2a: -1, d_k2b: -1, d_k2c: -1, d_k2d: -1, d_k2n: 0, d_id2: -1,
        d_k3a: -1, d_k3b: -1, d_k3c: -1, d_k3d: -1, d_k3n: 0, d_id3: -1,
    };
}

fn ecs_bi_bundles_len(b: EcsBiBundles) -> i32 { return b.len; }
fn ecs_bi_bundles_is_empty(b: EcsBiBundles) -> bool {
    if b.len == 0 { return true; };
    return false;
}

fn ecs_bi_bundles_get(b: EcsBiBundles, id: i32) -> (bool, EcsBiInfo) {
    if id < 0 || id >= b.len { return (false, ecs_bi_info_empty(-1)); };
    if id == 0 { return (true, b.b0); };
    if id == 1 { return (true, b.b1); };
    if id == 2 { return (true, b.b2); };
    if id == 3 { return (true, b.b3); };
    if id == 4 { return (true, b.b4); };
    if id == 5 { return (true, b.b5); };
    if id == 6 { return (true, b.b6); };
    if id == 7 { return (true, b.b7); };
    return (false, ecs_bi_info_empty(-1));
}

fn ecs_bi_bundles_set(b: EcsBiBundles, id: i32, info: EcsBiInfo) -> EcsBiBundles {
    if id == 0 {
        return EcsBiBundles {
            len: b.len, b0: info, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    if id == 1 {
        return EcsBiBundles {
            len: b.len, b0: b.b0, b1: info, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    if id == 2 {
        return EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: info, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    if id == 3 {
        return EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: info, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    return b;
}

fn ecs_bi_bundles_push_info(b: EcsBiBundles, info: EcsBiInfo) -> (EcsBiBundles, i32) {
    if b.len >= 8 { return (b, -1); };
    if info.ok != true { return (b, -1); };
    let id = b.len;
    let info2 = EcsBiInfo {
        id: id, c0: info.c0, c1: info.c1, c2: info.c2, c3: info.c3,
        c4: info.c4, c5: info.c5, c6: info.c6, c7: info.c7,
        contrib_len: info.contrib_len, explicit_len: info.explicit_len,
        rq0: info.rq0, rq1: info.rq1, rq2: info.rq2, rq3: info.rq3, rq_len: info.rq_len,
        ok: true,
    };
    let out = ecs_bi_bundles_set(b, id, info2);
    out = EcsBiBundles {
        len: id + 1, b0: out.b0, b1: out.b1, b2: out.b2, b3: out.b3, b4: out.b4, b5: out.b5, b6: out.b6, b7: out.b7,
        t_len: out.t_len, t_type0: out.t_type0, t_id0: out.t_id0, t_type1: out.t_type1, t_id1: out.t_id1,
        t_type2: out.t_type2, t_id2: out.t_id2, t_type3: out.t_type3, t_id3: out.t_id3,
        d_len: out.d_len,
        d_k0a: out.d_k0a, d_k0b: out.d_k0b, d_k0c: out.d_k0c, d_k0d: out.d_k0d, d_k0n: out.d_k0n, d_id0: out.d_id0,
        d_k1a: out.d_k1a, d_k1b: out.d_k1b, d_k1c: out.d_k1c, d_k1d: out.d_k1d, d_k1n: out.d_k1n, d_id1: out.d_id1,
        d_k2a: out.d_k2a, d_k2b: out.d_k2b, d_k2c: out.d_k2c, d_k2d: out.d_k2d, d_k2n: out.d_k2n, d_id2: out.d_id2,
        d_k3a: out.d_k3a, d_k3b: out.d_k3b, d_k3c: out.d_k3c, d_k3d: out.d_k3d, d_k3n: out.d_k3n, d_id3: out.d_id3,
    };
    return (out, id);
}

fn ecs_bi_bundles_get_id(b: EcsBiBundles, type_id: i32) -> (bool, i32) {
    if b.t_len >= 1 {
        if b.t_type0 == type_id { return (true, b.t_id0); };
    };
    if b.t_len >= 2 {
        if b.t_type1 == type_id { return (true, b.t_id1); };
    };
    if b.t_len >= 3 {
        if b.t_type2 == type_id { return (true, b.t_id2); };
    };
    if b.t_len >= 4 {
        if b.t_type3 == type_id { return (true, b.t_id3); };
    };
    return (false, -1);
}

fn ecs_bi_bundles_register_type(b: EcsBiBundles, type_id: i32, bundle_id: i32) -> EcsBiBundles {
    let existing = ecs_bi_bundles_get_id(b, type_id);
    if existing.0 == true { return b; };
    if b.t_len >= 4 { return b; };
    if b.t_len == 0 {
        return EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: 1, t_type0: type_id, t_id0: bundle_id, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    if b.t_len == 1 {
        return EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: 2, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: type_id, t_id1: bundle_id,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    if b.t_len == 2 {
        return EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: 3, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: type_id, t_id2: bundle_id, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: b.d_len,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
    };
    return EcsBiBundles {
        len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
        t_len: 4, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
        t_type2: b.t_type2, t_id2: b.t_id2, t_type3: type_id, t_id3: bundle_id,
        d_len: b.d_len,
        d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
        d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
        d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
        d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
    };
}

// register static bundle: create info + type map entry
fn ecs_bi_bundles_register_static(b: EcsBiBundles, type_id: i32, e0: i32, e1: i32, e2: i32, e3: i32, e_len: i32, r0: i32, r1: i32, r2: i32, r3: i32, r_len: i32) -> (EcsBiBundles, i32) {
    let existing = ecs_bi_bundles_get_id(b, type_id);
    if existing.0 == true { return (b, existing.1); };
    let info = ecs_bi_info_new(b.len, e0, e1, e2, e3, e_len, r0, r1, r2, r3, r_len);
    if info.ok != true { return (b, -1); };
    let p = ecs_bi_bundles_push_info(b, info);
    b = p.0;
    let id = p.1;
    if id < 0 { return (b, -1); };
    b = ecs_bi_bundles_register_type(b, type_id, id);
    return (b, id);
}

fn ecs_bi_dynamic_key_eq(na: i32, a0: i32, a1: i32, a2: i32, a3: i32, nb: i32, b0: i32, b1: i32, b2: i32, b3: i32) -> bool {
    if na != nb { return false; };
    if na >= 1 {
        if a0 != b0 { return false; };
    };
    if na >= 2 {
        if a1 != b1 { return false; };
    };
    if na >= 3 {
        if a2 != b2 { return false; };
    };
    if na >= 4 {
        if a3 != b3 { return false; };
    };
    return true;
}

fn ecs_bi_bundles_get_dynamic(b: EcsBiBundles, n: i32, a0: i32, a1: i32, a2: i32, a3: i32) -> (bool, i32) {
    if b.d_len >= 1 {
        if ecs_bi_dynamic_key_eq(n, a0, a1, a2, a3, b.d_k0n, b.d_k0a, b.d_k0b, b.d_k0c, b.d_k0d) {
            return (true, b.d_id0);
        };
    };
    if b.d_len >= 2 {
        if ecs_bi_dynamic_key_eq(n, a0, a1, a2, a3, b.d_k1n, b.d_k1a, b.d_k1b, b.d_k1c, b.d_k1d) {
            return (true, b.d_id1);
        };
    };
    if b.d_len >= 3 {
        if ecs_bi_dynamic_key_eq(n, a0, a1, a2, a3, b.d_k2n, b.d_k2a, b.d_k2b, b.d_k2c, b.d_k2d) {
            return (true, b.d_id2);
        };
    };
    if b.d_len >= 4 {
        if ecs_bi_dynamic_key_eq(n, a0, a1, a2, a3, b.d_k3n, b.d_k3a, b.d_k3b, b.d_k3c, b.d_k3d) {
            return (true, b.d_id3);
        };
    };
    return (false, -1);
}

fn ecs_bi_bundles_register_dynamic(b: EcsBiBundles, n: i32, a0: i32, a1: i32, a2: i32, a3: i32) -> (EcsBiBundles, i32) {
    let existing = ecs_bi_bundles_get_dynamic(b, n, a0, a1, a2, a3);
    if existing.0 == true { return (b, existing.1); };
    // build info with explicit components only
    let e0 = a0; let e1 = a1; let e2 = a2; let e3 = a3; let e_len = n;
    let info = ecs_bi_info_new(b.len, e0, e1, e2, e3, e_len, -1, -1, -1, -1, 0);
    if info.ok != true { return (b, -1); };
    let p = ecs_bi_bundles_push_info(b, info);
    b = p.0;
    let id = p.1;
    if id < 0 { return (b, -1); };
    if b.d_len >= 4 { return (b, id); };
    if b.d_len == 0 {
        b = EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: 1,
            d_k0a: a0, d_k0b: a1, d_k0c: a2, d_k0d: a3, d_k0n: n, d_id0: id,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
        return (b, id);
    };
    if b.d_len == 1 {
        b = EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: 2,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: a0, d_k1b: a1, d_k1c: a2, d_k1d: a3, d_k1n: n, d_id1: id,
            d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
        return (b, id);
    };
    if b.d_len == 2 {
        b = EcsBiBundles {
            len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
            t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
            t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
            d_len: 3,
            d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
            d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
            d_k2a: a0, d_k2b: a1, d_k2c: a2, d_k2d: a3, d_k2n: n, d_id2: id,
            d_k3a: b.d_k3a, d_k3b: b.d_k3b, d_k3c: b.d_k3c, d_k3d: b.d_k3d, d_k3n: b.d_k3n, d_id3: b.d_id3,
        };
        return (b, id);
    };
    b = EcsBiBundles {
        len: b.len, b0: b.b0, b1: b.b1, b2: b.b2, b3: b.b3, b4: b.b4, b5: b.b5, b6: b.b6, b7: b.b7,
        t_len: b.t_len, t_type0: b.t_type0, t_id0: b.t_id0, t_type1: b.t_type1, t_id1: b.t_id1,
        t_type2: b.t_type2, t_id2: b.t_id2, t_type3: b.t_type3, t_id3: b.t_id3,
        d_len: 4,
        d_k0a: b.d_k0a, d_k0b: b.d_k0b, d_k0c: b.d_k0c, d_k0d: b.d_k0d, d_k0n: b.d_k0n, d_id0: b.d_id0,
        d_k1a: b.d_k1a, d_k1b: b.d_k1b, d_k1c: b.d_k1c, d_k1d: b.d_k1d, d_k1n: b.d_k1n, d_id1: b.d_id1,
        d_k2a: b.d_k2a, d_k2b: b.d_k2b, d_k2c: b.d_k2c, d_k2d: b.d_k2d, d_k2n: b.d_k2n, d_id2: b.d_id2,
        d_k3a: a0, d_k3b: a1, d_k3c: a2, d_k3d: a3, d_k3n: n, d_id3: id,
    };
    return (b, id);
}
