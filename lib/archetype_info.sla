// Bevy ecs archetype::Archetype public surface + ArchetypeFlags.
// Mirrors src/archetype.rs.

// ArchetypeFlags bitmask (10 bits).
const ECS_AFLAGS_ON_ADD_HOOK: i32 = 1;       // 1 << 0
const ECS_AFLAGS_ON_INSERT_HOOK: i32 = 2;   // 1 << 1
const ECS_AFLAGS_ON_DISCARD_HOOK: i32 = 4;   // 1 << 2
const ECS_AFLAGS_ON_REMOVE_HOOK: i32 = 8;    // 1 << 3
const ECS_AFLAGS_ON_DESPAWN_HOOK: i32 = 16;  // 1 << 4
const ECS_AFLAGS_ON_ADD_OBSERVER: i32 = 32;  // 1 << 5
const ECS_AFLAGS_ON_INSERT_OBSERVER: i32 = 64;  // 1 << 6
const ECS_AFLAGS_ON_DISCARD_OBSERVER: i32 = 128;  // 1 << 7
const ECS_AFLAGS_ON_REMOVE_OBSERVER: i32 = 256;  // 1 << 8
const ECS_AFLAGS_ON_DESPAWN_OBSERVER: i32 = 512;  // 1 << 9

// Each component tracked on the archetype has a storage type (0 = Table, 1 = SparseSet).
struct EcsArchetypeComponentInfo {
    component_id: i32,
    storage_type: i32,
}

struct EcsArchetypeInfo {
    id: i32,
    table_id: i32,
    flags: i32,
    components: Vec<EcsArchetypeComponentInfo>,
    table_component_count: i32,
    sparse_set_component_count: i32,
    entity_count: i32,
    generation: i32,
    edges_present: bool,
}

fn ecs_archetype_info_new(id: i32, table_id: i32, generation: i32) -> EcsArchetypeInfo {
    let a = EcsArchetypeInfo { id: id, table_id: table_id, flags: 0, components: Vec::new(), table_component_count: 0, sparse_set_component_count: 0, entity_count: 0, generation: generation, edges_present: false };
    return a;
}

// add_table_component: adds a component with StorageType=Table
fn ecs_archetype_info_add_table_component(a: EcsArchetypeInfo, component_id: i32) -> EcsArchetypeInfo {
    let info = EcsArchetypeComponentInfo { component_id: component_id, storage_type: 0 };
    a.components.push(info);
    a.table_component_count = a.table_component_count + 1;
    return a;
}

// add_sparse_set_component: adds with StorageType=SparseSet
fn ecs_archetype_info_add_sparse_set_component(a: EcsArchetypeInfo, component_id: i32) -> EcsArchetypeInfo {
    let info = EcsArchetypeComponentInfo { component_id: component_id, storage_type: 1 };
    a.components.push(info);
    a.sparse_set_component_count = a.sparse_set_component_count + 1;
    return a;
}

// flag mutators
fn ecs_archetype_info_set_on_add_hook(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_ADD_HOOK;
    return a;
}
fn ecs_archetype_info_set_on_insert_hook(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_INSERT_HOOK;
    return a;
}
fn ecs_archetype_info_set_on_discard_hook(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_DISCARD_HOOK;
    return a;
}
fn ecs_archetype_info_set_on_remove_hook(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_REMOVE_HOOK;
    return a;
}
fn ecs_archetype_info_set_on_despawn_hook(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_DESPAWN_HOOK;
    return a;
}
fn ecs_archetype_info_set_on_add_observer(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_ADD_OBSERVER;
    return a;
}
fn ecs_archetype_info_set_on_insert_observer(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_INSERT_OBSERVER;
    return a;
}
fn ecs_archetype_info_set_on_discard_observer(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_DISCARD_OBSERVER;
    return a;
}
fn ecs_archetype_info_set_on_remove_observer(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_REMOVE_OBSERVER;
    return a;
}
fn ecs_archetype_info_set_on_despawn_observer(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.flags = a.flags + ECS_AFLAGS_ON_DESPAWN_OBSERVER;
    return a;
}

// accessors
fn ecs_archetype_info_id(a: EcsArchetypeInfo) -> i32 { return a.id; }
fn ecs_archetype_info_table_id(a: EcsArchetypeInfo) -> i32 { return a.table_id; }
fn ecs_archetype_info_flags(a: EcsArchetypeInfo) -> i32 { return a.flags; }
fn ecs_archetype_info_generation(a: EcsArchetypeInfo) -> i32 { return a.generation; }

fn ecs_archetype_info_component_count(a: EcsArchetypeInfo) -> i32 {
    return len(a.components) as i32;
}

fn ecs_archetype_info_len(a: EcsArchetypeInfo) -> i32 { return a.entity_count; }
fn ecs_archetype_info_is_empty(a: EcsArchetypeInfo) -> bool { return a.entity_count == 0; }

fn ecs_archetype_info_add_entity(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.entity_count = a.entity_count + 1;
    return a;
}

fn ecs_archetype_info_remove_entity(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    if a.entity_count > 0 {
        a.entity_count = a.entity_count - 1;
    };
    return a;
}

fn ecs_archetype_info_table_components_count(a: EcsArchetypeInfo) -> i32 {
    return a.table_component_count;
}

fn ecs_archetype_info_sparse_set_components_count(a: EcsArchetypeInfo) -> i32 {
    return a.sparse_set_component_count;
}

// contains(component_id): whether the archetype holds a component
fn ecs_archetype_info_contains(a: EcsArchetypeInfo, component_id: i32) -> bool {
    let idx: i32 = 0;
    let n: i32 = len(a.components) as i32;
    while idx < n {
        if a.components[idx].component_id == component_id {
            return true;
        };
        idx = idx + 1;
    }
    return false;
}

// get_storage_type(component_id): (found, storage_type)
fn ecs_archetype_info_get_storage_type(a: EcsArchetypeInfo, component_id: i32) -> (bool, i32) {
    let idx: i32 = 0;
    let n: i32 = len(a.components) as i32;
    while idx < n {
        if a.components[idx].component_id == component_id {
            return (true, a.components[idx].storage_type);
        };
        idx = idx + 1;
    }
    return (false, 0);
}

// has_* flags — bitwise via flag value & mask; SLA: use modulo instead of &.
fn ecs_archetype_info_has_flag(a: EcsArchetypeInfo, mask: i32) -> bool {
    // mask is a power of two (1, 2, 4, ... 512). Check via: (flags / mask) is odd.
    let q = a.flags / mask;
    let rem = q - (q / 2) * 2;
    return rem != 0;
}

fn ecs_archetype_info_has_add_hook(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_ADD_HOOK); }
fn ecs_archetype_info_has_insert_hook(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_INSERT_HOOK); }
fn ecs_archetype_info_has_discard_hook(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_DISCARD_HOOK); }
fn ecs_archetype_info_has_remove_hook(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_REMOVE_HOOK); }
fn ecs_archetype_info_has_despawn_hook(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_DESPAWN_HOOK); }
fn ecs_archetype_info_has_add_observer(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_ADD_OBSERVER); }
fn ecs_archetype_info_has_insert_observer(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_INSERT_OBSERVER); }
fn ecs_archetype_info_has_discard_observer(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_DISCARD_OBSERVER); }
fn ecs_archetype_info_has_remove_observer(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_REMOVE_OBSERVER); }
fn ecs_archetype_info_has_despawn_observer(a: EcsArchetypeInfo) -> bool { return ecs_archetype_info_has_flag(a, ECS_AFLAGS_ON_DESPAWN_OBSERVER); }

fn ecs_archetype_info_edges(a: EcsArchetypeInfo) -> bool { return a.edges_present; }
fn ecs_archetype_info_set_edges(a: EcsArchetypeInfo) -> EcsArchetypeInfo {
    a.edges_present = true;
    return a;
}

// entity_table_row(archetype_row): mapping from ArchetypeRow -> TableRow (here identity mapping).
fn ecs_archetype_info_entity_table_row(a: EcsArchetypeInfo, archetype_row: i32) -> i32 {
    return archetype_row;
}
