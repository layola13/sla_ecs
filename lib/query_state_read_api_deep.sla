// Deep self-contained Bevy ECS query/state.rs read API extras.
// Mirrors lib/query_state_read_api.sla (357 lines) with fixed-cap (cap-16) scalar slot families.
// No @import. All structs carry @derive(copy). Vec<i32> inputs replaced by EcsQsEntityArgDeep
// (cap-16 i32 slot family + count).

const ECS_QS_DEEP_CAP: i32 = 16;

// === Error markers ===
fn ecs_qe_deep_err_query_does_not_match() -> i32 { return 0; }
fn ecs_qe_deep_err_not_spawned() -> i32 { return 1; }
fn ecs_qe_deep_err_aliased_mutability() -> i32 { return 2; }
fn ecs_qe_deep_err_is_query_does_not_match(code: i32) -> bool { return code == 0; }
fn ecs_qe_deep_err_is_not_spawned(code: i32) -> bool { return code == 1; }
fn ecs_qe_deep_err_is_aliased_mutability(code: i32) -> bool { return code == 2; }

fn ecs_qs_deep_err_no_entities() -> i32 { return 0; }
fn ecs_qs_deep_err_multiple_entities() -> i32 { return 1; }
fn ecs_qs_deep_err_is_no_entities(code: i32) -> bool { return code == 0; }
fn ecs_qs_deep_err_is_multiple_entities(code: i32) -> bool { return code == 1; }

// === Single-entity read result ===
@derive(copy)
struct SingleResultDeep {
    ok: i32,
    err_code: i32,
    entity_idx: i32,
    value: i32,
}

fn ecs_qs_deep_single_found(r: SingleResultDeep) -> bool { return r.ok == 1; }
fn ecs_qs_deep_single_err_code(r: SingleResultDeep) -> i32 { return r.err_code; }
fn ecs_qs_deep_single_entity_idx(r: SingleResultDeep) -> i32 { return r.entity_idx; }
fn ecs_qs_deep_single_value(r: SingleResultDeep) -> i32 { return r.value; }

// === GetResult ===
@derive(copy)
struct GetResultDeep {
    ok: i32,
    err_code: i32,
    value: i32,
}

fn ecs_qs_deep_get_ok(r: GetResultDeep) -> i32 { return r.ok; }
fn ecs_qs_deep_get_err_code(r: GetResultDeep) -> i32 { return r.err_code; }
fn ecs_qs_deep_get_value(r: GetResultDeep) -> i32 { return r.value; }

// === GetManyResult ===
@derive(copy)
struct GetManyResultDeep {
    count: i32,
    first_err_code: i32,
    matched_count: i32,
    sum_values: i32,
    first_value: i32,
    aliased_idx: i32,
}

fn ecs_qs_deep_getmany_count(r: GetManyResultDeep) -> i32 { return r.count; }
fn ecs_qs_deep_getmany_first_err(r: GetManyResultDeep) -> i32 { return r.first_err_code; }
fn ecs_qs_deep_getmany_matched(r: GetManyResultDeep) -> i32 { return r.matched_count; }
fn ecs_qs_deep_getmany_sum(r: GetManyResultDeep) -> i32 { return r.sum_values; }
fn ecs_qs_deep_getmany_first_value(r: GetManyResultDeep) -> i32 { return r.first_value; }
fn ecs_qs_deep_getmany_aliased_idx(r: GetManyResultDeep) -> i32 { return r.aliased_idx; }

// === IterManyResult ===
@derive(copy)
struct IterManyResultDeep {
    requested: i32,
    matched: i32,
    sum_values: i32,
}

fn ecs_qs_deep_itermany_requested(r: IterManyResultDeep) -> i32 { return r.requested; }
fn ecs_qs_deep_itermany_matched(r: IterManyResultDeep) -> i32 { return r.matched; }
fn ecs_qs_deep_itermany_sum(r: IterManyResultDeep) -> i32 { return r.sum_values; }

// === EcsQsEntityArgDeep: cap-16 i32 slot family, callers populate before passing to get_many / iter_many. ===
@derive(copy)
struct EcsQsEntityArgDeep {
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    e8: i32, e9: i32, e10: i32, e11: i32, e12: i32, e13: i32, e14: i32, e15: i32,
    en: i32,
}

fn ecs_qs_deep_entity_arg_new() -> EcsQsEntityArgDeep {
    return EcsQsEntityArgDeep {
        e0: 0, e1: 0, e2: 0, e3: 0, e4: 0, e5: 0, e6: 0, e7: 0,
        e8: 0, e9: 0, e10: 0, e11: 0, e12: 0, e13: 0, e14: 0, e15: 0,
        en: 0,
    };
}

fn _ecs_qs_deep_entity_arg_at(ea: EcsQsEntityArgDeep, idx: i32) -> i32 {
    if idx == 0 { return ea.e0; };
    if idx == 1 { return ea.e1; };
    if idx == 2 { return ea.e2; };
    if idx == 3 { return ea.e3; };
    if idx == 4 { return ea.e4; };
    if idx == 5 { return ea.e5; };
    if idx == 6 { return ea.e6; };
    if idx == 7 { return ea.e7; };
    if idx == 8 { return ea.e8; };
    if idx == 9 { return ea.e9; };
    if idx == 10 { return ea.e10; };
    if idx == 11 { return ea.e11; };
    if idx == 12 { return ea.e12; };
    if idx == 13 { return ea.e13; };
    if idx == 14 { return ea.e14; };
    if idx == 15 { return ea.e15; };
    panic(145200);
}

fn _ecs_qs_deep_entity_arg_set(ea: EcsQsEntityArgDeep, idx: i32, value: i32) -> EcsQsEntityArgDeep {
    if idx == 0 { ea.e0 = value; return ea; };
    if idx == 1 { ea.e1 = value; return ea; };
    if idx == 2 { ea.e2 = value; return ea; };
    if idx == 3 { ea.e3 = value; return ea; };
    if idx == 4 { ea.e4 = value; return ea; };
    if idx == 5 { ea.e5 = value; return ea; };
    if idx == 6 { ea.e6 = value; return ea; };
    if idx == 7 { ea.e7 = value; return ea; };
    if idx == 8 { ea.e8 = value; return ea; };
    if idx == 9 { ea.e9 = value; return ea; };
    if idx == 10 { ea.e10 = value; return ea; };
    if idx == 11 { ea.e11 = value; return ea; };
    if idx == 12 { ea.e12 = value; return ea; };
    if idx == 13 { ea.e13 = value; return ea; };
    if idx == 14 { ea.e14 = value; return ea; };
    if idx == 15 { ea.e15 = value; return ea; };
    panic(145201);
}

fn ecs_qs_deep_entity_arg_push(ea: EcsQsEntityArgDeep, value: i32) -> EcsQsEntityArgDeep {
    if ea.en >= ECS_QS_DEEP_CAP { return ea; };
    ea = _ecs_qs_deep_entity_arg_set(ea, ea.en, value);
    ea.en = ea.en + 1;
    return ea;
}

fn ecs_qs_deep_entity_arg_len(ea: EcsQsEntityArgDeep) -> i32 { return ea.en; }

fn ecs_qs_deep_entity_arg_at(ea: EcsQsEntityArgDeep, idx: i32) -> i32 {
    return _ecs_qs_deep_entity_arg_at(ea, idx);
}

// === EcsQsReadApiStateDeep: cap-16 entity_indices + values slot family ===
@derive(copy)
struct EcsQsReadApiStateDeep {
    idx_0: i32, idx_1: i32, idx_2: i32, idx_3: i32, idx_4: i32, idx_5: i32, idx_6: i32, idx_7: i32,
    idx_8: i32, idx_9: i32, idx_10: i32, idx_11: i32, idx_12: i32, idx_13: i32, idx_14: i32, idx_15: i32,

    val_0: i32, val_1: i32, val_2: i32, val_3: i32, val_4: i32, val_5: i32, val_6: i32, val_7: i32,
    val_8: i32, val_9: i32, val_10: i32, val_11: i32, val_12: i32, val_13: i32, val_14: i32, val_15: i32,

    type_id: i32,
    archetype_generation: i32,
    world_id: i32,
    builder_source: i32,
    try_new_ok: i32,
    count: i32,
}

fn _ecqs_idx_set(s: EcsQsReadApiStateDeep, idx: i32, v: i32) -> EcsQsReadApiStateDeep {
    if idx == 0 { s.idx_0 = v; return s; };
    if idx == 1 { s.idx_1 = v; return s; };
    if idx == 2 { s.idx_2 = v; return s; };
    if idx == 3 { s.idx_3 = v; return s; };
    if idx == 4 { s.idx_4 = v; return s; };
    if idx == 5 { s.idx_5 = v; return s; };
    if idx == 6 { s.idx_6 = v; return s; };
    if idx == 7 { s.idx_7 = v; return s; };
    if idx == 8 { s.idx_8 = v; return s; };
    if idx == 9 { s.idx_9 = v; return s; };
    if idx == 10 { s.idx_10 = v; return s; };
    if idx == 11 { s.idx_11 = v; return s; };
    if idx == 12 { s.idx_12 = v; return s; };
    if idx == 13 { s.idx_13 = v; return s; };
    if idx == 14 { s.idx_14 = v; return s; };
    if idx == 15 { s.idx_15 = v; return s; };
    panic(145202);
}

fn _ecqs_val_set(s: EcsQsReadApiStateDeep, idx: i32, v: i32) -> EcsQsReadApiStateDeep {
    if idx == 0 { s.val_0 = v; return s; };
    if idx == 1 { s.val_1 = v; return s; };
    if idx == 2 { s.val_2 = v; return s; };
    if idx == 3 { s.val_3 = v; return s; };
    if idx == 4 { s.val_4 = v; return s; };
    if idx == 5 { s.val_5 = v; return s; };
    if idx == 6 { s.val_6 = v; return s; };
    if idx == 7 { s.val_7 = v; return s; };
    if idx == 8 { s.val_8 = v; return s; };
    if idx == 9 { s.val_9 = v; return s; };
    if idx == 10 { s.val_10 = v; return s; };
    if idx == 11 { s.val_11 = v; return s; };
    if idx == 12 { s.val_12 = v; return s; };
    if idx == 13 { s.val_13 = v; return s; };
    if idx == 14 { s.val_14 = v; return s; };
    if idx == 15 { s.val_15 = v; return s; };
    panic(145203);
}

fn _ecqs_val_at(s: EcsQsReadApiStateDeep, idx: i32) -> i32 {
    if idx == 0 { return s.val_0; };
    if idx == 1 { return s.val_1; };
    if idx == 2 { return s.val_2; };
    if idx == 3 { return s.val_3; };
    if idx == 4 { return s.val_4; };
    if idx == 5 { return s.val_5; };
    if idx == 6 { return s.val_6; };
    if idx == 7 { return s.val_7; };
    if idx == 8 { return s.val_8; };
    if idx == 9 { return s.val_9; };
    if idx == 10 { return s.val_10; };
    if idx == 11 { return s.val_11; };
    if idx == 12 { return s.val_12; };
    if idx == 13 { return s.val_13; };
    if idx == 14 { return s.val_14; };
    if idx == 15 { return s.val_15; };
    panic(145204);
}

fn ecqs_read_api_deep_empty() -> EcsQsReadApiStateDeep {
    return EcsQsReadApiStateDeep {
        idx_0: 0, idx_1: 0, idx_2: 0, idx_3: 0, idx_4: 0, idx_5: 0, idx_6: 0, idx_7: 0,
        idx_8: 0, idx_9: 0, idx_10: 0, idx_11: 0, idx_12: 0, idx_13: 0, idx_14: 0, idx_15: 0,
        val_0: 0, val_1: 0, val_2: 0, val_3: 0, val_4: 0, val_5: 0, val_6: 0, val_7: 0,
        val_8: 0, val_9: 0, val_10: 0, val_11: 0, val_12: 0, val_13: 0, val_14: 0, val_15: 0,
        type_id: 0, archetype_generation: 0, world_id: 0, builder_source: 0, try_new_ok: 1, count: 0,
    };
}

fn ecs_qs_deep_read_api_new(type_id: i32, world_id: i32) -> EcsQsReadApiStateDeep {
    let s = ecqs_read_api_deep_empty();
    s.type_id = type_id;
    s.world_id = world_id;
    return s;
}

fn ecs_qs_deep_read_api_from_builder(builder_id: i32, type_id: i32, world_id: i32) -> EcsQsReadApiStateDeep {
    let s = ecs_qs_deep_read_api_new(type_id, world_id);
    s.builder_source = builder_id;
    return s;
}

fn ecs_qs_deep_read_api_builder_source(s: EcsQsReadApiStateDeep) -> i32 { return s.builder_source; }

// === Wrapper for tuple (EcsQsReadApiState, i32) returned by try_new ===
@derive(copy)
struct EcsQsTryNewResultDeep {
    state: EcsQsReadApiStateDeep,
    ok: i32,
}

fn ecs_qs_deep_read_api_try_new(world_id: i32, type_id: i32) -> EcsQsTryNewResultDeep {
    if world_id <= 0 {
        let s = ecs_qs_deep_read_api_new(type_id, world_id);
        s.try_new_ok = 0;
        return EcsQsTryNewResultDeep { state: s, ok: 0 };
    };
    let s = ecs_qs_deep_read_api_new(type_id, world_id);
    return EcsQsTryNewResultDeep { state: s, ok: 1 };
}

fn ecs_qs_deep_read_api_try_new_state(r: EcsQsTryNewResultDeep) -> EcsQsReadApiStateDeep {
    return r.state;
}

fn ecs_qs_deep_read_api_try_new_ok(r: EcsQsTryNewResultDeep) -> i32 {
    return r.ok;
}

fn ecs_qs_deep_read_api_try_new_ok_value(s: EcsQsReadApiStateDeep) -> i32 {
    return s.try_new_ok;
}

// === Wrapper for tuple (EcsQsReadApiState, i32) returned by spawn ===
@derive(copy)
struct EcsQsSpawnResultDeep {
    state: EcsQsReadApiStateDeep,
    entity_idx: i32,
}

fn ecs_qs_deep_read_api_spawn(s: EcsQsReadApiStateDeep, value: i32) -> EcsQsSpawnResultDeep {
    let idx = s.count;
    if idx >= ECS_QS_DEEP_CAP {
        return EcsQsSpawnResultDeep { state: s, entity_idx: -1 };
    };
    s = _ecqs_idx_set(s, idx, idx);
    s = _ecqs_val_set(s, idx, value);
    s.count = s.count + 1;
    return EcsQsSpawnResultDeep { state: s, entity_idx: idx };
}

fn ecs_qs_deep_spawn_result_state(r: EcsQsSpawnResultDeep) -> EcsQsReadApiStateDeep {
    return r.state;
}

fn ecs_qs_deep_spawn_result_entity_idx(r: EcsQsSpawnResultDeep) -> i32 {
    return r.entity_idx;
}

fn _ecqs_idx_at(s: EcsQsReadApiStateDeep, idx: i32) -> i32 {
    if idx == 0 { return s.idx_0; };
    if idx == 1 { return s.idx_1; };
    if idx == 2 { return s.idx_2; };
    if idx == 3 { return s.idx_3; };
    if idx == 4 { return s.idx_4; };
    if idx == 5 { return s.idx_5; };
    if idx == 6 { return s.idx_6; };
    if idx == 7 { return s.idx_7; };
    if idx == 8 { return s.idx_8; };
    if idx == 9 { return s.idx_9; };
    if idx == 10 { return s.idx_10; };
    if idx == 11 { return s.idx_11; };
    if idx == 12 { return s.idx_12; };
    if idx == 13 { return s.idx_13; };
    if idx == 14 { return s.idx_14; };
    if idx == 15 { return s.idx_15; };
    panic(145205);
}

fn ecs_qs_deep_read_api_update_archetypes(s: EcsQsReadApiStateDeep) -> EcsQsReadApiStateDeep {
    s.archetype_generation = s.archetype_generation + 1;
    return s;
}

fn ecs_qs_deep_read_api_archetype_generation(s: EcsQsReadApiStateDeep) -> i32 {
    return s.archetype_generation;
}

fn ecs_qs_deep_read_api_world_id(s: EcsQsReadApiStateDeep) -> i32 { return s.world_id; }
fn ecs_qs_deep_read_api_type_id(s: EcsQsReadApiStateDeep) -> i32 { return s.type_id; }
fn ecs_qs_deep_read_api_count(s: EcsQsReadApiStateDeep) -> i32 { return s.count; }

fn ecs_qs_deep_read_api_entity_is_spawned(s: EcsQsReadApiStateDeep, entity: i32) -> bool {
    if entity < 0 { return false; };
    if entity >= s.count { return false; };
    let cur = _ecqs_idx_at(s, entity);
    return cur == entity;
}

fn ecs_qs_deep_read_api_is_empty(s: EcsQsReadApiStateDeep) -> bool {
    return s.count == 0;
}

fn ecs_qs_deep_read_api_contains(s: EcsQsReadApiStateDeep, entity: i32) -> bool {
    return ecs_qs_deep_read_api_entity_is_spawned(s, entity);
}

// Accessor for value at entity (kept private for helpers)
fn _ecqs_read_api_value_at(s: EcsQsReadApiStateDeep, entity: i32) -> i32 {
    return _ecqs_val_at(s, entity);
}

fn ecs_qs_deep_read_api_single(s: EcsQsReadApiStateDeep) -> SingleResultDeep {
    let n = s.count;
    if n == 0 {
        return SingleResultDeep { ok: 0, err_code: ecs_qs_deep_err_no_entities(), entity_idx: -1, value: 0 };
    };
    if n > 1 {
        return SingleResultDeep { ok: 0, err_code: ecs_qs_deep_err_multiple_entities(), entity_idx: -1, value: 0 };
    };
    return SingleResultDeep { ok: 1, err_code: -1, entity_idx: 0, value: _ecqs_val_at(s, 0) };
}

fn ecs_qs_deep_read_api_single_mut(s: EcsQsReadApiStateDeep) -> SingleResultDeep {
    return ecs_qs_deep_read_api_single(s);
}

fn ecs_qs_deep_read_api_get(s: EcsQsReadApiStateDeep, entity: i32) -> GetResultDeep {
    if ecs_qs_deep_read_api_entity_is_spawned(s, entity) != true {
        return GetResultDeep { ok: 0, err_code: ecs_qe_deep_err_not_spawned(), value: 0 };
    };
    return GetResultDeep { ok: 1, err_code: -1, value: _ecqs_val_at(s, entity) };
}

fn ecs_qs_deep_read_api_get_mut(s: EcsQsReadApiStateDeep, entity: i32) -> GetResultDeep {
    return ecs_qs_deep_read_api_get(s, entity);
}

fn ecs_qs_deep_read_api_first_duplicate_index(ea: EcsQsEntityArgDeep) -> i32 {
    let n = ea.en;
    let i: i32 = 0;
    let dup: i32 = -1;
    while i < n {
        let j: i32 = i + 1;
        while j < n {
            let a = _ecs_qs_deep_entity_arg_at(ea, i);
            let b = _ecs_qs_deep_entity_arg_at(ea, j);
            if a == b { dup = a; };
            j = j + 1;
        }
        if dup != -1 { i = n; } else { i = i + 1; };
    }
    return dup;
}

fn ecs_qs_deep_read_api_get_many(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep, require_unique: bool, allow_aliasing_for_mut: bool) -> GetManyResultDeep {
    let n = ea.en;
    let matched: i32 = 0;
    let first_err: i32 = -1;
    let sum: i32 = 0;
    let first_val: i32 = 0;
    let i: i32 = 0;
    while i < n {
        let e = _ecs_qs_deep_entity_arg_at(ea, i);
        let spawned = ecs_qs_deep_read_api_entity_is_spawned(s, e);
        if spawned != true {
            if first_err == -1 { first_err = ecs_qe_deep_err_not_spawned(); };
        };
        if spawned {
            matched = matched + 1;
            let v = _ecqs_val_at(s, e);
            sum = sum + v;
            if matched == 1 { first_val = v; };
        };
        i = i + 1;
    }
    let aliased_idx: i32 = -1;
    let need_dup_check: bool = allow_aliasing_for_mut || require_unique;
    if need_dup_check {
        let dup = ecs_qs_deep_read_api_first_duplicate_index(ea);
        if dup != -1 {
            aliased_idx = dup;
            if first_err == -1 { first_err = ecs_qe_deep_err_aliased_mutability(); };
        };
    };
    return GetManyResultDeep { count: n, first_err_code: first_err, matched_count: matched, sum_values: sum, first_value: first_val, aliased_idx: aliased_idx };
}

fn ecs_qs_deep_read_api_get_many_ro(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> GetManyResultDeep {
    return ecs_qs_deep_read_api_get_many(s, ea, false, false);
}

fn ecs_qs_deep_read_api_get_many_mut(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> GetManyResultDeep {
    return ecs_qs_deep_read_api_get_many(s, ea, true, true);
}

fn ecs_qs_deep_read_api_get_many_unique(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> GetManyResultDeep {
    return ecs_qs_deep_read_api_get_many(s, ea, true, false);
}

fn ecs_qs_deep_read_api_get_many_unique_mut(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> GetManyResultDeep {
    return ecs_qs_deep_read_api_get_many(s, ea, true, true);
}

fn ecs_qs_deep_read_api_iter_many(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> IterManyResultDeep {
    let n = ea.en;
    let matched: i32 = 0;
    let sum: i32 = 0;
    let i: i32 = 0;
    while i < n {
        let e = _ecs_qs_deep_entity_arg_at(ea, i);
        if ecs_qs_deep_read_api_entity_is_spawned(s, e) {
            matched = matched + 1;
            sum = sum + _ecqs_val_at(s, e);
        };
        i = i + 1;
    }
    return IterManyResultDeep { requested: n, matched: matched, sum_values: sum };
}

fn ecs_qs_deep_read_api_iter_many_mut(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> IterManyResultDeep {
    return ecs_qs_deep_read_api_iter_many(s, ea);
}

fn ecs_qs_deep_read_api_iter_many_unique(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> IterManyResultDeep {
    return ecs_qs_deep_read_api_iter_many(s, ea);
}

fn ecs_qs_deep_read_api_iter_many_unique_mut(s: EcsQsReadApiStateDeep, ea: EcsQsEntityArgDeep) -> IterManyResultDeep {
    return ecs_qs_deep_read_api_iter_many(s, ea);
}
