// Deepened Bevy ECS schedule::graph::graph_map Graph.
// Mirrors src/schedule/graph/graph_map.rs node/edge/neighbor/degree.
// Fixed capacity: 8 nodes, 16 edges. Shallow lib/graph_map.sla retained.

struct EcsGmDeep {
    directed: bool,
    n0: i64, n1: i64, n2: i64, n3: i64, n4: i64, n5: i64, n6: i64, n7: i64,
    nlen: i32,
    e0a: i64, e0b: i64,
    e1a: i64, e1b: i64,
    e2a: i64, e2b: i64,
    e3a: i64, e3b: i64,
    e4a: i64, e4b: i64,
    e5a: i64, e5b: i64,
    e6a: i64, e6b: i64,
    e7a: i64, e7b: i64,
    e8a: i64, e8b: i64,
    e9a: i64, e9b: i64,
    e10a: i64, e10b: i64,
    e11a: i64, e11b: i64,
    e12a: i64, e12b: i64,
    e13a: i64, e13b: i64,
    e14a: i64, e14b: i64,
    e15a: i64, e15b: i64,
    elen: i32,
}

fn ecs_gm_deep_new(directed: bool) -> EcsGmDeep {
    return EcsGmDeep {
        directed: directed,
        n0: 0, n1: 0, n2: 0, n3: 0, n4: 0, n5: 0, n6: 0, n7: 0, nlen: 0,
        e0a: 0, e0b: 0, e1a: 0, e1b: 0, e2a: 0, e2b: 0, e3a: 0, e3b: 0,
        e4a: 0, e4b: 0, e5a: 0, e5b: 0, e6a: 0, e6b: 0, e7a: 0, e7b: 0,
        e8a: 0, e8b: 0, e9a: 0, e9b: 0, e10a: 0, e10b: 0, e11a: 0, e11b: 0,
        e12a: 0, e12b: 0, e13a: 0, e13b: 0, e14a: 0, e14b: 0, e15a: 0, e15b: 0,
        elen: 0,
    };
}

fn ecs_gm_deep_is_directed(g: EcsGmDeep) -> bool { return g.directed; }
fn ecs_gm_deep_node_count(g: EcsGmDeep) -> i32 { return g.nlen; }
fn ecs_gm_deep_edge_count(g: EcsGmDeep) -> i32 { return g.elen; }

fn ecs_gm_deep_rebuild(
    directed: bool,
    n0: i64, n1: i64, n2: i64, n3: i64, n4: i64, n5: i64, n6: i64, n7: i64, nlen: i32,
    e0a: i64, e0b: i64, e1a: i64, e1b: i64, e2a: i64, e2b: i64, e3a: i64, e3b: i64,
    e4a: i64, e4b: i64, e5a: i64, e5b: i64, e6a: i64, e6b: i64, e7a: i64, e7b: i64,
    e8a: i64, e8b: i64, e9a: i64, e9b: i64, e10a: i64, e10b: i64, e11a: i64, e11b: i64,
    e12a: i64, e12b: i64, e13a: i64, e13b: i64, e14a: i64, e14b: i64, e15a: i64, e15b: i64,
    elen: i32
) -> EcsGmDeep {
    return EcsGmDeep {
        directed: directed,
        n0: n0, n1: n1, n2: n2, n3: n3, n4: n4, n5: n5, n6: n6, n7: n7, nlen: nlen,
        e0a: e0a, e0b: e0b, e1a: e1a, e1b: e1b, e2a: e2a, e2b: e2b, e3a: e3a, e3b: e3b,
        e4a: e4a, e4b: e4b, e5a: e5a, e5b: e5b, e6a: e6a, e6b: e6b, e7a: e7a, e7b: e7b,
        e8a: e8a, e8b: e8b, e9a: e9a, e9b: e9b, e10a: e10a, e10b: e10b, e11a: e11a, e11b: e11b,
        e12a: e12a, e12b: e12b, e13a: e13a, e13b: e13b, e14a: e14a, e14b: e14b, e15a: e15a, e15b: e15b,
        elen: elen,
    };
}

fn ecs_gm_deep_contains_node(g: EcsGmDeep, n: i64) -> bool {
    if g.nlen >= 1 { if g.n0 == n { return true; }; };
    if g.nlen >= 2 { if g.n1 == n { return true; }; };
    if g.nlen >= 3 { if g.n2 == n { return true; }; };
    if g.nlen >= 4 { if g.n3 == n { return true; }; };
    if g.nlen >= 5 { if g.n4 == n { return true; }; };
    if g.nlen >= 6 { if g.n5 == n { return true; }; };
    if g.nlen >= 7 { if g.n6 == n { return true; }; };
    if g.nlen >= 8 { if g.n7 == n { return true; }; };
    return false;
}

fn ecs_gm_deep_add_node(g: EcsGmDeep, n: i64) -> EcsGmDeep {
    if ecs_gm_deep_contains_node(g, n) { return g; };
    if g.nlen == 0 { return ecs_gm_deep_rebuild(g.directed, n, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, 1, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 1 { return ecs_gm_deep_rebuild(g.directed, g.n0, n, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, 2, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 2 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, n, g.n3, g.n4, g.n5, g.n6, g.n7, 3, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 3 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, n, g.n4, g.n5, g.n6, g.n7, 4, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 4 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, n, g.n5, g.n6, g.n7, 5, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 5 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, n, g.n6, g.n7, 6, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 6 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, n, g.n7, 7, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    if g.nlen == 7 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, n, 8, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, g.elen); };
    return g;
}

fn ecs_gm_deep_add_edge(g: EcsGmDeep, a: i64, b: i64) -> EcsGmDeep {
    if g.elen == 0 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, a, b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 1); };
    if g.elen == 1 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, a, b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 2); };
    if g.elen == 2 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, a, b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 3); };
    if g.elen == 3 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, a, b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 4); };
    if g.elen == 4 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, a, b, g.e5a, g.e5b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 5); };
    if g.elen == 5 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, a, b, g.e6a, g.e6b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 6); };
    if g.elen == 6 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, a, b, g.e7a, g.e7b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 7); };
    if g.elen == 7 { return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, a, b, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, 8); };
    return g;
}

fn ecs_gm_deep_edge_from(g: EcsGmDeep, idx: i32) -> i64 {
    if idx == 0 { return g.e0a; };
    if idx == 1 { return g.e1a; };
    if idx == 2 { return g.e2a; };
    if idx == 3 { return g.e3a; };
    if idx == 4 { return g.e4a; };
    if idx == 5 { return g.e5a; };
    if idx == 6 { return g.e6a; };
    if idx == 7 { return g.e7a; };
    return -1;
}

fn ecs_gm_deep_edge_to(g: EcsGmDeep, idx: i32) -> i64 {
    if idx == 0 { return g.e0b; };
    if idx == 1 { return g.e1b; };
    if idx == 2 { return g.e2b; };
    if idx == 3 { return g.e3b; };
    if idx == 4 { return g.e4b; };
    if idx == 5 { return g.e5b; };
    if idx == 6 { return g.e6b; };
    if idx == 7 { return g.e7b; };
    return -1;
}

fn ecs_gm_deep_contains_edge(g: EcsGmDeep, a: i64, b: i64) -> bool {
    if g.elen >= 1 { if g.e0a == a { if g.e0b == b { return true; }; }; if g.directed != true { if g.e0a == b { if g.e0b == a { return true; }; }; }; };
    if g.elen >= 2 { if g.e1a == a { if g.e1b == b { return true; }; }; if g.directed != true { if g.e1a == b { if g.e1b == a { return true; }; }; }; };
    if g.elen >= 3 { if g.e2a == a { if g.e2b == b { return true; }; }; if g.directed != true { if g.e2a == b { if g.e2b == a { return true; }; }; }; };
    if g.elen >= 4 { if g.e3a == a { if g.e3b == b { return true; }; }; if g.directed != true { if g.e3a == b { if g.e3b == a { return true; }; }; }; };
    if g.elen >= 5 { if g.e4a == a { if g.e4b == b { return true; }; }; if g.directed != true { if g.e4a == b { if g.e4b == a { return true; }; }; }; };
    if g.elen >= 6 { if g.e5a == a { if g.e5b == b { return true; }; }; if g.directed != true { if g.e5a == b { if g.e5b == a { return true; }; }; }; };
    if g.elen >= 7 { if g.e6a == a { if g.e6b == b { return true; }; }; if g.directed != true { if g.e6a == b { if g.e6b == a { return true; }; }; }; };
    if g.elen >= 8 { if g.e7a == a { if g.e7b == b { return true; }; }; if g.directed != true { if g.e7a == b { if g.e7b == a { return true; }; }; }; };
    return false;
}

fn ecs_gm_deep_degree(g: EcsGmDeep, a: i64) -> i32 {
    let c = 0;
    if g.elen >= 1 {
        if g.e0a == a { c = c + 1; };
        if g.directed != true { if g.e0b == a { if g.e0a != a { c = c + 1; }; }; };
        if g.directed { if g.e0b == a { if g.e0a != a { c = c + 1; }; }; };
    };
    if g.elen >= 2 {
        if g.e1a == a { c = c + 1; };
        if g.e1b == a { if g.e1a != a { c = c + 1; }; };
    };
    if g.elen >= 3 {
        if g.e2a == a { c = c + 1; };
        if g.e2b == a { if g.e2a != a { c = c + 1; }; };
    };
    if g.elen >= 4 {
        if g.e3a == a { c = c + 1; };
        if g.e3b == a { if g.e3a != a { c = c + 1; }; };
    };
    return c;
}

// neighbors of a: first matching target (for tests: count + first)
struct EcsGmNeighDeep {
    count: i32,
    first: i64,
    second: i64,
}

fn ecs_gm_deep_neighbors(g: EcsGmDeep, a: i64) -> EcsGmNeighDeep {
    let count = 0;
    let first = -1;
    let second = -1;
    if g.elen >= 1 {
        if g.e0a == a {
            if count == 0 { first = g.e0b; };
            if count == 1 { second = g.e0b; };
            count = count + 1;
        };
        if g.directed != true {
            if g.e0b == a {
                if g.e0a != a {
                    if count == 0 { first = g.e0a; };
                    if count == 1 { second = g.e0a; };
                    count = count + 1;
                };
            };
        };
    };
    if g.elen >= 2 {
        if g.e1a == a {
            if count == 0 { first = g.e1b; };
            if count == 1 { second = g.e1b; };
            count = count + 1;
        };
        if g.directed != true {
            if g.e1b == a {
                if g.e1a != a {
                    if count == 0 { first = g.e1a; };
                    if count == 1 { second = g.e1a; };
                    count = count + 1;
                };
            };
        };
    };
    if g.elen >= 3 {
        if g.e2a == a {
            if count == 0 { first = g.e2b; };
            if count == 1 { second = g.e2b; };
            count = count + 1;
        };
    };
    if g.elen >= 4 {
        if g.e3a == a {
            if count == 0 { first = g.e3b; };
            if count == 1 { second = g.e3b; };
            count = count + 1;
        };
    };
    return EcsGmNeighDeep { count: count, first: first, second: second };
}

fn ecs_gm_neigh_count(n: EcsGmNeighDeep) -> i32 { return n.count; }
fn ecs_gm_neigh_first(n: EcsGmNeighDeep) -> i64 { return n.first; }
fn ecs_gm_neigh_second(n: EcsGmNeighDeep) -> i64 { return n.second; }

fn ecs_gm_deep_node_at(g: EcsGmDeep, idx: i32) -> i64 {
    if idx == 0 { return g.n0; };
    if idx == 1 { return g.n1; };
    if idx == 2 { return g.n2; };
    if idx == 3 { return g.n3; };
    if idx == 4 { return g.n4; };
    if idx == 5 { return g.n5; };
    if idx == 6 { return g.n6; };
    if idx == 7 { return g.n7; };
    return -1;
}

// remove first edge a->b
fn ecs_gm_deep_remove_edge(g: EcsGmDeep, a: i64, b: i64) -> EcsGmDeep {
    // find index then compact by shifting last into hole for first 8 edges
    if g.elen >= 1 { if g.e0a == a { if g.e0b == b { return ecs_gm_deep_remove_edge_at(g, 0); }; }; };
    if g.elen >= 2 { if g.e1a == a { if g.e1b == b { return ecs_gm_deep_remove_edge_at(g, 1); }; }; };
    if g.elen >= 3 { if g.e2a == a { if g.e2b == b { return ecs_gm_deep_remove_edge_at(g, 2); }; }; };
    if g.elen >= 4 { if g.e3a == a { if g.e3b == b { return ecs_gm_deep_remove_edge_at(g, 3); }; }; };
    return g;
}

fn ecs_gm_deep_remove_edge_at(g: EcsGmDeep, idx: i32) -> EcsGmDeep {
    let last_a = 0;
    let last_b = 0;
    if g.elen == 1 { last_a = g.e0a; last_b = g.e0b; };
    if g.elen == 2 { last_a = g.e1a; last_b = g.e1b; };
    if g.elen == 3 { last_a = g.e2a; last_b = g.e2b; };
    if g.elen == 4 { last_a = g.e3a; last_b = g.e3b; };
    if g.elen == 5 { last_a = g.e4a; last_b = g.e4b; };
    if g.elen == 6 { last_a = g.e5a; last_b = g.e5b; };
    if g.elen == 7 { last_a = g.e6a; last_b = g.e6b; };
    if g.elen == 8 { last_a = g.e7a; last_b = g.e7b; };
    let nlen = g.elen - 1;
    if idx == 0 {
        return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, last_a, last_b, g.e1a, g.e1b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, 0, 0, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, nlen);
    };
    if idx == 1 {
        return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, last_a, last_b, g.e2a, g.e2b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, 0, 0, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, nlen);
    };
    if idx == 2 {
        return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, last_a, last_b, g.e3a, g.e3b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, 0, 0, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, nlen);
    };
    if idx == 3 {
        return ecs_gm_deep_rebuild(g.directed, g.n0, g.n1, g.n2, g.n3, g.n4, g.n5, g.n6, g.n7, g.nlen, g.e0a, g.e0b, g.e1a, g.e1b, g.e2a, g.e2b, last_a, last_b, g.e4a, g.e4b, g.e5a, g.e5b, g.e6a, g.e6b, 0, 0, g.e8a, g.e8b, g.e9a, g.e9b, g.e10a, g.e10b, g.e11a, g.e11b, g.e12a, g.e12b, g.e13a, g.e13b, g.e14a, g.e14b, g.e15a, g.e15b, nlen);
    };
    return g;
}

fn ecs_gm_deep_clear(g: EcsGmDeep) -> EcsGmDeep {
    return ecs_gm_deep_new(g.directed);
}
