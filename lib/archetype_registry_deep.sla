// Deepened Bevy ECS archetype registry / entity-archetype location mapping (Batch 383).
//
// Mirror of the shallow `lib/archetype_registry.sla` `RegistryArchetypeWorld` surface on
// fixed-cap storage (no Vec, no `while`, no `let mut` i32 rebind, no test tuple-return
// destructuring, no `let w = fn(w,...)` chained rebinds). Self-contained -- the world
// carries its own cap-16 entity generation/alive bit registry and cap-8 component-storage
// table so we never need `@import "world_registry.sla"` (the shallow file does, which would
// couple the deep to the whole registry world frame per the Batch 382 plan notes).
//
// Storage:
//   - cap-8  archetypes        (EcsArchWorldDeep.a0..a7 + arch_count)
//   - cap-16 entities-per-arch (EcsArchArchDeep.e0..e15 + ent_count)
//   - cap-6  component-ids-per-arch (EcsArchArchDeep.c0..c7 + comp_count) -- one slot per component id registered
//   - cap-16 location records  (EcsArchWorldDeep.loc0..loc15 + loc_count)
//   - cap-16 entity generation + alive bit (EcsArchWorldDeep.g0..g15 + alive0..alive15 + next_entity)
//   - cap-8  component storage tags (EcsArchWorldDeep.comp0..comp7 + comp_count) -- 0 = table, 1 = sparse_set
//
// Wrapper structs (Batch 373 rule -- no test tuple destructuring):
//   EcsArchInfoDeep   { id: i32, storage: i32 }                      -- register_table / register_sparse_set result
//   EcsArchSpawnDeep  { world: EcsArchWorldDeep, entity: i32 }     -- spawn result (test uses _spawn_world / _spawn_entity)
//   EcsArchSlotDeep   { world: EcsArchWorldDeep, archetype_id: i32 } -- get_or_create_archetype result
//   EcsArchSignDeep   { cap0..cap7: i32, count: i32 }             -- entity signature
//   EcsArchQueryDeep  { found: bool, count: i32, e0..e15: i32, g0..g15: i32, cap: i32 } -- query_component result

const ECS_AREG_ARCH_CAP: i32 = 8;
const ECS_AREG_ENT_CAP: i32 = 16;
const ECS_AREG_COMP_CAP: i32 = 8;
const ECS_AREG_LOC_CAP: i32 = 16;
const ECS_AREG_STORAGE_TABLE: i32 = 0;
const ECS_AREG_STORAGE_SPARSE: i32 = 1;

// ── Archetype record (cap-16 entities-per-arch slot x cap-8 component-ids) ───
struct EcsArchArchDeep {
    id: i32,
    c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32,
    comp_count: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    e8: i32, e9: i32, e10: i32, e11: i32, e12: i32, e13: i32, e14: i32, e15: i32,
    ent_count: i32,
}

// ── Entity location record (one per entity slot) ─────────────────────────────
struct EcsArchLocationDeep {
    entity_id: i32,
    archetype_id: i32,
    row: i32,
}

// ── World (cap-8 archetypes + cap-16 locations + cap-16 entity registry) ───
struct EcsArchWorldDeep {
    a0: EcsArchArchDeep, a1: EcsArchArchDeep, a2: EcsArchArchDeep, a3: EcsArchArchDeep,
    a4: EcsArchArchDeep, a5: EcsArchArchDeep, a6: EcsArchArchDeep, a7: EcsArchArchDeep,
    arch_count: i32,
    loc0: EcsArchLocationDeep, loc1: EcsArchLocationDeep, loc2: EcsArchLocationDeep, loc3: EcsArchLocationDeep,
    loc4: EcsArchLocationDeep, loc5: EcsArchLocationDeep, loc6: EcsArchLocationDeep, loc7: EcsArchLocationDeep,
    loc8: EcsArchLocationDeep, loc9: EcsArchLocationDeep, loc10: EcsArchLocationDeep, loc11: EcsArchLocationDeep,
    loc12: EcsArchLocationDeep, loc13: EcsArchLocationDeep, loc14: EcsArchLocationDeep, loc15: EcsArchLocationDeep,
    loc_count: i32,
    g0: i32, g1: i32, g2: i32, g3: i32, g4: i32, g5: i32, g6: i32, g7: i32,
    g8: i32, g9: i32, g10: i32, g11: i32, g12: i32, g13: i32, g14: i32, g15: i32,
    alive0: i32, alive1: i32, alive2: i32, alive3: i32, alive4: i32, alive5: i32, alive6: i32, alive7: i32,
    alive8: i32, alive9: i32, alive10: i32, alive11: i32, alive12: i32, alive13: i32, alive14: i32, alive15: i32,
    comp0: i32, comp1: i32, comp2: i32, comp3: i32, comp4: i32, comp5: i32, comp6: i32, comp7: i32,
    comp_count: i32,
    next_entity: i32,
    // per-entity attached-component bitset: cap-16 entities x cap-8 component bits -> 2 sets of 8 i32 bitwords.
    // Each entity slot k stores component-attachment bitword at attach_bits0..attach_bits15 (one i32 per entity).
    attach0: i32, attach1: i32, attach2: i32, attach3: i32, attach4: i32, attach5: i32, attach6: i32, attach7: i32,
    attach8: i32, attach9: i32, attach10: i32, attach11: i32, attach12: i32, attach13: i32, attach14: i32, attach15: i32,
}

// ── Wrapper structs (Batch 373 rule -- no test tuple destructuring) ──────────
struct EcsArchInfoDeep { id: i32, storage: i32 }
struct EcsArchSpawnDeep { world: EcsArchWorldDeep, entity: i32 }
struct EcsArchSlotDeep { world: EcsArchWorldDeep, archetype_id: i32 }
struct EcsArchSignDeep { c0: i32, c1: i32, c2: i32, c3: i32, c4: i32, c5: i32, c6: i32, c7: i32, count: i32 }
struct EcsArchQueryDeep {
    found: bool,
    count: i32,
    e0: i32, e1: i32, e2: i32, e3: i32, e4: i32, e5: i32, e6: i32, e7: i32,
    e8: i32, e9: i32, e10: i32, e11: i32, e12: i32, e13: i32, e14: i32, e15: i32,
    g0: i32, g1: i32, g2: i32, g3: i32, g4: i32, g5: i32, g6: i32, g7: i32,
    g8: i32, g9: i32, g10: i32, g11: i32, g12: i32, g13: i32, g14: i32, g15: i32,
}

fn ecs_arch_world_deep_info_id(r: EcsArchInfoDeep) -> i32 { return r.id; }
fn ecs_arch_world_deep_info_storage(r: EcsArchInfoDeep) -> i32 { return r.storage; }

struct EcsArchRegisterDeep { world: EcsArchWorldDeep, info: EcsArchInfoDeep }
fn ecs_arch_world_deep_register_world(r: EcsArchRegisterDeep) -> EcsArchWorldDeep { return r.world; }
fn ecs_arch_world_deep_register_info(r: EcsArchRegisterDeep) -> EcsArchInfoDeep { return r.info; }

fn ecs_arch_world_deep_register_table_w(w0: EcsArchWorldDeep) -> EcsArchRegisterDeep {
    if w0.comp_count >= ECS_AREG_COMP_CAP {
        return _ecs_arch_register_wrap(w0, _ecs_arch_info(w0.comp_count - 1, ECS_AREG_STORAGE_TABLE));
    };
    let cid = w0.comp_count;
    let w1 = _ecs_arch_world_deep_register_component(w0, ECS_AREG_STORAGE_TABLE);
    return _ecs_arch_register_wrap(w1, _ecs_arch_info(cid, ECS_AREG_STORAGE_TABLE));
}

fn ecs_arch_world_deep_register_sparse_set_w(w0: EcsArchWorldDeep) -> EcsArchRegisterDeep {
    if w0.comp_count >= ECS_AREG_COMP_CAP {
        return _ecs_arch_register_wrap(w0, _ecs_arch_info(w0.comp_count - 1, ECS_AREG_STORAGE_SPARSE));
    };
    let cid = w0.comp_count;
    let w1 = _ecs_arch_world_deep_register_component(w0, ECS_AREG_STORAGE_SPARSE);
    return _ecs_arch_register_wrap(w1, _ecs_arch_info(cid, ECS_AREG_STORAGE_SPARSE));
}

fn _ecs_arch_register_wrap(world: EcsArchWorldDeep, info: EcsArchInfoDeep) -> EcsArchRegisterDeep {
    let r = EcsArchRegisterDeep { world: world, info: info };
    return r;
}

fn ecs_arch_world_deep_spawn_world(r: EcsArchSpawnDeep) -> EcsArchWorldDeep { return r.world; }
fn ecs_arch_world_deep_spawn_entity(r: EcsArchSpawnDeep) -> i32 { return r.entity; }

fn ecs_arch_world_deep_slot_world(r: EcsArchSlotDeep) -> EcsArchWorldDeep { return r.world; }
fn ecs_arch_world_deep_slot_id(r: EcsArchSlotDeep) -> i32 { return r.archetype_id; }

fn ecs_arch_world_deep_sign_count(r: EcsArchSignDeep) -> i32 { return r.count; }
fn ecs_arch_world_deep_sign_at(r: EcsArchSignDeep, idx: i32) -> i32 {
    if idx == 0 { return r.c0; };
    if idx == 1 { return r.c1; };
    if idx == 2 { return r.c2; };
    if idx == 3 { return r.c3; };
    if idx == 4 { return r.c4; };
    if idx == 5 { return r.c5; };
    if idx == 6 { return r.c6; };
    if idx == 7 { return r.c7; };
    return -1;
}

fn ecs_arch_world_deep_query_found(r: EcsArchQueryDeep) -> bool { return r.found; }
fn ecs_arch_world_deep_query_count(r: EcsArchQueryDeep) -> i32 { return r.count; }
fn ecs_arch_world_deep_query_entity_id(r: EcsArchQueryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.e0; };
    if idx == 1 { return r.e1; };
    if idx == 2 { return r.e2; };
    if idx == 3 { return r.e3; };
    if idx == 4 { return r.e4; };
    if idx == 5 { return r.e5; };
    if idx == 6 { return r.e6; };
    if idx == 7 { return r.e7; };
    if idx == 8 { return r.e8; };
    if idx == 9 { return r.e9; };
    if idx == 10 { return r.e10; };
    if idx == 11 { return r.e11; };
    if idx == 12 { return r.e12; };
    if idx == 13 { return r.e13; };
    if idx == 14 { return r.e14; };
    if idx == 15 { return r.e15; };
    return -1;
}
fn ecs_arch_world_deep_query_generation(r: EcsArchQueryDeep, idx: i32) -> i32 {
    if idx == 0 { return r.g0; };
    if idx == 1 { return r.g1; };
    if idx == 2 { return r.g2; };
    if idx == 3 { return r.g3; };
    if idx == 4 { return r.g4; };
    if idx == 5 { return r.g5; };
    if idx == 6 { return r.g6; };
    if idx == 7 { return r.g7; };
    if idx == 8 { return r.g8; };
    if idx == 9 { return r.g9; };
    if idx == 10 { return r.g10; };
    if idx == 11 { return r.g11; };
    if idx == 12 { return r.g12; };
    if idx == 13 { return r.g13; };
    if idx == 14 { return r.g14; };
    if idx == 15 { return r.g15; };
    return 0;
}

// ── empty archetype record helpers ────────────────────────────────────────────
fn ecs_arch_arch_deep_empty(arch_id: i32) -> EcsArchArchDeep {
    let a = EcsArchArchDeep {
        id: arch_id,
        c0: -1, c1: -1, c2: -1, c3: -1, c4: -1, c5: -1, c6: -1, c7: -1,
        comp_count: 0,
        e0: -1, e1: -1, e2: -1, e3: -1, e4: -1, e5: -1, e6: -1, e7: -1,
        e8: -1, e9: -1, e10: -1, e11: -1, e12: -1, e13: -1, e14: -1, e15: -1,
        ent_count: 0,
    };
    return a;
}

fn ecs_arch_arch_deep_component_at(a: EcsArchArchDeep, idx: i32) -> i32 {
    if idx == 0 { return a.c0; };
    if idx == 1 { return a.c1; };
    if idx == 2 { return a.c2; };
    if idx == 3 { return a.c3; };
    if idx == 4 { return a.c4; };
    if idx == 5 { return a.c5; };
    if idx == 6 { return a.c6; };
    if idx == 7 { return a.c7; };
    return -1;
}

// Set the component-id at slot k (cascade-of-return, Batch 377 shape).
fn _ecs_arch_arch_deep_set_component_at(a0: EcsArchArchDeep, k: i32, v: i32) -> EcsArchArchDeep {
    if k == 0 { a0.c0 = v; return a0; };
    if k == 1 { a0.c1 = v; return a0; };
    if k == 2 { a0.c2 = v; return a0; };
    if k == 3 { a0.c3 = v; return a0; };
    if k == 4 { a0.c4 = v; return a0; };
    if k == 5 { a0.c5 = v; return a0; };
    if k == 6 { a0.c6 = v; return a0; };
    a0.c7 = v;
    return a0;
}

// Set the entity-id at row k (cascade-of-return).
fn _ecs_arch_arch_deep_set_entity_at(a0: EcsArchArchDeep, k: i32, v: i32) -> EcsArchArchDeep {
    if k == 0 { a0.e0 = v; return a0; };
    if k == 1 { a0.e1 = v; return a0; };
    if k == 2 { a0.e2 = v; return a0; };
    if k == 3 { a0.e3 = v; return a0; };
    if k == 4 { a0.e4 = v; return a0; };
    if k == 5 { a0.e5 = v; return a0; };
    if k == 6 { a0.e6 = v; return a0; };
    if k == 7 { a0.e7 = v; return a0; };
    if k == 8 { a0.e8 = v; return a0; };
    if k == 9 { a0.e9 = v; return a0; };
    if k == 10 { a0.e10 = v; return a0; };
    if k == 11 { a0.e11 = v; return a0; };
    if k == 12 { a0.e12 = v; return a0; };
    if k == 13 { a0.e13 = v; return a0; };
    if k == 14 { a0.e14 = v; return a0; };
    a0.e15 = v;
    return a0;
}

fn ecs_arch_arch_deep_entity_at(a: EcsArchArchDeep, idx: i32) -> i32 {
    if idx == 0 { return a.e0; };
    if idx == 1 { return a.e1; };
    if idx == 2 { return a.e2; };
    if idx == 3 { return a.e3; };
    if idx == 4 { return a.e4; };
    if idx == 5 { return a.e5; };
    if idx == 6 { return a.e6; };
    if idx == 7 { return a.e7; };
    if idx == 8 { return a.e8; };
    if idx == 9 { return a.e9; };
    if idx == 10 { return a.e10; };
    if idx == 11 { return a.e11; };
    if idx == 12 { return a.e12; };
    if idx == 13 { return a.e13; };
    if idx == 14 { return a.e14; };
    if idx == 15 { return a.e15; };
    return -1;
}

fn _ecs_arch_arch_deep_set_comp_count(a0: EcsArchArchDeep, v: i32) -> EcsArchArchDeep { a0.comp_count = v; return a0; }
fn _ecs_arch_arch_deep_set_ent_count(a0: EcsArchArchDeep, v: i32) -> EcsArchArchDeep { a0.ent_count = v; return a0; }

// Get-or-grow the archetype record at `arch_id`, returning it untouched.
// Shallow uses Vec indexing; here we have a cap-8 fixed array.
fn _ecs_arch_world_deep_arch_at(w: EcsArchWorldDeep, idx: i32) -> EcsArchArchDeep {
    if idx == 0 { return w.a0; };
    if idx == 1 { return w.a1; };
    if idx == 2 { return w.a2; };
    if idx == 3 { return w.a3; };
    if idx == 4 { return w.a4; };
    if idx == 5 { return w.a5; };
    if idx == 6 { return w.a6; };
    return w.a7;
}

// Set the archetype record at slot idx (cascade-of-return).
fn _ecs_arch_world_deep_set_arch(w0: EcsArchWorldDeep, idx: i32, a: EcsArchArchDeep) -> EcsArchWorldDeep {
    if idx == 0 { w0.a0 = a; return w0; };
    if idx == 1 { w0.a1 = a; return w0; };
    if idx == 2 { w0.a2 = a; return w0; };
    if idx == 3 { w0.a3 = a; return w0; };
    if idx == 4 { w0.a4 = a; return w0; };
    if idx == 5 { w0.a5 = a; return w0; };
    if idx == 6 { w0.a6 = a; return w0; };
    w0.a7 = a;
    return w0;
}

fn _ecs_arch_arch_deep_set_id(a0: EcsArchArchDeep, v: i32) -> EcsArchArchDeep { a0.id = v; return a0; }

// Append a component-id to an archetype under construction (cap-8 reject silent).
// Returns the updated archetype with comp_count bumped.
fn _ecs_arch_arch_deep_push_component(a0: EcsArchArchDeep, v: i32) -> EcsArchArchDeep {
    if a0.comp_count >= ECS_AREG_COMP_CAP { return a0; };
    let a1 = _ecs_arch_arch_deep_set_component_at(a0, a0.comp_count, v);
    a1.comp_count = a1.comp_count + 1;
    return a1;
}

// ── Location accessors / setters (cap-16 full table) ───────────────────────
fn _ecs_arch_world_deep_location_at(w: EcsArchWorldDeep, idx: i32) -> EcsArchLocationDeep {
    if idx == 0 { return w.loc0; };
    if idx == 1 { return w.loc1; };
    if idx == 2 { return w.loc2; };
    if idx == 3 { return w.loc3; };
    if idx == 4 { return w.loc4; };
    if idx == 5 { return w.loc5; };
    if idx == 6 { return w.loc6; };
    if idx == 7 { return w.loc7; };
    if idx == 8 { return w.loc8; };
    if idx == 9 { return w.loc9; };
    if idx == 10 { return w.loc10; };
    if idx == 11 { return w.loc11; };
    if idx == 12 { return w.loc12; };
    if idx == 13 { return w.loc13; };
    if idx == 14 { return w.loc14; };
    return w.loc15;
}

fn _ecs_arch_world_deep_set_location(w0: EcsArchWorldDeep, idx: i32, loc: EcsArchLocationDeep) -> EcsArchWorldDeep {
    if idx == 0 { w0.loc0 = loc; return w0; };
    if idx == 1 { w0.loc1 = loc; return w0; };
    if idx == 2 { w0.loc2 = loc; return w0; };
    if idx == 3 { w0.loc3 = loc; return w0; };
    if idx == 4 { w0.loc4 = loc; return w0; };
    if idx == 5 { w0.loc5 = loc; return w0; };
    if idx == 6 { w0.loc6 = loc; return w0; };
    if idx == 7 { w0.loc7 = loc; return w0; };
    if idx == 8 { w0.loc8 = loc; return w0; };
    if idx == 9 { w0.loc9 = loc; return w0; };
    if idx == 10 { w0.loc10 = loc; return w0; };
    if idx == 11 { w0.loc11 = loc; return w0; };
    if idx == 12 { w0.loc12 = loc; return w0; };
    if idx == 13 { w0.loc13 = loc; return w0; };
    if idx == 14 { w0.loc14 = loc; return w0; };
    w0.loc15 = loc;
    return w0;
}

fn _ecs_arch_world_deep_location_set_archetype_id(loc0: EcsArchLocationDeep, v: i32) -> EcsArchLocationDeep {
    loc0.archetype_id = v;
    return loc0;
}
fn _ecs_arch_world_deep_location_set_row(loc0: EcsArchLocationDeep, v: i32) -> EcsArchLocationDeep {
    loc0.row = v;
    return loc0;
}

// ── Per-entity registry (alive + generation + attached-component bitword) ────
fn _ecs_arch_world_deep_alive_at(w: EcsArchWorldDeep, k: i32) -> i32 {
    if k == 0 { return w.alive0; };
    if k == 1 { return w.alive1; };
    if k == 2 { return w.alive2; };
    if k == 3 { return w.alive3; };
    if k == 4 { return w.alive4; };
    if k == 5 { return w.alive5; };
    if k == 6 { return w.alive6; };
    if k == 7 { return w.alive7; };
    if k == 8 { return w.alive8; };
    if k == 9 { return w.alive9; };
    if k == 10 { return w.alive10; };
    if k == 11 { return w.alive11; };
    if k == 12 { return w.alive12; };
    if k == 13 { return w.alive13; };
    if k == 14 { return w.alive14; };
    if k == 15 { return w.alive15; };
    return 0;
}

fn _ecs_arch_world_deep_set_alive(w0: EcsArchWorldDeep, k: i32, v: i32) -> EcsArchWorldDeep {
    if k == 0 { w0.alive0 = v; return w0; };
    if k == 1 { w0.alive1 = v; return w0; };
    if k == 2 { w0.alive2 = v; return w0; };
    if k == 3 { w0.alive3 = v; return w0; };
    if k == 4 { w0.alive4 = v; return w0; };
