    if k == 8 { w0.alive8 = v; return w0; };
    if k == 9 { w0.alive9 = v; return w0; };
    if k == 10 { w0.alive10 = v; return w0; };
    if k == 11 { w0.alive11 = v; return w0; };
    if k == 12 { w0.alive12 = v; return w0; };
    if k == 13 { w0.alive13 = v; return w0; };
