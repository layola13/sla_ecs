// Deepened Bevy ECS system::commands::command.
// Mirrors src/system/commands/command.rs Command kinds + apply.
// Shallow lib/system_command.sla retained.

const ECS_SCMD_SPAWN: i32 = 0;
const ECS_SCMD_INSERT: i32 = 1;
const ECS_SCMD_REMOVE: i32 = 2;
const ECS_SCMD_DESPAWN: i32 = 3;
const ECS_SCMD_RES_INSERT: i32 = 4;
const ECS_SCMD_RES_REMOVE: i32 = 5;
const ECS_SCMD_CUSTOM: i32 = 6;

struct EcsScmdDeep {
    kind: i32,
    entity: i64,
    component_id: i32,
    value: i64,
}

fn ecs_scmd_spawn(value: i64) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_SPAWN, entity: 0, component_id: 0, value: value };
}
fn ecs_scmd_insert(entity: i64, component_id: i32, value: i64) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_INSERT, entity: entity, component_id: component_id, value: value };
}
fn ecs_scmd_remove(entity: i64, component_id: i32) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_REMOVE, entity: entity, component_id: component_id, value: 0 };
}
fn ecs_scmd_despawn(entity: i64) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_DESPAWN, entity: entity, component_id: 0, value: 0 };
}
fn ecs_scmd_res_insert(component_id: i32, value: i64) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_RES_INSERT, entity: 0, component_id: component_id, value: value };
}
fn ecs_scmd_res_remove(component_id: i32) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_RES_REMOVE, entity: 0, component_id: component_id, value: 0 };
}
fn ecs_scmd_custom(op_id: i64) -> EcsScmdDeep {
    return EcsScmdDeep { kind: ECS_SCMD_CUSTOM, entity: 0, component_id: 0, value: op_id };
}

fn ecs_scmd_kind(c: EcsScmdDeep) -> i32 { return c.kind; }
fn ecs_scmd_entity(c: EcsScmdDeep) -> i64 { return c.entity; }
fn ecs_scmd_component_id(c: EcsScmdDeep) -> i32 { return c.component_id; }
fn ecs_scmd_value(c: EcsScmdDeep) -> i64 { return c.value; }

fn ecs_scmd_is_spawn(c: EcsScmdDeep) -> bool { return c.kind == ECS_SCMD_SPAWN; }
fn ecs_scmd_is_insert(c: EcsScmdDeep) -> bool { return c.kind == ECS_SCMD_INSERT; }
fn ecs_scmd_is_remove(c: EcsScmdDeep) -> bool { return c.kind == ECS_SCMD_REMOVE; }
fn ecs_scmd_is_despawn(c: EcsScmdDeep) -> bool { return c.kind == ECS_SCMD_DESPAWN; }
fn ecs_scmd_is_resource(c: EcsScmdDeep) -> bool {
    if c.kind == ECS_SCMD_RES_INSERT { return true; };
    if c.kind == ECS_SCMD_RES_REMOVE { return true; };
    return false;
}

fn ecs_scmd_apply(c: EcsScmdDeep) -> i64 { return 1; }

// queue of up to 4 commands
struct EcsScmdQDeep {
    k0: i32, e0: i64, c0: i32, v0: i64,
    k1: i32, e1: i64, c1: i32, v1: i64,
    k2: i32, e2: i64, c2: i32, v2: i64,
    k3: i32, e3: i64, c3: i32, v3: i64,
    len: i32,
}

fn ecs_scmdq_new() -> EcsScmdQDeep {
    return EcsScmdQDeep {
        k0: 0, e0: 0, c0: 0, v0: 0,
        k1: 0, e1: 0, c1: 0, v1: 0,
        k2: 0, e2: 0, c2: 0, v2: 0,
        k3: 0, e3: 0, c3: 0, v3: 0,
        len: 0,
    };
}

fn ecs_scmdq_len(q: EcsScmdQDeep) -> i32 { return q.len; }
fn ecs_scmdq_is_empty(q: EcsScmdQDeep) -> bool { return q.len == 0; }

fn ecs_scmdq_rebuild(
    k0: i32, e0: i64, c0: i32, v0: i64,
    k1: i32, e1: i64, c1: i32, v1: i64,
    k2: i32, e2: i64, c2: i32, v2: i64,
    k3: i32, e3: i64, c3: i32, v3: i64,
    len: i32
) -> EcsScmdQDeep {
    return EcsScmdQDeep {
        k0: k0, e0: e0, c0: c0, v0: v0,
        k1: k1, e1: e1, c1: c1, v1: v1,
        k2: k2, e2: e2, c2: c2, v2: v2,
        k3: k3, e3: e3, c3: c3, v3: v3,
        len: len,
    };
}

fn ecs_scmdq_push(q: EcsScmdQDeep, cmd: EcsScmdDeep) -> EcsScmdQDeep {
    if q.len == 0 {
        return ecs_scmdq_rebuild(cmd.kind, cmd.entity, cmd.component_id, cmd.value, q.k1, q.e1, q.c1, q.v1, q.k2, q.e2, q.c2, q.v2, q.k3, q.e3, q.c3, q.v3, 1);
    };
    if q.len == 1 {
        return ecs_scmdq_rebuild(q.k0, q.e0, q.c0, q.v0, cmd.kind, cmd.entity, cmd.component_id, cmd.value, q.k2, q.e2, q.c2, q.v2, q.k3, q.e3, q.c3, q.v3, 2);
    };
    if q.len == 2 {
        return ecs_scmdq_rebuild(q.k0, q.e0, q.c0, q.v0, q.k1, q.e1, q.c1, q.v1, cmd.kind, cmd.entity, cmd.component_id, cmd.value, q.k3, q.e3, q.c3, q.v3, 3);
    };
    if q.len == 3 {
        return ecs_scmdq_rebuild(q.k0, q.e0, q.c0, q.v0, q.k1, q.e1, q.c1, q.v1, q.k2, q.e2, q.c2, q.v2, cmd.kind, cmd.entity, cmd.component_id, cmd.value, 4);
    };
    return q;
}

fn ecs_scmdq_kind_at(q: EcsScmdQDeep, idx: i32) -> i32 {
    if idx == 0 { return q.k0; };
    if idx == 1 { return q.k1; };
    if idx == 2 { return q.k2; };
    if idx == 3 { return q.k3; };
    return -1;
}

fn ecs_scmdq_apply_all(q: EcsScmdQDeep) -> i64 {
    return q.len as i64;
}

fn ecs_scmdq_clear(q: EcsScmdQDeep) -> EcsScmdQDeep {
    return ecs_scmdq_new();
}

fn ecs_scmd_eq_kind(a: EcsScmdDeep, b: EcsScmdDeep) -> bool {
    return a.kind == b.kind;
}
