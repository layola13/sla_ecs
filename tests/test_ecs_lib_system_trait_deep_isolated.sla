// Isolated tests for lib/system_trait_deep.sla (Batch 401).
// Tests SystemStateFlags, System trait, run, apply_deferred, RunSystemOnce/RunSystemError.

@import "lib/system_trait_deep.sla"

fn _assert_system_state_flags_set_unset() -> void {
    let f = ecs_system_state_flags_deep_new();
    let f2 = ecs_system_state_flags_deep_set(f, ECS_SSTFD_INITIALIZED);
    if ecs_system_state_flags_deep_is_initialized(f2) != true { panic(144500); };
    if ecs_system_state_flags_deep_is_exclusive(f2) { panic(144501); };
    let f3 = ecs_system_state_flags_deep_set(f2, ECS_SSTFD_EXCLUSIVE);
    if ecs_system_state_flags_deep_is_exclusive(f3) != true { panic(144502); };
    let f4 = ecs_system_state_flags_deep_unset(f3, ECS_SSTFD_INITIALIZED);
    if ecs_system_state_flags_deep_is_initialized(f4) { panic(144503); };
    if ecs_system_state_flags_deep_is_exclusive(f4) != true { panic(144504); };
}

fn _assert_system_state_flags_readonly_deferred() -> void {
    let g = ecs_system_state_flags_deep_new();
    let g2 = ecs_system_state_flags_deep_set(g, ECS_SSTFD_HAS_DEFERRED);
    if ecs_system_state_flags_deep_has_deferred(g2) != true { panic(144505); };
    let g3 = ecs_system_state_flags_deep_set(g2, ECS_SSTFD_READ_ONLY);
    if ecs_system_state_flags_deep_is_read_only(g3) != true { panic(144506); };
    let g4 = ecs_system_state_flags_deep_unset(g3, ECS_SSTFD_HAS_DEFERRED);
    if ecs_system_state_flags_deep_has_deferred(g4) { panic(144507); };
    if ecs_system_state_flags_deep_is_read_only(g4) != true { panic(144508); };
}

@test "state_flags_set_unset"() {
    _assert_system_state_flags_set_unset();
    _assert_system_state_flags_readonly_deferred();
}

@test "system_deep_new_and_name"() {
    let s = ecs_system_deep_new(42);
    if ecs_system_deep_name(s) != 42 { panic(144510); };
    if ecs_system_deep_is_initialized(s) { panic(144511); };
    if ecs_system_deep_last_run(s) != 0 { panic(144512); };
}

@test "system_deep_initialize_and_flags"() {
    let s = ecs_system_deep_new(7);
    let s2 = ecs_system_deep_initialize(s);
    if ecs_system_deep_is_initialized(s2) != true { panic(144520); };
    let s3 = ecs_system_deep_set_exclusive(s2);
    if ecs_system_deep_is_exclusive(s3) != true { panic(144521); };
    let s4 = ecs_system_deep_set_read_only(s3);
    if ecs_system_deep_is_read_only(s4) != true { panic(144522); };
    if ecs_system_deep_is_initialized(s4) != true { panic(144523); };
}

@test "system_deep_run_and_last_run"() {
    let s = ecs_system_deep_new(1);
    let s2 = ecs_system_deep_initialize(s);
    let run_result = ecs_system_deep_run(s2, 999);
    let output_val = ecs_system_run_deep_result_output(run_result);
    if output_val != 999 { panic(144530); };
    let updated_sys = ecs_system_run_deep_result_system(run_result);
    if ecs_system_deep_last_run(updated_sys) != 999 { panic(144531); };
}

@test "system_deep_apply_deferred_and_clear"() {
    let s = ecs_system_deep_new(5);
    let s2 = ecs_system_deep_initialize(s);
    let s3 = ecs_system_deep_apply_deferred(s2);
    if ecs_system_deep_has_deferred(s3) != true { panic(144540); };
    let s4 = ecs_system_deep_clear_deferred(s3);
    if ecs_system_deep_has_deferred(s4) { panic(144541); };
    if ecs_system_deep_is_initialized(s4) != true { panic(144542); };
}

@test "run_system_once_not_initialized"() {
    let s = ecs_system_deep_new(3);
    let result = ecs_run_system_once_deep(s, 100);
    if ecs_run_system_once_deep_is_ok(result) { panic(144550); };
    if ecs_run_system_once_deep_error_kind(result) != ECS_RSED_NOT_INITIALIZED { panic(144551); };
    if ecs_run_system_once_deep_output_value(result) != 0 { panic(144552); };
    if ecs_run_system_once_deep_error_name(result) != 1 { panic(144553); };
}

@test "run_system_once_ok"() {
    let s = ecs_system_deep_new(10);
    let s2 = ecs_system_deep_initialize(s);
    let result = ecs_run_system_once_deep(s2, 777);
    if ecs_run_system_once_deep_is_ok(result) != true { panic(144560); };
    if ecs_run_system_once_deep_output_value(result) != 777 { panic(144561); };
    if ecs_run_system_once_deep_error_kind(result) != ECS_RSED_OK { panic(144562); };
}
