@import "lib/never.sla"

@test "never type id is stable"() {
    if ecs_never_type_id() != 78001 { panic(78031); };
    if ecs_never_debug_name_id() != 78001 { panic(78032); };
}

@test "never reports uninhabited marker semantics"() {
    if ecs_never_is_uninhabited() != true { panic(78033); };
    if ecs_never_can_construct() != false { panic(78034); };
}

