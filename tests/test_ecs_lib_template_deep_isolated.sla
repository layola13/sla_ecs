@import "lib/template_deep.sla"

// Batch 225: template deep (src/template.rs).
// panic codes: 111000 – 111199.

@test "scene_entity_reference_identity"() {
    let a = ecs_tpl_ref_new(1, 10, 2, 3, 4);
    let b = ecs_tpl_ref_new(1, 10, 2, 3, 4);
    let c = ecs_tpl_ref_new(1, 10, 2, 3, 5);
    if ecs_tpl_ref_eq(a, b) != true { panic(111000); };
    if ecs_tpl_ref_eq(a, c) != false { panic(111001); };
    if ecs_tpl_ref_hash(a) != ecs_tpl_ref_hash(b) { panic(111002); };
    if ecs_tpl_ref_line(a) != 10 { panic(111003); };
}

@test "refs_get_spawns_on_miss"() {
    let r = ecs_tpl_refs_new(100);
    let g1 = ecs_tpl_refs_get(r, 7);
    r = g1.0;
    if g1.1 != 100 { panic(111010); };
    if ecs_tpl_refs_spawn_count(r) != 1 { panic(111011); };
    let g2 = ecs_tpl_refs_get(r, 7);
    r = g2.0;
    if g2.1 != 100 { panic(111012); };
    if ecs_tpl_refs_spawn_count(r) != 1 { panic(111013); };
    let g3 = ecs_tpl_refs_get(r, 8);
    if g3.1 != 101 { panic(111014); };
}

@test "refs_set_vacant_only"() {
    let r = ecs_tpl_refs_new(1);
    r = ecs_tpl_refs_set(r, 9, 50);
    r = ecs_tpl_refs_set(r, 9, 99);
    let g = ecs_tpl_refs_get(r, 9);
    if g.1 != 50 { panic(111020); };
}

@test "ctx_resource_mut"() {
    let c = ecs_tpl_ctx_new(5, 10, 3);
    if ecs_tpl_ctx_entity(c) != 5 { panic(111030); };
    if ecs_tpl_ctx_resource(c) != 10 { panic(111031); };
    c = ecs_tpl_ctx_resource_mut(c, 20);
    if ecs_tpl_ctx_resource(c) != 20 { panic(111032); };
    if ecs_tpl_ctx_resource_changed(c) != 3 { panic(111033); };
}

@test "identity_and_default_build"() {
    let ctx = ecs_tpl_ctx_new(1, 0, 0);
    let refs = ecs_tpl_refs_new(1);
    let t = ecs_tpl_identity(42);
    let b = ecs_tpl_build(t, ctx, refs);
    if ecs_tpl_build_ok(b) != true { panic(111040); };
    if ecs_tpl_build_value(b) != 42 { panic(111041); };
    let d = ecs_tpl_default(7);
    let b2 = ecs_tpl_build(d, ctx, refs);
    if ecs_tpl_build_value(b2) != 7 { panic(111042); };
}

@test "option_templates"() {
    let ctx = ecs_tpl_ctx_new(1, 0, 0);
    let refs = ecs_tpl_refs_new(1);
    let s = ecs_tpl_option_some(9);
    let b = ecs_tpl_build(s, ctx, refs);
    if ecs_tpl_build_has_value(b) != true { panic(111050); };
    if ecs_tpl_build_value(b) != 9 { panic(111051); };
    let n = ecs_tpl_option_none();
    let b2 = ecs_tpl_build(n, ctx, refs);
    if ecs_tpl_build_is_none(b2) != true { panic(111052); };
    if ecs_tpl_build_has_value(b2) != false { panic(111053); };
}

@test "vec_template"() {
    let ctx = ecs_tpl_ctx_new(1, 0, 0);
    let refs = ecs_tpl_refs_new(1);
    let t = ecs_tpl_vec_empty();
    t = ecs_tpl_vec_push(t, 1);
    t = ecs_tpl_vec_push(t, 2);
    t = ecs_tpl_vec_push(t, 3);
    if ecs_tpl_vlen(t) != 3 { panic(111060); };
    let b = ecs_tpl_build(t, ctx, refs);
    if ecs_tpl_build_vlen(b) != 3 { panic(111061); };
    if ecs_tpl_build_vat(b, 0) != 1 { panic(111062); };
    if ecs_tpl_build_vat(b, 2) != 3 { panic(111063); };
}

@test "fn_template"() {
    let ctx = ecs_tpl_ctx_new(55, 77, 0);
    let refs = ecs_tpl_refs_new(1);
    let b1 = ecs_tpl_build(ecs_tpl_fn(1), ctx, refs);
    if ecs_tpl_build_value(b1) != 100 { panic(111070); };
    let b2 = ecs_tpl_build(ecs_tpl_fn(2), ctx, refs);
    if ecs_tpl_build_value(b2) != 55 { panic(111071); };
    let b3 = ecs_tpl_build(ecs_tpl_fn(3), ctx, refs);
    if ecs_tpl_build_value(b3) != 77 { panic(111072); };
}

@test "entity_template_resolves_ref"() {
    let ctx = ecs_tpl_ctx_new(1, 0, 0);
    let refs = ecs_tpl_refs_new(200);
    let key = ecs_tpl_ref_hash(ecs_tpl_ref_new(1, 1, 1, 0, 0));
    let t = ecs_tpl_entity(key);
    let b = ecs_tpl_build(t, ctx, refs);
    if ecs_tpl_build_ok(b) != true { panic(111080); };
    if ecs_tpl_build_value(b) != 200 { panic(111081); };
    // second resolve same
    let b2 = ecs_tpl_build(t, ctx, ecs_tpl_build_refs(b));
    if ecs_tpl_build_value(b2) != 200 { panic(111082); };
    if ecs_tpl_refs_spawn_count(ecs_tpl_build_refs(b2)) != 1 { panic(111083); };
}

@test "clone_template"() {
    let t = ecs_tpl_vec_push(ecs_tpl_vec_push(ecs_tpl_vec_empty(), 4), 5);
    let c = ecs_tpl_clone(t);
    if ecs_tpl_vlen(c) != 2 { panic(111090); };
    if ecs_tpl_kind(c) != ECS_TPL_KIND_VEC { panic(111091); };
}

@test "error_template"() {
    let ctx = ecs_tpl_ctx_new(1, 0, 0);
    let refs = ecs_tpl_refs_new(1);
    let b = ecs_tpl_build(ecs_tpl_error(42), ctx, refs);
    if ecs_tpl_build_ok(b) != true { };
    if ecs_tpl_build_ok(b) != false { panic(111100); };
    if ecs_tpl_build_err(b) != 42 { panic(111101); };
}

@test "from_template_auto_manual"() {
    let a = ecs_from_tpl_auto(10);
    if ecs_from_tpl_template_type_id(a) != 100010 { panic(111110); };
    if ecs_from_tpl_has_manual(a) != false { panic(111111); };
    let m = ecs_from_tpl_manual(10, 999);
    if ecs_from_tpl_template_type_id(m) != 999 { panic(111112); };
    if ecs_from_tpl_has_manual(m) != true { panic(111113); };
}

@test "kind_constants"() {
    if ecs_tpl_kind_identity() != 0 { panic(111120); };
    if ecs_tpl_kind_entity() != 6 { panic(111121); };
    if ecs_tpl_kind_option_none() != 3 { panic(111122); };
}

@test "refs_len_after_inserts"() {
    let r = ecs_tpl_refs_new(1);
    let g = ecs_tpl_refs_get(r, 1);
    r = g.0;
    let g2 = ecs_tpl_refs_get(r, 2);
    r = g2.0;
    if ecs_tpl_refs_len(r) != 2 { panic(111130); };
}
