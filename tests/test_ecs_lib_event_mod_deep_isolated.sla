@import "lib/event_mod_deep.sla"

// Batch 208: Event mod deep (src/event/mod.rs).

@test "global_event_type_defaults"() {
    let e = ecs_em_event_global(1, 10);
    if ecs_em_trigger_kind(e) != ECS_EM_TRIG_GLOBAL { panic(107600); };
    if ecs_em_is_entity_event(e) != false { panic(107601); };
    if ecs_em_propagate_enabled(e) != false { panic(107602); };
}

@test "entity_event_defaults_to_entity_trigger"() {
    let e = ecs_em_entity_event(2, 20);
    if ecs_em_trigger_kind(e) != ECS_EM_TRIG_ENTITY { panic(107610); };
    if ecs_em_is_entity_event(e) != true { panic(107611); };
    if ecs_em_set_target_enabled(e) != false { panic(107612); };
}

@test "propagate_enables_set_target_and_propagate_trigger"() {
    let e = ecs_em_entity_event_propagate(3, 30);
    if ecs_em_trigger_kind(e) != ECS_EM_TRIG_PROPAGATE { panic(107620); };
    if ecs_em_propagate_enabled(e) != true { panic(107621); };
    if ecs_em_set_target_enabled(e) != true { panic(107622); };
    if ecs_em_auto_propagate(e) != false { panic(107623); };
}

@test "auto_propagate_flag"() {
    let e = ecs_em_entity_event_auto_propagate(4, 40);
    if ecs_em_auto_propagate(e) != true { panic(107630); };
    if ecs_em_trigger_kind(e) != ECS_EM_TRIG_PROPAGATE { panic(107631); };
}

@test "custom_traversal"() {
    let e = ecs_em_entity_event_propagate_custom(5, 50);
    if ecs_em_traversal_kind(e) != ECS_EM_TRAV_CUSTOM { panic(107640); };
}

@test "target_field_kinds"() {
    let e = ecs_em_entity_event(6, 60);
    e = ecs_em_with_target_field(e, 1);
    if ecs_em_target_field_kind(e) != 1 { panic(107650); };
}

@test "event_key_eq"() {
    let a = ecs_em_key_new(3);
    let b = ecs_em_key_new(3);
    let c = ecs_em_key_new(4);
    if ecs_em_key_eq(a, b) != true { panic(107660); };
    if ecs_em_key_eq(a, c) != false { panic(107661); };
    if ecs_em_key_component_id(a) != 3 { panic(107662); };
}

@test "register_event_key_idempotent"() {
    let w = ecs_em_world_new();
    let ev = ecs_em_event_global(100, 1);
    let r1 = ecs_em_register_event_key(w, ev);
    w = r1.0;
    if ecs_em_key_component_id(r1.1) != 1 { panic(107670); };
    let r2 = ecs_em_register_event_key(w, ev);
    w = r2.0;
    if ecs_em_key_component_id(r2.1) != 1 { panic(107671); };
    if ecs_em_world_len(w) != 1 { panic(107672); };
    if ecs_em_world_next_cid(w) != 2 { panic(107673); };
}

@test "event_key_lookup"() {
    let w = ecs_em_world_new();
    let r = ecs_em_register_event_key(w, ecs_em_entity_event(9, 1));
    w = r.0;
    let hit = ecs_em_event_key(w, 9);
    if hit.0 != true { panic(107680); };
    if ecs_em_key_eq(hit.1, r.1) != true { panic(107681); };
    let miss = ecs_em_event_key(w, 10);
    if miss.0 != false { panic(107682); };
}

@test "register_multiple_events"() {
    let w = ecs_em_world_new();
    let a = ecs_em_register_event_key(w, ecs_em_event_global(1, 1));
    w = a.0;
    let b = ecs_em_register_event_key(w, ecs_em_entity_event(2, 2));
    w = b.0;
    let c = ecs_em_register_event_key(w, ecs_em_entity_event_propagate(3, 3));
    w = c.0;
    if ecs_em_world_len(w) != 3 { panic(107690); };
    if ecs_em_key_component_id(a.1) != 1 { panic(107691); };
    if ecs_em_key_component_id(b.1) != 2 { panic(107692); };
    if ecs_em_key_component_id(c.1) != 3 { panic(107693); };
}

@test "trigger_global_path"() {
    let w = ecs_em_world_new();
    let ev = ecs_em_event_global(50, 1);
    let inst = ecs_em_instance_global(50, 7);
    let r = ecs_em_register_and_trigger(w, ev, inst);
    w = r.0;
    if ecs_em_world_last_kind(w) != ECS_EM_TRIG_GLOBAL { panic(107700); };
    if ecs_em_world_trigger_count(w) != 1 { panic(107701); };
    if ecs_em_world_last_key(w) != ecs_em_key_component_id(r.2) { panic(107702); };
}

@test "trigger_entity_path"() {
    let w = ecs_em_world_new();
    let ev = ecs_em_entity_event(51, 1);
    let inst = ecs_em_instance_entity(51, 9, 42);
    let r = ecs_em_register_and_trigger(w, ev, inst);
    w = r.0;
    if ecs_em_world_last_kind(w) != ECS_EM_TRIG_ENTITY { panic(107710); };
    if ecs_em_world_last_target(w) != 42 { panic(107711); };
    if ecs_em_instance_target(r.1) != 42 { panic(107712); };
}

@test "trigger_auto_propagate_sets_flag"() {
    let w = ecs_em_world_new();
    let ev = ecs_em_entity_event_auto_propagate(52, 1);
    let inst = ecs_em_instance_entity(52, 1, 3);
    if ecs_em_instance_get_propagate(inst) != false { panic(107720); };
    let r = ecs_em_register_and_trigger(w, ev, inst);
    if ecs_em_world_last_kind(r.0) != ECS_EM_TRIG_PROPAGATE { panic(107721); };
    if ecs_em_instance_get_propagate(r.1) != true { panic(107722); };
}

@test "set_event_target"() {
    let inst = ecs_em_instance_entity(1, 0, 5);
    inst = ecs_em_set_event_target(inst, 9);
    if ecs_em_event_target(inst) != 9 { panic(107730); };
}

@test "select_trigger_kind_helper"() {
    if ecs_em_select_trigger_kind(false, false) != ECS_EM_TRIG_GLOBAL { panic(107740); };
    if ecs_em_select_trigger_kind(true, false) != ECS_EM_TRIG_ENTITY { panic(107741); };
    if ecs_em_select_trigger_kind(true, true) != ECS_EM_TRIG_PROPAGATE { panic(107742); };
}

@test "dynamic_event_key_and_wrapper_type"() {
    let k = ecs_em_dynamic_event_key(99);
    if ecs_em_key_component_id(k) != 99 { panic(107750); };
    if ecs_em_wrapper_type_id(5) != 1000005 { panic(107751); };
}

@test "unknown_trigger_auto_registers_global"() {
    let w = ecs_em_world_new();
    let inst = ecs_em_instance_global(123, 1);
    let r = ecs_em_world_trigger(w, inst);
    w = r.0;
    if ecs_em_world_len(w) != 1 { panic(107760); };
    if ecs_em_world_last_kind(w) != ECS_EM_TRIG_GLOBAL { panic(107761); };
}

@test "manual_propagate_instance_flag"() {
    let inst = ecs_em_instance_entity(1, 0, 2);
    inst = ecs_em_instance_propagate(inst, true);
    if ecs_em_instance_get_propagate(inst) != true { panic(107770); };
    inst = ecs_em_instance_propagate(inst, false);
    if ecs_em_instance_get_propagate(inst) != false { panic(107771); };
}
