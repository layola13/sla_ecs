@import "lib/schedule_system_deep.sla"

// Batch 188 tests for WithInputWrapper / WithInputFromWrapper / ScheduleSystem.

@test "inner_system_initialize_and_run"() {
    let s = ecs_ss_inner_deep_new(1, 10);
    if ecs_ss_inner_deep_initialized(s) != false { panic(102000); };
    s = ecs_ss_inner_deep_run_unsafe(s, 5);
    if ecs_ss_inner_deep_last_error(s) != ECS_SS_ERR_UNINITIALIZED { panic(102001); };
    s = ecs_ss_inner_deep_initialize(s);
    s = ecs_ss_inner_deep_run_unsafe(s, 5);
    if ecs_ss_inner_deep_last_error(s) != ECS_SS_ERR_OK { panic(102002); };
    if ecs_ss_inner_deep_last_output(s) != 15 { panic(102003); };
    if ecs_ss_inner_deep_run_count(s) != 1 { panic(102004); };
}

@test "inner_deferred_and_last_run"() {
    let s = ecs_ss_inner_deep_initialize(ecs_ss_inner_deep_new(1, 0));
    s = ecs_ss_inner_deep_queue_deferred(s, 3);
    if ecs_ss_inner_deep_deferred(s) != 3 { panic(102010); };
    s = ecs_ss_inner_deep_apply_deferred(s);
    if ecs_ss_inner_deep_deferred(s) != 0 { panic(102011); };
    s = ecs_ss_inner_deep_set_last_run(s, 7);
    if ecs_ss_inner_deep_last_run(s) != 7 { panic(102012); };
    s = ecs_ss_inner_deep_check_change_tick(s, 2000000);
    if ecs_ss_inner_deep_last_run(s) != 2000000 { panic(102013); };
}

@test "with_input_wrapper_new_value_mut"() {
    let w = ecs_with_input_wrapper_deep_new(9, 1, 4);
    if ecs_with_input_wrapper_deep_name(w) != 9 { panic(102020); };
    if ecs_with_input_wrapper_deep_value(w) != 4 { panic(102021); };
    w = ecs_with_input_wrapper_deep_value_mut(w, 8);
    if ecs_with_input_wrapper_deep_value(w) != 8 { panic(102022); };
    if ecs_with_input_wrapper_deep_initialized(w) != false { panic(102023); };
}

@test "with_input_run_uninitialized_errors"() {
    let w = ecs_with_input_wrapper_deep_new(1, 2, 3);
    w = ecs_with_input_wrapper_deep_run_unsafe(w);
    if ecs_with_input_wrapper_deep_last_error(w) != ECS_SS_ERR_UNINITIALIZED { panic(102030); };
    if ecs_with_input_wrapper_deep_run_count(w) != 0 { panic(102031); };
}

@test "with_input_initialize_run_updates_value"() {
    let w = ecs_with_input_wrapper_deep_new(1, 10, 5);
    w = ecs_with_input_wrapper_deep_initialize(w);
    w = ecs_with_input_wrapper_deep_run_unsafe(w);
    if ecs_with_input_wrapper_deep_last_error(w) != ECS_SS_ERR_OK { panic(102040); };
    // output = value + func_id = 5+10; value mutated to output
    if ecs_with_input_wrapper_deep_last_output(w) != 15 { panic(102041); };
    if ecs_with_input_wrapper_deep_value(w) != 15 { panic(102042); };
    w = ecs_with_input_wrapper_deep_run_unsafe(w);
    if ecs_with_input_wrapper_deep_last_output(w) != 25 { panic(102043); };
    if ecs_with_input_wrapper_deep_run_count(w) != 2 { panic(102044); };
}

@test "with_input_flags_and_deferred_forward"() {
    let w = ecs_with_input_wrapper_deep_new(1, 0, 0);
    w = ecs_with_input_wrapper_deep_set_flags(w, ECS_SS_FLAG_DEFERRED);
    if ecs_with_input_wrapper_deep_flags(w) != ECS_SS_FLAG_DEFERRED { panic(102050); };
    w = ecs_with_input_wrapper_deep_initialize(w);
    w = ecs_with_input_wrapper_deep_queue_deferred(w, 2);
    if ecs_with_input_wrapper_deep_deferred(w) != 2 { panic(102051); };
    w = ecs_with_input_wrapper_deep_apply_deferred(w);
    if ecs_with_input_wrapper_deep_deferred(w) != 0 { panic(102052); };
    w = ecs_with_input_wrapper_deep_set_last_run(w, 3);
    if ecs_with_input_wrapper_deep_last_run(w) != 3 { panic(102053); };
}

@test "with_input_from_starts_without_value"() {
    let w = ecs_with_input_from_wrapper_deep_new(2, 1, 40);
    if ecs_with_input_from_wrapper_deep_has_value(w) != false { panic(102060); };
    let v = ecs_with_input_from_wrapper_deep_value(w);
    if v.0 != false { panic(102061); };
    w = ecs_with_input_from_wrapper_deep_run_unsafe(w);
    if ecs_with_input_from_wrapper_deep_last_error(w) != ECS_SS_ERR_NO_INPUT { panic(102062); };
}

@test "with_input_from_initialize_from_world"() {
    let w = ecs_with_input_from_wrapper_deep_new(2, 1, 40);
    w = ecs_with_input_from_wrapper_deep_initialize(w);
    if ecs_with_input_from_wrapper_deep_has_value(w) != true { panic(102070); };
    let v = ecs_with_input_from_wrapper_deep_value(w);
    if v.0 != true { panic(102071); };
    if v.1 != 40 { panic(102072); };
    if ecs_with_input_from_wrapper_deep_initialized(w) != true { panic(102073); };
}

@test "with_input_from_run_updates_value"() {
    let w = ecs_with_input_from_wrapper_deep_new(2, 5, 10);
    w = ecs_with_input_from_wrapper_deep_initialize(w);
    w = ecs_with_input_from_wrapper_deep_run_unsafe(w);
    if ecs_with_input_from_wrapper_deep_last_error(w) != ECS_SS_ERR_OK { panic(102080); };
    if ecs_with_input_from_wrapper_deep_last_output(w) != 15 { panic(102081); };
    if ecs_with_input_from_wrapper_deep_value(w).1 != 15 { panic(102082); };
}

@test "with_input_from_reinitialize_keeps_value"() {
    let w = ecs_with_input_from_wrapper_deep_new(2, 1, 10);
    w = ecs_with_input_from_wrapper_deep_initialize(w);
    w = ecs_with_input_from_wrapper_deep_run_unsafe(w);
    // value became 11
    if ecs_with_input_from_wrapper_deep_value(w).1 != 11 { panic(102090); };
    w = ecs_with_input_from_wrapper_deep_reinitialize(w);
    if ecs_with_input_from_wrapper_deep_value(w).1 != 11 { panic(102091); };
    if ecs_with_input_from_wrapper_deep_has_value(w) != true { panic(102092); };
}

@test "with_input_from_value_mut_only_when_present"() {
    let w = ecs_with_input_from_wrapper_deep_new(1, 0, 5);
    w = ecs_with_input_from_wrapper_deep_value_mut(w, 99);
    if ecs_with_input_from_wrapper_deep_has_value(w) != false { panic(102100); };
    w = ecs_with_input_from_wrapper_deep_initialize(w);
    w = ecs_with_input_from_wrapper_deep_value_mut(w, 7);
    if ecs_with_input_from_wrapper_deep_value(w).1 != 7 { panic(102101); };
}

@test "with_input_from_flags_deferred_last_run"() {
    let w = ecs_with_input_from_wrapper_deep_new(1, 0, 1);
    w = ecs_with_input_from_wrapper_deep_set_flags(w, ECS_SS_FLAG_EXCLUSIVE);
    if ecs_with_input_from_wrapper_deep_flags(w) != ECS_SS_FLAG_EXCLUSIVE { panic(102110); };
    w = ecs_with_input_from_wrapper_deep_initialize(w);
    w = ecs_with_input_from_wrapper_deep_queue_deferred(w, 4);
    w = ecs_with_input_from_wrapper_deep_apply_deferred(w);
    if ecs_with_input_from_wrapper_deep_deferred(w) != 0 { panic(102111); };
    w = ecs_with_input_from_wrapper_deep_set_last_run(w, 12);
    if ecs_with_input_from_wrapper_deep_last_run(w) != 12 { panic(102112); };
    w = ecs_with_input_from_wrapper_deep_check_change_tick(w, 12);
    if ecs_with_input_from_wrapper_deep_last_run(w) != 12 { panic(102113); };
}

@test "schedule_system_alias_lifecycle"() {
    let s = ecs_schedule_system_deep_new(100, 200);
    if ecs_schedule_system_deep_id(s) != 100 { panic(102120); };
    if ecs_schedule_system_deep_name(s) != 200 { panic(102121); };
    if ecs_schedule_system_deep_initialized(s) != false { panic(102122); };
    s = ecs_schedule_system_deep_run(s);
    if ecs_schedule_system_deep_run_count(s) != 0 { panic(102123); };
    s = ecs_schedule_system_deep_initialize(s);
    s = ecs_schedule_system_deep_run(s);
    s = ecs_schedule_system_deep_run(s);
    if ecs_schedule_system_deep_run_count(s) != 2 { panic(102124); };
}

@test "into_system_with_input_facade"() {
    let w = ecs_into_system_with_input_deep(3, 2, 1);
    w = ecs_with_input_wrapper_deep_initialize(w);
    w = ecs_with_input_wrapper_deep_run_unsafe(w);
    if ecs_with_input_wrapper_deep_last_output(w) != 3 { panic(102130); };
}

@test "into_system_with_input_from_facade"() {
    let w = ecs_into_system_with_input_from_deep(4, 2, 8);
    w = ecs_with_input_from_wrapper_deep_initialize(w);
    w = ecs_with_input_from_wrapper_deep_run_unsafe(w);
    if ecs_with_input_from_wrapper_deep_last_output(w) != 10 { panic(102140); };
}

@test "with_input_check_change_tick_gap"() {
    let w = ecs_with_input_wrapper_deep_set_last_run(ecs_with_input_wrapper_deep_new(1, 0, 0), 1);
    w = ecs_with_input_wrapper_deep_check_change_tick(w, 2000000);
    if ecs_with_input_wrapper_deep_last_run(w) != 2000000 { panic(102150); };
}

@test "inner_set_flags_name"() {
    let s = ecs_ss_inner_deep_set_flags(ecs_ss_inner_deep_new(5, 0), ECS_SS_FLAG_NON_SEND);
    if ecs_ss_inner_deep_flags(s) != ECS_SS_FLAG_NON_SEND { panic(102160); };
    if ecs_ss_inner_deep_name(s) != 5 { panic(102161); };
}

@test "with_input_from_run_twice_accumulates"() {
    let w = ecs_with_input_from_wrapper_deep_initialize(ecs_with_input_from_wrapper_deep_new(1, 1, 0));
    w = ecs_with_input_from_wrapper_deep_run_unsafe(w);
    w = ecs_with_input_from_wrapper_deep_run_unsafe(w);
    if ecs_with_input_from_wrapper_deep_run_count(w) != 2 { panic(102170); };
    if ecs_with_input_from_wrapper_deep_last_output(w) != 2 { panic(102171); };
}

@test "with_input_manual_value_before_run"() {
    let w = ecs_with_input_wrapper_deep_initialize(ecs_with_input_wrapper_deep_new(1, 0, 0));
    w = ecs_with_input_wrapper_deep_value_mut(w, 100);
    w = ecs_with_input_wrapper_deep_run_unsafe(w);
    if ecs_with_input_wrapper_deep_last_output(w) != 100 { panic(102180); };
}

@test "lifecycle_both_wrappers"() {
    let a = ecs_with_input_wrapper_deep_initialize(ecs_into_system_with_input_deep(1, 1, 1));
    a = ecs_with_input_wrapper_deep_run_unsafe(a);
    let b = ecs_with_input_from_wrapper_deep_initialize(ecs_into_system_with_input_from_deep(2, 1, 1));
    b = ecs_with_input_from_wrapper_deep_run_unsafe(b);
    if ecs_with_input_wrapper_deep_last_output(a) != 2 { panic(102190); };
    if ecs_with_input_from_wrapper_deep_last_output(b) != 2 { panic(102191); };
    if ecs_with_input_wrapper_deep_last_error(a) != ECS_SS_ERR_OK { panic(102192); };
    if ecs_with_input_from_wrapper_deep_last_error(b) != ECS_SS_ERR_OK { panic(102193); };
}
