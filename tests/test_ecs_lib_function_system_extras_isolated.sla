@import "lib/function_system_extras.sla"

// Isolated tests for lib/function_system_extras.sla — SystemState + FunctionSystemV2 + markers
// Bevy reference: src/system/function_system.rs

@test "system_state_new_defaults"() {
    let s = ecs_fs_system_state_new(7, 42, 10);
    if ecs_fs_system_state_param_state(s) != 7 { panic(90484); };
    let m = ecs_fs_system_state_get(s);
    let init0 = m.0;
    let cv0 = m.1;
    if init0 != true { panic(90485); };
    if cv0 != 0 { panic(90486); };
    let mm = ecs_fs_system_state_meta(s, 100);
    let mname = mm.0;
    let mtick = mm.1;
    let minit = mm.2;
    if mname != 100 { panic(90487); };
    if mtick != 10 { panic(90488); };
    if minit != true { panic(90489); };
}

@test "system_state_from_builder"() {
    let s = ecs_fs_system_state_from_builder(3, 9, 5);
    if ecs_fs_system_state_param_state(s) != 3 { panic(90490); };
}

@test "system_state_get"() {
    let s = ecs_fs_system_state_new(1, 2, 3);
    let m = ecs_fs_system_state_get(s);
    let init0 = m.0;
    let cv0 = m.1;
    if init0 != true { panic(90491); };
    if cv0 != 0 { panic(90492); };
}

@test "system_state_get_mut"() {
    let s = ecs_fs_system_state_new(1, 2, 3);
    let s2 = ecs_fs_system_state_get_mut(s, 55);
    let m = ecs_fs_system_state_get(s2);
    let cv0 = m.1;
    if cv0 != 55 { panic(90493); };
}

@test "system_state_apply"() {
    let s = ecs_fs_system_state_new(1, 2, 3);
    let s2 = ecs_fs_system_state_apply(s, 77);
    let m = ecs_fs_system_state_get(s2);
    let cv0 = m.1;
    if cv0 != 77 { panic(90494); };
}

@test "system_state_matches_world"() {
    let s = ecs_fs_system_state_new(1, 42, 3);
    if ecs_fs_system_state_matches_world(s, 42) != true { panic(90495); };
    if ecs_fs_system_state_matches_world(s, 99) != false { panic(90496); };
}

@test "system_state_meta_mut"() {
    let s = ecs_fs_system_state_new(1, 2, 10);
    let s2 = ecs_fs_system_state_meta_mut(s, 99, 25);
    let mm = ecs_fs_system_state_meta(s2, 0);
    let mtick = mm.1;
    if mtick != 25 { panic(90497); };
}

@test "system_state_param_state"() {
    let s = ecs_fs_system_state_new(123, 1, 1);
    if ecs_fs_system_state_param_state(s) != 123 { panic(90498); };
}

@test "fs_v2_new_defaults"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    if ecs_fs_function_system_v2_name(fs) != 11 { panic(90499); };
    if ecs_fs_function_system_v2_last_run(fs) != 5 { panic(90500); };
    if ecs_fs_function_system_v2_is_initialized(fs) != false { panic(90501); };
    if ecs_fs_function_system_v2_last_output(fs) != 0 { panic(90502); };
    if ecs_fs_function_system_v2_run_count(fs) != 0 { panic(90503); };
    if ecs_fs_function_system_v2_input(fs) != 0 { panic(90504); };
    if ecs_fs_function_system_v2_is_exclusive(fs) != false { panic(90505); };
    if ecs_fs_function_system_v2_is_non_send(fs) != false { panic(90506); };
}

@test "fs_v2_with_name"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_with_name(fs, 22);
    if ecs_fs_function_system_v2_name(fs2) != 22 { panic(90507); };
}

@test "fs_v2_initialize"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_initialize(fs);
    if ecs_fs_function_system_v2_is_initialized(fs2) != true { panic(90508); };
}

@test "fs_v2_run"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_run(fs, 42);
    if ecs_fs_function_system_v2_last_output(fs2) != 42 { panic(90509); };
    if ecs_fs_function_system_v2_run_count(fs2) != 1 { panic(90510); };
    let fs3 = ecs_fs_function_system_v2_run(fs2, 99);
    if ecs_fs_function_system_v2_run_count(fs3) != 2 { panic(90511); };
    if ecs_fs_function_system_v2_last_output(fs3) != 99 { panic(90512); };
}

@test "fs_v2_with_input"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_with_input(fs, 77);
    if ecs_fs_function_system_v2_input(fs2) != 77 { panic(90513); };
}

@test "fs_v2_set_exclusive"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_set_exclusive(fs);
    if ecs_fs_function_system_v2_is_exclusive(fs2) != true { panic(90514); };
}

@test "fs_v2_set_non_send"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_set_non_send(fs);
    if ecs_fs_function_system_v2_is_non_send(fs2) != true { panic(90515); };
}

@test "fs_v2_set_last_run"() {
    let fs = ecs_fs_function_system_v2_new(11, 5);
    let fs2 = ecs_fs_function_system_v2_set_last_run(fs, 88);
    if ecs_fs_function_system_v2_last_run(fs2) != 88 { panic(90516); };
}

@test "fs_v2_build_system"() {
    let s = ecs_fs_system_state_new(1, 42, 10);
    let fs = ecs_fs_build_system(s, 5);
    if ecs_fs_function_system_v2_name(fs) != 5 { panic(90517); };
    if ecs_fs_function_system_v2_last_run(fs) != 10 { panic(90518); };
}

@test "fs_v2_build_system_with_input"() {
    let s = ecs_fs_system_state_new(1, 42, 10);
    let fs = ecs_fs_build_system_with_input(s, 5, 99);
    if ecs_fs_function_system_v2_name(fs) != 5 { panic(90519); };
    if ecs_fs_function_system_v2_input(fs) != 99 { panic(90520); };
}

@test "fs_v2_build_any_system"() {
    let s = ecs_fs_system_state_new(1, 42, 10);
    let fs = ecs_fs_build_any_system(s, 7);
    if ecs_fs_function_system_v2_name(fs) != 7 { panic(90521); };
}

@test "fs_v2_full_lifecycle"() {
    let fs = ecs_fs_function_system_v2_new(1, 0);
    let fs2 = ecs_fs_function_system_v2_initialize(fs);
    if ecs_fs_function_system_v2_is_initialized(fs2) != true { panic(90522); };
    let fs3 = ecs_fs_function_system_v2_run(fs2, 42);
    if ecs_fs_function_system_v2_run_count(fs3) != 1 { panic(90523); };
    let fs4 = ecs_fs_function_system_v2_run(fs3, 84);
    if ecs_fs_function_system_v2_run_count(fs4) != 2 { panic(90524); };
    if ecs_fs_function_system_v2_last_output(fs4) != 84 { panic(90525); };
    let fs5 = ecs_fs_function_system_v2_with_input(fs4, 100);
    if ecs_fs_function_system_v2_input(fs5) != 100 { panic(90526); };
    let fs6 = ecs_fs_function_system_v2_set_exclusive(fs5);
    if ecs_fs_function_system_v2_is_exclusive(fs6) != true { panic(90527); };
    let fs7 = ecs_fs_function_system_v2_set_non_send(fs6);
    if ecs_fs_function_system_v2_is_non_send(fs7) != true { panic(90528); };
    let fs8 = ecs_fs_function_system_v2_set_last_run(fs7, 33);
    if ecs_fs_function_system_v2_last_run(fs8) != 33 { panic(90529); };
}

@test "fs_v2_with_name_then_run"() {
    let fs = ecs_fs_function_system_v2_new(1, 0);
    let fs2 = ecs_fs_function_system_v2_with_name(fs, 999);
    if ecs_fs_function_system_v2_name(fs2) != 999 { panic(90530); };
    let fs3 = ecs_fs_function_system_v2_run(fs2, 55);
    if ecs_fs_function_system_v2_last_output(fs3) != 55 { panic(90531); };
}

@test "is_function_system_new"() {
    let _m = ecs_fs_is_function_system_new();
    let n = 0;
    if n != 0 { panic(90532); };
}

@test "has_system_input_new"() {
    let _m = ecs_fs_has_system_input_new();
    let n = 0;
    if n != 0 { panic(90533); };
}
