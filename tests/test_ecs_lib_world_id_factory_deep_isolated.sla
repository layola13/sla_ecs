@import "lib/world_id_factory_deep.sla"

// Batch 317: world_id_factory deep.
// panic codes: 129400 – 129599.

@test "default_factory"() {
    let f = ecs_widf_deep_new();
    if ecs_widf_deep_next(f) != 0 { panic(129400); };
    if ecs_widf_deep_is_exhausted(f) != false { panic(129401); };
}

@test "mint_monotonic"() {
    let f = ecs_widf_deep_new();
    let r1 = ecs_widf_deep_mint(f);
    if ecs_wid_new_has(r1) != true { panic(129410); };
    if ecs_wid_new_value(r1) != 0 { panic(129411); };
    let r2 = ecs_widf_deep_mint(ecs_wid_new_factory(r1));
    if ecs_wid_new_value(r2) != 1 { panic(129412); };
    if ecs_widf_deep_next(ecs_wid_new_factory(r2)) != 2 { panic(129413); };
}

@test "exhaustion"() {
    let f = ecs_widf_deep_with_cap(2);
    let r1 = ecs_widf_deep_mint(f);
    let r2 = ecs_widf_deep_mint(ecs_wid_new_factory(r1));
    let r3 = ecs_widf_deep_mint(ecs_wid_new_factory(r2));
    if ecs_wid_new_has(r3) != false { panic(129420); };
    if ecs_widf_deep_is_exhausted(ecs_wid_new_factory(r3)) != true { panic(129421); };
    let r4 = ecs_widf_deep_mint(ecs_wid_new_factory(r3));
    if ecs_wid_new_has(r4) != false { panic(129422); };
}

@test "cap_zero"() {
    let f = ecs_widf_deep_with_cap(0);
    let r = ecs_widf_deep_mint(f);
    if ecs_wid_new_has(r) != false { panic(129430); };
}

@test "embedded_id"() {
    let id = ecs_wid_deep_new(7);
    if ecs_wid_deep_value(id) != 7 { panic(129440); };
    if ecs_wid_deep_sparse_index(id) != 7 { panic(129441); };
}

@test "from_sparse_eq"() {
    let a = ecs_wid_deep_from_sparse(3);
    let b = ecs_wid_deep_new(3);
    let c = ecs_wid_deep_new(4);
    if ecs_wid_deep_eq(a, b) != true { panic(129450); };
    if ecs_wid_deep_eq(a, c) != false { panic(129451); };
}

@test "mint_many_ok"() {
    let f = ecs_widf_deep_with_cap(10);
    let b = ecs_widf_deep_mint_many(f, 3);
    if ecs_wid_batch_ok(b) != true { panic(129460); };
    if ecs_wid_batch_n(b) != 3 { panic(129461); };
    if ecs_wid_batch_at(b, 0) != 0 { panic(129462); };
    if ecs_wid_batch_at(b, 2) != 2 { panic(129463); };
}

@test "mint_many_partial"() {
    let f = ecs_widf_deep_with_cap(2);
    let b = ecs_widf_deep_mint_many(f, 4);
    if ecs_wid_batch_ok(b) != false { panic(129470); };
    if ecs_wid_batch_n(b) != 2 { panic(129471); };
}

@test "cap_accessor"() {
    let f = ecs_widf_deep_with_cap(5);
    if ecs_widf_deep_cap(f) != 5 { panic(129480); };
}

@test "factory_after_batch"() {
    let f = ecs_widf_deep_with_cap(10);
    let b = ecs_widf_deep_mint_many(f, 2);
    if ecs_widf_deep_next(ecs_wid_batch_factory(b)) != 2 { panic(129490); };
}
