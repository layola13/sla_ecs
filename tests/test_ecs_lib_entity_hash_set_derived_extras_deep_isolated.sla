@import "lib/entity_hash_set_derived_extras_deep.sla"

// Batch 335: entity_hash_set_derived_extras deep.
// panic codes: 133000 – 133199.

@test "constructors"() {
    let a = ecs_ehsd_new();
    let b = ecs_ehsd_default();
    let c = ecs_ehsd_with_capacity(5);
    if ecs_ehsd_kind(a) != 1 { panic(133000); };
    if ecs_ehsd_kind(b) != 2 { panic(133001); };
    if ecs_ehsd_kind(c) != 3 { panic(133002); };
    if ecs_ehsd_capacity(c) != 5 { panic(133003); };
}

@test "insert_contains"() {
    let s = ecs_ehsd_new();
    let r = ecs_ehsd_insert(s, 1);
    if ecs_ehsd_ins_inserted(r) != true { panic(133010); };
    s = ecs_ehsd_ins_set(r);
    let r2 = ecs_ehsd_insert(s, 1);
    if ecs_ehsd_ins_inserted(r2) != false { panic(133011); };
    if ecs_ehsd_contains(s, 1) != true { panic(133012); };
}

@test "clone_and_from"() {
    let s = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 3));
    let c = ecs_ehsd_clone(s);
    if ecs_ehsd_kind(c) != 4 { panic(133020); };
    let f = ecs_ehsd_from_hash_set(s);
    if ecs_ehsd_kind(f) != 6 { panic(133021); };
    if ecs_ehsd_contains(f, 3) != true { panic(133022); };
}

@test "eq"() {
    let a = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 1)), 2));
    let b = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 2)), 1));
    if ecs_ehsd_eq(a, b) != true { panic(133030); };
    let c = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 1));
    if ecs_ehsd_eq(a, c) != false { panic(133031); };
}

@test "union_intersection"() {
    let a = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 1)), 2));
    let b = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 2)), 3));
    let u = ecs_ehsd_union(a, b);
    if ecs_ehsd_len(u) != 3 { panic(133040); };
    let i = ecs_ehsd_intersection(a, b);
    if ecs_ehsd_len(i) != 1 { panic(133041); };
    if ecs_ehsd_contains(i, 2) != true { panic(133042); };
}

@test "iter_next"() {
    let s = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 4)), 5));
    let it = ecs_ehsd_iter(s);
    if ecs_ehsd_iter_remaining(it) != 2 { panic(133050); };
    if ecs_ehsd_iter_debug(it) != 10 { panic(133051); };
    let n1 = ecs_ehsd_iter_next(it);
    if ecs_ehsd_next_value(n1) != 4 { panic(133052); };
    let n2 = ecs_ehsd_iter_next(ecs_ehsd_next_iter(n1));
    if ecs_ehsd_next_value(n2) != 5 { panic(133053); };
}

@test "capacity_eight"() {
    let s = ecs_ehsd_new();
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 1));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 2));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 3));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 4));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 5));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 6));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 7));
    s = ecs_ehsd_ins_set(ecs_ehsd_insert(s, 8));
    if ecs_ehsd_len(s) != 8 { panic(133060); };
    let r = ecs_ehsd_insert(s, 9);
    if ecs_ehsd_ins_inserted(r) != false { panic(133061); };
}

@test "at_access"() {
    let s = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 10)), 20));
    if ecs_ehsd_at(s, 0) != 10 { panic(133070); };
    if ecs_ehsd_at(s, 1) != 20 { panic(133071); };
}

@test "empty"() {
    let s = ecs_ehsd_new();
    if ecs_ehsd_is_empty(s) != true { panic(133080); };
}

@test "iter_end"() {
    let s = ecs_ehsd_ins_set(ecs_ehsd_insert(ecs_ehsd_new(), 1));
    let n1 = ecs_ehsd_iter_next(ecs_ehsd_iter(s));
    let n2 = ecs_ehsd_iter_next(ecs_ehsd_next_iter(n1));
    if ecs_ehsd_next_has(n2) != false { panic(133090); };
}
