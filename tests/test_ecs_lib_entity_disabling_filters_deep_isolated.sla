@import "lib/entity_disabling_filters_deep.sla"

// Batch 307: entity_disabling_filters deep.
// panic codes: 127400 – 127599.

@test "disabled_marker"() {
    let d = ecs_edf_disabled_new(17);
    if ecs_edf_disabled_id(d) != 17 { panic(127400); };
}

@test "empty_filters"() {
    let f = ecs_edf_deep_empty();
    if ecs_edf_deep_is_empty(f) != true { panic(127410); };
    if ecs_edf_deep_len(f) != 0 { panic(127411); };
    if ecs_edf_deep_passes(f, 1, 2, 0, 0, 2) != true { panic(127412); };
}

@test "register_and_is_disabling"() {
    let f = ecs_edf_deep_empty();
    f = ecs_edf_deep_register(f, 5);
    f = ecs_edf_deep_register(f, 6);
    if ecs_edf_deep_len(f) != 2 { panic(127420); };
    if ecs_edf_deep_is_disabling(f, 5) != true { panic(127421); };
    if ecs_edf_deep_is_disabling(f, 7) != false { panic(127422); };
}

@test "register_dedup"() {
    let f = ecs_edf_deep_register(ecs_edf_deep_empty(), 3);
    f = ecs_edf_deep_register(f, 3);
    if ecs_edf_deep_len(f) != 1 { panic(127430); };
    if ecs_edf_deep_at(f, 0) != 3 { panic(127431); };
}

@test "entity_disabled"() {
    let f = ecs_edf_deep_register(ecs_edf_deep_empty(), 9);
    if ecs_edf_deep_entity_disabled(f, 1, 9, 0, 0, 2) != true { panic(127440); };
    if ecs_edf_deep_entity_disabled(f, 1, 2, 0, 0, 2) != false { panic(127441); };
}

@test "passes_when_not_disabled"() {
    let f = ecs_edf_deep_register(ecs_edf_deep_empty(), 4);
    if ecs_edf_deep_passes(f, 1, 2, 0, 0, 2) != true { panic(127450); };
    if ecs_edf_deep_passes(f, 4, 2, 0, 0, 2) != false { panic(127451); };
}

@test "capacity_four"() {
    let f = ecs_edf_deep_empty();
    f = ecs_edf_deep_register(f, 1);
    f = ecs_edf_deep_register(f, 2);
    f = ecs_edf_deep_register(f, 3);
    f = ecs_edf_deep_register(f, 4);
    if ecs_edf_deep_len(f) != 4 { panic(127460); };
    f = ecs_edf_deep_register(f, 5);
    if ecs_edf_deep_len(f) != 4 { panic(127461); };
    if ecs_edf_deep_is_disabling(f, 4) != true { panic(127462); };
    if ecs_edf_deep_is_disabling(f, 5) != false { panic(127463); };
}

@test "count_passing_empty_filters"() {
    let f = ecs_edf_deep_empty();
    if ecs_edf_deep_count_passing(f, true, true, false, false, 4) != 4 { panic(127470); };
}

@test "count_passing_with_filters"() {
    let f = ecs_edf_deep_register(ecs_edf_deep_empty(), 1);
    if ecs_edf_deep_count_passing(f, true, false, true, false, 4) != 2 { panic(127480); };
    if ecs_edf_deep_count_passing(f, false, false, false, false, 3) != 3 { panic(127481); };
}

@test "clear"() {
    let f = ecs_edf_deep_register(ecs_edf_deep_register(ecs_edf_deep_empty(), 1), 2);
    f = ecs_edf_deep_clear(f);
    if ecs_edf_deep_is_empty(f) != true { panic(127490); };
    if ecs_edf_deep_is_disabling(f, 1) != false { panic(127491); };
}
