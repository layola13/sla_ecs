@import "lib/entity_index_map_derived_extras.sla"

// Isolated tests for lib/entity_index_map_derived_extras.sla.
// Bevy reference: bevy_ecs/src/entity/index_map.rs derived wrappers and mutable iterator traits.

fn make_eim4_entries() -> Vec<EcsEim4Pair> {
    let entries: Vec<EcsEim4Pair> = Vec::new();
    entries.push(ecs_eim4_pair(1, 10));
    entries.push(ecs_eim4_pair(2, 20));
    entries.push(ecs_eim4_pair(1, 15));
    entries.push(ecs_eim4_pair(3, 30));
    return entries;
}

fn make_eim4_map() -> EcsEim4Map {
    return ecs_eim4_from_iter(make_eim4_entries());
}

@test "entity index map derived extras new default capacity markers"() {
    let fresh = ecs_eim4_new();
    let defaulted = ecs_eim4_default();
    let capped = ecs_eim4_with_capacity(9);
    let clamped = ecs_eim4_with_capacity(-2);
    if ecs_eim4_len(fresh) != 0 { panic(92775); };
    if ecs_eim4_debug_kind(fresh) != 1 { panic(92776); };
    if ecs_eim4_debug_kind(defaulted) != 2 { panic(92777); };
    if capped.capacity_hint != 9 { panic(92778); };
    if clamped.capacity_hint != 0 { panic(92779); };
}

@test "entity index map derived extras clone preserves value and capacity"() {
    let map = ecs_eim4_with_capacity(5);
    let inserted = ecs_eim4_insert(map, 7, 70);
    let cloned = ecs_eim4_clone(inserted.map);
    let found = ecs_eim4_get(cloned, 7);
    if ecs_eim4_debug_kind(cloned) != 4 { panic(92780); };
    if cloned.capacity_hint != 5 { panic(92781); };
    if found.value != 70 { panic(92782); };
}

@test "entity index map derived extras extend owned replaces duplicates"() {
    let map = ecs_eim4_extend_owned(ecs_eim4_new(), make_eim4_entries());
    let first = ecs_eim4_get(map, 1);
    if ecs_eim4_len(map) != 3 { panic(92783); };
    if first.value != 15 { panic(92784); };
}

@test "entity index map derived extras extend refs appends and replaces"() {
    let refs: Vec<EcsEim4Pair> = Vec::new();
    refs.push(ecs_eim4_pair(2, 22));
    refs.push(ecs_eim4_pair(4, 40));
    let map = ecs_eim4_extend_refs(make_eim4_map(), refs);
    let replaced = ecs_eim4_get(map, 2);
    let appended = ecs_eim4_get(map, 4);
    if ecs_eim4_len(map) != 4 { panic(92785); };
    if replaced.value != 22 { panic(92786); };
    if appended.value != 40 { panic(92787); };
}

@test "entity index map derived extras from array capacity marker"() {
    let map = ecs_eim4_from_array4(5, 50, 6, 60, 5, 55, 7, 70);
    let replaced = ecs_eim4_get(map, 5);
    if ecs_eim4_len(map) != 3 { panic(92788); };
    if map.capacity_hint != 4 { panic(92789); };
    if ecs_eim4_debug_kind(map) != 5 { panic(92790); };
    if replaced.value != 55 { panic(92791); };
}

@test "entity index map derived extras eq inner ignores order"() {
    let inner: Vec<EcsEim4Pair> = Vec::new();
    inner.push(ecs_eim4_pair(3, 30));
    inner.push(ecs_eim4_pair(1, 15));
    inner.push(ecs_eim4_pair(2, 20));
    if ecs_eim4_eq_inner(make_eim4_map(), inner) != true { panic(92792); };
}

@test "entity index map derived extras eq inner detects value mismatch"() {
    let inner: Vec<EcsEim4Pair> = Vec::new();
    inner.push(ecs_eim4_pair(1, 15));
    inner.push(ecs_eim4_pair(2, 99));
    inner.push(ecs_eim4_pair(3, 30));
    if ecs_eim4_eq_inner(make_eim4_map(), inner) != false { panic(92793); };
}

@test "entity index map derived extras mutable slice markers"() {
    let slice = ecs_eim4_as_mut_slice(make_eim4_map());
    let ranged = ecs_eim4_slice_range_mut(slice, 1, 3);
    let inner = ecs_eim4_slice_as_inner(ranged.slice);
    if ranged.has != 1 { panic(92794); };
    if ecs_eim4_slice_len(inner) != 2 { panic(92795); };
    if inner.mutable_view != 1 { panic(92796); };
    if inner.inner_view != 1 { panic(92797); };
}

@test "entity index map derived extras first last mut updates"() {
    let slice = ecs_eim4_as_mut_slice(make_eim4_map());
    let first_set = ecs_eim4_slice_set_first(slice, 101);
    let last_set = ecs_eim4_slice_set_last(first_set, 303);
    let first = ecs_eim4_slice_range_mut(last_set, 0, 1);
    let last = ecs_eim4_slice_range_mut(last_set, 2, 3);
    if first.slice.entries[0].value != 101 { panic(92798); };
    if last.slice.entries[0].value != 303 { panic(92799); };
}

@test "entity index map derived extras split at mut"() {
    let split = ecs_eim4_slice_split_at_mut(ecs_eim4_as_mut_slice(make_eim4_map()), 2);
    if ecs_eim4_slice_len(split.left) != 2 { panic(92800); };
    if ecs_eim4_slice_len(split.right) != 1 { panic(92801); };
    if split.left.mutable_view != 1 { panic(92802); };
    if split.right.mutable_view != 1 { panic(92803); };
}

@test "entity index map derived extras iter size hint tracks next"() {
    let iter = ecs_eim4_iter(make_eim4_map());
    let hint = ecs_eim4_size_hint(iter);
    let next = ecs_eim4_iter_next(iter);
    let after = ecs_eim4_size_hint(next.iter);
    if hint.lower != 3 { panic(92804); };
    if next.key != 1 { panic(92805); };
    if next.value != 15 { panic(92806); };
    if after.lower != 2 { panic(92807); };
}

@test "entity index map derived extras iterator debug markers"() {
    let iter = ecs_eim4_iter(make_eim4_map());
    let iter_mut = ecs_eim4_iter_mut(make_eim4_map());
    let owned = ecs_eim4_into_iter(make_eim4_map());
    let drained = ecs_eim4_drain(make_eim4_map(), 1, 3);
    let keys = ecs_eim4_keys(make_eim4_map());
    let into_keys = ecs_eim4_into_keys(make_eim4_map());
    let values = ecs_eim4_into_values(make_eim4_map());
    if ecs_eim4_iter_debug_kind(iter) != 10 { panic(92808); };
    if ecs_eim4_iter_debug_kind(iter_mut) != 11 { panic(92809); };
    if ecs_eim4_iter_debug_kind(owned) != 20 { panic(92810); };
    if ecs_eim4_iter_debug_kind(drained.drain) != 30 { panic(92811); };
    if keys.trusted_unique != 1 { panic(92812); };
    if into_keys.debug_kind != 50 { panic(92813); };
    if values.debug_kind != 60 { panic(92814); };
}

@test "entity index map derived extras keys and values iterators"() {
    let key_result = ecs_eim4_key_next(ecs_eim4_keys(make_eim4_map()));
    let value_result = ecs_eim4_value_next(ecs_eim4_into_values(make_eim4_map()));
    if key_result.key != 1 { panic(92815); };
    if value_result.value != 15 { panic(92816); };
}

@test "entity index map derived extras drain next back and kept"() {
    let result = ecs_eim4_drain(make_eim4_map(), 1, 3);
    let back = ecs_eim4_iter_next_back(result.drain);
    if ecs_eim4_len(result.map) != 1 { panic(92817); };
    if back.key != 3 { panic(92818); };
    if back.value != 30 { panic(92819); };
}

@test "entity index map derived extras exhausted iterators"() {
    let empty = ecs_eim4_iter(ecs_eim4_new());
    let next = ecs_eim4_iter_next(empty);
    if next.has != 0 { panic(92820); };
}
