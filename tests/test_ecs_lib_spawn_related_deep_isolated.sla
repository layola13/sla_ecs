@import "lib/spawn_related_deep.sla"

// Batch 226: spawn related deep (src/spawn.rs).
// panic codes: 111200 – 111399.

@test "spawn_size_hint_one"() {
    let s = ecs_spawn_new(5);
    if ecs_spawn_bundle(s) != 5 { panic(111200); };
    if ecs_spawn_size_hint(s) != 1 { panic(111201); };
}

@test "spawn_one_child"() {
    let w = ecs_spw_new(10);
    w = ecs_spawn_list_spawn_one(w, 1, 100);
    if ecs_spw_len(w) != 1 { panic(111210); };
    if ecs_spw_entity_at(w, 0) != 10 { panic(111211); };
    if ecs_spw_parent_at(w, 0) != 1 { panic(111212); };
    if ecs_spw_bundle_at(w, 0) != 100 { panic(111213); };
    if ecs_spw_next(w) != 11 { panic(111214); };
}

@test "spawn_iter_multiple"() {
    let w = ecs_spw_new(1);
    let it = ecs_spawn_iter_new();
    it = ecs_spawn_iter_push(it, 10);
    it = ecs_spawn_iter_push(it, 20);
    it = ecs_spawn_iter_push(it, 30);
    if ecs_spawn_iter_size_hint(it) != 3 { panic(111220); };
    w = ecs_spawn_iter_spawn(w, 99, it);
    if ecs_spw_len(w) != 3 { panic(111221); };
    if ecs_spw_reserve_hints(w) != 3 { panic(111222); };
    if ecs_spw_parent_at(w, 0) != 99 { panic(111223); };
    if ecs_spw_bundle_at(w, 1) != 20 { panic(111224); };
    if ecs_spw_count_children(w, 99) != 3 { panic(111225); };
}

@test "spawn_with_func"() {
    let w = ecs_spw_new(5);
    w = ecs_spawn_with(w, 2, 3);
    // bundle = 3*10+2 = 32
    if ecs_spw_bundle_at(w, 0) != 32 { panic(111230); };
    if ecs_spw_parent_at(w, 0) != 2 { panic(111231); };
}

@test "with_related_existing"() {
    let w = ecs_spw_new(100);
    let rel = ecs_with_related_new();
    rel = ecs_with_related_push(rel, 7);
    rel = ecs_with_related_push(rel, 8);
    if ecs_with_related_size_hint(rel) != 2 { panic(111240); };
    w = ecs_with_related_spawn(w, 1, rel);
    if ecs_spw_len(w) != 2 { panic(111241); };
    if ecs_spw_entity_at(w, 0) != 7 { panic(111242); };
    if ecs_spw_bundle_at(w, 0) != -1 { panic(111243); };
    if ecs_spw_reserve_hints(w) != 2 { panic(111244); };
}

@test "with_one_related"() {
    let w = ecs_spw_new(1);
    w = ecs_with_one_related(w, 5, 42);
    if ecs_spw_entity_at(w, 0) != 42 { panic(111250); };
    if ecs_spw_parent_at(w, 0) != 5 { panic(111251); };
}

@test "two_parents_independent_children"() {
    let w = ecs_spw_new(1);
    w = ecs_spawn_list_spawn_one(w, 10, 1);
    w = ecs_spawn_list_spawn_one(w, 20, 2);
    w = ecs_spawn_list_spawn_one(w, 10, 3);
    if ecs_spw_count_children(w, 10) != 2 { panic(111260); };
    if ecs_spw_count_children(w, 20) != 1 { panic(111261); };
}

@test "spawn_iter_empty"() {
    let w = ecs_spw_new(1);
    let it = ecs_spawn_iter_new();
    w = ecs_spawn_iter_spawn(w, 1, it);
    if ecs_spw_len(w) != 0 { panic(111270); };
    if ecs_spw_reserve_hints(w) != 0 { panic(111271); };
}
