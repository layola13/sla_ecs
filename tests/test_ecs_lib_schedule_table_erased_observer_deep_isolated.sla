// Isolated deep tests for lib/schedule_table_erased_observer_deep.sla (Batch 398).
// Mirrors erased observer schedule batching without fn-pointers or runtime world erasure.
// panic codes: 144200 - 144272 (Batch 398 band; previous Batch 397 used 144100-144172).

@import "lib/schedule_table_erased_observer_deep.sla"

@test "EcsStoSchedule runs non-conflicting systems in one batch"() {
    let w0 = ecs_sto_world_new(4, 6, 3);
    let move_access0 = ecs_sto_access_none();
    let move_access1 = ecs_sto_access_write_component(move_access0, 1);
    let move_access = ecs_sto_access_read_component(move_access1, 2);
    let obs_access0 = ecs_sto_access_none();
    let obs_access1 = ecs_sto_access_read_event(obs_access0, 1);
    let obs_access = ecs_sto_access_write_resource(obs_access1);
    let msg_access0 = ecs_sto_access_none();
    let msg_access = ecs_sto_access_write_messages(msg_access0);
    let s0 = ecs_sto_schedule_default();
    let s1 = ecs_sto_schedule_add_system(s0, ECS_STO_SYS_MOVE, move_access);
    let s2 = ecs_sto_schedule_add_system(s1, ECS_STO_SYS_OBS_COUNT, obs_access);
    let s3 = ecs_sto_schedule_add_system(s2, ECS_STO_SYS_MESSAGE, msg_access);
    if ecs_sto_schedule_conflict_count(s3) != 0 { panic(144200); };
    if ecs_sto_schedule_batch_count(s3) != 1 { panic(144201); };
    if ecs_sto_schedule_max_parallel_width(s3) != 3 { panic(144202); };
    let w1 = ecs_sto_schedule_run(s3, w0);
    if ecs_sto_world_change_tick(w1) != 2 { panic(144203); };
    if ecs_sto_world_pos_x(w1) != 10 { panic(144204); };
    if ecs_sto_world_resource_tick(w1) != 3 { panic(144205); };
    if ecs_sto_world_message_count(w1) != 1 { panic(144206); };
    if ecs_sto_world_last_message(w1) != 2 { panic(144207); };
}

@test "EcsStoSchedule records event conflicts and batches"() {
    let read_evt0 = ecs_sto_access_none();
    let read_evt = ecs_sto_access_read_event(read_evt0, 1);
    let write_evt0 = ecs_sto_access_none();
    let write_evt = ecs_sto_access_write_event(write_evt0, 1);
    let msg0 = ecs_sto_access_none();
    let msg = ecs_sto_access_write_messages(msg0);
    let s0 = ecs_sto_schedule_default();
    let s1 = ecs_sto_schedule_add_system(s0, ECS_STO_SYS_OBS_COUNT, read_evt);
    let s2 = ecs_sto_schedule_add_system(s1, ECS_STO_SYS_TRIGGER_PING, write_evt);
    let s3 = ecs_sto_schedule_add_system(s2, ECS_STO_SYS_MESSAGE, msg);
    if ecs_sto_schedule_conflict_count(s3) != 1 { panic(144220); };
    if ecs_sto_schedule_batch_count(s3) != 2 { panic(144221); };
    if ecs_sto_schedule_system_batch(s3, 0) != 0 { panic(144222); };
    if ecs_sto_schedule_system_batch(s3, 1) != 1 { panic(144223); };
    if ecs_sto_schedule_system_batch(s3, 2) != 0 { panic(144224); };
    if ecs_sto_schedule_batch_width(s3, 0) != 2 { panic(144225); };
    if ecs_sto_schedule_max_parallel_width(s3) != 2 { panic(144226); };
}

@test "EcsStoSchedule planned run honors type access declarations"() {
    let w0 = ecs_sto_world_new(1, 2, 0);
    let move_access0 = ecs_sto_access_none();
    let move_access1 = ecs_sto_access_write_type(move_access0, 401);
    let move_access = ecs_sto_access_read_type(move_access1, 402);
    let trigger_access0 = ecs_sto_access_none();
    let trigger_access = ecs_sto_access_write_event(trigger_access0, 1);
    let s0 = ecs_sto_schedule_default();
    let s1 = ecs_sto_schedule_add_system(s0, ECS_STO_SYS_MOVE, move_access);
    let s2 = ecs_sto_schedule_add_system(s1, ECS_STO_SYS_TRIGGER_PING, trigger_access);
    if ecs_sto_schedule_batch_count(s2) != 1 { panic(144240); };
    let w1 = ecs_sto_schedule_run_planned(s2, w0);
    if ecs_sto_world_pos_x(w1) != 3 { panic(144241); };
    if ecs_sto_world_observer_count(w1) != 1 { panic(144242); };
    if ecs_sto_world_observed(w1) != 1 { panic(144243); };
}

@test "EcsStoAccess detects resource and message conflicts"() {
    let rr0 = ecs_sto_access_none();
    let rr = ecs_sto_access_read_resource(rr0);
    let wr0 = ecs_sto_access_none();
    let wr = ecs_sto_access_write_resource(wr0);
    let rm0 = ecs_sto_access_none();
    let rm = ecs_sto_access_read_messages(rm0);
    let wm0 = ecs_sto_access_none();
    let wm = ecs_sto_access_write_messages(wm0);
    let plain = ecs_sto_access_none();
    if ecs_sto_access_conflicts(rr, wr) != true { panic(144250); };
    if ecs_sto_access_conflicts(wr, rr) != true { panic(144251); };
    if ecs_sto_access_conflicts(rm, wm) != true { panic(144252); };
    if ecs_sto_access_conflicts(wm, rm) != true { panic(144253); };
    if ecs_sto_access_conflicts(rr, wm) != false { panic(144254); };
    if ecs_sto_access_conflicts(plain, wm) != false { panic(144255); };
}

@test "EcsStoSchedule out of range accessors return sentinels"() {
    let a = ecs_sto_access_none();
    let s0 = ecs_sto_schedule_default();
    let s1 = ecs_sto_schedule_add_system(s0, ECS_STO_SYS_MESSAGE, a);
    if ecs_sto_schedule_system_batch(s1, -1) != -1 { panic(144260); };
    if ecs_sto_schedule_system_batch(s1, 1) != -1 { panic(144261); };
    if ecs_sto_schedule_kind_at(s1, -1) != -1 { panic(144262); };
    if ecs_sto_schedule_kind_at(s1, 1) != -1 { panic(144263); };
}

@test "EcsStoSchedule fixed cap ignores ninth system"() {
    let a = ecs_sto_access_none();
    let s = ecs_sto_schedule_default();
    let i: i32 = 0;
    while i < 8 {
        s = ecs_sto_schedule_add_system(s, ECS_STO_SYS_MESSAGE, a);
        i = i + 1;
    }
    if ecs_sto_schedule_batch_width(s, 0) != 8 { panic(144270); };
    let overflow = ecs_sto_schedule_add_system(s, ECS_STO_SYS_MESSAGE, a);
    if ecs_sto_schedule_batch_width(overflow, 0) != 8 { panic(144271); };
    if ecs_sto_schedule_kind_at(overflow, 8) != -1 { panic(144272); };
}
