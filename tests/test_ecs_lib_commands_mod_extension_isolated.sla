@test "ecmd_ext_observe"() {
    let s = EcsEntityCmdExtState_new(18, true);
    let r = ecs_ecmd_ext_observe(s, 42);
    let r0 = r.0;
    if r.1 != true { panic(90399); };
    if r0.pending_observes != 1 { panic(90400); };
    if r0.last_event != 42 { panic(90401); };
}

@test "ecmd_ext_trigger"() {
    let s = EcsEntityCmdExtState_new(19, true);
    let r = ecs_ecmd_ext_trigger(s, 5);
    let r0 = r.0;
    if r.1 != 5 { panic(90402); };
    if r0.last_event != 5 { panic(90403); };
