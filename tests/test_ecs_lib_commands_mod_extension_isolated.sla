}

@test "ecmd_ext_new"() {
    let s = EcsEntityCmdExtState_new(10, true);
    if ecs_ecmd_ext_id(s) != 10 { panic(90385); };
    if ecs_ecmd_ext_is_spawned(s) != true { panic(90386); };
    if ecs_ecmd_ext_get_pending(s) != 0 { panic(90387); };
    if ecs_ecmd_ext_cloned_to(s) != -1 { panic(90388); };
}

@test "ecmd_ext_reborrow"() {
    let s = EcsEntityCmdExtState_new(11, true);
    let s2 = ecs_ecmd_ext_reborrow(s);
    if ecs_ecmd_ext_entity(s2) != 11 { panic(90389); };
}

@test "ecmd_ext_entry"() {
    let s = EcsEntityCmdExtState_new(12, true);
    let r = ecs_ecmd_ext_entry(s, 7);
    let r0 = r.0;
    if r.1 != 7 { panic(90390); };
    if r0.pending_commands != 1 { panic(90391); };
}

