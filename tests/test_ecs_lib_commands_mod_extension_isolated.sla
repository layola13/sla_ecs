@test "ecmd_ext_log_components"() {
    let s = EcsEntityCmdExtState_new(15, true);
    let comps = Vec::new();
    comps.push(1);
    comps.push(2);
    comps.push(3);
    let r = ecs_ecmd_ext_log_components(s, comps);
    if r.1 != 3 { panic(90396); };
}

@test "ecmd_ext_commands"() {
