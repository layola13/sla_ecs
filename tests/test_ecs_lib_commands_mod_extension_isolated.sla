@import "lib/commands_mod_extension.sla"

// Isolated tests for lib/commands_mod_extension.sla — Commands + EntityCommands extension methods
// Bevy reference: src/system/commands/mod.rs (extension methods)

@test "cmd_ext_new"() {
    let s = EcsCmdExtCurState_new();
    if s.last_system_id != 0 { panic(90354); };
    if s.last_cwd_queue_len != 0 { panic(90355); };
}

@test "cmd_ext_new_from_entities"() {
    let s = ecs_commands_ext_new_from_entities(42);
    if s.last_observed_entity != 42 { panic(90356); };
}

@test "cmd_ext_get_spawned_entity_negative"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_get_spawned_entity(s, -1);
    if r.2 != true { panic(90357); };   // is_spawn_request
    if r.3 != false { panic(90358); };  // was_found
    if r.1 != -1 { panic(90359); };
}

@test "cmd_ext_get_spawned_entity_positive"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_get_spawned_entity(s, 99);
    if r.2 != false { panic(90360); };
    if r.3 != true { panic(90361); };
    if r.1 != 99 { panic(90362); };
}

@test "cmd_ext_rebound_to"() {
    let s = EcsCmdExtCurState_new();
    let s2 = ecs_commands_ext_rebound_to(s);
    if s2.last_system_id != 0 { panic(90363); };
}

@test "cmd_ext_reborrow"() {
    let s = EcsCmdExtCurState_new();
    let s2 = ecs_commands_ext_reborrow(s);
    if s2.last_cwd_queue_len != 0 { panic(90364); };
}

@test "cmd_ext_register_boxed_system"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_register_boxed_system(s);
    if r.1 != 1 { panic(90365); };
    let r2 = ecs_commands_ext_register_boxed_system(r.0);
    if r2.1 != 2 { panic(90366); };
}

@test "cmd_ext_unregister_system_cached_found"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_register_boxed_system(s);
    let rr = ecs_commands_ext_unregister_system_cached(r.0, 1);
    if rr.1 != true { panic(90367); };
    if rr.2 != 1 { panic(90368); };
}

@test "cmd_ext_unregister_system_cached_missing"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_register_boxed_system(s);
    let rr = ecs_commands_ext_unregister_system_cached(r.0, 999);
    if rr.1 != false { panic(90369); };
}

@test "cmd_ext_run_system_cached_valid"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_register_boxed_system(s);
    let rr = ecs_commands_ext_run_system_cached(r.0, 1);
    if rr.1 != 1 { panic(90370); };
}

@test "cmd_ext_run_system_cached_invalid"() {
    let s = EcsCmdExtCurState_new();
    let rr = ecs_commands_ext_run_system_cached(s, 99);
    if rr.1 != -1 { panic(90371); };
}

@test "cmd_ext_run_system_cached_with"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_register_boxed_system(s);
    let rr = ecs_commands_ext_run_system_cached_with(r.0, 1, 42);
    if rr.1 != 1 { panic(90372); };
    if rr.2 != 42 { panic(90373); };
}

@test "cmd_ext_trigger"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_trigger(s, 5);
    let r0 = r.0;
    if r.1 != 5 { panic(90374); };
    if r0.last_cwd_queue_len != 1 { panic(90375); };
}

@test "cmd_ext_trigger_with"() {
    let s = EcsCmdExtCurState_new();
    let r = ecs_commands_ext_trigger_with(s, 6, 100);
    if r.1 != 6 { panic(90376); };
    let s2 = r.0;
    if s2.last_cwd_queue_len != 1 { panic(90377); };
}

