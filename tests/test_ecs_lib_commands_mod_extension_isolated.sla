@test "ecmd_ext_clone_with_opt_out"() {
    let s = EcsEntityCmdExtState_new(20, true);
    let excl = Vec::new();
    excl.push(1);
    excl.push(2);
    let r = ecs_ecmd_ext_clone_with_opt_out(s, 21, excl);
    let r0 = r.0;
    if r.1 != 2 { panic(90404); };
    if r0.cloned_to != 21 { panic(90405); };
}

@test "ecmd_ext_clone_with_opt_in"() {
    let s = EcsEntityCmdExtState_new(22, true);
    let incl = Vec::new();
    incl.push(1);
    incl.push(2);
    incl.push(3);
    let r = ecs_ecmd_ext_clone_with_opt_in(s, 23, incl);
    let r0 = r.0;
    if r.1 != 3 { panic(90406); };
    if r0.cloned_to != 23 { panic(90407); };
}

@test "ecmd_ext_clone_and_spawn"() {
    let s = EcsEntityCmdExtState_new(24, true);
    let r = ecs_ecmd_ext_clone_and_spawn(s, 25);
    let r0 = r.0;
    if r.1 != 25 { panic(90408); };
    if r.2 != true { panic(90409); };
    if r0.cloned_to != 25 { panic(90410); };
}

@test "ecmd_ext_clone_and_spawn_with_opt_out"() {
    let s = EcsEntityCmdExtState_new(26, true);
    let excl = Vec::new();
    excl.push(1);
    let r = ecs_ecmd_ext_clone_and_spawn_with_opt_out(s, 27, excl);
    let r0 = r.0;
    if r.1 != 1 { panic(90411); };
    if r0.cloned_to != 27 { panic(90412); };
}

@test "ecmd_ext_clone_and_spawn_with_opt_in"() {
    let s = EcsEntityCmdExtState_new(28, true);
    let incl = Vec::new();
    incl.push(1);
    incl.push(2);
    let r = ecs_ecmd_ext_clone_and_spawn_with_opt_in(s, 29, incl);
    let r0 = r.0;
    if r.1 != 2 { panic(90413); };
    if r0.cloned_to != 29 { panic(90414); };
}

@test "ecmd_ext_clone_components"() {
    let s = EcsEntityCmdExtState_new(30, true);
    let comps = Vec::new();
    comps.push(1);
    comps.push(2);
    comps.push(3);
    let r = ecs_ecmd_ext_clone_components(s, 31, comps);
    let r0 = r.0;
    if r.1 != 3 { panic(90415); };
    if r0.is_spawned != true { panic(90416); };
}

@test "ecmd_ext_move_components"() {
    let s = EcsEntityCmdExtState_new(32, true);
    let comps = Vec::new();
    comps.push(1);
    let r = ecs_ecmd_ext_move_components(s, 33, comps);
    let r0 = r.0;
    if r.1 != 1 { panic(90417); };
    if r.2 != true { panic(90418); };
    // move despawns source (sets is_spawned=false)
    if r0.is_spawned != false { panic(90419); };
    if r0.cloned_to != 33 { panic(90420); };
}
