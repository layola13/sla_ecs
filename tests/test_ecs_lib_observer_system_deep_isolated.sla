@import "lib/observer_system_deep.sla"

// Batch 281: observer_system deep (src/system/observer_system.rs).
// panic codes: 122200 – 122399.

@test "into_system_valid_on_first"() {
    let src = ecs_into_obs_sys_new(100, 7);
    if ecs_into_obs_sys_is_valid(src) != true { panic(122200); };
    let cr = ecs_into_obs_sys_into_system(src);
    if ecs_obs_sys_convert_ok(cr) != true { panic(122201); };
    let s = ecs_obs_sys_convert_system(cr);
    if ecs_obs_sys_name(s) != 100 { panic(122202); };
    if ecs_obs_sys_event_key(s) != 7 { panic(122203); };
    if ecs_obs_sys_is_observer_system(s) != true { panic(122204); };
}

@test "into_system_rejects_missing_on"() {
    let src = ecs_into_obs_sys_invalid_no_on(1);
    if ecs_into_obs_sys_is_valid(src) != true {
        // expected invalid
        let ok = true;
        if ok != true { panic(122210); };
    };
    if ecs_into_obs_sys_has_on_first(src) != false { panic(122211); };
    let cr = ecs_into_obs_sys_into_system(src);
    if ecs_obs_sys_convert_ok(cr) != false { panic(122212); };
}

@test "initialize_and_run"() {
    let src = ecs_into_obs_sys_new(5, 1);
    let cr = ecs_into_obs_sys_build(src);
    if ecs_obs_sys_convert_ok(cr) != true { panic(122220); };
    let s = ecs_obs_sys_convert_system(cr);
    if ecs_obs_sys_initialized(s) != true { panic(122221); };
    let onv = ecs_obs_sys_on_new(1, 42, 9);
    let rr = ecs_obs_sys_run(s, onv);
    if ecs_obs_sys_run_ok(rr) != true { panic(122222); };
    s = ecs_obs_sys_run_system(rr);
    if ecs_obs_sys_run_count(s) != 1 { panic(122223); };
    if ecs_obs_sys_last_payload(s) != 42 { panic(122224); };
}

@test "run_requires_initialize"() {
    let src = ecs_into_obs_sys_new(2, 0);
    let cr = ecs_into_obs_sys_into_system(src);
    let s = ecs_obs_sys_convert_system(cr);
    if ecs_obs_sys_initialized(s) != false { panic(122230); };
    let onv = ecs_obs_sys_on_new(0, 1, 1);
    let rr = ecs_obs_sys_run(s, onv);
    if ecs_obs_sys_run_ok(rr) != false { panic(122231); };
}

@test "event_key_filter"() {
    let src = ecs_into_obs_sys_new(3, 10);
    let cr = ecs_into_obs_sys_build(src);
    let s = ecs_obs_sys_convert_system(cr);
    let miss = ecs_obs_sys_on_new(11, 1, 1);
    let rr0 = ecs_obs_sys_run(s, miss);
    if ecs_obs_sys_run_ok(rr0) != false { panic(122240); };
    let hit = ecs_obs_sys_on_new(10, 5, 1);
    let rr1 = ecs_obs_sys_run(s, hit);
    if ecs_obs_sys_run_ok(rr1) != true { panic(122241); };
}

@test "pipe_no_input_second_stage"() {
    // Bevy: a(_: On<E>) {} ; b() {} ; a.pipe(b)
    let src = ecs_into_obs_sys_new(20, 1);
    let cr = ecs_into_obs_sys_build_piped(src, 21, false);
    if ecs_obs_sys_convert_ok(cr) != true { panic(122250); };
    let s = ecs_obs_sys_convert_system(cr);
    if ecs_obs_sys_has_pipe(s) != true { panic(122251); };
    let onv = ecs_obs_sys_on_new(1, 0, 1);
    let rr = ecs_obs_sys_run(s, onv);
    s = ecs_obs_sys_run_system(rr);
    if ecs_obs_sys_pipe_run_count(s) != 1 { panic(122252); };
    if ecs_obs_sys_last_pipe_in(s) != 0 { panic(122253); };
}

@test "pipe_with_input_from_out"() {
    // Bevy: a returns u32; b takes In<u32>
    let src = ecs_into_obs_sys_with_out(ecs_into_obs_sys_new(30, 2), 1, 3);
    let cr = ecs_into_obs_sys_build_piped(src, 31, true);
    let s = ecs_obs_sys_convert_system(cr);
    let onv = ecs_obs_sys_on_new(2, 99, 1);
    let rr = ecs_obs_sys_run(s, onv);
    if ecs_obs_sys_run_out(rr) != 3 { panic(122260); };
    s = ecs_obs_sys_run_system(rr);
    if ecs_obs_sys_last_pipe_in(s) != 3 { panic(122261); };
    if ecs_obs_sys_pipe_run_count(s) != 1 { panic(122262); };
}

@test "world_add_observer_and_trigger"() {
    let w = ecs_obs_sys_world_new();
    let src = ecs_into_obs_sys_new(40, 5);
    let ar = ecs_obs_sys_world_add_observer(w, src);
    if ecs_obs_sys_add_ok(ar) != true { panic(122270); };
    if ecs_obs_sys_add_entity(ar) != 1 { panic(122271); };
    w = ecs_obs_sys_add_world(ar);
    if ecs_obs_sys_world_count(w) != 1 { panic(122272); };
    let onv = ecs_obs_sys_on_new(5, 8, 1);
    let tr = ecs_obs_sys_world_trigger(w, onv);
    if ecs_obs_sys_trigger_fired(tr) != 1 { panic(122273); };
    w = ecs_obs_sys_trigger_world(tr);
    let s0 = ecs_obs_sys_world_system_at(w, 0);
    if ecs_obs_sys_run_count(s0) != 1 { panic(122274); };
    if ecs_obs_sys_last_payload(s0) != 8 { panic(122275); };
}

@test "on_with_target_and_meta"() {
    let onv = ecs_obs_sys_on_new(1, 2, 3);
    onv = ecs_obs_sys_on_with_target(onv, 99, 0x0f);
    if ecs_obs_sys_on_has_target(onv) != true { panic(122280); };
    if ecs_obs_sys_on_target(onv) != 99 { panic(122281); };
    if ecs_obs_sys_on_bundle_mask(onv) != 0x0f { panic(122282); };
    if ecs_obs_sys_on_observer(onv) != 3 { panic(122283); };
    let meta = ecs_obs_sys_meta_new(50);
    meta = ecs_obs_sys_meta_with_name(meta, 51);
    meta = ecs_obs_sys_meta_with_params(meta, 2);
    if ecs_obs_sys_meta_name(meta) != 51 { panic(122284); };
    if ecs_obs_sys_meta_param_count(meta) != 2 { panic(122285); };
    if ecs_obs_sys_meta_has_on_input(meta) != true { panic(122286); };
    if ecs_obs_sys_meta_deferred_only(meta) != true { panic(122287); };
}

@test "extra_params_and_multiple_observers"() {
    let src = ecs_into_obs_sys_with_params(ecs_into_obs_sys_new(60, 0), 3);
    if ecs_into_obs_sys_extra_params(src) != 3 { panic(122290); };
    let w = ecs_obs_sys_world_new();
    let ar0 = ecs_obs_sys_world_add_observer(w, src);
    w = ecs_obs_sys_add_world(ar0);
    let ar1 = ecs_obs_sys_world_add_observer(w, ecs_into_obs_sys_new(61, 0));
    w = ecs_obs_sys_add_world(ar1);
    if ecs_obs_sys_world_count(w) != 2 { panic(122291); };
    let onv = ecs_obs_sys_on_new(0, 1, 1);
    let tr = ecs_obs_sys_world_trigger(w, onv);
    if ecs_obs_sys_trigger_fired(tr) != 2 { panic(122292); };
    let s0 = ecs_obs_sys_world_system_at(ecs_obs_sys_trigger_world(tr), 0);
    if ecs_obs_sys_meta_param_count(ecs_obs_sys_meta(s0)) != 3 { panic(122293); };
}
