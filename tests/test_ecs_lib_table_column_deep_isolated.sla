@import "lib/table_column_deep.sla"

// Batch 273: table_column deep (src/storage/table/column.rs).
// panic codes: 120600 – 120799.

@test "with_capacity_defaults"() {
    let c = ecs_col_deep_with_capacity(5, 16, 100, true);
    if ecs_col_deep_component_id(c) != 5 { panic(120600); };
    if ecs_col_deep_component_size(c) != 16 { panic(120601); };
    if ecs_col_deep_capacity(c) != 100 { panic(120602); };
    if ecs_col_deep_has_drop(c) != true { panic(120603); };
    if ecs_col_deep_is_empty(c) != true { panic(120604); };
    if ecs_col_deep_get_drop(c) != true { panic(120605); };
}

@test "initialize_and_get"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, false);
    c = ecs_col_deep_initialize(c, 0, 42, 10, 7);
    if ecs_col_deep_len(c) != 1 { panic(120610); };
    let cell = ecs_col_deep_get_data(c, 0);
    if ecs_col_cell_found(cell) != true { panic(120611); };
    if ecs_col_cell_data(cell) != 42 { panic(120612); };
    if ecs_col_cell_added(cell) != 10 { panic(120613); };
    if ecs_col_cell_changed(cell) != 10 { panic(120614); };
    if ecs_col_cell_changed_by(cell) != 7 { panic(120615); };
}

@test "initialize_multiple"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, false);
    c = ecs_col_deep_initialize(c, 0, 10, 1, 0);
    c = ecs_col_deep_initialize(c, 1, 20, 2, 0);
    c = ecs_col_deep_initialize(c, 2, 30, 3, 0);
    if ecs_col_deep_len(c) != 3 { panic(120620); };
    if ecs_col_cell_data(ecs_col_deep_get_data(c, 1)) != 20 { panic(120621); };
    if ecs_col_cell_data(ecs_col_deep_get_data(c, 2)) != 30 { panic(120622); };
}

@test "replace_keeps_added"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, true);
    c = ecs_col_deep_initialize(c, 0, 1, 5, 1);
    c = ecs_col_deep_replace(c, 0, 9, 15, 2);
    let cell = ecs_col_deep_get_ticks(c, 0);
    if ecs_col_cell_data(cell) != 9 { panic(120630); };
    if ecs_col_cell_added(cell) != 5 { panic(120631); };
    if ecs_col_cell_changed(cell) != 15 { panic(120632); };
    if ecs_col_cell_changed_by(cell) != 2 { panic(120633); };
}

@test "swap_remove_middle"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, false);
    c = ecs_col_deep_initialize(c, 0, 10, 1, 0);
    c = ecs_col_deep_initialize(c, 1, 20, 1, 0);
    c = ecs_col_deep_initialize(c, 2, 30, 1, 0);
    c = ecs_col_deep_swap_remove(c, 0);
    if ecs_col_deep_len(c) != 2 { panic(120640); };
    // last (30) moved into row 0
    if ecs_col_cell_data(ecs_col_deep_get_data(c, 0)) != 30 { panic(120641); };
    if ecs_col_cell_data(ecs_col_deep_get_data(c, 1)) != 20 { panic(120642); };
}

@test "clear_and_drop_last"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, true);
    c = ecs_col_deep_initialize(c, 0, 1, 1, 0);
    c = ecs_col_deep_initialize(c, 1, 2, 1, 0);
    c = ecs_col_deep_drop_last(c);
    if ecs_col_deep_len(c) != 1 { panic(120650); };
    c = ecs_col_deep_clear(c);
    if ecs_col_deep_is_empty(c) != true { panic(120651); };
    if ecs_col_deep_capacity(c) != 8 { panic(120652); };
}

@test "check_change_ticks_clamps"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, false);
    c = ecs_col_deep_initialize(c, 0, 1, 100, 0);
    c = ecs_col_deep_replace(c, 0, 1, 200, 0);
    c = ecs_col_deep_check_change_ticks(c, 50);
    let cell = ecs_col_deep_get_ticks(c, 0);
    if ecs_col_cell_added(cell) != 50 { panic(120660); };
    if ecs_col_cell_changed(cell) != 50 { panic(120661); };
}

@test "realloc_grows_capacity"() {
    let c = ecs_col_deep_with_capacity(1, 8, 4, false);
    c = ecs_col_deep_realloc(c, 16);
    if ecs_col_deep_capacity(c) != 16 { panic(120670); };
    c = ecs_col_deep_realloc(c, 8);
    if ecs_col_deep_capacity(c) != 16 { panic(120671); };
}

@test "initialize_from_copies_row"() {
    let src = ecs_col_deep_with_capacity(1, 8, 8, false);
    src = ecs_col_deep_initialize(src, 0, 77, 3, 9);
    let dest = ecs_col_deep_with_capacity(1, 8, 8, false);
    dest = ecs_col_deep_initialize_from(dest, src, 0);
    if ecs_col_deep_len(dest) != 1 { panic(120680); };
    let cell = ecs_col_deep_get_cell(dest, 0);
    if ecs_col_cell_data(cell) != 77 { panic(120681); };
    if ecs_col_cell_added(cell) != 3 { panic(120682); };
    if ecs_col_cell_changed_by(cell) != 9 { panic(120683); };
}

@test "count_matching"() {
    let c = ecs_col_deep_with_capacity(1, 8, 8, false);
    c = ecs_col_deep_initialize(c, 0, 5, 1, 0);
    c = ecs_col_deep_initialize(c, 1, 5, 1, 0);
    c = ecs_col_deep_initialize(c, 2, 6, 1, 0);
    if ecs_col_deep_count_matching(c, 5) != 2 { panic(120690); };
    if ecs_col_deep_count_matching(c, 6) != 1 { panic(120691); };
    if ecs_col_deep_get_cell(c, 9).found != false { panic(120692); };
}
