@import "lib/observer_system_param_deep.sla"

// Batch 214: observer system_param deep (src/observer/system_param.rs).
// panic codes: 108800 – 108899.

@test "trigger_kind_constants"() {
    if ecs_osp_kind_global() != 0 { panic(108800); };
    if ecs_osp_kind_entity() != 1 { panic(108801); };
    if ecs_osp_kind_propagate() != 2 { panic(108802); };
}

@test "event_key_eq"() {
    let a = ecs_osp_event_key_new(9);
    let b = ecs_osp_event_key_new(9);
    let c = ecs_osp_event_key_new(10);
    if ecs_osp_event_key_id(a) != 9 { panic(108810); };
    if ecs_osp_event_key_eq(a, b) != true { panic(108811); };
    if ecs_osp_event_key_eq(a, c) != false { panic(108812); };
}

@test "trigger_context_fields"() {
    let c = ecs_osp_ctx_new(42, 1001, true);
    if ecs_osp_ctx_event_key(c) != 42 { panic(108820); };
    if ecs_osp_ctx_caller(c) != 1001 { panic(108821); };
    if ecs_osp_ctx_has_caller(c) != true { panic(108822); };
    let n = ecs_osp_ctx_new(1, 0, false);
    if ecs_osp_ctx_has_caller(n) != false { panic(108823); };
}

@test "on_new_event_key_observer_caller"() {
    let t = ecs_osp_trigger_entity(7);
    let c = ecs_osp_ctx_new(55, 900, true);
    let o = ecs_osp_on_new(123, 77, t, c);
    if ecs_osp_on_event_key(o) != 55 { panic(108830); };
    if ecs_osp_on_event(o) != 123 { panic(108831); };
    if ecs_osp_on_observer(o) != 77 { panic(108832); };
    if ecs_osp_on_caller(o) != 900 { panic(108833); };
    if ecs_osp_on_has_caller(o) != true { panic(108834); };
    if ecs_osp_on_event_ptr(o) != 123 { panic(108835); };
}

@test "event_mut_keeps_ptr_identity"() {
    let t = ecs_osp_trigger_global();
    let c = ecs_osp_ctx_new(1, 0, false);
    let o = ecs_osp_on_new(10, 1, t, c);
    let p0 = ecs_osp_on_event_ptr(o);
    let o2 = ecs_osp_on_event_mut(o, 99);
    if ecs_osp_on_event(o2) != 99 { panic(108840); };
    if ecs_osp_on_event_ptr(o2) != p0 { panic(108841); };
}

@test "trigger_entity_accessors"() {
    let t = ecs_osp_trigger_entity(44);
    if ecs_osp_trigger_kind(t) != ECS_OSP_TRIGGER_ENTITY { panic(108850); };
    if ecs_osp_trigger_event_target(t) != 44 { panic(108851); };
    if ecs_osp_trigger_original(t) != 44 { panic(108852); };
    if ecs_osp_trigger_get_propagate(t) != false { panic(108853); };
}

@test "propagate_default_and_toggle"() {
    let o = ecs_osp_on_propagate_new(5, 2, 10, 3, 8, false);
    if ecs_osp_on_get_propagate(o) != false { panic(108860); };
    if ecs_osp_on_original_event_target(o) != 10 { panic(108861); };
    if ecs_osp_on_event_target(o) != 10 { panic(108862); };
    o = ecs_osp_on_propagate(o, true);
    if ecs_osp_on_get_propagate(o) != true { panic(108863); };
    o = ecs_osp_on_propagate(o, false);
    if ecs_osp_on_get_propagate(o) != false { panic(108864); };
}

@test "auto_propagate_starts_true"() {
    let o = ecs_osp_on_propagate_new(1, 1, 20, 4, 5, true);
    if ecs_osp_on_get_propagate(o) != true { panic(108870); };
    let tr = ecs_osp_on_trigger(o);
    if ecs_osp_trigger_auto_propagate(tr) != true { panic(108871); };
    if ecs_osp_trigger_kind(tr) != ECS_OSP_TRIGGER_PROPAGATE { panic(108872); };
}

@test "advance_keeps_original_target"() {
    let o = ecs_osp_on_propagate_new(1, 9, 100, 1, 2, true);
    o = ecs_osp_on_advance(o, 200);
    if ecs_osp_on_event_target(o) != 200 { panic(108880); };
    if ecs_osp_on_original_event_target(o) != 100 { panic(108881); };
    o = ecs_osp_on_advance(o, 300);
    if ecs_osp_on_event_target(o) != 300 { panic(108882); };
    if ecs_osp_on_original_event_target(o) != 100 { panic(108883); };
}

@test "trigger_mut_replace"() {
    let t0 = ecs_osp_trigger_entity(1);
    let c = ecs_osp_ctx_new(2, 0, false);
    let o = ecs_osp_on_new(0, 5, t0, c);
    let t1 = ecs_osp_trigger_propagate(8, true);
    o = ecs_osp_on_trigger_mut(o, t1);
    let tr = ecs_osp_on_trigger(o);
    if ecs_osp_trigger_kind(tr) != ECS_OSP_TRIGGER_PROPAGATE { panic(108890); };
    if ecs_osp_on_event_target(o) != 8 { panic(108891); };
    if ecs_osp_on_get_propagate(o) != true { panic(108892); };
}

@test "bundle_empty_matches_all"() {
    let b = ecs_osp_bundle_empty();
    if ecs_osp_bundle_len(b) != 0 { panic(108900); };
    if ecs_osp_bundle_matches_any(b, 1) != true { panic(108901); };
    if ecs_osp_bundle_matches_any(b, 99) != true { panic(108902); };
}

@test "bundle_any_of_not_all"() {
    // Bevy: multiple components in B match ANY, not all
    let b = ecs_osp_bundle_two(10, 20);
    if ecs_osp_bundle_matches_any(b, 10) != true { panic(108910); };
    if ecs_osp_bundle_matches_any(b, 20) != true { panic(108911); };
    if ecs_osp_bundle_matches_any(b, 30) != false { panic(108912); };
    b = ecs_osp_bundle_push(b, 30);
    if ecs_osp_bundle_len(b) != 3 { panic(108913); };
    if ecs_osp_bundle_matches_any(b, 30) != true { panic(108914); };
}

@test "on_should_trigger_with_bundle"() {
    let t = ecs_osp_trigger_entity(1);
    let c = ecs_osp_ctx_new(1, 0, false);
    let o = ecs_osp_on_new(0, 1, t, c);
    o = ecs_osp_on_with_bundle(o, ecs_osp_bundle_two(5, 6));
    if ecs_osp_on_should_trigger(o, 5) != true { panic(108920); };
    if ecs_osp_on_should_trigger(o, 6) != true { panic(108921); };
    if ecs_osp_on_should_trigger(o, 7) != false { panic(108922); };
}

@test "run_observer_mutates_event_and_propagate"() {
    let o = ecs_osp_on_propagate_new(1, 3, 10, 2, 4, false);
    o = ecs_osp_run_observer(o, 50, true, true);
    if ecs_osp_on_event(o) != 50 { panic(108930); };
    if ecs_osp_on_get_propagate(o) != true { panic(108931); };
    // stop further propagation (remaining current-entity observers still conceptually run)
    o = ecs_osp_run_observer(o, 50, false, true);
    if ecs_osp_on_get_propagate(o) != false { panic(108932); };
}

@test "display_code_packs_fields"() {
    let o = ecs_osp_on_propagate_new(0, 3, 7, 2, 1, false);
    // base 5000000000 + key*1e6 + observer*1000 + target
    if ecs_osp_on_display_code(o) != (5000000000 + 2000000 + 3000 + 7) { panic(108940); };
}

@test "global_trigger_no_target"() {
    let t = ecs_osp_trigger_global();
    let c = ecs_osp_ctx_new(8, 0, false);
    let o = ecs_osp_on_new(11, 12, t, c);
    if ecs_osp_trigger_kind(ecs_osp_on_trigger(o)) != ECS_OSP_TRIGGER_GLOBAL { panic(108950); };
    if ecs_osp_on_event_target(o) != 0 { panic(108951); };
    if ecs_osp_on_event_key(o) != 8 { panic(108952); };
}
