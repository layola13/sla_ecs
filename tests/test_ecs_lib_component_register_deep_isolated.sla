@import "lib/component_register_deep.sla"

// Batch 244: component_register deep (src/component/register.rs).
// panic codes: 114800 – 114999.

@test "ids_peek_next_and_empty"() {
    let ids = ecs_cr_ids_new(0);
    if ecs_cr_ids_is_empty(ids) != true { panic(114800); };
    if ecs_cr_ids_peek(ids) != 0 { panic(114801); };
    let n = ecs_cr_ids_next(ids);
    ids = n.0;
    if n.1 != 0 { panic(114802); };
    if ecs_cr_ids_peek(ids) != 1 { panic(114803); };
    if ecs_cr_ids_is_empty(ids) != false { panic(114804); };
}

@test "register_component_dedup_by_type"() {
    let c = ecs_cr_new();
    let r = ecs_cr_register_component(c, 100, 1, ecs_cr_storage_table());
    c = r.0;
    if r.1 != 0 { panic(114810); };
    if ecs_cr_len(c) != 1 { panic(114811); };
    r = ecs_cr_register_component(c, 100, 1, ecs_cr_storage_table());
    c = r.0;
    if r.1 != 0 { panic(114812); };
    if ecs_cr_len(c) != 1 { panic(114813); };
    r = ecs_cr_register_component(c, 101, 2, ecs_cr_storage_sparse());
    c = r.0;
    if r.1 != 1 { panic(114814); };
    if ecs_cr_len(c) != 2 { panic(114815); };
    let g = ecs_cr_get(c, 1);
    if g.0 != true { panic(114816); };
    if ecs_cr_entry_storage(g.1) != ecs_cr_storage_sparse() { panic(114817); };
}

@test "register_resource_and_non_send"() {
    let c = ecs_cr_new();
    let r = ecs_cr_register_resource(c, 200, 9);
    c = r.0;
    let g = ecs_cr_get(c, r.1);
    if g.0 != true { panic(114820); };
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_resource() { panic(114821); };
    if ecs_cr_entry_storage(g.1) != ecs_cr_storage_table() { panic(114822); };
    if ecs_cr_entry_is_send(g.1) != true { panic(114823); };
    r = ecs_cr_register_non_send(c, 201, 8, ecs_cr_storage_table());
    c = r.0;
    g = ecs_cr_get(c, r.1);
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_non_send() { panic(114824); };
    if ecs_cr_entry_is_send(g.1) != false { panic(114825); };
}

@test "register_with_descriptor_no_type_id"() {
    let c = ecs_cr_new();
    let r = ecs_cr_register_with_descriptor(c, ecs_cr_storage_sparse(), false, 3);
    c = r.0;
    if r.1 != 0 { panic(114830); };
    let g = ecs_cr_get(c, 0);
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_descriptor() { panic(114831); };
    if ecs_cr_entry_storage(g.1) != ecs_cr_storage_sparse() { panic(114832); };
    r = ecs_cr_register_with_descriptor(c, ecs_cr_storage_table(), true, 4);
    c = r.0;
    g = ecs_cr_get(c, r.1);
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_resource() { panic(114833); };
}

@test "queue_register_and_apply"() {
    let c = ecs_cr_new();
    c = ecs_cr_as_queued(c);
    if ecs_cr_is_as_queued(c) != true { panic(114840); };
    let r = ecs_cr_queue_register_component(c, 10, 1);
    c = r.0;
    if r.1 != 0 { panic(114841); };
    if ecs_cr_num_queued(c) != 1 { panic(114842); };
    if ecs_cr_len(c) != 0 { panic(114843); };
    if ecs_cr_any_queued(c) != true { panic(114844); };
    r = ecs_cr_queue_register_resource(c, 11, 2);
    c = r.0;
    if r.1 != 1 { panic(114845); };
    if ecs_cr_num_queued(c) != 2 { panic(114846); };
    c = ecs_cr_apply_queued(c);
    if ecs_cr_num_queued(c) != 0 { panic(114847); };
    if ecs_cr_any_queued(c) != false { panic(114848); };
    if ecs_cr_len(c) != 2 { panic(114849); };
    let g = ecs_cr_get(c, 0);
    if g.0 != true { panic(114850); };
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_component() { panic(114851); };
    g = ecs_cr_get(c, 1);
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_resource() { panic(114852); };
}

@test "queue_dedup_same_type"() {
    let c = ecs_cr_new();
    let r = ecs_cr_queue_register_component(c, 50, 1);
    c = r.0;
    let id1 = r.1;
    r = ecs_cr_queue_register_component(c, 50, 1);
    c = r.0;
    if r.1 != id1 { panic(114860); };
    if ecs_cr_num_queued(c) != 1 { panic(114861); };
    // after apply, immediate register same type returns same id
    c = ecs_cr_apply_queued(c);
    r = ecs_cr_register_component(c, 50, 1, ecs_cr_storage_table());
    c = r.0;
    if r.1 != id1 { panic(114862); };
    if ecs_cr_len(c) != 1 { panic(114863); };
}

@test "queue_non_send_and_type_lookup"() {
    let c = ecs_cr_new();
    let r = ecs_cr_queue_register_non_send(c, 70, 7);
    c = r.0;
    c = ecs_cr_apply_queued(c);
    let g = ecs_cr_get(c, r.1);
    if ecs_cr_entry_is_send(g.1) != false { panic(114870); };
    if ecs_cr_entry_kind(g.1) != ecs_cr_kind_non_send() { panic(114871); };
    let t = ecs_cr_get_type_id(c, 70);
    if t.0 != true { panic(114872); };
    if t.1 != r.1 { panic(114873); };
}

@test "peek_advances_with_registers"() {
    let c = ecs_cr_new();
    if ecs_cr_peek(c) != 0 { panic(114880); };
    let r = ecs_cr_register_component(c, 1, 1, ecs_cr_storage_table());
    c = r.0;
    if ecs_cr_peek(c) != 1 { panic(114881); };
    r = ecs_cr_queue_register_component(c, 2, 2);
    c = r.0;
    if ecs_cr_peek(c) != 2 { panic(114882); };
}

@test "missing_get_and_empty_registry"() {
    let c = ecs_cr_new();
    if ecs_cr_len(c) != 0 { panic(114890); };
    if ecs_cr_any_queued(c) != false { panic(114891); };
    let g = ecs_cr_get(c, 0);
    if g.0 != false { panic(114892); };
    let t = ecs_cr_get_type_id(c, 1);
    if t.0 != false { panic(114893); };
}

@test "apply_empty_queue_is_noop"() {
    let c = ecs_cr_new();
    let r = ecs_cr_register_component(c, 9, 1, ecs_cr_storage_table());
    c = r.0;
    c = ecs_cr_apply_queued(c);
    if ecs_cr_len(c) != 1 { panic(114900); };
    if ecs_cr_num_queued(c) != 0 { panic(114901); };
}
