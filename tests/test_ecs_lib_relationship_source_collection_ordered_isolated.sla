@import "lib/relationship_source_collection_ordered.sla"

// Isolated tests for lib/relationship_source_collection_ordered.sla — OrderedRelationshipSourceCollection
// trait surface (insert/remove_at/insert_stable/remove_at_stable/sort/insert_sorted/place/place_most_recent/push_front
// + with_capacity/reserve/shrink_to_fit/extend_from_iter/source_to_remove_before_add).
// Bevy reference: src/relationship/relationship_source_collection.rs.

const E0: i64 = 100;
const E1: i64 = 101;
const E2: i64 = 102;
const E3: i64 = 103;

@test "ord_new_empty"() {
    let c = ecs_rsc_ordered_new();
    if ecs_rsc_ordered_len(c) != 0 { panic(91975); };
    if !ecs_rsc_ordered_is_empty(c) { panic(91976); };
}

@test "ord_at_oob"() {
    let c = ecs_rsc_ordered_new();
    if ecs_rsc_ordered_at(c, -1) != -1 { panic(91977); };
    if ecs_rsc_ordered_at(c, 5) != -1 { panic(91978); };
}

@test "ord_insert_grows_at_index"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    if ecs_rsc_ordered_len(c1) != 1 { panic(91979); };
    if ecs_rsc_ordered_at(c1, 0) != E0 { panic(91980); };
}

@test "ord_insert_at_index_shifts_trailing"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 0, E1);
    // [E0] insert E1 at 0 yields [E1, E0]
    if ecs_rsc_ordered_at(c2, 0) != E1 { panic(91981); };
    if ecs_rsc_ordered_at(c2, 1) != E0 { panic(91982); };
}

@test "ord_insert_at_index_two_shifts"() {
    // start [E0], insert E1 at 0 -> [E1, E0]; insert E2 at 1 -> [E1, E2, E0]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 0, E1);
    let c3 = ecs_rsc_ordered_insert(c2, 1, E2);
    if ecs_rsc_ordered_len(c3) != 3 { panic(91983); };
    if ecs_rsc_ordered_at(c3, 0) != E1 { panic(91984); };
    if ecs_rsc_ordered_at(c3, 1) != E2 { panic(91985); };
    if ecs_rsc_ordered_at(c3, 2) != E0 { panic(91986); };
}

@test "ord_insert_oob_clamps_to_end"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 100, E0);
    if ecs_rsc_ordered_at(c1, 0) != E0 { panic(91987); };
}

@test "ord_insert_negative_clamps_to_front"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, -5, E0);
    if ecs_rsc_ordered_at(c1, 0) != E0 { panic(91988); };
}

@test "ord_push_front"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_push_front(c1, E1);
    if ecs_rsc_ordered_at(c2, 0) != E1 { panic(91989); };
    if ecs_rsc_ordered_at(c2, 1) != E0 { panic(91990); };
}

@test "ord_remove_at_present"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 0, E1);
    // [E1, E0]
    let (c3, res) = ecs_rsc_ordered_remove_at(c2, 0);
    if ecs_rsc_ordered_len(c3) != 1 { panic(91991); };
    if ecs_rsc_ra_found(res) != 1 { panic(91992); };
    if ecs_rsc_ra_entity(res) != E1 { panic(91993); };
    if ecs_rsc_ordered_at(c3, 0) != E0 { panic(91994); };
}

@test "ord_remove_at_missing_index"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let (c2, res) = ecs_rsc_ordered_remove_at(c1, 5);
    if ecs_rsc_ra_found(res) != 0 { panic(91995); };
    if ecs_rsc_ra_entity(res) != -1 { panic(91996); };
    if ecs_rsc_ordered_len(c2) != 1 { panic(91997); };
}

@test "ord_remove_at_negative"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let (_, res) = ecs_rsc_ordered_remove_at(c1, -1);
    if ecs_rsc_ra_found(res) != 0 { panic(91998); };
}

@test "ord_remove_at_shrinks_length"() {
    // [E0, E1, E2]; remove index 1 -> [E0, E2]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E1);
    let c3 = ecs_rsc_ordered_insert(c2, 2, E2);
    let (c4, _) = ecs_rsc_ordered_remove_at(c3, 1);
    if ecs_rsc_ordered_len(c4) != 2 { panic(91999); };
    if ecs_rsc_ordered_at(c4, 0) != E0 { panic(92000); };
    if ecs_rsc_ordered_at(c4, 1) != E2 { panic(92001); };
}

@test "ord_remove_at_stable_same_result"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let (c2, res) = ecs_rsc_ordered_remove_at_stable(c1, 0);
    if ecs_rsc_ra_found(res) != 1 { panic(92002); };
    if ecs_rsc_ordered_len(c2) != 0 { panic(92003); };
}

@test "ord_insert_stable_equivalent"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert_stable(c0, 0, E0);
    if ecs_rsc_ordered_at(c1, 0) != E0 { panic(92004); };
    let c2 = ecs_rsc_ordered_insert_stable(c1, 0, E1);
    if ecs_rsc_ordered_at(c2, 0) != E1 { panic(92005); };
    if ecs_rsc_ordered_at(c2, 1) != E0 { panic(92006); };
}

@test "ord_extend_from_iter_appends"() {
    let c0 = ecs_rsc_ordered_new();
    let list = Vec::new();
    list.push(E0);
    list.push(E1);
    let c1 = ecs_rsc_ordered_extend_from_iter(c0, list);
    if ecs_rsc_ordered_len(c1) != 2 { panic(92007); };
    if ecs_rsc_ordered_at(c1, 0) != E0 { panic(92008); };
    if ecs_rsc_ordered_at(c1, 1) != E1 { panic(92009); };
}

@test "ord_extend_from_iter_empty"() {
    let c0 = ecs_rsc_ordered_new();
    let list = Vec::new();
    let c1 = ecs_rsc_ordered_extend_from_iter(c0, list);
    if ecs_rsc_ordered_len(c1) != 0 { panic(92010); };
}

@test "ord_with_capacity_starts_empty"() {
    let c = ecs_rsc_ordered_with_capacity(10);
    if !ecs_rsc_ordered_is_empty(c) { panic(92011); };
}

@test "ord_reserve_and_shrink_to_fit_are_noops"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_reserve(c1, 4);
    if ecs_rsc_ordered_len(c2) != 1 { panic(92012); };
    let c3 = ecs_rsc_ordered_shrink_to_fit(c2);
    if ecs_rsc_ordered_len(c3) != 1 { panic(92013); };
}

@test "ord_source_to_remove_before_add_default_none"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    if ecs_rsc_ordered_source_to_remove_before_add(c1) != -1 { panic(92014); };
}

@test "ord_place_most_recent_relocates_tail"() {
    // [E0, E1, E2] place_most_recent(0) -> tail E2 to head: [E2, E0, E1]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E1);
    let c3 = ecs_rsc_ordered_insert(c2, 2, E2);
    let c4 = ecs_rsc_ordered_place_most_recent(c3, 0);
    if ecs_rsc_ordered_at(c4, 0) != E2 { panic(92015); };
    if ecs_rsc_ordered_at(c4, 1) != E0 { panic(92016); };
    if ecs_rsc_ordered_at(c4, 2) != E1 { panic(92017); };
}

@test "ord_place_most_recent_oob_is_end_keep"() {
    // [E0, E1] place_most_recent(100) — tail stays at end
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E1);
    let c3 = ecs_rsc_ordered_place_most_recent(c2, 100);
    if ecs_rsc_ordered_at(c3, 1) != E1 { panic(92018); };
}

@test "ord_place_present_entity"() {
    // [E0, E1, E2] place(E0, 1): [E1, E0, E2]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E1);
    let c3 = ecs_rsc_ordered_insert(c2, 2, E2);
    let c4 = ecs_rsc_ordered_place(c3, E0, 1);
    if ecs_rsc_ordered_at(c4, 0) != E1 { panic(92019); };
    if ecs_rsc_ordered_at(c4, 1) != E0 { panic(92020); };
    if ecs_rsc_ordered_at(c4, 2) != E2 { panic(92021); };
}

@test "ord_place_absent_noop"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_place(c1, E2, 0);
    if ecs_rsc_ordered_at(c2, 0) != E0 { panic(92022); };
}

@test "ord_sort_ascending"() {
    // [E2, E0, E1] -> sort -> [E0, E1, E2]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E2);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E0);
    let c3 = ecs_rsc_ordered_insert(c2, 2, E1);
    let c4 = ecs_rsc_ordered_sort(c3);
    if ecs_rsc_ordered_at(c4, 0) != E0 { panic(92023); };
    if ecs_rsc_ordered_at(c4, 1) != E1 { panic(92024); };
    if ecs_rsc_ordered_at(c4, 2) != E2 { panic(92025); };
}

@test "ord_sort_already_sorted_unchanged"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E1);
    let c3 = ecs_rsc_ordered_sort(c2);
    if ecs_rsc_ordered_at(c3, 0) != E0 { panic(92026); };
    if ecs_rsc_ordered_at(c3, 1) != E1 { panic(92027); };
}

@test "ord_insert_sorted_in_middle"() {
    // [E0, E2] -> insert_sorted E1 -> [E0, E1, E2]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert(c1, 1, E2);
    let c3 = ecs_rsc_ordered_insert_sorted(c2, E1);
    if ecs_rsc_ordered_at(c3, 0) != E0 { panic(92028); };
    if ecs_rsc_ordered_at(c3, 1) != E1 { panic(92029); };
    if ecs_rsc_ordered_at(c3, 2) != E2 { panic(92030); };
}

@test "ord_insert_sorted_at_start"() {
    // [E1] -> insert_sorted E0 -> [E0, E1]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E1);
    let c2 = ecs_rsc_ordered_insert_sorted(c1, E0);
    if ecs_rsc_ordered_at(c2, 0) != E0 { panic(92031); };
}

@test "ord_insert_sorted_at_end"() {
    // [E0] -> insert_sorted E1 -> [E0, E1]
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert(c0, 0, E0);
    let c2 = ecs_rsc_ordered_insert_sorted(c1, E1);
    if ecs_rsc_ordered_at(c2, 1) != E1 { panic(92032); };
}

@test "ord_insert_sorted_into_empty"() {
    let c0 = ecs_rsc_ordered_new();
    let c1 = ecs_rsc_ordered_insert_sorted(c0, E0);
    if ecs_rsc_ordered_at(c1, 0) != E0 { panic(92033); };
}
