@import "lib/deferred_world_extras_deep.sla"

// Batch 287: deferred_world_extras deep (src/world/deferred_world.rs residual).
// panic codes: 123400 – 123599.

@test "new_spawn_and_get_entity_mut"() {
    let d = ecs_dwx_deep_new(7, 1);
    if ecs_dwx_deep_world_id(d) != 7 { panic(123400); };
    d = ecs_dwx_deep_spawn(d, 42);
    if ecs_dwx_deep_next_entity(d) != 1 { panic(123401); };
    let g = ecs_dwx_deep_get_entity_mut(d, 0);
    if ecs_dwx_get_ok(g) != true { panic(123402); };
    if ecs_dwx_get_value(g) != 42 { panic(123403); };
    let miss = ecs_dwx_deep_get_entity_mut(d, 3);
    if ecs_dwx_get_ok(miss) != false { panic(123404); };
    if ecs_dwx_get_err(miss) != 1 { panic(123405); };
}

@test "get_mut_and_set"() {
    let d = ecs_dwx_deep_new(1, 1);
    d = ecs_dwx_deep_spawn(d, 10);
    d = ecs_dwx_deep_insert_comp(d, 0, 5, 50);
    let g = ecs_dwx_deep_get_mut(d, 0, 5);
    if ecs_dwx_get_ok(g) != true { panic(123410); };
    if ecs_dwx_get_value(g) != 50 { panic(123411); };
    let sr = ecs_dwx_deep_set_mut(d, 0, 5, 99);
    if ecs_dwx_set_ok(sr) != true { panic(123412); };
    d = ecs_dwx_set_world(sr);
    if ecs_dwx_get_value(ecs_dwx_deep_get_mut_by_id(d, 0, 5)) != 99 { panic(123413); };
}

@test "entity_mut_many_alias"() {
    let d = ecs_dwx_deep_new(1, 1);
    d = ecs_dwx_deep_spawn(d, 1);
    d = ecs_dwx_deep_spawn(d, 2);
    let ok = ecs_dwx_deep_get_entity_mut_many(d, 0, 1, 2);
    if ecs_dwx_get_ok(ok) != true { panic(123420); };
    let bad = ecs_dwx_deep_get_entity_mut_many(d, 0, 0, 2);
    if ecs_dwx_get_ok(bad) != false { panic(123421); };
    if ecs_dwx_get_err(bad) != 2 { panic(123422); };
}

@test "query_handles"() {
    let d = ecs_dwx_deep_new(9, 1);
    let q1 = ecs_dwx_deep_query(d);
    if ecs_dwx_query_handle_id(q1) != 1 { panic(123430); };
    if ecs_dwx_query_world_id(q1) != 9 { panic(123431); };
    d = ecs_dwx_query_world(q1);
    let q2 = ecs_dwx_deep_query(d);
    if ecs_dwx_query_handle_id(q2) != 2 { panic(123432); };
}

@test "resource_mut_by_id"() {
    let d = ecs_dwx_deep_new(1, 1);
    d = ecs_dwx_deep_resource_insert(d, 100, 1000);
    if ecs_dwx_deep_rlen(d) != 1 { panic(123440); };
    let g = ecs_dwx_deep_get_resource_mut_by_id(d, 100);
    if ecs_dwx_get_ok(g) != true { panic(123441); };
    if ecs_dwx_get_value(g) != 1000 { panic(123442); };
    d = ecs_dwx_deep_resource_insert(d, 100, 1111);
    if ecs_dwx_get_value(ecs_dwx_deep_get_resource_mut_by_id(d, 100)) != 1111 { panic(123443); };
    let miss = ecs_dwx_deep_get_resource_mut_by_id(d, 999);
    if ecs_dwx_get_ok(miss) != false { panic(123444); };
}

@test "non_send_thread_check"() {
    let d = ecs_dwx_deep_new(1, 5);
    d = ecs_dwx_deep_insert_non_send(d, 3, 30, 5);
    let g = ecs_dwx_deep_get_non_send_mut_by_id(d, 3);
    if ecs_dwx_ns_ok(g) != true { panic(123450); };
    if ecs_dwx_ns_value(g) != 30 { panic(123451); };
    if ecs_dwx_ns_thread_ok(g) != true { panic(123452); };
    d = ecs_dwx_deep_insert_non_send(d, 4, 40, 9);
    let g2 = ecs_dwx_deep_non_send_resource_mut(d, 4);
    if ecs_dwx_ns_ok(g2) != true { panic(123453); };
    if ecs_dwx_ns_thread_ok(g2) != false { panic(123454); };
    let miss = ecs_dwx_deep_non_send_resource_mut(d, 99);
    if ecs_dwx_ns_ok(miss) != false { panic(123455); };
}

@test "entity_mut_borrow_exclusive"() {
    let d = ecs_dwx_deep_new(1, 1);
    d = ecs_dwx_deep_spawn(d, 7);
    let b = ecs_dwx_deep_entity_mut_begin(d, 0);
    if ecs_dwx_set_ok(b) != true { panic(123460); };
    d = ecs_dwx_set_world(b);
    if ecs_dwx_deep_mut_borrowed(d) != true { panic(123461); };
    let b2 = ecs_dwx_deep_entity_mut_begin(d, 0);
    if ecs_dwx_set_ok(b2) != false { panic(123462); };
    d = ecs_dwx_deep_entity_mut_end(d);
    if ecs_dwx_deep_mut_borrowed(d) != false { panic(123463); };
}

@test "change_tick_and_reborrow"() {
    let d = ecs_dwx_deep_new(2, 1);
    if ecs_dwx_deep_change_tick(d) != 0 { panic(123470); };
    d = ecs_dwx_deep_bump_tick(d);
    d = ecs_dwx_deep_bump_tick(d);
    if ecs_dwx_deep_change_tick(d) != 2 { panic(123471); };
    let r = ecs_dwx_deep_reborrow(d);
    if ecs_dwx_deep_world_id(r) != 2 { panic(123472); };
    if ecs_dwx_deep_change_tick(r) != 2 { panic(123473); };
}

@test "multi_entity_spawn_and_components"() {
    let d = ecs_dwx_deep_new(1, 1);
    d = ecs_dwx_deep_spawn(d, 1);
    d = ecs_dwx_deep_spawn(d, 2);
    d = ecs_dwx_deep_spawn(d, 3);
    d = ecs_dwx_deep_insert_comp(d, 1, 9, 90);
    if ecs_dwx_get_value(ecs_dwx_deep_get_entity_mut(d, 1)) != 2 { panic(123480); };
    if ecs_dwx_get_value(ecs_dwx_deep_get_mut(d, 1, 9)) != 90 { panic(123481); };
    if ecs_dwx_get_ok(ecs_dwx_deep_get_mut(d, 1, 8)) != false { panic(123482); };
}

@test "resource_capacity_two"() {
    let d = ecs_dwx_deep_new(1, 1);
    d = ecs_dwx_deep_resource_insert(d, 1, 10);
    d = ecs_dwx_deep_resource_insert(d, 2, 20);
    d = ecs_dwx_deep_resource_insert(d, 3, 30);
    if ecs_dwx_deep_rlen(d) != 2 { panic(123490); };
    if ecs_dwx_get_ok(ecs_dwx_deep_get_resource_mut_by_id(d, 3)) != false { panic(123491); };
    if ecs_dwx_get_value(ecs_dwx_deep_get_resource_mut_by_id(d, 2)) != 20 { panic(123492); };
}
