@import "lib/entity_hash_map_extras_deep.sla"

// Batch 306: entity_hash_map_extras deep.
// panic codes: 127200 – 127399.

@test "insert_get_len"() {
    let m = ecs_ehm_deep_new();
    if ecs_ehm_deep_is_empty(m) != true { panic(127200); };
    m = ecs_ehm_deep_insert(m, 10, 100);
    m = ecs_ehm_deep_insert(m, 20, 200);
    if ecs_ehm_deep_len(m) != 2 { panic(127201); };
    let g = ecs_ehm_deep_get(m, 10);
    if ecs_ehm_get_ok(g) != true { panic(127202); };
    if ecs_ehm_get_value(g) != 100 { panic(127203); };
    let miss = ecs_ehm_deep_get(m, 99);
    if ecs_ehm_get_ok(miss) != false { panic(127204); };
}

@test "insert_overwrite"() {
    let m = ecs_ehm_deep_insert(ecs_ehm_deep_new(), 5, 1);
    m = ecs_ehm_deep_insert(m, 5, 9);
    if ecs_ehm_deep_len(m) != 1 { panic(127210); };
    let g = ecs_ehm_deep_get(m, 5);
    if ecs_ehm_get_value(g) != 9 { panic(127211); };
}

@test "contains_and_at"() {
    let m = ecs_ehm_deep_insert(ecs_ehm_deep_insert(ecs_ehm_deep_new(), 1, 11), 2, 22);
    if ecs_ehm_deep_contains(m, 1) != true { panic(127220); };
    if ecs_ehm_deep_contains(m, 3) != false { panic(127221); };
    if ecs_ehm_deep_key_at(m, 0) != 1 { panic(127222); };
    if ecs_ehm_deep_value_at(m, 1) != 22 { panic(127223); };
}

@test "remove_middle_and_last"() {
    let m = ecs_ehm_deep_new();
    m = ecs_ehm_deep_insert(m, 1, 10);
    m = ecs_ehm_deep_insert(m, 2, 20);
    m = ecs_ehm_deep_insert(m, 3, 30);
    m = ecs_ehm_deep_remove(m, 2);
    if ecs_ehm_deep_len(m) != 2 { panic(127230); };
    if ecs_ehm_deep_contains(m, 2) != false { panic(127231); };
    if ecs_ehm_deep_contains(m, 1) != true { panic(127232); };
    if ecs_ehm_deep_contains(m, 3) != true { panic(127233); };
    m = ecs_ehm_deep_remove(m, 99);
    if ecs_ehm_deep_len(m) != 2 { panic(127234); };
}

@test "keys_iterator"() {
    let m = ecs_ehm_deep_insert(ecs_ehm_deep_insert(ecs_ehm_deep_new(), 7, 1), 8, 2);
    let k = ecs_ehm_deep_keys(m);
    if ecs_ehm_keys_len(k) != 2 { panic(127240); };
    if ecs_ehm_keys_remaining(k) != 2 { panic(127241); };
    let n1 = ecs_ehm_keys_next(k);
    if ecs_ehm_key_next_has(n1) != true { panic(127242); };
    if ecs_ehm_key_next_key(n1) != 7 { panic(127243); };
    let n2 = ecs_ehm_keys_next(ecs_ehm_key_next_iter(n1));
    if ecs_ehm_key_next_key(n2) != 8 { panic(127244); };
    let n3 = ecs_ehm_keys_next(ecs_ehm_key_next_iter(n2));
    if ecs_ehm_key_next_has(n3) != false { panic(127245); };
}

@test "extend_and_clear"() {
    let a = ecs_ehm_deep_insert(ecs_ehm_deep_new(), 1, 10);
    let b = ecs_ehm_deep_insert(ecs_ehm_deep_insert(ecs_ehm_deep_new(), 1, 99), 2, 20);
    let e = ecs_ehm_deep_extend(a, b);
    if ecs_ehm_deep_len(e) != 2 { panic(127250); };
    let g = ecs_ehm_deep_get(e, 1);
    if ecs_ehm_get_value(g) != 99 { panic(127251); };
    e = ecs_ehm_deep_clear(e);
    if ecs_ehm_deep_is_empty(e) != true { panic(127252); };
}

@test "capacity_eight"() {
    let m = ecs_ehm_deep_new();
    m = ecs_ehm_deep_insert(m, 1, 1);
    m = ecs_ehm_deep_insert(m, 2, 2);
    m = ecs_ehm_deep_insert(m, 3, 3);
    m = ecs_ehm_deep_insert(m, 4, 4);
    m = ecs_ehm_deep_insert(m, 5, 5);
    m = ecs_ehm_deep_insert(m, 6, 6);
    m = ecs_ehm_deep_insert(m, 7, 7);
    m = ecs_ehm_deep_insert(m, 8, 8);
    if ecs_ehm_deep_len(m) != 8 { panic(127260); };
    m = ecs_ehm_deep_insert(m, 9, 9);
    if ecs_ehm_deep_len(m) != 8 { panic(127261); };
    if ecs_ehm_deep_contains(m, 8) != true { panic(127262); };
    if ecs_ehm_deep_contains(m, 9) != false { panic(127263); };
}

@test "remove_until_empty"() {
    let m = ecs_ehm_deep_insert(ecs_ehm_deep_insert(ecs_ehm_deep_new(), 4, 40), 5, 50);
    m = ecs_ehm_deep_remove(m, 4);
    m = ecs_ehm_deep_remove(m, 5);
    if ecs_ehm_deep_is_empty(m) != true { panic(127270); };
    if ecs_ehm_deep_contains(m, 4) != false { panic(127271); };
}

@test "get_after_remove_swap"() {
    let m = ecs_ehm_deep_new();
    m = ecs_ehm_deep_insert(m, 1, 11);
    m = ecs_ehm_deep_insert(m, 2, 22);
    m = ecs_ehm_deep_insert(m, 3, 33);
    m = ecs_ehm_deep_remove(m, 1);
    let g2 = ecs_ehm_deep_get(m, 2);
    let g3 = ecs_ehm_deep_get(m, 3);
    if ecs_ehm_get_ok(g2) != true { panic(127280); };
    if ecs_ehm_get_ok(g3) != true { panic(127281); };
    if ecs_ehm_get_value(g2) != 22 { panic(127282); };
    if ecs_ehm_get_value(g3) != 33 { panic(127283); };
}

@test "keys_remaining"() {
    let m = ecs_ehm_deep_insert(ecs_ehm_deep_new(), 100, 1);
    let k = ecs_ehm_deep_keys(m);
    let n = ecs_ehm_keys_next(k);
    if ecs_ehm_keys_remaining(ecs_ehm_key_next_iter(n)) != 0 { panic(127290); };
}
