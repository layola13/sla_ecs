// Isolated deep tests for lib/world_mod_deep.sla (Batch 415).
// Tests the comprehensive EcsWorld surface: 6 helper structs + ~169 public API fns.
// Uses cap-16 slot families; tuple-return fns flatten to last_* accessor fields.

@import "lib/world_mod_deep.sla"

@test "new_and_id"() {
    let w = ecs_world_mod_deep_new();
    if ecs_world_mod_deep_id_value(w) != 0 { panic(147300); };
    w = ecs_world_mod_deep_set_id(w, 7);
    if ecs_world_mod_deep_id_value(w) != 7 { panic(147301); };
    if ecs_world_mod_deep_entity_count(w) != 0 { panic(147302); };
    if ecs_world_mod_deep_components_count(w) != 0 { panic(147303); };
    if ecs_world_mod_deep_resource_count(w) != 0 { panic(147304); };
    if ecs_world_mod_deep_non_send_count(w) != 0 { panic(147305); };
    if ecs_world_mod_deep_schedule_count(w) != 0 { panic(147306); };
    if ecs_world_mod_deep_observer_count(w) != 0 { panic(147307); };
    if ecs_world_mod_deep_removed_components_count(w) != 0 { panic(147308); };
    if ecs_world_mod_deep_removed_entities_count(w) != 0 { panic(147309); };
}

@test "register_component_and_id"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_register_component(w, 10);
    if ecs_world_mod_deep_last_register_component_id(w) != 0 { panic(147310); };
    if ecs_world_mod_deep_components_count(w) != 1 { panic(147311); };
    w = ecs_world_mod_deep_register_component(w, 20);
    if ecs_world_mod_deep_last_register_component_id(w) != 1 { panic(147312); };
    if ecs_world_mod_deep_component_id(w, 10) != 0 { panic(147313); };
    if ecs_world_mod_deep_component_id(w, 20) != 1 { panic(147314); };
    if ecs_world_mod_deep_component_id(w, 99) != (0 - 1) { panic(147315); };
    // re-register returns existing id, count unchanged.
    w = ecs_world_mod_deep_register_component(w, 10);
    if ecs_world_mod_deep_last_register_component_id(w) != 0 { panic(147316); };
    if ecs_world_mod_deep_components_count(w) != 2 { panic(147317); };
}

@test "register_component_with_descriptor_alias"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_register_component_with_descriptor(w, 5);
    if ecs_world_mod_deep_components_count(w) != 1 { panic(147318); };
    if ecs_world_mod_deep_component_id(w, 5) != 0 { panic(147319); };
}

@test "register_resource_and_id"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_register_resource(w, 100);
    if ecs_world_mod_deep_last_register_resource_id(w) != 0 { panic(147320); };
    if ecs_world_mod_deep_resource_count(w) != 1 { panic(147321); };
    w = ecs_world_mod_deep_register_resource(w, 200);
    if ecs_world_mod_deep_last_register_resource_id(w) != 1 { panic(147322); };
    if ecs_world_mod_deep_resource_id(w, 100) != 0 { panic(147323); };
    if ecs_world_mod_deep_resource_id(w, 200) != 1 { panic(147324); };
}

@test "spawn_empty_and_entities"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_spawn_empty(w);
    if ecs_world_mod_deep_last_spawn_empty_entity(w) != 1 { panic(147325); };
    if ecs_world_mod_deep_entity_count(w) != 1 { panic(147326); };
    w = ecs_world_mod_deep_spawn_empty(w);
    if ecs_world_mod_deep_last_spawn_empty_entity(w) != 2 { panic(147327); };
    if ecs_world_mod_deep_entity_count(w) != 2 { panic(147328); };
    if ecs_world_mod_deep_iter_entities_len(w) != 2 { panic(147329); };
    if ecs_world_mod_deep_entities(w) != 2 { panic(147330); };
}

@test "spawn_with_component"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_spawn(w, 0, 42);
    if ecs_world_mod_deep_last_spawn_entity(w) != 1 { panic(147331); };
    if ecs_world_mod_deep_entity_count(w) != 1 { panic(147332); };
}

@test "spawn_at_existing"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_spawn_empty(w);
    let e1 = ecs_world_mod_deep_last_spawn_empty_entity(w);
    w = ecs_world_mod_deep_spawn_at(w, e1);
    if ecs_world_mod_deep_last_spawn_at_created(w) != false { panic(147333); };
    if ecs_world_mod_deep_last_spawn_at_entity(w) != e1 { panic(147334); };
}

