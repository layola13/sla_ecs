@test "entity_valid_and_entity"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_spawn_empty(w);
    let e1 = ecs_world_mod_deep_last_spawn_empty_entity(w);
    if ecs_world_mod_deep_entity_valid(w, e1) != true { panic(147342); };
    if ecs_world_mod_deep_entity_valid(w, 999) != false { panic(147343); };
    w = ecs_world_mod_deep_entity(w, e1);
    if ecs_world_mod_deep_last_entity_found(w) != true { panic(147344); };
    w = ecs_world_mod_deep_entity(w, 999);
    if ecs_world_mod_deep_last_entity_found(w) != false { panic(147345); };
}

