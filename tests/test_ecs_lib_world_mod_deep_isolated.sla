@test "insert_batch_and_aliases"() {
    let w = ecs_world_mod_deep_new();
    w = ecs_world_mod_deep_insert_batch(w, 3);
    if ecs_world_mod_deep_last_insert_batch_count(w) != 3 { panic(147427); };
    if ecs_world_mod_deep_entity_count(w) != 3 { panic(147428); };
    w = ecs_world_mod_deep_insert_batch_if_new(w, 2);
    if ecs_world_mod_deep_last_insert_batch_count(w) != 2 { panic(147429); };
    w = ecs_world_mod_deep_try_insert_batch(w, 1);
    if ecs_world_mod_deep_last_insert_batch_count(w) != 1 { panic(147430); };
