    if ecs_world_mod_deep_last_get_value(w) != 42 { panic(147360); };
    w = ecs_world_mod_deep_get(w, 0, 99);
    if ecs_world_mod_deep_last_get_found(w) != false { panic(147361); };
    w = ecs_world_mod_deep_get_mut(w, 0, 5);
    if ecs_world_mod_deep_last_get_found(w) != true { panic(147362); };
}

