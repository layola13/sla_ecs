    let s = ecs_stepping_new();
    let s2 = ecs_stepping_set_breakpoint_node(s, 1, 5);
    if ecs_stepping_behavior_for(s2, 1, 5) != 2 { panic(90784); };
}

@test "stepping_behavior_unregistered_defaults_continue"() {
    let s = ecs_stepping_new();
    if ecs_stepping_behavior_for(s, 1, 9) != 3 { panic(90785); };
}

@test "stepping_clear_breakpoint_node"() {
    let s = ecs_stepping_new();
    let s2 = ecs_stepping_set_breakpoint_node(s, 1, 5);
    let s3 = ecs_stepping_clear_breakpoint_node(s2, 1, 5);
    if ecs_stepping_behavior_for(s3, 1, 5) != 3 { panic(90786); };
}

@test "stepping_clear_node"() {
    let s = ecs_stepping_new();
    let s2 = ecs_stepping_always_run_node(s, 1, 5);
    let s3 = ecs_stepping_clear_node(s2, 1, 5);
    if ecs_stepping_behavior_for(s3, 1, 5) != 3 { panic(90787); };
}

@test "stepping_skipped_systems_runall_returns_none"() {
    let s = ecs_stepping_new();
    let r = ecs_stepping_skipped_systems(s, 1);
    if r.0 != false { panic(90788); };
}

@test "stepping_skipped_systems_never_run"() {
    let s = ecs_stepping_new();
    let s2 = ecs_stepping_add_schedule(s, 7);
    let s3 = ecs_stepping_never_run_node(s2, 7, 3);
    let s4 = ecs_stepping_enable(s3);
    let s5 = ecs_stepping_step_frame(s4);
    let r = ecs_stepping_skipped_systems(s5, 7);
    if r.0 != true { panic(90789); };
    if r.1 != 1 { panic(90790); };
    if r.2 != 3 { panic(90791); };
}

@test "stepping_skipped_systems_unknown_schedule"() {
    let s = ecs_stepping_new();
    let s2 = ecs_stepping_enable(s);
    let r = ecs_stepping_skipped_systems(s2, 99);
    if r.0 != false { panic(90792); };
}

@test "stepping_skipped_systems_waiting_break"() {
    let s = ecs_stepping_new();
    let s2 = ecs_stepping_add_schedule(s, 5);
    let s3 = ecs_stepping_set_breakpoint_node(s2, 5, 2);
    let s4 = ecs_stepping_enable(s3);
    // After enable, action = WAITING, so Break nodes also get added to skipped.
    let r = ecs_stepping_skipped_systems(s4, 5);
    if r.0 != true { panic(90793); };
    if r.1 != 1 { panic(90794); };
    if r.2 != 2 { panic(90795); };
}

// ---------------------------------------------------------------------------
// Batch 169 — Deepened Bevy stepping model tests:
// next_frame update queue + ScheduleState::skipped_systems full traversal.
// ---------------------------------------------------------------------------

@test "deep_new_defaults"() {
    let d = ecs_stepping_deep_new();
    if ecs_stepping_deep_is_enabled(d) != false { panic(91700); };
    if ecs_stepping_deep_action(d) != 0 { panic(91701); };
    if ecs_stepping_deep_has_schedule(d, 1) != false { panic(91702); };
}

@test "deep_enable_queues_and_applies_on_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    // before begin_frame, action is still RunAll (queued, not yet applied)
    if ecs_stepping_deep_is_enabled(d1) != false { panic(91703); };
    let d2 = ecs_stepping_deep_begin_frame(d1);
    if ecs_stepping_deep_is_enabled(d2) != true { panic(91704); };
    if ecs_stepping_deep_action(d2) != 1 { panic(91705); };
}

@test "deep_disable_queues_and_applies_on_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    let d3 = ecs_stepping_deep_disable(d2);
    // before begin_frame, still enabled
    if ecs_stepping_deep_is_enabled(d3) != true { panic(91706); };
    let d4 = ecs_stepping_deep_begin_frame(d3);
    if ecs_stepping_deep_is_enabled(d4) != false { panic(91707); };
    if ecs_stepping_deep_action(d4) != 0 { panic(91708); };
}

@test "deep_step_frame_queues_and_applies_on_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    // enable -> Waiting after begin_frame
    if ecs_stepping_deep_action(d2) != 1 { panic(91709); };
    let d3 = ecs_stepping_deep_step_frame(d2);
    // before begin_frame, still Waiting
    if ecs_stepping_deep_action(d3) != 1 { panic(91710); };
    let d4 = ecs_stepping_deep_begin_frame(d3);
    if ecs_stepping_deep_action(d4) != 3 { panic(91711); };
}

@test "deep_continue_frame_queues_and_applies_on_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    let d3 = ecs_stepping_deep_continue_frame(d2);
    if ecs_stepping_deep_action(d3) != 1 { panic(91712); };
    let d4 = ecs_stepping_deep_begin_frame(d3);
    if ecs_stepping_deep_action(d4) != 2 { panic(91713); };
}

@test "deep_step_frame_when_disabled_noop"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_step_frame(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    // step when not enabled is filtered: still RunAll
    if ecs_stepping_deep_action(d2) != 0 { panic(91714); };
    if ecs_stepping_deep_is_enabled(d2) != false { panic(91715); };
}

@test "deep_action_transition_step_overrides_continue"() {
    // (Continue, Step) should be filtered: step over continue is ignored
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    let d3 = ecs_stepping_deep_continue_frame(d2);
    let d4 = ecs_stepping_deep_step_frame(d3);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    // Step when action is Continue -> filtered, stays Continue? No:
    // Bevy: (Continue, Step) -> "ignoring step_frame(); already continuing" -> continue
    // But here action is Waiting after begin_frame(d2), then Continue is queued, then Step is queued.
    // begin_frame first resets action to Waiting (since not RunAll), then applies updates:
    // (Waiting, Continue) -> permitted, action=Continue. (Continue, Step) -> filtered, stays Continue.
    if ecs_stepping_deep_action(d5) != 2 { panic(91716); };
}

@test "deep_action_transition_continue_overrides_step"() {
    // (Step, Continue) should be filtered: continue over step is ignored
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    let d3 = ecs_stepping_deep_step_frame(d2);
    let d4 = ecs_stepping_deep_continue_frame(d3);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    // After begin_frame resets to Waiting, (Waiting, Step) -> Step, (Step, Continue) -> filtered -> Step
    if ecs_stepping_deep_action(d5) != 3 { panic(91717); };
}

@test "deep_add_schedule_queues_and_applies_on_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 10);
    // before begin_frame, not yet applied
    if ecs_stepping_deep_has_schedule(d1, 10) != false { panic(91718); };
    let d2 = ecs_stepping_deep_begin_frame(d1);
    if ecs_stepping_deep_has_schedule(d2, 10) != true { panic(91719); };
}

@test "deep_remove_schedule_queues_and_applies_on_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 10);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    if ecs_stepping_deep_has_schedule(d2, 10) != true { panic(91720); };
    let d3 = ecs_stepping_deep_queue_remove_schedule(d2, 10);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    if ecs_stepping_deep_has_schedule(d4, 10) != false { panic(91721); };
}

@test "deep_schedules_not_ready_before_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let r = ecs_stepping_deep_schedules(d1);
    if r.0 != false { panic(91722); };
}

@test "deep_schedules_ready_after_begin_frame"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    // Must enable stepping so skipped_systems returns a skip set (RunAll returns false)
    let d1b = ecs_stepping_deep_enable(d1);
    let d2 = ecs_stepping_deep_begin_frame(d1b);
    // schedules() returns ready when schedule_order.len == states.len
    // schedule_order is built lazily by skipped_systems, so until then it's empty != 1 state
    let r = ecs_stepping_deep_schedules(d2);
    if r.0 != false { panic(91723); };
    // Call skipped_systems to build order
    let sr = ecs_stepping_deep_skipped_systems(d2, 5, 3);
    if sr.0 != true { panic(91724); };
    // Now after skipped_systems: 1 order, 1 state -> ready
    let r2 = ecs_stepping_deep_schedules(d2);
    if r2.0 != true { panic(91725); };
    if len(r2.1) as i32 != 1 { panic(91726); };
}

@test "deep_cursor_returns_none_when_runall"() {
    let d = ecs_stepping_deep_new();
    let r = ecs_stepping_deep_cursor(d);
    if r.0 != false { panic(91727); };
}

@test "deep_cursor_returns_position_when_stepping"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 7);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_begin_frame(d2);
    // call skipped_systems to populate node_count and order
    let sr = ecs_stepping_deep_skipped_systems(d3, 7, 5);
    if sr.0 != true { panic(91728); };
    let cr = ecs_stepping_deep_cursor(d3);
    if cr.0 != true { panic(91729); };
    if cr.1 != 7 { panic(91730); };
    // cursor should point at the next-to-run system (after Waiting, all are skipped, cursor stays at 0)
    if cr.2 != 0 { panic(91731); };
}

@test "deep_skipped_runall_returns_false"() {
    let d = ecs_stepping_deep_new();
    let r = ecs_stepping_deep_skipped_systems(d, 1, 3);
    if r.0 != false { panic(91732); };
}

@test "deep_skipped_waiting_skips_all_non_always_run"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_begin_frame(d2);
    // 4 systems, all Continue, action=Waiting -> all skipped
    let r = ecs_stepping_deep_skipped_systems(d3, 5, 4);
    if r.0 != true { panic(91733); };
    let c = ecs_stepping_deep_skip_count(r.1);
    if c != 4 { panic(91734); };
    // next_system should be 0 (all skipped, cursor stays)
    if r.2 != 0 { panic(91735); };
}

@test "deep_skipped_waiting_with_always_run_skips_others"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    // Set behavior AlwaysRun on system 1
    let d3 = ecs_stepping_deep_queue_set_behavior(d2, 5, 1, 0);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    let r = ecs_stepping_deep_skipped_systems(d4, 5, 4);
    if r.0 != true { panic(91736); };
    // AlwaysRun system 1 not skipped, others skipped
    if ecs_stepping_deep_is_skipped(r.1, 0) != true { panic(91737); };
    if ecs_stepping_deep_is_skipped(r.1, 1) != false { panic(91738); };
    if ecs_stepping_deep_is_skipped(r.1, 2) != true { panic(91739); };
    if ecs_stepping_deep_is_skipped(r.1, 3) != true { panic(91740); };
}

@test "deep_skipped_waiting_with_never_run_also_skips_it"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_queue_set_behavior(d2, 5, 2, 1);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    let r = ecs_stepping_deep_skipped_systems(d4, 5, 4);
    if r.0 != true { panic(91741); };
    // NeverRun system 2 skipped, all others skipped too (Waiting)
    if ecs_stepping_deep_is_skipped(r.1, 0) != true { panic(91742); };
    if ecs_stepping_deep_is_skipped(r.1, 1) != true { panic(91743); };
    if ecs_stepping_deep_is_skipped(r.1, 2) != true { panic(91744); };
    if ecs_stepping_deep_is_skipped(r.1, 3) != true { panic(91745); };
}

@test "deep_skipped_step_runs_only_cursor_system"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_step_frame(d2);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    // action=Step, 4 systems all Continue, cursor at 0
    let r = ecs_stepping_deep_skipped_systems(d4, 5, 4);
    if r.0 != true { panic(91746); };
    // Step: run system at cursor(0), skip all before (none), skip all after
    if ecs_stepping_deep_is_skipped(r.1, 0) != false { panic(91747); };
    if ecs_stepping_deep_is_skipped(r.1, 1) != true { panic(91748); };
    if ecs_stepping_deep_is_skipped(r.1, 2) != true { panic(91749); };
    if ecs_stepping_deep_is_skipped(r.1, 3) != true { panic(91750); };
    // next_system: pos advances past 0 to 1
    if r.2 != 1 { panic(91751); };
    // action should switch to Waiting after step
    if ecs_stepping_deep_action(d4) != 1 { panic(91752); };
}

@test "deep_skipped_step_advances_cursor_each_step"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    // Step frame 1: run system 0
    let d3 = ecs_stepping_deep_step_frame(d2);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    let r1 = ecs_stepping_deep_skipped_systems(d4, 5, 4);
    if ecs_stepping_deep_is_skipped(r1.1, 0) != false { panic(91753); };
    if r1.2 != 1 { panic(91754); };
    // We need begin_frame, then step, then begin_frame to step again
    let d5 = ecs_stepping_deep_step_frame(d4);
    let d6 = ecs_stepping_deep_begin_frame(d5);
    let r2 = ecs_stepping_deep_skipped_systems(d6, 5, 4);
    // Step 2: run system 1, skip others
    if ecs_stepping_deep_is_skipped(r2.1, 0) != true { panic(91755); };
    if ecs_stepping_deep_is_skipped(r2.1, 1) != false { panic(91756); };
    if ecs_stepping_deep_is_skipped(r2.1, 2) != true { panic(91757); };
    if r2.2 != 2 { panic(91758); };
}

@test "deep_skipped_step_with_never_run_skips_it"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_queue_set_behavior(d2, 5, 1, 1);
    let d4 = ecs_stepping_deep_step_frame(d3);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    let r = ecs_stepping_deep_skipped_systems(d5, 5, 4);
    // Step at cursor 0, but system 1 is NeverRun.
    // System 0 runs (not skipped), NeverRun system 1 is skipped.
    if ecs_stepping_deep_is_skipped(r.1, 0) != false { panic(91759); };
    if ecs_stepping_deep_is_skipped(r.1, 1) != true { panic(91760); };
    if ecs_stepping_deep_is_skipped(r.1, 2) != true { panic(91761); };
    if ecs_stepping_deep_is_skipped(r.1, 3) != true { panic(91762); };
    // pos after stepping system 0 goes to 1, but then NeverRun at 1 advances to 2
    if r.2 != 2 { panic(91763); };
}

@test "deep_skipped_continue_runs_all_until_break"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    // Set breakpoint on system 2
    let d3 = ecs_stepping_deep_queue_set_behavior(d2, 5, 2, 2);
    let d4 = ecs_stepping_deep_continue_frame(d3);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    // Continue: run from start(0), Break at system 2 before it (system 2 skipped if > start)
    let r = ecs_stepping_deep_skipped_systems(d5, 5, 4);
    if r.0 != true { panic(91764); };
    // Continue: systems before start(0) skipped (none), system 0 run, 1 run, Break at 2 skipped, 3 skipped (action->Waiting)
    if ecs_stepping_deep_is_skipped(r.1, 0) != false { panic(91765); };
    if ecs_stepping_deep_is_skipped(r.1, 1) != false { panic(91766); };
    if ecs_stepping_deep_is_skipped(r.1, 2) != true { panic(91767); };
    if ecs_stepping_deep_is_skipped(r.1, 3) != true { panic(91768); };
    // next_system: Break stopped at 2, but pos advanced past 0,1 to 2
    if r.2 != 2 { panic(91769); };
}

@test "deep_skipped_continue_at_breakpoint_runs_it"() {
    // When cursor is at a breakpoint and continue is called, that system runs.
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_queue_set_behavior(d2, 5, 1, 2);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    // First step to advance cursor to 1
    let d5 = ecs_stepping_deep_step_frame(d4);
    let d6 = ecs_stepping_deep_begin_frame(d5);
    let r0 = ecs_stepping_deep_skipped_systems(d6, 5, 4);
    // Token Step ran system 0, cursor now at 1
    if r0.2 != 1 { panic(91770); };
    // Now continue from cursor at 1 (which is also a Break)
    let d7 = ecs_stepping_deep_continue_frame(d6);
    let d8 = ecs_stepping_deep_begin_frame(d7);
    let r = ecs_stepping_deep_skipped_systems(d8, 5, 4);
    // Continue from start=1. System 1 is Break. i != start (1==1) -> NOT skipped, runs.
    // Systems after: action stays Continue for now until Break > start.
    // But here we only run the rest until next break (which is system 1 itself).
    if ecs_stepping_deep_is_skipped(r.1, 0) != true { panic(91771); };
    if ecs_stepping_deep_is_skipped(r.1, 1) != false { panic(91772); };
    // After system 1, Continue resumes for 2, 3 until next Break (none here)
    if ecs_stepping_deep_is_skipped(r.1, 2) != false { panic(91773); };
    if ecs_stepping_deep_is_skipped(r.1, 3) != false { panic(91774); };
}

@test "deep_skipped_unknown_schedule_returns_false"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_enable(d);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    let r = ecs_stepping_deep_skipped_systems(d2, 99, 3);
    // schedule 99 not registered; skipped_systems creates order entry + no state -> false
    if r.0 != false { panic(91775); };
}

@test "deep_behavior_for_returns_default_continue"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 3);
    let d2 = ecs_stepping_deep_begin_frame(d1);
    if ecs_stepping_deep_behavior_for(d2, 3, 0) != 3 { panic(91776); };
}

@test "deep_set_behavior_via_update_queue"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 3);
    let d2 = ecs_stepping_deep_queue_set_behavior(d1, 3, 1, 0);
    let d3 = ecs_stepping_deep_begin_frame(d2);
    if ecs_stepping_deep_behavior_for(d3, 3, 1) != 0 { panic(91777); };
}

@test "deep_clear_behavior_via_update_queue"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 3);
    let d2 = ecs_stepping_deep_queue_set_behavior(d1, 3, 1, 0);
    let d3 = ecs_stepping_deep_begin_frame(d2);
    if ecs_stepping_deep_behavior_for(d3, 3, 1) != 0 { panic(91778); };
    let d4 = ecs_stepping_deep_queue_clear_behavior(d3, 3, 1);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    if ecs_stepping_deep_behavior_for(d5, 3, 1) != 3 { panic(91779); };
}

@test "deep_clear_schedule_clears_behaviors"() {
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 3);
    let d2 = ecs_stepping_deep_queue_set_behavior(d1, 3, 0, 0);
    let d3 = ecs_stepping_deep_queue_set_behavior(d2, 3, 1, 1);
    let d4 = ecs_stepping_deep_begin_frame(d3);
    if ecs_stepping_deep_behavior_for(d4, 3, 0) != 0 { panic(91780); };
    if ecs_stepping_deep_behavior_for(d4, 3, 1) != 1 { panic(91781); };
    let d5 = ecs_stepping_deep_queue_clear_schedule(d4, 3);
    let d6 = ecs_stepping_deep_begin_frame(d5);
    if ecs_stepping_deep_behavior_for(d6, 3, 0) != 3 { panic(91782); };
    if ecs_stepping_deep_behavior_for(d6, 3, 1) != 3 { panic(91783); };
}

@test "deep_next_frame_resets_action_to_waiting_when_enabled"() {
    // After step frame, begin_frame resets action to Waiting before applying update
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_begin_frame(d2);
    let d4 = ecs_stepping_deep_step_frame(d3);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    if ecs_stepping_deep_action(d5) != 3 { panic(91784); };
    // Now call begin_frame again without new updates: resets to Waiting
    let d6 = ecs_stepping_deep_begin_frame(d5);
    if ecs_stepping_deep_action(d6) != 1 { panic(91785); };
}

@test "deep_step_to_end_advances_schedule_cursor"() {
    // When all systems in a schedule are stepped through, next_system=None,
    // cursor advances to next schedule.
    let d = ecs_stepping_deep_new();
    let d1 = ecs_stepping_deep_queue_add_schedule(d, 5);
    let d2 = ecs_stepping_deep_enable(d1);
    let d3 = ecs_stepping_deep_begin_frame(d2);
    // 2 systems
    // Step 1: run system 0, next=1
    let d4 = ecs_stepping_deep_step_frame(d3);
    let d5 = ecs_stepping_deep_begin_frame(d4);
    let r1 = ecs_stepping_deep_skipped_systems(d5, 5, 2);
    if r1.2 != 1 { panic(91786); };
    // Step 2: run system 1, next=None (-1)
    let d6 = ecs_stepping_deep_step_frame(d5);
    let d7 = ecs_stepping_deep_begin_frame(d6);
    let r2 = ecs_stepping_deep_skipped_systems(d7, 5, 2);
    if r2.2 != -1 { panic(91787); };
    // cursor should advance to schedule 1 (past end), cursor returns false
    let cr = ecs_stepping_deep_cursor(d7);
    if cr.0 != false { panic(91788); };
}
