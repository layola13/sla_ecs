@import "lib/entity_hash_set_ops.sla"

// Isolated tests for lib/entity_hash_set_ops.sla.
// Bevy reference: bevy_ecs/src/entity/hash_set.rs

fn make_set_a() -> EcsEntityHashSetOps {
    let v = Vec::new();
    v.push(1);
    v.push(2);
    v.push(3);
    return ecs_ehs_ops_from_vec(v);
}

fn make_set_b() -> EcsEntityHashSetOps {
    let v = Vec::new();
    v.push(3);
    v.push(4);
    v.push(5);
    return ecs_ehs_ops_from_vec(v);
}

@test "entity hash set ops from vec dedups"() {
    let v = Vec::new();
    v.push(7);
    v.push(7);
    v.push(8);
    let s = ecs_ehs_ops_from_vec(v);
    if ecs_ehs_ops_len(s) != 2 { panic(92485); };
    if ecs_ehs_ops_contains(s, 7) != true { panic(92486); };
}

@test "entity hash set ops extend dedups"() {
    let s = make_set_a();
    let v = Vec::new();
    v.push(2);
    v.push(6);
    let out = ecs_ehs_ops_extend(s, v);
    if ecs_ehs_ops_len(out) != 4 { panic(92487); };
    if ecs_ehs_ops_contains(out, 6) != true { panic(92488); };
}

@test "entity hash set ops union"() {
    let out = ecs_ehs_ops_union(make_set_a(), make_set_b());
    if ecs_ehs_ops_len(out) != 5 { panic(92489); };
    if ecs_ehs_ops_contains(out, 1) != true { panic(92490); };
    if ecs_ehs_ops_contains(out, 5) != true { panic(92491); };
}

@test "entity hash set ops intersection"() {
    let out = ecs_ehs_ops_intersection(make_set_a(), make_set_b());
    if ecs_ehs_ops_len(out) != 1 { panic(92492); };
    if ecs_ehs_ops_contains(out, 3) != true { panic(92493); };
}

@test "entity hash set ops difference"() {
    let out = ecs_ehs_ops_difference(make_set_a(), make_set_b());
    if ecs_ehs_ops_len(out) != 2 { panic(92494); };
    if ecs_ehs_ops_contains(out, 1) != true { panic(92495); };
    if ecs_ehs_ops_contains(out, 3) != false { panic(92496); };
}

@test "entity hash set ops symmetric difference"() {
    let out = ecs_ehs_ops_symmetric_difference(make_set_a(), make_set_b());
    if ecs_ehs_ops_len(out) != 4 { panic(92497); };
    if ecs_ehs_ops_contains(out, 2) != true { panic(92498); };
    if ecs_ehs_ops_contains(out, 4) != true { panic(92499); };
    if ecs_ehs_ops_contains(out, 3) != false { panic(92500); };
}

@test "entity hash set ops assign variants"() {
    let a = make_set_a();
    let b = make_set_b();
    if ecs_ehs_ops_len(ecs_ehs_ops_bitand_assign(a, b)) != 1 { panic(92501); };
    if ecs_ehs_ops_len(ecs_ehs_ops_bitor_assign(make_set_a(), make_set_b())) != 5 { panic(92502); };
    if ecs_ehs_ops_len(ecs_ehs_ops_bitxor_assign(make_set_a(), make_set_b())) != 4 { panic(92503); };
    if ecs_ehs_ops_len(ecs_ehs_ops_sub_assign(make_set_a(), make_set_b())) != 2 { panic(92504); };
}

@test "entity hash set ops subset superset disjoint"() {
    let subset_values = Vec::new();
    subset_values.push(1);
    subset_values.push(2);
    let subset = ecs_ehs_ops_from_vec(subset_values);
    let a = make_set_a();
    let b = make_set_b();
    if ecs_ehs_ops_is_subset(subset, a) != true { panic(92505); };
    if ecs_ehs_ops_is_superset(a, subset) != true { panic(92506); };
    if ecs_ehs_ops_is_disjoint(subset, b) != true { panic(92507); };
}

@test "entity hash set ops iter count"() {
    let a = make_set_a();
    if ecs_ehs_ops_iter_count(a) != 3 { panic(92508); };
}

@test "entity hash set ops into iter sum"() {
    let a = make_set_a();
    if ecs_ehs_ops_into_iter_sum(a) != 6 { panic(92509); };
}

@test "entity hash set ops drain empties set"() {
    let a = make_set_a();
    let r = ecs_ehs_ops_drain(a);
    if ecs_ehs_ops_len(r.set) != 0 { panic(92510); };
    if ecs_ehs_vec_len(r.drained) != 3 { panic(92511); };
    if ecs_ehs_vec_at(r.drained, 0) != 1 { panic(92512); };
}

@test "entity hash set ops extract even"() {
    let values = Vec::new();
    values.push(1);
    values.push(2);
    values.push(3);
    values.push(4);
    let set = ecs_ehs_ops_from_vec(values);
    let r = ecs_ehs_ops_extract_if(set, 0, 0);
    if ecs_ehs_ops_len(r.set) != 2 { panic(92513); };
    if ecs_ehs_vec_len(r.extracted) != 2 { panic(92514); };
    if ecs_ehs_ops_contains(r.set, 2) != false { panic(92515); };
}

@test "entity hash set ops extract greater than threshold"() {
    let set = make_set_b();
    let r = ecs_ehs_ops_extract_if(set, 1, 4);
    if ecs_ehs_vec_len(r.extracted) != 1 { panic(92516); };
    if ecs_ehs_vec_at(r.extracted, 0) != 5 { panic(92517); };
    if ecs_ehs_ops_contains(r.set, 4) != true { panic(92518); };
}

@test "entity hash set ops at bounds"() {
    let a = make_set_a();
    if ecs_ehs_ops_at(a, 0) != 1 { panic(92519); };
    if ecs_ehs_ops_at(a, -1) != -1 { panic(92520); };
    if ecs_ehs_ops_at(a, 9) != -1 { panic(92521); };
}

@test "entity hash set ops empty predicates"() {
    let empty = ecs_ehs_ops_new();
    if ecs_ehs_ops_is_empty(empty) != true { panic(92522); };
    if ecs_ehs_ops_len(ecs_ehs_ops_union(empty, make_set_a())) != 3 { panic(92523); };
}

@test "entity hash set ops intersection empty when disjoint"() {
    let left_values = Vec::new();
    left_values.push(10);
    let right_values = Vec::new();
    right_values.push(20);
    let left = ecs_ehs_ops_from_vec(left_values);
    let right = ecs_ehs_ops_from_vec(right_values);
    if ecs_ehs_ops_len(ecs_ehs_ops_intersection(left, right)) != 0 { panic(92524); };
}

@test "entity hash set ops difference from empty"() {
    let empty = ecs_ehs_ops_new();
    if ecs_ehs_ops_len(ecs_ehs_ops_difference(empty, make_set_a())) != 0 { panic(92525); };
}

@test "entity hash set ops symmetric difference self empty"() {
    let a = make_set_a();
    if ecs_ehs_ops_len(ecs_ehs_ops_symmetric_difference(a, a)) != 0 { panic(92526); };
}

