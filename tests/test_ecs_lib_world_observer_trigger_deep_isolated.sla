@import "lib/world_observer_trigger_deep.sla"

// Batch 284: world_observer_trigger deep (src/observer/mod.rs World trigger API).
// panic codes: 122800 – 122999.

@test "new_empty_world"() {
    let w = ecs_wot_world_deep_new();
    if ecs_wot_world_deep_count(w) != 0 { panic(122800); };
    if ecs_wot_world_deep_last_trigger_id(w) != 0 { panic(122801); };
    if ecs_wot_world_deep_next_entity(w) != 1 { panic(122802); };
}

@test "add_observer_spawns_entities"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 5, -1, 0, false, 0);
    if ecs_wot_add_deep_ok(a) != true { panic(122810); };
    if ecs_wot_add_deep_entity(a) != 1 { panic(122811); };
    w = ecs_wot_add_deep_world(a);
    if ecs_wot_world_deep_count(w) != 1 { panic(122812); };
    let a2 = ecs_wot_world_deep_add_observer(w, 6, 99, 0, false, 0);
    if ecs_wot_add_deep_entity(a2) != 2 { panic(122813); };
    w = ecs_wot_add_deep_world(a2);
    if ecs_wot_world_deep_count(w) != 2 { panic(122814); };
    let o1 = ecs_wot_world_deep_observer_at(w, 1);
    if ecs_wot_obs_deep_target(o1) != 99 { panic(122815); };
}

@test "trigger_fires_matching_global"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 5, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a);
    let r = ecs_wot_world_deep_trigger(w, 5);
    if ecs_wot_run_deep_fired(r) != 1 { panic(122820); };
    if ecs_wot_run_deep_last_trigger_id(r) != 1 { panic(122821); };
    if ecs_wot_run_deep_first_err(r) != -1 { panic(122822); };
    w = ecs_wot_run_deep_world(r);
    if ecs_wot_obs_deep_runs(ecs_wot_world_deep_observer_at(w, 0)) != 1 { panic(122823); };
}

@test "trigger_skips_non_matching_event"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 5, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a);
    let r = ecs_wot_world_deep_trigger(w, 99);
    if ecs_wot_run_deep_fired(r) != 0 { panic(122830); };
    if ecs_wot_run_deep_last_trigger_id(r) != 1 { panic(122831); };
    w = ecs_wot_run_deep_world(r);
    if ecs_wot_obs_deep_runs(ecs_wot_world_deep_observer_at(w, 0)) != 0 { panic(122832); };
}

@test "entity_target_matching"() {
    let w = ecs_wot_world_deep_new();
    // global watches all
    let a0 = ecs_wot_world_deep_add_observer(w, 1, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a0);
    // entity-specific
    let a1 = ecs_wot_world_deep_add_observer(w, 1, 42, 0, false, 0);
    w = ecs_wot_add_deep_world(a1);
    let a2 = ecs_wot_world_deep_add_observer(w, 1, 7, 0, false, 0);
    w = ecs_wot_add_deep_world(a2);
    let r = ecs_wot_world_deep_trigger_entity(w, 1, 42, 0);
    // global + entity 42
    if ecs_wot_run_deep_fired(r) != 2 { panic(122840); };
    w = ecs_wot_run_deep_world(r);
    if ecs_wot_obs_deep_runs(ecs_wot_world_deep_observer_at(w, 0)) != 1 { panic(122841); };
    if ecs_wot_obs_deep_runs(ecs_wot_world_deep_observer_at(w, 1)) != 1 { panic(122842); };
    if ecs_wot_obs_deep_runs(ecs_wot_world_deep_observer_at(w, 2)) != 0 { panic(122843); };
}

@test "payload_mutation_on_trigger_ref"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 3, -1, 0, true, 5);
    w = ecs_wot_add_deep_world(a);
    let a2 = ecs_wot_world_deep_add_observer(w, 3, -1, 0, true, 2);
    w = ecs_wot_add_deep_world(a2);
    let r = ecs_wot_world_deep_trigger_ref(w, 3, 10);
    if ecs_wot_run_deep_payload_mutated(r) != true { panic(122850); };
    if ecs_wot_run_deep_payload(r) != 17 { panic(122851); };
    if ecs_wot_run_deep_fired(r) != 2 { panic(122852); };
    w = ecs_wot_run_deep_world(r);
    if ecs_wot_world_deep_last_payload(w) != 17 { panic(122853); };
}

@test "first_error_handler_recorded"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 8, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a);
    let a2 = ecs_wot_world_deep_add_observer(w, 8, -1, 77, false, 0);
    w = ecs_wot_add_deep_world(a2);
    let a3 = ecs_wot_world_deep_add_observer(w, 8, -1, 88, false, 0);
    w = ecs_wot_add_deep_world(a3);
    let r = ecs_wot_world_deep_trigger(w, 8);
    if ecs_wot_run_deep_fired(r) != 3 { panic(122860); };
    if ecs_wot_run_deep_first_err(r) != 77 { panic(122861); };
}

@test "trigger_with_and_ref_with_caller"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 2, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a);
    let r = ecs_wot_world_deep_trigger_with(w, 2, 42);
    if ecs_wot_run_deep_trigger_data(r) != 42 { panic(122870); };
    if ecs_wot_run_deep_payload(r) != 42 { panic(122871); };
    w = ecs_wot_run_deep_world(r);
    let r2 = ecs_wot_world_deep_trigger_ref_with_caller(w, 2, 1, 9, 12345);
    if ecs_wot_run_deep_fired(r2) != 1 { panic(122872); };
    w = ecs_wot_run_deep_world(r2);
    if ecs_wot_world_deep_last_caller(w) != 12345 { panic(122873); };
    if ecs_wot_world_deep_last_event_key(w) != 2 { panic(122874); };
    if ecs_wot_world_deep_last_trigger_data(w) != 9 { panic(122875); };
    if ecs_wot_world_deep_last_trigger_id(w) != 2 { panic(122876); };
}

@test "trigger_ref_with_returns_mutated_payload"() {
    let w = ecs_wot_world_deep_new();
    let a = ecs_wot_world_deep_add_observer(w, 4, -1, 0, true, 10);
    w = ecs_wot_add_deep_world(a);
    let r = ecs_wot_world_deep_trigger_ref_with(w, 4, 100, 7);
    if ecs_wot_run_deep_payload(r) != 110 { panic(122880); };
    if ecs_wot_run_deep_trigger_data(r) != 7 { panic(122881); };
    if ecs_wot_run_deep_payload_mutated(r) != true { panic(122882); };
}

@test "capacity_limit_and_multiple_triggers"() {
    let w = ecs_wot_world_deep_new();
    let a0 = ecs_wot_world_deep_add_observer(w, 1, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a0);
    let a1 = ecs_wot_world_deep_add_observer(w, 1, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a1);
    let a2 = ecs_wot_world_deep_add_observer(w, 1, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a2);
    let a3 = ecs_wot_world_deep_add_observer(w, 1, -1, 0, false, 0);
    w = ecs_wot_add_deep_world(a3);
    let a4 = ecs_wot_world_deep_add_observer(w, 1, -1, 0, false, 0);
    if ecs_wot_add_deep_ok(a4) != false { panic(122890); };
    if ecs_wot_world_deep_count(w) != 4 { panic(122891); };
    let r1 = ecs_wot_world_deep_trigger(w, 1);
    if ecs_wot_run_deep_fired(r1) != 4 { panic(122892); };
    w = ecs_wot_run_deep_world(r1);
    let r2 = ecs_wot_world_deep_trigger(w, 1);
    if ecs_wot_run_deep_last_trigger_id(r2) != 2 { panic(122893); };
    w = ecs_wot_run_deep_world(r2);
    if ecs_wot_obs_deep_runs(ecs_wot_world_deep_observer_at(w, 0)) != 2 { panic(122894); };
}
