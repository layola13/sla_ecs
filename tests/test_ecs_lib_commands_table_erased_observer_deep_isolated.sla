// Isolated deep tests for lib/commands_table_erased_observer_deep.sla (Batch 366).
// Observer-aware deferred command queue for TableErasedObserverWorld.
// panic codes: 139200 - 139399.

@import "lib/commands_table_erased_observer_deep.sla"

const TYPE_POS: i32 = 411;
const TYPE_VEL: i32 = 412;
const TYPE_PING: i32 = 999;

@test "TblObsCommands new empty and all side counts zero"() {
    let c = ecs_tbl_obs_commands_new();
    if ecs_tbl_obs_commands_len(c) != 0 { panic(139200); };
    if ecs_tbl_obs_commands_pcomp_count(c) != 0 { panic(139201); };
    if ecs_tbl_obs_commands_pres_count(c) != 0 { panic(139202); };
    if ecs_tbl_obs_commands_pmsg_count(c) != 0 { panic(139203); };
    if ecs_tbl_obs_commands_pcev_count(c) != 0 { panic(139204); };
    if ecs_tbl_obs_commands_kind_at(c, 0) != 0 { panic(139205); };
}

@test "insert enqueues INSERT_COMPONENT with type_id and scalar value"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_insert(c0, 7, 11, TYPE_POS, 50);
    if ecs_tbl_obs_commands_len(c1) != 1 { panic(139210); };
    if ecs_tbl_obs_commands_kind_at(c1, 0) != ECS_CMD_TBL_OBS_INSERT_COMPONENT { panic(139211); };
    if ecs_tbl_obs_commands_entity_at(c1, 0) != 7 { panic(139212); };
    if ecs_tbl_obs_commands_cmp_at(c1, 0) != 11 { panic(139213); };
    if ecs_tbl_obs_commands_idx_at(c1, 0) != 0 { panic(139214); };
    if ecs_tbl_obs_commands_pcomp_count(c1) != 1 { panic(139215); };
    if ecs_tbl_obs_commands_resolve_value(c1, 0) != 50 { panic(139216); };
    if ecs_tbl_obs_commands_resolve_type(c1, 0) != TYPE_POS { panic(139217); };
}

@test "remove enqueues REMOVE_COMPONENT with no side payload"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_remove(c0, 9, 22);
    if ecs_tbl_obs_commands_len(c1) != 1 { panic(139220); };
    if ecs_tbl_obs_commands_kind_at(c1, 0) != ECS_CMD_TBL_OBS_REMOVE_COMPONENT { panic(139221); };
    if ecs_tbl_obs_commands_entity_at(c1, 0) != 9 { panic(139222); };
    if ecs_tbl_obs_commands_cmp_at(c1, 0) != 22 { panic(139223); };
    if ecs_tbl_obs_commands_idx_at(c1, 0) != -1 { panic(139224); };
    if ecs_tbl_obs_commands_resolve_value(c1, 0) != 0 { panic(139225); };
}

@test "despawn enqueues DESPAWN with no side payload"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_despawn(c0, 9);
    if ecs_tbl_obs_commands_len(c1) != 1 { panic(139230); };
    if ecs_tbl_obs_commands_kind_at(c1, 0) != ECS_CMD_TBL_OBS_DESPAWN { panic(139231); };
    if ecs_tbl_obs_commands_entity_at(c1, 0) != 9 { panic(139232); };
    if ecs_tbl_obs_commands_cmp_at(c1, 0) != 0 { panic(139233); };
    if ecs_tbl_obs_commands_idx_at(c1, 0) != -1 { panic(139234); };
    if ecs_tbl_obs_commands_resolve_value(c1, 0) != 0 { panic(139235); };
}

@test "insert_resource and write_message enqueue side payloads and resolve"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_insert_resource(c0, 888);
    if ecs_tbl_obs_commands_kind_at(c1, 0) != ECS_CMD_TBL_OBS_INSERT_RESOURCE { panic(139240); };
    if ecs_tbl_obs_commands_pres_count(c1) != 1 { panic(139241); };
    if ecs_tbl_obs_commands_resolve_value(c1, 0) != 888 { panic(139242); };
    let c2 = ecs_tbl_obs_commands_write_message(c1, 42);
    if ecs_tbl_obs_commands_kind_at(c2, 1) != ECS_CMD_TBL_OBS_WRITE_MESSAGE { panic(139243); };
    if ecs_tbl_obs_commands_pmsg_count(c2) != 1 { panic(139244); };
    if ecs_tbl_obs_commands_resolve_value(c2, 1) != 42 { panic(139245); };
}

@test "trigger enqueues TRIGGER_EVENT with no target entity and side-array payload"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_trigger(c0, TYPE_PING, 7);
    if ecs_tbl_obs_commands_len(c1) != 1 { panic(139250); };
    if ecs_tbl_obs_commands_kind_at(c1, 0) != ECS_CMD_TBL_OBS_TRIGGER_EVENT { panic(139251); };
    if ecs_tbl_obs_commands_entity_at(c1, 0) != 0 { panic(139252); };
    if ecs_tbl_obs_commands_idx_at(c1, 0) != 0 { panic(139253); };
    if ecs_tbl_obs_commands_pcev_count(c1) != 1 { panic(139254); };
    if ecs_tbl_obs_commands_resolve_value(c1, 0) != 7 { panic(139255); };
    if ecs_tbl_obs_commands_resolve_type(c1, 0) != TYPE_PING { panic(139256); };
}

@test "trigger_entity carries target entity in the command slot"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_trigger_entity(c0, 13, TYPE_PING, 9);
    if ecs_tbl_obs_commands_len(c1) != 1 { panic(139260); };
    if ecs_tbl_obs_commands_kind_at(c1, 0) != ECS_CMD_TBL_OBS_TRIGGER_EVENT { panic(139261); };
    if ecs_tbl_obs_commands_entity_at(c1, 0) != 13 { panic(139262); };
    // shallow `trigger_entity` sets command.entity = entity; deep mirrors
    if ecs_tbl_obs_commands_resolve_value(c1, 0) != 9 { panic(139263); };
    if ecs_tbl_obs_commands_resolve_type(c1, 0) != TYPE_PING { panic(139264); };
}

@test "count_by_kind categorizes mixed queue of all six kinds"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_insert(c0, 1, 10, TYPE_POS, 1);
    let c2 = ecs_tbl_obs_commands_remove(c1, 1, 10);
    let c3 = ecs_tbl_obs_commands_despawn(c2, 2);
    let c4 = ecs_tbl_obs_commands_insert_resource(c3, 9);
    let c5 = ecs_tbl_obs_commands_write_message(c4, 3);
    let c6 = ecs_tbl_obs_commands_trigger(c5, TYPE_PING, 6);
    let c7 = ecs_tbl_obs_commands_trigger_entity(c6, 4, TYPE_VEL, 7);
    if ecs_tbl_obs_commands_count_by_kind(c7, ECS_CMD_TBL_OBS_INSERT_COMPONENT) != 1 { panic(139270); };
    if ecs_tbl_obs_commands_count_by_kind(c7, ECS_CMD_TBL_OBS_REMOVE_COMPONENT) != 1 { panic(139271); };
    if ecs_tbl_obs_commands_count_by_kind(c7, ECS_CMD_TBL_OBS_DESPAWN) != 1 { panic(139272); };
    if ecs_tbl_obs_commands_count_by_kind(c7, ECS_CMD_TBL_OBS_INSERT_RESOURCE) != 1 { panic(139273); };
    if ecs_tbl_obs_commands_count_by_kind(c7, ECS_CMD_TBL_OBS_WRITE_MESSAGE) != 1 { panic(139274); };
    if ecs_tbl_obs_commands_count_by_kind(c7, ECS_CMD_TBL_OBS_TRIGGER_EVENT) != 2 { panic(139275); };
    if ecs_tbl_obs_commands_len(c7) != 7 { panic(139276); };
}

@test "resolve_value/type across mixed kinds respects side-array mapping"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = ecs_tbl_obs_commands_insert(c0, 1, 10, TYPE_POS, 11);
    let c2 = ecs_tbl_obs_commands_trigger(c1, TYPE_PING, 22);
    let c3 = ecs_tbl_obs_commands_write_message(c2, 33);
    let c4 = ecs_tbl_obs_commands_despawn(c3, 5);
    let c5 = ecs_tbl_obs_commands_insert_resource(c4, 44);
    let c6 = ecs_tbl_obs_commands_remove(c5, 2, 8);
    if ecs_tbl_obs_commands_resolve_value(c6, 0) != 11 { panic(139280); };
    if ecs_tbl_obs_commands_resolve_type(c6, 0) != TYPE_POS { panic(139281); };
    if ecs_tbl_obs_commands_resolve_value(c6, 1) != 22 { panic(139282); };
    if ecs_tbl_obs_commands_resolve_type(c6, 1) != TYPE_PING { panic(139283); };
    if ecs_tbl_obs_commands_resolve_value(c6, 2) != 33 { panic(139284); };
    if ecs_tbl_obs_commands_resolve_value(c6, 3) != 0 { panic(139285); };
    if ecs_tbl_obs_commands_resolve_value(c6, 4) != 44 { panic(139286); };
    if ecs_tbl_obs_commands_resolve_value(c6, 5) != 0 { panic(139287); };
    if ecs_tbl_obs_commands_pcomp_count(c6) != 1 { panic(139288); };
    if ecs_tbl_obs_commands_pcev_count(c6) != 1 { panic(139289); };
}

@test "queue cap-8 rejects and clear resets all side counts"() {
    let c0 = ecs_tbl_obs_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_tbl_obs_commands_insert(c1, i, i, TYPE_POS, 100 + i);
        i = i + 1;
    }
    if ecs_tbl_obs_commands_len(c1) != 8 { panic(139290); };
    if ecs_tbl_obs_commands_pcomp_count(c1) != 8 { panic(139291); };
    let c2 = ecs_tbl_obs_commands_insert(c1, 99, 99, 999, 999);
    if ecs_tbl_obs_commands_len(c2) != 8 { panic(139292); };
    let c3 = ecs_tbl_obs_commands_despawn(c2, 99);
    if ecs_tbl_obs_commands_len(c3) != 8 { panic(139293); };
    let c4 = ecs_tbl_obs_commands_clear(c3);
    if ecs_tbl_obs_commands_len(c4) != 0 { panic(139294); };
    if ecs_tbl_obs_commands_pcomp_count(c4) != 0 { panic(139295); };
    if ecs_tbl_obs_commands_pres_count(c4) != 0 { panic(139296); };
    if ecs_tbl_obs_commands_pmsg_count(c4) != 0 { panic(139297); };
    if ecs_tbl_obs_commands_pcev_count(c4) != 0 { panic(139298); };
}
