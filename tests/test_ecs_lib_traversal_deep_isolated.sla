@import "lib/traversal_deep.sla"

// Batch 222: traversal deep (src/traversal.rs).
// panic codes: 110400 – 110599.

@test "unit_traversal_none"() {
    let t = ecs_trav_none_new();
    let r = ecs_trav_none_traverse(t, 99);
    if r.0 != false { panic(110400); };
    if r.1 != 0 { panic(110401); };
}

@test "relationship_traversal_some"() {
    let t = ecs_trav_rel_new(42);
    if ecs_trav_rel_get(t) != 42 { panic(110410); };
    let r = ecs_trav_rel_traverse(t, 0);
    if r.0 != true { panic(110411); };
    if r.1 != 42 { panic(110412); };
    // data ignored
    let r2 = ecs_trav_rel_traverse(t, 7);
    if r2.1 != 42 { panic(110413); };
}

@test "data_dependent_traversal"() {
    let t = ecs_trav_data_new(5);
    let a = ecs_trav_data_traverse(t, 0);
    if a.0 != false { panic(110420); };
    let b = ecs_trav_data_traverse(t, 1);
    if b.0 != true { panic(110421); };
    if b.1 != 5 { panic(110422); };
}

@test "follow_chain"() {
    let g = ecs_trav_graph_new();
    g = ecs_trav_graph_set(g, 0, 1);
    g = ecs_trav_graph_set(g, 1, 2);
    g = ecs_trav_graph_set(g, 2, 3);
    let w = ecs_trav_follow(g, 0, 10);
    if ecs_trav_walk_n(w) != 3 { panic(110430); };
    if ecs_trav_walk_at(w, 0) != 1 { panic(110431); };
    if ecs_trav_walk_at(w, 1) != 2 { panic(110432); };
    if ecs_trav_walk_at(w, 2) != 3 { panic(110433); };
    if ecs_trav_walk_end(w) != true { panic(110434); };
}

@test "follow_max_depth"() {
    let g = ecs_trav_graph_new();
    g = ecs_trav_graph_set(g, 0, 1);
    g = ecs_trav_graph_set(g, 1, 2);
    g = ecs_trav_graph_set(g, 2, 3);
    let w = ecs_trav_follow(g, 0, 2);
    if ecs_trav_walk_n(w) != 2 { panic(110440); };
    if ecs_trav_walk_depth(w) != true { panic(110441); };
}

@test "follow_cycle_detection"() {
    let g = ecs_trav_graph_new();
    g = ecs_trav_graph_set(g, 0, 1);
    g = ecs_trav_graph_set(g, 1, 2);
    g = ecs_trav_graph_set(g, 2, 0);
    let w = ecs_trav_follow(g, 0, 10);
    // path 1,2 then cycle back to 0
    if ecs_trav_walk_n(w) != 2 { panic(110450); };
    if ecs_trav_walk_cycle(w) != true { panic(110451); };
}

@test "follow_empty_edge"() {
    let g = ecs_trav_graph_new();
    let w = ecs_trav_follow(g, 0, 5);
    if ecs_trav_walk_n(w) != 0 { panic(110460); };
    if ecs_trav_walk_end(w) != true { panic(110461); };
}

@test "propagate_step"() {
    let a = ecs_trav_propagate_step(true, 9, true);
    if a.0 != true { panic(110470); };
    if a.1 != 9 { panic(110471); };
    let b = ecs_trav_propagate_step(true, 9, false);
    if b.0 != false { panic(110472); };
    let c = ecs_trav_propagate_step(false, 9, true);
    if c.0 != false { panic(110473); };
}

@test "graph_set_get"() {
    let g = ecs_trav_graph_new();
    g = ecs_trav_graph_set(g, 3, 7);
    if ecs_trav_graph_next(g, 3) != 7 { panic(110480); };
    if ecs_trav_graph_next(g, 0) != -1 { panic(110481); };
}

@test "walk_contains"() {
    let g = ecs_trav_graph_new();
    g = ecs_trav_graph_set(g, 0, 5);
    g = ecs_trav_graph_set(g, 5, 6);
    let w = ecs_trav_follow(g, 0, 10);
    if ecs_trav_walk_contains(w, 5) != true { panic(110490); };
    if ecs_trav_walk_contains(w, 9) != false { panic(110491); };
}

@test "self_loop_cycle"() {
    let g = ecs_trav_graph_set(ecs_trav_graph_new(), 1, 1);
    let w = ecs_trav_follow(g, 1, 5);
    if ecs_trav_walk_n(w) != 0 { panic(110500); };
    if ecs_trav_walk_cycle(w) != true { panic(110501); };
}

@test "long_chain_eight"() {
    let g = ecs_trav_graph_new();
    g = ecs_trav_graph_set(g, 0, 1);
    g = ecs_trav_graph_set(g, 1, 2);
    g = ecs_trav_graph_set(g, 2, 3);
    g = ecs_trav_graph_set(g, 3, 4);
    g = ecs_trav_graph_set(g, 4, 5);
    g = ecs_trav_graph_set(g, 5, 6);
    g = ecs_trav_graph_set(g, 6, 7);
    let w = ecs_trav_follow(g, 0, 10);
    if ecs_trav_walk_n(w) != 7 { panic(110510); };
    if ecs_trav_walk_at(w, 6) != 7 { panic(110511); };
    if ecs_trav_walk_end(w) != true { panic(110512); };
}
