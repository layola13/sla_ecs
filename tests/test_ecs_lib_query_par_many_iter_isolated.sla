@import "lib/query_par_many_iter.sla"

// Isolated tests for lib/query_par_many_iter.sla — QueryParManyIter + QueryParManyUniqueIter
// (batching_strategy/for_each/for_each_init + len/is_empty/batch_count). Bevy reference:
// src/query/par_iter.rs (gaps not in lib/query_par_iter.sla which covers QueryParIter only).

const FN_A: i32 = 1;
const FN_B: i32 = 2;
const INIT_5: i64 = 5;

@test "par_many_new_defaults"() {
    let p = ecs_query_par_many_iter_new(10);
    if ecs_query_par_many_iter_len(p) != 10 { panic(91768); };
    if ecs_query_par_many_iter_batch_size(p) != 128 { panic(91769); };
    if ecs_query_par_many_iter_is_empty(p) { panic(91770); };
    if ecs_query_par_many_iter_processed(p) != 0 { panic(91771); };
}

@test "par_many_new_empty"() {
    let p = ecs_query_par_many_iter_new(0);
    if !ecs_query_par_many_iter_is_empty(p) { panic(91772); };
}

@test "par_many_batching_strategy"() {
    let p0 = ecs_query_par_many_iter_new(10);
    let p1 = ecs_query_par_many_iter_batching_strategy(p0, 16);
    if ecs_query_par_many_iter_batch_size(p1) != 16 { panic(91773); };
    if ecs_query_par_many_iter_len(p1) != 10 { panic(91774); };
}

@test "par_many_batch_count_exact"() {
    let p = ecs_query_par_many_iter_new(10);
    let p16 = ecs_query_par_many_iter_batching_strategy(p, 5);
    if ecs_query_par_many_iter_batch_count(p16) != 2 { panic(91775); };
}

@test "par_many_batch_count_rounds_up"() {
    let p = ecs_query_par_many_iter_new(7);
    let p2 = ecs_query_par_many_iter_batching_strategy(p, 3);
    if ecs_query_par_many_iter_batch_count(p2) != 3 { panic(91776); };
}

@test "par_many_batch_count_default_128"() {
    let p = ecs_query_par_many_iter_new(130);
    if ecs_query_par_many_iter_batch_count(p) != 2 { panic(91777); };
}

@test "par_many_batch_count_zero_batch_size"() {
    let p = ecs_query_par_many_iter_new(5);
    let p0 = ecs_query_par_many_iter_batching_strategy(p, 0);
    if ecs_query_par_many_iter_batch_count(p0) != 0 { panic(91778); };
}

@test "par_many_for_each_returns_processed_count"() {
    let p = ecs_query_par_many_iter_new(8);
    let cnt = ecs_query_par_many_iter_for_each(p, FN_A);
    if cnt != 8 { panic(91779); };
}

@test "par_many_for_each_negative_func_id"() {
    let p = ecs_query_par_many_iter_new(4);
    let cnt = ecs_query_par_many_iter_for_each(p, -1);
    if cnt != 4 { panic(91780); };
}

@test "par_many_for_each_init"() {
    let p = ecs_query_par_many_iter_new(10);
    let res = ecs_query_par_many_iter_for_each_init(p, INIT_5, FN_B);
    if ecs_par_many_fei_processed(res) != 10 { panic(91781); };
    if ecs_par_many_fei_accumulator(res) != 15 { panic(91782); };
}

@test "par_many_for_each_init_zero_items"() {
    let p = ecs_query_par_many_iter_new(0);
    let res = ecs_query_par_many_iter_for_each_init(p, INIT_5, FN_B);
    if ecs_par_many_fei_processed(res) != 0 { panic(91783); };
    if ecs_par_many_fei_accumulator(res) != 5 { panic(91784); };
}

// === QueryParManyUniqueIter ===

@test "par_many_unique_new_defaults"() {
    let p = ecs_query_par_many_unique_iter_new(12);
    if ecs_query_par_many_unique_iter_len(p) != 12 { panic(91785); };
    if ecs_query_par_many_unique_iter_batch_size(p) != 128 { panic(91786); };
    if ecs_query_par_many_unique_iter_is_empty(p) { panic(91787); };
    if ecs_query_par_many_unique_iter_processed(p) != 0 { panic(91788); };
}

@test "par_many_unique_new_empty"() {
    let p = ecs_query_par_many_unique_iter_new(0);
    if !ecs_query_par_many_unique_iter_is_empty(p) { panic(91789); };
}

@test "par_many_unique_batching_strategy"() {
    let p0 = ecs_query_par_many_unique_iter_new(9);
    let p1 = ecs_query_par_many_unique_iter_batching_strategy(p0, 4);
    if ecs_query_par_many_unique_iter_batch_size(p1) != 4 { panic(91790); };
}

@test "par_many_unique_batch_count_exact"() {
    let p = ecs_query_par_many_unique_iter_new(8);
    let p4 = ecs_query_par_many_unique_iter_batching_strategy(p, 4);
    if ecs_query_par_many_unique_iter_batch_count(p4) != 2 { panic(91791); };
}

@test "par_many_unique_batch_count_rounds_up"() {
    let p = ecs_query_par_many_unique_iter_new(5);
    let p2 = ecs_query_par_many_unique_iter_batching_strategy(p, 2);
    if ecs_query_par_many_unique_iter_batch_count(p2) != 3 { panic(91792); };
}

@test "par_many_unique_batch_count_zero_batch_size"() {
    let p = ecs_query_par_many_unique_iter_new(5);
    let p0 = ecs_query_par_many_unique_iter_batching_strategy(p, 0);
    if ecs_query_par_many_unique_iter_batch_count(p0) != 0 { panic(91793); };
}

@test "par_many_unique_for_each"() {
    let p = ecs_query_par_many_unique_iter_new(7);
    let cnt = ecs_query_par_many_unique_iter_for_each(p, FN_A);
    if cnt != 7 { panic(91794); };
}

@test "par_many_unique_for_each_init"() {
    let p = ecs_query_par_many_unique_iter_new(11);
    let res = ecs_query_par_many_unique_iter_for_each_init(p, INIT_5, FN_B);
    if ecs_par_many_unique_fei_processed(res) != 11 { panic(91795); };
    if ecs_par_many_unique_fei_accumulator(res) != 16 { panic(91796); };
}

@test "par_many_unique_for_each_init_zero"() {
    let p = ecs_query_par_many_unique_iter_new(0);
    let res = ecs_query_par_many_unique_iter_for_each_init(p, INIT_5, FN_B);
    if ecs_par_many_unique_fei_processed(res) != 0 { panic(91797); };
    if ecs_par_many_unique_fei_accumulator(res) != 5 { panic(91798); };
}

@test "par_many_vs_unique_different_processed"() {
    // QueryParManyIter counts list entries (1 per occurrence); QueryParManyUniqueIter counts unique entities.
    let many = ecs_query_par_many_iter_new(20);
    let unique = ecs_query_par_many_unique_iter_new(15);
    let m_cnt = ecs_query_par_many_iter_for_each(many, FN_A);
    let u_cnt = ecs_query_par_many_unique_iter_for_each(unique, FN_A);
    if m_cnt != 20 { panic(91799); };
    if u_cnt != 15 { panic(91800); };
}
