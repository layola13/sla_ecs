@import "lib/non_send_storage_deep.sla"

// Batch 242: non_send_storage deep (src/storage/non_send.rs).
// panic codes: 114400 – 114599.

@test "data_insert_sets_origin_and_ticks"() {
    let d = ecs_ns_data_new(7);
    let r = ecs_ns_data_insert(d, 100, 3, 9, 1);
    d = r.0;
    if r.1 != true { panic(114400); };
    if ecs_ns_data_is_present(d) != true { panic(114401); };
    if ecs_ns_data_get_data(d).1 != 100 { panic(114402); };
    if ecs_ns_data_get_added(d).1 != 3 { panic(114403); };
    if ecs_ns_data_get_changed(d).1 != 3 { panic(114404); };
    if ecs_ns_data_origin_thread(d) != 1 { panic(114405); };
    if ecs_ns_data_get_changed_by(d).1 != 9 { panic(114406); };
}

@test "data_replace_keeps_added_and_drops"() {
    let d = ecs_ns_data_new(1);
    let r = ecs_ns_data_insert(d, 10, 1, 0, 2);
    d = r.0;
    r = ecs_ns_data_insert(d, 20, 5, 8, 2);
    d = r.0;
    if r.1 != true { panic(114410); };
    if ecs_ns_data_get_data(d).1 != 20 { panic(114411); };
    if ecs_ns_data_get_added(d).1 != 1 { panic(114412); };
    if ecs_ns_data_get_changed(d).1 != 5 { panic(114413); };
    if ecs_ns_data_drop_count(d) != 1 { panic(114414); };
    if ecs_ns_data_get_changed_by(d).1 != 8 { panic(114415); };
}

@test "data_thread_guard_blocks_replace"() {
    let d = ecs_ns_data_new(1);
    let r = ecs_ns_data_insert(d, 1, 1, 0, 3);
    d = r.0;
    r = ecs_ns_data_insert(d, 2, 2, 0, 9);
    if r.1 != false { panic(114420); };
    if ecs_ns_data_get_data(r.0).1 != 1 { panic(114421); };
}

@test "data_remove_and_drop"() {
    let d = ecs_ns_data_new(2);
    let r = ecs_ns_data_insert(d, 50, 2, 1, 1);
    d = r.0;
    let rem = ecs_ns_data_remove(d, 1);
    d = rem.0;
    if rem.1 != true { panic(114430); };
    if rem.2 != 50 { panic(114431); };
    if ecs_ns_data_is_present(d) != false { panic(114432); };
    r = ecs_ns_data_insert(d, 60, 3, 1, 1);
    d = r.0;
    let rd = ecs_ns_data_remove_and_drop(d, 1);
    d = rd.0;
    if rd.1 != true { panic(114433); };
    if ecs_ns_data_drop_count(d) != 1 { panic(114434); };
}

@test "data_check_ticks_and_set_changed"() {
    let d = ecs_ns_data_new(3);
    let r = ecs_ns_data_insert(d, 1, 50, 0, 1);
    d = r.0;
    d = ecs_ns_data_check_ticks(d, 20);
    if ecs_ns_data_get_added(d).1 != 20 { panic(114440); };
    if ecs_ns_data_get_changed(d).1 != 20 { panic(114441); };
    d = ecs_ns_data_set_changed(d, 30, 4);
    if ecs_ns_data_get_changed(d).1 != 30 { panic(114442); };
    if ecs_ns_data_get_changed_by(d).1 != 4 { panic(114443); };
}

@test "nonsends_insert_get_contains"() {
    let s = ecs_ns_new();
    if ecs_ns_is_empty(s) != true { panic(114450); };
    let r = ecs_ns_insert(s, 10, 100, 1, 2, 1);
    s = r.0;
    if r.1 != true { panic(114451); };
    if ecs_ns_len(s) != 1 { panic(114452); };
    if ecs_ns_contains_present(s, 10) != true { panic(114453); };
    let g = ecs_ns_get(s, 10);
    if g.0 != true { panic(114454); };
    if ecs_ns_data_get_data(g.1).1 != 100 { panic(114455); };
}

@test "nonsends_get_or_insert_idempotent"() {
    let s = ecs_ns_new();
    let r = ecs_ns_get_or_insert(s, 5);
    s = r.0;
    if r.1 != 0 { panic(114460); };
    r = ecs_ns_get_or_insert(s, 5);
    s = r.0;
    if r.1 != 0 { panic(114461); };
    if ecs_ns_len(s) != 1 { panic(114462); };
    r = ecs_ns_get_or_insert(s, 6);
    s = r.0;
    if r.1 != 1 { panic(114463); };
    if ecs_ns_len(s) != 2 { panic(114464); };
}

@test "nonsends_remove_clear_count"() {
    let s = ecs_ns_new();
    let r = ecs_ns_insert(s, 1, 10, 1, 0, 1); s = r.0;
    r = ecs_ns_insert(s, 2, 20, 1, 0, 1); s = r.0;
    if ecs_ns_count_present(s) != 2 { panic(114470); };
    let rem = ecs_ns_remove(s, 1, 1);
    s = rem.0;
    if rem.1 != true { panic(114471); };
    if ecs_ns_count_present(s) != 1 { panic(114472); };
    if ecs_ns_len(s) != 2 { panic(114473); }; // slot remains after remove
    s = ecs_ns_clear(s);
    if ecs_ns_len(s) != 0 { panic(114474); };
    if ecs_ns_is_empty(s) != true { panic(114475); };
}

@test "nonsends_remove_and_drop_and_iter"() {
    let s = ecs_ns_new();
    let r = ecs_ns_insert(s, 8, 80, 1, 0, 1); s = r.0;
    r = ecs_ns_insert(s, 9, 90, 1, 0, 1); s = r.0;
    let rd = ecs_ns_remove_and_drop(s, 8, 1);
    s = rd.0;
    if rd.1 != true { panic(114480); };
    if ecs_ns_contains_present(s, 8) != false { panic(114481); };
    let it = ecs_ns_iter_at(s, 0);
    if it.0 != true { panic(114482); };
    if it.1 != 8 { panic(114483); };
    it = ecs_ns_iter_at(s, 1);
    if it.1 != 9 { panic(114484); };
}

@test "nonsends_wrong_thread_remove_fails"() {
    let s = ecs_ns_new();
    let r = ecs_ns_insert(s, 3, 30, 1, 0, 2); s = r.0;
    let rem = ecs_ns_remove(s, 3, 9);
    if rem.1 != false { panic(114490); };
    if ecs_ns_contains_present(rem.0, 3) != true { panic(114491); };
}
