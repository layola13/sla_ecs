@import "lib/component_clone_deep.sla"

// Batch 247: component_clone deep (src/component/clone.rs).
// panic codes: 115400 – 115599.

@test "behavior_resolve_variants"() {
    if ecs_cc_behavior_resolve(ecs_cc_behavior_default(), ecs_cc_fn_clone()) != ecs_cc_fn_clone() { panic(115400); };
    if ecs_cc_behavior_resolve(ecs_cc_behavior_ignore(), ecs_cc_fn_clone()) != ecs_cc_fn_ignore() { panic(115401); };
    if ecs_cc_behavior_resolve(ecs_cc_behavior_reflect(), ecs_cc_fn_clone()) != ecs_cc_fn_reflect() { panic(115402); };
    if ecs_cc_behavior_resolve(ecs_cc_behavior_clone(), ecs_cc_fn_ignore()) != ecs_cc_fn_clone() { panic(115403); };
    if ecs_cc_behavior_resolve(ecs_cc_behavior_custom(5), ecs_cc_fn_clone()) != ecs_cc_fn_custom_base() + 5 { panic(115404); };
}

@test "source_read_and_empty"() {
    let s = ecs_cc_source_new(3, 42);
    if ecs_cc_source_id(s) != 3 { panic(115410); };
    let r = ecs_cc_source_read(s);
    if r.0 != true { panic(115411); };
    if r.1 != 42 { panic(115412); };
    if ecs_cc_source_ptr(s) != 42 { panic(115413); };
    let e = ecs_cc_source_empty(3);
    if ecs_cc_source_read(e).0 != false { panic(115414); };
}

@test "mapper_get_or_insert_dedup"() {
    let m = ecs_cc_mapper_new();
    let r = ecs_cc_mapper_get_or_insert(m, 10, 100);
    m = r.0;
    if r.1 != 100 { panic(115420); };
    if ecs_cc_mapper_len(m) != 1 { panic(115421); };
    r = ecs_cc_mapper_get_or_insert(m, 10, 999);
    m = r.0;
    if r.1 != 100 { panic(115422); };
    if ecs_cc_mapper_len(m) != 1 { panic(115423); };
    r = ecs_cc_mapper_get_or_insert(m, 11, 110);
    m = r.0;
    if ecs_cc_mapper_len(m) != 2 { panic(115424); };
    let g = ecs_cc_mapper_get(m, 11);
    if g.0 != true { panic(115425); };
    if g.1 != 110 { panic(115426); };
}

@test "ctx_write_target_and_flags"() {
    let c = ecs_cc_ctx_new(1, 2, 7, 55);
    if ecs_cc_ctx_source(c) != 1 { panic(115430); };
    if ecs_cc_ctx_target(c) != 2 { panic(115431); };
    if ecs_cc_ctx_component_id(c) != 7 { panic(115432); };
    if ecs_cc_ctx_written(c) != false { panic(115433); };
    c = ecs_cc_ctx_write_target(c, 99);
    if ecs_cc_ctx_written(c) != true { panic(115434); };
    if ecs_cc_ctx_target_value(c) != 99 { panic(115435); };
    c = ecs_cc_ctx_set_moving(c, true);
    c = ecs_cc_ctx_set_linked(c, true);
    if ecs_cc_ctx_moving(c) != true { panic(115436); };
    if ecs_cc_ctx_linked(c) != true { panic(115437); };
}

@test "ctx_queue_and_map_entity"() {
    let c = ecs_cc_ctx_new(1, 2, 1, 0);
    c = ecs_cc_ctx_queue_entity(c, 50);
    c = ecs_cc_ctx_queue_entity(c, 51);
    if ecs_cc_ctx_queue_len(c) != 2 { panic(115440); };
    if ecs_cc_ctx_queue_at(c, 0) != 50 { panic(115441); };
    if ecs_cc_ctx_queue_at(c, 1) != 51 { panic(115442); };
    let r = ecs_cc_ctx_map_entity(c, 1, 2);
    c = r.0;
    if r.1 != 2 { panic(115443); };
    if ecs_cc_ctx_mapper_len(c) != 1 { panic(115444); };
}

@test "via_clone_writes_source"() {
    let s = ecs_cc_source_new(1, 77);
    let c = ecs_cc_ctx_new(1, 2, 1, 77);
    c = ecs_cc_via_clone(s, c);
    if ecs_cc_ctx_written(c) != true { panic(115450); };
    if ecs_cc_ctx_target_value(c) != 77 { panic(115451); };
    if ecs_cc_ctx_handler(c) != ecs_cc_fn_clone() { panic(115452); };
}

@test "via_reflect_and_ignore"() {
    let s = ecs_cc_source_new(1, 8);
    let c = ecs_cc_ctx_new(1, 2, 1, 8);
    c = ecs_cc_via_reflect(s, c);
    if ecs_cc_ctx_handler(c) != ecs_cc_fn_reflect() { panic(115460); };
    if ecs_cc_ctx_target_value(c) != 8 { panic(115461); };
    c = ecs_cc_ctx_new(1, 2, 1, 8);
    c = ecs_cc_via_ignore(s, c);
    if ecs_cc_ctx_handler(c) != ecs_cc_fn_ignore() { panic(115462); };
    if ecs_cc_ctx_written(c) != false { panic(115463); };
}

@test "dispatch_default_and_ignore"() {
    let s = ecs_cc_source_new(2, 5);
    let c = ecs_cc_ctx_new(1, 2, 2, 5);
    c = ecs_cc_dispatch(s, c, ecs_cc_behavior_default(), ecs_cc_fn_clone());
    if ecs_cc_ctx_handler(c) != ecs_cc_fn_clone() { panic(115470); };
    if ecs_cc_ctx_written(c) != true { panic(115471); };
    c = ecs_cc_ctx_new(1, 2, 2, 5);
    c = ecs_cc_dispatch(s, c, ecs_cc_behavior_ignore(), ecs_cc_fn_clone());
    if ecs_cc_ctx_handler(c) != ecs_cc_fn_ignore() { panic(115472); };
    if ecs_cc_ctx_written(c) != false { panic(115473); };
}

@test "dispatch_custom_handler_id"() {
    let s = ecs_cc_source_new(3, 9);
    let c = ecs_cc_ctx_new(1, 2, 3, 9);
    c = ecs_cc_dispatch(s, c, ecs_cc_behavior_custom(7), ecs_cc_fn_clone());
    if ecs_cc_ctx_handler(c) != ecs_cc_fn_custom_base() + 7 { panic(115480); };
    if ecs_cc_ctx_target_value(c) != 9 { panic(115481); };
}

@test "behavior_kind_accessors"() {
    if ecs_cc_behavior_kind(ecs_cc_behavior_default()) != ecs_cc_beh_default() { panic(115490); };
    if ecs_cc_behavior_kind(ecs_cc_behavior_ignore()) != ecs_cc_beh_ignore() { panic(115491); };
    if ecs_cc_behavior_custom_fn(ecs_cc_behavior_custom(3)) != 3 { panic(115492); };
}
