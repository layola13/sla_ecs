@import "lib/entity_access_deep.sla"

// Batch 289: entity_access composite deep facade.
// panic codes: 123800 – 123999.

@test "new_meta_and_contains"() {
    let e = ecs_ea_deep_new(42);
    e = ecs_ea_deep_with_meta(e, 3, 7, 9, 11);
    if ecs_ea_deep_id(e) != 42 { panic(123800); };
    if ecs_ea_deep_archetype(e) != 3 { panic(123801); };
    if ecs_ea_deep_location_row(e) != 7 { panic(123802); };
    if ecs_ea_deep_spawned_by(e) != 9 { panic(123803); };
    if ecs_ea_deep_spawn_tick(e) != 11 { panic(123804); };
    if ecs_ea_deep_is_spawned(e) != true { panic(123805); };
    if ecs_ea_deep_contains(e, 1) != false { panic(123806); };
}

@test "insert_get_set_remove"() {
    let e = ecs_ea_deep_new(1);
    let r = ecs_ea_deep_insert(e, 5, 50);
    if ecs_ea_set_ok(r) != true { panic(123810); };
    e = ecs_ea_set_entity(r);
    if ecs_ea_deep_len(e) != 1 { panic(123811); };
    if ecs_ea_get_value(ecs_ea_deep_get(e, 5)) != 50 { panic(123812); };
    let s = ecs_ea_deep_set(e, 5, 99);
    if ecs_ea_set_ok(s) != true { panic(123813); };
    e = ecs_ea_set_entity(s);
    if ecs_ea_get_value(ecs_ea_deep_get(e, 5)) != 99 { panic(123814); };
    let rm = ecs_ea_deep_remove(e, 5);
    e = ecs_ea_set_entity(rm);
    if ecs_ea_deep_len(e) != 0 { panic(123815); };
    if ecs_ea_get_ok(ecs_ea_deep_get(e, 5)) != false { panic(123816); };
}

@test "insert_if_new_and_clear"() {
    let e = ecs_ea_deep_new(2);
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 1, 10));
    e = ecs_ea_set_entity(ecs_ea_deep_insert_if_new(e, 1, 999));
    if ecs_ea_get_value(ecs_ea_deep_get(e, 1)) != 10 { panic(123820); };
    e = ecs_ea_set_entity(ecs_ea_deep_insert_if_new(e, 2, 20));
    if ecs_ea_deep_len(e) != 2 { panic(123821); };
    e = ecs_ea_set_entity(ecs_ea_deep_clear(e));
    if ecs_ea_deep_len(e) != 0 { panic(123822); };
}

@test "entry_or_insert_and_modify_take"() {
    let e = ecs_ea_deep_new(3);
    let en = ecs_ea_deep_entry(e, 7);
    if ecs_ea_entry_is_vacant(en) != true { panic(123830); };
    en = ecs_ea_entry_or_insert(en, 70);
    if ecs_ea_entry_is_occupied(en) != true { panic(123831); };
    if ecs_ea_entry_value(en) != 70 { panic(123832); };
    e = ecs_ea_entry_entity(en);
    en = ecs_ea_deep_entry(e, 7);
    en = ecs_ea_entry_and_modify(en, 5);
    if ecs_ea_entry_value(en) != 75 { panic(123833); };
    e = ecs_ea_entry_entity(en);
    en = ecs_ea_deep_entry(e, 7);
    let t = ecs_ea_entry_take(en);
    if ecs_ea_take_ok(t) != true { panic(123834); };
    if ecs_ea_take_value(t) != 75 { panic(123835); };
    e = ecs_ea_take_entity(t);
    if ecs_ea_deep_contains(e, 7) != false { panic(123836); };
}

@test "entry_or_default_and_insert"() {
    let e = ecs_ea_deep_new(4);
    let en = ecs_ea_entry_or_default(ecs_ea_deep_entry(e, 9));
    if ecs_ea_entry_value(en) != 0 { panic(123840); };
    e = ecs_ea_entry_entity(en);
    en = ecs_ea_entry_insert(ecs_ea_deep_entry(e, 9), 42);
    if ecs_ea_entry_value(en) != 42 { panic(123841); };
    e = ecs_ea_entry_entity(en);
    if ecs_ea_get_value(ecs_ea_deep_get(e, 9)) != 42 { panic(123842); };
}

@test "readonly_blocks_mutation"() {
    let e = ecs_ea_deep_new(5);
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 1, 11));
    let ro = ecs_ea_deep_into_readonly(e);
    if ecs_ea_deep_is_readonly(ro) != true { panic(123850); };
    if ecs_ea_get_value(ecs_ea_deep_get(ro, 1)) != 11 { panic(123851); };
    if ecs_ea_get_ok(ecs_ea_deep_get_mut(ro, 1)) != false { panic(123852); };
    if ecs_ea_set_ok(ecs_ea_deep_set(ro, 1, 0)) != false { panic(123853); };
    if ecs_ea_set_err(ecs_ea_deep_insert(ro, 2, 2)) != 3 { panic(123854); };
}

@test "filtered_access_gates"() {
    let e = ecs_ea_deep_new(6);
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 1, 10));
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 2, 20));
    let a = ecs_ea_access_allow_read(ecs_ea_access_new(), 1);
    a = ecs_ea_access_allow_write(a, 1);
    let f = ecs_ea_deep_into_filtered(e, a);
    if ecs_ea_deep_is_filtered(f) != true { panic(123860); };
    if ecs_ea_get_ok(ecs_ea_deep_get(f, 1)) != true { panic(123861); };
    if ecs_ea_get_ok(ecs_ea_deep_get(f, 2)) != false { panic(123862); };
    if ecs_ea_get_err(ecs_ea_deep_get(f, 2)) != 2 { panic(123863); };
    if ecs_ea_get_ok(ecs_ea_deep_get_mut(f, 1)) != true { panic(123864); };
    if ecs_ea_get_ok(ecs_ea_deep_get_mut(f, 2)) != false { panic(123865); };
}

@test "retain_and_despawn"() {
    let e = ecs_ea_deep_new(8);
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 1, 10));
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 2, 20));
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 3, 30));
    // keep bits for cid 1 and 3: bit1=2, bit3=8 => 10
    let keep: i64 = 2 + 8;
    e = ecs_ea_set_entity(ecs_ea_deep_retain(e, keep));
    if ecs_ea_deep_len(e) != 2 { panic(123870); };
    if ecs_ea_deep_contains(e, 1) != true { panic(123871); };
    if ecs_ea_deep_contains(e, 2) != false { panic(123872); };
    if ecs_ea_deep_contains(e, 3) != true { panic(123873); };
    e = ecs_ea_deep_despawn(e);
    if ecs_ea_deep_is_despawned(e) != true { panic(123874); };
    if ecs_ea_deep_len(e) != 0 { panic(123875); };
    if ecs_ea_get_err(ecs_ea_deep_get(e, 1)) != 4 { panic(123876); };
}

@test "eq_ord_reborrow_change_ticks"() {
    let a = ecs_ea_deep_new(10);
    let b = ecs_ea_deep_new(20);
    if ecs_ea_deep_eq(a, a) != true { panic(123880); };
    if ecs_ea_deep_eq(a, b) != false { panic(123881); };
    if ecs_ea_deep_cmp(a, b) != -1 { panic(123882); };
    if ecs_ea_deep_cmp(b, a) != 1 { panic(123883); };
    a = ecs_ea_set_entity(ecs_ea_deep_insert(a, 1, 5));
    let g = ecs_ea_deep_get(a, 1);
    if ecs_ea_get_add(g) != 1 { panic(123884); };
    if ecs_ea_get_ch(g) != 1 { panic(123885); };
    a = ecs_ea_set_entity(ecs_ea_deep_set(a, 1, 6));
    g = ecs_ea_deep_get(a, 1);
    if ecs_ea_get_add(g) != 1 { panic(123886); };
    if ecs_ea_get_ch(g) != 2 { panic(123887); };
    let r = ecs_ea_deep_reborrow(a);
    if ecs_ea_deep_id(r) != 10 { panic(123888); };
    if ecs_ea_deep_change_tick(r) != 2 { panic(123889); };
}

@test "capacity_four_and_full"() {
    let e = ecs_ea_deep_new(99);
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 1, 1));
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 2, 2));
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 3, 3));
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 4, 4));
    if ecs_ea_deep_len(e) != 4 { panic(123890); };
    let full = ecs_ea_deep_insert(e, 5, 5);
    if ecs_ea_set_ok(full) != false { panic(123891); };
    if ecs_ea_set_err(full) != 5 { panic(123892); };
    // update existing still works
    e = ecs_ea_set_entity(ecs_ea_deep_insert(e, 2, 22));
    if ecs_ea_get_value(ecs_ea_deep_get(e, 2)) != 22 { panic(123893); };
}
