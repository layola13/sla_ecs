@import "lib/lifecycle_deep.sla"

// Batch 215: lifecycle deep (src/lifecycle.rs).
// panic codes: 109000 – 109199.

@test "fixed_event_keys"() {
    if ecs_lc_event_key_add() != 0 { panic(109000); };
    if ecs_lc_event_key_insert() != 1 { panic(109001); };
    if ecs_lc_event_key_discard() != 2 { panic(109002); };
    if ecs_lc_event_key_remove() != 3 { panic(109003); };
    if ecs_lc_event_key_despawn() != 4 { panic(109004); };
    if ecs_lc_is_lifecycle_event_key(2) != true { panic(109005); };
    if ecs_lc_is_lifecycle_event_key(5) != false { panic(109006); };
    if ecs_lc_event_key_name_id(0) != 900001 { panic(109007); };
    if ecs_lc_event_key_name_id(4) != 900005 { panic(109008); };
}

@test "relationship_hook_mode"() {
    if ecs_lc_rhm_run() != 0 { panic(109010); };
    if ecs_lc_rhm_skip() != 1 { panic(109011); };
    if ecs_lc_rhm_run_if_not_linked() != 2 { panic(109012); };
    if ecs_lc_rhm_should_run_hooks(0) != true { panic(109013); };
    if ecs_lc_rhm_should_skip(1) != true { panic(109014); };
    if ecs_lc_rhm_should_skip(2) != true { panic(109015); };
    if ecs_lc_rhm_should_skip(0) != false { panic(109016); };
}

@test "hook_context_fields"() {
    let c = ecs_lc_hook_ctx_new(42, 7, 100, true, ECS_LC_RHM_RUN);
    if ecs_lc_hook_ctx_entity(c) != 42 { panic(109020); };
    if ecs_lc_hook_ctx_component_id(c) != 7 { panic(109021); };
    if ecs_lc_hook_ctx_caller(c) != 100 { panic(109022); };
    if ecs_lc_hook_ctx_has_caller(c) != true { panic(109023); };
    if ecs_lc_hook_ctx_rhm(c) != 0 { panic(109024); };
    let d = ecs_lc_hook_ctx_default(9, 3);
    if ecs_lc_hook_ctx_has_caller(d) != false { panic(109025); };
    if ecs_lc_hook_ctx_rhm(d) != ECS_LC_RHM_RUN { panic(109026); };
}

@test "component_hooks_set_and_try"() {
    let h = ecs_lc_hooks_new();
    if ecs_lc_hooks_count(h) != 0 { panic(109030); };
    h = ecs_lc_hooks_on_add(h, 11);
    h = ecs_lc_hooks_on_insert(h, 12);
    h = ecs_lc_hooks_on_discard(h, 13);
    h = ecs_lc_hooks_on_remove(h, 14);
    h = ecs_lc_hooks_on_despawn(h, 15);
    if ecs_lc_hooks_count(h) != 5 { panic(109031); };
    if ecs_lc_hooks_get_add(h) != 11 { panic(109032); };
    if ecs_lc_hooks_get_despawn(h) != 15 { panic(109033); };
    let t = ecs_lc_hooks_try_on_add(h, 99);
    if t.0 != false { panic(109034); };
    if ecs_lc_hooks_get_add(t.1) != 11 { panic(109035); };
    let h2 = ecs_lc_hooks_new();
    let t2 = ecs_lc_hooks_try_on_remove(h2, 44);
    if t2.0 != true { panic(109036); };
    if ecs_lc_hooks_get_remove(t2.1) != 44 { panic(109037); };
}

@test "lifecycle_event_constructors"() {
    let a = ecs_lc_event_add(5, 2);
    if ecs_lc_event_kind(a) != ECS_LC_KIND_ADD { panic(109040); };
    if ecs_lc_event_entity(a) != 5 { panic(109041); };
    if ecs_lc_event_component_id(a) != 2 { panic(109042); };
    if ecs_lc_event_event_key(a) != ECS_LC_ADD { panic(109043); };
    let i = ecs_lc_event_insert(5, 2);
    if ecs_lc_event_kind(i) != ECS_LC_KIND_INSERT { panic(109044); };
    let d = ecs_lc_event_discard(1, 9);
    if ecs_lc_event_kind(d) != ECS_LC_KIND_DISCARD { panic(109045); };
    let r = ecs_lc_event_remove(1, 9);
    if ecs_lc_event_kind(r) != ECS_LC_KIND_REMOVE { panic(109046); };
    let s = ecs_lc_event_despawn(1, 9);
    if ecs_lc_event_kind(s) != ECS_LC_KIND_DESPAWN { panic(109047); };
    if ecs_lc_event_eq(a, a) != true { panic(109048); };
    if ecs_lc_event_eq(a, i) != false { panic(109049); };
}

@test "insert_path_order_add_then_insert"() {
    let p = ecs_lc_emit_insert_path(false);
    if ecs_lc_path_len(p) != 2 { panic(109050); };
    if ecs_lc_path_k0(p) != ECS_LC_KIND_ADD { panic(109051); };
    if ecs_lc_path_k1(p) != ECS_LC_KIND_INSERT { panic(109052); };
    if ecs_lc_add_path_before(ecs_lc_path_k0(p), ecs_lc_path_k1(p)) != true { panic(109053); };
    let q = ecs_lc_emit_insert_path(true);
    if ecs_lc_path_len(q) != 1 { panic(109054); };
    if ecs_lc_path_k0(q) != ECS_LC_KIND_INSERT { panic(109055); };
    if ecs_lc_path_k1(q) != -1 { panic(109056); };
}

@test "remove_and_replace_and_despawn_paths"() {
    let r = ecs_lc_emit_remove_path();
    if ecs_lc_path_len(r) != 2 { panic(109060); };
    if ecs_lc_path_k0(r) != ECS_LC_KIND_DISCARD { panic(109061); };
    if ecs_lc_path_k1(r) != ECS_LC_KIND_REMOVE { panic(109062); };
    if ecs_lc_remove_path_before(ecs_lc_path_k0(r), ecs_lc_path_k1(r)) != true { panic(109063); };
    let rep = ecs_lc_emit_replace_path();
    if ecs_lc_path_k0(rep) != ECS_LC_KIND_DISCARD { panic(109064); };
    if ecs_lc_path_k1(rep) != ECS_LC_KIND_INSERT { panic(109065); };
    let d = ecs_lc_emit_despawn_component_path();
    if ecs_lc_path_len(d) != 3 { panic(109066); };
    if ecs_lc_path_k0(d) != ECS_LC_KIND_DISCARD { panic(109067); };
    if ecs_lc_path_k1(d) != ECS_LC_KIND_REMOVE { panic(109068); };
    if ecs_lc_path_k2(d) != ECS_LC_KIND_DESPAWN { panic(109069); };
}

@test "run_hooks_insert_path_fires_add_then_insert"() {
    let h = ecs_lc_hooks_new();
    h = ecs_lc_hooks_on_add(h, 101);
    h = ecs_lc_hooks_on_insert(h, 102);
    let path = ecs_lc_emit_insert_path(false);
    let res = ecs_lc_run_hooks_path(h, path, ECS_LC_RHM_RUN);
    if ecs_lc_hook_run_fired_count(res) != 2 { panic(109070); };
    if ecs_lc_hook_run_first(res) != 101 { panic(109071); };
    if ecs_lc_hook_run_second(res) != 102 { panic(109072); };
    if ecs_lc_hook_run_skipped(res) != false { panic(109073); };
}

@test "run_hooks_skip_rhm"() {
    let h = ecs_lc_hooks_new();
    h = ecs_lc_hooks_on_add(h, 1);
    h = ecs_lc_hooks_on_insert(h, 2);
    let res = ecs_lc_run_hooks_sequence(h, ECS_LC_KIND_ADD, ECS_LC_KIND_INSERT, -1, 2, ECS_LC_RHM_SKIP);
    if ecs_lc_hook_run_skipped(res) != true { panic(109080); };
    if ecs_lc_hook_run_fired_count(res) != 0 { panic(109081); };
}

@test "run_hooks_despawn_three"() {
    let h = ecs_lc_hooks_new();
    h = ecs_lc_hooks_on_discard(h, 201);
    h = ecs_lc_hooks_on_remove(h, 202);
    h = ecs_lc_hooks_on_despawn(h, 203);
    let d = ecs_lc_emit_despawn_component_path();
    let res = ecs_lc_run_hooks_path(h, d, ECS_LC_RHM_RUN);
    if ecs_lc_hook_run_fired_count(res) != 3 { panic(109090); };
    if ecs_lc_hook_run_first(res) != 201 { panic(109091); };
    if ecs_lc_hook_run_second(res) != 202 { panic(109092); };
    if ecs_lc_hook_run_third(res) != 203 { panic(109093); };
}

@test "removed_component_entity"() {
    let e = ecs_lc_rce_new(77);
    if ecs_lc_rce_entity(e) != 77 { panic(109100); };
}

@test "removed_messages_write_get_update"() {
    let m = ecs_lc_rm_new();
    if ecs_lc_rm_used_slots(m) != 0 { panic(109110); };
    m = ecs_lc_rm_write(m, 10, 100);
    m = ecs_lc_rm_write(m, 10, 101);
    m = ecs_lc_rm_write(m, 20, 200);
    if ecs_lc_rm_has(m, 10) != true { panic(109111); };
    if ecs_lc_rm_has(m, 99) != false { panic(109112); };
    if ecs_lc_rm_len(m, 10) != 2 { panic(109113); };
    if ecs_lc_rm_get(m, 10, 0) != 100 { panic(109114); };
    if ecs_lc_rm_get(m, 10, 1) != 101 { panic(109115); };
    if ecs_lc_rm_len(m, 20) != 1 { panic(109116); };
    if ecs_lc_rm_used_slots(m) != 2 { panic(109117); };
    m = ecs_lc_rm_update(m);
    if ecs_lc_rm_len(m, 10) != 0 { panic(109118); };
    if ecs_lc_rm_update_count(m) != 1 { panic(109119); };
    if ecs_lc_rm_has(m, 10) != true { panic(109120); };
}

@test "removed_components_reader"() {
    let m = ecs_lc_rm_new();
    m = ecs_lc_rm_write(m, 5, 50);
    m = ecs_lc_rm_write(m, 5, 51);
    m = ecs_lc_rm_write(m, 5, 52);
    let r = ecs_lc_rc_new(5);
    if ecs_lc_rc_component_id(r) != 5 { panic(109130); };
    if ecs_lc_rc_is_empty(r, m) != false { panic(109131); };
    if ecs_lc_rc_len(r, m) != 3 { panic(109132); };
    let a = ecs_lc_rc_read(r, m);
    if a.0 != true { panic(109133); };
    if a.1 != 50 { panic(109134); };
    r = a.2;
    let b = ecs_lc_rc_read_with_id(r, m);
    if b.0 != true { panic(109135); };
    if b.1 != 5 { panic(109136); };
    if b.2 != 51 { panic(109137); };
    r = b.3;
    if ecs_lc_rc_len(r, m) != 1 { panic(109138); };
    r = ecs_lc_rc_clear(r, m);
    if ecs_lc_rc_is_empty(r, m) != true { panic(109139); };
    r = ecs_lc_rc_reset_cursor(r);
    if ecs_lc_rc_len(r, m) != 3 { panic(109140); };
}

@test "hooks_for_kind_mapping"() {
    let h = ecs_lc_hooks_new();
    h = ecs_lc_hooks_on_add(h, 1);
    h = ecs_lc_hooks_on_insert(h, 2);
    h = ecs_lc_hooks_on_discard(h, 3);
    h = ecs_lc_hooks_on_remove(h, 4);
    h = ecs_lc_hooks_on_despawn(h, 5);
    if ecs_lc_hooks_for_kind(h, ECS_LC_KIND_ADD) != 1 { panic(109150); };
    if ecs_lc_hooks_for_kind(h, ECS_LC_KIND_INSERT) != 2 { panic(109151); };
    if ecs_lc_hooks_for_kind(h, ECS_LC_KIND_DISCARD) != 3 { panic(109152); };
    if ecs_lc_hooks_for_kind(h, ECS_LC_KIND_REMOVE) != 4 { panic(109153); };
    if ecs_lc_hooks_for_kind(h, ECS_LC_KIND_DESPAWN) != 5 { panic(109154); };
    if ecs_lc_event_order_rank(ECS_LC_KIND_DESPAWN) != 4 { panic(109155); };
}

@test "try_hooks_all_slots_independent"() {
    let h = ecs_lc_hooks_new();
    let a = ecs_lc_hooks_try_on_add(h, 1);
    h = a.1;
    let b = ecs_lc_hooks_try_on_insert(h, 2);
    h = b.1;
    let c = ecs_lc_hooks_try_on_discard(h, 3);
    h = c.1;
    let d = ecs_lc_hooks_try_on_remove(h, 4);
    h = d.1;
    let e = ecs_lc_hooks_try_on_despawn(h, 5);
    h = e.1;
    if a.0 != true || b.0 != true || c.0 != true || d.0 != true || e.0 != true { panic(109160); };
    if ecs_lc_hooks_count(h) != 5 { panic(109161); };
    let a2 = ecs_lc_hooks_try_on_add(h, 9);
    if a2.0 != false { panic(109162); };
}

@test "insert_already_present_only_insert_hook"() {
    let h = ecs_lc_hooks_new();
    h = ecs_lc_hooks_on_add(h, 11);
    h = ecs_lc_hooks_on_insert(h, 12);
    let path = ecs_lc_emit_insert_path(true);
    let res = ecs_lc_run_hooks_path(h, path, ECS_LC_RHM_RUN);
    if ecs_lc_hook_run_fired_count(res) != 1 { panic(109170); };
    if ecs_lc_hook_run_first(res) != 12 { panic(109171); };
}
