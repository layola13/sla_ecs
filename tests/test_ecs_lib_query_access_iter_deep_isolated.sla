@import "lib/query_access_iter_deep.sla"

// Batch 267: query_access_iter deep (src/query/access_iter.rs).
// panic codes: 119400 – 119599.

@test "levels_and_types"() {
    let r = ecs_qai_level_read(3);
    if ecs_qai_level_kind(r) != 0 { panic(119400); };
    if ecs_qai_level_id(r) != 3 { panic(119401); };
    let w = ecs_qai_level_write(3);
    if ecs_qai_level_kind(w) != 1 { panic(119402); };
    let t = ecs_qai_type_component(r);
    if ecs_qai_type_variant(t) != 1 { panic(119403); };
    if ecs_qai_type_component_id(t) != 3 { panic(119404); };
    let e = ecs_qai_type_empty();
    if ecs_qai_type_variant(e) != 0 { panic(119405); };
}

@test "read_read_same_id_compatible"() {
    let a = ecs_qai_type_component(ecs_qai_level_read(1));
    let b = ecs_qai_type_component(ecs_qai_level_read(1));
    let c = ecs_qai_is_compatible(a, b);
    if ecs_qai_compat_ok(c) != true { panic(119410); };
}

@test "write_read_same_id_conflicts"() {
    let a = ecs_qai_type_component(ecs_qai_level_write(2));
    let b = ecs_qai_type_component(ecs_qai_level_read(2));
    let c = ecs_qai_is_compatible(a, b);
    if ecs_qai_compat_ok(c) != false { panic(119420); };
    if ecs_qai_compat_a_id(c) != 2 { panic(119421); };
}

@test "write_all_conflicts_any_component"() {
    let a = ecs_qai_type_component(ecs_qai_level_write_all());
    let b = ecs_qai_type_component(ecs_qai_level_read(9));
    let c = ecs_qai_is_compatible(a, b);
    if ecs_qai_compat_ok(c) != false { panic(119430); };
}

@test "read_all_vs_write_conflicts"() {
    let a = ecs_qai_type_component(ecs_qai_level_read_all());
    let b = ecs_qai_type_component(ecs_qai_level_write(4));
    let c = ecs_qai_is_compatible(a, b);
    if ecs_qai_compat_ok(c) != false { panic(119440); };
    let d = ecs_qai_type_component(ecs_qai_level_read(4));
    let c2 = ecs_qai_is_compatible(a, d);
    if ecs_qai_compat_ok(c2) != true { panic(119441); };
}

@test "empty_compatible_with_all"() {
    let e = ecs_qai_type_empty();
    let w = ecs_qai_type_component(ecs_qai_level_write(1));
    let c = ecs_qai_is_compatible(e, w);
    if ecs_qai_compat_ok(c) != true { panic(119450); };
}

@test "access_borrowed_vs_component"() {
    // access has write bit for id 3
    let bit3 = 8; // 2^3
    let acc = ecs_qai_type_access(0, bit3, false, false);
    let r = ecs_qai_type_component(ecs_qai_level_read(3));
    let c0 = ecs_qai_is_compatible(acc, r);
    if ecs_qai_compat_ok(c0) != false { panic(119460); };
    let r2 = ecs_qai_type_component(ecs_qai_level_read(1));
    let c1 = ecs_qai_is_compatible(acc, r2);
    if ecs_qai_compat_ok(c1) != true { panic(119461); };
}

@test "has_conflicts_small_and_unregistered"() {
    let l = ecs_qai_list_new();
    l = ecs_qai_list_push(l, 0, 1); // read 1
    l = ecs_qai_list_push(l, 0, 2); // read 2
    if ecs_qai_uses_small_path(l) != true { panic(119470); };
    let r0 = ecs_qai_has_conflicts(l);
    if ecs_qai_conflict_ok(r0) != true { panic(119471); };
    l = ecs_qai_list_push(l, 1, 1); // write 1 conflicts with read 1
    let r1 = ecs_qai_has_conflicts(l);
    if ecs_qai_conflict_ok(r1) != false { panic(119472); };
    if ecs_qai_conflict_err(r1) != 3 { panic(119473); };
    let u = ecs_qai_list_unregistered();
    let r2 = ecs_qai_has_conflicts(u);
    if ecs_qai_conflict_ok(r2) != false { panic(119474); };
    if ecs_qai_conflict_err(r2) != 1 { panic(119475); };
}

@test "large_path_threshold"() {
    if ecs_qai_threshold() != 4 { panic(119480); };
    let l = ecs_qai_list_new();
    l = ecs_qai_list_push(l, 0, 1);
    l = ecs_qai_list_push(l, 0, 2);
    l = ecs_qai_list_push(l, 0, 3);
    l = ecs_qai_list_push(l, 0, 4);
    l = ecs_qai_list_push(l, 0, 5);
    if ecs_qai_list_len(l) != 5 { panic(119481); };
    if ecs_qai_uses_small_path(l) != false { panic(119482); };
    let r = ecs_qai_has_conflicts(l);
    if ecs_qai_conflict_ok(r) != true { panic(119483); };
    l = ecs_qai_list_push(l, 1, 3); // write 3 vs read 3
    let r2 = ecs_qai_has_conflicts(l);
    if ecs_qai_conflict_ok(r2) != false { panic(119484); };
}

@test "entity_match_error"() {
    if ecs_qai_entity_match_error(true) != 0 { panic(119490); };
    if ecs_qai_entity_match_error(false) != 2 { panic(119491); };
}
