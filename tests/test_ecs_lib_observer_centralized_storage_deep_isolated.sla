@import "lib/observer_centralized_storage_deep.sla"

// Batch 227: observer centralized storage deep (src/observer/centralized_storage.rs).
// panic codes: 111400 – 111599.

@test "lifecycle_keys"() {
    if ecs_ocs_key_add() != 0 { panic(111400); };
    if ecs_ocs_key_despawn() != 4 { panic(111401); };
    if ecs_ocs_is_lifecycle_key(2) != true { panic(111402); };
    if ecs_ocs_is_lifecycle_key(9) != false { panic(111403); };
}

@test "archetype_cached_flags"() {
    let a = ecs_ocs_is_archetype_cached(0);
    if a.0 != true { panic(111410); };
    if a.1 != ECS_OCS_FLAG_ON_ADD { panic(111411); };
    let b = ecs_ocs_is_archetype_cached(99);
    if b.0 != false { panic(111412); };
}

@test "map_insert_get"() {
    let m = ecs_ocs_map_new();
    m = ecs_ocs_map_insert(m, 10, 100);
    m = ecs_ocs_map_insert(m, 11, 101);
    if ecs_ocs_map_len(m) != 2 { panic(111420); };
    let g = ecs_ocs_map_get(m, 10);
    if g.0 != true { panic(111421); };
    if g.1 != 100 { panic(111422); };
    m = ecs_ocs_map_insert(m, 10, 200);
    if ecs_ocs_map_get(m, 10).1 != 200 { panic(111423); };
}

@test "register_global_lifecycle"() {
    let o = ecs_ocs_observers_new();
    o = ecs_ocs_register_global(o, ECS_OCS_ADD, 1, 50);
    o = ecs_ocs_register_global(o, ECS_OCS_ADD, 2, 51);
    if ecs_ocs_global_count(o, ECS_OCS_ADD) != 2 { panic(111430); };
    if ecs_ocs_global_count(o, ECS_OCS_INSERT) != 0 { panic(111431); };
    if ecs_ocs_has_event_cache(o, ECS_OCS_ADD) != true { panic(111432); };
}

@test "register_custom_event_cache"() {
    let o = ecs_ocs_observers_new();
    o = ecs_ocs_register_global(o, 42, 7, 9);
    if ecs_ocs_has_event_cache(o, 42) != true { panic(111440); };
    if ecs_ocs_global_count(o, 42) != 1 { panic(111441); };
    if ecs_ocs_has_event_cache(o, 43) != false { panic(111442); };
}

@test "component_observers_and_flags"() {
    let o = ecs_ocs_observers_new();
    o = ecs_ocs_register_component(o, ECS_OCS_ADD, 5, 1, 10);
    o = ecs_ocs_register_component(o, ECS_OCS_REMOVE, 5, 2, 20);
    let flags = ecs_ocs_update_archetype_flags(o, 5);
    if (flags / ECS_OCS_FLAG_ON_ADD) % 2 != 1 { panic(111450); };
    if (flags / ECS_OCS_FLAG_ON_REMOVE) % 2 != 1 { panic(111451); };
    if (flags / ECS_OCS_FLAG_ON_INSERT) % 2 != 0 { panic(111452); };
    let flags2 = ecs_ocs_update_archetype_flags(o, 9);
    if flags2 != 0 { panic(111453); };
}

@test "entity_observers"() {
    let o = ecs_ocs_observers_new();
    o = ecs_ocs_register_entity(o, ECS_OCS_INSERT, 100, 3, 30);
    let t = ecs_ocs_try_get_lifecycle(o, ECS_OCS_INSERT);
    if t.0 != true { panic(111460); };
    if ecs_ocs_cached_entity_map_len(t.1, 100) != 1 { panic(111461); };
    if ecs_ocs_cached_entity_map_len(t.1, 101) != 0 { panic(111462); };
}

@test "try_get_missing"() {
    let o = ecs_ocs_observers_new();
    let t = ecs_ocs_try_get_lifecycle(o, 77);
    if t.0 != false { panic(111470); };
}

@test "all_lifecycle_paths"() {
    let o = ecs_ocs_observers_new();
    o = ecs_ocs_register_global(o, ECS_OCS_DISCARD, 1, 1);
    o = ecs_ocs_register_global(o, ECS_OCS_DESPAWN, 2, 2);
    o = ecs_ocs_register_global(o, ECS_OCS_REMOVE, 3, 3);
    if ecs_ocs_global_count(o, ECS_OCS_DISCARD) != 1 { panic(111480); };
    if ecs_ocs_global_count(o, ECS_OCS_DESPAWN) != 1 { panic(111481); };
    if ecs_ocs_global_count(o, ECS_OCS_REMOVE) != 1 { panic(111482); };
}

@test "flag_constants"() {
    if ecs_ocs_flag_on_add() != 1 { panic(111490); };
    if ecs_ocs_flag_on_despawn() != 16 { panic(111491); };
}

@test "component_then_global_independent"() {
    let o = ecs_ocs_observers_new();
    o = ecs_ocs_register_component(o, ECS_OCS_ADD, 1, 9, 1);
    o = ecs_ocs_register_global(o, ECS_OCS_ADD, 8, 2);
    if ecs_ocs_global_count(o, ECS_OCS_ADD) != 1 { panic(111500); };
    if ecs_ocs_cached_has_component(ecs_ocs_try_get_lifecycle(o, ECS_OCS_ADD).1, 1) != true { panic(111501); };
}

@test "map_contains"() {
    let m = ecs_ocs_map_insert(ecs_ocs_map_new(), 5, 1);
    if ecs_ocs_map_contains(m, 5) != true { panic(111510); };
    if ecs_ocs_map_contains(m, 6) != false { panic(111511); };
}
