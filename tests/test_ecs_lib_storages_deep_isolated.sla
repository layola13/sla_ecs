@import "lib/storages_deep.sla"

// Batch 241: storages deep (src/storage/mod.rs).
// panic codes: 114200 – 114399.

@test "new_counts_empty"() {
    let s = ecs_st_new();
    if ecs_st_sparse_set_count(s) != 0 { panic(114200); };
    if ecs_st_table_count(s) != 0 { panic(114201); };
    if ecs_st_non_send_count(s) != 0 { panic(114202); };
    if ecs_st_prepared_len(s) != 0 { panic(114203); };
    if ecs_st_sparse_sets_is_empty(s) != true { panic(114204); };
}

@test "prepare_table_records_without_sparse_bump"() {
    let s = ecs_st_new();
    let r = ecs_st_prepare_component(s, 1, ecs_st_storage_table());
    s = r.0;
    if r.1 != ecs_st_storage_table() { panic(114210); };
    if ecs_st_prepared_len(s) != 1 { panic(114211); };
    if ecs_st_sparse_set_count(s) != 0 { panic(114212); };
    if ecs_st_is_prepared(s, 1) != true { panic(114213); };
    let k = ecs_st_get_prepared_kind(s, 1);
    if k.0 != true { panic(114214); };
    if k.1 != 0 { panic(114215); };
}

@test "prepare_sparse_bumps_and_is_idempotent"() {
    let s = ecs_st_new();
    let r = ecs_st_prepare_component(s, 5, ecs_st_storage_sparse());
    s = r.0;
    if ecs_st_sparse_set_count(s) != 1 { panic(114220); };
    if ecs_st_sparse_len(s) != 1 { panic(114221); };
    r = ecs_st_prepare_component(s, 5, ecs_st_storage_sparse());
    s = r.0;
    if ecs_st_sparse_set_count(s) != 1 { panic(114222); };
    if ecs_st_prepared_len(s) != 1 { panic(114223); };
}

@test "prepare_multiple_sparse_and_get"() {
    let s = ecs_st_new();
    let r = ecs_st_prepare_component(s, 10, ecs_st_storage_sparse()); s = r.0;
    r = ecs_st_prepare_component(s, 11, ecs_st_storage_sparse()); s = r.0;
    r = ecs_st_prepare_component(s, 12, ecs_st_storage_table()); s = r.0;
    if ecs_st_sparse_set_count(s) != 2 { panic(114230); };
    if ecs_st_prepared_len(s) != 3 { panic(114231); };
    let g = ecs_st_sparse_get(s, 11);
    if ecs_st_sparse_get_found(g) != true { panic(114232); };
    if ecs_st_sparse_get_index(g) != 1 { panic(114233); };
    g = ecs_st_sparse_get(s, 99);
    if ecs_st_sparse_get_found(g) != false { panic(114234); };
}

@test "sparse_iter_order"() {
    let s = ecs_st_new();
    let r = ecs_st_prepare_component(s, 3, ecs_st_storage_sparse()); s = r.0;
    r = ecs_st_prepare_component(s, 4, ecs_st_storage_sparse()); s = r.0;
    r = ecs_st_prepare_component(s, 5, ecs_st_storage_sparse()); s = r.0;
    let it = ecs_st_sparse_iter_at(s, 0);
    if ecs_st_sparse_iter_ok(it) != true { panic(114240); };
    if ecs_st_sparse_iter_cid(it) != 3 { panic(114241); };
    if ecs_st_sparse_iter_index(it) != 0 { panic(114242); };
    it = ecs_st_sparse_iter_at(s, 2);
    if ecs_st_sparse_iter_cid(it) != 5 { panic(114243); };
    if ecs_st_sparse_iter_index(it) != 2 { panic(114244); };
    it = ecs_st_sparse_iter_at(s, 9);
    if ecs_st_sparse_iter_ok(it) != false { panic(114245); };
}

@test "register_table_and_non_send"() {
    let s = ecs_st_new();
    s = ecs_st_register_table(s);
    s = ecs_st_register_table(s);
    s = ecs_st_register_non_send(s);
    if ecs_st_table_count(s) != 2 { panic(114250); };
    if ecs_st_non_send_count(s) != 1 { panic(114251); };
    if ecs_st_tables_is_empty(s) != false { panic(114252); };
    if ecs_st_non_sends_is_empty(s) != false { panic(114253); };
}

@test "mixed_prepare_and_register"() {
    let s = ecs_st_new();
    let r = ecs_st_prepare_component(s, 1, ecs_st_storage_sparse()); s = r.0;
    r = ecs_st_prepare_component(s, 2, ecs_st_storage_table()); s = r.0;
    s = ecs_st_register_table(s);
    s = ecs_st_register_non_send(s);
    if ecs_st_sparse_set_count(s) != 1 { panic(114260); };
    if ecs_st_table_count(s) != 1 { panic(114261); };
    if ecs_st_non_send_count(s) != 1 { panic(114262); };
    if ecs_st_prepared_len(s) != 2 { panic(114263); };
}

@test "storage_type_constants"() {
    if ecs_st_storage_table() != 0 { panic(114270); };
    if ecs_st_storage_sparse() != 1 { panic(114271); };
}

@test "prepare_capacity_first_four"() {
    let s = ecs_st_new();
    let r = ecs_st_prepare_component(s, 0, ecs_st_storage_table()); s = r.0;
    r = ecs_st_prepare_component(s, 1, ecs_st_storage_table()); s = r.0;
    r = ecs_st_prepare_component(s, 2, ecs_st_storage_table()); s = r.0;
    r = ecs_st_prepare_component(s, 3, ecs_st_storage_table()); s = r.0;
    if ecs_st_prepared_len(s) != 4 { panic(114280); };
    // 5th is ignored by fixed append helper (capacity 4 active slots)
    r = ecs_st_prepare_component(s, 4, ecs_st_storage_table()); s = r.0;
    if ecs_st_prepared_len(s) != 4 { panic(114281); };
    if ecs_st_is_prepared(s, 3) != true { panic(114282); };
    if ecs_st_is_prepared(s, 4) != false { panic(114283); };
}

@test "get_prepared_missing"() {
    let s = ecs_st_new();
    let k = ecs_st_get_prepared_kind(s, 1);
    if k.0 != false { panic(114290); };
    if ecs_st_is_prepared(s, 1) != false { panic(114291); };
}
