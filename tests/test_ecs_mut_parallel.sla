// Verification tests for the isolated mutable parallel runner.
@import "../lib/parallel_runner.sla"

const MPA_ID: i32 = 2401;
const MPB_ID: i32 = 2402;
const MPC_ID: i32 = 2403;
const MPD_ID: i32 = 2404;
const MPE_ID: i32 = 2405;

fn mp_write_a(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 1;
}

fn mp_write_b(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 1;
}

fn mp_plan_a(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 3;
}

fn mp_plan_b(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 5;
}

fn mp_plan_c(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 7;
}

fn mp_plan_d(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 11;
}

fn mp_plan_e(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 13;
}

@test "mut batch parallel sums disjoint systems"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPB_ID);
    let total = ecs_parallel_run_mut_batch<i32, i32>(w0, mp_write_a, mp_write_b, acc_a, acc_b);
    if total != 2 { panic(24001); };
}

@test "ready pair bridge advances plan"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    dep0.push(2);
    let dep1 = Vec::new();
    let dep2 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 1, dep2);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPB_ID);

    let result = ecs_parallel_run_ready_pair_batch<i32, i32>(w0, p3, 0, 1, mp_plan_a, mp_plan_b, acc_a, acc_b);
    if result.mismatch { panic(24002); };
    if result.used_threads != true { panic(24003); };
    if result.thread_sum != 8 { panic(24004); };
    if result.ran_count != 2 { panic(24005); };
    if result.skipped_count != 0 { panic(24006); };
    if ecs_executor_state_completed_count(result.plan.executor.state) != 2 { panic(24007); };
    if ecs_executor_state_is_ready(result.plan.executor.state, 2) != true { panic(24008); };
    if ecs_executor_run_plan_run_count(result.plan) != 2 { panic(24009); };
    if ecs_executor_run_plan_run_at(result.plan, 0) != 0 { panic(24010); };
    if ecs_executor_run_plan_run_at(result.plan, 1) != 1 { panic(24011); };
}

@test "ready pair runner rejects mismatched batch order"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 2, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPB_ID);
    let result = ecs_parallel_run_ready_pair_batch<i32, i32>(w0, p2, 1, 0, mp_plan_a, mp_plan_b, acc_a, acc_b);
    if result.mismatch != true { panic(24012); };
    if result.used_threads { panic(24013); };
    if result.ran_count != 0 { panic(24014); };
}

@test "ready triple bridge releases dependent"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 4, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    dep0.push(3);
    let dep1 = Vec::new();
    dep1.push(3);
    let dep2 = Vec::new();
    dep2.push(3);
    let dep3 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 0, dep2);
    let p4 = ecs_executor_run_plan_add_system(p3, ecs_executor_system_spec_new(3, false, false, false, true), 3, dep3);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    let acc_c = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPB_ID);
    acc_c.write_components.push(MPC_ID);

    let result = ecs_parallel_run_ready_triple_batch<i32, i32>(w0, p4, 0, 1, 2, mp_plan_a, mp_plan_b, mp_plan_c, acc_a, acc_b, acc_c);
    if result.mismatch { panic(24015); };
    if result.used_threads != true { panic(24016); };
    if result.thread_sum != 15 { panic(24017); };
    if result.ran_count != 3 { panic(24018); };
    if ecs_executor_state_completed_count(result.plan.executor.state) != 3 { panic(24019); };
    if ecs_executor_state_is_ready(result.plan.executor.state, 3) != true { panic(24020); };
    if ecs_executor_run_plan_run_count(result.plan) != 3 { panic(24021); };
    if ecs_executor_run_plan_run_at(result.plan, 0) != 0 { panic(24022); };
    if ecs_executor_run_plan_run_at(result.plan, 1) != 1 { panic(24023); };
    if ecs_executor_run_plan_run_at(result.plan, 2) != 2 { panic(24024); };
}

@test "width dispatch selects pair"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    dep0.push(2);
    let dep1 = Vec::new();
    let dep2 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 1, dep2);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    let acc_c = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPB_ID);
    acc_c.write_components.push(MPC_ID);

    let result = ecs_parallel_run_ready_batch_up_to3<i32, i32>(w0, p3, 3, 0, 1, 2, mp_plan_a, mp_plan_b, mp_plan_c, acc_a, acc_b, acc_c);
    if result.mismatch { panic(24025); };
    if result.used_threads != true { panic(24026); };
    if result.thread_sum != 8 { panic(24027); };
    if result.ran_count != 2 { panic(24028); };
    if ecs_executor_state_is_ready(result.plan.executor.state, 2) != true { panic(24029); };
}

