    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 0, dep2);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    let acc_c = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPA_ID);
    acc_c.write_components.push(MPC_ID);

    let result = ecs_parallel_run_ready_all_nonconflicting_up_to3<i32, i32>(w0, p3, 3, 0, 1, 2, mp_plan_a, mp_plan_b, mp_plan_c, acc_a, acc_b, acc_c);
    if result.mismatch { panic(24070); };
    if result.used_threads != true { panic(24071); };
    if result.thread_sum != 15 { panic(24072); };
    if result.ran_count != 3 { panic(24073); };
    if ecs_executor_state_completed_count(result.plan.executor.state) != 3 { panic(24074); };
    if ecs_executor_run_plan_run_count(result.plan) != 3 { panic(24075); };
    if ecs_executor_run_plan_run_at(result.plan, 0) != 0 { panic(24076); };
    if ecs_executor_run_plan_run_at(result.plan, 1) != 2 { panic(24077); };
    if ecs_executor_run_plan_run_at(result.plan, 2) != 1 { panic(24078); };
}

@test "dynamic catalog first wave"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 4, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    let dep2 = Vec::new();
    let dep3 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 0, dep2);
    let p4 = ecs_executor_run_plan_add_system(p3, ecs_executor_system_spec_new(3, false, false, false, true), 0, dep3);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    let acc_c = table_erased_system_access_none();
    let acc_d = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPA_ID);
    acc_c.write_components.push(MPB_ID);
    acc_d.write_components.push(MPD_ID);
    let catalog0 = ecs_parallel_fn_catalog_new<i32, i32>();
    let catalog1 = ecs_parallel_fn_catalog_add<i32, i32>(catalog0, 0, mp_plan_a, acc_a);
    let catalog2 = ecs_parallel_fn_catalog_add<i32, i32>(catalog1, 1, mp_plan_b, acc_b);
    let catalog3 = ecs_parallel_fn_catalog_add<i32, i32>(catalog2, 2, mp_plan_c, acc_c);
    let catalog4 = ecs_parallel_fn_catalog_add<i32, i32>(catalog3, 3, mp_plan_d, acc_d);
    if ecs_parallel_fn_catalog_len<i32, i32>(catalog4) != 4 { panic(24079); };
    if ecs_parallel_fn_catalog_find_slot<i32, i32>(catalog4, 3) != 3 { panic(24080); };

    let result = ecs_parallel_run_ready_dynamic_catalog_batch_up_to3<i32, i32>(w0, p4, catalog4, 3);
    if result.mismatch { panic(24081); };
    if result.used_threads != true { panic(24082); };
    if result.thread_sum != 21 { panic(24083); };
    if result.ran_count != 3 { panic(24084); };
