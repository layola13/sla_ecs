@test "nonconflict batch skips conflicting ready"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    let dep2 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 0, dep2);
    let acc_a = table_erased_system_access_none();
    let acc_b = table_erased_system_access_none();
    let acc_c = table_erased_system_access_none();
    acc_a.write_components.push(MPA_ID);
    acc_b.write_components.push(MPA_ID);
    acc_c.write_components.push(MPC_ID);

    let result = ecs_parallel_run_ready_nonconflicting_catalog_batch_up_to3<i32, i32>(w0, p3, 3, 0, 1, 2, mp_plan_a, mp_plan_b, mp_plan_c, acc_a, acc_b, acc_c);
    if result.mismatch { panic(24060); };
    if result.used_threads != true { panic(24061); };
    if result.thread_sum != 10 { panic(24062); };
    if result.ran_count != 2 { panic(24063); };
    if ecs_executor_state_completed_count(result.plan.executor.state) != 2 { panic(24064); };
    if ecs_executor_state_is_completed(result.plan.executor.state, 0) != true { panic(24065); };
    if ecs_executor_state_is_completed(result.plan.executor.state, 1) { panic(24066); };
    if ecs_executor_state_is_completed(result.plan.executor.state, 2) != true { panic(24067); };
    if ecs_executor_run_plan_run_at(result.plan, 0) != 0 { panic(24068); };
    if ecs_executor_run_plan_run_at(result.plan, 1) != 2 { panic(24069); };
}

@test "nonconflict conflict waves"() {
    let w0 = table_erased_world_new<i32, i32>(0, 0);
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
