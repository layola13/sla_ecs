    if ecs_parallel_task_pool_worker_count(pool) != 17 { panic(24230); };
    if ecs_parallel_task_pool_batch_width(pool) != 17 { panic(24231); };

    let result = ecs_parallel_task_pool_scope_run_ready_dynamic_catalog_batch<i32, i32>(pool, w0, p10, catalog10);
    if result.mismatch { panic(24232); };
    if result.used_threads != true { panic(24233); };
    if result.thread_sum != 158 { panic(24234); };
    if result.ran_count != 10 { panic(24235); };
    if ecs_executor_state_completed_count(result.plan.executor.state) != 10 { panic(24236); };
}

