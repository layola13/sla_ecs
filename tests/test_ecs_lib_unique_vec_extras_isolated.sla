@import "lib/unique_vec_extras.sla"

// Isolated tests for lib/unique_vec_extras.sla — remaining UniqueEntityEquivalentVec API.
// Bevy reference: bevy_ecs/src/entity/unique_vec.rs

fn make_uve3() -> EcsUniqueVecExtras {
    let v = ecs_uve_new();
    let v1 = ecs_uve_push_unchecked(v, 10);
    let v2 = ecs_uve_push_unchecked(v1, 20);
    return ecs_uve_push_unchecked(v2, 30);
}

@test "unique vec extras reserve and spare capacity"() {
    let v = make_uve3();
    let r = ecs_uve_reserve(v, 5);
    if ecs_uve_len(r) != 3 { panic(92406); };
    if ecs_uve_capacity(r) < 8 { panic(92407); };
    if ecs_uve_spare_capacity(r) < 5 { panic(92408); };
}

@test "unique vec extras reserve exact keeps existing when enough"() {
    let v = ecs_uve_with_capacity(10);
    let v1 = ecs_uve_push_unchecked(v, 1);
    let r = ecs_uve_reserve_exact(v1, 2);
    if ecs_uve_capacity(r) != 10 { panic(92409); };
}

@test "unique vec extras try reserve reports success"() {
    let v = make_uve3();
    let r = ecs_uve_try_reserve(v, 4);
    if r.ok != 1 { panic(92410); };
    if ecs_uve_capacity(r.vec) < 7 { panic(92411); };
}

@test "unique vec extras try reserve rejects negative"() {
    let v = make_uve3();
    let r = ecs_uve_try_reserve_exact(v, -1);
    if r.ok != 0 { panic(92412); };
    if ecs_uve_len(r.vec) != 3 { panic(92413); };
}

@test "unique vec extras shrink to fit"() {
    let v = ecs_uve_with_capacity(20);
    let v1 = ecs_uve_push_unchecked(v, 7);
    let s = ecs_uve_shrink_to_fit(v1);
    if ecs_uve_capacity(s) != 1 { panic(92414); };
}

@test "unique vec extras shrink to lower bound"() {
    let v = make_uve3();
    let r = ecs_uve_reserve(v, 10);
    let s = ecs_uve_shrink_to(r, 5);
    if ecs_uve_capacity(s) != 5 { panic(92415); };
    let s2 = ecs_uve_shrink_to(s, 1);
    if ecs_uve_capacity(s2) != 3 { panic(92416); };
}

@test "unique vec extras append moves all entities"() {
    let a = make_uve3();
    let b0 = ecs_uve_new();
    let b1 = ecs_uve_push_unchecked(b0, 40);
    let b2 = ecs_uve_push_unchecked(b1, 50);
    let out = ecs_uve_append(a, b2);
    if ecs_uve_len(out) != 5 { panic(92417); };
    if ecs_uve_at(out, 3) != 40 { panic(92418); };
    if ecs_uve_at(out, 4) != 50 { panic(92419); };
}

@test "unique vec extras split off preserves order"() {
    let v = make_uve3();
    let r = ecs_uve_split_off(v, 1);
    if ecs_uve_len(r.left) != 1 { panic(92420); };
    if ecs_uve_len(r.right) != 2 { panic(92421); };
    if ecs_uve_at(r.left, 0) != 10 { panic(92422); };
    if ecs_uve_at(r.right, 0) != 20 { panic(92423); };
}

@test "unique vec extras drain removes range"() {
    let v = make_uve3();
    let r = ecs_uve_drain(v, 1, 3);
    if r.removed_count != 2 { panic(92424); };
    if r.first_removed != 20 { panic(92425); };
    if r.removed_sum != 50 { panic(92426); };
    if ecs_uve_len(r.vec) != 1 { panic(92427); };
    if ecs_uve_at(r.vec, 0) != 10 { panic(92428); };
}

@test "unique vec extras drain empty range no op"() {
    let v = make_uve3();
    let r = ecs_uve_drain(v, 2, 2);
    if r.removed_count != 0 { panic(92429); };
    if ecs_uve_len(r.vec) != 3 { panic(92430); };
}

@test "unique vec extras splice replaces range"() {
    let v = make_uve3();
    let replacement = Vec::new();
    replacement.push(80);
    replacement.push(90);
    let r = ecs_uve_splice(v, 1, 2, replacement);
    if r.removed_count != 1 { panic(92431); };
    if r.first_removed != 20 { panic(92432); };
    if r.inserted_count != 2 { panic(92433); };
    if ecs_uve_len(r.vec) != 4 { panic(92434); };
    if ecs_uve_at(r.vec, 0) != 10 { panic(92435); };
    if ecs_uve_at(r.vec, 1) != 80 { panic(92436); };
    if ecs_uve_at(r.vec, 2) != 90 { panic(92437); };
    if ecs_uve_at(r.vec, 3) != 30 { panic(92438); };
}

@test "unique vec extras splice can append"() {
    let v = make_uve3();
    let replacement = Vec::new();
    replacement.push(100);
    let r = ecs_uve_splice(v, 3, 3, replacement);
    if r.removed_count != 0 { panic(92439); };
    if ecs_uve_len(r.vec) != 4 { panic(92440); };
    if ecs_uve_at(r.vec, 3) != 100 { panic(92441); };
}

@test "unique vec extras resize with sequence grows"() {
    let v = make_uve3();
    let r = ecs_uve_resize_with_sequence(v, 5, 40);
    if ecs_uve_len(r) != 5 { panic(92442); };
    if ecs_uve_at(r, 3) != 40 { panic(92443); };
    if ecs_uve_at(r, 4) != 41 { panic(92444); };
}

@test "unique vec extras resize with sequence truncates"() {
    let v = make_uve3();
    let r = ecs_uve_resize_with_sequence(v, 2, 100);
    if ecs_uve_len(r) != 2 { panic(92445); };
    if ecs_uve_at(r, 0) != 10 { panic(92446); };
    if ecs_uve_at(r, 1) != 20 { panic(92447); };
}

@test "unique vec extras leak marks slice view"() {
    let v = make_uve3();
    let r = ecs_uve_leak(v);
    if ecs_uve_is_leaked(r) != true { panic(92448); };
    if ecs_uve_len(r) != 3 { panic(92449); };
}

@test "unique vec extras from entity set iter trusts uniqueness"() {
    let items = Vec::new();
    items.push(1);
    items.push(2);
    items.push(3);
    let v = ecs_uve_from_entity_set_iter(items);
    if ecs_uve_len(v) != 3 { panic(92450); };
    if ecs_uve_at(v, 2) != 3 { panic(92451); };
}

@test "unique vec extras from entity set iter does not dedup"() {
    let items = Vec::new();
    items.push(1);
    items.push(1);
    let v = ecs_uve_from_entity_set_iter(items);
    if ecs_uve_len(v) != 2 { panic(92452); };
}

