// Isolated deep tests for lib/query_access_iter_extras_deep.sla (Batch 405).
// Tests the deep EcsAccessLevel / EcsAccessType / AccessConflictError + is_compatible matrix.

@import "lib/query_access_iter_extras_deep.sla"

@test "level_constructors_and_accessors"() {
    let lr = ecs_access_level_deep_read(7);
    if ecs_access_level_deep_kind(lr) != 0 { panic(145500); };
    if ecs_access_level_deep_component_id(lr) != 7 { panic(145501); };
    let lw = ecs_access_level_deep_write(11);
    if ecs_access_level_deep_kind(lw) != 1 { panic(145502); };
    if ecs_access_level_deep_component_id(lw) != 11 { panic(145503); };
    let lra = ecs_access_level_deep_read_all();
    if ecs_access_level_deep_kind(lra) != 2 { panic(145504); };
    if ecs_access_level_deep_component_id(lra) != (0 - 1) { panic(145505); };
    let lwa = ecs_access_level_deep_write_all();
    if ecs_access_level_deep_kind(lwa) != 3 { panic(145506); };
    if ecs_access_level_deep_component_id(lwa) != (0 - 1) { panic(145507); };
}

@test "access_type_empty_variants_accessors"() {
    let e = ecs_access_type_deep_empty();
    if ecs_access_type_deep_variant(e) != 0 { panic(145520); };
    if ecs_access_type_deep_level_kind(e) != 0 { panic(145521); };
    if ecs_access_type_deep_component_id(e) != (0 - 1) { panic(145522); };
    if ecs_access_type_deep_access_id(e) != (0 - 1) { panic(145523); };
}

@test "access_type_component_level_fields"() {
    let lr = ecs_access_level_deep_read(3);
    let lra = ecs_access_level_deep_read_all();
    let lwa = ecs_access_level_deep_write_all();
    let c_r = ecs_access_type_deep_component(lr);
    if ecs_access_type_deep_variant(c_r) != 1 { panic(145540); };
    if ecs_access_type_deep_level_kind(c_r) != 0 { panic(145541); };
    if ecs_access_type_deep_component_id(c_r) != 3 { panic(145542); };
    if ecs_access_type_deep_access_id(c_r) != (0 - 1) { panic(145543); };
    let c_ra = ecs_access_type_deep_component(lra);
    if ecs_access_type_deep_level_kind(c_ra) != 2 { panic(145544); };
    let c_wa = ecs_access_type_deep_component(lwa);
    if ecs_access_type_deep_level_kind(c_wa) != 3 { panic(145545); };
}

@test "id_list_push_at_len"() {
    let l = ecs_acc_id_list_deep_new();
    if ecs_acc_id_list_deep_len(l) != 0 { panic(145560); };
    l = ecs_acc_id_list_deep_push(l, 5);
    l = ecs_acc_id_list_deep_push(l, 6);
    l = ecs_acc_id_list_deep_push(l, 7);
    if ecs_acc_id_list_deep_len(l) != 3 { panic(145561); };
    if ecs_acc_id_list_deep_at(l, 0) != 5 { panic(145562); };
    if ecs_acc_id_list_deep_at(l, 1) != 6 { panic(145563); };
    if ecs_acc_id_list_deep_at(l, 2) != 7 { panic(145564); };
}

@test "access_type_access_borrow_fields"() {
    let reads = ecs_acc_id_list_deep_new();
    reads = ecs_acc_id_list_deep_push(reads, 2);
    reads = ecs_acc_id_list_deep_push(reads, 3);
    let writes = ecs_acc_id_list_deep_new();
    writes = ecs_acc_id_list_deep_push(writes, 1);
    let acc = ecs_access_type_deep_access(42, reads, writes, false, false);
    if ecs_access_type_deep_variant(acc) != 2 { panic(145580); };
    if ecs_access_type_deep_access_id(acc) != 42 { panic(145581); };
    if ecs_access_type_deep_component_id(acc) != (0 - 1) { panic(145582); };
    if ecs_access_type_deep_level_kind(acc) != 0 { panic(145583); };
}

@test "access_type_access_with_flags"() {
    let reads = ecs_acc_id_list_deep_new();
    let writes = ecs_acc_id_list_deep_new();
    let acc = ecs_access_type_deep_access(9, reads, writes, true, true);
    if ecs_access_type_deep_variant(acc) != 2 { panic(145600); };
    if ecs_access_type_deep_access_id(acc) != 9 { panic(145601); };
}

@test "is_compatible_empty_always_ok"() {
    let e = ecs_access_type_deep_empty();
    let lr = ecs_access_level_deep_read(1);
    let c = ecs_access_type_deep_component(lr);
    let r1 = ecs_access_type_deep_is_compatible(e, c);
    if ecs_acr_deep_ok(r1) != true { panic(145620); };
    let r2 = ecs_access_type_deep_is_compatible(c, e);
    if ecs_acr_deep_ok(r2) != true { panic(145621); };
    let r3 = ecs_access_type_deep_is_compatible(e, e);
    if ecs_acr_deep_ok(r3) != true { panic(145622); };
}

