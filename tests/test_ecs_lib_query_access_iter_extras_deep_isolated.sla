@test "conflict_error_fields_set"() {
    let lr = ecs_access_level_deep_read(3);
    let lw = ecs_access_level_deep_write(3);
    let c_r = ecs_access_type_deep_component(lr);
    let c_w = ecs_access_type_deep_component(lw);
    let r = ecs_access_type_deep_is_compatible(c_r, c_w);
    if ecs_acr_deep_conflict_a_variant(r) != 1 { panic(145980); };
    if ecs_acr_deep_conflict_b_variant(r) != 1 { panic(145981); };
    if ecs_acr_deep_conflict_a_level(r) != 0 { panic(145982); };
    if ecs_acr_deep_conflict_b_level(r) != 1 { panic(145983); };
    if ecs_acr_deep_conflict_a_component_id(r) != 3 { panic(145984); };
    if ecs_acr_deep_conflict_b_component_id(r) != 3 { panic(145985); };
}
