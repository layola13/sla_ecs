@test "is_compatible_read_write_same_id_conflict"() {
    let lr = ecs_access_level_deep_read(5);
    let lw = ecs_access_level_deep_write(5);
    let c_r = ecs_access_type_deep_component(lr);
    let c_w = ecs_access_type_deep_component(lw);
    let r1 = ecs_access_type_deep_is_compatible(c_r, c_w);
    if ecs_acr_deep_ok(r1) != false { panic(145660); };
    let r2 = ecs_access_type_deep_is_compatible(c_w, c_r);
    if ecs_acr_deep_ok(r2) != false { panic(145661); };
    if ecs_acr_deep_conflict_a_variant(r1) != 1 { panic(145662); };
    if ecs_acr_deep_conflict_b_variant(r1) != 1 { panic(145663); };
    if ecs_acr_deep_conflict_a_component_id(r1) != 5 { panic(145664); };
    if ecs_acr_deep_conflict_b_component_id(r1) != 5 { panic(145665); };
}

