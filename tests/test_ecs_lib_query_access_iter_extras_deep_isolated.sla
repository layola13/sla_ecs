@test "is_compatible_writeall_anything_conflict"() {
    let lwa = ecs_access_level_deep_write_all();
    let lr = ecs_access_level_deep_read(1);
    let lw = ecs_access_level_deep_write(1);
    let c_wa = ecs_access_type_deep_component(lwa);
    let c_r = ecs_access_type_deep_component(lr);
    let c_w = ecs_access_type_deep_component(lw);
    let r1 = ecs_access_type_deep_is_compatible(c_wa, c_r);
    if ecs_acr_deep_ok(r1) != false { panic(145780); };
    let r2 = ecs_access_type_deep_is_compatible(c_r, c_wa);
    if ecs_acr_deep_ok(r2) != false { panic(145781); };
    let r3 = ecs_access_type_deep_is_compatible(c_wa, c_w);
    if ecs_acr_deep_ok(r3) != false { panic(145782); };
    let r4 = ecs_access_type_deep_is_compatible(c_wa, c_wa);
    if ecs_acr_deep_ok(r4) != false { panic(145783); };
}

@test "is_compatible_component_vs_access"() {
    // Component(Read cid=10) vs Access that writes 10 -> conflict
    let lr = ecs_access_level_deep_read(10);
    let c_r = ecs_access_type_deep_component(lr);
    let reads = ecs_acc_id_list_deep_new();
    let writes = ecs_acc_id_list_deep_new();
    writes = ecs_acc_id_list_deep_push(writes, 10);
    let acc_w = ecs_access_type_deep_access(1, reads, writes, false, false);
    let r1 = ecs_access_type_deep_is_compatible(c_r, acc_w);
    if ecs_acr_deep_ok(r1) != false { panic(145800); };
    // Component(Read cid=10) vs Access that reads 10 -> ok
    let reads2 = ecs_acc_id_list_deep_new();
    reads2 = ecs_acc_id_list_deep_push(reads2, 10);
    let writes2 = ecs_acc_id_list_deep_new();
    let acc_r = ecs_access_type_deep_access(2, reads2, writes2, false, false);
    let r2 = ecs_access_type_deep_is_compatible(c_r, acc_r);
    if ecs_acr_deep_ok(r2) != true { panic(145801); };
    // Component(Write cid=7) vs Access that reads 7 -> conflict
    let lw = ecs_access_level_deep_write(7);
    let c_w = ecs_access_type_deep_component(lw);
    let reads3 = ecs_acc_id_list_deep_new();
    reads3 = ecs_acc_id_list_deep_push(reads3, 7);
    let writes3 = ecs_acc_id_list_deep_new();
    let acc3 = ecs_access_type_deep_access(3, reads3, writes3, false, false);
    let r3 = ecs_access_type_deep_is_compatible(c_w, acc3);
    if ecs_acr_deep_ok(r3) != false { panic(145802); };
}

@test "is_compatible_access_vs_component_symmetry"() {
    // Access writes 4, Component reads 4 -- Access side first.
    // The Component-vs-Access branch (variant 1==2) fires with a=Component, b=Access; for the
    // Access-vs-Component case (variant 2==1), the symmetric guard reads b.level_kind==0
    // (Read) and asks Access.has_write(b.component_id).  Access writes 4 -> conflict.
    let lr = ecs_access_level_deep_read(4);
    let c_r = ecs_access_type_deep_component(lr);
    let reads = ecs_acc_id_list_deep_new();
    let writes = ecs_acc_id_list_deep_new();
    writes = ecs_acc_id_list_deep_push(writes, 4);
    let acc = ecs_access_type_deep_access(5, reads, writes, false, false);
    let r1 = ecs_access_type_deep_is_compatible(acc, c_r);
    if ecs_acr_deep_ok(r1) != false { panic(145820); };
    // Access reads 4, Component writes 4 -- Access side first.
    // Access-vs-Component with b.level_kind==1 (Write) checks Access.has_read(b.component_id).
    // Access reads 4 -> conflict.
    let lw = ecs_access_level_deep_write(4);
    let c_w = ecs_access_type_deep_component(lw);
    let reads2 = ecs_acc_id_list_deep_new();
    reads2 = ecs_acc_id_list_deep_push(reads2, 4);
    let writes2 = ecs_acc_id_list_deep_new();
    let acc2 = ecs_access_type_deep_access(6, reads2, writes2, false, false);
    let r2 = ecs_access_type_deep_is_compatible(acc2, c_w);
    if ecs_acr_deep_ok(r2) != false { panic(145821); };
    // Access writes 4, Component writes 4 -- Access has no read for write(cid) so this should
    // be OK (write-write needs the ReadAll/WriteAll path), regression guard for #145821.
    let r3 = ecs_access_type_deep_is_compatible(acc, c_w);
    if ecs_acr_deep_ok(r3) != true { panic(145822); };
}

@test "is_compatible_component_vs_access_readall_writeall"() {
    // Component(ReadAll) + Access(has any write) -> conflict
    let lra = ecs_access_level_deep_read_all();
    let c_ra = ecs_access_type_deep_component(lra);
    let reads = ecs_acc_id_list_deep_new();
    let writes = ecs_acc_id_list_deep_new();
    writes = ecs_acc_id_list_deep_push(writes, 99);
    let acc = ecs_access_type_deep_access(6, reads, writes, false, false);
    let r1 = ecs_access_type_deep_is_compatible(c_ra, acc);
    if ecs_acr_deep_ok(r1) != false { panic(145840); };
    // Component(ReadAll) + Access(no writes) -> ok
    let reads2 = ecs_acc_id_list_deep_new();
    reads2 = ecs_acc_id_list_deep_push(reads2, 99);
    let writes2 = ecs_acc_id_list_deep_new();
    let acc2 = ecs_access_type_deep_access(7, reads2, writes2, false, false);
    let r2 = ecs_access_type_deep_is_compatible(c_ra, acc2);
    if ecs_acr_deep_ok(r2) != true { panic(145841); };
    // Component(WriteAll) + Access(has any read) -> conflict
    let lwa = ecs_access_level_deep_write_all();
    let c_wa = ecs_access_type_deep_component(lwa);
    let r3 = ecs_access_type_deep_is_compatible(c_wa, acc2);
    if ecs_acr_deep_ok(r3) != false { panic(145842); };
    // Component(WriteAll) + Access(no reads, no writes) -> ok
    let reads3 = ecs_acc_id_list_deep_new();
    let writes3 = ecs_acc_id_list_deep_new();
    let acc3 = ecs_access_type_deep_access(8, reads3, writes3, false, false);
    let r4 = ecs_access_type_deep_is_compatible(c_wa, acc3);
    if ecs_acr_deep_ok(r4) != true { panic(145843); };
}

@test "is_compatible_access_vs_access_read_all_write"() {
    // Access a read_all, Access b writes anything -> write_all check first (write_all != 0),
    // then b.wn has write entries -> b write overlaps a read_all -> conflict
    let reads_a = ecs_acc_id_list_deep_new();
    let writes_a = ecs_acc_id_list_deep_new();
    let acc_a = ecs_access_type_deep_access(10, reads_a, writes_a, true, false);
    let reads_b = ecs_acc_id_list_deep_new();
    let writes_b = ecs_acc_id_list_deep_new();
    writes_b = ecs_acc_id_list_deep_push(writes_b, 1);
    let acc_b = ecs_access_type_deep_access(11, reads_b, writes_b, false, false);
    let r = ecs_access_type_deep_is_compatible(acc_a, acc_b);
    if ecs_acr_deep_ok(r) != false { panic(145860); };
}

@test "is_compatible_access_vs_access_write_all_conflict"() {
    // Either write_all -> conflict
    let reads_a = ecs_acc_id_list_deep_new();
    let writes_a = ecs_acc_id_list_deep_new();
    let acc_a = ecs_access_type_deep_access(20, reads_a, writes_a, false, true);
    let reads_b = ecs_acc_id_list_deep_new();
    let writes_b = ecs_acc_id_list_deep_new();
    let acc_b = ecs_access_type_deep_access(21, reads_b, writes_b, true, false);
    let r = ecs_access_type_deep_is_compatible(acc_b, acc_a);
    if ecs_acr_deep_ok(r) != false { panic(145880); };
}

