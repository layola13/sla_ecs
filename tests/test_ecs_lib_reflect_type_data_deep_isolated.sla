// Isolated deep tests for lib/reflect_type_data_deep.sla (Batch 411).
// Tests the deep reflect::type_data 4-subtype module: EcsReflectFromWorldDeep (the flattened
// one-field Fns companion), EcsReflectEventDeep (the flattened 3-field Fns companion),
// EcsReflectMapEntitiesDeep (flattened one-field Fns), and the EcsReflectCommandDeep record
// with insert/remove/take constructors and is_insert/is_remove/is_take predicates.

@import "lib/reflect_type_data_deep.sla"

@test "from_world_fns_new_and_new"() {
    let fns = ecs_reflect_from_world_deep_fns_new(12345);
    let r = ecs_reflect_from_world_deep_new(fns);
    if ecs_reflect_from_world_deep_from_world(r) != 12345 { panic(147040); };
}

@test "from_world_fn_pointers_returns_self"() {
    let fns = ecs_reflect_from_world_deep_fns_new(999);
    let r = ecs_reflect_from_world_deep_new(fns);
    let p = ecs_reflect_from_world_deep_fn_pointers(r);
    if ecs_reflect_from_world_deep_from_world(p) != 999 { panic(147041); };
}

@test "event_fns_new_and_accessors"() {
    let fns = ecs_reflect_event_deep_fns_new(100, 200, 300);
    let r = ecs_reflect_event_deep_new(fns);
    if ecs_reflect_event_deep_trigger(r) != 100 { panic(147042); };
    if ecs_reflect_event_deep_create_observer(r) != 200 { panic(147043); };
    if ecs_reflect_event_deep_register_event_key(r) != 300 { panic(147044); };
}

@test "event_fn_pointers_returns_self"() {
    let fns = ecs_reflect_event_deep_fns_new(10, 20, 30);
    let r = ecs_reflect_event_deep_new(fns);
    let p = ecs_reflect_event_deep_fn_pointers(r);
    if ecs_reflect_event_deep_trigger(p) != 10 { panic(147045); };
    if ecs_reflect_event_deep_create_observer(p) != 20 { panic(147046); };
    if ecs_reflect_event_deep_register_event_key(p) != 30 { panic(147047); };
}

@test "map_entities_new_and_call"() {
    let r = ecs_reflect_map_entities_deep_new(777);
    if ecs_reflect_map_entities_deep_call(r) != 777 { panic(147048); };
}

@test "command_insert_constructor"() {
    let c = ecs_reflect_command_deep_insert(42, 99);
    if ecs_reflect_command_deep_kind(c) != 0 { panic(147049); };
    if ecs_reflect_command_deep_type_path(c) != 42 { panic(147050); };
    if ecs_reflect_command_deep_component(c) != 99 { panic(147051); };
    if ecs_reflect_command_deep_is_insert(c) != true { panic(147052); };
    if ecs_reflect_command_deep_is_remove(c) != false { panic(147053); };
    if ecs_reflect_command_deep_is_take(c) != false { panic(147054); };
}

@test "command_remove_constructor"() {
    let c = ecs_reflect_command_deep_remove(88);
    if ecs_reflect_command_deep_kind(c) != 1 { panic(147055); };
    if ecs_reflect_command_deep_type_path(c) != 88 { panic(147056); };
    if ecs_reflect_command_deep_component(c) != 0 { panic(147057); };
    if ecs_reflect_command_deep_is_insert(c) != false { panic(147058); };
    if ecs_reflect_command_deep_is_remove(c) != true { panic(147059); };
    if ecs_reflect_command_deep_is_take(c) != false { panic(147060); };
}

@test "command_take_constructor"() {
    let c = ecs_reflect_command_deep_take(55);
    if ecs_reflect_command_deep_kind(c) != 2 { panic(147061); };
    if ecs_reflect_command_deep_type_path(c) != 55 { panic(147062); };
    if ecs_reflect_command_deep_component(c) != 0 { panic(147063); };
    if ecs_reflect_command_deep_is_insert(c) != false { panic(147064); };
    if ecs_reflect_command_deep_is_remove(c) != false { panic(147065); };
    if ecs_reflect_command_deep_is_take(c) != true { panic(147066); };
}

@test "event_flattend_field_assignment_is_independent"() {
    // Each EcsReflectEventDeep gets its own field slot; mutating one via _new copy
    // must not bleed into another.
    let fns_a = ecs_reflect_event_deep_fns_new(1, 2, 3);
    let fns_b = ecs_reflect_event_deep_fns_new(4, 5, 6);
    let a = ecs_reflect_event_deep_new(fns_a);
    let b = ecs_reflect_event_deep_new(fns_b);
    if ecs_reflect_event_deep_trigger(a) != 1 { panic(147067); };
    if ecs_reflect_event_deep_trigger(b) != 4 { panic(147068); };
    if ecs_reflect_event_deep_create_observer(b) != 5 { panic(147069); };
}
