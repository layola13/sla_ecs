@import "lib/messages_buffer_deep.sla"

// Batch 265: messages_buffer deep (src/message/messages.rs Messages dual-buffer).
// panic codes: 119000 – 119199.

@test "new_empty"() {
    let m = ecs_msgbuf_deep_new();
    if ecs_msgbuf_deep_is_empty(m) != true { panic(119000); };
    if ecs_msgbuf_deep_len(m) != 0 { panic(119001); };
    if ecs_msgbuf_deep_message_count(m) != 0 { panic(119002); };
    if ecs_msgbuf_deep_oldest_message_count(m) != 0 { panic(119003); };
}

@test "write_assigns_ids_and_len"() {
    let m = ecs_msgbuf_deep_new();
    let r0 = ecs_msgbuf_deep_write(m, 10);
    m = ecs_msgbuf_deep_write_result_messages(r0);
    if ecs_msgbuf_deep_write_result_id(r0) != 0 { panic(119010); };
    let r1 = ecs_msgbuf_deep_write(m, 20);
    m = ecs_msgbuf_deep_write_result_messages(r1);
    if ecs_msgbuf_deep_write_result_id(r1) != 1 { panic(119011); };
    if ecs_msgbuf_deep_len(m) != 2 { panic(119012); };
    if ecs_msgbuf_deep_b_len(m) != 2 { panic(119013); };
    if ecs_msgbuf_deep_message_count(m) != 2 { panic(119014); };
}

@test "write_batch_ids_and_len"() {
    let m = ecs_msgbuf_deep_new();
    let br = ecs_msgbuf_deep_write_batch4(m, 1, 2, 3, 4, 4);
    m = ecs_msgbuf_deep_batch_result_messages(br);
    let ids = ecs_msgbuf_deep_batch_result_ids(br);
    if ecs_msgbuf_deep_batch_ids_len(ids) != 4 { panic(119020); };
    let n0 = ecs_msgbuf_deep_batch_ids_next(ids);
    if n0.1 != true { panic(119021); };
    if n0.2 != 0 { panic(119022); };
    if ecs_msgbuf_deep_len(m) != 4 { panic(119023); };
    if ecs_msgbuf_deep_message_count(m) != 4 { panic(119024); };
}

@test "update_swaps_and_clears_oldest"() {
    let m = ecs_msgbuf_deep_new();
    let r = ecs_msgbuf_deep_write(m, 7);
    m = ecs_msgbuf_deep_write_result_messages(r);
    m = ecs_msgbuf_deep_update(m);
    if ecs_msgbuf_deep_a_len(m) != 1 { panic(119030); };
    if ecs_msgbuf_deep_b_len(m) != 0 { panic(119031); };
    if ecs_msgbuf_deep_b_start(m) != 1 { panic(119032); };
    if ecs_msgbuf_deep_invariant_ok(m) != true { panic(119033); };
    if ecs_msgbuf_deep_oldest_message_count(m) != 0 { panic(119034); };
}

@test "double_update_drops_old_and_advances_oldest"() {
    let m = ecs_msgbuf_deep_new();
    let r = ecs_msgbuf_deep_write(m, 11);
    m = ecs_msgbuf_deep_write_result_messages(r);
    m = ecs_msgbuf_deep_update(m);
    let r2 = ecs_msgbuf_deep_write(m, 22);
    m = ecs_msgbuf_deep_write_result_messages(r2);
    m = ecs_msgbuf_deep_update(m);
    // first write dropped; second is in A
    if ecs_msgbuf_deep_a_len(m) != 1 { panic(119040); };
    if ecs_msgbuf_deep_oldest_message_count(m) != 1 { panic(119041); };
    if ecs_msgbuf_deep_len(m) != 1 { panic(119042); };
    let g = ecs_msgbuf_deep_get_message(m, 0);
    if ecs_msgbuf_deep_get_result_found(g) != false { panic(119043); };
    let g2 = ecs_msgbuf_deep_get_message(m, 1);
    if ecs_msgbuf_deep_get_result_found(g2) != true { panic(119044); };
    if ecs_msgbuf_deep_get_result_value(g2) != 22 { panic(119045); };
}

@test "update_drain_returns_old_a"() {
    let m = ecs_msgbuf_deep_new();
    let r0 = ecs_msgbuf_deep_write(m, 5);
    m = ecs_msgbuf_deep_write_result_messages(r0);
    let r1 = ecs_msgbuf_deep_write(m, 6);
    m = ecs_msgbuf_deep_write_result_messages(r1);
    m = ecs_msgbuf_deep_update(m);
    // A has 5,6; write new into B then update_drain drops A
    let r2 = ecs_msgbuf_deep_write(m, 9);
    m = ecs_msgbuf_deep_write_result_messages(r2);
    let dr = ecs_msgbuf_deep_update_drain(m);
    m = ecs_msgbuf_deep_drain_result_messages(dr);
    if ecs_msgbuf_deep_drain_result_count(dr) != 2 { panic(119050); };
    if ecs_msgbuf_deep_drain_result_sum(dr) != 11 { panic(119051); };
    if ecs_msgbuf_deep_a_len(m) != 1 { panic(119052); };
    if ecs_msgbuf_deep_b_len(m) != 0 { panic(119053); };
}

@test "clear_and_drain"() {
    let m = ecs_msgbuf_deep_new();
    let r0 = ecs_msgbuf_deep_write(m, 1);
    m = ecs_msgbuf_deep_write_result_messages(r0);
    m = ecs_msgbuf_deep_update(m);
    let r1 = ecs_msgbuf_deep_write(m, 2);
    m = ecs_msgbuf_deep_write_result_messages(r1);
    if ecs_msgbuf_deep_len(m) != 2 { panic(119060); };
    let dr = ecs_msgbuf_deep_drain(m);
    m = ecs_msgbuf_deep_drain_result_messages(dr);
    if ecs_msgbuf_deep_drain_result_count(dr) != 2 { panic(119061); };
    if ecs_msgbuf_deep_is_empty(m) != true { panic(119062); };
    if ecs_msgbuf_deep_oldest_message_count(m) != 2 { panic(119063); };
    // clear after more writes
    let r2 = ecs_msgbuf_deep_write(m, 3);
    m = ecs_msgbuf_deep_write_result_messages(r2);
    m = ecs_msgbuf_deep_clear(m);
    if ecs_msgbuf_deep_is_empty(m) != true { panic(119064); };
    if ecs_msgbuf_deep_message_count(m) != 3 { panic(119065); };
}

@test "iter_current_update_messages"() {
    let m = ecs_msgbuf_deep_new();
    let r0 = ecs_msgbuf_deep_write(m, 4);
    m = ecs_msgbuf_deep_write_result_messages(r0);
    m = ecs_msgbuf_deep_update(m);
    if ecs_msgbuf_deep_iter_current_count(m) != 0 { panic(119070); };
    let r1 = ecs_msgbuf_deep_write(m, 8);
    m = ecs_msgbuf_deep_write_result_messages(r1);
    let r2 = ecs_msgbuf_deep_write(m, 9);
    m = ecs_msgbuf_deep_write_result_messages(r2);
    if ecs_msgbuf_deep_iter_current_count(m) != 2 { panic(119071); };
    if ecs_msgbuf_deep_iter_current_at(m, 0) != 8 { panic(119072); };
    if ecs_msgbuf_deep_iter_current_at(m, 1) != 9 { panic(119073); };
    // double-buffered total still includes A
    if ecs_msgbuf_deep_len(m) != 3 { panic(119074); };
}

@test "get_cursor_and_current"() {
    let m = ecs_msgbuf_deep_new();
    let r0 = ecs_msgbuf_deep_write(m, 1);
    m = ecs_msgbuf_deep_write_result_messages(r0);
    let c_all = ecs_msgbuf_deep_get_cursor(m);
    if ecs_msgbuf_deep_cursor_last(c_all) != 0 { panic(119080); };
    if ecs_msgbuf_deep_cursor_len(c_all, m) != 1 { panic(119081); };
    let c_cur = ecs_msgbuf_deep_get_cursor_current(m);
    if ecs_msgbuf_deep_cursor_last(c_cur) != 1 { panic(119082); };
    if ecs_msgbuf_deep_cursor_len(c_cur, m) != 0 { panic(119083); };
    let r1 = ecs_msgbuf_deep_write(m, 2);
    m = ecs_msgbuf_deep_write_result_messages(r1);
    if ecs_msgbuf_deep_cursor_len(c_cur, m) != 1 { panic(119084); };
}

@test "write_default_and_get_message_across_buffers"() {
    let m = ecs_msgbuf_deep_new();
    let r0 = ecs_msgbuf_deep_write_default(m);
    m = ecs_msgbuf_deep_write_result_messages(r0);
    if ecs_msgbuf_deep_write_result_id(r0) != 0 { panic(119090); };
    m = ecs_msgbuf_deep_update(m);
    let r1 = ecs_msgbuf_deep_write(m, 42);
    m = ecs_msgbuf_deep_write_result_messages(r1);
    let g0 = ecs_msgbuf_deep_get_message(m, 0);
    if ecs_msgbuf_deep_get_result_found(g0) != true { panic(119091); };
    if ecs_msgbuf_deep_get_result_value(g0) != 0 { panic(119092); };
    let g1 = ecs_msgbuf_deep_get_message(m, 1);
    if ecs_msgbuf_deep_get_result_found(g1) != true { panic(119093); };
    if ecs_msgbuf_deep_get_result_value(g1) != 42 { panic(119094); };
    if ecs_msgbuf_deep_invariant_ok(m) != true { panic(119095); };
}
