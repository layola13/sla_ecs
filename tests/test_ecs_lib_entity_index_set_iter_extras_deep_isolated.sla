// Isolated deep tests for lib/entity_index_set_iter_extras_deep.sla (Batch 402).
// Tests EntityIndexSet bound/iter/into_iter/drain/set-op/splice on cap-8 scalar slot families.

@import "lib/entity_index_set_iter_extras_deep.sla"

@test "bound_kinds"() {
    let unbounded = ecs_eis3_deep_bound_unbounded();
    if ecs_eis3_deep_bound_kind(unbounded) != 0 { panic(144700); };
    let included = ecs_eis3_deep_bound_included(5);
    if ecs_eis3_deep_bound_kind(included) != 1 { panic(144701); };
    if ecs_eis3_deep_bound_value(included) != 5 { panic(144702); };
    let excluded = ecs_eis3_deep_bound_excluded(7);
    if ecs_eis3_deep_bound_kind(excluded) != 2 { panic(144703); };
    if ecs_eis3_deep_bound_value(excluded) != 7 { panic(144704); };
}

@test "bound_start_end"() {
    let unbounded = ecs_eis3_deep_bound_unbounded();
    if ecs_eis3_deep_bound_start(unbounded) != 0 { panic(144710); };
    if ecs_eis3_deep_bound_end(unbounded, 10) != 10 { panic(144711); };
    let inc = ecs_eis3_deep_bound_included(3);
    if ecs_eis3_deep_bound_start(inc) != 3 { panic(144712); };
    if ecs_eis3_deep_bound_end(inc, 10) != 4 { panic(144713); };
    let exc = ecs_eis3_deep_bound_excluded(3);
    if ecs_eis3_deep_bound_start(exc) != 4 { panic(144714); };
    if ecs_eis3_deep_bound_end(exc, 10) != 3 { panic(144715); };
}

@test "set_contains_and_insert"() {
    let s0 = ecs_eis3_deep_new();
    if ecs_eis3_deep_len(s0) != 0 { panic(144720); };
    let ins1 = ecs_eis3_deep_insert(s0, 100);
    if ecs_eis3_deep_insert_result_inserted(ins1) != 1 { panic(144721); };
    let s1 = ecs_eis3_deep_insert_result_set_from(ins1);
    if ecs_eis3_deep_len(s1) != 1 { panic(144722); };
    if ecs_eis3_deep_contains(s1, 100) != true { panic(144723); };
    if ecs_eis3_deep_contains(s1, 200) { panic(144724); };
    let ins2 = ecs_eis3_deep_insert(s1, 100);
    if ecs_eis3_deep_insert_result_inserted(ins2) != 0 { panic(144725); };
    let ins3 = ecs_eis3_deep_insert(s1, 200);
    if ecs_eis3_deep_insert_result_inserted(ins3) != 1 { panic(144726); };
    let s2 = ecs_eis3_deep_insert_result_set_from(ins3);
    if ecs_eis3_deep_len(s2) != 2 { panic(144727); };
}

@test "slice_and_inner_info"() {
    let s0 = ecs_eis3_deep_new();
    let ins = ecs_eis3_deep_insert(s0, 50);
    let s1 = ecs_eis3_deep_insert_result_set_from(ins);
    let sl = ecs_eis3_deep_as_slice(s1);
    if ecs_eis3_deep_slice_len(sl) != 1 { panic(144730); };
    let inner = ecs_eis3_deep_slice_as_inner(sl);
    if ecs_eis3_deep_inner_info_len(inner) != 1 { panic(144731); };
    if ecs_eis3_deep_inner_info_inner_view(inner) != 1 { panic(144732); };
    let boxed = ecs_eis3_deep_slice_boxed(s1);
    let binner = ecs_eis3_deep_boxed_as_inner(boxed);
    if ecs_eis3_deep_inner_info_boxed(binner) != 1 { panic(144733); };
    let empty = ecs_eis3_deep_empty_slice();
    if ecs_eis3_deep_slice_len(empty) != 0 { panic(144734); };
}

@test "slice_range"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 10));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 20));
    let s3 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s2, 30));
    let sl = ecs_eis3_deep_as_slice(s3);
    let r = ecs_eis3_deep_slice_range(sl, 0, 2);
    if ecs_eis3_deep_range_result_has(r) != 1 { panic(144740); };
    if ecs_eis3_deep_range_result_len(r) != 2 { panic(144741); };
    if ecs_eis3_deep_range_result_at(r, 0) != 10 { panic(144742); };
    if ecs_eis3_deep_range_result_at(r, 1) != 20 { panic(144743); };
    let rb = ecs_eis3_deep_slice_range(sl, 1, 2);
    if ecs_eis3_deep_range_result_has(rb) != 1 { panic(144744); };
    if ecs_eis3_deep_range_result_len(rb) != 1 { panic(144745); };
    if ecs_eis3_deep_range_result_at(rb, 0) != 20 { panic(144746); };
    let rbad = ecs_eis3_deep_slice_range(sl, -1, 2);
    if ecs_eis3_deep_range_result_has(rbad) != 0 { panic(144747); };
}

@test "bound_range_set"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 1));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 2));
    let s3 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s2, 3));
    let s4 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s3, 4));
    let start = ecs_eis3_deep_bound_included(1);
    let end = ecs_eis3_deep_bound_excluded(3);
    let r = ecs_eis3_deep_set_bound_range(s4, start, end);
    if ecs_eis3_deep_range_result_has(r) != 1 { panic(144750); };
    if ecs_eis3_deep_range_result_len(r) != 2 { panic(144751); };
    if ecs_eis3_deep_range_result_at(r, 0) != 2 { panic(144752); };
    if ecs_eis3_deep_range_result_at(r, 1) != 3 { panic(144753); };
}

@test "iter_next"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 11));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 22));
    let iter0 = ecs_eis3_deep_iter(s2);
    if ecs_eis3_deep_iter_len(iter0) != 2 { panic(144760); };
    let n1 = ecs_eis3_deep_iter_next(iter0);
    if ecs_eis3_deep_iter_next_has(n1) != 1 { panic(144761); };
    if ecs_eis3_deep_iter_next_value(n1) != 11 { panic(144762); };
    let n1_front = ecs_eis3_deep_iter_next_front(n1);
    if n1_front != 1 { panic(144763); };
    let n2 = ecs_eis3_deep_iter_next_from_next(n1);
    if ecs_eis3_deep_iter_next_has(n2) != 1 { panic(144764); };
    if ecs_eis3_deep_iter_next_value(n2) != 22 { panic(144765); };
    let n2_front = ecs_eis3_deep_iter_next_front(n2);
    if n2_front != 2 { panic(144766); };
    let n3 = ecs_eis3_deep_iter_next_from_next(n2);
    if ecs_eis3_deep_iter_next_has(n3) != 0 { panic(144767); };
}

@test "into_iter_next_and_back"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 5));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 10));
    let sl = ecs_eis3_deep_as_slice(s2);
    let into_iter = ecs_eis3_deep_boxed_into_iter(sl);
    if ecs_eis3_deep_into_iter_len(into_iter) != 2 { panic(144770); };
    let n1 = ecs_eis3_deep_into_iter_next(into_iter);
    if ecs_eis3_deep_into_iter_next_value(n1) != 5 { panic(144771); };
    let n_back = ecs_eis3_deep_into_iter_next_back(into_iter);
    let val2 = ecs_eis3_deep_into_iter_next_value(n_back);
    __assert_eq_i64(val2, 10, 144772);
}

fn __assert_eq_i64(actual: i64, expected: i64, code: i32) -> void {
    if actual != expected { panic(code); };
}

@test "into_iter_next_back_value"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 100));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 200));
    let sl = ecs_eis3_deep_as_slice(s2);
    let ii = ecs_eis3_deep_boxed_into_iter(sl);
    let n_back = ecs_eis3_deep_into_iter_next_back(ii);
    if ecs_eis3_deep_into_iter_next_value(n_back) != 200 { panic(144780); };
    if ecs_eis3_deep_into_iter_next_back_value(n_back) != 1 { panic(144781); };
}

@test "drain_next"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 1));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 2));
    let s3 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s2, 3));
    let dr = ecs_eis3_deep_drain(s3, 1, 2);
    if ecs_eis3_deep_drain_result_set_len(dr) != 2 { panic(144790); };
    if ecs_eis3_deep_drain_result_drain_count(dr) != 1 { panic(144791); };
    if ecs_eis3_deep_drain_result_set_at(dr, 0) != 1 { panic(144792); };
    if ecs_eis3_deep_drain_result_set_at(dr, 1) != 3 { panic(144793); };
}

@test "op_iter_next_and_back"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 7));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 8));
    let op_iter = ecs_eis3_deep_op_iter_from_set(s2, 9);
    if ecs_eis3_deep_op_iter_len(op_iter) != 2 { panic(144800); };
    if ecs_eis3_deep_op_iter_op_kind(op_iter) != 9 { panic(144801); };
    let n = ecs_eis3_deep_op_iter_next(op_iter);
    if ecs_eis3_deep_op_iter_next_value(n) != 7 { panic(144802); };
    let n_back = ecs_eis3_deep_op_iter_next_back(op_iter);
    let val = ecs_eis3_deep_op_iter_next_value(n_back);
    __assert_eq_i64(val, 8, 144803);
}

@test "collect_op_iter"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 11));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 12));
    let op_iter = ecs_eis3_deep_op_iter_from_set(s2, 0);
    let collected = ecs_eis3_deep_collect_op_iter(op_iter);
    if ecs_eis3_deep_len(collected) != 2 { panic(144810); };
    if ecs_eis3_deep_contains(collected, 11) != true { panic(144811); };
    if ecs_eis3_deep_contains(collected, 12) != true { panic(144812); };
}

@test "difference_set"() {
    let l0 = ecs_eis3_deep_new();
    let l1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(l0, 1));
    let l2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(l1, 2));
    let r0 = ecs_eis3_deep_new();
    let r1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(r0, 2));
    let r2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(r1, 3));
    let diff = ecs_eis3_deep_difference_set(l2, r2);
    if ecs_eis3_deep_len(diff) != 1 { panic(144820); };
    if ecs_eis3_deep_contains(diff, 1) != true { panic(144821); };
    if ecs_eis3_deep_contains(diff, 2) { panic(144822); };
    let di = ecs_eis3_deep_difference_iter(l2, r2);
    if ecs_eis3_deep_op_iter_op_kind(di) != 3 { panic(144823); };
}

@test "intersection_union_symmetric"() {
    let l0 = ecs_eis3_deep_new();
    let l1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(l0, 1));
    let l2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(l1, 2));
    let l3 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(l2, 3));
    let r0 = ecs_eis3_deep_new();
    let r1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(r0, 2));
    let r2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(r1, 3));
    let r3 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(r2, 4));
    let inter = ecs_eis3_deep_intersection_iter(l3, r3);
    if ecs_eis3_deep_op_iter_len(inter) != 2 { panic(144830); };
    if ecs_eis3_deep_op_iter_op_kind(inter) != 1 { panic(144831); };
    let union_iter = ecs_eis3_deep_union_iter(l3, r3);
    if ecs_eis3_deep_op_iter_len(union_iter) != 4 { panic(144832); };
    if ecs_eis3_deep_op_iter_op_kind(union_iter) != 2 { panic(144833); };
    let sym = ecs_eis3_deep_symmetric_difference_iter(l3, r3);
    if ecs_eis3_deep_op_iter_len(sym) != 2 { panic(144834); };
    if ecs_eis3_deep_op_iter_op_kind(sym) != 4 { panic(144835); };
    let n_sym = ecs_eis3_deep_op_iter_next(sym);
    if ecs_eis3_deep_op_iter_next_has(n_sym) != 1 { panic(144836); };
}

@test "splice_unique"() {
    let s0 = ecs_eis3_deep_new();
    let s1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s0, 10));
    let s2 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s1, 20));
    let s3 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s2, 30));
    let s4 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(s3, 40));
    let rep0 = ecs_eis3_deep_new();
    let rep1 = ecs_eis3_deep_insert_result_set_from(ecs_eis3_deep_insert(rep0, 99));
    let sp = ecs_eis3_deep_splice_unique(s4, 1, 3, rep1);
    if ecs_eis3_deep_splice_result_set_len(sp) != 3 { panic(144840); };
    if ecs_eis3_deep_splice_result_set_at(sp, 0) != 10 { panic(144841); };
    if ecs_eis3_deep_splice_result_set_at(sp, 1) != 99 { panic(144842); };
    if ecs_eis3_deep_splice_result_set_at(sp, 2) != 40 { panic(144843); };
    if ecs_eis3_deep_splice_result_removed_count(sp) != 2 { panic(144844); };
    if ecs_eis3_deep_splice_result_op_kind(sp) != 5 { panic(144845); };
}
