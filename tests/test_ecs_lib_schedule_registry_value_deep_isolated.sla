// Isolated deep tests for lib/schedule_registry_value_deep.sla (Batch 370).
// registry-value schedule: cap-8 systems keyed by registry component id; conflict tracking.
// panic codes: 140000 - 140199.

@import "lib/schedule_registry_value_deep.sla"

const CID_HEALTH: i32 = 1;
const CID_MANA: i32 = 2;
const CID_POS: i32 = 31;
const CID_VEL: i32 = 32;

@test "Schedule default empty zero conflicts"() {
    let s = ecs_reg_value_schedule_default();
    if ecs_reg_value_schedule_len(s) != 0 { panic(140000); };
    if ecs_reg_value_schedule_conflict_count(s) != 0 { panic(140001); };
}

@test "Access none empty and resource/messages mutators"() {
    let a = ecs_reg_value_access_none();
    if ecs_reg_value_len_reads(a) != 0 { panic(140010); };
    if ecs_reg_value_len_writes(a) != 0 { panic(140011); };
    if ecs_reg_value_reads_resource(a) != 0 { panic(140012); };
    if ecs_reg_value_writes_resource(a) != 0 { panic(140013); };
    if ecs_reg_value_reads_messages(a) != 0 { panic(140014); };
    if ecs_reg_value_writes_messages(a) != 0 { panic(140015); };
    let ar = ecs_reg_value_access_read_resource(a);
    if ecs_reg_value_reads_resource(ar) != 1 { panic(140016); };
    let aw = ecs_reg_value_access_write_resource(ar);
    if ecs_reg_value_writes_resource(aw) != 1 { panic(140017); };
    let amr = ecs_reg_value_access_read_messages(aw);
    if ecs_reg_value_reads_messages(amr) != 1 { panic(140018); };
    let amw = ecs_reg_value_access_write_messages(amr);
    if ecs_reg_value_writes_messages(amw) != 1 { panic(140019); };
}

@test "Access read/write component mutators store registry ids"() {
    let a0 = ecs_reg_value_access_none();
    let a1 = ecs_reg_value_access_read_component(a0, CID_HEALTH);
    let a2 = ecs_reg_value_access_write_component(a1, CID_HEALTH);
    if ecs_reg_value_len_reads(a2) != 1 { panic(140020); };
    if ecs_reg_value_len_writes(a2) != 1 { panic(140021); };
    if ecs_reg_value_read_at(a2, 0) != CID_HEALTH { panic(140022); };
    if ecs_reg_value_write_at(a2, 0) != CID_HEALTH { panic(140023); };
    let a3 = ecs_reg_value_access_read_component(a2, CID_MANA);
    let a4 = ecs_reg_value_access_write_component(a3, CID_VEL);
    if ecs_reg_value_len_reads(a4) != 2 { panic(140024); };
    if ecs_reg_value_len_writes(a4) != 2 { panic(140025); };
    if ecs_reg_value_read_at(a4, 1) != CID_MANA { panic(140026); };
    if ecs_reg_value_write_at(a4, 1) != CID_VEL { panic(140027); };
}

@test "Access read/write list cap-4 rejection"() {
    let a0 = ecs_reg_value_access_none();
    let a1 = ecs_reg_value_access_read_component(a0, 1);
    let a2 = ecs_reg_value_access_read_component(a1, 2);
    let a3 = ecs_reg_value_access_read_component(a2, 3);
    let a4 = ecs_reg_value_access_read_component(a3, 4);
    let a5 = ecs_reg_value_access_read_component(a4, 5);
    if ecs_reg_value_len_reads(a5) != 4 { panic(140030); };
    if ecs_reg_value_read_at(a5, 3) != 4 { panic(140031); };
    let a6 = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), 10);
    let a7 = ecs_reg_value_access_write_component(a6, 11);
    let a8 = ecs_reg_value_access_write_component(a7, 12);
    let a9 = ecs_reg_value_access_write_component(a8, 13);
    let a10 = ecs_reg_value_access_write_component(a9, 14);
    if ecs_reg_value_len_writes(a10) != 4 { panic(140032); };
    if ecs_reg_value_write_at(a10, 3) != 13 { panic(140033); };
}

@test "Component conflict detection (write vs read/write on same registry id)"() {
    let write_health = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), CID_HEALTH);
    let read_health = ecs_reg_value_access_read_component(ecs_reg_value_access_none(), CID_HEALTH);
    let write_mana = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), CID_MANA);
    let read_mana = ecs_reg_value_access_read_component(ecs_reg_value_access_none(), CID_MANA);
    // write vs read on same id conflicts.
    if ecs_reg_value_access_conflicts(write_health, read_health) != true { panic(140040); };
    // write vs write on same id conflicts.
    if ecs_reg_value_access_conflicts(write_health, write_health) != true { panic(140041); };
    // different ids do not conflict.
    if ecs_reg_value_access_conflicts(write_health, read_mana) != false { panic(140042); };
    if ecs_reg_value_access_conflicts(write_health, write_mana) != false { panic(140043); };
    // read vs read on the same id does NOT conflict.
    if ecs_reg_value_access_conflicts(read_health, read_health) != false { panic(140044); };
}

@test "Resource and message conflict detection"() {
    let read_res = ecs_reg_value_access_read_resource(ecs_reg_value_access_none());
    let write_res = ecs_reg_value_access_write_resource(ecs_reg_value_access_none());
    let read_msg = ecs_reg_value_access_read_messages(ecs_reg_value_access_none());
    let write_msg = ecs_reg_value_access_write_messages(ecs_reg_value_access_none());
    if ecs_reg_value_access_conflicts(write_res, read_res) != true { panic(140050); };
    if ecs_reg_value_access_conflicts(write_res, write_res) != true { panic(140051); };
    if ecs_reg_value_access_conflicts(read_res, read_res) != false { panic(140052); };
    if ecs_reg_value_access_conflicts(write_msg, read_msg) != true { panic(140053); };
    if ecs_reg_value_access_conflicts(write_msg, write_msg) != true { panic(140054); };
    if ecs_reg_value_access_conflicts(read_msg, read_msg) != false { panic(140055); };
    // resource and message arenas are independent.
    if ecs_reg_value_access_conflicts(write_res, write_msg) != false { panic(140056); };
    if ecs_reg_value_access_conflicts(write_res, read_msg) != false { panic(140057); };
}

@test "schedule_add_systems records one conflict per conflicting earlier system"() {
    let write_health = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), CID_HEALTH);
    let read_health = ecs_reg_value_access_read_component(ecs_reg_value_access_none(), CID_HEALTH);
    let write_mana = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), CID_MANA);
    let s0 = ecs_reg_value_schedule_default();
    let s1 = ecs_reg_value_schedule_add_systems(s0, write_health);
    let s2 = ecs_reg_value_schedule_add_systems(s1, read_health);
    // write_health (slot 0) conflicts with read_health (slot 1) -> conflict_count==1.
    if ecs_reg_value_schedule_conflict_count(s2) != 1 { panic(140060); };
    if ecs_reg_value_schedule_len(s2) != 2 { panic(140061); };
    // Add write_mana: conflicts with neither (different id); conflict_count stays 1.
    let s3 = ecs_reg_value_schedule_add_systems(s2, write_mana);
    if ecs_reg_value_schedule_conflict_count(s3) != 1 { panic(140062); };
    if ecs_reg_value_schedule_len(s3) != 3 { panic(140063); };
    // Add read_health again: conflicts with write_health (slot 0) only; count -> 2.
    let s4 = ecs_reg_value_schedule_add_systems(s3, read_health);
    if ecs_reg_value_schedule_conflict_count(s4) != 2 { panic(140064); };
    if ecs_reg_value_schedule_len(s4) != 4 { panic(140065); };
}

@test "schedule_add_systems access retrievable per slot via access_at"() {
    let s0 = ecs_reg_value_schedule_default();
    let a_read = ecs_reg_value_access_read_component(ecs_reg_value_access_none(), CID_POS);
    let a_write = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), CID_POS);
    let a_msg = ecs_reg_value_access_write_messages(ecs_reg_value_access_none());
    let s1 = ecs_reg_value_schedule_add_systems(s0, a_read);
    let s2 = ecs_reg_value_schedule_add_systems(s1, a_write);
    let s3 = ecs_reg_value_schedule_add_systems(s2, a_msg);
    if ecs_reg_value_schedule_len(s3) != 3 { panic(140070); };
    let a0 = ecs_reg_value_access_at(s3, 0);
    if ecs_reg_value_read_at(a0, 0) != CID_POS { panic(140071); };
    if ecs_reg_value_len_reads(a0) != 1 { panic(140072); };
    let a1 = ecs_reg_value_access_at(s3, 1);
    if ecs_reg_value_write_at(a1, 0) != CID_POS { panic(140073); };
    if ecs_reg_value_len_writes(a1) != 1 { panic(140074); };
    let a2 = ecs_reg_value_access_at(s3, 2);
    if ecs_reg_value_writes_messages(a2) != 1 { panic(140075); };
    // read+write on the same id (slots 0 and 1) -> 1 conflict; msg independent.
    if ecs_reg_value_schedule_conflict_count(s3) != 1 { panic(140076); };
}

@test "schedule cap-8 rejection and clear resets"() {
    let s0 = ecs_reg_value_schedule_default();
    let s1 = s0;
    let i: i32 = 0;
    while i < 8 {
        let next = ecs_reg_value_schedule_add_systems(s1, ecs_reg_value_access_read_component(ecs_reg_value_access_none(), 100 + i));
        s1 = next;
        i = i + 1;
    }
    if ecs_reg_value_schedule_len(s1) != 8 { panic(140080); };
    if ecs_reg_value_schedule_conflict_count(s1) != 0 { panic(140081); };
    // 9th system rejected (different read ids -> no conflicts anyway).
    let s2 = ecs_reg_value_schedule_add_systems(s1, ecs_reg_value_access_read_component(ecs_reg_value_access_none(), 200));
    if ecs_reg_value_schedule_len(s2) != 8 { panic(140082); };
    // clear resets both counts.
    let s3 = ecs_reg_value_schedule_clear(s2);
    if ecs_reg_value_schedule_len(s3) != 0 { panic(140083); };
    if ecs_reg_value_schedule_conflict_count(s3) != 0 { panic(140084); };
}

@test "no conflict between disjoint reads and a write to a different component"() {
    // read A + read B (both read), then write C — write C vs read A/ read B no overlap.
    let read_a = ecs_reg_value_access_read_component(ecs_reg_value_access_none(), CID_POS);
    let read_a_b = ecs_reg_value_access_read_component(read_a, CID_VEL);
    let write_c = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), 33);
    let s0 = ecs_reg_value_schedule_default();
    let s1 = ecs_reg_value_schedule_add_systems(s0, read_a_b);
    let s2 = ecs_reg_value_schedule_add_systems(s1, write_c);
    if ecs_reg_value_schedule_conflict_count(s2) != 0 { panic(140090); };
    // Now add a write to A -> conflicts with read A only (1 conflict).
    let write_a = ecs_reg_value_access_write_component(ecs_reg_value_access_none(), CID_POS);
    let s3 = ecs_reg_value_schedule_add_systems(s2, write_a);
    if ecs_reg_value_schedule_conflict_count(s3) != 1 { panic(140091); };
    // Add another read A -> conflicts with write_a only (1 conflict added -> 2 total).
    let read_a_only = ecs_reg_value_access_read_component(ecs_reg_value_access_none(), CID_POS);
    let s4 = ecs_reg_value_schedule_add_systems(s3, read_a_only);
    if ecs_reg_value_schedule_conflict_count(s4) != 2 { panic(140092); };
    if ecs_reg_value_schedule_len(s4) != 4 { panic(140093); };
}
