@import "lib/entity_hash_map_extras.sla"

// Isolated tests for lib/entity_hash_map_extras.sla.
// Bevy reference: bevy_ecs/src/entity/hash_map.rs

fn make_pairs_123() -> Vec<EcsEntityHashMapPair> {
    let pairs = Vec::new();
    pairs.push(ecs_ehm_pair(1, 10));
    pairs.push(ecs_ehm_pair(2, 20));
    pairs.push(ecs_ehm_pair(3, 30));
    return pairs;
}

fn make_map_123() -> EcsEntityHashMapExtras {
    return ecs_ehm_from_pairs(make_pairs_123());
}

@test "entity hash map extras new empty"() {
    let map = ecs_ehm_new();
    if ecs_ehm_is_empty(map) != true { panic(92527); };
    if ecs_ehm_len(map) != 0 { panic(92528); };
}

@test "entity hash map extras from pairs"() {
    let map = make_map_123();
    if ecs_ehm_len(map) != 3 { panic(92529); };
    if ecs_ehm_index_entity_equivalent(map, 2) != 20 { panic(92530); };
}

@test "entity hash map extras duplicate replaces"() {
    let pairs = make_pairs_123();
    pairs.push(ecs_ehm_pair(2, 99));
    let map = ecs_ehm_from_pairs(pairs);
    if ecs_ehm_len(map) != 3 { panic(92531); };
    if ecs_ehm_index_entity_equivalent(map, 2) != 99 { panic(92532); };
}

@test "entity hash map extras extend pairs"() {
    let map = make_map_123();
    let pairs = Vec::new();
    pairs.push(ecs_ehm_pair(3, 33));
    pairs.push(ecs_ehm_pair(4, 40));
    let out = ecs_ehm_extend_pairs(map, pairs);
    if ecs_ehm_len(out) != 4 { panic(92533); };
    if ecs_ehm_index_entity_equivalent(out, 3) != 33 { panic(92534); };
    if ecs_ehm_index_entity_equivalent(out, 4) != 40 { panic(92535); };
}

@test "entity hash map extras extend refs"() {
    let map = make_map_123();
    let keys = Vec::new();
    keys.push(5);
    keys.push(6);
    let values = Vec::new();
    values.push(50);
    values.push(60);
    let out = ecs_ehm_extend_refs(map, keys, values);
    if ecs_ehm_len(out) != 5 { panic(92536); };
    if ecs_ehm_index_entity_equivalent(out, 6) != 60 { panic(92537); };
}

@test "entity hash map extras extend refs ignores extra keys"() {
    let map = make_map_123();
    let keys = Vec::new();
    keys.push(5);
    keys.push(6);
    let values = Vec::new();
    values.push(50);
    let out = ecs_ehm_extend_refs(map, keys, values);
    if ecs_ehm_len(out) != 4 { panic(92538); };
    if ecs_ehm_index_entity_equivalent(out, 6) != -1 { panic(92539); };
}

@test "entity hash map extras keys iterates"() {
    let map = make_map_123();
    let iter = ecs_ehm_keys(map);
    let n1 = ecs_ehm_keys_next(iter);
    let n2 = ecs_ehm_keys_next(n1.iter);
    if n1.has != 1 { panic(92540); };
    if n1.key != 1 { panic(92541); };
    if n2.key != 2 { panic(92542); };
}

@test "entity hash map extras keys remaining"() {
    let map = make_map_123();
    let iter = ecs_ehm_keys(map);
    let n1 = ecs_ehm_keys_next(iter);
    if ecs_ehm_keys_remaining(n1.iter) != 2 { panic(92543); };
}

@test "entity hash map extras into keys consumes shape"() {
    let map = make_map_123();
    let iter = ecs_ehm_into_keys(map);
    if ecs_ehm_keys_collect_sum(iter) != 6 { panic(92544); };
}

@test "entity hash map extras keys default empty"() {
    let iter = ecs_ehm_keys_default();
    let n = ecs_ehm_keys_next(iter);
    if n.has != 0 { panic(92545); };
}

@test "entity hash map extras keys clone preserves cursor"() {
    let map = make_map_123();
    let iter = ecs_ehm_keys(map);
    let n1 = ecs_ehm_keys_next(iter);
    let cloned = ecs_ehm_keys_clone(n1.iter);
    let n2 = ecs_ehm_keys_next(cloned);
    if n2.key != 2 { panic(92546); };
}

@test "entity hash map extras keys trusted unique"() {
    let map = make_map_123();
    let iter = ecs_ehm_keys(map);
    if iter.trusted_unique != 1 { panic(92547); };
}

@test "entity hash map extras index missing sentinel"() {
    let map = make_map_123();
    if ecs_ehm_index_entity_equivalent(map, 99) != -1 { panic(92548); };
}

@test "entity hash map extras into inner"() {
    let map = make_map_123();
    let inner = ecs_ehm_into_inner(map);
    if ecs_ehm_pair_vec_len(inner) != 3 { panic(92549); };
    if ecs_ehm_pair_vec_key_at(inner, 0) != 1 { panic(92550); };
}

@test "entity hash map extras from hash map identity"() {
    let map = make_map_123();
    let out = ecs_ehm_from_hash_map(map);
    if ecs_ehm_len(out) != 3 { panic(92551); };
}

@test "entity hash map extras with capacity empty"() {
    let map = ecs_ehm_with_capacity(32);
    if ecs_ehm_len(map) != 0 { panic(92552); };
}

@test "entity hash map extras exhausted keys"() {
    let map = make_map_123();
    let a = ecs_ehm_keys_next(ecs_ehm_keys(map));
    let b = ecs_ehm_keys_next(a.iter);
    let c = ecs_ehm_keys_next(b.iter);
    let d = ecs_ehm_keys_next(c.iter);
    if d.has != 0 { panic(92553); };
}

