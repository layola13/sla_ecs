// Isolated deep tests for lib/commands_registry_erased_deep.sla (Batch 364).
// Erased-value deferred command queue for RegistryErasedWorld.
// panic codes: 138800 - 138999.

@import "lib/commands_registry_erased_deep.sla"

const TYPE_POS: i32 = 111;
const TYPE_VEL: i32 = 112;
const TYPE_MARKER: i32 = 113;

@test "RegErasedCommands new empty and side counts zero"() {
    let c = ecs_reg_erased_commands_new();
    if ecs_reg_erased_commands_len(c) != 0 { panic(138800); };
    if ecs_reg_erased_commands_pcomp_count(c) != 0 { panic(138801); };
    if ecs_reg_erased_commands_pres_count(c) != 0 { panic(138802); };
    if ecs_reg_erased_commands_pmsg_count(c) != 0 { panic(138803); };
    if ecs_reg_erased_commands_kind_at(c, 0) != 0 { panic(138804); };
}

@test "insert enqueues INSERT_COMPONENT with type_id and scalar value"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_insert(c0, 7, 11, TYPE_POS, 50);
    if ecs_reg_erased_commands_len(c1) != 1 { panic(138810); };
    if ecs_reg_erased_commands_kind_at(c1, 0) != ECS_CMD_REG_ERASED_INSERT_COMPONENT { panic(138811); };
    if ecs_reg_erased_commands_entity_at(c1, 0) != 7 { panic(138812); };
    if ecs_reg_erased_commands_cmp_at(c1, 0) != 11 { panic(138813); };
    if ecs_reg_erased_commands_idx_at(c1, 0) != 0 { panic(138814); };
    if ecs_reg_erased_commands_pcomp_count(c1) != 1 { panic(138815); };
    if ecs_reg_erased_commands_resolve_value(c1, 0) != 50 { panic(138816); };
    if ecs_reg_erased_commands_resolve_type(c1, 0) != TYPE_POS { panic(138817); };
    if ecs_reg_erased_commands_pv_at(c1, 0) != 50 { panic(138818); };
    if ecs_reg_erased_commands_pt_at(c1, 0) != TYPE_POS { panic(138819); };
}

@test "multi-insert heterogeneous types track per-slot type_id"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_insert(c0, 1, 10, TYPE_POS, 5);
    let c2 = ecs_reg_erased_commands_insert(c1, 1, 20, TYPE_VEL, 8);
    let c3 = ecs_reg_erased_commands_insert(c2, 1, 30, TYPE_MARKER, 1);
    if ecs_reg_erased_commands_len(c3) != 3 { panic(138820); };
    if ecs_reg_erased_commands_cmp_at(c3, 0) != 10 { panic(138821); };
    if ecs_reg_erased_commands_cmp_at(c3, 1) != 20 { panic(138822); };
    if ecs_reg_erased_commands_cmp_at(c3, 2) != 30 { panic(138823); };
    if ecs_reg_erased_commands_resolve_type(c3, 0) != TYPE_POS { panic(138824); };
    if ecs_reg_erased_commands_resolve_type(c3, 1) != TYPE_VEL { panic(138825); };
    if ecs_reg_erased_commands_resolve_type(c3, 2) != TYPE_MARKER { panic(138826); };
    if ecs_reg_erased_commands_resolve_value(c3, 0) != 5 { panic(138827); };
    if ecs_reg_erased_commands_resolve_value(c3, 1) != 8 { panic(138828); };
    if ecs_reg_erased_commands_resolve_value(c3, 2) != 1 { panic(138829); };
    if ecs_reg_erased_commands_pcomp_count(c3) != 3 { panic(138830); };
}

@test "despawn enqueues DESPAWN with no side payload"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_despawn(c0, 9);
    if ecs_reg_erased_commands_len(c1) != 1 { panic(138840); };
    if ecs_reg_erased_commands_kind_at(c1, 0) != ECS_CMD_REG_ERASED_DESPAWN { panic(138841); };
    if ecs_reg_erased_commands_entity_at(c1, 0) != 9 { panic(138842); };
    if ecs_reg_erased_commands_cmp_at(c1, 0) != 0 { panic(138843); };
    if ecs_reg_erased_commands_idx_at(c1, 0) != -1 { panic(138844); };
    if ecs_reg_erased_commands_resolve_value(c1, 0) != 0 { panic(138845); };
    if ecs_reg_erased_commands_resolve_type(c1, 0) != 0 { panic(138846); };
}

@test "insert_resource enqueues resource side payload and resolves"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_insert_resource(c0, 888);
    if ecs_reg_erased_commands_len(c1) != 1 { panic(138850); };
    if ecs_reg_erased_commands_kind_at(c1, 0) != ECS_CMD_REG_ERASED_INSERT_RESOURCE { panic(138851); };
    if ecs_reg_erased_commands_pres_count(c1) != 1 { panic(138852); };
    if ecs_reg_erased_commands_pres_at(c1, 0) != 888 { panic(138853); };
    if ecs_reg_erased_commands_resolve_value(c1, 0) != 888 { panic(138854); };
    if ecs_reg_erased_commands_resolve_resource(c1, 0) != 888 { panic(138855); };
}

@test "write_message enqueues message side payload and resolves"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_write_message(c0, 42);
    if ecs_reg_erased_commands_len(c1) != 1 { panic(138860); };
    if ecs_reg_erased_commands_kind_at(c1, 0) != ECS_CMD_REG_ERASED_WRITE_MESSAGE { panic(138861); };
    if ecs_reg_erased_commands_pmsg_count(c1) != 1 { panic(138862); };
    if ecs_reg_erased_commands_pmsg_at(c1, 0) != 42 { panic(138863); };
    if ecs_reg_erased_commands_resolve_value(c1, 0) != 42 { panic(138864); };
    if ecs_reg_erased_commands_resolve_message(c1, 0) != 42 { panic(138865); };
}

@test "count_by_kind categorizes mixed queue across four kinds"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_insert(c0, 1, 10, TYPE_POS, 1);
    let c2 = ecs_reg_erased_commands_despawn(c1, 1);
    let c3 = ecs_reg_erased_commands_insert(c2, 2, 10, TYPE_VEL, 2);
    let c4 = ecs_reg_erased_commands_insert_resource(c3, 9);
    let c5 = ecs_reg_erased_commands_write_message(c4, 3);
    let c6 = ecs_reg_erased_commands_despawn(c5, 2);
    if ecs_reg_erased_commands_count_by_kind(c6, ECS_CMD_REG_ERASED_INSERT_COMPONENT) != 2 { panic(138870); };
    if ecs_reg_erased_commands_count_by_kind(c6, ECS_CMD_REG_ERASED_DESPAWN) != 2 { panic(138871); };
    if ecs_reg_erased_commands_count_by_kind(c6, ECS_CMD_REG_ERASED_INSERT_RESOURCE) != 1 { panic(138872); };
    if ecs_reg_erased_commands_count_by_kind(c6, ECS_CMD_REG_ERASED_WRITE_MESSAGE) != 1 { panic(138873); };
    if ecs_reg_erased_commands_len(c6) != 6 { panic(138874); };
}

@test "resolve_value/type/resource/message across mixed kinds"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = ecs_reg_erased_commands_insert(c0, 1, 10, TYPE_POS, 11);
    let c2 = ecs_reg_erased_commands_insert_resource(c1, 22);
    let c3 = ecs_reg_erased_commands_write_message(c2, 33);
    let c4 = ecs_reg_erased_commands_despawn(c3, 5);
    let c5 = ecs_reg_erased_commands_insert(c4, 2, 11, TYPE_VEL, 44);
    if ecs_reg_erased_commands_resolve_value(c5, 0) != 11 { panic(138880); };
    if ecs_reg_erased_commands_resolve_type(c5, 0) != TYPE_POS { panic(138881); };
    if ecs_reg_erased_commands_resolve_value(c5, 1) != 22 { panic(138882); };
    if ecs_reg_erased_commands_resolve_resource(c5, 1) != 22 { panic(138883); };
    if ecs_reg_erased_commands_resolve_value(c5, 2) != 33 { panic(138884); };
    if ecs_reg_erased_commands_resolve_message(c5, 2) != 33 { panic(138885); };
    if ecs_reg_erased_commands_resolve_value(c5, 3) != 0 { panic(138886); };
    if ecs_reg_erased_commands_resolve_type(c5, 3) != 0 { panic(138887); };
    if ecs_reg_erased_commands_resolve_value(c5, 4) != 44 { panic(138888); };
    if ecs_reg_erased_commands_resolve_type(c5, 4) != TYPE_VEL { panic(138889); };
    if ecs_reg_erased_commands_pcomp_count(c5) != 2 { panic(138890); };
    if ecs_reg_erased_commands_pres_count(c5) != 1 { panic(138891); };
    if ecs_reg_erased_commands_pmsg_count(c5) != 1 { panic(138892); };
}

@test "queue rejects at cap-8 and clear resets all counts"() {
    let c0 = ecs_reg_erased_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_reg_erased_commands_insert(c1, i, i, TYPE_POS + i, 100 + i);
        i = i + 1;
    }
    if ecs_reg_erased_commands_len(c1) != 8 { panic(138900); };
    if ecs_reg_erased_commands_pcomp_count(c1) != 8 { panic(138901); };
    let c2 = ecs_reg_erased_commands_insert(c1, 99, 99, 999, 999);
    if ecs_reg_erased_commands_len(c2) != 8 { panic(138902); };
    let c3 = ecs_reg_erased_commands_despawn(c2, 99);
    if ecs_reg_erased_commands_len(c3) != 8 { panic(138903); };
    let c4 = ecs_reg_erased_commands_clear(c3);
    if ecs_reg_erased_commands_len(c4) != 0 { panic(138904); };
    if ecs_reg_erased_commands_pcomp_count(c4) != 0 { panic(138905); };
    if ecs_reg_erased_commands_pres_count(c4) != 0 { panic(138906); };
    if ecs_reg_erased_commands_pmsg_count(c4) != 0 { panic(138907); };
}

@test "reserve_entity placeholder and builder helper struct fields"() {
    let c0 = ecs_reg_erased_commands_new();
    let (c1, id) = ecs_reg_erased_commands_reserve_entity(c0);
    if id != 0 { panic(138910); };
    if ecs_reg_erased_commands_len(c1) != 0 { panic(138911); };
    let cmd = ecs_reg_erased_command(ECS_CMD_REG_ERASED_INSERT_COMPONENT, 3, 7, 0);
    if ecs_reg_erased_command_kind(cmd) != ECS_CMD_REG_ERASED_INSERT_COMPONENT { panic(138912); };
    if ecs_reg_erased_command_entity_id(cmd) != 3 { panic(138913); };
    if ecs_reg_erased_command_component_id(cmd) != 7 { panic(138914); };
    if ecs_reg_erased_command_value_index(cmd) != 0 { panic(138915); };
}
