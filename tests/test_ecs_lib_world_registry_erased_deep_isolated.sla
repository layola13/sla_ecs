// Isolated deep tests for lib/world_registry_erased_deep.sla (Batch 385).
// Mirrors shallow lib/world_registry_erased.sla's `RegistryErasedWorld<R, M>` registry world as a
// SELF-CONTAINED fixed-cap variant (no @import -- the registry/column storage, resource slot,
// message slot, and typed (pos/vel/marker) component columns are all inlined). The erased "any
// concrete type" surface is reified via three concrete typed columns keyed by `type_id`
// (ECS_REG_TYPE_POS / VEL / MARKER). Wrapper structs EcsRegRegisterDeep / EcsRegSpawnDeep /
// EcsRegCompInfoDeep / EcsRegQueryDeep / EcsRegPairQueryDeepPosVel / EcsRegPairMutDeepPosVel /
// EcsRegMessageReadDeep expose scalar accessors (no tuple-return destructuring in tests).
// panic codes: 142600 - 142699.

@import "lib/world_registry_erased_deep.sla"

// ── Test 1: new/register_table/register_sparse_set/spawn + component_count/change_tick. ───────
@test "EcsRegWorldDeep new + register table/sparse + spawn + component_count + change_tick"() {
    let w0 = ecs_reg_world_deep_new();
    if ecs_reg_world_deep_component_count(w0) != 0 { panic(142600); };
    if ecs_reg_world_deep_entity_count(w0) != 0 { panic(142601); };
    if ecs_reg_world_deep_change_tick(w0) != 0 { panic(142602); };
    let r1 = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(r1);
    let info1 = ecs_reg_register_info_deep(r1);
    if ecs_reg_comp_info_id_deep(info1) != 0 { panic(142603); };
    if ecs_reg_world_deep_component_count(w1) != 1 { panic(142604); };
    if ecs_reg_world_deep_change_tick(w1) != 1 { panic(142605); };
    let r2 = ecs_reg_world_deep_register_table(w1, ECS_REG_TYPE_VEL);
    let w2 = ecs_reg_register_world_deep(r2);
    let info2 = ecs_reg_register_info_deep(r2);
    if ecs_reg_comp_info_id_deep(info2) != 1 { panic(142606); };
    if ecs_reg_world_deep_component_count(w2) != 2 { panic(142607); };
    let r3 = ecs_reg_world_deep_register_sparse_set(w2, ECS_REG_TYPE_MARKER);
    let w3 = ecs_reg_register_world_deep(r3);
    let info3 = ecs_reg_register_info_deep(r3);
    if ecs_reg_comp_info_id_deep(info3) != 2 { panic(142608); };
    if ecs_reg_world_deep_component_count(w3) != 3 { panic(142609); };
    if ecs_reg_world_deep_change_tick(w3) != 3 { panic(142610); };
    let sp = ecs_reg_world_deep_spawn(w3);
    let w4 = ecs_reg_spawn_world_deep(sp);
    let e1 = ecs_reg_spawn_entity_deep(sp);
    if e1.id != 0 { panic(142611); };
    if e1.generation != 0 { panic(142612); };
    if ecs_reg_world_deep_entity_count(w4) != 1 { panic(142613); };
    if ecs_reg_world_deep_is_alive(w4, e1) != true { panic(142614); };
}

// ── Test 2: stores multiple concrete component types + get (mirrors shallow test 1 zombie). ──
@test "EcsRegWorldDeep insert pos/vel/marker + get + cap of identical-type re-inserts"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let rv = ecs_reg_world_deep_register_table(w1, ECS_REG_TYPE_VEL);
    let w2 = ecs_reg_register_world_deep(rv);
    let vel_info = ecs_reg_register_info_deep(rv);
    let rm = ecs_reg_world_deep_register_sparse_set(w2, ECS_REG_TYPE_MARKER);
    let w3 = ecs_reg_register_world_deep(rm);
    let mark_info = ecs_reg_register_info_deep(rm);
    let sp1 = ecs_reg_world_deep_spawn(w3);
    let w4 = ecs_reg_spawn_world_deep(sp1);
    let e1 = ecs_reg_spawn_entity_deep(sp1);
    let sp2 = ecs_reg_world_deep_spawn(w4);
    let w5 = ecs_reg_spawn_world_deep(sp2);
    let e2 = ecs_reg_spawn_entity_deep(sp2);
    let w6 = ecs_reg_world_deep_insert_pos(w5, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(1, 0));
    let w7 = ecs_reg_world_deep_insert_vel(w6, e1, ecs_reg_comp_info_id_deep(vel_info), ecs_reg_vel_deep_new(4, 0));
    let w8 = ecs_reg_world_deep_insert_pos(w7, e2, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(9, 0));
    let w9 = ecs_reg_world_deep_insert_marker(w8, e2, ecs_reg_comp_info_id_deep(mark_info), ecs_reg_marker_deep_new(1));
    let pos = ecs_reg_world_deep_get_pos(w9, e1, ecs_reg_comp_info_id_deep(pos_info));
    let vel = ecs_reg_world_deep_get_vel(w9, e1, ecs_reg_comp_info_id_deep(vel_info));
    let mark = ecs_reg_world_deep_get_marker(w9, e2, ecs_reg_comp_info_id_deep(mark_info));
    if ecs_reg_pos_deep_x(pos) != 1 { panic(142620); };
    if ecs_reg_vel_deep_x(vel) != 4 { panic(142621); };
    if ecs_reg_marker_deep_value(mark) != 1 { panic(142622); };
    // has() correct for present + absent.
    if ecs_reg_world_deep_has(w9, e1, ecs_reg_comp_info_id_deep(pos_info)) != true { panic(142623); };
    if ecs_reg_world_deep_has(w9, e1, ecs_reg_comp_info_id_deep(mark_info)) != false { panic(142624); };
    if ecs_reg_world_deep_has(w9, e2, ecs_reg_comp_info_id_deep(mark_info)) != true { panic(142625); };
}

// ── Test 3: query variants (mirror shallow "registry erased world stores multiple..." tail). ──
@test "EcsRegWorldDeep query/query_without/query_added_since"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let rm = ecs_reg_world_deep_register_sparse_set(w1, ECS_REG_TYPE_MARKER);
    let w2 = ecs_reg_register_world_deep(rm);
    let mark_info = ecs_reg_register_info_deep(rm);
    let sp1 = ecs_reg_world_deep_spawn(w2);
    let w3 = ecs_reg_spawn_world_deep(sp1);
    let e1 = ecs_reg_spawn_entity_deep(sp1);
    let sp2 = ecs_reg_world_deep_spawn(w3);
    let w4 = ecs_reg_spawn_world_deep(sp2);
    let e2 = ecs_reg_spawn_entity_deep(sp2);
    let w5 = ecs_reg_world_deep_insert_pos(w4, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(1, 0));
    let w6 = ecs_reg_world_deep_insert_marker(w5, e1, ecs_reg_comp_info_id_deep(mark_info), ecs_reg_marker_deep_new(1));
    let w7 = ecs_reg_world_deep_insert_pos(w6, e2, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(2, 0));
    // query: both present.
    let positions = ecs_reg_world_deep_query(w7, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_query_deep_count(positions) != 2 { panic(142630); };
    // query_without(marker): only e1 has marker; e2 alone survives.
    let unmarked = ecs_reg_world_deep_query_without(w7, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_comp_info_id_deep(mark_info));
    if ecs_reg_query_deep_count(unmarked) != 1 { panic(142631); };
    let unmarked_e = ecs_reg_query_deep_at(unmarked, 0);
    if ecs_reg_entity_eq_deep(unmarked_e, e2) != true { panic(142632); };
    // query_added_since(0): both were added at change_tick after register (which advanced tick).
    let added = ecs_reg_world_deep_query_added(w7, ecs_reg_comp_info_id_deep(pos_info), 0);
    if ecs_reg_query_deep_count(added) != 2 { panic(142633); };
}

// ── Test 4: pair query writeback + cleanup (mirrors shallow test 2). ──────────────────────────
@test "EcsRegWorldDeep pair query + pair_without + pair_mut_first writeback + changed_since"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let rv = ecs_reg_world_deep_register_table(w1, ECS_REG_TYPE_VEL);
    let w2 = ecs_reg_register_world_deep(rv);
    let vel_info = ecs_reg_register_info_deep(rv);
    let sp = ecs_reg_world_deep_spawn(w2);
    let w3 = ecs_reg_spawn_world_deep(sp);
    let entity = ecs_reg_spawn_entity_deep(sp);
    let before = ecs_reg_world_deep_change_tick(w3);
    let w4 = ecs_reg_world_deep_insert_pos(w3, entity, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(2, 0));
    let w5 = ecs_reg_world_deep_insert_vel(w4, entity, ecs_reg_comp_info_id_deep(vel_info), ecs_reg_vel_deep_new(5, 0));
    let w6 = ecs_reg_world_deep_increment_tick(w5);
    let pairs = ecs_reg_world_deep_query_pair_pos_vel(w6, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_comp_info_id_deep(vel_info));
    if ecs_reg_pair_query_deep_count(pairs) != 1 { panic(142640); };
    let pair0 = ecs_reg_pair_query_deep_at(pairs, 0);
    let p0_first = ecs_reg_pair_deep_pos_vel_first(pair0);
    let p0_second = ecs_reg_pair_deep_pos_vel_second(pair0);
    if (ecs_reg_pos_deep_x(p0_first) + ecs_reg_vel_deep_x(p0_second)) != 7 { panic(142641); };
    // pair query with a nonexistent without_component_id (999 -> no column) -> all are kept.
    let pairs_without_missing = ecs_reg_world_deep_query_pair_pos_vel_without(w6, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_comp_info_id_deep(vel_info), 999);
    if ecs_reg_pair_query_deep_count(pairs_without_missing) != 1 { panic(142642); };
    let mut_pairs = ecs_reg_world_deep_query_pair_mut_pos_vel(w6, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_comp_info_id_deep(vel_info));
    let item = ecs_reg_pair_mut_query_deep_at(mut_pairs, 0);
    let item_first = ecs_reg_pair_mut_pos_vel_first(item);
    let item_second = ecs_reg_pair_mut_pos_vel_second(item);
    let next_pos = ecs_reg_pos_deep_new(ecs_reg_pos_deep_x(item_first) + ecs_reg_vel_deep_x(item_second), 0);
    let w7 = ecs_reg_world_deep_pair_write_first_pos_vel(w6, item, next_pos);
    let out = ecs_reg_world_deep_get_pos(w7, entity, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_pos_deep_x(out) != 7 { panic(142643); };
    let changed = ecs_reg_world_deep_query_changed(w7, ecs_reg_comp_info_id_deep(pos_info), before);
    if ecs_reg_query_deep_count(changed) != 1 { panic(142644); };
}

// ── Test 5: despawn + is_alive + has + entity_count + remove. ─────────────────────────────────
@test "EcsRegWorldDeep despawn + remove + has + alive (shallow test 2 tail mirrors)"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let sp = ecs_reg_world_deep_spawn(w1);
    let w2 = ecs_reg_spawn_world_deep(sp);
    let e1 = ecs_reg_spawn_entity_deep(sp);
    let w3 = ecs_reg_world_deep_insert_pos(w2, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(7, 0));
    if ecs_reg_world_deep_entity_count(w3) != 1 { panic(142650); };
    // remove then has false; entity still alive.
    let w4 = ecs_reg_world_deep_remove(w3, e1, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_world_deep_has(w4, e1, ecs_reg_comp_info_id_deep(pos_info)) != false { panic(142651); };
    if ecs_reg_world_deep_is_alive(w4, e1) != true { panic(142652); };
    // re-insert then despawn: alive goes false, has false, entity_count -1.
    let w5 = ecs_reg_world_deep_insert_pos(w4, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(7, 0));
    let w6 = ecs_reg_world_deep_despawn(w5, e1);
    if ecs_reg_world_deep_is_alive(w6, e1) != false { panic(142653); };
    if ecs_reg_world_deep_has(w6, e1, ecs_reg_comp_info_id_deep(pos_info)) != false { panic(142654); };
    if ecs_reg_world_deep_entity_count(w6) != 0 { panic(142655); };
    // stale entity id with old generation should not be alive.
    if ecs_reg_world_deep_is_alive(w6, e1) != false { panic(142656); };
    // Spawn again: the deep does not recycle slots (monotone next_entity), so the new entity takes
    // the next free slot (id 1, gen 0). It MUST NOT be confused with the dead e1.
    let sp2 = ecs_reg_world_deep_spawn(w6);
    let w7 = ecs_reg_spawn_world_deep(sp2);
    let other = ecs_reg_spawn_entity_deep(sp2);
    if other.id != 1 { panic(142657); };
    if other.generation != 0 { panic(142658); };
    if ecs_reg_world_deep_entity_count(w7) != 1 { panic(142659); };
}

// ── Test 6: insert_resource + get_resource + write_message + read_message (shallow test 2 tail). ─
@test "EcsRegWorldDeep insert_resource + write_message + read_message + change_tick after tick"() {
    // Replicates the shallow test 2 tail: tick advances once for register, once for increment_tick
    // (register_pos + register_vel + increment_tick = 3 ticks); then despawn; res_time is set to
    // w6.registry.change_tick; message amount is 6.
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let rv = ecs_reg_world_deep_register_table(w1, ECS_REG_TYPE_VEL);
    let w2 = ecs_reg_register_world_deep(rv);
    let sp = ecs_reg_world_deep_spawn(w2);
    let w3 = ecs_reg_spawn_world_deep(sp);
    let entity = ecs_reg_spawn_entity_deep(sp);
    let before = ecs_reg_world_deep_change_tick(w3);
    let w4 = ecs_reg_world_deep_insert_pos(w3, entity, 0, ecs_reg_pos_deep_new(2, 0));
    let w5 = ecs_reg_world_deep_insert_vel(w4, entity, 1, ecs_reg_vel_deep_new(5, 0));
    let w6 = ecs_reg_world_deep_increment_tick(w5);
    // change_tick sequence: new=0, register pos=1, register vel=2, insert (no flush tick), insert, increment_tick=3.
    // The shallow measures the same: increment_tick+register+register sequence totals 3 by despawn time.
    let w7 = ecs_reg_world_deep_insert_resource(w6, ecs_reg_time_deep_new(ecs_reg_world_deep_change_tick(w6)));
    let w8 = ecs_reg_world_deep_write_message(w7, ecs_reg_event_deep_new(6));
    let w9 = ecs_reg_world_deep_despawn(w8, entity);
    let time = ecs_reg_world_deep_get_resource(w9);
    if ecs_reg_time_deep_tick(time) != 3 { panic(142660); };
    let event = ecs_reg_world_deep_read_message(w9, ecs_reg_event_deep_new(0));
    if ecs_reg_message_read_amount(event) != 6 { panic(142661); };
    if ecs_reg_message_read_count(event) != 1 { panic(142662); };
    // unused reader signal (the shallow test passes a fresh reader; default+0 message -> default).

    // read on a world with NO messages returns the default amount.
    let just_resources = ecs_reg_world_deep_insert_resource(ecs_reg_world_deep_new(), ecs_reg_time_deep_new(2));
    let none = ecs_reg_world_deep_read_message(just_resources, ecs_reg_event_deep_new(99));
    if ecs_reg_message_read_amount(none) != 99 { panic(142663); };
    if ecs_reg_message_read_count(none) != 0 { panic(142664); };
    // before snapshot must reflect change_tick after the two registers but BEFORE the increment.
    if before != 2 { panic(142665); };
}

// ── Test 7: out-of-range + despawn-of-non-alive + query sees non-alive excluded. ─────────────
@test "EcsRegWorldDeep non-alive probes + query excludes despawned col slot"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let bogus = ecs_reg_entity_new(-1, 0);
    if ecs_reg_world_deep_is_alive(w1, bogus) != false { panic(142670); };
    let out_of_range = ecs_reg_entity_new(99, 0);
    if ecs_reg_world_deep_is_alive(w1, out_of_range) != false { panic(142671); };
    let sp1 = ecs_reg_world_deep_spawn(w1);
    let w2 = ecs_reg_spawn_world_deep(sp1);
    let e1 = ecs_reg_spawn_entity_deep(sp1);
    let sp2 = ecs_reg_world_deep_spawn(w2);
    let w3 = ecs_reg_spawn_world_deep(sp2);
    let e2 = ecs_reg_spawn_entity_deep(sp2);
    let w4 = ecs_reg_world_deep_insert_pos(w3, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(1, 0));
    let w5 = ecs_reg_world_deep_insert_pos(w4, e2, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(2, 0));
    let q_all = ecs_reg_world_deep_query(w5, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_query_deep_count(q_all) != 2 { panic(142672); };
    // despawn e1; query excludes it; remove on a despawned entity is a no-op.
    let w6 = ecs_reg_world_deep_despawn(w5, e1);
    let q_left = ecs_reg_world_deep_query(w6, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_query_deep_count(q_left) != 1 { panic(142673); };
    let w7 = ecs_reg_world_deep_remove(w6, e1, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_world_deep_has(w7, e1, ecs_reg_comp_info_id_deep(pos_info)) != false { panic(142674); };
    // despawn on an entity that's not alive is a no-op.
    let q_left_again = ecs_reg_world_deep_query(w7, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_query_deep_count(q_left_again) != 1 { panic(142675); };
    // remove on a missing component is a no-op; query on a missing comp_id is empty.
    let q_missing = ecs_reg_world_deep_query(w7, 999);
    if ecs_reg_query_deep_count(q_missing) != 0 { panic(142676); };
}

// ── Test 8: replace (re-insert on already-present) DOES NOT bump added_tick. ──────────────────
@test "EcsRegWorldDeep replace bumps changed but not added"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let sp = ecs_reg_world_deep_spawn(w1);
    let w2 = ecs_reg_spawn_world_deep(sp);
    let e1 = ecs_reg_spawn_entity_deep(sp);
    let t_after_register = ecs_reg_world_deep_change_tick(w2);
    let w3 = ecs_reg_world_deep_insert_pos(w2, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(1, 0));
    let t_after_first_insert = ecs_reg_world_deep_change_tick(w3);
    // first insert: added_at == t_after_register, so since_tick must be strictly below that.
    // Mirror shallow's query_added_since(0): added(=2) > 0 -> count 1.
    let added1 = ecs_reg_world_deep_query_added(w3, ecs_reg_comp_info_id_deep(pos_info), 0);
    if ecs_reg_query_deep_count(added1) != 1 { panic(142680); };
    // advance tick so subsequent re-inserts at the same tick don't accidentally satisfy added-since.
    let w4 = ecs_reg_world_deep_increment_tick(w3);
    let t_before_replace = ecs_reg_world_deep_change_tick(w4);
    let w5 = ecs_reg_world_deep_insert_pos(w4, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(8, 0));
    // re-insert: added-since t_after_register should NOT include e (added tick unchanged from the
    // first insert -- _set_changed_only does NOT write into added).
    let added2 = ecs_reg_world_deep_query_added(w5, ecs_reg_comp_info_id_deep(pos_info), t_after_register);
    if ecs_reg_query_deep_count(added2) != 0 { panic(142681); };
    // re-insert: changed-since t_after_first_insert should include e -- the re-insert advances
    // changed[e] from t_after_first_insert=1 to the post-increment tick 2, so changed(2) > 1 == true.
    let changed2 = ecs_reg_world_deep_query_changed(w5, ecs_reg_comp_info_id_deep(pos_info), t_after_first_insert);
    if ecs_reg_query_deep_count(changed2) != 1 { panic(142682); };
    let out = ecs_reg_world_deep_get_pos(w5, e1, ecs_reg_comp_info_id_deep(pos_info));
    if ecs_reg_pos_deep_x(out) != 8 { panic(142683); };
}

// ── Test 9: cap-16 entity reject + cap-8 column reject silent. ────────────────────────────────
@test "EcsRegWorldDeep cap-16 entity reject + cap-8 column cap silent"() {
    let w0 = ecs_reg_world_deep_new();
    // First spawn (id 0) is separable so we can assert it.
    let s1 = ecs_reg_world_deep_spawn(w0);
    let wa = ecs_reg_spawn_world_deep(s1);
    let e1 = ecs_reg_spawn_entity_deep(s1);
    if e1.id != 0 { panic(142690); };
    // Spawns 15 more (we already have 1) -> 16 total. The 16th (id 0..15) verifies the cap.
    let wb = ecs_reg_world_deep_spawn_many(wa, 15);
    if ecs_reg_world_deep_entity_count(wb) != 16 { panic(142693); };
    // The 17th spawn hits the cap-16 silent reject.
    let s17 = ecs_reg_world_deep_spawn(wb);
    let wc = ecs_reg_spawn_world_deep(s17);
    let e17 = ecs_reg_spawn_entity_deep(s17);
    if e17.id != -1 { panic(142694); };
    if ecs_reg_world_deep_is_alive(wc, e17) != false { panic(142695); };
    // Register 8 columns (cap), then a 9th which is rejected (info.id == -1). We register the first 7
    // via the helper, then explicitly register the 8th and the rejected 9th.
    let wd = ecs_reg_world_deep_register_many(wc, 7);
    let r8 = ecs_reg_world_deep_register_table(wd, ECS_REG_TYPE_POS);
    let w8 = ecs_reg_register_world_deep(r8);
    let i8 = ecs_reg_register_info_deep(r8);
    if i8.id != 7 { panic(142691); };
    let r9 = ecs_reg_world_deep_register_table(w8, ECS_REG_TYPE_POS);
    let w9 = ecs_reg_register_world_deep(r9);
    let i9 = ecs_reg_register_info_deep(r9);
    if ecs_reg_world_deep_component_count(w9) != 8 { panic(142696); };
    if i9.id != -1 { panic(142697); };
    // e16 is the last in-range slot; verify it was id 15 (16th spawn overall, after e1 plus 15 more).
    let e16 = ecs_reg_entity_new(15, 0);
    if ecs_reg_world_deep_is_alive(w9, e16) != true { panic(142692); };
}

// ── Test 10: multi-column query + key adjust + despawn restores slot capacity. ────────────────
@test "EcsRegWorldDeep multi-column query + despawn-then-respawn at same slot + generation"() {
    let w0 = ecs_reg_world_deep_new();
    let rp = ecs_reg_world_deep_register_table(w0, ECS_REG_TYPE_POS);
    let w1 = ecs_reg_register_world_deep(rp);
    let pos_info = ecs_reg_register_info_deep(rp);
    let rv = ecs_reg_world_deep_register_table(w1, ECS_REG_TYPE_VEL);
    let w2 = ecs_reg_register_world_deep(rv);
    let vel_info = ecs_reg_register_info_deep(rv);
    // 3 entities: e1 (pos only), e2 (pos+vel), e3 (vel only).
    let sp1 = ecs_reg_world_deep_spawn(w2);
    let w3 = ecs_reg_spawn_world_deep(sp1);
    let e1 = ecs_reg_spawn_entity_deep(sp1);
    let sp2 = ecs_reg_world_deep_spawn(w3);
    let w4 = ecs_reg_spawn_world_deep(sp2);
    let e2 = ecs_reg_spawn_entity_deep(sp2);
    let sp3 = ecs_reg_world_deep_spawn(w4);
    let w5 = ecs_reg_spawn_world_deep(sp3);
    let e3 = ecs_reg_spawn_entity_deep(sp3);
    let w6 = ecs_reg_world_deep_insert_pos(w5, e1, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(1, 0));
    let w7 = ecs_reg_world_deep_insert_pos(w6, e2, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_pos_deep_new(2, 0));
    let w8 = ecs_reg_world_deep_insert_vel(w7, e2, ecs_reg_comp_info_id_deep(vel_info), ecs_reg_vel_deep_new(3, 0));
    let w9 = ecs_reg_world_deep_insert_vel(w8, e3, ecs_reg_comp_info_id_deep(vel_info), ecs_reg_vel_deep_new(4, 0));
    // pair query: only e2 has both pos + vel.
    let pairs = ecs_reg_world_deep_query_pair_pos_vel(w9, ecs_reg_comp_info_id_deep(pos_info), ecs_reg_comp_info_id_deep(vel_info));
    if ecs_reg_pair_query_deep_count(pairs) != 1 { panic(142698); };
    let pair0_e = ecs_reg_pair_deep_pos_vel_entity(ecs_reg_pair_query_deep_at(pairs, 0));
    if ecs_reg_entity_eq_deep(pair0_e, e2) != true { panic(142699); };
}
