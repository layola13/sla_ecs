// Isolated deep tests for lib/commands_mod_extension_deep.sla (Batch 369).
// Commands-side boxed-system registry + deferred command queue, plus EntityCommands-side extension state.
// panic codes: 139800 - 139999.

@import "lib/commands_mod_extension_deep.sla"

@test "CmdExt new empty and zero counts"() {
    let c = ecs_cmd_ext_commands_deep_new();
    if ecs_cmd_ext_commands_deep_len(c) != 0 { panic(139800); };
    if ecs_cmd_ext_commands_deep_sys_count(c) != 0 { panic(139801); };
    if ecs_cmd_ext_commands_deep_bound_entities(c) != 0 { panic(139802); };
    if ecs_cmd_ext_kind_at(c, 0) != 0 { panic(139803); };
    if ecs_cmd_ext_sys_id_at(c, 0) != 0 { panic(139804); };
}

@test "register_boxed_system reserves increasing ids and run_system_cached finds in range"() {
    let c0 = ecs_cmd_ext_commands_deep_new();
    let (c1, id1) = ecs_cmd_ext_register_boxed_system(c0);
    if id1 != 1 { panic(139810); };
    if ecs_cmd_ext_commands_deep_sys_count(c1) != 1 { panic(139811); };
    if ecs_cmd_ext_sys_id_at(c1, 0) != 1 { panic(139812); };
    let (c2, id2) = ecs_cmd_ext_register_boxed_system(c1);
    if id2 != 2 { panic(139813); };
    if ecs_cmd_ext_commands_deep_sys_count(c2) != 2 { panic(139814); };
    let (c3, found) = ecs_cmd_ext_run_system_cached(c2, 1);
    if found != 1 { panic(139815); };
    let (c4, found2) = ecs_cmd_ext_run_system_cached(c3, 3);
    if found2 != -1 { panic(139816); };
    let (c5, sysid, inp) = ecs_cmd_ext_run_system_cached_with(c4, 2, 777);
    if sysid != 2 { panic(139817); };
    if inp != 777 { panic(139818); };
}

@test "unregister_system_cached removes only the last-registered id"() {
    let c0 = ecs_cmd_ext_commands_deep_new();
    let (c1, id1) = ecs_cmd_ext_register_boxed_system(c0);
    let (c2, id2) = ecs_cmd_ext_register_boxed_system(c1);
    let (c3, found, removed_id) = ecs_cmd_ext_unregister_system_cached(c2, 1);
    if found != false { panic(139820); };
    if removed_id != 1 { panic(139821); };
    if ecs_cmd_ext_commands_deep_sys_count(c3) != 2 { panic(139822); };
    let (c4, found2, removed_id2) = ecs_cmd_ext_unregister_system_cached(c3, 2);
    if found2 != true { panic(139823); };
    if removed_id2 != 2 { panic(139824); };
    if ecs_cmd_ext_commands_deep_sys_count(c4) != 1 { panic(139825); };
    if ecs_cmd_ext_sys_id_at(c4, 1) != 0 { panic(139826); };
}

@test "trigger/trigger_with/add_observer/write_message/run_schedule enqueue correct kinds and metadata"() {
    let c0 = ecs_cmd_ext_commands_deep_new();
    let (c1, ev1) = ecs_cmd_ext_trigger(c0, 50);
    if ev1 != 50 { panic(139830); };
    if ecs_cmd_ext_kind_at(c1, 0) != ECS_CMDEXT_KIND_TRIGGER { panic(139831); };
    if ecs_cmd_ext_primary_at(c1, 0) != 50 { panic(139832); };
    let (c2, ev2) = ecs_cmd_ext_trigger_with(c1, 51, 9999);
    if ev2 != 51 { panic(139833); };
    if ecs_cmd_ext_kind_at(c2, 1) != ECS_CMDEXT_KIND_TRIGGER_WITH { panic(139834); };
    if ecs_cmd_ext_secondary_at(c2, 1) != 9999 { panic(139835); };
    let (c3, ok_obs) = ecs_cmd_ext_add_observer(c2, 888);
    if ok_obs != true { panic(139836); };
    if ecs_cmd_ext_kind_at(c3, 2) != ECS_CMDEXT_KIND_ADD_OBSERVER { panic(139837); };
    if ecs_cmd_ext_primary_at(c3, 2) != 888 { panic(139838); };
    let (c4, mid) = ecs_cmd_ext_write_message(c3, 42);
    if mid != 42 { panic(139839); };
    if ecs_cmd_ext_kind_at(c4, 3) != ECS_CMDEXT_KIND_WRITE_MESSAGE { panic(139840); };
    let (c5, ok_sched) = ecs_cmd_ext_run_schedule(c4, 7);
    if ok_sched != true { panic(139841); };
    if ecs_cmd_ext_kind_at(c5, 4) != ECS_CMDEXT_KIND_RUN_SCHEDULE { panic(139842); };
    let (c6, ok_neg) = ecs_cmd_ext_run_schedule(c5, -1);
    if ok_neg != false { panic(139843); };
    if ecs_cmd_ext_commands_deep_len(c6) != 5 { panic(139844); };
}

@test "count_by_kind categorizes a mixed queue and get_spawned_entity flags requests"() {
    let c0 = ecs_cmd_ext_commands_deep_new();
    let (c1, ev1) = ecs_cmd_ext_trigger(c0, 1);
    let (c2, ev2) = ecs_cmd_ext_trigger(c1, 2);
    let (c3, obs) = ecs_cmd_ext_add_observer(c2, 5);
    let (c4, mid) = ecs_cmd_ext_write_message(c3, 9);
    if ecs_cmd_ext_commands_deep_count_by_kind(c4, ECS_CMDEXT_KIND_TRIGGER) != 2 { panic(139850); };
    if ecs_cmd_ext_commands_deep_count_by_kind(c4, ECS_CMDEXT_KIND_ADD_OBSERVER) != 1 { panic(139851); };
    if ecs_cmd_ext_commands_deep_count_by_kind(c4, ECS_CMDEXT_KIND_WRITE_MESSAGE) != 1 { panic(139852); };
    if ecs_cmd_ext_commands_deep_count_by_kind(c4, ECS_CMDEXT_KIND_RUN_SCHEDULE) != 0 { panic(139853); };
    if ecs_cmd_ext_commands_deep_len(c4) != 4 { panic(139854); };
    let (c5rsp, ent, is_spawn, was_found) = ecs_cmd_ext_get_spawned_entity(c4, -3);
    if ent != -3 { panic(139855); };
    if is_spawn != true { panic(139856); };
    if was_found != false { panic(139857); };
    let (c6rsp, ent2, is_spawn2, was_found2) = ecs_cmd_ext_get_spawned_entity(c5rsp, 7);
    if is_spawn2 != false { panic(139858); };
    if was_found2 != true { panic(139859); };
}

@test "cap-8 rejection on command queue and registry, and clear resets"() {
    let c0 = ecs_cmd_ext_commands_deep_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        let (cn, ev) = ecs_cmd_ext_trigger(c1, i);
        c1 = cn;
        i = i + 1;
    }
    if ecs_cmd_ext_commands_deep_len(c1) != 8 { panic(139870); };
    let (c2, ev) = ecs_cmd_ext_trigger(c1, 99);
    if ecs_cmd_ext_commands_deep_len(c2) != 8 { panic(139871); };
    // registry cap-8: 8 systems register, 9th rejected.
    let c3 = ecs_cmd_ext_commands_deep_new();
    let c4 = c3;
    let j: i32 = 0;
    while j < 8 {
        let (cn, sid) = ecs_cmd_ext_register_boxed_system(c4);
        c4 = cn;
        j = j + 1;
    }
    if ecs_cmd_ext_commands_deep_sys_count(c4) != 8 { panic(139872); };
    let (c5, sid9) = ecs_cmd_ext_register_boxed_system(c4);
    if sid9 != -1 { panic(139873); };
    if ecs_cmd_ext_commands_deep_sys_count(c5) != 8 { panic(139874); };
    let c6 = ecs_cmd_ext_commands_deep_clear(c5);
    if ecs_cmd_ext_commands_deep_len(c6) != 0 { panic(139875); };
    if ecs_cmd_ext_commands_deep_sys_count(c6) != 0 { panic(139876); };
}

@test "new_from_entities binds the world marker and reborrow/rebound are pass-through"() {
    let c0 = ecs_cmd_ext_commands_deep_new_from_entities(555);
    if ecs_cmd_ext_commands_deep_bound_entities(c0) != 555 { panic(139880); };
    if ecs_cmd_ext_commands_deep_len(c0) != 0 { panic(139881); };
    let c1 = ecs_cmd_ext_rebound_to(c0);
    if ecs_cmd_ext_commands_deep_bound_entities(c1) != 555 { panic(139882); };
    let c2 = ecs_cmd_ext_reborrow(c1);
    if ecs_cmd_ext_commands_deep_sys_count(c2) != 0 { panic(139883); };
}

@test "EntityCmdExt state: id/is_spawned/pending/observe/trigger and entry/queue/log"() {
    let s0 = ecs_entity_cmd_ext_deep_new(42, true);
    if ecs_entity_cmd_ext_id(s0) != 42 { panic(139890); };
    if ecs_entity_cmd_ext_entity(s0) != 42 { panic(139891); };
    if ecs_entity_cmd_ext_is_spawned(s0) != true { panic(139892); };
    if ecs_entity_cmd_ext_get_pending(s0) != 0 { panic(139893); };
    let (s1, comp) = ecs_entity_cmd_ext_entry(s0, 11);
    if comp != 11 { panic(139894); };
    if ecs_entity_cmd_ext_last_component(s1) != 11 { panic(139895); };
    if ecs_entity_cmd_ext_get_pending(s1) != 1 { panic(139896); };
    let (s2, handled) = ecs_entity_cmd_ext_queue_handled(s1, 12);
    if handled != true { panic(139897); };
    let (s3, silenced) = ecs_entity_cmd_ext_queue_silenced(s2, 13);
    if silenced != false { panic(139898); };
    let (s4, lc) = ecs_entity_cmd_ext_log_components(s3, 5);
    if lc != 5 { panic(139899); };
    if ecs_entity_cmd_ext_get_pending(s4) != 4 { panic(139900); };
    let s5 = ecs_entity_cmd_ext_commands(s4);
    let s6 = ecs_entity_cmd_ext_commands_mut(s5);
    if ecs_entity_cmd_ext_get_pending(s6) != 6 { panic(139901); };
    let (s7, obs_ok) = ecs_entity_cmd_ext_observe(s6, 900);
    if obs_ok != true { panic(139902); };
    if ecs_entity_cmd_ext_pending_observes(s7) != 1 { panic(139903); };
    if ecs_entity_cmd_ext_last_event(s7) != 900 { panic(139904); };
    let (s8, evid) = ecs_entity_cmd_ext_trigger(s7, 901);
    if evid != 901 { panic(139905); };
    if ecs_entity_cmd_ext_last_event(s8) != 901 { panic(139906); };
    if ecs_entity_cmd_ext_get_pending(s8) != 7 { panic(139907); };
    let s9 = ecs_entity_cmd_ext_reborrow(s8);
    if ecs_entity_cmd_ext_last_event(s9) != 901 { panic(139908); };
}

@test "EntityCmdExt clone/move variants set cloned_to, counts, and move clears is_spawned"() {
    let s0 = ecs_entity_cmd_ext_deep_new(100, true);
    let (s1, opt_out_n) = ecs_entity_cmd_ext_clone_with_opt_out(s0, 200, 3);
    if opt_out_n != 3 { panic(139910); };
    if ecs_entity_cmd_ext_cloned_to(s1) != 200 { panic(139911); };
    let (s2, opt_in_n) = ecs_entity_cmd_ext_clone_with_opt_in(s1, 201, 4);
    if opt_in_n != 4 { panic(139912); };
    if ecs_entity_cmd_ext_cloned_to(s2) != 201 { panic(139913); };
    let (s3, new_target, spawned) = ecs_entity_cmd_ext_clone_and_spawn(s2, 202);
    if new_target != 202 { panic(139914); };
    if spawned != true { panic(139915); };
    let (s4, cso_n) = ecs_entity_cmd_ext_clone_and_spawn_with_opt_out(s3, 203, 6);
    if cso_n != 6 { panic(139916); };
    if ecs_entity_cmd_ext_cloned_to(s4) != 203 { panic(139917); };
    let (s5, csi_n) = ecs_entity_cmd_ext_clone_and_spawn_with_opt_in(s4, 204, 7);
    if csi_n != 7 { panic(139918); };
    if ecs_entity_cmd_ext_cloned_to(s5) != 204 { panic(139919); };
    let (s6, cc_n) = ecs_entity_cmd_ext_clone_components(s5, 205, 8);
    if cc_n != 8 { panic(139920); };
    if ecs_entity_cmd_ext_cloned_to(s6) != 205 { panic(139921); };
    // move_components clears is_spawned on source (despawn-on-move) and queues despawn.
    if ecs_entity_cmd_ext_is_spawned(s6) != true { panic(139922); };
    let (s7, mc_n, despawned) = ecs_entity_cmd_ext_move_components(s6, 206, 9);
    if mc_n != 9 { panic(139923); };
    if despawned != true { panic(139924); };
    if ecs_entity_cmd_ext_cloned_to(s7) != 206 { panic(139925); };
    if ecs_entity_cmd_ext_is_spawned(s7) != false { panic(139926); };
    // 9 clone/move ops queued through interspersed (opt_out / opt_in / clone_and_spawn /
    // clone_and_spawn_with_opt_out / clone_and_spawn_with_opt_in / clone_components / move_components)
    // each increments pending_commands by 1 — entry/queue/log not invoked in this test.
    if ecs_entity_cmd_ext_get_pending(s7) != 7 { panic(139927); };
}

@test "EntityCmdExt non-spawned construction and per-op pending accounting"() {
    let s0 = ecs_entity_cmd_ext_deep_new(300, false);
    if ecs_entity_cmd_ext_is_spawned(s0) != false { panic(139930); };
    if ecs_entity_cmd_ext_get_pending(s0) != 0 { panic(139931); };
    if ecs_entity_cmd_ext_pending_observes(s0) != 0 { panic(139932); };
    if ecs_entity_cmd_ext_cloned_to(s0) != -1 { panic(139933); };
    // entry sets last_component to the component id; pending increments by 1.
    let (s1, comp) = ecs_entity_cmd_ext_entry(s0, 71);
    if comp != 71 { panic(139934); };
    if ecs_entity_cmd_ext_last_component(s1) != 71 { panic(139935); };
    // queue_handled then queue_silenced update last_component each time; both return
    // distinct handled-bool (true vs false) mirroring the shallow surface.
    let (s2, handled) = ecs_entity_cmd_ext_queue_handled(s1, 72);
    if handled != true { panic(139936); };
    if ecs_entity_cmd_ext_last_component(s2) != 72 { panic(139937); };
    let (s3, silenced) = ecs_entity_cmd_ext_queue_silenced(s2, 73);
    if silenced != false { panic(139938); };
    if ecs_entity_cmd_ext_last_component(s3) != 73 { panic(139939); };
    // log_components returns the component-count parameter (its surface return) without
    // mutating last_component (mirror shallow returns len(components) but tracks pending).
    let (s4, lc) = ecs_entity_cmd_ext_log_components(s3, 9);
    if lc != 9 { panic(139940); };
    if ecs_entity_cmd_ext_last_component(s4) != 73 { panic(139941); };
    // observe increments pending_observes (independent of pending_commands) and records the
    // observer entity only in last_event.
    let (s5, obs) = ecs_entity_cmd_ext_observe(s4, 777);
    if obs != true { panic(139942); };
    if ecs_entity_cmd_ext_pending_observes(s5) != 1 { panic(139943); };
    if ecs_entity_cmd_ext_get_pending(s5) != 4 { panic(139944); };
    if ecs_entity_cmd_ext_last_event(s5) != 777 { panic(139945); };
}
