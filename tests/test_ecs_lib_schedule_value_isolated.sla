@import "lib/schedule_value.sla"

// Isolated tests for lib/schedule_value.sla — Schedule value model.
// Bevy reference: src/schedule/schedule.rs (Schedule struct lines 387-715)

@test "schedule_value_new_defaults"() {
    let s = ecs_schedule_new(42);
    if ecs_schedule_label(s) != 42 { panic(95000); };
    if ecs_schedule_is_changed(s) != true { panic(95001); };
    if ecs_schedule_executor_initialized(s) != false { panic(95002); };
    if ecs_schedule_apply_final_deferred(s) != true { panic(95003); };
    if ecs_schedule_executor_kind(s) != 0 { panic(95004); };
}

@test "schedule_value_default_label_zero"() {
    let s = ecs_schedule_default();
    if ecs_schedule_label(s) != 0 { panic(95010); };
}

@test "schedule_value_mark_changed_resets_executor"() {
    let s = ecs_schedule_new(1);
    let r = ecs_schedule_initialize(s);
    let s2 = r.0;
    if ecs_schedule_executor_initialized(s2) != true { panic(95020); };
    let s3 = ecs_schedule_mark_changed(s2);
    if ecs_schedule_is_changed(s3) != true { panic(95021); };
    if ecs_schedule_executor_initialized(s3) != false { panic(95022); };
}

@test "schedule_value_set_executor_multi"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_set_executor(s, 0);
    if ecs_schedule_executor_kind(s2) != 0 { panic(95030); };
    if ecs_schedule_executor_initialized(s2) != false { panic(95031); };
}

@test "schedule_value_set_executor_single"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_set_executor(s, 1);
    if ecs_schedule_executor_kind(s2) != 1 { panic(95040); };
}

@test "schedule_value_set_apply_final_deferred"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_set_apply_final_deferred(s, false);
    if ecs_schedule_apply_final_deferred(s2) != false { panic(95050); };
}

@test "schedule_value_set_build_settings"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_set_build_settings(s, 1, 2, false);
    if ecs_schedule_get_build_settings_ambiguity(s2) != 1 { panic(95060); };
    if ecs_schedule_get_build_settings_hierarchy(s2) != 2 { panic(95061); };
    if ecs_schedule_get_build_settings_auto_insert(s2) != false { panic(95062); };
}

@test "schedule_value_add_system_marks_changed"() {
    let s = ecs_schedule_default();
    let r = ecs_schedule_initialize(s);
    let s2 = r.0;
    if ecs_schedule_is_changed(s2) != false { panic(95070); };
    let s3 = ecs_schedule_add_system(s2, 100, 2);
    if ecs_schedule_is_changed(s3) != true { panic(95071); };
    if ecs_schedule_executor_initialized(s3) != false { panic(95072); };
}

@test "schedule_value_add_set_marks_changed"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_set(s, 7, 1);
    if ecs_schedule_is_changed(s2) != true { panic(95080); };
    if ecs_schedule_graph_set_count(s2) != 1 { panic(95081); };
}

@test "schedule_value_initialize_freezes_counts_and_clears_changed"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 1, 0);
    let s3 = ecs_schedule_add_system(s2, 2, 1);
    let s4 = ecs_schedule_add_set(s3, 10, 0);
    if ecs_schedule_is_changed(s4) != true { panic(95090); };
    let r = ecs_schedule_initialize(s4);
    let s5 = r.0;
    if ecs_schedule_is_changed(s5) != false { panic(95091); };
    if ecs_schedule_executor_initialized(s5) != true { panic(95092); };
    if ecs_schedule_graph_system_count(s5) != 2 { panic(95093); };
    if ecs_schedule_graph_set_count(s5) != 1 { panic(95094); };
}

@test "schedule_value_systems_uninitialized_returns_false"() {
    let s = ecs_schedule_default();
    let r = ecs_schedule_systems(s);
    if r.0 != false { panic(95100); };
}

@test "schedule_value_systems_initialized_returns_ids"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 10, 0);
    let s3 = ecs_schedule_add_system(s2, 20, 0);
    let r = ecs_schedule_initialize(s3);
    let s4 = r.0;
    let sr = ecs_schedule_systems(s4);
    if sr.0 != true { panic(95110); };
    if len(sr.1) as i32 != 2 { panic(95111); };
    if sr.1[0] != 10 { panic(95112); };
    if sr.1[1] != 20 { panic(95113); };
}

@test "schedule_value_systems_len_uninitialized_returns_false"() {
    let s = ecs_schedule_default();
    let r = ecs_schedule_systems_len(s);
    if r.0 != false { panic(95120); };
    if r.1 != 0 { panic(95121); };
}

@test "schedule_value_systems_len_initialized"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 1, 0);
    let s3 = ecs_schedule_add_system(s2, 2, 0);
    let s4 = ecs_schedule_add_system(s3, 3, 0);
    let r = ecs_schedule_initialize(s4);
    let s5 = r.0;
    let lr = ecs_schedule_systems_len(s5);
    if lr.0 != true { panic(95130); };
    if lr.1 != 3 { panic(95131); };
}

@test "schedule_value_check_change_ticks_updates_ticks"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 1, 0);
    let s3 = ecs_schedule_add_system(s2, 2, 0);
    let r = ecs_schedule_check_change_ticks(s3, 99);
    let s4 = r.0;
    let cr = r.1;
    if cr.checked_systems != 2 { panic(95140); };
    if cr.present_tick != 99 { panic(95141); };
}

@test "schedule_value_apply_deferred_returns_count"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 1, 0);
    let s3 = ecs_schedule_add_system(s2, 2, 0);
    let s4 = ecs_schedule_add_system(s3, 3, 0);
    let r = ecs_schedule_apply_deferred(s4);
    if r.1 != 3 { panic(95150); };
}

@test "schedule_value_run_initializes_and_returns_count"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 1, 0);
    let s3 = ecs_schedule_add_system(s2, 2, 0);
    let r = ecs_schedule_run(s3);
    let s4 = r.0;
    if ecs_schedule_executor_initialized(s4) != true { panic(95160); };
    if ecs_schedule_is_changed(s4) != false { panic(95161); };
    if r.1 != 2 { panic(95162); };
}

@test "schedule_value_systems_in_set_counts"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_set(s, 10, 0);
    let s3 = ecs_schedule_add_set(s2, 10, 0);
    let s4 = ecs_schedule_add_set(s3, 20, 0);
    if ecs_schedule_systems_in_set(s4, 10) != 2 { panic(95170); };
    if ecs_schedule_systems_in_set(s4, 20) != 1 { panic(95171); };
    if ecs_schedule_systems_in_set(s4, 99) != 0 { panic(95172); };
}

@test "schedule_value_remove_systems_in_set_marks_changed_and_removes"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_set(s, 10, 0);
    let s3 = ecs_schedule_add_set(s2, 20, 0);
    let s4 = ecs_schedule_add_set(s3, 10, 0);
    let r = ecs_schedule_initialize(s4);
    let s5 = r.0;
    if ecs_schedule_is_changed(s5) != false { panic(95180); };
    let s6 = ecs_schedule_remove_systems_in_set(s5, 10);
    if ecs_schedule_is_changed(s6) != true { panic(95181); };
    if ecs_schedule_executor_initialized(s6) != false { panic(95182); };
    if ecs_schedule_systems_in_set(s6, 10) != 0 { panic(95183); };
    if ecs_schedule_systems_in_set(s6, 20) != 1 { panic(95184); };
}

@test "schedule_value_cleanup_policy_default"() {
    let p = ecs_cleanup_policy_default();
    if ecs_cleanup_policy_is_remove_set_and_systems(p) != true { panic(96200); };
    if ecs_cleanup_policy_is_remove_systems_only(p) != false { panic(96201); };
    if ecs_cleanup_policy_is_remove_set_and_systems_allow_breakages(p) != false { panic(96202); };
    if ecs_cleanup_policy_is_remove_systems_only_allow_breakages(p) != false { panic(96203); };
}

@test "schedule_value_cleanup_policy_all_variants"() {
    if ecs_cleanup_policy_is_remove_set_and_systems(0) != true { panic(96210); };
    if ecs_cleanup_policy_is_remove_systems_only(1) != true { panic(96211); };
    if ecs_cleanup_policy_is_remove_set_and_systems_allow_breakages(2) != true { panic(96212); };
    if ecs_cleanup_policy_is_remove_systems_only_allow_breakages(3) != true { panic(96213); };
}

@test "schedule_value_remove_with_policy_remove_set_and_systems"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 10, 0);
    let s3 = ecs_schedule_add_system(s2, 20, 0);
    let s4 = ecs_schedule_add_set(s3, 99, 0);
    let s5 = ecs_schedule_add_set(s4, 99, 0);
    let r = ecs_schedule_initialize(s5);
    let s6 = r.0;
    let rr = ecs_schedule_remove_systems_in_set_with_policy(s6, 99, 0);
    let cr = rr.1;
    if cr.removed_count != 2 { panic(96220); };
    if cr.set_removed != true { panic(96221); };
    if cr.ok != true { panic(96222); };
    if ecs_schedule_executor_initialized(rr.0) != false { panic(96223); };
    if ecs_schedule_systems_in_set_count(rr.0, 99) != 0 { panic(96224); };
}

@test "schedule_value_remove_with_policy_remove_systems_only"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 10, 0);
    let s3 = ecs_schedule_add_set(s2, 99, 0);
    let s4 = ecs_schedule_add_set(s3, 99, 0);
    let s5 = ecs_schedule_add_set(s4, 100, 0);
    let r = ecs_schedule_initialize(s5);
    let s6 = r.0;
    let rr = ecs_schedule_remove_systems_in_set_with_policy(s6, 99, 1);
    let cr = rr.1;
    if cr.removed_count != 2 { panic(96230); };
    if cr.set_removed != false { panic(96231); };
    if ecs_schedule_systems_in_set_count(rr.0, 100) != 1 { panic(96232); };
}

@test "schedule_value_remove_with_policy_remove_systems_only_no_set_drop"() {
    let s = ecs_schedule_default();
    let s2 = ecs_schedule_add_system(s, 10, 0);
    let s3 = ecs_schedule_add_set(s2, 99, 0);
    let s4 = ecs_schedule_add_set(s3, 99, 0);
    let r = ecs_schedule_remove_systems_in_set_with_policy(s4, 99, 1);
    let cr = r.1;
    if cr.removed_count != 2 { panic(96240); };
    if cr.set_removed != false { panic(96241); };
}
