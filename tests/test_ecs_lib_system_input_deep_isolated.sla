@import "lib/system_input_deep.sla"

// Batch 184 tests for SystemInput wrap/Option/tuples/FromInput + SystemName SystemParam.

@test "wrap_unit_in_inref_inmut"() {
    let u = ecs_system_input_wrap_unit();
    if ecs_in_param_kind(u) != ECS_IN_KIND_UNIT { panic(101300); };
    let i = ecs_system_input_wrap_in(12);
    if ecs_in_param_kind(i) != ECS_IN_KIND_IN { panic(101301); };
    if ecs_in_param_value(i) != 12 { panic(101302); };
    let r = ecs_system_input_wrap_in_ref(5);
    if ecs_in_param_kind(r) != ECS_IN_KIND_IN_REF { panic(101303); };
    let m = ecs_system_input_wrap_in_mut(7);
    if ecs_in_param_kind(m) != ECS_IN_KIND_IN_MUT { panic(101304); };
    if ecs_in_param_mut_value(m) != 7 { panic(101305); };
}

@test "in_mut_square"() {
    let m = ecs_system_input_wrap_in_mut(12);
    m = ecs_in_mut_square(m);
    if ecs_in_param_mut_value(m) != 144 { panic(101310); };
    if ecs_in_param_value(m) != 144 { panic(101311); };
}

@test "in_param_deref_and_set"() {
    let m = ecs_system_input_wrap_in_mut(3);
    if ecs_in_param_deref(m) != 3 { panic(101320); };
    m = ecs_in_param_deref_mut_set(m, 9);
    if ecs_in_param_mut_value(m) != 9 { panic(101321); };
}

@test "option_some_and_none_wrap"() {
    let some = ecs_system_input_wrap_option(ecs_in_inner_option_some(ECS_IN_KIND_IN, 5));
    if ecs_in_param_kind(some) != ECS_IN_KIND_OPTION { panic(101330); };
    if ecs_in_param_has_value(some) != true { panic(101331); };
    if ecs_in_param_value(some) != 5 { panic(101332); };
    let none = ecs_system_input_wrap_option(ecs_in_inner_option_none(ECS_IN_KIND_IN));
    if ecs_in_param_has_value(none) != false { panic(101333); };
}

@test "static_system_input_wrap"() {
    let inner = ecs_in_inner_value(ECS_IN_KIND_IN, 8);
    let p = ecs_static_system_input_wrap(inner);
    if ecs_in_param_kind(p) != ECS_IN_KIND_STATIC { panic(101340); };
    if ecs_in_param_value(p) != 8 { panic(101341); };
}

@test "from_input_identity_and_static"() {
    let inner = ecs_in_inner_value(ECS_IN_KIND_IN, 4);
    let a = ecs_from_input_identity(inner);
    if ecs_in_inner_get_value(a) != 4 { panic(101350); };
    let b = ecs_from_input_static_from_in(inner);
    if ecs_in_inner_get_value(b) != 4 { panic(101351); };
}

@test "tuple2_wrap_and_access"() {
    let inner = ecs_in_inner_tuple2(1, 2);
    let p = ecs_system_input_wrap_tuple(inner);
    if ecs_in_param_kind(p) != ECS_IN_KIND_TUPLE { panic(101360); };
    if ecs_in_param_t_len(p) != 2 { panic(101361); };
    if ecs_in_param_t_at(p, 0) != 1 { panic(101362); };
    if ecs_in_param_t_at(p, 1) != 2 { panic(101363); };
}

@test "tuple3_and_tuple4"() {
    let t3 = ecs_system_input_wrap_tuple(ecs_in_inner_tuple3(1, 2, 3));
    if ecs_in_param_t_len(t3) != 3 { panic(101370); };
    if ecs_in_param_t_at(t3, 2) != 3 { panic(101371); };
    let t4 = ecs_system_input_wrap_tuple(ecs_in_inner_tuple4(1, 2, 3, 4));
    if ecs_in_param_t_len(t4) != 4 { panic(101372); };
    if ecs_in_param_t_at(t4, 3) != 4 { panic(101373); };
}

@test "tuple_add_mut_example"() {
    // (InMut(a), In(b)) => a += b
    if ecs_in_tuple_add_mut(12, 24) != 36 { panic(101380); };
}

@test "system_input_arity_ok"() {
    if ecs_system_input_arity_ok(0) != true { panic(101390); };
    if ecs_system_input_arity_ok(1) != true { panic(101391); };
    if ecs_system_input_arity_ok(2) != false { panic(101392); };
    if ecs_system_input_arity_ok(-1) != false { panic(101393); };
}

@test "pipe_input_matches"() {
    if ecs_system_input_matches_pipe(ECS_IN_KIND_IN, ECS_IN_KIND_IN) != true { panic(101400); };
    if ecs_system_input_matches_pipe(ECS_IN_KIND_IN, ECS_IN_KIND_IN_MUT) != false { panic(101401); };
}

@test "system_in_kind_from_param_kind"() {
    if ecs_system_in_kind_from_param_kind(ECS_IN_KIND_IN_REF) != ECS_IN_KIND_IN_REF { panic(101410); };
}

@test "on_observer_input_wrap"() {
    let p = ecs_system_input_wrap_on(99);
    if ecs_in_param_kind(p) != ECS_IN_KIND_ON { panic(101420); };
    if ecs_in_param_value(p) != 99 { panic(101421); };
}

@test "system_name_get_param_from_meta"() {
    let meta = ecs_system_meta_name_new(100, 1);
    let sn = ecs_system_name_deep_get_param(meta);
    if ecs_system_name_deep_name_id(sn) != 100 { panic(101430); };
    if ecs_system_name_deep_crate_id(sn) != 1 { panic(101431); };
    if ecs_system_name_deep_matches(sn, 100) != true { panic(101432); };
}

@test "system_name_exclusive_get_param_same"() {
    let meta = ecs_system_meta_name_new(50, 2);
    let sn = ecs_system_name_deep_get_param_exclusive(meta);
    if ecs_system_name_deep_name_id(sn) != 50 { panic(101440); };
}

@test "system_name_with_name_on_meta"() {
    let meta = ecs_system_meta_name_new(1, 0);
    meta = ecs_system_meta_name_with_name(meta, 99);
    let sn = ecs_system_name_deep_get_param(meta);
    if ecs_system_name_deep_name_id(sn) != 99 { panic(101450); };
    if ecs_system_meta_name_crate(meta) != 0 { panic(101451); };
}

@test "system_name_eq_and_read_only_access"() {
    let a = ecs_system_name_deep_get_param(ecs_system_meta_name_new(7, 0));
    let b = ecs_system_name_deep_get_param(ecs_system_meta_name_new(7, 1));
    let c = ecs_system_name_deep_get_param(ecs_system_meta_name_new(8, 0));
    if ecs_system_name_deep_eq(a, b) != true { panic(101460); };
    if ecs_system_name_deep_eq(a, c) != false { panic(101461); };
    if ecs_system_name_deep_is_read_only() != true { panic(101462); };
    if ecs_system_name_deep_init_access_adds_components() != false { panic(101463); };
}

@test "system_name_init_state"() {
    if ecs_system_name_deep_init_state() != 0 { panic(101470); };
}

@test "inner_constructors"() {
    let u = ecs_in_inner_unit();
    if ecs_in_inner_kind(u) != ECS_IN_KIND_UNIT { panic(101480); };
    if ecs_in_inner_has_value(u) != false { panic(101481); };
    let v = ecs_in_inner_value(ECS_IN_KIND_IN, 3);
    if ecs_in_inner_get_value(v) != 3 { panic(101482); };
    if ecs_in_inner_t_len(ecs_in_inner_tuple2(1, 2)) != 2 { panic(101483); };
}

@test "wrap_preserves_tuple_slots"() {
    let p = ecs_system_input_wrap(ecs_in_inner_tuple3(9, 8, 7));
    if ecs_in_param_t_at(p, 0) != 9 { panic(101490); };
    if ecs_in_param_t_at(p, 1) != 8 { panic(101491); };
    if ecs_in_param_t_at(p, 2) != 7 { panic(101492); };
}
