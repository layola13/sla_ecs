@import "lib/query_sort_iter.sla"

// Isolated tests for lib/query_sort_iter.sla — QueryIter sort family (sort/sort_unstable/sort_by/sort_unstable_by/sort_by_key/sort_unstable_by_key/sort_by_cached_key). Bevy reference: src/query/iter.rs (gaps not in lib/query_iter.sla).

@test "sort_iter_new_empty"() {
    let q = ecs_query_sort_iter_new();
    if !ecs_query_sort_iter_is_empty(q) { panic(91447); };
    if ecs_query_sort_iter_len(q) != 0 { panic(91448); };
}

@test "sort_iter_push_grows_len"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 10, 3);
    let q3 = ecs_query_sort_iter_push(q2, 11, 1);
    if ecs_query_sort_iter_len(q3) != 2 { panic(91449); };
}

@test "sort_asc_keys_reorder_entities"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 10, 3);
    let q3 = ecs_query_sort_iter_push(q2, 11, 1);
    let q4 = ecs_query_sort_iter_push(q3, 12, 2);
    let res = ecs_query_sort_iter_sort(q4);
    if ecs_sort_ok(res) != 1 { panic(91450); };
    let s = ecs_sort_iter(res);
    // expected order by key asc: key=1 (ent 11), key=2 (ent 12), key=3 (ent 10)
    if ecs_query_sorted_iter_entity_at(s, 0) != 11 { panic(91451); };
    if ecs_query_sorted_iter_entity_at(s, 1) != 12 { panic(91452); };
    if ecs_query_sorted_iter_entity_at(s, 2) != 10 { panic(91453); };
    if ecs_query_sorted_iter_key_at(s, 0) != 1 { panic(91454); };
    if ecs_query_sorted_iter_key_at(s, 2) != 3 { panic(91455); };
}

@test "sort_unstable_same_result_as_sort_for_distinct_keys"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let q3 = ecs_query_sort_iter_push(q2, 2, 3);
    let res = ecs_query_sort_iter_sort_unstable(q3);
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_entity_at(s, 0) != 2 { panic(91456); };
    if ecs_query_sorted_iter_entity_at(s, 1) != 1 { panic(91457); };
}

@test "sort_by_uses_mode_comparator"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 10, 3);
    let q3 = ecs_query_sort_iter_push(q2, 11, 1);
    let q4 = ecs_query_sort_iter_push(q3, 12, 2);
    let res = ecs_query_sort_iter_sort_by(q4, 777);
    if ecs_sort_ok(res) != 1 { panic(91458); };
    let s = ecs_sort_iter(res);
    // mode 2 is asc-by-supplied-comparator-id; for distinct keys equals asc order
    if ecs_query_sorted_iter_entity_at(s, 0) != 11 { panic(91459); };
    if ecs_query_sorted_iter_entity_at(s, 2) != 10 { panic(91460); };
}

@test "sort_unstable_by_returns_ok"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 9);
    let q3 = ecs_query_sort_iter_push(q2, 2, 4);
    let res = ecs_query_sort_iter_sort_unstable_by(q3, 5);
    if ecs_sort_ok(res) != 1 { panic(91461); };
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_entity_at(s, 0) != 2 { panic(91462); };
}

@test "sort_by_key_uses_precomputed_keys"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 100, 30);
    let q3 = ecs_query_sort_iter_push(q2, 200, 10);
    let res = ecs_query_sort_iter_sort_by_key(q3, 0);
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_entity_at(s, 0) != 200 { panic(91463); };
    if ecs_query_sorted_iter_entity_at(s, 1) != 100 { panic(91464); };
}

@test "sort_unstable_by_key_uses_precomputed_keys"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 100, 30);
    let q3 = ecs_query_sort_iter_push(q2, 200, 10);
    let res = ecs_query_sort_iter_sort_unstable_by_key(q3, 0);
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_entity_at(s, 0) != 200 { panic(91465); };
}

@test "sort_by_cached_key_marks_cached"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let q3 = ecs_query_sort_iter_push(q2, 2, 3);
    let res = ecs_query_sort_iter_sort_by_cached_key(q3, 0);
    let s = ecs_sort_iter(res);
    if !ecs_query_sorted_iter_is_cached(s) { panic(91466); };
    if ecs_query_sorted_iter_entity_at(s, 0) != 2 { panic(91467); };
}

@test "sort_returns_not_cached"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let res = ecs_query_sort_iter_sort(q2);
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_is_cached(s) { panic(91468); };
}

@test "sort_panics_when_next_consumed"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let q3 = ecs_query_sort_iter_mark_consumed(q2);
    let res = ecs_query_sort_iter_sort(q3);
    if ecs_sort_ok(res) != 0 { panic(91469); };
    if ecs_sort_err_code(res) != 1 { panic(91470); };
}

@test "sort_panics_when_next_consumed_unstable_variant"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let q3 = ecs_query_sort_iter_mark_consumed(q2);
    let res = ecs_query_sort_iter_sort_unstable_by_key(q3, 0);
    if ecs_sort_ok(res) != 0 { panic(91471); };
}

@test "sort_empty_iter_is_allowed"() {
    let q = ecs_query_sort_iter_new();
    let res = ecs_query_sort_iter_sort(q);
    if ecs_sort_ok(res) != 1 { panic(91472); };
    let s = ecs_sort_iter(res);
    if !ecs_query_sorted_iter_is_empty(s) { panic(91473); };
}

@test "sorted_iter_first_and_last"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let q3 = ecs_query_sort_iter_push(q2, 2, 3);
    let q4 = ecs_query_sort_iter_push(q3, 3, 9);
    let res = ecs_query_sort_iter_sort(q4);
    let s = ecs_sort_iter(res);
    let first = ecs_query_sorted_iter_first(s);
    if !ecs_sfn_found(first) { panic(91474); };
    if ecs_sfn_entity(first) != 2 { panic(91475); };
    if ecs_sfn_key(first) != 3 { panic(91476); };
    let last = ecs_query_sorted_iter_last(s);
    if !ecs_sfn_found(last) { panic(91477); };
    if ecs_sfn_entity(last) != 3 { panic(91478); };
    if ecs_sfn_key(last) != 9 { panic(91479); };
}

@test "sorted_iter_fetch_next_advances_cursor"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 9);
    let q3 = ecs_query_sort_iter_push(q2, 2, 3);
    let q4 = ecs_query_sort_iter_push(q3, 3, 1);
    let res = ecs_query_sort_iter_sort(q4);
    let s = ecs_sort_iter(res);
    let p1 = ecs_sorted_fetch_next(s);
    let s2 = p1.0; let r1 = p1.1;
    if !ecs_sfn_found(r1) { panic(91480); };
    if ecs_sfn_entity(r1) != 3 { panic(91481); };
    if ecs_sfn_key(r1) != 1 { panic(91482); };
    let p2 = ecs_sorted_fetch_next(s2);
    let s3 = p2.0; let r2 = p2.1;
    if ecs_sfn_entity(r2) != 2 { panic(91483); };
    let p3 = ecs_sorted_fetch_next(s3);
    let s4 = p3.0; let r3 = p3.1;
    if ecs_sfn_entity(r3) != 1 { panic(91484); };
    let p4 = ecs_sorted_fetch_next(s4);
    let r4 = p4.1;
    if ecs_sfn_found(r4) { panic(91485); };
}

@test "sorted_iter_first_empty"() {
    let q = ecs_query_sort_iter_new();
    let res = ecs_query_sort_iter_sort(q);
    let s = ecs_sort_iter(res);
    let first = ecs_query_sorted_iter_first(s);
    if ecs_sfn_found(first) { panic(91486); };
}

@test "sort_desc_mode_reverses_order"() {
    // Use sort_by_cached_key with a descending-encoded model via... actually model only supports asc/cmp;
    // we expose mode 1 (desc) via the internal helper directly to verify the comparator.
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 3);
    let q3 = ecs_query_sort_iter_push(q2, 2, 1);
    let q4 = ecs_query_sort_iter_push(q3, 3, 2);
    let res = ecs_query_sort_impl(q4, 1, false);
    if ecs_sort_ok(res) != 1 { panic(91487); };
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_entity_at(s, 0) != 1 { panic(91488); };
    if ecs_query_sorted_iter_entity_at(s, 2) != 2 { panic(91489); };
}

@test "sorted_iter_entity_at_out_of_bounds"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 1, 5);
    let res = ecs_query_sort_iter_sort(q2);
    let s = ecs_sort_iter(res);
    if ecs_query_sorted_iter_entity_at(s, -1) != -1 { panic(91490); };
    if ecs_query_sorted_iter_entity_at(s, 99) != -1 { panic(91491); };
}

@test "sort_stable_preserves_equal_key_entity_order"() {
    let q = ecs_query_sort_iter_new();
    let q2 = ecs_query_sort_iter_push(q, 100, 5);
    let q3 = ecs_query_sort_iter_push(q2, 200, 5);
    let q4 = ecs_query_sort_iter_push(q3, 300, 5);
    let res = ecs_query_sort_iter_sort(q4);
    let s = ecs_sort_iter(res);
    // all keys equal -> stable: entity order preserved (100, 200, 300)
    if ecs_query_sorted_iter_entity_at(s, 0) != 100 { panic(91492); };
    if ecs_query_sorted_iter_entity_at(s, 1) != 200 { panic(91493); };
    if ecs_query_sorted_iter_entity_at(s, 2) != 300 { panic(91494); };
}
