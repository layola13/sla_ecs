@import "lib/sparse_set_extras.sla"

// Isolated tests for lib/sparse_set_extras.sla — ComponentSparseSet + ImmutableSparseSet + SparseSets.
// Bevy reference: src/storage/sparse_set.rs

@test "css_v2_new_defaults"() {
    let s = ecs_css_v2_new(0);
    if ecs_css_v2_len(s) != 0 { panic(90951); };
    if ecs_css_v2_is_empty(s) != true { panic(90952); };
    let r = ecs_css_v2_get_drop(s);
    if r.0 != false { panic(90953); };
}

@test "css_v2_insert_contains"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    if ecs_css_v2_contains(s2, 5) != true { panic(90954); };
    if ecs_css_v2_contains(s2, 6) != false { panic(90955); };
    if ecs_css_v2_len(s2) != 1 { panic(90956); };
}

@test "css_v2_get_value"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let r = ecs_css_v2_get(s2, 5);
    if r.0 != true { panic(90957); };
    if r.1 != 100 { panic(90958); };
}

@test "css_v2_get_miss"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let r = ecs_css_v2_get(s2, 999);
    if r.0 != false { panic(90959); };
}

@test "css_v2_get_added_tick"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let r = ecs_css_v2_get_added_tick(s2, 5);
    if r.0 != true { panic(90960); };
    if r.1 != 7 { panic(90961); };
}

@test "css_v2_get_changed_tick"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let r = ecs_css_v2_get_changed_tick(s2, 5);
    if r.0 != true { panic(90962); };
    if r.1 != 7 { panic(90963); };
}

@test "css_v2_get_ticks"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let r = ecs_css_v2_get_ticks(s2, 5);
    if r.0 != true { panic(90964); };
    if r.1 != 7 { panic(90965); };
    if r.2 != 7 { panic(90966); };
}

@test "css_v2_get_changed_by"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let r = ecs_css_v2_get_changed_by(s2, 5);
    if r.0 != true { panic(90967); };
    if r.1 != 99 { panic(90968); };
}

@test "css_v2_get_drop_present"() {
    let s = ecs_css_v2_new(42);
    let r = ecs_css_v2_get_drop(s);
    if r.0 != true { panic(90969); };
    if r.1 != 42 { panic(90970); };
}

@test "css_v2_remove"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let s3 = ecs_css_v2_remove(s2, 5);
    if ecs_css_v2_contains(s3, 5) != false { panic(90971); };
    if ecs_css_v2_len(s3) != 0 { panic(90972); };
}

@test "css_v2_remove_partial"() {
    let s = ecs_css_v2_new(0);
    let s2 = ecs_css_v2_insert(s, 5, 100, 7, 99);
    let s3 = ecs_css_v2_insert(s2, 6, 200, 8, 88);
    let s4 = ecs_css_v2_remove(s3, 5);
    if ecs_css_v2_contains(s4, 5) != false { panic(90973); };
    if ecs_css_v2_contains(s4, 6) != true { panic(90974); };
    if ecs_css_v2_len(s4) != 1 { panic(90975); };
}

@test "imm_sparse_set_capacity"() {
    let s = ecs_imm_sparse_set_with_capacity(64);
    if ecs_imm_sparse_set_capacity(s) != 64 { panic(90976); };
    if ecs_imm_sparse_set_len(s) != 0 { panic(90977); };
    if ecs_imm_sparse_set_is_empty(s) != true { panic(90978); };
}

@test "imm_sparse_set_insert_get"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let s2 = ecs_imm_sparse_set_insert(s, 11, 999);
    let r = ecs_imm_sparse_set_get(s2, 11);
    if r.0 != true { panic(90979); };
    if r.1 != 999 { panic(90980); };
}

@test "imm_sparse_set_get_miss"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let r = ecs_imm_sparse_set_get(s, 11);
    if r.0 != false { panic(90981); };
}

@test "imm_sparse_set_contains"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let s2 = ecs_imm_sparse_set_insert(s, 11, 999);
    if ecs_imm_sparse_set_contains(s2, 11) != true { panic(90982); };
    if ecs_imm_sparse_set_contains(s2, 22) != false { panic(90983); };
}

@test "imm_sparse_set_get_or_insert_existing"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let s2 = ecs_imm_sparse_set_insert(s, 11, 999);
    let r = ecs_imm_sparse_set_get_or_insert_with(s2, 11, 12345);
    if r.1 != 999 { panic(90984); };
}

@test "imm_sparse_set_get_or_insert_new"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let r = ecs_imm_sparse_set_get_or_insert_with(s, 11, 12345);
    let s2 = r.0;
    let v0 = r.1;
    if v0 != 12345 { panic(90985); };
    let r2 = ecs_imm_sparse_set_get(s2, 11);
    if r2.0 != true { panic(90986); };
    if r2.1 != 12345 { panic(90987); };
}

@test "imm_sparse_set_remove"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let s2 = ecs_imm_sparse_set_insert(s, 11, 999);
    let r = ecs_imm_sparse_set_remove(s2, 11);
    let rm = r.1;
    if rm != true { panic(90988); };
    let s3 = r.0;
    if ecs_imm_sparse_set_contains(s3, 11) != false { panic(90989); };
}

@test "imm_sparse_set_remove_missing"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let r = ecs_imm_sparse_set_remove(s, 99);
    if r.1 != false { panic(90990); };
}

@test "imm_sparse_set_clear"() {
    let s = ecs_imm_sparse_set_with_capacity(8);
    let s2 = ecs_imm_sparse_set_insert(s, 1, 10);
    let s3 = ecs_imm_sparse_set_insert(s2, 2, 20);
    let s4 = ecs_imm_sparse_set_clear(s3);
    if ecs_imm_sparse_set_len(s4) != 0 { panic(90991); };
    if ecs_imm_sparse_set_is_empty(s4) != true { panic(90992); };
}

@test "sparse_sets_v2_new"() {
    let s = ecs_sparse_sets_v2_new();
    if ecs_sparse_sets_v2_len(s) != 0 { panic(90993); };
    if ecs_sparse_sets_v2_is_empty(s) != true { panic(90994); };
}

@test "sparse_sets_v2_get_or_insert_new"() {
    let s = ecs_sparse_sets_v2_new();
    let r = ecs_sparse_sets_v2_get_or_insert(s, 100, 7);
    let s2 = r.0;
    let idx0 = r.1;
    if idx0 != 0 { panic(90995); };
    if ecs_sparse_sets_v2_len(s2) != 1 { panic(90996); };
}

@test "sparse_sets_v2_get_or_insert_existing"() {
    let s = ecs_sparse_sets_v2_new();
    let r = ecs_sparse_sets_v2_get_or_insert(s, 100, 7);
    let s2 = r.0;
    let r2 = ecs_sparse_sets_v2_get_or_insert(s2, 100, 0);
    if r2.1 != 0 { panic(90997); };
    if ecs_sparse_sets_v2_len(r2.0) != 1 { panic(90998); };
}

@test "sparse_sets_v2_get_index"() {
    let s = ecs_sparse_sets_v2_new();
    let r = ecs_sparse_sets_v2_get_or_insert(s, 100, 7);
    let s2 = r.0;
    let g = ecs_sparse_sets_v2_get_index(s2, 100);
    if g.0 != true { panic(90999); };
    if g.1 != 0 { panic(91000); };
    let m = ecs_sparse_sets_v2_get_index(s2, 999);
    if m.0 != false { panic(91001); };
}

@test "sparse_sets_v2_push_and_set_len"() {
    let s = ecs_sparse_sets_v2_new();
    let r = ecs_sparse_sets_v2_get_or_insert(s, 100, 7);
    let s2 = r.0;
    let s3 = ecs_sparse_sets_v2_push(s2, 0);
    let s4 = ecs_sparse_sets_v2_push(s3, 0);
    if ecs_sparse_sets_v2_set_len(s4, 0) != 2 { panic(91002); };
}

@test "sparse_sets_v2_push_out_of_range_noop"() {
    let s = ecs_sparse_sets_v2_new();
    let s2 = ecs_sparse_sets_v2_push(s, 999);
    if ecs_sparse_sets_v2_len(s2) != 0 { panic(91003); };
    if ecs_sparse_sets_v2_set_len(s2, 999) != 0 { panic(91004); };
}
