@import "lib/function_system_extras_deep.sla"

// Batch 309: function_system_extras deep.
// panic codes: 127800 – 127999.

@test "state_new_and_meta"() {
    let s = ecs_fse_state_new(10, 3, 5);
    if ecs_fse_state_param(s) != 10 { panic(127800); };
    if ecs_fse_state_world(s) != 3 { panic(127801); };
    if ecs_fse_state_tick(s) != 5 { panic(127802); };
    if ecs_fse_state_initialized(s) != true { panic(127803); };
}

@test "state_cached_and_apply"() {
    let s = ecs_fse_state_new(1, 1, 0);
    s = ecs_fse_state_set_cached(s, 42);
    if ecs_fse_state_cached(s) != 42 { panic(127810); };
    s = ecs_fse_state_apply(s, 99);
    if ecs_fse_state_cached(s) != 99 { panic(127811); };
}

@test "state_matches_world_and_tick"() {
    let s = ecs_fse_state_new(1, 7, 1);
    if ecs_fse_state_matches_world(s, 7) != true { panic(127820); };
    if ecs_fse_state_matches_world(s, 8) != false { panic(127821); };
    s = ecs_fse_state_set_tick(s, 11);
    if ecs_fse_state_tick(s) != 11 { panic(127822); };
}

@test "build_system"() {
    let s = ecs_fse_state_new(1, 2, 9);
    let fs = ecs_fse_build_system(s, 100);
    if ecs_fse_name(fs) != 100 { panic(127830); };
    if ecs_fse_tick(fs) != 9 { panic(127831); };
    if ecs_fse_is_initialized(fs) != false { panic(127832); };
}

@test "build_with_input"() {
    let s = ecs_fse_state_new(1, 2, 3);
    let fs = ecs_fse_build_system_with_input(s, 50, 77);
    if ecs_fse_input(fs) != 77 { panic(127840); };
    if ecs_fse_name(fs) != 50 { panic(127841); };
    let any = ecs_fse_build_any_system(s, 51);
    if ecs_fse_name(any) != 51 { panic(127842); };
}

@test "initialize_and_run"() {
    let fs = ecs_fse_new(1, 0);
    fs = ecs_fse_initialize(fs);
    if ecs_fse_is_initialized(fs) != true { panic(127850); };
    fs = ecs_fse_run(fs, 12);
    fs = ecs_fse_run(fs, 13);
    if ecs_fse_last_output(fs) != 13 { panic(127851); };
    if ecs_fse_run_count(fs) != 2 { panic(127852); };
}

@test "name_input_last_run"() {
    let fs = ecs_fse_new(1, 0);
    fs = ecs_fse_with_name(fs, 9);
    fs = ecs_fse_with_input(fs, 4);
    fs = ecs_fse_set_last_run(fs, 20);
    if ecs_fse_name(fs) != 9 { panic(127860); };
    if ecs_fse_input(fs) != 4 { panic(127861); };
    if ecs_fse_tick(fs) != 20 { panic(127862); };
}

@test "exclusive_and_non_send"() {
    let fs = ecs_fse_new(1, 0);
    fs = ecs_fse_set_exclusive(fs);
    fs = ecs_fse_set_non_send(fs);
    if ecs_fse_is_exclusive(fs) != true { panic(127870); };
    if ecs_fse_is_non_send(fs) != true { panic(127871); };
}

@test "from_builder"() {
    let s = ecs_fse_state_from_builder(3, 4, 5);
    if ecs_fse_state_param(s) != 3 { panic(127880); };
    if ecs_fse_state_world(s) != 4 { panic(127881); };
}

@test "markers"() {
    let a = ecs_fse_is_fn_marker();
    let b = ecs_fse_has_input_marker();
    if ecs_fse_is_fn_tag(a) != 1 { panic(127890); };
    if ecs_fse_has_input_tag(b) != 1 { panic(127891); };
}
