// Isolated deep tests for lib/schedule_registry_erased_deep.sla (Batch 358).
// panic codes: 137600 - 137799.

@import "lib/schedule_registry_erased_deep.sla"

const CID_POS: i32 = 121;
const CID_VEL: i32 = 122;

@test "Schedule default empty zero conflicts"() {
    let s = ecs_reg_erased_schedule_default();
    if ecs_reg_erased_schedule_len(s) != 0 { panic(137600); };
    if ecs_reg_erased_schedule_conflict_count(s) != 0 { panic(137601); };
}

@test "Access none empty"() {
    let a = ecs_reg_erased_access_none();
    if ecs_reg_erased_len_reads(a) != 0 { panic(137610); };
    if ecs_reg_erased_len_writes(a) != 0 { panic(137611); };
    if ecs_reg_erased_reads_resource(a) != 0 { panic(137612); };
    if ecs_reg_erased_writes_resource(a) != 0 { panic(137613); };
    if ecs_reg_erased_reads_messages(a) != 0 { panic(137614); };
    if ecs_reg_erased_writes_messages(a) != 0 { panic(137615); };
}

@test "Access read/write component mutators"() {
    let a0 = ecs_reg_erased_access_none();
    let a1 = ecs_reg_erased_access_read_component(a0, CID_POS);
    let a2 = ecs_reg_erased_access_write_component(a1, CID_POS);
    if ecs_reg_erased_len_reads(a2) != 1 { panic(137620); };
    if ecs_reg_erased_len_writes(a2) != 1 { panic(137621); };
    if ecs_reg_erased_read_at(a2, 0) != CID_POS { panic(137622); };
    if ecs_reg_erased_write_at(a2, 0) != CID_POS { panic(137623); };
    // Adding more reads/writes
    let a3 = ecs_reg_erased_access_read_component(a2, CID_VEL);
    if ecs_reg_erased_len_reads(a3) != 2 { panic(137624); };
    if ecs_reg_erased_read_at(a3, 1) != CID_VEL { panic(137625); };
}

@test "Access read list cap-4"() {
    let a0 = ecs_reg_erased_access_none();
    a0 = ecs_reg_erased_access_read_component(a0, 1);
    a0 = ecs_reg_erased_access_read_component(a0, 2);
    a0 = ecs_reg_erased_access_read_component(a0, 3);
    a0 = ecs_reg_erased_access_read_component(a0, 4);
    let a_full = ecs_reg_erased_access_read_component(a0, 5);
    if ecs_reg_erased_len_reads(a_full) != 4 { panic(137630); };
}

@test "Access resource/messages toggles"() {
    let a = ecs_reg_erased_access_none();
    a = ecs_reg_erased_access_read_resource(a);
    a = ecs_reg_erased_access_write_resource(a);
    a = ecs_reg_erased_access_read_messages(a);
    a = ecs_reg_erased_access_write_messages(a);
    if ecs_reg_erased_reads_resource(a) != 1 { panic(137640); };
    if ecs_reg_erased_writes_resource(a) != 1 { panic(137641); };
    if ecs_reg_erased_reads_messages(a) != 1 { panic(137642); };
    if ecs_reg_erased_writes_messages(a) != 1 { panic(137643); };
}

@test "Component conflict: write POS clashes read POS"() {
    let w = ecs_reg_erased_access_write_component(ecs_reg_erased_access_none(), CID_POS);
    let r = ecs_reg_erased_access_read_component(ecs_reg_erased_access_none(), CID_POS);
    if ecs_reg_erased_access_conflicts(w, r) != true { panic(137650); };
    if ecs_reg_erased_access_conflicts(r, w) != true { panic(137651); };
}

@test "Component non-conflict: read POS vs read POS independent"() {
    let r1 = ecs_reg_erased_access_read_component(ecs_reg_erased_access_none(), CID_POS);
    let r2 = ecs_reg_erased_access_read_component(ecs_reg_erased_access_none(), CID_POS);
    if ecs_reg_erased_access_conflicts(r1, r2) != false { panic(137660); };
    // Different components are independent.
    let w_pos = ecs_reg_erased_access_write_component(ecs_reg_erased_access_none(), CID_POS);
    let w_vel = ecs_reg_erased_access_write_component(ecs_reg_erased_access_none(), CID_VEL);
    if ecs_reg_erased_access_conflicts(w_pos, w_vel) != false { panic(137661); };
}

@test "Resource/messages conflicts flip independent of components"() {
    let r_only = ecs_reg_erased_access_read_resource(ecs_reg_erased_access_none());
    let w_only = ecs_reg_erased_access_write_resource(ecs_reg_erased_access_none());
    if ecs_reg_erased_access_conflicts(r_only, w_only) != true { panic(137670); };
    let m_read = ecs_reg_erased_access_read_messages(ecs_reg_erased_access_none());
    let m_write = ecs_reg_erased_access_write_messages(ecs_reg_erased_access_none());
    if ecs_reg_erased_access_conflicts(m_read, m_write) != true { panic(137671); };
    if ecs_reg_erased_access_conflicts(r_only, m_read) != false { panic(137672); };
}

@test "Schedule add binds and computes conflicts"() {
    let s0 = ecs_reg_erased_schedule_default();
    let first = ecs_reg_erased_access_write_component(ecs_reg_erased_access_none(), CID_POS);
    let s1 = ecs_reg_erased_schedule_add_systems(s0, first);
    if ecs_reg_erased_schedule_conflict_count(s1) != 0 { panic(137680); };
    // Add a read POS system; conflicts with first write -> count 1.
    let reader = ecs_reg_erased_access_read_component(ecs_reg_erased_access_none(), CID_POS);
    let s2 = ecs_reg_erased_schedule_add_systems(s1, reader);
    if ecs_reg_erased_schedule_conflict_count(s2) != 1 { panic(137681); };
    // Add a third write POS system; conflicts with both -> count +2 = 3.
    let third = ecs_reg_erased_access_write_component(ecs_reg_erased_access_none(), CID_POS);
    let s3 = ecs_reg_erased_schedule_add_systems(s2, third);
    if ecs_reg_erased_schedule_conflict_count(s3) != 3 { panic(137682); };
    if ecs_reg_erased_schedule_len(s3) != 3 { panic(137683); };
}

@test "Schedule clear resets and access_at readout matches add"() {
    let s0 = ecs_reg_erased_schedule_default();
    let r = ecs_reg_erased_access_read_component(ecs_reg_erased_access_none(), CID_POS);
    let s1 = ecs_reg_erased_schedule_add_systems(s0, r);
    let a0 = ecs_reg_erased_access_at(s1, 0);
    if ecs_reg_erased_read_at(a0, 0) != CID_POS { panic(137690); };
    if ecs_reg_erased_len_reads(a0) != 1 { panic(137691); };
    let s2 = ecs_reg_erased_schedule_clear(s1);
    if ecs_reg_erased_schedule_len(s2) != 0 { panic(137692); };
    if ecs_reg_erased_schedule_conflict_count(s2) != 0 { panic(137693); };
}
