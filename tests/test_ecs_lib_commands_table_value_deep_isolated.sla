// Isolated deep tests for lib/commands_table_value_deep.sla (Batch 359).
// panic codes: 137800 - 137999.

@import "lib/commands_table_value_deep.sla"

@test "Commands new starts empty"() {
    let c = ecs_table_value_commands_new();
    if ecs_table_value_commands_len(c) != 0 { panic(137800); };
    if ecs_table_value_commands_pcomp_count(c) != 0 { panic(137801); };
    if ecs_table_value_commands_pres_count(c) != 0 { panic(137802); };
    if ecs_table_value_commands_pmsg_count(c) != 0 { panic(137803); };
}

@test "Commands insert queues component kind and side value"() {
    let c0 = ecs_table_value_commands_new();
    let c1 = ecs_table_value_commands_insert(c0, 5, 11, 99);
    if ecs_table_value_commands_len(c1) != 1 { panic(137810); };
    if ecs_table_value_commands_kind_at(c1, 0) != ECS_CMD_TABLE_VALUE_INSERT_COMPONENT { panic(137811); };
    if ecs_table_value_commands_entity_at(c1, 0) != 5 { panic(137812); };
    if ecs_table_value_commands_cmp_at(c1, 0) != 11 { panic(137813); };
    if ecs_table_value_commands_pcomp_count(c1) != 1 { panic(137814); };
}

@test "Commands despawn and insert_resource and write_message"() {
    let c0 = ecs_table_value_commands_new();
    let c1 = ecs_table_value_commands_despawn(c0, 7);
    let c2 = ecs_table_value_commands_insert_resource(c1, 42);
    let c3 = ecs_table_value_commands_write_message(c2, 200);
    if ecs_table_value_commands_len(c3) != 3 { panic(137820); };
    if ecs_table_value_commands_kind_at(c3, 0) != ECS_CMD_TABLE_VALUE_DESPAWN { panic(137821); };
    if ecs_table_value_commands_kind_at(c3, 1) != ECS_CMD_TABLE_VALUE_INSERT_RESOURCE { panic(137822); };
    if ecs_table_value_commands_kind_at(c3, 2) != ECS_CMD_TABLE_VALUE_WRITE_MESSAGE { panic(137823); };
    if ecs_table_value_commands_entity_at(c3, 0) != 7 { panic(137824); };
    if ecs_table_value_commands_pres_count(c3) != 1 { panic(137825); };
    if ecs_table_value_commands_pmsg_count(c3) != 1 { panic(137826); };
}

@test "Commands count_by_kind tallies correctly"() {
    let c0 = ecs_table_value_commands_new();
    c0 = ecs_table_value_commands_insert(c0, 1, 1, 0);
    c0 = ecs_table_value_commands_insert(c0, 2, 2, 0);
    c0 = ecs_table_value_commands_despawn(c0, 1);
    c0 = ecs_table_value_commands_insert_resource(c0, 0);
    if ecs_table_value_commands_count_by_kind(c0, ECS_CMD_TABLE_VALUE_INSERT_COMPONENT) != 2 { panic(137830); };
    if ecs_table_value_commands_count_by_kind(c0, ECS_CMD_TABLE_VALUE_DESPAWN) != 1 { panic(137831); };
    if ecs_table_value_commands_count_by_kind(c0, ECS_CMD_TABLE_VALUE_INSERT_RESOURCE) != 1 { panic(137832); };
    if ecs_table_value_commands_count_by_kind(c0, ECS_CMD_TABLE_VALUE_WRITE_MESSAGE) != 0 { panic(137833); };
}

@test "Commands resolve_value maps side payload by kind for component"() {
    let c0 = ecs_table_value_commands_new();
    let c1 = ecs_table_value_commands_insert(c0, 9, 11, 55);
    if ecs_table_value_commands_resolve_value(c1, 0) != 55 { panic(137840); };
}

@test "Commands resolve_value for resource and message"() {
    let c0 = ecs_table_value_commands_new();
    let c1 = ecs_table_value_commands_insert_resource(c0, 7);
    let c2 = ecs_table_value_commands_write_message(c1, 88);
    if ecs_table_value_commands_resolve_value(c2, 0) != 7 { panic(137850); };
    if ecs_table_value_commands_resolve_value(c2, 1) != 88 { panic(137851); };
}

@test "Commands cap-8 reject beyond capacity"() {
    let c0 = ecs_table_value_commands_new();
    let i: i32 = 0;
    let c = c0;
    while i < 8 {
        c = ecs_table_value_commands_despawn(c, i);
        i = i + 1;
    }
    if ecs_table_value_commands_len(c) != 8 { panic(137860); };
    let c_full = ecs_table_value_commands_despawn(c, 99);
    if ecs_table_value_commands_len(c_full) != 8 { panic(137861); };
}

@test "Commands cap-side cap-8 reject for side payloads"() {
    let c0 = ecs_table_value_commands_new();
    let i: i32 = 0;
    let c = c0;
    while i < 8 {
        c = ecs_table_value_commands_insert(c, 1, 1, i * 2);
        i = i + 1;
    }
    if ecs_table_value_commands_len(c) != 8 { panic(137870); };
    if ecs_table_value_commands_pcomp_count(c) != 8 { panic(137871); };
    // Inserting a 9th component-payload insert would also overflow count - so attempt despawn.
    let c_full = ecs_table_value_commands_insert(c, 1, 1, 99);
    if ecs_table_value_commands_len(c_full) != 8 { panic(137872); };
    if ecs_table_value_commands_pcomp_count(c_full) != 8 { panic(137873); };
}

@test "Commands reserve_entity returns 0 placeholder"() {
    let c0 = ecs_table_value_commands_new();
    let pair = ecs_table_value_commands_reserve_entity(c0);
    if pair.1 != 0 { panic(137880); };
    if ecs_table_value_commands_len(pair.0) != 0 { panic(137881); };
}

@test "Commands clear resets all counters"() {
    let c0 = ecs_table_value_commands_new();
    c0 = ecs_table_value_commands_insert(c0, 1, 1, 0);
    c0 = ecs_table_value_commands_insert_resource(c0, 11);
    c0 = ecs_table_value_commands_write_message(c0, 22);
    c0 = ecs_table_value_commands_despawn(c0, 5);
    let c1 = ecs_table_value_commands_clear(c0);
    if ecs_table_value_commands_len(c1) != 0 { panic(137890); };
    if ecs_table_value_commands_pcomp_count(c1) != 0 { panic(137891); };
    if ecs_table_value_commands_pres_count(c1) != 0 { panic(137892); };
    if ecs_table_value_commands_pmsg_count(c1) != 0 { panic(137893); };
}
