@import "lib/entity_component_fetch_deep.sla"

// Batch 280: entity_component_fetch deep (src/world/entity_access/component_fetch.rs).
// panic codes: 122000 – 122199.

@test "entity_insert_and_fetch_ref_one"() {
    let e = ecs_ecf_entity_new(7);
    e = ecs_ecf_entity_insert(e, 1, 10);
    e = ecs_ecf_entity_insert(e, 2, 20);
    if ecs_ecf_entity_len(e) != 2 { panic(122000); };
    let r = ecs_ecf_fetch_ref_one(e, 1);
    if ecs_ecf_one_ok(r) != true { panic(122001); };
    if ecs_ecf_one_value(r) != 10 { panic(122002); };
    if ecs_ecf_one_is_mut(r) != false { panic(122003); };
    if ecs_ecf_one_cid(r) != 1 { panic(122004); };
}

@test "fetch_mut_one_and_apply_set"() {
    let e = ecs_ecf_entity_new(1);
    e = ecs_ecf_entity_insert(e, 5, 50);
    let r = ecs_ecf_fetch_mut_one(e, 5);
    if ecs_ecf_one_ok(r) != true { panic(122010); };
    if ecs_ecf_one_is_mut(r) != true { panic(122011); };
    let sr = ecs_ecf_apply_set(e, 5, 99);
    if ecs_ecf_set_ok(sr) != true { panic(122012); };
    e = ecs_ecf_set_entity(sr);
    let r2 = ecs_ecf_fetch_ref_one(e, 5);
    if ecs_ecf_one_value(r2) != 99 { panic(122013); };
}

@test "missing_component_errors"() {
    let e = ecs_ecf_entity_new(2);
    e = ecs_ecf_entity_insert(e, 1, 1);
    let r = ecs_ecf_fetch_ref_one(e, 9);
    if ecs_ecf_one_ok(r) != false { panic(122020); };
    if ecs_ecf_one_err(r) != 1 { panic(122021); };
    if ecs_ecf_one_cid(r) != 9 { panic(122022); };
    let m = ecs_ecf_fetch_mut_one(e, 9);
    if ecs_ecf_one_err(m) != 1 { panic(122023); };
    let a = ecs_ecf_fetch_mut_assume_mutable_one(e, 9);
    if ecs_ecf_one_err(a) != 1 { panic(122024); };
    if ecs_ecf_one_assume_mutable(a) != true { panic(122025); };
}

@test "fetch_ref_many_array"() {
    let e = ecs_ecf_entity_new(3);
    e = ecs_ecf_entity_insert(e, 1, 11);
    e = ecs_ecf_entity_insert(e, 2, 22);
    e = ecs_ecf_entity_insert(e, 3, 33);
    let ids = ecs_ecf_ids_new();
    ids = ecs_ecf_ids_push(ids, 1);
    ids = ecs_ecf_ids_push(ids, 3);
    let r = ecs_ecf_fetch_ref_many(e, ids);
    if ecs_ecf_multi_ok(r) != true { panic(122030); };
    if ecs_ecf_multi_count(r) != 2 { panic(122031); };
    if ecs_ecf_multi_value_at(r, 0) != 11 { panic(122032); };
    if ecs_ecf_multi_value_at(r, 1) != 33 { panic(122033); };
    if ecs_ecf_multi_is_mut(r) != false { panic(122034); };
}

@test "fetch_mut_many_alias_error"() {
    let e = ecs_ecf_entity_new(4);
    e = ecs_ecf_entity_insert(e, 7, 70);
    let ids = ecs_ecf_ids_new();
    ids = ecs_ecf_ids_push(ids, 7);
    ids = ecs_ecf_ids_push(ids, 7);
    let r = ecs_ecf_fetch_mut_many(e, ids);
    if ecs_ecf_multi_ok(r) != false { panic(122040); };
    if ecs_ecf_multi_err(r) != 2 { panic(122041); };
    if ecs_ecf_multi_err_cid(r) != 7 { panic(122042); };
    // read path allows duplicates
    let rr = ecs_ecf_fetch_ref_many(e, ids);
    if ecs_ecf_multi_ok(rr) != true { panic(122043); };
    if ecs_ecf_multi_count(rr) != 2 { panic(122044); };
}

@test "unique_set_skips_alias_check"() {
    let e = ecs_ecf_entity_new(5);
    e = ecs_ecf_entity_insert(e, 1, 10);
    e = ecs_ecf_entity_insert(e, 2, 20);
    let ids = ecs_ecf_ids_unique_new();
    ids = ecs_ecf_ids_push(ids, 1);
    ids = ecs_ecf_ids_push(ids, 1);
    ids = ecs_ecf_ids_push(ids, 2);
    if ecs_ecf_ids_len(ids) != 2 { panic(122050); };
    if ecs_ecf_ids_is_unique_set(ids) != true { panic(122051); };
    let r = ecs_ecf_fetch_mut_many(e, ids);
    if ecs_ecf_multi_ok(r) != true { panic(122052); };
    if ecs_ecf_multi_count(r) != 2 { panic(122053); };
    let g = ecs_ecf_multi_get_by_cid(r, 2);
    if ecs_ecf_one_value(g) != 20 { panic(122054); };
}

@test "fetch_mut_many_missing"() {
    let e = ecs_ecf_entity_new(6);
    e = ecs_ecf_entity_insert(e, 1, 1);
    let ids = ecs_ecf_ids_new();
    ids = ecs_ecf_ids_push(ids, 1);
    ids = ecs_ecf_ids_push(ids, 99);
    let r = ecs_ecf_fetch_mut_many(e, ids);
    if ecs_ecf_multi_ok(r) != false { panic(122060); };
    if ecs_ecf_multi_err(r) != 1 { panic(122061); };
    if ecs_ecf_multi_err_cid(r) != 99 { panic(122062); };
}

@test "fetch_mut_assume_mutable_many"() {
    let e = ecs_ecf_entity_new(8);
    e = ecs_ecf_entity_insert(e, 3, 30);
    e = ecs_ecf_entity_insert(e, 4, 40);
    let ids = ecs_ecf_ids_new();
    ids = ecs_ecf_ids_push(ids, 3);
    ids = ecs_ecf_ids_push(ids, 4);
    let r = ecs_ecf_fetch_mut_assume_mutable_many(e, ids);
    if ecs_ecf_multi_ok(r) != true { panic(122070); };
    if ecs_ecf_multi_is_mut(r) != true { panic(122071); };
    if ecs_ecf_multi_assume_mutable(r) != true { panic(122072); };
    if ecs_ecf_multi_value_at(r, 0) != 30 { panic(122073); };
    if ecs_ecf_multi_value_at(r, 1) != 40 { panic(122074); };
}

@test "ids_push_capacity_and_at"() {
    let ids = ecs_ecf_ids_new();
    ids = ecs_ecf_ids_push(ids, 10);
    ids = ecs_ecf_ids_push(ids, 20);
    ids = ecs_ecf_ids_push(ids, 30);
    ids = ecs_ecf_ids_push(ids, 40);
    ids = ecs_ecf_ids_push(ids, 50);
    if ecs_ecf_ids_len(ids) != 4 { panic(122080); };
    if ecs_ecf_ids_at(ids, 0) != 10 { panic(122081); };
    if ecs_ecf_ids_at(ids, 3) != 40 { panic(122082); };
    if ecs_ecf_ids_at(ids, 4) != -1 { panic(122083); };
}

@test "replace_insert_and_entity_id"() {
    let e = ecs_ecf_entity_new(42);
    if ecs_ecf_entity_id(e) != 42 { panic(122090); };
    e = ecs_ecf_entity_insert(e, 1, 1);
    e = ecs_ecf_entity_insert(e, 1, 2);
    if ecs_ecf_entity_len(e) != 1 { panic(122091); };
    if ecs_ecf_entity_value(e, 1) != 2 { panic(122092); };
    if ecs_ecf_entity_has(e, 1) != true { panic(122093); };
    if ecs_ecf_entity_has(e, 2) != false { panic(122094); };
    let fail = ecs_ecf_apply_set(e, 2, 9);
    if ecs_ecf_set_ok(fail) != false { panic(122095); };
}
