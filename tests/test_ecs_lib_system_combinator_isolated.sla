@import "lib/system_combinator.sla"

// Isolated tests for lib/system_combinator.sla — CombinatorSystem / PipeSystem / IntoPipeSystem / markers.
// Bevy reference: src/system/combinator.rs + src/system/mod.rs

@test "combinator_system_new"() {
    let s = ecs_combinator_system_new(0, 11, 22, 100);
    if ecs_combinator_system_a_id(s) != 11 { panic(90729); };
    if ecs_combinator_system_b_id(s) != 22 { panic(90730); };
    if ecs_combinator_system_name_id(s) != 100 { panic(90731); };
    if ecs_combinator_system_marker_id(s) != 0 { panic(90732); };
    if ecs_combinator_system_out(s) != 0 { panic(90733); };
}

@test "combinator_system_pipe"() {
    let s = ecs_combinator_system_new(0, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 42);
    let s3 = ecs_combinator_system_run_b(s2, 99);
    if ecs_combinator_system_out(s3) != 99 { panic(90734); };
}

@test "combinator_system_and_then_a_zero"() {
    let s = ecs_combinator_system_new(1, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 0);
    let s3 = ecs_combinator_system_run_b(s2, 55);
    if ecs_combinator_system_out(s3) != 0 { panic(90735); };
}

@test "combinator_system_and_then_a_nonzero"() {
    let s = ecs_combinator_system_new(1, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 1);
    let s3 = ecs_combinator_system_run_b(s2, 55);
    if ecs_combinator_system_out(s3) != 55 { panic(90736); };
}

@test "combinator_system_map_combine"() {
    let s = ecs_combinator_system_new(2, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 10);
    let s3 = ecs_combinator_system_run_b(s2, 20);
    if ecs_combinator_system_out(s3) != 30 { panic(90737); };
}

@test "combinator_system_xor_true_false"() {
    let s = ecs_combinator_system_new(3, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 5);
    let s3 = ecs_combinator_system_run_b(s2, 0);
    if ecs_combinator_system_out(s3) != 1 { panic(90738); };
}

@test "combinator_system_xor_false_true"() {
    let s = ecs_combinator_system_new(3, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 0);
    let s3 = ecs_combinator_system_run_b(s2, 7);
    if ecs_combinator_system_out(s3) != 1 { panic(90739); };
}

@test "combinator_system_xor_both_true"() {
    let s = ecs_combinator_system_new(3, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 5);
    let s3 = ecs_combinator_system_run_b(s2, 7);
    if ecs_combinator_system_out(s3) != 0 { panic(90740); };
}

@test "combinator_system_xor_both_false"() {
    let s = ecs_combinator_system_new(3, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 0);
    let s3 = ecs_combinator_system_run_b(s2, 0);
    if ecs_combinator_system_out(s3) != 0 { panic(90741); };
}

@test "pipe_system_new"() {
    let s = ecs_pipe_system_new(11, 22, 100);
    if ecs_pipe_system_a_id(s) != 11 { panic(90742); };
    if ecs_pipe_system_b_id(s) != 22 { panic(90743); };
    if ecs_pipe_system_name_id(s) != 100 { panic(90744); };
}

@test "pipe_system_run"() {
    let s = ecs_pipe_system_new(1, 2, 100);
    let s2 = ecs_pipe_system_run_a(s, 42);
    if ecs_pipe_system_pipe_value(s2) != 42 { panic(90745); };
    let s3 = ecs_pipe_system_run_b(s2, 84);
    if ecs_pipe_system_out(s3) != 84 { panic(90746); };
}

@test "into_pipe_system_new"() {
    let s = ecs_into_pipe_system_new(31, 32);
    if ecs_into_pipe_system_a_id(s) != 31 { panic(90747); };
    if ecs_into_pipe_system_b_id(s) != 32 { panic(90748); };
}

@test "into_pipe_system_into_pipe"() {
    let s = ecs_into_pipe_system_new(31, 32);
    let p = ecs_into_pipe_system_into_pipe(s, 200);
    if ecs_pipe_system_a_id(p) != 31 { panic(90749); };
    if ecs_pipe_system_b_id(p) != 32 { panic(90750); };
    if ecs_pipe_system_name_id(p) != 200 { panic(90751); };
}

@test "is_pipe_system_marker_new"() {
    let mk = ecs_is_pipe_system_marker_new();
    let n = 0;
    if n != 0 { panic(90752); };
}

@test "assert_is_system_passes_through"() {
    if ecs_assert_is_system(123) != 123 { panic(90753); };
}

@test "assert_is_read_only_system_passes"() {
    if ecs_assert_is_read_only_system(456) != 456 { panic(90754); };
}

@test "assert_system_does_not_conflict_passes"() {
    if ecs_assert_system_does_not_conflict(789) != 789 { panic(90755); };
}

@test "combinator_system_run_a_only_defaults_out"() {
    let s = ecs_combinator_system_new(0, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 42);
    if ecs_combinator_system_out(s2) != 0 { panic(90756); };
}

@test "pipe_system_round_trip"() {
    let s = ecs_pipe_system_new(1, 2, 100);
    let s2 = ecs_pipe_system_run_a(s, 7);
    let s3 = ecs_pipe_system_run_b(s2, 14);
    let out0 = ecs_pipe_system_out(s3);
    let pv0 = ecs_pipe_system_pipe_value(s3);
    if out0 != 14 { panic(90757); };
    if pv0 != 7 { panic(90758); };
}

@test "combinator_map_combine_zero_a"() {
    let s = ecs_combinator_system_new(2, 1, 2, 100);
    let s2 = ecs_combinator_system_run_a(s, 0);
    let s3 = ecs_combinator_system_run_b(s2, 25);
    if ecs_combinator_system_out(s3) != 25 { panic(90759); };
}

@test "combinator_and_then_full_chain"() {
    let s0 = ecs_combinator_system_new(1, 5, 6, 200);
    let s1 = ecs_combinator_system_run_a(s0, 0);
    let s3 = ecs_combinator_system_run_b(s1, 99);
    let sa = ecs_combinator_system_new(1, 5, 6, 200);
    let sb = ecs_combinator_system_run_a(sa, 1);
    let s5 = ecs_combinator_system_run_b(sb, 50);
    if ecs_combinator_system_out(s3) != 0 { panic(90760); };
    if ecs_combinator_system_out(s5) != 50 { panic(90761); };
}
