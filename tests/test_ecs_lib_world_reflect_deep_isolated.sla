// Isolated deep tests for lib/world_reflect_deep.sla (Batch 413).
// Tests EcsReflectWorldDeep: new/id/register_component/register_resource/component_count/
// resource_count, plus the placeholder ecs_short_type_name_deep.

@import "lib/world_reflect_deep.sla"

@test "new_id_and_zero_counts"() {
    let w = ecs_reflect_world_deep_new(42);
    if ecs_reflect_world_deep_id(w) != 42 { panic(147110); };
    if ecs_reflect_world_deep_component_count(w) != 0 { panic(147111); };
    if ecs_reflect_world_deep_resource_count(w) != 0 { panic(147112); };
}

@test "register_component_increments"() {
    let w = ecs_reflect_world_deep_new(1);
    w = ecs_reflect_world_deep_register_component(w);
    w = ecs_reflect_world_deep_register_component(w);
    if ecs_reflect_world_deep_component_count(w) != 2 { panic(147113); };
    if ecs_reflect_world_deep_resource_count(w) != 0 { panic(147114); };
}

@test "register_resource_increments"() {
    let w = ecs_reflect_world_deep_new(1);
    w = ecs_reflect_world_deep_register_resource(w);
    w = ecs_reflect_world_deep_register_resource(w);
    w = ecs_reflect_world_deep_register_resource(w);
    if ecs_reflect_world_deep_resource_count(w) != 3 { panic(147115); };
    if ecs_reflect_world_deep_component_count(w) != 0 { panic(147116); };
}

@test "register_mixed_keeps_separate_counts"() {
    let w = ecs_reflect_world_deep_new(77);
    w = ecs_reflect_world_deep_register_component(w);
    w = ecs_reflect_world_deep_register_resource(w);
    w = ecs_reflect_world_deep_register_component(w);
    if ecs_reflect_world_deep_component_count(w) != 2 { panic(147117); };
    if ecs_reflect_world_deep_resource_count(w) != 1 { panic(147118); };
    if ecs_reflect_world_deep_id(w) != 77 { panic(147119); };
}

@test "short_type_name_is_identity"() {
    if ecs_short_type_name_deep(123) != 123 { panic(147120); };
    if ecs_short_type_name_deep(0) != 0 { panic(147121); };
}
