@import "lib/hierarchy_deep.sla"

// Batch 235: hierarchy deep (src/hierarchy.rs).
// panic codes: 113000 – 113199.

@test "linked_spawn_flag"() {
    if ecs_h_linked_spawn() != true { panic(113000); };
}

@test "insert_child_of_syncs_children"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w);
    w = r.0;
    let root = r.1;
    r = ecs_h_world_spawn_empty(w);
    w = r.0;
    let c1 = r.1;
    r = ecs_h_world_spawn_empty(w);
    w = r.0;
    let c2 = r.1;
    w = ecs_h_insert_child_of(w, c1, root);
    w = ecs_h_insert_child_of(w, c2, root);
    let kids = ecs_h_children_of(w, root);
    if ecs_h_children_len(kids) != 2 { panic(113010); };
    if ecs_h_children_contains(kids, c1) != true { panic(113011); };
    if ecs_h_parent_of(w, c2).1 != root { panic(113012); };
}

@test "remove_child_of_clears_empty_children"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let c1 = r.1;
    w = ecs_h_insert_child_of(w, c1, root);
    w = ecs_h_remove_child_of(w, c1);
    if ecs_h_parent_of(w, c1).0 != false { panic(113020); };
    if ecs_h_children_len(ecs_h_children_of(w, root)) != 0 { panic(113021); };
}

@test "reparent_updates_old_and_new"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let a = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let b = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let c = r.1;
    w = ecs_h_insert_child_of(w, c, a);
    w = ecs_h_insert_child_of(w, c, b);
    if ecs_h_parent_of(w, c).1 != b { panic(113030); };
    if ecs_h_children_contains(ecs_h_children_of(w, a), c) != false { panic(113031); };
    if ecs_h_children_contains(ecs_h_children_of(w, b), c) != true { panic(113032); };
}

@test "with_children_and_add_children"() {
    let w = ecs_h_world_new(10);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    w = ecs_h_with_children(w, root, 2);
    if ecs_h_children_len(ecs_h_children_of(w, root)) != 2 { panic(113040); };
    r = ecs_h_world_spawn_empty(w); w = r.0; let x = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let y = r.1;
    w = ecs_h_add_children2(w, root, x, y);
    if ecs_h_children_len(ecs_h_children_of(w, root)) != 4 { panic(113041); };
}

@test "insert_children_at_index"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let a = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let b = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let c = r.1;
    w = ecs_h_add_child(w, root, a);
    w = ecs_h_insert_children(w, root, 0, b, c, 2);
    let kids = ecs_h_children_of(w, root);
    if ecs_h_children_at(kids, 0) != b { panic(113050); };
    if ecs_h_children_at(kids, 1) != c { panic(113051); };
    if ecs_h_children_contains(kids, a) != true { panic(113052); };
}

@test "swap_and_sort_children"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    // manual ids for sort predictability: spawn then reparent known order
    r = ecs_h_world_spawn_empty(w); w = r.0; let c3 = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let c1 = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let c2 = r.1;
    w = ecs_h_add_children2(w, root, c3, c1);
    w = ecs_h_add_child(w, root, c2);
    w = ecs_h_swap_children(w, root, 0, 2);
    let kids = ecs_h_children_of(w, root);
    if ecs_h_children_at(kids, 0) != c2 { panic(113060); };
    w = ecs_h_sort_children(w, root);
    kids = ecs_h_children_of(w, root);
    if ecs_h_children_at(kids, 0) > ecs_h_children_at(kids, 1) { panic(113061); };
    if ecs_h_children_at(kids, 1) > ecs_h_children_at(kids, 2) { panic(113062); };
}

@test "despawn_linked_descendants"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let child = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let grand = r.1;
    w = ecs_h_insert_child_of(w, child, root);
    w = ecs_h_insert_child_of(w, grand, child);
    w = ecs_h_despawn(w, root);
    if ecs_h_alive(w, root) != false { panic(113070); };
    if ecs_h_alive(w, child) != false { panic(113071); };
    if ecs_h_alive(w, grand) != false { panic(113072); };
    if ecs_h_world_despawn_count(w) != 3 { panic(113073); };
}

@test "root_ancestor_and_descendant_count"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let child = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let grand = r.1;
    w = ecs_h_insert_child_of(w, child, root);
    w = ecs_h_insert_child_of(w, grand, child);
    if ecs_h_root_ancestor(w, grand) != root { panic(113080); };
    if ecs_h_descendant_count(w, root) != 2 { panic(113081); };
}

@test "remove_children_batch"() {
    let w = ecs_h_world_new(1);
    let r = ecs_h_world_spawn_empty(w); w = r.0; let root = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let a = r.1;
    r = ecs_h_world_spawn_empty(w); w = r.0; let b = r.1;
    w = ecs_h_add_children2(w, root, a, b);
    w = ecs_h_remove_children2(w, root, a, b);
    if ecs_h_children_len(ecs_h_children_of(w, root)) != 0 { panic(113090); };
    if ecs_h_parent_of(w, a).0 != false { panic(113091); };
}
