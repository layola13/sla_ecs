@import "lib/entity_map_entities.sla"

@test "entity map insert and get"() {
    let m = ecs_entity_map_new();
    m = ecs_entity_map_insert(m, 1, 10);
    m = ecs_entity_map_insert(m, 2, 20);
    let r = ecs_entity_map_get(m, 1);
    if r.0 != true { panic(41001); };
    if r.1 != 10 { panic(41002); };
    let r2 = ecs_entity_map_get(m, 2);
    if r2.1 != 20 { panic(41003); };
}

@test "entity map get missing"() {
    let m = ecs_entity_map_new();
    m = ecs_entity_map_insert(m, 1, 10);
    let r = ecs_entity_map_get(m, 99);
    if r.0 != false { panic(41004); };
}

@test "entity map insert overwrite"() {
    let m = ecs_entity_map_new();
    m = ecs_entity_map_insert(m, 1, 10);
    m = ecs_entity_map_insert(m, 1, 99);
    let r = ecs_entity_map_get(m, 1);
    if r.1 != 99 { panic(41005); };
    if ecs_entity_map_len(m) != 1 { panic(41006); };
}

@test "entity map contains"() {
    let m = ecs_entity_map_new();
    m = ecs_entity_map_insert(m, 5, 50);
    if ecs_entity_map_contains(m, 5) != true { panic(41007); };
    if ecs_entity_map_contains(m, 6) != false { panic(41008); };
}

@test "scene entity mapper get or allocate new"() {
    let m = ecs_scene_entity_mapper_new(100);
    let r = ecs_scene_entity_mapper_get_or_allocate(m, 1);
    if r.1 != 100 { panic(41009); };
    if ecs_scene_entity_mapper_next_remote(r.0) != 101 { panic(41010); };
}

@test "scene entity mapper get or allocate existing"() {
    let m = ecs_scene_entity_mapper_new(100);
    let r1 = ecs_scene_entity_mapper_get_or_allocate(m, 1);
    let r2 = ecs_scene_entity_mapper_get_or_allocate(r1.0, 1);
    if r2.1 != 100 { panic(41011); };
    if ecs_scene_entity_mapper_next_remote(r2.0) != 101 { panic(41012); };
}

@test "scene entity mapper multiple"() {
    let m = ecs_scene_entity_mapper_new(0);
    let r1 = ecs_scene_entity_mapper_get_or_allocate(m, 1);
    let r2 = ecs_scene_entity_mapper_get_or_allocate(r1.0, 2);
    let r3 = ecs_scene_entity_mapper_get_or_allocate(r2.0, 3);
    if r1.1 != 0 { panic(41013); };
    if r2.1 != 1 { panic(41014); };
    if r3.1 != 2 { panic(41015); };
}

@test "scene entity mapper resolve"() {
    let m = ecs_scene_entity_mapper_new(100);
    let r = ecs_scene_entity_mapper_get_or_allocate(m, 5);
    let res = ecs_scene_entity_mapper_resolve(r.0, 5);
    if res.0 != true { panic(41016); };
    if res.1 != 100 { panic(41017); };
}

@test "scene entity mapper resolve missing"() {
    let m = ecs_scene_entity_mapper_new(100);
    let res = ecs_scene_entity_mapper_resolve(m, 99);
    if res.0 != false { panic(41018); };
}

@test "scene entity mapper len"() {
    let m = ecs_scene_entity_mapper_new(100);
    let r1 = ecs_scene_entity_mapper_get_or_allocate(m, 1);
    let r2 = ecs_scene_entity_mapper_get_or_allocate(r1.0, 2);
    if ecs_scene_entity_mapper_len(r2.0) != 2 { panic(41019); };
}

@test "scene entity mapper snapshot encodes stable pairs"() {
    let m = ecs_scene_entity_mapper_new(50);
    let r1 = ecs_scene_entity_mapper_get_or_allocate(m, 10);
    let r2 = ecs_scene_entity_mapper_get_or_allocate(r1.0, 11);
    let snap = ecs_scene_entity_mapper_snapshot(r2.0);
    if ecs_entity_map_snapshot_len(snap) != 6 { panic(41020); };
    if ecs_entity_map_snapshot_at(snap, 0) != 52 { panic(41021); };
    if ecs_entity_map_snapshot_at(snap, 1) != 2 { panic(41022); };
    if ecs_entity_map_snapshot_at(snap, 2) != 10 { panic(41023); };
    if ecs_entity_map_snapshot_at(snap, 3) != 50 { panic(41024); };
    if ecs_entity_map_snapshot_at(snap, 4) != 11 { panic(41025); };
    if ecs_entity_map_snapshot_at(snap, 5) != 51 { panic(41026); };
}

@test "scene entity mapper snapshot restores mappings and allocator"() {
    let m = ecs_scene_entity_mapper_new(100);
    let r1 = ecs_scene_entity_mapper_get_or_allocate(m, 5);
    let r2 = ecs_scene_entity_mapper_get_or_allocate(r1.0, 6);
    let snap = ecs_scene_entity_mapper_snapshot(r2.0);
    let restored = ecs_scene_entity_mapper_from_snapshot(snap);
    let a = ecs_scene_entity_mapper_resolve(restored, 5);
    let b = ecs_scene_entity_mapper_resolve(restored, 6);
    if a.0 != true { panic(41027); };
    if a.1 != 100 { panic(41028); };
    if b.1 != 101 { panic(41029); };
    if ecs_scene_entity_mapper_next_remote(restored) != 102 { panic(41030); };
    let r3 = ecs_scene_entity_mapper_get_or_allocate(restored, 7);
    if r3.1 != 102 { panic(41031); };
}

@test "scene entity mapper snapshot tolerates truncated pairs"() {
    let snap = ecs_entity_map_snapshot_new();
    snap.data.push(200);
    snap.data.push(2);
    snap.data.push(1);
    snap.data.push(201);
    snap.data.push(2);
    let restored = ecs_scene_entity_mapper_from_snapshot(snap);
    if ecs_scene_entity_mapper_len(restored) != 1 { panic(41032); };
    let a = ecs_scene_entity_mapper_resolve(restored, 1);
    if a.0 != true { panic(41033); };
    if a.1 != 201 { panic(41034); };
    let b = ecs_scene_entity_mapper_resolve(restored, 2);
    if b.0 != false { panic(41035); };
    if ecs_scene_entity_mapper_next_remote(restored) != 200 { panic(41036); };
}

@test "scene entity mapper batch allocation preserves duplicates"() {
    let m = ecs_scene_entity_mapper_new(10);
    let sources = Vec::new();
    sources.push(1);
    sources.push(2);
    sources.push(1);
    sources.push(3);
    let batch = ecs_scene_entity_mapper_get_or_allocate_many(m, sources);
    if ecs_entity_remap_batch_len(batch) != 4 { panic(41037); };
    if ecs_entity_remap_batch_target_at(batch, 0) != 10 { panic(41038); };
    if ecs_entity_remap_batch_target_at(batch, 1) != 11 { panic(41039); };
    if ecs_entity_remap_batch_target_at(batch, 2) != 10 { panic(41040); };
    if ecs_entity_remap_batch_target_at(batch, 3) != 12 { panic(41041); };
    if ecs_entity_remap_batch_allocated_count(batch) != 3 { panic(41042); };
    let mapper = ecs_entity_remap_batch_mapper(batch);
    if ecs_scene_entity_mapper_len(mapper) != 3 { panic(41043); };
}

@test "entity map apply many reports missing sources"() {
    let m0 = ecs_entity_map_new();
    let m1 = ecs_entity_map_insert(m0, 1, 101);
    let m2 = ecs_entity_map_insert(m1, 3, 103);
    let sources = Vec::new();
    sources.push(1);
    sources.push(2);
    sources.push(3);
    let strict = ecs_entity_map_apply_many(m2, sources, false);
    if ecs_entity_map_apply_len(strict) != 3 { panic(41044); };
    if ecs_entity_map_apply_target_at(strict, 0) != 101 { panic(41045); };
    if ecs_entity_map_apply_target_at(strict, 1) != -1 { panic(41046); };
    if ecs_entity_map_apply_target_at(strict, 2) != 103 { panic(41047); };
    if ecs_entity_map_apply_missing_count(strict) != 1 { panic(41048); };
    if ecs_entity_map_apply_missing_at(strict, 0) != 2 { panic(41049); };
    let sources2 = Vec::new();
    sources2.push(2);
    let identity = ecs_entity_map_apply_many(m2, sources2, true);
    if ecs_entity_map_apply_target_at(identity, 0) != 2 { panic(41050); };
}
