@import "lib/system_param_special_deep.sla"

// Batch 329: system_param_special deep.
// panic codes: 131800 – 131999.

@test "buffer_push_get"() {
    let b = ecs_spb_deep_new();
    b = ecs_spb_deep_push(b, 10);
    b = ecs_spb_deep_push(b, 20);
    if ecs_spb_deep_len(b) != 2 { panic(131800); };
    if ecs_spb_deep_get(b, 1) != 20 { panic(131801); };
}

@test "buffer_apply_clear"() {
    let b = ecs_spb_deep_push(ecs_spb_deep_new(), 1);
    b = ecs_spb_deep_apply(b);
    if ecs_spb_deep_is_applied(b) != true { panic(131810); };
    b = ecs_spb_deep_clear(b);
    if ecs_spb_deep_is_empty(b) != true { panic(131811); };
}

@test "deferred_push_apply"() {
    let d = ecs_spd_deep_new();
    if ecs_spd_deep_has_deferred(d) != true { panic(131820); };
    d = ecs_spd_deep_push(d, 5);
    if ecs_spd_deep_len(d) != 1 { panic(131821); };
    d = ecs_spd_deep_apply(d);
    if ecs_spd_deep_is_applied(d) != true { panic(131822); };
}

@test "deferred_reborrow_clear"() {
    let d = ecs_spd_deep_push(ecs_spd_deep_new(), 1);
    let r = ecs_spd_deep_reborrow(d);
    if ecs_spd_deep_len(r) != 1 { panic(131830); };
    d = ecs_spd_deep_clear(d);
    if ecs_spd_deep_len(d) != 0 { panic(131831); };
}

@test "markers"() {
    let e = ecs_spex_deep_new();
    let n = ecs_spns_deep_new();
    if ecs_spex_deep_tag(e) != 1 { panic(131840); };
    if ecs_spns_deep_tag(n) != 1 { panic(131841); };
}

@test "removed_components_next"() {
    let r = ecs_sprc_deep_new();
    r = ecs_sprc_deep_add(r, 10);
    r = ecs_sprc_deep_add(r, 20);
    if ecs_sprc_deep_len(r) != 2 { panic(131850); };
    let n1 = ecs_sprc_deep_next(r);
    if ecs_sprc_next_has(n1) != true { panic(131851); };
    if ecs_sprc_next_entity(n1) != 10 { panic(131852); };
    let n2 = ecs_sprc_deep_next(ecs_sprc_next_param(n1));
    if ecs_sprc_next_entity(n2) != 20 { panic(131853); };
    let n3 = ecs_sprc_deep_next(ecs_sprc_next_param(n2));
    if ecs_sprc_next_has(n3) != false { panic(131854); };
}

@test "removed_empty_clear"() {
    let r = ecs_sprc_deep_add(ecs_sprc_deep_new(), 1);
    let n = ecs_sprc_deep_next(r);
    r = ecs_sprc_next_param(n);
    if ecs_sprc_deep_is_empty(r) != true { panic(131860); };
    r = ecs_sprc_deep_clear(r);
    if ecs_sprc_deep_len(r) != 0 { panic(131861); };
}

@test "run_system_once"() {
    let ok = ecs_sro_deep_ok(42);
    let err = ecs_sro_deep_err();
    if ecs_sro_deep_is_ok(ok) != true { panic(131870); };
    if ecs_sro_deep_output(ok) != 42 { panic(131871); };
    if ecs_sro_deep_is_ok(err) != false { panic(131872); };
}

@test "validation"() {
    if ecs_spv_deep_is_ok(ecs_spv_deep_ok()) != true { panic(131880); };
    if ecs_spv_deep_is_skipped(ecs_spv_deep_skipped()) != true { panic(131881); };
}

@test "buffer_capacity_eight"() {
    let b = ecs_spb_deep_new();
    b = ecs_spb_deep_push(b, 1);
    b = ecs_spb_deep_push(b, 2);
    b = ecs_spb_deep_push(b, 3);
    b = ecs_spb_deep_push(b, 4);
    b = ecs_spb_deep_push(b, 5);
    b = ecs_spb_deep_push(b, 6);
    b = ecs_spb_deep_push(b, 7);
    b = ecs_spb_deep_push(b, 8);
    if ecs_spb_deep_len(b) != 8 { panic(131890); };
    b = ecs_spb_deep_push(b, 9);
    if ecs_spb_deep_len(b) != 8 { panic(131891); };
}
