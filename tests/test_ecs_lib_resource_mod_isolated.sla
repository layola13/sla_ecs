@import "lib/resource_mod.sla"

// Isolated tests for lib/resource_mod.sla — IsResource + ResourceEntities + IS_RESOURCE flag.
// Bevy reference: src/resource.rs

@test "is_resource_new_id"() {
    let m = ecs_is_resource_new(42);
    if ecs_is_resource_id(m) != 42 { panic(91005); };
}

@test "is_resource_eq_true"() {
    let m1 = ecs_is_resource_new(7);
    let m2 = ecs_is_resource_new(7);
    if ecs_is_resource_eq(m1, m2) != true { panic(91006); };
}

@test "is_resource_eq_false"() {
    let m1 = ecs_is_resource_new(7);
    let m2 = ecs_is_resource_new(8);
    if ecs_is_resource_eq(m1, m2) != false { panic(91007); };
}

@test "resource_entities_new_empty"() {
    let r = ecs_resource_entities_new();
    if ecs_resource_entities_len(r) != 0 { panic(91008); };
    if ecs_resource_entities_is_empty(r) != true { panic(91009); };
}

@test "resource_entities_insert_new"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 999);
    if ecs_resource_entities_len(r2) != 1 { panic(91010); };
    let g = ecs_resource_entities_get(r2, 100);
    if g.0 != true { panic(91011); };
    if g.1 != 999 { panic(91012); };
}

@test "resource_entities_insert_overwrite"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 1);
    let r3 = ecs_resource_entities_insert(r2, 100, 2);
    if ecs_resource_entities_len(r3) != 1 { panic(91013); };
    let g = ecs_resource_entities_get(r3, 100);
    if g.1 != 2 { panic(91014); };
}

@test "resource_entities_get_miss"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 999);
    let g = ecs_resource_entities_get(r2, 999);
    if g.0 != false { panic(91015); };
}

@test "resource_entities_contains"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 999);
    if ecs_resource_entities_contains(r2, 100) != true { panic(91016); };
    if ecs_resource_entities_contains(r2, 200) != false { panic(91017); };
}

@test "resource_entities_iter_at"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 1);
    let r3 = ecs_resource_entities_insert(r2, 200, 2);
    let i1 = ecs_resource_entities_iter_at(r3, 0);
    let i2 = ecs_resource_entities_iter_at(r3, 1);
    let i3 = ecs_resource_entities_iter_at(r3, 5);
    if i1.0 != true { panic(91018); };
    if i1.1 != 100 { panic(91019); };
    if i1.2 != 1 { panic(91020); };
    if i2.0 != true { panic(91021); };
    if i2.1 != 200 { panic(91022); };
    if i2.2 != 2 { panic(91023); };
    if i3.0 != false { panic(91024); };
}

@test "resource_entities_remove_existing"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 1);
    let r3 = ecs_resource_entities_insert(r2, 200, 2);
    let res = ecs_resource_entities_remove(r3, 100);
    let rm = res.0;
    let r4 = res.1;
    if rm != true { panic(91025); };
    if ecs_resource_entities_contains(r4, 100) != false { panic(91026); };
    if ecs_resource_entities_contains(r4, 200) != true { panic(91027); };
    if ecs_resource_entities_len(r4) != 1 { panic(91028); };
}

@test "resource_entities_remove_missing"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 1);
    let res = ecs_resource_entities_remove(r2, 999);
    if res.0 != false { panic(91029); };
    let r3 = res.1;
    if ecs_resource_entities_len(r3) != 1 { panic(91030); };
}

@test "resource_entities_clear"() {
    let r = ecs_resource_entities_new();
    let r2 = ecs_resource_entities_insert(r, 100, 1);
    let r3 = ecs_resource_entities_insert(r2, 200, 2);
    let r4 = ecs_resource_entities_clear(r3);
    if ecs_resource_entities_len(r4) != 0 { panic(91031); };
    if ecs_resource_entities_is_empty(r4) != true { panic(91032); };
}

@test "resource_flag_make_resource"() {
    let flag = ecs_resource_flag_make_resource();
    if ecs_resource_flag_is_resource(flag) != true { panic(91033); };
}

@test "resource_flag_make_non_resource"() {
    let flag = ecs_resource_flag_make_non_resource();
    if ecs_resource_flag_is_resource(flag) != false { panic(91034); };
}

@test "resource_flag_parity_with_extra_bits"() {
    // Note: parity check uses flag's bit-0; a value of 3 (binary 11) is resource flag set
    if ecs_resource_flag_is_resource(3) != true { panic(91035); };
    if ecs_resource_flag_is_resource(4) != false { panic(91036); };
}

@test "resource_entities_full_workflow"() {
    let r0 = ecs_resource_entities_new();
    let r1 = ecs_resource_entities_insert(r0, 10, 1000);
    let r2 = ecs_resource_entities_insert(r1, 20, 2000);
    let r3 = ecs_resource_entities_insert(r2, 30, 3000);
    if ecs_resource_entities_len(r3) != 3 { panic(91037); };
    let g = ecs_resource_entities_get(r3, 20);
    if g.0 != true { panic(91038); };
    if g.1 != 2000 { panic(91039); };
    let res = ecs_resource_entities_remove(r3, 20);
    let r4 = res.1;
    if ecs_resource_entities_len(r4) != 2 { panic(91040); };
    if ecs_resource_entities_contains(r4, 20) != false { panic(91041); };
    if ecs_resource_entities_contains(r4, 10) != true { panic(91042); };
    if ecs_resource_entities_contains(r4, 30) != true { panic(91043); };
}
