@import "lib/message_reader_writer_deep.sla"

// Batch 276: message_reader_writer deep (src/message/message_reader.rs + message_writer.rs).
// panic codes: 121200 – 121399.

@test "writer_write_and_len"() {
    let m = ecs_mrw_messages_new();
    let w0 = ecs_mrw_messages_write(m, 10);
    m = ecs_mrw_write_messages(w0);
    if ecs_mrw_write_id(w0) != 0 { panic(121200); };
    let w1 = ecs_mrw_messages_write(m, 20);
    m = ecs_mrw_write_messages(w1);
    if ecs_mrw_write_id(w1) != 1 { panic(121201); };
    if ecs_mrw_messages_len(m) != 2 { panic(121202); };
    if ecs_mrw_messages_message_count(m) != 2 { panic(121203); };
}

@test "writer_batch_and_default"() {
    let m = ecs_mrw_messages_new();
    let br = ecs_mrw_messages_write_batch4(m, 1, 2, 3, 4, 3);
    m = ecs_mrw_batch_messages(br);
    if ecs_mrw_batch_count(br) != 3 { panic(121210); };
    if ecs_mrw_messages_len(m) != 3 { panic(121211); };
    let d = ecs_mrw_messages_write_default(m);
    m = ecs_mrw_write_messages(d);
    if ecs_mrw_write_id(d) != 3 { panic(121212); };
}

@test "reader_len_and_read_order"() {
    let m = ecs_mrw_messages_new();
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 7));
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 8));
    let r = ecs_mrw_reader_new();
    if ecs_mrw_reader_len(r, m) != 2 { panic(121220); };
    if ecs_mrw_reader_is_empty(r, m) != false { panic(121221); };
    let rr0 = ecs_mrw_reader_read(r, m);
    r = ecs_mrw_read_reader(rr0);
    if ecs_mrw_read_has(rr0) != true { panic(121222); };
    if ecs_mrw_read_value(rr0) != 7 { panic(121223); };
    if ecs_mrw_read_id(rr0) != 0 { panic(121224); };
    let rr1 = ecs_mrw_reader_read(r, m);
    r = ecs_mrw_read_reader(rr1);
    if ecs_mrw_read_value(rr1) != 8 { panic(121225); };
    if ecs_mrw_reader_is_empty(r, m) != true { panic(121226); };
}

@test "reader_clear_skips"() {
    let m = ecs_mrw_messages_new();
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 1));
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 2));
    let r = ecs_mrw_reader_new();
    r = ecs_mrw_reader_clear(r, m);
    if ecs_mrw_reader_is_empty(r, m) != true { panic(121230); };
    let rr = ecs_mrw_reader_read(r, m);
    if ecs_mrw_read_has(rr) != false { panic(121231); };
}

@test "read_with_id_matches"() {
    let m = ecs_mrw_messages_new();
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 42));
    let r = ecs_mrw_reader_new();
    let rr = ecs_mrw_reader_read_with_id(r, m);
    if ecs_mrw_read_has(rr) != true { panic(121240); };
    if ecs_mrw_read_value(rr) != 42 { panic(121241); };
    if ecs_mrw_read_id(rr) != 0 { panic(121242); };
}

@test "update_then_read_a_then_b"() {
    let m = ecs_mrw_messages_new();
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 1));
    m = ecs_mrw_messages_update(m);
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 2));
    let r = ecs_mrw_reader_new();
    if ecs_mrw_reader_len(r, m) != 2 { panic(121250); };
    let rr0 = ecs_mrw_reader_read(r, m);
    r = ecs_mrw_read_reader(rr0);
    if ecs_mrw_read_value(rr0) != 1 { panic(121251); };
    let rr1 = ecs_mrw_reader_read(r, m);
    if ecs_mrw_read_value(rr1) != 2 { panic(121252); };
}

@test "double_update_misses_old"() {
    let m = ecs_mrw_messages_new();
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 9));
    let r = ecs_mrw_reader_new();
    m = ecs_mrw_messages_update(m);
    m = ecs_mrw_messages_update(m);
    if ecs_mrw_reader_len(r, m) != 0 { panic(121260); };
    let rr = ecs_mrw_reader_read(r, m);
    if ecs_mrw_read_has(rr) != false { panic(121261); };
}

@test "par_read_batching"() {
    let m = ecs_mrw_messages_new();
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 1));
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 2));
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 3));
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 4));
    let r = ecs_mrw_reader_new();
    let p = ecs_mrw_reader_par_read(r, m);
    if ecs_mrw_par_unread(p) != 4 { panic(121270); };
    p = ecs_mrw_par_batching_strategy(p, 2);
    if ecs_mrw_par_batch_count(p) != 2 { panic(121271); };
}

@test "populated_reader"() {
    let m = ecs_mrw_messages_new();
    let p0 = ecs_mrw_populated_from_messages(m);
    if ecs_mrw_populated_is_populated(p0) != false { panic(121280); };
    m = ecs_mrw_write_messages(ecs_mrw_messages_write(m, 1));
    let p1 = ecs_mrw_populated_from_messages(m);
    if ecs_mrw_populated_is_populated(p1) != true { panic(121281); };
    let r = ecs_mrw_populated_reader(p1);
    if ecs_mrw_reader_last(r) != 0 { panic(121282); };
}

@test "writer_facade"() {
    let w = ecs_mrw_writer_new();
    if ecs_mrw_writer_len(w) != 0 { panic(121290); };
    let wr = ecs_mrw_writer_write(w, 5);
    let m = ecs_mrw_write_messages(wr);
    w = ecs_mrw_writer_from_messages(m);
    if ecs_mrw_writer_len(w) != 1 { panic(121291); };
}
