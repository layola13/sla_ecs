@import "lib/schedule_config_deep.sla"

// Batch 177 tests for deepened schedule::config GraphInfo/Dependency/Ambiguity/Chain/nested configs.

@test "dependency_before_after_and_ignore_deferred"() {
    let b = ecs_dependency_before(10);
    if ecs_dependency_is_before(b) != true { panic(99600); };
    if ecs_dependency_is_after(b) != false { panic(99601); };
    if ecs_dependency_set_id(b) != 10 { panic(99602); };
    if ecs_dependency_ignores_deferred(b) != false { panic(99603); };
    let bi = ecs_dependency_add_ignore_deferred(b);
    if ecs_dependency_ignores_deferred(bi) != true { panic(99604); };
    let a = ecs_dependency_after(20);
    if ecs_dependency_is_after(a) != true { panic(99605); };
    if ecs_dep_kind_is_before(0) != true { panic(99606); };
    if ecs_dep_kind_is_after(1) != true { panic(99607); };
}

@test "ambiguity_check_to_ignore_with_set_to_push"() {
    let a = ecs_ambiguity_check();
    if ecs_ambiguity_is_check(a) != true { panic(99610); };
    let a2 = ecs_ambiguity_with(a, 5);
    if ecs_ambiguity_is_ignore_with_set(a2) != true { panic(99611); };
    if ecs_ambiguity_ignore_sets_count(a2) != 1 { panic(99612); };
    if ecs_ambiguity_ignore_set_at(a2, 0) != 5 { panic(99613); };
    let a3 = ecs_ambiguity_with(a2, 7);
    if ecs_ambiguity_ignore_sets_count(a3) != 2 { panic(99614); };
    if ecs_ambiguity_ignore_set_at(a3, 1) != 7 { panic(99615); };
}

@test "ambiguity_ignore_all_is_noop_for_with"() {
    let a = ecs_ambiguity_ignore_all();
    if ecs_ambiguity_is_ignore_all(a) != true { panic(99620); };
    let a2 = ecs_ambiguity_with(a, 99);
    if ecs_ambiguity_is_ignore_all(a2) != true { panic(99621); };
    if ecs_ambiguity_ignore_sets_count(a2) != 0 { panic(99622); };
}

@test "graph_info_hierarchy_and_dependencies"() {
    let g = ecs_graph_info_deep_new();
    g = ecs_graph_info_deep_hierarchy_push(g, 1);
    g = ecs_graph_info_deep_hierarchy_push(g, 2);
    if ecs_graph_info_deep_hierarchy_count(g) != 2 { panic(99630); };
    if ecs_graph_info_deep_hierarchy_at(g, 0) != 1 { panic(99631); };
    if ecs_graph_info_deep_hierarchy_at(g, 1) != 2 { panic(99632); };
    g = ecs_graph_info_deep_before(g, 10);
    g = ecs_graph_info_deep_after(g, 20);
    g = ecs_graph_info_deep_before_ignore_deferred(g, 30);
    g = ecs_graph_info_deep_after_ignore_deferred(g, 40);
    if ecs_graph_info_deep_dependency_count(g) != 4 { panic(99633); };
    let d0 = ecs_graph_info_deep_dependency_at(g, 0);
    if ecs_dependency_is_before(d0) != true { panic(99634); };
    if ecs_dependency_ignores_deferred(d0) != false { panic(99635); };
    let d2 = ecs_graph_info_deep_dependency_at(g, 2);
    if ecs_dependency_set_id(d2) != 30 { panic(99636); };
    if ecs_dependency_ignores_deferred(d2) != true { panic(99637); };
    let d3 = ecs_graph_info_deep_dependency_at(g, 3);
    if ecs_dependency_is_after(d3) != true { panic(99638); };
    if ecs_dependency_ignores_deferred(d3) != true { panic(99639); };
}

@test "graph_info_ambiguous_with_and_all"() {
    let g = ecs_graph_info_deep_new();
    g = ecs_graph_info_deep_ambiguous_with(g, 3);
    let a = ecs_graph_info_deep_ambiguity(g);
    if ecs_ambiguity_is_ignore_with_set(a) != true { panic(99640); };
    if ecs_ambiguity_ignore_set_at(a, 0) != 3 { panic(99641); };
    g = ecs_graph_info_deep_ambiguous_with_all(g);
    let a2 = ecs_graph_info_deep_ambiguity(g);
    if ecs_ambiguity_is_ignore_all(a2) != true { panic(99642); };
}

@test "chain_set_chained_and_ignore_deferred"() {
    let c = ecs_chain_unchained();
    if ecs_chain_is_unchained(c) != true { panic(99650); };
    let c2 = ecs_chain_set_chained(c);
    if ecs_chain_is_chained(c2) != true { panic(99651); };
    if ecs_chain_ignores_deferred(c2) != false { panic(99652); };
    // already chained keeps ignore_deferred false when set_chained again
    let c3 = ecs_chain_set_chained(c2);
    if ecs_chain_is_chained(c3) != true { panic(99653); };
    let c4 = ecs_chain_set_chained_with_ignore_deferred(ecs_chain_unchained());
    if ecs_chain_is_chained(c4) != true { panic(99654); };
    if ecs_chain_ignores_deferred(c4) != true { panic(99655); };
}

@test "schedule_config_system_with_default_sets"() {
    let sets: Vec<i64> = Vec::new();
    sets.push(100);
    sets.push(200);
    let c = ecs_schedule_config_deep_system_with_default_sets(7, sets);
    if ecs_schedule_config_deep_is_system(c) != true { panic(99660); };
    if ecs_schedule_config_deep_node_id(c) != 7 { panic(99661); };
    let g = ecs_schedule_config_deep_metadata(c);
    if ecs_graph_info_deep_hierarchy_count(g) != 2 { panic(99662); };
    if ecs_graph_info_deep_hierarchy_at(g, 0) != 100 { panic(99663); };
    if ecs_graph_info_deep_hierarchy_at(g, 1) != 200 { panic(99664); };
}

@test "schedule_config_system_set_rejects_system_type_set"() {
    let r = ecs_schedule_config_deep_system_set(5, true);
    if r.0 != false { panic(99670); };
    let r2 = ecs_schedule_config_deep_system_set(5, false);
    if r2.0 != true { panic(99671); };
    if ecs_schedule_config_deep_is_set(r2.1) != true { panic(99672); };
    if ecs_schedule_config_deep_node_id(r2.1) != 5 { panic(99673); };
}

@test "schedule_config_push_condition"() {
    let c = ecs_schedule_config_deep_system(1);
    c = ecs_schedule_config_deep_push_condition(c, 42);
    c = ecs_schedule_config_deep_push_condition(c, 43);
    if ecs_schedule_config_deep_condition_count(c) != 2 { panic(99680); };
    if ecs_schedule_config_deep_condition_at(c, 0) != 42 { panic(99681); };
    if ecs_schedule_config_deep_condition_at(c, 1) != 43 { panic(99682); };
}

@test "configs_single_in_set_and_before_after"() {
    let leaf = ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1));
    let r = ecs_schedule_configs_deep_in_set(leaf, 9, false);
    if r.0 != true { panic(99690); };
    let c = r.1;
    if ecs_schedule_configs_deep_leaf_hierarchy_membership_count(c, 9) != 1 { panic(99691); };
    c = ecs_schedule_configs_deep_before(c, 11);
    c = ecs_schedule_configs_deep_after(c, 12);
    if ecs_schedule_configs_deep_leaf_dep_count(c, 0, 11, false) != 1 { panic(99692); };
    if ecs_schedule_configs_deep_leaf_dep_count(c, 1, 12, false) != 1 { panic(99693); };
}

@test "configs_in_set_rejects_system_type_set"() {
    let leaf = ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1));
    let r = ecs_schedule_configs_deep_in_set(leaf, 9, true);
    if r.0 != false { panic(99700); };
    if ecs_schedule_configs_deep_leaf_hierarchy_membership_count(r.1, 9) != 0 { panic(99701); };
}

@test "configs_group_in_set_applies_to_all_leaves"() {
    let children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    let group = ecs_schedule_configs_deep_group(children);
    if ecs_schedule_configs_deep_is_group(group) != true { panic(99710); };
    if ecs_schedule_configs_deep_child_count(group) != 2 { panic(99711); };
    let r = ecs_schedule_configs_deep_in_set(group, 55, false);
    if r.0 != true { panic(99712); };
    if ecs_schedule_configs_deep_leaf_hierarchy_membership_count(r.1, 55) != 2 { panic(99713); };
}

@test "configs_group_before_after_ignore_deferred"() {
    let children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    let group = ecs_schedule_configs_deep_group(children);
    let g = ecs_schedule_configs_deep_before_ignore_deferred(group, 70);
    g = ecs_schedule_configs_deep_after_ignore_deferred(g, 80);
    if ecs_schedule_configs_deep_leaf_dep_count(g, 0, 70, true) != 2 { panic(99720); };
    if ecs_schedule_configs_deep_leaf_dep_count(g, 1, 80, true) != 2 { panic(99721); };
    // plain before/after without ignore_deferred still zero for require_ignore_deferred=false on those sets
    if ecs_schedule_configs_deep_leaf_dep_count(g, 0, 70, false) != 0 { panic(99722); };
}

@test "distributive_run_if_vs_collective_run_if"() {
    let children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    let group = ecs_schedule_configs_deep_group(children);
    // distributive: condition on every leaf
    let d = ecs_schedule_configs_deep_distributive_run_if(group, 100);
    if ecs_schedule_configs_deep_leaf_condition_total(d) != 2 { panic(99730); };
    if ecs_schedule_configs_deep_collective_count(d) != 0 { panic(99731); };
    // collective run_if on a fresh group
    let children2: Vec<EcsScheduleConfigsDeep> = Vec::new();
    children2.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    children2.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    let group2 = ecs_schedule_configs_deep_group(children2);
    let c = ecs_schedule_configs_deep_run_if(group2, 200);
    if ecs_schedule_configs_deep_collective_count(c) != 1 { panic(99732); };
    if ecs_schedule_configs_deep_leaf_condition_total(c) != 0 { panic(99733); };
    // single leaf run_if goes to leaf conditions
    let leaf = ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(3));
    let leaf2 = ecs_schedule_configs_deep_run_if(leaf, 300);
    if ecs_schedule_configs_deep_leaf_condition_total(leaf2) != 1 { panic(99734); };
}

@test "ambiguous_with_and_ambiguous_with_all_on_group"() {
    let children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    let group = ecs_schedule_configs_deep_group(children);
    let g = ecs_schedule_configs_deep_ambiguous_with(group, 15);
    // each leaf should have IgnoreWithSet([15])
    let g2 = ecs_schedule_configs_deep_ambiguous_with_all(g);
    if ecs_schedule_configs_deep_leaf_ignore_all_count(g2) != 2 { panic(99740); };
}

@test "chain_and_chain_ignore_deferred_on_group_and_noop_on_single"() {
    let children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    let group = ecs_schedule_configs_deep_group(children);
    let g = ecs_schedule_configs_deep_chain(group);
    let chain = ecs_schedule_configs_deep_get_chain(g);
    if ecs_chain_is_chained(chain) != true { panic(99750); };
    if ecs_chain_ignores_deferred(chain) != false { panic(99751); };
    let g2 = ecs_schedule_configs_deep_chain_ignore_deferred(ecs_schedule_configs_deep_group(children));
    let chain2 = ecs_schedule_configs_deep_get_chain(g2);
    if ecs_chain_is_chained(chain2) != true { panic(99752); };
    if ecs_chain_ignores_deferred(chain2) != true { panic(99753); };
    // single: chain is a no-op (stays Unchained)
    let leaf = ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(9));
    let leaf2 = ecs_schedule_configs_deep_chain(leaf);
    if ecs_chain_is_unchained(ecs_schedule_configs_deep_get_chain(leaf2)) != true { panic(99754); };
}

@test "into_configs_identity"() {
    let leaf = ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1));
    let out = ecs_schedule_configs_deep_into_configs(leaf);
    if ecs_schedule_configs_deep_is_single(out) != true { panic(99760); };
    if ecs_schedule_config_deep_node_id(ecs_schedule_configs_deep_single_config(out)) != 1 { panic(99761); };
}

@test "nested_group_distributive_and_in_set"() {
    // ((s1), (s2, s3)) style nesting
    let inner_children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    inner_children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(2)));
    inner_children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(3)));
    let inner = ecs_schedule_configs_deep_group(inner_children);
    let outer_children: Vec<EcsScheduleConfigsDeep> = Vec::new();
    outer_children.push(ecs_schedule_configs_deep_single(ecs_schedule_config_deep_system(1)));
    outer_children.push(inner);
    let outer = ecs_schedule_configs_deep_group(outer_children);
    let r = ecs_schedule_configs_deep_in_set(outer, 99, false);
    if r.0 != true { panic(99770); };
    // three leaves all in set 99
    if ecs_schedule_configs_deep_leaf_hierarchy_membership_count(r.1, 99) != 3 { panic(99771); };
    let d = ecs_schedule_configs_deep_distributive_run_if(r.1, 7);
    if ecs_schedule_configs_deep_leaf_condition_total(d) != 3 { panic(99772); };
}

@test "ambiguity_ignore_set_at_out_of_range"() {
    let a = ecs_ambiguity_ignore_with_set(1);
    if ecs_ambiguity_ignore_set_at(a, 5) != -1 { panic(99780); };
    if ecs_ambiguity_ignore_set_at(a, -1) != -1 { panic(99781); };
}

@test "dependency_at_out_of_range"() {
    let g = ecs_graph_info_deep_new();
    let d = ecs_graph_info_deep_dependency_at(g, 0);
    if ecs_dependency_kind(d) != -1 { panic(99790); };
    if ecs_dependency_set_id(d) != -1 { panic(99791); };
}
