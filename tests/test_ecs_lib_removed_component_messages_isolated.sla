@import "lib/removed_component_messages.sla"

// Isolated tests for lib/removed_component_messages.sla — world-level RemovedComponentMessages
// storage (new/update/iter/get/write) + RemovedComponentReader reader API (read/read_with_id/
// len/is_empty/clear). Bevy reference: src/lifecycle.rs.

const COMP_X: i32 = 3201;
const COMP_Y: i32 = 3202;
const ENT_1: i32 = 41;
const ENT_2: i32 = 42;
const ENT_3: i32 = 43;

@test "rcm_new_is_empty_buckets"() {
    let s = ecs_removed_component_messages_new();
    if ecs_removed_component_messages_buckets(s) != 0 { panic(91700); };
    if ecs_removed_component_messages_iter_count(s) != 0 { panic(91701); };
}

@test "rcm_write_creates_bucket_for_new_component"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    if ecs_removed_component_messages_buckets(s1) != 1 { panic(91702); };
    if ecs_removed_component_messages_bucket_count(s1, COMP_X) != 1 { panic(91703); };
    if ecs_removed_component_messages_entity_at(s1, COMP_X, 0) != ENT_1 { panic(91704); };
}

@test "rcm_write_appends_to_existing_bucket"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let s3 = ecs_removed_component_messages_write(s2, COMP_X, ENT_3);
    if ecs_removed_component_messages_buckets(s3) != 1 { panic(91705); };
    if ecs_removed_component_messages_bucket_count(s3, COMP_X) != 3 { panic(91706); };
    if ecs_removed_component_messages_entity_at(s3, COMP_X, 0) != ENT_1 { panic(91707); };
    if ecs_removed_component_messages_entity_at(s3, COMP_X, 1) != ENT_2 { panic(91708); };
    if ecs_removed_component_messages_entity_at(s3, COMP_X, 2) != ENT_3 { panic(91709); };
}

@test "rcm_write_distinct_components_separate_buckets"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_Y, ENT_2);
    if ecs_removed_component_messages_buckets(s2) != 2 { panic(91710); };
    if ecs_removed_component_messages_bucket_count(s2, COMP_X) != 1 { panic(91711); };
    if ecs_removed_component_messages_bucket_count(s2, COMP_Y) != 1 { panic(91712); };
}

@test "rcm_update_returns_same_state"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_update(s1);
    // update is a no-op in our linear model
    if ecs_removed_component_messages_bucket_count(s2, COMP_X) != 1 { panic(91713); };
}

@test "rcm_get_none"() {
    let s = ecs_removed_component_messages_new();
    let g = ecs_removed_component_messages_get(s, COMP_X);
    if ecs_rcm_get_has(g) != 0 { panic(91714); };
    if ecs_rcm_get_count(g) != 0 { panic(91715); };
    if ecs_rcm_get_first_entity(g) != -1 { panic(91716); };
}

@test "rcm_get_some"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let g = ecs_removed_component_messages_get(s2, COMP_X);
    if ecs_rcm_get_has(g) != 1 { panic(91717); };
    if ecs_rcm_get_count(g) != 2 { panic(91718); };
    if ecs_rcm_get_first_entity(g) != ENT_1 { panic(91719); };
}

@test "rcm_get_unknown_after_write_other_id"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_Y, ENT_2);
    let g = ecs_removed_component_messages_get(s1, COMP_X);
    if ecs_rcm_get_has(g) != 0 { panic(91720); };
}

@test "rcm_iter_empty"() {
    let s = ecs_removed_component_messages_new();
    if ecs_removed_component_messages_iter_count(s) != 0 { panic(91721); };
    let p = ecs_removed_component_messages_iter_pair(s, 0);
    if ecs_rcm_pair_component_id(p) != -1 { panic(91722); };
}

@test "rcm_iter_pair"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let s3 = ecs_removed_component_messages_write(s2, COMP_Y, ENT_3);
    if ecs_removed_component_messages_iter_count(s3) != 2 { panic(91723); };
    let p0 = ecs_removed_component_messages_iter_pair(s3, 0);
    if ecs_rcm_pair_component_id(p0) != COMP_X { panic(91724); };
    if ecs_rcm_pair_count(p0) != 2 { panic(91725); };
    let p1 = ecs_removed_component_messages_iter_pair(s3, 1);
    if ecs_rcm_pair_component_id(p1) != COMP_Y { panic(91726); };
    if ecs_rcm_pair_count(p1) != 1 { panic(91727); };
}

@test "rcm_iter_oob"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let p_neg = ecs_removed_component_messages_iter_pair(s1, -1);
    if ecs_rcm_pair_component_id(p_neg) != -1 { panic(91728); };
    let p_oob = ecs_removed_component_messages_iter_pair(s1, 99);
    if ecs_rcm_pair_component_id(p_oob) != -1 { panic(91729); };
}

@test "rcm_entity_at_oob"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    if ecs_removed_component_messages_entity_at(s1, COMP_X, -1) != -1 { panic(91730); };
    if ecs_removed_component_messages_entity_at(s1, COMP_X, 9) != -1 { panic(91731); };
    if ecs_removed_component_messages_entity_at(s1, COMP_Y, 0) != -1 { panic(91732); };
}

@test "rcr_new"() {
    let r = ecs_removed_component_reader_new(COMP_X);
    if ecs_removed_component_reader_component_id(r) != COMP_X { panic(91733); };
    if ecs_removed_component_reader_cursor(r) != 0 { panic(91734); };
    if ecs_removed_component_reader_drained(r) != 0 { panic(91735); };
}

@test "rcr_len_empty_when_no_messages"() {
    let s = ecs_removed_component_messages_new();
    let r = ecs_removed_component_reader_new(COMP_X);
    if ecs_removed_component_reader_len(s, r) != 0 { panic(91736); };
    if !ecs_removed_component_reader_is_empty(s, r) { panic(91737); };
}

@test "rcr_len_after_writes"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let r = ecs_removed_component_reader_new(COMP_X);
    if ecs_removed_component_reader_len(s2, r) != 2 { panic(91738); };
}

@test "rcr_read_returns_entity_then_none"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let r0 = ecs_removed_component_reader_new(COMP_X);
    let (rd1, r1) = ecs_removed_component_reader_read(s2, r0);
    if ecs_rcr_read_had(rd1) != 1 { panic(91739); };
    if ecs_rcr_read_entity(rd1) != ENT_1 { panic(91740); };
    if ecs_rcr_read_cursor(rd1) != 1 { panic(91741); };
    let (rd2, r2) = ecs_removed_component_reader_read(s2, r1);
    if ecs_rcr_read_had(rd2) != 1 { panic(91742); };
    if ecs_rcr_read_entity(rd2) != ENT_2 { panic(91743); };
    let (rd3, r3) = ecs_removed_component_reader_read(s2, r2);
    if ecs_rcr_read_had(rd3) != 0 { panic(91744); };
    if ecs_rcr_read_entity(rd3) != -1 { panic(91745); };
    if ecs_rcr_read_drained(rd3) != 2 { panic(91746); };
    let _ = r3;
}

@test "rcr_read_exhausted_reader_returns_empty_initially"() {
    let s = ecs_removed_component_messages_new();
    let r = ecs_removed_component_reader_new(COMP_X);
    let (rd, _) = ecs_removed_component_reader_read(s, r);
    if ecs_rcr_read_had(rd) != 0 { panic(91747); };
    if ecs_rcr_read_entity(rd) != -1 { panic(91748); };
}

@test "rcr_read_with_id"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let r0 = ecs_removed_component_reader_new(COMP_X);
    let (rd1, r1) = ecs_removed_component_reader_read_with_id(s2, r0);
    if ecs_rcr_read_with_id_had(rd1) != 1 { panic(91749); };
    if ecs_rcr_read_with_id_entity(rd1) != ENT_1 { panic(91750); };
    if ecs_rcr_read_with_id_msg_id(rd1) != 0 { panic(91751); };
    let (rd2, r2) = ecs_removed_component_reader_read_with_id(s2, r1);
    if ecs_rcr_read_with_id_had(rd2) != 1 { panic(91752); };
    if ecs_rcr_read_with_id_entity(rd2) != ENT_2 { panic(91753); };
    if ecs_rcr_read_with_id_msg_id(rd2) != 1 { panic(91754); };
    let (rd3, _) = ecs_removed_component_reader_read_with_id(s2, r2);
    if ecs_rcr_read_with_id_had(rd3) != 0 { panic(91755); };
    if ecs_rcr_read_with_id_msg_id(rd3) != -1 { panic(91756); };
}

@test "rcr_is_empty_after_draining"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let r0 = ecs_removed_component_reader_new(COMP_X);
    let (_, r1) = ecs_removed_component_reader_read(s1, r0);
    if !ecs_removed_component_reader_is_empty(s1, r1) { panic(91757); };
}

@test "rcr_clear_consumes_all_messages"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let s3 = ecs_removed_component_messages_write(s2, COMP_X, ENT_3);
    let r0 = ecs_removed_component_reader_new(COMP_X);
    let r1 = ecs_removed_component_reader_clear(s3, r0);
    if !ecs_removed_component_reader_is_empty(s3, r1) { panic(91758); };
    if ecs_removed_component_reader_drained(r1) != 3 { panic(91759); };
    // post-clear read returns had=0
    let (rd, _) = ecs_removed_component_reader_read(s3, r1);
    if ecs_rcr_read_had(rd) != 0 { panic(91760); };
}

@test "rcr_len_decrements_per_read"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let r0 = ecs_removed_component_reader_new(COMP_X);
    if ecs_removed_component_reader_len(s2, r0) != 2 { panic(91761); };
    let (_, r1) = ecs_removed_component_reader_read(s2, r0);
    if ecs_removed_component_reader_len(s2, r1) != 1 { panic(91762); };
}

@test "rcr_partial_clear_drains_only_remaining"() {
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_X, ENT_2);
    let s3 = ecs_removed_component_messages_write(s2, COMP_X, ENT_3);
    let r0 = ecs_removed_component_reader_new(COMP_X);
    let (_, r1) = ecs_removed_component_reader_read(s3, r0);
    if ecs_removed_component_reader_drained(r1) != 1 { panic(91763); };
    // clear after one read should only drain the remaining 2
    let r2 = ecs_removed_component_reader_clear(s3, r1);
    if ecs_removed_component_reader_drained(r2) != 3 { panic(91764); };
    if ecs_removed_component_reader_len(s3, r2) != 0 { panic(91765); };
}

@test "rcm_multi_component_reader_isolation"() {
    // two readers on different components should drain independently
    let s0 = ecs_removed_component_messages_new();
    let s1 = ecs_removed_component_messages_write(s0, COMP_X, ENT_1);
    let s2 = ecs_removed_component_messages_write(s1, COMP_Y, ENT_2);
    let rX = ecs_removed_component_reader_new(COMP_X);
    let rY = ecs_removed_component_reader_new(COMP_Y);
    let (rxRd, drX) = ecs_removed_component_reader_read(s2, rX);
    if ecs_rcr_read_entity(rxRd) != ENT_1 { panic(91766); };
    let (ryRd, drY) = ecs_removed_component_reader_read(s2, rY);
    if ecs_rcr_read_entity(ryRd) != ENT_2 { panic(91767); };
}
