// Isolated deep tests for lib/schedule_value_deep.sla (Batch 403).
// Tests the deep Schedule value struct lifecycle + cleanup policy APIs.

@import "lib/schedule_value_deep.sla"

@test "new_default_and_label"() {
    let s = ecs_schedule_deep_new(42);
    if ecs_schedule_deep_label(s) != 42 { panic(145000); };
    if ecs_schedule_deep_is_changed(s) != true { panic(145001); };
    if ecs_schedule_deep_executor_initialized(s) != false { panic(145002); };
    let d = ecs_schedule_deep_default();
    if ecs_schedule_deep_label(d) != 0 { panic(145003); };
    if ecs_schedule_deep_apply_final_deferred(d) != true { panic(145004); };
    if ecs_schedule_deep_executor_kind(d) != ECS_SCHED_DEEP_EXEC_MULTI { panic(145005); };
}

@test "set_executor_and_apply_final_deferred"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_set_executor(s0, ECS_SCHED_DEEP_EXEC_SINGLE);
    if ecs_schedule_deep_executor_kind(s1) != ECS_SCHED_DEEP_EXEC_SINGLE { panic(145010); };
    let s2 = ecs_schedule_deep_set_apply_final_deferred(s1, false);
    if ecs_schedule_deep_apply_final_deferred(s2) != false { panic(145011); };
    let s3 = ecs_schedule_deep_set_apply_final_deferred(s2, true);
    if ecs_schedule_deep_apply_final_deferred(s3) != true { panic(145012); };
}

@test "build_settings"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_set_build_settings(s0, 2, 3, false);
    if ecs_schedule_deep_get_build_settings_ambiguity(s1) != 2 { panic(145020); };
    if ecs_schedule_deep_get_build_settings_hierarchy(s1) != 3 { panic(145021); };
    if ecs_schedule_deep_get_build_settings_auto_insert(s1) != false { panic(145022); };
    let s2 = ecs_schedule_deep_set_build_settings(s1, 1, 1, true);
    if ecs_schedule_deep_get_build_settings_auto_insert(s2) != true { panic(145023); };
}

@test "add_systems_and_sets"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 11, 1);
    let s2 = ecs_schedule_deep_add_system(s1, 12, 2);
    let s3 = ecs_schedule_deep_add_set(s2, 100, 1);
    let s4 = ecs_schedule_deep_add_set(s3, 200, 1);
    if ecs_schedule_deep_graph_system_count(s4) != 2 { panic(145030); };
    if ecs_schedule_deep_graph_set_count(s4) != 2 { panic(145031); };
    if ecs_schedule_deep_is_changed(s4) != true { panic(145032); };
}

@test "mark_changed_resets_initialized"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_mark_changed(s0);
    if ecs_schedule_deep_is_changed(s1) != true { panic(145040); };
    if ecs_schedule_deep_executor_initialized(s1) != false { panic(145041); };
}

@test "initialize_freezes_counts"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 1, 0);
    let s2 = ecs_schedule_deep_add_system(s1, 2, 0);
    let s3 = ecs_schedule_deep_add_set(s2, 100, 0);
    let r = ecs_schedule_deep_initialize(s3);
    if ecs_schedule_deep_init_result_initialized(r) != true { panic(145050); };
    if ecs_schedule_deep_init_result_built_system_count(r) != 2 { panic(145051); };
    if ecs_schedule_deep_init_result_built_set_count(r) != 1 { panic(145052); };
    if ecs_schedule_deep_init_result_graph_changed(r) != 0 { panic(145053); };
}

@test "check_change_ticks"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 1, 0);
    let s2 = ecs_schedule_deep_add_system(s1, 2, 0);
    let r = ecs_schedule_deep_check_change_ticks(s2, 7);
    if ecs_schedule_deep_check_change_ticks_system_count(r) != 2 { panic(145060); };
    if ecs_schedule_deep_check_change_ticks_present_tick(r) != 7 { panic(145061); };
}

@test "run_returns_built_count"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 1, 0);
    let s2 = ecs_schedule_deep_add_set(s1, 10, 0);
    let r = ecs_schedule_deep_run(s2);
    if ecs_schedule_deep_run_result_initialized(r) != true { panic(145070); };
    if ecs_schedule_deep_run_result_built_system_count(r) != 1 { panic(145071); };
}

@test "apply_deferred"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 1, 0);
    let s2 = ecs_schedule_deep_add_system(s1, 2, 0);
    let r = ecs_schedule_deep_apply_deferred(s2);
    if ecs_schedule_deep_apply_deferred_result_count(r) != 2 { panic(145080); };
}

@test "systems_uninitialized"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 1, 0);
    let r = ecs_schedule_deep_systems(s1);
    if ecs_schedule_deep_systems_result_initialized(r) != false { panic(145090); };
    if ecs_schedule_deep_systems_result_len(r) != 0 { panic(145091); };
    let len = ecs_schedule_deep_systems_len(s1);
    if ecs_schedule_deep_systems_len_result_initialized(len) != false { panic(145092); };
    if ecs_schedule_deep_systems_len_result_count(len) != 0 { panic(145093); };
}

@test "systems_initialized_returns_ids"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_system(s0, 11, 0);
    let s2 = ecs_schedule_deep_add_system(s1, 22, 0);
    let s_init = ecs_schedule_deep_initialize_inplace(s2);
    let r = ecs_schedule_deep_systems(s_init);
    if ecs_schedule_deep_systems_result_initialized(r) != true { panic(145100); };
    if ecs_schedule_deep_systems_result_len(r) != 2 { panic(145101); };
    if ecs_schedule_deep_systems_result_at(r, 0) != 11 { panic(145102); };
    if ecs_schedule_deep_systems_result_at(r, 1) != 22 { panic(145103); };
    let len = ecs_schedule_deep_systems_len(s_init);
    if ecs_schedule_deep_systems_len_result_initialized(len) != true { panic(145104); };
    if ecs_schedule_deep_systems_len_result_count(len) != 2 { panic(145105); };
}

@test "systems_in_set_count"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_set(s0, 100, 0);
    let s2 = ecs_schedule_deep_add_set(s1, 100, 0);
    let s3 = ecs_schedule_deep_add_set(s2, 200, 0);
    if ecs_schedule_deep_systems_in_set(s3, 100) != 2 { panic(145110); };
    if ecs_schedule_deep_systems_in_set_count(s3, 100) != 2 { panic(145111); };
    if ecs_schedule_deep_systems_in_set(s3, 200) != 1 { panic(145112); };
    if ecs_schedule_deep_systems_in_set(s3, 300) != 0 { panic(145113); };
}

@test "remove_systems_in_set"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_set(s0, 100, 0);
    let s2 = ecs_schedule_deep_add_set(s1, 100, 0);
    let s3 = ecs_schedule_deep_add_set(s2, 200, 0);
    let s4 = ecs_schedule_deep_remove_systems_in_set(s3, 100);
    if ecs_schedule_deep_graph_set_count(s4) != 1 { panic(145120); };
    if ecs_schedule_deep_is_changed(s4) != true { panic(145121); };
}

@test "cleanup_policy_predicates"() {
    if ecs_cleanup_deep_policy_is_remove_set_and_systems(ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS) != true { panic(145130); };
    if ecs_cleanup_deep_policy_is_remove_systems_only(ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY) != true { panic(145131); };
    if ecs_cleanup_deep_policy_is_remove_set_and_systems_allow_breakages(ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS_ALLOW_BREAKAGES) != true { panic(145132); };
    if ecs_cleanup_deep_policy_is_remove_systems_only_allow_breakages(ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY_ALLOW_BREAKAGES) != true { panic(145133); };
    if ecs_cleanup_deep_policy_default() != ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS { panic(145134); };
}

@test "cleanup_with_policy_remove_set_and_systems"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_set(s0, 100, 0);
    let s2 = ecs_schedule_deep_add_set(s1, 100, 0);
    let s3 = ecs_schedule_deep_add_set(s2, 200, 0);
    let outcome = ecs_schedule_deep_remove_systems_in_set_with_policy(s3, 100, ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS);
    if ecs_schedule_deep_cleanup_outcome_removed_count(outcome) != 2 { panic(145140); };
    if ecs_schedule_deep_cleanup_outcome_set_removed(outcome) != true { panic(145141); };
    if ecs_schedule_deep_cleanup_outcome_ok(outcome) != true { panic(145142); };
    if ecs_schedule_deep_cleanup_outcome_next_set_n(outcome) != 1 { panic(145143); };
    if ecs_schedule_deep_cleanup_outcome_transitive_edges_added(outcome) != 0 { panic(145144); };
}

@test "cleanup_with_policy_remove_systems_only"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_set(s0, 100, 0);
    let s2 = ecs_schedule_deep_add_set(s1, 100, 0);
    let s3 = ecs_schedule_deep_add_set(s2, 200, 0);
    let outcome = ecs_schedule_deep_remove_systems_in_set_with_policy(s3, 100, ECS_CLEANUP_DEEP_REMOVE_SYSTEMS_ONLY);
    if ecs_schedule_deep_cleanup_outcome_removed_count(outcome) != 2 { panic(145150); };
    if ecs_schedule_deep_cleanup_outcome_set_removed(outcome) != false { panic(145151); };
    if ecs_schedule_deep_cleanup_outcome_next_set_n(outcome) != 3 { panic(145152); };
}

@test "cleanup_with_policy_remove_set_and_systems_allow_breakages"() {
    let s0 = ecs_schedule_deep_default();
    let s1 = ecs_schedule_deep_add_set(s0, 100, 0);
    let s2 = ecs_schedule_deep_add_set(s1, 100, 0);
    let s3 = ecs_schedule_deep_add_set(s2, 300, 0);
    let outcome = ecs_schedule_deep_remove_systems_in_set_with_policy(s3, 100, ECS_CLEANUP_DEEP_REMOVE_SET_AND_SYSTEMS_ALLOW_BREAKAGES);
    if ecs_schedule_deep_cleanup_outcome_removed_count(outcome) != 2 { panic(145160); };
    if ecs_schedule_deep_cleanup_outcome_set_removed(outcome) != true { panic(145161); };
    if ecs_schedule_deep_cleanup_outcome_next_set_n(outcome) != 1 { panic(145162); };
}
