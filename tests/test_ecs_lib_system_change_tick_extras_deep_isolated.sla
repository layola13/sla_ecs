@import "lib/system_change_tick_extras_deep.sla"

// Batch 312: system_change_tick_extras deep.
// panic codes: 128400 – 128599.

@test "tick_new_accessors"() {
    let t = ecs_sct_deep_new(10, 3);
    if ecs_sct_deep_this_run(t) != 10 { panic(128400); };
    if ecs_sct_deep_last_run(t) != 3 { panic(128401); };
}

@test "tick_advance"() {
    let t = ecs_sct_deep_new(5, 1);
    t = ecs_sct_deep_advance(t, 9);
    if ecs_sct_deep_this_run(t) != 9 { panic(128410); };
    if ecs_sct_deep_last_run(t) != 5 { panic(128411); };
}

@test "changed_since_last"() {
    let t = ecs_sct_deep_new(10, 4);
    if ecs_sct_deep_changed_since_last(t, 5) != true { panic(128420); };
    if ecs_sct_deep_changed_since_last(t, 4) != false { panic(128421); };
    if ecs_sct_deep_changed_since_last(t, 3) != false { panic(128422); };
}

@test "param_set_push_len"() {
    let p = ecs_ps_deep_new();
    p = ecs_ps_deep_push(p, 11);
    p = ecs_ps_deep_push(p, 22);
    if ecs_ps_deep_len(p) != 2 { panic(128430); };
    if ecs_ps_deep_slot(p, 0) != 11 { panic(128431); };
    if ecs_ps_deep_slot(p, 1) != 22 { panic(128432); };
}

@test "param_set_get_mut"() {
    let p = ecs_ps_deep_from4(1, 2, 3, 4, 4);
    let g = ecs_ps_deep_get_mut(p, 1);
    if ecs_ps_get_ok(g) != true { panic(128440); };
    if ecs_ps_get_value(g) != 2 { panic(128441); };
    p = ecs_ps_deep_with_active(p, ecs_ps_get_active(g));
    let g2 = ecs_ps_deep_get_mut(p, 1);
    if ecs_ps_get_conflict(g2) != true { panic(128442); };
    p = ecs_ps_deep_release(p);
    if ecs_ps_deep_active(p) != (0 - 1) { panic(128443); };
}

@test "param_set_oob"() {
    let p = ecs_ps_deep_from4(1, 0, 0, 0, 1);
    let g = ecs_ps_deep_get_mut(p, 5);
    if ecs_ps_get_ok(g) != false { panic(128450); };
}

@test "for_each_count"() {
    let p = ecs_ps_deep_from4(1, 2, 3, 0, 3);
    if ecs_ps_deep_for_each_count(p) != 3 { panic(128460); };
}

@test "deferred_reborrow_push"() {
    let d = ecs_def_deep_new(5);
    d = ecs_def_deep_push(d, 3);
    if ecs_def_deep_state(d) != 8 { panic(128470); };
    let r = ecs_def_deep_reborrow(d);
    if ecs_def_deep_state(r) != 8 { panic(128471); };
}

@test "if_gate"() {
    let a = ecs_if_deep_new(true, 42);
    let b = ecs_if_deep_new(false, 42);
    if ecs_if_deep_enabled(a) != true { panic(128480); };
    if ecs_if_deep_get(a) != 42 { panic(128481); };
    if ecs_if_deep_get(b) != 0 { panic(128482); };
}

@test "tick_setters"() {
    let t = ecs_sct_deep_new(1, 2);
    t = ecs_sct_deep_set_this(t, 8);
    t = ecs_sct_deep_set_last(t, 7);
    if ecs_sct_deep_this_run(t) != 8 { panic(128490); };
    if ecs_sct_deep_last_run(t) != 7 { panic(128491); };
}
