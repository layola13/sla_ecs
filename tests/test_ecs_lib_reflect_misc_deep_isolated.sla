// Isolated deep tests for lib/reflect_misc_deep.sla (Batch 409).
// Tests the deep reflect::misc 5-struct module: EcsReflectEvent (id + trigger counter),
// EcsReflectMessage (id + send counter), EcsFromWorld (new + from_world factory), EcsReflectMapEntities
// (remap accumulator), and EcsReflectEntityCommands (cap-16 commands slot family with push/count/at).

@import "lib/reflect_misc_deep.sla"

@test "event_new_id_and_initial_count"() {
    let e = ecs_reflect_event_deep_new(42);
    if ecs_reflect_event_deep_id(e) != 42 { panic(146960); };
    if ecs_reflect_event_deep_trigger_count(e) != 0 { panic(146961); };
}

@test "event_trigger_increments"() {
    let e = ecs_reflect_event_deep_new(7);
    e = ecs_reflect_event_deep_trigger(e);
    if ecs_reflect_event_deep_trigger_count(e) != 1 { panic(146962); };
    e = ecs_reflect_event_deep_trigger(e);
    e = ecs_reflect_event_deep_trigger(e);
    if ecs_reflect_event_deep_trigger_count(e) != 3 { panic(146963); };
}

@test "event_id_preserved_after_trigger"() {
    let e = ecs_reflect_event_deep_new(99);
    e = ecs_reflect_event_deep_trigger(e);
    if ecs_reflect_event_deep_id(e) != 99 { panic(146964); };
}

@test "message_new_id_and_initial_count"() {
    let m = ecs_reflect_message_deep_new(33);
    if ecs_reflect_message_deep_id(m) != 33 { panic(146965); };
    if ecs_reflect_message_deep_sent_count(m) != 0 { panic(146966); };
}

@test "message_send_increments"() {
    let m = ecs_reflect_message_deep_new(55);
    m = ecs_reflect_message_deep_send(m);
    m = ecs_reflect_message_deep_send(m);
    if ecs_reflect_message_deep_sent_count(m) != 2 { panic(146967); };
    if ecs_reflect_message_deep_id(m) != 55 { panic(146968); };
}

@test "from_world_new_value_zero"() {
    let f = ecs_from_world_deep_new(100);
    if ecs_from_world_deep_world_id(f) != 100 { panic(146969); };
    if ecs_from_world_deep_value(f) != 0 { panic(146970); };
}

@test "from_world_from_world_factory"() {
    let f = ecs_from_world_deep_from_world(200, 7777);
    if ecs_from_world_deep_world_id(f) != 200 { panic(146971); };
    if ecs_from_world_deep_value(f) != 7777 { panic(146972); };
}

@test "map_entities_new_and_remap_accumulate"() {
    let m = ecs_reflect_map_entities_deep_new();
    if ecs_reflect_map_entities_deep_count(m) != 0 { panic(146973); };
    m = ecs_reflect_map_entities_deep_remap(m, 3);
    if ecs_reflect_map_entities_deep_count(m) != 3 { panic(146974); };
    m = ecs_reflect_map_entities_deep_remap(m, 5);
    if ecs_reflect_map_entities_deep_count(m) != 8 { panic(146975); };
}

@test "entity_commands_new_empty"() {
    let c = ecs_reflect_entity_commands_deep_new();
    if ecs_reflect_entity_commands_deep_count(c) != 0 { panic(146976); };
}

@test "entity_commands_push_and_at"() {
    let c = ecs_reflect_entity_commands_deep_new();
    c = ecs_reflect_entity_commands_deep_push(c, 1);
    c = ecs_reflect_entity_commands_deep_push(c, 2);
    c = ecs_reflect_entity_commands_deep_push(c, 3);
    if ecs_reflect_entity_commands_deep_count(c) != 3 { panic(146977); };
    if ecs_reflect_entity_commands_deep_at(c, 0) != 1 { panic(146978); };
    if ecs_reflect_entity_commands_deep_at(c, 1) != 2 { panic(146979); };
    if ecs_reflect_entity_commands_deep_at(c, 2) != 3 { panic(146980); };
}

@test "entity_commands_cap16_enforced"() {
    let c = ecs_reflect_entity_commands_deep_new();
    let i: i32 = 0;
    while i < 16 {
        c = ecs_reflect_entity_commands_deep_push(c, i);
        i = i + 1;
    }
    if ecs_reflect_entity_commands_deep_count(c) != 16 { panic(146981); };
    // 17th push is silently dropped by the cap guard.
    c = ecs_reflect_entity_commands_deep_push(c, 99);
    if ecs_reflect_entity_commands_deep_count(c) != 16 { panic(146982); };
}

@test "entity_commands_at_first_last_after_cap16"() {
    let c = ecs_reflect_entity_commands_deep_new();
    let i: i32 = 0;
    while i < 16 {
        c = ecs_reflect_entity_commands_deep_push(c, i * 10);
        i = i + 1;
    }
    if ecs_reflect_entity_commands_deep_at(c, 0) != 0 { panic(146983); };
    if ecs_reflect_entity_commands_deep_at(c, 15) != 150 { panic(146984); };
}
