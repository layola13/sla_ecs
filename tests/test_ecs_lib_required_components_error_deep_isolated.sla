@import "lib/required_components_error_deep.sla"

// Batch 213: RequiredComponentsError deep (src/component/required.rs + World::try_register_required_components).
// panic codes: 108600 – 108699.

@test "kind_constants_bevy_order"() {
    if ecs_rce_kind_duplicate() != 0 { panic(108600); };
    if ecs_rce_kind_cyclic() != 1 { panic(108601); };
    if ecs_rce_kind_archetype() != 2 { panic(108602); };
    if ECS_RCE_DUPLICATE_REGISTRATION != 0 { panic(108603); };
    if ECS_RCE_CYCLIC_REQUIREMENT != 1 { panic(108604); };
    if ECS_RCE_ARCHETYPE_EXISTS != 2 { panic(108605); };
}

@test "duplicate_ctor_and_accessors"() {
    let e = ecs_rce_duplicate(3, 7);
    if ecs_rce_kind(e) != ECS_RCE_DUPLICATE_REGISTRATION { panic(108610); };
    if ecs_rce_is_duplicate(e) != true { panic(108611); };
    if ecs_rce_is_cyclic(e) != false { panic(108612); };
    if ecs_rce_is_archetype_exists(e) != false { panic(108613); };
    if ecs_rce_a(e) != 3 { panic(108614); };
    if ecs_rce_b(e) != 7 { panic(108615); };
    if ecs_rce_has_b(e) != true { panic(108616); };
    if ecs_rce_display_code(e) != (ECS_RCE_DISP_DUP + 3000 + 7) { panic(108617); };
}

@test "cyclic_ctor_and_display"() {
    let e = ecs_rce_cyclic(11, 12);
    if ecs_rce_is_cyclic(e) != true { panic(108620); };
    if ecs_rce_a(e) != 11 { panic(108621); };
    if ecs_rce_b(e) != 12 { panic(108622); };
    if ecs_rce_has_b(e) != true { panic(108623); };
    if ecs_rce_display_code(e) != (ECS_RCE_DISP_CYCLE + 11000 + 12) { panic(108624); };
}

@test "archetype_exists_ctor_no_b"() {
    let e = ecs_rce_archetype_exists(5);
    if ecs_rce_is_archetype_exists(e) != true { panic(108630); };
    if ecs_rce_a(e) != 5 { panic(108631); };
    if ecs_rce_has_b(e) != false { panic(108632); };
    if ecs_rce_display_code(e) != (ECS_RCE_DISP_ARCH + 5) { panic(108633); };
}

@test "eq_and_disjoint_kinds"() {
    let d1 = ecs_rce_duplicate(1, 2);
    let d2 = ecs_rce_duplicate(1, 2);
    let d3 = ecs_rce_duplicate(1, 3);
    let c = ecs_rce_cyclic(1, 2);
    let a = ecs_rce_archetype_exists(1);
    if ecs_rce_eq(d1, d2) != true { panic(108640); };
    if ecs_rce_eq(d1, d3) != false { panic(108641); };
    if ecs_rce_eq(d1, c) != false { panic(108642); };
    if ecs_rce_eq(d1, a) != false { panic(108643); };
    if ecs_rce_eq(a, ecs_rce_archetype_exists(1)) != true { panic(108644); };
    if ecs_rce_eq(a, ecs_rce_archetype_exists(2)) != false { panic(108645); };
}

@test "try_register_success_adds_direct_edge"() {
    let g = ecs_rce_graph_new();
    let r = ecs_rce_try_register(g, 1, 2);
    g = r.0;
    if r.1 != true { panic(108650); };
    if ecs_rce_result_is_ok(r.1) != true { panic(108651); };
    if ecs_rce_node_contains(g, 1, 2) != true { panic(108652); };
    if ecs_rce_node_len(g, 1) != 1 { panic(108653); };
    if ecs_rce_node_get(g, 1, 0) != 2 { panic(108654); };
}

@test "try_register_duplicate_direct"() {
    let g = ecs_rce_graph_new();
    let r1 = ecs_rce_try_register(g, 1, 2);
    g = r1.0;
    if r1.1 != true { panic(108660); };
    let r2 = ecs_rce_try_register(g, 1, 2);
    g = r2.0;
    if r2.1 != false { panic(108661); };
    if ecs_rce_is_duplicate(r2.2) != true { panic(108662); };
    if ecs_rce_a(r2.2) != 1 { panic(108663); };
    if ecs_rce_b(r2.2) != 2 { panic(108664); };
    // edge remains single
    if ecs_rce_node_len(g, 1) != 1 { panic(108665); };
}

@test "try_register_self_cycle"() {
    let g = ecs_rce_graph_new();
    let r = ecs_rce_try_register(g, 4, 4);
    if r.1 != false { panic(108670); };
    if ecs_rce_is_cyclic(r.2) != true { panic(108671); };
    if ecs_rce_a(r.2) != 4 { panic(108672); };
    if ecs_rce_b(r.2) != 4 { panic(108673); };
    if ecs_rce_node_len(r.0, 4) != 0 { panic(108674); };
}

@test "try_register_indirect_cycle"() {
    // 1 -> 2 -> 3; then 3 requires 1 would cycle
    let g = ecs_rce_graph_new();
    let a = ecs_rce_try_register(g, 1, 2);
    g = a.0;
    if a.1 != true { panic(108680); };
    let b = ecs_rce_try_register(g, 2, 3);
    g = b.0;
    if b.1 != true { panic(108681); };
    let c = ecs_rce_try_register(g, 3, 1);
    g = c.0;
    if c.1 != false { panic(108682); };
    if ecs_rce_is_cyclic(c.2) != true { panic(108683); };
    if ecs_rce_a(c.2) != 3 { panic(108684); };
    if ecs_rce_b(c.2) != 1 { panic(108685); };
    if ecs_rce_node_contains(g, 3, 1) != false { panic(108686); };
}

@test "try_register_archetype_exists_blocks"() {
    let g = ecs_rce_graph_new();
    g = ecs_rce_graph_set_archetype(g, 5);
    if ecs_rce_graph_archetype_exists(g, 5) != true { panic(108690); };
    let r = ecs_rce_try_register(g, 5, 6);
    if r.1 != false { panic(108691); };
    if ecs_rce_is_archetype_exists(r.2) != true { panic(108692); };
    if ecs_rce_a(r.2) != 5 { panic(108693); };
    if ecs_rce_node_len(r.0, 5) != 0 { panic(108694); };
}

@test "try_register_order_archetype_before_cycle"() {
    // requiree has archetype and required would also cycle if checked later
    let g = ecs_rce_graph_new();
    // 2 requires 1 already, so 1 requiring 2 is a cycle; but archetype on 1 wins
    let a = ecs_rce_try_register(g, 2, 1);
    g = a.0;
    g = ecs_rce_graph_set_archetype(g, 1);
    let r = ecs_rce_try_register(g, 1, 2);
    if r.1 != false { panic(108700); };
    if ecs_rce_is_archetype_exists(r.2) != true { panic(108701); };
    if ecs_rce_is_cyclic(r.2) != false { panic(108702); };
}

@test "try_register_order_cycle_before_duplicate"() {
    // After 1->2 and 2->1 blocked as cycle, re-registering existing direct is duplicate only when no cycle
    let g = ecs_rce_graph_new();
    let a = ecs_rce_try_register(g, 1, 2);
    g = a.0;
    // self cycle on existing edge path: required reaches requiree via 2->? no, for duplicate of 1->2
    // first make a cycle candidate separate: 3->3 is cycle not duplicate
    let c = ecs_rce_try_register(g, 3, 3);
    if ecs_rce_is_cyclic(c.2) != true { panic(108710); };
    // duplicate on 1->2
    let d = ecs_rce_try_register(g, 1, 2);
    if ecs_rce_is_duplicate(d.2) != true { panic(108711); };
}

@test "reaches_direct_and_transitive"() {
    let g = ecs_rce_graph_new();
    let a = ecs_rce_try_register(g, 1, 2);
    g = a.0;
    let b = ecs_rce_try_register(g, 2, 3);
    g = b.0;
    if ecs_rce_reaches(g, 1, 1, 0) != true { panic(108720); };
    if ecs_rce_reaches(g, 1, 2, 0) != true { panic(108721); };
    if ecs_rce_reaches(g, 1, 3, 0) != true { panic(108722); };
    if ecs_rce_reaches(g, 2, 1, 0) != false { panic(108723); };
    if ecs_rce_reaches(g, 3, 1, 0) != false { panic(108724); };
}

@test "multi_direct_requirements_and_indirect_ok"() {
    // Bevy allows indirect overlap: 1->2 and 1->3, with 2->3 also ok
    let g = ecs_rce_graph_new();
    let a = ecs_rce_try_register(g, 1, 2);
    g = a.0;
    let b = ecs_rce_try_register(g, 1, 3);
    g = b.0;
    if b.1 != true { panic(108730); };
    let c = ecs_rce_try_register(g, 2, 3);
    g = c.0;
    if c.1 != true { panic(108731); };
    if ecs_rce_node_len(g, 1) != 2 { panic(108732); };
    if ecs_rce_node_contains(g, 1, 2) != true { panic(108733); };
    if ecs_rce_node_contains(g, 1, 3) != true { panic(108734); };
    if ecs_rce_reaches(g, 1, 3, 0) != true { panic(108735); };
}

@test "archetype_mask_idempotent"() {
    let g = ecs_rce_graph_new();
    g = ecs_rce_graph_set_archetype(g, 8);
    g = ecs_rce_graph_set_archetype(g, 8);
    if ecs_rce_graph_archetype_exists(g, 8) != true { panic(108740); };
    if ecs_rce_graph_archetype_exists(g, 7) != false { panic(108741); };
    // other nodes still registerable
    let r = ecs_rce_try_register(g, 7, 8);
    if r.1 != true { panic(108742); };
}
