@import "lib/schedule_node_sets.sla"

// Isolated tests for lib/schedule_node_sets.sla — Systems extensions + SystemSets + ConflictingSystems
// Bevy reference: bevy_ecs/src/schedule/node.rs

@test "systems_ext_new_empty"() {
    let s = ecs_systems_ext_new();
    if ecs_systems_ext_len(s) != 0 { panic(90036); };
    if ecs_systems_ext_is_empty(s) != true { panic(90037); };
    if ecs_systems_ext_is_initialized(s) != true { panic(90038); };
    if ecs_systems_ext_uninit_count(s) != 0 { panic(90039); };
}

@test "systems_ext_insert"() {
    let s = ecs_systems_ext_new();
    let sys = ecs_systems_ext_entry(10, 100, false);
    let r = ecs_systems_ext_insert(s, sys);
    let s2 = r.0;
    let key = r.1;
    if key != 0 { panic(90040); };
    if ecs_systems_ext_len(s2) != 1 { panic(90041); };
    if ecs_systems_ext_is_empty(s2) != false { panic(90042); };
    if ecs_systems_ext_is_initialized(s2) != false { panic(90043); };
    if ecs_systems_ext_uninit_count(s2) != 1 { panic(90044); };
}

@test "systems_ext_insert_and_get"() {
    let s = ecs_systems_ext_new();
    let sys = ecs_systems_ext_entry(42, 7, true);
    let r = ecs_systems_ext_insert(s, sys);
    let g = ecs_systems_ext_get(r.0, r.1);
    let g1 = g.1;
    if g.0 != true { panic(90045); };
    if g1.system_id != 42 { panic(90046); };
    if g1.is_exclusive != true { panic(90047); };
}

@test "systems_ext_get_mut_and_set"() {
    let s = ecs_systems_ext_new();
    let sys = ecs_systems_ext_entry(1, 2, false);
    let r = ecs_systems_ext_insert(s, sys);
    let mut_s = ecs_systems_ext_get_mut(r.0, r.1);
    if mut_s.0 != true { panic(90048); };
    let read = mut_s.2;
    let updated = ecs_systems_ext_entry(read.system_id, read.system_name, true);
    let s2 = ecs_systems_ext_set_system(mut_s.1, r.1, updated);
    let g = ecs_systems_ext_get(s2, r.1);
    let g1 = g.1;
    if g1.is_exclusive != true { panic(90049); };
}

@test "systems_ext_get_out_of_range"() {
    let s = ecs_systems_ext_new();
    let g = ecs_systems_ext_get(s, 999);
    if g.0 != false { panic(90050); };
    let gm = ecs_systems_ext_get_mut(s, 999);
    if gm.0 != false { panic(90051); };
}

@test "systems_ext_conditions"() {
    let s = ecs_systems_ext_new();
    let sys = ecs_systems_ext_entry(5, 3, false);
    let r = ecs_systems_ext_insert(s, sys);
    if ecs_systems_ext_has_conditions(r.0, r.1) != false { panic(90052); };
    if ecs_systems_ext_condition_count(r.0, r.1) != 0 { panic(90053); };
    let cond = ecs_node_set_cond_new(88);
    let s2 = ecs_systems_ext_add_condition(r.0, r.1, cond);
    if ecs_systems_ext_has_conditions(s2, r.1) != true { panic(90054); };
    if ecs_systems_ext_condition_count(s2, r.1) != 1 { panic(90055); };
    let gc = ecs_systems_ext_get_conditions(s2, r.1);
    if gc.0 != true { panic(90056); };
    if (len(gc.1) as i64) != 1 { panic(90057); };
}

@test "systems_ext_get_conditions_mut"() {
    let s = ecs_systems_ext_new();
    let sys = ecs_systems_ext_entry(5, 3, false);
    let r = ecs_systems_ext_insert(s, sys);
    let cond = ecs_node_set_cond_new(1);
    let s2 = ecs_systems_ext_add_condition(r.0, r.1, cond);
    let gcm = ecs_systems_ext_get_conditions_mut(s2, r.1);
    if gcm.0 != true { panic(90058); };
    if ecs_systems_ext_condition_count(gcm.1, r.1) != 1 { panic(90059); };
    let oor = ecs_systems_ext_get_conditions_mut(s2, 999);
    if oor.0 != false { panic(90060); };
}

@test "systems_ext_iter"() {
    let s = ecs_systems_ext_new();
    let i = 0;
    while i < 3 {
        let sys = ecs_systems_ext_entry(i * 10, i + 100, false);
        let r = ecs_systems_ext_insert(s, sys);
        s = r.0;
        i = i + 1;
    }
    if ecs_systems_ext_len(s) != 3 { panic(90061); };
    let keys = ecs_systems_ext_iter_keys(s);
    if (len(keys) as i64) != 3 { panic(90062); };
    if keys[0] != 0 { panic(90063); };
    if keys[2] != 2 { panic(90064); };
    let ids = ecs_systems_ext_iter_system_ids(s);
    if ids[0] != 0 { panic(90065); };
    if ids[1] != 10 { panic(90066); };
    if ids[2] != 20 { panic(90067); };
    let counts = ecs_systems_ext_iter_condition_counts(s);
    if counts[0] != 0 { panic(90068); };
}

@test "systems_ext_remove"() {
    let s = ecs_systems_ext_new();
    let sys = ecs_systems_ext_entry(7, 1, false);
    let r = ecs_systems_ext_insert(s, sys);
    let rr = ecs_systems_ext_remove(r.0, r.1);
    if rr.1 != true { panic(90069); };
    // After removal the entry exists but is blanked
    let g = ecs_systems_ext_get(rr.0, r.1);
    let g1 = g.1;
    if g.0 != true { panic(90070); };
    if g1.system_id != 0 { panic(90071); };
    // Removing an out-of-range key returns false
    let rr2 = ecs_systems_ext_remove(rr.0, 999);
    if rr2.1 != false { panic(90072); };
}

@test "systems_ext_initialize"() {
    let s = ecs_systems_ext_new();
    let s2 = ecs_systems_ext_insert(s, ecs_systems_ext_entry(1, 1, false)).0;
    let s3 = ecs_systems_ext_insert(s2, ecs_systems_ext_entry(2, 2, false)).0;
    if ecs_systems_ext_is_initialized(s3) != false { panic(90073); };
    let s4 = ecs_systems_ext_initialize(s3);
    if ecs_systems_ext_is_initialized(s4) != true { panic(90074); };
    if ecs_systems_ext_uninit_count(s4) != 0 { panic(90075); };
}

@test "conflicting_systems_new"() {
    let c = ecs_conflicting_systems_new();
    if ecs_conflicting_systems_len(c) != 0 { panic(90076); };
    if ecs_conflicting_systems_is_empty(c) != true { panic(90077); };
    if ecs_conflicting_systems_check_if_not_empty(c) != 0 { panic(90078); };
}

@test "conflicting_systems_push"() {
    let c = ecs_conflicting_systems_new();
    let conflict = ecs_node_set_conflict_new(1, 2, Vec::new());
    let c2 = ecs_conflicting_systems_push(c, conflict);
    if ecs_conflicting_systems_len(c2) != 1 { panic(90079); };
    if ecs_conflicting_systems_is_empty(c2) != false { panic(90080); };
    if ecs_conflicting_systems_check_if_not_empty(c2) != 1 { panic(90081); };
    let g = ecs_conflicting_systems_get(c2, 0);
    if ecs_conflicting_systems_a(g) != 1 { panic(90082); };
    if ecs_conflicting_systems_b(g) != 2 { panic(90083); };
    if ecs_conflicting_systems_conflict_count(g) != 0 { panic(90084); };
}

@test "conflicting_systems_with_components"() {
    let c = ecs_conflicting_systems_new();
    let comps = Vec::new();
    comps.push(10);
    comps.push(20);
    let conflict = ecs_node_set_conflict_new(3, 4, comps);
    let c2 = ecs_conflicting_systems_push(c, conflict);
    let g = ecs_conflicting_systems_get(c2, 0);
    if ecs_conflicting_systems_conflict_count(g) != 2 { panic(90085); };
    let comps2 = ecs_conflicting_systems_conflicts(g);
    if comps2[0] != 10 { panic(90086); };
    if comps2[1] != 20 { panic(90087); };
}

@test "system_access_compatible_basic"() {
    let a = ecs_system_access_new();
    let b = ecs_system_access_new();
    if ecs_system_access_is_compatible(a, b) != true { panic(90088); };
}

@test "system_access_incompatible_write_write"() {
    let a = ecs_system_access_new();
    let a2 = ecs_system_access_add_write(a, 5);
    let b = ecs_system_access_new();
    let b2 = ecs_system_access_add_write(b, 5);
    if ecs_system_access_is_compatible(a2, b2) != false { panic(90089); };
}

@test "system_access_incompatible_write_read"() {
    let a = ecs_system_access_new();
    let a2 = ecs_system_access_add_write(a, 7);
    let b = ecs_system_access_new();
    let b2 = ecs_system_access_add_read(b, 7);
    if ecs_system_access_is_compatible(a2, b2) != false { panic(90090); };
}

@test "system_access_reads_all_conflict"() {
    let a = ecs_system_access_new();
    let a2 = ecs_system_access_set_reads_all(a);
    let b = ecs_system_access_new();
    let b2 = ecs_system_access_set_writes_all(b);
    if ecs_system_access_is_compatible(a2, b2) != false { panic(90091); };
}

@test "system_access_get_conflicts_individual"() {
    let a = ecs_system_access_new();
    let a2 = ecs_system_access_add_write(a, 3);
    let a3 = ecs_system_access_add_write(a2, 5);
    let b = ecs_system_access_new();
    let b2 = ecs_system_access_add_read(b, 5);
    let g = ecs_system_access_get_conflicts(a3, b2);
    if g.0 != true { panic(90092); };
    if (len(g.1) as i64) != 1 { panic(90093); };
    if g.1[0] != 5 { panic(90094); };
}

@test "system_access_get_conflicts_all"() {
    let a = ecs_system_access_new();
    let a2 = ecs_system_access_set_writes_all(a);
    let b = ecs_system_access_new();
    let b2 = ecs_system_access_set_writes_all(b);
    let g = ecs_system_access_get_conflicts(a2, b2);
    if g.0 != false { panic(90095); };
    if (len(g.1) as i64) != 0 { panic(90096); };
}

@test "system_sets_new_empty"() {
    let s = ecs_system_sets_new();
    if ecs_system_sets_len(s) != 0 { panic(90097); };
    if ecs_system_sets_is_empty(s) != true { panic(90098); };
    if ecs_system_sets_is_initialized(s) != true { panic(90099); };
    if ecs_system_sets_uninit_count(s) != 0 { panic(90100); };
}

@test "system_sets_get_key_or_insert"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 42);
    let s2 = r.0;
    let key = r.1;
    if key != 0 { panic(90101); };
    if ecs_system_sets_len(s2) != 1 { panic(90102); };
    if ecs_system_sets_contains(s2, 42) != true { panic(90103); };
    // Same set_id returns same key, no new entry
    let r2 = ecs_system_sets_get_key_or_insert(s2, 42);
    if r2.1 != 0 { panic(90104); };
    if ecs_system_sets_len(r2.0) != 1 { panic(90105); };
    // Different set_id gets key 1
    let r3 = ecs_system_sets_get_key_or_insert(r2.0, 7);
    if r3.1 != 1 { panic(90106); };
    if ecs_system_sets_len(r3.0) != 2 { panic(90107); };
}

@test "system_sets_get_key"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 11);
    let k = ecs_system_sets_get_key(r.0, 11);
    if k != 0 { panic(90108); };
    let missing = ecs_system_sets_get_key(r.0, 999);
    if missing != -1 { panic(90109); };
}

@test "system_sets_get"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 33);
    let g = ecs_system_sets_get(r.0, r.1);
    let g1 = g.1;
    if g.0 != true { panic(90110); };
    if g1.set_id != 33 { panic(90111); };
    let bad = ecs_system_sets_get(r.0, 999);
    if bad.0 != false { panic(90112); };
}

@test "system_sets_conditions"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 5);
    let s2 = r.0;
    let key = r.1;
    if ecs_system_sets_has_conditions(s2, key) != false { panic(90113); };
    let cond = ecs_node_set_cond_new(99);
    let s3 = ecs_system_sets_add_condition(s2, key, cond);
    if ecs_system_sets_has_conditions(s3, key) != true { panic(90114); };
    let gc = ecs_system_sets_get_conditions(s3, key);
    if gc.0 != true { panic(90115); };
    if (len(gc.1) as i64) != 1 { panic(90116); };
    let gcm = ecs_system_sets_get_conditions_mut(s3, key);
    if gcm.0 != true { panic(90117); };
    // Adding a condition schedules uninit entry
    if ecs_system_sets_uninit_count(s3) != 1 { panic(90118); };
    if ecs_system_sets_is_initialized(s3) != false { panic(90119); };
}

@test "system_sets_initialize"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 1);
    let cond = ecs_node_set_cond_new(2);
    let s2 = ecs_system_sets_add_condition(r.0, r.1, cond);
    if ecs_system_sets_is_initialized(s2) != false { panic(90120); };
    let s3 = ecs_system_sets_initialize(s2);
    if ecs_system_sets_is_initialized(s3) != true { panic(90121); };
    if ecs_system_sets_uninit_count(s3) != 0 { panic(90122); };
}

@test "system_sets_iter"() {
    let s = ecs_system_sets_new();
    let i = 0;
    while i < 2 {
        let r = ecs_system_sets_get_key_or_insert(s, i + 100);
        s = r.0;
        i = i + 1;
    }
    let keys = ecs_system_sets_iter_keys(s);
    if (len(keys) as i64) != 2 { panic(90123); };
    let ids = ecs_system_sets_iter_set_ids(s);
    if ids[0] != 100 { panic(90124); };
    if ids[1] != 101 { panic(90125); };
}

@test "system_sets_remove"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 8);
    let rr = ecs_system_sets_remove(r.0, r.1);
    if rr.1 != true { panic(90126); };
    // entry blanked
    let g = ecs_system_sets_get(rr.0, r.1);
    let g1 = g.1;
    if g1.set_id != 0 { panic(90127); };
    let oor = ecs_system_sets_remove(rr.0, 999);
    if oor.1 != false { panic(90128); };
}

@test "system_sets_check_type_set_ambiguity_ok"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 1);
    let s2 = ecs_system_sets_set_is_system_type(r.0, r.1, true);
    let instances = Vec::new();
    instances.push(1);
    let relations = Vec::new();
    relations.push(0);
    let err = ecs_system_sets_check_type_set_ambiguity(s2, instances, relations);
    if err != 0 { panic(90129); };
}

@test "system_sets_check_type_set_ambiguity_err"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 1);
    let s2 = ecs_system_sets_set_is_system_type(r.0, r.1, true);
    let instances = Vec::new();
    instances.push(3);
    let relations = Vec::new();
    relations.push(2);
    let err = ecs_system_sets_check_type_set_ambiguity(s2, instances, relations);
    if err != 1 { panic(90130); };
}

@test "system_sets_check_type_set_ambiguity_skip_non_type"() {
    let s = ecs_system_sets_new();
    let r = ecs_system_sets_get_key_or_insert(s, 1);
    // not system type
    let instances = Vec::new();
    instances.push(5);
    let relations = Vec::new();
    relations.push(5);
    let err = ecs_system_sets_check_type_set_ambiguity(r.0, instances, relations);
    if err != 0 { panic(90131); };
}

@test "ambiguous_warning_new"() {
    let c = ecs_conflicting_systems_new();
    let conflict = ecs_node_set_conflict_new(1, 2, Vec::new());
    let c2 = ecs_conflicting_systems_push(c, conflict);
    let w = ecs_ambiguous_warning_new(c2);
    if ecs_ambiguous_warning_len(w) != 1 { panic(90132); };
    if ecs_ambiguous_warning_is_empty(w) != false { panic(90133); };
    let g = ecs_ambiguous_warning_get(w, 0);
    if ecs_conflicting_systems_a(g) != 1 { panic(90134); };
}

@test "system_type_set_ambiguity_error"() {
    let e = ecs_system_type_set_ambiguity_error_new(42);
    if ecs_system_type_set_ambiguity_error_key(e) != 42 { panic(90135); };
}
