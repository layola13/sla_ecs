// Isolated deep tests for lib/required_components_dynamic_deep.sla (Batch 395).
// Mirrors required-components dynamic registration helpers with fixed-cap slot families.
// panic codes: 143900 - 143963 (Batch 395 band; previous Batch 394 used 143800-143872).

@import "lib/required_components_dynamic_deep.sla"

fn mr_r(m: EcsReqDynMutResultDeep) -> EcsRequiredComponentsDynDeep { return ecs_rcd_mut_required(m); }
fn mr_res(m: EcsReqDynMutResultDeep) -> EcsReqDynResultDeep { return ecs_rcd_mut_result(m); }

@test "EcsRequiredComponentsDynDeep register_dynamic_with reports success and lengths"() {
    let r0 = ecs_rcd_new();
    let m1 = ecs_rcd_register_dynamic_with_result(r0, 11, 1000);
    let r1 = mr_r(m1);
    let res1 = mr_res(m1);
    if ecs_rcd_result_ok(res1) != 1 { panic(143900); };
    if ecs_rcd_result_direct_len(res1) != 1 { panic(143901); };
    if ecs_rcd_result_all_len(res1) != 1 { panic(143902); };
    if ecs_rcd_direct_at(r1, 0) != 11 { panic(143903); };
    if ecs_rcd_all_at(r1, 0) != 11 { panic(143904); };
}

@test "EcsRequiredComponentsDynDeep duplicate direct registration returns error without mutation"() {
    let r0 = ecs_rcd_new();
    let r1 = ecs_rcd_register_dynamic_with_mut(r0, 21, 1000);
    let m2 = ecs_rcd_register_dynamic_with_result(r1, 21, 2000);
    let r2 = mr_r(m2);
    let res2 = mr_res(m2);
    if ecs_rcd_result_ok(res2) != 0 { panic(143910); };
    if ecs_rcd_result_err_kind(res2) != ecs_rcd_err_dup_kind() { panic(143911); };
    if ecs_rcd_direct_count(r2) != 1 { panic(143912); };
    if ecs_rcd_all_count(r2) != 1 { panic(143913); };
    if ecs_rcd_direct_at(r2, 0) != 21 { panic(143914); };
}

@test "EcsRequiredComponentsDynDeep all ids are prepended in depth-first order"() {
    let r0 = ecs_rcd_new();
    let r1 = ecs_rcd_register_dynamic_with_mut(r0, 31, 1000);
    let r2 = ecs_rcd_register_dynamic_with_mut(r1, 32, 1001);
    let r3 = ecs_rcd_register_by_id_mut(r2, 33, 1002);
    if ecs_rcd_direct_count(r3) != 3 { panic(143920); };
    if ecs_rcd_direct_at(r3, 0) != 31 { panic(143921); };
    if ecs_rcd_direct_at(r3, 1) != 32 { panic(143922); };
    if ecs_rcd_direct_at(r3, 2) != 33 { panic(143923); };
    if ecs_rcd_all_count(r3) != 3 { panic(143924); };
    if ecs_rcd_all_at(r3, 0) != 33 { panic(143925); };
    if ecs_rcd_all_at(r3, 1) != 32 { panic(143926); };
    if ecs_rcd_all_at(r3, 2) != 31 { panic(143927); };
    if ecs_rcd_iter_nth(r3, 1) != 32 { panic(143928); };
}

@test "EcsRequiredComponentsRegistratorDynDeep facade records target and components accessor"() {
    let reg0 = ecs_rcd_registrator_new(100);
    if ecs_rcd_registrator_target(reg0) != 100 { panic(143930); };
    if ecs_rcd_registrator_components_next_id(reg0) != 100 { panic(143931); };
    let reg1 = ecs_rcd_registrator_register_required_by_id(reg0, 201, 3001);
    if ecs_rcd_registrator_last_ok(reg1) != 1 { panic(143932); };
    if ecs_rcd_registrator_required_direct_count(reg1) != 1 { panic(143933); };
    if ecs_rcd_registrator_required_all_at(reg1, 0) != 201 { panic(143934); };
}

@test "EcsRequiredComponentsRegistratorDynDeep dynamic_with duplicate records last error"() {
    let reg0 = ecs_rcd_registrator_new(100);
    let reg1 = ecs_rcd_registrator_register_required_dynamic_with(reg0, 301, 4001);
    let reg2 = ecs_rcd_registrator_register_required_dynamic_with(reg1, 301, 4002);
    if ecs_rcd_registrator_last_ok(reg2) != 0 { panic(143940); };
    if ecs_rcd_registrator_last_err_kind(reg2) != ecs_rcd_err_dup_kind() { panic(143941); };
    if ecs_rcd_registrator_required_direct_count(reg2) != 1 { panic(143942); };
    if ecs_rcd_registrator_required_all_count(reg2) != 1 { panic(143943); };
}

@test "EcsRequiredComponentsDynDeep out-of-range accessors return minus one"() {
    let r0 = ecs_rcd_new();
    let r1 = ecs_rcd_register_by_id_mut(r0, 401, 5001);
    if ecs_rcd_direct_at(r1, -1) != -1 { panic(143950); };
    if ecs_rcd_direct_at(r1, 1) != -1 { panic(143951); };
    if ecs_rcd_all_at(r1, 1) != -1 { panic(143952); };
}

@test "EcsRequiredComponentsDynDeep cap rejects seventeenth unique registration"() {
    let r = ecs_rcd_new();
    let i: i32 = 0;
    while i < 16 {
        r = ecs_rcd_register_dynamic_with_mut(r, 500 + i, 9000 + i);
        i = i + 1;
    }
    if ecs_rcd_direct_count(r) != 16 { panic(143960); };
    if ecs_rcd_all_count(r) != 16 { panic(143961); };
    let overflow = ecs_rcd_register_dynamic_with_result(r, 999, 9999);
    let res = mr_res(overflow);
    if ecs_rcd_result_ok(res) != 0 { panic(143962); };
    if ecs_rcd_direct_count(mr_r(overflow)) != 16 { panic(143963); };
}
