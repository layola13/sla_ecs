@import "lib/filtered_resource_deep.sla"

// Batch 274: filtered_resource deep (src/world/filtered_resource.rs).
// panic codes: 120800 – 120999.

@test "access_read_write_bits"() {
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_read(a, 1);
    if ecs_fr_access_deep_has_read(a, 1) != true { panic(120800); };
    if ecs_fr_access_deep_has_write(a, 1) != false { panic(120801); };
    a = ecs_fr_access_deep_add_write(a, 2);
    if ecs_fr_access_deep_has_write(a, 2) != true { panic(120802); };
    if ecs_fr_access_deep_has_read(a, 2) != true { panic(120803); };
}

@test "get_not_registered"() {
    let w = ecs_fr_world_deep_new();
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_read(a, 1);
    let f = ecs_fr_deep_new(w, a);
    let g = ecs_fr_deep_get(f, 1);
    if ecs_fr_get_ok(g) != false { panic(120810); };
    if ecs_fr_get_err(g) != 1 { panic(120811); };
}

@test "get_no_resource_access"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 3, 10, true);
    let a = ecs_fr_access_deep_new();
    let f = ecs_fr_deep_new(w, a);
    let g = ecs_fr_deep_get(f, 3);
    if ecs_fr_get_ok(g) != false { panic(120820); };
    if ecs_fr_get_err(g) != 3 { panic(120821); };
}

@test "get_does_not_exist"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_register(w, 4, true);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_read(a, 4);
    let f = ecs_fr_deep_new(w, a);
    let g = ecs_fr_deep_get(f, 4);
    if ecs_fr_get_ok(g) != false { panic(120830); };
    if ecs_fr_get_err(g) != 2 { panic(120831); };
}

@test "get_success_and_by_id"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 5, 55, true);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_read(a, 5);
    let f = ecs_fr_deep_new(w, a);
    let g = ecs_fr_deep_get(f, 5);
    if ecs_fr_get_ok(g) != true { panic(120840); };
    if ecs_fr_get_value(g) != 55 { panic(120841); };
    let g2 = ecs_fr_deep_get_by_id(f, 5);
    if ecs_fr_get_value(g2) != 55 { panic(120842); };
}

@test "mut_get_mut_requires_write"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 6, 1, true);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_read(a, 6);
    let f = ecs_fr_mut_deep_new(w, a);
    let g = ecs_fr_mut_deep_get_mut(f, 6);
    if ecs_fr_get_ok(g) != false { panic(120850); };
    if ecs_fr_get_err(g) != 3 { panic(120851); };
    a = ecs_fr_access_deep_add_write(a, 6);
    f = ecs_fr_mut_deep_new(w, a);
    let g2 = ecs_fr_mut_deep_get_mut(f, 6);
    if ecs_fr_get_ok(g2) != true { panic(120852); };
}

@test "mut_immutable_resource"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 7, 9, false);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_write(a, 7);
    let f = ecs_fr_mut_deep_new(w, a);
    let g = ecs_fr_mut_deep_get_mut(f, 7);
    if ecs_fr_get_ok(g) != false { panic(120860); };
    if ecs_fr_get_err(g) != 4 { panic(120861); };
}

@test "mut_set_updates_value"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 8, 1, true);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_write(a, 8);
    let f = ecs_fr_mut_deep_new(w, a);
    let sr = ecs_fr_mut_deep_set(f, 8, 88);
    if ecs_fr_set_ok(sr) != true { panic(120870); };
    f = ecs_fr_set_view(sr);
    let g = ecs_fr_mut_deep_get(f, 8);
    if ecs_fr_get_value(g) != 88 { panic(120871); };
}

@test "as_readonly_and_reborrow"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 1, 11, true);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_add_write(a, 1);
    let f = ecs_fr_mut_deep_new(w, a);
    let ro = ecs_fr_mut_deep_as_readonly(f);
    let g = ecs_fr_deep_get(ro, 1);
    if ecs_fr_get_value(g) != 11 { panic(120880); };
    let f2 = ecs_fr_mut_deep_reborrow(f);
    if ecs_fr_mut_deep_has_write(f2, 1) != true { panic(120881); };
}

@test "read_all_and_into_mut"() {
    let w = ecs_fr_world_deep_new();
    w = ecs_fr_world_deep_insert(w, 2, 22, true);
    let a = ecs_fr_access_deep_new();
    a = ecs_fr_access_deep_read_all(a);
    a = ecs_fr_access_deep_write_all(a);
    let f = ecs_fr_mut_deep_new(w, a);
    if ecs_fr_mut_deep_has_read(f, 99) != true { panic(120890); };
    let im = ecs_fr_mut_deep_into_mut(f, 2);
    if ecs_fr_get_ok(im) != true { panic(120891); };
    if ecs_fr_get_value(im) != 22 { panic(120892); };
}
