@import "lib/world_extras.sla"

// Isolated tests for lib/world_extras.sla — required-component try/register-by-id + modify_component/resource +
// spawn_at/empty_at/batch + World accessor facades. Bevy reference: src/world/mod.rs.

@test "req_err_dup_kind_and_ids"() {
    let e = ecs_req_err_kind(0, 5, 7);
    if ecs_req_result_kind(e) != 0 { panic(91171); };
    if ecs_req_result_a(e) != 5 { panic(91172); };
    if ecs_req_result_b(e) != 7 { panic(91173); };
}

@test "req_err_cyclic_kind"() {
    let e = ecs_req_err_kind(1, 3, 9);
    if ecs_req_result_kind(e) != 1 { panic(91174); };
    if !ecs_req_result_is_cyclic(e) { panic(91175); };
}

@test "req_err_archetype_exists_kind"() {
    let e = ecs_req_err_kind(2, 11, 0);
    if ecs_req_result_kind(e) != 2 { panic(91176); };
    if !ecs_req_result_is_archetype_exists(e) { panic(91177); };
}

@test "spawn_err_variant_codes"() {
    if ecs_spawn_err_invalid() != 0 { panic(91178); };
    if ecs_spawn_err_already_spawned() != 1 { panic(91179); };
    if !ecs_spawn_err_is_invalid(ecs_spawn_err_invalid()) { panic(91180); };
    if !ecs_spawn_err_is_already_spawned(ecs_spawn_err_already_spawned()) { panic(91181); };
}

@test "entity_fetch_err_variant_codes"() {
    if ecs_entity_fetch_err_not_spawned() != 0 { panic(91182); };
    if ecs_entity_fetch_err_aliased_mutability() != 1 { panic(91183); };
    if !ecs_entity_fetch_err_is_not_spawned(0) { panic(91184); };
    if !ecs_entity_fetch_err_is_aliased(1) { panic(91185); };
}

@test "req_registry_new_empty"() {
    let r = ecs_world_req_registry_new();
    let q = ecs_world_req_registry_get_required_by_id(r, 1);
    if ecs_req_query_found(q) { panic(91186); };
    if ecs_req_query_count(q) != 0 { panic(91187); };
}

@test "req_registry_try_register_default_ok"() {
    let r = ecs_world_req_registry_new();
    let res = ecs_world_req_registry_try_register(r, 1, 2);
    let result = ecs_register_result_result(res);
    if ecs_req_result_ok(result) != 1 { panic(91188); };
    let r2 = ecs_register_result_registry(res);
    let q = ecs_world_req_registry_get_required_by_id(r2, 1);
    if !ecs_req_query_found(q) { panic(91189); };
    if ecs_req_query_count(q) != 1 { panic(91190); };
}

@test "req_registry_try_register_with_custom_ctor"() {
    let r = ecs_world_req_registry_new();
    let res = ecs_world_req_registry_try_register_with(r, 1, 2, 42);
    let r2 = ecs_register_result_registry(res);
    let result = ecs_register_result_result(res);
    if ecs_req_result_ok(result) != 1 { panic(91191); };
    let nth = ecs_world_req_registry_get_required_nth(r2, 1, 0);
    if !ecs_req_nth_found(nth) { panic(91192); };
    if ecs_req_nth_required_id(nth) != 2 { panic(91193); };
    if ecs_req_nth_constructor_id(nth) != 42 { panic(91194); };
}

@test "req_registry_duplicate_registration_errors"() {
    let r = ecs_world_req_registry_new();
    let res1 = ecs_world_req_registry_try_register(r, 1, 2);
    let r2 = ecs_register_result_registry(res1);
    let res2 = ecs_world_req_registry_try_register(r2, 1, 2);
    let result = ecs_register_result_result(res2);
    if ecs_req_result_ok(result) != 0 { panic(91195); };
    if !ecs_req_result_is_dup(result) { panic(91196); };
    if ecs_req_result_a(result) != 1 { panic(91197); };
    if ecs_req_result_b(result) != 2 { panic(91198); };
}

@test "req_registry_archetype_exists_errors"() {
    let r = ecs_world_req_registry_new();
    let r2 = ecs_world_req_registry_mark_archetyped(r, 5);
    let res = ecs_world_req_registry_try_register(r2, 5, 9);
    let result = ecs_register_result_result(res);
    if ecs_req_result_ok(result) != 0 { panic(91199); };
    if !ecs_req_result_is_archetype_exists(result) { panic(91200); };
    if ecs_req_result_a(result) != 5 { panic(91201); };
}

@test "req_registry_get_required_by_id_multiple"() {
    let r = ecs_world_req_registry_new();
    let res1 = ecs_world_req_registry_try_register(r, 1, 2);
    let r2 = ecs_register_result_registry(res1);
    let res2 = ecs_world_req_registry_try_register(r2, 1, 3);
    let r3 = ecs_register_result_registry(res2);
    let q = ecs_world_req_registry_get_required_by_id(r3, 1);
    if !ecs_req_query_found(q) { panic(91202); };
    if ecs_req_query_count(q) != 2 { panic(91203); };
    let nth0 = ecs_world_req_registry_get_required_nth(r3, 1, 0);
    if ecs_req_nth_required_id(nth0) != 2 { panic(91204); };
    let nth1 = ecs_world_req_registry_get_required_nth(r3, 1, 1);
    if ecs_req_nth_required_id(nth1) != 3 { panic(91205); };
}

@test "entity_allocator_alloc_and_count"() {
    let a = ecs_world_entity_allocator_new();
    let res = ecs_world_entity_allocator_alloc(a);
    let a2 = ecs_world_entity_allocator_alloc_allocator(res);
    if ecs_world_entity_allocator_alloc_idx(res) != 0 { panic(91206); };
    if ecs_world_entity_allocator_alloc_gen(res) != 1 { panic(91207); };
    if ecs_world_entity_allocator_spawned_count(a2) != 1 { panic(91208); };
    if !ecs_world_entity_allocator_is_spawned(a2, 0) { panic(91209); };
}

@test "entity_allocator_free_then_reuse_index"() {
    let a = ecs_world_entity_allocator_new();
    let res = ecs_world_entity_allocator_alloc(a);
    let a2 = ecs_world_entity_allocator_alloc_allocator(res);
    let idx = ecs_world_entity_allocator_alloc_idx(res);
    let a3 = ecs_world_entity_allocator_free(a2, idx);
    if ecs_world_entity_allocator_is_spawned(a3, idx) { panic(91210); };
    if ecs_world_entity_allocator_spawned_count(a3) != 0 { panic(91211); };
    let res2 = ecs_world_entity_allocator_alloc(a3);
    let idx2 = ecs_world_entity_allocator_alloc_idx(res2);
    if idx2 != idx { panic(91212); };
}

@test "entity_allocator_check_can_spawn_at_already_spawned"() {
    let a = ecs_world_entity_allocator_new();
    let res = ecs_world_entity_allocator_alloc(a);
    let a2 = ecs_world_entity_allocator_alloc_allocator(res);
    let code = ecs_world_entity_allocator_check_can_spawn_at(a2, 0);
    if code != ecs_spawn_err_already_spawned() { panic(91213); };
    let code2 = ecs_world_entity_allocator_check_can_spawn_at(a2, 99);
    if code2 != -1 { panic(91214); };
}

@test "resource_entities_insert_get_len"() {
    let re = ecs_world_resource_entities_new();
    let re2 = ecs_world_resource_entities_insert(re, 3, 10);
    let pkg = ecs_world_resource_entities_get(re2, 3);
    if !ecs_world_resource_entities_get_found(pkg) { panic(91215); };
    if ecs_world_resource_entities_get_entity_idx(pkg) != 10 { panic(91216); };
    if ecs_world_resource_entities_len(re2) != 1 { panic(91217); };
}

@test "resource_entities_insert_overwrites"() {
    let re = ecs_world_resource_entities_new();
    let re2 = ecs_world_resource_entities_insert(re, 3, 10);
    let re3 = ecs_world_resource_entities_insert(re2, 3, 20);
    let pkg = ecs_world_resource_entities_get(re3, 3);
    if ecs_world_resource_entities_get_entity_idx(pkg) != 20 { panic(91218); };
    if ecs_world_resource_entities_len(re3) != 1 { panic(91219); };
}

@test "resource_entities_get_missing"() {
    let re = ecs_world_resource_entities_new();
    let pkg = ecs_world_resource_entities_get(re, 99);
    if ecs_world_resource_entities_get_found(pkg) { panic(91220); };
}

@test "spawn_facade_spawn_at_success"() {
    let f = ecs_world_spawn_facade_new();
    let res = ecs_world_spawn_facade_spawn_at(f, 7, 42);
    if ecs_spawn_at_ok(res) != 1 { panic(91221); };
    if ecs_spawn_at_entity_idx(res) != 7 { panic(91222); };
}

@test "spawn_facade_spawn_at_already_spawned"() {
    let f = ecs_world_spawn_facade_new();
    let res1 = ecs_world_spawn_facade_spawn_at(f, 7, 1);
    let f2 = ecs_spawn_at_facade(res1);
    let res2 = ecs_world_spawn_facade_spawn_at(f2, 7, 2);
    if ecs_spawn_at_ok(res2) != 0 { panic(91223); };
    if ecs_spawn_at_error_code(res2) != ecs_spawn_err_already_spawned() { panic(91224); };
}

@test "spawn_facade_spawn_empty_at_success"() {
    let f = ecs_world_spawn_facade_new();
    let res = ecs_world_spawn_facade_spawn_empty_at(f, 3);
    if ecs_spawn_at_ok(res) != 1 { panic(91225); };
    if ecs_spawn_at_entity_idx(res) != 3 { panic(91226); };
}

@test "spawn_facade_spawn_batch_count_and_first"() {
    let f = ecs_world_spawn_facade_new();
    let type_ids = Vec::new();
    type_ids.push(1); type_ids.push(2); type_ids.push(3);
    let res = ecs_world_spawn_facade_spawn_batch(f, type_ids);
    let f2 = ecs_spawn_batch_facade(res);
    if ecs_spawn_batch_count(res) != 3 { panic(91227); };
    if ecs_spawn_batch_first(res) != 0 { panic(91228); };
    if ecs_world_entity_allocator_spawned_count(ecs_world_spawn_facade_allocator(f2)) != 3 { panic(91229); };
}

@test "components_queue_enqueue_at_and_len"() {
    let q = ecs_world_components_queue_new();
    let q2 = ecs_world_components_queue_enqueue(q, 5, 0);
    let q3 = ecs_world_components_queue_enqueue(q2, 6, 1);
    if ecs_world_components_queue_len(q3) != 2 { panic(91230); };
    let at0 = ecs_world_components_queue_at(q3, 0);
    if !ecs_queue_at_found(at0) { panic(91231); };
    if ecs_queue_at_type_id(at0) != 5 { panic(91232); };
    if ecs_queue_at_storage_kind(at0) != 0 { panic(91233); };
    let at1 = ecs_world_components_queue_at(q3, 1);
    if ecs_queue_at_type_id(at1) != 6 { panic(91234); };
    if ecs_queue_at_storage_kind(at1) != 1 { panic(91235); };
}

@test "components_queue_at_out_of_bounds"() {
    let q = ecs_world_components_queue_new();
    let at = ecs_world_components_queue_at(q, 0);
    if ecs_queue_at_found(at) { panic(91236); };
}

@test "components_queue_apply_drains"() {
    let q = ecs_world_components_queue_new();
    let q2 = ecs_world_components_queue_enqueue(q, 5, 0);
    let q3 = ecs_world_components_queue_enqueue(q2, 6, 1);
    let res = ecs_world_components_queue_apply(q3);
    let q4 = ecs_queue_apply_queue(res);
    if ecs_queue_apply_applied(res) != 2 { panic(91237); };
    if ecs_world_components_queue_len(q4) != 0 { panic(91238); };
}

@test "unsafe_cell_new_ptr_and_readonly"() {
    let c = ecs_world_unsafe_cell_new(123);
    if ecs_world_unsafe_cell_ptr(c) != 123 { panic(91239); };
    if ecs_world_unsafe_cell_is_readonly(c) { panic(91240); };
}

@test "unsafe_cell_readonly_flag"() {
    let c = ecs_world_unsafe_cell_readonly(456);
    if ecs_world_unsafe_cell_ptr(c) != 456 { panic(91241); };
    if !ecs_world_unsafe_cell_is_readonly(c) { panic(91242); };
}

@test "modify_component_not_spawned_error"() {
    let f = ecs_world_spawn_facade_new();
    let res = ecs_world_modify_component(f, 5, 1, 0, 99);
    if ecs_modify_ok(res) != 0 { panic(91243); };
    if ecs_modify_error_code(res) != ecs_entity_fetch_err_not_spawned() { panic(91244); };
}

@test "modify_component_success_writeback"() {
    let f = ecs_world_spawn_facade_new();
    let sf = ecs_world_spawn_facade_spawn_at(f, 0, 1);
    let f2 = ecs_spawn_at_facade(sf);
    let res = ecs_world_modify_component(f2, 0, 1, 0, 77);
    if ecs_modify_ok(res) != 1 { panic(91245); };
    if ecs_modify_present(res) != 1 { panic(91246); };
}

@test "modify_component_missing_returns_none"() {
    let f = ecs_world_spawn_facade_new();
    let sf = ecs_world_spawn_facade_spawn_at(f, 0, 1);
    let f2 = ecs_spawn_at_facade(sf);
    let res = ecs_world_modify_component(f2, 0, 2, 0, 77);
    if ecs_modify_ok(res) != 1 { panic(91247); };
    if ecs_modify_present(res) != 0 { panic(91248); };
}

@test "modify_resource_not_registered_returns_none"() {
    let re = ecs_world_resource_entities_new();
    let f = ecs_world_spawn_facade_new();
    let res = ecs_world_modify_resource(re, f, 5, 0, 99);
    if ecs_modify_resource_ok(res) != 1 { panic(91249); };
    if ecs_modify_resource_present(res) != 0 { panic(91250); };
}

@test "modify_resource_registered_writeback"() {
    let re = ecs_world_resource_entities_new();
    let re2 = ecs_world_resource_entities_insert(re, 3, 0);
    let f = ecs_world_spawn_facade_new();
    let sf = ecs_world_spawn_facade_spawn_at(f, 0, 3);
    let f2 = ecs_spawn_at_facade(sf);
    let res = ecs_world_modify_resource(re2, f2, 3, 0, 88);
    if ecs_modify_resource_ok(res) != 1 { panic(91251); };
    if ecs_modify_resource_present(res) != 1 { panic(91252); };
}

@test "modify_component_by_id_equals_modify_component"() {
    let f = ecs_world_spawn_facade_new();
    let sf = ecs_world_spawn_facade_spawn_at(f, 0, 1);
    let f2 = ecs_spawn_at_facade(sf);
    let res = ecs_world_modify_component_by_id(f2, 0, 1, 0, 55);
    if ecs_modify_ok(res) != 1 { panic(91253); };
    if ecs_modify_present(res) != 1 { panic(91254); };
}

@test "modify_resource_by_id_equals_modify_resource"() {
    let re = ecs_world_resource_entities_new();
    let re2 = ecs_world_resource_entities_insert(re, 3, 0);
    let f = ecs_world_spawn_facade_new();
    let sf = ecs_world_spawn_facade_spawn_at(f, 0, 3);
    let f2 = ecs_spawn_at_facade(sf);
    let res = ecs_world_modify_resource_by_id(re2, f2, 3, 0, 66);
    if ecs_modify_resource_ok(res) != 1 { panic(91255); };
    if ecs_modify_resource_present(res) != 1 { panic(91256); };
}

@test "req_registry_next_free_type_id_skips_used"() {
    let r = ecs_world_req_registry_new();
    let used = Vec::new();
    used.push(1); used.push(2);
    let id = ecs_world_req_registry_next_free_type_id(r, used);
    if id != 3 { panic(91257); };
}

@test "req_registry_next_free_type_id_skips_registered"() {
    let r = ecs_world_req_registry_new();
    let r2 = ecs_world_req_registry_register_component(r, 1);
    let id = ecs_world_req_registry_next_free_type_id(r2, Vec::new());
    if id != 2 { panic(91258); };
}
