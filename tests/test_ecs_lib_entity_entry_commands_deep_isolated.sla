@import "lib/entity_entry_commands_deep.sla"

// Batch 282: entity_entry_commands deep (src/system/commands/mod.rs EntityEntryCommands).
// panic codes: 122400 – 122599.

@test "new_and_identity"() {
    let e = ecs_eec_deep_new(10, 3, true, false, 0);
    if ecs_eec_deep_entity(e) != 10 { panic(122400); };
    if ecs_eec_deep_component_id(e) != 3 { panic(122401); };
    if ecs_eec_deep_has_component(e) != false { panic(122402); };
    if ecs_eec_deep_entity_commands(e) != 10 { panic(122403); };
}

@test "or_insert_when_absent"() {
    let e = ecs_eec_deep_new(1, 1, true, false, 0);
    e = ecs_eec_deep_or_insert(e, 42);
    if ecs_eec_deep_has_component(e) != true { panic(122410); };
    if ecs_eec_deep_value(e) != 42 { panic(122411); };
    if ecs_eec_deep_op_len(e) != 1 { panic(122412); };
    if ecs_eec_deep_op_kind_at(e, 0) != 1 { panic(122413); };
}

@test "or_insert_keeps_existing"() {
    let e = ecs_eec_deep_new(1, 1, true, true, 7);
    e = ecs_eec_deep_or_insert(e, 99);
    if ecs_eec_deep_value(e) != 7 { panic(122420); };
    if ecs_eec_deep_has_component(e) != true { panic(122421); };
}

@test "and_modify_only_if_present"() {
    let e = ecs_eec_deep_new(2, 5, true, false, 0);
    e = ecs_eec_deep_and_modify(e, 10);
    if ecs_eec_deep_value(e) != 0 { panic(122430); };
    e = ecs_eec_deep_or_insert(e, 5);
    e = ecs_eec_deep_and_modify(e, 3);
    if ecs_eec_deep_value(e) != 8 { panic(122431); };
    if ecs_eec_deep_op_kind_at(e, 0) != 0 { panic(122432); };
}

@test "or_default_and_from_world"() {
    let e = ecs_eec_deep_new(3, 1, true, false, 0);
    e = ecs_eec_deep_or_default(e);
    if ecs_eec_deep_value(e) != 0 { panic(122440); };
    if ecs_eec_deep_factory_invokes(e) != 1 { panic(122441); };
    let e2 = ecs_eec_deep_new(4, 1, true, false, 0);
    e2 = ecs_eec_deep_or_from_world(e2, 77);
    if ecs_eec_deep_value(e2) != 77 { panic(122442); };
    if ecs_eec_deep_factory_invokes(e2) != 1 { panic(122443); };
    // existing skips factory
    let e3 = ecs_eec_deep_new(5, 1, true, true, 1);
    e3 = ecs_eec_deep_or_default(e3);
    if ecs_eec_deep_factory_invokes(e3) != 0 { panic(122444); };
    if ecs_eec_deep_value(e3) != 1 { panic(122445); };
}

@test "or_insert_with_lazy_factory"() {
    let e = ecs_eec_deep_new(6, 2, true, false, 0);
    e = ecs_eec_deep_or_insert_with(e, 55);
    if ecs_eec_deep_value(e) != 55 { panic(122450); };
    if ecs_eec_deep_factory_invokes(e) != 1 { panic(122451); };
    e = ecs_eec_deep_or_insert_with(e, 66);
    if ecs_eec_deep_value(e) != 55 { panic(122452); };
    if ecs_eec_deep_factory_invokes(e) != 1 { panic(122453); };
}

@test "try_insert_silences_missing_entity"() {
    let e = ecs_eec_deep_new(9, 1, false, false, 0);
    e = ecs_eec_deep_or_try_insert(e, 10);
    if ecs_eec_deep_error_count(e) != 0 { panic(122460); };
    if ecs_eec_deep_has_component(e) != false { panic(122461); };
    e = ecs_eec_deep_or_try_insert_with(e, 11);
    if ecs_eec_deep_error_count(e) != 0 { panic(122462); };
    if ecs_eec_deep_factory_invokes(e) != 0 { panic(122463); };
}

@test "non_try_errors_on_missing_entity"() {
    let e = ecs_eec_deep_new(8, 1, false, false, 0);
    e = ecs_eec_deep_or_insert(e, 1);
    if ecs_eec_deep_error_count(e) != 1 { panic(122470); };
    if ecs_eec_deep_last_error(e) != 1 { panic(122471); };
    e = ecs_eec_deep_or_insert_with(e, 2);
    if ecs_eec_deep_error_count(e) != 2 { panic(122472); };
}

@test "reborrow_and_flush"() {
    let e = ecs_eec_deep_new(7, 1, true, false, 0);
    e = ecs_eec_deep_or_insert(e, 3);
    let r = ecs_eec_deep_reborrow(e);
    if ecs_eec_deep_reborrow_gen(r) != 1 { panic(122480); };
    if ecs_eec_deep_value(r) != 3 { panic(122481); };
    let f = ecs_eec_deep_flush(r);
    if ecs_eec_deep_op_len(f) != 0 { panic(122482); };
    if ecs_eec_deep_value(f) != 3 { panic(122483); };
}

@test "op_log_sequence"() {
    let e = ecs_eec_deep_new(1, 1, true, false, 0);
    e = ecs_eec_deep_or_insert(e, 1);
    e = ecs_eec_deep_and_modify(e, 2);
    e = ecs_eec_deep_or_default(e);
    if ecs_eec_deep_op_len(e) != 3 { panic(122490); };
    if ecs_eec_deep_op_kind_at(e, 0) != ecs_eec_d_op_or_insert() { panic(122491); };
    if ecs_eec_deep_op_kind_at(e, 1) != ecs_eec_d_op_and_modify() { panic(122492); };
    if ecs_eec_deep_op_kind_at(e, 2) != ecs_eec_d_op_or_default() { panic(122493); };
    if ecs_eec_deep_value(e) != 3 { panic(122494); };
}
