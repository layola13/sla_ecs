@import "lib/entity_lifecycle.sla"

// Isolated tests for lib/entity_lifecycle.sla — DefaultQueryFilters + ComponentHooks + RemovedComponents.
// Bevy reference: src/entity_disabling.rs + src/lifecycle.rs

@test "dqf_empty_no_disabling"() {
    let f = ecs_dqf_empty();
    if ecs_dqf_disabling_count(f) != 0 { panic(90796); };
    if ecs_dqf_is_disabling(f, 5) != false { panic(90797); };
    let r = ecs_dqf_disabling_first(f);
    if r.0 != false { panic(90798); };
}

@test "dqf_register_disabling"() {
    let f = ecs_dqf_empty();
    let f2 = ecs_dqf_register_disabling_component(f, 5);
    if ecs_dqf_disabling_count(f2) != 1 { panic(90799); };
    if ecs_dqf_is_disabling(f2, 5) != true { panic(90800); };
    if ecs_dqf_is_disabling(f2, 6) != false { panic(90801); };
}

@test "dqf_disabling_ids_first"() {
    let f = ecs_dqf_empty();
    let f2 = ecs_dqf_register_disabling_component(f, 9);
    let r = ecs_dqf_disabling_first(f2);
    if r.0 != true { panic(90802); };
    if r.1 != 9 { panic(90803); };
}

@test "component_hooks_new_defaults"() {
    let h = ecs_component_hooks_new();
    if ecs_component_hooks_has_on_add(h) != false { panic(90804); };
    if ecs_component_hooks_has_on_insert(h) != false { panic(90805); };
    if ecs_component_hooks_has_on_discard(h) != false { panic(90806); };
    if ecs_component_hooks_has_on_remove(h) != false { panic(90807); };
    if ecs_component_hooks_has_on_despawn(h) != false { panic(90808); };
}

@test "component_hooks_on_add"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_add(h, 101);
    if ecs_component_hooks_has_on_add(h2) != true { panic(90809); };
    if ecs_component_hooks_on_add_id(h2) != 101 { panic(90810); };
}

@test "component_hooks_on_insert"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_insert(h, 102);
    if ecs_component_hooks_on_insert_id(h2) != 102 { panic(90811); };
}

@test "component_hooks_on_discard"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_discard(h, 103);
    if ecs_component_hooks_on_discard_id(h2) != 103 { panic(90812); };
}

@test "component_hooks_on_remove"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_remove(h, 104);
    if ecs_component_hooks_on_remove_id(h2) != 104 { panic(90813); };
}

@test "component_hooks_on_despawn"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_despawn(h, 105);
    if ecs_component_hooks_on_despawn_id(h2) != 105 { panic(90814); };
}

@test "component_hooks_try_on_add_when_empty"() {
    let h = ecs_component_hooks_new();
    let r = ecs_component_hooks_try_on_add(h, 200);
    if r.0 != true { panic(90815); };
    let h2 = r.1;
    if ecs_component_hooks_on_add_id(h2) != 200 { panic(90816); };
}

@test "component_hooks_try_on_add_when_present"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_add(h, 200);
    let r = ecs_component_hooks_try_on_add(h2, 999);
    if r.0 != false { panic(90817); };
}

@test "component_hooks_try_on_insert_when_present"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_insert(h, 50);
    let r = ecs_component_hooks_try_on_insert(h2, 60);
    if r.0 != false { panic(90818); };
}

@test "component_hooks_try_on_discard_when_empty"() {
    let h = ecs_component_hooks_new();
    let r = ecs_component_hooks_try_on_discard(h, 7);
    if r.0 != true { panic(90819); };
}

@test "component_hooks_try_on_remove_when_present"() {
    let h = ecs_component_hooks_new();
    let h2 = ecs_component_hooks_on_remove(h, 7);
    let r = ecs_component_hooks_try_on_remove(h2, 8);
    if r.0 != false { panic(90820); };
}

@test "component_hooks_try_on_despawn_full_set"() {
    let h = ecs_component_hooks_new();
    let r = ecs_component_hooks_try_on_despawn(h, 11);
    if r.0 != true { panic(90821); };
    let h2 = r.1;
    let r2 = ecs_component_hooks_try_on_despawn(h2, 12);
    if r2.0 != false { panic(90822); };
}

@test "removed_components_new_empty"() {
    let r = ecs_removed_components_new(7);
    if ecs_removed_components_component_id(r) != 7 { panic(90823); };
    if ecs_removed_components_len(r) != 0 { panic(90824); };
    if ecs_removed_components_is_empty(r) != true { panic(90825); };
}

@test "removed_components_write_then_len"() {
    let r = ecs_removed_components_new(7);
    let r2 = ecs_removed_components_write(r, 100);
    let r3 = ecs_removed_components_write(r2, 200);
    if ecs_removed_components_len(r3) != 2 { panic(90826); };
    if ecs_removed_components_is_empty(r3) != false { panic(90827); };
}

@test "removed_components_read_first"() {
    let r = ecs_removed_components_new(7);
    let r2 = ecs_removed_components_write(r, 100);
    let r3 = ecs_removed_components_write(r2, 200);
    let res = ecs_removed_components_read(r3);
    if res.0 != true { panic(90828); };
    if res.1 != 100 { panic(90829); };
    if ecs_removed_components_cursor(res.2) != 1 { panic(90830); };
}

@test "removed_components_read_exhausted"() {
    let r = ecs_removed_components_new(7);
    let r2 = ecs_removed_components_write(r, 100);
    let res1 = ecs_removed_components_read(r2);
    if res1.0 != true { panic(90831); };
    let res2 = ecs_removed_components_read(res1.2);
    if res2.0 != false { panic(90832); };
}

@test "removed_components_read_with_id"() {
    let r = ecs_removed_components_new(42);
    let r2 = ecs_removed_components_write(r, 300);
    let res = ecs_removed_components_read_with_id(r2);
    if res.0 != true { panic(90833); };
    if res.1 != 42 { panic(90834); };
    if res.2 != 300 { panic(90835); };
}

@test "removed_components_clear"() {
    let r = ecs_removed_components_new(7);
    let r2 = ecs_removed_components_write(r, 100);
    let r3 = ecs_removed_components_clear(r2);
    if ecs_removed_components_len(r3) != 0 { panic(90836); };
    if ecs_removed_components_cursor(r3) != 0 { panic(90837); };
}

@test "removed_components_reset_cursor"() {
    let r = ecs_removed_components_new(7);
    let r2 = ecs_removed_components_write(r, 100);
    let res = ecs_removed_components_read(r2);
    let r3 = res.2;
    let r4 = ecs_removed_components_reset_cursor(r3);
    if ecs_removed_components_cursor(r4) != 0 { panic(90838); };
}

@test "removed_components_messages"() {
    let r = ecs_removed_components_new(9);
    let r2 = ecs_removed_components_write(r, 1);
    let r3 = ecs_removed_components_write(r2, 2);
    let m = ecs_removed_components_messages(r3);
    if m.0 != true { panic(90839); };
    if m.1 != 2 { panic(90840); };
    if m.2 != 1 { panic(90841); };
}

@test "removed_components_messages_empty"() {
    let r = ecs_removed_components_new(9);
    let m = ecs_removed_components_messages(r);
    if m.0 != false { panic(90842); };
}

@test "removed_components_full_workflow"() {
    let r0 = ecs_removed_components_new(5);
    let r1 = ecs_removed_components_write(r0, 11);
    let r2 = ecs_removed_components_write(r1, 22);
    let r3 = ecs_removed_components_write(r2, 33);
    let rd1 = ecs_removed_components_read(r3);
    if rd1.0 != true { panic(90843); };
    if rd1.1 != 11 { panic(90844); };
    let rd2 = ecs_removed_components_read(rd1.2);
    if rd2.0 != true { panic(90845); };
    if rd2.1 != 22 { panic(90846); };
    let rd3 = ecs_removed_components_read(rd2.2);
    if rd3.0 != true { panic(90847); };
    if rd3.1 != 33 { panic(90848); };
    let rd4 = ecs_removed_components_read(rd3.2);
    if rd4.0 != false { panic(90849); };
}
