@import "lib/component_deep.sla"

// Batch 207: Component core deep (src/component/mod.rs + clone + required + register).

@test "storage_defaults_table"() {
    if ecs_cd_storage_default() != ECS_CD_STORAGE_TABLE { panic(107400); };
    if ecs_cd_storage_is_table(ECS_CD_STORAGE_TABLE) != true { panic(107401); };
    if ecs_cd_storage_is_sparse(ECS_CD_STORAGE_SPARSE) != true { panic(107402); };
}

@test "desc_table_mutable_default"() {
    let d = ecs_cd_desc_default(10, 100);
    if ecs_cd_desc_is_table(d) != true { panic(107410); };
    if ecs_cd_desc_is_mutable(d) != true { panic(107411); };
    if ecs_cd_desc_clone_kind(d) != ECS_CD_CLONE_DEFAULT { panic(107412); };
    if ecs_cd_desc_is_send(d) != true { panic(107413); };
}

@test "desc_sparse_immutable_non_send"() {
    let d = ecs_cd_desc_default(11, 101);
    d = ecs_cd_desc_storage_sparse(d);
    d = ecs_cd_desc_immutable(d);
    d = ecs_cd_desc_non_send(d);
    if ecs_cd_desc_is_sparse(d) != true { panic(107420); };
    if ecs_cd_desc_is_mutable(d) != false { panic(107421); };
    if ecs_cd_desc_is_send(d) != false { panic(107422); };
}

@test "clone_resolve_default_ignore_custom"() {
    let def = ecs_cd_clone_default();
    if ecs_cd_clone_resolve(def, ECS_CD_CLONE_FN_DEFAULT) != ECS_CD_CLONE_FN_DEFAULT { panic(107430); };
    let ign = ecs_cd_clone_ignore();
    if ecs_cd_clone_resolve(ign, ECS_CD_CLONE_FN_DEFAULT) != ECS_CD_CLONE_FN_IGNORE { panic(107431); };
    let custom = ecs_cd_clone_custom(55);
    if ecs_cd_clone_resolve(custom, ECS_CD_CLONE_FN_DEFAULT) != 55 { panic(107432); };
}

@test "desc_clone_behavior_resolve"() {
    let d = ecs_cd_desc_default(1, 1);
    d = ecs_cd_desc_clone_behavior(d, ecs_cd_clone_ignore());
    if ecs_cd_desc_resolve_clone(d, 100) != ECS_CD_CLONE_FN_IGNORE { panic(107440); };
    d = ecs_cd_desc_clone_behavior(d, ecs_cd_clone_custom(9));
    if ecs_cd_desc_resolve_clone(d, 100) != 9 { panic(107441); };
}

@test "hooks_set_and_flags"() {
    let h = ecs_cd_hooks_none();
    if ecs_cd_hooks_is_empty(h) != true { panic(107450); };
    h = ecs_cd_hooks_set_on_add(h, 10);
    h = ecs_cd_hooks_set_on_insert(h, 11);
    h = ecs_cd_hooks_set_on_remove(h, 12);
    if ecs_cd_hooks_has(h, ECS_CD_HOOK_ON_ADD) != true { panic(107451); };
    if ecs_cd_hooks_has(h, ECS_CD_HOOK_ON_INSERT) != true { panic(107452); };
    if ecs_cd_hooks_has(h, ECS_CD_HOOK_ON_REMOVE) != true { panic(107453); };
    if ecs_cd_hooks_has(h, ECS_CD_HOOK_ON_DESPAWN) != false { panic(107454); };
    if ecs_cd_hooks_on_add(h) != 10 { panic(107455); };
}

@test "required_shallowest_depth_wins"() {
    let r = ecs_cd_req_new();
    r = ecs_cd_req_register(r, 2, 100, 3);
    r = ecs_cd_req_register(r, 2, 200, 1); // shallower wins
    r = ecs_cd_req_register(r, 2, 300, 5); // deeper ignored
    if ecs_cd_req_len(r) != 1 { panic(107460); };
    if ecs_cd_req_get_ctor(r, 0) != 200 { panic(107461); };
    if ecs_cd_req_get_depth(r, 0) != 1 { panic(107462); };
}

@test "required_multiple_and_contains"() {
    let r = ecs_cd_req_new();
    r = ecs_cd_req_register_direct(r, 2, 20);
    r = ecs_cd_req_register(r, 3, 30, 1);
    if ecs_cd_req_len(r) != 2 { panic(107470); };
    if ecs_cd_req_contains(r, 2) != true { panic(107471); };
    if ecs_cd_req_contains(r, 9) != false { panic(107472); };
}

@test "register_component_assigns_ids"() {
    let c = ecs_cd_components_new();
    let d1 = ecs_cd_desc_default(100, 1);
    let r1 = ecs_cd_register(c, d1);
    c = r1.0;
    if r1.1 != 1 { panic(107480); };
    let d2 = ecs_cd_desc_default(200, 2);
    d2 = ecs_cd_desc_storage_sparse(d2);
    let r2 = ecs_cd_register(c, d2);
    c = r2.0;
    if r2.1 != 2 { panic(107481); };
    if ecs_cd_components_len(c) != 2 { panic(107482); };
    let g = ecs_cd_get_by_id(c, 2);
    if g.0 != true { panic(107483); };
    if ecs_cd_desc_is_sparse(g.1) != true { panic(107484); };
}

@test "register_same_type_idempotent"() {
    let c = ecs_cd_components_new();
    let r1 = ecs_cd_register(c, ecs_cd_desc_default(5, 1));
    c = r1.0;
    let r2 = ecs_cd_register(c, ecs_cd_desc_default(5, 99));
    c = r2.0;
    if r2.1 != r1.1 { panic(107490); };
    if ecs_cd_components_len(c) != 1 { panic(107491); };
}

@test "get_by_type_and_id_for"() {
    let c = ecs_cd_components_new();
    let r = ecs_cd_register(c, ecs_cd_desc_default(77, 7));
    c = r.0;
    let g = ecs_cd_get_by_type(c, 77);
    if g.0 != true { panic(107500); };
    if ecs_cd_desc_id(g.1) != 1 { panic(107501); };
    let idf = ecs_cd_id_for(c, 77);
    if idf.0 != true { panic(107502); };
    if idf.1 != 1 { panic(107503); };
    let miss = ecs_cd_id_for(c, 78);
    if miss.0 != false { panic(107504); };
}

@test "hooks_fire_on_insert_add_remove"() {
    let c = ecs_cd_components_new();
    let h = ecs_cd_hooks_none();
    h = ecs_cd_hooks_set_on_add(h, 1000);
    h = ecs_cd_hooks_set_on_insert(h, 1001);
    h = ecs_cd_hooks_set_on_remove(h, 1002);
    h = ecs_cd_hooks_set_on_despawn(h, 1003);
    h = ecs_cd_hooks_set_on_discard(h, 1004);
    let d = ecs_cd_desc_default(1, 1);
    d = ecs_cd_desc_hooks(d, h);
    let reg = ecs_cd_register(c, d);
    c = reg.0;
    let cid = reg.1;
    c = ecs_cd_fire_insert(c, cid, true);
    if ecs_cd_hook_add_count(c) != 1 { panic(107510); };
    if ecs_cd_hook_insert_count(c) != 1 { panic(107511); };
    // reinsert: add not fired
    c = ecs_cd_fire_insert(c, cid, false);
    if ecs_cd_hook_add_count(c) != 1 { panic(107512); };
    if ecs_cd_hook_insert_count(c) != 2 { panic(107513); };
    c = ecs_cd_fire_remove(c, cid);
    if ecs_cd_hook_remove_count(c) != 1 { panic(107514); };
    c = ecs_cd_fire_despawn(c, cid);
    if ecs_cd_hook_despawn_count(c) != 1 { panic(107515); };
    c = ecs_cd_fire_discard(c, cid);
    if ecs_cd_hook_discard_count(c) != 1 { panic(107516); };
    if ecs_cd_last_hook_id(c) != 1004 { panic(107517); };
}

@test "insert_plan_includes_missing_required"() {
    // register B (id will be 1), A requires B
    let c = ecs_cd_components_new();
    let b = ecs_cd_desc_default(2, 2);
    let rb = ecs_cd_register(c, b);
    c = rb.0;
    let bid = rb.1;
    let a = ecs_cd_desc_default(1, 1);
    a = ecs_cd_desc_require(a, bid, 50, 0);
    let ra = ecs_cd_register(c, a);
    c = ra.0;
    let aid = ra.1;
    // entity empty mask
    let plan = ecs_cd_build_insert_plan(c, aid, 0);
    if ecs_cd_plan_len(plan) != 2 { panic(107520); };
    if ecs_cd_plan_id_at(plan, 0) != aid { panic(107521); };
    if ecs_cd_plan_id_at(plan, 1) != bid { panic(107522); };
    if ecs_cd_plan_ctor_at(plan, 1) != 50 { panic(107523); };
    // entity already has B: bit for component_id 1 is 1
    let mask: i64 = 1; // if bid==1
    if bid == 1 {
        plan = ecs_cd_build_insert_plan(c, aid, mask);
        if ecs_cd_plan_len(plan) != 1 { panic(107524); };
    };
    if bid == 2 {
        mask = 2; // bit1
        plan = ecs_cd_build_insert_plan(c, aid, mask);
        if ecs_cd_plan_len(plan) != 1 { panic(107525); };
    };
}

@test "layout_and_name_fields"() {
    let d = ecs_cd_desc_default(3, 33);
    d = ecs_cd_desc_layout(d, 16, 8);
    if d.layout_size != 16 { panic(107530); };
    if d.layout_align != 8 { panic(107531); };
    if d.name_id != 33 { panic(107532); };
}

@test "entity_has_mask_bits"() {
    // component_id 1 -> bit0
    if ecs_cd_entity_has(1, 1) != true { panic(107540); };
    if ecs_cd_entity_has(1, 2) != false { panic(107541); };
    // component_id 3 -> bit2 = 4
    if ecs_cd_entity_has(4, 3) != true { panic(107542); };
}

@test "required_direct_register"() {
    let r = ecs_cd_req_new();
    r = ecs_cd_req_register_direct(r, 9, 1);
    r = ecs_cd_req_register_direct(r, 9, 2); // same depth, first kept? find updates only if shallower; equal depth keeps old
    if ecs_cd_req_get_ctor(r, 0) != 1 { panic(107550); };
}
