@import "lib/unique_array_deep.sla"

// Batch 321: unique_array deep.
// panic codes: 130200 – 130399.

@test "new_capacity"() {
    let a = ecs_ua_deep_new(4);
    if ecs_ua_deep_capacity(a) != 4 { panic(130200); };
    if ecs_ua_deep_is_empty(a) != true { panic(130201); };
}

@test "push_unique"() {
    let a = ecs_ua_deep_new(4);
    a = ecs_ua_deep_push(a, 1);
    a = ecs_ua_deep_push(a, 2);
    a = ecs_ua_deep_push(a, 1);
    if ecs_ua_deep_len(a) != 2 { panic(130210); };
    if ecs_ua_deep_contains(a, 2) != true { panic(130211); };
}

@test "full"() {
    let a = ecs_ua_deep_new(2);
    a = ecs_ua_deep_push(a, 1);
    a = ecs_ua_deep_push(a, 2);
    if ecs_ua_deep_is_full(a) != true { panic(130220); };
    a = ecs_ua_deep_push(a, 3);
    if ecs_ua_deep_len(a) != 2 { panic(130221); };
}

@test "get_first_last"() {
    let a = ecs_ua_deep_push(ecs_ua_deep_push(ecs_ua_deep_new(4), 10), 20);
    if ecs_ua_get_value(ecs_ua_deep_first(a)) != 10 { panic(130230); };
    if ecs_ua_get_value(ecs_ua_deep_last(a)) != 20 { panic(130231); };
    if ecs_ua_get_value(ecs_ua_deep_get(a, 1)) != 20 { panic(130232); };
}

@test "get_oob"() {
    let a = ecs_ua_deep_new(2);
    if ecs_ua_get_ok(ecs_ua_deep_get(a, 0)) != false { panic(130240); };
    if ecs_ua_get_ok(ecs_ua_deep_first(a)) != false { panic(130241); };
}

@test "index_of"() {
    let a = ecs_ua_deep_push(ecs_ua_deep_push(ecs_ua_deep_new(4), 7), 8);
    if ecs_ua_deep_index_of(a, 8) != 1 { panic(130250); };
    if ecs_ua_deep_index_of(a, 9) != (0 - 1) { panic(130251); };
}

@test "at_access"() {
    let a = ecs_ua_deep_push(ecs_ua_deep_push(ecs_ua_deep_new(4), 3), 4);
    if ecs_ua_deep_at(a, 0) != 3 { panic(130260); };
    if ecs_ua_deep_at(a, 1) != 4 { panic(130261); };
}

@test "clear_preserves_cap"() {
    let a = ecs_ua_deep_push(ecs_ua_deep_new(5), 1);
    a = ecs_ua_deep_clear(a);
    if ecs_ua_deep_is_empty(a) != true { panic(130270); };
    if ecs_ua_deep_capacity(a) != 5 { panic(130271); };
}

@test "cap_clamped_to_eight"() {
    let a = ecs_ua_deep_new(20);
    if ecs_ua_deep_capacity(a) != 8 { panic(130280); };
}

@test "contains_false"() {
    let a = ecs_ua_deep_push(ecs_ua_deep_new(3), 1);
    if ecs_ua_deep_contains(a, 2) != false { panic(130290); };
}
