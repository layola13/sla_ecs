@import "lib/entity_commands_conditional_deep.sla"

// Batch 283: entity_commands_conditional deep (src/system/commands/mod.rs EntityCommands).
// panic codes: 122600 – 122799.

@test "insert_replace_and_get"() {
    let c = ecs_ecc_deep_new(1);
    c = ecs_ecc_deep_insert(c, 10, 100);
    if ecs_ecc_deep_len(c) != 1 { panic(122600); };
    if ecs_ecc_deep_contains(c, 10) != true { panic(122601); };
    let g = ecs_ecc_deep_get(c, 10);
    if ecs_ecc_get_found(g) != true { panic(122602); };
    if ecs_ecc_get_value(g) != 100 { panic(122603); };
    c = ecs_ecc_deep_insert(c, 10, 200);
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 10)) != 200 { panic(122604); };
    if ecs_ecc_deep_log_at(c, 0) != 0 { panic(122605); };
}

@test "insert_if_and_if_new"() {
    let c = ecs_ecc_deep_new(2);
    c = ecs_ecc_deep_insert_if(c, 1, 11, false);
    if ecs_ecc_deep_contains(c, 1) != false { panic(122610); };
    c = ecs_ecc_deep_insert_if(c, 1, 11, true);
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 1)) != 11 { panic(122611); };
    c = ecs_ecc_deep_insert_if_new(c, 1, 99);
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 1)) != 11 { panic(122612); };
    c = ecs_ecc_deep_insert_if_new(c, 2, 22);
    if ecs_ecc_deep_len(c) != 2 { panic(122613); };
    c = ecs_ecc_deep_insert_if_new_and(c, 3, 33, false);
    if ecs_ecc_deep_contains(c, 3) != false { panic(122614); };
    c = ecs_ecc_deep_insert_if_new_and(c, 3, 33, true);
    if ecs_ecc_deep_contains(c, 3) != true { panic(122615); };
}

@test "insert_if_neq"() {
    let c = ecs_ecc_deep_new(3);
    c = ecs_ecc_deep_insert_if_neq(c, 5, 1);
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 5)) != 1 { panic(122620); };
    c = ecs_ecc_deep_insert_if_neq(c, 5, 1);
    if ecs_ecc_deep_log_len(c) != 2 { panic(122621); };
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 5)) != 1 { panic(122622); };
    c = ecs_ecc_deep_insert_if_neq(c, 5, 2);
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 5)) != 2 { panic(122623); };
}

@test "try_insert_silences_missing"() {
    let c = ecs_ecc_deep_new_despawned(9);
    let r = ecs_ecc_deep_try_insert(c, 1, 10);
    if ecs_ecc_try_code(r) != 1 { panic(122630); };
    c = ecs_ecc_try_cmd(r);
    if ecs_ecc_deep_silenced_count(c) != 1 { panic(122631); };
    if ecs_ecc_deep_error_count(c) != 0 { panic(122632); };
    if ecs_ecc_deep_contains(c, 1) != false { panic(122633); };
    let r2 = ecs_ecc_deep_try_insert_if(c, 1, 10, true);
    if ecs_ecc_try_code(r2) != 1 { panic(122634); };
    c = ecs_ecc_try_cmd(r2);
    if ecs_ecc_deep_silenced_count(c) != 2 { panic(122635); };
}

@test "try_insert_if_new_keep"() {
    let c = ecs_ecc_deep_new(4);
    let r = ecs_ecc_deep_try_insert(c, 7, 70);
    if ecs_ecc_try_code(r) != 0 { panic(122640); };
    c = ecs_ecc_try_cmd(r);
    let r2 = ecs_ecc_deep_try_insert_if_new(c, 7, 99);
    c = ecs_ecc_try_cmd(r2);
    if ecs_ecc_get_value(ecs_ecc_deep_get(c, 7)) != 70 { panic(122641); };
    let r3 = ecs_ecc_deep_try_insert_if_new_and(c, 8, 80, true);
    c = ecs_ecc_try_cmd(r3);
    if ecs_ecc_deep_contains(c, 8) != true { panic(122642); };
    let r4 = ecs_ecc_deep_try_insert_if_new_and(c, 9, 90, false);
    c = ecs_ecc_try_cmd(r4);
    if ecs_ecc_deep_contains(c, 9) != false { panic(122643); };
}

@test "remove_and_remove_if"() {
    let c = ecs_ecc_deep_new(5);
    c = ecs_ecc_deep_insert(c, 1, 1);
    c = ecs_ecc_deep_insert(c, 2, 2);
    c = ecs_ecc_deep_insert(c, 3, 3);
    c = ecs_ecc_deep_remove_if(c, 2, false);
    if ecs_ecc_deep_contains(c, 2) != true { panic(122650); };
    c = ecs_ecc_deep_remove_if(c, 2, true);
    if ecs_ecc_deep_contains(c, 2) != false { panic(122651); };
    if ecs_ecc_deep_len(c) != 2 { panic(122652); };
    c = ecs_ecc_deep_remove(c, 1);
    if ecs_ecc_deep_contains(c, 1) != false { panic(122653); };
}

@test "try_remove_and_try_remove_if"() {
    let c = ecs_ecc_deep_new(6);
    c = ecs_ecc_deep_insert(c, 4, 40);
    let r = ecs_ecc_deep_try_remove_if(c, 4, false);
    c = ecs_ecc_try_cmd(r);
    if ecs_ecc_deep_contains(c, 4) != true { panic(122660); };
    let r2 = ecs_ecc_deep_try_remove_if(c, 4, true);
    c = ecs_ecc_try_cmd(r2);
    if ecs_ecc_deep_contains(c, 4) != false { panic(122661); };
    let missing = ecs_ecc_deep_new_despawned(0);
    let r3 = ecs_ecc_deep_try_remove(missing, 1);
    if ecs_ecc_try_code(r3) != 1 { panic(122662); };
    if ecs_ecc_deep_silenced_count(ecs_ecc_try_cmd(r3)) != 1 { panic(122663); };
}

@test "retain_clear_try_despawn"() {
    let c = ecs_ecc_deep_new(7);
    c = ecs_ecc_deep_insert(c, 1, 10);
    c = ecs_ecc_deep_insert(c, 2, 20);
    c = ecs_ecc_deep_insert(c, 3, 30);
    c = ecs_ecc_deep_retain(c, 2);
    if ecs_ecc_deep_len(c) != 1 { panic(122670); };
    if ecs_ecc_deep_contains(c, 2) != true { panic(122671); };
    if ecs_ecc_deep_contains(c, 1) != false { panic(122672); };
    c = ecs_ecc_deep_clear(c);
    if ecs_ecc_deep_len(c) != 0 { panic(122673); };
    let r = ecs_ecc_deep_try_despawn(c);
    if ecs_ecc_try_code(r) != 0 { panic(122674); };
    c = ecs_ecc_try_cmd(r);
    if ecs_ecc_deep_is_spawned(c) != false { panic(122675); };
}

@test "handled_error_on_missing_entity"() {
    let c = ecs_ecc_deep_new_despawned(8);
    c = ecs_ecc_deep_insert(c, 1, 1);
    if ecs_ecc_deep_error_count(c) != 1 { panic(122680); };
    if ecs_ecc_deep_last_error(c) != 1 { panic(122681); };
    c = ecs_ecc_deep_remove(c, 1);
    if ecs_ecc_deep_error_count(c) != 2 { panic(122682); };
    c = ecs_ecc_deep_insert_if_new(c, 2, 2);
    if ecs_ecc_deep_error_count(c) != 3 { panic(122683); };
}

@test "log_and_reborrow"() {
    let c = ecs_ecc_deep_new(10);
    c = ecs_ecc_deep_insert(c, 1, 1);
    c = ecs_ecc_deep_insert_if_new(c, 2, 2);
    c = ecs_ecc_deep_remove_if(c, 1, true);
    if ecs_ecc_deep_log_len(c) != 3 { panic(122690); };
    if ecs_ecc_deep_log_at(c, 0) != 0 { panic(122691); };
    if ecs_ecc_deep_log_at(c, 1) != 2 { panic(122692); };
    if ecs_ecc_deep_log_at(c, 2) != 9 { panic(122693); };
    let r = ecs_ecc_deep_reborrow(c);
    if ecs_ecc_deep_id(r) != 10 { panic(122694); };
    if ecs_ecc_deep_len(r) != 1 { panic(122695); };
    if ecs_ecc_deep_contains(r, 2) != true { panic(122696); };
}
