// Isolated deep tests for lib/system_schedule_deep.sla (Batch 376).
// Mirrors shallow lib/system_schedule.sla — SystemSchedule + ApplyDeferred + default_executor — on
// cap-8 parallel-array storage. No tuple-return callsites — get_system_id/_conditions/_dependencies
// / get_set_id/_conditions return wrapper structs read directly via `.valid` / `.id` / `.count`
// (Batch 373 observation: let (a, b) = tuple_fn() retroactively corrupts prior assertions on SA).
// panic codes: 141200 - 141399.

@import "lib/system_schedule_deep.sla"

@test "EcsSystemScheduleDeep new is empty and counts zero"() {
    let s0 = ecs_system_schedule_deep_new();
    if ecs_system_schedule_deep_system_count(s0) != 0 { panic(141200); };
    if ecs_system_schedule_deep_set_count(s0) != 0 { panic(141201); };
    if ecs_system_schedule_deep_is_empty(s0) != true { panic(141202); };
    if ecs_system_schedule_deep_systems_run(s0) != 0 { panic(141203); };
    if ecs_system_schedule_deep_systems_skipped(s0) != 0 { panic(141204); };
    if ecs_system_schedule_deep_total_conditions(s0) != 0 { panic(141205); };
    if ecs_system_schedule_deep_total_dependencies(s0) != 0 { panic(141206); };
}

@test "EcsSystemScheduleDeep add_system stores slot (id, conditions, deps)"() {
    let s0 = ecs_system_schedule_deep_new();
    let s1 = ecs_system_schedule_deep_add_system(s0, 100, 2, 1);
    let s2 = ecs_system_schedule_deep_add_system(s1, 200, 0, 3);
    if ecs_system_schedule_deep_system_count(s2) != 2 { panic(141210); };
    if ecs_system_schedule_deep_is_empty(s2) != false { panic(141211); };
    let r0 = ecs_system_schedule_deep_get_system_id(s2, 0);
    if r0.valid != true { panic(141212); };
    if r0.id != 100 { panic(141213); };
    let r1 = ecs_system_schedule_deep_get_system_conditions(s2, 0);
    if r1.valid != true { panic(141214); };
    if r1.count != 2 { panic(141215); };
    let r2 = ecs_system_schedule_deep_get_system_dependencies(s2, 0);
    if r2.valid != true { panic(141216); };
    if r2.count != 1 { panic(141217); };
    let r3 = ecs_system_schedule_deep_get_system_id(s2, 1);
    if r3.id != 200 { panic(141218); };
    if r3.valid != true { panic(141219); };
    let r4 = ecs_system_schedule_deep_get_system_conditions(s2, 1);
    if r4.count != 0 { panic(141220); };
    let r5 = ecs_system_schedule_deep_get_system_dependencies(s2, 1);
    if r5.count != 3 { panic(141221); };
}

@test "EcsSystemScheduleDeep add_set stores (set_id, conditions)"() {
    let s0 = ecs_system_schedule_deep_new();
    let s1 = ecs_system_schedule_deep_add_set(s0, 50, 4);
    let s2 = ecs_system_schedule_deep_add_set(s1, 60, 0);
    if ecs_system_schedule_deep_set_count(s2) != 2 { panic(141230); };
    let r0 = ecs_system_schedule_deep_get_set_id(s2, 0);
    if r0.valid != true { panic(141231); };
    if r0.id != 50 { panic(141232); };
    let r1 = ecs_system_schedule_deep_get_set_conditions(s2, 0);
    if r1.valid != true { panic(141233); };
    if r1.count != 4 { panic(141234); };
    let r2 = ecs_system_schedule_deep_get_set_id(s2, 1);
    if r2.id != 60 { panic(141235); };
    if r2.valid != true { panic(141236); };
    let r3 = ecs_system_schedule_deep_get_set_conditions(s2, 1);
    if r3.count != 0 { panic(141237); };
    // out-of-range set accessors return valid=false.
    let r4 = ecs_system_schedule_deep_get_set_id(s2, 2);
    if r4.valid != false { panic(141238); };
    let r5 = ecs_system_schedule_deep_get_set_conditions(s2, -1);
    if r5.valid != false { panic(141239); };
}

@test "EcsSystemScheduleDeep get accessors out-of-range is invalid and id 0"() {
    let s0 = ecs_system_schedule_deep_add_system(ecs_system_schedule_deep_new(), 1, 0, 0);
    let r0 = ecs_system_schedule_deep_get_system_id(s0, 1);
    if r0.valid != false { panic(141240); };
    if r0.id != 0 { panic(141241); };
    let r1 = ecs_system_schedule_deep_get_system_conditions(s0, 1);
    if r1.valid != false { panic(141242); };
    if r1.count != 0 { panic(141243); };
    let r2 = ecs_system_schedule_deep_get_system_dependencies(s0, -1);
    if r2.valid != false { panic(141244); };
    if r2.count != 0 { panic(141245); };
}

@test "EcsSystemScheduleDeep cap-8 reject on add_system and add_set"() {
    let s0 = ecs_system_schedule_deep_new();
    let s1 = ecs_system_schedule_deep_add_system(s0, 1, 0, 0);
    let s2 = ecs_system_schedule_deep_add_system(s1, 2, 0, 0);
    let s3 = ecs_system_schedule_deep_add_system(s2, 3, 0, 0);
    let s4 = ecs_system_schedule_deep_add_system(s3, 4, 0, 0);
    let s5 = ecs_system_schedule_deep_add_system(s4, 5, 0, 0);
    let s6 = ecs_system_schedule_deep_add_system(s5, 6, 0, 0);
    let s7 = ecs_system_schedule_deep_add_system(s6, 7, 0, 0);
    let s8 = ecs_system_schedule_deep_add_system(s7, 8, 0, 0);
    if ecs_system_schedule_deep_system_count(s8) != 8 { panic(141250); };
    // 9th system rejected.
    let s9 = ecs_system_schedule_deep_add_system(s8, 9, 0, 0);
    if ecs_system_schedule_deep_system_count(s9) != 8 { panic(141251); };
    let r0 = ecs_system_schedule_deep_get_system_id(s9, 7);
    if r0.id != 8 { panic(141252); };
    // cap-8 for sets too
    let t0 = ecs_system_schedule_deep_add_set(ecs_system_schedule_deep_new(), 10, 0);
    let t1 = ecs_system_schedule_deep_add_set(t0, 11, 0);
    let t2 = ecs_system_schedule_deep_add_set(t1, 12, 0);
    let t3 = ecs_system_schedule_deep_add_set(t2, 13, 0);
    let t4 = ecs_system_schedule_deep_add_set(t3, 14, 0);
    let t5 = ecs_system_schedule_deep_add_set(t4, 15, 0);
    let t6 = ecs_system_schedule_deep_add_set(t5, 16, 0);
    let t7 = ecs_system_schedule_deep_add_set(t6, 17, 0);
    if ecs_system_schedule_deep_set_count(t7) != 8 { panic(141253); };
    let t8 = ecs_system_schedule_deep_add_set(t7, 18, 0);
    if ecs_system_schedule_deep_set_count(t8) != 8 { panic(141254); };
    let r1 = ecs_system_schedule_deep_get_set_id(t8, 7);
    if r1.id != 17 { panic(141255); };
}

@test "EcsSystemScheduleDeep run and skipped counters + reset"() {
    let s0 = ecs_system_schedule_deep_new();
    // mark_run / mark_skip accumulate separately.
    let s1 = ecs_system_schedule_deep_mark_run(s0);
    let s2 = ecs_system_schedule_deep_mark_run(s1);
    let s3 = ecs_system_schedule_deep_mark_skip(s2);
    if ecs_system_schedule_deep_systems_run(s3) != 2 { panic(141260); };
    if ecs_system_schedule_deep_systems_skipped(s3) != 1 { panic(141261); };
    // reset zeroes run + skip but leaves systems/sets intact.
    let s4 = ecs_system_schedule_deep_reset(s3);
    if ecs_system_schedule_deep_systems_run(s4) != 0 { panic(141262); };
    if ecs_system_schedule_deep_systems_skipped(s4) != 0 { panic(141263); };
}

@test "EcsSystemScheduleDeep total_conditions and total_dependencies sum"() {
    let s0 = ecs_system_schedule_deep_new();
    let s1 = ecs_system_schedule_deep_add_system(s0, 100, 2, 1);
    let s2 = ecs_system_schedule_deep_add_system(s1, 200, 0, 3);
    let s3 = ecs_system_schedule_deep_add_system(s2, 300, 5, 0);
    // systems: 2 + 0 + 5 = 7 conditions, 1 + 3 + 0 = 4 dependencies.
    if ecs_system_schedule_deep_total_conditions(s3) != 7 { panic(141270); };
    if ecs_system_schedule_deep_total_dependencies(s3) != 4 { panic(141271); };
    // Mix in a set: set condition counts add into total_conditions but NOT total_dependencies.
    let s4 = ecs_system_schedule_deep_add_set(s3, 50, 1);
    let s5 = ecs_system_schedule_deep_add_set(s4, 60, 4);
    if ecs_system_schedule_deep_total_conditions(s5) != 12 { panic(141272); };
    if ecs_system_schedule_deep_total_dependencies(s5) != 4 { panic(141273); };
    // Empty totals zero.
    if ecs_system_schedule_deep_total_conditions(ecs_system_schedule_deep_new()) != 0 { panic(141274); };
    if ecs_system_schedule_deep_total_dependencies(ecs_system_schedule_deep_new()) != 0 { panic(141275); };
}

@test "EcsSystemScheduleDeep clear blankens everything"() {
    let s0 = ecs_system_schedule_deep_new();
    let s1 = ecs_system_schedule_deep_add_system(s0, 1, 2, 3);
    let s2 = ecs_system_schedule_deep_add_set(s1, 4, 5);
    let s3 = ecs_system_schedule_deep_mark_run(s2);
    let s4 = ecs_system_schedule_deep_mark_skip(s3);
    let s5 = ecs_system_schedule_deep_clear(s4);
    if ecs_system_schedule_deep_system_count(s5) != 0 { panic(141280); };
    if ecs_system_schedule_deep_set_count(s5) != 0 { panic(141281); };
    if ecs_system_schedule_deep_systems_run(s5) != 0 { panic(141282); };
    if ecs_system_schedule_deep_systems_skipped(s5) != 0 { panic(141283); };
    if ecs_system_schedule_deep_is_empty(s5) != true { panic(141284); };
    if ecs_system_schedule_deep_total_conditions(s5) != 0 { panic(141285); };
    let r0 = ecs_system_schedule_deep_get_system_id(s5, 0);
    if r0.valid != false { panic(141286); };
}

@test "EcsSystemScheduleDeep round-trips add clear re-add systems"() {
    let s0 = ecs_system_schedule_deep_new();
    let s1 = ecs_system_schedule_deep_add_system(s0, 7, 1, 2);
    let s2 = ecs_system_schedule_deep_clear(s1);
    if ecs_system_schedule_deep_system_count(s2) != 0 { panic(141290); };
    // re-add after clear: cap is back at 8 fresh slots.
    let s3 = ecs_system_schedule_deep_add_system(s2, 8, 3, 1);
    let s4 = ecs_system_schedule_deep_add_system(s3, 9, 4, 0);
    if ecs_system_schedule_deep_system_count(s4) != 2 { panic(141291); };
    let r0 = ecs_system_schedule_deep_get_system_id(s4, 0);
    if r0.id != 8 { panic(141292); };
    if ecs_system_schedule_deep_total_conditions(s4) != 7 { panic(141293); };
    if ecs_system_schedule_deep_total_dependencies(s4) != 1 { panic(141294); };
}

@test "ApplyDeferred marker and default_executor_kind"() {
    if ecs_is_apply_deferred_deep(999999) != true { panic(141300); };
    if ecs_is_apply_deferred_deep(1) != false { panic(141301); };
    if ecs_is_apply_deferred_deep(0) != false { panic(141302); };
    if ecs_default_executor_kind_deep(true) != 1 { panic(141303); };
    if ecs_default_executor_kind_deep(false) != 0 { panic(141304); };
    // The marker constant matches ECS_APPLY_DEFERRED_DEEP = 999999 deep side; check via the
    // predicate + a non-marker that tests-coded via the predicate.
    if ecs_is_apply_deferred_deep(141399) != false { panic(141310); };
}
