@import "lib/world_observer_trigger.sla"

// Isolated tests for lib/world_observer_trigger.sla — World-level observer trigger API (World::trigger/trigger_with/trigger_ref/trigger_ref_with/add_observer). Bevy reference: src/observer/mod.rs.

@test "world_observer_fields"() {
    let o = ecs_world_observer_new(7, 99, 0, false);
    if ecs_world_observer_event_id(o) != 7 { panic(91327); };
    if ecs_world_observer_target_entity(o) != 99 { panic(91328); };
    if ecs_world_observer_error_handler_id(o) != 0 { panic(91329); };
    if ecs_world_observer_runs(o) != 0 { panic(91330); };
    if ecs_world_observer_mutates_payload(o) { panic(91331); };
}

@test "world_trigger_model_new_empty"() {
    let w = ecs_world_trigger_model_new();
    if ecs_world_trigger_model_observer_count(w) != 0 { panic(91332); };
    if ecs_world_trigger_model_last_trigger_id(w) != 0 { panic(91333); };
}

@test "add_observer_spawns_entity_and_increments_count"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 1, -1, 0, false);
    if ecs_wot_add_observer_entity(res) != 1 { panic(91334); };
    if ecs_wot_add_observer_count(res) != 1 { panic(91335); };
    let w2 = ecs_wot_add_observer_world(res);
    let res2 = ecs_world_trigger_model_add_observer(w2, 2, -1, 0, false);
    if ecs_wot_add_observer_entity(res2) != 2 { panic(91336); };
    if ecs_wot_add_observer_count(res2) != 2 { panic(91337); };
}

@test "trigger_no_observers_fires_zero"() {
    let w = ecs_world_trigger_model_new();
    let r = ecs_world_trigger(w, 7);
    if ecs_wot_run_fired(r) != 0 { panic(91338); };
    if ecs_wot_run_last_trigger_id(r) != 1 { panic(91339); };
}

@test "trigger_fires_matching_global_observer"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 5, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger(w2, 5);
    if ecs_wot_run_fired(r) != 1 { panic(91340); };
    if ecs_wot_run_last_trigger_id(r) != 1 { panic(91341); };
    if ecs_wot_run_first_err_handler(r) != -1 { panic(91342); };
}

@test "trigger_skips_non_matching_event"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 5, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger(w2, 99);
    if ecs_wot_run_fired(r) != 0 { panic(91343); };
    if ecs_wot_run_last_trigger_id(r) != 1 { panic(91344); };
    // observer runs counter still 0 after a non-matching trigger
    let ob = ecs_world_trigger_model_observer_at(w2, 0);
    if ecs_world_observer_runs(ob) != 0 { panic(91345); };
}

@test "trigger_bumps_observer_runs_on_match"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 5, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r1 = ecs_world_trigger(w2, 5);
    if ecs_wot_run_fired(r1) != 1 { panic(91346); };
    if ecs_wot_run_last_trigger_id(r1) != 1 { panic(91347); };
    let r2 = ecs_world_trigger(w2, 5);
    if ecs_wot_run_fired(r2) != 1 { panic(91348); };
    if ecs_wot_run_last_trigger_id(r2) != 2 { panic(91349); };
    let ob = ecs_world_trigger_model_observer_at(w2, 0);
    if ecs_world_observer_runs(ob) != 2 { panic(91350); };
}

@test "trigger_multiple_observers_fires_all_matching"() {
    let w = ecs_world_trigger_model_new();
    let res1 = ecs_world_trigger_model_add_observer(w, 5, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res1);
    let res2 = ecs_world_trigger_model_add_observer(w2, 5, -1, 0, false);
    let w3 = ecs_wot_add_observer_world(res2);
    let res3 = ecs_world_trigger_model_add_observer(w3, 9, -1, 0, false);
    let w4 = ecs_wot_add_observer_world(res3);
    let r = ecs_world_trigger(w4, 5);
    if ecs_wot_run_fired(r) != 2 { panic(91351); };
    if ecs_wot_run_last_trigger_id(r) != 1 { panic(91352); };
    let ob0 = ecs_world_trigger_model_observer_at(w4, 0);
    let ob1 = ecs_world_trigger_model_observer_at(w4, 1);
    let ob2 = ecs_world_trigger_model_observer_at(w4, 2);
    if ecs_world_observer_runs(ob0) != 1 { panic(91353); };
    if ecs_world_observer_runs(ob1) != 1 { panic(91354); };
    if ecs_world_observer_runs(ob2) != 0 { panic(91355); };
}

@test "trigger_with_returns_payload_and_runs"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 7, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger_with(w2, 7, 42);
    if ecs_wot_with_payload(r) != 42 { panic(91356); };
    if ecs_wot_with_trigger_data(r) != 42 { panic(91357); };
    let run = ecs_wot_with_run(r);
    if ecs_wot_run_fired(run) != 1 { panic(91358); };
}

@test "trigger_ref_equivalent_to_trigger"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 3, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger_ref(w2, 3);
    if ecs_wot_run_fired(r) != 1 { panic(91359); };
    if ecs_wot_run_last_trigger_id(r) != 1 { panic(91360); };
}

@test "trigger_ref_with_returns_payload_and_runs"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 4, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger_ref_with(w2, 4, 100);
    if ecs_wot_with_payload(r) != 100 { panic(91361); };
    let run = ecs_wot_with_run(r);
    if ecs_wot_run_fired(run) != 1 { panic(91362); };
}

@test "trigger_records_first_error_handler_id"() {
    let w = ecs_world_trigger_model_new();
    let res1 = ecs_world_trigger_model_add_observer(w, 5, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res1);
    let res2 = ecs_world_trigger_model_add_observer(w2, 5, -1, 765, false);
    let w3 = ecs_wot_add_observer_world(res2);
    let r = ecs_world_trigger(w3, 5);
    if ecs_wot_run_first_err_handler(r) != 765 { panic(91363); };
    if ecs_wot_run_fired(r) != 2 { panic(91364); };
}

@test "trigger_no_error_when_zero_handler_ids"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 5, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger(w2, 5);
    if ecs_wot_run_first_err_handler(r) != -1 { panic(91365); };
}

@test "add_observer_records_target_entity"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 5, 17, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let ob = ecs_world_trigger_model_observer_at(w2, 0);
    if ecs_world_observer_target_entity(ob) != 17 { panic(91366); };
    if ecs_world_observer_event_id(ob) != 5 { panic(91367); };
}

@test "trigger_with_default_trigger_data_zero"() {
    let w = ecs_world_trigger_model_new();
    let res = ecs_world_trigger_model_add_observer(w, 9, -1, 0, false);
    let w2 = ecs_wot_add_observer_world(res);
    let r = ecs_world_trigger_with(w2, 9, 0);
    if ecs_wot_with_payload(r) != 0 { panic(91368); };
    let run = ecs_wot_with_run(r);
    if ecs_wot_run_fired(run) != 1 { panic(91369); };
}
