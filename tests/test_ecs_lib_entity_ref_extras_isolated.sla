@import "lib/entity_ref_extras.sla"

// Isolated tests for lib/entity_ref_extras.sla — EntityRef pub surface not in lib/entity_access.sla. Bevy reference: src/world/entity_access/entity_ref.rs.

@test "extra_new_and_id"() {
    let r = ecs_entity_ref_extra_new(42);
    if ecs_entity_ref_extra_id(r) != 42 { panic(91370); };
}

@test "extra_archetype_default_zero"() {
    let r = ecs_entity_ref_extra_new(1);
    if ecs_entity_ref_extra_archetype(r) != 0 { panic(91371); };
}

@test "extra_set_archetype_location_reads_back"() {
    let r = ecs_entity_ref_extra_new(7);
    let r2 = ecs_entity_ref_extra_set_archetype_location(r, 5, 9);
    if ecs_entity_ref_extra_archetype(r2) != 5 { panic(91372); };
    let loc = ecs_entity_ref_extra_location(r2);
    if ecs_entity_ref_extra_location_archetype(loc) != 5 { panic(91373); };
    if ecs_entity_ref_extra_location_table_row(loc) != 9 { panic(91374); };
}

@test "extra_set_spawn_reads_back"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_set_spawn(r, 33, 777);
    if ecs_entity_ref_extra_spawn_tick(r2) != 33 { panic(91375); };
    if ecs_entity_ref_extra_spawned_by(r2) != 777 { panic(91376); };
}

@test "extra_default_spawn_zero"() {
    let r = ecs_entity_ref_extra_new(1);
    if ecs_entity_ref_extra_spawn_tick(r) != 0 { panic(91377); };
    if ecs_entity_ref_extra_spawned_by(r) != 0 { panic(91378); };
}

@test "extra_contains_id_present_and_absent"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 999);
    if !ecs_entity_ref_extra_contains_id(r2, 7) { panic(91379); };
    if ecs_entity_ref_extra_contains_id(r2, 8) { panic(91380); };
}

@test "extra_contains_type_id_present_and_absent"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 999);
    if !ecs_entity_ref_extra_contains_type_id(r2, 100) { panic(91381); };
    if ecs_entity_ref_extra_contains_type_id(r2, 200) { panic(91382); };
}

@test "extra_get_by_id_found_and_missing"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 999);
    if ecs_entity_ref_extra_get_by_id(r2, 7) != 0 { panic(91383); };
    if ecs_entity_ref_extra_get_by_id(r2, 99) != -1 { panic(91384); };
}

@test "extra_get_change_ticks_by_id_found"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 999);
    let ct = ecs_entity_ref_extra_get_change_ticks_by_id(r2, 7);
    if !ecs_ct_found(ct) { panic(91385); };
    if ecs_ct_added_tick(ct) != 5 { panic(91386); };
    if ecs_ct_changed_tick(ct) != 5 { panic(91387); };
}

@test "extra_get_change_ticks_by_id_missing"() {
    let r = ecs_entity_ref_extra_new(1);
    let ct = ecs_entity_ref_extra_get_change_ticks_by_id(r, 99);
    if ecs_ct_found(ct) { panic(91388); };
}

@test "extra_get_change_ticks_alias"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 8, 0);
    let ct = ecs_entity_ref_extra_get_change_ticks(r2, 7);
    if !ecs_ct_found(ct) { panic(91389); };
    if ecs_ct_added_tick(ct) != 8 { panic(91390); };
}

@test "extra_get_changed_by_found"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 42);
    if ecs_entity_ref_extra_get_changed_by(r2, 7) != 42 { panic(91391); };
    if ecs_entity_ref_extra_get_changed_by(r2, 99) != -1 { panic(91392); };
}

@test "extra_get_ref_found_and_missing"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 42);
    let rf = ecs_entity_ref_extra_get_ref(r2, 7);
    if !ecs_ref_found(rf) { panic(91393); };
    if ecs_ref_value(rf) != 0 { panic(91394); };
    if ecs_ref_added_tick(rf) != 5 { panic(91395); };
    if ecs_ref_changed_tick(rf) != 5 { panic(91396); };
    if ecs_ref_changed_by_id(rf) != 42 { panic(91397); };
    let missing = ecs_entity_ref_extra_get_ref(r2, 99);
    if ecs_ref_found(missing) { panic(91398); };
}

@test "extra_components_count"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 1, 100, 5, 0);
    let r3 = ecs_entity_ref_extra_add(r2, 2, 101, 5, 0);
    let r4 = ecs_entity_ref_extra_add(r3, 3, 102, 5, 0);
    let requested = Vec::new();
    requested.push(1); requested.push(3); requested.push(99);
    if ecs_entity_ref_extra_components_count(r4, requested) != 2 { panic(91399); };
}

@test "extra_get_components_all_present"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 1, 100, 5, 0);
    let r3 = ecs_entity_ref_extra_add(r2, 2, 101, 5, 0);
    let requested = Vec::new();
    requested.push(1); requested.push(2);
    if ecs_entity_ref_extra_get_components_result(r3, requested) != 1 { panic(91400); };
}

@test "extra_get_components_missing_returns_zero"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 1, 100, 5, 0);
    let requested = Vec::new();
    requested.push(1); requested.push(99);
    if ecs_entity_ref_extra_get_components_result(r2, requested) != 0 { panic(91401); };
}

@test "extra_get_components_empty_request_returns_one"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 1, 100, 5, 0);
    if ecs_entity_ref_extra_get_components_result(r2, Vec::new()) != 1 { panic(91402); };
}

@test "extra_into_filtered_carries_entity_and_count"() {
    let r = ecs_entity_ref_extra_new(13);
    let r2 = ecs_entity_ref_extra_add(r, 1, 100, 5, 0);
    let r3 = ecs_entity_ref_extra_add(r2, 2, 101, 5, 0);
    let f = ecs_entity_ref_extra_into_filtered(r3);
    if ecs_filtered_entity_ref_entity_id(f) != 13 { panic(91403); };
    if ecs_filtered_entity_ref_access_id(f) != -1 { panic(91404); };
    if ecs_filtered_entity_ref_component_count(f) != 2 { panic(91405); };
}

@test "extra_contains_type_id_after_two_adds"() {
    let r = ecs_entity_ref_extra_new(1);
    let r2 = ecs_entity_ref_extra_add(r, 7, 100, 5, 0);
    let r3 = ecs_entity_ref_extra_add(r2, 9, 200, 5, 0);
    if !ecs_entity_ref_extra_contains_type_id(r3, 100) { panic(91406); };
    if !ecs_entity_ref_extra_contains_type_id(r3, 200) { panic(91407); };
    if ecs_entity_ref_extra_contains_type_id(r3, 300) { panic(91408); };
}

@test "extra_location_default_zero"() {
    let r = ecs_entity_ref_extra_new(1);
    let loc = ecs_entity_ref_extra_location(r);
    if ecs_entity_ref_extra_location_archetype(loc) != 0 { panic(91409); };
    if ecs_entity_ref_extra_location_table_row(loc) != 0 { panic(91410); };
}
