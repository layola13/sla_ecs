@import "lib/observer_entity_cloning_deep.sla"

// Batch 218: observer entity cloning deep (src/observer/entity_cloning.rs).
// panic codes: 109600 – 109799.

@test "builder_add_observers_true_custom"() {
    let b = ecs_oec_builder_new();
    if ecs_oec_builder_will_clone_observers(b) != false { panic(109600); };
    b = ecs_oec_builder_add_observers(b, true);
    if ecs_oec_builder_behavior(b) != ECS_OEC_BEHAVIOR_CUSTOM_OBSERVED_BY { panic(109601); };
    if ecs_oec_builder_will_clone_observers(b) != true { panic(109602); };
}

@test "builder_add_observers_false_removes_override"() {
    let b = ecs_oec_builder_new();
    b = ecs_oec_builder_add_observers(b, true);
    b = ecs_oec_builder_add_observers(b, false);
    if ecs_oec_builder_behavior(b) != ECS_OEC_BEHAVIOR_REMOVED_OVERRIDE { panic(109610); };
    if ecs_oec_builder_will_clone_observers(b) != false { panic(109611); };
}

@test "observed_by_push_and_clone"() {
    let o = ecs_oec_observed_by_new();
    o = ecs_oec_observed_by_push(o, 10);
    o = ecs_oec_observed_by_push(o, 11);
    if ecs_oec_observed_by_len(o) != 2 { panic(109620); };
    if ecs_oec_observed_by_at(o, 0) != 10 { panic(109621); };
    if ecs_oec_observed_by_contains(o, 11) != true { panic(109622); };
    let c = ecs_oec_observed_by_clone(o);
    if ecs_oec_observed_by_len(c) != 2 { panic(109623); };
    if ecs_oec_observed_by_at(c, 1) != 11 { panic(109624); };
}

@test "desc_push_entity_event_component"() {
    let d = ecs_oec_desc_new();
    d = ecs_oec_desc_push_entity(d, 5);
    d = ecs_oec_desc_push_event_key(d, 1);
    d = ecs_oec_desc_push_component(d, 10);
    if ecs_oec_desc_entity_len(d) != 1 { panic(109630); };
    if ecs_oec_desc_event_key_len(d) != 1 { panic(109631); };
    if ecs_oec_desc_component_len(d) != 1 { panic(109632); };
    if ecs_oec_desc_has_entity(d, 5) != true { panic(109633); };
}

@test "emap_insert_get_clone_entry"() {
    let m = ecs_oec_emap_new();
    m = ecs_oec_emap_insert(m, 100, 7);
    let g = ecs_oec_emap_get(m, 100);
    if g.0 != true { panic(109640); };
    if g.1 != 7 { panic(109641); };
    m = ecs_oec_emap_clone_entry(m, 100, 200);
    let g2 = ecs_oec_emap_get(m, 200);
    if g2.0 != true { panic(109642); };
    if g2.1 != 7 { panic(109643); };
    if ecs_oec_emap_len(m) != 2 { panic(109644); };
}

@test "clone_without_add_observers_no_deferred"() {
    let b = ecs_oec_builder_new();
    // default / false — no custom behavior
    let w = ecs_oec_world_new(1, 2);
    let obs = ecs_oec_observed_by_new();
    obs = ecs_oec_observed_by_push(obs, 50);
    w = ecs_oec_world_set_source_obs(w, obs);
    let r = ecs_oec_clone_entity(b, w);
    b = r.0;
    w = r.1;
    if ecs_oec_builder_clone_count(b) != 1 { panic(109650); };
    if ecs_oec_world_deferred_runs(w) != 0 { panic(109651); };
    if ecs_oec_world_target_has_obs(w) != false { panic(109652); };
}

@test "clone_with_observers_copies_observed_by"() {
    let b = ecs_oec_builder_new();
    b = ecs_oec_builder_add_observers(b, true);
    let w = ecs_oec_world_new(1, 2);
    let obs = ecs_oec_observed_by_new();
    obs = ecs_oec_observed_by_push(obs, 50);
    w = ecs_oec_world_set_source_obs(w, obs);
    let desc = ecs_oec_desc_new();
    desc = ecs_oec_desc_push_entity(desc, 1);
    desc = ecs_oec_desc_push_event_key(desc, 1);
    w = ecs_oec_world_add_observer(w, 50, desc);
    let r = ecs_oec_clone_entity(b, w);
    w = r.1;
    if ecs_oec_world_deferred_runs(w) != 1 { panic(109660); };
    if ecs_oec_world_target_has_obs(w) != true { panic(109661); };
    let t = ecs_oec_world_target_obs(w);
    if ecs_oec_observed_by_contains(t, 50) != true { panic(109662); };
}

@test "clone_pushes_target_into_observer_descriptor"() {
    let b = ecs_oec_builder_add_observers(ecs_oec_builder_new(), true);
    let w = ecs_oec_world_new(10, 20);
    let obs = ecs_oec_observed_by_push(ecs_oec_observed_by_new(), 99);
    w = ecs_oec_world_set_source_obs(w, obs);
    let desc = ecs_oec_desc_push_entity(ecs_oec_desc_new(), 10);
    desc = ecs_oec_desc_push_event_key(desc, 1);
    w = ecs_oec_world_add_observer(w, 99, desc);
    let r = ecs_oec_clone_entity(b, w);
    w = r.1;
    if ecs_oec_world_obs_has_target(w, 99, 20) != true { panic(109670); };
    if ecs_oec_world_obs_desc_entity_len(w, 99) != 2 { panic(109671); };
}

@test "clone_entity_observers_map_empty_components"() {
    let b = ecs_oec_builder_add_observers(ecs_oec_builder_new(), true);
    let w = ecs_oec_world_new(1, 2);
    let obs = ecs_oec_observed_by_push(ecs_oec_observed_by_new(), 50);
    w = ecs_oec_world_set_source_obs(w, obs);
    let desc = ecs_oec_desc_push_entity(ecs_oec_desc_new(), 1);
    desc = ecs_oec_desc_push_event_key(desc, 1);
    // no components → entity_observers path
    w = ecs_oec_world_add_observer(w, 50, desc);
    let m = ecs_oec_emap_insert(ecs_oec_emap_new(), 1, 777);
    w = ecs_oec_world_set_emap_k1(w, m);
    let r = ecs_oec_clone_entity(b, w);
    w = r.1;
    let g = ecs_oec_world_emap_k1_get(w, 2);
    if g.0 != true { panic(109680); };
    if g.1 != 777 { panic(109681); };
    // source preserved
    let gs = ecs_oec_world_emap_k1_get(w, 1);
    if gs.0 != true { panic(109682); };
}

@test "clone_component_observers_maps"() {
    let b = ecs_oec_builder_add_observers(ecs_oec_builder_new(), true);
    let w = ecs_oec_world_new(5, 6);
    let obs = ecs_oec_observed_by_push(ecs_oec_observed_by_new(), 70);
    w = ecs_oec_world_set_source_obs(w, obs);
    let desc = ecs_oec_desc_push_entity(ecs_oec_desc_new(), 5);
    desc = ecs_oec_desc_push_event_key(desc, 1);
    desc = ecs_oec_desc_push_component(desc, 10);
    desc = ecs_oec_desc_push_component(desc, 20);
    w = ecs_oec_world_add_observer(w, 70, desc);
    w = ecs_oec_world_set_emap_k1_c10(w, ecs_oec_emap_insert(ecs_oec_emap_new(), 5, 11));
    w = ecs_oec_world_set_emap_k1_c20(w, ecs_oec_emap_insert(ecs_oec_emap_new(), 5, 22));
    let r = ecs_oec_clone_entity(b, w);
    w = r.1;
    let a = ecs_oec_world_emap_k1_c10_get(w, 6);
    let bmap = ecs_oec_world_emap_k1_c20_get(w, 6);
    if a.0 != true { panic(109690); };
    if a.1 != 11 { panic(109691); };
    if bmap.0 != true { panic(109692); };
    if bmap.1 != 22 { panic(109693); };
}

@test "two_observers_both_updated"() {
    let b = ecs_oec_builder_add_observers(ecs_oec_builder_new(), true);
    let w = ecs_oec_world_new(1, 2);
    let obs = ecs_oec_observed_by_new();
    obs = ecs_oec_observed_by_push(obs, 50);
    obs = ecs_oec_observed_by_push(obs, 51);
    w = ecs_oec_world_set_source_obs(w, obs);
    let d0 = ecs_oec_desc_push_entity(ecs_oec_desc_new(), 1);
    d0 = ecs_oec_desc_push_event_key(d0, 1);
    let d1 = ecs_oec_desc_push_entity(ecs_oec_desc_new(), 1);
    d1 = ecs_oec_desc_push_event_key(d1, 2);
    w = ecs_oec_world_add_observer(w, 50, d0);
    w = ecs_oec_world_add_observer(w, 51, d1);
    w = ecs_oec_world_set_emap_k1(w, ecs_oec_emap_insert(ecs_oec_emap_new(), 1, 1));
    w = ecs_oec_world_set_emap_k2(w, ecs_oec_emap_insert(ecs_oec_emap_new(), 1, 2));
    let r = ecs_oec_clone_entity(b, w);
    w = r.1;
    if ecs_oec_world_obs_has_target(w, 50, 2) != true { panic(109700); };
    if ecs_oec_world_obs_has_target(w, 51, 2) != true { panic(109701); };
    if ecs_oec_world_emap_k1_get(w, 2).0 != true { panic(109702); };
    if ecs_oec_world_emap_k2_get(w, 2).0 != true { panic(109703); };
}

@test "clone_count_increments_always"() {
    let b = ecs_oec_builder_new();
    let w = ecs_oec_world_new(1, 2);
    let r1 = ecs_oec_clone_entity(b, w);
    let r2 = ecs_oec_clone_entity(r1.0, r1.1);
    if ecs_oec_builder_clone_count(r2.0) != 2 { panic(109710); };
}

@test "emap_update_existing_entity"() {
    let m = ecs_oec_emap_insert(ecs_oec_emap_new(), 1, 5);
    m = ecs_oec_emap_insert(m, 1, 9);
    if ecs_oec_emap_len(m) != 1 { panic(109720); };
    if ecs_oec_emap_get(m, 1).1 != 9 { panic(109721); };
}

@test "missing_source_map_entry_no_target"() {
    let m = ecs_oec_emap_new();
    m = ecs_oec_emap_clone_entry(m, 1, 2);
    if ecs_oec_emap_get(m, 2).0 != false { panic(109730); };
    if ecs_oec_emap_len(m) != 0 { panic(109731); };
}

@test "behavior_constants"() {
    if ECS_OEC_BEHAVIOR_DEFAULT != 0 { panic(109740); };
    if ECS_OEC_BEHAVIOR_CUSTOM_OBSERVED_BY != 1 { panic(109741); };
    if ECS_OEC_BEHAVIOR_REMOVED_OVERRIDE != 2 { panic(109742); };
}
