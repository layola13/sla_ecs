@import "lib/entity_hash_map_derived_extras.sla"

// Isolated tests for lib/entity_hash_map_derived_extras.sla.
// Bevy reference: bevy_ecs/src/entity/hash_map.rs derived wrappers and iterator traits.

fn make_ehm4_entries() -> Vec<EcsEhm4Pair> {
    let entries: Vec<EcsEhm4Pair> = Vec::new();
    entries.push(ecs_ehm4_pair(1, 10));
    entries.push(ecs_ehm4_pair(2, 20));
    entries.push(ecs_ehm4_pair(1, 15));
    entries.push(ecs_ehm4_pair(3, 30));
    return entries;
}

fn make_ehm4_map() -> EcsEhm4Map {
    return ecs_ehm4_from_iter(make_ehm4_entries());
}

@test "entity hash map derived extras new default capacity markers"() {
    let fresh = ecs_ehm4_new();
    let defaulted = ecs_ehm4_default();
    let capped = ecs_ehm4_with_capacity(13);
    let clamped = ecs_ehm4_with_capacity(-4);
    if ecs_ehm4_len(fresh) != 0 { panic(92864); };
    if ecs_ehm4_debug_kind(fresh) != 1 { panic(92865); };
    if ecs_ehm4_debug_kind(defaulted) != 2 { panic(92866); };
    if capped.capacity_hint != 13 { panic(92867); };
    if clamped.capacity_hint != 0 { panic(92868); };
}

@test "entity hash map derived extras clone preserves value and capacity"() {
    let map = ecs_ehm4_with_capacity(8);
    let inserted = ecs_ehm4_insert(map, 7, 70);
    let cloned = ecs_ehm4_clone(inserted.map);
    let found = ecs_ehm4_get(cloned, 7);
    if ecs_ehm4_debug_kind(cloned) != 4 { panic(92869); };
    if cloned.capacity_hint != 8 { panic(92870); };
    if found.value != 70 { panic(92871); };
}

@test "entity hash map derived extras from hash map and into inner"() {
    let wrapped = ecs_ehm4_from_hash_map(make_ehm4_map());
    let alias = ecs_ehm4_from_index_map(make_ehm4_map());
    let inner = ecs_ehm4_into_inner(wrapped);
    if ecs_ehm4_debug_kind(wrapped) != 6 { panic(92872); };
    if ecs_ehm4_len(alias) != 3 { panic(92873); };
    if ecs_ehm4_inner_len(inner) != 3 { panic(92874); };
}

@test "entity hash map derived extras extend owned replaces duplicates"() {
    let map = ecs_ehm4_extend_owned(ecs_ehm4_new(), make_ehm4_entries());
    let first = ecs_ehm4_get(map, 1);
    if ecs_ehm4_len(map) != 3 { panic(92875); };
    if first.value != 15 { panic(92876); };
}

@test "entity hash map derived extras extend ref pairs"() {
    let refs: Vec<EcsEhm4Pair> = Vec::new();
    refs.push(ecs_ehm4_pair(2, 22));
    refs.push(ecs_ehm4_pair(4, 40));
    let map = ecs_ehm4_extend_ref_pairs(make_ehm4_map(), refs);
    let replaced = ecs_ehm4_get(map, 2);
    let appended = ecs_ehm4_get(map, 4);
    if ecs_ehm4_len(map) != 4 { panic(92877); };
    if replaced.value != 22 { panic(92878); };
    if appended.value != 40 { panic(92879); };
}

@test "entity hash map derived extras extend ref kv"() {
    let keys: Vec<i64> = Vec::new();
    keys.push(3);
    keys.push(5);
    let values: Vec<i64> = Vec::new();
    values.push(33);
    values.push(50);
    let map = ecs_ehm4_extend_ref_kv(make_ehm4_map(), keys, values);
    if ecs_ehm4_len(map) != 4 { panic(92880); };
    if ecs_ehm4_index_entity_equivalent(map, 3) != 33 { panic(92881); };
    if ecs_ehm4_index_entity_equivalent(map, 5) != 50 { panic(92882); };
}

@test "entity hash map derived extras extend ref kv ignores extra keys"() {
    let keys: Vec<i64> = Vec::new();
    keys.push(5);
    keys.push(6);
    let values: Vec<i64> = Vec::new();
    values.push(50);
    let map = ecs_ehm4_extend_ref_kv(make_ehm4_map(), keys, values);
    if ecs_ehm4_len(map) != 4 { panic(92883); };
    if ecs_ehm4_index_entity_equivalent(map, 6) != -1 { panic(92884); };
}

@test "entity hash map derived extras from array capacity marker"() {
    let map = ecs_ehm4_from_array4(5, 50, 6, 60, 5, 55, 7, 70);
    let replaced = ecs_ehm4_get(map, 5);
    if ecs_ehm4_len(map) != 3 { panic(92885); };
    if map.capacity_hint != 4 { panic(92886); };
    if ecs_ehm4_debug_kind(map) != 5 { panic(92887); };
    if replaced.value != 55 { panic(92888); };
}

@test "entity hash map derived extras eq inner ignores order"() {
    let inner: Vec<EcsEhm4Pair> = Vec::new();
    inner.push(ecs_ehm4_pair(3, 30));
    inner.push(ecs_ehm4_pair(1, 15));
    inner.push(ecs_ehm4_pair(2, 20));
    if ecs_ehm4_eq_inner(make_ehm4_map(), inner) != true { panic(92889); };
}

@test "entity hash map derived extras eq inner detects value mismatch"() {
    let inner: Vec<EcsEhm4Pair> = Vec::new();
    inner.push(ecs_ehm4_pair(1, 15));
    inner.push(ecs_ehm4_pair(2, 99));
    inner.push(ecs_ehm4_pair(3, 30));
    if ecs_ehm4_eq_inner(make_ehm4_map(), inner) != false { panic(92890); };
}

@test "entity hash map derived extras iterator debug markers"() {
    let iter = ecs_ehm4_iter(make_ehm4_map());
    let iter_mut = ecs_ehm4_iter_mut(make_ehm4_map());
    let owned = ecs_ehm4_into_iter(make_ehm4_map());
    let keys = ecs_ehm4_keys(make_ehm4_map());
    let into_keys = ecs_ehm4_into_keys(make_ehm4_map());
    if ecs_ehm4_iter_debug_kind(iter) != 10 { panic(92891); };
    if ecs_ehm4_iter_debug_kind(iter_mut) != 11 { panic(92892); };
    if iter_mut.mutable_view != 1 { panic(92893); };
    if ecs_ehm4_iter_debug_kind(owned) != 20 { panic(92894); };
    if keys.trusted_unique != 1 { panic(92895); };
    if into_keys.debug_kind != 50 { panic(92896); };
}

@test "entity hash map derived extras iter size hint tracks next"() {
    let iter = ecs_ehm4_iter(make_ehm4_map());
    let hint = ecs_ehm4_size_hint(iter);
    let next = ecs_ehm4_iter_next(iter);
    let after = ecs_ehm4_size_hint(next.iter);
    if hint.lower != 3 { panic(92897); };
    if next.key != 1 { panic(92898); };
    if next.value != 15 { panic(92899); };
    if after.lower != 2 { panic(92900); };
}

@test "entity hash map derived extras keys size hint clone and next"() {
    let key_iter = ecs_ehm4_keys(make_ehm4_map());
    let first = ecs_ehm4_key_next(key_iter);
    let cloned = ecs_ehm4_iter_clone(first.iter);
    let second = ecs_ehm4_key_next(cloned);
    let hint = ecs_ehm4_size_hint(second.iter);
    if first.key != 1 { panic(92901); };
    if second.key != 2 { panic(92902); };
    if hint.lower != 1 { panic(92903); };
}

@test "entity hash map derived extras into keys inner marker"() {
    let first = ecs_ehm4_key_next(ecs_ehm4_into_keys(make_ehm4_map()));
    let inner = ecs_ehm4_iter_into_inner(first.iter);
    let second = ecs_ehm4_key_next(inner);
    if inner.inner_exposed != 1 { panic(92904); };
    if second.has != 1 { panic(92905); };
    if second.key != 2 { panic(92906); };
}

@test "entity hash map derived extras default keys empty trusted"() {
    let keys = ecs_ehm4_iter_default(40, 1);
    let into_keys = ecs_ehm4_iter_default(50, 1);
    let next = ecs_ehm4_key_next(keys);
    if next.has != 0 { panic(92907); };
    if next.iter.trusted_unique != 1 { panic(92908); };
    if into_keys.debug_kind != 50 { panic(92909); };
}

@test "entity hash map derived extras exhausted owned iterator"() {
    let empty = ecs_ehm4_into_iter(ecs_ehm4_new());
    let next = ecs_ehm4_iter_next(empty);
    if next.has != 0 { panic(92910); };
}
