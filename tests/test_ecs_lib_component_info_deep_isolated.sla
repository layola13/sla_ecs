@import "lib/component_info_deep.sla"

// Batch 243: component_info deep (src/component/info.rs).
// panic codes: 114600 – 114799.

@test "component_id_eq"() {
    let a = ecs_ci_id_new(3);
    let b = ecs_ci_id_new(3);
    let c = ecs_ci_id_new(4);
    if ecs_ci_id_index(a) != 3 { panic(114600); };
    if ecs_ci_id_eq(a, b) != true { panic(114601); };
    if ecs_ci_id_eq(a, c) != false { panic(114602); };
}

@test "descriptor_component_and_resource"() {
    let d = ecs_ci_desc_new(11);
    d = ecs_ci_desc_set_type_id(d, 99);
    d = ecs_ci_desc_set_layout(d, 16, 8);
    d = ecs_ci_desc_set_storage(d, ecs_ci_storage_sparse());
    d = ecs_ci_desc_set_drop(d, true);
    d = ecs_ci_desc_set_clone(d, ecs_ci_clone_ignore());
    let info = ecs_ci_info_from_descriptor(1, d);
    if ecs_ci_info_id(info) != 1 { panic(114610); };
    if ecs_ci_info_name(info) != 11 { panic(114611); };
    if ecs_ci_info_storage_type(info) != ecs_ci_storage_sparse() { panic(114612); };
    if ecs_ci_info_has_drop(info) != true { panic(114613); };
    if ecs_ci_info_clone_behavior(info) != ecs_ci_clone_ignore() { panic(114614); };
    if ecs_ci_info_type_id(info).0 != true { panic(114615); };
    if ecs_ci_info_type_id(info).1 != 99 { panic(114616); };
    if ecs_ci_info_layout(info).0 != 16 { panic(114617); };
    if ecs_ci_info_layout(info).1 != 8 { panic(114618); };
    let r = ecs_ci_desc_new_resource(22);
    let ri = ecs_ci_info_from_descriptor(2, r);
    if ecs_ci_info_is_resource(ri) != true { panic(114619); };
    if ecs_ci_info_storage_type(ri) != ecs_ci_storage_table() { panic(114620); };
}

@test "descriptor_non_send"() {
    let d = ecs_ci_desc_new_non_send(5, ecs_ci_storage_table());
    let info = ecs_ci_info_from_descriptor(0, d);
    if ecs_ci_info_is_send_and_sync(info) != false { panic(114630); };
    if ecs_ci_info_storage_type(info) != 0 { panic(114631); };
}

@test "mutable_and_relationship"() {
    let d = ecs_ci_desc_new(1);
    d = ecs_ci_desc_set_mutable(d, false);
    d = ecs_ci_desc_set_relationship(d, 1);
    let info = ecs_ci_info_from_descriptor(3, d);
    if ecs_ci_info_mutable(info) != false { panic(114640); };
    if ecs_ci_info_relationship(info) != 1 { panic(114641); };
}

@test "hooks_and_archetype_flags"() {
    let d = ecs_ci_desc_new(1);
    let info = ecs_ci_info_from_descriptor(0, d);
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_add());
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_remove());
    if ecs_ci_info_has_hook(info, ecs_ci_hook_on_add()) != true { panic(114650); };
    if ecs_ci_info_has_hook(info, ecs_ci_hook_on_insert()) != false { panic(114651); };
    if ecs_ci_info_has_hook(info, ecs_ci_hook_on_remove()) != true { panic(114652); };
    let flags = 0;
    flags = ecs_ci_update_archetype_flags(info, flags);
    if (flags & ecs_ci_hook_on_add()) == 0 { panic(114653); };
    if (flags & ecs_ci_hook_on_remove()) == 0 { panic(114654); };
    if (flags & ecs_ci_hook_on_despawn()) != 0 { panic(114655); };
}

@test "required_and_required_by"() {
    let d = ecs_ci_desc_new(1);
    let info = ecs_ci_info_from_descriptor(0, d);
    info = ecs_ci_info_set_required_count(info, 2);
    if ecs_ci_info_required_count(info) != 2 { panic(114660); };
    info = ecs_ci_info_add_required_by(info, 10);
    info = ecs_ci_info_add_required_by(info, 11);
    info = ecs_ci_info_add_required_by(info, 10); // de-dup
    if ecs_ci_info_required_by_count(info) != 2 { panic(114661); };
    if ecs_ci_info_required_by_at(info, 0) != 10 { panic(114662); };
    if ecs_ci_info_required_by_at(info, 1) != 11 { panic(114663); };
}

@test "clone_resolve"() {
    if ecs_ci_clone_resolve(ecs_ci_clone_default(), ecs_ci_clone_custom()) != ecs_ci_clone_custom() { panic(114670); };
    if ecs_ci_clone_resolve(ecs_ci_clone_ignore(), ecs_ci_clone_custom()) != ecs_ci_clone_ignore() { panic(114671); };
    if ecs_ci_clone_default() != 0 { panic(114672); };
    if ecs_ci_clone_ignore() != 1 { panic(114673); };
    if ecs_ci_clone_custom() != 2 { panic(114674); };
}

@test "storage_type_constants"() {
    if ecs_ci_storage_table() != 0 { panic(114680); };
    if ecs_ci_storage_sparse() != 1 { panic(114681); };
}

@test "all_hook_bits"() {
    let d = ecs_ci_desc_new(1);
    let info = ecs_ci_info_from_descriptor(0, d);
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_add());
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_insert());
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_discard());
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_remove());
    info = ecs_ci_info_enable_hook(info, ecs_ci_hook_on_despawn());
    let flags = ecs_ci_update_archetype_flags(info, 0);
    if flags != 31 { panic(114690); };
}

@test "info_from_full_descriptor"() {
    let d = ecs_ci_desc_new(77);
    d = ecs_ci_desc_set_type_id(d, 123);
    d = ecs_ci_desc_set_layout(d, 4, 4);
    d = ecs_ci_desc_set_storage(d, ecs_ci_storage_table());
    d = ecs_ci_desc_set_mutable(d, true);
    d = ecs_ci_desc_set_clone(d, ecs_ci_clone_default());
    let info = ecs_ci_info_from_descriptor(9, d);
    if ecs_ci_info_id(info) != 9 { panic(114700); };
    if ecs_ci_info_is_resource(info) != false { panic(114701); };
    if ecs_ci_info_is_send_and_sync(info) != true { panic(114702); };
    if ecs_ci_info_mutable(info) != true { panic(114703); };
}
