// Isolated deep tests for lib/schedule_archetype_value_deep.sla (Batch 372).
// archetype-value schedule: cap-8 systems with cap-4 read/write component-id lists + packed
// 2-bit resource/messages arena flag matrix.
// panic codes: 140400 - 140599.

@import "lib/schedule_archetype_value_deep.sla"

const CID_POS: i32 = 1;
const CID_VEL: i32 = 2;
const CID_HP: i32 = 11;
const CID_MP: i32 = 12;

@test "Schedule default empty zero conflicts"() {
    let s = ecs_arch_value_schedule_default();
    if ecs_arch_value_schedule_len(s) != 0 { panic(140400); };
    if ecs_arch_value_schedule_conflict_count(s) != 0 { panic(140401); };
}

@test "Access none empty and resource/messages flag mutators (packed bits)"() {
    let a = ecs_arch_value_access_none();
    if ecs_arch_value_len_reads(a) != 0 { panic(140410); };
    if ecs_arch_value_len_writes(a) != 0 { panic(140411); };
    if ecs_arch_value_reads_resource(a) != 0 { panic(140412); };
    if ecs_arch_value_writes_resource(a) != 0 { panic(140413); };
    if ecs_arch_value_reads_messages(a) != 0 { panic(140414); };
    if ecs_arch_value_writes_messages(a) != 0 { panic(140415); };
    let ar = ecs_arch_value_access_read_resource(a);
    if ecs_arch_value_reads_resource(ar) != 1 { panic(140416); };
    if ecs_arch_value_reads_messages(ar) != 0 { panic(140417); };
    let aw = ecs_arch_value_access_write_resource(ar);
    if ecs_arch_value_writes_resource(aw) != 1 { panic(140418); };
    let amr = ecs_arch_value_access_read_messages(aw);
    if ecs_arch_value_reads_messages(amr) != 1 { panic(140419); };
    if ecs_arch_value_reads_resource(amr) != 1 { panic(140420); };
    let amw = ecs_arch_value_access_write_messages(amr);
    if ecs_arch_value_writes_messages(amw) != 1 { panic(140421); };
    if ecs_arch_value_writes_resource(amw) != 1 { panic(140422); };
}

@test "Access read/write component mutators store archetype-world component ids"() {
    let a0 = ecs_arch_value_access_none();
    let a1 = ecs_arch_value_access_read_component(a0, CID_POS);
    let a2 = ecs_arch_value_access_write_component(a1, CID_POS);
    if ecs_arch_value_len_reads(a2) != 1 { panic(140430); };
    if ecs_arch_value_len_writes(a2) != 1 { panic(140431); };
    if ecs_arch_value_read_at(a2, 0) != CID_POS { panic(140432); };
    if ecs_arch_value_write_at(a2, 0) != CID_POS { panic(140433); };
    let a3 = ecs_arch_value_access_read_component(a2, CID_VEL);
    let a4 = ecs_arch_value_access_write_component(a3, CID_HP);
    if ecs_arch_value_len_reads(a4) != 2 { panic(140434); };
    if ecs_arch_value_len_writes(a4) != 2 { panic(140435); };
    if ecs_arch_value_read_at(a4, 1) != CID_VEL { panic(140436); };
    if ecs_arch_value_write_at(a4, 1) != CID_HP { panic(140437); };
}

@test "Access read/write list cap-4 rejection"() {
    let a0 = ecs_arch_value_access_none();
    let a1 = ecs_arch_value_access_read_component(a0, 1);
    let a2 = ecs_arch_value_access_read_component(a1, 2);
    let a3 = ecs_arch_value_access_read_component(a2, 3);
    let a4 = ecs_arch_value_access_read_component(a3, 4);
    let a5 = ecs_arch_value_access_read_component(a4, 5);
    if ecs_arch_value_len_reads(a5) != 4 { panic(140440); };
    if ecs_arch_value_read_at(a5, 3) != 4 { panic(140441); };
    let a6 = ecs_arch_value_access_write_component(ecs_arch_value_access_none(), 10);
    let a7 = ecs_arch_value_access_write_component(a6, 11);
    let a8 = ecs_arch_value_access_write_component(a7, 12);
    let a9 = ecs_arch_value_access_write_component(a8, 13);
    let a10 = ecs_arch_value_access_write_component(a9, 14);
    if ecs_arch_value_len_writes(a10) != 4 { panic(140442); };
    if ecs_arch_value_write_at(a10, 3) != 13 { panic(140443); };
}

@test "Component conflict detection via writes_touch helper (both directions)"() {
    let write_pos = ecs_arch_value_access_write_component(ecs_arch_value_access_none(), CID_POS);
    let read_pos = ecs_arch_value_access_read_component(ecs_arch_value_access_none(), CID_POS);
    let write_vel = ecs_arch_value_access_write_component(ecs_arch_value_access_none(), CID_VEL);
    let read_vel = ecs_arch_value_access_read_component(ecs_arch_value_access_none(), CID_VEL);
    // write vs read on same id conflicts (writes_touch detects either direction).
    if ecs_arch_value_access_conflicts(write_pos, read_pos) != true { panic(140450); };
    if ecs_arch_value_access_conflicts(read_pos, write_pos) != true { panic(140451); };
    if ecs_arch_value_access_conflicts(write_pos, write_pos) != true { panic(140452); };
    if ecs_arch_value_access_conflicts(write_pos, read_vel) != false { panic(140453); };
    if ecs_arch_value_access_conflicts(write_pos, write_vel) != false { panic(140454); };
    if ecs_arch_value_access_conflicts(read_pos, read_pos) != false { panic(140455); };
}

@test "Resource and message arena conflict detection (packed-bit matrix)"() {
    let read_res = ecs_arch_value_access_read_resource(ecs_arch_value_access_none());
    let write_res = ecs_arch_value_access_write_resource(ecs_arch_value_access_none());
    let read_msg = ecs_arch_value_access_read_messages(ecs_arch_value_access_none());
    let write_msg = ecs_arch_value_access_write_messages(ecs_arch_value_access_none());
    if ecs_arch_value_access_conflicts(write_res, read_res) != true { panic(140460); };
    if ecs_arch_value_access_conflicts(write_res, write_res) != true { panic(140461); };
    if ecs_arch_value_access_conflicts(read_res, read_res) != false { panic(140462); };
    if ecs_arch_value_access_conflicts(write_msg, read_msg) != true { panic(140463); };
    if ecs_arch_value_access_conflicts(write_msg, write_msg) != true { panic(140464); };
    if ecs_arch_value_access_conflicts(read_msg, read_msg) != false { panic(140465); };
    if ecs_arch_value_access_conflicts(write_res, write_msg) != false { panic(140466); };
    if ecs_arch_value_access_conflicts(write_res, read_msg) != false { panic(140467); };
    if ecs_arch_value_access_conflicts(write_msg, read_res) != false { panic(140468); };
    // combined access: read both arenas + write resource — read_res as one and read_msg as
    // another side's reader; ensures packed-bit fields don't bleed.
    let r_res_msg = ecs_arch_value_access_read_messages(ecs_arch_value_access_read_resource(ecs_arch_value_access_none()));
    if ecs_arch_value_reads_resource(r_res_msg) != 1 { panic(140469); };
    if ecs_arch_value_reads_messages(r_res_msg) != 1 { panic(140470); };
    if ecs_arch_value_access_conflicts(write_res, r_res_msg) != true { panic(140471); };
    if ecs_arch_value_access_conflicts(write_msg, r_res_msg) != true { panic(140472); };
}

@test "schedule_add_systems records one conflict per conflicting earlier system"() {
    let write_pos = ecs_arch_value_access_write_component(ecs_arch_value_access_none(), CID_POS);
    let read_pos = ecs_arch_value_access_read_component(ecs_arch_value_access_none(), CID_POS);
    let write_hp = ecs_arch_value_access_write_component(ecs_arch_value_access_none(), CID_HP);
    let s0 = ecs_arch_value_schedule_default();
    let s1 = ecs_arch_value_schedule_add_systems(s0, write_pos);
    let s2 = ecs_arch_value_schedule_add_systems(s1, read_pos);
    if ecs_arch_value_schedule_conflict_count(s2) != 1 { panic(140480); };
    if ecs_arch_value_schedule_len(s2) != 2 { panic(140481); };
    let s3 = ecs_arch_value_schedule_add_systems(s2, write_hp);
    if ecs_arch_value_schedule_conflict_count(s3) != 1 { panic(140482); };
    if ecs_arch_value_schedule_len(s3) != 3 { panic(140483); };
    let s4 = ecs_arch_value_schedule_add_systems(s3, read_pos);
    if ecs_arch_value_schedule_conflict_count(s4) != 2 { panic(140484); };
    if ecs_arch_value_schedule_len(s4) != 4 { panic(140485); };
}

@test "schedule_add_systems access retrievable per slot via access_at"() {
    let s0 = ecs_arch_value_schedule_default();
    let a_read = ecs_arch_value_access_read_component(ecs_arch_value_access_none(), CID_HP);
    let a_write = ecs_arch_value_access_write_component(ecs_arch_value_access_none(), CID_HP);
    let a_msg = ecs_arch_value_access_write_messages(ecs_arch_value_access_none());
    let s1 = ecs_arch_value_schedule_add_systems(s0, a_read);
    let s2 = ecs_arch_value_schedule_add_systems(s1, a_write);
    let s3 = ecs_arch_value_schedule_add_systems(s2, a_msg);
    if ecs_arch_value_schedule_len(s3) != 3 { panic(140490); };
    let a0 = ecs_arch_value_access_at(s3, 0);
    if ecs_arch_value_read_at(a0, 0) != CID_HP { panic(140491); };
    if ecs_arch_value_len_reads(a0) != 1 { panic(140492); };
    let a1 = ecs_arch_value_access_at(s3, 1);
    if ecs_arch_value_write_at(a1, 0) != CID_HP { panic(140493); };
    if ecs_arch_value_len_writes(a1) != 1 { panic(140494); };
    let a2 = ecs_arch_value_access_at(s3, 2);
    if ecs_arch_value_writes_messages(a2) != 1 { panic(140495); };
    if ecs_arch_value_schedule_conflict_count(s3) != 1 { panic(140496); };
}

@test "schedule cap-8 rejection and clear resets"() {
    let s0 = ecs_arch_value_schedule_default();
    let s1 = s0;
    let i: i32 = 0;
    while i < 8 {
        let next = ecs_arch_value_schedule_add_systems(s1, ecs_arch_value_access_read_component(ecs_arch_value_access_none(), 100 + i));
        s1 = next;
        i = i + 1;
    }
    if ecs_arch_value_schedule_len(s1) != 8 { panic(140500); };
    if ecs_arch_value_schedule_conflict_count(s1) != 0 { panic(140501); };
    let s2 = ecs_arch_value_schedule_add_systems(s1, ecs_arch_value_access_read_component(ecs_arch_value_access_none(), 200));
    if ecs_arch_value_schedule_len(s2) != 8 { panic(140502); };
    let s3 = ecs_arch_value_schedule_clear(s2);
    if ecs_arch_value_schedule_len(s3) != 0 { panic(140503); };
    if ecs_arch_value_schedule_conflict_count(s3) != 0 { panic(140504); };
}

@test "packed-bit fields don't leak across arenas under writes_touch + arena_conflict"() {
    // Build access with read_resource + write_messages (independent arena bits that must not
    // cross-talk in the packed-bit field). Low bit (resource) read=1, messages bit (1<<1)
    // write. Reads-data on resource, writes-data on messages.
    let a = ecs_arch_value_access_write_messages(ecs_arch_value_access_read_resource(ecs_arch_value_access_none()));
    if ecs_arch_value_reads_resource(a) != 1 { panic(140510); };
    if ecs_arch_value_writes_resource(a) != 0 { panic(140511); };
    if ecs_arch_value_reads_messages(a) != 0 { panic(140512); };
    if ecs_arch_value_writes_messages(a) != 1 { panic(140513); };
    // a reads resource + writes messages. b writes resource -> CONFLICT on resource arena
    // (b writes resource, a reads resource). Packed-bit field keeps the conflicts on the
    // right arena, and does not erroneously tie the messages write to the resource read.
    let b = ecs_arch_value_access_write_resource(ecs_arch_value_access_none());
    if ecs_arch_value_access_conflicts(a, b) != true { panic(140514); };
    // a writes messages; c reads messages -> conflict on the messages arena only.
    let c = ecs_arch_value_access_read_messages(ecs_arch_value_access_none());
    if ecs_arch_value_access_conflicts(a, c) != true { panic(140515); };
    // a writes messages only (drop the resource read on a fresh copy) + d reads resource only
    // -- genuine arena independence, both packed writes/reads on disjoint arenas, no conflict.
    let a_msg_only = ecs_arch_value_access_write_messages(ecs_arch_value_access_none());
    let d = ecs_arch_value_access_read_resource(ecs_arch_value_access_none());
    if ecs_arch_value_access_conflicts(a_msg_only, d) != false { panic(140516); };
}
