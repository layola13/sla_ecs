// Isolated deep tests for lib/app_type_registry_deep.sla (Batch 400).
// Mirrors AppTypeRegistry/AppFunctionRegistry: descriptor + type data + result wrappers, fixed-cap.
// panic codes: 144400 - 144499 (Batch 400 band; previous Batch 399 used 144300-144395).

@import "lib/app_type_registry_deep.sla"

fn reg_type(r: EcsAtrTypeRegistry, id: i64, path: i64, short: i64) -> EcsAtrTypeRegistry {
    return ecs_atr_type_registry_register_or_replace(r, ecs_atr_descriptor_new(id, path, short));
}

@test "EcsAtrTypeRegistry register and get descriptor"() {
    let r0 = ecs_atr_type_registry_new();
    let r1 = reg_type(r0, 100, 200, 300);
    if ecs_atr_type_registry_len(r1) != 1 { panic(144400); };
    if ecs_atr_type_registry_contains(r1, 100) != true { panic(144401); };
    if ecs_atr_type_registry_contains(r1, 999) != false { panic(144402); };
    let res = ecs_atr_type_registry_get(r1, 100);
    if res.has != 1 { panic(144403); };
    if ecs_atr_descriptor_type_id(res.descriptor) != 100 { panic(144404); };
    if ecs_atr_descriptor_type_path(res.descriptor) != 200 { panic(144405); };
    if ecs_atr_descriptor_short_type_path(res.descriptor) != 300 { panic(144406); };
    let missing = ecs_atr_type_registry_get(r1, 999);
    if missing.has != 0 { panic(144407); };
}

@test "EcsAtrTypeRegistry register_or_replace updates existing"() {
    let r0 = ecs_atr_type_registry_new();
    let r1 = reg_type(r0, 100, 200, 300);
    let r2 = reg_type(r1, 100, 201, 301);
    if ecs_atr_type_registry_len(r2) != 1 { panic(144410); };
    let res = ecs_atr_type_registry_get(r2, 100);
    if ecs_atr_descriptor_type_path(res.descriptor) != 201 { panic(144411); };
    if ecs_atr_descriptor_short_type_path(res.descriptor) != 301 { panic(144412); };
}

@test "EcsAtrTypeRegistry type data set and query"() {
    let r0 = ecs_atr_type_registry_new();
    let r1 = reg_type(r0, 200, 0, 0);
    let r2 = ecs_atr_type_registry_register_type_data(r1, 200, ECS_ATR_DATA_COMPONENT, 5000);
    let r3 = ecs_atr_type_registry_register_type_data(r2, 200, ECS_ATR_DATA_RESOURCE, 6000);
    if ecs_atr_type_registry_has_type_data(r3, 200, ECS_ATR_DATA_COMPONENT) != true { panic(144420); };
    if ecs_atr_type_registry_has_type_data(r3, 200, ECS_ATR_DATA_EVENT) != false { panic(144421); };
    let comp = ecs_atr_type_registry_type_data(r3, 200, ECS_ATR_DATA_COMPONENT);
    if comp.has != 1 { panic(144422); };
    if comp.data != 5000 { panic(144423); };
    let res = ecs_atr_type_registry_type_data(r3, 200, ECS_ATR_DATA_RESOURCE);
    if res.data != 6000 { panic(144424); };
    let r4 = ecs_atr_type_registry_register_type_data(r3, 999, ECS_ATR_DATA_COMPONENT, 7000);
    if ecs_atr_type_registry_len(r4) != 1 { panic(144425); };
}

@test "EcsAtrTypeRegistry at and empty results"() {
    let r0 = ecs_atr_type_registry_new();
    let r1 = reg_type(r0, 300, 0, 0);
    let r2 = reg_type(r1, 301, 0, 0);
    let at0 = ecs_atr_type_registry_at(r2, 0);
    if at0.has != 1 { panic(144430); };
    if ecs_atr_descriptor_type_id(at0.descriptor) != 300 { panic(144431); };
    let at1 = ecs_atr_type_registry_at(r2, 1);
    if ecs_atr_descriptor_type_id(at1.descriptor) != 301 { panic(144432); };
    let neg = ecs_atr_type_registry_at(r2, -1);
    if neg.has != 0 { panic(144433); };
    let oob = ecs_atr_type_registry_at(r2, 5);
    if oob.has != 0 { panic(144434); };
}

@test "EcsAtrTypeRegistry cap rejects ninth registration"() {
    let r = ecs_atr_type_registry_new();
    let i: i32 = 0;
    while i < 8 {
        r = reg_type(r, 1000 + i as i64, 0, 0);
        i = i + 1;
    }
    if ecs_atr_type_registry_len(r) != 8 { panic(144440); };
    r = reg_type(r, 1008, 0, 0);
    if ecs_atr_type_registry_len(r) != 8 { panic(144441); };
    if ecs_atr_type_registry_contains(r, 1012) != false { panic(144442); };
}

@test "EcsAtrFunctionRegistry register get and replace"() {
    let r0 = ecs_atr_function_registry_new();
    let r1 = ecs_atr_function_registry_register_or_replace(r0, ecs_atr_function_descriptor_new(10, 20, 30));
    if ecs_atr_function_registry_len(r1) != 1 { panic(144450); };
    if ecs_atr_function_registry_contains(r1, 10) != true { panic(144451); };
    let res = ecs_atr_function_registry_get(r1, 10);
    if res.has != 1 { panic(144452); };
    if ecs_atr_function_descriptor_function_id(res.descriptor) != 10 { panic(144453); };
    if ecs_atr_function_descriptor_name(res.descriptor) != 20 { panic(144454); };
    if ecs_atr_function_descriptor_function_handle(res.descriptor) != 30 { panic(144455); };
    let r2 = ecs_atr_function_registry_register_or_replace(r1, ecs_atr_function_descriptor_new(10, 21, 31));
    if ecs_atr_function_registry_len(r2) != 1 { panic(144456); };
    let res2 = ecs_atr_function_registry_get(r2, 10);
    if ecs_atr_function_descriptor_name(res2.descriptor) != 21 { panic(144457); };
    let at0 = ecs_atr_function_registry_at(r2, 0);
    if at0.has != 1 { panic(144458); };
    let missing = ecs_atr_function_registry_get(r2, 999);
    if missing.has != 0 { panic(144459); };
    let oob = ecs_atr_function_registry_at(r2, 5);
    if oob.has != 0 { panic(144460); };
}

@test "EcsAtrFunctionRegistry cap rejects ninth registration"() {
    let r = ecs_atr_function_registry_new();
    let i: i32 = 0;
    while i < 8 {
        r = ecs_atr_function_registry_register_or_replace(r, ecs_atr_function_descriptor_new(100 + i as i64, 0, 0));
        i = i + 1;
    }
    if ecs_atr_function_registry_len(r) != 8 { panic(144470); };
    r = ecs_atr_function_registry_register_or_replace(r, ecs_atr_function_descriptor_new(108, 0, 0));
    if ecs_atr_function_registry_len(r) != 8 { panic(144471); };
    if ecs_atr_function_registry_contains(r, 112) != false { panic(144472); };
}
