@import "lib/error_command_handling_deep.sla"

// Batch 286: error_command_handling deep (src/error/command_handling.rs).
// panic codes: 123200 – 123399.

@test "command_output_unit_and_never_to_err_none"() {
    let u = ecs_ech_cmd_out_unit();
    let te = ecs_ech_cmd_out_to_err(u);
    if ecs_ech_to_err_has(te) != false { panic(123200); };
    let n = ecs_ech_cmd_out_never();
    let te2 = ecs_ech_cmd_out_to_err(n);
    if ecs_ech_to_err_has(te2) != false { panic(123201); };
    let ok = ecs_ech_cmd_out_result_ok();
    if ecs_ech_to_err_has(ecs_ech_cmd_out_to_err(ok)) != false { panic(123202); };
}

@test "command_output_result_err_to_err_some"() {
    let e = ecs_ech_cmd_out_result_err(7, 99);
    let te = ecs_ech_cmd_out_to_err(e);
    if ecs_ech_to_err_has(te) != true { panic(123210); };
    if ecs_ech_to_err_code(te) != 7 { panic(123211); };
    if ecs_ech_to_err_message(te) != 99 { panic(123212); };
}

@test "entity_command_unit_into_result_ok"() {
    let o = ecs_ech_ent_out_unit();
    let r = ecs_ech_ent_out_into_result(o);
    if ecs_ech_into_ok(r) != true { panic(123220); };
    if ecs_ech_into_value(r) != 0 { panic(123221); };
}

@test "entity_command_result_ok_and_err"() {
    let o = ecs_ech_ent_out_result_ok(42);
    let r = ecs_ech_ent_out_into_result(o);
    if ecs_ech_into_ok(r) != true { panic(123230); };
    if ecs_ech_into_value(r) != 42 { panic(123231); };
    let e = ecs_ech_ent_out_result_err(5);
    let r2 = ecs_ech_ent_out_into_result(e);
    if ecs_ech_into_ok(r2) != false { panic(123232); };
    if ecs_ech_into_error_kind(r2) != 1 { panic(123233); };
    if ecs_ech_into_error_code(r2) != 5 { panic(123234); };
}

@test "entity_from_mutable_fetch_errors"() {
    let ns = ecs_ech_ent_out_from_fetch_not_spawned();
    let r = ecs_ech_ent_out_into_result(ns);
    if ecs_ech_into_ok(r) != false { panic(123240); };
    if ecs_ech_into_error_kind(r) != 2 { panic(123241); };
    let al = ecs_ech_ent_out_from_fetch_aliased();
    let r2 = ecs_ech_ent_out_into_result(al);
    if ecs_ech_into_error_kind(r2) != 3 { panic(123242); };
}

@test "entity_error_to_command_output"() {
    let e = ecs_ech_ent_out_result_err(11);
    let r = ecs_ech_ent_out_into_result(e);
    let out = ecs_ech_entity_error_to_cmd_out(r);
    let te = ecs_ech_cmd_out_to_err(out);
    if ecs_ech_to_err_has(te) != true { panic(123250); };
    if ecs_ech_to_err_code(te) != 11 { panic(123251); };
    // message_id encodes error_kind CommandFailed = 1
    if ecs_ech_to_err_message(te) != 1 { panic(123252); };
    let ok = ecs_ech_ent_out_result_ok(1);
    let out2 = ecs_ech_entity_error_to_cmd_out(ecs_ech_ent_out_into_result(ok));
    if ecs_ech_to_err_has(ecs_ech_cmd_out_to_err(out2)) != false { panic(123253); };
}

@test "handler_apply_only_on_error"() {
    let h = ecs_ech_handler_new(3);
    let hr = ecs_ech_handler_apply(h, ecs_ech_cmd_out_unit(), 10);
    if ecs_ech_handle_had_error(hr) != false { panic(123260); };
    if ecs_ech_handler_count(ecs_ech_handle_handler(hr)) != 0 { panic(123261); };
    let hr2 = ecs_ech_handler_apply(ecs_ech_handle_handler(hr), ecs_ech_cmd_out_result_err(4, 50), 10);
    if ecs_ech_handle_had_error(hr2) != true { panic(123262); };
    let h2 = ecs_ech_handle_handler(hr2);
    if ecs_ech_handler_count(h2) != 1 { panic(123263); };
    if ecs_ech_handler_last_code(h2) != 4 { panic(123264); };
    if ecs_ech_handler_last_message(h2) != 50 { panic(123265); };
    if ecs_ech_handler_last_ctx(h2) != 10 { panic(123266); };
}

@test "queue_handled_surfaces_error"() {
    let h = ecs_ech_handler_new(1);
    let q = ecs_ech_queue_handled(ecs_ech_cmd_out_result_err(9, 1));
    let ar = ecs_ech_queue_apply(q, h, 7);
    if ecs_ech_apply_queue_surfaced(ar) != true { panic(123270); };
    if ecs_ech_handler_count(ecs_ech_apply_queue_h(ar)) != 1 { panic(123271); };
    if ecs_ech_queue_applied(ecs_ech_apply_queue_q(ar)) != true { panic(123272); };
}

@test "queue_silenced_ignores_error"() {
    let h = ecs_ech_handler_new(2);
    let q = ecs_ech_queue_silenced(ecs_ech_cmd_out_result_err(9, 1));
    let ar = ecs_ech_queue_apply(q, h, 7);
    if ecs_ech_apply_queue_surfaced(ar) != false { panic(123280); };
    if ecs_ech_handler_count(ecs_ech_apply_queue_h(ar)) != 0 { panic(123281); };
    if ecs_ech_queue_mode(ecs_ech_apply_queue_q(ar)) != 1 { panic(123282); };
}

@test "queue_ok_no_surface"() {
    let h = ecs_ech_handler_new(0);
    let q = ecs_ech_queue_handled(ecs_ech_cmd_out_result_ok());
    let ar = ecs_ech_queue_apply(q, h, 0);
    if ecs_ech_apply_queue_surfaced(ar) != false { panic(123290); };
    let q2 = ecs_ech_queue_silenced(ecs_ech_cmd_out_unit());
    let ar2 = ecs_ech_queue_apply(q2, h, 0);
    if ecs_ech_apply_queue_surfaced(ar2) != false { panic(123291); };
    if ecs_ech_cmd_out_kind(ecs_ech_cmd_out_unit()) != 0 { panic(123292); };
    if ecs_ech_cmd_out_kind(ecs_ech_cmd_out_never()) != 1 { panic(123293); };
}
