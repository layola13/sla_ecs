// Isolated deep tests for lib/world_extras_deep.sla (Batch 414).
// Tests the world::extras module — 5 main module structs (RequiredRegistry, EntityAllocator,
// ResourceEntities, SpawnFacade, ComponentsQueue) plus the scalar UnsafeWorldCell and the 5 flat
// result-shim structs (ReqComp/ReqQuery/ReqNth/ResourceGet/QueueAt). Tuple-return replacement
// companions are read via last_* accessors (Batch 406 flatten pattern). No Vec parameterization:
// spawn_batch takes one caller-driven step per type via spawn_batch_step.

@import "lib/world_extras_deep.sla"

@test "req_err_kind_and_accessors"() {
    let e = ecs_req_err_kind_deep(2, 7, 9);
    if ecs_req_result_ok_deep(e) != 0 { panic(147160); };
    if ecs_req_result_kind_deep(e) != 2 { panic(147161); };
    if ecs_req_result_a_deep(e) != 7 { panic(147162); };
    if ecs_req_result_b_deep(e) != 9 { panic(147163); };
    if ecs_req_result_is_archetype_exists_deep(e) != true { panic(147164); };
    if ecs_req_result_is_dup_deep(e) != false { panic(147165); };
    if ecs_req_result_is_cyclic_deep(e) != false { panic(147166); };
}

@test "req_ok_placeholder"() {
    let e = ecs_req_ok_placeholder_deep();
    if ecs_req_result_ok_deep(e) != 1 { panic(147167); };
    if ecs_req_result_kind_deep(e) != 0 { panic(147168); };
}

@test "spawn_err_and_entity_fetch_err_classifiers"() {
    if ecs_spawn_err_invalid_deep() != 0 { panic(147169); };
    if ecs_spawn_err_already_spawned_deep() != 1 { panic(147170); };
    if ecs_spawn_err_is_invalid_deep(0) != true { panic(147171); };
    if ecs_spawn_err_is_already_spawned_deep(1) != true { panic(147172); };
    if ecs_entity_fetch_err_not_spawned_deep() != 0 { panic(147173); };
    if ecs_entity_fetch_err_aliased_mutability_deep() != 1 { panic(147174); };
    if ecs_entity_fetch_err_is_not_spawned_deep(0) != true { panic(147175); };
    if ecs_entity_fetch_err_is_aliased_deep(1) != true { panic(147176); };
}

@test "required_registry_new_empty"() {
    let r = ecs_world_req_registry_deep_new();
    if ecs_world_req_registry_deep_is_archetyped(r, 1) != false { panic(147177); };
}

@test "required_registry_register_component_grows_reg"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_register_component(r, 5);
    r = ecs_world_req_registry_deep_register_component(r, 6);
    if ecs_world_req_registry_deep_next_free_type_id(r, 0) != 1 { panic(147178); };
}

@test "required_registry_mark_archetyped"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_mark_archetyped(r, 9);
    if ecs_world_req_registry_deep_is_archetyped(r, 9) != true { panic(147179); };
    if ecs_world_req_registry_deep_is_archetyped(r, 8) != false { panic(147180); };
}

@test "required_registry_try_register_with_success"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 20, 99);
    if ecs_register_result_deep_result_ok(r) != 1 { panic(147181); };
}

@test "required_registry_try_register_duplicate_returns_dup_kind"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 20, 99);
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 20, 99);
    if ecs_register_result_deep_result_ok(r) != 0 { panic(147182); };
    if ecs_register_result_deep_result_kind(r) != 0 { panic(147183); };
    if ecs_register_result_deep_result_a(r) != 10 { panic(147184); };
    if ecs_register_result_deep_result_b(r) != 20 { panic(147185); };
    if ecs_register_result_deep_is_dup(r) != true { panic(147186); };
}

@test "required_registry_try_register_archetype_exists_kind"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_mark_archetyped(r, 50);
    r = ecs_world_req_registry_deep_try_register_with(r, 50, 60, 99);
    if ecs_register_result_deep_result_ok(r) != 0 { panic(147187); };
    if ecs_register_result_deep_result_kind(r) != 2 { panic(147188); };
    if ecs_register_result_deep_is_archetype_exists(r) != true { panic(147189); };
}

@test "required_registry_get_required_by_id"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 20, 99);
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 21, 98);
    r = ecs_world_req_registry_deep_get_required_by_id(r, 10);
    if ecs_req_query_deep_found(r) != true { panic(147190); };
    if ecs_req_query_deep_count(r) != 2 { panic(147191); };
}

@test "required_registry_get_required_by_id_not_found"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_get_required_by_id(r, 99);
    if ecs_req_query_deep_found(r) != false { panic(147192); };
    if ecs_req_query_deep_count(r) != 0 { panic(147193); };
}

@test "required_registry_get_required_nth"() {
    let r = ecs_world_req_registry_deep_new();
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 20, 99);
    r = ecs_world_req_registry_deep_try_register_with(r, 10, 21, 98);
    r = ecs_world_req_registry_deep_get_required_nth(r, 10, 0);
    if ecs_req_nth_deep_found(r) != true { panic(147194); };
    if ecs_req_nth_deep_required_id(r) != 20 { panic(147195); };
    if ecs_req_nth_deep_constructor_id(r) != 99 { panic(147196); };
    r = ecs_world_req_registry_deep_get_required_nth(r, 10, 1);
    if ecs_req_nth_deep_required_id(r) != 21 { panic(147197); };
    if ecs_req_nth_deep_constructor_id(r) != 98 { panic(147198); };
    r = ecs_world_req_registry_deep_get_required_nth(r, 10, 99);
    if ecs_req_nth_deep_found(r) != false { panic(147199); };
}

@test "entity_allocator_new"() {
    let a = ecs_world_entity_allocator_deep_new();
    if ecs_world_entity_allocator_deep_spawned_count(a) != 0 { panic(147200); };
    if ecs_world_entity_allocator_deep_is_spawned(a, 0) != false { panic(147201); };
    if ecs_world_entity_allocator_deep_check_can_spawn_at(a, 0) != (0 - 1) { panic(147202); };
}

@test "entity_allocator_alloc_grows_spawned"() {
    let a = ecs_world_entity_allocator_deep_new();
    a = ecs_world_entity_allocator_deep_alloc(a);
    if ecs_world_entity_allocator_deep_alloc_idx(a) != 0 { panic(147203); };
    if ecs_world_entity_allocator_deep_alloc_gen(a) != 1 { panic(147204); };
    if ecs_world_entity_allocator_deep_spawned_count(a) != 1 { panic(147205); };
    if ecs_world_entity_allocator_deep_is_spawned(a, 0) != true { panic(147206); };
}

@test "entity_allocator_alloc_multiple"() {
    let a = ecs_world_entity_allocator_deep_new();
    a = ecs_world_entity_allocator_deep_alloc(a);
    a = ecs_world_entity_allocator_deep_alloc(a);
    a = ecs_world_entity_allocator_deep_alloc(a);
    if ecs_world_entity_allocator_deep_spawned_count(a) != 3 { panic(147207); };
    if ecs_world_entity_allocator_deep_is_spawned(a, 2) != true { panic(147208); };
    if ecs_world_entity_allocator_deep_check_can_spawn_at(a, 2) != 1 { panic(147209); };
}

@test "entity_allocator_free_then_reuse"() {
    let a = ecs_world_entity_allocator_deep_new();
    a = ecs_world_entity_allocator_deep_alloc(a);
    a = ecs_world_entity_allocator_deep_alloc(a);
    a = ecs_world_entity_allocator_deep_free(a, 0);
    if ecs_world_entity_allocator_deep_is_spawned(a, 0) != false { panic(147210); };
    if ecs_world_entity_allocator_deep_spawned_count(a) != 1 { panic(147211); };
    // Re-alloc — first-bucket reuse (since the free list is non-empty).
    a = ecs_world_entity_allocator_deep_alloc(a);
    if ecs_world_entity_allocator_deep_alloc_idx(a) != 0 { panic(147212); };
}

@test "resource_entities_insert_and_get"() {
    let re = ecs_world_resource_entities_deep_new();
    re = ecs_world_resource_entities_deep_insert(re, 100, 5);
    re = ecs_world_resource_entities_deep_insert(re, 200, 9);
    if ecs_world_resource_entities_deep_len(re) != 2 { panic(147213); };
    re = ecs_world_resource_entities_deep_get(re, 100);
    if ecs_world_resource_entities_deep_get_found(re) != true { panic(147214); };
    if ecs_world_resource_entities_deep_get_entity_idx(re) != 5 { panic(147215); };
    re = ecs_world_resource_entities_deep_get(re, 999);
    if ecs_world_resource_entities_deep_get_found(re) != false { panic(147216); };
}

@test "resource_entities_insert_overwrites_existing"() {
    let re = ecs_world_resource_entities_deep_new();
    re = ecs_world_resource_entities_deep_insert(re, 100, 5);
    re = ecs_world_resource_entities_deep_insert(re, 100, 7);
    if ecs_world_resource_entities_deep_len(re) != 1 { panic(147217); };
    re = ecs_world_resource_entities_deep_get(re, 100);
    if ecs_world_resource_entities_deep_get_entity_idx(re) != 7 { panic(147218); };
}

@test "spawn_facade_new_empty"() {
    let f = ecs_world_spawn_facade_deep_new();
    if ecs_world_spawn_facade_deep_spawned_count(f) != 0 { panic(147219); };
    if ecs_world_spawn_facade_deep_next_index(f) != 0 { panic(147220); };
}

@test "spawn_facade_spawn_at_and_count"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_at(f, 5, 100);
    if ecs_spawn_at_deep_ok(f) != 1 { panic(147221); };
    if ecs_spawn_at_deep_error_code(f) != (0 - 1) { panic(147222); };
    if ecs_spawn_at_deep_entity_idx(f) != 5 { panic(147223); };
    if ecs_world_spawn_facade_deep_spawned_count(f) != 1 { panic(147224); };
    if ecs_world_spawn_facade_deep_type_at(f, 0) != 100 { panic(147225); };
}

@test "spawn_facade_spawn_at_already_spawned_fails"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_at(f, 5, 100);
    f = ecs_world_spawn_facade_deep_spawn_at(f, 5, 200);
    if ecs_spawn_at_deep_ok(f) != 0 { panic(147226); };
    if ecs_spawn_at_deep_error_code(f) != 1 { panic(147227); };
    if ecs_spawn_at_deep_entity_idx(f) != (0 - 1) { panic(147228); };
    // count stays at 1 (16 cap not hit, but already-spawned is rejected before push).
    if ecs_world_spawn_facade_deep_spawned_count(f) != 1 { panic(147229); };
}

@test "spawn_facade_spawn_empty_at"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_empty_at(f, 7);
    if ecs_spawn_at_deep_ok(f) != 1 { panic(147230); };
    if ecs_world_spawn_facade_deep_type_at(f, 0) != 0 { panic(147231); };
}

@test "spawn_facade_spawn_batch_steps"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_batch_step(f, 100);
    f = ecs_world_spawn_facade_deep_spawn_batch_step(f, 200);
    f = ecs_world_spawn_facade_deep_spawn_batch_step(f, 300);
    if ecs_spawn_batch_deep_count(f) != 3 { panic(147232); };
    if ecs_spawn_batch_deep_first(f) != 0 { panic(147233); };
    if ecs_world_spawn_facade_deep_spawned_count(f) != 3 { panic(147234); };
    if ecs_world_spawn_facade_deep_type_at(f, 2) != 300 { panic(147235); };
}

@test "spawn_facade_modify_component_present"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_at(f, 0, 100);
    f = ecs_world_modify_component_deep(f, 0, 100, 0, 999);
    if ecs_modify_deep_ok(f) != 1 { panic(147236); };
    if ecs_modify_deep_present(f) != 1 { panic(147237); };
    if ecs_world_spawn_facade_deep_type_at(f, 0) != 999 { panic(147238); };
}

@test "spawn_facade_modify_component_not_spawned"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_modify_component_deep(f, 50, 100, 0, 999);
    if ecs_modify_deep_ok(f) != 0 { panic(147239); };
    if ecs_modify_deep_error_code(f) != 0 { panic(147240); };
    if ecs_modify_deep_present(f) != 0 { panic(147241); };
}

@test "spawn_facade_modify_component_spawned_but_type_absent"() {
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_at(f, 0, 100);
    // entity 0 is spawned with type 100; modification of a different type must
    // succeed with present=0 (matches the shallow behaviour).
    f = ecs_world_modify_component_deep(f, 0, 200, 0, 999);
    if ecs_modify_deep_ok(f) != 1 { panic(147242); };
    if ecs_modify_deep_present(f) != 0 { panic(147243); };
    // stored type stays at 100 — no mutation happened.
    if ecs_world_spawn_facade_deep_type_at(f, 0) != 100 { panic(147244); };
}

@test "components_queue_new_empty"() {
    let q = ecs_world_components_queue_deep_new();
    if ecs_world_components_queue_deep_len(q) != 0 { panic(147245); };
}

@test "components_queue_enqueue_at"() {
    let q = ecs_world_components_queue_deep_new();
    q = ecs_world_components_queue_deep_enqueue(q, 7, 1);
    q = ecs_world_components_queue_deep_enqueue(q, 8, 2);
    if ecs_world_components_queue_deep_len(q) != 2 { panic(147246); };
    q = ecs_world_components_queue_deep_at(q, 0);
    if ecs_queue_at_deep_found(q) != true { panic(147247); };
    if ecs_queue_at_deep_type_id(q) != 7 { panic(147248); };
    if ecs_queue_at_deep_storage_kind(q) != 1 { panic(147249); };
    q = ecs_world_components_queue_deep_at(q, 5);
    if ecs_queue_at_deep_found(q) != false { panic(147250); };
}

@test "components_queue_apply_drains"() {
    let q = ecs_world_components_queue_deep_new();
    q = ecs_world_components_queue_deep_enqueue(q, 1, 10);
    q = ecs_world_components_queue_deep_enqueue(q, 2, 20);
    q = ecs_world_components_queue_deep_apply(q);
    if ecs_queue_apply_deep_applied(q) != 2 { panic(147251); };
    if ecs_world_components_queue_deep_len(q) != 0 { panic(147252); };
}

@test "unsafe_world_cell_new_and_readonly"() {
    let c = ecs_world_unsafe_cell_deep_new(123456);
    if ecs_world_unsafe_cell_deep_ptr(c) != 123456 { panic(147253); };
    if ecs_world_unsafe_cell_deep_is_readonly(c) != false { panic(147254); };
    let r = ecs_world_unsafe_cell_deep_readonly(789);
    if ecs_world_unsafe_cell_deep_is_readonly(r) != true { panic(147255); };
}

@test "modify_resource_present_via_resource_entities"() {
    let re = ecs_world_resource_entities_deep_new();
    re = ecs_world_resource_entities_deep_insert(re, 100, 5);
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_at(f, 5, 100);
    f = ecs_world_modify_resource_deep(re, f, 100, 0, 999);
    if ecs_modify_deep_ok(f) != 1 { panic(147256); };
    if ecs_modify_deep_present(f) != 1 { panic(147257); };
    if ecs_world_spawn_facade_deep_type_at(f, 0) != 999 { panic(147258); };
}

@test "modify_resource_not_found"() {
    let re = ecs_world_resource_entities_deep_new();
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_modify_resource_deep(re, f, 100, 0, 999);
    if ecs_modify_deep_ok(f) != 1 { panic(147259); };
    if ecs_modify_deep_present(f) != 0 { panic(147260); };
}

@test "modify_by_id_aliases"() {
    let re = ecs_world_resource_entities_deep_new();
    re = ecs_world_resource_entities_deep_insert(re, 50, 9);
    let f = ecs_world_spawn_facade_deep_new();
    f = ecs_world_spawn_facade_deep_spawn_at(f, 9, 50);
    let r1 = ecs_world_modify_component_by_id_deep(f, 9, 50, 0, 7777);
    if ecs_modify_deep_ok(r1) != 1 { panic(147261); };
    if ecs_modify_deep_present(r1) != 1 { panic(147262); };
    let r2 = ecs_world_modify_resource_by_id_deep(re, f, 50, 0, 8888);
    if ecs_modify_deep_ok(r2) != 1 { panic(147263); };
    if ecs_modify_deep_present(r2) != 1 { panic(147264); };
}
