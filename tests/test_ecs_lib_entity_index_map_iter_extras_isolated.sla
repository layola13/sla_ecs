@import "lib/entity_index_map_iter_extras.sla"

// Isolated tests for lib/entity_index_map_iter_extras.sla.
// Bevy reference: bevy_ecs/src/entity/index_map.rs iterator and Slice impls.

fn make_eim2_3() -> EcsEim2Map {
    let map = ecs_eim2_new();
    let m1 = ecs_eim2_insert(map, 1, 10);
    let m2 = ecs_eim2_insert(m1, 2, 20);
    return ecs_eim2_insert(m2, 3, 30);
}

@test "entity index map iter extras boxed slice"() {
    let boxed = ecs_eim2_into_boxed_slice(make_eim2_3());
    if boxed.boxed != 1 { panic(92597); };
    if ecs_eim2_slice_len(boxed) != 3 { panic(92598); };
}

@test "entity index map iter extras boxed clone and inner"() {
    let boxed = ecs_eim2_into_boxed_slice(make_eim2_3());
    let cloned = ecs_eim2_boxed_clone(boxed);
    let inner = ecs_eim2_boxed_into_inner(cloned);
    if inner.boxed != 0 { panic(92599); };
    if ecs_eim2_slice_len(inner) != 3 { panic(92600); };
}

@test "entity index map iter extras boxed default empty"() {
    let boxed = ecs_eim2_boxed_default();
    if boxed.boxed != 1 { panic(92601); };
    if ecs_eim2_slice_len(boxed) != 0 { panic(92602); };
}

@test "entity index map iter extras range variants"() {
    let slice = ecs_eim2_as_slice(make_eim2_3());
    let from = ecs_eim2_slice_range_from(slice, 1);
    let to = ecs_eim2_slice_range_to(slice, 2);
    let inc = ecs_eim2_slice_range_inclusive(slice, 0, 1);
    if ecs_eim2_slice_len(from.slice) != 2 { panic(92603); };
    if ecs_eim2_slice_len(to.slice) != 2 { panic(92604); };
    if ecs_eim2_slice_len(inc.slice) != 2 { panic(92605); };
}

@test "entity index map iter extras slice equality"() {
    let a = ecs_eim2_as_slice(make_eim2_3());
    let b = ecs_eim2_as_slice(make_eim2_3());
    if ecs_eim2_slice_eq(a, b) != true { panic(92606); };
}

@test "entity index map iter extras slice comparison"() {
    let a = ecs_eim2_as_slice(make_eim2_3());
    let map = ecs_eim2_insert(make_eim2_3(), 3, 99);
    let b = ecs_eim2_as_slice(map);
    if ecs_eim2_slice_cmp(a, b) != -1 { panic(92607); };
    if ecs_eim2_slice_cmp(b, a) != 1 { panic(92608); };
}

@test "entity index map iter extras slice hash stable"() {
    let a = ecs_eim2_as_slice(make_eim2_3());
    let b = ecs_eim2_as_slice(make_eim2_3());
    if ecs_eim2_slice_hash(a) != ecs_eim2_slice_hash(b) { panic(92609); };
}

@test "entity index map iter extras iter mut set next"() {
    let iter = ecs_eim2_iter_mut(make_eim2_3());
    let r = ecs_eim2_iter_mut_set_next(iter, 77);
    if r.has != 1 { panic(92610); };
    if r.key != 1 { panic(92611); };
    if r.old_value != 10 { panic(92612); };
    let rest = ecs_eim2_iter_mut_as_slice(r.iter);
    let p = ecs_eim2_slice_at(rest, 0);
    if p.key != 2 { panic(92613); };
}

@test "entity index map iter extras into iter next"() {
    let iter = ecs_eim2_into_iter(make_eim2_3());
    let r = ecs_eim2_into_iter_next(iter);
    if r.has != 1 { panic(92614); };
    if r.key != 1 { panic(92615); };
    if r.value != 10 { panic(92616); };
}

@test "entity index map iter extras into iter next back"() {
    let iter = ecs_eim2_into_iter(make_eim2_3());
    let r = ecs_eim2_into_iter_next_back(iter);
    if r.has != 1 { panic(92617); };
    if r.key != 3 { panic(92618); };
}

@test "entity index map iter extras into iter as slice"() {
    let iter = ecs_eim2_into_iter(make_eim2_3());
    let slice = ecs_eim2_into_iter_as_slice(iter);
    if ecs_eim2_slice_len(slice) != 3 { panic(92619); };
}

@test "entity index map iter extras drain as slice"() {
    let r = ecs_eim2_drain(make_eim2_3(), 1, 3);
    let slice = ecs_eim2_drain_as_slice(r.drain);
    if ecs_eim2_slice_len(slice) != 2 { panic(92620); };
    let p = ecs_eim2_slice_at(slice, 0);
    if p.key != 2 { panic(92621); };
}

@test "entity index map iter extras drain leaves kept"() {
    let r = ecs_eim2_drain(make_eim2_3(), 1, 2);
    if ecs_eim2_len(r.map) != 2 { panic(92622); };
    let slice = ecs_eim2_as_slice(r.map);
    let p = ecs_eim2_slice_at(slice, 1);
    if p.key != 3 { panic(92623); };
}

@test "entity index map iter extras invalid range"() {
    let r = ecs_eim2_slice_range(ecs_eim2_as_slice(make_eim2_3()), 2, 1);
    if r.has != 0 { panic(92624); };
}

@test "entity index map iter extras slice at missing"() {
    let p = ecs_eim2_slice_at(ecs_eim2_as_slice(make_eim2_3()), 9);
    if p.has != 0 { panic(92625); };
}

@test "entity index map iter extras iter mut exhausted"() {
    let iter = ecs_eim2_iter_mut(ecs_eim2_new());
    let r = ecs_eim2_iter_mut_set_next(iter, 1);
    if r.has != 0 { panic(92626); };
}

@test "entity index map iter extras into iter exhausted"() {
    let iter = ecs_eim2_into_iter(ecs_eim2_new());
    let r = ecs_eim2_into_iter_next(iter);
    if r.has != 0 { panic(92627); };
}

