@import "lib/world_id_factory.sla"

// Isolated tests for lib/world_id_factory.sla — WorldId::new() static factory (Option + monotonic
// uniqueness + exhaustion) + SparseSetIndex impl. Bevy: src/world/identifier.rs.
// panic codes: 92376 – 92405.

@test "factory_new_starts_at_zero"() {
    let f = ecs_world_id_factory_new();
    if ecs_world_id_factory_next_id(f) != 0 { panic(92376); };
    if ecs_world_id_factory_is_exhausted(f) { panic(92377); };
}

@test "new_mints_zero_then_one_then_two"() {
    let f0 = ecs_world_id_factory_new();
    let r0 = ecs_world_id_new(f0);
    if ecs_widr_has(r0) != 1 { panic(92378); };
    if ecs_widr_value(r0) != 0 { panic(92379); };
    let f1 = ecs_widr_factory(r0);
    let r1 = ecs_world_id_new(f1);
    if ecs_widr_value(r1) != 1 { panic(92380); };
    let f2 = ecs_widr_factory(r1);
    let r2 = ecs_world_id_new(f2);
    if ecs_widr_value(r2) != 2 { panic(92381); };
    let f3 = ecs_widr_factory(r2);
    if ecs_world_id_factory_next_id(f3) != 3 { panic(92382); };
}

@test "new_returns_distinct_ids"() {
    let f0 = ecs_world_id_factory_new();
    let r0 = ecs_world_id_new(f0); let f1 = ecs_widr_factory(r0);
    let r1 = ecs_world_id_new(f1); let f2 = ecs_widr_factory(r1);
    let r2 = ecs_world_id_new(f2);
    if ecs_widr_value(r0) == ecs_widr_value(r1) { panic(92383); };
    if ecs_widr_value(r1) == ecs_widr_value(r2) { panic(92384); };
    if ecs_widr_value(r0) == ecs_widr_value(r2) { panic(92385); };
}

@test "exhaustion_at_cap_returns_none"() {
    let f0 = ecs_world_id_factory_with_cap(3);
    let r0 = ecs_world_id_new(f0); let f1 = ecs_widr_factory(r0);  // id 0
    let r1 = ecs_world_id_new(f1); let f2 = ecs_widr_factory(r1);  // id 1
    let r2 = ecs_world_id_new(f2); let f3 = ecs_widr_factory(r2);  // id 2
    if ecs_widr_value(r0) != 0 { panic(92386); };
    if ecs_widr_value(r1) != 1 { panic(92387); };
    if ecs_widr_value(r2) != 2 { panic(92388); };
    // next_id == cap -> None
    let r3 = ecs_world_id_new(f3);
    if ecs_widr_has(r3) != 0 { panic(92389); };
    if ecs_widr_value(r3) != (0 - 1) { panic(92390); };
    let f4 = ecs_widr_factory(r3);
    if !ecs_world_id_factory_is_exhausted(f4) { panic(92391); };
}

@test "once_exhausted_stays_exhausted"() {
    let f0 = ecs_world_id_factory_with_cap(1);
    let r0 = ecs_world_id_new(f0); let f1 = ecs_widr_factory(r0);  // id 0
    if ecs_widr_value(r0) != 0 { panic(92392); };
    let r1 = ecs_world_id_new(f1);
    if ecs_widr_has(r1) != 0 { panic(92393); };
    let f2 = ecs_widr_factory(r1);
    let r2 = ecs_world_id_new(f2);
    // still None
    if ecs_widr_has(r2) != 0 { panic(92394); };
    if !ecs_world_id_factory_is_exhausted(f2) { panic(92395); };
}

@test "with_cap_zero_exhausts_immediately"() {
    let f0 = ecs_world_id_factory_with_cap(0);
    let r0 = ecs_world_id_new(f0);
    if ecs_widr_has(r0) != 0 { panic(92396); };
    let f1 = ecs_widr_factory(r0);
    if !ecs_world_id_factory_is_exhausted(f1) { panic(92397); };
}

@test "sparse_set_index_roundtrip"() {
    let id = ecs_world_id_embedded_new(42);
    if ecs_world_id_sparse_set_index(id) != 42 { panic(92398); };
}

@test "get_sparse_set_index_value"() {
    let id = ecs_world_id_get_sparse_set_index(7);
    if ecs_world_id_embedded_value(id) != 7 { panic(92399); };
    if ecs_world_id_sparse_set_index(id) != 7 { panic(92400); };
}

@test "world_id_embedded_eq_distinct_and_equal"() {
    let a = ecs_world_id_embedded_new(5);
    let b = ecs_world_id_embedded_new(5);
    let c = ecs_world_id_embedded_new(6);
    if !ecs_world_id_embedded_eq(a, b) { panic(92401); };
    if ecs_world_id_embedded_eq(a, c) { panic(92402); };
}

@test "no_reuse_after_exhaustion_subsequent_new_does_not_decrement"() {
    let f0 = ecs_world_id_factory_with_cap(2);
    let r0 = ecs_world_id_new(f0); let f1 = ecs_widr_factory(r0);  // id 0
    let r1 = ecs_world_id_new(f1); let f2 = ecs_widr_factory(r1);  // id 1
    if ecs_widr_value(r1) != 1 { panic(92403); };
    let r2 = ecs_world_id_new(f2);  // None
    if ecs_widr_has(r2) != 0 { panic(92404); };
    let f3 = ecs_widr_factory(r2);
    // Bevy: "ids created from this method are unique across time — if a given WorldId is Dropped its
    // value still cannot be reused". After exhaustion the counter stays at the cap (no rollback).
    if ecs_world_id_factory_next_id(f3) != 2 { panic(92405); };
}
