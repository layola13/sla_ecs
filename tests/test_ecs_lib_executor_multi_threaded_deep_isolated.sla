@test "mt_deep_run_history_drive_records_run_and_apply_barrier"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 4, 0);
    let prior0 = ecs_executor_system_spec_deep_new(0, false, false);
    let prior1 = ecs_executor_system_spec_deep_new(1, false, false);
    let barrier0 = ecs_executor_system_spec_deep_new(2, true, true);
    let barrier = ecs_executor_system_spec_deep_as_apply_deferred(barrier0);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, prior0);
    s = ecs_executor_state_deep_complete_system(s, prior0, true);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_start_system(s, prior1);
    s = ecs_executor_state_deep_complete_system(s, prior1, true);
    s = ecs_executor_state_deep_mark_ready(s, 2);
    let h = ecs_executor_run_history_deep_drive_one(ecs_executor_run_history_deep_new(), s, barrier);
    if ecs_executor_run_history_deep_run_count(h) != 1 { panic(148128); };
    if ecs_executor_run_history_deep_run_at(h, 0) != 2 { panic(148129); };
    if ecs_executor_run_history_deep_apply_count(h) != 2 { panic(148130); };
    if ecs_executor_run_history_deep_apply_at(h, 0) != 0 { panic(148131); };
    if ecs_executor_run_history_deep_apply_at(h, 1) != 1 { panic(148132); };
    if ecs_executor_run_history_deep_skipped_count(h) != 0 { panic(148133); };
}

