    if r.selected_count != 0 { panic(148046); };
    if r.skipped_count != 1 { panic(148047); };
    if r.completed_count != 1 { panic(148048); };
    if r.ready_count != 1 { panic(148049); };
}

@test "mt_deep_drive_one_apply_deferred_barrier_counts_existing_unapplied"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let completed = ecs_executor_system_spec_deep_new(0, false, false);
    let barrier0 = ecs_executor_system_spec_deep_new(1, true, true);
    let barrier = ecs_executor_system_spec_deep_as_apply_deferred(barrier0);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, completed);
    s = ecs_executor_state_deep_complete_system(s, completed, true);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    let r = ecs_executor_state_deep_drive_one_summary(s, barrier, -1, -1, -1, 0);
    if r.apply_count != 1 { panic(148050); };
    if r.selected_count != 1 { panic(148051); };
    if r.selected0 != 1 { panic(148052); };
    if r.unapplied_count != 0 { panic(148053); };
    if r.completed_count != 2 { panic(148054); };
}

