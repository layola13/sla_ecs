// Isolated deep tests for lib/executor_multi_threaded_deep.sla (Batches 420-421).
// Covers fixed-cap ExecutorState gates, ready-batch selection, and completion handoff.

@import "lib/executor_multi_threaded_deep.sla"

@test "mt_deep_state_init_clamps_and_starts_empty"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 20, 20);
    if s.system_count != 16 { panic(147880); };
    if s.set_count != 16 { panic(147881); };
    if ecs_executor_state_deep_ready_count(s) != 0 { panic(147882); };
    if ecs_executor_state_deep_running_count(s) != 0 { panic(147883); };
}

@test "mt_deep_dependencies_gate_ready"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    s = ecs_executor_state_deep_set_dependencies(s, 1, 2);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    if ecs_executor_state_deep_is_ready(s, 1) { panic(147884); };
    s = ecs_executor_state_deep_set_dependencies(s, 1, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    if ecs_executor_state_deep_is_ready(s, 1) != true { panic(147885); };
    if ecs_executor_state_deep_get_dependencies(s, 1) != 0 { panic(147886); };
}

@test "mt_deep_start_and_complete_send_system"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let spec = ecs_executor_system_spec_deep_new(0, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    if ecs_executor_state_deep_can_spawn_system(s, spec) != true { panic(147887); };
    s = ecs_executor_state_deep_start_system(s, spec);
    if ecs_executor_state_deep_is_running(s, 0) != true { panic(147888); };
    if ecs_executor_state_deep_running_count(s) != 1 { panic(147889); };
    s = ecs_executor_state_deep_complete_system(s, spec, true);
    if ecs_executor_state_deep_is_running(s, 0) { panic(147890); };
    if ecs_executor_state_deep_is_completed(s, 0) != true { panic(147891); };
    if ecs_executor_state_deep_is_unapplied(s, 0) != true { panic(147892); };
    if ecs_executor_state_deep_running_count(s) != 0 { panic(147893); };
}

@test "mt_deep_local_gate_blocks_second_local"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let local0 = ecs_executor_system_spec_deep_new(0, false, true);
    let local1 = ecs_executor_system_spec_deep_new(1, false, true);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_start_system(s, local0);
    if ecs_executor_state_deep_local_running(s) != true { panic(147894); };
    if ecs_executor_state_deep_can_spawn_system(s, local1) { panic(147895); };
    s = ecs_executor_state_deep_complete_system(s, local0, false);
    if ecs_executor_state_deep_local_running(s) { panic(147896); };
    if ecs_executor_state_deep_can_spawn_system(s, local1) != true { panic(147897); };
}

@test "mt_deep_exclusive_gate_blocks_while_any_running"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let send = ecs_executor_system_spec_deep_new(0, false, false);
    let exclusive = ecs_executor_system_spec_deep_new(1, true, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_start_system(s, send);
    if ecs_executor_state_deep_can_spawn_system(s, exclusive) { panic(147898); };
    s = ecs_executor_state_deep_complete_system(s, send, false);
    if ecs_executor_state_deep_can_spawn_system(s, exclusive) != true { panic(147899); };
    s = ecs_executor_state_deep_start_system(s, exclusive);
    if ecs_executor_state_deep_exclusive_running(s) != true { panic(147900); };
    if ecs_executor_state_deep_local_running(s) != true { panic(147901); };
}

@test "mt_deep_access_conflict_blocks_candidate"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let a = ecs_executor_system_spec_deep_new(0, false, false);
    let b0 = ecs_executor_system_spec_deep_new(1, false, false);
    let b = ecs_executor_system_spec_deep_with_conflict(b0, 0);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_start_system(s, a);
    if ecs_executor_state_deep_can_spawn_system(s, b) { panic(147902); };
    s = ecs_executor_state_deep_complete_system(s, a, false);
    if ecs_executor_state_deep_can_spawn_system(s, b) != true { panic(147903); };
}

@test "mt_deep_ready_batch_selects_nonconflicting_send_systems"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    let a = ecs_executor_system_spec_deep_new(0, false, false);
    let b = ecs_executor_system_spec_deep_new(1, false, false);
    let c = ecs_executor_system_spec_deep_new(2, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_mark_ready(s, 2);
    let batch = ecs_executor_state_deep_take_ready_batch3(s, a, b, c);
    if batch.count != 3 { panic(147904); };
    if ecs_executor_ready_batch_deep_at(batch, 0) != 0 { panic(147905); };
    if ecs_executor_ready_batch_deep_at(batch, 1) != 1 { panic(147906); };
    if ecs_executor_ready_batch_deep_at(batch, 2) != 2 { panic(147907); };
}

@test "mt_deep_ready_batch_allows_one_local_only"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    let a = ecs_executor_system_spec_deep_new(0, false, true);
    let b = ecs_executor_system_spec_deep_new(1, false, true);
    let c = ecs_executor_system_spec_deep_new(2, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_mark_ready(s, 2);
    let batch = ecs_executor_state_deep_take_ready_batch3(s, a, b, c);
    if batch.count != 2 { panic(147908); };
    if ecs_executor_ready_batch_deep_at(batch, 0) != 0 { panic(147909); };
    if ecs_executor_ready_batch_deep_at(batch, 1) != 2 { panic(147910); };
    if batch.is_local != 1 { panic(147911); };
}

@test "mt_deep_ready_batch_exclusive_stands_alone"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    let a = ecs_executor_system_spec_deep_new(0, true, false);
    let b = ecs_executor_system_spec_deep_new(1, false, false);
    let c = ecs_executor_system_spec_deep_new(2, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_mark_ready(s, 2);
    let batch = ecs_executor_state_deep_take_ready_batch3(s, a, b, c);
    if batch.count != 1 { panic(147912); };
    if ecs_executor_ready_batch_deep_at(batch, 0) != 0 { panic(147913); };
    if batch.is_exclusive != 1 { panic(147914); };
}

@test "mt_deep_completed_system_cannot_be_readied_or_spawned"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 1, 0);
    let spec = ecs_executor_system_spec_deep_new(0, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, spec);
    s = ecs_executor_state_deep_complete_system(s, spec, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    if ecs_executor_state_deep_is_completed(s, 0) != true { panic(147915); };
    if ecs_executor_state_deep_can_spawn_system(s, spec) { panic(147916); };
}

@test "mt_deep_release_dependents_marks_zero_dependency_ready"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    s = ecs_executor_state_deep_set_dependencies(s, 1, 2);
    s = ecs_executor_state_deep_set_dependencies(s, 2, 1);
    s = ecs_executor_state_deep_release_dependents3(s, 1, 2, -1, 2);
    if ecs_executor_state_deep_get_dependencies(s, 1) != 1 { panic(147930); };
    if ecs_executor_state_deep_is_ready(s, 1) { panic(147931); };
    if ecs_executor_state_deep_get_dependencies(s, 2) != 0 { panic(147932); };
    if ecs_executor_state_deep_is_ready(s, 2) != true { panic(147933); };
}

@test "mt_deep_complete_with_dependents_releases_next_ready"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    let a = ecs_executor_system_spec_deep_new(0, false, false);
    s = ecs_executor_state_deep_set_dependencies(s, 1, 1);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, a);
    s = ecs_executor_state_deep_complete_system_with_dependents3(s, a, true, 1, -1, -1, 1);
    if ecs_executor_state_deep_is_completed(s, 0) != true { panic(147934); };
    if ecs_executor_state_deep_is_unapplied(s, 0) != true { panic(147935); };
    if ecs_executor_state_deep_is_ready(s, 1) != true { panic(147936); };
    if ecs_executor_state_deep_completed_count(s) != 1 { panic(147937); };
}

@test "mt_deep_skip_with_dependents_completes_and_releases"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    s = ecs_executor_state_deep_set_dependencies(s, 1, 1);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_skip_system_with_dependents3(s, 0, 1, -1, -1, 1);
    if ecs_executor_state_deep_is_skipped(s, 0) != true { panic(147938); };
    if ecs_executor_state_deep_is_completed(s, 0) != true { panic(147939); };
    if ecs_executor_state_deep_is_ready(s, 0) { panic(147940); };
    if ecs_executor_state_deep_is_ready(s, 1) != true { panic(147941); };
    if ecs_executor_state_deep_skipped_count(s) != 1 { panic(147942); };
}

@test "mt_deep_mark_skipped_pending_ignores_completed"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 1, 0);
    let spec = ecs_executor_system_spec_deep_new(0, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, spec);
    s = ecs_executor_state_deep_complete_system(s, spec, false);
    s = ecs_executor_state_deep_mark_skipped_pending(s, 0);
    if ecs_executor_state_deep_is_completed(s, 0) != true { panic(147943); };
    if ecs_executor_state_deep_is_skipped(s, 0) { panic(147944); };
}

@test "mt_deep_evaluated_set_tracking_and_bounds"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 0, 3);
    s = ecs_executor_state_deep_mark_set_evaluated(s, 1);
    s = ecs_executor_state_deep_mark_set_evaluated(s, 5);
    if ecs_executor_state_deep_is_set_evaluated(s, 1) != true { panic(147945); };
    if ecs_executor_state_deep_is_set_evaluated(s, 2) { panic(147946); };
    if ecs_executor_state_deep_evaluated_set_count(s) != 1 { panic(147947); };
}

@test "mt_deep_apply_deferred_clears_one_or_all"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let a = ecs_executor_system_spec_deep_new(0, false, false);
    let b = ecs_executor_system_spec_deep_new(1, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_start_system(s, a);
    s = ecs_executor_state_deep_complete_system(s, a, true);
    s = ecs_executor_state_deep_start_system(s, b);
    s = ecs_executor_state_deep_complete_system(s, b, true);
    if ecs_executor_state_deep_unapplied_count(s) != 2 { panic(147948); };
    s = ecs_executor_state_deep_apply_deferred_system(s, 0);
    if ecs_executor_state_deep_is_unapplied(s, 0) { panic(147949); };
    if ecs_executor_state_deep_unapplied_count(s) != 1 { panic(147950); };
    s = ecs_executor_state_deep_apply_deferred_all(s);
    if ecs_executor_state_deep_unapplied_count(s) != 0 { panic(147951); };
}

@test "mt_deep_finish_run_resets_transient_state_and_can_keep_deferred"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 2);
    let a = ecs_executor_system_spec_deep_new(0, false, true);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, a);
    s = ecs_executor_state_deep_complete_system(s, a, true);
    s = ecs_executor_state_deep_mark_set_evaluated(s, 1);
    s = ecs_executor_state_deep_mark_skipped_pending(s, 1);
    s = ecs_executor_state_deep_finish_run(s, false);
    if ecs_executor_state_deep_completed_count(s) != 0 { panic(147952); };
    if ecs_executor_state_deep_skipped_count(s) != 0 { panic(147953); };
    if ecs_executor_state_deep_evaluated_set_count(s) != 0 { panic(147954); };
    if ecs_executor_state_deep_unapplied_count(s) != 1 { panic(147955); };
    if ecs_executor_state_deep_local_running(s) { panic(147956); };
    s = ecs_executor_state_deep_finish_run(s, true);
    if ecs_executor_state_deep_unapplied_count(s) != 0 { panic(147957); };
}

@test "mt_deep_tick_after_completion_releases_and_batches_ready"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 0);
    let a = ecs_executor_system_spec_deep_new(0, false, false);
    let b = ecs_executor_system_spec_deep_new(1, false, false);
    let c = ecs_executor_system_spec_deep_new(2, false, false);
    s = ecs_executor_state_deep_set_dependencies(s, 1, 1);
    s = ecs_executor_state_deep_set_dependencies(s, 2, 1);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, a);
    let batch = ecs_executor_state_deep_tick_after_completion3(s, a, false, 1, 2, -1, 2, b, c, a);
    if batch.count != 2 { panic(147958); };
    if ecs_executor_ready_batch_deep_at(batch, 0) != 1 { panic(147959); };
    if ecs_executor_ready_batch_deep_at(batch, 1) != 2 { panic(147960); };
}

@test "mt_deep_error_state_records_and_takes_panic_payload"() {
    let e = ecs_executor_error_state_deep_new();
    e = ecs_executor_error_state_deep_record_system_panic_payload(e, 4);
    if e.panic_payload_pending != 1 { panic(147970); };
    if e.system_panic_payloads != 1 { panic(147971); };
    if e.panic_payload_phase != ecs_executor_panic_phase_deep_system() { panic(147972); };
    if e.panic_payload_system != 4 { panic(147973); };
    e = ecs_executor_error_state_deep_take_panic_payload(e);
    if e.panic_payload_pending != 0 { panic(147974); };
    if e.panic_payload_phase != ecs_executor_panic_phase_deep_none() { panic(147975); };
    if e.panic_payload_system != -1 { panic(147976); };
    if e.panic_payload_rethrows != 1 { panic(147977); };
}

@test "mt_deep_error_state_records_deferred_and_handled_errors"() {
    let e = ecs_executor_error_state_deep_new();
    e = ecs_executor_error_state_deep_record_deferred_panic_payload(e, 2);
    e = ecs_executor_error_state_deep_record_system_handled_error(e, 3);
    e = ecs_executor_error_state_deep_record_deferred_handled_error(e, 5);
    if e.deferred_panic_payloads != 1 { panic(147978); };
    if e.panic_payload_phase != ecs_executor_panic_phase_deep_apply_deferred() { panic(147979); };
    if e.panic_payload_system != 2 { panic(147980); };
    if e.system_handled_errors != 1 { panic(147981); };
    if e.deferred_handled_errors != 1 { panic(147982); };
    if e.handled_error_phase != ecs_executor_panic_phase_deep_apply_deferred() { panic(147983); };
    if e.handled_error_system != 5 { panic(147984); };
}

@test "mt_deep_condition_fold_false_does_not_short_circuit"() {
    let f = ecs_executor_condition_fold_deep_outcomes3(
        7,
        ecs_executor_condition_outcome_deep_false(),
        ecs_executor_condition_outcome_deep_true(),
        ecs_executor_condition_outcome_deep_false(),
        3
    );
    if f.should_run != 0 { panic(147985); };
    if f.evaluated_count != 3 { panic(147986); };
    if f.aborted != 0 { panic(147987); };
    if f.system_panic_payloads != 0 { panic(147988); };
}

@test "mt_deep_condition_fold_handled_error_continues"() {
    let f = ecs_executor_condition_fold_deep_outcomes3(
        8,
        ecs_executor_condition_outcome_deep_handled_error(),
        ecs_executor_condition_outcome_deep_true(),
        ecs_executor_condition_outcome_deep_true(),
        3
    );
    if f.should_run != 0 { panic(147989); };
    if f.evaluated_count != 3 { panic(147990); };
    if f.system_handled_errors != 1 { panic(147991); };
    if f.handled_error_phase != ecs_executor_panic_phase_deep_run_condition() { panic(147992); };
    if f.handled_error_system != 8 { panic(147993); };
}

@test "mt_deep_condition_fold_error_handler_panic_aborts"() {
    let f = ecs_executor_condition_fold_deep_outcomes3(
        9,
        ecs_executor_condition_outcome_deep_true(),
        ecs_executor_condition_outcome_deep_error_handler_panic(),
        ecs_executor_condition_outcome_deep_handled_error(),
        3
    );
    if f.should_run != 0 { panic(147994); };
    if f.evaluated_count != 2 { panic(147995); };
    if f.aborted != 1 { panic(147996); };
    if f.panic_payload_pending != 1 { panic(147997); };
    if f.system_panic_payloads != 1 { panic(147998); };
    if f.panic_payload_phase != ecs_executor_panic_phase_deep_run_condition() { panic(147999); };
    if f.panic_payload_system != 9 { panic(148000); };
    if f.system_handled_errors != 0 { panic(148001); };
}

@test "mt_deep_failed_and_passed_conditions_update_state"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 4, 2);
    s = ecs_executor_state_deep_apply_failed_set_condition3(s, 0, 1, 2, 3, 3);
    if ecs_executor_state_deep_is_set_evaluated(s, 0) != true { panic(148002); };
    if ecs_executor_state_deep_skipped_count(s) != 3 { panic(148003); };
    s = ecs_executor_state_deep_apply_failed_set_condition3(s, 0, 0, -1, -1, 1);
    if ecs_executor_state_deep_skipped_count(s) != 3 { panic(148004); };
    s = ecs_executor_state_deep_apply_passed_set_condition(s, 1);
    if ecs_executor_state_deep_is_set_evaluated(s, 1) != true { panic(148005); };
    s = ecs_executor_state_deep_apply_failed_system_condition(s, 0);
    if ecs_executor_state_deep_is_skipped(s, 0) != true { panic(148006); };
}

@test "mt_deep_condition_fold_join_prefers_abort_and_late_errors"() {
    let set_fold = ecs_executor_condition_fold_deep_outcomes3(
        10,
        ecs_executor_condition_outcome_deep_false(),
        ecs_executor_condition_outcome_deep_true(),
        ecs_executor_condition_outcome_deep_true(),
        2
    );
    let sys_fold = ecs_executor_condition_fold_deep_outcomes3(
        10,
        ecs_executor_condition_outcome_deep_handled_error(),
        ecs_executor_condition_outcome_deep_true(),
        ecs_executor_condition_outcome_deep_true(),
        2
    );
    let joined = ecs_executor_condition_fold_deep_join(set_fold, sys_fold, false);
    if joined.should_run != 0 { panic(148007); };
    if joined.evaluated_count != 4 { panic(148008); };
    if joined.system_handled_errors != 1 { panic(148009); };
    if joined.handled_error_system != 10 { panic(148010); };
    let aborted = ecs_executor_condition_fold_deep_outcomes3(
        11,
        ecs_executor_condition_outcome_deep_error_handler_panic(),
        ecs_executor_condition_outcome_deep_true(),
        ecs_executor_condition_outcome_deep_true(),
        3
    );
    let joined_abort = ecs_executor_condition_fold_deep_join(aborted, sys_fold, false);
    if joined_abort.aborted != 1 { panic(148011); };
    if joined_abort.evaluated_count != 3 { panic(148012); };
    if joined_abort.panic_payload_system != 11 { panic(148013); };
}

@test "mt_deep_system_spec_drive_flags"() {
    let spec = ecs_executor_system_spec_deep_new(0, false, false);
    if spec.should_run != 1 { panic(148030); };
    if spec.has_deferred != 0 { panic(148031); };
    if spec.is_apply_deferred != 0 { panic(148032); };
    let deferred = ecs_executor_system_spec_deep_with_deferred(spec, true);
    if deferred.has_deferred != 1 { panic(148033); };
    let skipped = ecs_executor_system_spec_deep_with_should_run(deferred, false);
    if skipped.should_run != 0 { panic(148034); };
    let barrier = ecs_executor_system_spec_deep_as_apply_deferred(spec);
    if barrier.is_apply_deferred != 1 { panic(148035); };
    if barrier.is_exclusive != 1 { panic(148036); };
    if barrier.is_local != 1 { panic(148037); };
}

