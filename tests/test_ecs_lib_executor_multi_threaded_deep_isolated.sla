}

@test "mt_deep_lock_failed_summaries_preserve_pending_completion"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let spec = ecs_executor_system_spec_deep_new(0, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, spec);
    s = ecs_executor_state_deep_complete_system(s, spec, true);
    let locked = ecs_executor_tick_loop_deep_lock_failed(3);
    if locked.lock_failed != 1 { panic(148059); };
    if locked.pending_count != 1 { panic(148060); };
    if locked.pending0 != 3 { panic(148061); };
    let barrier_locked = ecs_executor_tick_loop_deep_apply_deferred_lock_failed(s, 4);
    if barrier_locked.lock_failed != 1 { panic(148062); };
    if barrier_locked.apply_count != 1 { panic(148063); };
    if barrier_locked.pending0 != 4 { panic(148064); };
}
