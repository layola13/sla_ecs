    if ecs_executor_ready_batch_rescan_summary_deep_selected_at(r, 1) != -1 { panic(149005); };
    if ecs_executor_ready_batch_rescan_summary_deep_rescan_count(r) != 2 { panic(149006); };
    if ecs_executor_ready_batch_rescan_summary_deep_completed_after(r) != 1 { panic(149007); };
    if ecs_executor_ready_batch_rescan_summary_deep_running_after(r) != 1 { panic(149008); };
    if ecs_executor_ready_batch_rescan_summary_deep_stalled(r) { panic(149009); };
}

