@test "mt_deep_begin_run_accessor_reads_ready_dependency_bounds"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 3, 2);
    let a = ecs_executor_system_spec_deep_new(0, false, false);
    let b = ecs_executor_system_spec_deep_new(1, true, true);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, a);
    s = ecs_executor_state_deep_complete_system(s, a, true);
    s = ecs_executor_state_deep_mark_ready(s, 1);
    s = ecs_executor_state_deep_start_system(s, b);
    s = ecs_executor_state_deep_skip_system(s, 2);
    s = ecs_executor_state_deep_mark_set_evaluated(s, 0);
    s = ecs_executor_state_deep_mark_set_evaluated(s, 1);
    let r = ecs_executor_begin_run_summary_deep3(s, true, false, true, 0, 3, 1);
    if ecs_executor_begin_run_summary_deep_ready_count(r) != 2 { panic(149030); };
    if !ecs_executor_begin_run_summary_deep_ready_at(r, 0) { panic(149031); };
    if ecs_executor_begin_run_summary_deep_ready_at(r, 1) { panic(149032); };
    if !ecs_executor_begin_run_summary_deep_ready_at(r, 2) { panic(149033); };
    if ecs_executor_begin_run_summary_deep_ready_at(r, 3) { panic(149034); };
    if ecs_executor_begin_run_summary_deep_dependencies_at(r, 0) != 0 { panic(149035); };
    if ecs_executor_begin_run_summary_deep_dependencies_at(r, 1) != 3 { panic(149036); };
    if ecs_executor_begin_run_summary_deep_dependencies_at(r, 2) != 1 { panic(149037); };
    if ecs_executor_begin_run_summary_deep_dependencies_at(r, 3) != -1 { panic(149038); };
    if ecs_executor_begin_run_summary_deep_running_count(r) != 0 { panic(149039); };
    if ecs_executor_begin_run_summary_deep_completed_count(r) != 0 { panic(149040); };
    if ecs_executor_begin_run_summary_deep_skipped_count(r) != 0 { panic(149041); };
    if ecs_executor_begin_run_summary_deep_evaluated_count(r) != 0 { panic(149042); };
    if ecs_executor_begin_run_summary_deep_local_running(r) { panic(149043); };
    if ecs_executor_begin_run_summary_deep_exclusive_running(r) { panic(149044); };
}

