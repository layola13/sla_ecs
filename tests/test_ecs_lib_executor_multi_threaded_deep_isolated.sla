    let b0 = ecs_executor_system_spec_deep_new(1, true, true);
    let b = ecs_executor_system_spec_deep_as_apply_deferred(b0);
    let c = ecs_executor_system_spec_deep_new(2, false, false);
    s = ecs_executor_state_deep_mark_ready(s, 0);
    s = ecs_executor_state_deep_start_system(s, a);
    s = ecs_executor_state_deep_complete_system(s, a, true);
