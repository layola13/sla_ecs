}

@test "mt_deep_skip_with_dependents_ignores_completed_system"() {
    let s = ecs_executor_state_deep_init(ecs_executor_state_deep_new(), 2, 0);
    let spec = ecs_executor_system_spec_deep_new(0, false, false);
