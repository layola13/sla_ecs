// Isolated deep tests for lib/schedule_table_value_deep.sla (Batch 371).
// table-value schedule: cap-8 systems with cap-4 read/write component-id lists + arena-flag
// pair (resource/messages) hazard matrix.
// panic codes: 140200 - 140399.

@import "lib/schedule_table_value_deep.sla"

const CID_POS: i32 = 1;
const CID_VEL: i32 = 2;
const CID_HP: i32 = 31;
const CID_MP: i32 = 32;

@test "Schedule default empty zero conflicts"() {
    let s = ecs_tbl_value_schedule_default();
    if ecs_tbl_value_schedule_len(s) != 0 { panic(140200); };
    if ecs_tbl_value_schedule_conflict_count(s) != 0 { panic(140201); };
}

@test "Access none empty and resource/messages flag mutators"() {
    let a = ecs_tbl_value_access_none();
    if ecs_tbl_value_len_reads(a) != 0 { panic(140210); };
    if ecs_tbl_value_len_writes(a) != 0 { panic(140211); };
    if ecs_tbl_value_reads_resource(a) != 0 { panic(140212); };
    if ecs_tbl_value_writes_resource(a) != 0 { panic(140213); };
    if ecs_tbl_value_reads_messages(a) != 0 { panic(140214); };
    if ecs_tbl_value_writes_messages(a) != 0 { panic(140215); };
    let ar = ecs_tbl_value_access_read_resource(a);
    if ecs_tbl_value_reads_resource(ar) != 1 { panic(140216); };
    let aw = ecs_tbl_value_access_write_resource(ar);
    if ecs_tbl_value_writes_resource(aw) != 1 { panic(140217); };
    let amr = ecs_tbl_value_access_read_messages(aw);
    if ecs_tbl_value_reads_messages(amr) != 1 { panic(140218); };
    let amw = ecs_tbl_value_access_write_messages(amr);
    if ecs_tbl_value_writes_messages(amw) != 1 { panic(140219); };
}

@test "Access read/write component mutators store table-world component ids"() {
    let a0 = ecs_tbl_value_access_none();
    let a1 = ecs_tbl_value_access_read_component(a0, CID_POS);
    let a2 = ecs_tbl_value_access_write_component(a1, CID_POS);
    if ecs_tbl_value_len_reads(a2) != 1 { panic(140220); };
    if ecs_tbl_value_len_writes(a2) != 1 { panic(140221); };
    if ecs_tbl_value_read_at(a2, 0) != CID_POS { panic(140222); };
    if ecs_tbl_value_write_at(a2, 0) != CID_POS { panic(140223); };
    let a3 = ecs_tbl_value_access_read_component(a2, CID_VEL);
    let a4 = ecs_tbl_value_access_write_component(a3, CID_HP);
    if ecs_tbl_value_len_reads(a4) != 2 { panic(140224); };
    if ecs_tbl_value_len_writes(a4) != 2 { panic(140225); };
    if ecs_tbl_value_read_at(a4, 1) != CID_VEL { panic(140226); };
    if ecs_tbl_value_write_at(a4, 1) != CID_HP { panic(140227); };
}

@test "Access read/write list cap-4 rejection"() {
    let a0 = ecs_tbl_value_access_none();
    let a1 = ecs_tbl_value_access_read_component(a0, 1);
    let a2 = ecs_tbl_value_access_read_component(a1, 2);
    let a3 = ecs_tbl_value_access_read_component(a2, 3);
    let a4 = ecs_tbl_value_access_read_component(a3, 4);
    let a5 = ecs_tbl_value_access_read_component(a4, 5);
    if ecs_tbl_value_len_reads(a5) != 4 { panic(140230); };
    if ecs_tbl_value_read_at(a5, 3) != 4 { panic(140231); };
    let a6 = ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), 10);
    let a7 = ecs_tbl_value_access_write_component(a6, 11);
    let a8 = ecs_tbl_value_access_write_component(a7, 12);
    let a9 = ecs_tbl_value_access_write_component(a8, 13);
    let a10 = ecs_tbl_value_access_write_component(a9, 14);
    if ecs_tbl_value_len_writes(a10) != 4 { panic(140232); };
    if ecs_tbl_value_write_at(a10, 3) != 13 { panic(140233); };
}

@test "Component conflict detection (write vs read/write on same id)"() {
    let write_pos = ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), CID_POS);
    let read_pos = ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), CID_POS);
    let write_vel = ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), CID_VEL);
    let read_vel = ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), CID_VEL);
    if ecs_tbl_value_access_conflicts(write_pos, read_pos) != true { panic(140240); };
    if ecs_tbl_value_access_conflicts(write_pos, write_pos) != true { panic(140241); };
    if ecs_tbl_value_access_conflicts(write_pos, read_vel) != false { panic(140242); };
    if ecs_tbl_value_access_conflicts(write_pos, write_vel) != false { panic(140243); };
    if ecs_tbl_value_access_conflicts(read_pos, read_pos) != false { panic(140244); };
}

@test "Resource and message conflict detection (arenas independent via arena_hazard)"() {
    let read_res = ecs_tbl_value_access_read_resource(ecs_tbl_value_access_none());
    let write_res = ecs_tbl_value_access_write_resource(ecs_tbl_value_access_none());
    let read_msg = ecs_tbl_value_access_read_messages(ecs_tbl_value_access_none());
    let write_msg = ecs_tbl_value_access_write_messages(ecs_tbl_value_access_none());
    if ecs_tbl_value_access_conflicts(write_res, read_res) != true { panic(140250); };
    if ecs_tbl_value_access_conflicts(write_res, write_res) != true { panic(140251); };
    if ecs_tbl_value_access_conflicts(read_res, read_res) != false { panic(140252); };
    if ecs_tbl_value_access_conflicts(write_msg, read_msg) != true { panic(140253); };
    if ecs_tbl_value_access_conflicts(write_msg, write_msg) != true { panic(140254); };
    if ecs_tbl_value_access_conflicts(read_msg, read_msg) != false { panic(140255); };
    if ecs_tbl_value_access_conflicts(write_res, write_msg) != false { panic(140256); };
    if ecs_tbl_value_access_conflicts(write_res, read_msg) != false { panic(140257); };
    if ecs_tbl_value_access_conflicts(write_msg, read_res) != false { panic(140258); };
}

@test "schedule_add_systems records one conflict per conflicting earlier system"() {
    let write_pos = ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), CID_POS);
    let read_pos = ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), CID_POS);
    let write_vel = ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), CID_VEL);
    let s0 = ecs_tbl_value_schedule_default();
    let s1 = ecs_tbl_value_schedule_add_systems(s0, write_pos);
    let s2 = ecs_tbl_value_schedule_add_systems(s1, read_pos);
    if ecs_tbl_value_schedule_conflict_count(s2) != 1 { panic(140260); };
    if ecs_tbl_value_schedule_len(s2) != 2 { panic(140261); };
    let s3 = ecs_tbl_value_schedule_add_systems(s2, write_vel);
    if ecs_tbl_value_schedule_conflict_count(s3) != 1 { panic(140262); };
    if ecs_tbl_value_schedule_len(s3) != 3 { panic(140263); };
    let s4 = ecs_tbl_value_schedule_add_systems(s3, read_pos);
    if ecs_tbl_value_schedule_conflict_count(s4) != 2 { panic(140264); };
    if ecs_tbl_value_schedule_len(s4) != 4 { panic(140265); };
}

@test "schedule_add_systems access retrievable per slot via access_at"() {
    let s0 = ecs_tbl_value_schedule_default();
    let a_read = ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), CID_HP);
    let a_write = ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), CID_HP);
    let a_msg = ecs_tbl_value_access_write_messages(ecs_tbl_value_access_none());
    let s1 = ecs_tbl_value_schedule_add_systems(s0, a_read);
    let s2 = ecs_tbl_value_schedule_add_systems(s1, a_write);
    let s3 = ecs_tbl_value_schedule_add_systems(s2, a_msg);
    if ecs_tbl_value_schedule_len(s3) != 3 { panic(140270); };
    let a0 = ecs_tbl_value_access_at(s3, 0);
    if ecs_tbl_value_read_at(a0, 0) != CID_HP { panic(140271); };
    if ecs_tbl_value_len_reads(a0) != 1 { panic(140272); };
    let a1 = ecs_tbl_value_access_at(s3, 1);
    if ecs_tbl_value_write_at(a1, 0) != CID_HP { panic(140273); };
    if ecs_tbl_value_len_writes(a1) != 1 { panic(140274); };
    let a2 = ecs_tbl_value_access_at(s3, 2);
    if ecs_tbl_value_writes_messages(a2) != 1 { panic(140275); };
    if ecs_tbl_value_schedule_conflict_count(s3) != 1 { panic(140276); };
}

@test "schedule cap-8 rejection and clear resets"() {
    let s0 = ecs_tbl_value_schedule_default();
    let s1 = s0;
    let i: i32 = 0;
    while i < 8 {
        let next = ecs_tbl_value_schedule_add_systems(s1, ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), 100 + i));
        s1 = next;
        i = i + 1;
    }
    if ecs_tbl_value_schedule_len(s1) != 8 { panic(140280); };
    if ecs_tbl_value_schedule_conflict_count(s1) != 0 { panic(140281); };
    let s2 = ecs_tbl_value_schedule_add_systems(s1, ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), 200));
    if ecs_tbl_value_schedule_len(s2) != 8 { panic(140282); };
    let s3 = ecs_tbl_value_schedule_clear(s2);
    if ecs_tbl_value_schedule_len(s3) != 0 { panic(140283); };
    if ecs_tbl_value_schedule_conflict_count(s3) != 0 { panic(140284); };
}

@test "mixed arena + component conflicts accumulate correctly"() {
    // system A writes resource + writes CID_HP.
    let a_wres_whp = ecs_tbl_value_access_write_resource(ecs_tbl_value_access_write_component(ecs_tbl_value_access_none(), CID_HP));
    // system B reads resource (conflicts with A's write-resource).
    let b_rres = ecs_tbl_value_access_read_resource(ecs_tbl_value_access_none());
    // system C writes messages (does not conflict with resource or component ids).
    let c_wmsg = ecs_tbl_value_access_write_messages(ecs_tbl_value_access_none());
    // system D reads CID_HP (conflicts with A's write of CID_HP).
    let d_rhp = ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), CID_HP);
    // system E reads CID_MP (no conflicts with anything queued).
    let e_rmp = ecs_tbl_value_access_read_component(ecs_tbl_value_access_none(), CID_MP);
    let s0 = ecs_tbl_value_schedule_default();
    let s1 = ecs_tbl_value_schedule_add_systems(s0, a_wres_whp);
    // A's queue is 0 systems; adding A contributes 0 conflicts.
    if ecs_tbl_value_schedule_conflict_count(s1) != 0 { panic(140290); };
    let s2 = ecs_tbl_value_schedule_add_systems(s1, b_rres);
    // B conflicts with A (write-resource on A vs read-resource on B) -> 1.
    if ecs_tbl_value_schedule_conflict_count(s2) != 1 { panic(140291); };
    let s3 = ecs_tbl_value_schedule_add_systems(s2, c_wmsg);
    // C conflicts with nothing (messages arena vs resource arena vs CID_HP are disjoint) -> 1.
    if ecs_tbl_value_schedule_conflict_count(s3) != 1 { panic(140292); };
    let s4 = ecs_tbl_value_schedule_add_systems(s3, d_rhp);
    // D conflicts with A (write CID_HP on A vs read CID_HP on D) -> 2.
    if ecs_tbl_value_schedule_conflict_count(s4) != 2 { panic(140293); };
    let s5 = ecs_tbl_value_schedule_add_systems(s4, e_rmp);
    // E conflicts with nothing -> 2.
    if ecs_tbl_value_schedule_conflict_count(s5) != 2 { panic(140294); };
    if ecs_tbl_value_schedule_len(s5) != 5 { panic(140295); };
}
