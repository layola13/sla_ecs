@import "lib/schedule_condition_deep.sla"

// Batch 178 tests for deepened schedule::condition combinators + stateful trackers.

@test "cond_outcome_ok_err_unwrap"() {
    let ok = ecs_cond_outcome_ok(true);
    if ecs_cond_outcome_is_ok(ok) != true { panic(99800); };
    if ecs_cond_outcome_unwrap_or_false(ok) != true { panic(99801); };
    let okf = ecs_cond_outcome_ok(false);
    if ecs_cond_outcome_unwrap_or_false(okf) != false { panic(99802); };
    let err = ecs_cond_outcome_err();
    if ecs_cond_outcome_is_err(err) != true { panic(99803); };
    if ecs_cond_outcome_unwrap_or_false(err) != false { panic(99804); };
}

@test "and_then_short_circuits_when_a_false"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_AND_THEN, false, true);
    if ecs_comb_eval_result(e) != false { panic(99810); };
    if ecs_comb_eval_a_ran(e) != true { panic(99811); };
    if ecs_comb_eval_b_ran(e) != false { panic(99812); };
    if ecs_comb_eval_a_unwrapped(e) != false { panic(99813); };
}

@test "and_then_runs_b_when_a_true"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_AND_THEN, true, true);
    if ecs_comb_eval_result(e) != true { panic(99820); };
    if ecs_comb_eval_b_ran(e) != true { panic(99821); };
    let e2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_AND_THEN, true, false);
    if ecs_comb_eval_result(e2) != false { panic(99822); };
    if ecs_comb_eval_b_ran(e2) != true { panic(99823); };
}

@test "and_eager_always_runs_both"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_AND_EAGER, false, true);
    if ecs_comb_eval_result(e) != false { panic(99830); };
    if ecs_comb_eval_b_ran(e) != true { panic(99831); };
    let e2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_AND_EAGER, true, false);
    if ecs_comb_eval_result(e2) != false { panic(99832); };
    if ecs_comb_eval_b_ran(e2) != true { panic(99833); };
}

@test "or_else_short_circuits_when_a_true"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_OR_ELSE, true, false);
    if ecs_comb_eval_result(e) != true { panic(99840); };
    if ecs_comb_eval_b_ran(e) != false { panic(99841); };
}

@test "or_else_runs_b_when_a_false"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_OR_ELSE, false, true);
    if ecs_comb_eval_result(e) != true { panic(99850); };
    if ecs_comb_eval_b_ran(e) != true { panic(99851); };
    let e2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_OR_ELSE, false, false);
    if ecs_comb_eval_result(e2) != false { panic(99852); };
    if ecs_comb_eval_b_ran(e2) != true { panic(99853); };
}

@test "or_eager_always_runs_both"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_OR_EAGER, true, false);
    if ecs_comb_eval_result(e) != true { panic(99860); };
    if ecs_comb_eval_b_ran(e) != true { panic(99861); };
}

@test "nand_then_short_circuits_and_negates"() {
    // A=false => B not run; result = !(false && b) = true
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_NAND_THEN, false, true);
    if ecs_comb_eval_result(e) != true { panic(99870); };
    if ecs_comb_eval_b_ran(e) != false { panic(99871); };
    // A=true, B=true => !(true && true) = false; B runs
    let e2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_NAND_THEN, true, true);
    if ecs_comb_eval_result(e2) != false { panic(99872); };
    if ecs_comb_eval_b_ran(e2) != true { panic(99873); };
}

@test "nor_else_short_circuits_and_negates"() {
    // A=true => B not run; result = !(true || b) = false
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_NOR_ELSE, true, false);
    if ecs_comb_eval_result(e) != false { panic(99880); };
    if ecs_comb_eval_b_ran(e) != false { panic(99881); };
    // A=false, B=false => !(false || false) = true
    let e2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_NOR_ELSE, false, false);
    if ecs_comb_eval_result(e2) != true { panic(99882); };
    if ecs_comb_eval_b_ran(e2) != true { panic(99883); };
}

@test "xor_and_xnor_eager"() {
    let x1 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_XOR, true, false);
    if ecs_comb_eval_result(x1) != true { panic(99890); };
    if ecs_comb_eval_b_ran(x1) != true { panic(99891); };
    let x2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_XOR, true, true);
    if ecs_comb_eval_result(x2) != false { panic(99892); };
    let n1 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_XNOR, true, true);
    if ecs_comb_eval_result(n1) != true { panic(99893); };
    let n2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_XNOR, true, false);
    if ecs_comb_eval_result(n2) != false { panic(99894); };
    if ecs_comb_eval_b_ran(n2) != true { panic(99895); };
}

@test "nand_eager_and_nor_eager_always_run_b"() {
    let e = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_NAND_EAGER, false, true);
    if ecs_comb_eval_b_ran(e) != true { panic(99900); };
    if ecs_comb_eval_result(e) != true { panic(99901); };
    let e2 = ecs_comb_deep_eval_bools(ECS_COMB_DEEP_NOR_EAGER, true, false);
    if ecs_comb_eval_b_ran(e2) != true { panic(99902); };
    if ecs_comb_eval_result(e2) != false { panic(99903); };
}

@test "combinator_err_unwraps_to_false"() {
    // A err => unwrap false; AndThen short-circuits B
    let e = ecs_comb_deep_eval(ECS_COMB_DEEP_AND_THEN, ecs_cond_outcome_err(), ecs_cond_outcome_ok(true));
    if ecs_comb_eval_result(e) != false { panic(99910); };
    if ecs_comb_eval_a_unwrapped(e) != false { panic(99911); };
    if ecs_comb_eval_b_ran(e) != false { panic(99912); };
    // A true, B err => unwrap B false; AndThen result false
    let e2 = ecs_comb_deep_eval(ECS_COMB_DEEP_AND_THEN, ecs_cond_outcome_ok(true), ecs_cond_outcome_err());
    if ecs_comb_eval_result(e2) != false { panic(99913); };
    if ecs_comb_eval_b_ran(e2) != true { panic(99914); };
    if ecs_comb_eval_b_unwrapped(e2) != false { panic(99915); };
}

@test "not_marker_negates_and_err_is_false"() {
    if ecs_comb_deep_not(ecs_cond_outcome_ok(true)) != false { panic(99920); };
    if ecs_comb_deep_not(ecs_cond_outcome_ok(false)) != true { panic(99921); };
    if ecs_comb_deep_not(ecs_cond_outcome_err()) != true { panic(99922); };
}

@test "system_condition_kind_builders"() {
    if ecs_system_condition_and_then() != 0 { panic(99930); };
    if ecs_system_condition_and_eager() != 1 { panic(99931); };
    if ecs_system_condition_xnor() != 8 { panic(99932); };
    if ecs_system_condition_xor() != 9 { panic(99933); };
    if ecs_comb_deep_is_then(ECS_COMB_DEEP_AND_THEN) != true { panic(99934); };
    if ecs_comb_deep_is_eager(ECS_COMB_DEEP_AND_EAGER) != true { panic(99935); };
}

@test "res_changed_or_removed_tracks_local_existed"() {
    let t = ecs_res_track_deep_new();
    // missing, never existed
    let r0 = ecs_res_changed_or_removed(t, false, false);
    if r0.0 != false { panic(99940); };
    if ecs_res_track_deep_existed(r0.1) != false { panic(99941); };
    // present and changed
    let r1 = ecs_res_changed_or_removed(r0.1, true, true);
    if r1.0 != true { panic(99942); };
    if ecs_res_track_deep_existed(r1.1) != true { panic(99943); };
    // present unchanged
    let r2 = ecs_res_changed_or_removed(r1.1, true, false);
    if r2.0 != false { panic(99944); };
    // removed after existing
    let r3 = ecs_res_changed_or_removed(r2.1, false, false);
    if r3.0 != true { panic(99945); };
    if ecs_res_track_deep_existed(r3.1) != false { panic(99946); };
    // still missing
    let r4 = ecs_res_changed_or_removed(r3.1, false, false);
    if r4.0 != false { panic(99947); };
}

@test "res_removed_tracks_local_existed"() {
    let t = ecs_res_track_deep_new();
    let r0 = ecs_res_removed(t, false);
    if r0.0 != false { panic(99950); };
    let r1 = ecs_res_removed(r0.1, true);
    if r1.0 != false { panic(99951); };
    if ecs_res_track_deep_existed(r1.1) != true { panic(99952); };
    let r2 = ecs_res_removed(r1.1, true);
    if r2.0 != false { panic(99953); };
    let r3 = ecs_res_removed(r2.1, false);
    if r3.0 != true { panic(99954); };
    if ecs_res_track_deep_existed(r3.1) != false { panic(99955); };
    let r4 = ecs_res_removed(r3.1, false);
    if r4.0 != false { panic(99956); };
}

@test "resource_exists_added_changed_facades"() {
    if ecs_cond_deep_resource_exists(true) != true { panic(99960); };
    if ecs_cond_deep_resource_exists(false) != false { panic(99961); };
    if ecs_cond_deep_resource_added(true, true) != true { panic(99962); };
    if ecs_cond_deep_resource_added(false, true) != false { panic(99963); };
    if ecs_cond_deep_resource_added(true, false) != false { panic(99964); };
    let c = ecs_cond_deep_resource_changed(true, true);
    if c.0 != true { panic(99965); };
    if c.1 != true { panic(99966); };
    let c2 = ecs_cond_deep_resource_changed(false, true);
    if c2.0 != false { panic(99967); };
    if ecs_cond_deep_resource_exists_and_changed(true, true) != true { panic(99968); };
    if ecs_cond_deep_resource_exists_and_changed(false, true) != false { panic(99969); };
}

@test "resource_equals_and_exists_and_equals"() {
    let e = ecs_cond_deep_resource_equals(true, 5, 5);
    if e.0 != true { panic(99970); };
    if e.1 != true { panic(99971); };
    let e2 = ecs_cond_deep_resource_equals(false, 5, 5);
    if e2.0 != false { panic(99972); };
    if ecs_cond_deep_resource_exists_and_equals(true, 5, 5) != true { panic(99973); };
    if ecs_cond_deep_resource_exists_and_equals(false, 5, 5) != false { panic(99974); };
    if ecs_cond_deep_resource_exists_and_equals(true, 5, 6) != false { panic(99975); };
    if ecs_cond_deep_resource_exists_and(true, true) != true { panic(99976); };
    if ecs_cond_deep_resource_exists_and(false, true) != false { panic(99977); };
}

@test "on_message_and_any_helpers"() {
    if ecs_cond_deep_on_message(0) != false { panic(99980); };
    if ecs_cond_deep_on_message(3) != true { panic(99981); };
    if ecs_cond_deep_any_with_component(0) != false { panic(99982); };
    if ecs_cond_deep_any_with_component(1) != true { panic(99983); };
    if ecs_cond_deep_any_component_removed(2) != true { panic(99984); };
    if ecs_cond_deep_any_match_filter(0) != false { panic(99985); };
}

@test "condition_changed_deep_local_prev_default_false"() {
    let s = ecs_cond_changed_deep_new();
    // first call: prev=false, new=true => changed
    let r1 = ecs_cond_changed_deep(s, true);
    if r1.0 != true { panic(99990); };
    if ecs_cond_changed_deep_prev(r1.1) != true { panic(99991); };
    let r2 = ecs_cond_changed_deep(r1.1, true);
    if r2.0 != false { panic(99992); };
    let r3 = ecs_cond_changed_deep(r2.1, false);
    if r3.0 != true { panic(99993); };
}

@test "condition_changed_to_deep"() {
    let s = ecs_cond_changed_deep_new();
    // prev=false, new=true, to=true => true
    let r1 = ecs_cond_changed_to_deep(s, true, true);
    if r1.0 != true { panic(100000); };
    // still true => false
    let r2 = ecs_cond_changed_to_deep(r1.1, true, true);
    if r2.0 != false { panic(100001); };
    // to false
    let r3 = ecs_cond_changed_to_deep(r2.1, false, false);
    if r3.0 != true { panic(100002); };
}

@test "run_once_deep"() {
    let s = ecs_run_once_deep_new();
    let r1 = ecs_run_once_deep(s);
    if r1.0 != true { panic(100010); };
    if ecs_run_once_deep_has_run(r1.1) != true { panic(100011); };
    let r2 = ecs_run_once_deep(r1.1);
    if r2.0 != false { panic(100012); };
    let r3 = ecs_run_once_deep(r2.1);
    if r3.0 != false { panic(100013); };
}

@test "should_run_b_policy_table"() {
    if ecs_comb_deep_should_run_b(ECS_COMB_DEEP_AND_THEN, true) != true { panic(100020); };
    if ecs_comb_deep_should_run_b(ECS_COMB_DEEP_AND_THEN, false) != false { panic(100021); };
    if ecs_comb_deep_should_run_b(ECS_COMB_DEEP_OR_ELSE, true) != false { panic(100022); };
    if ecs_comb_deep_should_run_b(ECS_COMB_DEEP_OR_ELSE, false) != true { panic(100023); };
    if ecs_comb_deep_should_run_b(ECS_COMB_DEEP_XOR, false) != true { panic(100024); };
    if ecs_comb_deep_should_run_b(ECS_COMB_DEEP_XNOR, true) != true { panic(100025); };
}
