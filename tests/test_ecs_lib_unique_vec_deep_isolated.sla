@import "lib/unique_vec_deep.sla"

// Batch 325: unique_vec deep.
// panic codes: 131000 – 131199.

@test "new_empty"() {
    let v = ecs_uv_deep_new();
    if ecs_uv_deep_is_empty(v) != true { panic(131000); };
}

@test "push_unique"() {
    let v = ecs_uv_deep_new();
    v = ecs_uv_deep_push(v, 1);
    v = ecs_uv_deep_push(v, 2);
    v = ecs_uv_deep_push(v, 1);
    if ecs_uv_deep_len(v) != 2 { panic(131010); };
}

@test "contains_and_index"() {
    let v = ecs_uv_deep_push(ecs_uv_deep_push(ecs_uv_deep_new(), 4), 5);
    if ecs_uv_deep_contains(v, 5) != true { panic(131020); };
    if ecs_uv_deep_index_of(v, 4) != 0 { panic(131021); };
    if ecs_uv_deep_index_of(v, 9) != (0 - 1) { panic(131022); };
}

@test "get_first_last"() {
    let v = ecs_uv_deep_push(ecs_uv_deep_push(ecs_uv_deep_new(), 10), 20);
    if ecs_uv_get_value(ecs_uv_deep_first(v)) != 10 { panic(131030); };
    if ecs_uv_get_value(ecs_uv_deep_last(v)) != 20 { panic(131031); };
    if ecs_uv_get_value(ecs_uv_deep_get(v, 1)) != 20 { panic(131032); };
}

@test "get_oob"() {
    let v = ecs_uv_deep_new();
    if ecs_uv_get_ok(ecs_uv_deep_get(v, 0)) != false { panic(131040); };
}

@test "at"() {
    let v = ecs_uv_deep_push(ecs_uv_deep_push(ecs_uv_deep_new(), 1), 2);
    if ecs_uv_deep_at(v, 0) != 1 { panic(131050); };
    if ecs_uv_deep_at(v, 1) != 2 { panic(131051); };
}

@test "clear"() {
    let v = ecs_uv_deep_push(ecs_uv_deep_new(), 1);
    v = ecs_uv_deep_clear(v);
    if ecs_uv_deep_is_empty(v) != true { panic(131060); };
}

@test "capacity_eight"() {
    let v = ecs_uv_deep_new();
    v = ecs_uv_deep_push(v, 1);
    v = ecs_uv_deep_push(v, 2);
    v = ecs_uv_deep_push(v, 3);
    v = ecs_uv_deep_push(v, 4);
    v = ecs_uv_deep_push(v, 5);
    v = ecs_uv_deep_push(v, 6);
    v = ecs_uv_deep_push(v, 7);
    v = ecs_uv_deep_push(v, 8);
    if ecs_uv_deep_len(v) != 8 { panic(131070); };
    v = ecs_uv_deep_push(v, 9);
    if ecs_uv_deep_len(v) != 8 { panic(131071); };
}

@test "contains_false"() {
    let v = ecs_uv_deep_push(ecs_uv_deep_new(), 1);
    if ecs_uv_deep_contains(v, 2) != false { panic(131080); };
}

@test "first_empty"() {
    let v = ecs_uv_deep_new();
    if ecs_uv_get_ok(ecs_uv_deep_first(v)) != false { panic(131090); };
    if ecs_uv_get_ok(ecs_uv_deep_last(v)) != false { panic(131091); };
}
