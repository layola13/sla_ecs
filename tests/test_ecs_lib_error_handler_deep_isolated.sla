@import "lib/error_handler_deep.sla"

// Batch 199: Error handler + CommandOutput deep.

@test "state_defaults_to_match_severity"() {
    let s = ecs_eh_state_new();
    if ecs_eh_fallback_handler(s) != ECS_EH_H_MATCH { panic(105600); };
    if ecs_eh_invoke_count(s) != 0 { panic(105601); };
    if ecs_eh_panic_from_handler(s) != false { panic(105602); };
}

@test "ctx_system_kind_and_display"() {
    let c = ecs_eh_ctx_system(7, 3);
    if ecs_eh_ctx_kind(c) != ECS_EH_CTX_SYSTEM { panic(105610); };
    if ecs_eh_ctx_name(c) != 7 { panic(105611); };
    if ecs_eh_ctx_last_run(c) != 3 { panic(105612); };
    if ecs_eh_ctx_kind_label(c) != ECS_EH_KIND_SYSTEM { panic(105613); };
    if ecs_eh_ctx_display_code(c) != 1000007 { panic(105614); };
}

@test "ctx_command_observer_run_condition"() {
    let c = ecs_eh_ctx_command(5);
    if ecs_eh_ctx_kind_label(c) != ECS_EH_KIND_COMMAND { panic(105620); };
    if ecs_eh_ctx_display_code(c) != 2000005 { panic(105621); };
    let o = ecs_eh_ctx_observer(9, 1);
    if ecs_eh_ctx_kind_label(o) != ECS_EH_KIND_OBSERVER { panic(105622); };
    let rc = ecs_eh_ctx_run_condition(2, 0, 8, false);
    if ecs_eh_ctx_display_code(rc) != 4000002 { panic(105623); };
    let rcs = ecs_eh_ctx_run_condition(2, 0, 8, true);
    if ecs_eh_ctx_display_code(rcs) != 4500002 { panic(105624); };
    if ecs_eh_ctx_on_set(rcs) != true { panic(105625); };
    if ecs_eh_ctx_system_name(rcs) != 8 { panic(105626); };
}

@test "match_severity_dispatches_all"() {
    let s = ecs_eh_state_new();
    let c = ecs_eh_ctx_system(1, 0);
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_IGNORE, 1), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_IGNORE { panic(105630); };
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_TRACE, 2), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_TRACE { panic(105631); };
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_DEBUG, 3), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_DEBUG { panic(105632); };
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_INFO, 4), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_INFO { panic(105633); };
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_WARNING, 5), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_WARN { panic(105634); };
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_ERROR, 6), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_ERROR { panic(105635); };
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_PANIC, 7), c);
    if ecs_eh_last_handler(s) != ECS_EH_H_PANIC { panic(105636); };
    if ecs_eh_did_panic(s) != true { panic(105637); };
    if ecs_eh_panic_from_handler(s) != true { panic(105638); };
}

@test "handler_counts"() {
    let s = ecs_eh_state_new();
    let c = ecs_eh_ctx_command(1);
    s = ecs_eh_handle_warn(s, ecs_eh_error_new(ECS_EH_SEV_WARNING, 1), c);
    s = ecs_eh_handle_warn(s, ecs_eh_error_new(ECS_EH_SEV_WARNING, 2), c);
    s = ecs_eh_handle_error(s, ecs_eh_error_new(ECS_EH_SEV_ERROR, 3), c);
    if ecs_eh_warn_count(s) != 2 { panic(105640); };
    if ecs_eh_error_count(s) != 1 { panic(105641); };
    if ecs_eh_invoke_count(s) != 3 { panic(105642); };
}

@test "fallback_override_to_ignore"() {
    let s = ecs_eh_state_new();
    s = ecs_eh_set_fallback(s, ECS_EH_H_IGNORE);
    let e = ecs_eh_error_new(ECS_EH_SEV_PANIC, 9);
    let c = ecs_eh_ctx_system(3, 0);
    s = ecs_eh_invoke_fallback(s, e, c);
    if ecs_eh_last_handler(s) != ECS_EH_H_IGNORE { panic(105650); };
    if ecs_eh_did_panic(s) != false { panic(105651); };
    if ecs_eh_ignore_count(s) != 1 { panic(105652); };
}

@test "fallback_panic_sets_flag"() {
    let s = ecs_eh_state_new();
    s = ecs_eh_set_fallback(s, ECS_EH_H_PANIC);
    s = ecs_eh_invoke_fallback(s, ecs_eh_error_new(ECS_EH_SEV_ERROR, 1), ecs_eh_ctx_observer(2, 0));
    if ecs_eh_panic_from_handler(s) != true { panic(105660); };
    s = ecs_eh_clear_panic_flag(s);
    if ecs_eh_panic_from_handler(s) != false { panic(105661); };
    if ecs_eh_did_panic(s) != true { panic(105662); };
}

@test "command_output_ok_skips_handler"() {
    let s = ecs_eh_state_new();
    let out = ecs_eh_cmd_ok();
    s = ecs_eh_handle_command_output(s, out, 5);
    if ecs_eh_invoke_count(s) != 0 { panic(105670); };
    if ecs_eh_cmd_is_ok(out) != true { panic(105671); };
}

@test "command_output_err_invokes_fallback"() {
    let s = ecs_eh_state_new();
    let out = ecs_eh_cmd_err(12, 34, ECS_EH_SEV_WARNING);
    s = ecs_eh_handle_command_output(s, out, 77);
    if ecs_eh_last_handler(s) != ECS_EH_H_WARN { panic(105680); };
    if ecs_eh_last_ctx_kind(s) != ECS_EH_CTX_COMMAND { panic(105681); };
    if ecs_eh_last_ctx_name(s) != 77 { panic(105682); };
    if ecs_eh_last_message(s) != 34 { panic(105683); };
    if ecs_eh_cmd_error_code(out) != 12 { panic(105684); };
}

@test "severity_to_handler_map"() {
    if ecs_eh_severity_to_handler(ECS_EH_SEV_IGNORE) != ECS_EH_H_IGNORE { panic(105690); };
    if ecs_eh_severity_to_handler(ECS_EH_SEV_WARNING) != ECS_EH_H_WARN { panic(105691); };
    if ecs_eh_severity_to_handler(ECS_EH_SEV_PANIC) != ECS_EH_H_PANIC { panic(105692); };
}

@test "error_with_severity"() {
    let e = ecs_eh_error_new(ECS_EH_SEV_INFO, 5);
    e = ecs_eh_error_with_severity(e, ECS_EH_SEV_ERROR);
    if ecs_eh_error_severity(e) != ECS_EH_SEV_ERROR { panic(105700); };
    if ecs_eh_error_message(e) != 5 { panic(105701); };
}

@test "match_records_context"() {
    let s = ecs_eh_state_new();
    let c = ecs_eh_ctx_system(42, 9);
    s = ecs_eh_match_severity(s, ecs_eh_error_new(ECS_EH_SEV_INFO, 8), c);
    if ecs_eh_last_ctx_name(s) != 42 { panic(105710); };
    if ecs_eh_last_severity(s) != ECS_EH_SEV_INFO { panic(105711); };
    if ecs_eh_info_count(s) != 1 { panic(105712); };
}

@test "all_log_handlers"() {
    let s = ecs_eh_state_new();
    let c = ecs_eh_ctx_command(1);
    let e = ecs_eh_error_new(ECS_EH_SEV_TRACE, 1);
    s = ecs_eh_handle_trace(s, e, c);
    s = ecs_eh_handle_debug(s, e, c);
    s = ecs_eh_handle_info(s, e, c);
    if ecs_eh_trace_count(s) != 1 { panic(105720); };
    if ecs_eh_debug_count(s) != 1 { panic(105721); };
    if ecs_eh_info_count(s) != 1 { panic(105722); };
}

@test "cmd_accessors"() {
    let o = ecs_eh_cmd_err(3, 4, ECS_EH_SEV_ERROR);
    if ecs_eh_cmd_is_ok(o) != false { panic(105730); };
    if ecs_eh_cmd_message(o) != 4 { panic(105731); };
    if ecs_eh_cmd_severity(o) != ECS_EH_SEV_ERROR { panic(105732); };
}

@test "lifecycle_fallback_command_panic"() {
    let s = ecs_eh_state_new();
    // default match: warning -> warn
    s = ecs_eh_handle_command_output(s, ecs_eh_cmd_err(1, 2, ECS_EH_SEV_WARNING), 10);
    if ecs_eh_warn_count(s) != 1 { panic(105740); };
    // switch fallback to panic
    s = ecs_eh_set_fallback(s, ECS_EH_H_PANIC);
    s = ecs_eh_handle_command_output(s, ecs_eh_cmd_err(1, 2, ECS_EH_SEV_INFO), 11);
    if ecs_eh_panic_count(s) != 1 { panic(105741); };
    if ecs_eh_panic_from_handler(s) != true { panic(105742); };
}

@test "set_fallback_match_restores_dispatch"() {
    let s = ecs_eh_state_new();
    s = ecs_eh_set_fallback(s, ECS_EH_H_ERROR);
    s = ecs_eh_set_fallback(s, ECS_EH_H_MATCH);
    s = ecs_eh_invoke_fallback(s, ecs_eh_error_new(ECS_EH_SEV_TRACE, 1), ecs_eh_ctx_system(1, 0));
    if ecs_eh_last_handler(s) != ECS_EH_H_TRACE { panic(105750); };
}

@test "run_condition_on_set_flag"() {
    let c = ecs_eh_ctx_run_condition(1, 2, 3, true);
    if ecs_eh_ctx_on_set(c) != true { panic(105760); };
    if ecs_eh_ctx_kind(c) != ECS_EH_CTX_RUN_CONDITION { panic(105761); };
}

@test "ignore_handler_no_panic"() {
    let s = ecs_eh_state_new();
    s = ecs_eh_handle_ignore(s, ecs_eh_error_new(ECS_EH_SEV_PANIC, 1), ecs_eh_ctx_command(1));
    if ecs_eh_did_panic(s) != false { panic(105770); };
    if ecs_eh_ignore_count(s) != 1 { panic(105771); };
}

@test "panic_count_increments"() {
    let s = ecs_eh_state_new();
    let c = ecs_eh_ctx_system(1, 0);
    s = ecs_eh_handle_panic(s, ecs_eh_error_new(ECS_EH_SEV_PANIC, 1), c);
    s = ecs_eh_handle_panic(s, ecs_eh_error_new(ECS_EH_SEV_PANIC, 2), c);
    if ecs_eh_panic_count(s) != 2 { panic(105780); };
}
