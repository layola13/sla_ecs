@import "lib/entity_access_except_deep.sla"

// Batch 269: entity_access_except deep (src/world/entity_access/except.rs).
// panic codes: 119800 – 119999.

@test "bundle_excludes"() {
    let b = ecs_except_bundle_deep_new();
    b = ecs_except_bundle_deep_add(b, 1);
    b = ecs_except_bundle_deep_add(b, 3);
    if ecs_except_bundle_deep_len(b) != 2 { panic(119800); };
    if ecs_except_bundle_contains(b, 1) != true { panic(119801); };
    if ecs_except_bundle_contains(b, 2) != false { panic(119802); };
}

@test "ref_get_hides_excluded"() {
    let e = ecs_except_entity_deep_new(10);
    e = ecs_except_entity_deep_insert(e, 1, 100, 1);
    e = ecs_except_entity_deep_insert(e, 2, 200, 2);
    let b = ecs_except_bundle_deep_new();
    b = ecs_except_bundle_deep_add(b, 1);
    let v = ecs_entity_ref_except_deep_new(e, b);
    if ecs_entity_ref_except_deep_contains(v, 1) != true { panic(119810); };
    let g1 = ecs_entity_ref_except_deep_get(v, 1);
    if ecs_except_get_found(g1) != false { panic(119811); };
    let g2 = ecs_entity_ref_except_deep_get(v, 2);
    if ecs_except_get_found(g2) != true { panic(119812); };
    if ecs_except_get_value(g2) != 200 { panic(119813); };
}

@test "ref_get_change_ticks_excluded"() {
    let e = ecs_except_entity_deep_new(11);
    e = ecs_except_entity_deep_insert(e, 4, 1, 77);
    let b = ecs_except_bundle_deep_new();
    b = ecs_except_bundle_deep_add(b, 4);
    let v = ecs_entity_ref_except_deep_new(e, b);
    let t = ecs_entity_ref_except_deep_get_change_ticks(v, 4);
    if ecs_except_get_found(t) != false { panic(119820); };
    b = ecs_except_bundle_deep_new();
    v = ecs_entity_ref_except_deep_new(e, b);
    t = ecs_entity_ref_except_deep_get_change_ticks(v, 4);
    if ecs_except_get_tick(t) != 77 { panic(119821); };
}

@test "ref_into_filtered_readonly"() {
    let e = ecs_except_entity_deep_new(12);
    e = ecs_except_entity_deep_insert(e, 5, 50, 1);
    let b = ecs_except_bundle_deep_new();
    b = ecs_except_bundle_deep_add(b, 5);
    let v = ecs_entity_ref_except_deep_new(e, b);
    let f = ecs_entity_ref_except_deep_into_filtered(v);
    if ecs_except_filtered_deep_writable(f) != false { panic(119830); };
    if ecs_except_filtered_deep_id(f) != 12 { panic(119831); };
    let g = ecs_except_filtered_deep_get(f, 5);
    if ecs_except_get_found(g) != false { panic(119832); };
}

@test "mut_get_mut_and_set"() {
    let e = ecs_except_entity_deep_new(13);
    e = ecs_except_entity_deep_insert(e, 2, 20, 1);
    e = ecs_except_entity_deep_insert(e, 3, 30, 1);
    let b = ecs_except_bundle_deep_new();
    b = ecs_except_bundle_deep_add(b, 2);
    let v = ecs_entity_mut_except_deep_new(e, b);
    let g2 = ecs_entity_mut_except_deep_get_mut(v, 2);
    if ecs_except_get_found(g2) != false { panic(119840); };
    let s2 = ecs_entity_mut_except_deep_set(v, 2, 99, 5);
    if ecs_except_mut_set_ok(s2) != false { panic(119841); };
    let s3 = ecs_entity_mut_except_deep_set(v, 3, 33, 6);
    if ecs_except_mut_set_ok(s3) != true { panic(119842); };
    v = ecs_except_mut_set_view(s3);
    let g3 = ecs_entity_mut_except_deep_get(v, 3);
    if ecs_except_get_value(g3) != 33 { panic(119843); };
    if ecs_except_get_tick(g3) != 6 { panic(119844); };
}

@test "mut_into_readonly_and_reborrow"() {
    let e = ecs_except_entity_deep_new(14);
    e = ecs_except_entity_deep_insert(e, 1, 7, 1);
    let b = ecs_except_bundle_deep_new();
    let v = ecs_entity_mut_except_deep_new(e, b);
    let r = ecs_entity_mut_except_deep_into_readonly(v);
    if ecs_entity_ref_except_deep_id(r) != 14 { panic(119850); };
    let g = ecs_entity_ref_except_deep_get(r, 1);
    if ecs_except_get_value(g) != 7 { panic(119851); };
    let v2 = ecs_entity_mut_except_deep_reborrow(v);
    if ecs_entity_mut_except_deep_id(v2) != 14 { panic(119852); };
}

@test "mut_into_filtered_writable"() {
    let e = ecs_except_entity_deep_new(15);
    let b = ecs_except_bundle_deep_new();
    b = ecs_except_bundle_deep_add(b, 9);
    let v = ecs_entity_mut_except_deep_new(e, b);
    let f = ecs_entity_mut_except_deep_into_filtered(v);
    if ecs_except_filtered_deep_writable(f) != true { panic(119860); };
}

@test "spawn_meta"() {
    let e = ecs_except_entity_deep_new(16);
    e = ecs_except_entity_deep_with_spawn(e, 100, 50);
    let b = ecs_except_bundle_deep_new();
    let v = ecs_entity_ref_except_deep_new(e, b);
    if ecs_entity_ref_except_deep_spawned_by(v) != 100 { panic(119870); };
    if ecs_entity_ref_except_deep_spawn_tick(v) != 50 { panic(119871); };
}

@test "eq_cmp_ref"() {
    let e1 = ecs_except_entity_deep_new(1);
    let e2 = ecs_except_entity_deep_new(2);
    let b = ecs_except_bundle_deep_new();
    let a = ecs_entity_ref_except_deep_new(e1, b);
    let c = ecs_entity_ref_except_deep_new(e2, b);
    if ecs_entity_ref_except_deep_eq(a, c) != false { panic(119880); };
    if ecs_entity_ref_except_deep_cmp(a, c) != -1 { panic(119881); };
}

@test "eq_cmp_mut"() {
    let e1 = ecs_except_entity_deep_new(5);
    let e2 = ecs_except_entity_deep_new(8);
    let b = ecs_except_bundle_deep_new();
    let a = ecs_entity_mut_except_deep_new(e1, b);
    let c = ecs_entity_mut_except_deep_new(e2, b);
    if ecs_entity_mut_except_deep_eq(a, c) != false { panic(119890); };
    if ecs_entity_mut_except_deep_cmp(c, a) != 1 { panic(119891); };
}
