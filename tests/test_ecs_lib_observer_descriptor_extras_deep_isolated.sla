@import "lib/observer_descriptor_extras_deep.sla"

// Batch 285: observer_descriptor_extras deep (src/observer/distributed_storage.rs).
// panic codes: 123000 – 123199.

@test "descriptor_with_event_keys"() {
    let d = ecs_ode_desc_new();
    d = ecs_ode_desc_with_event_keys(d, 1, 2, 3, 0, 3);
    if ecs_ode_desc_ek_len(d) != 3 { panic(123000); };
    if ecs_ode_desc_event_key_at(d, 0) != 1 { panic(123001); };
    if ecs_ode_desc_event_key_at(d, 2) != 3 { panic(123002); };
    if ecs_ode_desc_contains_event_key(d, 2) != true { panic(123003); };
    if ecs_ode_desc_contains_event_key(d, 9) != false { panic(123004); };
}

@test "descriptor_with_components_and_entities"() {
    let d = ecs_ode_desc_new();
    d = ecs_ode_desc_with_components(d, 10, 20, 0, 0, 2);
    d = ecs_ode_desc_with_entities(d, 100, 200, 300, 0, 3);
    if ecs_ode_desc_c_len(d) != 2 { panic(123010); };
    if ecs_ode_desc_e_len(d) != 3 { panic(123011); };
    if ecs_ode_desc_component_at(d, 1) != 20 { panic(123012); };
    if ecs_ode_desc_entity_at(d, 2) != 300 { panic(123013); };
    if ecs_ode_desc_contains_component(d, 10) != true { panic(123014); };
    if ecs_ode_desc_contains_entity(d, 200) != true { panic(123015); };
}

@test "observer_builder_chain"() {
    let o = ecs_ode_obs_new();
    o = ecs_ode_obs_with_event_key(o, 7);
    o = ecs_ode_obs_with_component(o, 3);
    o = ecs_ode_obs_with_entity(o, 42);
    o = ecs_ode_obs_with_error_handler(o, 99);
    o = ecs_ode_obs_with_name(o, 1000);
    if ecs_ode_obs_error_handler(o) != 99 { panic(123020); };
    if ecs_ode_obs_name(o) != 1000 { panic(123021); };
    let d = ecs_ode_obs_descriptor(o);
    if ecs_ode_desc_ek_len(d) != 1 { panic(123022); };
    if ecs_ode_desc_c_len(d) != 1 { panic(123023); };
    if ecs_ode_desc_e_len(d) != 1 { panic(123024); };
    if ecs_ode_desc_entity_at(d, 0) != 42 { panic(123025); };
}

@test "run_bumps_last_trigger_id"() {
    let o = ecs_ode_obs_new();
    if ecs_ode_obs_last_trigger_id(o) != 0 { panic(123030); };
    o = ecs_ode_obs_run(o);
    o = ecs_ode_obs_run(o);
    if ecs_ode_obs_last_trigger_id(o) != 2 { panic(123031); };
    o = ecs_ode_obs_reset_run_state(o);
    if ecs_ode_obs_last_trigger_id(o) != 0 { panic(123032); };
    if ecs_ode_obs_despawned_watched(o) != 0 { panic(123033); };
}

@test "auto_despawn_when_all_entities_gone"() {
    let o = ecs_ode_obs_new();
    o = ecs_ode_obs_with_entities(o, 1, 2, 0, 0, 2);
    if ecs_ode_obs_alive(o) != true { panic(123040); };
    o = ecs_ode_obs_record_despawned(o);
    if ecs_ode_obs_despawned_watched(o) != 1 { panic(123041); };
    if ecs_ode_obs_alive(o) != true { panic(123042); };
    o = ecs_ode_obs_record_despawned(o);
    if ecs_ode_obs_despawned_watched(o) != 2 { panic(123043); };
    if ecs_ode_obs_alive(o) != false { panic(123044); };
}

@test "global_observer_no_auto_despawn_without_entities"() {
    let o = ecs_ode_obs_new();
    o = ecs_ode_obs_with_event_key(o, 1);
    // no entities watched: record_despawned should not kill
    o = ecs_ode_obs_record_despawned(o);
    if ecs_ode_obs_alive(o) != true { panic(123050); };
    if ecs_ode_obs_despawned_watched(o) != 1 { panic(123051); };
}

@test "matches_event_key"() {
    let o = ecs_ode_obs_new();
    if ecs_ode_obs_matches_event(o, 1) != false { panic(123060); };
    o = ecs_ode_obs_with_event_keys(o, 1, 2, 0, 0, 2);
    if ecs_ode_obs_matches_event(o, 1) != true { panic(123061); };
    if ecs_ode_obs_matches_event(o, 3) != false { panic(123062); };
    o = ecs_ode_obs_with_entities(o, 9, 0, 0, 0, 1);
    o = ecs_ode_obs_record_despawned(o);
    if ecs_ode_obs_alive(o) != false { panic(123063); };
    if ecs_ode_obs_matches_event(o, 1) != false { panic(123064); };
}

@test "batch_with_entities_and_components"() {
    let o = ecs_ode_obs_new();
    o = ecs_ode_obs_with_components(o, 1, 2, 3, 4, 4);
    o = ecs_ode_obs_with_entities(o, 10, 20, 30, 40, 4);
    let d = ecs_ode_obs_descriptor(o);
    if ecs_ode_desc_c_len(d) != 4 { panic(123070); };
    if ecs_ode_desc_e_len(d) != 4 { panic(123071); };
    if ecs_ode_desc_component_at(d, 3) != 4 { panic(123072); };
    if ecs_ode_desc_entity_at(d, 0) != 10 { panic(123073); };
}

@test "capacity_limits"() {
    let d = ecs_ode_desc_new();
    d = ecs_ode_desc_with_event_key(d, 1);
    d = ecs_ode_desc_with_event_key(d, 2);
    d = ecs_ode_desc_with_event_key(d, 3);
    d = ecs_ode_desc_with_event_key(d, 4);
    d = ecs_ode_desc_with_event_key(d, 5);
    if ecs_ode_desc_ek_len(d) != 4 { panic(123080); };
    if ecs_ode_desc_event_key_at(d, 3) != 4 { panic(123081); };
}

@test "single_entity_despawn_kills_observer"() {
    let o = ecs_ode_obs_new();
    o = ecs_ode_obs_with_entity(o, 55);
    o = ecs_ode_obs_run(o);
    if ecs_ode_obs_last_trigger_id(o) != 1 { panic(123090); };
    o = ecs_ode_obs_record_despawned(o);
    if ecs_ode_obs_alive(o) != false { panic(123091); };
    if ecs_ode_obs_despawned_watched(o) != 1 { panic(123092); };
}
