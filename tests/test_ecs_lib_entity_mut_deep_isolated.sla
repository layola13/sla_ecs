@import "lib/entity_mut_deep.sla"

// Batch 271: entity_mut deep (src/world/entity_access/entity_mut.rs).
// panic codes: 120200 – 120399.

@test "new_and_meta"() {
    let m = ecs_em_deep_new(42);
    m = ecs_em_deep_with_meta(m, 3, 7, 100, 50);
    if ecs_em_deep_id(m) != 42 { panic(120200); };
    if ecs_em_deep_archetype(m) != 3 { panic(120201); };
    if ecs_em_deep_location_row(m) != 7 { panic(120202); };
    if ecs_em_deep_spawned_by(m) != 100 { panic(120203); };
    if ecs_em_deep_spawn_tick(m) != 50 { panic(120204); };
}

@test "insert_get_contains"() {
    let m = ecs_em_deep_new(1);
    m = ecs_em_deep_insert(m, 10, 100, 1, 2);
    m = ecs_em_deep_insert(m, 11, 200, 3, 4);
    if ecs_em_deep_len(m) != 2 { panic(120210); };
    if ecs_em_deep_contains(m, 10) != true { panic(120211); };
    if ecs_em_deep_contains_id(m, 99) != false { panic(120212); };
    let g = ecs_em_deep_get(m, 11);
    if ecs_em_get_found(g) != true { panic(120213); };
    if ecs_em_get_value(g) != 200 { panic(120214); };
}

@test "get_mut_set_updates_changed"() {
    let m = ecs_em_deep_new(2);
    m = ecs_em_deep_insert(m, 5, 50, 1, 1);
    let gm = ecs_em_deep_get_mut(m, 5);
    if ecs_em_get_value(gm) != 50 { panic(120220); };
    let sr = ecs_em_deep_set(m, 5, 55, 9);
    if ecs_em_set_ok(sr) != true { panic(120221); };
    m = ecs_em_set_view(sr);
    let g = ecs_em_deep_get(m, 5);
    if ecs_em_get_value(g) != 55 { panic(120222); };
    if ecs_em_get_changed(g) != 9 { panic(120223); };
    if ecs_em_get_added(g) != 1 { panic(120224); };
}

@test "change_ticks_by_id"() {
    let m = ecs_em_deep_new(3);
    m = ecs_em_deep_insert(m, 1, 7, 11, 22);
    let t = ecs_em_deep_get_change_ticks_by_id(m, 1);
    if ecs_em_get_added(t) != 11 { panic(120230); };
    if ecs_em_get_changed(t) != 22 { panic(120231); };
    let miss = ecs_em_deep_get_change_ticks(m, 2);
    if ecs_em_get_found(miss) != false { panic(120232); };
}

@test "into_readonly_and_as_readonly"() {
    let m = ecs_em_deep_new(4);
    m = ecs_em_deep_insert(m, 8, 80, 1, 2);
    let r = ecs_em_deep_into_readonly(m);
    if ecs_em_ref_deep_id(r) != 4 { panic(120240); };
    let g = ecs_em_ref_deep_get(r, 8);
    if ecs_em_get_value(g) != 80 { panic(120241); };
    let r2 = ecs_em_deep_as_readonly(m);
    if ecs_em_ref_deep_len(r2) != 1 { panic(120242); };
}

@test "into_filtered_write_all"() {
    let m = ecs_em_deep_new(5);
    if ecs_em_deep_is_filtered(m) != false { panic(120250); };
    m = ecs_em_deep_into_filtered(m);
    if ecs_em_deep_is_filtered(m) != true { panic(120251); };
    if ecs_em_deep_id(m) != 5 { panic(120252); };
}

@test "reborrow_and_into_mut"() {
    let m = ecs_em_deep_new(6);
    m = ecs_em_deep_insert(m, 2, 20, 1, 1);
    let m2 = ecs_em_deep_reborrow(m);
    if ecs_em_deep_id(m2) != 6 { panic(120260); };
    let im = ecs_em_deep_into_mut(m, 2);
    if ecs_em_get_value(im) != 20 { panic(120261); };
    let ib = ecs_em_deep_into_borrow(m, 2);
    if ecs_em_get_found(ib) != true { panic(120262); };
}

@test "remove_component"() {
    let m = ecs_em_deep_new(7);
    m = ecs_em_deep_insert(m, 1, 10, 1, 1);
    m = ecs_em_deep_insert(m, 2, 20, 1, 1);
    let rr = ecs_em_deep_remove(m, 1);
    if ecs_em_remove_ok(rr) != true { panic(120270); };
    if ecs_em_remove_value(rr) != 10 { panic(120271); };
    m = ecs_em_remove_view(rr);
    if ecs_em_deep_len(m) != 1 { panic(120272); };
    if ecs_em_deep_contains(m, 1) != false { panic(120273); };
    if ecs_em_deep_contains(m, 2) != true { panic(120274); };
}

@test "component_at_and_eq_cmp"() {
    let m = ecs_em_deep_new(8);
    m = ecs_em_deep_insert(m, 3, 1, 0, 0);
    m = ecs_em_deep_insert(m, 4, 2, 0, 0);
    if ecs_em_deep_component_at(m, 0) != 3 { panic(120280); };
    if ecs_em_deep_component_at(m, 1) != 4 { panic(120281); };
    let a = ecs_em_deep_new(1);
    let b = ecs_em_deep_new(2);
    if ecs_em_deep_eq(a, b) != false { panic(120282); };
    if ecs_em_deep_cmp(a, b) != -1 { panic(120283); };
}

@test "set_missing_fails"() {
    let m = ecs_em_deep_new(9);
    let sr = ecs_em_deep_set(m, 1, 5, 1);
    if ecs_em_set_ok(sr) != false { panic(120290); };
}
