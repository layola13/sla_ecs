@import "lib/name_hashed_deep.sla"

// Batch 297: name_hashed deep.
// panic codes: 125400 – 125599.

@test "hashed_new_and_hash"() {
    let h = ecs_nh_hashed_new(10);
    if ecs_nh_hashed_value(h) != 10 { panic(125400); };
    if ecs_nh_hashed_pre_hash(h) != ecs_nh_hash_fn(10) { panic(125401); };
}

@test "hashed_set_and_eq"() {
    let a = ecs_nh_hashed_new(1);
    let b = ecs_nh_hashed_set(a, 2);
    if ecs_nh_hashed_value(b) != 2 { panic(125410); };
    if ecs_nh_hashed_eq(a, b) != false { panic(125411); };
    if ecs_nh_hashed_eq(b, ecs_nh_hashed_new(2)) != true { panic(125412); };
    if ecs_nh_hashed_eq_str(b, 2) != true { panic(125413); };
}

@test "name_set_mutate"() {
    let n = ecs_nh_name_new(5);
    if ecs_nh_name_as_str(n) != 5 { panic(125420); };
    n = ecs_nh_name_set(n, 8);
    if ecs_nh_name_as_str(n) != 8 { panic(125421); };
    n = ecs_nh_name_mutate(n, 2);
    if ecs_nh_name_as_str(n) != 10 { panic(125422); };
    if ecs_nh_name_pre_hash(n) != ecs_nh_hash_fn(10) { panic(125423); };
}

@test "name_eq_and_convert"() {
    let a = ecs_nh_name_new(3);
    let b = ecs_nh_name_new(3);
    let c = ecs_nh_name_new(4);
    if ecs_nh_name_eq(a, b) != true { panic(125430); };
    if ecs_nh_name_eq(a, c) != false { panic(125431); };
    let h = ecs_nh_name_to_hashed(a);
    if ecs_nh_hashed_value(h) != 3 { panic(125432); };
    let n2 = ecs_nh_name_from_hashed(h);
    if ecs_nh_name_eq(a, n2) != true { panic(125433); };
}

@test "name_or_entity_variants"() {
    let n = ecs_nh_noe_name(11);
    let e = ecs_nh_noe_entity(99);
    if ecs_nh_noe_is_name(n) != true { panic(125440); };
    if ecs_nh_noe_is_entity(e) != true { panic(125441); };
    if ecs_nh_noe_kind(n) != ecs_nh_kind_name() { panic(125442); };
    if ecs_nh_noe_kind(e) != ecs_nh_kind_entity() { panic(125443); };
    if ecs_nh_noe_value(n) != 11 { panic(125444); };
    if ecs_nh_noe_value(e) != 99 { panic(125445); };
}

@test "name_or_entity_eq_display"() {
    let a = ecs_nh_noe_name(1);
    let b = ecs_nh_noe_name(1);
    let c = ecs_nh_noe_entity(1);
    if ecs_nh_noe_eq(a, b) != true { panic(125450); };
    if ecs_nh_noe_eq(a, c) != false { panic(125451); };
    if ecs_nh_noe_display(a) != 1 { panic(125452); };
    if ecs_nh_noe_display(c) != 1 { panic(125453); };
}

@test "hash_changes_with_value"() {
    let h1 = ecs_nh_hashed_new(100);
    let h2 = ecs_nh_hashed_new(101);
    if ecs_nh_hashed_pre_hash(h1) == ecs_nh_hashed_pre_hash(h2) { panic(125460); };
}

@test "name_hash_stable"() {
    let n1 = ecs_nh_name_new(42);
    let n2 = ecs_nh_name_new(42);
    if ecs_nh_name_pre_hash(n1) != ecs_nh_name_pre_hash(n2) { panic(125470); };
}

@test "kind_constants"() {
    if ecs_nh_kind_name() != 0 { panic(125480); };
    if ecs_nh_kind_entity() != 1 { panic(125481); };
}

@test "mutate_zero_offset_noop_value"() {
    let n = ecs_nh_name_new(7);
    let n2 = ecs_nh_name_mutate(n, 0);
    if ecs_nh_name_eq(n, n2) != true { panic(125490); };
}
