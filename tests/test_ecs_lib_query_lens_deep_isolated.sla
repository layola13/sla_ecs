@import "lib/query_lens_deep.sla"

// Batch 258: query_lens deep (src/system/query.rs QueryLens).
// panic codes: 117600 – 117799.

@test "access_and_match_push"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_add_access(l, 1, 0);
    l = ecs_ql_deep_add_access(l, 2, 1);
    l = ecs_ql_deep_push_match(l, 10, 100);
    l = ecs_ql_deep_push_match(l, 11, 110);
    if ecs_ql_deep_access_len(l) != 2 { panic(117600); };
    if ecs_ql_deep_match_len(l) != 2 { panic(117601); };
    if ecs_ql_deep_has_access(l, 1) != true { panic(117602); };
    if ecs_ql_deep_has_write(l, 2) != true { panic(117603); };
    if ecs_ql_deep_has_write(l, 1) != false { panic(117604); };
}

@test "find_entity"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_push_match(l, 5, 50);
    l = ecs_ql_deep_push_match(l, 6, 60);
    let f = ecs_ql_deep_find(l, 6);
    if ecs_ql_find_found(f) != true { panic(117610); };
    if ecs_ql_find_value(f) != 60 { panic(117611); };
    f = ecs_ql_deep_find(l, 9);
    if ecs_ql_find_found(f) != false { panic(117612); };
}

@test "transmute_subset_and_write_downgrade"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_add_access(l, 1, 1);
    l = ecs_ql_deep_add_access(l, 2, 0);
    l = ecs_ql_deep_push_match(l, 1, 10);
    // request write on 2 but source is read-only -> downgrade
    let t = ecs_ql_deep_transmute2(l, 2, 1, 1, 1, 2);
    if ecs_ql_deep_access_len(t) != 2 { panic(117620); };
    if ecs_ql_deep_has_write(t, 2) != false { panic(117621); };
    if ecs_ql_deep_has_write(t, 1) != true { panic(117622); };
    if ecs_ql_deep_match_len(t) != 1 { panic(117623); };
}

@test "transmute_drops_unknown_access"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_add_access(l, 1, 0);
    let t = ecs_ql_deep_transmute2(l, 9, 0, 1, 0, 2);
    if ecs_ql_deep_access_len(t) != 1 { panic(117630); };
    if ecs_ql_deep_has_access(t, 1) != true { panic(117631); };
    if ecs_ql_deep_has_access(t, 9) != false { panic(117632); };
}

@test "transmute_filtered_adds_filter"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_add_access(l, 1, 0);
    let t = ecs_ql_deep_transmute_filtered2(l, 1, 0, 0, 0, 1, 7);
    if ecs_ql_deep_filter_len(t) != 1 { panic(117640); };
    if ecs_ql_deep_access_len(t) != 1 { panic(117641); };
}

@test "join_intersects_entities"() {
    let a = ecs_ql_deep_new();
    a = ecs_ql_deep_add_access(a, 1, 0);
    a = ecs_ql_deep_push_match(a, 10, 100);
    a = ecs_ql_deep_push_match(a, 11, 110);
    a = ecs_ql_deep_push_match(a, 12, 120);
    let b = ecs_ql_deep_new();
    b = ecs_ql_deep_add_access(b, 2, 1);
    b = ecs_ql_deep_push_match(b, 11, 999);
    b = ecs_ql_deep_push_match(b, 13, 130);
    let j = ecs_ql_deep_join(a, b);
    if ecs_ql_deep_match_len(j) != 1 { panic(117650); };
    if ecs_ql_deep_entity_at(j, 0) != 11 { panic(117651); };
    if ecs_ql_deep_value_at(j, 0) != 110 { panic(117652); }; // from a
    if ecs_ql_deep_access_len(j) != 2 { panic(117653); };
    if ecs_ql_deep_has_write(j, 2) != true { panic(117654); };
}

@test "join_filtered"() {
    let a = ecs_ql_deep_new();
    a = ecs_ql_deep_push_match(a, 1, 1);
    let b = ecs_ql_deep_new();
    b = ecs_ql_deep_push_match(b, 1, 2);
    let j = ecs_ql_deep_join_filtered(a, b, 5);
    if ecs_ql_deep_match_len(j) != 1 { panic(117660); };
    if ecs_ql_deep_filter_len(j) != 1 { panic(117661); };
}

@test "query_identity"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_add_access(l, 3, 1);
    l = ecs_ql_deep_push_match(l, 8, 80);
    let q = ecs_ql_deep_query(l);
    if ecs_ql_deep_match_len(q) != 1 { panic(117670); };
    if ecs_ql_deep_write_count(q) != 1 { panic(117671); };
}

@test "access_dedup"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_add_access(l, 1, 0);
    l = ecs_ql_deep_add_access(l, 1, 1);
    if ecs_ql_deep_access_len(l) != 1 { panic(117680); };
    if ecs_ql_deep_has_write(l, 1) != false { panic(117681); };
}

@test "match_capacity_eight"() {
    let l = ecs_ql_deep_new();
    l = ecs_ql_deep_push_match(l, 1, 1);
    l = ecs_ql_deep_push_match(l, 2, 2);
    l = ecs_ql_deep_push_match(l, 3, 3);
    l = ecs_ql_deep_push_match(l, 4, 4);
    l = ecs_ql_deep_push_match(l, 5, 5);
    l = ecs_ql_deep_push_match(l, 6, 6);
    l = ecs_ql_deep_push_match(l, 7, 7);
    l = ecs_ql_deep_push_match(l, 8, 8);
    l = ecs_ql_deep_push_match(l, 9, 9);
    if ecs_ql_deep_match_len(l) != 8 { panic(117690); };
}
