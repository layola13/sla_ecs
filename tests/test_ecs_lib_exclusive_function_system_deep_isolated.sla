@import "lib/exclusive_function_system_deep.sla"

// Batch 186 tests for ExclusiveFunctionSystem + ExclusiveSystemParam deep surface.

@test "esp_param_constructors_kinds"() {
    if ecs_esp_deep_kind(ecs_esp_deep_query_state(3)) != ECS_ESP_QUERY_STATE { panic(101600); };
    if ecs_esp_deep_state_id(ecs_esp_deep_query_state(3)) != 3 { panic(101601); };
    if ecs_esp_deep_kind(ecs_esp_deep_system_state(4)) != ECS_ESP_SYSTEM_STATE { panic(101602); };
    if ecs_esp_deep_kind(ecs_esp_deep_local(9)) != ECS_ESP_LOCAL { panic(101603); };
    if ecs_esp_deep_local_value(ecs_esp_deep_local(9)) != 9 { panic(101604); };
    if ecs_esp_deep_kind(ecs_esp_deep_phantom()) != ECS_ESP_PHANTOM { panic(101605); };
    if ecs_esp_deep_kind(ecs_esp_deep_tuple(3)) != ECS_ESP_TUPLE { panic(101606); };
    if ecs_esp_deep_param_count(ecs_esp_deep_tuple(3)) != 3 { panic(101607); };
}

@test "esp_init_and_get_param"() {
    let p = ecs_esp_deep_query_state(0);
    if ecs_esp_deep_get_param_ok(p) != false { panic(101610); };
    p = ecs_esp_deep_init(p, 10);
    if ecs_esp_deep_initialized(p) != true { panic(101611); };
    if ecs_esp_deep_world_id(p) != 10 { panic(101612); };
    if ecs_esp_deep_state_id(p) != 1010 { panic(101613); };
    if ecs_esp_deep_get_param_ok(p) != true { panic(101614); };
    let ss = ecs_esp_deep_init(ecs_esp_deep_system_state(0), 5);
    if ecs_esp_deep_state_id(ss) != 2005 { panic(101615); };
}

@test "esp_local_bump_persists"() {
    let p = ecs_esp_deep_init(ecs_esp_deep_local(0), 1);
    p = ecs_esp_deep_local_bump(p);
    p = ecs_esp_deep_local_bump(p);
    if ecs_esp_deep_local_value(p) != 2 { panic(101620); };
    p = ecs_esp_deep_set_local(p, 7);
    if ecs_esp_deep_local_value(p) != 7 { panic(101621); };
}

@test "efs_new_defaults_flags"() {
    let s = ecs_efs_deep_new(42, false);
    if ecs_efs_deep_name(s) != 42 { panic(101630); };
    if ecs_efs_deep_has_param_state(s) != false { panic(101631); };
    if ecs_efs_deep_is_non_send(s) != true { panic(101632); };
    if ecs_efs_deep_is_exclusive(s) != true { panic(101633); };
    if ecs_efs_deep_has_deferred(s) != false { panic(101634); };
    if ecs_efs_deep_flags(s) != ECS_EFS_DEFAULT_FLAGS { panic(101635); };
    if ecs_efs_deep_has_input(s) != false { panic(101636); };
}

@test "efs_with_name_and_from_func_input"() {
    let s = ecs_efs_deep_from_func(1, true);
    if ecs_efs_deep_has_input(s) != true { panic(101640); };
    s = ecs_efs_deep_with_name(s, 99);
    if ecs_efs_deep_name(s) != 99 { panic(101641); };
}

@test "run_unsafe_uninitialized_errors"() {
    let s = ecs_efs_deep_new(1, false);
    s = ecs_efs_deep_run_plain(s, 0, 5);
    if ecs_efs_deep_last_error(s) != ECS_EFS_ERR_UNINITIALIZED { panic(101650); };
    if ecs_efs_deep_run_count(s) != 0 { panic(101651); };
    if ecs_efs_deep_flush_count(s) != 0 { panic(101652); };
}

@test "initialize_then_run_plain_ok"() {
    let s = ecs_efs_deep_new(10, false);
    s = ecs_efs_deep_initialize(s, 100, 50, ecs_esp_deep_phantom());
    if ecs_efs_deep_has_param_state(s) != true { panic(101660); };
    if ecs_efs_deep_world_id(s) != 100 { panic(101661); };
    if ecs_efs_deep_last_run(s) != 50 { panic(101662); };
    s = ecs_efs_deep_run_plain(s, 0, 7);
    if ecs_efs_deep_last_error(s) != ECS_EFS_ERR_OK { panic(101663); };
    if ecs_efs_deep_last_output(s) != 7 { panic(101664); };
    if ecs_efs_deep_run_count(s) != 1 { panic(101665); };
    if ecs_efs_deep_flush_count(s) != 1 { panic(101666); };
    if ecs_efs_deep_last_run(s) != 51 { panic(101667); };
}

@test "run_unsafe_param_fail"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, false), 1, 1, ecs_esp_deep_phantom());
    s = ecs_efs_deep_run_unsafe(s, 0, false, 44, 0, false, true, 0);
    if ecs_efs_deep_last_error(s) != ECS_EFS_ERR_PARAM { panic(101670); };
    if ecs_efs_deep_last_err_code(s) != 44 { panic(101671); };
    if ecs_efs_deep_run_count(s) != 0 { panic(101672); };
}

@test "run_unsafe_into_result_err_and_ok"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, false), 1, 1, ecs_esp_deep_phantom());
    s = ecs_efs_deep_run_unsafe(s, 0, true, 0, 0, true, false, 88);
    if ecs_efs_deep_last_error(s) != ECS_EFS_ERR_INTO_RESULT { panic(101680); };
    if ecs_efs_deep_last_err_code(s) != 88 { panic(101681); };
    if ecs_efs_deep_run_count(s) != 1 { panic(101682); };
    s = ecs_efs_deep_run_unsafe(s, 0, true, 0, 15, true, true, 0);
    if ecs_efs_deep_last_error(s) != ECS_EFS_ERR_OK { panic(101683); };
    if ecs_efs_deep_last_output(s) != 15 { panic(101684); };
}

@test "run_with_input_folds_plain_output"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, true), 1, 0, ecs_esp_deep_phantom());
    s = ecs_efs_deep_run_plain(s, 10, 5);
    if ecs_efs_deep_last_output(s) != 15 { panic(101690); };
    if ecs_efs_deep_has_input(s) != true { panic(101691); };
}

@test "local_param_persists_across_runs"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, false), 1, 0, ecs_esp_deep_local(0));
    if ecs_efs_deep_param_kind(s) != ECS_ESP_LOCAL { panic(101700); };
    if ecs_efs_deep_local_value(s) != 0 { panic(101701); };
    s = ecs_efs_deep_run_plain(s, 0, 1);
    if ecs_efs_deep_local_value(s) != 1 { panic(101702); };
    s = ecs_efs_deep_run_plain(s, 0, 1);
    if ecs_efs_deep_local_value(s) != 2 { panic(101703); };
    if ecs_efs_deep_run_count(s) != 2 { panic(101704); };
}

@test "initialize_query_state_assigns_id"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(2, false), 7, 0, ecs_esp_deep_query_state(0));
    if ecs_efs_deep_param_kind(s) != ECS_ESP_QUERY_STATE { panic(101710); };
    if ecs_efs_deep_param_state_id(s) != 1007 { panic(101711); };
}

@test "apply_and_queue_deferred_noop"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, false), 1, 0, ecs_esp_deep_phantom());
    s = ecs_efs_deep_queue_deferred(s);
    s = ecs_efs_deep_apply_deferred(s);
    if ecs_efs_deep_has_param_state(s) != true { panic(101720); };
    if ecs_efs_deep_flush_count(s) != 0 { panic(101721); };
}

@test "set_last_run_and_default_system_set"() {
    let s = ecs_efs_deep_new(55, false);
    s = ecs_efs_deep_set_last_run(s, 12);
    if ecs_efs_deep_last_run(s) != 12 { panic(101730); };
    if ecs_efs_deep_default_system_set_id(s) != 55 { panic(101731); };
}

@test "check_change_tick_resets_on_huge_gap"() {
    let s = ecs_efs_deep_set_last_run(ecs_efs_deep_new(1, false), 1);
    s = ecs_efs_deep_check_change_tick(s, 2000000);
    if ecs_efs_deep_last_run(s) != 2000000 { panic(101740); };
    s = ecs_efs_deep_check_change_tick(s, 2000010);
    if ecs_efs_deep_last_run(s) != 2000000 { panic(101741); };
}

@test "clone_deinitializes"() {
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(8, true), 3, 1, ecs_esp_deep_local(5));
    s = ecs_efs_deep_run_plain(s, 1, 2);
    let c = ecs_efs_deep_clone(s);
    if ecs_efs_deep_name(c) != 8 { panic(101750); };
    if ecs_efs_deep_has_param_state(c) != false { panic(101751); };
    if ecs_efs_deep_has_input(c) != true { panic(101752); };
    if ecs_efs_deep_run_count(c) != 0 { panic(101753); };
    if ecs_efs_deep_is_exclusive(c) != true { panic(101754); };
    if ecs_efs_deep_has_param_state(s) != true { panic(101755); };
}

@test "markers_exclusive_function_system"() {
    if ecs_is_exclusive_function_system_marker_deep() != 1 { panic(101760); };
    if ecs_has_exclusive_system_input_marker_deep() != 1 { panic(101761); };
}

@test "lifecycle_init_run_twice_reclone"() {
    let s = ecs_efs_deep_new(1, false);
    s = ecs_efs_deep_initialize(s, 1, 10, ecs_esp_deep_system_state(0));
    s = ecs_efs_deep_run_plain(s, 0, 1);
    s = ecs_efs_deep_run_plain(s, 0, 2);
    if ecs_efs_deep_run_count(s) != 2 { panic(101770); };
    if ecs_efs_deep_last_output(s) != 2 { panic(101771); };
    if ecs_efs_deep_flush_count(s) != 2 { panic(101772); };
    if ecs_efs_deep_last_run(s) != 12 { panic(101773); };
    let c = ecs_efs_deep_clone(s);
    c = ecs_efs_deep_initialize(c, 2, 0, ecs_esp_deep_phantom());
    c = ecs_efs_deep_run_plain(c, 0, 9);
    if ecs_efs_deep_last_error(c) != ECS_EFS_ERR_OK { panic(101774); };
    if ecs_efs_deep_last_output(c) != 9 { panic(101775); };
}

@test "tuple_param_init"() {
    let p = ecs_esp_deep_init(ecs_esp_deep_tuple(2), 4);
    if ecs_esp_deep_initialized(p) != true { panic(101780); };
    if ecs_esp_deep_param_count(p) != 2 { panic(101781); };
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, false), 4, 0, p);
    if ecs_efs_deep_param_kind(s) != ECS_ESP_TUPLE { panic(101782); };
    s = ecs_efs_deep_run_plain(s, 0, 3);
    if ecs_efs_deep_last_output(s) != 3 { panic(101783); };
}

@test "system_state_param_preserves_explicit_id"() {
    let p = ecs_esp_deep_init(ecs_esp_deep_system_state(77), 1);
    if ecs_esp_deep_state_id(p) != 77 { panic(101790); };
    let s = ecs_efs_deep_initialize(ecs_efs_deep_new(1, false), 1, 0, ecs_esp_deep_system_state(77));
    if ecs_efs_deep_param_state_id(s) != 77 { panic(101791); };
}
