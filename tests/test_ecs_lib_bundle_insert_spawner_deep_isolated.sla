@import "lib/bundle_insert_spawner_deep.sla"

// Batch 231: bundle insert + spawner deep (src/bundle/insert.rs + spawner.rs).
// panic codes: 112200 – 112399.

@test "insert_mode_constants"() {
    if ecs_bi_keep() != 0 { panic(112200); };
    if ecs_bi_replace() != 1 { panic(112201); };
    if ecs_bi_move_same() != 0 { panic(112202); };
    if ecs_bi_status_existing() != 1 { panic(112203); };
}

@test "same_archetype_replace_existing"() {
    let w = ecs_bi_world_new(10);
    let arch = ecs_bi_arch_new(1, 1);
    arch = ecs_bi_arch_add(arch, 1);
    arch = ecs_bi_arch_with_observers(arch, true, true, true);
    w = ecs_bi_world_spawn_base(w, arch);
    // seed value
    let e = ecs_bi_entity_set(ecs_bi_world_entity(w), 1, 5, 1);
    w = ecs_bi_world_place_entity(w, e);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(1), 1, ECS_BI_TABLE, 99);
    let ir = ecs_bi_inserter_new(w, 1, bundle);
    w = ir.0;
    if ecs_bi_inserter_move_type(ir.1) != ECS_BI_MOVE_SAME { panic(112210); };
    w = ecs_bi_inserter_insert(w, ir.1, ECS_BI_REPLACE);
    if ecs_bi_entity_value(ecs_bi_world_entity(w), 1) != 99 { panic(112211); };
    if ecs_bi_world_on_discard_hooks(w) != 1 { panic(112212); };
    if ecs_bi_world_discard_count(w) != 1 { panic(112213); };
}

@test "keep_mode_skips_existing_write"() {
    let w = ecs_bi_world_new(3);
    let arch = ecs_bi_arch_add(ecs_bi_arch_new(1, 1), 1);
    w = ecs_bi_world_spawn_base(w, arch);
    let e = ecs_bi_entity_set(ecs_bi_world_entity(w), 1, 5, 1);
    w = ecs_bi_world_place_entity(w, e);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(1), 1, ECS_BI_TABLE, 77);
    let ir = ecs_bi_inserter_new(w, 1, bundle);
    w = ir.0;
    w = ecs_bi_inserter_insert(w, ir.1, ECS_BI_KEEP);
    if ecs_bi_entity_value(ecs_bi_world_entity(w), 1) != 5 { panic(112220); };
    if ecs_bi_world_on_discard_hooks(w) != 0 { panic(112221); };
}

@test "insert_adds_component_new_table"() {
    let w = ecs_bi_world_new(5);
    let arch = ecs_bi_arch_add(ecs_bi_arch_new(1, 1), 1);
    arch = ecs_bi_arch_with_observers(arch, true, true, false);
    w = ecs_bi_world_spawn_base(w, arch);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(2), 2, ECS_BI_TABLE, 42);
    let ir = ecs_bi_inserter_new(w, 1, bundle);
    w = ir.0;
    if ecs_bi_inserter_move_type(ir.1) != ECS_BI_MOVE_NEW_TABLE { panic(112230); };
    if ecs_bi_world_archetype_created(w) != 1 { panic(112231); };
    w = ecs_bi_inserter_insert(w, ir.1, ECS_BI_KEEP);
    let e = ecs_bi_world_entity(w);
    if ecs_bi_entity_has(e, 2) != true { panic(112232); };
    if ecs_bi_entity_value(e, 2) != 42 { panic(112233); };
    if e.arch_id != ecs_bi_inserter_new_arch(ir.1) { panic(112234); };
    if ecs_bi_world_on_add_hooks(w) != 1 { panic(112235); };
    if ecs_bi_world_add_count(w) != 1 { panic(112236); };
}

@test "sparse_add_same_table"() {
    let w = ecs_bi_world_new(1);
    let arch = ecs_bi_arch_add(ecs_bi_arch_new(1, 3), 1);
    w = ecs_bi_world_spawn_base(w, arch);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(3), 2, ECS_BI_SPARSE, 8);
    let ir = ecs_bi_inserter_new(w, 1, bundle);
    w = ir.0;
    if ecs_bi_inserter_move_type(ir.1) != ECS_BI_MOVE_SAME_TABLE { panic(112240); };
    w = ecs_bi_inserter_insert(w, ir.1, ECS_BI_REPLACE);
    if ecs_bi_entity_value(ecs_bi_world_entity(w), 2) != 8 { panic(112241); };
}

@test "insert_edge_cache"() {
    let w = ecs_bi_world_new(1);
    let arch = ecs_bi_arch_add(ecs_bi_arch_new(1, 1), 1);
    w = ecs_bi_world_spawn_base(w, arch);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(9), 2, ECS_BI_TABLE, 1);
    let ir1 = ecs_bi_inserter_new(w, 1, bundle);
    w = ir1.0;
    if ecs_bi_world_archetype_created(w) != 1 { panic(112250); };
    let ir2 = ecs_bi_inserter_new(w, 1, bundle);
    w = ir2.0;
    if ecs_bi_world_archetype_created(w) != 1 { panic(112251); };
    if ecs_bi_inserter_new_arch(ir1.1) != ecs_bi_inserter_new_arch(ir2.1) { panic(112252); };
}

@test "spawner_spawn_writes_all_added"() {
    let w = ecs_bi_world_new(7);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(1), 1, ECS_BI_TABLE, 11);
    bundle = ecs_bi_bundle_push(bundle, 2, ECS_BI_TABLE, 22);
    let sr = ecs_bi_spawner_new(w, bundle);
    w = sr.0;
    let s = sr.1;
    let out = ecs_bi_spawner_spawn(w, s);
    w = out.0;
    if out.1 != 1 { panic(112260); };
    let e = ecs_bi_world_entity(w);
    if ecs_bi_entity_value(e, 1) != 11 { panic(112261); };
    if ecs_bi_entity_value(e, 2) != 22 { panic(112262); };
    if ecs_bi_world_on_add_hooks(w) != 2 { panic(112263); };
    if ecs_bi_world_on_insert_hooks(w) != 2 { panic(112264); };
    if ecs_bi_world_add_count(w) != 1 { panic(112265); };
}

@test "spawner_spawn_at_and_reserve_flush"() {
    let w = ecs_bi_world_new(2);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(1), 1, ECS_BI_TABLE, 5);
    let sr = ecs_bi_spawner_new(w, bundle);
    w = sr.0;
    let s = ecs_bi_spawner_reserve(sr.1, 4);
    if ecs_bi_spawner_reserved(s) != 4 { panic(112270); };
    w = ecs_bi_spawner_spawn_at(w, s, 50);
    if ecs_bi_world_entity(w).entity != 50 { panic(112271); };
    if ecs_bi_entity_value(ecs_bi_world_entity(w), 1) != 5 { panic(112272); };
    w = ecs_bi_spawner_flush(w);
    if ecs_bi_world_flush_count(w) != 1 { panic(112273); };
}

@test "component_status_helper"() {
    let arch = ecs_bi_arch_add(ecs_bi_arch_new(1, 1), 1);
    if ecs_bi_component_status(arch, 1) != ECS_BI_STATUS_EXISTING { panic(112280); };
    if ecs_bi_component_status(arch, 2) != ECS_BI_STATUS_ADDED { panic(112281); };
}

@test "mixed_replace_add_and_existing"() {
    let w = ecs_bi_world_new(9);
    let arch = ecs_bi_arch_add(ecs_bi_arch_new(1, 1), 1);
    arch = ecs_bi_arch_with_observers(arch, true, true, true);
    w = ecs_bi_world_spawn_base(w, arch);
    let e = ecs_bi_entity_set(ecs_bi_world_entity(w), 1, 1, 1);
    w = ecs_bi_world_place_entity(w, e);
    let bundle = ecs_bi_bundle_push(ecs_bi_bundle_new(5), 1, ECS_BI_TABLE, 100);
    bundle = ecs_bi_bundle_push(bundle, 2, ECS_BI_TABLE, 200);
    let ir = ecs_bi_inserter_new(w, 1, bundle);
    w = ir.0;
    w = ecs_bi_inserter_insert(w, ir.1, ECS_BI_REPLACE);
    let ent = ecs_bi_world_entity(w);
    if ecs_bi_entity_value(ent, 1) != 100 { panic(112290); };
    if ecs_bi_entity_value(ent, 2) != 200 { panic(112291); };
    if ecs_bi_world_on_discard_hooks(w) != 1 { panic(112292); };
    if ecs_bi_world_on_add_hooks(w) != 1 { panic(112293); };
}
