@import "lib/relationship_source_collection_deep.sla"

// Batch 232: relationship source collection deep.
// panic codes: 112400 – 112599.

@test "vec_add_allows_dup"() {
    let c = ecs_rscd_new(ECS_RSCD_VEC);
    let r = ecs_rscd_add(c, 1);
    c = r.0;
    r = ecs_rscd_add(c, 1);
    c = r.0;
    if ecs_rscd_len(c) != 2 { panic(112400); };
    if r.1 != true { panic(112401); };
}

@test "hashset_dedup"() {
    let c = ecs_rscd_new(ECS_RSCD_HASHSET);
    let r = ecs_rscd_add(c, 5);
    c = r.0;
    r = ecs_rscd_add(c, 5);
    if r.1 != false { panic(112410); };
    if ecs_rscd_len(r.0) != 1 { panic(112411); };
}

@test "one_to_one_source_to_remove"() {
    let c = ecs_rscd_new(ECS_RSCD_ONE);
    let r = ecs_rscd_add(c, 10);
    c = r.0;
    let s = ecs_rscd_source_to_remove_before_add(c);
    if s.0 != true { panic(112420); };
    if s.1 != 10 { panic(112421); };
    r = ecs_rscd_add(c, 11);
    c = r.0;
    if ecs_rscd_len(c) != 1 { panic(112422); };
    if ecs_rscd_at(c, 0) != 11 { panic(112423); };
}

@test "remove_swap_and_clear"() {
    let c = ecs_rscd_new(ECS_RSCD_VEC);
    c = ecs_rscd_extend2(c, 1, 2);
    c = ecs_rscd_add(c, 3).0;
    let r = ecs_rscd_remove(c, 2);
    c = r.0;
    if r.1 != true { panic(112430); };
    if ecs_rscd_len(c) != 2 { panic(112431); };
    if ecs_rscd_contains(c, 2) != false { panic(112432); };
    c = ecs_rscd_clear(c);
    if ecs_rscd_is_empty(c) != true { panic(112433); };
}

@test "with_capacity_and_reserve_shrink"() {
    let c = ecs_rscd_with_capacity(ECS_RSCD_VEC, 4);
    if ecs_rscd_capacity(c) != 4 { panic(112440); };
    let h = ecs_rscd_with_capacity(ECS_RSCD_HASHSET, 4);
    if ecs_rscd_capacity(h) != 0 { panic(112441); };
    c = ecs_rscd_reserve(c, 3);
    if ecs_rscd_capacity(c) < 3 { panic(112442); };
    c = ecs_rscd_add(c, 1).0;
    c = ecs_rscd_shrink_to_fit(c);
    if ecs_rscd_capacity(c) != 1 { panic(112443); };
    if ecs_rscd_shrink_count(c) != 1 { panic(112444); };
}

@test "ordered_insert_remove_at"() {
    let c = ecs_rscd_new(ECS_RSCD_VEC);
    c = ecs_rscd_add(c, 1).0;
    c = ecs_rscd_add(c, 3).0;
    c = ecs_rscd_insert(c, 1, 2);
    if ecs_rscd_at(c, 0) != 1 { panic(112450); };
    if ecs_rscd_at(c, 1) != 2 { panic(112451); };
    if ecs_rscd_at(c, 2) != 3 { panic(112452); };
    let r = ecs_rscd_remove_at(c, 1);
    c = r.0;
    if r.2 != 2 { panic(112453); };
    if ecs_rscd_len(c) != 2 { panic(112454); };
}

@test "push_front_back_first_last"() {
    let c = ecs_rscd_new(ECS_RSCD_VEC);
    c = ecs_rscd_push_back(c, 2);
    c = ecs_rscd_push_front(c, 1);
    c = ecs_rscd_push_back(c, 3);
    if ecs_rscd_first(c).1 != 1 { panic(112460); };
    if ecs_rscd_last(c).1 != 3 { panic(112461); };
    if ecs_rscd_len(c) != 3 { panic(112462); };
}

@test "sort_and_insert_sorted"() {
    let c = ecs_rscd_new(ECS_RSCD_VEC);
    c = ecs_rscd_add(c, 3).0;
    c = ecs_rscd_add(c, 1).0;
    c = ecs_rscd_add(c, 2).0;
    c = ecs_rscd_sort(c);
    if ecs_rscd_at(c, 0) != 1 { panic(112470); };
    if ecs_rscd_at(c, 1) != 2 { panic(112471); };
    if ecs_rscd_at(c, 2) != 3 { panic(112472); };
    c = ecs_rscd_insert_sorted(c, 0);
    if ecs_rscd_at(c, 0) != 0 { panic(112473); };
}

@test "place_most_recent_and_place"() {
    let c = ecs_rscd_new(ECS_RSCD_VEC);
    c = ecs_rscd_add(c, 1).0;
    c = ecs_rscd_add(c, 2).0;
    c = ecs_rscd_add(c, 3).0;
    c = ecs_rscd_place_most_recent(c, 0);
    if ecs_rscd_at(c, 0) != 3 { panic(112480); };
    c = ecs_rscd_place(c, 2, 2);
    if ecs_rscd_contains(c, 2) != true { panic(112481); };
    if ecs_rscd_at(c, 2) != 2 { panic(112482); };
}

@test "unique_vec_no_dup"() {
    let c = ecs_rscd_new(ECS_RSCD_UNIQUE_VEC);
    c = ecs_rscd_add(c, 7).0;
    let r = ecs_rscd_add(c, 7);
    if r.1 != false { panic(112490); };
    if ecs_rscd_len(r.0) != 1 { panic(112491); };
}
