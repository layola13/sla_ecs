// Isolated deep tests for lib/world_archetype_value_deep.sla (Batch 388).
// Mirrors shallow lib/world_archetype_value.sla's `ArchetypeValueWorld<T, R, M>` as a SELF-CONTAINED
// fixed-cap archetype-grouped variant (no @import -- archetype + entity location + resource +
// message + tick all inlined). Concrete typed plugs for ArchetypeValueData/Time/Event. Wrapper
// structs EcsAVRegisterDeep / EcsAVSpawnDeep / EcsAVCompInfoDeep / EcsAVQueryDeep /
// EcsAVPairQueryMutDeep / EcsAVReadDeep / EcsAVResDeep / EcsAVResMutDeep expose scalar accessors
// (NO tuple-return destructuring in tests).
// panic codes: 143000 - 143099.

@import "lib/world_archetype_value_deep.sla"

// convenience helpers around the id accessor (idiomatic in every test).
fn health_id(r: EcsAVRegisterDeep) -> i32 { return ecs_av_comp_info_id_deep(ecs_av_register_info_deep(r)); }
fn spawn_w(r: EcsAVSpawnDeep) -> EcsAVWorldDeep { return ecs_av_spawn_world_deep(r); }
fn spawn_e(r: EcsAVSpawnDeep) -> EcsAVEntityDeep { return ecs_av_spawn_entity_deep(r); }

// ── Test 1: new + register + spawn + counts + per-register tick bump. ──
@test "EcsAVWorldDeep new + register + spawn + counts + change_tick"() {
    let w0 = ecs_av_world_deep_new();
    if ecs_av_world_deep_archetype_count(w0) != 1 { panic(143000); };
    if ecs_av_world_deep_component_count(w0) != 0 { panic(143001); };
    if ecs_av_world_deep_change_tick(w0) != 0 { panic(143002); };
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    if ecs_av_comp_info_id_deep(ecs_av_register_info_deep(r1)) != 1 { panic(143003); };
    if ecs_av_world_deep_component_count(w1) != 1 { panic(143004); };
    if ecs_av_world_deep_change_tick(w1) != 1 { panic(143005); };
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    if ecs_av_comp_info_id_deep(ecs_av_register_info_deep(r2)) != 2 { panic(143006); };
    if ecs_av_world_deep_component_count(w2) != 2 { panic(143007); };
    let r3 = ecs_av_world_deep_register_sparse_set(w2);
    let w3 = ecs_av_register_world_deep(r3);
    if ecs_av_comp_info_id_deep(ecs_av_register_info_deep(r3)) != 3 { panic(143008); };
    if ecs_av_world_deep_component_count(w3) != 3 { panic(143009); };
    let sp = ecs_av_world_deep_spawn(w3);
    let w4 = spawn_w(sp);
    let e1 = spawn_e(sp);
    if e1.id != 0 { panic(143010); };
    if e1.generation != 0 { panic(143011); };
    if ecs_av_world_deep_entity_count(w4) != 1 { panic(143012); };
    if ecs_av_world_deep_is_alive(w4, e1) != true { panic(143013); };
    if ecs_av_world_deep_entity_archetype_id(w4, e1) != 0 { panic(143014); };
    if ecs_av_world_deep_entity_row(w4, e1) != 0 { panic(143015); };
    if ecs_av_world_deep_archetype_entity_count(w4, 0) != 1 { panic(143016); };
}

// ── Test 2 (shallow test 1): insert migration by archetype signature + diagonal landing. ──
@test "EcsAVWorldDeep insert migrates values by signature + shared archetype"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let mana = ecs_av_register_info_deep(r2);
    let r3 = ecs_av_world_deep_register_sparse_set(w2);
    let w3 = ecs_av_register_world_deep(r3);
    let selected = ecs_av_register_info_deep(r3);
    let sp1 = ecs_av_world_deep_spawn(w3);
    let w4 = spawn_w(sp1);
    let e1 = spawn_e(sp1);
    let sp2 = ecs_av_world_deep_spawn(w4);
    let w5 = spawn_w(sp2);
    let e2 = spawn_e(sp2);
    // Diagonal recipe: e1 inserts health-then-mana (creates {hp} arch then {hp,mp} arch);
    // e2 also inserts health-then-mana (reuses the {hp} and {hp,mp} arches), so both converge to
    // the same shared {hp,mp} arch WITHOUT creating a third archetype (arch_count stays 3 incl. arch0).
    let w6 = ecs_av_world_deep_insert(w5, e1, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(10));
    let w7 = ecs_av_world_deep_insert(w6, e1, ecs_av_comp_info_id_deep(mana), ecs_av_data_deep_new(4));
    let w8 = ecs_av_world_deep_insert(w7, e2, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(8));
    let w9 = ecs_av_world_deep_insert(w8, e2, ecs_av_comp_info_id_deep(mana), ecs_av_data_deep_new(2));
    let shared = ecs_av_world_deep_entity_archetype_id(w9, e1);
    if shared != ecs_av_world_deep_entity_archetype_id(w9, e2) { panic(143020); };
    if ecs_av_world_deep_archetype_entity_count(w9, shared) != 2 { panic(143021); };
    let w10 = ecs_av_world_deep_insert(w9, e2, ecs_av_comp_info_id_deep(selected), ecs_av_data_deep_new(1));
    if ecs_av_world_deep_entity_archetype_id(w10, e1) == ecs_av_world_deep_entity_archetype_id(w10, e2) { panic(143022); };
    let unselected = ecs_av_world_deep_query_pair_without(w10, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(mana), ecs_av_comp_info_id_deep(selected));
    if ecs_av_query_deep_count(unselected) != 1 { panic(143023); };
    let uitem = ecs_av_query_deep_at(unselected, 0);
    if ecs_av_entity_id_deep(ecs_av_entity_item_entity(uitem)) != e1.id { panic(143024); };
    let sel_health = ecs_av_world_deep_query_with(w10, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(selected));
    if ecs_av_query_deep_count(sel_health) != 1 { panic(143026); };
    let shitem = ecs_av_query_deep_at(sel_health, 0);
    if ecs_av_entity_id_deep(ecs_av_entity_item_entity(shitem)) != e2.id { panic(143027); };
    let w11 = ecs_av_world_deep_remove(w10, e2, ecs_av_comp_info_id_deep(selected));
    if ecs_av_world_deep_entity_archetype_id(w11, e1) != ecs_av_world_deep_entity_archetype_id(w11, e2) { panic(143025); };
}

// ── Test 3 (shallow test 2): pair_mut_first writeback + changed_since not added_since. ──
@test "EcsAVWorldDeep pair_mut_first writeback preserves arch/row + changed_since not added_since"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let mana = ecs_av_register_info_deep(r2);
    let sp = ecs_av_world_deep_spawn(w2);
    let w3 = spawn_w(sp);
    let entity = spawn_e(sp);
    let w4 = ecs_av_world_deep_insert(w3, entity, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(5));
    let w5 = ecs_av_world_deep_insert(w4, entity, ecs_av_comp_info_id_deep(mana), ecs_av_data_deep_new(3));
    // change_tick before pair-write. Two registers bumped change_tick from 0 -> 1 -> 2 in test world
    // setup; two inserts did NOT bump the tick themselves (only registers do per the shallow's
    // `_world_increment_tick`).  Increment here to model the "before" tick being referenced later.
    let before = ecs_av_world_deep_change_tick(w5);
    let original_group = ecs_av_world_deep_entity_archetype_id(w5, entity);
    let original_row = ecs_av_world_deep_entity_row(w5, entity);
    let w6 = ecs_av_world_deep_increment_tick(w5);
    let pq = ecs_av_world_deep_query_pair_mut_first(w6, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(mana));
    if ecs_av_pair_query_mut_count(pq) != 1 { panic(143030); };
    let item = ecs_av_pair_query_mut_at(pq, 0);
    let w7 = ecs_av_world_deep_pair_write_first(w6, item, ecs_av_data_deep_new(ecs_av_data_deep_amount(ecs_av_pair_mut_first(item)) + ecs_av_data_deep_amount(ecs_av_pair_mut_second(item))));
    if ecs_av_world_deep_entity_archetype_id(w7, entity) != original_group { panic(143031); };
    if ecs_av_world_deep_entity_row(w7, entity) != original_row { panic(143032); };
    let out = ecs_av_world_deep_get(w7, entity, ecs_av_comp_info_id_deep(health));
    if ecs_av_data_deep_amount(out) != 8 { panic(143033); };
    if ecs_av_world_deep_added_since(w7, entity, ecs_av_comp_info_id_deep(health), before) != false { panic(143034); };
    if ecs_av_world_deep_changed_since(w7, entity, ecs_av_comp_info_id_deep(health), before) != true { panic(143035); };
    let changed = ecs_av_world_deep_query_changed(w7, ecs_av_comp_info_id_deep(health), before);
    if ecs_av_query_deep_count(changed) != 1 { panic(143036); };
    let w8 = ecs_av_world_deep_insert_resource(w7, ecs_av_time_deep_new(ecs_av_world_deep_change_tick(w7)));
    let w9 = ecs_av_world_deep_write_message(w8, ecs_av_event_deep_new(6));
    let w10 = ecs_av_world_deep_despawn(w9, entity);
    if ecs_av_world_deep_is_alive(w10, entity) != false { panic(143037); };
    if ecs_av_world_deep_entity_archetype_id(w10, entity) != -1 { panic(143038); };
    let time = ecs_av_world_deep_get_resource(w10);
    // change_tick on w7 (post-increment from w6 = tick 2 -> 3) was stamped into res_tick at
    // insert_resource time; despawn does not touch the resource. So we expect the value of
    // change_tick AFTER the increment (which equals t_before_change + 1 = 3).
    if ecs_av_time_deep_tick(time) != 3 { panic(143039); };
    let read = ecs_av_world_deep_read_message(w10, 0, ecs_av_event_deep_new(0));
    if ecs_av_read_has_value(read) != true { panic(143040); };
    if ecs_av_read_amount(read) != 6 { panic(143041); };
}

// ── Test 4: remove returns entity to the matching smaller signature (back to arch 0 empty). ──
@test "EcsAVWorldDeep remove migrates entity to the smaller signature (empty archetype)"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let mana = ecs_av_register_info_deep(r2);
    let sp = ecs_av_world_deep_spawn(w2);
    let w3 = spawn_w(sp);
    let entity = spawn_e(sp);
    let w4 = ecs_av_world_deep_insert(w3, entity, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(11));
    let w5 = ecs_av_world_deep_insert(w4, entity, ecs_av_comp_info_id_deep(mana), ecs_av_data_deep_new(7));
    // entity in {health, mana} archetype (created on first insert).
    let two_arch = ecs_av_world_deep_entity_archetype_id(w5, entity);
    if two_arch == 0 { panic(143050); };
    let w6 = ecs_av_world_deep_remove(w5, entity, ecs_av_comp_info_id_deep(health));
    // removing health leaves only {mana} -- migration to {mana} archetype.
    if ecs_av_world_deep_has(w6, entity, ecs_av_comp_info_id_deep(health)) != false { panic(143051); };
    if ecs_av_world_deep_has(w6, entity, ecs_av_comp_info_id_deep(mana)) != true { panic(143052); };
    if ecs_av_world_deep_entity_archetype_id(w6, entity) == two_arch { panic(143053); };
    let r = ecs_av_world_deep_get(w6, entity, ecs_av_comp_info_id_deep(mana));
    if ecs_av_data_deep_amount(r) != 7 { panic(143054); };
    let w7 = ecs_av_world_deep_remove(w6, entity, ecs_av_comp_info_id_deep(mana));
    // removing the last component returns to arch 0 (empty archetype).
    if ecs_av_world_deep_entity_archetype_id(w7, entity) != 0 { panic(143055); };
    if ecs_av_world_deep_archetype_entity_count(w7, 0) != 1 { panic(143056); };
    // remove a missing comp is a silent no-op.
    let w8 = ecs_av_world_deep_remove(w7, entity, ecs_av_comp_info_id_deep(health));
    if ecs_av_world_deep_entity_count(w8) != 1 { panic(143057); };
}

// ── Test 5: query variants + added_since on a fresh insert + replace preserves added tick. ──
@test "EcsAVWorldDeep query + added_since + replace preserves added tick"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let mana = ecs_av_register_info_deep(r2);
    let sp1 = ecs_av_world_deep_spawn(w2);
    let w3 = spawn_w(sp1);
    let e1 = spawn_e(sp1);
    let sp2 = ecs_av_world_deep_spawn(w3);
    let w4 = spawn_w(sp2);
    let e2 = spawn_e(sp2);
    // registers bumped change_tick to 2; inserts stamp added_t at the CURRENT change_tick (=2).
    // added_since is strict-greater-than, so we use (change_tick - 1) as the since-tick to catch them.
    let tick_after_registers = ecs_av_world_deep_change_tick(w4);
    let tick_before_inserts = tick_after_registers - 1;
    let w5 = ecs_av_world_deep_insert(w4, e1, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(5));
    let w6 = ecs_av_world_deep_insert(w5, e2, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(9));
    // both e1, e2 are in {health} archetype now (one archetype {1} created on the first insert).
    let q = ecs_av_world_deep_query(w6, ecs_av_comp_info_id_deep(health));
    if ecs_av_query_deep_count(q) != 2 { panic(143060); };
    let q_added = ecs_av_world_deep_query_added(w6, ecs_av_comp_info_id_deep(health), tick_before_inserts);
    if ecs_av_query_deep_count(q_added) != 2 { panic(143061); };
    // Capture pre-increment tick (the inserts stamp added/changed at this value). Increment, then
    // replace e1's health, which bumps its changed tick to the post-increment value while preserving
    // added. Both added_since and changed_since are strict-greater-than the captured pre-increment tick.
    let since_replace = tick_after_registers;
    let w7 = ecs_av_world_deep_increment_tick(w6);
    // replace e1's health: bumps changed tick to the post-increment value (= since_replace + 1).
    let w8 = ecs_av_world_deep_insert(w7, e1, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(15));
    // The original added ticks equal `since_replace`; added_since(since_replace) must be false.
    if ecs_av_world_deep_added_since(w8, e1, ecs_av_comp_info_id_deep(health), since_replace) != false { panic(143062); };
    // Since-since(since_replace - 1) catches the original added ticks. We expect true.
    if ecs_av_world_deep_added_since(w8, e1, ecs_av_comp_info_id_deep(health), since_replace - 1) != true { panic(143063); };
    // The replace bumped changed tick to the post-increment value (= since_replace + 1), so
    // changed_since(since_replace) is true.
    if ecs_av_world_deep_changed_since(w8, e1, ecs_av_comp_info_id_deep(health), since_replace) != true { panic(143064); };
    // query_changed(since_replace) picks up exactly the one entity that was replaced (e1);
    // e2's changed tick (= since_replace) is NOT > since_replace so it is not included.
    let q_changed = ecs_av_world_deep_query_changed(w8, ecs_av_comp_info_id_deep(health), since_replace);
    if ecs_av_query_deep_count(q_changed) != 1 { panic(143065); };
    let q_without_mana = ecs_av_world_deep_query_without(w8, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(mana));
    if ecs_av_query_deep_count(q_without_mana) != 2 { panic(143066); };
    let q_with_mana = ecs_av_world_deep_query_with(w8, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(mana));
    if ecs_av_query_deep_count(q_with_mana) != 0 { panic(143067); };
}

// ── Test 6: pair_query writeback across two entities, then despawn leaves the other. ──
@test "EcsAVWorldDeep pair_mut writeback across two entities + despawn leaves count"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let mana = ecs_av_register_info_deep(r2);
    let sp1 = ecs_av_world_deep_spawn(w2);
    let w3 = spawn_w(sp1);
    let e1 = spawn_e(sp1);
    let sp2 = ecs_av_world_deep_spawn(w3);
    let w4 = spawn_w(sp2);
    let e2 = spawn_e(sp2);
    let w5 = ecs_av_world_deep_insert(w4, e1, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(2));
    let w6 = ecs_av_world_deep_insert(w5, e1, ecs_av_comp_info_id_deep(mana), ecs_av_data_deep_new(4));
    let w7 = ecs_av_world_deep_insert(w6, e2, ecs_av_comp_info_id_deep(health), ecs_av_data_deep_new(6));
    let w8 = ecs_av_world_deep_insert(w7, e2, ecs_av_comp_info_id_deep(mana), ecs_av_data_deep_new(1));
    let sp3 = ecs_av_world_deep_spawn(w8);
    let w9 = spawn_w(sp3);
    let e3 = spawn_e(sp3);
    // e3 has only health; only e1 and e2 should land in the pair_mut query (both comps).
    let pq = ecs_av_world_deep_query_pair_mut_first(w9, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(mana));
    if ecs_av_pair_query_mut_count(pq) != 2 { panic(143070); };
    let w10 = ecs_av_world_deep_despawn(w9, e2);
    if ecs_av_world_deep_entity_count(w10) != 2 { panic(143071); };
    if ecs_av_world_deep_is_alive(w10, e2) != false { panic(143072); };
    if ecs_av_world_deep_is_alive(w10, e1) != true { panic(143073); };
    // after despawning e2, the pair_mut query should only have e1.
    let pq2 = ecs_av_world_deep_query_pair_mut_first(w10, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(mana));
    if ecs_av_pair_query_mut_count(pq2) != 1 { panic(143074); };
}

// ── Test 7: resource res / res_mut / res_mut_write / added_since / changed_since / remove_resource. ──
@test "EcsAVWorldDeep resource added/changed + res_mut_write + remove_resource"() {
    let w0 = ecs_av_world_deep_new();
    // Capture `before` BEFORE the increment that stamps added+changed, so `before` is strictly
    // less than the post-increment tick used as the added tick stamp.
    let before = ecs_av_world_deep_change_tick(w0);
    let w0a = ecs_av_world_deep_increment_tick(w0);
    let w1 = ecs_av_world_deep_insert_resource(w0a, ecs_av_time_deep_new(3));
    if ecs_av_world_deep_resource_added_since(w1, before) != true { panic(143080); };
    if ecs_av_world_deep_resource_changed_since(w1, before) != true { panic(143081); };
    // The post-increment tick used for added stamp must be `before + 1`; compute arithmetically
    // rather than re-reading change_tick(w1) because SA passes structs by reference (Batch 386 #1).
    let t_after_insert = before + 1;
    let w2 = ecs_av_world_deep_increment_tick(w1);
    let res = ecs_av_world_deep_res_mut(w2);
    if ecs_av_resmut_is_added_since(res, t_after_insert) != false { panic(143082); };
    if ecs_av_resmut_is_changed_since(res, t_after_insert) != false { panic(143083); };
    let w3 = ecs_av_world_deep_res_mut_write(w2, res, ecs_av_time_deep_new(ecs_av_resmut_value(res) + 2));
    let r2 = ecs_av_world_deep_get_resource(w3);
    if ecs_av_time_deep_tick(r2) != 5 { panic(143084); };
    if ecs_av_world_deep_resource_added_since(w3, t_after_insert) != false { panic(143085); };
    if ecs_av_world_deep_resource_changed_since(w3, before) != true { panic(143086); };
    let w4 = ecs_av_world_deep_remove_resource(w3);
    if ecs_av_world_deep_has_resource(w4) != false { panic(143087); };
}

// ── Test 8: message write + multi-read sequential cursor + cap-8 reject on full buffer at tail. ──
@test "EcsAVWorldDeep message write + read_next advances cursor + sentinel after drain"() {
    let w0 = ecs_av_world_deep_new();
    let w1 = ecs_av_world_deep_write_message(w0, ecs_av_event_deep_new(11));
    let w2 = ecs_av_world_deep_write_message(w1, ecs_av_event_deep_new(22));
    let read0 = ecs_av_world_deep_read_message(w2, 0, ecs_av_event_deep_new(0));
    if ecs_av_read_has_value(read0) != true { panic(143090); };
    if ecs_av_read_amount(read0) != 11 { panic(143091); };
    let read1 = ecs_av_world_deep_read_message(w2, ecs_av_read_cursor(read0), ecs_av_event_deep_new(0));
    if ecs_av_read_has_value(read1) != true { panic(143092); };
    if ecs_av_read_amount(read1) != 22 { panic(143093); };
    let read2 = ecs_av_world_deep_read_message(w2, ecs_av_read_cursor(read1), ecs_av_event_deep_new(99));
    if ecs_av_read_has_value(read2) != false { panic(143094); };
    if ecs_av_read_amount(read2) != 99 { panic(143095); };
}

// ── Test 9: cap-4 component register rejects 5th with CompInfo.id -1 sanity + cap-8 spawn cap. ──
@test "EcsAVWorldDeep cap-4 component register rejects 5th + cap-8 spawn cap reject"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let r3 = ecs_av_world_deep_register_table(w2);
    let w3 = ecs_av_register_world_deep(r3);
    let r4 = ecs_av_world_deep_register_sparse_set(w3);
    let w4 = ecs_av_register_world_deep(r4);
    if ecs_av_world_deep_component_count(w4) != 4 { panic(143096); };
    let r5 = ecs_av_world_deep_register_table(w4);
    let w5 = ecs_av_register_world_deep(r5);
    if ecs_av_comp_info_id_deep(ecs_av_register_info_deep(r5)) != -1 { panic(143097); };
    if ecs_av_world_deep_component_count(w5) != 4 { panic(143098); };
    // Spawn 5 entities; cap-4 row cap on the empty arch 0 means the 5th spawn returns entity.id -1.
    let s1 = ecs_av_world_deep_spawn(w5);
    let w6 = spawn_w(s1);
    let s2 = ecs_av_world_deep_spawn(w6);
    let w7 = spawn_w(s2);
    let s3 = ecs_av_world_deep_spawn(w7);
    let w8 = spawn_w(s3);
    let s4 = ecs_av_world_deep_spawn(w8);
    let w9 = spawn_w(s4);
    let s5 = ecs_av_world_deep_spawn(w9);
    let w10 = spawn_w(s5);
    let e5 = spawn_e(s5);
    if e5.id != -1 { panic(143099); };
    if ecs_av_world_deep_entity_count(w10) != 4 { panic(143100); };
}

// ── Test 10: cap-4 archetype reject on insert of distinct 4th component. ──
@test "EcsAVWorldDeep cap-4 archetype reject on insert of 4th distinct component"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let c0 = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let c1 = ecs_av_register_info_deep(r2);
    let r3 = ecs_av_world_deep_register_table(w2);
    let w3 = ecs_av_register_world_deep(r3);
    let c2 = ecs_av_register_info_deep(r3);
    let r4 = ecs_av_world_deep_register_sparse_set(w3);
    let w4 = ecs_av_register_world_deep(r4);
    let c3 = ecs_av_register_info_deep(r4);
    let sp = ecs_av_world_deep_spawn(w4);
    let w5 = spawn_w(sp);
    let e1 = spawn_e(sp);
    let w6 = ecs_av_world_deep_insert(w5, e1, ecs_av_comp_info_id_deep(c0), ecs_av_data_deep_new(1));
    let w7 = ecs_av_world_deep_insert(w6, e1, ecs_av_comp_info_id_deep(c1), ecs_av_data_deep_new(2));
    let w8 = ecs_av_world_deep_insert(w7, e1, ecs_av_comp_info_id_deep(c2), ecs_av_data_deep_new(3));
    if ecs_av_world_deep_archetype_count(w8) != 4 { panic(143110); };
    // insert a 4th distinct component; the new "new archetype" should be silently rejected and
    // the entity stays in its current 3-component archetype (cap-4 archetype clamp).
    let w9 = ecs_av_world_deep_insert(w8, e1, ecs_av_comp_info_id_deep(c3), ecs_av_data_deep_new(4));
    if ecs_av_world_deep_archetype_count(w9) != 4 { panic(143111); };
    if ecs_av_world_deep_has(w9, e1, ecs_av_comp_info_id_deep(c3)) != false { panic(143112); };
}
