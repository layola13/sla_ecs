@import "lib/required_components_error.sla"

// Isolated tests for lib/required_components_error.sla — RequiredComponentsError enum + lifecycle constants.
// Bevy: src/component/required.rs + src/component/constants.rs.
// panic codes: 92346 – 92375.

@test "duplicate_registration_ctor"() {
    let e = ecs_rce_duplicate_registration(7, 9);
    if ecs_rce_kind(e) != 0 { panic(92346); };
    if ecs_rce_a(e) != 7 { panic(92347); };
    if ecs_rce_b(e) != 9 { panic(92348); };
    if !ecs_rce_is_duplicate_registration(e) { panic(92349); };
}

@test "cyclic_requirement_ctor"() {
    let e = ecs_rce_cyclic_requirement(11, 12);
    if ecs_rce_kind(e) != 1 { panic(92350); };
    if ecs_rce_a(e) != 11 { panic(92351); };
    if ecs_rce_b(e) != 12 { panic(92352); };
    if !ecs_rce_is_cyclic_requirement(e) { panic(92353); };
}

@test "archetype_exists_ctor"() {
    let e = ecs_rce_archetype_exists(5);
    if ecs_rce_kind(e) != 2 { panic(92354); };
    if ecs_rce_a(e) != 5 { panic(92355); };
    if ecs_rce_b(e) != (0 - 1) { panic(92356); };
    if !ecs_rce_is_archetype_exists(e) { panic(92357); };
}

@test "error_kind_discriminators_disjoint"() {
    let d = ecs_rce_duplicate_registration(1, 2);
    let c = ecs_rce_cyclic_requirement(1, 2);
    let a = ecs_rce_archetype_exists(1);
    if ecs_rce_is_cyclic_requirement(d) { panic(92358); };
    if ecs_rce_is_archetype_exists(d) { panic(92359); };
    if ecs_rce_is_duplicate_registration(c) { panic(92360); };
    if ecs_rce_is_archetype_exists(c) { panic(92361); };
    if ecs_rce_is_duplicate_registration(a) { panic(92362); };
    if ecs_rce_is_cyclic_requirement(a) { panic(92363); };
}

@test "lifecycle_constants_values"() {
    if ecs_const_add() != 0 { panic(92364); };
    if ecs_const_insert() != 1 { panic(92365); };
    if ecs_const_discard() != 2 { panic(92366); };
    if ecs_const_remove() != 3 { panic(92367); };
    if ecs_const_despawn() != 4 { panic(92368); };
    if ecs_const_is_resource() != 5 { panic(92369); };
}

@test "lifecycle_kind_lookup"() {
    if ecs_const_lifecycle_kind(0) != 0 { panic(92370); };
    if ecs_const_lifecycle_kind(5) != 5 { panic(92371); };
    if ecs_const_lifecycle_kind(3) != 3 { panic(92372); };
    if ecs_const_lifecycle_kind(6) != (0 - 1) { panic(92373); };
    if ecs_const_lifecycle_kind((0 - 1)) != (0 - 1) { panic(92374); };
}

@test "duplicate_pair_uses_message_ordering"() {
    // Display: "Component {0:?} already directly requires component {1:?}" — a=0, b=1 (requiree, required).
    let e = ecs_rce_duplicate_registration(0, 1);
    if ecs_rce_a(e) == ecs_rce_b(e) { panic(92375); };
}
