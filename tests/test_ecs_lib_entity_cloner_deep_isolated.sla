@import "lib/entity_cloner_deep.sla"

// Batch 248: entity_cloner deep (src/entity/clone_entities.rs).
// panic codes: 115600 – 115799.

@test "builder_opt_out_and_opt_in"() {
    let b = ecs_ec_builder_opt_out();
    if ecs_ec_builder_is_opt_in(b) != false { panic(115600); };
    b = ecs_ec_builder_opt_in();
    if ecs_ec_builder_is_opt_in(b) != true { panic(115601); };
}

@test "builder_allow_deny_dedup"() {
    let b = ecs_ec_builder_opt_in();
    b = ecs_ec_builder_allow(b, 1);
    b = ecs_ec_builder_allow(b, 2);
    b = ecs_ec_builder_allow(b, 1);
    if ecs_ec_builder_allow_len(b) != 2 { panic(115610); };
    b = ecs_ec_builder_deny(b, 3);
    b = ecs_ec_builder_deny(b, 3);
    if ecs_ec_builder_deny_len(b) != 1 { panic(115611); };
}

@test "opt_out_should_clone_respects_deny"() {
    let b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_deny(b, 5);
    let c = ecs_ec_finish(b);
    if ecs_ec_should_clone(c, 1) != true { panic(115620); };
    if ecs_ec_should_clone(c, 5) != false { panic(115621); };
}

@test "opt_in_should_clone_only_allowed"() {
    let b = ecs_ec_builder_opt_in();
    b = ecs_ec_builder_allow(b, 2);
    b = ecs_ec_builder_allow(b, 4);
    let c = ecs_ec_finish(b);
    if ecs_ec_should_clone(c, 2) != true { panic(115630); };
    if ecs_ec_should_clone(c, 3) != false { panic(115631); };
    if ecs_ec_should_clone(c, 4) != true { panic(115632); };
}

@test "override_ignore_skips_component"() {
    let b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_override(b, 7, 0); // ignore
    let c = ecs_ec_finish(b);
    if ecs_ec_should_clone(c, 7) != true { panic(115640); }; // filter allows
    if ecs_ec_clone_behavior_of(c, 7) != 0 { panic(115641); };
    if ecs_ec_clone_entity_count(c, 2, 7, 8, -1, -1) != 1 { panic(115642); }; // only 8
}

@test "clone_entity_count_and_spawn"() {
    let b = ecs_ec_builder_opt_in();
    b = ecs_ec_builder_allow(b, 1);
    b = ecs_ec_builder_allow(b, 2);
    b = ecs_ec_builder_allow(b, 3);
    let c = ecs_ec_finish(b);
    if ecs_ec_clone_entity_count(c, 3, 1, 9, 2, -1) != 2 { panic(115650); };
    let s = ecs_ec_spawn_clone(c, 42, 3, 1, 9, 2, -1);
    if s.0 != 42 { panic(115651); };
    if s.1 != 2 { panic(115652); };
}

@test "move_linked_insert_mode_flags"() {
    let b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_move(b, true);
    b = ecs_ec_builder_linked(b, true);
    b = ecs_ec_builder_insert_mode(b, ecs_ec_insert_keep());
    b = ecs_ec_builder_add_observers(b, true);
    let c = ecs_ec_finish(b);
    if ecs_ec_moving(c) != true { panic(115660); };
    if ecs_ec_linked(c) != true { panic(115661); };
    if ecs_ec_insert_mode(c) != ecs_ec_insert_keep() { panic(115662); };
    if ecs_ec_add_observers(c) != true { panic(115663); };
}

@test "would_write_keep_existing"() {
    let b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_insert_mode(b, ecs_ec_insert_keep());
    let c = ecs_ec_finish(b);
    if ecs_ec_would_write(c, 1, false) != true { panic(115670); };
    if ecs_ec_would_write(c, 1, true) != false { panic(115671); };
    b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_insert_mode(b, ecs_ec_insert_replace());
    c = ecs_ec_finish(b);
    if ecs_ec_would_write(c, 1, true) != true { panic(115672); };
}

@test "default_fn_ignore_skips_all_without_override"() {
    let b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_default_fn(b, 0);
    let c = ecs_ec_finish(b);
    if ecs_ec_clone_entity_count(c, 2, 1, 2, -1, -1) != 0 { panic(115680); };
    b = ecs_ec_builder_opt_out();
    b = ecs_ec_builder_default_fn(b, 0);
    b = ecs_ec_builder_override(b, 1, 1);
    c = ecs_ec_finish(b);
    if ecs_ec_clone_entity_count(c, 2, 1, 2, -1, -1) != 1 { panic(115681); };
}

@test "constants"() {
    if ecs_ec_filter_opt_out() != 0 { panic(115690); };
    if ecs_ec_filter_opt_in() != 1 { panic(115691); };
    if ecs_ec_insert_replace() != 0 { panic(115692); };
    if ecs_ec_insert_keep() != 1 { panic(115693); };
}
