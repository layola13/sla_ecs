@import "lib/archetype_deep.sla"

// Batch 246: archetype deep (src/archetype.rs).
// panic codes: 115200 – 115399.

@test "ids_rows_and_entity"() {
    let id = ecs_ad_id_new(3);
    if ecs_ad_id_value(id) != 3 { panic(115200); };
    if ecs_ad_id_eq(id, ecs_ad_id_new(3)) != true { panic(115201); };
    let row = ecs_ad_row_new(5);
    if ecs_ad_row_value(row) != 5 { panic(115202); };
    let e = ecs_ad_entity_new(10, 2);
    if ecs_ad_entity_id(e) != 10 { panic(115203); };
    if ecs_ad_entity_table_row(e) != 2 { panic(115204); };
}

@test "after_insert_status_and_added"() {
    let a = ecs_ad_after_insert_new(7);
    a = ecs_ad_after_insert_push_status(a, ecs_ad_status_added(), 1);
    a = ecs_ad_after_insert_push_status(a, ecs_ad_status_existed(), 2);
    a = ecs_ad_after_insert_push_status(a, ecs_ad_status_added(), 3);
    if ecs_ad_after_insert_id(a) != 7 { panic(115210); };
    if ecs_ad_after_insert_status_len(a) != 3 { panic(115211); };
    if ecs_ad_after_insert_added_len(a) != 2 { panic(115212); };
    if ecs_ad_after_insert_status_at(a, 1) != ecs_ad_status_existed() { panic(115213); };
    if ecs_ad_after_insert_added_at(a, 0) != 1 { panic(115214); };
    if ecs_ad_after_insert_added_at(a, 1) != 3 { panic(115215); };
}

@test "edges_insert_cache"() {
    let e = ecs_ad_edges_new();
    let after = ecs_ad_after_insert_new(2);
    after = ecs_ad_after_insert_push_status(after, ecs_ad_status_added(), 9);
    e = ecs_ad_edges_cache_insert(e, 100, after);
    if ecs_ad_edges_insert_count(e) != 1 { panic(115220); };
    let g = ecs_ad_edges_get_insert(e, 100);
    if g.0 != true { panic(115221); };
    if ecs_ad_after_insert_id(g.1) != 2 { panic(115222); };
    let miss = ecs_ad_edges_get_insert(e, 999);
    if miss.0 != false { panic(115223); };
}

@test "edges_remove_and_take_optional"() {
    let e = ecs_ad_edges_new();
    e = ecs_ad_edges_cache_remove(e, 1, true, 4);
    e = ecs_ad_edges_cache_remove(e, 2, false, -1);
    let r = ecs_ad_edges_get_remove(e, 1);
    if ecs_ad_edge_opt_cached(r) != true { panic(115230); };
    if ecs_ad_edge_opt_has(r) != true { panic(115231); };
    if ecs_ad_edge_opt_id(r) != 4 { panic(115232); };
    r = ecs_ad_edges_get_remove(e, 2);
    if ecs_ad_edge_opt_has(r) != false { panic(115233); };
    r = ecs_ad_edges_get_remove(e, 9);
    if ecs_ad_edge_opt_cached(r) != false { panic(115234); };
    e = ecs_ad_edges_cache_take(e, 3, true, 8);
    let t = ecs_ad_edges_get_take(e, 3);
    if ecs_ad_edge_opt_has(t) != true { panic(115235); };
    if ecs_ad_edge_opt_id(t) != 8 { panic(115236); };
}

@test "archetype_components_and_flags"() {
    let a = ecs_ad_archetype_new(1, 5);
    a = ecs_ad_archetype_add_component(a, 10, 0);
    a = ecs_ad_archetype_add_component(a, 11, 1);
    a = ecs_ad_archetype_add_component(a, 10, 0); // de-dup
    if ecs_ad_archetype_component_count(a) != 2 { panic(115240); };
    if ecs_ad_archetype_has_component(a, 11) != true { panic(115241); };
    if ecs_ad_archetype_has_component(a, 99) != false { panic(115242); };
    a = ecs_ad_archetype_set_flag(a, ecs_ad_flag_on_add());
    a = ecs_ad_archetype_set_flag(a, ecs_ad_flag_on_remove());
    if ecs_ad_archetype_has_flag(a, ecs_ad_flag_on_add()) != true { panic(115243); };
    if ecs_ad_archetype_has_flag(a, ecs_ad_flag_on_insert()) != false { panic(115244); };
    if ecs_ad_archetype_table_id(a) != 5 { panic(115245); };
}

@test "archetype_allocate_and_swap_remove"() {
    let a = ecs_ad_archetype_new(1, 0);
    let r = ecs_ad_archetype_allocate(a, 100, 0); a = r.0;
    if r.1 != 0 { panic(115250); };
    r = ecs_ad_archetype_allocate(a, 101, 1); a = r.0;
    r = ecs_ad_archetype_allocate(a, 102, 2); a = r.0;
    if ecs_ad_archetype_len(a) != 3 { panic(115251); };
    if ecs_ad_entity_id(ecs_ad_archetype_entity_at(a, 1)) != 101 { panic(115252); };
    a = ecs_ad_archetype_swap_remove(a, 0);
    if ecs_ad_archetype_len(a) != 2 { panic(115253); };
    if ecs_ad_entity_id(ecs_ad_archetype_entity_at(a, 0)) != 102 { panic(115254); };
    if ecs_ad_entity_id(ecs_ad_archetype_entity_at(a, 1)) != 101 { panic(115255); };
}

@test "archetype_edges_roundtrip"() {
    let a = ecs_ad_archetype_new(1, 0);
    let edges = ecs_ad_edges_new();
    let after = ecs_ad_after_insert_new(3);
    edges = ecs_ad_edges_cache_insert(edges, 9, after);
    a = ecs_ad_archetype_set_edges(a, edges);
    let e2 = ecs_ad_archetype_edges(a);
    if ecs_ad_edges_insert_count(e2) != 1 { panic(115260); };
    let g = ecs_ad_edges_get_insert(e2, 9);
    if g.0 != true { panic(115261); };
    if ecs_ad_after_insert_id(g.1) != 3 { panic(115262); };
}

@test "archetypes_empty_and_get_or_create"() {
    let a = ecs_ad_archetypes_new();
    if ecs_ad_archetypes_len(a) != 1 { panic(115270); };
    if ecs_ad_archetypes_empty_id() != 0 { panic(115271); };
    let g = ecs_ad_archetypes_get(a, 0);
    if g.0 != true { panic(115272); };
    if ecs_ad_archetype_is_empty(g.1) != true { panic(115273); };
    let r = ecs_ad_archetypes_get_or_create(a, 2, 1, 2, -1, -1, 7);
    a = r.0;
    if r.1 != 1 { panic(115274); };
    if ecs_ad_archetypes_len(a) != 2 { panic(115275); };
    if ecs_ad_archetypes_generation(a) != 1 { panic(115276); };
    // find existing
    r = ecs_ad_archetypes_get_or_create(a, 2, 1, 2, -1, -1, 7);
    a = r.0;
    if r.1 != 1 { panic(115277); };
    if ecs_ad_archetypes_len(a) != 2 { panic(115278); };
    g = ecs_ad_archetypes_get(a, 1);
    if ecs_ad_archetype_component_count(g.1) != 2 { panic(115279); };
    if ecs_ad_archetype_table_id(g.1) != 7 { panic(115280); };
}

@test "archetypes_find_missing"() {
    let a = ecs_ad_archetypes_new();
    if ecs_ad_archetypes_find(a, 1, 9, -1, -1, -1) != -1 { panic(115290); };
    let r = ecs_ad_archetypes_get_or_create(a, 1, 9, -1, -1, -1, 1);
    a = r.0;
    if ecs_ad_archetypes_find(a, 1, 9, -1, -1, -1) != 1 { panic(115291); };
}

@test "status_and_flag_constants"() {
    if ecs_ad_status_added() != 0 { panic(115300); };
    if ecs_ad_status_existed() != 1 { panic(115301); };
    if ecs_ad_flag_on_add() != 1 { panic(115302); };
    if ecs_ad_flag_on_despawn() != 16 { panic(115303); };
}
