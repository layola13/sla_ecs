// Isolated deep tests for lib/bundle_table_erased_deep.sla (Batch 392).
// Mirrors shallow lib/bundle_table_erased.sla's Bevy-style bundle ops over TableErasedWorld.
// The deep is self-contained: fixed-cap registry + entity allocator + Pos/Vel table stores +
// Player sparse-set store. Tuple-return shallow ops use wrappers; tests use while loops only.
// panic codes: 143600 - 143681 (Batch 392 band; previous Batch 391 used 143500-143595).

@import "lib/bundle_table_erased_deep.sla"

fn rb_w(r: EcsBteRegister) -> EcsBteWorld { return ecs_bte_register_world(r); }
fn rb_id(r: EcsBteRegister) -> i32 { return ecs_bte_register_component_id(r); }
fn sb_w(s: EcsBteSpawn) -> EcsBteWorld { return ecs_bte_spawn_world(s); }
fn sb_e(s: EcsBteSpawn) -> EcsBteEntity { return ecs_bte_spawn_entity(s); }
fn sbb_w(s: EcsBteSpawnBatch) -> EcsBteWorld { return ecs_bte_spawn_batch_world(s); }
fn sbb_e(s: EcsBteSpawnBatch, idx: i32) -> EcsBteEntity { return ecs_bte_spawn_batch_entity_at(s, idx); }

fn bte_register_three(w0: EcsBteWorld) -> EcsBteRegister {
    let r1 = ecs_bte_world_register_component_metadata(w0, ECS_BTE_POS_TYPE, ECS_BTE_TABLE_KIND);
    let w1 = rb_w(r1);
    let r2 = ecs_bte_world_register_component_metadata(w1, ECS_BTE_VEL_TYPE, ECS_BTE_TABLE_KIND);
    let w2 = rb_w(r2);
    let r3 = ecs_bte_world_register_component_metadata(w2, ECS_BTE_PLAYER_TYPE, ECS_BTE_SPARSE_KIND);
    return r3;
}

@test "EcsBte bundle3 spawns and inserts component sets"() {
    let w0 = ecs_bte_world_new();
    let rpos = ecs_bte_world_register_component_metadata(w0, ECS_BTE_POS_TYPE, ECS_BTE_TABLE_KIND);
    let w1 = rb_w(rpos);
    let pos_id = rb_id(rpos);
    let rvel = ecs_bte_world_register_component_metadata(w1, ECS_BTE_VEL_TYPE, ECS_BTE_TABLE_KIND);
    let w2 = rb_w(rvel);
    let vel_id = rb_id(rvel);
    let rplayer = ecs_bte_world_register_component_metadata(w2, ECS_BTE_PLAYER_TYPE, ECS_BTE_SPARSE_KIND);
    let w3 = rb_w(rplayer);
    let player_id = rb_id(rplayer);
    let bundle = ecs_bte_bundle3_new_player_pos_vel(7, 1, 0, 2, 0);
    let sp = ecs_bte_world_spawn_bundle3(w3, bundle);
    let w4 = sb_w(sp);
    let entity = sb_e(sp);
    if ecs_bte_world_has(w4, entity, pos_id) != true { panic(143600); };
    if ecs_bte_world_has(w4, entity, vel_id) != true { panic(143601); };
    if ecs_bte_world_has(w4, entity, player_id) != true { panic(143602); };
    if ecs_bte_world_entity_archetype_id(w4, entity) <= 0 { panic(143603); };
    let q = ecs_bte_world_query_pair_auto(w4);
    if ecs_bte_pair_query_count(q) != 1 { panic(143604); };
    let first = ecs_bte_pair_query_a_at(q, 0);
    let second = ecs_bte_pair_query_b_at(q, 0);
    if first.x + second.x != 3 { panic(143605); };
}

@test "EcsBte bundle2 insert preserves existing components"() {
    let w0 = ecs_bte_world_new();
    let rpos = ecs_bte_world_register_component_metadata(w0, ECS_BTE_POS_TYPE, ECS_BTE_TABLE_KIND);
    let w1 = rb_w(rpos);
    let pos_id = rb_id(rpos);
    let rvel = ecs_bte_world_register_component_metadata(w1, ECS_BTE_VEL_TYPE, ECS_BTE_TABLE_KIND);
    let w2 = rb_w(rvel);
    let vel_id = rb_id(rvel);
    let rplayer = ecs_bte_world_register_component_metadata(w2, ECS_BTE_PLAYER_TYPE, ECS_BTE_SPARSE_KIND);
    let w3 = rb_w(rplayer);
    let player_id = rb_id(rplayer);
    let sp = ecs_bte_world_spawn(w3);
    let w4 = sb_w(sp);
    let entity = sb_e(sp);
    let w5 = ecs_bte_world_insert_pos(w4, entity, 5, 0);
    let bundle = ecs_bte_bundle2_new_vel_player(4, 0, 3);
    let w6 = ecs_bte_world_insert_bundle2(w5, entity, bundle);
    if ecs_bte_world_has(w6, entity, pos_id) != true { panic(143610); };
    if ecs_bte_world_has(w6, entity, vel_id) != true { panic(143611); };
    if ecs_bte_world_has(w6, entity, player_id) != true { panic(143612); };
    let pos = ecs_bte_world_get_pos(w6, entity);
    let vel = ecs_bte_world_get_vel(w6, entity);
    let player = ecs_bte_world_get_player(w6, entity);
    if pos.x + vel.x + player.team != 12 { panic(143613); };
}

@test "EcsBte insert batch bundle3 overwrites existing components"() {
    let r = bte_register_three(ecs_bte_world_new());
    let w3 = rb_w(r);
    let sp1 = ecs_bte_world_spawn(w3);
    let w4 = sb_w(sp1);
    let first = sb_e(sp1);
    let sp2 = ecs_bte_world_spawn(w4);
    let w5 = sb_w(sp2);
    let second = sb_e(sp2);
    let w6 = ecs_bte_world_insert_pos(w5, first, 1, 0);
    let b0 = ecs_bte_bundle3_new_pos_vel_player(10, 0, 3, 0, 7);
    let b1 = ecs_bte_bundle3_new_pos_vel_player(20, 0, 4, 0, 8);
    let w7 = ecs_bte_world_insert_batch_bundle3(w6, first, b0, second, b1);
    let first_pos = ecs_bte_world_get_pos(w7, first);
    let second_pos = ecs_bte_world_get_pos(w7, second);
    let first_vel = ecs_bte_world_get_vel(w7, first);
    let second_player = ecs_bte_world_get_player(w7, second);
    if first_pos.x != 10 { panic(143620); };
    if second_pos.x != 20 { panic(143621); };
    if first_vel.x != 3 { panic(143622); };
    if second_player.team != 8 { panic(143623); };
    let q = ecs_bte_world_query_pair_auto(w7);
    if ecs_bte_pair_query_count(q) != 2 { panic(143624); };
}

@test "EcsBte insert batch bundle3 if_new preserves existing components"() {
    let r = bte_register_three(ecs_bte_world_new());
    let w3 = rb_w(r);
    let sp1 = ecs_bte_world_spawn(w3);
    let w4 = sb_w(sp1);
    let first = sb_e(sp1);
    let sp2 = ecs_bte_world_spawn(w4);
    let w5 = sb_w(sp2);
    let second = sb_e(sp2);
    let w6 = ecs_bte_world_insert_pos(w5, first, 1, 0);
    let b0 = ecs_bte_bundle3_new_pos_vel_player(10, 0, 3, 0, 7);
    let b1 = ecs_bte_bundle3_new_pos_vel_player(20, 0, 4, 0, 8);
    let w7 = ecs_bte_world_insert_batch_bundle3_if_new(w6, first, b0, second, b1);
    let first_pos = ecs_bte_world_get_pos(w7, first);
    let second_pos = ecs_bte_world_get_pos(w7, second);
    let first_vel = ecs_bte_world_get_vel(w7, first);
    let second_player = ecs_bte_world_get_player(w7, second);
    if first_pos.x != 1 { panic(143630); };
    if second_pos.x != 20 { panic(143631); };
    if first_vel.x != 3 { panic(143632); };
    if second_player.team != 8 { panic(143633); };
    let q = ecs_bte_world_query_pair_auto(w7);
    if ecs_bte_pair_query_count(q) != 2 { panic(143634); };
}

@test "EcsBte spawn batch bundle3 returns both entities and populated world"() {
    let r = bte_register_three(ecs_bte_world_new());
    let w3 = rb_w(r);
    let b0 = ecs_bte_bundle3_new_pos_vel_player(2, 0, 5, 0, 1);
    let b1 = ecs_bte_bundle3_new_pos_vel_player(4, 0, 7, 0, 2);
    let batch = ecs_bte_world_spawn_batch_bundle3(w3, b0, b1);
    let w4 = sbb_w(batch);
    let e0 = sbb_e(batch, 0);
    let e1 = sbb_e(batch, 1);
    if ecs_bte_spawn_batch_count(batch) != 2 { panic(143640); };
    if ecs_bte_is_alive(w4, e0) != true { panic(143641); };
    if ecs_bte_is_alive(w4, e1) != true { panic(143642); };
    let p0 = ecs_bte_world_get_pos(w4, e0);
    let v1 = ecs_bte_world_get_vel(w4, e1);
    if p0.x != 2 { panic(143643); };
    if v1.x != 7 { panic(143644); };
    let q = ecs_bte_world_query_pair_auto(w4);
    if ecs_bte_pair_query_count(q) != 2 { panic(143645); };
}

@test "EcsBte registry lookup and storage kind metadata"() {
    let w0 = ecs_bte_world_new();
    let rpos = ecs_bte_world_register_component_metadata(w0, ECS_BTE_POS_TYPE, ECS_BTE_TABLE_KIND);
    let w1 = rb_w(rpos);
    let rvel = ecs_bte_world_register_component_metadata(w1, ECS_BTE_VEL_TYPE, ECS_BTE_TABLE_KIND);
    let w2 = rb_w(rvel);
    let rplayer = ecs_bte_world_register_component_metadata(w2, ECS_BTE_PLAYER_TYPE, ECS_BTE_SPARSE_KIND);
    let w3 = rb_w(rplayer);
    if ecs_bte_world_component_id_for_type(w3, ECS_BTE_POS_TYPE) != rb_id(rpos) { panic(143650); };
    if ecs_bte_world_component_id_for_type(w3, ECS_BTE_VEL_TYPE) != rb_id(rvel) { panic(143651); };
    if ecs_bte_world_component_id_for_type(w3, ECS_BTE_PLAYER_TYPE) != rb_id(rplayer) { panic(143652); };
    if ecs_bte_world_kind_for_component(w3, rb_id(rpos)) != ECS_BTE_TABLE_KIND { panic(143653); };
    if ecs_bte_world_kind_for_component(w3, rb_id(rplayer)) != ECS_BTE_SPARSE_KIND { panic(143654); };
}

@test "EcsBte cap-16 spawn rejects with sentinel after slot-zero reservation"() {
    let w = ecs_bte_world_new();
    let i: i32 = 0;
    while i < 15 {
        let sp = ecs_bte_world_spawn(w);
        w = sb_w(sp);
        let e = sb_e(sp);
        if e.id != i + 1 { panic(143660 + i); };
        i = i + 1;
    }
    let sp16 = ecs_bte_world_spawn(w);
    let e16 = sb_e(sp16);
    if e16.id != -1 { panic(143676); };
    if e16.generation != 0 { panic(143677); };
}

@test "EcsBte spawn bundle2 pos vel queries as pair without player"() {
    let r = bte_register_three(ecs_bte_world_new());
    let w3 = rb_w(r);
    let bundle = ecs_bte_bundle2_new_pos_vel(6, 0, 8, 0);
    let sp = ecs_bte_world_spawn_bundle2(w3, bundle);
    let w4 = sb_w(sp);
    let e = sb_e(sp);
    if ecs_bte_world_has_player(w4, e) != false { panic(143680); };
    let q = ecs_bte_world_query_pair_auto(w4);
    if ecs_bte_pair_query_count(q) != 1 { panic(143681); };
    let a = ecs_bte_pair_query_a_at(q, 0);
    let b = ecs_bte_pair_query_b_at(q, 0);
    if a.x + b.x != 14 { panic(143682); };
}
