@import "lib/query_fetch_deep.sla"

// Batch 259: query_fetch deep (src/query/fetch.rs).
// panic codes: 117800 – 117999.

@test "entity_read_ref_write_kinds"() {
    let e = ecs_qfd_entity(42);
    let r = ecs_qfd_read(1, 10);
    let rf = ecs_qfd_ref(2, 20);
    let w = ecs_qfd_write(3, 30);
    if ecs_qfd_kind(e) != ECS_QFD_ENTITY { panic(117800); };
    if ecs_qfd_value(e) != 42 { panic(117801); };
    if ecs_qfd_is_read_only(r) != true { panic(117802); };
    if ecs_qfd_is_read_only(rf) != true { panic(117803); };
    if ecs_qfd_is_write(w) != true { panic(117804); };
    if ecs_qfd_is_read_only(w) != false { panic(117805); };
}

@test "option_and_has_present"() {
    let o = ecs_qfd_option(5, true, 55);
    let n = ecs_qfd_option(5, false, 99);
    let h = ecs_qfd_has(6, true);
    let m = ecs_qfd_has(6, false);
    if ecs_qfd_present(o) != true { panic(117810); };
    if ecs_qfd_value(o) != 55 { panic(117811); };
    if ecs_qfd_present(n) != false { panic(117812); };
    if ecs_qfd_value(n) != 0 { panic(117813); };
    if ecs_qfd_present(h) != true { panic(117814); };
    if ecs_qfd_present(m) != false { panic(117815); };
}

@test "write_set"() {
    let w = ecs_qfd_write(1, 1);
    w = ecs_qfd_write_set(w, 99);
    if ecs_qfd_value(w) != 99 { panic(117820); };
    let r = ecs_qfd_read(1, 1);
    r = ecs_qfd_write_set(r, 5);
    if ecs_qfd_value(r) != 1 { panic(117821); };
}

@test "any_of_present_and_ids"() {
    let a = ecs_qfd_any_of_new();
    a = ecs_qfd_any_of_add(a, 1, false);
    a = ecs_qfd_any_of_add(a, 2, true);
    a = ecs_qfd_any_of_add(a, 3, false);
    if ecs_qfd_any_of_len(a) != 3 { panic(117830); };
    if ecs_qfd_any_of_any_present(a) != true { panic(117831); };
    if ecs_qfd_any_of_has_id(a, 2) != true { panic(117832); };
    if ecs_qfd_any_of_has_id(a, 9) != false { panic(117833); };
}

@test "any_of_none_present"() {
    let a = ecs_qfd_any_of_new();
    a = ecs_qfd_any_of_add(a, 1, false);
    a = ecs_qfd_any_of_add(a, 2, false);
    if ecs_qfd_any_of_any_present(a) != false { panic(117840); };
}

@test "nested_push_and_at"() {
    let n = ecs_qfd_nested_new(10, 20);
    n = ecs_qfd_nested_push(n, 1);
    n = ecs_qfd_nested_push(n, 2);
    n = ecs_qfd_nested_push(n, 3);
    if ecs_qfd_nested_len(n) != 3 { panic(117850); };
    if ecs_qfd_nested_inner(n) != 10 { panic(117851); };
    if ecs_qfd_nested_filter(n) != 20 { panic(117852); };
    if ecs_qfd_nested_at(n, 1) != 2 { panic(117853); };
}

@test "query_item_and_ro_item"() {
    let w = ecs_qfd_write(1, 7);
    let item = ecs_qfd_item_new(w);
    if ecs_qfd_item_is_read_only(item) != false { panic(117860); };
    if ecs_qfd_item_value(item) != 7 { panic(117861); };
    let ro = ecs_qfd_ro_item(w);
    if ecs_qfd_item_is_read_only(ro) != true { panic(117862); };
    if ecs_qfd_item_kind(ro) != ECS_QFD_WRITE { panic(117863); };
}

@test "spawn_details"() {
    let s = ecs_qfd_spawn_new(9, 3, 100);
    if ecs_qfd_spawn_entity(s) != 9 { panic(117870); };
    if ecs_qfd_spawn_tick(s) != 3 { panic(117871); };
    if ecs_qfd_spawn_by(s) != 100 { panic(117872); };
}

@test "any_of_capacity_four"() {
    let a = ecs_qfd_any_of_new();
    a = ecs_qfd_any_of_add(a, 1, true);
    a = ecs_qfd_any_of_add(a, 2, true);
    a = ecs_qfd_any_of_add(a, 3, true);
    a = ecs_qfd_any_of_add(a, 4, true);
    a = ecs_qfd_any_of_add(a, 5, true);
    if ecs_qfd_any_of_len(a) != 4 { panic(117880); };
}

@test "nested_capacity_four"() {
    let n = ecs_qfd_nested_new(1, 2);
    n = ecs_qfd_nested_push(n, 1);
    n = ecs_qfd_nested_push(n, 2);
    n = ecs_qfd_nested_push(n, 3);
    n = ecs_qfd_nested_push(n, 4);
    n = ecs_qfd_nested_push(n, 5);
    if ecs_qfd_nested_len(n) != 4 { panic(117890); };
    if ecs_qfd_nested_at(n, 3) != 4 { panic(117891); };
}
