@import "lib/system_registry_deep.sla"

// Batch 187 tests for system_registry deep: SystemId, register/run/unregister,
// tracked Strong handles, CachedSystemId, RegisteredSystemError paths.

@test "system_id_and_marker"() {
    let id = ecs_system_id_deep_new(7, 1, 2);
    if ecs_system_id_deep_entity(id) != 7 { panic(101800); };
    if ecs_system_id_deep_input_type(id) != 1 { panic(101801); };
    if ecs_system_id_deep_output_type(id) != 2 { panic(101802); };
    let id2 = ecs_system_id_deep_from_entity(7);
    if ecs_system_id_deep_eq(id, id2) != true { panic(101803); };
    let m = ecs_system_id_marker_deep_new(1, 2);
    if ecs_system_id_marker_deep_matches(m, 1, 2) != true { panic(101804); };
    if ecs_system_id_marker_deep_matches(m, 1, 3) != false { panic(101805); };
}

@test "handle_strong_weak_eq"() {
    let s = ecs_system_handle_deep_strong(9, 0, 0);
    let w = ecs_system_handle_deep_weak(9, 0, 0);
    if ecs_system_handle_deep_is_strong(s) != true { panic(101810); };
    if ecs_system_handle_deep_is_weak(w) != true { panic(101811); };
    if ecs_system_handle_deep_eq(s, w) != true { panic(101812); };
    let id = ecs_system_handle_deep_to_id(s);
    if ecs_system_handle_deep_eq_id(w, id) != true { panic(101813); };
}

@test "register_and_count"() {
    let world = ecs_sr_world_deep_new();
    if ecs_sr_world_deep_count(world) != 0 { panic(101820); };
    let p = ecs_sr_world_deep_register(world, 100, 0, 0);
    world = p.0;
    let id = p.1;
    if ecs_system_id_deep_entity(id) != 1 { panic(101821); };
    if ecs_sr_world_deep_count(world) != 1 { panic(101822); };
    if ecs_sr_world_deep_next_entity(world) != 2 { panic(101823); };
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_OK { panic(101824); };
}

@test "run_system_local_persists"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register(world, 10, 0, 0);
    world = p.0;
    let id = p.1;
    let r1 = ecs_sr_world_deep_run_system(world, id);
    world = r1.0;
    if r1.1 != 1 { panic(101830); };
    let r2 = ecs_sr_world_deep_run_system(world, id);
    world = r2.0;
    if r2.1 != 2 { panic(101831); };
    if ecs_sr_world_deep_slot_run_count(world, id.entity) != 2 { panic(101832); };
    if ecs_sr_world_deep_slot_local(world, id.entity) != 2 { panic(101833); };
    if ecs_sr_world_deep_slot_initialized(world, id.entity) != true { panic(101834); };
    if ecs_sr_world_deep_flush_count(world) != 2 { panic(101835); };
}

@test "run_system_with_input"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register(world, 11, 5, 6);
    world = p.0;
    let id = p.1;
    let r = ecs_sr_world_deep_run_system_with(world, id, 10, 1);
    world = r.0;
    if r.1 != 10 { panic(101840); };
    let r2 = ecs_sr_world_deep_run_system_with(world, id, 3, 1);
    world = r2.0;
    if r2.1 != 13 { panic(101841); };
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_OK { panic(101842); };
}

@test "run_not_registered_and_incorrect_type"() {
    let world = ecs_sr_world_deep_new();
    let missing = ecs_system_id_deep_new(99, 0, 0);
    let r = ecs_sr_world_deep_run_system(world, missing);
    world = r.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_NOT_REGISTERED { panic(101850); };
    let p = ecs_sr_world_deep_register(world, 1, 1, 1);
    world = p.0;
    let id = p.1;
    let bad = ecs_system_id_deep_new(id.entity, 2, 1);
    let r2 = ecs_sr_world_deep_run_system(world, bad);
    world = r2.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_INCORRECT_TYPE { panic(101851); };
}

@test "run_skipped_and_failed_modes"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register(world, 1, 0, 0);
    world = p.0;
    let id = p.1;
    let r = ecs_sr_world_deep_run_system_with(world, id, 0, 2);
    world = r.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_SKIPPED { panic(101860); };
    if ecs_sr_world_deep_slot_run_count(world, id.entity) != 0 { panic(101861); };
    let r2 = ecs_sr_world_deep_run_system_with(world, id, 0, 3);
    world = r2.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_FAILED { panic(101862); };
    if ecs_sr_world_deep_last_err_code(world) != 99 { panic(101863); };
    if ecs_sr_world_deep_flush_count(world) != 1 { panic(101864); };
}

@test "unregister_returns_removed_system"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register(world, 42, 0, 0);
    world = p.0;
    let id = p.1;
    let run = ecs_sr_world_deep_run_system(world, id);
    world = run.0;
    let u = ecs_sr_world_deep_unregister(world, id);
    world = u.0;
    let rem = u.1;
    if ecs_removed_system_deep_valid(rem) != true { panic(101870); };
    if ecs_removed_system_deep_system(rem) != 42 { panic(101871); };
    if ecs_removed_system_deep_initialized(rem) != true { panic(101872); };
    if ecs_sr_world_deep_count(world) != 0 { panic(101873); };
    let again = ecs_sr_world_deep_unregister(world, id);
    world = again.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_NOT_REGISTERED { panic(101874); };
    if ecs_removed_system_deep_valid(again.1) != false { panic(101875); };
}

@test "missing_component_and_system_missing"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register(world, 1, 0, 0);
    world = p.0;
    let id = p.1;
    world = ecs_sr_world_deep_strip_component(world, id.entity);
    let r = ecs_sr_world_deep_run_system(world, id);
    world = r.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_MISSING_COMPONENT { panic(101880); };
    // re-register fresh for system missing path
    let p2 = ecs_sr_world_deep_register(world, 2, 0, 0);
    world = p2.0;
    let id2 = p2.1;
    world = ecs_sr_world_deep_force_system_missing(world, id2.entity);
    let r2 = ecs_sr_world_deep_run_system(world, id2);
    world = r2.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_SYSTEM_MISSING { panic(101881); };
}

@test "tracked_strong_clone_drop_despawn"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register_tracked(world, 7, 0, 0);
    world = p.0;
    let h = p.1;
    if ecs_system_handle_deep_is_strong(h) != true { panic(101890); };
    if ecs_sr_world_deep_slot_strong_refs(world, h.entity) != 1 { panic(101891); };
    let c = ecs_sr_world_deep_clone_strong(world, h);
    world = c.0;
    let h2 = c.1;
    if ecs_sr_world_deep_slot_strong_refs(world, h.entity) != 2 { panic(101892); };
    world = ecs_sr_world_deep_drop_strong(world, h2);
    if ecs_sr_world_deep_slot_strong_refs(world, h.entity) != 1 { panic(101893); };
    if ecs_sr_world_deep_despawner_len(world) != 0 { panic(101894); };
    world = ecs_sr_world_deep_drop_strong(world, h);
    if ecs_sr_world_deep_slot_strong_refs(world, h.entity) != 0 { panic(101895); };
    if ecs_sr_world_deep_despawner_len(world) != 1 { panic(101896); };
    world = ecs_sr_world_deep_despawn_unused(world);
    if ecs_sr_world_deep_count(world) != 0 { panic(101897); };
    if ecs_sr_world_deep_despawner_len(world) != 0 { panic(101898); };
}

@test "downgrade_weak_does_not_keep_alive"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register_tracked(world, 1, 0, 0);
    world = p.0;
    let h = p.1;
    let weak = ecs_sr_world_deep_downgrade(h);
    if ecs_system_handle_deep_is_weak(weak) != true { panic(101900); };
    world = ecs_sr_world_deep_drop_strong(world, h);
    world = ecs_sr_world_deep_despawn_unused(world);
    if ecs_sr_world_deep_count(world) != 0 { panic(101901); };
}

@test "register_cached_reuses_entity"() {
    let world = ecs_sr_world_deep_new();
    let p1 = ecs_sr_world_deep_register_cached(world, 55, 100, 0, 0);
    world = p1.0;
    let id1 = p1.1;
    if ecs_sr_world_deep_cache_has(world) != true { panic(101910); };
    if ecs_sr_world_deep_cache_entity(world) != id1.entity { panic(101911); };
    let p2 = ecs_sr_world_deep_register_cached(world, 55, 100, 0, 0);
    world = p2.0;
    let id2 = p2.1;
    if id2.entity != id1.entity { panic(101912); };
    if ecs_sr_world_deep_count(world) != 1 { panic(101913); };
}

@test "unregister_cached_and_not_cached"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register_cached(world, 9, 3, 0, 0);
    world = p.0;
    let bad = ecs_sr_world_deep_unregister_cached(world, 8);
    world = bad.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_NOT_CACHED { panic(101920); };
    let ok = ecs_sr_world_deep_unregister_cached(world, 9);
    world = ok.0;
    if ecs_removed_system_deep_valid(ok.1) != true { panic(101921); };
    if ecs_sr_world_deep_cache_has(world) != false { panic(101922); };
    if ecs_sr_world_deep_count(world) != 0 { panic(101923); };
}

@test "run_cached_with_and_local"() {
    let world = ecs_sr_world_deep_new();
    let r1 = ecs_sr_world_deep_run_cached_with(world, 77, 1, 0, 0, 0, 0);
    world = r1.0;
    if r1.1 != 1 { panic(101930); };
    let r2 = ecs_sr_world_deep_run_cached_with(world, 77, 1, 0, 0, 0, 0);
    world = r2.0;
    if r2.1 != 2 { panic(101931); };
    if ecs_sr_world_deep_count(world) != 1 { panic(101932); };
    if ecs_sr_world_deep_flush_count(world) != 2 { panic(101933); };
}

@test "cached_reinserts_component_if_stripped"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register_cached(world, 3, 1, 0, 0);
    world = p.0;
    let id = p.1;
    world = ecs_sr_world_deep_strip_component(world, id.entity);
    let p2 = ecs_sr_world_deep_register_cached(world, 3, 1, 0, 0);
    world = p2.0;
    let id2 = p2.1;
    if id2.entity != id.entity { panic(101940); };
    let r = ecs_sr_world_deep_run_system(world, id2);
    world = r.0;
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_OK { panic(101941); };
    if r.1 != 1 { panic(101942); };
}

@test "two_registers_independent_locals"() {
    let world = ecs_sr_world_deep_new();
    let a = ecs_sr_world_deep_register(world, 1, 0, 0);
    world = a.0;
    let ida = a.1;
    let b = ecs_sr_world_deep_register(world, 1, 0, 0);
    world = b.0;
    let idb = b.1;
    let ra = ecs_sr_world_deep_run_system(world, ida);
    world = ra.0;
    let ra2 = ecs_sr_world_deep_run_system(world, ida);
    world = ra2.0;
    let rb = ecs_sr_world_deep_run_system(world, idb);
    world = rb.0;
    if ra2.1 != 2 { panic(101950); };
    if rb.1 != 1 { panic(101951); };
    if ecs_sr_world_deep_count(world) != 2 { panic(101952); };
}

@test "rse_from_run_system_error_and_system_value"() {
    if ecs_rse_from_run_system_error(true, 0) != ECS_RSE_SKIPPED { panic(101960); };
    if ecs_rse_from_run_system_error(false, 1) != ECS_RSE_FAILED { panic(101961); };
    if ecs_system_value_deep(12) != 12 { panic(101962); };
}

@test "despawner_push_at_clear"() {
    let d = ecs_sr_despawner_deep_new();
    d = ecs_sr_despawner_deep_push(d, 5);
    d = ecs_sr_despawner_deep_push(d, 6);
    if ecs_sr_despawner_deep_len(d) != 2 { panic(101970); };
    if ecs_sr_despawner_deep_at(d, 0) != 5 { panic(101971); };
    if ecs_sr_despawner_deep_at(d, 1) != 6 { panic(101972); };
    d = ecs_sr_despawner_deep_clear(d);
    if ecs_sr_despawner_deep_len(d) != 0 { panic(101973); };
}

@test "unregister_clears_cache_for_entity"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register_cached(world, 1, 9, 0, 0);
    world = p.0;
    let id = p.1;
    let u = ecs_sr_world_deep_unregister(world, id);
    world = u.0;
    if ecs_sr_world_deep_cache_has(world) != false { panic(101980); };
}

@test "lifecycle_register_run_unregister_reregister"() {
    let world = ecs_sr_world_deep_new();
    let p = ecs_sr_world_deep_register(world, 50, 0, 1);
    world = p.0;
    let id = p.1;
    let r = ecs_sr_world_deep_run_system(world, id);
    world = r.0;
    if r.1 != 1 { panic(101990); };
    let u = ecs_sr_world_deep_unregister(world, id);
    world = u.0;
    let p2 = ecs_sr_world_deep_register(world, 50, 0, 1);
    world = p2.0;
    let id2 = p2.1;
    if id2.entity == id.entity { panic(101991); };
    let r2 = ecs_sr_world_deep_run_system(world, id2);
    world = r2.0;
    if r2.1 != 1 { panic(101992); };
    if ecs_sr_world_deep_last_error(world) != ECS_RSE_OK { panic(101993); };
}
