@import "lib/query_filtered_set_deep.sla"

// Batch 262: query_filtered_set deep (src/query/access.rs FilteredAccessSet).
// panic codes: 118400 – 118599.

@test "add_resource_read_write"() {
    let s = ecs_fas_deep_new();
    s = ecs_fas_deep_add_resource_read(s, 1);
    s = ecs_fas_deep_add_resource_write(s, 2);
    if ecs_fas_deep_len(s) != 2 { panic(118400); };
    if ecs_fas_deep_combined_read_len(s) != 2 { panic(118401); };
    if ecs_fas_deep_combined_write_len(s) != 1 { panic(118402); };
}

@test "read_all_write_all"() {
    let s = ecs_fas_deep_new();
    s = ecs_fas_deep_read_all(s);
    if ecs_fas_deep_combined_read_all(s) != true { panic(118410); };
    s = ecs_fas_deep_write_all(s);
    if ecs_fas_deep_combined_write_all(s) != true { panic(118411); };
}

@test "compatible_reads"() {
    let a = ecs_fas_deep_new();
    a = ecs_fas_deep_add_resource_read(a, 1);
    let b = ecs_fas_deep_new();
    b = ecs_fas_deep_add_resource_read(b, 1);
    if ecs_fas_deep_is_compatible(a, b) != true { panic(118420); };
}

@test "incompatible_write_read"() {
    let a = ecs_fas_deep_new();
    a = ecs_fas_deep_add_resource_write(a, 3);
    let b = ecs_fas_deep_new();
    b = ecs_fas_deep_add_resource_read(b, 3);
    if ecs_fas_deep_is_compatible(a, b) != false { panic(118430); };
    let c = ecs_fas_deep_get_conflicts(a, b);
    if ecs_fas_conflict_has(c) != true { panic(118431); };
    if ecs_fas_conflict_id(c) != 3 { panic(118432); };
}

@test "filter_disjoint_rescues_conflict"() {
    let a = ecs_fas_deep_new();
    a = ecs_fas_deep_add_filtered(a, 1, 1, 9, -1); // write 1 with 9
    let b = ecs_fas_deep_new();
    b = ecs_fas_deep_add_filtered(b, 1, -1, -1, 9); // read 1 without 9
    if ecs_fas_deep_is_compatible(a, b) != true { panic(118440); };
}

@test "extend_merges"() {
    let a = ecs_fas_deep_new();
    a = ecs_fas_deep_add_resource_read(a, 1);
    let b = ecs_fas_deep_new();
    b = ecs_fas_deep_add_resource_write(b, 2);
    a = ecs_fas_deep_extend(a, b);
    if ecs_fas_deep_len(a) != 2 { panic(118450); };
    if ecs_fas_deep_combined_write_len(a) != 1 { panic(118451); };
}

@test "clear_resets"() {
    let s = ecs_fas_deep_new();
    s = ecs_fas_deep_add_resource_write(s, 4);
    s = ecs_fas_deep_clear();
    if ecs_fas_deep_len(s) != 0 { panic(118460); };
    if ecs_fas_deep_combined_write_len(s) != 0 { panic(118461); };
}

@test "capacity_four_entries"() {
    let s = ecs_fas_deep_new();
    s = ecs_fas_deep_add_resource_read(s, 1);
    s = ecs_fas_deep_add_resource_read(s, 2);
    s = ecs_fas_deep_add_resource_read(s, 3);
    s = ecs_fas_deep_add_resource_read(s, 4);
    s = ecs_fas_deep_add_resource_read(s, 5);
    if ecs_fas_deep_len(s) != 4 { panic(118470); };
}

@test "write_all_conflicts_any_read"() {
    let a = ecs_fas_deep_new();
    a = ecs_fas_deep_write_all(a);
    let b = ecs_fas_deep_new();
    b = ecs_fas_deep_add_resource_read(b, 1);
    if ecs_fas_deep_is_compatible(a, b) != false { panic(118480); };
}

@test "no_conflict_when_compatible"() {
    let a = ecs_fas_deep_new();
    a = ecs_fas_deep_add_resource_read(a, 1);
    let b = ecs_fas_deep_new();
    b = ecs_fas_deep_add_resource_read(b, 2);
    let c = ecs_fas_deep_get_conflicts(a, b);
    if ecs_fas_conflict_has(c) != false { panic(118490); };
}
