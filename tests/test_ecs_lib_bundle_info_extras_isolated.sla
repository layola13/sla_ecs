    if req[0] != 2 { panic(90587); };
    if req[1] != 3 { panic(90588); };
}

@test "bundle_info_v2_iter_explicit"() {
    let explicit = Vec::new();
    explicit.push(5);
    let required = Vec::new();
    let info = ecs_bundle_info_v2_new(10, explicit, required);
    let iter = ecs_bundle_info_v2_iter_explicit_components(info);
    if iter[0] != 5 { panic(90589); };
    if len(iter) as i32 != 1 { panic(90590); };
}

