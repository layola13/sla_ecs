@test "bundle_info_v2_id"() {
    let explicit = Vec::new();
    let required = Vec::new();
    let info = ecs_bundle_info_v2_new(77, explicit, required);
    if ecs_bundle_info_v2_id(info) != 77 { panic(90598); };
}

@test "bundles_new_empty"() {
    let b = ecs_bundles_new();
    if ecs_bundles_len(b) != 0 { panic(90599); };
    if ecs_bundles_is_empty(b) != true { panic(90600); };
}

@test "bundles_register_then_get"() {
    let b = ecs_bundles_new();
    let explicit = Vec::new();
    explicit.push(1);
    let required = Vec::new();
    let b2 = ecs_bundles_register(b, 100, explicit, required);
    if ecs_bundles_len(b2) != 1 { panic(90601); };
    if ecs_bundles_is_empty(b2) != false { panic(90602); };
    let r = ecs_bundles_get(b2, 100);
    let ok0 = r.0;
    let idx0 = r.1;
    if ok0 != true { panic(90603); };
    if idx0 != 0 { panic(90604); };
}

@test "bundles_get_miss"() {
    let b = ecs_bundles_new();
    let explicit = Vec::new();
    let required = Vec::new();
    let b2 = ecs_bundles_register(b, 100, explicit, required);
    let r = ecs_bundles_get(b2, 999);
    let ok0 = r.0;
    if ok0 != false { panic(90605); };
}

@test "bundles_iter"() {
    let b = ecs_bundles_new();
    let explicit = Vec::new();
    explicit.push(1);
    let required = Vec::new();
    let b2 = ecs_bundles_register(b, 100, explicit, required);
    let explicit2 = Vec::new();
    explicit2.push(9);
    let required2 = Vec::new();
    required2.push(8);
    let b3 = ecs_bundles_register(b2, 200, explicit2, required2);
    let all = ecs_bundles_iter(b3);
    if len(all) as i32 != 2 { panic(90606); };
    let i0 = all[0];
    let i1 = all[1];
    if ecs_bundle_info_v2_id(i0) != 100 { panic(90607); };
    if ecs_bundle_info_v2_id(i1) != 200 { panic(90608); };
}

@test "bundles_register_type_get_id"() {
    let b = ecs_bundles_new();
    let b2 = ecs_bundles_register_type(b, 55, 100);
    let r = ecs_bundles_get_id(b2, 55);
    let ok0 = r.0;
    let bid0 = r.1;
    if ok0 != true { panic(90609); };
    if bid0 != 100 { panic(90610); };
}

@test "bundles_get_id_miss"() {
    let b = ecs_bundles_new();
    let b2 = ecs_bundles_register_type(b, 55, 100);
    let r = ecs_bundles_get_id(b2, 99);
    let ok0 = r.0;
    if ok0 != false { panic(90611); };
}

@test "bundles_get_second_index"() {
    let b = ecs_bundles_new();
    let e0 = Vec::new();
    let r0 = Vec::new();
    let b2 = ecs_bundles_register(b, 1, e0, r0);
    let e1 = Vec::new();
    let r1 = Vec::new();
    let b3 = ecs_bundles_register(b2, 2, e1, r1);
    let res = ecs_bundles_get(b3, 2);
    let ok0 = res.0;
    let idx0 = res.1;
    if ok0 != true { panic(90612); };
    if idx0 != 1 { panic(90613); };
}

@test "bundle_info_v2_no_required_contributed_matches_explicit"() {
    let explicit = Vec::new();
    explicit.push(1);
    explicit.push(2);
    let required = Vec::new();
    let info = ecs_bundle_info_v2_new(10, explicit, required);
    let expl = ecs_bundle_info_v2_explicit_components(info);
    let cont = ecs_bundle_info_v2_contributed_components(info);
    let req = ecs_bundle_info_v2_required_components(info);
    if len(cont) as i32 != 2 { panic(90614); };
    if len(expl) as i32 != 2 { panic(90615); };
    if len(req) as i32 != 0 { panic(90616); };
}

@test "bundle_info_v2_empty_bundle"() {
    let explicit = Vec::new();
    let required = Vec::new();
    let info = ecs_bundle_info_v2_new(1, explicit, required);
    if ecs_bundle_info_v2_explicit_count(info) != 0 { panic(90617); };
    if ecs_bundle_info_v2_explicit_components_len(info) != 0 { panic(90618); };
    let cont = ecs_bundle_info_v2_contributed_components(info);
    if len(cont) as i32 != 0 { panic(90619); };
}

@test "bundles_multiple_types_lookup"() {
    let b = ecs_bundles_new();
    let b2 = ecs_bundles_register_type(b, 11, 100);
    let b3 = ecs_bundles_register_type(b2, 22, 200);
    let r1 = ecs_bundles_get_id(b3, 11);
    let r2 = ecs_bundles_get_id(b3, 22);
    let r3 = ecs_bundles_get_id(b3, 33);
    let bid1 = r1.1;
    let bid2 = r2.1;
    let ok3 = r3.0;
    if bid1 != 100 { panic(90620); };
    if bid2 != 200 { panic(90621); };
    if ok3 != false { panic(90622); };
}
