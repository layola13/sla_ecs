@import "lib/bundle_info_extras.sla"

// Isolated tests for lib/bundle_info_extras.sla — BundleId::index, contributed_components,
// Bundles registry surface.
// Bevy reference: src/bundle/info.rs

@test "bundle_id_v2_index"() {
    let id = ecs_bundle_id_v2_new(42);
    if ecs_bundle_id_v2_index(id) != 42 { panic(90578); };
}

@test "bundle_info_v2_contributed_components"() {
    let explicit = Vec::new();
    explicit.push(1);
    explicit.push(2);
    let required = Vec::new();
    required.push(3);
    let info = ecs_bundle_info_v2_new(10, explicit, required);
    let contributed = ecs_bundle_info_v2_contributed_components(info);
    if len(contributed) as i32 != 3 { panic(90579); };
    if contributed[0] != 1 { panic(90580); };
    if contributed[1] != 2 { panic(90581); };
    if contributed[2] != 3 { panic(90582); };
}

@test "bundle_info_v2_explicit_components"() {
    let explicit = Vec::new();
    explicit.push(1);
    explicit.push(2);
    let required = Vec::new();
    required.push(3);
    let info = ecs_bundle_info_v2_new(10, explicit, required);
    let expl = ecs_bundle_info_v2_explicit_components(info);
    if len(expl) as i32 != 2 { panic(90583); };
    if expl[0] != 1 { panic(90584); };
    if expl[1] != 2 { panic(90585); };
}

@test "bundle_info_v2_required_components"() {
    let explicit = Vec::new();
