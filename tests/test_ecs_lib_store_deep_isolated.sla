@import "lib/store_deep.sla"

// Batch 339: store deep.
// panic codes: 133800 – 133999.

@test "new_empty"() {
    let s = ecs_store_new();
    if ecs_store_count(s) != 0 { panic(133800); };
    if ecs_store_is_empty(s) != true { panic(133801); };
}

@test "insert_get_has_slot"() {
    let s = ecs_store_insert(ecs_store_new(), 1, 10, 20);
    if ecs_store_count(s) != 1 { panic(133810); };
    if ecs_store_has(s, 1) != true { panic(133811); };
    if ecs_store_slot_of(s, 1) != 0 { panic(133812); };
    let g = ecs_store_get(s, 1);
    if ecs_store_get_ok(g) != true { panic(133813); };
    if ecs_store_get_x(g) != 10 { panic(133814); };
    if ecs_store_get_y(g) != 20 { panic(133815); };
}

@test "write_updates_slot"() {
    let s = ecs_store_insert(ecs_store_new(), 1, 1, 2);
    s = ecs_store_write(s, 0, 3, 4);
    let g = ecs_store_get(s, 1);
    if ecs_store_get_x(g) != 3 { panic(133820); };
    if ecs_store_get_y(g) != 4 { panic(133821); };
}

@test "remove_swap"() {
    let s = ecs_store_insert(ecs_store_new(), 1, 10, 0);
    s = ecs_store_insert(s, 2, 20, 0);
    s = ecs_store_insert(s, 3, 30, 0);
    s = ecs_store_remove(s, 2);
    if ecs_store_count(s) != 2 { panic(133830); };
    if ecs_store_has(s, 2) != false { panic(133831); };
    if ecs_store_has(s, 3) != true { panic(133832); };
    let moved = ecs_store_get(s, 3);
    if ecs_store_get_x(moved) != 30 { panic(133833); };
}

@test "insert_overwrite_existing"() {
    let s = ecs_store_insert(ecs_store_new(), 5, 1, 1);
    s = ecs_store_insert(s, 5, 9, 8);
    if ecs_store_count(s) != 1 { panic(133840); };
    let g = ecs_store_get(s, 5);
    if ecs_store_get_x(g) != 9 { panic(133841); };
    if ecs_store_get_y(g) != 8 { panic(133842); };
}

@test "remove_missing_noop"() {
    let s = ecs_store_insert(ecs_store_new(), 1, 1, 1);
    let s2 = ecs_store_remove(s, 99);
    if ecs_store_count(s2) != 1 { panic(133850); };
    if ecs_store_has(s2, 1) != true { panic(133851); };
}

@test "capacity_eight"() {
    let s = ecs_store_new();
    s = ecs_store_insert(s, 1, 1, 0);
    s = ecs_store_insert(s, 2, 2, 0);
    s = ecs_store_insert(s, 3, 3, 0);
    s = ecs_store_insert(s, 4, 4, 0);
    s = ecs_store_insert(s, 5, 5, 0);
    s = ecs_store_insert(s, 6, 6, 0);
    s = ecs_store_insert(s, 7, 7, 0);
    s = ecs_store_insert(s, 8, 8, 0);
    if ecs_store_count(s) != 8 { panic(133860); };
    let full = ecs_store_insert(s, 9, 9, 0);
    if ecs_store_count(full) != 8 { panic(133861); };
    if ecs_store_has(full, 9) != false { panic(133862); };
}

@test "entity_value_at"() {
    let s = ecs_store_insert(ecs_store_insert(ecs_store_new(), 10, 100, 1), 20, 200, 2);
    if ecs_store_entity_at(s, 0) != 10 { panic(133870); };
    if ecs_store_entity_at(s, 1) != 20 { panic(133871); };
    let v0 = ecs_store_value_at(s, 0);
    let v1 = ecs_store_value_at(s, 1);
    if v0.x != 100 { panic(133872); };
    if v1.y != 2 { panic(133873); };
}

@test "clear"() {
    let s = ecs_store_insert(ecs_store_new(), 1, 1, 1);
    s = ecs_store_clear(s);
    if ecs_store_is_empty(s) != true { panic(133880); };
    if ecs_store_has(s, 1) != false { panic(133881); };
}

@test "get_missing"() {
    let s = ecs_store_insert(ecs_store_new(), 1, 1, 1);
    let g = ecs_store_get(s, 2);
    if ecs_store_get_ok(g) != false { panic(133890); };
    if ecs_store_slot_of(s, 2) != -1 { panic(133891); };
}
