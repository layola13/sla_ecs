// Focused TaskPool::Scope executor-identity regressions.
@import "../lib/parallel_runner.sla"

fn scope_executor_external_value(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> i32 {
    return 7;
}

fn scope_executor_empty_child(world_ptr: Arc<*TableErasedWorld<i32, i32>>) -> EcsParallelScopedTaskSet<i32, i32> {
    return ecs_parallel_scoped_task_set_new<i32, i32>();
}

@test "task pool scope external task sharing scope executor ticks scope"() {
    let world = table_erased_world_new<i32, i32>(0, 0);
    let tasks0 = ecs_parallel_scoped_task_set_new<i32, i32>();
    let tasks1 = ecs_parallel_scoped_task_set_spawn_on_external<i32, i32>(tasks0, scope_executor_external_value);
    let pool = ecs_parallel_task_pool_new(1);
    let result = ecs_parallel_task_pool_scope_run_tasks<i32, i32>(pool, world, tasks1);
    if result.mismatch { panic(151000); };
    if result.thread_sum != 7 { panic(151001); };
    if result.external_count != 1 { panic(151002); };
    if result.ticked_scope_executor != true { panic(151003); };
    if result.ticked_external_executor { panic(151004); };
}

@test "task pool recursive external child sharing scope executor ticks scope"() {
    let world = table_erased_world_new<i32, i32>(0, 0);
    let tasks0 = ecs_parallel_scoped_task_set_new<i32, i32>();
    let tasks1 = ecs_parallel_scoped_task_set_spawn_child_scope_on_external<i32, i32>(tasks0, scope_executor_empty_child);
    let pool = ecs_parallel_task_pool_new(1);
    let result = ecs_parallel_task_pool_scope_run_tasks_recursive<i32, i32>(pool, world, tasks1);
    if result.mismatch { panic(151005); };
    if result.child_scope_count != 1 { panic(151006); };
    if result.child_scope_external_count != 1 { panic(151007); };
    if result.ticked_scope_executor != true { panic(151008); };
    if result.ticked_external_executor { panic(151009); };
}
