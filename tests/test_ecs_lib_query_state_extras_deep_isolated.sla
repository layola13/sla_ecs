@import "lib/query_state_extras_deep.sla"

// Batch 305: query_state_extras deep.
// panic codes: 127000 – 127199.

@test "switch_extract"() {
    let s = ecs_qse_switch_new(10, 20);
    if ecs_qse_switch_table(s) != 10 { panic(127000); };
    if ecs_qse_switch_sparse(s) != 20 { panic(127001); };
    if ecs_qse_switch_extract(s, ECS_QSE_TABLE) != 10 { panic(127002); };
    if ecs_qse_switch_extract(s, ECS_QSE_SPARSE) != 20 { panic(127003); };
}

@test "fetch_wrappers"() {
    let r = ecs_qse_read_fetch(5);
    let w = ecs_qse_write_fetch(7);
    let f = ecs_qse_ref_fetch(9);
    if ecs_qse_fetch_kind(r) != 0 { panic(127010); };
    if ecs_qse_fetch_kind(w) != 1 { panic(127011); };
    if ecs_qse_fetch_kind(f) != 2 { panic(127012); };
    if ecs_qse_fetch_is_write(w) != true { panic(127013); };
    if ecs_qse_fetch_is_write(r) != false { panic(127014); };
    let w2 = ecs_qse_fetch_set(w, 42);
    if ecs_qse_fetch_get(w2) != 42 { panic(127015); };
    let r2 = ecs_qse_fetch_set(r, 99);
    if ecs_qse_fetch_get(r2) != 5 { panic(127016); };
}

@test "new_and_add_read"() {
    let s = ecs_qse_deep_new(3);
    if ecs_qse_deep_world(s) != 3 { panic(127020); };
    if ecs_qse_deep_rlen(s) != 0 { panic(127021); };
    s = ecs_qse_deep_add_read(s, 10);
    s = ecs_qse_deep_add_read(s, 11);
    if ecs_qse_deep_rlen(s) != 2 { panic(127022); };
    if ecs_qse_deep_has_access(s, 10) != true { panic(127023); };
    if ecs_qse_deep_has_access(s, 12) != false { panic(127024); };
}

@test "add_write_and_readonly"() {
    let s = ecs_qse_deep_new(1);
    s = ecs_qse_deep_add_write(s, 5);
    if ecs_qse_deep_wlen(s) != 1 { panic(127030); };
    if ecs_qse_deep_rlen(s) != 1 { panic(127031); };
    if ecs_qse_deep_has_write(s, 5) != true { panic(127032); };
    s = ecs_qse_deep_as_readonly(s);
    if ecs_qse_deep_is_readonly(s) != true { panic(127033); };
    if ecs_qse_deep_wlen(s) != 0 { panic(127034); };
    if ecs_qse_deep_has_write(s, 5) != false { panic(127035); };
    if ecs_qse_deep_has_access(s, 5) != true { panic(127036); };
}

@test "tables_and_archetypes"() {
    let s = ecs_qse_deep_new(1);
    s = ecs_qse_deep_add_table(s, 100);
    s = ecs_qse_deep_add_table(s, 101);
    s = ecs_qse_deep_add_archetype(s, 200);
    s = ecs_qse_deep_add_archetype(s, 201);
    if ecs_qse_deep_tlen(s) != 2 { panic(127040); };
    if ecs_qse_deep_alen(s) != 2 { panic(127041); };
    if ecs_qse_deep_table_at(s, 0) != 100 { panic(127042); };
    if ecs_qse_deep_table_at(s, 1) != 101 { panic(127043); };
    if ecs_qse_deep_archetype_at(s, 0) != 200 { panic(127044); };
    if ecs_qse_deep_archetype_at(s, 1) != 201 { panic(127045); };
}

@test "validate_world"() {
    let s = ecs_qse_deep_new(7);
    let v = ecs_qse_deep_validate_world(s, 7);
    if ecs_qse_val_ok(v) != true { panic(127050); };
    if ecs_qse_deep_generation(ecs_qse_val_state(v)) != 0 { panic(127051); };
    let v2 = ecs_qse_deep_validate_world(s, 9);
    if ecs_qse_val_ok(v2) != false { panic(127052); };
    if ecs_qse_deep_generation(ecs_qse_val_state(v2)) != 1 { panic(127053); };
}

@test "matches_set"() {
    let s = ecs_qse_deep_new(1);
    s = ecs_qse_deep_add_read(s, 1);
    s = ecs_qse_deep_add_read(s, 2);
    if ecs_qse_deep_matches_set(s, 2, 9, 0, 0, 2) != true { panic(127060); };
    if ecs_qse_deep_matches_set(s, 9, 8, 0, 0, 2) != false { panic(127061); };
}

@test "transmute_and_join"() {
    let s = ecs_qse_deep_new(1);
    s = ecs_qse_deep_add_read(s, 3);
    s = ecs_qse_deep_transmute(s, 5);
    if ecs_qse_deep_generation(s) != 5 { panic(127070); };
    s = ecs_qse_deep_join(s, 2);
    if ecs_qse_deep_generation(s) != 7 { panic(127071); };
    if ecs_qse_deep_has_access(s, 3) != true { panic(127072); };
}

@test "capacity_four_reads"() {
    let s = ecs_qse_deep_new(1);
    s = ecs_qse_deep_add_read(s, 1);
    s = ecs_qse_deep_add_read(s, 2);
    s = ecs_qse_deep_add_read(s, 3);
    s = ecs_qse_deep_add_read(s, 4);
    if ecs_qse_deep_rlen(s) != 4 { panic(127080); };
    s = ecs_qse_deep_add_read(s, 5);
    if ecs_qse_deep_rlen(s) != 4 { panic(127081); };
    if ecs_qse_deep_has_access(s, 4) != true { panic(127082); };
    if ecs_qse_deep_has_access(s, 5) != false { panic(127083); };
}

@test "world_preserved"() {
    let s = ecs_qse_deep_new(42);
    s = ecs_qse_deep_add_write(s, 1);
    s = ecs_qse_deep_add_table(s, 2);
    s = ecs_qse_deep_as_readonly(s);
    if ecs_qse_deep_world(s) != 42 { panic(127090); };
}
