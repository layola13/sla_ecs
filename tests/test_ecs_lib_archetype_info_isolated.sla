@test "archetype_info_multiple_flags"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_set_on_add_hook(a);
    let a3 = ecs_archetype_info_set_on_despawn_observer(a2);
    if ecs_archetype_info_has_add_hook(a3) != true { panic(90885); };
    if ecs_archetype_info_has_despawn_observer(a3) != true { panic(90886); };
    if ecs_archetype_info_has_insert_hook(a3) != false { panic(90887); };
    if ecs_archetype_info_has_add_observer(a3) != false { panic(90888); };
}

@test "archetype_info_all_flags_combined"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_set_on_add_hook(a);
    let a3 = ecs_archetype_info_set_on_insert_hook(a2);
    let a4 = ecs_archetype_info_set_on_remove_observer(a3);
    if ecs_archetype_info_has_add_hook(a4) != true { panic(90889); };
    if ecs_archetype_info_has_insert_hook(a4) != true { panic(90890); };
    if ecs_archetype_info_has_remove_observer(a4) != true { panic(90891); };
    if ecs_archetype_info_has_despawn_hook(a4) != false { panic(90892); };
}

@test "archetype_info_edges"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_set_edges(a);
    if ecs_archetype_info_edges(a2) != true { panic(90893); };
}

@test "archetype_info_entity_table_row_identity"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    if ecs_archetype_info_entity_table_row(a, 5) != 5 { panic(90894); };
    if ecs_archetype_info_entity_table_row(a, 17) != 17 { panic(90895); };
}

@test "archetype_info_full_workflow"() {
    let a0 = ecs_archetype_info_new(42, 99, 4);
    let a1 = ecs_archetype_info_add_table_component(a0, 10);
    let a2 = ecs_archetype_info_add_sparse_set_component(a1, 20);
    let a3 = ecs_archetype_info_add_entity(a2);
    let a4 = ecs_archetype_info_add_entity(a3);
    let a5 = ecs_archetype_info_set_on_add_hook(a4);
    let a6 = ecs_archetype_info_set_on_remove_hook(a5);
    if ecs_archetype_info_id(a6) != 42 { panic(90896); };
    if ecs_archetype_info_table_id(a6) != 99 { panic(90897); };
    if ecs_archetype_info_generation(a6) != 4 { panic(90898); };
    if ecs_archetype_info_component_count(a6) != 2 { panic(90899); };
    if ecs_archetype_info_table_components_count(a6) != 1 { panic(90900); };
    if ecs_archetype_info_sparse_set_components_count(a6) != 1 { panic(90901); };
    if ecs_archetype_info_len(a6) != 2 { panic(90902); };
    if ecs_archetype_info_contains(a6, 10) != true { panic(90903); };
    if ecs_archetype_info_contains(a6, 20) != true { panic(90904); };
    if ecs_archetype_info_contains(a6, 30) != false { panic(90905); };
    if ecs_archetype_info_has_add_hook(a6) != true { panic(90906); };
    if ecs_archetype_info_has_remove_hook(a6) != true { panic(90907); };
    if ecs_archetype_info_has_insert_hook(a6) != false { panic(90908); };
}
