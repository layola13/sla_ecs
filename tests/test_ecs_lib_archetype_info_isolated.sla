@import "lib/archetype_info.sla"

// Isolated tests for lib/archetype_info.sla — Archetype struct surface + ArchetypeFlags.
// Bevy reference: src/archetype.rs

@test "archetype_info_new_defaults"() {
    let a = ecs_archetype_info_new(5, 9, 0);
    if ecs_archetype_info_id(a) != 5 { panic(90850); };
    if ecs_archetype_info_table_id(a) != 9 { panic(90851); };
    if ecs_archetype_info_generation(a) != 0 { panic(90852); };
    if ecs_archetype_info_flags(a) != 0 { panic(90853); };
    if ecs_archetype_info_component_count(a) != 0 { panic(90854); };
    if ecs_archetype_info_len(a) != 0 { panic(90855); };
    if ecs_archetype_info_is_empty(a) != true { panic(90856); };
    if ecs_archetype_info_edges(a) != false { panic(90857); };
}

@test "archetype_info_add_table_component"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_add_table_component(a, 100);
    if ecs_archetype_info_table_components_count(a2) != 1 { panic(90858); };
    if ecs_archetype_info_sparse_set_components_count(a2) != 0 { panic(90859); };
    if ecs_archetype_info_component_count(a2) != 1 { panic(90860); };
    if ecs_archetype_info_contains(a2, 100) != true { panic(90861); };
    if ecs_archetype_info_contains(a2, 200) != false { panic(90862); };
}

@test "archetype_info_add_sparse_set_component"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_add_sparse_set_component(a, 200);
    if ecs_archetype_info_sparse_set_components_count(a2) != 1 { panic(90863); };
    if ecs_archetype_info_table_components_count(a2) != 0 { panic(90864); };
}

@test "archetype_info_get_storage_type"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_add_table_component(a, 100);
    let a3 = ecs_archetype_info_add_sparse_set_component(a2, 200);
    let r1 = ecs_archetype_info_get_storage_type(a3, 100);
    let r2 = ecs_archetype_info_get_storage_type(a3, 200);
    let r3 = ecs_archetype_info_get_storage_type(a3, 999);
    if r1.0 != true { panic(90865); };
    if r1.1 != 0 { panic(90866); };
    if r2.0 != true { panic(90867); };
    if r2.1 != 1 { panic(90868); };
    if r3.0 != false { panic(90869); };
}

@test "archetype_info_add_remove_entity"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_add_entity(a);
    let a3 = ecs_archetype_info_add_entity(a2);
    if ecs_archetype_info_len(a3) != 2 { panic(90870); };
    if ecs_archetype_info_is_empty(a3) != false { panic(90871); };
    let a4 = ecs_archetype_info_remove_entity(a3);
    if ecs_archetype_info_len(a4) != 1 { panic(90872); };
}

@test "archetype_info_remove_entity_clamped"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_remove_entity(a);
    if ecs_archetype_info_len(a2) != 0 { panic(90873); };
}

@test "archetype_info_has_add_hook"() {
    let a = ecs_archetype_info_new(1, 1, 0);
    let a2 = ecs_archetype_info_set_on_add_hook(a);
    if ecs_archetype_info_has_add_hook(a2) != true { panic(90874); };
    if ecs_archetype_info_has_insert_hook(a2) != false { panic(90875); };
}

