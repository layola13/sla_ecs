@import "lib/entity_map_entities_deep.sla"

// Batch 250: entity_map_entities deep (src/entity/map_entities.rs).
// panic codes: 116000 – 116199.

@test "identity_and_pair_mapper"() {
    if ecs_me_identity_get_mapped(42) != 42 { panic(116000); };
    if ecs_me_pair_get_mapped(1, 99, 1) != 99 { panic(116001); };
    if ecs_me_pair_get_mapped(1, 99, 2) != 2 { panic(116002); };
    if ecs_me_identity_set_mapped() != true { panic(116003); };
}

@test "hash_map_get_set_mapped"() {
    let m = ecs_me_map_deep_new();
    m = ecs_me_hash_set_mapped(m, 10, 100);
    m = ecs_me_hash_set_mapped(m, 11, 110);
    if ecs_me_map_deep_len(m) != 2 { panic(116010); };
    if ecs_me_hash_get_mapped(m, 10) != 100 { panic(116011); };
    if ecs_me_hash_get_mapped(m, 12) != 12 { panic(116012); };
    m = ecs_me_hash_set_mapped(m, 10, 101);
    if ecs_me_hash_get_mapped(m, 10) != 101 { panic(116013); };
}

@test "scene_get_mapped_allocates"() {
    let s = ecs_me_scene_deep_new(1000);
    let r = ecs_me_scene_deep_get_mapped(s, 1);
    s = ecs_me_scene_deep_apply_mapped(s, r);
    if ecs_me_mapped_entity(r) != 1000 { panic(116020); };
    if ecs_me_scene_deep_generations(s) != 1 { panic(116021); };
    r = ecs_me_scene_deep_get_mapped(s, 2);
    s = ecs_me_scene_deep_apply_mapped(s, r);
    if ecs_me_mapped_entity(r) != 1001 { panic(116022); };
    // same source reuses mapping
    r = ecs_me_scene_deep_get_mapped(s, 1);
    if ecs_me_mapped_entity(r) != 1000 { panic(116023); };
    if ecs_me_mapped_generations(r) != 2 { panic(116024); };
}

@test "scene_set_mapped_overrides"() {
    let s = ecs_me_scene_deep_new(50);
    s = ecs_me_scene_deep_set_mapped(s, 7, 77);
    let r = ecs_me_scene_deep_get_mapped(s, 7);
    if ecs_me_mapped_entity(r) != 77 { panic(116030); };
    if ecs_me_mapped_generations(r) != 0 { panic(116031); };
}

@test "map_entities_entity_and_option"() {
    let m = ecs_me_map_deep_new();
    m = ecs_me_hash_set_mapped(m, 5, 55);
    if ecs_me_map_entity_with_hash(m, 5) != 55 { panic(116040); };
    if ecs_me_map_entity_with_hash(m, 6) != 6 { panic(116041); };
    let none = ecs_me_opt_none();
    let mapped_none = ecs_me_map_opt_entity_with_hash(m, none);
    if ecs_me_opt_has(mapped_none) != false { panic(116042); };
    let some = ecs_me_opt_some(5);
    let mapped_some = ecs_me_map_opt_entity_with_hash(m, some);
    if ecs_me_opt_entity(mapped_some) != 55 { panic(116043); };
}

@test "map_entities_list_and_spring"() {
    let m = ecs_me_map_deep_new();
    m = ecs_me_hash_set_mapped(m, 1, 10);
    m = ecs_me_hash_set_mapped(m, 2, 20);
    let l = ecs_me_list_deep_new();
    l = ecs_me_list_deep_push(l, 1);
    l = ecs_me_list_deep_push(l, 2);
    l = ecs_me_list_deep_push(l, 3);
    l = ecs_me_map_list_with_hash(m, l);
    if ecs_me_list_deep_at(l, 0) != 10 { panic(116050); };
    if ecs_me_list_deep_at(l, 1) != 20 { panic(116051); };
    if ecs_me_list_deep_at(l, 2) != 3 { panic(116052); };
    let spring = ecs_me_spring_deep_new(1, 2);
    spring = ecs_me_map_spring_with_hash(m, spring);
    if ecs_me_spring_a(spring) != 10 { panic(116053); };
    if ecs_me_spring_b(spring) != 20 { panic(116054); };
}

@test "map_spring_with_scene_alloc"() {
    let s = ecs_me_scene_deep_new(500);
    let spring = ecs_me_spring_deep_new(1, 2);
    let out = ecs_me_map_spring_with_scene(s, spring);
    s = out.0;
    spring = out.1;
    if ecs_me_spring_a(spring) != 500 { panic(116060); };
    if ecs_me_spring_b(spring) != 501 { panic(116061); };
    if ecs_me_scene_deep_generations(s) != 2 { panic(116062); };
    if ecs_me_scene_deep_finish_reserve(s) != 2 { panic(116063); };
}

@test "world_scope_get_and_reserve"() {
    let s = ecs_me_scene_deep_new(900);
    let w = ecs_me_world_scope_deep_get(s, 3);
    if ecs_me_world_scope_result(w) != 900 { panic(116070); };
    if ecs_me_world_scope_reserve(w) != 1 { panic(116071); };
    s = ecs_me_world_scope_mapper(w);
    let r = ecs_me_scene_deep_get_mapped(s, 3);
    if ecs_me_mapped_entity(r) != 900 { panic(116072); };
}

@test "map_capacity_eight"() {
    let m = ecs_me_map_deep_new();
    m = ecs_me_hash_set_mapped(m, 1, 1);
    m = ecs_me_hash_set_mapped(m, 2, 2);
    m = ecs_me_hash_set_mapped(m, 3, 3);
    m = ecs_me_hash_set_mapped(m, 4, 4);
    m = ecs_me_hash_set_mapped(m, 5, 5);
    m = ecs_me_hash_set_mapped(m, 6, 6);
    m = ecs_me_hash_set_mapped(m, 7, 7);
    m = ecs_me_hash_set_mapped(m, 8, 8);
    m = ecs_me_hash_set_mapped(m, 9, 9);
    if ecs_me_map_deep_len(m) != 8 { panic(116080); };
    if ecs_me_hash_get_mapped(m, 8) != 8 { panic(116081); };
    if ecs_me_hash_get_mapped(m, 9) != 9 { panic(116082); }; // identity missing
}

@test "scene_from_existing_map"() {
    let m = ecs_me_map_deep_new();
    m = ecs_me_hash_set_mapped(m, 4, 44);
    let s = ecs_me_scene_deep_from_map(m, 200);
    if ecs_me_scene_deep_map_len(s) != 1 { panic(116090); };
    let r = ecs_me_scene_deep_get_mapped(s, 4);
    if ecs_me_mapped_entity(r) != 44 { panic(116091); };
    r = ecs_me_scene_deep_get_mapped(s, 5);
    s = ecs_me_scene_deep_apply_mapped(s, r);
    if ecs_me_mapped_entity(r) != 200 { panic(116092); };
    if ecs_me_scene_deep_dead_start(s) != 200 { panic(116093); };
}
