@import "lib/component_register.sla"

// Isolated tests for lib/component_register.sla — ComponentIdRegistrator + queue + descriptor facade.
// Bevy reference: src/component/register.rs

@test "registrator_new"() {
    let r = ecs_registrator_new(5);
    if ecs_registrator_peek(r) != 5 { panic(91073); };
    if ecs_registrator_len(r) != 0 { panic(91074); };
    if ecs_registrator_is_empty(r) != true { panic(91075); };
    if ecs_registrator_any_queued_mut(r) != false { panic(91076); };
}

@test "registrator_peek_mut"() {
    let r = ecs_registrator_new(7);
    if ecs_registrator_peek_mut(r) != 7 { panic(91077); };
}

@test "registrator_next_advances"() {
    let r = ecs_registrator_new(10);
    let res = ecs_registrator_next(r);
    if res.0 != 10 { panic(91078); };
    let r2 = res.1;
    if ecs_registrator_peek(r2) != 11 { panic(91079); };
}

@test "registrator_next_mut_advances"() {
    let r = ecs_registrator_new(20);
    let res = ecs_registrator_next_mut(r);
    if res.0 != 20 { panic(91080); };
    if ecs_registrator_peek(res.1) != 21 { panic(91081); };
}

@test "registrator_multiple_ids_monotonic"() {
    let r = ecs_registrator_new(1);
    let res1 = ecs_registrator_next(r);
    let r2 = res1.1;
    let res2 = ecs_registrator_next(r2);
    let r3 = res2.1;
    let res3 = ecs_registrator_next(r3);
    if res1.0 != 1 { panic(91082); };
    if res2.0 != 2 { panic(91083); };
    if res3.0 != 3 { panic(91084); };
}

@test "registrator_as_queued"() {
    let r = ecs_registrator_new(1);
    let r2 = ecs_registrator_as_queued(r);
    if ecs_registrator_peek(r2) != 1 { panic(91085); };
}

@test "registrator_queue_register_component_increments"() {
    let r = ecs_registrator_new(100);
    let res = ecs_registrator_queue_register_component(r, 1234);
    if res.0 != 100 { panic(91086); };
    let r2 = res.1;
    if ecs_registrator_num_queued_mut(r2) != 1 { panic(91087); };
    if ecs_registrator_any_queued_mut(r2) != true { panic(91088); };
    if ecs_registrator_peek(r2) != 101 { panic(91089); };
}

@test "registrator_queue_register_resource"() {
    let r = ecs_registrator_new(100);
    let res = ecs_registrator_queue_register_resource(r, 5678);
    if res.0 != 100 { panic(91090); };
    if ecs_registrator_num_queued_mut(res.1) != 1 { panic(91091); };
}

@test "registrator_queue_register_non_send"() {
    let r = ecs_registrator_new(100);
    let res = ecs_registrator_queue_register_non_send(r, 9012);
    if res.0 != 100 { panic(91092); };
    if ecs_registrator_num_queued_mut(res.1) != 1 { panic(91093); };
}

@test "registrator_apply_queued_resets"() {
    let r = ecs_registrator_new(100);
    let res = ecs_registrator_queue_register_component(r, 1);
    let r2 = res.1;
    let r3 = ecs_registrator_apply_queued_registrations(r2);
    if ecs_registrator_num_queued_mut(r3) != 0 { panic(91094); };
    if ecs_registrator_is_empty(r3) != true { panic(91095); };
}

@test "registrator_apply_queued_empty_noop"() {
    let r = ecs_registrator_new(100);
    let r2 = ecs_registrator_apply_queued_registrations(r);
    if ecs_registrator_num_queued_mut(r2) != 0 { panic(91096); };
}

@test "descriptor_tiny_new"() {
    let d = ecs_descriptor_tiny_new(1, true);
    if ecs_descriptor_tiny_storage_type(d) != 1 { panic(91097); };
    if ecs_descriptor_tiny_is_resource(d) != true { panic(91098); };
}

@test "register_with_descriptor"() {
    let r = ecs_registrator_new(50);
    let d = ecs_descriptor_tiny_new(0, false);
    let res = ecs_registrator_register_with_descriptor(r, d);
    if res.0 != 50 { panic(91099); };
    if ecs_registrator_peek(res.1) != 51 { panic(91100); };
}

@test "multiple_queue_then_apply"() {
    let r0 = ecs_registrator_new(1);
    let res1 = ecs_registrator_queue_register_component(r0, 11);
    let r1 = res1.1;
    let res2 = ecs_registrator_queue_register_resource(r1, 22);
    let r2 = res2.1;
    let res3 = ecs_registrator_queue_register_non_send(r2, 33);
    let r3 = res3.1;
    if ecs_registrator_num_queued_mut(r3) != 3 { panic(91101); };
    if ecs_registrator_is_empty(r3) != false { panic(91102); };
    let r4 = ecs_registrator_apply_queued_registrations(r3);
    if ecs_registrator_num_queued_mut(r4) != 0 { panic(91103); };
    if ecs_registrator_peek(r4) != 4 { panic(91104); };
}
