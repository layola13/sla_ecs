@import "lib/archetype_edges_deep.sla"

// Batch 345: archetype_edges deep.
// panic codes: 135000 – 135199.

@test "archetype_id_row"() {
    let id = ecs_aid_new(7);
    if ecs_aid_value(id) != 7 { panic(135000); };
    if ecs_aid_eq(ecs_aid_new(7), ecs_aid_new(7)) != true { panic(135001); };
    if ecs_aid_eq(ecs_aid_new(7), ecs_aid_new(8)) != false { panic(135002); };
    let row = ecs_arow_new(3);
    if ecs_arow_value(row) != 3 { panic(135003); };
}

@test "after_bundle_insert_components"() {
    let a = ecs_aabi_new(5);
    a = ecs_aabi_push_added(a, 1);
    a = ecs_aabi_push_added(a, 2);
    a = ecs_aabi_push_existed(a, 3);
    if ecs_aabi_archetype_id(a) != 5 { panic(135010); };
    if ecs_aabi_added_len(a) != 2 { panic(135011); };
    if ecs_aabi_existed_len(a) != 1 { panic(135012); };
    if ecs_aabi_total_len(a) != 3 { panic(135013); };
    if ecs_aabi_added_at(a, 0) != 1 { panic(135014); };
    if ecs_aabi_added_at(a, 1) != 2 { panic(135015); };
}

@test "insert_edge_cache"() {
    let e = ecs_aenew();
    e = ecs_ae_cache_insert(e, 10, 100);
    if ecs_ae_insert_count(e) != 1 { panic(135020); };
    let g = ecs_ae_get_insert(e, 10);
    if ecs_ae_ins_found(g) != true { panic(135021); };
    if ecs_ae_ins_target(g) != 100 { panic(135022); };
    e = ecs_ae_cache_insert(e, 10, 999);
    if ecs_ae_insert_count(e) != 1 { panic(135023); };
    if ecs_ae_ins_target(ecs_ae_get_insert(e, 10)) != 100 { panic(135024); };
}

@test "remove_edge_cache_and_none"() {
    let e = ecs_aenew();
    e = ecs_ae_cache_remove(e, 10, 50);
    let g = ecs_ae_get_remove(e, 10);
    if ecs_ae_rem_found(g) != true { panic(135030); };
    if ecs_ae_rem_has(g) != true { panic(135031); };
    if ecs_ae_rem_target(g) != 50 { panic(135032); };
    e = ecs_ae_cache_remove_none(e, 20);
    let n = ecs_ae_get_remove(e, 20);
    if ecs_ae_rem_has(n) != false { panic(135033); };
    let miss = ecs_ae_get_remove(e, 99);
    if ecs_ae_rem_found(miss) != false { panic(135034); };
}

@test "take_edge_cache_and_none"() {
    let e = ecs_aenew();
    e = ecs_ae_cache_take(e, 5, 60);
    if ecs_ae_take_target(ecs_ae_get_take(e, 5)) != 60 { panic(135040); };
    e = ecs_ae_cache_take_none(e, 6);
    if ecs_ae_take_has(ecs_ae_get_take(e, 6)) != false { panic(135041); };
    if ecs_ae_take_count(e) != 2 { panic(135042); };
}

@test "capacity_four_insert"() {
    let e = ecs_aenew();
    e = ecs_ae_cache_insert(e, 1, 1);
    e = ecs_ae_cache_insert(e, 2, 2);
    e = ecs_ae_cache_insert(e, 3, 3);
    e = ecs_ae_cache_insert(e, 4, 4);
    if ecs_ae_insert_count(e) != 4 { panic(135050); };
    let full = ecs_ae_cache_insert(e, 5, 5);
    if ecs_ae_insert_count(full) != 4 { panic(135051); };
    if ecs_ae_ins_found(ecs_ae_get_insert(full, 5)) != false { panic(135052); };
}

@test "multiple_lookup"() {
    let e = ecs_aenew();
    e = ecs_ae_cache_insert(e, 11, 21);
    e = ecs_ae_cache_insert(e, 12, 22);
    e = ecs_ae_cache_insert(e, 13, 23);
    if ecs_ae_ins_target(ecs_ae_get_insert(e, 12)) != 22 { panic(135060); };
    if ecs_ae_ins_target(ecs_ae_get_insert(e, 13)) != 23 { panic(135061); };
    if ecs_ae_ins_found(ecs_ae_get_insert(e, 99)) != false { panic(135062); };
}

@test "after_insert_capacity_four"() {
    let a = ecs_aabi_new(1);
    a = ecs_aabi_push_added(a, 1);
    a = ecs_aabi_push_added(a, 2);
    a = ecs_aabi_push_added(a, 3);
    a = ecs_aabi_push_added(a, 4);
    a = ecs_aabi_push_added(a, 5);
    if ecs_aabi_added_len(a) != 4 { panic(135070); };
    if ecs_aabi_added_at(a, 3) != 4 { panic(135071); };
}

@test "archetype_entity"() {
    let e = ecs_ae_entity_new(42, 7);
    if ecs_ae_entity_id(e) != 42 { panic(135080); };
    if ecs_ae_entity_table_row(e) != 7 { panic(135081); };
}

@test "component_status_constants"() {
    if ECS_CS_NOT_PRESENT != 0 { panic(135090); };
    if ECS_CS_ADDED != 1 { panic(135091); };
    if ECS_CS_EXISTED != 2 { panic(135092); };
}
