@import "lib/entity_hash_map_derived_extras_deep.sla"

// Batch 336: entity_hash_map_derived_extras deep.
// panic codes: 133200 – 133399.

@test "constructors"() {
    let a = ecs_ehmd_new();
    let b = ecs_ehmd_default();
    let c = ecs_ehmd_with_capacity(5);
    let d = ecs_ehmd_with_capacity(-3);
    if ecs_ehmd_kind(a) != 1 { panic(133200); };
    if ecs_ehmd_kind(b) != 2 { panic(133201); };
    if ecs_ehmd_kind(c) != 3 { panic(133202); };
    if ecs_ehmd_capacity(c) != 5 { panic(133203); };
    if ecs_ehmd_capacity(d) != 0 { panic(133204); };
}

@test "insert_get"() {
    let m = ecs_ehmd_new();
    let r = ecs_ehmd_insert(m, 1, 10);
    if ecs_ehmd_ins_replaced(r) != false { panic(133210); };
    m = ecs_ehmd_ins_map(r);
    let r2 = ecs_ehmd_insert(m, 1, 15);
    if ecs_ehmd_ins_replaced(r2) != true { panic(133211); };
    m = ecs_ehmd_ins_map(r2);
    let g = ecs_ehmd_get(m, 1);
    if ecs_ehmd_get_has(g) != true { panic(133212); };
    if ecs_ehmd_get_value(g) != 15 { panic(133213); };
    if ecs_ehmd_contains(m, 1) != true { panic(133214); };
}

@test "clone_and_from"() {
    let m = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 3, 30));
    let c = ecs_ehmd_clone(m);
    if ecs_ehmd_kind(c) != 4 { panic(133220); };
    let f = ecs_ehmd_from_hash_map(m);
    if ecs_ehmd_kind(f) != 6 { panic(133221); };
    let g = ecs_ehmd_get(f, 3);
    if ecs_ehmd_get_value(g) != 30 { panic(133222); };
    let idx = ecs_ehmd_from_index_map(m);
    if ecs_ehmd_kind(idx) != 6 { panic(133223); };
}

@test "eq"() {
    let a = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 1, 10)), 2, 20));
    let b = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 2, 20)), 1, 10));
    if ecs_ehmd_eq(a, b) != true { panic(133230); };
    let c = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 1, 10));
    if ecs_ehmd_eq(a, c) != false { panic(133231); };
    let d = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 1, 99)), 2, 20));
    if ecs_ehmd_eq(a, d) != false { panic(133232); };
}

@test "from_array4"() {
    let m = ecs_ehmd_from_array4(5, 50, 6, 60, 5, 55, 7, 70);
    if ecs_ehmd_len(m) != 3 { panic(133240); };
    if ecs_ehmd_capacity(m) != 4 { panic(133241); };
    if ecs_ehmd_kind(m) != 5 { panic(133242); };
    let g = ecs_ehmd_get(m, 5);
    if ecs_ehmd_get_value(g) != 55 { panic(133243); };
}

@test "iter_next"() {
    let m = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 4, 40)), 5, 50));
    let it = ecs_ehmd_iter(m);
    if ecs_ehmd_iter_remaining(it) != 2 { panic(133250); };
    if ecs_ehmd_iter_debug(it) != 10 { panic(133251); };
    let n1 = ecs_ehmd_iter_next(it);
    if ecs_ehmd_next_key(n1) != 4 { panic(133252); };
    if ecs_ehmd_next_value(n1) != 40 { panic(133253); };
    let n2 = ecs_ehmd_iter_next(ecs_ehmd_next_iter(n1));
    if ecs_ehmd_next_key(n2) != 5 { panic(133254); };
    if ecs_ehmd_next_value(n2) != 50 { panic(133255); };
}

@test "keys_into_keys"() {
    let m = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 9, 90));
    let keys = ecs_ehmd_keys(m);
    if ecs_ehmd_iter_debug(keys) != 40 { panic(133260); };
    if ecs_ehmd_iter_trusted(keys) != 1 { panic(133261); };
    let into_keys = ecs_ehmd_into_keys(m);
    if ecs_ehmd_iter_debug(into_keys) != 50 { panic(133262); };
    if ecs_ehmd_iter_trusted(into_keys) != 1 { panic(133263); };
    let kn = ecs_ehmd_key_next(keys);
    if ecs_ehmd_next_key(kn) != 9 { panic(133264); };
}

@test "capacity_eight"() {
    let m = ecs_ehmd_new();
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 1, 1));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 2, 2));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 3, 3));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 4, 4));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 5, 5));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 6, 6));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 7, 7));
    m = ecs_ehmd_ins_map(ecs_ehmd_insert(m, 8, 8));
    if ecs_ehmd_len(m) != 8 { panic(133270); };
    let r = ecs_ehmd_insert(m, 9, 9);
    if ecs_ehmd_ins_replaced(r) != false { panic(133271); };
    if ecs_ehmd_len(ecs_ehmd_ins_map(r)) != 8 { panic(133272); };
    let r2 = ecs_ehmd_insert(m, 8, 88);
    if ecs_ehmd_ins_replaced(r2) != true { panic(133273); };
    if ecs_ehmd_get_value(ecs_ehmd_get(ecs_ehmd_ins_map(r2), 8)) != 88 { panic(133274); };
}

@test "at_access_empty"() {
    let m = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 10, 100)), 20, 200));
    if ecs_ehmd_key_at(m, 0) != 10 { panic(133280); };
    if ecs_ehmd_value_at(m, 0) != 100 { panic(133281); };
    if ecs_ehmd_key_at(m, 1) != 20 { panic(133282); };
    if ecs_ehmd_value_at(m, 1) != 200 { panic(133283); };
    let empty = ecs_ehmd_new();
    if ecs_ehmd_is_empty(empty) != true { panic(133284); };
}

@test "iter_end_and_markers"() {
    let m = ecs_ehmd_ins_map(ecs_ehmd_insert(ecs_ehmd_new(), 1, 11));
    let n1 = ecs_ehmd_iter_next(ecs_ehmd_iter(m));
    let n2 = ecs_ehmd_iter_next(ecs_ehmd_next_iter(n1));
    if ecs_ehmd_next_has(n2) != false { panic(133290); };
    let im = ecs_ehmd_iter_mut(m);
    if ecs_ehmd_iter_debug(im) != 11 { panic(133291); };
    let ii = ecs_ehmd_into_iter(m);
    if ecs_ehmd_iter_debug(ii) != 20 { panic(133292); };
    let def = ecs_ehmd_iter_default(40, 1);
    if ecs_ehmd_iter_remaining(def) != 0 { panic(133293); };
    if ecs_ehmd_iter_trusted(def) != 1 { panic(133294); };
}
