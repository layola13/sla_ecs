@import "lib/filtered_entity_deep.sla"

// Batch 266: filtered_entity deep (src/world/entity_access/filtered.rs).
// panic codes: 119200 – 119399.

@test "access_bits_and_all_flags"() {
    let a = ecs_fe_access_deep_new();
    if ecs_fe_access_deep_has_read(a, 3) != false { panic(119200); };
    a = ecs_fe_access_deep_add_read(a, 3);
    if ecs_fe_access_deep_has_read(a, 3) != true { panic(119201); };
    if ecs_fe_access_deep_has_write(a, 3) != false { panic(119202); };
    a = ecs_fe_access_deep_add_write(a, 5);
    if ecs_fe_access_deep_has_write(a, 5) != true { panic(119203); };
    if ecs_fe_access_deep_has_read(a, 5) != true { panic(119204); };
    a = ecs_fe_access_deep_set_read_all(a);
    if ecs_fe_access_deep_has_read(a, 99) != true { panic(119205); };
}

@test "entity_insert_get_contains"() {
    let e = ecs_fe_entity_deep_new(42);
    e = ecs_fe_entity_deep_with_meta(e, 7, 3, 11, 100);
    e = ecs_fe_entity_deep_insert(e, 1, 10, 1);
    e = ecs_fe_entity_deep_insert(e, 2, 20, 2);
    if ecs_fe_entity_deep_len(e) != 2 { panic(119210); };
    if ecs_fe_entity_deep_contains(e, 1) != true { panic(119211); };
    if ecs_fe_entity_deep_contains(e, 9) != false { panic(119212); };
    let g = ecs_fe_entity_deep_get(e, 2);
    if ecs_fe_comp_get_found(g) != true { panic(119213); };
    if ecs_fe_comp_get_value(g) != 20 { panic(119214); };
    if ecs_fe_entity_deep_archetype(e) != 7 { panic(119215); };
}

@test "ref_get_requires_read_access"() {
    let e = ecs_fe_entity_deep_new(1);
    e = ecs_fe_entity_deep_insert(e, 3, 300, 5);
    let a = ecs_fe_access_deep_new();
    let f = ecs_fe_ref_deep_new(e, a);
    // contains ignores access
    if ecs_fe_ref_deep_contains(f, 3) != true { panic(119220); };
    let g0 = ecs_fe_ref_deep_get(f, 3);
    if ecs_fe_comp_get_found(g0) != false { panic(119221); };
    a = ecs_fe_access_deep_add_read(a, 3);
    f = ecs_fe_ref_deep_new(e, a);
    let g1 = ecs_fe_ref_deep_get(f, 3);
    if ecs_fe_comp_get_found(g1) != true { panic(119222); };
    if ecs_fe_comp_get_value(g1) != 300 { panic(119223); };
    if ecs_fe_comp_get_tick(g1) != 5 { panic(119224); };
}

@test "ref_try_into_all_needs_read_all"() {
    let e = ecs_fe_entity_deep_new(2);
    let a = ecs_fe_access_deep_new();
    a = ecs_fe_access_deep_add_read(a, 1);
    let f = ecs_fe_ref_deep_new(e, a);
    let t0 = ecs_fe_ref_deep_try_into_all(f);
    if ecs_fe_try_all_ok(t0) != false { panic(119230); };
    if ecs_fe_try_all_err(t0) != 1 { panic(119231); };
    a = ecs_fe_access_deep_set_read_all(a);
    f = ecs_fe_ref_deep_new(e, a);
    let t1 = ecs_fe_ref_deep_try_into_all(f);
    if ecs_fe_try_all_ok(t1) != true { panic(119232); };
}

@test "mut_get_mut_and_set"() {
    let e = ecs_fe_entity_deep_new(3);
    e = ecs_fe_entity_deep_insert(e, 4, 40, 1);
    let a = ecs_fe_access_deep_new();
    a = ecs_fe_access_deep_add_read(a, 4);
    let f = ecs_fe_mut_deep_new(e, a);
    // write not granted
    let gm0 = ecs_fe_mut_deep_get_mut(f, 4);
    if ecs_fe_comp_get_found(gm0) != false { panic(119240); };
    a = ecs_fe_access_deep_add_write(a, 4);
    f = ecs_fe_mut_deep_new(e, a);
    let gm1 = ecs_fe_mut_deep_get_mut(f, 4);
    if ecs_fe_comp_get_found(gm1) != true { panic(119241); };
    let sr = ecs_fe_mut_deep_set(f, 4, 99, 8);
    if ecs_fe_mut_set_ok(sr) != true { panic(119242); };
    f = ecs_fe_mut_set_view(sr);
    let g = ecs_fe_mut_deep_get(f, 4);
    if ecs_fe_comp_get_value(g) != 99 { panic(119243); };
    if ecs_fe_comp_get_tick(g) != 8 { panic(119244); };
}

@test "mut_try_into_all_needs_read_and_write_all"() {
    let e = ecs_fe_entity_deep_new(4);
    let a = ecs_fe_access_deep_new();
    a = ecs_fe_access_deep_set_read_all(a);
    let f = ecs_fe_mut_deep_new(e, a);
    let t0 = ecs_fe_mut_deep_try_into_all(f);
    if ecs_fe_try_all_ok(t0) != false { panic(119250); };
    if ecs_fe_try_all_err(t0) != 2 { panic(119251); };
    a = ecs_fe_access_deep_set_write_all(a);
    f = ecs_fe_mut_deep_new(e, a);
    let t1 = ecs_fe_mut_deep_try_into_all(f);
    if ecs_fe_try_all_ok(t1) != true { panic(119252); };
}

@test "mut_into_readonly_and_reborrow"() {
    let e = ecs_fe_entity_deep_new(5);
    e = ecs_fe_entity_deep_insert(e, 1, 7, 1);
    let a = ecs_fe_access_deep_new();
    a = ecs_fe_access_deep_add_write(a, 1);
    let f = ecs_fe_mut_deep_new(e, a);
    let r = ecs_fe_mut_deep_into_readonly(f);
    if ecs_fe_ref_deep_id(r) != 5 { panic(119260); };
    let g = ecs_fe_ref_deep_get(r, 1);
    if ecs_fe_comp_get_value(g) != 7 { panic(119261); };
    let f2 = ecs_fe_mut_deep_reborrow(f);
    if ecs_fe_mut_deep_id(f2) != 5 { panic(119262); };
}

@test "unsafe_filtered_roundtrip"() {
    let e = ecs_fe_entity_deep_new(6);
    let a = ecs_fe_access_deep_new();
    a = ecs_fe_access_deep_add_write(a, 2);
    let f = ecs_fe_mut_deep_new(e, a);
    let u = ecs_fe_unsafe_mut_deep_new_readonly(f);
    if ecs_fe_unsafe_mut_deep_id(u) != 6 { panic(119270); };
    let f2 = ecs_fe_unsafe_mut_deep_into_mut(u);
    if ecs_fe_mut_deep_id(f2) != 6 { panic(119271); };
}

@test "eq_and_cmp_by_entity_id"() {
    let e1 = ecs_fe_entity_deep_new(10);
    let e2 = ecs_fe_entity_deep_new(20);
    let a = ecs_fe_access_deep_new();
    let r1 = ecs_fe_ref_deep_new(e1, a);
    let r2 = ecs_fe_ref_deep_new(e2, a);
    if ecs_fe_ref_deep_eq(r1, r2) != false { panic(119280); };
    if ecs_fe_ref_deep_cmp(r1, r2) != -1 { panic(119281); };
    let m1 = ecs_fe_mut_deep_new(e1, a);
    let m2 = ecs_fe_mut_deep_new(e2, a);
    if ecs_fe_mut_deep_eq(m1, m2) != false { panic(119282); };
    if ecs_fe_mut_deep_cmp(m2, m1) != 1 { panic(119283); };
}

@test "meta_and_get_change_ticks"() {
    let e = ecs_fe_entity_deep_new(8);
    e = ecs_fe_entity_deep_with_meta(e, 2, 9, 100, 50);
    e = ecs_fe_entity_deep_insert(e, 0, 1, 77);
    let a = ecs_fe_access_deep_new();
    a = ecs_fe_access_deep_add_read(a, 0);
    let f = ecs_fe_ref_deep_new(e, a);
    if ecs_fe_ref_deep_spawned_by(f) != 100 { panic(119290); };
    if ecs_fe_ref_deep_spawn_tick(f) != 50 { panic(119291); };
    if ecs_fe_ref_deep_location_row(f) != 9 { panic(119292); };
    let t = ecs_fe_ref_deep_get_change_ticks(f, 0);
    if ecs_fe_comp_get_tick(t) != 77 { panic(119293); };
}
