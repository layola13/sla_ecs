@import "lib/entity_index_map_extras.sla"

// Isolated tests for lib/entity_index_map_extras.sla.
// Bevy reference: bevy_ecs/src/entity/index_map.rs

fn make_eim4() -> EcsEntityIndexMapExtras {
    let map = ecs_eim_new();
    let m1 = ecs_eim_insert(map, 10, 1);
    let m2 = ecs_eim_insert(m1, 20, 2);
    let m3 = ecs_eim_insert(m2, 30, 3);
    return ecs_eim_insert(m3, 40, 4);
}

@test "entity index map extras as slice preserves order"() {
    let slice = ecs_eim_as_slice(make_eim4());
    if ecs_eim_slice_len(slice) != 4 { panic(92554); };
    let p = ecs_eim_slice_pair_at(slice, 1);
    if p.key != 20 { panic(92555); };
    if p.value != 2 { panic(92556); };
}

@test "entity index map extras get range"() {
    let r = ecs_eim_get_range(make_eim4(), 1, 3);
    if r.has != 1 { panic(92557); };
    if ecs_eim_slice_len(r.slice) != 2 { panic(92558); };
    let p = ecs_eim_slice_pair_at(r.slice, 0);
    if p.key != 20 { panic(92559); };
}

@test "entity index map extras invalid range none"() {
    let r = ecs_eim_get_range(make_eim4(), 3, 2);
    if r.has != 0 { panic(92560); };
}

@test "entity index map extras get index mut updates value"() {
    let slice = ecs_eim_as_slice(make_eim4());
    let r = ecs_eim_slice_get_index_mut(slice, 2, 99);
    if r.pair.has != 1 { panic(92561); };
    if r.pair.key != 30 { panic(92562); };
    if r.pair.value != 99 { panic(92563); };
    let p = ecs_eim_slice_pair_at(r.slice, 2);
    if p.value != 99 { panic(92564); };
}

@test "entity index map extras first and last"() {
    let slice = ecs_eim_as_slice(make_eim4());
    let first = ecs_eim_slice_first(slice);
    let last = ecs_eim_slice_last(slice);
    if first.key != 10 { panic(92565); };
    if last.key != 40 { panic(92566); };
}

@test "entity index map extras split at"() {
    let split = ecs_eim_slice_split_at(ecs_eim_as_slice(make_eim4()), 2);
    if ecs_eim_slice_len(split.left) != 2 { panic(92567); };
    if ecs_eim_slice_len(split.right) != 2 { panic(92568); };
    let p = ecs_eim_slice_pair_at(split.right, 0);
    if p.key != 30 { panic(92569); };
}

@test "entity index map extras split first"() {
    let r = ecs_eim_slice_split_first(ecs_eim_as_slice(make_eim4()));
    if r.has != 1 { panic(92570); };
    if r.key != 10 { panic(92571); };
    if ecs_eim_slice_len(r.rest) != 3 { panic(92572); };
}

@test "entity index map extras split last"() {
    let r = ecs_eim_slice_split_last(ecs_eim_as_slice(make_eim4()));
    if r.has != 1 { panic(92573); };
    if r.key != 40 { panic(92574); };
    if ecs_eim_slice_len(r.rest) != 3 { panic(92575); };
}

@test "entity index map extras iter next and back"() {
    let iter = ecs_eim_iter(make_eim4());
    let a = ecs_eim_iter_next(iter);
    let b = ecs_eim_iter_next_back(a.iter);
    if a.key != 10 { panic(92576); };
    if b.key != 40 { panic(92577); };
    if ecs_eim_iter_remaining(b.iter) != 2 { panic(92578); };
}

@test "entity index map extras iter as slice remaining"() {
    let iter = ecs_eim_iter(make_eim4());
    let a = ecs_eim_iter_next(iter);
    let slice = ecs_eim_iter_as_slice(a.iter);
    if ecs_eim_slice_len(slice) != 3 { panic(92579); };
    let p = ecs_eim_slice_pair_at(slice, 0);
    if p.key != 20 { panic(92580); };
}

@test "entity index map extras keys double ended"() {
    let keys = ecs_eim_keys(make_eim4());
    let a = ecs_eim_keys_next(keys);
    let b = ecs_eim_keys_next_back(a.iter);
    if a.key != 10 { panic(92581); };
    if b.key != 40 { panic(92582); };
    if ecs_eim_keys_remaining(b.iter) != 2 { panic(92583); };
}

@test "entity index map extras keys index"() {
    let keys = ecs_eim_keys(make_eim4());
    let a = ecs_eim_keys_next(keys);
    if ecs_eim_keys_index(a.iter, 0) != 20 { panic(92584); };
    if ecs_eim_keys_index(a.iter, 2) != 40 { panic(92585); };
}

@test "entity index map extras keys trusted unique"() {
    let keys = ecs_eim_keys(make_eim4());
    if keys.trusted_unique != 1 { panic(92586); };
}

@test "entity index map extras values sum"() {
    let slice = ecs_eim_as_slice(make_eim4());
    if ecs_eim_values_sum(slice) != 10 { panic(92587); };
}

@test "entity index map extras drain middle"() {
    let r = ecs_eim_drain(make_eim4(), 1, 3);
    if ecs_eim_len(r.map) != 2 { panic(92588); };
    let d1 = ecs_eim_iter_next(r.drained);
    let d2 = ecs_eim_iter_next(d1.iter);
    if d1.key != 20 { panic(92589); };
    if d2.key != 30 { panic(92590); };
}

@test "entity index map extras drain clamps range"() {
    let r = ecs_eim_drain(make_eim4(), -3, 99);
    if ecs_eim_len(r.map) != 0 { panic(92591); };
    if ecs_eim_iter_remaining(r.drained) != 4 { panic(92592); };
}

@test "entity index map extras insert replaces without moving"() {
    let map = make_eim4();
    let out = ecs_eim_insert(map, 20, 55);
    let slice = ecs_eim_as_slice(out);
    let p = ecs_eim_slice_pair_at(slice, 1);
    if p.key != 20 { panic(92593); };
    if p.value != 55 { panic(92594); };
    if ecs_eim_slice_len(slice) != 4 { panic(92595); };
}

@test "entity index map extras empty split first none"() {
    let r = ecs_eim_slice_split_first(ecs_eim_slice_new());
    if r.has != 0 { panic(92596); };
}
