// Isolated deep tests for lib/relationship_one_adapter_deep.sla (Batch 355).
// panic codes: 137001 - 137199.

@import "lib/relationship_one_adapter_deep.sla"

@test "OneRel world spawns sequential ids 1..8"() {
    let w0 = ecs_one_rel_world_new(0);
    let r1 = ecs_one_rel_spawn(w0);
    if ecs_one_rel_entity_id(ecs_one_rel_spawn_result_entity(r1)) != 1 { panic(137001); };
    let r2 = ecs_one_rel_spawn(ecs_one_rel_spawn_result_world(r1));
    if ecs_one_rel_entity_id(ecs_one_rel_spawn_result_entity(r2)) != 2 { panic(137002); };
    if ecs_one_rel_count(ecs_one_rel_spawn_result_world(r2)) != 2 { panic(137003); };
}

@test "OneRel is_alive span and despawn removes from alive set"() {
    let w0 = ecs_one_rel_world_new(0);
    let r1 = ecs_one_rel_spawn(w0);
    let e1 = ecs_one_rel_spawn_result_entity(r1);
    let w1 = ecs_one_rel_spawn_result_world(r1);
    if ecs_one_rel_is_alive(w1, e1) != true { panic(137010); };
    let w2 = ecs_one_rel_despawn(w1, e1);
    if ecs_one_rel_is_alive(w2, e1) != false { panic(137011); };
    if ecs_one_rel_count(w2) != 0 { panic(137012); };
}

@test "OneRel set establishes source->target relation"() {
    let w0 = ecs_one_rel_world_new(0);
    let rt = ecs_one_rel_spawn(w0);
    let target = ecs_one_rel_spawn_result_entity(rt);
    let w1 = ecs_one_rel_spawn_result_world(rt);
    let rs = ecs_one_rel_spawn(w1);
    let source = ecs_one_rel_spawn_result_entity(rs);
    let w2 = ecs_one_rel_spawn_result_world(rs);
    let w3 = ecs_one_rel_set(w2, source, target);
    if ecs_one_rel_has_target(w3, source) != true { panic(137020); };
    if ecs_one_rel_has_source(w3, target) != true { panic(137021); };
    if ecs_one_rel_entity_id(ecs_one_rel_target(w3, source)) != ecs_one_rel_entity_id(target) { panic(137022); };
    if ecs_one_rel_entity_id(ecs_one_rel_source(w3, target)) != ecs_one_rel_entity_id(source) { panic(137023); };
}

@test "OneRel exclusive replaces previous source for shared target"() {
    let w0 = ecs_one_rel_world_new(0);
    let rt = ecs_one_rel_spawn(w0);
    let target = ecs_one_rel_spawn_result_entity(rt);
    let w1 = ecs_one_rel_spawn_result_world(rt);
    let r1s = ecs_one_rel_spawn(w1);
    let first = ecs_one_rel_spawn_result_entity(r1s);
    let w2 = ecs_one_rel_spawn_result_world(r1s);
    let r2s = ecs_one_rel_spawn(w2);
    let second = ecs_one_rel_spawn_result_entity(r2s);
    let w3 = ecs_one_rel_spawn_result_world(r2s);
    let w4 = ecs_one_rel_set(w3, first, target);
    if ecs_one_rel_has_target(w4, first) != true { panic(137030); };
    let w5 = ecs_one_rel_set(w4, second, target);
    if ecs_one_rel_has_target(w5, first) != false { panic(137031); };
    if ecs_one_rel_has_target(w5, second) != true { panic(137032); };
    if ecs_one_rel_entity_id(ecs_one_rel_source(w5, target)) != ecs_one_rel_entity_id(second) { panic(137033); };
}

@test "OneRel retarget moves source to a new target"() {
    let w0 = ecs_one_rel_world_new(0);
    let rt1 = ecs_one_rel_spawn(w0);
    let target1 = ecs_one_rel_spawn_result_entity(rt1);
    let w1 = ecs_one_rel_spawn_result_world(rt1);
    let rt2 = ecs_one_rel_spawn(w1);
    let target2 = ecs_one_rel_spawn_result_entity(rt2);
    let w2 = ecs_one_rel_spawn_result_world(rt2);
    let rs = ecs_one_rel_spawn(w2);
    let source = ecs_one_rel_spawn_result_entity(rs);
    let w3 = ecs_one_rel_spawn_result_world(rs);
    let w4 = ecs_one_rel_set(w3, source, target1);
    let w5 = ecs_one_rel_set(w4, source, target2);
    if ecs_one_rel_has_source(w5, target1) != false { panic(137040); };
    if ecs_one_rel_entity_id(ecs_one_rel_target(w5, source)) != ecs_one_rel_entity_id(target2) { panic(137041); };
}

@test "OneRel remove clears source relation"() {
    let w0 = ecs_one_rel_world_new(0);
    let rt = ecs_one_rel_spawn(w0);
    let target = ecs_one_rel_spawn_result_entity(rt);
    let w1 = ecs_one_rel_spawn_result_world(rt);
    let rs = ecs_one_rel_spawn(w1);
    let source = ecs_one_rel_spawn_result_entity(rs);
    let w2 = ecs_one_rel_spawn_result_world(rs);
    let w3 = ecs_one_rel_set(w2, source, target);
    let w4 = ecs_one_rel_remove(w3, source);
    if ecs_one_rel_has_target(w4, source) != false { panic(137050); };
    if ecs_one_rel_has_source(w4, target) != false { panic(137051); };
}

@test "OneRel self-relation rejected when allow_self is false"() {
    let w0 = ecs_one_rel_world_new(0);
    let rs = ecs_one_rel_spawn(w0);
    let s = ecs_one_rel_spawn_result_entity(rs);
    let w1 = ecs_one_rel_spawn_result_world(rs);
    let w2 = ecs_one_rel_set(w1, s, s);
    if ecs_one_rel_has_target(w2, s) != false { panic(137060); };
}

@test "OneRel self-relation accepted when allow_self is true"() {
    let w0 = ecs_one_rel_world_new(1);
    let rs = ecs_one_rel_spawn(w0);
    let s = ecs_one_rel_spawn_result_entity(rs);
    let w1 = ecs_one_rel_spawn_result_world(rs);
    if ecs_one_rel_allow_self(w1) != 1 { panic(137070); };
    let w2 = ecs_one_rel_set(w1, s, s);
    if ecs_one_rel_has_target(w2, s) != true { panic(137071); };
    if ecs_one_rel_entity_id(ecs_one_rel_target(w2, s)) != ecs_one_rel_entity_id(s) { panic(137072); };
}

@test "OneRel despawn of target linked-despawns source"() {
    let w0 = ecs_one_rel_world_new(1);
    let rt = ecs_one_rel_spawn(w0);
    let target = ecs_one_rel_spawn_result_entity(rt);
    let w1 = ecs_one_rel_spawn_result_world(rt);
    let rs = ecs_one_rel_spawn(w1);
    let source = ecs_one_rel_spawn_result_entity(rs);
    let w2 = ecs_one_rel_spawn_result_world(rs);
    let w3 = ecs_one_rel_set(w2, source, target);
    let w4 = ecs_one_rel_despawn(w3, target);
    if ecs_one_rel_is_alive(w4, target) != false { panic(137080); };
    if ecs_one_rel_is_alive(w4, source) != false { panic(137081); };
    if ecs_one_rel_count(w4) != 0 { panic(137082); };
}

@test "OneRel has_target and target on dead or unlinked source returns false"() {
    let w0 = ecs_one_rel_world_new(0);
    let rs = ecs_one_rel_spawn(w0);
    let source = ecs_one_rel_spawn_result_entity(rs);
    let w1 = ecs_one_rel_spawn_result_world(rs);
    if ecs_one_rel_has_target(w1, source) != false { panic(137090); };
    if ecs_one_rel_entity_id(ecs_one_rel_target(w1, source)) != 0 { panic(137091); };
    let dead = ecs_one_rel_entity_new(99);
    if ecs_one_rel_is_alive(w1, dead) != false { panic(137092); };
    if ecs_one_rel_has_target(w1, dead) != false { panic(137093); };
    if ecs_one_rel_has_source(w1, dead) != false { panic(137094); };
}
