@import "lib/entity_hash_set_ops_deep.sla"

// Batch 302: entity_hash_set_ops deep.
// panic codes: 126400 – 126599.

@test "insert_contains_len"() {
    let s = ecs_ehs_deep_new();
    if ecs_ehs_deep_is_empty(s) != true { panic(126400); };
    s = ecs_ehs_deep_insert(s, 1);
    s = ecs_ehs_deep_insert(s, 2);
    s = ecs_ehs_deep_insert(s, 1);
    if ecs_ehs_deep_len(s) != 2 { panic(126401); };
    if ecs_ehs_deep_contains(s, 2) != true { panic(126402); };
    if ecs_ehs_deep_contains(s, 3) != false { panic(126403); };
}

@test "remove_and_clear"() {
    let s = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 1), 2);
    s = ecs_ehs_deep_remove(s, 1);
    if ecs_ehs_deep_contains(s, 1) != false { panic(126410); };
    if ecs_ehs_deep_len(s) != 1 { panic(126411); };
    s = ecs_ehs_deep_clear(s);
    if ecs_ehs_deep_is_empty(s) != true { panic(126412); };
}

@test "union_intersection"() {
    let a = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 1), 2);
    let b = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 2), 3);
    let u = ecs_ehs_deep_union(a, b);
    if ecs_ehs_deep_len(u) != 3 { panic(126420); };
    let i = ecs_ehs_deep_intersection(a, b);
    if ecs_ehs_deep_len(i) != 1 { panic(126421); };
    if ecs_ehs_deep_contains(i, 2) != true { panic(126422); };
}

@test "difference_and_symmetric"() {
    let a = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 1), 2);
    let b = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 2), 3);
    let d = ecs_ehs_deep_difference(a, b);
    if ecs_ehs_deep_len(d) != 1 { panic(126430); };
    if ecs_ehs_deep_contains(d, 1) != true { panic(126431); };
    let s = ecs_ehs_deep_symmetric_difference(a, b);
    if ecs_ehs_deep_len(s) != 2 { panic(126432); };
    if ecs_ehs_deep_contains(s, 1) != true { panic(126433); };
    if ecs_ehs_deep_contains(s, 3) != true { panic(126434); };
}

@test "subset_and_disjoint"() {
    let a = ecs_ehs_deep_insert(ecs_ehs_deep_new(), 1);
    let b = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 1), 2);
    if ecs_ehs_deep_is_subset(a, b) != true { panic(126440); };
    if ecs_ehs_deep_is_subset(b, a) != false { panic(126441); };
    let c = ecs_ehs_deep_insert(ecs_ehs_deep_new(), 9);
    if ecs_ehs_deep_is_disjoint(a, c) != true { panic(126442); };
    if ecs_ehs_deep_is_disjoint(a, b) != false { panic(126443); };
}

@test "drain"() {
    let s = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 4), 5);
    let d = ecs_ehs_deep_drain(s);
    if ecs_ehs_deep_is_empty(ecs_ehs_drain_set(d)) != true { panic(126450); };
    if ecs_ehs_deep_len(ecs_ehs_drain_drained(d)) != 2 { panic(126451); };
}

@test "extract_if_gt"() {
    let s = ecs_ehs_deep_new();
    s = ecs_ehs_deep_insert(s, 1);
    s = ecs_ehs_deep_insert(s, 5);
    s = ecs_ehs_deep_insert(s, 10);
    let e = ecs_ehs_deep_extract_if_gt(s, 4);
    if ecs_ehs_deep_contains(ecs_ehs_extract_extracted(e), 5) != true { panic(126460); };
    if ecs_ehs_deep_contains(ecs_ehs_extract_extracted(e), 10) != true { panic(126461); };
    if ecs_ehs_deep_contains(ecs_ehs_extract_set(e), 1) != true { panic(126462); };
    if ecs_ehs_deep_len(ecs_ehs_extract_set(e)) != 1 { panic(126463); };
}

@test "extend_and_eq"() {
    let a = ecs_ehs_deep_insert(ecs_ehs_deep_new(), 1);
    let b = ecs_ehs_deep_insert(ecs_ehs_deep_new(), 2);
    let e = ecs_ehs_deep_extend(a, b);
    if ecs_ehs_deep_len(e) != 2 { panic(126470); };
    if ecs_ehs_deep_eq(e, ecs_ehs_deep_union(a, b)) != true { panic(126471); };
}

@test "capacity_eight"() {
    let s = ecs_ehs_deep_new();
    s = ecs_ehs_deep_insert(s, 1);
    s = ecs_ehs_deep_insert(s, 2);
    s = ecs_ehs_deep_insert(s, 3);
    s = ecs_ehs_deep_insert(s, 4);
    s = ecs_ehs_deep_insert(s, 5);
    s = ecs_ehs_deep_insert(s, 6);
    s = ecs_ehs_deep_insert(s, 7);
    s = ecs_ehs_deep_insert(s, 8);
    if ecs_ehs_deep_len(s) != 8 { panic(126480); };
    s = ecs_ehs_deep_insert(s, 9);
    if ecs_ehs_deep_len(s) != 8 { panic(126481); };
}

@test "at_access"() {
    let s = ecs_ehs_deep_insert(ecs_ehs_deep_insert(ecs_ehs_deep_new(), 10), 20);
    if ecs_ehs_deep_at(s, 0) != 10 { panic(126490); };
    if ecs_ehs_deep_at(s, 1) != 20 { panic(126491); };
}
