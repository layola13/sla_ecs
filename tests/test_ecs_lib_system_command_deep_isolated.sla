@import "lib/system_command_deep.sla"

// Batch 328: system_command deep.
// panic codes: 131600 – 131799.

@test "spawn_insert_kinds"() {
    let s = ecs_scmd_spawn(9);
    if ecs_scmd_is_spawn(s) != true { panic(131600); };
    if ecs_scmd_value(s) != 9 { panic(131601); };
    let i = ecs_scmd_insert(3, 4, 5);
    if ecs_scmd_is_insert(i) != true { panic(131602); };
    if ecs_scmd_entity(i) != 3 { panic(131603); };
    if ecs_scmd_component_id(i) != 4 { panic(131604); };
}

@test "remove_despawn"() {
    let r = ecs_scmd_remove(2, 7);
    if ecs_scmd_is_remove(r) != true { panic(131610); };
    let d = ecs_scmd_despawn(8);
    if ecs_scmd_is_despawn(d) != true { panic(131611); };
    if ecs_scmd_entity(d) != 8 { panic(131612); };
}

@test "resource_commands"() {
    let a = ecs_scmd_res_insert(1, 10);
    let b = ecs_scmd_res_remove(1);
    if ecs_scmd_is_resource(a) != true { panic(131620); };
    if ecs_scmd_is_resource(b) != true { panic(131621); };
    if ecs_scmd_value(a) != 10 { panic(131622); };
}

@test "custom_and_apply"() {
    let c = ecs_scmd_custom(99);
    if ecs_scmd_kind(c) != ECS_SCMD_CUSTOM { panic(131630); };
    if ecs_scmd_apply(c) != 1 { panic(131631); };
}

@test "queue_push"() {
    let q = ecs_scmdq_new();
    if ecs_scmdq_is_empty(q) != true { panic(131640); };
    q = ecs_scmdq_push(q, ecs_scmd_spawn(1));
    q = ecs_scmdq_push(q, ecs_scmd_despawn(2));
    if ecs_scmdq_len(q) != 2 { panic(131641); };
    if ecs_scmdq_kind_at(q, 0) != ECS_SCMD_SPAWN { panic(131642); };
    if ecs_scmdq_kind_at(q, 1) != ECS_SCMD_DESPAWN { panic(131643); };
}

@test "queue_capacity_four"() {
    let q = ecs_scmdq_new();
    q = ecs_scmdq_push(q, ecs_scmd_spawn(1));
    q = ecs_scmdq_push(q, ecs_scmd_spawn(2));
    q = ecs_scmdq_push(q, ecs_scmd_spawn(3));
    q = ecs_scmdq_push(q, ecs_scmd_spawn(4));
    if ecs_scmdq_len(q) != 4 { panic(131650); };
    q = ecs_scmdq_push(q, ecs_scmd_spawn(5));
    if ecs_scmdq_len(q) != 4 { panic(131651); };
}

@test "apply_all_and_clear"() {
    let q = ecs_scmdq_push(ecs_scmdq_push(ecs_scmdq_new(), ecs_scmd_spawn(1)), ecs_scmd_insert(1, 2, 3));
    if ecs_scmdq_apply_all(q) != 2 { panic(131660); };
    q = ecs_scmdq_clear(q);
    if ecs_scmdq_is_empty(q) != true { panic(131661); };
}

@test "eq_kind"() {
    let a = ecs_scmd_spawn(1);
    let b = ecs_scmd_spawn(2);
    let c = ecs_scmd_despawn(1);
    if ecs_scmd_eq_kind(a, b) != true { panic(131670); };
    if ecs_scmd_eq_kind(a, c) != false { panic(131671); };
}

@test "kind_accessors"() {
    let i = ecs_scmd_insert(5, 6, 7);
    if ecs_scmd_kind(i) != ECS_SCMD_INSERT { panic(131680); };
    if ecs_scmd_value(i) != 7 { panic(131681); };
}

@test "remove_value_zero"() {
    let r = ecs_scmd_remove(1, 2);
    if ecs_scmd_value(r) != 0 { panic(131690); };
}
