@import "lib/spawn_batch_deep.sla"

// Batch 195: SpawnBatchIter deep.

@test "new_reserves_and_allocates"() {
    let s = ecs_sb_deep_new(1, 10, 7, 3, 3, 100);
    if ecs_sb_deep_world_id(s) != 1 { panic(104800); };
    if ecs_sb_deep_change_tick(s) != 10 { panic(104801); };
    if ecs_sb_deep_caller_id(s) != 7 { panic(104802); };
    if ecs_sb_deep_reserved(s) != 3 { panic(104803); };
    if ecs_sb_deep_alloc_len(s) != 3 { panic(104804); };
    if ecs_sb_deep_is_exact_size(s) != true { panic(104805); };
}

@test "unknown_upper_uses_lower"() {
    let s = ecs_sb_deep_new_unknown_upper(1, 0, 0, 4, 1);
    if ecs_sb_deep_reserved(s) != 4 { panic(104810); };
    if ecs_sb_deep_is_exact_size(s) != false { panic(104811); };
}

@test "next_spawns_bulk_entities"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 3, 50, 10);
    let r1 = ecs_sb_deep_next(s);
    s = r1.0;
    if r1.1 != true { panic(104820); };
    if r1.2 != 10 { panic(104821); };
    let r2 = ecs_sb_deep_next(s);
    s = r2.0;
    if r2.2 != 11 { panic(104822); };
    let r3 = ecs_sb_deep_next(s);
    s = r3.0;
    if r3.2 != 12 { panic(104823); };
    let r4 = ecs_sb_deep_next(s);
    if r4.1 != false { panic(104824); };
    if ecs_sb_deep_spawned_len(s) != 3 { panic(104825); };
}

@test "len_and_size_hint_shrink"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 4, 0, 1);
    if ecs_sb_deep_len(s) != 4 { panic(104830); };
    let r = ecs_sb_deep_next(s);
    s = r.0;
    if ecs_sb_deep_len(s) != 3 { panic(104831); };
    if ecs_sb_deep_size_hint_lower(s) != 3 { panic(104832); };
    if ecs_sb_deep_size_hint_upper(s) != 3 { panic(104833); };
}

@test "collect_spawns_all"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 5, 1, 20);
    s = ecs_sb_deep_collect(s);
    if ecs_sb_deep_spawned_len(s) != 5 { panic(104840); };
    if ecs_sb_deep_is_empty(s) != true { panic(104841); };
    if ecs_sb_deep_spawned_at(s, 0) != 20 { panic(104842); };
    if ecs_sb_deep_spawned_at(s, 4) != 24 { panic(104843); };
}

@test "drop_spawns_remaining_and_frees_overalloc"() {
    // hint 5, actual 2 => free 3 after drop if none next'd? drop collects 2, frees 3
    let s = ecs_sb_deep_from_count_with_hint(1, 0, 0, 2, 5, 0, 100);
    if ecs_sb_deep_alloc_len(s) != 5 { panic(104850); };
    if ecs_sb_deep_pending_remaining(s) != 2 { panic(104851); };
    s = ecs_sb_deep_drop(s);
    if ecs_sb_deep_spawned_len(s) != 2 { panic(104852); };
    if ecs_sb_deep_free_count(s) != 3 { panic(104853); };
    if ecs_sb_deep_flush_count(s) != 1 { panic(104854); };
    if ecs_sb_deep_drop_count(s) != 1 { panic(104855); };
    if ecs_sb_deep_last_error(s) != ECS_SB_ERR_DROPPED { panic(104856); };
}

@test "drop_after_partial_next"() {
    let s = ecs_sb_deep_from_count_with_hint(1, 0, 0, 3, 4, 0, 1);
    let r = ecs_sb_deep_next(s);
    s = r.0;
    s = ecs_sb_deep_drop(s);
    if ecs_sb_deep_spawned_len(s) != 3 { panic(104860); };
    // alloc 4, used 3, free 1
    if ecs_sb_deep_free_count(s) != 1 { panic(104861); };
}

@test "entities_are_unique"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 6, 0, 50);
    s = ecs_sb_deep_collect(s);
    if ecs_sb_deep_entities_unique(s) != true { panic(104870); };
}

@test "fused_stays_exhausted"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 1, 0, 1);
    let r = ecs_sb_deep_next(s);
    s = r.0;
    let r2 = ecs_sb_deep_next_after_exhaust(s);
    s = r2.0;
    if r2.1 != false { panic(104880); };
    let r3 = ecs_sb_deep_next_after_exhaust(s);
    if r3.1 != false { panic(104881); };
    if ecs_sb_deep_is_fused(s) != true { panic(104882); };
}

@test "overflow_spawn_when_bulk_exhausted"() {
    // hint 1 but push 3 bundles => first bulk, rest overflow
    let s = ecs_sb_deep_new(1, 0, 0, 1, 1, 10);
    s = ecs_sb_deep_push_bundle(s, 1);
    s = ecs_sb_deep_push_bundle(s, 2);
    s = ecs_sb_deep_push_bundle(s, 3);
    let r1 = ecs_sb_deep_next(s); s = r1.0;
    let r2 = ecs_sb_deep_next(s); s = r2.0;
    let r3 = ecs_sb_deep_next(s); s = r3.0;
    if r1.2 != 10 { panic(104890); };
    if r2.2 != 11 { panic(104891); };
    if r3.2 != 12 { panic(104892); };
    if ecs_sb_deep_spawned_len(s) != 3 { panic(104893); };
}

@test "push_full_error"() {
    let s = ecs_sb_deep_new(1, 0, 0, 0, 0, 1);
    let i: i32 = 0;
    while i < 16 {
        s = ecs_sb_deep_push_bundle(s, i as i64);
        i = i + 1;
    }
    if ecs_sb_deep_last_error(s) != ECS_SB_ERR_OK { panic(104900); };
    s = ecs_sb_deep_push_bundle(s, 99);
    if ecs_sb_deep_last_error(s) != ECS_SB_ERR_FULL { panic(104901); };
}

@test "empty_iter_drop_only_flush"() {
    let s = ecs_sb_deep_new(1, 0, 0, 0, 0, 1);
    s = ecs_sb_deep_drop(s);
    if ecs_sb_deep_spawned_len(s) != 0 { panic(104910); };
    if ecs_sb_deep_free_count(s) != 0 { panic(104911); };
    if ecs_sb_deep_flush_count(s) != 1 { panic(104912); };
}

@test "was_bulk_helper"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 2, 0, 5);
    let r = ecs_sb_deep_next(s); s = r.0;
    if ecs_sb_deep_was_bulk(s, r.2, 5) != true { panic(104920); };
}

@test "size_hint_zero_when_empty"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 1, 0, 1);
    s = ecs_sb_deep_collect(s);
    if ecs_sb_deep_size_hint_lower(s) != 0 { panic(104930); };
    if ecs_sb_deep_is_empty(s) != true { panic(104931); };
}

@test "lifecycle_reserve_next_drop"() {
    let s = ecs_sb_deep_from_count_with_hint(2, 5, 9, 2, 3, 10, 100);
    if ecs_sb_deep_reserved(s) != 3 { panic(104940); };
    let r = ecs_sb_deep_next(s); s = r.0;
    if r.2 != 100 { panic(104941); };
    s = ecs_sb_deep_drop(s);
    if ecs_sb_deep_spawned_len(s) != 2 { panic(104942); };
    if ecs_sb_deep_free_count(s) != 1 { panic(104943); };
    if ecs_sb_deep_caller_id(s) != 9 { panic(104944); };
}

@test "alloc_remaining_tracks_cursor"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 3, 0, 1);
    if ecs_sb_deep_alloc_remaining(s) != 3 { panic(104950); };
    let r = ecs_sb_deep_next(s); s = r.0;
    if ecs_sb_deep_alloc_remaining(s) != 2 { panic(104951); };
}

@test "collect_then_drop_no_double_spawn"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 2, 0, 1);
    s = ecs_sb_deep_collect(s);
    s = ecs_sb_deep_drop(s);
    if ecs_sb_deep_spawned_len(s) != 2 { panic(104960); };
    if ecs_sb_deep_free_count(s) != 0 { panic(104961); };
}

@test "hint_zero_actual_push_overflow_only"() {
    let s = ecs_sb_deep_new(1, 0, 0, 0, 0, 7);
    s = ecs_sb_deep_push_bundle(s, 1);
    s = ecs_sb_deep_push_bundle(s, 2);
    let r1 = ecs_sb_deep_next(s); s = r1.0;
    let r2 = ecs_sb_deep_next(s); s = r2.0;
    if r1.2 != 7 { panic(104970); };
    if r2.2 != 8 { panic(104971); };
}

@test "exact_size_flag_true_with_upper"() {
    let s = ecs_sb_deep_new(1, 0, 0, 2, 5, 1);
    if ecs_sb_deep_is_exact_size(s) != true { panic(104980); };
    if ecs_sb_deep_reserved(s) != 5 { panic(104981); };
}

@test "spawned_sequence_contiguous_from_start"() {
    let s = ecs_sb_deep_from_count(1, 0, 0, 4, 0, 30);
    s = ecs_sb_deep_collect(s);
    if ecs_sb_deep_spawned_at(s, 0) != 30 { panic(104990); };
    if ecs_sb_deep_spawned_at(s, 1) != 31 { panic(104991); };
    if ecs_sb_deep_spawned_at(s, 2) != 32 { panic(104992); };
    if ecs_sb_deep_spawned_at(s, 3) != 33 { panic(104993); };
}
