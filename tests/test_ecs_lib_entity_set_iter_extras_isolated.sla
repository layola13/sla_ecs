@import "lib/entity_set_iter_extras.sla"

// Isolated tests for lib/entity_set_iter_extras.sla.
// Bevy reference: bevy_ecs/src/entity/entity_set.rs

fn make_iter3() -> EcsUniqueEntityIter {
    let items = Vec::new();
    items.push(11);
    items.push(22);
    items.push(33);
    return ecs_unique_entity_iter_from_vec_unchecked(items);
}

@test "entity equivalent direct returns entity"() {
    let v = ecs_contains_entity_direct(42);
    if ecs_entity_equivalent_entity(v) != 42 { panic(92453); };
}

@test "entity equivalent wrappers preserve entity"() {
    let v0 = ecs_contains_entity_direct(77);
    let v1 = ecs_contains_entity_ref(v0);
    let v2 = ecs_contains_entity_mut(v1);
    let v3 = ecs_contains_entity_box(v2);
    let v4 = ecs_contains_entity_rc(v3);
    let v5 = ecs_contains_entity_arc(v4);
    if ecs_entity_equivalent_entity(v5) != 77 { panic(92454); };
    if v5.wrapper_kind != 5 { panic(92455); };
}

@test "entity equivalent equality ignores wrapper kind"() {
    let a = ecs_contains_entity_ref(ecs_contains_entity_direct(5));
    let b = ecs_contains_entity_arc(ecs_contains_entity_direct(5));
    if ecs_entity_equivalent_same(a, b) != true { panic(92456); };
}

@test "entity equivalent comparison follows entity order"() {
    let a = ecs_contains_entity_direct(5);
    let b = ecs_contains_entity_direct(8);
    if ecs_entity_equivalent_cmp(a, b) != -1 { panic(92457); };
    if ecs_entity_equivalent_cmp(b, a) != 1 { panic(92458); };
    if ecs_entity_equivalent_cmp(a, a) != 0 { panic(92459); };
}

@test "unique entity iter empty"() {
    let iter = ecs_unique_entity_iter_empty();
    if ecs_unique_entity_iter_is_empty(iter) != true { panic(92460); };
    if ecs_unique_entity_iter_remaining(iter) != 0 { panic(92461); };
}

@test "unique entity iter next advances front"() {
    let iter = make_iter3();
    let n1 = ecs_unique_entity_iter_next(iter);
    if n1.has != 1 { panic(92462); };
    if n1.entity != 11 { panic(92463); };
    if ecs_unique_entity_iter_remaining(n1.iter) != 2 { panic(92464); };
}

@test "unique entity iter next back advances back"() {
    let iter = make_iter3();
    let n1 = ecs_unique_entity_iter_next_back(iter);
    if n1.has != 1 { panic(92465); };
    if n1.entity != 33 { panic(92466); };
    if ecs_unique_entity_iter_remaining(n1.iter) != 2 { panic(92467); };
}

@test "unique entity iter double ended sequence"() {
    let iter = make_iter3();
    let a = ecs_unique_entity_iter_next(iter);
    let b = ecs_unique_entity_iter_next_back(a.iter);
    let c = ecs_unique_entity_iter_next(b.iter);
    let d = ecs_unique_entity_iter_next(c.iter);
    if a.entity != 11 { panic(92468); };
    if b.entity != 33 { panic(92469); };
    if c.entity != 22 { panic(92470); };
    if d.has != 0 { panic(92471); };
}

@test "unique entity iter into inner returns original payload"() {
    let iter = make_iter3();
    let inner = ecs_unique_entity_iter_into_inner(iter);
    if len(inner) != 3 { panic(92472); };
    if inner[2] != 33 { panic(92473); };
}

@test "entity set collect set preserves remaining order"() {
    let iter = make_iter3();
    let n1 = ecs_unique_entity_iter_next(iter);
    let collected = ecs_entity_set_collect_set(n1.iter);
    if collected.inserted_count != 2 { panic(92474); };
    if collected.first_entity != 22 { panic(92475); };
    if ecs_entity_set_collect_at(collected, 1) != 33 { panic(92476); };
}

@test "entity set collect set marks trusted uniqueness"() {
    let iter = make_iter3();
    let collected = ecs_entity_set_collect_set(iter);
    if collected.trusted_unique != 1 { panic(92477); };
}

@test "from entity set iter hashset preserves unique payload"() {
    let iter = make_iter3();
    let collected = ecs_from_entity_set_iter_hashset(iter);
    if ecs_entity_set_collect_len(collected) != 3 { panic(92478); };
    if ecs_entity_set_collect_contains(collected, 22) != true { panic(92479); };
}

@test "from entity set iter does not dedup arbitrary duplicates"() {
    let items = Vec::new();
    items.push(9);
    items.push(9);
    let iter = ecs_unique_entity_iter_from_entity_set_iter(items);
    let collected = ecs_from_entity_set_iter_hashset(iter);
    if ecs_entity_set_collect_len(collected) != 2 { panic(92480); };
}

@test "entity set collect contains absent false"() {
    let iter = make_iter3();
    let collected = ecs_entity_set_collect_set(iter);
    if ecs_entity_set_collect_contains(collected, 44) != false { panic(92481); };
}

@test "unique entity iter from entity set iter remaining"() {
    let items = Vec::new();
    items.push(1);
    items.push(2);
    let iter = ecs_unique_entity_iter_from_entity_set_iter(items);
    if ecs_unique_entity_iter_remaining(iter) != 2 { panic(92482); };
}

@test "unique entity iter exhausted after next back"() {
    let items = Vec::new();
    items.push(6);
    let iter = ecs_unique_entity_iter_from_vec_unchecked(items);
    let a = ecs_unique_entity_iter_next_back(iter);
    let b = ecs_unique_entity_iter_next_back(a.iter);
    if a.entity != 6 { panic(92483); };
    if b.has != 0 { panic(92484); };
}

