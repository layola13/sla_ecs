@import "lib/system_param_extras_deep.sla"

// Batch 310: system_param_extras deep.
// panic codes: 128000 – 128199.

@test "local_from_world"() {
    let l = ecs_spe_local_from_world(42);
    if ecs_spe_local_get(l) != 42 { panic(128000); };
    if ecs_spe_local_is_initialized(l) != true { panic(128001); };
}

@test "local_uninit_and_set"() {
    let l = ecs_spe_local_uninit();
    if ecs_spe_local_is_initialized(l) != false { panic(128010); };
    l = ecs_spe_local_set(l, 7);
    if ecs_spe_local_get(l) != 7 { panic(128011); };
    if ecs_spe_local_is_initialized(l) != true { panic(128012); };
}

@test "static_param"() {
    let p = ecs_spe_static_new(11);
    if ecs_spe_static_get(p) != 11 { panic(128020); };
    p = ecs_spe_static_set(p, 22);
    if ecs_spe_static_into_inner(p) != 22 { panic(128021); };
}

@test "validation_empty"() {
    let e = ecs_spe_ve_empty();
    if ecs_spe_ve_is_empty(e) != true { panic(128030); };
    if ecs_spe_ve_is_skipped(e) != false { panic(128031); };
}

@test "validation_skipped_invalid"() {
    let s = ecs_spe_ve_skipped(5, 100);
    if ecs_spe_ve_is_skipped(s) != true { panic(128040); };
    if ecs_spe_should_skip(s) != true { panic(128041); };
    if ecs_spe_is_hard_error(s) != false { panic(128042); };
    let i = ecs_spe_ve_invalid(6, 200);
    if ecs_spe_ve_is_skipped(i) != false { panic(128043); };
    if ecs_spe_is_hard_error(i) != true { panic(128044); };
}

@test "validation_new_with_field"() {
    let e = ecs_spe_ve_new(3, false, 9, 4);
    if ecs_spe_ve_param(e) != 3 { panic(128050); };
    if ecs_spe_ve_field(e) != 4 { panic(128051); };
    if ecs_spe_ve_message(e) != 9 { panic(128052); };
}

@test "display"() {
    let e = ecs_spe_ve_new(8, false, 12, 1);
    let d = ecs_spe_ve_display(e);
    if ecs_spe_ve_disp_param(d) != 8 { panic(128060); };
    if ecs_spe_ve_disp_has_field(d) != true { panic(128061); };
    if ecs_spe_ve_disp_message(d) != 12 { panic(128062); };
    let e2 = ecs_spe_ve_invalid(8, 12);
    let d2 = ecs_spe_ve_display(e2);
    if ecs_spe_ve_disp_has_field(d2) != false { panic(128063); };
}

@test "eq"() {
    let a = ecs_spe_ve_new(1, true, 2, 3);
    let b = ecs_spe_ve_new(1, true, 2, 3);
    let c = ecs_spe_ve_new(1, false, 2, 3);
    if ecs_spe_ve_eq(a, b) != true { panic(128070); };
    if ecs_spe_ve_eq(a, c) != false { panic(128071); };
}

@test "apply_local_to_static"() {
    let l = ecs_spe_local_from_world(55);
    let p = ecs_spe_static_new(0);
    p = ecs_spe_apply_local_to_static(l, p);
    if ecs_spe_static_get(p) != 55 { panic(128080); };
    let u = ecs_spe_local_uninit();
    p = ecs_spe_apply_local_to_static(u, p);
    if ecs_spe_static_get(p) != 55 { panic(128081); };
}

@test "hard_error_empty_message"() {
    let e = ecs_spe_ve_new(1, false, 0, 0);
    if ecs_spe_is_hard_error(e) != false { panic(128090); };
    if ecs_spe_ve_is_empty(e) != false { panic(128091); };
}
