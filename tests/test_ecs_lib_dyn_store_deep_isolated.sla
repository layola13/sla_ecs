// Isolated deep tests for lib/dyn_store_deep.sla (Batch 349).
// panic codes: 135802 - 135999.

@import "lib/dyn_store_deep.sla"

@test "DynStore insert then count and is_empty"() {
    let s = ecs_dyn_store_new();
    if ecs_dyn_store_count(s) != 0 { panic(135802); };
    if ecs_dyn_store_is_empty(s) != true { panic(135803); };
    let s1 = ecs_dyn_store_insert(s, 0, 10, 20);
    if ecs_dyn_store_count(s1) != 1 { panic(135804); };
    if ecs_dyn_store_is_empty(s1) != false { panic(135805); };
}

@test "DynStore insert up to cap-8"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 1, 0);
    let s2 = ecs_dyn_store_insert(s1, 1, 1, 0);
    let s3 = ecs_dyn_store_insert(s2, 2, 1, 0);
    let s4 = ecs_dyn_store_insert(s3, 3, 1, 0);
    let s5 = ecs_dyn_store_insert(s4, 4, 1, 0);
    let s6 = ecs_dyn_store_insert(s5, 5, 1, 0);
    let s7 = ecs_dyn_store_insert(s6, 6, 1, 0);
    let s8 = ecs_dyn_store_insert(s7, 7, 1, 0);
    if ecs_dyn_store_count(s8) != 8 { panic(135810); };
    if ecs_dyn_store_has(s8, 7) != true { panic(135811); };
}

@test "DynStore insert overwrites existing value"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 2, 5, 0);
    let s2 = ecs_dyn_store_insert(s1, 2, 99, 100);
    if ecs_dyn_store_count(s2) != 1 { panic(135820); };
    if ecs_dyn_store_get_x(s2, 2) != 99 { panic(135821); };
    if ecs_dyn_store_get_y(s2, 2) != 100 { panic(135822); };
}

@test "DynStore has on absent and out-of-range ids"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 1, 0);
    if ecs_dyn_store_has(s1, 0) != true { panic(135830); };
    if ecs_dyn_store_has(s1, 1) != false { panic(135831); };
    if ecs_dyn_store_has(s1, -1) != false { panic(135832); };
    if ecs_dyn_store_has(s1, 8) != false { panic(135833); };
}

@test "DynStore row_of returns slot or -1"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 1, 0);
    let s2 = ecs_dyn_store_insert(s1, 3, 1, 0);
    if ecs_dyn_store_row_of(s2, 0) != 0 { panic(135840); };
    if ecs_dyn_store_row_of(s2, 3) != 1 { panic(135841); };
    if ecs_dyn_store_row_of(s2, 2) != -1 { panic(135842); };
}

@test "DynStore get_x / get_y for present"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 7, 9);
    if ecs_dyn_store_get_x(s1, 0) != 7 { panic(135850); };
    if ecs_dyn_store_get_y(s1, 0) != 9 { panic(135851); };
}

@test "DynStore write by slot updates value"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 1, 0, 0);
    let s2 = ecs_dyn_store_insert(s1, 4, 0, 0);
    let row = ecs_dyn_store_row_of(s2, 1);
    let s3 = ecs_dyn_store_write(s2, row, 42, 71);
    if ecs_dyn_store_get_x(s3, 1) != 42 { panic(135860); };
    if ecs_dyn_store_get_y(s3, 1) != 71 { panic(135861); };
}

@test "DynStore swap_remove middle row moves last into it"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 50, 0);
    let s2 = ecs_dyn_store_insert(s1, 1, 60, 0);
    let s3 = ecs_dyn_store_insert(s2, 2, 70, 0);
    // Remove id 1; id 2 (last dense row moves into row 1).
    let s4 = ecs_dyn_store_swap_remove(s3, 1);
    if ecs_dyn_store_count(s4) != 2 { panic(135870); };
    if ecs_dyn_store_has(s4, 1) != false { panic(135871); };
    if ecs_dyn_store_has(s4, 2) != true { panic(135872); };
    if ecs_dyn_store_get_x(s4, 2) != 70 { panic(135873); };
    if ecs_dyn_store_has(s4, 0) != true { panic(135874); };
}

@test "DynStore swap_remove absent is no-op"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 1, 0);
    let s2 = ecs_dyn_store_insert(s1, 1, 2, 0);
    let s3 = ecs_dyn_store_swap_remove(s2, 5);
    if ecs_dyn_store_count(s3) != 2 { panic(135880); };
    if ecs_dyn_store_has(s3, 5) != false { panic(135881); };
}

@test "DynStore clear resets to empty"() {
    let s = ecs_dyn_store_new();
    let s1 = ecs_dyn_store_insert(s, 0, 1, 0);
    let s2 = ecs_dyn_store_insert(s1, 1, 1, 0);
    let s3 = ecs_dyn_store_insert(s2, 2, 1, 0);
    let s4 = ecs_dyn_store_clear(s3);
    if ecs_dyn_store_count(s4) != 0 { panic(135890); };
    if ecs_dyn_store_has(s4, 0) != false { panic(135891); };
    if ecs_dyn_store_has(s4, 2) != false { panic(135892); };
    // Reinsertions after clear function normally
    let s5 = ecs_dyn_store_insert(s4, 0, 7, 8);
    if ecs_dyn_store_count(s5) != 1 { panic(135893); };
    if ecs_dyn_store_get_x(s5, 0) != 7 { panic(135894); };
    if ecs_dyn_store_get_y(s5, 0) != 8 { panic(135895); };
}
