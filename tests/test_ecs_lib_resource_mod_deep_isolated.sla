@import "lib/resource_mod_deep.sla"

// Batch 337: resource_mod deep.
// panic codes: 133400 – 133599.

@test "is_resource_new_id"() {
    let m = ecs_isrd_new(42);
    if ecs_isrd_id(m) != 42 { panic(133400); };
}

@test "is_resource_eq"() {
    let a = ecs_isrd_new(7);
    let b = ecs_isrd_new(7);
    let c = ecs_isrd_new(8);
    if ecs_isrd_eq(a, b) != true { panic(133410); };
    if ecs_isrd_eq(a, c) != false { panic(133411); };
}

@test "entities_new_empty"() {
    let r = ecs_red_new();
    if ecs_red_len(r) != 0 { panic(133420); };
    if ecs_red_is_empty(r) != true { panic(133421); };
}

@test "entities_insert_get"() {
    let r = ecs_red_insert(ecs_red_new(), 100, 999);
    if ecs_red_len(r) != 1 { panic(133430); };
    let g = ecs_red_get(r, 100);
    if ecs_red_get_found(g) != true { panic(133431); };
    if ecs_red_get_entity(g) != 999 { panic(133432); };
    let miss = ecs_red_get(r, 1);
    if ecs_red_get_found(miss) != false { panic(133433); };
}

@test "entities_overwrite_contains"() {
    let r = ecs_red_insert(ecs_red_new(), 100, 1);
    r = ecs_red_insert(r, 100, 2);
    if ecs_red_len(r) != 1 { panic(133440); };
    if ecs_red_get_entity(ecs_red_get(r, 100)) != 2 { panic(133441); };
    if ecs_red_contains(r, 100) != true { panic(133442); };
    if ecs_red_contains(r, 200) != false { panic(133443); };
}

@test "entities_iter_at"() {
    let r = ecs_red_insert(ecs_red_insert(ecs_red_new(), 100, 1), 200, 2);
    let i0 = ecs_red_iter_at(r, 0);
    let i1 = ecs_red_iter_at(r, 1);
    let i5 = ecs_red_iter_at(r, 5);
    if ecs_red_iter_found(i0) != true { panic(133450); };
    if ecs_red_iter_cid(i0) != 100 { panic(133451); };
    if ecs_red_iter_entity(i0) != 1 { panic(133452); };
    if ecs_red_iter_found(i1) != true { panic(133453); };
    if ecs_red_iter_cid(i1) != 200 { panic(133454); };
    if ecs_red_iter_found(i5) != false { panic(133455); };
}

@test "entities_remove_clear"() {
    let r = ecs_red_insert(ecs_red_insert(ecs_red_new(), 100, 1), 200, 2);
    let rem = ecs_red_remove(r, 100);
    if ecs_red_rem_removed(rem) != true { panic(133460); };
    r = ecs_red_rem_table(rem);
    if ecs_red_contains(r, 100) != false { panic(133461); };
    if ecs_red_contains(r, 200) != true { panic(133462); };
    if ecs_red_len(r) != 1 { panic(133463); };
    let miss = ecs_red_remove(r, 999);
    if ecs_red_rem_removed(miss) != false { panic(133464); };
    r = ecs_red_clear(r);
    if ecs_red_is_empty(r) != true { panic(133465); };
}

@test "capacity_eight"() {
    let r = ecs_red_new();
    r = ecs_red_insert(r, 1, 10);
    r = ecs_red_insert(r, 2, 20);
    r = ecs_red_insert(r, 3, 30);
    r = ecs_red_insert(r, 4, 40);
    r = ecs_red_insert(r, 5, 50);
    r = ecs_red_insert(r, 6, 60);
    r = ecs_red_insert(r, 7, 70);
    r = ecs_red_insert(r, 8, 80);
    if ecs_red_len(r) != 8 { panic(133470); };
    let full = ecs_red_insert(r, 9, 90);
    if ecs_red_len(full) != 8 { panic(133471); };
    if ecs_red_contains(full, 9) != false { panic(133472); };
    r = ecs_red_insert(r, 8, 88);
    if ecs_red_get_entity(ecs_red_get(r, 8)) != 88 { panic(133473); };
}

@test "resource_flags"() {
    if ecs_red_flag_is_resource(ecs_red_flag_make_resource()) != true { panic(133480); };
    if ecs_red_flag_is_resource(ecs_red_flag_make_non_resource()) != false { panic(133481); };
    if ecs_red_flag_is_resource(3) != true { panic(133482); };
    if ecs_red_flag_is_resource(4) != false { panic(133483); };
}

@test "hooks_apply"() {
    let r = ecs_red_new();
    let h_ins = ecs_red_hook_on_insert(50, 5000);
    if ecs_red_hook_kind(h_ins) != 1 { panic(133490); };
    r = ecs_red_apply_hook(r, h_ins);
    if ecs_red_get_entity(ecs_red_get(r, 50)) != 5000 { panic(133491); };
    let h_disc = ecs_red_hook_on_discard(50, 5000);
    if ecs_red_hook_kind(h_disc) != 2 { panic(133492); };
    r = ecs_red_apply_hook(r, h_disc);
    if ecs_red_contains(r, 50) != false { panic(133493); };
    r = ecs_red_apply_hook(r, ecs_red_hook_on_insert(60, 6000));
    let h_desp = ecs_red_hook_on_despawn(60, 6000);
    if ecs_red_hook_kind(h_desp) != 3 { panic(133494); };
    if ecs_red_hook_applied(h_desp) != true { panic(133495); };
    r = ecs_red_apply_hook(r, h_desp);
    if ecs_red_is_empty(r) != true { panic(133496); };
}
