@import "lib/exclusive_system_param_deep.sla"

// Batch 212: ExclusiveSystemParam deep (src/system/exclusive_system_param.rs).

@test "local_init_from_world"() {
    let w = ecs_esp_world_new();
    w = ecs_esp_world_set_resource(w, 7);
    let r = ecs_esp_local_init(w);
    w = r.0;
    if ecs_esp_local_value(r.1) != 7 { panic(108400); };
    if ecs_esp_world_init_count(w) != 1 { panic(108401); };
}

@test "local_get_and_bump"() {
    let w = ecs_esp_world_new();
    let r = ecs_esp_local_init(w);
    let g = ecs_esp_local_get(r.1);
    if g.0 != true { panic(108410); };
    let s = ecs_esp_local_bump(g.1);
    if ecs_esp_local_value(s) != 1 { panic(108411); };
}

@test "query_state_init_and_run"() {
    let w = ecs_esp_world_new();
    w.query_match_count = 3;
    let r = ecs_esp_query_state_init(w);
    w = r.0;
    let g = ecs_esp_query_state_get(r.1);
    if g.0 != true { panic(108420); };
    w.query_match_count = 5;
    let run = ecs_esp_query_state_run(g.1, w);
    if run.1 != 5 { panic(108421); };
    if ecs_esp_query_state_run_count(run.0) != 1 { panic(108422); };
}

@test "system_state_init_get"() {
    let w = ecs_esp_world_set_resource(ecs_esp_world_new(), 9);
    let r = ecs_esp_system_state_init(w, ECS_ESP_KIND_LOCAL);
    let g = ecs_esp_system_state_get(r.1);
    if g.0 != true { panic(108430); };
    if ecs_esp_system_state_value(g.1) != 9 { panic(108431); };
    if ecs_esp_system_state_get_count(g.1) != 1 { panic(108432); };
}

@test "phantom_always_ok"() {
    let w = ecs_esp_world_new();
    let s = ecs_esp_phantom_init(w);
    let g = ecs_esp_phantom_get(s);
    if g.0 != true { panic(108440); };
}

@test "system_name_from_meta"() {
    let w = ecs_esp_world_new();
    let m = ecs_esp_meta_new(42);
    let s = ecs_esp_system_name_init(w, m);
    let g = ecs_esp_system_name_get(s, m);
    if g.0 != true { panic(108450); };
    if ecs_esp_system_name_id(g.1) != 42 { panic(108451); };
}

@test "unit_tuple"() {
    let w = ecs_esp_world_new();
    let st = ecs_esp_unit_init(w);
    if ecs_esp_unit_get(st) != true { panic(108460); };
}

@test "tuple2_local_query"() {
    let w = ecs_esp_world_set_resource(ecs_esp_world_new(), 2);
    w.query_match_count = 4;
    let r = ecs_esp_tuple2_local_query_init(w);
    w = r.0;
    let g = ecs_esp_tuple2_get(r.1);
    if g.0 != true { panic(108470); };
    if ecs_esp_local_value(ecs_esp_tuple2_local(g.1)) != 2 { panic(108471); };
    if ecs_esp_query_state_match_count(ecs_esp_tuple2_query(g.1)) != 4 { panic(108472); };
    // init called twice (local + query)
    if ecs_esp_world_init_count(w) != 2 { panic(108473); };
}

@test "exclusive_system_two_runs"() {
    let w = ecs_esp_world_new();
    let m = ecs_esp_meta_new(1);
    let init = ecs_esp_system_init(w, m);
    w = init.0;
    let s = init.1;
    // resource and local both 0
    let r1 = ecs_esp_system_run(w, s);
    w = r1.0; s = r1.1;
    if r1.2 != true { panic(108480); };
    if ecs_esp_world_resource(w) != 1 { panic(108481); };
    if ecs_esp_system_local_value(s) != 1 { panic(108482); };
    let r2 = ecs_esp_system_run(w, s);
    w = r2.0; s = r2.1;
    if r2.2 != true { panic(108483); };
    if ecs_esp_world_resource(w) != 2 { panic(108484); };
    if ecs_esp_system_run_count(s) != 2 { panic(108485); };
}

@test "exclusive_system_validation_fail"() {
    let w = ecs_esp_world_new();
    let init = ecs_esp_system_init(w, ecs_esp_meta_new(1));
    w = init.0;
    let s = init.1;
    // desync resource
    w = ecs_esp_world_set_resource(w, 5);
    let r = ecs_esp_system_run(w, s);
    if r.2 != false { panic(108490); };
    if ecs_esp_system_last_error(r.1) != ECS_ESP_ERR_VALIDATION { panic(108491); };
}

@test "kind_constants"() {
    if ecs_esp_kind_query_state() != 0 { panic(108500); };
    if ecs_esp_kind_local() != 2 { panic(108501); };
    if ecs_esp_kind_phantom() != 3 { panic(108502); };
    if ecs_esp_ok() != 0 { panic(108503); };
}

@test "local_set"() {
    let w = ecs_esp_world_new();
    let r = ecs_esp_local_init(w);
    let s = ecs_esp_local_set(r.1, 99);
    if ecs_esp_local_value(s) != 99 { panic(108510); };
}

@test "tuple2_set_local"() {
    let w = ecs_esp_world_new();
    let r = ecs_esp_tuple2_local_query_init(w);
    let t = r.1;
    let loc = ecs_esp_local_set(ecs_esp_tuple2_local(t), 11);
    t = ecs_esp_tuple2_set_local(t, loc);
    if ecs_esp_local_value(ecs_esp_tuple2_local(t)) != 11 { panic(108520); };
}

@test "meta_name"() {
    let m = ecs_esp_meta_new(77);
    if ecs_esp_meta_name(m) != 77 { panic(108530); };
}
