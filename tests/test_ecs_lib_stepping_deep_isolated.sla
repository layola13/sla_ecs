@import "lib/stepping_deep.sla"

// Batch 193 tests for Stepping deep: deferred updates, actions, behaviors, cursor.

@test "new_defaults_disabled"() {
    let s = ecs_st_deep_new();
    if ecs_st_deep_is_enabled(s) != false { panic(104200); };
    if ecs_st_deep_action(s) != ECS_ST_ACTION_RUN_ALL { panic(104201); };
    if ecs_st_deep_schedule_count(s) != 0 { panic(104202); };
    if ecs_st_deep_update_len(s) != 0 { panic(104203); };
}

@test "updates_deferred_until_next_frame"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    if ecs_st_deep_schedule_count(s) != 0 { panic(104210); };
    if ecs_st_deep_is_enabled(s) != false { panic(104211); };
    if ecs_st_deep_update_len(s) != 2 { panic(104212); };
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_schedule_count(s) != 1 { panic(104213); };
    if ecs_st_deep_is_enabled(s) != true { panic(104214); };
    if ecs_st_deep_action(s) != ECS_ST_ACTION_WAITING { panic(104215); };
    if ecs_st_deep_update_len(s) != 0 { panic(104216); };
}

@test "disable_resets_to_run_all"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_disable(s);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_is_enabled(s) != false { panic(104220); };
    if ecs_st_deep_action(s) != ECS_ST_ACTION_RUN_ALL { panic(104221); };
}

@test "skipped_none_when_disabled"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_disable(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_last_skip_valid(s) != false { panic(104230); };
}

@test "skipped_none_for_unknown_schedule"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_last_skip_valid(s) != false { panic(104240); };
}

@test "waiting_runs_only_always"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_always_run_node(s, 0, 0);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_last_skip_valid(s) != true { panic(104250); };
    if ecs_st_deep_will_run(s, 0) != true { panic(104251); };
    if ecs_st_deep_will_run(s, 1) != false { panic(104252); };
}

@test "step_runs_cursor_and_always"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_always_run_node(s, 0, 0);
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    // action is STEP; system0 AlwaysRun, system1 is cursor step target after always?
    // start cursor 0: always runs, continue systems step at first non-always/never
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 0) != true { panic(104260); };
    if ecs_st_deep_will_run(s, 1) != true { panic(104261); };
}

@test "step_never_run_skips_and_advances"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_never_run_node(s, 0, 0);
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 0) != false { panic(104270); };
    if ecs_st_deep_will_run(s, 1) != true { panic(104271); };
}

@test "continue_runs_until_breakpoint"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 3);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_set_breakpoint_node(s, 0, 2);
    s = ecs_st_deep_continue_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 0) != true { panic(104280); };
    if ecs_st_deep_will_run(s, 1) != true { panic(104281); };
    if ecs_st_deep_will_run(s, 2) != false { panic(104282); }; // break stops before
}

@test "step_ignores_breakpoint"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_set_breakpoint_node(s, 0, 1);
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    // first step runs system 0 only
    if ecs_st_deep_will_run(s, 0) != true { panic(104290); };
    if ecs_st_deep_will_run(s, 1) != false { panic(104291); };
    // next step runs system 1 (breakpoint ignored during step)
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 1) != true { panic(104292); };
}

@test "cursor_none_when_disabled"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_next_frame(s);
    let c = ecs_st_deep_cursor(s);
    if c.0 != false { panic(104300); };
}

@test "cursor_tracks_steps"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_next_frame(s);
    let c0 = ecs_st_deep_cursor(s);
    if c0.0 != true { panic(104310); };
    if c0.1 != 0 { panic(104311); };
    if c0.2 != 0 { panic(104312); };
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    let c1 = ecs_st_deep_cursor(s);
    if c1.0 != true { panic(104313); };
    if c1.2 != 1 { panic(104314); };
}

@test "remove_schedule_and_clear_behaviors"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_always_run_node(s, 0, 1);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_behavior_of(s, 0, 1) != ECS_ST_BEH_ALWAYS { panic(104320); };
    s = ecs_st_deep_clear_schedule(s, 0);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_behavior_of(s, 0, 1) != ECS_ST_BEH_CONTINUE { panic(104321); };
    s = ecs_st_deep_remove_schedule(s, 0);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_schedule_count(s) != 0 { panic(104322); };
}

@test "clear_node_resets_behavior"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_set_breakpoint_node(s, 0, 0);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_behavior_of(s, 0, 0) != ECS_ST_BEH_BREAK { panic(104330); };
    s = ecs_st_deep_clear_node(s, 0, 0);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_behavior_of(s, 0, 0) != ECS_ST_BEH_CONTINUE { panic(104331); };
}

@test "multi_schedule_order"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 1);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_schedule_count(s) != 2 { panic(104340); };
    if ecs_st_deep_order_at(s, 0) != 1 { panic(104341); };
    if ecs_st_deep_order_at(s, 1) != 0 { panic(104342); };
}

@test "waiting_never_run_runs_nothing"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_never_run_node(s, 0, 0);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 0) != false { panic(104350); };
    if ecs_st_deep_will_run(s, 1) != false { panic(104351); };
}

@test "disabled_always_run_still_runs_all"() {
    // when disabled, skipped_systems is None => all systems run (executor ignores stepping)
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_always_run_node(s, 0, 0);
    s = ecs_st_deep_disable(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_last_skip_valid(s) != false { panic(104360); };
}

@test "continue_never_run_skips_never"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_never_run_node(s, 0, 0);
    s = ecs_st_deep_continue_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 0) != false { panic(104370); };
    if ecs_st_deep_will_run(s, 1) != true { panic(104371); };
}

@test "step_wraps_cursor_after_schedule"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 1);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    // finished schedule => cursor reset to start
    let c = ecs_st_deep_cursor(s);
    if c.0 != true { panic(104380); };
    if c.2 != 0 { panic(104381); };
}

@test "begin_frame_alias_applies_updates"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_begin_frame(s);
    if ecs_st_deep_is_enabled(s) != true { panic(104390); };
}

@test "duplicate_add_schedule_ignored"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_schedule_count(s) != 1 { panic(104400); };
}

@test "lifecycle_enable_step_disable"() {
    let s = ecs_st_deep_new();
    s = ecs_st_deep_set_system_count(s, 0, 2);
    s = ecs_st_deep_add_schedule(s, 0);
    s = ecs_st_deep_enable(s);
    s = ecs_st_deep_step_frame(s);
    s = ecs_st_deep_next_frame(s);
    s = ecs_st_deep_skipped_systems(s, 0);
    if ecs_st_deep_will_run(s, 0) != true { panic(104410); };
    s = ecs_st_deep_disable(s);
    s = ecs_st_deep_next_frame(s);
    if ecs_st_deep_is_enabled(s) != false { panic(104411); };
}
