@import "lib/archetype_info_deep.sla"

// Batch 346: archetype_info deep.
// panic codes: 135200 – 135399.

@test "new_accessors"() {
    let a = ecs_ainf_new(5, 10, 3);
    if ecs_ainf_id(a) != 5 { panic(135200); };
    if ecs_ainf_table_id(a) != 10 { panic(135201); };
    if ecs_ainf_generation(a) != 3 { panic(135202); };
    if ecs_ainf_flags(a) != 0 { panic(135203); };
    if ecs_ainf_edges(a) != false { panic(135204); };
}

@test "add_table_sparse_components"() {
    let a = ecs_ainf_new(1, 1, 0);
    a = ecs_ainf_add_table_component_full(a, 11);
    a = ecs_ainf_add_sparse_component_full(a, 22);
    if ecs_ainf_component_count(a) != 2 { panic(135210); };
    if ecs_ainf_table_components_count(a) != 1 { panic(135211); };
    if ecs_ainf_sparse_components_count(a) != 1 { panic(135212); };
    if ecs_ainf_component_at(a, 0) != 11 { panic(135213); };
    if ecs_ainf_storage_at(a, 0) != ECS_AIF_STORAGE_TABLE { panic(135214); };
    if ecs_ainf_storage_at(a, 1) != ECS_AIF_STORAGE_SPARSE { panic(135215); };
}

@test "contains_and_storage"() {
    let a = ecs_ainf_new(1, 1, 0);
    a = ecs_ainf_add_table_component_full(a, 11);
    a = ecs_ainf_add_sparse_component_full(a, 22);
    if ecs_ainf_contains(a, 11) != true { panic(135220); };
    if ecs_ainf_contains(a, 99) != false { panic(135221); };
    let s = ecs_ainf_get_storage_type(a, 22);
    if ecs_ainf_storage_found(s) != true { panic(135222); };
    if ecs_ainf_storage_type(s) != ECS_AIF_STORAGE_SPARSE { panic(135223); };
    let miss = ecs_ainf_get_storage_type(a, 5);
    if ecs_ainf_storage_found(miss) != false { panic(135224); };
}

@test "flags_set_has"() {
    let a = ecs_ainf_new(1, 1, 0);
    a = ecs_ainf_set_add_hook(a);
    a = ecs_ainf_set_remove_observer(a);
    if ecs_ainf_has_add_hook(a) != true { panic(135230); };
    if ecs_ainf_has_remove_observer(a) != true { panic(135231); };
    if ecs_ainf_has_insert_hook(a) != false { panic(135232); };
    if ecs_ainf_flags(a) != 257 { panic(135233); };
    a = ecs_ainf_set_despawn_hook(a);
    if ecs_ainf_has_despawn_hook(a) != true { panic(135234); };
}

@test "all_flag_kind_constants"() {
    if ECS_AIF_ON_ADD_HOOK != 1 { panic(135240); };
    if ECS_AIF_ON_INSERT_HOOK != 2 { panic(135241); };
    if ECS_AIF_ON_DESPAWN_OBSERVER != 512 { panic(135242); };
    if ECS_AIF_STORAGE_TABLE != 0 { panic(135243); };
    if ECS_AIF_STORAGE_SPARSE != 1 { panic(135244); };
}

@test "entity_counts"() {
    let a = ecs_ainf_new(1, 1, 0);
    if ecs_ainf_is_empty(a) != true { panic(135250); };
    a = ecs_ainf_add_entity(a);
    a = ecs_ainf_add_entity(a);
    if ecs_ainf_len(a) != 2 { panic(135251); };
    a = ecs_ainf_remove_entity(a);
    if ecs_ainf_len(a) != 1 { panic(135252); };
    a = ecs_ainf_remove_entity(a);
    a = ecs_ainf_remove_entity(a);
    if ecs_ainf_is_empty(a) != true { panic(135253); };
}

@test "set_edges"() {
    let a = ecs_ainf_new(1, 1, 0);
    let s = ecs_ainf_set_edges(a);
    if ecs_ainf_edges(s) != true { panic(135260); };
    if ecs_ainf_edges(a) != false { panic(135261); };
}

@test "capacity_four_components"() {
    let a = ecs_ainf_new(1, 1, 0);
    a = ecs_ainf_add_table_component_full(a, 1);
    a = ecs_ainf_add_table_component_full(a, 2);
    a = ecs_ainf_add_table_component_full(a, 3);
    a = ecs_ainf_add_table_component_full(a, 4);
    if ecs_ainf_component_count(a) != 4 { panic(135270); };
    let full = ecs_ainf_add_table_component_full(a, 5);
    if ecs_ainf_component_count(full) != 4 { panic(135271); };
}

@test "entity_table_row_identity"() {
    let a = ecs_ainf_new(1, 1, 0);
    if ecs_ainf_entity_table_row(a, 7) != 7 { panic(135280); };
}

@test "multiple_hooks_or_observers"() {
    let a = ecs_ainf_new(1, 1, 0);
    a = ecs_ainf_set_add_hook(a);
    a = ecs_ainf_set_add_observer(a);
    a = ecs_ainf_set_insert_observer(a);
    if ecs_ainf_has_add_hook(a) != true { panic(135290); };
    if ecs_ainf_has_add_observer(a) != true { panic(135291); };
    if ecs_ainf_has_insert_observer(a) != true { panic(135292); };
    if ecs_ainf_flags(a) != (1 + 32 + 64) { panic(135293); };
}
