@import "lib/query_par_many_iter_deep.sla"

// Batch 264: query_par_many_iter deep (src/query/par_iter.rs QueryParMany*).
// panic codes: 118800 – 118999.

@test "new_defaults"() {
    let p = ecs_qpmi_deep_new(3);
    if ecs_qpmi_deep_batch_size(p) != 128 { panic(118800); };
    if ecs_qpmi_deep_len(p) != 3 { panic(118801); };
    if ecs_qpmi_deep_is_unique(p) != false { panic(118802); };
    if ecs_qpmi_deep_is_empty(p) != false { panic(118803); };
}

@test "batching_strategy_and_count"() {
    let p = ecs_qpmi_deep_new(10);
    p = ecs_qpmi_deep_batching_strategy(p, 4);
    if ecs_qpmi_deep_batch_size(p) != 4 { panic(118810); };
    if ecs_qpmi_deep_batch_count(p) != 3 { panic(118811); };
}

@test "for_each_multi_visits_all"() {
    let p = ecs_qpmi_deep_new(4);
    p = ecs_qpmi_deep_set_entity(p, 0, 1);
    p = ecs_qpmi_deep_set_entity(p, 1, 1);
    p = ecs_qpmi_deep_set_entity(p, 2, 2);
    p = ecs_qpmi_deep_set_entity(p, 3, 3);
    p = ecs_qpmi_deep_for_each(p, 1);
    if ecs_qpmi_deep_processed(p) != 4 { panic(118820); };
    if ecs_qpmi_deep_sum(p) != 4 { panic(118821); };
}

@test "for_each_unique_dedups"() {
    let p = ecs_qpmi_deep_unique_new(4);
    p = ecs_qpmi_deep_set_entity(p, 0, 1);
    p = ecs_qpmi_deep_set_entity(p, 1, 1);
    p = ecs_qpmi_deep_set_entity(p, 2, 2);
    p = ecs_qpmi_deep_set_entity(p, 3, 2);
    if ecs_qpmi_deep_unique_count(p) != 2 { panic(118830); };
    p = ecs_qpmi_deep_for_each(p, 5);
    if ecs_qpmi_deep_processed(p) != 2 { panic(118831); };
    if ecs_qpmi_deep_sum(p) != 10 { panic(118832); };
}

@test "for_each_init_adds_init"() {
    let p = ecs_qpmi_deep_new(2);
    p = ecs_qpmi_deep_for_each_init(p, 7, 3);
    if ecs_qpmi_deep_init_value(p) != 7 { panic(118840); };
    if ecs_qpmi_deep_processed(p) != 2 { panic(118841); };
    if ecs_qpmi_deep_sum(p) != (2 * 3 + 7) { panic(118842); };
}

@test "empty_batch_count_zero"() {
    let p = ecs_qpmi_deep_new(0);
    if ecs_qpmi_deep_is_empty(p) != true { panic(118850); };
    if ecs_qpmi_deep_batch_count(p) != 0 { panic(118851); };
}

@test "unique_flag"() {
    let p = ecs_qpmi_deep_unique_new(1);
    if ecs_qpmi_deep_is_unique(p) != true { panic(118860); };
}

@test "exact_batches"() {
    let p = ecs_qpmi_deep_new(8);
    p = ecs_qpmi_deep_batching_strategy(p, 4);
    if ecs_qpmi_deep_batch_count(p) != 2 { panic(118870); };
}

@test "set_entity_slots"() {
    let p = ecs_qpmi_deep_new(2);
    p = ecs_qpmi_deep_set_entity(p, 0, 9);
    p = ecs_qpmi_deep_set_entity(p, 1, 8);
    if ecs_qpmi_deep_unique_count(p) != 2 { panic(118880); };
}

@test "unique_all_same"() {
    let p = ecs_qpmi_deep_unique_new(3);
    p = ecs_qpmi_deep_set_entity(p, 0, 4);
    p = ecs_qpmi_deep_set_entity(p, 1, 4);
    p = ecs_qpmi_deep_set_entity(p, 2, 4);
    if ecs_qpmi_deep_unique_count(p) != 1 { panic(118890); };
    p = ecs_qpmi_deep_for_each(p, 2);
    if ecs_qpmi_deep_processed(p) != 1 { panic(118891); };
}
