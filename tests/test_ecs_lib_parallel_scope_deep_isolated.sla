// Isolated deep tests for lib/parallel_scope_deep.sla (Batch 417).
// Covers fixed-cap parallel command queues, per-thread filtering via companion slots,
// clear/is_empty, cap enforcement, and ParallelCommands command_scope aggregation.

@import "lib/parallel_scope_deep.sla"

@test "parallel_queue_new_empty"() {
    let q = ecs_parallel_command_queue_deep_new();
    if ecs_parallel_command_queue_deep_len(q) != 0 { panic(147700); };
    if ecs_parallel_command_queue_deep_is_empty(q) != true { panic(147701); };
}

@test "parallel_queue_command_preserves_insertion_order"() {
    let q = ecs_parallel_command_queue_deep_new();
    q = ecs_parallel_command_queue_deep_command(q, 7, 100);
    q = ecs_parallel_command_queue_deep_command(q, 8, 200);
    if ecs_parallel_command_queue_deep_len(q) != 2 { panic(147702); };
    if ecs_parallel_command_queue_deep_thread_at(q, 0) != 7 { panic(147703); };
    if ecs_parallel_command_queue_deep_command_at(q, 0) != 100 { panic(147704); };
    if ecs_parallel_command_queue_deep_thread_at(q, 1) != 8 { panic(147705); };
    if ecs_parallel_command_queue_deep_command_at(q, 1) != 200 { panic(147706); };
}

@test "parallel_queue_count_for_thread"() {
    let q = ecs_parallel_command_queue_deep_new();
    q = ecs_parallel_command_queue_deep_command(q, 1, 10);
    q = ecs_parallel_command_queue_deep_command(q, 2, 20);
    q = ecs_parallel_command_queue_deep_command(q, 1, 30);
    if ecs_parallel_command_queue_deep_count_for_thread(q, 1) != 2 { panic(147707); };
    if ecs_parallel_command_queue_deep_count_for_thread(q, 2) != 1 { panic(147708); };
    if ecs_parallel_command_queue_deep_count_for_thread(q, 3) != 0 { panic(147709); };
}

@test "parallel_queue_get_commands_for_thread_preserves_order"() {
    let q = ecs_parallel_command_queue_deep_new();
    q = ecs_parallel_command_queue_deep_command(q, 1, 10);
    q = ecs_parallel_command_queue_deep_command(q, 2, 20);
    q = ecs_parallel_command_queue_deep_command(q, 1, 30);
    q = ecs_parallel_command_queue_deep_get_commands_for_thread(q, 1);
    if ecs_parallel_command_queue_deep_last_count(q) != 2 { panic(147710); };
    if ecs_parallel_command_queue_deep_last_at(q, 0) != 10 { panic(147711); };
    if ecs_parallel_command_queue_deep_last_at(q, 1) != 30 { panic(147712); };
}

@test "parallel_queue_get_missing_thread_clears_previous_result"() {
    let q = ecs_parallel_command_queue_deep_new();
    q = ecs_parallel_command_queue_deep_command(q, 1, 10);
    q = ecs_parallel_command_queue_deep_get_commands_for_thread(q, 1);
    if ecs_parallel_command_queue_deep_last_count(q) != 1 { panic(147713); };
    q = ecs_parallel_command_queue_deep_get_commands_for_thread(q, 9);
    if ecs_parallel_command_queue_deep_last_count(q) != 0 { panic(147714); };
}

@test "parallel_queue_clear_resets_count_and_last"() {
    let q = ecs_parallel_command_queue_deep_new();
    q = ecs_parallel_command_queue_deep_command(q, 1, 10);
    q = ecs_parallel_command_queue_deep_get_commands_for_thread(q, 1);
    q = ecs_parallel_command_queue_deep_clear(q);
    if ecs_parallel_command_queue_deep_len(q) != 0 { panic(147715); };
    if ecs_parallel_command_queue_deep_last_count(q) != 0 { panic(147716); };
    if ecs_parallel_command_queue_deep_is_empty(q) != true { panic(147717); };
}

@test "parallel_queue_cap16_enforced"() {
    let q = ecs_parallel_command_queue_deep_new();
    let i: i32 = 0;
    while i < 16 {
        q = ecs_parallel_command_queue_deep_command(q, i as i64, (i as i64) * 10);
        i = i + 1;
    }
    if ecs_parallel_command_queue_deep_len(q) != 16 { panic(147718); };
    q = ecs_parallel_command_queue_deep_command(q, 99, 999);
    if ecs_parallel_command_queue_deep_len(q) != 16 { panic(147719); };
    if ecs_parallel_command_queue_deep_command_at(q, 15) != 150 { panic(147720); };
}

@test "parallel_commands_new_empty"() {
    let c = ecs_parallel_commands_deep_new();
    if ecs_parallel_commands_deep_total_commands(c) != 0 { panic(147721); };
    if ecs_parallel_commands_deep_queue_count(c) != 0 { panic(147722); };
    if ecs_parallel_commands_deep_is_empty(c) != true { panic(147723); };
}

@test "parallel_commands_command_scope_aggregates_threads"() {
    let c = ecs_parallel_commands_deep_new();
    c = ecs_parallel_commands_deep_command_scope(c, 3, 300);
    c = ecs_parallel_commands_deep_command_scope(c, 4, 400);
    c = ecs_parallel_commands_deep_command_scope(c, 3, 301);
    if ecs_parallel_commands_deep_total_commands(c) != 3 { panic(147724); };
    if ecs_parallel_commands_deep_queue_count(c) != 1 { panic(147725); };
    if ecs_parallel_commands_deep_count_for_thread(c, 3) != 2 { panic(147726); };
    if ecs_parallel_commands_deep_count_for_thread(c, 4) != 1 { panic(147727); };
    if ecs_parallel_commands_deep_next_thread_id(c) != 5 { panic(147728); };
}

@test "parallel_commands_get_commands_for_thread"() {
    let c = ecs_parallel_commands_deep_new();
    c = ecs_parallel_commands_deep_command_scope(c, 3, 300);
    c = ecs_parallel_commands_deep_command_scope(c, 4, 400);
    c = ecs_parallel_commands_deep_command_scope(c, 3, 301);
    let q = ecs_parallel_commands_deep_get_commands_for_thread(c, 3);
    if ecs_parallel_command_queue_deep_last_count(q) != 2 { panic(147729); };
    if ecs_parallel_command_queue_deep_last_at(q, 0) != 300 { panic(147730); };
    if ecs_parallel_command_queue_deep_last_at(q, 1) != 301 { panic(147731); };
}

@test "parallel_commands_clear_keeps_next_thread_counter"() {
    let c = ecs_parallel_commands_deep_new();
    c = ecs_parallel_commands_deep_command_scope(c, 2, 20);
    c = ecs_parallel_commands_deep_command_scope(c, 5, 50);
    c = ecs_parallel_commands_deep_clear(c);
    if ecs_parallel_commands_deep_total_commands(c) != 0 { panic(147732); };
    if ecs_parallel_commands_deep_queue_count(c) != 0 { panic(147733); };
    if ecs_parallel_commands_deep_next_thread_id(c) != 6 { panic(147734); };
}
