@import "lib/schedule_error_deep.sla"

// Batch 326: schedule_error deep.
// panic codes: 131200 – 131399.

@test "build_error"() {
    let e = ecs_se_deep_build(9);
    if ecs_se_deep_is_build(e) != true { panic(131200); };
    if ecs_se_deep_message(e) != 9 { panic(131201); };
}

@test "system_error"() {
    let e = ecs_se_deep_system(3, 4);
    if ecs_se_deep_is_system(e) != true { panic(131210); };
    if ecs_se_deep_node(e) != 3 { panic(131211); };
}

@test "loop_error"() {
    let e = ecs_se_deep_loop(7);
    if ecs_se_deep_is_loop(e) != true { panic(131220); };
    if ecs_se_deep_node(e) != 7 { panic(131221); };
}

@test "cycle_error"() {
    let e = ecs_se_deep_cycle(1, 2, 3, 0, 3);
    if ecs_se_deep_is_cycle(e) != true { panic(131230); };
    if ecs_se_deep_clen(e) != 3 { panic(131231); };
    if ecs_se_deep_cycle_at(e, 1) != 2 { panic(131232); };
}

@test "hierarchy_error"() {
    let e = ecs_se_deep_hierarchy(5);
    if ecs_se_deep_is_hierarchy(e) != true { panic(131240); };
}

@test "ambiguity_error"() {
    let e = ecs_se_deep_ambiguity(8, 9);
    if ecs_se_deep_is_ambiguity(e) != true { panic(131250); };
    if ecs_se_deep_cycle_at(e, 0) != 8 { panic(131251); };
    if ecs_se_deep_cycle_at(e, 1) != 9 { panic(131252); };
}

@test "kind_codes"() {
    let e = ecs_se_deep_build(0);
    if ecs_se_deep_kind(e) != ECS_SE_BUILD { panic(131260); };
    let e2 = ecs_se_deep_cycle(1, 2, 0, 0, 2);
    if ecs_se_deep_kind(e2) != ECS_SE_CYCLE { panic(131261); };
}

@test "eq_kind"() {
    let a = ecs_se_deep_system(1, 0);
    let b = ecs_se_deep_system(2, 0);
    let c = ecs_se_deep_build(0);
    if ecs_se_deep_eq_kind(a, b) != true { panic(131270); };
    if ecs_se_deep_eq_kind(a, c) != false { panic(131271); };
}

@test "result_ok_err"() {
    let ok = ecs_se_res_ok();
    if ecs_se_res_is_ok(ok) != true { panic(131280); };
    let err = ecs_se_res_err(ecs_se_deep_loop(2));
    if ecs_se_res_is_ok(err) != false { panic(131281); };
    if ecs_se_res_err_kind(err) != ECS_SE_LOOP { panic(131282); };
}

@test "result_err_val"() {
    let e = ecs_se_deep_ambiguity(1, 2);
    let r = ecs_se_res_err(e);
    if ecs_se_deep_is_ambiguity(ecs_se_res_err_val(r)) != true { panic(131290); };
}
