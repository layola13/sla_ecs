@import "lib/entity_generation_extras_deep.sla"

// Batch 294: entity_generation_extras deep.
// panic codes: 124800 – 124999.

@test "first_and_bits"() {
    let g = ecs_eg_first();
    if ecs_eg_is_first(g) != true { panic(124800); };
    if ecs_eg_to_bits(g) != 0 { panic(124801); };
    g = ecs_eg_from_bits(42);
    if ecs_eg_to_bits(g) != 42 { panic(124802); };
    if ecs_eg_eq(g, ecs_eg_from_bits(42)) != true { panic(124803); };
}

@test "after_versions_wrap"() {
    let g = ecs_eg_from_bits(ecs_eg_mod() - 2);
    g = ecs_eg_after_versions(g, 5);
    if ecs_eg_to_bits(g) != 3 { panic(124810); };
    g = ecs_eg_from_bits(10);
    g = ecs_eg_after_versions(g, 7);
    if ecs_eg_to_bits(g) != 17 { panic(124811); };
}

@test "could_alias_overflow"() {
    let g = ecs_eg_from_bits(ecs_eg_mod() - 1);
    let r = ecs_eg_after_versions_and_could_alias(g, 1);
    if ecs_eg_alias_could(r) != true { panic(124820); };
    if ecs_eg_alias_bits(r) != 0 { panic(124821); };
    let r2 = ecs_eg_after_versions_and_could_alias(ecs_eg_from_bits(5), 3);
    if ecs_eg_alias_could(r2) != false { panic(124822); };
    if ecs_eg_alias_bits(r2) != 8 { panic(124823); };
    if ecs_eg_could_alias_after(g, 1) != true { panic(124824); };
}

@test "cmp_approx"() {
    let a = ecs_eg_from_bits(10);
    let b = ecs_eg_from_bits(10);
    if ecs_eg_cmp_approx(a, b) != ecs_eg_ord_equal() { panic(124830); };
    if ecs_eg_cmp_approx(ecs_eg_from_bits(11), a) != ecs_eg_ord_greater() { panic(124831); };
    if ecs_eg_cmp_approx(a, ecs_eg_from_bits(11)) != ecs_eg_ord_less() { panic(124832); };
    // large wrap distance treated as less
    let far = ecs_eg_from_bits(ecs_eg_half() + 10);
    if ecs_eg_cmp_approx(far, a) != ecs_eg_ord_less() { panic(124833); };
}

@test "next_and_versions_between"() {
    let g = ecs_eg_from_bits(5);
    let n = ecs_eg_next(g);
    if ecs_eg_to_bits(n) != 6 { panic(124840); };
    if ecs_eg_versions_between(g, n) != 1 { panic(124841); };
    if ecs_eg_versions_between(n, g) != ecs_eg_mod() - 1 { panic(124842); };
}

@test "try_from_bits_generation"() {
    let ok = ecs_eg_try_from_bits(123);
    if ecs_eg_try_ok(ok) != true { panic(124850); };
    if ecs_eg_try_bits(ok) != 123 { panic(124851); };
    let bad = ecs_eg_try_from_bits(-1);
    if ecs_eg_try_ok(bad) != false { panic(124852); };
    let bad2 = ecs_eg_try_from_bits(ecs_eg_mod());
    if ecs_eg_try_ok(bad2) != false { panic(124853); };
}

@test "entity_pack_unpack"() {
    let e = ecs_eg_entity_new(7, 3);
    if ecs_eg_entity_index(e) != 7 { panic(124860); };
    if ecs_eg_entity_generation(e) != 3 { panic(124861); };
    let bits = ecs_eg_entity_to_bits(e);
    let t = ecs_eg_entity_try_from_bits(bits);
    if ecs_eg_try_ok(t) != true { panic(124862); };
    if ecs_eg_try_index(t) != 7 { panic(124863); };
    if ecs_eg_try_generation(t) != 3 { panic(124864); };
}

@test "entity_try_from_bits_invalid"() {
    let bad = ecs_eg_entity_try_from_bits(-5);
    if ecs_eg_try_ok(bad) != false { panic(124870); };
}

@test "constants"() {
    if ecs_eg_mod() != 4294967296 { panic(124880); };
    if ecs_eg_half() != 2147483648 { panic(124881); };
    if ecs_eg_ord_less() != 0 { panic(124882); };
    if ecs_eg_ord_equal() != 1 { panic(124883); };
    if ecs_eg_ord_greater() != 2 { panic(124884); };
}

@test "wrap_from_bits_negative"() {
    let g = ecs_eg_from_bits(-1);
    if ecs_eg_to_bits(g) != ecs_eg_mod() - 1 { panic(124890); };
    g = ecs_eg_after_versions(ecs_eg_first(), ecs_eg_mod() + 5);
    if ecs_eg_to_bits(g) != 5 { panic(124891); };
}
