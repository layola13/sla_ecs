@import "lib/unique_slice_deep.sla"

// Batch 324: unique_slice deep.
// panic codes: 130800 – 130999.

@test "empty"() {
    let s = ecs_us_deep_empty();
    if ecs_us_deep_is_empty(s) != true { panic(130800); };
}

@test "push_get"() {
    let s = ecs_us_deep_push(ecs_us_deep_push(ecs_us_deep_empty(), 1), 2);
    if ecs_us_deep_len(s) != 2 { panic(130810); };
    if ecs_us_get_value(ecs_us_deep_get(s, 1)) != 2 { panic(130811); };
}

@test "first_last"() {
    let s = ecs_us_deep_from4(3, 4, 5, 0, 3);
    if ecs_us_get_value(ecs_us_deep_first(s)) != 3 { panic(130820); };
    if ecs_us_get_value(ecs_us_deep_last(s)) != 5 { panic(130821); };
}

@test "contains_index"() {
    let s = ecs_us_deep_from4(7, 8, 9, 0, 3);
    if ecs_us_deep_contains(s, 8) != true { panic(130830); };
    if ecs_us_deep_index_of(s, 9) != 2 { panic(130831); };
    if ecs_us_deep_index_of(s, 1) != (0 - 1) { panic(130832); };
}

@test "rindex"() {
    let s = ecs_us_deep_from4(1, 2, 1, 0, 3);
    if ecs_us_deep_rindex_of(s, 1) != 2 { panic(130840); };
}

@test "swap"() {
    let s = ecs_us_deep_from4(1, 2, 3, 0, 3);
    s = ecs_us_deep_swap(s, 0, 2);
    if ecs_us_deep_at(s, 0) != 3 { panic(130850); };
    if ecs_us_deep_at(s, 2) != 1 { panic(130851); };
}

@test "reverse"() {
    let s = ecs_us_deep_from4(1, 2, 3, 4, 4);
    s = ecs_us_deep_reverse(s);
    if ecs_us_deep_at(s, 0) != 4 { panic(130860); };
    if ecs_us_deep_at(s, 3) != 1 { panic(130861); };
}

@test "eq"() {
    let a = ecs_us_deep_from4(1, 2, 0, 0, 2);
    let b = ecs_us_deep_from4(1, 2, 0, 0, 2);
    let c = ecs_us_deep_from4(1, 3, 0, 0, 2);
    if ecs_us_deep_eq(a, b) != true { panic(130870); };
    if ecs_us_deep_eq(a, c) != false { panic(130871); };
}

@test "min_max"() {
    let s = ecs_us_deep_from4(5, 2, 9, 0, 3);
    if ecs_us_get_value(ecs_us_deep_min(s)) != 2 { panic(130880); };
    if ecs_us_get_value(ecs_us_deep_max(s)) != 9 { panic(130881); };
}

@test "get_oob"() {
    let s = ecs_us_deep_empty();
    if ecs_us_get_ok(ecs_us_deep_get(s, 0)) != false { panic(130890); };
    if ecs_us_get_ok(ecs_us_deep_first(s)) != false { panic(130891); };
}
