@import "lib/entity_cloner_builder_extras_deep.sla"

// Batch 290: entity_cloner_builder_extras deep.
// panic codes: 124000 – 124199.

@test "default_clone_fn"() {
    let b = ecs_ecbe_deep_opt_out();
    if ecs_ecbe_deep_default_fn(b) != 1 { panic(124000); };
    b = ecs_ecbe_deep_with_default_clone_fn(b, 3);
    if ecs_ecbe_deep_default_fn(b) != 3 { panic(124001); };
    if ecs_ecbe_deep_behavior_of(b, 9) != 3 { panic(124002); };
}

@test "override_insert_replace_remove"() {
    let b = ecs_ecbe_deep_opt_out();
    b = ecs_ecbe_deep_override_with_id(b, 1, 2);
    b = ecs_ecbe_deep_override_with_id(b, 2, 0);
    if ecs_ecbe_deep_override_len(b) != 2 { panic(124010); };
    if ecs_ecbe_ov_behavior(ecs_ecbe_deep_overridden_at(b, 1)) != 2 { panic(124011); };
    b = ecs_ecbe_deep_override_with_id(b, 1, 3);
    if ecs_ecbe_deep_override_len(b) != 2 { panic(124012); };
    if ecs_ecbe_ov_behavior(ecs_ecbe_deep_overridden_at(b, 1)) != 3 { panic(124013); };
    b = ecs_ecbe_deep_remove_override(b, 1);
    if ecs_ecbe_deep_override_len(b) != 1 { panic(124014); };
    if ecs_ecbe_ov_has(ecs_ecbe_deep_overridden_at(b, 1)) != false { panic(124015); };
    if ecs_ecbe_ov_has(ecs_ecbe_deep_overridden_at(b, 2)) != true { panic(124016); };
}

@test "behavior_of_falls_back_to_default"() {
    let b = ecs_ecbe_deep_opt_out();
    b = ecs_ecbe_deep_with_default_clone_fn(b, 1);
    b = ecs_ecbe_deep_override_with_id(b, 5, 0);
    if ecs_ecbe_deep_behavior_of(b, 5) != 0 { panic(124020); };
    if ecs_ecbe_deep_behavior_of(b, 6) != 1 { panic(124021); };
}

@test "without_required_scope_opt_in"() {
    // A requires B: allow(A) normally also allows B; inside without_required, only A.
    let b = ecs_ecbe_deep_opt_in();
    let req = ecs_ecbe_req_add(ecs_ecbe_req_new(), 1, 2);
    b = ecs_ecbe_deep_set_req(b, req);
    b = ecs_ecbe_deep_allow(b, 1);
    if ecs_ecbe_deep_allow_len(b) != 2 { panic(124030); };
    if ecs_ecbe_deep_has_allow(b, 2) != true { panic(124031); };

    let b2 = ecs_ecbe_deep_opt_in();
    b2 = ecs_ecbe_deep_set_req(b2, req);
    b2 = ecs_ecbe_deep_without_required_begin(b2);
    if ecs_ecbe_deep_attach_required(b2) != false { panic(124032); };
    b2 = ecs_ecbe_deep_allow(b2, 1);
    if ecs_ecbe_deep_allow_len(b2) != 1 { panic(124033); };
    if ecs_ecbe_deep_has_allow(b2, 2) != false { panic(124034); };
    b2 = ecs_ecbe_deep_without_required_end(b2);
    if ecs_ecbe_deep_attach_required(b2) != true { panic(124035); };
    b2 = ecs_ecbe_deep_allow(b2, 3);
    // 3 has no required; still length 2
    if ecs_ecbe_deep_allow_len(b2) != 2 { panic(124036); };
}

@test "without_required_by_scope_opt_out"() {
    // C requires D: deny(D) normally also denies C; inside without_required_by, only D.
    let b = ecs_ecbe_deep_opt_out();
    let req = ecs_ecbe_req_add(ecs_ecbe_req_new(), 3, 4);
    b = ecs_ecbe_deep_set_req(b, req);
    b = ecs_ecbe_deep_deny(b, 4);
    if ecs_ecbe_deep_deny_len(b) != 2 { panic(124040); };
    if ecs_ecbe_deep_has_deny(b, 3) != true { panic(124041); };

    let b2 = ecs_ecbe_deep_opt_out();
    b2 = ecs_ecbe_deep_set_req(b2, req);
    b2 = ecs_ecbe_deep_without_required_by_begin(b2);
    if ecs_ecbe_deep_attach_required_by(b2) != false { panic(124042); };
    b2 = ecs_ecbe_deep_deny(b2, 4);
    if ecs_ecbe_deep_deny_len(b2) != 1 { panic(124043); };
    if ecs_ecbe_deep_has_deny(b2, 3) != false { panic(124044); };
    b2 = ecs_ecbe_deep_without_required_by_end(b2);
    if ecs_ecbe_deep_attach_required_by(b2) != true { panic(124045); };
}

@test "should_clone_opt_in_and_opt_out"() {
    let bi = ecs_ecbe_deep_opt_in();
    bi = ecs_ecbe_deep_allow(bi, 1);
    bi = ecs_ecbe_deep_allow(bi, 2);
    if ecs_ecbe_deep_should_clone(bi, 1) != true { panic(124050); };
    if ecs_ecbe_deep_should_clone(bi, 3) != false { panic(124051); };

    let bo = ecs_ecbe_deep_opt_out();
    bo = ecs_ecbe_deep_deny(bo, 5);
    if ecs_ecbe_deep_should_clone(bo, 1) != true { panic(124052); };
    if ecs_ecbe_deep_should_clone(bo, 5) != false { panic(124053); };
}

@test "would_clone_respects_ignore_override"() {
    let b = ecs_ecbe_deep_opt_out();
    b = ecs_ecbe_deep_override_with_id(b, 7, 0); // ignore
    if ecs_ecbe_deep_should_clone(b, 7) != true { panic(124060); };
    if ecs_ecbe_deep_would_clone(b, 7) != false { panic(124061); };
    if ecs_ecbe_deep_would_clone(b, 8) != true { panic(124062); };
}

@test "allow_deny_dedup"() {
    let b = ecs_ecbe_deep_opt_in();
    b = ecs_ecbe_deep_allow(b, 1);
    b = ecs_ecbe_deep_allow(b, 1);
    if ecs_ecbe_deep_allow_len(b) != 1 { panic(124070); };
    let o = ecs_ecbe_deep_opt_out();
    o = ecs_ecbe_deep_deny(o, 2);
    o = ecs_ecbe_deep_deny(o, 2);
    if ecs_ecbe_deep_deny_len(o) != 1 { panic(124071); };
}

@test "override_capacity_four"() {
    let b = ecs_ecbe_deep_opt_out();
    b = ecs_ecbe_deep_override_with_id(b, 1, 1);
    b = ecs_ecbe_deep_override_with_id(b, 2, 2);
    b = ecs_ecbe_deep_override_with_id(b, 3, 3);
    b = ecs_ecbe_deep_override_with_id(b, 4, 0);
    if ecs_ecbe_deep_override_len(b) != 4 { panic(124080); };
    // 5th ignored
    b = ecs_ecbe_deep_override_with_id(b, 5, 1);
    if ecs_ecbe_deep_override_len(b) != 4 { panic(124081); };
    if ecs_ecbe_ov_has(ecs_ecbe_deep_overridden_at(b, 5)) != false { panic(124082); };
    // replace still works
    b = ecs_ecbe_deep_override_with_id(b, 2, 0);
    if ecs_ecbe_ov_behavior(ecs_ecbe_deep_overridden_at(b, 2)) != 0 { panic(124083); };
}

@test "mode_flags_and_req_table"() {
    let b = ecs_ecbe_deep_opt_in();
    if ecs_ecbe_deep_is_opt_in(b) != true { panic(124090); };
    let o = ecs_ecbe_deep_opt_out();
    if ecs_ecbe_deep_is_opt_in(o) != false { panic(124091); };
    let req = ecs_ecbe_req_new();
    req = ecs_ecbe_req_add(req, 1, 2);
    req = ecs_ecbe_req_add(req, 1, 3);
    if ecs_ecbe_req_len(req) != 2 { panic(124092); };
    b = ecs_ecbe_deep_set_req(b, req);
    b = ecs_ecbe_deep_allow(b, 1);
    if ecs_ecbe_deep_has_allow(b, 2) != true { panic(124093); };
    if ecs_ecbe_deep_has_allow(b, 3) != true { panic(124094); };
    if ecs_ecbe_deep_allow_len(b) != 3 { panic(124095); };
}
