@import "lib/entity_allocator_extras_deep.sla"

// Batch 301: entity_allocator_extras deep.
// panic codes: 126200 – 126399.

@test "alloc_fresh"() {
    let a = ecs_eaex_deep_new();
    if ecs_eaex_next(a) != 1 { panic(126200); };
    let r = ecs_eaex_alloc(a);
    if ecs_eaex_alloc_entity(r) != 1 { panic(126201); };
    a = ecs_eaex_alloc_world(r);
    if ecs_eaex_next(a) != 2 { panic(126202); };
    if ecs_eaex_allocated(a) != 1 { panic(126203); };
}

@test "free_and_reuse_lifo"() {
    let a = ecs_eaex_deep_new();
    let r1 = ecs_eaex_alloc(a);
    let r2 = ecs_eaex_alloc(ecs_eaex_alloc_world(r1));
    a = ecs_eaex_alloc_world(r2);
    a = ecs_eaex_free(a, ecs_eaex_alloc_entity(r2));
    a = ecs_eaex_free(a, ecs_eaex_alloc_entity(r1));
    if ecs_eaex_pending_free(a) != 2 { panic(126210); };
    let r3 = ecs_eaex_alloc(a);
    // LIFO: last freed first
    if ecs_eaex_alloc_entity(r3) != ecs_eaex_alloc_entity(r1) { panic(126211); };
}

@test "free_many2"() {
    let a = ecs_eaex_deep_new();
    a = ecs_eaex_free_many2(a, 10, 11);
    if ecs_eaex_pending_free(a) != 2 { panic(126220); };
    let r = ecs_eaex_alloc(a);
    if ecs_eaex_alloc_entity(r) != 11 { panic(126221); };
}

@test "alloc_many_next"() {
    let a = ecs_eaex_deep_new();
    let m = ecs_eaex_alloc_many(a, 3);
    if ecs_eaex_many_count(m) != 3 { panic(126230); };
    if ecs_eaex_many_remaining(m) != 3 { panic(126231); };
    let n0 = ecs_eaex_many_next(m);
    if ecs_eaex_next_has(n0) != true { panic(126232); };
    if ecs_eaex_next_entity(n0) != 1 { panic(126233); };
    m = ecs_eaex_next_iter(n0);
    let n1 = ecs_eaex_many_next(m);
    if ecs_eaex_next_entity(n1) != 2 { panic(126234); };
    m = ecs_eaex_next_iter(n1);
    let n2 = ecs_eaex_many_next(m);
    if ecs_eaex_next_entity(n2) != 3 { panic(126235); };
    m = ecs_eaex_next_iter(n2);
    if ecs_eaex_many_is_empty(m) != true { panic(126236); };
    a = ecs_eaex_many_world(m);
    if ecs_eaex_allocated(a) != 3 { panic(126237); };
}

@test "alloc_many_zero"() {
    let m = ecs_eaex_alloc_many(ecs_eaex_deep_new(), 0);
    if ecs_eaex_many_count(m) != 0 { panic(126240); };
    if ecs_eaex_next_has(ecs_eaex_many_next(m)) != false { panic(126241); };
}

@test "remote_allocator_generation"() {
    let a = ecs_eaex_deep_new();
    let p = ecs_eaex_build_remote(a);
    if ecs_eaex_has_remote(a, p) != true { panic(126250); };
    if ecs_eaex_remote_generation(p) != 1 { panic(126251); };
    a = ecs_eaex_restart(a);
    if ecs_eaex_has_remote(a, p) != false { panic(126252); };
    if ecs_eaex_generation(a) != 2 { panic(126253); };
    if ecs_eaex_next(a) != 1 { panic(126254); };
    if ecs_eaex_allocated(a) != 0 { panic(126255); };
}

@test "restart_clears_free"() {
    let a = ecs_eaex_free(ecs_eaex_deep_new(), 5);
    if ecs_eaex_pending_free(a) != 1 { panic(126260); };
    a = ecs_eaex_restart(a);
    if ecs_eaex_pending_free(a) != 0 { panic(126261); };
}

@test "remote_proxy_fields"() {
    let a = ecs_eaex_deep_new();
    a = ecs_eaex_alloc_world(ecs_eaex_alloc(a));
    a = ecs_eaex_free(a, 1);
    let p = ecs_eaex_build_remote(a);
    if ecs_eaex_remote_next(p) != ecs_eaex_next(a) { panic(126270); };
    if ecs_eaex_remote_freed_len(p) != 1 { panic(126271); };
}

@test "alloc_many_four"() {
    let m = ecs_eaex_alloc_many(ecs_eaex_deep_new(), 4);
    if ecs_eaex_many_count(m) != 4 { panic(126280); };
    if ecs_eaex_many_at(m, 0) != 1 { panic(126281); };
    if ecs_eaex_many_at(m, 3) != 4 { panic(126282); };
}

@test "fresh_after_free_exhaust"() {
    let a = ecs_eaex_deep_new();
    a = ecs_eaex_alloc_world(ecs_eaex_alloc(a)); // 1
    a = ecs_eaex_free(a, 1);
    let r = ecs_eaex_alloc(a); // reuses 1
    a = ecs_eaex_alloc_world(r);
    let r2 = ecs_eaex_alloc(a); // fresh 2
    if ecs_eaex_alloc_entity(r2) != 2 { panic(126290); };
}
