@import "lib/entity_index_map_derived_extras_deep.sla"

// Batch 344: entity_index_map_derived_extras deep.
// panic codes: 134800 – 134999.

@test "constructors"() {
    let a = ecs_eimd_new();
    let b = ecs_eimd_default();
    let c = ecs_eimd_with_capacity(5);
    let d = ecs_eimd_with_capacity(-3);
    if ecs_eimd_kind(a) != 1 { panic(134800); };
    if ecs_eimd_kind(b) != 2 { panic(134801); };
    if ecs_eimd_kind(c) != 3 { panic(134802); };
    if ecs_eimd_capacity(c) != 5 { panic(134803); };
    if ecs_eimd_capacity(d) != 0 { panic(134804); };
}

@test "insert_get"() {
    let m = ecs_eimd_new();
    let r = ecs_eimd_insert(m, 1, 10);
    if ecs_eimd_ins_replaced(r) != false { panic(134810); };
    m = ecs_eimd_ins_map(r);
    let r2 = ecs_eimd_insert(m, 1, 15);
    if ecs_eimd_ins_replaced(r2) != true { panic(134811); };
    m = ecs_eimd_ins_map(r2);
    let g = ecs_eimd_get(m, 1);
    if ecs_eimd_get_has(g) != true { panic(134812); };
    if ecs_eimd_get_value(g) != 15 { panic(134813); };
    if ecs_eimd_contains(m, 1) != true { panic(134814); };
}

@test "clone_and_from"() {
    let m = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 3, 30));
    let c = ecs_eimd_clone(m);
    if ecs_eimd_kind(c) != 4 { panic(134820); };
    let f = ecs_eimd_from_index_map(m);
    if ecs_eimd_kind(f) != 6 { panic(134821); };
    if ecs_eimd_get_value(ecs_eimd_get(f, 3)) != 30 { panic(134822); };
}

@test "eq"() {
    let a = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 1, 10)), 2, 20));
    let b = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 2, 20)), 1, 10));
    if ecs_eimd_eq(a, b) != true { panic(134830); };
    let c = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 1, 10));
    if ecs_eimd_eq(a, c) != false { panic(134831); };
    let d = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 1, 99)), 2, 20));
    if ecs_eimd_eq(a, d) != false { panic(134832); };
}

@test "from_array4"() {
    let m = ecs_eimd_from_array4(5, 50, 6, 60, 5, 55, 7, 70);
    if ecs_eimd_len(m) != 3 { panic(134840); };
    if ecs_eimd_capacity(m) != 4 { panic(134841); };
    if ecs_eimd_kind(m) != 5 { panic(134842); };
    let g = ecs_eimd_get(m, 5);
    if ecs_eimd_get_value(g) != 55 { panic(134843); };
}

@test "iter_next"() {
    let m = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 4, 40)), 5, 50));
    let it = ecs_eimd_iter(m);
    if ecs_eimd_iter_remaining(it) != 2 { panic(134850); };
    if ecs_eimd_iter_debug(it) != 10 { panic(134851); };
    let n1 = ecs_eimd_iter_next(it);
    if ecs_eimd_next_key(n1) != 4 { panic(134852); };
    if ecs_eimd_next_value(n1) != 40 { panic(134853); };
    let n2 = ecs_eimd_iter_next(ecs_eimd_next_iter(n1));
    if ecs_eimd_next_key(n2) != 5 { panic(134854); };
    if ecs_eimd_next_value(n2) != 50 { panic(134855); };
}

@test "keys_values_markers"() {
    let m = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 9, 90));
    if ecs_eimd_iter_debug(ecs_eimd_keys(m)) != 40 { panic(134860); };
    if ecs_eimd_iter_trusted(ecs_eimd_keys(m)) != 1 { panic(134861); };
    if ecs_eimd_iter_debug(ecs_eimd_values(m)) != 60 { panic(134862); };
    if ecs_eimd_iter_debug(ecs_eimd_into_keys(m)) != 50 { panic(134863); };
    if ecs_eimd_iter_debug(ecs_eimd_into_values(m)) != 70 { panic(134864); };
    if ecs_eimd_iter_debug(ecs_eimd_iter_mut(m)) != 11 { panic(134865); };
    if ecs_eimd_iter_debug(ecs_eimd_into_iter(m)) != 20 { panic(134866); };
}

@test "capacity_eight"() {
    let m = ecs_eimd_new();
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 1, 1));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 2, 2));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 3, 3));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 4, 4));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 5, 5));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 6, 6));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 7, 7));
    m = ecs_eimd_ins_map(ecs_eimd_insert(m, 8, 8));
    if ecs_eimd_len(m) != 8 { panic(134870); };
    let r = ecs_eimd_insert(m, 9, 9);
    if ecs_eimd_ins_replaced(r) != false { panic(134871); };
    let r2 = ecs_eimd_insert(m, 8, 88);
    if ecs_eimd_ins_replaced(r2) != true { panic(134872); };
    if ecs_eimd_get_value(ecs_eimd_get(ecs_eimd_ins_map(r2), 8)) != 88 { panic(134873); };
}

@test "at_access_slice"() {
    let m = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 10, 100)), 20, 200));
    if ecs_eimd_key_at(m, 0) != 10 { panic(134880); };
    if ecs_eimd_value_at(m, 0) != 100 { panic(134881); };
    if ecs_eimd_key_at(m, 1) != 20 { panic(134882); };
    let s = ecs_eimd_slice_view(m, 1);
    if ecs_eimd_slice_len(s) != 2 { panic(134883); };
    if ecs_eimd_slice_mutable(s) != 1 { panic(134884); };
    if ecs_eimd_slice_key_at(s, 1) != 20 { panic(134885); };
}

@test "iter_end_and_empty"() {
    let m = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 1, 11));
    let n1 = ecs_eimd_iter_next(ecs_eimd_iter(m));
    let n2 = ecs_eimd_iter_next(ecs_eimd_next_iter(n1));
    if ecs_eimd_next_has(n2) != false { panic(134890); };
    if ecs_eimd_is_empty(ecs_eimd_new()) != true { panic(134891); };
    let def = ecs_eimd_iter_default(40, 1);
    if ecs_eimd_iter_remaining(def) != 0 { panic(134892); };
    if ecs_eimd_iter_trusted(def) != 1 { panic(134893); };
}

@test "slice_split"() {
    let m = ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_ins_map(ecs_eimd_insert(ecs_eimd_new(), 1, 10)), 2, 20)), 3, 30));
    let s = ecs_eimd_slice_view(m, 0);
    let sp = ecs_eimd_slice_split(s, 1);
    let l = ecs_eimd_split_left(sp);
    let r = ecs_eimd_split_right(sp);
    if ecs_eimd_slice_len(l) != 1 { panic(134895); };
    if ecs_eimd_slice_len(r) != 2 { panic(134896); };
    if ecs_eimd_slice_key_at(l, 0) != 1 { panic(134897); };
    if ecs_eimd_slice_key_at(r, 0) != 2 { panic(134898); };
    if ecs_eimd_slice_key_at(r, 1) != 3 { panic(134899); };
}
