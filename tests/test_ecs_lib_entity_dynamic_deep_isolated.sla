@import "lib/entity_dynamic_deep.sla"

// Batch 348: entity_dynamic deep.
// panic codes: 135600 – 135799.

@test "alloc_first"() {
    let a = ecs_dyn_alloc_new();
    let r = ecs_dyn_alloc_entity(a);
    let e = ecs_dyn_alloc_result_entity(r);
    if ecs_dyn_entity_id(e) != 1 { panic(135600); };
    if ecs_dyn_entity_gen(e) != 0 { panic(135601); };
    if ecs_dyn_alloc_count(ecs_dyn_alloc_result(r)) != 1 { panic(135602); };
}

@test "alloc_sequence"() {
    let a = ecs_dyn_alloc_new();
    let r1 = ecs_dyn_alloc_entity(a);
    a = ecs_dyn_alloc_result(r1);
    let r2 = ecs_dyn_alloc_entity(a);
    a = ecs_dyn_alloc_result(r2);
    let r3 = ecs_dyn_alloc_entity(a);
    if ecs_dyn_entity_id(ecs_dyn_alloc_result_entity(r3)) != 3 { panic(135610); };
    if ecs_dyn_alloc_count(ecs_dyn_alloc_result(r3)) != 3 { panic(135611); };
}

@test "alive_after_alloc"() {
    let a = ecs_dyn_alloc_new();
    let r = ecs_dyn_alloc_entity(a);
    let e = ecs_dyn_alloc_result_entity(r);
    if ecs_dyn_is_alive(ecs_dyn_alloc_result(r), e) != true { panic(135620); };
}

@test "free_then_alloc_reuses"() {
    let a = ecs_dyn_alloc_new();
    let r1 = ecs_dyn_alloc_entity(a);
    a = ecs_dyn_alloc_result(r1);
    let r2 = ecs_dyn_alloc_entity(a);
    a = ecs_dyn_alloc_result(r2);
    let e1 = ecs_dyn_alloc_result_entity(r1);
    a = ecs_dyn_free_entity(a, e1);
    if ecs_dyn_alloc_count(a) != 1 { panic(135630); };
    if ecs_dyn_free_len(a) != 1 { panic(135631); };
    let r3 = ecs_dyn_alloc_entity(a);
    let e3 = ecs_dyn_alloc_result_entity(r3);
    if ecs_dyn_entity_id(e3) != 1 { panic(135632); };
    if ecs_dyn_entity_gen(e3) != 1 { panic(135633); };
    if ecs_dyn_alloc_count(ecs_dyn_alloc_result(r3)) != 2 { panic(135634); };
}

@test "alive_fabricated_next_gen_rejected"() {
    let a = ecs_dyn_alloc_new();
    let r1 = ecs_dyn_alloc_entity(a);
    let e1 = ecs_dyn_alloc_result_entity(r1);
    let after_free = ecs_dyn_free_entity(ecs_dyn_alloc_result(r1), e1);
    let fake = ecs_dyn_entity_new(e1.id, e1.gen + 1);
    if ecs_dyn_is_alive(after_free, e1) != false { panic(135640); };
    if ecs_dyn_is_alive(after_free, fake) != false { panic(135641); };
    let r2 = ecs_dyn_alloc_entity(after_free);
    let e2 = ecs_dyn_alloc_result_entity(r2);
    if ecs_dyn_entity_eq(e2, fake) != true { panic(135642); };
    if ecs_dyn_is_alive(ecs_dyn_alloc_result(r2), e2) != true { panic(135643); };
}

@test "free_missing_noop"() {
    let a = ecs_dyn_alloc_new();
    let r = ecs_dyn_alloc_entity(a);
    a = ecs_dyn_alloc_result(r);
    let unknown = ecs_dyn_entity_new(7, 0);
    let a2 = ecs_dyn_free_entity(a, unknown);
    if ecs_dyn_alloc_count(a2) != 1 { panic(135650); };
}

@test "free_id_zero_no_alive"() {
    let a = ecs_dyn_alloc_new();
    let ezero = ecs_dyn_entity_new(0, 0);
    if ecs_dyn_is_alive(a, ezero) != false { panic(135660); };
}

@test "entity_eq"() {
    if ecs_dyn_entity_eq(ecs_dyn_entity_new(2, 1), ecs_dyn_entity_new(2, 1)) != true { panic(135670); };
    if ecs_dyn_entity_eq(ecs_dyn_entity_new(2, 1), ecs_dyn_entity_new(2, 2)) != false { panic(135671); };
}

@test "capacity_allocations"() {
    let a = ecs_dyn_alloc_new();
    let i = 0;
    while i < 14 {
        a = ecs_dyn_alloc_result(ecs_dyn_alloc_entity(a));
        i = i + 1;
    }
    if ecs_dyn_alloc_count(a) != 14 { panic(135680); };
    let last = ecs_dyn_alloc_entity(a);
    if ecs_dyn_entity_id(ecs_dyn_alloc_result_entity(last)) != 15 { panic(135681); };
}

@test "double_free_no_double_count"() {
    let a = ecs_dyn_alloc_new();
    let r = ecs_dyn_alloc_entity(a);
    let e = ecs_dyn_alloc_result_entity(r);
    a = ecs_dyn_free_entity(ecs_dyn_alloc_result(r), e);
    let count_before = ecs_dyn_free_len(a);
    a = ecs_dyn_free_entity(a, e);
    if ecs_dyn_free_len(a) != count_before { panic(135690); };
    if ecs_dyn_alloc_count(a) != 0 { panic(135691); };
}
