@import "lib/maybe_location_deep.sla"

// Batch 220: maybe_location deep (src/change_detection/maybe_location.rs).
// panic codes: 110000 – 110199.

@test "track_constants"() {
    if ecs_ml_track_off() != 0 { panic(110000); };
    if ecs_ml_track_on() != 1 { panic(110001); };
}

@test "new_on_into_option"() {
    let m = ecs_ml_new_on(42);
    if ecs_ml_track(m) != ECS_ML_TRACK_ON { panic(110010); };
    let o = ecs_ml_into_option_plain(m);
    if o.0 != true { panic(110011); };
    if o.1 != 42 { panic(110012); };
}

@test "new_off_into_option_none"() {
    let m = ecs_ml_new_off();
    let o = ecs_ml_into_option_plain(m);
    if o.0 != false { panic(110020); };
    if ecs_ml_unwrap_or_default(m) != 0 { panic(110021); };
    if ecs_ml_unwrap_or(m, 9) != 9 { panic(110022); };
}

@test "map_on_and_off"() {
    let m = ecs_ml_new_on(3);
    let m2 = ecs_ml_map(m, 30);
    if ecs_ml_value(m2) != 30 { panic(110030); };
    let off = ecs_ml_new_off();
    let m3 = ecs_ml_map(off, 99);
    if ecs_ml_track(m3) != ECS_ML_TRACK_OFF { panic(110031); };
}

@test "zip_packs_values"() {
    let a = ecs_ml_new_on(12);
    let b = ecs_ml_new_on(34);
    let z = ecs_ml_zip(a, b);
    if ecs_ml_track(z) != ECS_ML_TRACK_ON { panic(110040); };
    let p = ecs_ml_value(z);
    if ecs_ml_zip_left(p) != 12 { panic(110041); };
    if ecs_ml_zip_right(p) != 34 { panic(110042); };
}

@test "zip_off_if_either_off"() {
    let a = ecs_ml_new_on(1);
    let b = ecs_ml_new_off();
    let z = ecs_ml_zip(a, b);
    if ecs_ml_track(z) != ECS_ML_TRACK_OFF { panic(110050); };
}

@test "option_some_transpose"() {
    let m = ecs_ml_option_some_on(7);
    let t = ecs_ml_transpose(m);
    if ecs_ml_transpose_has(t) != true { panic(110060); };
    if ecs_ml_value(ecs_ml_transpose_ml(t)) != 7 { panic(110061); };
}

@test "option_none_transpose"() {
    let m = ecs_ml_option_none_on();
    let t = ecs_ml_transpose(m);
    if ecs_ml_transpose_has(t) != false { panic(110070); };
}

@test "option_off_transpose_always_some_empty"() {
    let m = ecs_ml_option_off();
    let t = ecs_ml_transpose(m);
    if ecs_ml_transpose_has(t) != true { panic(110080); };
    if ecs_ml_track(ecs_ml_transpose_ml(t)) != ECS_ML_TRACK_OFF { panic(110081); };
}

@test "copied_preserves_value"() {
    let m = ecs_ml_new_on(55);
    let c = ecs_ml_copied(m);
    if ecs_ml_value(c) != 55 { panic(110090); };
}

@test "assign_when_on"() {
    let m = ecs_ml_new_on(1);
    m = ecs_ml_assign(m, 8);
    if ecs_ml_value(m) != 8 { panic(110100); };
}

@test "eq"() {
    let a = ecs_ml_new_on(3);
    let b = ecs_ml_new_on(3);
    let c = ecs_ml_new_on(4);
    if ecs_ml_eq(a, b) != true { panic(110110); };
    if ecs_ml_eq(a, c) != false { panic(110111); };
    if ecs_ml_eq(ecs_ml_new_off(), ecs_ml_new_off()) != true { panic(110112); };
}

@test "new_with_flattened_paths"() {
    let a = ecs_ml_new_with_flattened(true, true, 11);
    if ecs_ml_has_value(a) != true { panic(110120); };
    if ecs_ml_value(a) != 11 { panic(110121); };
    let b = ecs_ml_new_with_flattened(false, true, 0);
    if ecs_ml_track(b) != ECS_ML_TRACK_OFF { panic(110122); };
}

@test "unwrap_or_default_on"() {
    let m = ecs_ml_new_on(19);
    if ecs_ml_unwrap_or_default(m) != 19 { panic(110130); };
}

@test "as_ref_identity"() {
    let m = ecs_ml_new_on(4);
    let r = ecs_ml_as_ref(m);
    if ecs_ml_value(r) != 4 { panic(110140); };
}

@test "option_layer_flags"() {
    let s = ecs_ml_option_some_on(1);
    if ecs_ml_is_option_layer(s) != true { panic(110150); };
    if ecs_ml_has_value(s) != true { panic(110151); };
    let n = ecs_ml_option_none_on();
    if ecs_ml_has_value(n) != false { panic(110152); };
}
