@import "lib/filtered_resource_builders_deep.sla"

// Batch 304: filtered_resource_builders deep.
// panic codes: 126800 – 126999.

@test "read_builder_new"() {
    let b = ecs_frb_deep_new(3);
    if ecs_frb_deep_world(b) != 3 { panic(126800); };
    if ecs_frb_deep_built(b) != false { panic(126801); };
    if ecs_frb_deep_can_read(b, 1) != false { panic(126802); };
}

@test "add_read_by_id_and_build"() {
    let b = ecs_frb_deep_new(1);
    b = ecs_frb_deep_add_read_by_id(b, 2);
    b = ecs_frb_deep_add_read_by_id(b, 5);
    if ecs_frb_deep_can_read(b, 2) != true { panic(126810); };
    if ecs_frb_deep_can_read(b, 5) != true { panic(126811); };
    if ecs_frb_deep_can_read(b, 3) != false { panic(126812); };
    b = ecs_frb_deep_build(b);
    if ecs_frb_deep_built(b) != true { panic(126813); };
}

@test "add_read_all"() {
    let b = ecs_frb_deep_add_read_all(ecs_frb_deep_new(1));
    if ecs_frb_deep_read_all(b) != true { panic(126820); };
    if ecs_frb_deep_can_read(b, 9) != true { panic(126821); };
}

@test "mut_builder_write"() {
    let b = ecs_frbm_deep_new(2);
    b = ecs_frbm_deep_add_write_by_id(b, 4);
    if ecs_frbm_deep_can_write(b, 4) != true { panic(126830); };
    if ecs_frbm_deep_can_read(b, 4) != true { panic(126831); };
    if ecs_frbm_deep_can_write(b, 5) != false { panic(126832); };
}

@test "mut_builder_write_all"() {
    let b = ecs_frbm_deep_add_write_all(ecs_frbm_deep_new(1));
    if ecs_frbm_deep_write_all(b) != true { panic(126840); };
    if ecs_frbm_deep_read_all(b) != true { panic(126841); };
    if ecs_frbm_deep_can_write(b, 7) != true { panic(126842); };
}

@test "mut_add_read_and_build"() {
    let b = ecs_frbm_deep_new(1);
    b = ecs_frbm_deep_add_read_by_id(b, 1);
    b = ecs_frbm_deep_add_write_by_id(b, 2);
    b = ecs_frbm_deep_build(b);
    if ecs_frbm_deep_built(b) != true { panic(126850); };
    if ecs_frbm_deep_can_read(b, 1) != true { panic(126851); };
    if ecs_frbm_deep_can_write(b, 1) != false { panic(126852); };
}

@test "as_readonly_strips_write"() {
    let b = ecs_frbm_deep_add_write_by_id(ecs_frbm_deep_new(1), 3);
    let ro = ecs_frbm_deep_as_readonly(b);
    if ecs_frb_deep_can_read(ro, 3) != true { panic(126860); };
    if ecs_frb_deep_write_all(ro) != false { panic(126861); };
    if ecs_frb_deep_write_bits(ro) != 0 { panic(126862); };
}

@test "read_all_on_mut_builder"() {
    let b = ecs_frbm_deep_add_read_all(ecs_frbm_deep_new(1));
    if ecs_frbm_deep_read_all(b) != true { panic(126870); };
    if ecs_frbm_deep_write_all(b) != false { panic(126871); };
}

@test "idempotent_bit_or"() {
    let b = ecs_frb_deep_new(1);
    b = ecs_frb_deep_add_read_by_id(b, 1);
    let bits = ecs_frb_deep_read_bits(b);
    b = ecs_frb_deep_add_read_by_id(b, 1);
    if ecs_frb_deep_read_bits(b) != bits { panic(126880); };
}

@test "world_ids_preserved"() {
    let b = ecs_frb_deep_build(ecs_frb_deep_add_read_by_id(ecs_frb_deep_new(99), 1));
    if ecs_frb_deep_world(b) != 99 { panic(126890); };
    let m = ecs_frbm_deep_build(ecs_frbm_deep_add_write_by_id(ecs_frbm_deep_new(77), 2));
    if ecs_frbm_deep_world(m) != 77 { panic(126891); };
}
