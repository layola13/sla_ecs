// Isolated deep tests for lib/schedule_node_sets_deep.sla (Batch 407).
// Tests the deep schedule node set types: EcsNodeSetEntryDeep, EcsNodeSetCondDeep,
// EcsNodeSetSystemsDeep (insert/get/set_system/has_conditions/condition_count/
// add_condition/remove/initialize), EcsNodeSetConflictingSystemsDeep (push/get/
// check_if_not_empty), EcsNodeSetSystemAccessDeep (add_read/add_write/set_reads_all/
// set_writes_all/get_conflicts), EcsNodeSetSystemSetsDeep (get_key_or_insert/contains/
// get_index/get_set_id/set_is_system_type/get_is_system_type/initialize), and
// EcsSystemTypeSetAmbiguityErrorDeep.

@import "lib/schedule_node_sets_deep.sla"

@test "entry_new_and_accessors"() {
    let e = ecs_node_set_entry_deep_new(42, 777, true);
    if ecs_node_set_entry_deep_id(e) != 42 { panic(146500); };
    if ecs_node_set_entry_deep_name(e) != 777 { panic(146501); };
    if ecs_node_set_entry_deep_is_exclusive(e) != true { panic(146502); };
    let e2 = ecs_node_set_entry_deep_new(7, 99, false);
    if ecs_node_set_entry_deep_id(e2) != 7 { panic(146503); };
    if ecs_node_set_entry_deep_name(e2) != 99 { panic(146504); };
    if ecs_node_set_entry_deep_is_exclusive(e2) != false { panic(146505); };
}

@test "cond_new_and_accessor"() {
    let c = ecs_node_set_cond_deep_new(55);
    if ecs_node_set_cond_deep_id(c) != 55 { panic(146510); };
    let c2 = ecs_node_set_cond_deep_new((0 - 1) + 1);
    if ecs_node_set_cond_deep_id(c2) != 0 { panic(146511); };
}

@test "systems_new_len_is_empty"() {
    let s = ecs_systems_ext_deep_new();
    if ecs_systems_ext_deep_len(s) != 0 { panic(146520); };
    if ecs_systems_ext_deep_is_empty(s) != true { panic(146521); };
}

@test "systems_insert_and_get"() {
    let s = ecs_systems_ext_deep_new();
    let e = ecs_systems_ext_deep_entry(10, 200, true);
    s = ecs_systems_ext_deep_insert(s, e);
    if ecs_systems_ext_deep_last_insert_key(s) != 0 { panic(146525); };
    if ecs_systems_ext_deep_len(s) != 1 { panic(146526); };
    if ecs_systems_ext_deep_is_empty(s) != false { panic(146527); };
    s = ecs_systems_ext_deep_get(s, 0);
    if ecs_systems_ext_deep_get_found(s) != true { panic(146528); };
    if ecs_systems_ext_deep_get_entry_system_id(s) != 10 { panic(146529); };
    if ecs_systems_ext_deep_get_entry_system_name(s) != 200 { panic(146530); };
    if ecs_systems_ext_deep_get_entry_is_exclusive(s) != true { panic(146531); };
}

@test "systems_insert_multiple_then_get"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(1, 11, false));
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(2, 22, true));
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(3, 33, false));
    if ecs_systems_ext_deep_len(s) != 3 { panic(146535); };
    s = ecs_systems_ext_deep_get(s, 2);
    if ecs_systems_ext_deep_get_entry_system_id(s) != 3 { panic(146536); };
    if ecs_systems_ext_deep_get_entry_system_name(s) != 33 { panic(146537); };
    if ecs_systems_ext_deep_get_entry_is_exclusive(s) != false { panic(146538); };
}

@test "systems_get_not_found"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(9, 91, false));
    s = ecs_systems_ext_deep_get(s, 5);
    if ecs_systems_ext_deep_get_found(s) != false { panic(146540); };
    if ecs_systems_ext_deep_get_entry_system_id(s) != 0 { panic(146541); };
}

@test "systems_set_system"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(1, 11, false));
    s = ecs_systems_ext_deep_set_system(s, 0, ecs_systems_ext_deep_entry(99, 999, true));
    s = ecs_systems_ext_deep_get(s, 0);
    if ecs_systems_ext_deep_get_entry_system_id(s) != 99 { panic(146545); };
    if ecs_systems_ext_deep_get_entry_system_name(s) != 999 { panic(146546); };
    if ecs_systems_ext_deep_get_entry_is_exclusive(s) != true { panic(146547); };
}

@test "systems_has_conditions_initial_and_add"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(1, 11, false));
    if ecs_systems_ext_deep_has_conditions(s, 0) != false { panic(146550); };
    if ecs_systems_ext_deep_condition_count(s, 0) != 0 { panic(146551); };
    s = ecs_systems_ext_deep_add_condition(s, 0, ecs_node_set_cond_deep_new(101));
    if ecs_systems_ext_deep_condition_count(s, 0) != 1 { panic(146552); };
    if ecs_systems_ext_deep_has_conditions(s, 0) != true { panic(146553); };
    s = ecs_systems_ext_deep_add_condition(s, 0, ecs_node_set_cond_deep_new(102));
    if ecs_systems_ext_deep_condition_count(s, 0) != 2 { panic(146554); };
}

@test "systems_add_condition_second_entry"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(1, 11, false));
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(2, 22, true));
    s = ecs_systems_ext_deep_add_condition(s, 1, ecs_node_set_cond_deep_new(201));
    s = ecs_systems_ext_deep_add_condition(s, 0, ecs_node_set_cond_deep_new(202));
    if ecs_systems_ext_deep_condition_count(s, 1) != 1 { panic(146555); };
    if ecs_systems_ext_deep_condition_count(s, 0) != 1 { panic(146556); };
}

@test "systems_remove_found_and_uninit"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(1, 11, false));
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(2, 22, true));
    if ecs_systems_ext_deep_uninit_count(s) != 2 { panic(146560); };
    if ecs_systems_ext_deep_is_initialized(s) != false { panic(146561); };
    s = ecs_systems_ext_deep_remove(s, 0);
    if ecs_systems_ext_deep_last_remove_found(s) != true { panic(146562); };
    if ecs_systems_ext_deep_uninit_count(s) != 1 { panic(146563); };
    s = ecs_systems_ext_deep_get(s, 0);
    if ecs_systems_ext_deep_get_entry_system_id(s) != 0 { panic(146564); };
}

@test "systems_remove_not_found"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_remove(s, 0);
    if ecs_systems_ext_deep_last_remove_found(s) != false { panic(146565); };
}

@test "systems_initialize"() {
    let s = ecs_systems_ext_deep_new();
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(1, 11, false));
    s = ecs_systems_ext_deep_insert(s, ecs_systems_ext_deep_entry(2, 22, true));
    if ecs_systems_ext_deep_is_initialized(s) != false { panic(146570); };
    s = ecs_systems_ext_deep_initialize(s);
    if ecs_systems_ext_deep_is_initialized(s) != true { panic(146571); };
    if ecs_systems_ext_deep_uninit_count(s) != 0 { panic(146572); };
}

@test "conflicting_systems_new_empty"() {
    let c = ecs_conflicting_systems_deep_new();
    if ecs_conflicting_systems_deep_len(c) != 0 { panic(146580); };
    if ecs_conflicting_systems_deep_is_empty(c) != true { panic(146581); };
    if ecs_conflicting_systems_deep_check_if_not_empty(c) != 0 { panic(146582); };
}

@test "conflicting_systems_push_get"() {
    let c = ecs_conflicting_systems_deep_new();
    c = ecs_conflicting_systems_deep_push(c, 10, 20, 2, 100, 200, 0, 0);
    if ecs_conflicting_systems_deep_len(c) != 1 { panic(146585); };
    if ecs_conflicting_systems_deep_is_empty(c) != false { panic(146586); };
    if ecs_conflicting_systems_deep_check_if_not_empty(c) != 1 { panic(146587); };
    c = ecs_conflicting_systems_deep_get(c, 0);
    if ecs_conflicting_systems_deep_last_get_a(c) != 10 { panic(146588); };
    if ecs_conflicting_systems_deep_last_get_b(c) != 20 { panic(146589); };
    if ecs_conflicting_systems_deep_last_get_conflict_count(c) != 2 { panic(146590); };
}

@test "conflicting_systems_push_two"() {
    let c = ecs_conflicting_systems_deep_new();
    c = ecs_conflicting_systems_deep_push(c, 1, 2, 1, 50, 0, 0, 0);
    c = ecs_conflicting_systems_deep_push(c, 3, 4, 1, 60, 0, 0, 0);
    if ecs_conflicting_systems_deep_len(c) != 2 { panic(146591); };
    c = ecs_conflicting_systems_deep_get(c, 1);
    if ecs_conflicting_systems_deep_last_get_a(c) != 3 { panic(146592); };
    if ecs_conflicting_systems_deep_last_get_b(c) != 4 { panic(146593); };
    if ecs_conflicting_systems_deep_last_get_conflict_count(c) != 1 { panic(146594); };
}

@test "conflicting_systems_to_string_count"() {
    let c = ecs_conflicting_systems_deep_new();
    c = ecs_conflicting_systems_deep_push(c, 1, 2, 0, 0, 0, 0, 0);
    c = ecs_conflicting_systems_deep_push(c, 3, 4, 0, 0, 0, 0, 0);
    if ecs_conflicting_systems_deep_to_string_count(c) != 2 { panic(146595); };
}

@test "system_access_new_and_read_write"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_read(a, 5);
    a = ecs_system_access_deep_add_write(a, 10);
    a = ecs_system_access_deep_add_read(a, 15);
    a = ecs_system_access_deep_add_write(a, 20);
    // Verify via get_conflicts semantics — empty vs empty has no conflicts.
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_read(b, 99);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != true { panic(146600); };
    if ecs_access_conflict_result_deep_count(r) != 0 { panic(146601); };
}

@test "system_access_read_read_no_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_read(a, 1);
    a = ecs_system_access_deep_add_read(a, 2);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_read(b, 1);
    b = ecs_system_access_deep_add_read(b, 2);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != true { panic(146605); };
    if ecs_access_conflict_result_deep_count(r) != 0 { panic(146606); };
}

@test "system_access_write_write_same_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_write(a, 7);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_write(b, 7);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != true { panic(146610); };
    if ecs_access_conflict_result_deep_count(r) != 1 { panic(146611); };
    if ecs_access_conflict_result_deep_cf(r, 0) != 7 { panic(146612); };
}

@test "system_access_write_read_same_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_write(a, 9);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_read(b, 9);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != true { panic(146615); };
    if ecs_access_conflict_result_deep_count(r) != 1 { panic(146616); };
    if ecs_access_conflict_result_deep_cf(r, 0) != 9 { panic(146617); };
}

@test "system_access_disjoint_no_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_read(a, 1);
    a = ecs_system_access_deep_add_write(a, 2);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_read(b, 3);
    b = ecs_system_access_deep_add_write(b, 4);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != true { panic(146620); };
    if ecs_access_conflict_result_deep_count(r) != 0 { panic(146621); };
}

@test "system_access_writes_all_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_set_writes_all(a);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_write(b, 3);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != false { panic(146625); };
    if ecs_access_conflict_result_deep_count(r) != 0 { panic(146626); };
}

@test "system_access_reads_all_writes_all_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_set_reads_all(a);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_set_writes_all(b);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != false { panic(146630); };
}

@test "system_access_writes_all_reads_conflict"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_write(a, 11);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_set_writes_all(b);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != false { panic(146635); };
}

@test "system_access_multiple_conflicts"() {
    let a = ecs_system_access_deep_new();
    a = ecs_system_access_deep_add_write(a, 1);
    a = ecs_system_access_deep_add_write(a, 2);
    a = ecs_system_access_deep_add_write(a, 3);
    let b = ecs_system_access_deep_new();
    b = ecs_system_access_deep_add_write(b, 1);
    b = ecs_system_access_deep_add_write(b, 2);
    b = ecs_system_access_deep_add_write(b, 3);
    let r = ecs_system_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_result_deep_is_individual(r) != true { panic(146640); };
    if ecs_access_conflict_result_deep_count(r) != 3 { panic(146641); };
}

@test "system_sets_new_empty"() {
    let s = ecs_system_sets_deep_new();
    if ecs_system_sets_deep_len(s) != 0 { panic(146650); };
    if ecs_system_sets_deep_is_empty(s) != true { panic(146651); };
}

@test "system_sets_get_key_or_insert_new"() {
    let s = ecs_system_sets_deep_new();
    s = ecs_system_sets_deep_get_key_or_insert(s, 100);
    if ecs_system_sets_deep_last_get_or_insert_key(s) != 0 { panic(146655); };
    if ecs_system_sets_deep_len(s) != 1 { panic(146656); };
    if ecs_system_sets_deep_contains(s, 100) != true { panic(146657); };
    if ecs_system_sets_deep_get_index(s, 100) != 0 { panic(146658); };
}

@test "system_sets_get_key_or_insert_existing"() {
    let s = ecs_system_sets_deep_new();
    s = ecs_system_sets_deep_get_key_or_insert(s, 200);
    s = ecs_system_sets_deep_get_key_or_insert(s, 200);
    if ecs_system_sets_deep_len(s) != 1 { panic(146660); };
    if ecs_system_sets_deep_last_get_or_insert_key(s) != 0 { panic(146661); };
}

@test "system_sets_get_key_or_insert_multiple"() {
    let s = ecs_system_sets_deep_new();
    s = ecs_system_sets_deep_get_key_or_insert(s, 1);
    s = ecs_system_sets_deep_get_key_or_insert(s, 2);
    s = ecs_system_sets_deep_get_key_or_insert(s, 3);
    if ecs_system_sets_deep_len(s) != 3 { panic(146665); };
    if ecs_system_sets_deep_get_index(s, 2) != 1 { panic(146666); };
    if ecs_system_sets_deep_get_index(s, 3) != 2 { panic(146667); };
    if ecs_system_sets_deep_get_set_id(s, 0) != 1 { panic(146668); };
    if ecs_system_sets_deep_get_set_id(s, 2) != 3 { panic(146669); };
}

@test "system_sets_set_get_is_system_type"() {
    let s = ecs_system_sets_deep_new();
    s = ecs_system_sets_deep_get_key_or_insert(s, 50);
    if ecs_system_sets_deep_get_is_system_type(s, 0) != false { panic(146670); };
    s = ecs_system_sets_deep_set_is_system_type(s, 0, true);
    if ecs_system_sets_deep_get_is_system_type(s, 0) != true { panic(146671); };
    s = ecs_system_sets_deep_set_is_system_type(s, 0, false);
    if ecs_system_sets_deep_get_is_system_type(s, 0) != false { panic(146672); };
}

@test "system_sets_get_set_id_not_found"() {
    let s = ecs_system_sets_deep_new();
    s = ecs_system_sets_deep_get_key_or_insert(s, 1);
    if ecs_system_sets_deep_get_set_id(s, 5) != (0 - 1) { panic(146675); };
}

@test "system_sets_initialize"() {
    let s = ecs_system_sets_deep_new();
    if ecs_system_sets_deep_is_initialized(s) != true { panic(146680); };
    if ecs_system_sets_deep_uninit_count(s) != 0 { panic(146681); };
    s = ecs_system_sets_deep_initialize(s);
    if ecs_system_sets_deep_is_initialized(s) != true { panic(146682); };
}

@test "ambiguity_error_new_and_key"() {
    let e = ecs_system_type_set_ambiguity_error_deep_new(999);
    if ecs_system_type_set_ambiguity_error_deep_key(e) != 999 { panic(146690); };
    let e2 = ecs_system_type_set_ambiguity_error_deep_new(0);
    if ecs_system_type_set_ambiguity_error_deep_key(e2) != 0 { panic(146691); };
}
