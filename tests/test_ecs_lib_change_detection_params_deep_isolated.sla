@import "lib/change_detection_params_deep.sla"

// Batch 224: change_detection params deep (src/change_detection/params.rs).
// panic codes: 110800 – 110999.

@test "ref_detect_changes"() {
    let r = ecs_cdp_ref_new(10, 5, 5, 3, 10);
    if ecs_cdp_ptr_is_added(r) != true { panic(110800); };
    if ecs_cdp_ptr_is_changed(r) != true { panic(110801); };
    if ecs_cdp_ref_into_inner(r) != 10 { panic(110802); };
}

@test "mut_set_changed_and_bypass"() {
    let m = ecs_cdp_mut_new(1, 1, 1, 5, 10);
    m = ecs_cdp_mut_set_changed(m);
    if ecs_cdp_ptr_changed(m) != 10 { panic(110810); };
    m = ecs_cdp_mut_bypass(m, 99);
    if ecs_cdp_ptr_value(m) != 99 { panic(110811); };
    if ecs_cdp_ptr_changed(m) != 10 { panic(110812); };
}

@test "mut_set_if_neq"() {
    let m = ecs_cdp_mut_new(3, 0, 0, 0, 7);
    let r1 = ecs_cdp_mut_set_if_neq(m, 3);
    if r1.1 != false { panic(110820); };
    let r2 = ecs_cdp_mut_set_if_neq(r1.0, 4);
    if r2.1 != true { panic(110821); };
    if ecs_cdp_ptr_value(r2.0) != 4 { panic(110822); };
    if ecs_cdp_ptr_changed(r2.0) != 7 { panic(110823); };
}

@test "mut_map_unchanged_no_flag"() {
    let m = ecs_cdp_mut_new(1, 2, 2, 0, 9);
    m = ecs_cdp_mut_map_unchanged(m, 50);
    if ecs_cdp_ptr_value(m) != 50 { panic(110830); };
    if ecs_cdp_ptr_changed(m) != 2 { panic(110831); };
}

@test "mut_set_added_and_last"() {
    let m = ecs_cdp_mut_new(0, 1, 2, 0, 10);
    m = ecs_cdp_mut_set_added(m);
    if ecs_cdp_ptr_added(m) != 10 { panic(110840); };
    if ecs_cdp_ptr_changed(m) != 10 { panic(110841); };
    m = ecs_cdp_mut_set_last_changed(m, 4);
    if ecs_cdp_ptr_changed(m) != 4 { panic(110842); };
    m = ecs_cdp_mut_set_last_added(m, 3);
    if ecs_cdp_ptr_added(m) != 3 { panic(110843); };
    if ecs_cdp_ptr_changed(m) != 3 { panic(110844); };
}

@test "mut_as_ref_and_reborrow"() {
    let m = ecs_cdp_mut_new(8, 1, 2, 0, 5);
    let r = ecs_cdp_mut_as_ref(m);
    if ecs_cdp_ptr_value(r) != 8 { panic(110850); };
    let b = ecs_cdp_mut_reborrow(m);
    if ecs_cdp_ptr_value(b) != 8 { panic(110851); };
}

@test "mut_untyped_ops"() {
    let u = ecs_cdp_mut_untyped_new(1, 1, 1, 0, 6);
    u = ecs_cdp_mut_untyped_set_changed(u);
    if ecs_cdp_ptr_is_changed(u) != true { panic(110860); };
    u = ecs_cdp_mut_untyped_map_unchanged(u, 9);
    if ecs_cdp_ptr_value(u) != 9 { panic(110861); };
    if ecs_cdp_mut_untyped_into_inner(u) != 9 { panic(110862); };
}

@test "res_and_res_mut"() {
    let r = ecs_cdp_res_new(11, 2, 2, 1, 5);
    if ecs_cdp_param_kind(r) != ecs_cdp_kind_res() { panic(110870); };
    if ecs_cdp_param_is_changed(r) != true { panic(110871); };
    if ecs_cdp_res_into_inner(r) != 11 { panic(110872); };
    let m = ecs_cdp_res_mut_new(0, 0, 0, 0, 3);
    if ecs_cdp_param_kind(m) != ecs_cdp_kind_res_mut() { panic(110873); };
    let r2 = ecs_cdp_param_set_if_neq(m, 5);
    if r2.1 != true { panic(110874); };
    if ecs_cdp_param_value(r2.0) != 5 { panic(110875); };
}

@test "nonsend_mut"() {
    let n = ecs_cdp_nonsend_mut_new(7, 1, 1, 0, 4);
    if ecs_cdp_param_kind(n) != ecs_cdp_kind_nonsend_mut() { panic(110880); };
    n = ecs_cdp_param_set_changed(n);
    if ecs_cdp_ptr_changed(ecs_cdp_param_ptr(n)) != 4 { panic(110881); };
}

@test "is_after"() {
    let p = ecs_cdp_ptr_new(0, 2, 8, 0, 10);
    if ecs_cdp_ptr_is_changed_after(p, 5) != true { panic(110890); };
    if ecs_cdp_ptr_is_changed_after(p, 9) != false { panic(110891); };
    if ecs_cdp_ptr_is_added_after(p, 1) != true { panic(110892); };
}

@test "caller_on_set_changed"() {
    let m = ecs_cdp_mut_new(0, 0, 0, 0, 2);
    m = ecs_cdp_mut_set_changed_with_caller(m, 77);
    if ecs_cdp_ptr_has_caller(m) != true { panic(110900); };
    if ecs_cdp_ptr_changed_by(m) != 77 { panic(110901); };
}

@test "deref_mut_write"() {
    let m = ecs_cdp_mut_new(0, 0, 0, 0, 5);
    m = ecs_cdp_mut_deref_mut(m, 42);
    if ecs_cdp_ptr_value(m) != 42 { panic(110910); };
    if ecs_cdp_ptr_changed(m) != 5 { panic(110911); };
}

@test "contig_push_and_flags"() {
    let c = ecs_cdp_contig_new(3, 10);
    c = ecs_cdp_contig_push(c, 5, 5);
    c = ecs_cdp_contig_push(c, 1, 8);
    if ecs_cdp_contig_len(c) != 2 { panic(110920); };
    if ecs_cdp_contig_is_added_at(c, 0) != true { panic(110921); };
    if ecs_cdp_contig_is_added_at(c, 1) != false { panic(110922); };
    if ecs_cdp_contig_is_changed_at(c, 1) != true { panic(110923); };
}

@test "contig_mark_changed"() {
    let c = ecs_cdp_contig_new(5, 10);
    c = ecs_cdp_contig_push(c, 1, 1);
    c = ecs_cdp_contig_mark_changed_at(c, 0);
    if ecs_cdp_contig_is_changed_at(c, 0) != true { panic(110930); };
}

@test "param_bypass_no_change"() {
    let m = ecs_cdp_res_mut_new(1, 0, 0, 0, 8);
    m = ecs_cdp_param_bypass(m, 2);
    if ecs_cdp_param_value(m) != 2 { panic(110940); };
    if ecs_cdp_param_is_changed(m) != false { panic(110941); };
}
