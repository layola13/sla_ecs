@import "lib/world_mut_deep.sla"

// Isolated deep EntityWorldMut tests.
// panic codes: 121600 – 121799.

@test "ewm_deep new id and spawned"() {
    let m = ecs_ewm_deep_new(42);
    if ecs_ewm_deep_id(m) != 42 { panic(121600); };
    if ecs_ewm_deep_is_spawned(m) != true { panic(121601); };
    if ecs_ewm_deep_is_despawned(m) != false { panic(121602); };
    if ecs_ewm_deep_len(m) != 0 { panic(121603); };
}

@test "ewm_deep location archetype and meta"() {
    let m = ecs_ewm_deep_new(7);
    let m2 = ecs_ewm_deep_with_meta(m, 5, 3, 99, 11);
    if ecs_ewm_deep_archetype(m2) != 5 { panic(121610); };
    if ecs_ewm_deep_location_row(m2) != 3 { panic(121611); };
    if ecs_ewm_deep_spawned_by(m2) != 99 { panic(121612); };
    if ecs_ewm_deep_spawn_tick(m2) != 11 { panic(121613); };
    let loc = ecs_ewm_deep_try_location(m2);
    if ecs_ewm_loc_ok(loc) != true { panic(121614); };
    if ecs_ewm_loc_archetype(loc) != 5 { panic(121615); };
    if ecs_ewm_loc_row(loc) != 3 { panic(121616); };
    let empty = ecs_ewm_deep_new_empty(1);
    let tl = ecs_ewm_deep_try_location(empty);
    if ecs_ewm_loc_ok(tl) != false { panic(121617); };
    let ta = ecs_ewm_deep_try_archetype(empty);
    if ecs_ewm_loc_ok(ta) != false { panic(121618); };
}

@test "ewm_deep insert get contains set"() {
    let m = ecs_ewm_deep_new(1);
    let m2 = ecs_ewm_deep_insert(m, 10, 100, 1, 2);
    if ecs_ewm_deep_contains(m2, 10) != true { panic(121620); };
    if ecs_ewm_deep_contains_id(m2, 10) != true { panic(121621); };
    if ecs_ewm_deep_len(m2) != 1 { panic(121622); };
    let g = ecs_ewm_deep_get(m2, 10);
    if ecs_ewm_get_found(g) != true { panic(121623); };
    if ecs_ewm_get_value(g) != 100 { panic(121624); };
    if ecs_ewm_get_added(g) != 1 { panic(121625); };
    if ecs_ewm_get_changed(g) != 2 { panic(121626); };
    let sr = ecs_ewm_deep_set(m2, 10, 200, 5);
    if ecs_ewm_set_ok(sr) != true { panic(121627); };
    let m3 = ecs_ewm_set_view(sr);
    let g2 = ecs_ewm_deep_get_mut(m3, 10);
    if ecs_ewm_get_value(g2) != 200 { panic(121628); };
    if ecs_ewm_get_changed(g2) != 5 { panic(121629); };
}

@test "ewm_deep insert_if_new and multi components"() {
    let m = ecs_ewm_deep_new(2);
    let m1 = ecs_ewm_deep_insert(m, 1, 10, 0, 0);
    let m2 = ecs_ewm_deep_insert(m1, 2, 20, 0, 0);
    let m3 = ecs_ewm_deep_insert_if_new(m2, 1, 999, 0, 0);
    let g = ecs_ewm_deep_get(m3, 1);
    if ecs_ewm_get_value(g) != 10 { panic(121630); };
    let m4 = ecs_ewm_deep_insert_if_new(m3, 3, 30, 0, 0);
    if ecs_ewm_deep_len(m4) != 3 { panic(121631); };
    if ecs_ewm_deep_contains(m4, 3) != true { panic(121632); };
    if ecs_ewm_deep_component_at(m4, 0) != 1 { panic(121633); };
    if ecs_ewm_deep_component_at(m4, 2) != 3 { panic(121634); };
}

@test "ewm_deep remove take clear retain"() {
    let m = ecs_ewm_deep_new(3);
    let m1 = ecs_ewm_deep_insert(m, 1, 11, 0, 0);
    let m2 = ecs_ewm_deep_insert(m1, 2, 22, 0, 0);
    let m3 = ecs_ewm_deep_insert(m2, 3, 33, 0, 0);
    let rr = ecs_ewm_deep_remove(m3, 2);
    if ecs_ewm_remove_ok(rr) != true { panic(121640); };
    if ecs_ewm_remove_value(rr) != 22 { panic(121641); };
    let m4 = ecs_ewm_remove_view(rr);
    if ecs_ewm_deep_contains(m4, 2) != false { panic(121642); };
    if ecs_ewm_deep_len(m4) != 2 { panic(121643); };
    let tr = ecs_ewm_deep_take(m4, 1);
    if ecs_ewm_remove_ok(tr) != true { panic(121644); };
    if ecs_ewm_remove_value(tr) != 11 { panic(121645); };
    let m5 = ecs_ewm_remove_view(tr);
    let m6 = ecs_ewm_deep_insert(m5, 4, 44, 0, 0);
    let m7 = ecs_ewm_deep_retain(m6, 3);
    if ecs_ewm_deep_len(m7) != 1 { panic(121646); };
    if ecs_ewm_deep_contains(m7, 3) != true { panic(121647); };
    if ecs_ewm_deep_contains(m7, 4) != false { panic(121648); };
    let m8 = ecs_ewm_deep_clear(m7);
    if ecs_ewm_deep_len(m8) != 0 { panic(121649); };
}

@test "ewm_deep despawn flush and update_location"() {
    let m = ecs_ewm_deep_new(8);
    let m1 = ecs_ewm_deep_insert(m, 9, 90, 0, 0);
    let m2 = ecs_ewm_deep_with_meta(m1, 2, 4, 1, 2);
    let m3 = ecs_ewm_deep_update_location(m2);
    if ecs_ewm_deep_archetype(m3) != 2 { panic(121650); };
    if ecs_ewm_deep_flush(m3) != 8 { panic(121651); };
    let m4 = ecs_ewm_deep_despawn(m3);
    if ecs_ewm_deep_is_despawned(m4) != true { panic(121652); };
    if ecs_ewm_deep_is_spawned(m4) != false { panic(121653); };
    if ecs_ewm_deep_len(m4) != 0 { panic(121654); };
    if ecs_ewm_deep_id(m4) != 8 { panic(121655); };
    let m5 = ecs_ewm_deep_despawn_no_free(ecs_ewm_deep_new(9));
    if ecs_ewm_deep_is_despawned(m5) != true { panic(121656); };
}

@test "ewm_deep readonly mutable filtered reborrow"() {
    let m = ecs_ewm_deep_new(4);
    let m1 = ecs_ewm_deep_insert(m, 1, 5, 0, 0);
    let ro = ecs_ewm_deep_into_readonly(m1);
    if ecs_ewm_deep_is_readonly(ro) != true { panic(121660); };
    let g = ecs_ewm_deep_get_ref(ro, 1);
    if ecs_ewm_get_value(g) != 5 { panic(121661); };
    let mutv = ecs_ewm_deep_into_mutable(ro);
    if ecs_ewm_deep_is_readonly(mutv) != false { panic(121662); };
    let f = ecs_ewm_deep_into_filtered(mutv);
    if ecs_ewm_deep_is_filtered(f) != true { panic(121663); };
    let rb = ecs_ewm_deep_reborrow(f);
    if ecs_ewm_deep_id(rb) != 4 { panic(121664); };
    if ecs_ewm_deep_is_filtered(rb) != true { panic(121665); };
    let ar = ecs_ewm_deep_as_readonly(rb);
    if ecs_ewm_deep_is_readonly(ar) != true { panic(121666); };
}

@test "ewm_deep world resources"() {
    let m = ecs_ewm_deep_new(5);
    let m1 = ecs_ewm_deep_resource_insert(m, 100, 1000);
    if ecs_ewm_deep_resource_len(m1) != 1 { panic(121670); };
    let g = ecs_ewm_deep_resource_get(m1, 100);
    if ecs_ewm_res_found(g) != true { panic(121671); };
    if ecs_ewm_res_value(g) != 1000 { panic(121672); };
    let m2 = ecs_ewm_deep_resource_insert(m1, 200, 2000);
    if ecs_ewm_deep_resource_len(m2) != 2 { panic(121673); };
    let g2 = ecs_ewm_deep_resource_get(m2, 200);
    if ecs_ewm_res_value(g2) != 2000 { panic(121674); };
    let m3 = ecs_ewm_deep_resource_insert(m2, 100, 1111);
    let g3 = ecs_ewm_deep_resource_get(m3, 100);
    if ecs_ewm_res_value(g3) != 1111 { panic(121675); };
    let miss = ecs_ewm_deep_resource_get(m3, 999);
    if ecs_ewm_res_found(miss) != false { panic(121676); };
}

@test "ewm_deep clone and move components"() {
    let src = ecs_ewm_deep_new(10);
    let src1 = ecs_ewm_deep_insert(src, 7, 70, 1, 2);
    let src2 = ecs_ewm_deep_insert(src1, 8, 80, 3, 4);
    let tgt = ecs_ewm_deep_new(11);
    let tgt1 = ecs_ewm_deep_clone_components(src2, tgt, 7);
    if ecs_ewm_deep_contains(tgt1, 7) != true { panic(121680); };
    let gt = ecs_ewm_deep_get(tgt1, 7);
    if ecs_ewm_get_value(gt) != 70 { panic(121681); };
    // source still has component after clone
    if ecs_ewm_deep_contains(src2, 7) != true { panic(121682); };
    let mv = ecs_ewm_deep_move_components(src2, tgt1, 8);
    if ecs_ewm_move_ok(mv) != true { panic(121683); };
    let src3 = ecs_ewm_move_source(mv);
    let tgt2 = ecs_ewm_move_target(mv);
    if ecs_ewm_deep_contains(src3, 8) != false { panic(121684); };
    if ecs_ewm_deep_contains(tgt2, 8) != true { panic(121685); };
    let gt2 = ecs_ewm_deep_get(tgt2, 8);
    if ecs_ewm_get_value(gt2) != 80 { panic(121686); };
}

@test "ewm_deep eq cmp change ticks into_mut"() {
    let a = ecs_ewm_deep_new(1);
    let b = ecs_ewm_deep_new(2);
    let a1 = ecs_ewm_deep_insert(a, 9, 90, 5, 6);
    if ecs_ewm_deep_eq(a1, a1) != true { panic(121690); };
    if ecs_ewm_deep_eq(a1, b) != false { panic(121691); };
    if ecs_ewm_deep_cmp(a1, b) != -1 { panic(121692); };
    if ecs_ewm_deep_cmp(b, a1) != 1 { panic(121693); };
    if ecs_ewm_deep_cmp(a1, a1) != 0 { panic(121694); };
    let ct = ecs_ewm_deep_get_change_ticks(a1, 9);
    if ecs_ewm_get_added(ct) != 5 { panic(121695); };
    if ecs_ewm_get_changed(ct) != 6 { panic(121696); };
    let im = ecs_ewm_deep_into_mut(a1, 9);
    if ecs_ewm_get_found(im) != true { panic(121697); };
    if ecs_ewm_get_value(im) != 90 { panic(121698); };
    let miss = ecs_ewm_deep_get_by_id(a1, 99);
    if ecs_ewm_get_found(miss) != false { panic(121699); };
}
