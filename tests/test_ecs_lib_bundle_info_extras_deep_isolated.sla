@import "lib/bundle_info_extras_deep.sla"

// Batch 296: bundle_info_extras deep.
// panic codes: 125200 – 125399.

@test "empty_bundles"() {
    let b = ecs_bie_deep_new();
    if ecs_bie_deep_is_empty(b) != true { panic(125200); };
    if ecs_bie_deep_len(b) != 0 { panic(125201); };
}

@test "info_explicit_required_split"() {
    let info = ecs_bie_info_new(1, 10, 11, 2, 20, 21, 2);
    if ecs_bie_info_id(info) != 1 { panic(125210); };
    if ecs_bie_info_explicit_count(info) != 2 { panic(125211); };
    if ecs_bie_info_required_count(info) != 2 { panic(125212); };
    if ecs_bie_info_total(info) != 4 { panic(125213); };
    if ecs_bie_info_explicit_at(info, 0) != 10 { panic(125214); };
    if ecs_bie_info_explicit_at(info, 1) != 11 { panic(125215); };
    if ecs_bie_info_required_at(info, 0) != 20 { panic(125216); };
    if ecs_bie_info_required_at(info, 1) != 21 { panic(125217); };
}

@test "info_contains_and_at"() {
    let info = ecs_bie_info_new(2, 5, -1, 1, 6, -1, 1);
    if ecs_bie_info_contains(info, 5) != true { panic(125220); };
    if ecs_bie_info_contains(info, 6) != true { panic(125221); };
    if ecs_bie_info_contains(info, 7) != false { panic(125222); };
    if ecs_bie_info_at(info, 0) != 5 { panic(125223); };
    if ecs_bie_info_at(info, 1) != 6 { panic(125224); };
}

@test "register_and_get"() {
    let b = ecs_bie_deep_new();
    let info = ecs_bie_info_new(3, 1, 2, 2, 0, 0, 0);
    let r = ecs_bie_deep_register(b, info);
    if ecs_bie_get_ok(r) != true { panic(125230); };
    b = ecs_bie_get_world(r);
    if ecs_bie_deep_len(b) != 1 { panic(125231); };
    let g = ecs_bie_deep_get(b, 3);
    if ecs_bie_get_ok(g) != true { panic(125232); };
    if ecs_bie_info_explicit_count(ecs_bie_get_info(g)) != 2 { panic(125233); };
}

@test "register_replace_same_id"() {
    let b = ecs_bie_deep_new();
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(1, 1, -1, 1, 0, 0, 0)));
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(1, 9, 8, 2, 0, 0, 0)));
    if ecs_bie_deep_len(b) != 1 { panic(125240); };
    if ecs_bie_info_explicit_at(ecs_bie_get_info(ecs_bie_deep_get(b, 1)), 0) != 9 { panic(125241); };
}

@test "type_id_mapping"() {
    let b = ecs_bie_deep_new();
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(10, 1, -1, 1, 0, 0, 0)));
    b = ecs_bie_get_world(ecs_bie_deep_register_type(b, 100, 10));
    let g = ecs_bie_deep_get_id(b, 100);
    if ecs_bie_get_ok(g) != true { panic(125250); };
    if ecs_bie_get_bundle_id(g) != 10 { panic(125251); };
    let miss = ecs_bie_deep_get_id(b, 999);
    if ecs_bie_get_ok(miss) != false { panic(125252); };
}

@test "type_id_replace"() {
    let b = ecs_bie_deep_new();
    b = ecs_bie_get_world(ecs_bie_deep_register_type(b, 1, 10));
    b = ecs_bie_get_world(ecs_bie_deep_register_type(b, 1, 20));
    if ecs_bie_deep_tlen(b) != 1 { panic(125260); };
    if ecs_bie_get_bundle_id(ecs_bie_deep_get_id(b, 1)) != 20 { panic(125261); };
}

@test "capacity_four_bundles"() {
    let b = ecs_bie_deep_new();
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(1, 1, -1, 1, 0, 0, 0)));
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(2, 2, -1, 1, 0, 0, 0)));
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(3, 3, -1, 1, 0, 0, 0)));
    b = ecs_bie_get_world(ecs_bie_deep_register(b, ecs_bie_info_new(4, 4, -1, 1, 0, 0, 0)));
    if ecs_bie_deep_len(b) != 4 { panic(125270); };
    let full = ecs_bie_deep_register(b, ecs_bie_info_new(5, 5, -1, 1, 0, 0, 0));
    if ecs_bie_get_ok(full) != false { panic(125271); };
    if ecs_bie_get_err(full) != 2 { panic(125272); };
}

@test "missing_get"() {
    let b = ecs_bie_deep_new();
    if ecs_bie_get_ok(ecs_bie_deep_get(b, 1)) != false { panic(125280); };
    if ecs_bie_get_err(ecs_bie_deep_get(b, 1)) != 1 { panic(125281); };
}

@test "id_index_helper"() {
    if ecs_bie_id_index(7) != 7 { panic(125290); };
    let info = ecs_bie_info_new(0, -1, -1, 0, 1, 2, 2);
    if ecs_bie_info_explicit_count(info) != 0 { panic(125291); };
    if ecs_bie_info_required_count(info) != 2 { panic(125292); };
}
