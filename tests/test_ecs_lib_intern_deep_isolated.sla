@import "lib/intern_deep.sla"

// Batch 197: Interner / Interned deep.

@test "interner_new_empty"() {
    let i = ecs_in_interner_new(1);
    if ecs_in_interner_len(i) != 0 { panic(105200); };
    if ecs_in_interner_id(i) != 1 { panic(105201); };
    if ecs_in_interner_leak_count(i) != 0 { panic(105202); };
}

@test "intern_dedups_same_value"() {
    let i = ecs_in_interner_new(1);
    let a = ecs_in_intern(i, 42);
    i = a.0;
    let b = ecs_in_intern(i, 42);
    i = b.0;
    if ecs_in_interned_eq(a.1, b.1) != true { panic(105210); };
    if ecs_in_interner_len(i) != 1 { panic(105211); };
    if ecs_in_interner_leak_count(i) != 1 { panic(105212); };
    if ecs_in_interner_hit_count(i) != 1 { panic(105213); };
}

@test "intern_different_values_neq"() {
    let i = ecs_in_interner_new(1);
    let a = ecs_in_intern(i, 1); i = a.0;
    let b = ecs_in_intern(i, 2); i = b.0;
    if ecs_in_interned_eq(a.1, b.1) != false { panic(105220); };
    if ecs_in_interner_len(i) != 2 { panic(105221); };
}

@test "different_interners_neq_even_if_same_content"() {
    let i1 = ecs_in_interner_new(1);
    let i2 = ecs_in_interner_new(2);
    let a = ecs_in_intern(i1, 42);
    let b = ecs_in_intern(i2, 42);
    if ecs_in_interned_eq(a.1, b.1) != false { panic(105230); };
    if ecs_in_interned_payload(a.1) != ecs_in_interned_payload(b.1) { panic(105231); };
}

@test "clone_equals_original"() {
    let i = ecs_in_interner_new(1);
    let a = ecs_in_intern(i, 7);
    let c = ecs_in_interned_clone(a.1);
    if ecs_in_interned_eq(a.1, c) != true { panic(105240); };
    if ecs_in_interned_hash(a.1) != ecs_in_interned_hash(c) { panic(105241); };
}

@test "from_ref_equals"() {
    let i = ecs_in_interner_new(1);
    let a = ecs_in_intern(i, 9);
    let b = ecs_in_interned_from_ref(a.1);
    if ecs_in_interned_eq(a.1, b) != true { panic(105250); };
}

@test "deref_returns_payload"() {
    let i = ecs_in_interner_new(1);
    let a = ecs_in_intern(i, 99);
    if ecs_in_interned_deref(a.1) != 99 { panic(105260); };
}

@test "raw_same_content_diff_ptr"() {
    let a = ecs_in_interned_raw(5, 1, 0);
    let b = ecs_in_interned_raw(5, 1, 1);
    if ecs_in_same_content_diff_ptr(a, b) != true { panic(105270); };
    if ecs_in_interned_eq(a, b) != false { panic(105271); };
}

@test "ref_eq_requires_leaked"() {
    let v1 = ecs_in_value(3);
    let v2 = ecs_in_value(3);
    if ecs_in_ref_eq(v1, v2) != false { panic(105280); };
    if ecs_in_value_eq(v1, v2) != true { panic(105281); };
}

@test "intern_then_ref_eq"() {
    let i = ecs_in_interner_new(3);
    let a = ecs_in_intern(i, 10); i = a.0;
    let b = ecs_in_intern(i, 10); i = b.0;
    let va = ecs_in_from_interned(a.1);
    let vb = ecs_in_from_interned(b.1);
    if ecs_in_ref_eq(va, vb) != true { panic(105290); };
    if ecs_in_ref_hash(va) != ecs_in_ref_hash(vb) { panic(105291); };
}

@test "default_interner"() {
    let i = ecs_in_interner_default();
    if ecs_in_interner_id(i) != 1 { panic(105300); };
}

@test "ne_helper"() {
    let a = ecs_in_interned_raw(1, 1, 0);
    let b = ecs_in_interned_raw(1, 2, 0);
    if ecs_in_interned_ne(a, b) != true { panic(105310); };
}

@test "multi_intern_sequence"() {
    let i = ecs_in_interner_new(5);
    let a = ecs_in_intern(i, 1); i = a.0;
    let b = ecs_in_intern(i, 2); i = b.0;
    let c = ecs_in_intern(i, 1); i = c.0;
    if ecs_in_interned_eq(a.1, c.1) != true { panic(105320); };
    if ecs_in_interner_len(i) != 2 { panic(105321); };
    if ecs_in_interner_leak_count(i) != 2 { panic(105322); };
    if ecs_in_interner_hit_count(i) != 1 { panic(105323); };
}

@test "same_instance_helper"() {
    let a = ecs_in_interned_raw(8, 1, 3);
    let b = ecs_in_interned_clone(a);
    if ecs_in_same_instance(a, b) != true { panic(105330); };
}

@test "payload_accessors"() {
    let v = ecs_in_value(12);
    if ecs_in_payload(v) != 12 { panic(105340); };
    if ecs_in_is_leaked(v) != false { panic(105341); };
    if ecs_in_slot(v) != -1 { panic(105342); };
}

@test "lifecycle_two_interners"() {
    let i1 = ecs_in_interner_new(10);
    let i2 = ecs_in_interner_new(20);
    let a = ecs_in_intern(i1, 100); i1 = a.0;
    let b = ecs_in_intern(i1, 100); i1 = b.0;
    let c = ecs_in_intern(i2, 100); i2 = c.0;
    if ecs_in_interned_eq(a.1, b.1) != true { panic(105350); };
    if ecs_in_interned_eq(a.1, c.1) != false { panic(105351); };
    if ecs_in_interner_len(i1) != 1 { panic(105352); };
    if ecs_in_interner_len(i2) != 1 { panic(105353); };
}
