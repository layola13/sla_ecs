// Isolated deep tests for lib/reflect_bundle_deep.sla (Batch 412).
// Tests EcsReflectBundleDeep: new/id/add_component/component_count/component_at/
// insert(returns count)/is_registered; cap-16 enforcement.

@import "lib/reflect_bundle_deep.sla"

@test "new_id_and_empty"() {
    let b = ecs_reflect_bundle_deep_new(42);
    if ecs_reflect_bundle_deep_id(b) != 42 { panic(147090); };
    if ecs_reflect_bundle_deep_component_count(b) != 0 { panic(147091); };
    if ecs_reflect_bundle_deep_is_registered(b) != true { panic(147092); };
}

@test "add_component_grows_count"() {
    let b = ecs_reflect_bundle_deep_new(1);
    b = ecs_reflect_bundle_deep_add_component(b, 10);
    b = ecs_reflect_bundle_deep_add_component(b, 20);
    b = ecs_reflect_bundle_deep_add_component(b, 30);
    if ecs_reflect_bundle_deep_component_count(b) != 3 { panic(147093); };
}

@test "component_at_reads_in_order"() {
    let b = ecs_reflect_bundle_deep_new(1);
    b = ecs_reflect_bundle_deep_add_component(b, 100);
    b = ecs_reflect_bundle_deep_add_component(b, 200);
    b = ecs_reflect_bundle_deep_add_component(b, 300);
    if ecs_reflect_bundle_deep_component_at(b, 0) != 100 { panic(147094); };
    if ecs_reflect_bundle_deep_component_at(b, 1) != 200 { panic(147095); };
    if ecs_reflect_bundle_deep_component_at(b, 2) != 300 { panic(147096); };
}

@test "insert_returns_component_count"() {
    let b = ecs_reflect_bundle_deep_new(7);
    b = ecs_reflect_bundle_deep_add_component(b, 1);
    b = ecs_reflect_bundle_deep_add_component(b, 2);
    // Insert onto entity 500 returns the count of components the bundle inserts.
    let n = ecs_reflect_bundle_deep_insert(b, 500);
    if n != 2 { panic(147097); };
}

@test "is_registered_true_for_nonneg_id"() {
    let b0 = ecs_reflect_bundle_deep_new(0);
    if ecs_reflect_bundle_deep_is_registered(b0) != true { panic(147098); };
    let b1 = ecs_reflect_bundle_deep_new(1);
    if ecs_reflect_bundle_deep_is_registered(b1) != true { panic(147099); };
}

@test "is_registered_false_for_negative_id"() {
    let b = ecs_reflect_bundle_deep_new((0 - 1));
    if ecs_reflect_bundle_deep_is_registered(b) != false { panic(147100); };
}

@test "cap16_enforced_overflow_silent"() {
    let b = ecs_reflect_bundle_deep_new(1);
    let i: i32 = 0;
    while i < 16 {
        b = ecs_reflect_bundle_deep_add_component(b, i);
        i = i + 1;
    }
    if ecs_reflect_bundle_deep_component_count(b) != 16 { panic(147101); };
    // 17th add is silently dropped.
    b = ecs_reflect_bundle_deep_add_component(b, 99);
    if ecs_reflect_bundle_deep_component_count(b) != 16 { panic(147102); };
    // Last visible component is still 15 — the cap-guarded drop didn't bump the count.
    if ecs_reflect_bundle_deep_component_at(b, 15) != 15 { panic(147103); };
}
