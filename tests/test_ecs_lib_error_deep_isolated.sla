@import "lib/error_deep.sla"

// Batch 300: error deep composite.
// panic codes: 126000 – 126199.

@test "severity_helpers"() {
    if ecs_err_sev_is_error(ecs_err_sev_error()) != true { panic(126000); };
    if ecs_err_sev_is_error(ecs_err_sev_panic()) != true { panic(126001); };
    if ecs_err_sev_is_error(ecs_err_sev_warning()) != false { panic(126002); };
    if ecs_err_sev_is_warning(ecs_err_sev_warning()) != true { panic(126003); };
    if ecs_err_sev_is_info(ecs_err_sev_info()) != true { panic(126004); };
    if ecs_err_sev_ge(5, 4) != true { panic(126005); };
}

@test "bevy_error_with_context"() {
    let e = ecs_err_new(7, ecs_err_sev_error(), 100);
    if ecs_err_code(e) != 7 { panic(126010); };
    if ecs_err_is_error_level(e) != true { panic(126011); };
    e = ecs_err_with_context(e, 55);
    if ecs_err_has_context(e) != true { panic(126012); };
    if ecs_err_context_id(e) != 55 { panic(126013); };
    if ecs_err_is_panic(ecs_err_new(1, ecs_err_sev_panic(), 0)) != true { panic(126014); };
}

@test "error_context_kinds"() {
    let s = ecs_err_ctx_system(1);
    if ecs_err_ctx_kind(s) != 0 { panic(126020); };
    if ecs_err_ctx_has_entity(s) != false { panic(126021); };
    let o = ecs_err_ctx_observer(2, 9);
    if ecs_err_ctx_kind(o) != 2 { panic(126022); };
    if ecs_err_ctx_entity(o) != 9 { panic(126023); };
    let h = ecs_err_ctx_hook(3, 4);
    if ecs_err_ctx_kind(h) != 3 { panic(126024); };
    let c = ecs_err_ctx_command(8);
    if ecs_err_ctx_name(c) != 8 { panic(126025); };
}

@test "handler_ignore_policy"() {
    let h = ecs_err_handler_new(0, 0); // ignore
    let r = ecs_err_handler_handle(h, ecs_err_new(1, ecs_err_sev_error(), 0));
    if ecs_err_handle_ignored(r) != true { panic(126030); };
    if ecs_err_handle_should_panic(r) != false { panic(126031); };
    h = ecs_err_handle_handler(r);
    if ecs_err_handler_ignored(h) != 1 { panic(126032); };
}

@test "handler_min_severity"() {
    let h = ecs_err_handler_new(2, ecs_err_sev_error()); // error policy, min error
    let r = ecs_err_handler_handle(h, ecs_err_new(1, ecs_err_sev_warning(), 0));
    if ecs_err_handle_ignored(r) != true { panic(126040); };
    h = ecs_err_handle_handler(r);
    let r2 = ecs_err_handler_handle(h, ecs_err_new(2, ecs_err_sev_error(), 0));
    if ecs_err_handle_handled(r2) != true { panic(126041); };
    if ecs_err_handle_should_panic(r2) != false { panic(126042); };
}

@test "handler_panic_policy"() {
    let h = ecs_err_handler_new(3, 0);
    let r = ecs_err_handler_handle(h, ecs_err_new(9, ecs_err_sev_info(), 0));
    if ecs_err_handle_should_panic(r) != true { panic(126050); };
    if ecs_err_handler_last_code(ecs_err_handle_handler(r)) != 9 { panic(126051); };
}

@test "command_output_to_err"() {
    if ecs_err_out_is_ok(ecs_err_out_ok()) != true { panic(126060); };
    let e = ecs_err_out_err(42);
    if ecs_err_out_is_err(e) != true { panic(126061); };
    if ecs_err_out_code(e) != 42 { panic(126062); };
    let be = ecs_err_out_to_err(e);
    if ecs_err_code(be) != 42 { panic(126063); };
    if ecs_err_severity(be) != ecs_err_sev_error() { panic(126064); };
    let n = ecs_err_out_to_err(ecs_err_out_never());
    if ecs_err_is_panic(n) != true { panic(126065); };
}

@test "entity_command_output"() {
    let ok = ecs_err_eout_ok(7);
    if ecs_err_eout_is_ok(ok) != true { panic(126070); };
    if ecs_err_eout_entity(ok) != 7 { panic(126071); };
    let bad = ecs_err_eout_err(7, 3);
    if ecs_err_eout_is_ok(bad) != false { panic(126072); };
    let out = ecs_err_eout_into_result(bad);
    if ecs_err_out_is_err(out) != true { panic(126073); };
    if ecs_err_out_code(out) != 3 { panic(126074); };
}

@test "handler_error_sev_panic_escalates"() {
    let h = ecs_err_handler_new(2, 0);
    let r = ecs_err_handler_handle(h, ecs_err_new(1, ecs_err_sev_panic(), 0));
    if ecs_err_handle_should_panic(r) != true { panic(126080); };
}

@test "severity_constants_order"() {
    if ecs_err_sev_ignore() != 0 { panic(126090); };
    if ecs_err_sev_trace() != 1 { panic(126091); };
    if ecs_err_sev_panic() != 6 { panic(126092); };
}
