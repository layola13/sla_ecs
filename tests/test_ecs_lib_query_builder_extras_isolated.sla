@import "lib/query_builder_extras.sla"

// Isolated tests for lib/query_builder_extras.sla — id-by-id variants + World mut + access view + transmute/build.
// Bevy reference: src/query/builder.rs

@test "qb2_new_world"() {
    let qb = ecs_query_builder2_new(42);
    if ecs_query_builder2_world(qb) != 42 { panic(91145); };
    if ecs_query_builder2_data_count(qb) != 0 { panic(91146); };
}

@test "qb2_world_mut_updates_id"() {
    let qb = ecs_query_builder2_new(42);
    let qb2 = ecs_query_builder2_world_mut(qb, 99);
    if ecs_query_builder2_world(qb2) != 99 { panic(91147); };
}

@test "qb2_with_id"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_with_id(qb, 5);
    if ecs_query_builder2_with_count(qb2) != 1 { panic(91148); };
}

@test "qb2_without_id"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_without_id(qb, 7);
    if ecs_query_builder2_without_count(qb2) != 1 { panic(91149); };
}

@test "qb2_with_and_without_id"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_with_id(qb, 5);
    let qb3 = ecs_query_builder2_without_id(qb2, 7);
    let qb4 = ecs_query_builder2_with_id(qb3, 8);
    if ecs_query_builder2_with_count(qb4) != 2 { panic(91150); };
    if ecs_query_builder2_without_count(qb4) != 1 { panic(91151); };
}

@test "qb2_ref_id_then_mut_id"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_ref_id(qb, 10);
    let qb3 = ecs_query_builder2_mut_id(qb2, 20);
    if ecs_query_builder2_data_count(qb3) != 2 { panic(91152); };
}

@test "qb2_filter"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_filter(qb, 99);
    if ecs_query_builder2_with_count(qb2) != 1 { panic(91153); };
}

@test "qb2_optional"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_optional(qb);
    let qb3 = ecs_query_builder2_optional(qb2);
    if ecs_query_builder2_optional_count(qb3) != 2 { panic(91154); };
}

@test "qb2_and_then_or_groups"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_and(qb);
    let qb3 = ecs_query_builder2_or(qb2);
    if ecs_query_builder2_or_groups(qb3) != 2 { panic(91155); };
}

@test "qb2_extend_access_count"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_extend_access_count(qb, 4);
    let a = ecs_query_builder2_access(qb2);
    if a.0 != 0 { panic(91156); };
}

@test "qb2_access_view"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_data(qb, 1);
    let qb3 = ecs_query_builder2_with_id(qb2, 10);
    let qb4 = ecs_query_builder2_without_id(qb3, 20);
    let qb5 = ecs_query_builder2_or(qb4);
    let a = ecs_query_builder2_access(qb5);
    if a.0 != 1 { panic(91157); };
    if a.1 != 1 { panic(91158); };
    if a.2 != 1 { panic(91159); };
    if a.3 != 1 { panic(91160); };
}

@test "qb2_transmute_resets_data"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_data(qb, 1);
    let qb3 = ecs_query_builder2_data(qb2, 2);
    let qb4 = ecs_query_builder2_transmute(qb3);
    if ecs_query_builder2_data_count(qb4) != 0 { panic(91161); };
}

@test "qb2_transmute_filtered_resets_all"() {
    let qb = ecs_query_builder2_new(1);
    let qb2 = ecs_query_builder2_with_id(qb, 10);
    let qb3 = ecs_query_builder2_without_id(qb2, 20);
    let qb4 = ecs_query_builder2_transmute_filtered(qb3);
    if ecs_query_builder2_with_count(qb4) != 0 { panic(91162); };
    if ecs_query_builder2_without_count(qb4) != 0 { panic(91163); };
    if ecs_query_builder2_data_count(qb4) != 0 { panic(91164); };
}

@test "qb2_build_id_includes_totals"() {
    let qb = ecs_query_builder2_new(100);
    let qb2 = ecs_query_builder2_data(qb, 1);
    let qb3 = ecs_query_builder2_data(qb2, 2);
    let qb4 = ecs_query_builder2_with_id(qb3, 9);
    let bid = ecs_query_builder2_build(qb4);
    // bid = world_id (100) + (data_count 2 + with_count 1 + without_count 0) == 103
    if bid != 103 { panic(91165); };
}

@test "qb2_full_workflow"() {
    let qb0 = ecs_query_builder2_new(50);
    let qb1 = ecs_query_builder2_data(qb0, 1);
    let qb2 = ecs_query_builder2_ref_id(qb1, 2);
    let qb3 = ecs_query_builder2_mut_id(qb2, 3);
    let qb4 = ecs_query_builder2_with_id(qb3, 10);
    let qb5 = ecs_query_builder2_without_id(qb4, 20);
    let qb6 = ecs_query_builder2_with_id(qb5, 11);
    let qb7 = ecs_query_builder2_or(qb6);
    let a = ecs_query_builder2_access(qb7);
    if a.0 != 3 { panic(91166); };
    if a.1 != 2 { panic(91167); };
    if a.2 != 1 { panic(91168); };
    if a.3 != 1 { panic(91169); };
    let bid = ecs_query_builder2_build(qb7);
    if bid != 50 + 6 { panic(91170); };
}
