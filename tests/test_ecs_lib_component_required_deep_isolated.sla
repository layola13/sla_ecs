@import "lib/component_required_deep.sla"

// Batch 245: component_required deep (src/component/required.rs).
// panic codes: 115000 – 115199.

@test "register_direct_and_all"() {
    let r = ecs_rq_new();
    r = ecs_rq_register_direct(r, 10, 100);
    if ecs_rq_last_ok(r) != true { panic(115000); };
    if ecs_rq_direct_len(r) != 1 { panic(115001); };
    if ecs_rq_all_len(r) != 1 { panic(115002); };
    if ecs_rq_contains_direct(r, 10) != true { panic(115003); };
    if ecs_rq_contains_all(r, 10) != true { panic(115004); };
    let c = ecs_rq_constructor_of(r, 10);
    if c.0 != true { panic(115005); };
    if c.1 != 100 { panic(115006); };
}

@test "duplicate_direct_errors"() {
    let r = ecs_rq_new();
    r = ecs_rq_register_direct(r, 1, 10);
    r = ecs_rq_register_direct(r, 1, 11);
    if ecs_rq_last_ok(r) != false { panic(115010); };
    if ecs_rq_last_err(r) != ecs_rq_err_duplicate() { panic(115011); };
    if ecs_rq_direct_len(r) != 1 { panic(115012); };
    if ecs_rq_constructor_of(r, 1).1 != 10 { panic(115013); };
}

@test "inherited_then_direct_overrides"() {
    let r = ecs_rq_new();
    r = ecs_rq_register_inherited(r, 5, 50, 2);
    if ecs_rq_all_len(r) != 1 { panic(115020); };
    if ecs_rq_direct_len(r) != 0 { panic(115021); };
    if ecs_rq_depth_of(r, 5).1 != 2 { panic(115022); };
    r = ecs_rq_register_direct(r, 5, 99);
    if ecs_rq_last_ok(r) != true { panic(115023); };
    if ecs_rq_direct_len(r) != 1 { panic(115024); };
    if ecs_rq_depth_of(r, 5).1 != 0 { panic(115025); };
    if ecs_rq_constructor_of(r, 5).1 != 99 { panic(115026); };
}

@test "shallower_inherited_wins"() {
    let r = ecs_rq_new();
    r = ecs_rq_register_inherited(r, 7, 70, 3);
    r = ecs_rq_register_inherited(r, 7, 71, 1);
    if ecs_rq_constructor_of(r, 7).1 != 71 { panic(115030); };
    if ecs_rq_depth_of(r, 7).1 != 1 { panic(115031); };
    // deeper does not override
    r = ecs_rq_register_inherited(r, 7, 72, 5);
    if ecs_rq_constructor_of(r, 7).1 != 71 { panic(115032); };
}

@test "register_with_inherited_children"() {
    let r = ecs_rq_new();
    r = ecs_rq_register_direct_with_inherited(r, 1, 10, 2, 20, 3, 30, 2);
    if ecs_rq_last_ok(r) != true { panic(115040); };
    if ecs_rq_direct_len(r) != 1 { panic(115041); };
    if ecs_rq_contains_all(r, 1) != true { panic(115042); };
    if ecs_rq_contains_all(r, 2) != true { panic(115043); };
    if ecs_rq_contains_all(r, 3) != true { panic(115044); };
    if ecs_rq_depth_of(r, 2).1 != 1 { panic(115045); };
    if ecs_rq_depth_of(r, 1).1 != 0 { panic(115046); };
}

@test "cycle_detection"() {
    let r = ecs_rq_new();
    r = ecs_rq_register_checked(r, 4, 40, 1, 2, 4, -1, 3);
    if ecs_rq_last_ok(r) != false { panic(115050); };
    if ecs_rq_last_err(r) != ecs_rq_err_cyclic() { panic(115051); };
    r = ecs_rq_register_checked(r, 9, 90, 1, 2, -1, -1, 2);
    if ecs_rq_last_ok(r) != true { panic(115052); };
}

@test "registrator_register_and_target"() {
    let reg = ecs_rq_reg_new(100, 5);
    if ecs_rq_reg_target(reg) != 100 { panic(115060); };
    if ecs_rq_reg_next_id(reg) != 5 { panic(115061); };
    reg = ecs_rq_reg_register_required(reg, 1, 11);
    let req = ecs_rq_reg_required(reg);
    if ecs_rq_last_ok(req) != true { panic(115062); };
    if ecs_rq_direct_len(req) != 1 { panic(115063); };
    if ecs_rq_iter_ids_at(req, 0) != 1 { panic(115064); };
}

@test "registrator_self_require_is_cycle"() {
    let reg = ecs_rq_reg_new(3, 0);
    reg = ecs_rq_reg_register_required(reg, 3, 30);
    let req = ecs_rq_reg_required(reg);
    if ecs_rq_last_ok(req) != false { panic(115070); };
    if ecs_rq_last_err(req) != ecs_rq_err_cyclic() { panic(115071); };
}

@test "registrator_archetype_exists_blocks"() {
    let reg = ecs_rq_reg_new(1, 0);
    reg = ecs_rq_reg_set_archetype_exists(reg, true);
    reg = ecs_rq_reg_register_required(reg, 2, 20);
    let req = ecs_rq_reg_required(reg);
    if ecs_rq_last_ok(req) != false { panic(115080); };
    if ecs_rq_last_err(req) != ecs_rq_err_archetype_exists() { panic(115081); };
    if ecs_rq_direct_len(req) != 0 { panic(115082); };
}

@test "error_kind_constants"() {
    if ecs_rq_err_duplicate() != 0 { panic(115090); };
    if ecs_rq_err_cyclic() != 1 { panic(115091); };
    if ecs_rq_err_archetype_exists() != 2 { panic(115092); };
    if ecs_rq_err_none() != -1 { panic(115093); };
}
