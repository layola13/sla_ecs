// Isolated deep tests for lib/commands_relationship_deep.sla (Batch 381).
// Mirror shallow lib/commands_relationship.sla on cap-8 kind-discriminated command queue +
// cap-8 x cap-4 entity-list pool + cap-2 relationship-kind registry (kind0/kind1) with cap-8
// source→target adjacency. No tuple-return destructuring (wrapper structs EcsRelCmdReserveDeep /
// EcsRelCmdSpawnRelDeep / EcsRelCmdApplyDeep / EcsRelSpawnerDeep / EcsRelSpawnLinkedDeep with
// scalar accessors). No `let m = fn(m, ...)` chained rebinding. panic codes: 142100 - 142247.

@import "lib/commands_relationship_deep.sla"

@test "EcsRelCmdsDeep new + len + set_related queueing"() {
    let s0 = ecs_rel_cmd_state_deep_new();
    if ecs_rel_cmd_state_deep_len(s0) != 0 { panic(142100); };
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 1);
    let s1 = ecs_rel_cmds_deep_set_related(s0, 0, 5, 9);
    let s2 = ecs_rel_cmds_deep_set_related(s1, 0, 7, 9);
    if ecs_rel_cmd_state_deep_len(s2) != 2 { panic(142101); };
    if ecs_rel_cmd_state_deep_kind_at(s2, 0) != ECS_RELCMD_SET_RELATED { panic(142102); };
    if ecs_rel_cmd_state_deep_kind_id_at(s2, 0) != 0 { panic(142103); };
    if ecs_rel_cmd_state_deep_target_at(s2, 0) != 9 { panic(142104); };
    if ecs_rel_cmd_state_deep_source_at(s2, 1) != 7 { panic(142105); };
}

@test "EcsRelCmdsDeep set_related one_to_one replacement apply"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 1);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let first = sp2.1;
    let sp3 = ecs_rel_cmd_world_deep_spawn(w3);
    let w4 = sp3.0;
    let second = sp3.1;
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_set_related(s0, 0, first, target);
    let s2 = ecs_rel_cmds_deep_set_related(s1, 0, second, target);
    let apply = ecs_rel_cmds_deep_apply(w4, s2);
    let w5 = ecs_rel_cmd_apply_world(apply);
    if ecs_rel_cmd_state_deep_len(apply.state) != 0 { panic(142106); };
    if ecs_rel_cmd_world_deep_has_related(w5, 0, first) != false { panic(142107); };
    if ecs_rel_cmd_world_deep_has_related(w5, 0, second) != true { panic(142108); };
    if ecs_rel_cmd_world_deep_source_count(w5, 0, target) != 1 { panic(142109); };
    if ecs_rel_cmd_world_deep_source_at(w5, 0, target, 0) != second { panic(142110); };
}

@test "EcsRelCmdsDeep add_related multi-source apply"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_rel_cmd_world_deep_spawn(w3);
    let w4 = sp3.0;
    let c2 = sp3.1;
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_add_related(s0, 0, target, c1);
    let s2 = ecs_rel_cmds_deep_add_related(s1, 0, target, c2);
    let apply = ecs_rel_cmds_deep_apply(w4, s2);
    let w5 = ecs_rel_cmd_apply_world(apply);
    if ecs_rel_cmd_world_deep_related(w5, 0, c1) != target { panic(142111); };
    if ecs_rel_cmd_world_deep_related(w5, 0, c2) != target { panic(142112); };
    if ecs_rel_cmd_world_deep_source_count(w5, 0, target) != 2 { panic(142113); };
    if ecs_rel_cmd_world_deep_source_at(w5, 0, target, 0) != c1 { panic(142114); };
    if ecs_rel_cmd_world_deep_source_at(w5, 0, target, 1) != c2 { panic(142115); };
}

@test "EcsRelCmdsDeep insert_related + remove_related target-guard"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_rel_cmd_world_deep_spawn(w3);
    let w4 = sp3.0;
    let c2 = sp3.1;
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_insert_related(s0, 0, target, 0, c1);
    let s2 = ecs_rel_cmds_deep_insert_related(s1, 0, target, 1, c2);
    let apply1 = ecs_rel_cmds_deep_apply(w4, s2);
    let w5 = ecs_rel_cmd_apply_world(apply1);
    if ecs_rel_cmd_world_deep_source_count(w5, 0, target) != 2 { panic(142116); };
    // remove c1 only if its current target equals `target`.
    let s3 = ecs_rel_cmds_deep_remove_related(apply1.state, 0, target, c1);
    let apply2 = ecs_rel_cmds_deep_apply(w5, s3);
    let w6 = ecs_rel_cmd_apply_world(apply2);
    if ecs_rel_cmd_world_deep_has_related(w6, 0, c1) != false { panic(142117); };
    if ecs_rel_cmd_world_deep_has_related(w6, 0, c2) != true { panic(142118); };
    if ecs_rel_cmd_world_deep_source_count(w6, 0, target) != 1 { panic(142119); };
}

@test "EcsRelCmdsDeep detach_all_related clears target"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let c1 = sp2.1;
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_add_related(s0, 0, target, c1);
    let apply1 = ecs_rel_cmds_deep_apply(w3, s1);
    let w4 = ecs_rel_cmd_apply_world(apply1);
    if ecs_rel_cmd_world_deep_source_count(w4, 0, target) != 1 { panic(142120); };
    let s2 = ecs_rel_cmds_deep_detach_all_related(apply1.state, 0, target);
    let apply2 = ecs_rel_cmds_deep_apply(w4, s2);
    let w5 = ecs_rel_cmd_apply_world(apply2);
    if ecs_rel_cmd_world_deep_has_related(w5, 0, c1) != false { panic(142121); };
    if ecs_rel_cmd_world_deep_source_count(w5, 0, target) != 0 { panic(142122); };
}

@test "EcsRelCmdsDeep replace_related via list pool"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_rel_cmd_world_deep_spawn(w3);
    let w4 = sp3.0;
    let c2 = sp3.1;
    let sp4 = ecs_rel_cmd_world_deep_spawn(w4);
    let w5 = sp4.0;
    let c3 = sp4.1;
    // seed target with c1, c2.
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_add_related(s0, 0, target, c1);
    let s2 = ecs_rel_cmds_deep_add_related(s1, 0, target, c2);
    let apply1 = ecs_rel_cmds_deep_apply(w5, s2);
    let w6 = ecs_rel_cmd_apply_world(apply1);
    if ecs_rel_cmd_world_deep_source_count(w6, 0, target) != 2 { panic(142123); };
    // replace with just c3.
    let s3 = ecs_rel_cmds_deep_replace_related(apply1.state, 0, target, c3);
    let apply2 = ecs_rel_cmds_deep_apply(w6, s3);
    let w7 = ecs_rel_cmd_apply_world(apply2);
    if ecs_rel_cmd_world_deep_source_count(w7, 0, target) != 1 { panic(142124); };
    if ecs_rel_cmd_world_deep_related(w7, 0, c3) != target { panic(142125); };
    if ecs_rel_cmd_world_deep_has_related(w7, 0, c1) != false { panic(142126); };
    if ecs_rel_cmd_world_deep_has_related(w7, 0, c2) != false { panic(142127); };
}

@test "EcsRelCmdsDeep replace_diff unrelate + relate"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_rel_cmd_world_deep_spawn(w3);
    let w4 = sp3.0;
    let c2 = sp3.1;
    let sp4 = ecs_rel_cmd_world_deep_spawn(w4);
    let w5 = sp4.0;
    let c3 = sp4.1;
    // seed c1 + c2
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_add_related(s0, 0, target, c1);
    let s2 = ecs_rel_cmds_deep_add_related(s1, 0, target, c2);
    let apply1 = ecs_rel_cmds_deep_apply(w5, s2);
    let w6 = ecs_rel_cmd_apply_world(apply1);
    // diff: unrelate c1, relate c3; newly c3. After: c2 kept (untouched), c3 added -> {c2, c3}.
    let s3 = ecs_rel_cmds_deep_replace_diff(apply1.state, 0, target, c1, c3, c3);
    let apply2 = ecs_rel_cmds_deep_apply(w6, s3);
    let w7 = ecs_rel_cmd_apply_world(apply2);
    if ecs_rel_cmd_world_deep_has_related(w7, 0, c1) != false { panic(142128); };
    if ecs_rel_cmd_world_deep_has_related(w7, 0, c2) != true { panic(142129); };
    if ecs_rel_cmd_world_deep_has_related(w7, 0, c3) != true { panic(142130); };
    if ecs_rel_cmd_world_deep_source_count(w7, 0, target) != 2 { panic(142131); };
}

@test "EcsRelCmdsDeep despawn + despawn_related linked"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 1, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let warp1 = ecs_rel_cmd_world_deep_spawn_related(w2, 0, target);
    let w3 = ecs_rel_spawn_linked_world(warp1);
    let child1 = ecs_rel_spawn_linked_entity(warp1);
    let warp2 = ecs_rel_cmd_world_deep_spawn_related(w3, 0, target);
    let w4 = ecs_rel_spawn_linked_world(warp2);
    let child2 = ecs_rel_spawn_linked_entity(warp2);
    let sp4 = ecs_rel_cmd_world_deep_spawn(w4);
    let w5 = sp4.0;
    let child3 = sp4.1;
    let s0 = ecs_rel_cmd_state_deep_new();
    let s1 = ecs_rel_cmds_deep_despawn(s0, target);
    let apply1 = ecs_rel_cmds_deep_apply(w5, s1);
    let w6 = ecs_rel_cmd_apply_world(apply1);
    if ecs_rel_cmd_world_deep_is_alive(w6, target) != false { panic(142132); };
    if ecs_rel_cmd_world_deep_is_alive(w6, child1) != true { panic(142133); };
    if ecs_rel_cmd_world_deep_is_alive(w6, child2) != true { panic(142134); };
    // despawn_related with link=true should mark the target and its sources not-alive.
    let s2 = ecs_rel_cmds_deep_despawn_related(s0, 0, target);
    let apply2 = ecs_rel_cmds_deep_apply(w5, s2);
    let w7 = ecs_rel_cmd_apply_world(apply2);
    if ecs_rel_cmd_world_deep_is_alive(w7, target) != false { panic(142135); };
    if ecs_rel_cmd_world_deep_is_alive(w7, child1) != false { panic(142136); };
    if ecs_rel_cmd_world_deep_is_alive(w7, child2) != false { panic(142137); };
    if ecs_rel_cmd_world_deep_is_alive(w7, child3) != true { panic(142138); };
}

@test "EcsRelCmdsDeep RelatedSpawner builder + finish"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let sp1 = ecs_rel_cmd_world_deep_spawn(w1);
    let w2 = sp1.0;
    let target = sp1.1;
    let sp2 = ecs_rel_cmd_world_deep_spawn(w2);
    let w3 = sp2.0;
    let existing = sp2.1;
    let s0 = ecs_rel_cmd_state_deep_new();
    let sp = ecs_rel_spawner_deep_new(s0, 0, target);
    let sr1 = ecs_rel_spawner_deep_spawn(w3, sp);
    let w3b = ecs_rel_spawner_spawn_world(sr1);
    let sp1b = ecs_rel_spawner_spawn_spawner(sr1);
    let first = ecs_rel_spawner_spawn_entity(sr1);
    let sr2 = ecs_rel_spawner_deep_spawn(w3b, sp1b);
    let w3c = ecs_rel_spawner_spawn_world(sr2);
    let sp1c = ecs_rel_spawner_spawn_spawner(sr2);
    let second = ecs_rel_spawner_spawn_entity(sr2);
    let sp2b = ecs_rel_spawner_deep_add_existing(sp1c, existing);
    if ecs_rel_spawner_deep_len(sp2b) != 3 { panic(142139); };
    let sfin = ecs_rel_spawner_deep_finish(sp2b);
    let apply = ecs_rel_cmds_deep_apply(w3c, sfin);
    let w4 = ecs_rel_cmd_apply_world(apply);
    if ecs_rel_cmd_state_deep_len(apply.state) != 0 { panic(142140); };
    if ecs_rel_cmd_world_deep_source_count(w4, 0, target) != 3 { panic(142141); };
    if ecs_rel_cmd_world_deep_related(w4, 0, first) != target { panic(142142); };
    if ecs_rel_cmd_world_deep_related(w4, 0, second) != target { panic(142247); };
    if ecs_rel_cmd_world_deep_related(w4, 0, existing) != target { panic(142143); };
}

@test "EcsRelCmdsDeep reserve_entity + spawn_related wrappers + cap-8 reject + clear"() {
    let w0 = ecs_rel_cmd_world_deep_new();
    let w1 = ecs_rel_cmd_world_deep_register(w0, 0, 0, 0);
    let s0 = ecs_rel_cmd_state_deep_new();
    let res = ecs_rel_cmds_deep_reserve_entity(w1, s0);
    let e1 = ecs_rel_cmd_reserve_entity(res);
    let w2 = ecs_rel_cmd_reserve_world(res);
    if e1 != 1 { panic(142144); };
    if ecs_rel_cmd_world_deep_is_alive(w2, e1) != true { panic(142145); };
    let res2 = ecs_rel_cmds_deep_spawn_related(w2, res.state, 0, 2);
    let child = ecs_rel_cmd_spawn_rel_entity(res2);
    let w3 = ecs_rel_cmd_spawn_rel_world(res2);
    if child != 2 { panic(142146); };
    if ecs_rel_cmd_world_deep_is_alive(w3, child) != true { panic(142147); };
    if ecs_rel_cmd_state_deep_len(res2.state) != 1 { panic(142148); };
    // Cap-8 reject: push 8 set_related commands then attempt a 9th.
    let sA = ecs_rel_cmd_state_deep_new();
    let sB = ecs_rel_cmds_deep_set_related(sA, 0, 1, 2);
    let sC = ecs_rel_cmds_deep_set_related(sB, 0, 1, 3);
    let sD = ecs_rel_cmds_deep_set_related(sC, 0, 1, 4);
    let sE = ecs_rel_cmds_deep_set_related(sD, 0, 1, 5);
    let sF = ecs_rel_cmds_deep_set_related(sE, 0, 1, 6);
    let sG = ecs_rel_cmds_deep_set_related(sF, 0, 1, 7);
    let sH = ecs_rel_cmds_deep_set_related(sG, 0, 1, 8);
    let sI = ecs_rel_cmds_deep_set_related(sH, 0, 1, 9);
    let sJ = ecs_rel_cmds_deep_set_related(sI, 0, 1, 1);
    if ecs_rel_cmd_state_deep_len(sJ) != 8 { panic(142149); };
    let sK = ecs_rel_cmds_deep_clear(sJ);
    if ecs_rel_cmd_state_deep_len(sK) != 0 { panic(142150); };
    // apply an empty queue leaves the world untouched and resets to a clean cleared state.
    let apply0 = ecs_rel_cmds_deep_apply(w3, sK);
    let w4 = ecs_rel_cmd_apply_world(apply0);
    if ecs_rel_cmd_world_deep_is_alive(w4, child) != true { panic(142151); };
    if ecs_rel_cmd_state_deep_len(apply0.state) != 0 { panic(142152); };
}
