@import "lib/lifecycle_hooks_deep.sla"

// Batch 295: lifecycle_hooks deep.
// panic codes: 125000 – 125199.

@test "kinds_and_context"() {
    if ecs_lh_kind_add() != 0 { panic(125000); };
    if ecs_lh_kind_insert() != 1 { panic(125001); };
    if ecs_lh_kind_replace() != 2 { panic(125002); };
    if ecs_lh_kind_remove() != 3 { panic(125003); };
    if ecs_lh_kind_despawn() != 4 { panic(125004); };
    let c = ecs_lh_ctx_new(9, 3, ecs_lh_kind_add());
    if ecs_lh_ctx_entity(c) != 9 { panic(125005); };
    if ecs_lh_ctx_component_id(c) != 3 { panic(125006); };
    c = ecs_lh_ctx_with_caller(c, 77);
    if ecs_lh_ctx_has_caller(c) != true { panic(125007); };
    if ecs_lh_ctx_caller(c) != 77 { panic(125008); };
}

@test "set_hooks_and_has_any"() {
    let h = ecs_lh_hooks_new();
    if ecs_lh_hooks_has_any(h) != false { panic(125010); };
    h = ecs_lh_hooks_set_on_add(h, 10);
    h = ecs_lh_hooks_set_on_insert(h, 11);
    if ecs_lh_hooks_on_add(h) != 10 { panic(125011); };
    if ecs_lh_hooks_on_insert(h) != 11 { panic(125012); };
    if ecs_lh_hooks_has_any(h) != true { panic(125013); };
}

@test "try_set_fails_when_locked"() {
    let h = ecs_lh_hooks_new();
    let t = ecs_lh_hooks_try_on_add(h, 1);
    if ecs_lh_try_ok(t) != true { panic(125020); };
    h = ecs_lh_try_hooks(t);
    let t2 = ecs_lh_hooks_try_on_add(h, 2);
    if ecs_lh_try_ok(t2) != false { panic(125021); };
    if ecs_lh_hooks_on_add(ecs_lh_try_hooks(t2)) != 1 { panic(125022); };
}

@test "all_try_kinds"() {
    let h = ecs_lh_hooks_new();
    h = ecs_lh_try_hooks(ecs_lh_hooks_try_on_insert(h, 2));
    h = ecs_lh_try_hooks(ecs_lh_hooks_try_on_replace(h, 3));
    h = ecs_lh_try_hooks(ecs_lh_hooks_try_on_remove(h, 4));
    h = ecs_lh_try_hooks(ecs_lh_hooks_try_on_despawn(h, 5));
    if ecs_lh_hooks_on_insert(h) != 2 { panic(125030); };
    if ecs_lh_hooks_on_replace(h) != 3 { panic(125031); };
    if ecs_lh_hooks_on_remove(h) != 4 { panic(125032); };
    if ecs_lh_hooks_on_despawn(h) != 5 { panic(125033); };
    if ecs_lh_try_ok(ecs_lh_hooks_try_on_remove(h, 9)) != false { panic(125034); };
}

@test "run_dispatch"() {
    let h = ecs_lh_hooks_set_on_add(ecs_lh_hooks_new(), 42);
    let d = ecs_lh_hooks_run(h, ecs_lh_ctx_new(1, 2, ecs_lh_kind_add()));
    if ecs_lh_dispatch_ran(d) != true { panic(125040); };
    if ecs_lh_dispatch_runner(d) != 42 { panic(125041); };
    if ecs_lh_dispatch_entity(d) != 1 { panic(125042); };
    let miss = ecs_lh_hooks_run(h, ecs_lh_ctx_new(1, 2, ecs_lh_kind_remove()));
    if ecs_lh_dispatch_ran(miss) != false { panic(125043); };
}

@test "table_set_get_run"() {
    let t = ecs_lh_table_new();
    let h = ecs_lh_hooks_set_on_insert(ecs_lh_hooks_new(), 99);
    t = ecs_lh_table_set(t, 5, h);
    if ecs_lh_table_len(t) != 1 { panic(125050); };
    if ecs_lh_table_has(t, 5) != true { panic(125051); };
    if ecs_lh_hooks_on_insert(ecs_lh_table_get(t, 5)) != 99 { panic(125052); };
    let d = ecs_lh_table_run(t, ecs_lh_ctx_new(8, 5, ecs_lh_kind_insert()));
    if ecs_lh_dispatch_ran(d) != true { panic(125053); };
    if ecs_lh_dispatch_runner(d) != 99 { panic(125054); };
}

@test "table_replace_existing"() {
    let t = ecs_lh_table_new();
    t = ecs_lh_table_set(t, 1, ecs_lh_hooks_set_on_add(ecs_lh_hooks_new(), 1));
    t = ecs_lh_table_set(t, 1, ecs_lh_hooks_set_on_add(ecs_lh_hooks_new(), 2));
    if ecs_lh_table_len(t) != 1 { panic(125060); };
    if ecs_lh_hooks_on_add(ecs_lh_table_get(t, 1)) != 2 { panic(125061); };
}

@test "table_capacity_four"() {
    let t = ecs_lh_table_new();
    t = ecs_lh_table_set(t, 1, ecs_lh_hooks_new());
    t = ecs_lh_table_set(t, 2, ecs_lh_hooks_new());
    t = ecs_lh_table_set(t, 3, ecs_lh_hooks_new());
    t = ecs_lh_table_set(t, 4, ecs_lh_hooks_new());
    if ecs_lh_table_len(t) != 4 { panic(125070); };
    // 5th ignored
    t = ecs_lh_table_set(t, 5, ecs_lh_hooks_set_on_add(ecs_lh_hooks_new(), 1));
    if ecs_lh_table_len(t) != 4 { panic(125071); };
    if ecs_lh_table_has(t, 5) != false { panic(125072); };
}

@test "runner_for_all_kinds"() {
    let h = ecs_lh_hooks_new();
    h = ecs_lh_hooks_set_on_add(h, 1);
    h = ecs_lh_hooks_set_on_insert(h, 2);
    h = ecs_lh_hooks_set_on_replace(h, 3);
    h = ecs_lh_hooks_set_on_remove(h, 4);
    h = ecs_lh_hooks_set_on_despawn(h, 5);
    if ecs_lh_hooks_runner_for(h, 0) != 1 { panic(125080); };
    if ecs_lh_hooks_runner_for(h, 1) != 2 { panic(125081); };
    if ecs_lh_hooks_runner_for(h, 2) != 3 { panic(125082); };
    if ecs_lh_hooks_runner_for(h, 3) != 4 { panic(125083); };
    if ecs_lh_hooks_runner_for(h, 4) != 5 { panic(125084); };
    if ecs_lh_hooks_runner_for(h, 9) != -1 { panic(125085); };
}

@test "missing_table_component"() {
    let t = ecs_lh_table_new();
    let d = ecs_lh_table_run(t, ecs_lh_ctx_new(1, 9, ecs_lh_kind_add()));
    if ecs_lh_dispatch_ran(d) != false { panic(125090); };
    if ecs_lh_table_has(t, 9) != false { panic(125091); };
}
