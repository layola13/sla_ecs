@import "lib/message_iterators_deep.sla"

// Batch 279: message_iterators deep (src/message/iterators.rs).
// panic codes: 121800 – 121999.

@test "write_and_iter_reads_all"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 10);
    m = ecs_mi_messages_write(m, 20);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    if ecs_mi_iter_len(it) != 2 { panic(121800); };
    if ecs_mi_iter_is_mut(it) != false { panic(121801); };
    let n0 = ecs_mi_iter_next(it);
    it = ecs_mi_next_iter(n0);
    if ecs_mi_next_has(n0) != true { panic(121802); };
    if ecs_mi_next_value(n0) != 10 { panic(121803); };
    if ecs_mi_next_id(n0) != 0 { panic(121804); };
    let n1 = ecs_mi_iter_next(it);
    if ecs_mi_next_value(n1) != 20 { panic(121805); };
}

@test "without_id_flag"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 1);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_without_id(ecs_mi_new_iter(nr));
    if ecs_mi_iter_without_id_flag(it) != true { panic(121810); };
    if ecs_mi_iter_len(it) != 1 { panic(121811); };
}

@test "count_consumes_unread"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 1);
    m = ecs_mi_messages_write(m, 2);
    m = ecs_mi_messages_write(m, 3);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    let cr = ecs_mi_iter_count(it);
    if ecs_mi_count_n(cr) != 3 { panic(121820); };
    if ecs_mi_iter_len(ecs_mi_count_iter(cr)) != 0 { panic(121821); };
    let c2 = ecs_mi_cursor_from_iter(ecs_mi_count_iter(cr));
    if ecs_mi_cursor_last(c2) != 3 { panic(121822); };
}

@test "last_returns_final"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 4);
    m = ecs_mi_messages_write(m, 5);
    m = ecs_mi_messages_write(m, 6);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    let lr = ecs_mi_iter_last(it);
    if ecs_mi_next_has(lr) != true { panic(121830); };
    if ecs_mi_next_value(lr) != 6 { panic(121831); };
    if ecs_mi_iter_len(ecs_mi_next_iter(lr)) != 0 { panic(121832); };
}

@test "nth_skips"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 10);
    m = ecs_mi_messages_write(m, 20);
    m = ecs_mi_messages_write(m, 30);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    let n = ecs_mi_iter_nth(it, 1);
    if ecs_mi_next_has(n) != true { panic(121840); };
    if ecs_mi_next_value(n) != 20 { panic(121841); };
    if ecs_mi_next_id(n) != 1 { panic(121842); };
}

@test "nth_past_end_exhausts"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 1);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    let n = ecs_mi_iter_nth(it, 5);
    if ecs_mi_next_has(n) != false { panic(121850); };
    if ecs_mi_iter_len(ecs_mi_next_iter(n)) != 0 { panic(121851); };
}

@test "update_then_iter_chain_a_then_b"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 7);
    m = ecs_mi_messages_update(m);
    m = ecs_mi_messages_write(m, 8);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    if ecs_mi_iter_len(it) != 2 { panic(121860); };
    let n0 = ecs_mi_iter_next(it);
    it = ecs_mi_next_iter(n0);
    if ecs_mi_next_value(n0) != 7 { panic(121861); };
    let n1 = ecs_mi_iter_next(it);
    if ecs_mi_next_value(n1) != 8 { panic(121862); };
}

@test "par_batching_and_sum"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 1);
    m = ecs_mi_messages_write(m, 2);
    m = ecs_mi_messages_write(m, 3);
    m = ecs_mi_messages_write(m, 4);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    let p = ecs_mi_par_from_iter(it);
    p = ecs_mi_par_batching_strategy(p, 2);
    if ecs_mi_par_batch_size(p) != 2 { panic(121870); };
    if ecs_mi_par_batch_count(p) != 2 { panic(121871); };
    if ecs_mi_par_for_each_sum(it) != 10 { panic(121872); };
}

@test "cursor_advances_only_unread"() {
    let m = ecs_mi_messages_new();
    m = ecs_mi_messages_write(m, 1);
    m = ecs_mi_messages_write(m, 2);
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    c = ecs_mi_new_cursor(nr);
    // after construction last = message_count - unread = 0
    if ecs_mi_cursor_last(c) != 0 { panic(121880); };
    let it = ecs_mi_new_iter(nr);
    let n0 = ecs_mi_iter_next(it);
    it = ecs_mi_next_iter(n0);
    c = ecs_mi_cursor_from_iter(it);
    if ecs_mi_cursor_last(c) != 1 { panic(121881); };
}

@test "empty_iter_and_messages_len"() {
    let m = ecs_mi_messages_new();
    if ecs_mi_messages_len(m) != 0 { panic(121890); };
    let c = ecs_mi_cursor_new();
    let nr = ecs_mi_iter_with_id_new(c, m);
    let it = ecs_mi_new_iter(nr);
    if ecs_mi_iter_len(it) != 0 { panic(121891); };
    let n = ecs_mi_iter_next(it);
    if ecs_mi_next_has(n) != false { panic(121892); };
    m = ecs_mi_messages_write(m, 42);
    if ecs_mi_messages_message_count(m) != 1 { panic(121893); };
    if ecs_mi_messages_len(m) != 1 { panic(121894); };
}
