@import "lib/label_deep.sla"

// Batch 200a: label DynEq/DynHash/intern deep.

@test "dyn_eq_same_type_value"() {
    let a = ecs_lb_dyn_new(ECS_LB_TYPE_A, 1);
    let b = ecs_lb_dyn_new(ECS_LB_TYPE_A, 1);
    if ecs_lb_dyn_eq(a, b) != true { panic(105800); };
}

@test "dyn_eq_diff_type_false"() {
    if ecs_lb_cross_type_eq(5, 5) != false { panic(105810); };
}

@test "dyn_eq_diff_value_false"() {
    let a = ecs_lb_dyn_new(ECS_LB_TYPE_A, 1);
    let b = ecs_lb_dyn_new(ECS_LB_TYPE_A, 2);
    if ecs_lb_dyn_eq(a, b) != false { panic(105820); };
}

@test "dyn_hash_stable"() {
    let a = ecs_lb_dyn_new(ECS_LB_TYPE_B, 9);
    let b = ecs_lb_dyn_clone(a);
    if ecs_lb_dyn_hash(a) != ecs_lb_dyn_hash(b) { panic(105830); };
}

@test "dyn_clone_copies"() {
    let a = ecs_lb_dyn_new(ECS_LB_TYPE_C, 3);
    let b = ecs_lb_dyn_clone(a);
    if ecs_lb_dyn_eq(a, b) != true { panic(105840); };
    if ecs_lb_dyn_type(b) != ECS_LB_TYPE_C { panic(105841); };
}

@test "intern_dedup"() {
    let i = ecs_lb_interner_new(1);
    let l = ecs_lb_schedule_label(10);
    let a = ecs_lb_intern(i, l); i = a.0;
    let b = ecs_lb_intern(i, l); i = b.0;
    if ecs_lb_interned_eq(a.1, b.1) != true { panic(105850); };
    if ecs_lb_interner_len(i) != 1 { panic(105851); };
}

@test "intern_different_labels"() {
    let i = ecs_lb_interner_new(1);
    let a = ecs_lb_intern(i, ecs_lb_schedule_label(1)); i = a.0;
    let b = ecs_lb_intern(i, ecs_lb_schedule_label(2)); i = b.0;
    if ecs_lb_interned_eq(a.1, b.1) != false { panic(105860); };
    if ecs_lb_interner_len(i) != 2 { panic(105861); };
}

@test "different_interners_neq"() {
    let i1 = ecs_lb_interner_new(1);
    let i2 = ecs_lb_interner_new(2);
    let a = ecs_lb_intern(i1, ecs_lb_system_set(7));
    let b = ecs_lb_intern(i2, ecs_lb_system_set(7));
    if ecs_lb_interned_eq(a.1, b.1) != false { panic(105870); };
}

@test "interned_accessors"() {
    let i = ecs_lb_interner_new(3);
    let r = ecs_lb_intern(i, ecs_lb_schedule_label(4));
    if ecs_lb_interned_value(r.1) != 4 { panic(105880); };
    if ecs_lb_interned_type(r.1) != ECS_LB_TYPE_A { panic(105881); };
    if ecs_lb_interned_interner(r.1) != 3 { panic(105882); };
}

@test "interned_hash_by_slot"() {
    let i = ecs_lb_interner_new(1);
    let a = ecs_lb_intern(i, ecs_lb_schedule_label(1)); i = a.0;
    let b = ecs_lb_intern(i, ecs_lb_schedule_label(1)); i = b.0;
    if ecs_lb_interned_dyn_hash(a.1) != ecs_lb_interned_dyn_hash(b.1) { panic(105890); };
}

@test "system_set_vs_schedule_type"() {
    let a = ecs_lb_schedule_label(1);
    let b = ecs_lb_system_set(1);
    if ecs_lb_dyn_eq(a, b) != false { panic(105900); };
}

@test "lifecycle_intern_many"() {
    let i = ecs_lb_interner_new(9);
    let a = ecs_lb_intern(i, ecs_lb_schedule_label(1)); i = a.0;
    let b = ecs_lb_intern(i, ecs_lb_system_set(1)); i = b.0;
    let c = ecs_lb_intern(i, ecs_lb_schedule_label(1)); i = c.0;
    if ecs_lb_interned_eq(a.1, c.1) != true { panic(105910); };
    if ecs_lb_interner_len(i) != 2 { panic(105911); };
}

@test "dyn_value_accessor"() {
    let d = ecs_lb_dyn_new(ECS_LB_TYPE_A, 99);
    if ecs_lb_dyn_value(d) != 99 { panic(105920); };
    if ecs_lb_dyn_type(d) != ECS_LB_TYPE_A { panic(105921); };
}

@test "interner_id_accessor"() {
    let i = ecs_lb_interner_new(42);
    if ecs_lb_interner_id(i) != 42 { panic(105930); };
    if ecs_lb_interner_len(i) != 0 { panic(105931); };
}

@test "interned_dyn_eq_is_pointer_eq"() {
    let i = ecs_lb_interner_new(1);
    let a = ecs_lb_intern(i, ecs_lb_schedule_label(5)); i = a.0;
    let b = ecs_lb_intern(i, ecs_lb_schedule_label(5)); i = b.0;
    if ecs_lb_interned_dyn_eq(a.1, b.1) != true { panic(105940); };
}
