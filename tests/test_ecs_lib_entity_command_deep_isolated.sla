@import "lib/entity_command_deep.sla"

// Batch 192 tests for EntityCommand deep apply semantics.

@test "spawn_seed_has_component"() {
    let w = ecs_ec_deep_world_new();
    w = ecs_ec_deep_seed(w, 0, 1, 42);
    if ecs_ec_deep_occupied(w, 0) != true { panic(103900); };
    if ecs_ec_deep_has(w, 0, 1) != true { panic(103901); };
    if ecs_ec_deep_get_value(w, 0) != 42 { panic(103902); };
}

@test "apply_missing_entity_fetch_error"() {
    let w = ecs_ec_deep_world_new();
    let cmd = ecs_ec_deep_cmd_insert(0, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 2, cmd);
    if ecs_ec_deep_last_error(w) != ECS_EC_DEEP_ENTITY_FETCH { panic(103910); };
    if ecs_ec_deep_error_is_fetch(ecs_ec_deep_last_error(w)) != true { panic(103911); };
}

@test "insert_replace_and_keep"() {
    let w = ecs_ec_deep_seed(ecs_ec_deep_world_new(), 0, 0, 10);
    let cmd = ecs_ec_deep_cmd_insert(0, 99, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 0, cmd);
    if ecs_ec_deep_get_value(w, 0) != 99 { panic(103920); };
    let keep = ecs_ec_deep_cmd_insert(0, 5, ECS_EC_DEEP_INSERT_KEEP);
    w = ecs_ec_deep_apply(w, 0, keep);
    if ecs_ec_deep_get_value(w, 0) != 99 { panic(103921); };
}

@test "insert_new_component"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 1);
    let cmd = ecs_ec_deep_cmd_insert(3, 7, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 1, cmd);
    if ecs_ec_deep_has(w, 1, 3) != true { panic(103930); };
    if ecs_ec_deep_get_value(w, 1) != 7 { panic(103931); };
}

@test "insert_from_world_invokes_only_when_inserted"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    let cmd = ecs_ec_deep_cmd_insert_from_world(2, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 0, cmd);
    if ecs_ec_deep_from_world_calls(w) != 1 { panic(103940); };
    if ecs_ec_deep_has(w, 0, 2) != true { panic(103941); };
    if ecs_ec_deep_get_value(w, 0) != 102 { panic(103942); };
    // Keep existing skips FromWorld
    let keep = ecs_ec_deep_cmd_insert_from_world(2, ECS_EC_DEEP_INSERT_KEEP);
    w = ecs_ec_deep_apply(w, 0, keep);
    if ecs_ec_deep_from_world_calls(w) != 1 { panic(103943); };
}

@test "insert_with_keep_skips_fn_value"() {
    let w = ecs_ec_deep_seed(ecs_ec_deep_world_new(), 0, 1, 3);
    let cmd = ecs_ec_deep_cmd_insert_with(1, 50, ECS_EC_DEEP_INSERT_KEEP);
    w = ecs_ec_deep_apply(w, 0, cmd);
    if ecs_ec_deep_get_value(w, 0) != 3 { panic(103950); };
    let rep = ecs_ec_deep_cmd_insert_with(1, 50, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 0, rep);
    if ecs_ec_deep_get_value(w, 0) != 50 { panic(103951); };
}

@test "remove_and_remove_by_id"() {
    let w = ecs_ec_deep_seed(ecs_ec_deep_world_new(), 0, 2, 1);
    w = ecs_ec_deep_add_component(w, 0, 4, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_remove(2));
    if ecs_ec_deep_has(w, 0, 2) != false { panic(103960); };
    if ecs_ec_deep_has(w, 0, 4) != true { panic(103961); };
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_remove_by_id(4));
    if ecs_ec_deep_has(w, 0, 4) != false { panic(103962); };
}

@test "remove_with_requires"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_add_component(w, 0, 1, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 2, 1, ECS_EC_DEEP_INSERT_REPLACE); // required of 1 is 2
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_remove_with_requires(1));
    if ecs_ec_deep_has(w, 0, 1) != false { panic(103970); };
    if ecs_ec_deep_has(w, 0, 2) != false { panic(103971); };
}

@test "clear_and_retain"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_add_component(w, 0, 0, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 1, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 3, 1, ECS_EC_DEEP_INSERT_REPLACE);
    let keep_mask = ecs_ec_deep_bit(1); // keep only component 1
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_retain(keep_mask));
    if ecs_ec_deep_has(w, 0, 1) != true { panic(103980); };
    if ecs_ec_deep_has(w, 0, 0) != false { panic(103981); };
    if ecs_ec_deep_has(w, 0, 3) != false { panic(103982); };
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_clear());
    if ecs_ec_deep_component_count(w, 0) != 0 { panic(103983); };
}

@test "despawn"() {
    let w = ecs_ec_deep_seed(ecs_ec_deep_world_new(), 3, 0, 1);
    w = ecs_ec_deep_apply(w, 3, ecs_ec_deep_cmd_despawn());
    if ecs_ec_deep_occupied(w, 3) != false { panic(103990); };
    if ecs_ec_deep_has(w, 3, 0) != false { panic(103991); };
}

@test "observe"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_observe(55));
    if ecs_ec_deep_observer_count(w) != 1 { panic(104000); };
    if ecs_ec_deep_last_observer_id(w) != 55 { panic(104001); };
}

@test "clone_opt_out_denies"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_add_component(w, 0, 0, 9, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 1, 9, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_spawn(w, 1);
    let deny = ecs_ec_deep_bit(1);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_clone_opt_out(1, deny));
    if ecs_ec_deep_has(w, 1, 0) != true { panic(104010); };
    if ecs_ec_deep_has(w, 1, 1) != false { panic(104011); };
}

@test "clone_opt_in_and_components"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_add_component(w, 0, 0, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 2, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_spawn(w, 1);
    let allow = ecs_ec_deep_bit(2);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_clone_opt_in(1, allow));
    if ecs_ec_deep_has(w, 1, 2) != true { panic(104020); };
    if ecs_ec_deep_has(w, 1, 0) != false { panic(104021); };
    w = ecs_ec_deep_spawn(w, 2);
    let mask = ecs_ec_deep_or_masks(ecs_ec_deep_bit(0), ecs_ec_deep_bit(2));
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_clone_components(2, mask));
    if ecs_ec_deep_has(w, 2, 0) != true { panic(104022); };
    if ecs_ec_deep_has(w, 2, 2) != true { panic(104023); };
}

@test "move_components_removes_from_source"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_add_component(w, 0, 1, 8, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 2, 8, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_spawn(w, 1);
    let m = ecs_ec_deep_bit(1);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_move_components(1, m));
    if ecs_ec_deep_has(w, 1, 1) != true { panic(104030); };
    if ecs_ec_deep_has(w, 0, 1) != false { panic(104031); };
    if ecs_ec_deep_has(w, 0, 2) != true { panic(104032); };
}

@test "move_missing_target_fails"() {
    let w = ecs_ec_deep_seed(ecs_ec_deep_world_new(), 0, 0, 1);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_move_components(5, ecs_ec_deep_bit(0)));
    if ecs_ec_deep_last_error(w) != ECS_EC_DEEP_COMMAND_FAILED { panic(104040); };
    if ecs_ec_deep_last_command_failed(w) != 1 { panic(104041); };
}

@test "log_components"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 2);
    w = ecs_ec_deep_add_component(w, 2, 0, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 2, 3, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 2, ecs_ec_deep_cmd_log());
    if ecs_ec_deep_log_entity(w) != 2 { panic(104050); };
    if ecs_ec_deep_log_component_count(w) != 2 { panic(104051); };
}

@test "custom_fail_command_error"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_custom_fail(77));
    if ecs_ec_deep_error_is_failed(ecs_ec_deep_last_error(w)) != true { panic(104060); };
    if ecs_ec_deep_last_command_failed(w) != 77 { panic(104061); };
}

@test "with_entity_routes_to_apply"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 4);
    let cmd = ecs_ec_deep_cmd_insert(5, 12, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_with_entity(w, 4, cmd);
    if ecs_ec_deep_has(w, 4, 5) != true { panic(104070); };
    if ecs_ec_deep_get_value(w, 4) != 12 { panic(104071); };
}

@test "fn_style_entity_command"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_apply_fn_insert(w, 0, 6, 33);
    if ecs_ec_deep_has(w, 0, 6) != true { panic(104080); };
    if ecs_ec_deep_get_value(w, 0) != 33 { panic(104081); };
}

@test "with_caller_is_metadata_only"() {
    let cmd = ecs_ec_deep_cmd_with_caller(ecs_ec_deep_cmd_clear(), 9);
    let w = ecs_ec_deep_seed(ecs_ec_deep_world_new(), 0, 0, 1);
    w = ecs_ec_deep_apply(w, 0, cmd);
    if ecs_ec_deep_component_count(w, 0) != 0 { panic(104090); };
}

@test "requires_disabled_skips_required_remove"() {
    let w = ecs_ec_deep_set_requires_enabled(ecs_ec_deep_world_new(), false);
    w = ecs_ec_deep_spawn(w, 0);
    w = ecs_ec_deep_add_component(w, 0, 1, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_add_component(w, 0, 2, 1, ECS_EC_DEEP_INSERT_REPLACE);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_remove_with_requires(1));
    if ecs_ec_deep_has(w, 0, 1) != false { panic(104100); };
    if ecs_ec_deep_has(w, 0, 2) != true { panic(104101); };
}

@test "lifecycle_insert_remove_clone_despawn"() {
    let w = ecs_ec_deep_spawn(ecs_ec_deep_world_new(), 0);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_insert(0, 1, ECS_EC_DEEP_INSERT_REPLACE));
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_insert(1, 2, ECS_EC_DEEP_INSERT_REPLACE));
    w = ecs_ec_deep_spawn(w, 1);
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_clone_components(1, ecs_ec_deep_or_masks(ecs_ec_deep_bit(0), ecs_ec_deep_bit(1))));
    if ecs_ec_deep_has(w, 1, 0) != true { panic(104110); };
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_remove(0));
    if ecs_ec_deep_has(w, 0, 0) != false { panic(104111); };
    w = ecs_ec_deep_apply(w, 0, ecs_ec_deep_cmd_despawn());
    if ecs_ec_deep_occupied(w, 0) != false { panic(104112); };
    if ecs_ec_deep_occupied(w, 1) != true { panic(104113); };
}
