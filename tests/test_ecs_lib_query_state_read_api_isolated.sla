@import "lib/query_state_read_api.sla"

// Isolated tests for lib/query_state_read_api.sla — QueryState read API gaps (single/single_mut/is_empty/contains/get/get_mut/get_many[_mut/_unique/_unique_mut]/iter_many[_mut/_unique/_unique_mut] + try_new/from_builder/update_archetypes + error markers). Bevy reference: src/query/state.rs.

@test "qe_err_codes"() {
    if ecs_qe_err_query_does_not_match() != 0 { panic(91259); };
    if ecs_qe_err_not_spawned() != 1 { panic(91260); };
    if ecs_qe_err_aliased_mutability() != 2 { panic(91261); };
    if !ecs_qe_err_is_query_does_not_match(0) { panic(91262); };
    if !ecs_qe_err_is_not_spawned(1) { panic(91263); };
    if !ecs_qe_err_is_aliased_mutability(2) { panic(91264); };
}

@test "qs_err_codes"() {
    if ecs_qs_err_no_entities() != 0 { panic(91265); };
    if ecs_qs_err_multiple_entities() != 1 { panic(91266); };
    if !ecs_qs_err_is_no_entities(0) { panic(91267); };
    if !ecs_qs_err_is_multiple_entities(1) { panic(91268); };
}

@test "try_new_valid_world"() {
    let res = ecs_qs_read_api_try_new(7, 1);
    let s = res.0; let ok = res.1;
    if ok != 1 { panic(91269); };
    if ecs_qs_read_api_try_new_ok(s) != 1 { panic(91270); };
    if ecs_qs_read_api_world_id(s) != 7 { panic(91271); };
}

@test "try_new_invalid_world"() {
    let res = ecs_qs_read_api_try_new(0, 1);
    if res.1 != 0 { panic(91272); };
    let s = res.0;
    if ecs_qs_read_api_try_new_ok(s) != 0 { panic(91273); };
}

@test "from_builder_records_source"() {
    let s = ecs_qs_read_api_from_builder(42, 1, 5);
    if ecs_qs_read_api_builder_source(s) != 42 { panic(91274); };
    if ecs_qs_read_api_world_id(s) != 5 { panic(91275); };
}

@test "is_empty_true_initially"() {
    let s = ecs_qs_read_api_new(1, 1);
    if !ecs_qs_read_api_is_empty(s) { panic(91276); };
}

@test "is_empty_false_after_spawn"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 10);
    if ecs_qs_read_api_is_empty(res.0) { panic(91277); };
}

@test "update_archetypes_bumps_generation"() {
    let s = ecs_qs_read_api_new(1, 1);
    if ecs_qs_read_api_archetype_generation(s) != 0 { panic(91278); };
    let s2 = ecs_qs_read_api_update_archetypes(s);
    if ecs_qs_read_api_archetype_generation(s2) != 1 { panic(91279); };
    let s3 = ecs_qs_read_api_update_archetypes(s2);
    if ecs_qs_read_api_archetype_generation(s3) != 2 { panic(91280); };
}

@test "contains_spawned_and_missing"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 5);
    let s2 = res.0;
    if !ecs_qs_read_api_contains(s2, 0) { panic(91281); };
    if ecs_qs_read_api_contains(s2, 99) { panic(91282); };
    if ecs_qs_read_api_contains(s2, -1) { panic(91283); };
}

@test "single_no_entities_error"() {
    let s = ecs_qs_read_api_new(1, 1);
    let r = ecs_qs_read_api_single(s);
    if ecs_qs_single_found(r) { panic(91284); };
    if ecs_qs_single_err_code(r) != ecs_qs_err_no_entities() { panic(91285); };
}

@test "single_multiple_entities_error"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 1);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 2);
    let s3 = res2.0;
    let r = ecs_qs_read_api_single(s3);
    if ecs_qs_single_found(r) { panic(91286); };
    if ecs_qs_single_err_code(r) != ecs_qs_err_multiple_entities() { panic(91287); };
}

@test "single_one_entity_success"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 42);
    let s2 = res.0;
    let r = ecs_qs_read_api_single(s2);
    if !ecs_qs_single_found(r) { panic(91288); };
    if ecs_qs_single_entity_idx(r) != 0 { panic(91289); };
    if ecs_qs_single_value(r) != 42 { panic(91290); };
}

@test "single_mut_equivalent_to_single"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 7);
    let s2 = res.0;
    let r = ecs_qs_read_api_single_mut(s2);
    if !ecs_qs_single_found(r) { panic(91291); };
    if ecs_qs_single_value(r) != 7 { panic(91292); };
}

@test "get_success_returns_value"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 99);
    let s2 = res.0;
    let r = ecs_qs_read_api_get(s2, 0);
    if ecs_qs_get_ok(r) != 1 { panic(91293); };
    if ecs_qs_get_value(r) != 99 { panic(91294); };
}

@test "get_not_spawned_error"() {
    let s = ecs_qs_read_api_new(1, 1);
    let r = ecs_qs_read_api_get(s, 50);
    if ecs_qs_get_ok(r) != 0 { panic(91295); };
    if ecs_qs_get_err_code(r) != ecs_qe_err_not_spawned() { panic(91296); };
}

@test "get_mut_equivalent_to_get"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 11);
    let s2 = res.0;
    let r = ecs_qs_read_api_get_mut(s2, 0);
    if ecs_qs_get_ok(r) != 1 { panic(91297); };
    if ecs_qs_get_value(r) != 11 { panic(91298); };
}

@test "get_many_ro_all_match"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 10);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 20);
    let s3 = res2.0;
    let res3 = ecs_qs_read_api_spawn(s3, 30);
    let s4 = res3.0;
    let entities = Vec::new();
    entities.push(0); entities.push(1); entities.push(2);
    let r = ecs_qs_read_api_get_many_ro(s4, entities);
    if ecs_qs_getmany_count(r) != 3 { panic(91299); };
    if ecs_qs_getmany_matched(r) != 3 { panic(91300); };
    if ecs_qs_getmany_sum(r) != 60 { panic(91301); };
    if ecs_qs_getmany_first_value(r) != 10 { panic(91302); };
    if ecs_qs_getmany_first_err(r) != -1 { panic(91303); };
}

@test "get_many_ro_allows_duplicate_entities"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 10);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 20);
    let s3 = res2.0;
    let entities = Vec::new();
    entities.push(0); entities.push(0); entities.push(1);
    let r = ecs_qs_read_api_get_many_ro(s3, entities);
    if ecs_qs_getmany_matched(r) != 3 { panic(91304); };
    if ecs_qs_getmany_sum(r) != 40 { panic(91305); };
    // ro path allows duplication, no aliasing error
    if ecs_qs_getmany_first_err(r) != -1 { panic(91306); };
}

@test "get_many_ro_skips_not_spawned"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res = ecs_qs_read_api_spawn(s, 5);
    let s2 = res.0;
    let entities = Vec::new();
    entities.push(0); entities.push(99);
    let r = ecs_qs_read_api_get_many_ro(s2, entities);
    if ecs_qs_getmany_matched(r) != 1 { panic(91307); };
    if ecs_qs_getmany_sum(r) != 5 { panic(91308); };
    if ecs_qs_getmany_first_err(r) != ecs_qe_err_not_spawned() { panic(91309); };
}

@test "get_many_mut_aliasing_error"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 10);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 20);
    let s3 = res2.0;
    let entities = Vec::new();
    entities.push(0); entities.push(0);
    let r = ecs_qs_read_api_get_many_mut(s3, entities);
    // both match, but aliasing detected
    if ecs_qs_getmany_first_err(r) != ecs_qe_err_aliased_mutability() { panic(91310); };
    if ecs_qs_getmany_aliased_idx(r) != 0 { panic(91311); };
}

@test "get_many_mut_no_alias_succeeds"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 10);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 20);
    let s3 = res2.0;
    let entities = Vec::new();
    entities.push(0); entities.push(1);
    let r = ecs_qs_read_api_get_many_mut(s3, entities);
    if ecs_qs_getmany_first_err(r) != -1 { panic(91312); };
    if ecs_qs_getmany_sum(r) != 30 { panic(91313); };
}

@test "get_many_unique_dup_is_error"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 10);
    let s2 = res1.0;
    let entities = Vec::new();
    entities.push(0); entities.push(0);
    let r = ecs_qs_read_api_get_many_unique(s2, entities);
    if ecs_qs_getmany_first_err(r) != ecs_qe_err_aliased_mutability() { panic(91314); };
    if ecs_qs_getmany_aliased_idx(r) != 0 { panic(91315); };
}

@test "get_many_unique_no_dup_succeeds"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 1);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 2);
    let s3 = res2.0;
    let entities = Vec::new();
    entities.push(0); entities.push(1);
    let r = ecs_qs_read_api_get_many_unique(s3, entities);
    if ecs_qs_getmany_matched(r) != 2 { panic(91316); };
    if ecs_qs_getmany_sum(r) != 3 { panic(91317); };
}

@test "get_many_unique_mut_dup_is_error"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 10);
    let s2 = res1.0;
    let entities = Vec::new();
    entities.push(0); entities.push(0);
    let r = ecs_qs_read_api_get_many_unique_mut(s2, entities);
    if ecs_qs_getmany_first_err(r) != ecs_qe_err_aliased_mutability() { panic(91318); };
    if ecs_qs_getmany_aliased_idx(r) != 0 { panic(91319); };
}

@test "iter_many_matched_and_sum"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 5);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 10);
    let s3 = res2.0;
    let res3 = ecs_qs_read_api_spawn(s3, 15);
    let s4 = res3.0;
    let entities = Vec::new();
    entities.push(0); entities.push(2); entities.push(99);
    let r = ecs_qs_read_api_iter_many(s4, entities);
    if ecs_qs_itermany_requested(r) != 3 { panic(91320); };
    if ecs_qs_itermany_matched(r) != 2 { panic(91321); };
    if ecs_qs_itermany_sum(r) != 20 { panic(91322); };
}

@test "iter_many_mut_no_alias_check_in_model"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 5);
    let s2 = res1.0;
    let entities = Vec::new();
    entities.push(0); entities.push(0);
    let r = ecs_qs_read_api_iter_many_mut(s2, entities);
    // iter_many_mut does not enforce aliasing in Bevy either; model reduces simply
    if ecs_qs_itermany_matched(r) != 2 { panic(91323); };
    if ecs_qs_itermany_sum(r) != 10 { panic(91324); };
}

@test "iter_many_unique_and_unique_mut_reduce"() {
    let s = ecs_qs_read_api_new(1, 1);
    let res1 = ecs_qs_read_api_spawn(s, 3);
    let s2 = res1.0;
    let res2 = ecs_qs_read_api_spawn(s2, 6);
    let s3 = res2.0;
    let entities = Vec::new();
    entities.push(0); entities.push(1);
    let ru = ecs_qs_read_api_iter_many_unique(s3, entities);
    if ecs_qs_itermany_sum(ru) != 9 { panic(91325); };
    let rum = ecs_qs_read_api_iter_many_unique_mut(s3, entities);
    if ecs_qs_itermany_sum(rum) != 9 { panic(91326); };
}
