@import "lib/unique_vec_extras_deep.sla"

// Batch 322: unique_vec_extras deep.
// panic codes: 130400 – 130599.

@test "new_empty"() {
    let v = ecs_uve_deep_new();
    if ecs_uve_deep_is_empty(v) != true { panic(130400); };
    if ecs_uve_deep_capacity(v) != 0 { panic(130401); };
}

@test "with_capacity_and_spare"() {
    let v = ecs_uve_deep_with_capacity(5);
    if ecs_uve_deep_capacity(v) != 5 { panic(130410); };
    if ecs_uve_deep_spare(v) != 5 { panic(130411); };
}

@test "push_and_at"() {
    let v = ecs_uve_deep_new();
    v = ecs_uve_deep_push_unchecked(v, 1);
    v = ecs_uve_deep_push_unchecked(v, 2);
    if ecs_uve_deep_len(v) != 2 { panic(130420); };
    if ecs_uve_deep_at(v, 1) != 2 { panic(130421); };
    if ecs_uve_deep_contains(v, 1) != true { panic(130422); };
}

@test "reserve_grows"() {
    let v = ecs_uve_deep_push_unchecked(ecs_uve_deep_new(), 1);
    v = ecs_uve_deep_reserve(v, 4);
    if ecs_uve_deep_capacity(v) >= 5 { } else { panic(130430); };
}

@test "try_reserve"() {
    let r = ecs_uve_deep_try_reserve(ecs_uve_deep_new(), 3);
    if ecs_uve_try_ok(r) != true { panic(130440); };
    if ecs_uve_deep_capacity(ecs_uve_try_vec(r)) != 3 { panic(130441); };
    let bad = ecs_uve_deep_try_reserve(ecs_uve_deep_new(), 0 - 1);
    if ecs_uve_try_ok(bad) != false { panic(130442); };
}

@test "split_off_middle"() {
    let v = ecs_uve_deep_new();
    v = ecs_uve_deep_push_unchecked(v, 1);
    v = ecs_uve_deep_push_unchecked(v, 2);
    v = ecs_uve_deep_push_unchecked(v, 3);
    let s = ecs_uve_deep_split_off(v, 1);
    if ecs_uve_deep_len(ecs_uve_split_left(s)) != 1 { panic(130450); };
    if ecs_uve_deep_len(ecs_uve_split_right(s)) != 2 { panic(130451); };
    if ecs_uve_deep_at(ecs_uve_split_left(s), 0) != 1 { panic(130452); };
    if ecs_uve_deep_at(ecs_uve_split_right(s), 0) != 2 { panic(130453); };
}

@test "split_off_edges"() {
    let v = ecs_uve_deep_push_unchecked(ecs_uve_deep_push_unchecked(ecs_uve_deep_new(), 1), 2);
    let s0 = ecs_uve_deep_split_off(v, 0);
    if ecs_uve_deep_is_empty(ecs_uve_split_left(s0)) != true { panic(130460); };
    if ecs_uve_deep_len(ecs_uve_split_right(s0)) != 2 { panic(130461); };
    let s2 = ecs_uve_deep_split_off(v, 2);
    if ecs_uve_deep_len(ecs_uve_split_left(s2)) != 2 { panic(130462); };
    if ecs_uve_deep_is_empty(ecs_uve_split_right(s2)) != true { panic(130463); };
}

@test "clear_preserves_cap"() {
    let v = ecs_uve_deep_reserve(ecs_uve_deep_push_unchecked(ecs_uve_deep_new(), 1), 3);
    v = ecs_uve_deep_clear(v);
    if ecs_uve_deep_is_empty(v) != true { panic(130470); };
    if ecs_uve_deep_capacity(v) >= 3 { } else { panic(130471); };
}

@test "mark_leaked"() {
    let v = ecs_uve_deep_mark_leaked(ecs_uve_deep_new());
    if ecs_uve_deep_leaked(v) != 1 { panic(130480); };
}

@test "capacity_eight_push"() {
    let v = ecs_uve_deep_new();
    v = ecs_uve_deep_push_unchecked(v, 1);
    v = ecs_uve_deep_push_unchecked(v, 2);
    v = ecs_uve_deep_push_unchecked(v, 3);
    v = ecs_uve_deep_push_unchecked(v, 4);
    v = ecs_uve_deep_push_unchecked(v, 5);
    v = ecs_uve_deep_push_unchecked(v, 6);
    v = ecs_uve_deep_push_unchecked(v, 7);
    v = ecs_uve_deep_push_unchecked(v, 8);
    if ecs_uve_deep_len(v) != 8 { panic(130490); };
    v = ecs_uve_deep_push_unchecked(v, 9);
    if ecs_uve_deep_len(v) != 8 { panic(130491); };
}
