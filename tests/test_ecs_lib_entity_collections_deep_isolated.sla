// Isolated deep tests for lib/entity_collections_deep.sla (Batch 352).
// panic codes: 136400 - 136599.

@import "lib/entity_collections_deep.sla"

@test "EntityIndexSet new is empty"() {
    let s = ecs_entity_index_set_new();
    if ecs_entity_index_set_len(s) != 0 { panic(136400); };
    if ecs_entity_index_set_is_empty(s) != true { panic(136401); };
    if ecs_entity_index_set_contains(s, 1) != false { panic(136402); };
    let sw = ecs_entity_index_set_with_capacity(32);
    if ecs_entity_index_set_len(sw) != 0 { panic(136403); };
}

@test "EntityIndexSet insert dedup and capacity"() {
    let s0 = ecs_entity_index_set_new();
    let r1 = ecs_entity_index_set_insert(s0, 1);
    if ecs_entity_index_set_op_inserted(r1) != 1 { panic(136410); };
    let s1 = ecs_entity_index_set_op_set(r1);
    if ecs_entity_index_set_len(s1) != 1 { panic(136411); };
    // Inserting same item again is no-op.
    let r2 = ecs_entity_index_set_insert(s1, 1);
    if ecs_entity_index_set_op_inserted(r2) != 0 { panic(136412); };
    if ecs_entity_index_set_len(ecs_entity_index_set_op_set(r2)) != 1 { panic(136413); };
    // Add 7 distinct items - reaches cap of 8 total.
    let s = ecs_entity_index_set_op_set(r2);
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 2));
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 3));
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 4));
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 5));
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 6));
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 7));
    s = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s, 8));
    if ecs_entity_index_set_len(s) != 8 { panic(136414); };
    // Inserting a 9th distinct item is rejected by cap.
    let r3 = ecs_entity_index_set_insert(s, 9);
    if ecs_entity_index_set_op_inserted(r3) != 0 { panic(136415); };
}

@test "EntityIndexSet contains after inserts"() {
    let s0 = ecs_entity_index_set_new();
    let s1 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 100));
    let s2 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s1, 200));
    if ecs_entity_index_set_contains(s2, 100) != true { panic(136420); };
    if ecs_entity_index_set_contains(s2, 200) != true { panic(136421); };
    if ecs_entity_index_set_contains(s2, 999) != false { panic(136422); };
}

@test "EntityIndexSet get_index returns slot or -1"() {
    let s0 = ecs_entity_index_set_new();
    let s1 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 100));
    let s2 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s1, 200));
    if ecs_entity_index_set_get_index(s2, 100) != 0 { panic(136430); };
    if ecs_entity_index_set_get_index(s2, 200) != 1 { panic(136431); };
    if ecs_entity_index_set_get_index(s2, 999) != -1 { panic(136432); };
}

@test "EntityIndexSet swap_remove existing preserves others but reorders"() {
    let s0 = ecs_entity_index_set_new();
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 10));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 20));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 30));
    // Remove middle (20): swaps last (30) into slot index 1.
    let r = ecs_entity_index_set_swap_remove(s0, 20);
    if ecs_entity_index_set_op_inserted(r) != 1 { panic(136440); };
    let s1 = ecs_entity_index_set_op_set(r);
    if ecs_entity_index_set_len(s1) != 2 { panic(136441); };
    if ecs_entity_index_set_contains(s1, 20) != false { panic(136442); };
    if ecs_entity_index_set_contains(s1, 10) != true { panic(136443); };
    if ecs_entity_index_set_contains(s1, 30) != true { panic(136444); };
    // 30 moved into slot 1; 10 stays at slot 0.
    if ecs_entity_index_set_get_index(s1, 10) != 0 { panic(136445); };
    if ecs_entity_index_set_get_index(s1, 30) != 1 { panic(136446); };
}

@test "EntityIndexSet swap_remove absent is no-op"() {
    let s0 = ecs_entity_index_set_new();
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 11));
    let r = ecs_entity_index_set_swap_remove(s0, 99);
    if ecs_entity_index_set_op_inserted(r) != 0 { panic(136450); };
    if ecs_entity_index_set_len(ecs_entity_index_set_op_set(r)) != 1 { panic(136451); };
}

@test "EntityIndexSet shift_remove preserves insertion order"() {
    let s0 = ecs_entity_index_set_new();
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 10));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 20));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 30));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 40));
    // Remove 20: order preserved (10, 30, 40).
    let r = ecs_entity_index_set_shift_remove(s0, 20);
    if ecs_entity_index_set_op_inserted(r) != 1 { panic(136460); };
    let s1 = ecs_entity_index_set_op_set(r);
    if ecs_entity_index_set_len(s1) != 3 { panic(136461); };
    if ecs_entity_index_set_get_index(s1, 10) != 0 { panic(136462); };
    if ecs_entity_index_set_get_index(s1, 30) != 1 { panic(136463); };
    if ecs_entity_index_set_get_index(s1, 40) != 2 { panic(136464); };
    if ecs_entity_index_set_contains(s1, 20) != false { panic(136465); };
}

@test "EntityIndexSet any marker matches contains"() {
    let s0 = ecs_entity_index_set_new();
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 100));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 200));
    if ecs_entity_index_set_any(s0, 200) != true { panic(136470); };
    if ecs_entity_index_set_any(s0, 1) != false { panic(136471); };
}

@test "EntityIndexSet into_iter marker returns same"() {
    let s0 = ecs_entity_index_set_new();
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 1));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 2));
    let i = ecs_entity_index_set_into_iter(s0);
    if ecs_entity_index_set_len(i) != 2 { panic(136480); };
    if ecs_entity_index_set_at(i, 0) != 1 { panic(136481); };
    if ecs_entity_index_set_at(i, 1) != 2 { panic(136482); };
}

@test "EntityIndexSet clear resets to empty"() {
    let s0 = ecs_entity_index_set_new();
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 1));
    s0 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s0, 2));
    if ecs_entity_index_set_len(s0) != 2 { panic(136490); };
    let s1 = ecs_entity_index_set_clear(s0);
    if ecs_entity_index_set_len(s1) != 0 { panic(136491); };
    if ecs_entity_index_set_contains(s1, 1) != false { panic(136492); };
    if ecs_entity_index_set_contains(s1, 2) != false { panic(136493); };
    // Re-insertion after clear works.
    let s2 = ecs_entity_index_set_op_set(ecs_entity_index_set_insert(s1, 100));
    if ecs_entity_index_set_len(s2) != 1 { panic(136494); };
    if ecs_entity_index_set_contains(s2, 100) != true { panic(136495); };
}
