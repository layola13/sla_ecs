@import "lib/hot_patch_deep.sla"

// Batch 320: hot_patch deep.
// panic codes: 130000 – 130199.

@test "registered"() {
    let m = ecs_hp_deep_new();
    if ecs_hp_deep_is_registered(m) != true { panic(130000); };
}

@test "changes_apply"() {
    let c = ecs_hp_changes_new();
    if ecs_hp_changes_last(c) != 0 { panic(130010); };
    c = ecs_hp_changes_apply(c, 15);
    if ecs_hp_changes_last(c) != 15 { panic(130011); };
}

@test "changed_after"() {
    let c = ecs_hp_changes_apply(ecs_hp_changes_new(), 10);
    if ecs_hp_changes_is_changed_after(c, 5) != true { panic(130020); };
    if ecs_hp_changes_is_changed_after(c, 10) != false { panic(130021); };
}

@test "is_none_or"() {
    if ecs_hp_changes_is_none_or(false, 99, 1) != true { panic(130030); };
    if ecs_hp_changes_is_none_or(true, 5, 10) != true { panic(130031); };
    if ecs_hp_changes_is_none_or(true, 15, 10) != false { panic(130032); };
}

@test "should_refresh"() {
    if ecs_hp_should_refresh(false, 20, 1) != false { panic(130040); };
    if ecs_hp_should_refresh(true, 20, 1) != true { panic(130041); };
    if ecs_hp_should_refresh(true, 1, 20) != false { panic(130042); };
}

@test "sys_new"() {
    let s = ecs_hp_sys_new(3);
    if ecs_hp_sys_last_run(s) != 3 { panic(130050); };
    if ecs_hp_sys_refreshed(s) != false { panic(130051); };
}

@test "sys_refresh"() {
    let s = ecs_hp_sys_refresh(ecs_hp_sys_new(1), 9);
    if ecs_hp_sys_last_run(s) != 9 { panic(130060); };
    if ecs_hp_sys_refreshed(s) != true { panic(130061); };
}

@test "maybe_refresh_yes"() {
    let s = ecs_hp_maybe_refresh(ecs_hp_sys_new(1), true, 5);
    if ecs_hp_sys_refreshed(s) != true { panic(130070); };
    if ecs_hp_sys_last_run(s) != 5 { panic(130071); };
}

@test "maybe_refresh_no_resource"() {
    let s = ecs_hp_maybe_refresh(ecs_hp_sys_new(1), false, 5);
    if ecs_hp_sys_refreshed(s) != false { panic(130080); };
    if ecs_hp_sys_last_run(s) != 1 { panic(130081); };
}

@test "maybe_refresh_stale"() {
    let s = ecs_hp_maybe_refresh(ecs_hp_sys_new(10), true, 5);
    if ecs_hp_sys_refreshed(s) != false { panic(130090); };
}
