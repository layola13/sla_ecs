// Isolated deep tests for lib/system_param_archetype_value_deep.sla (Batch 387).
// Mirrors shallow lib/system_param_archetype_value.sla's system-parameter adapter set as a
// SELF-CONTAINED fixed-cap archetype-value world with inlined run_*_system bus bodies (SA cannot
// pass fns as values; the deep hard-codes each system_* body inside its bus). No @import. Wrapper
// structs / scalar accessors (no tuple-return destructuring, no `let m = fn(m,...)` chained rebinds).
// panic codes: 142900 - 142999.

@import "lib/system_param_archetype_value_deep.sla"

// ── Test 1 (mirror shallow test 1): pair query system param writes back first.value = first + second. ──
@test "EcsAvSystemParamDeep run_pair_mut_system writes back first+second + changed_since"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let position = ecs_av_register_info_deep(r1);
    if ecs_av_comp_info_id_deep(position) != 1 { panic(142900); };
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let velocity = ecs_av_register_info_deep(r2);
    if ecs_av_comp_info_id_deep(velocity) != 2 { panic(142901); };
    let sp1 = ecs_av_world_deep_spawn(w2);
    let w3 = ecs_av_spawn_world_deep(sp1);
    let entity = ecs_av_spawn_entity_deep(sp1);
    if ecs_av_entity_id_deep(entity) != 0 { panic(142902); };
    let w4 = ecs_av_world_deep_insert(w3, entity, ecs_av_comp_info_id_deep(position), ecs_av_data_new(8));
    let w5 = ecs_av_world_deep_insert(w4, entity, ecs_av_comp_info_id_deep(velocity), ecs_av_data_new(3));
    let before = ecs_av_world_deep_change_tick(w5);
    let group_before = ecs_av_world_deep_entity_archetype_id(w5, entity);
    let row_before = ecs_av_world_deep_entity_row(w5, entity);
    let w6 = ecs_av_run_pair_mut_system(w5, ecs_av_comp_info_id_deep(position), ecs_av_comp_info_id_deep(velocity));
    let out = ecs_av_world_deep_get(w6, entity, ecs_av_comp_info_id_deep(position));
    if ecs_av_data_amount(out) != 11 { panic(142903); };
    if ecs_av_world_deep_entity_archetype_id(w6, entity) != group_before { panic(142904); };
    if ecs_av_world_deep_entity_row(w6, entity) != row_before { panic(142905); };
    if ecs_av_world_deep_changed_since(w6, entity, ecs_av_comp_info_id_deep(position), before - 1) != true { panic(142906); };
}

// ── Test 2 (mirror shallow test 2): resource_message_system writes tick+1 + event.amount=tick+4. ──
@test "EcsAvSystemParamDeep run_resource_message_system writes tick+1 + event.amount=tick+4"() {
    let w0 = ecs_av_world_deep_new();
    let w1 = ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(5));
    let w2 = ecs_av_run_resource_message_system(w1, ecs_av_event_default());
    let time = ecs_av_world_deep_get_resource(w2);
    if ecs_av_time_tick(time) != 6 { panic(142910); };
    let event = ecs_av_world_deep_read_message(w2, ecs_av_reader_new(), ecs_av_event_default());
    if ecs_av_read_has_value(event) != true { panic(142911); };
    if ecs_av_event_amount(ecs_av_read_value(event)) != 9 { panic(142912); };
}

// ── Test 3 (mirror shallow test 3): res_mut_system bumps resource.tick by 2 + changed_since. ──
@test "EcsAvSystemParamDeep run_res_mut_system bumps +2 + change tracking"() {
    let w0 = ecs_av_world_deep_new();
    let w1 = ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(4));
    let before = ecs_av_world_deep_change_tick(w1);
    let w2 = ecs_av_world_deep_increment_tick(w1);
    let w3 = ecs_av_run_res_mut_system(w2);
    let out = ecs_av_world_deep_get_resource(w3);
    if ecs_av_time_tick(out) != 6 { panic(142920); };
    if ecs_av_world_deep_resource_added_since(w3, before) != false { panic(142921); };
    if ecs_av_world_deep_resource_changed_since(w3, before) != true { panic(142922); };
}

// ── Test 4 (mirror shallow test 4): message_reader + resmut advances cursor + reads amount+5. ──
@test "EcsAvSystemParamDeep run_message_reader_resmut_system advances cursor + reads event"() {
    let w0 = ecs_av_world_deep_new();
    let w1 = ecs_av_world_deep_insert_resource(w0, ecs_av_time_new(1));
    let w2 = ecs_av_world_deep_write_message(w1, ecs_av_event_new(5));
    let reader0 = ecs_av_reader_new();
    let run1 = ecs_av_run_message_reader_res_mut_system(w2, reader0, ecs_av_event_default());
    let w3 = ecs_av_run_reader_world(run1);
    let reader1 = ecs_av_run_reader_reader(run1);
    let out1 = ecs_av_world_deep_get_resource(w3);
    if ecs_av_time_tick(out1) != 6 { panic(142930); };
    let run2 = ecs_av_run_message_reader_res_mut_system(w3, reader1, ecs_av_event_default());
    let w4 = ecs_av_run_reader_world(run2);
    let reader2 = ecs_av_run_reader_reader(run2);
    let out2 = ecs_av_world_deep_get_resource(w4);
    if ecs_av_time_tick(out2) != 6 { panic(142931); };
    if ecs_av_reader_cursor(reader2) != 1 { panic(142932); };
}

// ── Test 5 (mirror shallow test 5): commands_system queues reserve + insert + resource + message
//    and applies. The deep's bus takes the reserved entity-id and the component-id as args
//    (the body has the systems inputs fixed; the bus owns apply). The test reserves an entity via
//    the orphaned command queue helper to derive the eid, then runs the bus.
@test "EcsAvSystemParamDeep run_commands_system queues + applies insert/resource/message"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    if ecs_av_comp_info_id_deep(health) != 1 { panic(142940); };
    // Reserve an entity explicitly so the bus can drive the insert at the right eid; the shallow's
    // `archetype_param_commands_system` body did this internally and returned the eid to the bus.
    let sp = ecs_av_actor_reserve_for_commands(w1);
    let w2 = ecs_av_actor_reserve_world(sp);
    let reserved_eid = ecs_av_actor_reserve_eid(sp);
    if reserved_eid != 0 { panic(142941); };
    let w3 = ecs_av_run_commands_system(w2, ecs_av_comp_info_id_deep(health), reserved_eid);
    let query = ecs_av_world_deep_query(w3, ecs_av_comp_info_id_deep(health));
    if ecs_av_query_deep_count(query) != 1 { panic(142942); };
    let item0 = ecs_av_query_deep_at(query, 0);
    if ecs_av_data_amount(ecs_av_entity_item_value(item0)) != 12 { panic(142943); };
    let time = ecs_av_world_deep_get_resource(w3);
    if ecs_av_time_tick(time) != 7 { panic(142944); };
    let event = ecs_av_world_deep_read_message(w3, ecs_av_reader_new(), ecs_av_event_default());
    if ecs_av_read_has_value(event) != true { panic(142945); };
    if ecs_av_event_amount(ecs_av_read_value(event)) != 4 { panic(142946); };
}

// ── Test 6 (mirror shallow test 6): message_writer_system sends amount=2 + amount=8 in order. ──
@test "EcsAvSystemParamDeep run_message_writer_system batches messages in send order"() {
    let w0 = ecs_av_world_deep_new();
    let w1 = ecs_av_run_message_writer_system(w0);
    let read1 = ecs_av_world_deep_read_message(w1, ecs_av_reader_new(), ecs_av_event_default());
    if ecs_av_read_has_value(read1) != true { panic(142950); };
    if ecs_av_event_amount(ecs_av_read_value(read1)) != 2 { panic(142951); };
    let read2 = ecs_av_world_deep_read_message(w1, ecs_av_read_reader(read1), ecs_av_event_default());
    if ecs_av_read_has_value(read2) != true { panic(142952); };
    if ecs_av_event_amount(ecs_av_read_value(read2)) != 8 { panic(142953); };
}

// ── Test 7 (mirror shallow test 7): filtered query params - with/without/added/changed update
//    resource.tick = query.count. Mirrors the same tick dance as the shallow: take-from + replace.
@test "EcsAvSystemParamDeep run_with/without/added/changed query_resource_system"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let health = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let selected = ecs_av_register_info_deep(r2);
    let sp1 = ecs_av_world_deep_spawn(w2);
    let w3 = ecs_av_spawn_world_deep(sp1);
    let e1 = ecs_av_spawn_entity_deep(sp1);
    let sp2 = ecs_av_world_deep_spawn(w3);
    let w4 = ecs_av_spawn_world_deep(sp2);
    let e2 = ecs_av_spawn_entity_deep(sp2);
    let w5 = ecs_av_world_deep_insert_resource(w4, ecs_av_time_new(0));
    if ecs_av_world_deep_has_resource(w5) != true { panic(142960); };
    let t_after_registers = ecs_av_world_deep_change_tick(w5);
    let w5a = ecs_av_world_deep_increment_tick(w5);
    let w6 = ecs_av_world_deep_insert(w5a, e1, ecs_av_comp_info_id_deep(health), ecs_av_data_new(5));
    let w7 = ecs_av_world_deep_insert(w6, e2, ecs_av_comp_info_id_deep(health), ecs_av_data_new(7));
    let w8 = ecs_av_world_deep_insert(w7, e2, ecs_av_comp_info_id_deep(selected), ecs_av_data_new(1));
    let w8a = ecs_av_run_with_query_resource_system(w8, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(selected));
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w8a)) != 1 { panic(142961); };
    let w9 = ecs_av_run_without_query_resource_system(w8a, ecs_av_comp_info_id_deep(health), ecs_av_comp_info_id_deep(selected));
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w9)) != 1 { panic(142962); };
    let w10 = ecs_av_run_added_query_resource_system(w9, ecs_av_comp_info_id_deep(health), t_after_registers);
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w10)) != 2 { panic(142963); };
    let t_before_change = ecs_av_world_deep_change_tick(w10);
    let w11 = ecs_av_world_deep_increment_tick(w10);
    let mut_query = ecs_av_world_deep_query_mut(w11, ecs_av_comp_info_id_deep(health));
    let item0 = ecs_av_query_deep_at(mut_query, 0);
    let w12 = ecs_av_world_deep_write(w11, ecs_av_entity_item_entity(item0), ecs_av_comp_info_id_deep(health), ecs_av_data_new(9));
    let w13 = ecs_av_run_changed_query_resource_system(w12, ecs_av_comp_info_id_deep(health), t_before_change);
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w13)) != 1 { panic(142964); };
    let out_e1 = ecs_av_world_deep_get(w13, e1, ecs_av_comp_info_id_deep(health));
    if ecs_av_data_amount(out_e1) != 9 { panic(142965); };
}

// ── Test 8 (mirror shallow test 8): schedule runs movement-pair + time-message in sequence. ──
@test "EcsAvSystemParamDeep schedule runs movement-pair + time-message in sequence"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let position = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let velocity = ecs_av_register_info_deep(r2);
    let sp1 = ecs_av_world_deep_spawn(w2);
    let w3 = ecs_av_spawn_world_deep(sp1);
    let entity = ecs_av_spawn_entity_deep(sp1);
    let w4 = ecs_av_world_deep_insert(w3, entity, ecs_av_comp_info_id_deep(position), ecs_av_data_new(1));
    let w5 = ecs_av_world_deep_insert(w4, entity, ecs_av_comp_info_id_deep(velocity), ecs_av_data_new(4));
    let w6 = ecs_av_world_deep_insert_resource(w5, ecs_av_time_new(2));
    // schedule.add_system(movement) + schedule.add_system(time_message) + schedule.run.
    let w7 = ecs_av_schedule_run_movement_resource(w6, ecs_av_comp_info_id_deep(position), ecs_av_comp_info_id_deep(velocity));
    let out = ecs_av_world_deep_get(w7, entity, ecs_av_comp_info_id_deep(position));
    if ecs_av_data_amount(out) != 5 { panic(142970); };
    let time = ecs_av_world_deep_get_resource(w7);
    if ecs_av_time_tick(time) != 3 { panic(142971); };
    let event = ecs_av_world_deep_read_message(w7, ecs_av_reader_new(), ecs_av_event_default());
    if ecs_av_read_has_value(event) != true { panic(142972); };
    if ecs_av_event_amount(ecs_av_read_value(event)) != 6 { panic(142973); };
}

// ── Test 9 (standalone extended): multi-entity pair + despawn + cap rejections. ──
@test "EcsAvSystemParamDeep pair_mut across 2 entities + despawn + cap-8 rejects"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let pos = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let vel = ecs_av_register_info_deep(r2);
    // spawn two entities; insert distinct pos/vel on each.
    let sp1 = ecs_av_world_deep_spawn(w2);
    let w3 = ecs_av_spawn_world_deep(sp1);
    let e1 = ecs_av_spawn_entity_deep(sp1);
    let sp2 = ecs_av_world_deep_spawn(w3);
    let w4 = ecs_av_spawn_world_deep(sp2);
    let e2 = ecs_av_spawn_entity_deep(sp2);
    let w5 = ecs_av_world_deep_insert(w4, e1, ecs_av_comp_info_id_deep(pos), ecs_av_data_new(2));
    let w6 = ecs_av_world_deep_insert(w5, e1, ecs_av_comp_info_id_deep(vel), ecs_av_data_new(5));
    let w7 = ecs_av_world_deep_insert(w6, e2, ecs_av_comp_info_id_deep(pos), ecs_av_data_new(3));
    let w8 = ecs_av_world_deep_insert(w7, e2, ecs_av_comp_info_id_deep(vel), ecs_av_data_new(7));
    let pre_count = ecs_av_world_deep_entity_count(w8);
    if pre_count != 2 { panic(142980); };
    let pair_query = ecs_av_world_deep_query_pair_mut_first(w8, ecs_av_comp_info_id_deep(pos), ecs_av_comp_info_id_deep(vel));
    if ecs_av_pair_query_mut_count(pair_query) != 2 { panic(142981); };
    // movement applied over two entities: pos becomes pos+vel (7 for e1, 10 for e2).
    let w9 = ecs_av_run_pair_mut_system(w8, ecs_av_comp_info_id_deep(pos), ecs_av_comp_info_id_deep(vel));
    if ecs_av_data_amount(ecs_av_world_deep_get(w9, e1, ecs_av_comp_info_id_deep(pos))) != 7 { panic(142982); };
    if ecs_av_data_amount(ecs_av_world_deep_get(w9, e2, ecs_av_comp_info_id_deep(pos))) != 10 { panic(142983); };
    // despawn e1; e1 dead; pair query now matches only e2.
    let w10 = ecs_av_world_deep_despawn(w9, e1);
    if ecs_av_world_deep_is_alive(w10, e1) != false { panic(142984); };
    if ecs_av_world_deep_entity_count(w10) != 1 { panic(142985); };
    let pair_query2 = ecs_av_world_deep_query_pair_mut_first(w10, ecs_av_comp_info_id_deep(pos), ecs_av_comp_info_id_deep(vel));
    if ecs_av_pair_query_mut_count(pair_query2) != 1 { panic(142986); };
}

// ── Test 10 (standalone): chained adapters - move + resource_message + res_mut verify the world
//    snapshot invariant: replace-paths bump changed only (added preserved); the by-ref aliasing
//    gotcha important lesson from Batch 386 -- capture since-ticks BEFORE incrementing (since the
//    deep's mutation alias rewires captured-tick variables ONLY when those variables were re-read
//    through change_tick AFTER the bump). This test asserts the deep's chained adapters produce a
//    stable final state.
@test "EcsAvSystemParamDeep chained movement + time-message + res_mut + cap-4 components rejects 5th register"() {
    let w0 = ecs_av_world_deep_new();
    let r1 = ecs_av_world_deep_register_table(w0);
    let w1 = ecs_av_register_world_deep(r1);
    let c0 = ecs_av_register_info_deep(r1);
    let r2 = ecs_av_world_deep_register_table(w1);
    let w2 = ecs_av_register_world_deep(r2);
    let c1 = ecs_av_register_info_deep(r2);
    let r3 = ecs_av_world_deep_register_table(w2);
    let w3 = ecs_av_register_world_deep(r3);
    let c2 = ecs_av_register_info_deep(r3);
    let r4 = ecs_av_world_deep_register_table(w3);
    let w4 = ecs_av_register_world_deep(r4);
    let c3 = ecs_av_register_info_deep(r4);
    // 5th register: cap-4 component cap reject silent (info.id = -1).
    let r5 = ecs_av_world_deep_register_table(w4);
    let w5 = ecs_av_register_world_deep(r5);
    let c4 = ecs_av_register_info_deep(r5);
    if ecs_av_comp_info_id_deep(c4) != -1 { panic(142990); };
    if ecs_av_world_deep_component_count(w5) != 4 { panic(142991); };
    let sp = ecs_av_world_deep_spawn(w5);
    let w6 = ecs_av_spawn_world_deep(sp);
    let e1 = ecs_av_spawn_entity_deep(sp);
    let w7 = ecs_av_world_deep_insert(w6, e1, ecs_av_comp_info_id_deep(c0), ecs_av_data_new(1));
    let w8 = ecs_av_world_deep_insert(w7, e1, ecs_av_comp_info_id_deep(c1), ecs_av_data_new(2));
    let w9 = ecs_av_world_deep_insert_resource(w8, ecs_av_time_new(0));
    let w10 = ecs_av_run_pair_mut_system(w9, ecs_av_comp_info_id_deep(c0), ecs_av_comp_info_id_deep(c1));
    if ecs_av_data_amount(ecs_av_world_deep_get(w10, e1, ecs_av_comp_info_id_deep(c0))) != 3 { panic(142992); };
    let w11 = ecs_av_run_resource_message_system(w10, ecs_av_event_default());
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w11)) != 1 { panic(142993); };
    let event = ecs_av_world_deep_read_message(w11, ecs_av_reader_new(), ecs_av_event_default());
    if ecs_av_event_amount(ecs_av_read_value(event)) != 4 { panic(142994); };
    let w12 = ecs_av_run_res_mut_system(w11);
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w12)) != 3 { panic(142995); };
    // cap-4 component cap invariant: even after rejects, the resource/message adapters keep working.
    let w13 = ecs_av_world_deep_increment_tick(w12);
    let w14 = ecs_av_run_res_mut_system(w13);
    if ecs_av_time_tick(ecs_av_world_deep_get_resource(w14)) != 5 { panic(142996); };
}
