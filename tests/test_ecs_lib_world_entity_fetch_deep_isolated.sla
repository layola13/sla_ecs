@import "lib/world_entity_fetch_deep.sla"

// Batch 277: world_entity_fetch deep (src/world/entity_fetch.rs).
// panic codes: 121400 – 121599.

@test "spawn_and_get_ref"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 1, 10);
    w = ecs_wef_world_deep_spawn(w, 2, 20);
    let f = ecs_wef_fetcher_deep_new(w);
    let r = ecs_wef_fetcher_deep_get(f, 1);
    if ecs_wef_ref_ok(r) != true { panic(121400); };
    if ecs_wef_ref_value(r) != 10 { panic(121401); };
    if ecs_wef_ref_is_deferred(r) != false { panic(121402); };
}

@test "get_not_spawned"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 0, 1);
    let f = ecs_wef_fetcher_deep_new(w);
    let r = ecs_wef_fetcher_deep_get(f, 3);
    if ecs_wef_ref_ok(r) != false { panic(121410); };
    if ecs_wef_ref_err(r) != 1 { panic(121411); };
}

@test "get_mut_deferred"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 2, 5);
    let f = ecs_wef_fetcher_deep_mut(w);
    let r = ecs_wef_fetcher_deep_get_mut(f, 2);
    if ecs_wef_ref_ok(r) != true { panic(121420); };
    if ecs_wef_ref_is_deferred(r) != true { panic(121421); };
    if ecs_wef_ref_is_structural(r) != false { panic(121422); };
}

@test "get_mut_structural"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 1, 9);
    let f = ecs_wef_fetcher_deep_mut(w);
    let r = ecs_wef_fetcher_deep_get_mut_structural(f, 1);
    if ecs_wef_ref_ok(r) != true { panic(121430); };
    if ecs_wef_ref_is_structural(r) != true { panic(121431); };
}

@test "many_ref_allows_dups"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 1, 11);
    let f = ecs_wef_fetcher_deep_new(w);
    let m = ecs_wef_fetcher_deep_get_many_ref(f, 1, 1, 0, 0, 2);
    if ecs_wef_multi_ok(m) != true { panic(121440); };
    if ecs_wef_multi_count(m) != 2 { panic(121441); };
    if ecs_wef_multi_value_at(m, 0) != 11 { panic(121442); };
}

@test "many_mut_rejects_alias"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 1, 1);
    w = ecs_wef_world_deep_spawn(w, 2, 2);
    let f = ecs_wef_fetcher_deep_mut(w);
    let m = ecs_wef_fetcher_deep_get_many_mut(f, 1, 1, 0, 0, 2);
    if ecs_wef_multi_ok(m) != false { panic(121450); };
    if ecs_wef_multi_err(m) != 2 { panic(121451); };
}

@test "many_mut_unique_ok"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 1, 10);
    w = ecs_wef_world_deep_spawn(w, 2, 20);
    let f = ecs_wef_fetcher_deep_mut(w);
    let m = ecs_wef_fetcher_deep_get_many_mut(f, 1, 2, 0, 0, 2);
    if ecs_wef_multi_ok(m) != true { panic(121460); };
    if ecs_wef_multi_value_at(m, 1) != 20 { panic(121461); };
}

@test "many_ref_missing_entity"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 0, 1);
    let f = ecs_wef_fetcher_deep_new(w);
    let m = ecs_wef_fetcher_deep_get_many_ref(f, 0, 3, 0, 0, 2);
    if ecs_wef_multi_ok(m) != false { panic(121470); };
    if ecs_wef_multi_err(m) != 1 { panic(121471); };
}

@test "apply_set_updates_world"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 4, 1);
    let f = ecs_wef_fetcher_deep_mut(w);
    let sr = ecs_wef_apply_set(f, 4, 99);
    if ecs_wef_set_ok(sr) != true { panic(121480); };
    w = ecs_wef_set_world(sr);
    if ecs_wef_world_deep_value(w, 4) != 99 { panic(121481); };
}

@test "despawn_then_get_fails"() {
    let w = ecs_wef_world_deep_new(0);
    w = ecs_wef_world_deep_spawn(w, 5, 5);
    w = ecs_wef_world_deep_despawn(w, 5);
    let f = ecs_wef_fetcher_deep_new(w);
    let r = ecs_wef_fetcher_deep_get(f, 5);
    if ecs_wef_ref_ok(r) != false { panic(121490); };
    if ecs_wef_world_deep_is_spawned(w, 5) != false { panic(121491); };
}
