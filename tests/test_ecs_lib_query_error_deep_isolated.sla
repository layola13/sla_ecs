@import "lib/query_error_deep.sla"

// Batch 201: Query error deep (src/query/error.rs).

@test "ns_invalid_and_valid_constructors"() {
    let inv = ecs_qe_ns_invalid(10, 3);
    if ecs_qe_ns_is_invalid(inv) != true { panic(106200); };
    if ecs_qe_ns_entity(inv) != 10 { panic(106201); };
    if ecs_qe_ns_current_generation(inv) != 3 { panic(106202); };
    let vb = ecs_qe_ns_valid_but_not_spawned(11, 99);
    if ecs_qe_ns_is_valid_but_not_spawned(vb) != true { panic(106203); };
    if ecs_qe_ns_location(vb) != 99 { panic(106204); };
    if ecs_qe_ns_entity_method(vb) != 11 { panic(106205); };
}

@test "ns_eq_and_display"() {
    let a = ecs_qe_ns_invalid(1, 2);
    let b = ecs_qe_ns_invalid(1, 2);
    let c = ecs_qe_ns_invalid(1, 3);
    if ecs_qe_ns_eq(a, b) != true { panic(106210); };
    if ecs_qe_ns_eq(a, c) != false { panic(106211); };
    if ecs_qe_ns_display_code(a) != 1000001 { panic(106212); };
    let v = ecs_qe_ns_valid_but_not_spawned(5, 0);
    if ecs_qe_ns_display_code(v) != 2000005 { panic(106213); };
}

@test "query_does_not_match_fields"() {
    let e = ecs_qe_query_does_not_match(42, 7);
    if ecs_qe_is_query_does_not_match(e) != true { panic(106220); };
    if ecs_qe_entity(e) != 42 { panic(106221); };
    if ecs_qe_archetype_id(e) != 7 { panic(106222); };
    if ecs_qe_flat_code(e) != ECS_QE_KIND_QUERY_DOES_NOT_MATCH { panic(106223); };
    if ecs_qe_display_code(e) != (ECS_QE_DISP_DOES_NOT_MATCH + 42 * 1000 + 7) { panic(106224); };
}

@test "not_spawned_from_nested"() {
    let ns = ecs_qe_ns_invalid(8, 4);
    let e = ecs_qe_from_not_spawned(ns);
    if ecs_qe_is_not_spawned(e) != true { panic(106230); };
    if ecs_qe_entity_any(e) != 8 { panic(106231); };
    let payload = ecs_qe_not_spawned_payload(e);
    if ecs_qe_ns_is_invalid(payload) != true { panic(106232); };
    if ecs_qe_ns_current_generation(payload) != 4 { panic(106233); };
    let e2 = ecs_qe_not_spawned_valid(9, 55);
    let p2 = ecs_qe_not_spawned_payload(e2);
    if ecs_qe_ns_is_valid_but_not_spawned(p2) != true { panic(106234); };
    if ecs_qe_ns_location(p2) != 55 { panic(106235); };
}

@test "aliased_mutability"() {
    let e = ecs_qe_aliased_mutability(3);
    if ecs_qe_is_aliased_mutability(e) != true { panic(106240); };
    if ecs_qe_entity(e) != 3 { panic(106241); };
    if ecs_qe_display_code(e) != (ECS_QE_DISP_ALIASED + 3) { panic(106242); };
    if ecs_qe_flat_code(e) != ECS_QE_KIND_ALIASED_MUTABILITY { panic(106243); };
}

@test "query_entity_error_eq"() {
    let a = ecs_qe_query_does_not_match(1, 2);
    let b = ecs_qe_query_does_not_match(1, 2);
    let c = ecs_qe_query_does_not_match(1, 3);
    if ecs_qe_eq(a, b) != true { panic(106250); };
    if ecs_qe_eq(a, c) != false { panic(106251); };
    let n1 = ecs_qe_not_spawned_invalid(5, 1);
    let n2 = ecs_qe_not_spawned_invalid(5, 1);
    if ecs_qe_eq(n1, n2) != true { panic(106252); };
    if ecs_qe_eq(a, n1) != false { panic(106253); };
}

@test "single_no_and_multiple"() {
    let n = ecs_qe_single_no_entities(77);
    if ecs_qe_single_is_no_entities(n) != true { panic(106260); };
    if ecs_qe_single_debug_name(n) != 77 { panic(106261); };
    if ecs_qe_single_display_code(n) != (ECS_QE_DISP_SINGLE_NONE + 77) { panic(106262); };
    let m = ecs_qe_single_multiple_entities(77);
    if ecs_qe_single_is_multiple(m) != true { panic(106263); };
    if ecs_qe_single_display_code(m) != (ECS_QE_DISP_SINGLE_MULTI + 77) { panic(106264); };
    if ecs_qe_single_eq(n, m) != false { panic(106265); };
    if ecs_qe_single_eq(n, ecs_qe_single_no_entities(77)) != true { panic(106266); };
}

@test "single_from_count"() {
    let r0 = ecs_qe_single_from_count(0, 10);
    if r0.0 != true { panic(106270); };
    if ecs_qe_single_is_no_entities(r0.1) != true { panic(106271); };
    let r1 = ecs_qe_single_from_count(1, 10);
    if r1.0 != false { panic(106272); };
    let r2 = ecs_qe_single_from_count(3, 10);
    if r2.0 != true { panic(106273); };
    if ecs_qe_single_is_multiple(r2.1) != true { panic(106274); };
    if ecs_qe_single_debug_name(r2.1) != 10 { panic(106275); };
}

@test "not_dense_error"() {
    let e = ecs_qe_not_dense(123);
    if ecs_qe_not_dense_name(e) != 123 { panic(106280); };
    if ecs_qe_not_dense_display_code(e) != (ECS_QE_DISP_NOT_DENSE + 123) { panic(106281); };
    if ecs_qe_not_dense_eq(e, ecs_qe_not_dense(123)) != true { panic(106282); };
    if ecs_qe_not_dense_eq(e, ecs_qe_not_dense(1)) != false { panic(106283); };
    let ok = ecs_qe_not_dense_from_is_dense(true, 5);
    if ok.0 != false { panic(106284); };
    let err = ecs_qe_not_dense_from_is_dense(false, 5);
    if err.0 != true { panic(106285); };
    if ecs_qe_not_dense_name(err.1) != 5 { panic(106286); };
}

@test "detect_aliased_mutability_none"() {
    let l = ecs_qe_entity_list8_empty();
    l = ecs_qe_entity_list8_push(l, 1);
    l = ecs_qe_entity_list8_push(l, 2);
    l = ecs_qe_entity_list8_push(l, 3);
    let r = ecs_qe_detect_aliased_mutability(l);
    if r.0 != false { panic(106290); };
}

@test "detect_aliased_mutability_duplicate"() {
    let l = ecs_qe_entity_list8_empty();
    l = ecs_qe_entity_list8_push(l, 10);
    l = ecs_qe_entity_list8_push(l, 20);
    l = ecs_qe_entity_list8_push(l, 10);
    let r = ecs_qe_detect_aliased_mutability(l);
    if r.0 != true { panic(106300); };
    if ecs_qe_is_aliased_mutability(r.1) != true { panic(106301); };
    if ecs_qe_entity(r.1) != 10 { panic(106302); };
}

@test "classify_get_not_spawned"() {
    let r = ecs_qe_classify_get(5, false, false, 0, ECS_QE_NS_INVALID, 2, 0);
    if r.0 != true { panic(106310); };
    if ecs_qe_is_not_spawned(r.1) != true { panic(106311); };
    if ecs_qe_entity(r.1) != 5 { panic(106312); };
    let payload = ecs_qe_not_spawned_payload(r.1);
    if ecs_qe_ns_current_generation(payload) != 2 { panic(106313); };
}

@test "classify_get_valid_but_not_spawned"() {
    let r = ecs_qe_classify_get(6, false, true, 1, ECS_QE_NS_VALID_BUT_NOT_SPAWNED, 0, 88);
    if r.0 != true { panic(106320); };
    if ecs_qe_is_not_spawned(r.1) != true { panic(106321); };
    let p = ecs_qe_not_spawned_payload(r.1);
    if ecs_qe_ns_is_valid_but_not_spawned(p) != true { panic(106322); };
    if ecs_qe_ns_location(p) != 88 { panic(106323); };
}

@test "classify_get_does_not_match"() {
    let r = ecs_qe_classify_get(7, true, false, 15, 0, 0, 0);
    if r.0 != true { panic(106330); };
    if ecs_qe_is_query_does_not_match(r.1) != true { panic(106331); };
    if ecs_qe_archetype_id(r.1) != 15 { panic(106332); };
    if ecs_qe_entity(r.1) != 7 { panic(106333); };
}

@test "classify_get_ok"() {
    let r = ecs_qe_classify_get(8, true, true, 3, 0, 0, 0);
    if r.0 != false { panic(106340); };
}

@test "not_spawned_display_nested"() {
    let e = ecs_qe_not_spawned_invalid(4, 1);
    // nested display for invalid entity 4 is 1000004
    if ecs_qe_display_code(e) != (ECS_QE_DISP_NOT_SPAWNED + 1000004) { panic(106350); };
    let e2 = ecs_qe_not_spawned_valid(4, 0);
    if ecs_qe_display_code(e2) != (ECS_QE_DISP_NOT_SPAWNED + 2000004) { panic(106351); };
}

@test "bevy_variant_order_codes"() {
    // Bevy enum order: QueryDoesNotMatch=0, NotSpawned=1, AliasedMutability=2
    if ECS_QE_KIND_QUERY_DOES_NOT_MATCH != 0 { panic(106360); };
    if ECS_QE_KIND_NOT_SPAWNED != 1 { panic(106361); };
    if ECS_QE_KIND_ALIASED_MUTABILITY != 2 { panic(106362); };
    if ECS_QE_SINGLE_NO_ENTITIES != 0 { panic(106363); };
    if ECS_QE_SINGLE_MULTIPLE_ENTITIES != 1 { panic(106364); };
}

@test "legacy_names_not_used"() {
    // Ensure deep API exposes Bevy names, not shallow ALIEN/ENTITY_NOT_FOUND kinds.
    let e = ecs_qe_aliased_mutability(1);
    if ecs_qe_kind(e) == 0 { panic(106370); };
    if ecs_qe_is_not_spawned(e) != false { panic(106371); };
    if ecs_qe_is_query_does_not_match(e) != false { panic(106372); };
}
