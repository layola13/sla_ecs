    if ecs_executor_ready_batch_at(taken.batch, 1) != 1 { panic(83306); };
    if ecs_executor_state_num_running(taken.plan.executor.state) != 2 { panic(83307); };
    let p4 = ecs_executor_run_plan_complete_running_system(taken.plan, 1);
    if ecs_executor_state_is_completed(p4.executor.state, 1) != true { panic(83308); };
    if ecs_executor_state_is_running(p4.executor.state, 0) != true { panic(83309); };
    if ecs_executor_state_is_running(p4.executor.state, 1) { panic(83310); };
