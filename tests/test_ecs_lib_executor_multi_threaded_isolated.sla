    conflicts.push(0);
    let spec2_base = ecs_executor_system_spec_new(2, false, false, false, true);
    let spec2 = ecs_executor_system_spec_with_access_conflicts(spec2_base, conflicts);
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, spec2, 1, dep2);
