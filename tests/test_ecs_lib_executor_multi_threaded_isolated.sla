@test "executor_state_can_spawn_system_respects_active_running_flags"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let base = e1.state;
    let normal_running = ecs_executor_state_start_system(base, 0, false, false);
    let exclusive_spec = ecs_executor_system_spec_new(1, true, false, false, true);
    let normal_spec = ecs_executor_system_spec_new(1, false, false, false, true);
    if ecs_executor_state_can_spawn_system(normal_running, exclusive_spec) { panic(83018); };
    if ecs_executor_state_can_spawn_system(normal_running, normal_spec) != true { panic(83019); };

    let local_base = ecs_executor_state_init(ecs_executor_state_new(), 3, 0);
    let local_running = ecs_executor_state_start_system(local_base, 0, false, true);
    let local_spec = ecs_executor_system_spec_new(1, false, true, false, true);
    if ecs_executor_state_can_spawn_system(local_running, local_spec) { panic(83020); };
    if ecs_executor_state_can_spawn_system(local_running, normal_spec) != true { panic(83021); };

    let exclusive_base = ecs_executor_state_init(ecs_executor_state_new(), 3, 0);
    let exclusive_running = ecs_executor_state_start_system(exclusive_base, 0, true, true);
    if ecs_executor_state_can_spawn_system(exclusive_running, normal_spec) { panic(83022); };
}

@test "executor_state_can_spawn_system_respects_running_conflicts"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 1);
    let base = e1.state;
    let running = ecs_executor_state_start_system(base, 0, false, false);

    let condition_conflicts = Vec::new();
    condition_conflicts.push(0);
    let condition_base = ecs_executor_system_spec_new(1, false, false, false, true);
    let condition_spec = ecs_executor_system_spec_with_condition_conflicts(condition_base, condition_conflicts);
    if ecs_executor_state_can_spawn_system(running, condition_spec) { panic(83091); };

    let access_conflicts = Vec::new();
    access_conflicts.push(0);
    let access_base = ecs_executor_system_spec_new(1, false, false, false, true);
    let access_spec = ecs_executor_system_spec_with_access_conflicts(access_base, access_conflicts);
    if ecs_executor_state_can_spawn_system(running, access_spec) { panic(83092); };
    let skipped_running = ecs_executor_state_mark_skipped_pending(running, 1);
    if ecs_executor_state_can_spawn_system(skipped_running, access_spec) != true { panic(83093); };

    let set_conflicts = Vec::new();
    set_conflicts.push(0);
    let set_base = ecs_executor_system_spec_new(1, false, false, false, true);
    let set_spec = ecs_executor_system_spec_add_set_condition_conflicts(set_base, 0, set_conflicts);
    if ecs_executor_state_can_spawn_system(running, set_spec) { panic(83094); };
    let evaluated_running = ecs_executor_state_mark_set_evaluated(running, 0);
    if ecs_executor_state_can_spawn_system(evaluated_running, set_spec) != true { panic(83095); };
}

