@test "executor_run_plan_apply_deferred_completed_tick_executor_applies_prior_and_spawns"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    dep1.push(2);
    let dep2 = Vec::new();
    let barrier_base = ecs_executor_system_spec_new(1, false, false, false, true);
    let barrier_spec = ecs_executor_system_spec_as_apply_deferred(barrier_base);
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, barrier_spec, 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 1, dep2);
    let first = ecs_executor_run_plan_take_ready_batch(p3, 1);
    if ecs_executor_ready_batch_count(first.batch) != 1 { panic(83441); };
    if ecs_executor_ready_batch_at(first.batch, 0) != 0 { panic(83442); };
    let p4 = ecs_executor_run_plan_complete_ready_batch(first.plan, first.batch);
    if ecs_executor_state_is_unapplied(p4.executor.state, 0) != true { panic(83443); };

    let barrier = ecs_executor_run_plan_take_ready_batch(p4, 1);
    if ecs_executor_ready_batch_count(barrier.batch) != 1 { panic(83444); };
    if ecs_executor_ready_batch_at(barrier.batch, 0) != 1 { panic(83445); };
    if ecs_executor_ready_batch_is_exclusive(barrier.batch) != true { panic(83446); };
    if ecs_executor_ready_batch_is_local(barrier.batch) != true { panic(83447); };
    let later: Vec<Vec<i64>> = Vec::new();
    let looped = ecs_executor_run_plan_system_completed_tick_executor(barrier.plan, 1, later, 1);
    if ecs_executor_run_plan_apply_count(looped.plan) != 1 { panic(83448); };
