@test "executor_ready_group_rescans_after_skip_for_lower_index_dependent"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 2, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    dep1.push(0);
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 1, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, false), 0, dep1);
    let taken = ecs_executor_run_plan_take_ready_batch(p2, 2);
    if ecs_executor_ready_batch_skipped_count(taken.batch) != 1 { panic(83121); };
    if ecs_executor_ready_batch_skipped_at(taken.batch, 0) != 1 { panic(83122); };
    if ecs_executor_state_get_dependencies(taken.plan.executor.state, 0) != 0 { panic(83123); };
    if ecs_executor_ready_batch_count(taken.batch) != 1 { panic(83124); };
    if ecs_executor_ready_batch_at(taken.batch, 0) != 0 { panic(83125); };
}

@test "executor_ready_group_selected_system_blocks_later_conflict"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 2, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    let conflicts = Vec::new();
    conflicts.push(0);
    let spec1_base = ecs_executor_system_spec_new(1, false, false, false, true);
    let spec1 = ecs_executor_system_spec_with_access_conflicts(spec1_base, conflicts);
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, spec1, 0, dep1);
    let first = ecs_executor_run_plan_take_ready_batch(p2, 2);
    if ecs_executor_ready_batch_count(first.batch) != 1 { panic(83126); };
    if ecs_executor_ready_batch_at(first.batch, 0) != 0 { panic(83127); };
    if ecs_executor_state_is_running(first.plan.executor.state, 0) != true { panic(83128); };
    if ecs_executor_state_num_running(first.plan.executor.state) != 1 { panic(83129); };
    if ecs_executor_state_is_ready(first.plan.executor.state, 1) != true { panic(83130); };
    let p3 = ecs_executor_run_plan_complete_ready_batch(first.plan, first.batch);
    let second = ecs_executor_run_plan_take_ready_batch(p3, 2);
    if ecs_executor_ready_batch_count(second.batch) != 1 { panic(83131); };
    if ecs_executor_ready_batch_at(second.batch, 0) != 1 { panic(83132); };
    if ecs_executor_run_plan_run_count(second.plan) != 2 { panic(83133); };
}

@test "executor_ready_group_allows_one_local_with_send_systems"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    let dep2 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, true, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, true, false, true), 0, dep2);
    let taken = ecs_executor_run_plan_take_ready_batch(p3, 3);
    if ecs_executor_ready_batch_count(taken.batch) != 2 { panic(83134); };
    if ecs_executor_ready_batch_at(taken.batch, 0) != 0 { panic(83135); };
    if ecs_executor_ready_batch_at(taken.batch, 1) != 1 { panic(83136); };
    if ecs_executor_ready_batch_is_exclusive(taken.batch) { panic(83137); };
    if ecs_executor_ready_batch_is_local(taken.batch) != true { panic(83138); };
    if ecs_executor_state_local_thread_running(taken.plan.executor.state) != true { panic(83139); };
    if ecs_executor_state_num_running(taken.plan.executor.state) != 2 { panic(83140); };
    if ecs_executor_state_is_ready(taken.plan.executor.state, 2) != true { panic(83141); };
}

@test "executor_ready_group_rescan_respects_selected_running_conflict"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 3, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    let dep1 = Vec::new();
    dep1.push(2);
    let dep2 = Vec::new();
    let conflicts = Vec::new();
    conflicts.push(0);
    let spec2_base = ecs_executor_system_spec_new(2, false, false, false, true);
    let spec2 = ecs_executor_system_spec_with_access_conflicts(spec2_base, conflicts);
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, false), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, spec2, 1, dep2);
    let taken = ecs_executor_run_plan_take_ready_batch(p3, 3);
    if ecs_executor_ready_batch_count(taken.batch) != 1 { panic(83142); };
    if ecs_executor_ready_batch_at(taken.batch, 0) != 0 { panic(83143); };
    if ecs_executor_ready_batch_skipped_count(taken.batch) != 1 { panic(83144); };
    if ecs_executor_ready_batch_skipped_at(taken.batch, 0) != 1 { panic(83145); };
    if ecs_executor_state_get_dependencies(taken.plan.executor.state, 2) != 0 { panic(83146); };
    if ecs_executor_state_is_ready(taken.plan.executor.state, 2) != true { panic(83147); };
    if ecs_executor_state_is_running(taken.plan.executor.state, 0) != true { panic(83148); };
    if ecs_executor_state_num_running(taken.plan.executor.state) != 1 { panic(83149); };
}

@test "executor_ready_group_drive_width"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 5, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    dep0.push(2);
    let dep1 = Vec::new();
    dep1.push(3);
    let dep2 = Vec::new();
    dep2.push(4);
    let dep3 = Vec::new();
    let dep4 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 1, dep2);
    let p4 = ecs_executor_run_plan_add_system(p3, ecs_executor_system_spec_new(3, false, false, false, true), 1, dep3);
    let p5 = ecs_executor_run_plan_add_system(p4, ecs_executor_system_spec_new(4, false, false, true, true), 1, dep4);
    let p6 = ecs_executor_run_plan_drive_all_batched(p5, 2);
    if ecs_executor_state_completed_count(p6.executor.state) != 5 { panic(82969); };
    if ecs_executor_run_plan_run_count(p6) != 5 { panic(82970); };
    if ecs_executor_run_plan_run_at(p6, 0) != 0 { panic(82971); };
    if ecs_executor_run_plan_run_at(p6, 1) != 1 { panic(82972); };
    if ecs_executor_run_plan_run_at(p6, 2) != 2 { panic(82973); };
    if ecs_executor_run_plan_run_at(p6, 3) != 3 { panic(82974); };
    if ecs_executor_run_plan_run_at(p6, 4) != 4 { panic(82975); };
    if ecs_executor_run_plan_apply_count(p6) != 0 { panic(82976); };
    if ecs_executor_state_unapplied_count(p6.executor.state) != 5 { panic(82977); };
    if ecs_executor_state_is_unapplied(p6.executor.state, 0) != true { panic(83206); };
    if ecs_executor_state_is_unapplied(p6.executor.state, 1) != true { panic(83207); };
    if ecs_executor_state_is_unapplied(p6.executor.state, 2) != true { panic(83208); };
    if ecs_executor_state_is_unapplied(p6.executor.state, 3) != true { panic(83209); };
    if ecs_executor_state_is_unapplied(p6.executor.state, 4) != true { panic(83190); };
    let finished = ecs_multi_threaded_executor_finish_run(p6.executor);
    if ecs_executor_state_unapplied_count(finished.state) != 0 { panic(83191); };
    if finished.deferred_applied != 5 { panic(83192); };
}
