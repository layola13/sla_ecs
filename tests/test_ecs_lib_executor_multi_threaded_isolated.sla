}

@test "executor_ready_group_drive_width"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 5, 0);
    let p0 = ecs_executor_run_plan_new(e1);
    let dep0 = Vec::new();
    dep0.push(2);
    let dep1 = Vec::new();
    dep1.push(3);
    let dep2 = Vec::new();
    dep2.push(4);
    let dep3 = Vec::new();
    let dep4 = Vec::new();
    let p1 = ecs_executor_run_plan_add_system(p0, ecs_executor_system_spec_new(0, false, false, false, true), 0, dep0);
    let p2 = ecs_executor_run_plan_add_system(p1, ecs_executor_system_spec_new(1, false, false, false, true), 0, dep1);
    let p3 = ecs_executor_run_plan_add_system(p2, ecs_executor_system_spec_new(2, false, false, false, true), 1, dep2);
    let p4 = ecs_executor_run_plan_add_system(p3, ecs_executor_system_spec_new(3, false, false, false, true), 1, dep3);
    let p5 = ecs_executor_run_plan_add_system(p4, ecs_executor_system_spec_new(4, false, false, true, true), 1, dep4);
    let p6 = ecs_executor_run_plan_drive_all_batched(p5, 2);
    if ecs_executor_state_completed_count(p6.executor.state) != 5 { panic(82969); };
    if ecs_executor_run_plan_run_count(p6) != 5 { panic(82970); };
    if ecs_executor_run_plan_run_at(p6, 0) != 0 { panic(82971); };
    if ecs_executor_run_plan_run_at(p6, 1) != 1 { panic(82972); };
    if ecs_executor_run_plan_run_at(p6, 2) != 2 { panic(82973); };
    if ecs_executor_run_plan_run_at(p6, 3) != 3 { panic(82974); };
    if ecs_executor_run_plan_run_at(p6, 4) != 4 { panic(82975); };
    if ecs_executor_run_plan_apply_count(p6) != 1 { panic(82976); };
    if ecs_executor_run_plan_apply_at(p6, 0) != 4 { panic(82977); };
}
