    if ecs_executor_state_is_unapplied(p4.executor.state, 1) != true { panic(83314); };
    let blocked = ecs_executor_run_plan_take_ready_batch(p4, 1);
    if ecs_executor_ready_batch_count(blocked.batch) != 0 { panic(83315); };
    if ecs_executor_state_is_ready(blocked.plan.executor.state, 2) != true { panic(83316); };
    let p5 = ecs_executor_run_plan_complete_running_system(blocked.plan, 0);
    let next = ecs_executor_run_plan_take_ready_batch(p5, 1);
    if ecs_executor_ready_batch_count(next.batch) != 1 { panic(83317); };
    if ecs_executor_ready_batch_at(next.batch, 0) != 2 { panic(83318); };
    let p6 = ecs_executor_run_plan_complete_ready_batch(next.plan, next.batch);
    if ecs_executor_state_completed_count(p6.executor.state) != 3 { panic(83319); };
}

