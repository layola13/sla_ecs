    if ecs_executor_ready_batch_at(taken.batch, 0) != 1 { panic(83026); };
    if ecs_executor_state_is_ready(taken.plan.executor.state, 0) != true { panic(83027); };
}

@test "executor_ready_group_releases_dependents"() {
    let e0 = ecs_multi_threaded_executor_new();
    let e1 = ecs_multi_threaded_executor_init(e0, 2, 0);
