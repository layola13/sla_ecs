@import "lib/schedule_node_deep.sla"

// Batch 179 tests for deepened schedule::node compact packing + conflict detection + SystemSets uninit.

@test "node_id_deep_system_and_set"() {
    let s = ecs_node_id_deep_system(7);
    if ecs_node_id_deep_is_system(s) != true { panic(100100); };
    if ecs_node_id_deep_is_set(s) != false { panic(100101); };
    if ecs_node_id_deep_key(s) != 7 { panic(100102); };
    let t = ecs_node_id_deep_set(9);
    if ecs_node_id_deep_is_set(t) != true { panic(100103); };
    if ecs_node_id_deep_eq(s, t) != false { panic(100104); };
    if ecs_node_id_deep_eq(s, ecs_node_id_deep_system(7)) != true { panic(100105); };
}

@test "compact_node_dir_roundtrip_system_outgoing"() {
    let id = ecs_node_id_deep_system(3);
    let r = ecs_compact_node_dir_roundtrip(id, ECS_DIR_OUTGOING);
    if r.0 != true { panic(100110); };
    if ecs_node_id_deep_is_system(r.1) != true { panic(100111); };
    if ecs_node_id_deep_key(r.1) != 3 { panic(100112); };
    if r.2 != ECS_DIR_OUTGOING { panic(100113); };
}

@test "compact_node_dir_roundtrip_set_incoming"() {
    let id = ecs_node_id_deep_set(11);
    let r = ecs_compact_node_dir_roundtrip(id, ECS_DIR_INCOMING);
    if r.0 != true { panic(100120); };
    if ecs_node_id_deep_is_set(r.1) != true { panic(100121); };
    if ecs_node_id_deep_key(r.1) != 11 { panic(100122); };
    if r.2 != ECS_DIR_INCOMING { panic(100123); };
}

@test "compact_node_pair_roundtrip_mixed"() {
    let a = ecs_node_id_deep_system(1);
    let b = ecs_node_id_deep_set(2);
    let r = ecs_compact_node_pair_roundtrip(a, b);
    if r.0 != true { panic(100130); };
    if ecs_node_id_deep_is_system(r.1) != true { panic(100131); };
    if ecs_node_id_deep_is_set(r.2) != true { panic(100132); };
    if ecs_node_id_deep_key(r.1) != 1 { panic(100133); };
    if ecs_node_id_deep_key(r.2) != 2 { panic(100134); };
}

@test "compact_node_pair_eq"() {
    let a = ecs_node_id_deep_system(5);
    let b = ecs_node_id_deep_system(6);
    let p1 = ecs_compact_node_pair_from(a, b);
    let p2 = ecs_compact_node_pair_from(a, b);
    let p3 = ecs_compact_node_pair_from(b, a);
    if ecs_compact_node_pair_eq(p1, p2) != true { panic(100140); };
    if ecs_compact_node_pair_eq(p1, p3) != false { panic(100141); };
}

@test "system_node_option_get_and_clear"() {
    let n = ecs_system_node_deep_new(42, true);
    let g = ecs_system_node_deep_get(n);
    if g.0 != true { panic(100150); };
    if g.1 != 42 { panic(100151); };
    if g.2 != true { panic(100152); };
    if ecs_system_node_deep_access_initialized(n) != false { panic(100153); };
    let n2 = ecs_system_node_deep_set_access_initialized(n);
    if ecs_system_node_deep_access_initialized(n2) != true { panic(100154); };
    let n3 = ecs_system_node_deep_clear(n2);
    let g2 = ecs_system_node_deep_get(n3);
    if g2.0 != false { panic(100155); };
    if ecs_system_node_deep_access_initialized(n3) != false { panic(100156); };
}

@test "access_compatible_read_read"() {
    let a = ecs_access_deep_add_read(ecs_access_deep_new(), 1);
    let b = ecs_access_deep_add_read(ecs_access_deep_new(), 1);
    if ecs_access_deep_is_compatible(a, b) != true { panic(100160); };
}

@test "access_incompatible_write_read"() {
    let a = ecs_access_deep_add_write(ecs_access_deep_new(), 1);
    let b = ecs_access_deep_add_read(ecs_access_deep_new(), 1);
    if ecs_access_deep_is_compatible(a, b) != false { panic(100170); };
    let conf = ecs_access_deep_get_conflicts(a, b);
    if conf.0 != true { panic(100171); };
    if len(conf.1) != 1 { panic(100172); };
    if conf.1[0] != 1 { panic(100173); };
}

@test "access_exclusive_not_compatible"() {
    let a = ecs_access_deep_exclusive();
    let b = ecs_access_deep_new();
    if ecs_access_deep_is_compatible(a, b) != false { panic(100180); };
}

@test "access_writes_all_is_all_conflict"() {
    let a = ecs_access_deep_set_writes_all(ecs_access_deep_new());
    let b = ecs_access_deep_add_read(ecs_access_deep_new(), 9);
    if ecs_access_deep_is_compatible(a, b) != false { panic(100190); };
    let conf = ecs_access_deep_get_conflicts(a, b);
    if conf.0 != false { panic(100191); };
    if len(conf.1) != 0 { panic(100192); };
}

@test "get_conflicting_systems_exclusive_pair"() {
    let keys: Vec<i64> = Vec::new();
    keys.push(1);
    keys.push(2);
    let excl: Vec<bool> = Vec::new();
    excl.push(true);
    excl.push(false);
    let reads: Vec<Vec<i64>> = Vec::new();
    reads.push(Vec::new());
    reads.push(Vec::new());
    let writes: Vec<Vec<i64>> = Vec::new();
    writes.push(Vec::new());
    writes.push(Vec::new());
    let ra: Vec<bool> = Vec::new();
    ra.push(false);
    ra.push(false);
    let wa: Vec<bool> = Vec::new();
    wa.push(false);
    wa.push(false);
    let disc: Vec<i64> = Vec::new();
    disc.push(1);
    disc.push(2);
    let amb: Vec<i64> = Vec::new();
    let awa: Vec<i64> = Vec::new();
    let ign: Vec<i64> = Vec::new();
    let c = ecs_systems_get_conflicting_systems(keys, excl, reads, writes, ra, wa, disc, amb, awa, ign);
    if ecs_conflicting_systems_deep_len(c) != 1 { panic(100200); };
    let it = ecs_conflicting_systems_deep_get(c, 0);
    if ecs_conflict_item_a(it) != 1 { panic(100201); };
    if ecs_conflict_item_b(it) != 2 { panic(100202); };
    if ecs_conflict_item_component_count(it) != 0 { panic(100203); };
}

@test "get_conflicting_systems_individual_components"() {
    let keys: Vec<i64> = Vec::new();
    keys.push(10);
    keys.push(20);
    let excl: Vec<bool> = Vec::new();
    excl.push(false);
    excl.push(false);
    let r0: Vec<i64> = Vec::new();
    let w0: Vec<i64> = Vec::new();
    w0.push(5);
    let r1: Vec<i64> = Vec::new();
    r1.push(5);
    let w1: Vec<i64> = Vec::new();
    let reads: Vec<Vec<i64>> = Vec::new();
    reads.push(r0);
    reads.push(r1);
    let writes: Vec<Vec<i64>> = Vec::new();
    writes.push(w0);
    writes.push(w1);
    let ra: Vec<bool> = Vec::new();
    ra.push(false);
    ra.push(false);
    let wa: Vec<bool> = Vec::new();
    wa.push(false);
    wa.push(false);
    let disc: Vec<i64> = Vec::new();
    disc.push(10);
    disc.push(20);
    let amb: Vec<i64> = Vec::new();
    let awa: Vec<i64> = Vec::new();
    let ign: Vec<i64> = Vec::new();
    let c = ecs_systems_get_conflicting_systems(keys, excl, reads, writes, ra, wa, disc, amb, awa, ign);
    if ecs_conflicting_systems_deep_len(c) != 1 { panic(100210); };
    let it = ecs_conflicting_systems_deep_get(c, 0);
    if ecs_conflict_item_component_count(it) != 1 { panic(100211); };
    if ecs_conflict_item_component_at(it, 0) != 5 { panic(100212); };
}

