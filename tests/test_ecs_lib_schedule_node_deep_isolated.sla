@test "conflicting_systems_check_if_not_empty"() {
    let empty = ecs_conflicting_systems_deep_new();
    let r = ecs_conflicting_systems_deep_check_if_not_empty(empty);
    if r.0 != true { panic(100250); };
    if r.1 != 0 { panic(100251); };
    // non-empty via exclusive conflict
    let keys: Vec<i64> = Vec::new();
    keys.push(1);
    keys.push(2);
    let excl: Vec<bool> = Vec::new();
    excl.push(true);
    excl.push(true);
    let reads: Vec<Vec<i64>> = Vec::new();
    reads.push(Vec::new());
    reads.push(Vec::new());
    let writes: Vec<Vec<i64>> = Vec::new();
    writes.push(Vec::new());
    writes.push(Vec::new());
    let ra: Vec<bool> = Vec::new();
    ra.push(false);
    ra.push(false);
    let wa: Vec<bool> = Vec::new();
    wa.push(false);
    wa.push(false);
    let disc: Vec<i64> = Vec::new();
    disc.push(1);
    disc.push(2);
    let c = ecs_systems_get_conflicting_systems(keys, excl, reads, writes, ra, wa, disc, Vec::new(), Vec::new(), Vec::new());
    let r2 = ecs_conflicting_systems_deep_check_if_not_empty(c);
    if r2.0 != false { panic(100252); };
    if r2.1 != 1 { panic(100253); };
}

@test "system_sets_deep_get_key_or_insert_and_contains"() {
    let s = ecs_system_sets_deep_new();
    if ecs_system_sets_deep_is_empty(s) != true { panic(100260); };
    let r = ecs_system_sets_deep_get_key_or_insert(s, 50);
    s = r.0;
    if r.1 != 0 { panic(100261); };
    if ecs_system_sets_deep_contains(s, 50) != true { panic(100262); };
    let r2 = ecs_system_sets_deep_get_key_or_insert(s, 50);
    if r2.1 != 0 { panic(100263); };
    if ecs_system_sets_deep_len(r2.0) != 1 { panic(100264); };
}

@test "system_sets_deep_insert_tracks_uninit_range"() {
    let s = ecs_system_sets_deep_new();
    let conds: Vec<i64> = Vec::new();
    conds.push(100);
    conds.push(101);
    let r = ecs_system_sets_deep_insert(s, 7, conds);
    s = r.0;
    let key = r.1;
    if ecs_system_sets_deep_condition_count(s, key) != 2 { panic(100270); };
    if ecs_system_sets_deep_has_conditions(s, key) != true { panic(100271); };
    if ecs_system_sets_deep_is_initialized(s) != false { panic(100272); };
    if ecs_system_sets_deep_uninit_count(s) != 1 { panic(100273); };
    let u = ecs_system_sets_deep_uninit_at(s, 0);
    if ecs_uninit_set_key(u) != key { panic(100274); };
    if ecs_uninit_set_start(u) != 0 { panic(100275); };
    if ecs_uninit_set_end(u) != 2 { panic(100276); };
    if ecs_uninit_set_len(u) != 2 { panic(100277); };
}

@test "system_sets_deep_insert_appends_second_uninit_range"() {
    // Bevy: configure_sets can append conditions multiple times; each append gets its own uninit range.
    let s = ecs_system_sets_deep_new();
    let c1: Vec<i64> = Vec::new();
    c1.push(1);
    let r1 = ecs_system_sets_deep_insert(s, 9, c1);
    s = r1.0;
    let c2: Vec<i64> = Vec::new();
    c2.push(2);
    c2.push(3);
    let r2 = ecs_system_sets_deep_insert(s, 9, c2);
    s = r2.0;
    if ecs_system_sets_deep_condition_count(s, r2.1) != 3 { panic(100280); };
    if ecs_system_sets_deep_uninit_count(s) != 2 { panic(100281); };
    let u0 = ecs_system_sets_deep_uninit_at(s, 0);
    let u1 = ecs_system_sets_deep_uninit_at(s, 1);
    if ecs_uninit_set_start(u0) != 0 { panic(100282); };
    if ecs_uninit_set_end(u0) != 1 { panic(100283); };
    if ecs_uninit_set_start(u1) != 1 { panic(100284); };
    if ecs_uninit_set_end(u1) != 3 { panic(100285); };
    let all = ecs_system_sets_deep_conditions_for(s, r2.1);
    if len(all) != 3 { panic(100286); };
    if all[0] != 1 { panic(100287); };
    if all[2] != 3 { panic(100288); };
}

@test "system_sets_deep_initialize_clears_uninit"() {
    let s = ecs_system_sets_deep_new();
    let conds: Vec<i64> = Vec::new();
    conds.push(1);
    let r = ecs_system_sets_deep_insert(s, 3, conds);
    s = r.0;
    s = ecs_system_sets_deep_initialize(s);
    if ecs_system_sets_deep_is_initialized(s) != true { panic(100290); };
    if ecs_system_sets_deep_uninit_count(s) != 0 { panic(100291); };
    // conditions remain
    if ecs_system_sets_deep_condition_count(s, r.1) != 1 { panic(100292); };
}

@test "system_sets_deep_check_type_set_ambiguity"() {
    let s = ecs_system_sets_deep_new();
    let r = ecs_system_sets_deep_get_key_or_insert(s, 1);
    s = r.0;
    s = ecs_system_sets_deep_set_system_type(s, r.1, true);
    let keys: Vec<i64> = Vec::new();
    keys.push(r.1);
    let inst: Vec<i64> = Vec::new();
    inst.push(2);
    let rel: Vec<i64> = Vec::new();
    rel.push(1);
    let chk = ecs_system_sets_deep_check_type_set_ambiguity(s, keys, inst, rel);
    if chk.0 != false { panic(100300); };
    if chk.1 != r.1 { panic(100301); };
    // single instance ok
    let inst2: Vec<i64> = Vec::new();
    inst2.push(1);
    let chk2 = ecs_system_sets_deep_check_type_set_ambiguity(s, keys, inst2, rel);
    if chk2.0 != true { panic(100302); };
    // multi instance but no relations ok
    let rel0: Vec<i64> = Vec::new();
    rel0.push(0);
    let chk3 = ecs_system_sets_deep_check_type_set_ambiguity(s, keys, inst, rel0);
    if chk3.0 != true { panic(100303); };
}

@test "systems_deep_insert_get_remove_initialize"() {
    let s = ecs_systems_deep_new();
    if ecs_systems_deep_is_empty(s) != true { panic(100310); };
    let conds: Vec<i64> = Vec::new();
    conds.push(10);
    let r = ecs_systems_deep_insert(s, 100, false, conds);
    s = r.0;
    let key = r.1;
    if ecs_systems_deep_len(s) != 1 { panic(100311); };
    if ecs_systems_deep_is_initialized(s) != false { panic(100312); };
    if ecs_systems_deep_has_conditions(s, key) != true { panic(100313); };
    if ecs_systems_deep_condition_count(s, key) != 1 { panic(100314); };
    let g = ecs_systems_deep_get(s, key);
    if g.0 != true { panic(100315); };
    if g.1 != 100 { panic(100316); };
    if ecs_systems_deep_access_initialized(s, key) != false { panic(100317); };
    s = ecs_systems_deep_initialize(s);
    if ecs_systems_deep_is_initialized(s) != true { panic(100318); };
    if ecs_systems_deep_access_initialized(s, key) != true { panic(100319); };
    let rem = ecs_systems_deep_remove(s, key);
    s = rem.0;
    if rem.1 != true { panic(100320); };
    if ecs_systems_deep_len(s) != 0 { panic(100321); };
    let g2 = ecs_systems_deep_get(s, key);
    if g2.0 != false { panic(100322); };
}

@test "systems_deep_remove_from_uninit_before_init"() {
    let s = ecs_systems_deep_new();
    let r = ecs_systems_deep_insert(s, 1, true, Vec::new());
    s = r.0;
    if ecs_systems_deep_uninit_count(s) != 1 { panic(100330); };
    let rem = ecs_systems_deep_remove(s, r.1);
    s = rem.0;
    if ecs_systems_deep_uninit_count(s) != 0 { panic(100331); };
    if ecs_systems_deep_is_initialized(s) != true { panic(100332); };
}
