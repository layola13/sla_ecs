@import "lib/entity_hash_set_derived_extras.sla"

// Isolated tests for lib/entity_hash_set_derived_extras.sla.
// Bevy reference: bevy_ecs/src/entity/hash_set.rs derived wrappers and iterator traits.

fn make_ehs4_values() -> Vec<i64> {
    let values: Vec<i64> = Vec::new();
    values.push(1);
    values.push(2);
    values.push(1);
    values.push(3);
    return values;
}

fn make_ehs4_set() -> EcsEhs4Set {
    return ecs_ehs4_from_iter(make_ehs4_values());
}

fn make_ehs4_other() -> EcsEhs4Set {
    let values: Vec<i64> = Vec::new();
    values.push(3);
    values.push(4);
    return ecs_ehs4_from_iter(values);
}

@test "entity hash set derived extras new default capacity markers"() {
    let fresh = ecs_ehs4_new();
    let defaulted = ecs_ehs4_default();
    let capped = ecs_ehs4_with_capacity(11);
    let clamped = ecs_ehs4_with_capacity(-9);
    if ecs_ehs4_len(fresh) != 0 { panic(92821); };
    if ecs_ehs4_debug_kind(fresh) != 1 { panic(92822); };
    if ecs_ehs4_debug_kind(defaulted) != 2 { panic(92823); };
    if capped.capacity_hint != 11 { panic(92824); };
    if clamped.capacity_hint != 0 { panic(92825); };
}

@test "entity hash set derived extras clone and from hash set markers"() {
    let wrapped = ecs_ehs4_from_hash_set(make_ehs4_set());
    let cloned = ecs_ehs4_clone(wrapped);
    if ecs_ehs4_debug_kind(wrapped) != 6 { panic(92826); };
    if ecs_ehs4_debug_kind(cloned) != 4 { panic(92827); };
    if ecs_ehs4_contains(cloned, 2) != true { panic(92828); };
}

@test "entity hash set derived extras into inner"() {
    let inner = ecs_ehs4_into_inner(make_ehs4_set());
    if ecs_ehs4_inner_len(inner) != 3 { panic(92829); };
}

@test "entity hash set derived extras extend owned refs and array"() {
    let refs: Vec<i64> = Vec::new();
    refs.push(3);
    refs.push(5);
    refs.push(5);
    let extended = ecs_ehs4_extend_refs(make_ehs4_set(), refs);
    let arrayed = ecs_ehs4_from_array4(7, 8, 7, 9);
    if ecs_ehs4_len(extended) != 4 { panic(92830); };
    if ecs_ehs4_contains(extended, 5) != true { panic(92831); };
    if ecs_ehs4_len(arrayed) != 3 { panic(92832); };
    if arrayed.capacity_hint != 4 { panic(92833); };
    if ecs_ehs4_debug_kind(arrayed) != 5 { panic(92834); };
}

@test "entity hash set derived extras from entity set iterator"() {
    let values: Vec<i64> = Vec::new();
    values.push(10);
    values.push(11);
    values.push(12);
    let set = ecs_ehs4_from_entity_set_iter(values, 3);
    if ecs_ehs4_len(set) != 3 { panic(92835); };
    if set.capacity_hint != 3 { panic(92836); };
    if ecs_ehs4_debug_kind(set) != 7 { panic(92837); };
}

@test "entity hash set derived extras equality ignores order"() {
    let values: Vec<i64> = Vec::new();
    values.push(3);
    values.push(1);
    values.push(2);
    let other = ecs_ehs4_from_iter(values);
    if ecs_ehs4_eq(make_ehs4_set(), other) != true { panic(92838); };
}

@test "entity hash set derived extras equality detects missing"() {
    let values: Vec<i64> = Vec::new();
    values.push(1);
    values.push(2);
    let other = ecs_ehs4_from_iter(values);
    if ecs_ehs4_eq(make_ehs4_set(), other) != false { panic(92839); };
}

@test "entity hash set derived extras iter size hint and clone"() {
    let iter = ecs_ehs4_iter(make_ehs4_set());
    let hint = ecs_ehs4_size_hint(iter);
    let first = ecs_ehs4_iter_next(iter);
    let cloned = ecs_ehs4_iter_clone(first.iter);
    let after = ecs_ehs4_size_hint(cloned);
    if hint.lower != 3 { panic(92840); };
    if first.has != 1 { panic(92841); };
    if after.lower != 2 { panic(92842); };
}

@test "entity hash set derived extras iterator debug markers"() {
    let iter = ecs_ehs4_iter(make_ehs4_set());
    let owned = ecs_ehs4_into_iter(make_ehs4_set());
    let drained = ecs_ehs4_drain(make_ehs4_set());
    let extracted = ecs_ehs4_extract_if(make_ehs4_set(), 0, 0);
    if ecs_ehs4_iter_debug_kind(iter) != 10 { panic(92843); };
    if ecs_ehs4_iter_debug_kind(owned) != 20 { panic(92844); };
    if ecs_ehs4_iter_debug_kind(drained) != 30 { panic(92845); };
    if ecs_ehs4_iter_debug_kind(extracted) != 40 { panic(92846); };
    if extracted.trusted_unique != 1 { panic(92847); };
}

@test "entity hash set derived extras into inner markers"() {
    let first = ecs_ehs4_iter_next(ecs_ehs4_into_iter(make_ehs4_set()));
    let inner = ecs_ehs4_iter_into_inner(first.iter);
    if inner.inner_exposed != 1 { panic(92848); };
    let next = ecs_ehs4_iter_next(inner);
    if next.has != 1 { panic(92849); };
}

@test "entity hash set derived extras default iter empty"() {
    let iter = ecs_ehs4_iter_default(10);
    let next = ecs_ehs4_iter_next(iter);
    if next.has != 0 { panic(92850); };
    if next.iter.trusted_unique != 1 { panic(92851); };
}

@test "entity hash set derived extras extract threshold"() {
    let iter = ecs_ehs4_extract_if(make_ehs4_set(), 1, 2);
    let first = ecs_ehs4_iter_next(iter);
    if first.has != 1 { panic(92852); };
    if first.value != 3 { panic(92853); };
}

@test "entity hash set derived extras set op iterator markers"() {
    let diff = ecs_ehs4_difference_iter(make_ehs4_set(), make_ehs4_other());
    let inter = ecs_ehs4_intersection_iter(make_ehs4_set(), make_ehs4_other());
    let union_iter = ecs_ehs4_union_iter(make_ehs4_set(), make_ehs4_other());
    let sym = ecs_ehs4_symmetric_difference_iter(make_ehs4_set(), make_ehs4_other());
    if diff.debug_kind != 51 { panic(92854); };
    if inter.debug_kind != 52 { panic(92855); };
    if union_iter.debug_kind != 53 { panic(92856); };
    if sym.debug_kind != 54 { panic(92857); };
    if diff.trusted_unique != 1 { panic(92858); };
}

@test "entity hash set derived extras set op iterator counts"() {
    let diff = ecs_ehs4_difference_iter(make_ehs4_set(), make_ehs4_other());
    let inter = ecs_ehs4_intersection_iter(make_ehs4_set(), make_ehs4_other());
    let union_iter = ecs_ehs4_union_iter(make_ehs4_set(), make_ehs4_other());
    let sym = ecs_ehs4_symmetric_difference_iter(make_ehs4_set(), make_ehs4_other());
    if ecs_ehs4_size_hint(diff).lower != 2 { panic(92859); };
    if ecs_ehs4_size_hint(inter).lower != 1 { panic(92860); };
    if ecs_ehs4_size_hint(union_iter).lower != 4 { panic(92861); };
    if ecs_ehs4_size_hint(sym).lower != 3 { panic(92862); };
}

@test "entity hash set derived extras exhausted owned iterator"() {
    let iter = ecs_ehs4_into_iter(ecs_ehs4_new());
    let next = ecs_ehs4_iter_next(iter);
    if next.has != 0 { panic(92863); };
}
