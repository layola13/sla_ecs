@import "lib/deferred_world_extras.sla"

// Isolated tests for lib/deferred_world_extras.sla — DeferredWorld pub surface not in lib/deferred_world.sla. Bevy reference: src/world/deferred_world.rs.

@test "fetch_err_codes"() {
    if ecs_dwx_fetch_err_not_spawned() != 0 { panic(91411); };
    if ecs_dwx_fetch_err_aliased_mutability() != 1 { panic(91412); };
}

@test "dwx_new_change_tick_and_world_id"() {
    let d = ecs_dwx_new(5, 7);
    if ecs_dwx_change_tick(d) != 0 { panic(91413); };
    if ecs_dwx_world_id(d) != 5 { panic(91414); };
}

@test "get_entity_mut_found"() {
    let d = ecs_dwx_new(1, 0);
    let d2 = ecs_dwx_spawn(d, 42);
    let r = ecs_dwx_get_entity_mut(d2, 0);
    if ecs_dwx_gem_ok(r) != 1 { panic(91415); };
    if ecs_dwx_gem_err_code(r) != -1 { panic(91416); };
    if ecs_dwx_gem_entity_idx(r) != 0 { panic(91417); };
    if ecs_dwx_gem_value(r) != 42 { panic(91418); };
}

@test "get_entity_mut_not_spawned_error"() {
    let d = ecs_dwx_new(1, 0);
    let r = ecs_dwx_get_entity_mut(d, 99);
    if ecs_dwx_gem_ok(r) != 0 { panic(91419); };
    if ecs_dwx_gem_err_code(r) != ecs_dwx_fetch_err_not_spawned() { panic(91420); };
}

@test "get_entity_mut_negative_error"() {
    let d = ecs_dwx_new(1, 0);
    let r = ecs_dwx_get_entity_mut(d, -1);
    if ecs_dwx_gem_ok(r) != 0 { panic(91421); };
    if ecs_dwx_gem_err_code(r) != ecs_dwx_fetch_err_not_spawned() { panic(91422); };
}

@test "get_mut_returns_component_value"() {
    let d = ecs_dwx_new(1, 0);
    let d2 = ecs_dwx_spawn(d, 77);
    let r = ecs_dwx_get_mut(d2, 0, 1);
    if ecs_dwx_gm_ok(r) != 1 { panic(91423); };
    if ecs_dwx_gm_value(r) != 77 { panic(91424); };
}

@test "get_mut_missing_entity_returns_none"() {
    let d = ecs_dwx_new(1, 0);
    let r = ecs_dwx_get_mut(d, 5, 1);
    if ecs_dwx_gm_ok(r) != 0 { panic(91425); };
}

@test "get_mut_missing_component_returns_none"() {
    let d = ecs_dwx_new(1, 0);
    let d2 = ecs_dwx_spawn(d, 77);
    let r = ecs_dwx_get_mut(d2, 0, 99);
    if ecs_dwx_gm_ok(r) != 0 { panic(91426); };
}

@test "query_returns_handle_and_world_id"() {
    let d = ecs_dwx_new(13, 0);
    let qr = ecs_dwx_query(d);
    if ecs_dwx_query_handle(qr) != 1 { panic(91427); };
    if ecs_dwx_query_world_id(qr) != 13 { panic(91428); };
}

@test "query_multiple_handles_distinct"() {
    let d = ecs_dwx_new(1, 0);
    let q1 = ecs_dwx_query(d);
    let q2 = ecs_dwx_query(d);
    if ecs_dwx_query_handle(q1) == ecs_dwx_query_handle(q2) { panic(91429); };
}

@test "resources_insert_get_resource_mut_by_id"() {
    let rs = ecs_dwx_resources_new();
    let rs2 = ecs_dwx_resources_insert(rs, 5, 100);
    let rm = ecs_dwx_get_resource_mut_by_id(rs2, 5);
    if ecs_dwx_grmb_ok(rm) != 1 { panic(91430); };
    if ecs_dwx_grmb_value(rm) != 100 { panic(91431); };
}

@test "resources_insert_existing_overwrites"() {
    let rs = ecs_dwx_resources_new();
    let rs2 = ecs_dwx_resources_insert(rs, 5, 100);
    let rs3 = ecs_dwx_resources_insert(rs2, 5, 200);
    let rm = ecs_dwx_get_resource_mut_by_id(rs3, 5);
    if ecs_dwx_grmb_value(rm) != 200 { panic(91432); };
}

@test "resources_get_resource_mut_by_id_missing"() {
    let rs = ecs_dwx_resources_new();
    let rm = ecs_dwx_get_resource_mut_by_id(rs, 9);
    if ecs_dwx_grmb_ok(rm) != 0 { panic(91433); };
}

@test "non_send_insert_then_get_non_send_mut_by_id_same_thread"() {
    let d = ecs_dwx_new(1, 7);
    let d2 = ecs_dwx_insert_non_send(d, 9, 55, 7);
    let r = ecs_dwx_get_non_send_mut_by_id(d2, 9);
    if ecs_dwx_gnsmb_ok(r) != 1 { panic(91434); };
    if ecs_dwx_gnsmb_value(r) != 55 { panic(91435); };
    if !ecs_dwx_gnsmb_thread_ok(r) { panic(91436); };
}

@test "non_send_get_non_send_mut_by_id_cross_thread_fails"() {
    let d = ecs_dwx_new(1, 7);
    let d2 = ecs_dwx_insert_non_send(d, 9, 55, 99);
    let r = ecs_dwx_get_non_send_mut_by_id(d2, 9);
    if ecs_dwx_gnsmb_ok(r) != 1 { panic(91437); };
    if ecs_dwx_gnsmb_thread_ok(r) { panic(91438); };
}

@test "non_send_get_non_send_mut_by_id_missing"() {
    let d = ecs_dwx_new(1, 7);
    let r = ecs_dwx_get_non_send_mut_by_id(d, 9);
    if ecs_dwx_gnsmb_ok(r) != 0 { panic(91439); };
}

@test "non_send_insert_overwrites"() {
    let d = ecs_dwx_new(1, 7);
    let d2 = ecs_dwx_insert_non_send(d, 9, 55, 7);
    let d3 = ecs_dwx_insert_non_send(d2, 9, 200, 7);
    let r = ecs_dwx_get_non_send_mut_by_id(d3, 9);
    if ecs_dwx_gnsmb_value(r) != 200 { panic(91440); };
}

@test "non_send_resource_mut_found"() {
    let d = ecs_dwx_new(1, 7);
    let d2 = ecs_dwx_insert_non_send(d, 8, 30, 7);
    let r = ecs_dwx_non_send_resource_mut(d2, 8);
    if ecs_dwx_gnsmb_ok(r) != 1 { panic(91441); };
    if ecs_dwx_gnsmb_value(r) != 30 { panic(91442); };
}

@test "non_send_resource_mut_missing_returns_none"() {
    let d = ecs_dwx_new(1, 7);
    let r = ecs_dwx_non_send_resource_mut(d, 9);
    if ecs_dwx_gnsmb_ok(r) != 0 { panic(91443); };
}

@test "get_entity_mut_after_multiple_spawns"() {
    let d = ecs_dwx_new(1, 0);
    let d2 = ecs_dwx_spawn(d, 10);
    let d3 = ecs_dwx_spawn(d2, 20);
    let d4 = ecs_dwx_spawn(d3, 30);
    let r1 = ecs_dwx_get_entity_mut(d4, 0);
    let r2 = ecs_dwx_get_entity_mut(d4, 1);
    let r3 = ecs_dwx_get_entity_mut(d4, 2);
    if ecs_dwx_gem_value(r1) != 10 { panic(91444); };
    if ecs_dwx_gem_value(r2) != 20 { panic(91445); };
    if ecs_dwx_gem_value(r3) != 30 { panic(91446); };
}
