@import "lib/entity_ref_deep.sla"

// Batch 275: entity_ref deep (src/world/entity_access/entity_ref.rs).
// panic codes: 121000 – 121199.

@test "new_and_meta"() {
    let r = ecs_er_deep_new(42);
    r = ecs_er_deep_with_meta(r, 3, 7, 100, 50);
    if ecs_er_deep_id(r) != 42 { panic(121000); };
    if ecs_er_deep_archetype(r) != 3 { panic(121001); };
    if ecs_er_deep_location_row(r) != 7 { panic(121002); };
    if ecs_er_deep_spawned_by(r) != 100 { panic(121003); };
    if ecs_er_deep_spawn_tick(r) != 50 { panic(121004); };
}

@test "insert_get_contains"() {
    let r = ecs_er_deep_new(1);
    r = ecs_er_deep_insert(r, 10, 110, 100, 1, 2, 9);
    r = ecs_er_deep_insert(r, 11, 111, 200, 3, 4, 8);
    if ecs_er_deep_len(r) != 2 { panic(121010); };
    if ecs_er_deep_contains(r, 10) != true { panic(121011); };
    if ecs_er_deep_contains_id(r, 99) != false { panic(121012); };
    if ecs_er_deep_contains_type_id(r, 111) != true { panic(121013); };
    let g = ecs_er_deep_get(r, 11);
    if ecs_er_get_found(g) != true { panic(121014); };
    if ecs_er_get_value(g) != 200 { panic(121015); };
}

@test "get_ref_and_changed_by"() {
    let r = ecs_er_deep_new(2);
    r = ecs_er_deep_insert(r, 5, 50, 55, 1, 2, 77);
    let g = ecs_er_deep_get_ref(r, 5);
    if ecs_er_get_value(g) != 55 { panic(121020); };
    if ecs_er_get_added(g) != 1 { panic(121021); };
    if ecs_er_get_changed(g) != 2 { panic(121022); };
    if ecs_er_get_changed_by(g) != 77 { panic(121023); };
    let miss = ecs_er_deep_get_changed_by(r, 6);
    if ecs_er_get_found(miss) != false { panic(121024); };
}

@test "change_ticks_by_id"() {
    let r = ecs_er_deep_new(3);
    r = ecs_er_deep_insert(r, 1, 1, 7, 11, 22, 0);
    let t = ecs_er_deep_get_change_ticks_by_id(r, 1);
    if ecs_er_get_added(t) != 11 { panic(121030); };
    if ecs_er_get_changed(t) != 22 { panic(121031); };
    let t2 = ecs_er_deep_get_change_ticks(r, 2);
    if ecs_er_get_found(t2) != false { panic(121032); };
}

@test "get_by_id"() {
    let r = ecs_er_deep_new(4);
    r = ecs_er_deep_insert(r, 8, 80, 80, 1, 1, 0);
    let g = ecs_er_deep_get_by_id(r, 8);
    if ecs_er_get_value(g) != 80 { panic(121040); };
    let g2 = ecs_er_deep_get_by_id(r, 9);
    if ecs_er_get_found(g2) != false { panic(121041); };
}

@test "components_count_and_get_all"() {
    let r = ecs_er_deep_new(5);
    r = ecs_er_deep_insert(r, 1, 1, 1, 0, 0, 0);
    r = ecs_er_deep_insert(r, 2, 2, 2, 0, 0, 0);
    if ecs_er_deep_components_count4(r, 1, 2, 3, 0, 3) != 2 { panic(121050); };
    if ecs_er_deep_get_components_all4(r, 1, 2, 0, 0, 2) != true { panic(121051); };
    if ecs_er_deep_get_components_all4(r, 1, 2, 3, 0, 3) != false { panic(121052); };
}

@test "into_filtered"() {
    let r = ecs_er_deep_new(6);
    r = ecs_er_deep_insert(r, 1, 1, 1, 0, 0, 0);
    if ecs_er_deep_is_filtered(r) != false { panic(121060); };
    r = ecs_er_deep_into_filtered(r);
    if ecs_er_deep_is_filtered(r) != true { panic(121061); };
    if ecs_er_deep_id(r) != 6 { panic(121062); };
    if ecs_er_deep_len(r) != 1 { panic(121063); };
}

@test "component_at_and_eq_cmp"() {
    let r = ecs_er_deep_new(8);
    r = ecs_er_deep_insert(r, 3, 30, 1, 0, 0, 0);
    r = ecs_er_deep_insert(r, 4, 40, 2, 0, 0, 0);
    if ecs_er_deep_component_at(r, 0) != 3 { panic(121070); };
    if ecs_er_deep_component_at(r, 1) != 4 { panic(121071); };
    let a = ecs_er_deep_new(1);
    let b = ecs_er_deep_new(2);
    if ecs_er_deep_eq(a, b) != false { panic(121072); };
    if ecs_er_deep_cmp(a, b) != -1 { panic(121073); };
}

@test "overwrite_same_component"() {
    let r = ecs_er_deep_new(9);
    r = ecs_er_deep_insert(r, 1, 10, 5, 1, 1, 1);
    r = ecs_er_deep_insert(r, 1, 10, 9, 1, 5, 2);
    if ecs_er_deep_len(r) != 1 { panic(121080); };
    let g = ecs_er_deep_get(r, 1);
    if ecs_er_get_value(g) != 9 { panic(121081); };
    if ecs_er_get_changed(g) != 5 { panic(121082); };
    if ecs_er_get_changed_by(g) != 2 { panic(121083); };
}

@test "empty_get_miss"() {
    let r = ecs_er_deep_new(10);
    if ecs_er_deep_is_filtered(r) != false { panic(121090); };
    if ecs_er_deep_len(r) != 0 { panic(121091); };
    let g = ecs_er_deep_get(r, 1);
    if ecs_er_get_found(g) != false { panic(121092); };
}
