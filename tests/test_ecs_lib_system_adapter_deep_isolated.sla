@import "lib/system_adapter_deep.sla"

// Batch 333: system_adapter deep.
// panic codes: 132600 – 132799.

@test "run_error_ok"() {
    let e = ecs_sae_ok();
    if ecs_sae_is_ok(e) != true { panic(132600); };
    let bad = ecs_sae_err(3, 9);
    if ecs_sae_is_ok(bad) != false { panic(132601); };
    if ecs_sae_payload(bad) != 9 { panic(132602); };
}

@test "not_adapt"() {
    let m = ecs_sae_not_new();
    let r = ecs_sae_not_adapt(m, true, ecs_sae_ok());
    if ecs_sae_not_res_value(r) != false { panic(132610); };
    let r2 = ecs_sae_not_adapt(m, false, ecs_sae_ok());
    if ecs_sae_not_res_value(r2) != true { panic(132611); };
}

@test "not_adapt_err"() {
    let r = ecs_sae_not_adapt(ecs_sae_not_new(), true, ecs_sae_err(1, 2));
    if ecs_sae_is_ok(ecs_sae_not_res_err(r)) != false { panic(132620); };
    if ecs_sae_not_res_value(r) != false { panic(132621); };
}

@test "adapter_not_run"() {
    let s = ecs_sae_sys_new(0, 0, 11);
    let r = ecs_sae_sys_run(s, 0);
    if ecs_sae_run_value(r) != 1 { panic(132630); };
    if ecs_sae_sys_name(s) != 11 { panic(132631); };
}

@test "adapter_map_run"() {
    let s = ecs_sae_sys_new(1, 5, 1);
    let r = ecs_sae_sys_run(s, 3);
    if ecs_sae_run_value(r) != 8 { panic(132640); };
}

@test "adapter_chain_run"() {
    let s = ecs_sae_sys_new(2, 4, 1);
    let r = ecs_sae_sys_run(s, 6);
    if ecs_sae_run_value(r) != 10 { panic(132650); };
}

@test "into_adapter"() {
    let i = ecs_sae_into_new(1, 7);
    let s = ecs_sae_into_system(i, 99);
    if ecs_sae_sys_kind(s) != 1 { panic(132660); };
    if ecs_sae_sys_name(s) != 99 { panic(132661); };
}

@test "map_adapt"() {
    let m = ecs_sae_map_new(10);
    let r = ecs_sae_map_adapt(m, 5, ecs_sae_ok());
    if ecs_sae_run_value(r) != 15 { panic(132670); };
}

@test "chain_adapt"() {
    let c = ecs_sae_chain_new(2);
    let r = ecs_sae_chain_adapt(c, 8, ecs_sae_ok());
    if ecs_sae_run_value(r) != 10 { panic(132680); };
}

@test "marker"() {
    let m = ecs_sae_mark_new();
    if ecs_sae_mark_tag(m) != 1 { panic(132690); };
}
