@import "lib/schedule_auto_insert_deferred_deep.sla"

// Batch 334: schedule_auto_insert_deferred deep.
// panic codes: 132800 – 132999.

@test "edge_key"() {
    if ecs_aid_deep_edge_key(1, 2) != 10002 { panic(132800); };
}

@test "add_no_sync"() {
    let p = ecs_aid_deep_new();
    p = ecs_aid_deep_add_dependency(p, 1, 2, true);
    p = ecs_aid_deep_add_dependency(p, 3, 4, false);
    if ecs_aid_deep_no_sync_count(p) != 1 { panic(132810); };
    if ecs_aid_deep_is_no_sync(p, 1, 2) != true { panic(132811); };
    if ecs_aid_deep_is_no_sync(p, 3, 4) != false { panic(132812); };
}

@test "should_insert"() {
    let p = ecs_aid_deep_add_dependency(ecs_aid_deep_new(), 1, 2, true);
    if ecs_aid_deep_should_insert_sync(p, 1, 2, true) != false { panic(132820); };
    if ecs_aid_deep_should_insert_sync(p, 1, 3, true) != true { panic(132821); };
    if ecs_aid_deep_should_insert_sync(p, 1, 3, false) != false { panic(132822); };
}

@test "get_sync_point_create"() {
    let p = ecs_aid_deep_new();
    let r = ecs_aid_deep_get_sync_point(p, 0);
    if ecs_aid_sync_node(r) != 0 { panic(132830); };
    if ecs_aid_deep_sync_count(ecs_aid_sync_pass(r)) != 1 { panic(132831); };
}

@test "get_sync_point_reuse"() {
    let p = ecs_aid_deep_new();
    let r1 = ecs_aid_deep_get_sync_point(p, 5);
    let r2 = ecs_aid_deep_get_sync_point(ecs_aid_sync_pass(r1), 5);
    if ecs_aid_sync_node(r2) != ecs_aid_sync_node(r1) { panic(132840); };
    if ecs_aid_deep_sync_count(ecs_aid_sync_pass(r2)) != 1 { panic(132841); };
}

@test "add_auto_sync"() {
    let p = ecs_aid_deep_new();
    let r = ecs_aid_deep_add_auto_sync(p);
    if ecs_aid_sync_node(r) != 0 { panic(132850); };
    if ecs_aid_deep_next(ecs_aid_sync_pass(r)) != 1 { panic(132851); };
}

@test "build_edge_insert"() {
    let p = ecs_aid_deep_new();
    let b = ecs_aid_deep_build_edge(p, 1, 2, true);
    if ecs_aid_build_inserted(b) != true { panic(132860); };
    if ecs_aid_build_from(b) != 1 { panic(132861); };
    if ecs_aid_build_to(b) != 2 { panic(132862); };
    if ecs_aid_build_sync(b) != 0 { panic(132863); };
}

@test "build_edge_skip_no_sync"() {
    let p = ecs_aid_deep_add_dependency(ecs_aid_deep_new(), 1, 2, true);
    let b = ecs_aid_deep_build_edge(p, 1, 2, true);
    if ecs_aid_build_inserted(b) != false { panic(132870); };
    if ecs_aid_build_sync(b) != (0 - 1) { panic(132871); };
}

@test "build_edge_no_deferred"() {
    let b = ecs_aid_deep_build_edge(ecs_aid_deep_new(), 1, 2, false);
    if ecs_aid_build_inserted(b) != false { panic(132880); };
}

@test "sync_capacity_four"() {
    let p = ecs_aid_deep_new();
    let r0 = ecs_aid_deep_get_sync_point(p, 0);
    let r1 = ecs_aid_deep_get_sync_point(ecs_aid_sync_pass(r0), 1);
    let r2 = ecs_aid_deep_get_sync_point(ecs_aid_sync_pass(r1), 2);
    let r3 = ecs_aid_deep_get_sync_point(ecs_aid_sync_pass(r2), 3);
    if ecs_aid_deep_sync_count(ecs_aid_sync_pass(r3)) != 4 { panic(132890); };
    let r4 = ecs_aid_deep_get_sync_point(ecs_aid_sync_pass(r3), 4);
    if ecs_aid_sync_node(r4) != (0 - 1) { panic(132891); };
}
