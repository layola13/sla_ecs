@import "lib/app_type_registry.sla"

@test "app type registry new is empty"() {
    let r = ecs_app_type_registry_new();
    if ecs_app_type_registry_is_empty(r) != true { panic(78101); };
    if ecs_app_type_registry_len(r) != 0 { panic(78102); };
}

@test "app type registry registers descriptor"() {
    let d = ecs_app_type_descriptor_new(10, 1000, 100);
    let r = ecs_app_type_registry_register_or_replace(ecs_app_type_registry_new(), d);
    if ecs_app_type_registry_len(r) != 1 { panic(78103); };
    if ecs_app_type_registry_contains(r, 10) != true { panic(78104); };
    let got = ecs_app_type_registry_get(r, 10);
    if got.has != true { panic(78105); };
    if ecs_app_type_descriptor_type_path(got.descriptor) != 1000 { panic(78106); };
    if ecs_app_type_descriptor_short_type_path(got.descriptor) != 100 { panic(78107); };
}

@test "app type registry replaces descriptor by type id"() {
    let r0 = ecs_app_type_registry_new();
    let r1 = ecs_app_type_registry_register_or_replace(r0, ecs_app_type_descriptor_new(10, 1000, 100));
    let r2 = ecs_app_type_registry_register_or_replace(r1, ecs_app_type_descriptor_new(10, 2000, 200));
    if ecs_app_type_registry_len(r2) != 1 { panic(78108); };
    let got = ecs_app_type_registry_get(r2, 10);
    if got.has != true { panic(78109); };
    if ecs_app_type_descriptor_type_path(got.descriptor) != 2000 { panic(78110); };
}

@test "app type registry at preserves insertion order"() {
    let r0 = ecs_app_type_registry_new();
    let r1 = ecs_app_type_registry_register_or_replace(r0, ecs_app_type_descriptor_new(10, 1000, 100));
    let r2 = ecs_app_type_registry_register_or_replace(r1, ecs_app_type_descriptor_new(20, 2000, 200));
    let first = ecs_app_type_registry_at(r2, 0);
    let second = ecs_app_type_registry_at(r2, 1);
    let missing = ecs_app_type_registry_at(r2, 2);
    if first.has != true { panic(78111); };
    if second.has != true { panic(78112); };
    if missing.has != false { panic(78113); };
    if ecs_app_type_descriptor_type_id(first.descriptor) != 10 { panic(78114); };
    if ecs_app_type_descriptor_type_id(second.descriptor) != 20 { panic(78115); };
}

@test "app type descriptor stores type data slots"() {
    let d0 = ecs_app_type_descriptor_new(10, 1000, 100);
    let d1 = ecs_app_type_descriptor_with_type_data(d0, ECS_APP_TYPE_DATA_COMPONENT, 501);
    let d2 = ecs_app_type_descriptor_with_type_data(d1, ECS_APP_TYPE_DATA_RESOURCE, 601);
    if ecs_app_type_descriptor_has_type_data(d2, ECS_APP_TYPE_DATA_COMPONENT) != true { panic(78116); };
    if ecs_app_type_descriptor_has_type_data(d2, ECS_APP_TYPE_DATA_EVENT) != false { panic(78117); };
    let component = ecs_app_type_descriptor_type_data(d2, ECS_APP_TYPE_DATA_COMPONENT);
    let resource = ecs_app_type_descriptor_type_data(d2, ECS_APP_TYPE_DATA_RESOURCE);
    let event = ecs_app_type_descriptor_type_data(d2, ECS_APP_TYPE_DATA_EVENT);
    if component.has != true { panic(78118); };
    if component.data != 501 { panic(78119); };
    if resource.has != true { panic(78120); };
    if resource.data != 601 { panic(78121); };
    if event.has != false { panic(78122); };
}

@test "app type registry registers type data onto descriptor"() {
    let r0 = ecs_app_type_registry_new();
    let r1 = ecs_app_type_registry_register_or_replace(r0, ecs_app_type_descriptor_new(10, 1000, 100));
    let r2 = ecs_app_type_registry_register_type_data(r1, 10, ECS_APP_TYPE_DATA_EVENT, 701);
    if ecs_app_type_registry_has_type_data(r2, 10, ECS_APP_TYPE_DATA_EVENT) != true { panic(78123); };
    let data = ecs_app_type_registry_type_data(r2, 10, ECS_APP_TYPE_DATA_EVENT);
    if data.has != true { panic(78124); };
    if data.data != 701 { panic(78125); };
    let missing = ecs_app_type_registry_type_data(r2, 99, ECS_APP_TYPE_DATA_EVENT);
    if missing.has != false { panic(78126); };
}

@test "app type registry ignores type data for missing descriptor"() {
    let r = ecs_app_type_registry_register_type_data(ecs_app_type_registry_new(), 10, ECS_APP_TYPE_DATA_COMPONENT, 1);
    if ecs_app_type_registry_len(r) != 0 { panic(78127); };
}

@test "app function registry new is empty"() {
    let r = ecs_app_function_registry_new();
    if ecs_app_function_registry_is_empty(r) != true { panic(78128); };
    if ecs_app_function_registry_len(r) != 0 { panic(78129); };
}

@test "app function registry registers descriptor"() {
    let d = ecs_app_function_descriptor_new(10, 1000, 5000);
    let r = ecs_app_function_registry_register_or_replace(ecs_app_function_registry_new(), d);
    if ecs_app_function_registry_len(r) != 1 { panic(78130); };
    if ecs_app_function_registry_contains(r, 10) != true { panic(78131); };
    let got = ecs_app_function_registry_get(r, 10);
    if got.has != true { panic(78132); };
    if got.descriptor.name != 1000 { panic(78133); };
    if got.descriptor.function_handle != 5000 { panic(78134); };
}

@test "app function registry replaces by function id"() {
    let r0 = ecs_app_function_registry_new();
    let r1 = ecs_app_function_registry_register_or_replace(r0, ecs_app_function_descriptor_new(10, 1000, 5000));
    let r2 = ecs_app_function_registry_register_or_replace(r1, ecs_app_function_descriptor_new(10, 2000, 6000));
    if ecs_app_function_registry_len(r2) != 1 { panic(78135); };
    let got = ecs_app_function_registry_get(r2, 10);
    if got.has != true { panic(78136); };
    if got.descriptor.name != 2000 { panic(78137); };
    if got.descriptor.function_handle != 6000 { panic(78138); };
}

@test "app function registry at preserves insertion order"() {
    let r0 = ecs_app_function_registry_new();
    let r1 = ecs_app_function_registry_register_or_replace(r0, ecs_app_function_descriptor_new(10, 1000, 5000));
    let r2 = ecs_app_function_registry_register_or_replace(r1, ecs_app_function_descriptor_new(20, 2000, 6000));
    let first = ecs_app_function_registry_at(r2, 0);
    let second = ecs_app_function_registry_at(r2, 1);
    let missing = ecs_app_function_registry_at(r2, 2);
    if first.has != true { panic(78139); };
    if second.has != true { panic(78140); };
    if missing.has != false { panic(78141); };
    if first.descriptor.function_id != 10 { panic(78142); };
    if second.descriptor.function_id != 20 { panic(78143); };
}

