@import "lib/query_builder_extras_deep.sla"

// Batch 303: query_builder_extras deep.
// panic codes: 126600 – 126799.

@test "new_world"() {
    let q = ecs_qb_deep_new(7);
    if ecs_qb_deep_world(q) != 7 { panic(126600); };
    if ecs_qb_deep_dlen(q) != 0 { panic(126601); };
}

@test "ref_and_mut_ids"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_ref_id(q, 10);
    q = ecs_qb_deep_mut_id(q, 11);
    if ecs_qb_deep_dlen(q) != 2 { panic(126610); };
    if ecs_qb_deep_data_id_at(q, 0) != 10 { panic(126611); };
    if ecs_qb_deep_data_is_write(q, 0) != false { panic(126612); };
    if ecs_qb_deep_data_is_write(q, 1) != true { panic(126613); };
}

@test "with_without_dedup"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_with_id(q, 1);
    q = ecs_qb_deep_with_id(q, 1);
    q = ecs_qb_deep_with_id(q, 2);
    if ecs_qb_deep_wlen(q) != 2 { panic(126620); };
    q = ecs_qb_deep_without_id(q, 3);
    q = ecs_qb_deep_without_id(q, 3);
    if ecs_qb_deep_xlen(q) != 1 { panic(126621); };
    if ecs_qb_deep_with_at(q, 1) != 2 { panic(126622); };
    if ecs_qb_deep_without_at(q, 0) != 3 { panic(126623); };
}

@test "optional_and_or"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_optional(q);
    q = ecs_qb_deep_optional(q);
    q = ecs_qb_deep_or(q);
    if ecs_qb_deep_optional_count(q) != 2 { panic(126630); };
    if ecs_qb_deep_or_groups(q) != 1 { panic(126631); };
}

@test "access_view"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_ref_id(q, 1);
    q = ecs_qb_deep_mut_id(q, 2);
    q = ecs_qb_deep_mut_id(q, 3);
    q = ecs_qb_deep_with_id(q, 4);
    q = ecs_qb_deep_without_id(q, 5);
    let a = ecs_qb_deep_access(q);
    if ecs_qb_access_reads(a) != 1 { panic(126640); };
    if ecs_qb_access_writes(a) != 2 { panic(126641); };
    if ecs_qb_access_with(a) != 1 { panic(126642); };
    if ecs_qb_access_without(a) != 1 { panic(126643); };
}

@test "data_capacity_four"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_ref_id(q, 1);
    q = ecs_qb_deep_ref_id(q, 2);
    q = ecs_qb_deep_ref_id(q, 3);
    q = ecs_qb_deep_ref_id(q, 4);
    if ecs_qb_deep_dlen(q) != 4 { panic(126650); };
    q = ecs_qb_deep_ref_id(q, 5);
    if ecs_qb_deep_dlen(q) != 4 { panic(126651); };
}

@test "with_capacity_four"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_with_id(q, 1);
    q = ecs_qb_deep_with_id(q, 2);
    q = ecs_qb_deep_with_id(q, 3);
    q = ecs_qb_deep_with_id(q, 4);
    if ecs_qb_deep_wlen(q) != 4 { panic(126660); };
    q = ecs_qb_deep_with_id(q, 5);
    if ecs_qb_deep_wlen(q) != 4 { panic(126661); };
}

@test "without_capacity_four"() {
    let q = ecs_qb_deep_new(1);
    q = ecs_qb_deep_without_id(q, 1);
    q = ecs_qb_deep_without_id(q, 2);
    q = ecs_qb_deep_without_id(q, 3);
    q = ecs_qb_deep_without_id(q, 4);
    if ecs_qb_deep_xlen(q) != 4 { panic(126670); };
}

@test "mixed_builder_chain"() {
    let q = ecs_qb_deep_new(42);
    q = ecs_qb_deep_mut_id(q, 1);
    q = ecs_qb_deep_with_id(q, 2);
    q = ecs_qb_deep_without_id(q, 3);
    q = ecs_qb_deep_or(q);
    if ecs_qb_deep_world(q) != 42 { panic(126680); };
    if ecs_qb_deep_data_is_write(q, 0) != true { panic(126681); };
    if ecs_qb_deep_or_groups(q) != 1 { panic(126682); };
}

@test "access_empty"() {
    let a = ecs_qb_deep_access(ecs_qb_deep_new(1));
    if ecs_qb_access_reads(a) != 0 { panic(126690); };
    if ecs_qb_access_writes(a) != 0 { panic(126691); };
}
