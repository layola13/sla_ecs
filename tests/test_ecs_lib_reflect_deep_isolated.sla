// Isolated deep tests for lib/reflect_deep.sla (Batch 416).
// Covers the root reflect facade: stable reflect type id, flattened fn table handles,
// ReflectComponent wrapper construction, fn-pointer extraction, and deterministic dispatch
// for insert/apply/remove/take/contains/reflect/copy/register_component.

@import "lib/reflect_deep.sla"

@test "reflect_value_type_id_and_clone"() {
    let v = ecs_reflect_value_deep_new(42, 9001);
    if ecs_reflect_value_deep_type_id(v) != 42 { panic(147630); };
    if ecs_reflect_deep_reflect_type_id(v) != 42 { panic(147631); };
    let c = ecs_reflect_deep_clone_value(v);
    if ecs_reflect_value_deep_type_id(c) != 42 { panic(147632); };
    if ecs_reflect_value_deep_raw(c) != 9001 { panic(147633); };
}

@test "component_fns_new_and_accessors"() {
    let f = ecs_reflect_component_fns_deep_new(10, 20, 30, 40, 50, 60, 70, 80);
    if ecs_reflect_component_fns_deep_insert(f) != 10 { panic(147634); };
    if ecs_reflect_component_fns_deep_apply(f) != 20 { panic(147635); };
    if ecs_reflect_component_fns_deep_remove(f) != 30 { panic(147636); };
    if ecs_reflect_component_fns_deep_take(f) != 40 { panic(147637); };
    if ecs_reflect_component_fns_deep_contains(f) != 50 { panic(147638); };
    if ecs_reflect_component_fns_deep_reflect(f) != 60 { panic(147639); };
    if ecs_reflect_component_fns_deep_copy(f) != 70 { panic(147640); };
    if ecs_reflect_component_fns_deep_register_component(f) != 80 { panic(147641); };
}

@test "component_new_flattens_fns"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2, 3, 4, 5, 6, 7, 8);
    let rc = ecs_reflect_component_deep_new(99, f);
    if ecs_reflect_component_deep_type_id(rc) != 99 { panic(147642); };
    let p = ecs_reflect_component_deep_fn_pointers(rc);
    if ecs_reflect_component_fns_deep_insert(p) != 1 { panic(147643); };
    if ecs_reflect_component_fns_deep_register_component(p) != 8 { panic(147644); };
}

@test "component_insert_dispatches_handle"() {
    let f = ecs_reflect_component_fns_deep_new(1000, 2, 3, 4, 5, 6, 7, 8);
    let rc = ecs_reflect_component_deep_new(77, f);
    let v = ecs_reflect_component_deep_insert(rc, 123);
    if ecs_reflect_value_deep_type_id(v) != 123 { panic(147645); };
    if ecs_reflect_value_deep_raw(v) != 1123 { panic(147646); };
}

@test "component_apply_dispatches_handle_and_preserves_target_type"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2000, 3, 4, 5, 6, 7, 8);
    let rc = ecs_reflect_component_deep_new(77, f);
    let target = ecs_reflect_value_deep_new(10, 30);
    let source = ecs_reflect_value_deep_new(20, 40);
    let v = ecs_reflect_component_deep_apply(rc, target, source);
    if ecs_reflect_value_deep_type_id(v) != 10 { panic(147647); };
    if ecs_reflect_value_deep_raw(v) != 2070 { panic(147648); };
}

@test "component_remove_and_take_dispatch_handles"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2, 300, 4000, 5, 6, 7, 8);
    let rc = ecs_reflect_component_deep_new(77, f);
    if ecs_reflect_component_deep_remove(rc, 9) != 309 { panic(147649); };
    let taken = ecs_reflect_component_deep_take(rc, 12);
    if ecs_reflect_value_deep_type_id(taken) != 77 { panic(147650); };
    if ecs_reflect_value_deep_raw(taken) != 4012 { panic(147651); };
}

@test "component_contains_uses_handle_as_expected_row"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2, 3, 4, 55, 6, 7, 8);
    let rc = ecs_reflect_component_deep_new(77, f);
    if ecs_reflect_component_deep_contains(rc, 55) != true { panic(147652); };
    if ecs_reflect_component_deep_contains(rc, 54) != false { panic(147653); };
}

@test "component_reflect_dispatches_handle"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2, 3, 4, 5, 6000, 7, 8);
    let rc = ecs_reflect_component_deep_new(77, f);
    let v = ecs_reflect_component_deep_reflect(rc, 44);
    if ecs_reflect_value_deep_type_id(v) != 77 { panic(147654); };
    if ecs_reflect_value_deep_raw(v) != 6044 { panic(147655); };
}

@test "component_copy_dispatches_handle_and_preserves_source_type"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2, 3, 4, 5, 6, 7000, 8);
    let rc = ecs_reflect_component_deep_new(77, f);
    let source = ecs_reflect_value_deep_new(88, 33);
    let v = ecs_reflect_component_deep_copy(rc, source);
    if ecs_reflect_value_deep_type_id(v) != 88 { panic(147656); };
    if ecs_reflect_value_deep_raw(v) != 7033 { panic(147657); };
}

@test "component_register_returns_register_handle"() {
    let f = ecs_reflect_component_fns_deep_new(1, 2, 3, 4, 5, 6, 7, 8080);
    let rc = ecs_reflect_component_deep_new(77, f);
    if ecs_reflect_component_deep_register(rc) != 8080 { panic(147658); };
}
