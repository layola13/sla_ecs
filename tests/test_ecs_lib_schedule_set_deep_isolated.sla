@import "lib/schedule_set_deep.sla"

// Batch 173 tests for deepened schedule::set surface.

@test "system_set_identity_system_type"() {
    let s = ecs_system_set_identity_system_type(7);
    if ecs_system_set_identity_is_system_type(s) != true { panic(97000); };
    if ecs_system_set_identity_is_anonymous(s) != false { panic(97001); };
    if ecs_system_set_identity_is_base(s) != false { panic(97002); };
    if ecs_system_set_identity_kind(s) != 0 { panic(97003); };
    if ecs_system_set_identity_type_id(s) != 7 { panic(97004); };
    if ecs_system_set_identity_anon_id(s) != 0 { panic(97005); };
    if ecs_system_set_identity_label_id(s) != 0 { panic(97006); };
}

@test "system_set_identity_anonymous"() {
    let s = ecs_system_set_identity_anonymous(42);
    if ecs_system_set_identity_is_anonymous(s) != true { panic(97010); };
    if ecs_system_set_identity_is_system_type(s) != false { panic(97011); };
    if ecs_system_set_identity_is_base(s) != false { panic(97012); };
    if ecs_system_set_identity_kind(s) != 1 { panic(97013); };
    if ecs_system_set_identity_anon_id(s) != 42 { panic(97014); };
    if ecs_system_set_identity_type_id(s) != 0 { panic(97015); };
    if ecs_system_set_identity_label_id(s) != 0 { panic(97016); };
}

@test "system_set_identity_base"() {
    let s = ecs_system_set_identity_base(99);
    if ecs_system_set_identity_is_base(s) != true { panic(97020); };
    if ecs_system_set_identity_kind(s) != 2 { panic(97021); };
    if ecs_system_set_identity_label_id(s) != 99 { panic(97022); };
    if ecs_system_set_identity_type_id(s) != 0 { panic(97023); };
    if ecs_system_set_identity_anon_id(s) != 0 { panic(97024); };
}

@test "trait_system_type_some_for_system_type"() {
    let s = ecs_system_type_set_new(123);
    let oi = ecs_system_set_trait_system_type(s);
    if ecs_option_type_id_is_some(oi) != true { panic(97030); };
    if ecs_option_type_id_is_none(oi) != false { panic(97031); };
    if ecs_option_type_id_value(oi) != 123 { panic(97032); };
}

@test "trait_system_type_none_for_anonymous"() {
    let s = ecs_system_set_identity_anonymous(8);
    let oi = ecs_system_set_trait_system_type(s);
    if ecs_option_type_id_is_some(oi) != false { panic(97040); };
    if ecs_option_type_id_is_none(oi) != true { panic(97041); };
}

@test "trait_system_type_none_for_base_set"() {
    let s = ecs_system_set_identity_base(5);
    let oi = ecs_system_set_trait_system_type(s);
    if ecs_option_type_id_is_some(oi) != false { panic(97050); };
    if ecs_option_type_id_is_none(oi) != true { panic(97051); };
}

@test "trait_is_anonymous_true_only_for_anonymous"() {
    if ecs_system_set_trait_is_anonymous(ecs_system_set_identity_anonymous(1)) != true { panic(97060); };
    if ecs_system_set_trait_is_anonymous(ecs_system_type_set_new(2)) != false { panic(97061); };
    if ecs_system_set_trait_is_anonymous(ecs_system_set_identity_base(3)) != false { panic(97062); };
}

@test "option_type_id_some_none_helpers"() {
    let s = ecs_option_type_id_some(50);
    if ecs_option_type_id_is_some(s) != true { panic(97070); };
    if ecs_option_type_id_value(s) != 50 { panic(97071); };
    let n = ecs_option_type_id_none();
    if ecs_option_type_id_is_none(n) != true { panic(97072); };
    if ecs_option_type_id_is_some(n) != false { panic(97073); };
    if ecs_option_type_id_value(n) != 0 { panic(97074); };
}

@test "anon_set_traits"() {
    if ecs_anon_set_is_anonymous(0) != true { panic(97080); };
    if ecs_anon_set_eq(3, 3) != true { panic(97081); };
    if ecs_anon_set_eq(3, 4) != false { panic(97082); };
    if ecs_anon_set_hash(7) != 7 { panic(97083); };
}

@test "system_type_set_eq_semantics"() {
    let a = ecs_system_type_set_new(11);
    let b = ecs_system_type_set_new(11);
    // Same-T compares equal for any two instances.
    if ecs_system_type_set_eq_distinct(11, 11) != true { panic(97090); };
    // hash is constant-by-T (modeled as the type id).
    if ecs_system_type_set_hash(a, 11) != 11 { panic(97091); };
    // is_anonymous is always false for SystemTypeSet.
    if ecs_system_type_set_is_anonymous(b) != false { panic(97092); };
    // different types are unequal
    if ecs_system_type_set_eq_distinct(11, 12) != false { panic(97093); };
}

@test "system_type_set_system_type_helper"() {
    let oi = ecs_system_type_set_system_type(999);
    if ecs_option_type_id_is_some(oi) != true { panic(97100); };
    if ecs_option_type_id_value(oi) != 999 { panic(97101); };
}

@test "intern_registry_new_starts_at_one"() {
    let r = ecs_intern_registry_new();
    let result = ecs_intern_registry_intern(r, ecs_system_type_set_new(100));
    if ecs_intern_result_created_flag(result) != true { panic(97110); };
    if ecs_intern_result_found_flag(result) != false { panic(97111); };
    if ecs_intern_result_id(result) != 1 { panic(97112); };
}

@test "intern_registry_dedup_same_identity"() {
    let r = ecs_intern_registry_new();
    let id1 = ecs_intern_registry_intern(r, ecs_system_set_identity_anonymous(5));
    let id2 = ecs_intern_registry_intern(r, ecs_system_set_identity_anonymous(5));
    if ecs_intern_result_created_flag(id1) != true { panic(97120); };
    if ecs_intern_result_found_flag(id2) != true { panic(97121); };
    if ecs_intern_result_id(id1) != ecs_intern_result_id(id2) { panic(97122); };
    if ecs_intern_result_id(id2) != 1 { panic(97123); };
}

@test "intern_registry_distinct_identities_distinct_ids"() {
    let r = ecs_intern_registry_new();
    let a = ecs_intern_registry_intern(r, ecs_system_type_set_new(1));
    let b = ecs_intern_registry_intern(r, ecs_system_type_set_new(2));
    let c = ecs_intern_registry_intern(r, ecs_system_set_identity_anonymous(99));
    if ecs_intern_result_id(a) == ecs_intern_result_id(b) { panic(97130); };
    if ecs_intern_result_id(b) == ecs_intern_result_id(c) { panic(97131); };
    if ecs_intern_result_id(a) != 1 { panic(97132); };
    if ecs_intern_result_id(b) != 2 { panic(97133); };
    if ecs_intern_result_id(c) != 3 { panic(97134); };
}

@test "intern_registry_same_type_id_after_others"() {
    let r = ecs_intern_registry_new();
    let a = ecs_intern_registry_intern(r, ecs_system_type_set_new(7));
    let unrelated = ecs_intern_registry_intern(r, ecs_system_type_set_new(8));
    let b = ecs_intern_registry_intern(r, ecs_system_type_set_new(7));
    if ecs_intern_result_found_flag(b) != true { panic(97140); };
    if ecs_intern_result_id(a) != ecs_intern_result_id(b) { panic(97141); };
}

@test "intern_registry_find_missing_returns_zero"() {
    let r = ecs_intern_registry_new();
    if ecs_intern_registry_find(r, ecs_system_type_set_new(1)) != 0 { panic(97150); };
}

@test "intern_registry_label_intern_separate_namespace"() {
    let r = ecs_intern_registry_new();
    let set = ecs_intern_registry_intern(r, ecs_system_type_set_new(1));
    let label = ecs_intern_registry_intern_label(r, ecs_schedule_label_identity_new(1));
    // A label and system set with the same numeric id must intern to distinct ids.
    if ecs_intern_result_id(set) == ecs_intern_result_id(label) { panic(97160); };
    if ecs_intern_result_created_flag(label) != true { panic(97161); };
    // Same label reused returns the same id and found=true on the second call.
    let label2 = ecs_intern_registry_intern_label(r, ecs_schedule_label_identity_new(1));
    if ecs_intern_result_id(label) != ecs_intern_result_id(label2) { panic(97162); };
    if ecs_intern_result_found_flag(label2) != true { panic(97163); };
}

@test "schedule_label_identity_eq_and_hash"() {
    let a = ecs_schedule_label_identity_new(11);
    let b = ecs_schedule_label_identity_new(11);
    let c = ecs_schedule_label_identity_new(12);
    if ecs_schedule_label_identity_eq(a, b) != true { panic(97170); };
    if ecs_schedule_label_identity_eq(a, c) != false { panic(97171); };
    if ecs_schedule_label_identity_hash(a) != 11 { panic(97172); };
}

@test "into_system_set_from_system_set"() {
    let identity = ecs_system_set_identity_base(5);
    let input = ecs_into_system_set_input_from_system_set(identity);
    let out = ecs_into_system_set(input);
    // SystemSet impl: returns self unchanged.
    if ecs_system_set_identity_is_base(out) != true { panic(97180); };
    if ecs_system_set_identity_label_id(out) != 5 { panic(97181); };
}

@test "into_system_set_from_function_system_returns_system_type_set"() {
    let input = ecs_into_system_set_input_from_function_system(30);
    let out = ecs_into_system_set(input);
    // function-system impl returns SystemTypeSet::<F>::new() with same TypeId.
    if ecs_system_set_identity_is_system_type(out) != true { panic(97190); };
    if ecs_system_set_identity_type_id(out) != 30 { panic(97191); };
    let oi = ecs_system_set_trait_system_type(out);
    if ecs_option_type_id_value(oi) != 30 { panic(97192); };
}

@test "into_system_set_from_exclusive_system_returns_system_type_set"() {
    let input = ecs_into_system_set_input_from_exclusive_system(77);
    let out = ecs_into_system_set(input);
    if ecs_system_set_identity_is_system_type(out) != true { panic(97200); };
    if ecs_system_set_identity_type_id(out) != 77 { panic(97201); };
}

@test "into_system_set_function_and_exclusive_share_type_id"() {
    // Both function-system and exclusive-system paths targeting the same F type id
    // produce identical SystemTypeSet identities (matching Bevy `type Set = SystemTypeSet<F>`).
    let f = ecs_into_system_set(ecs_into_system_set_input_from_function_system(5));
    let e = ecs_into_system_set(ecs_into_system_set_input_from_exclusive_system(5));
    if ecs_system_set_identity_type_id(f) != ecs_system_set_identity_type_id(e) { panic(97210); };
    if ecs_system_set_identity_kind(f) != ecs_system_set_identity_kind(e) { panic(97211); };
}

@test "trait_base_is_none_for_all_built_in_sets"() {
    if ecs_system_set_trait_base_is_some(ecs_system_type_set_new(1)) != false { panic(97220); };
    if ecs_system_set_trait_base_is_none(ecs_system_type_set_new(1)) != true { panic(97221); };
    if ecs_system_set_trait_base_is_some(ecs_system_set_identity_anonymous(2)) != false { panic(97222); };
    if ecs_system_set_trait_base_is_none(ecs_system_set_identity_anonymous(2)) != true { panic(97223); };
    if ecs_system_set_trait_base_is_some(ecs_system_set_identity_base(3)) != false { panic(97224); };
}

@test "dyn_clone_preserves_identity"() {
    let s = ecs_system_set_identity_base(13);
    let c = ecs_system_set_trait_dyn_clone(s);
    if ecs_system_set_identity_kind(s) != ecs_system_set_identity_kind(c) { panic(97230); };
    if ecs_system_set_identity_label_id(s) != ecs_system_set_identity_label_id(c) { panic(97231); };
}

@test "interned_system_set_eq_and_hash"() {
    if ecs_interned_system_set_eq(4, 4) != true { panic(97240); };
    if ecs_interned_system_set_eq(4, 5) != false { panic(97241); };
    if ecs_interned_system_set_hash(9) != 9 { panic(97242); };
}
