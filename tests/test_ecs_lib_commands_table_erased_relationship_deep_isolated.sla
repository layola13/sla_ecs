// Isolated deep tests for lib/commands_table_erased_relationship_deep.sla (Batch 367).
// Kind-discriminated ordered deferred command queue for TableErasedRelationshipWorld (11 kinds).
// panic codes: 139400 - 139599.

@import "lib/commands_table_erased_relationship_deep.sla"

const TYPE_POS: i32 = 311;
const TYPE_VEL: i32 = 312;
const RK_HIERARCHY: i32 = 41;

@test "TblRelCommands new empty and side counts zero"() {
    let c = ecs_tbl_rel_commands_new();
    if ecs_tbl_rel_commands_len(c) != 0 { panic(139400); };
    if ecs_tbl_rel_commands_pcomp_count(c) != 0 { panic(139401); };
    if ecs_tbl_rel_commands_pres_count(c) != 0 { panic(139402); };
    if ecs_tbl_rel_commands_pmsg_count(c) != 0 { panic(139403); };
    if ecs_tbl_rel_commands_lcount(c) != 0 { panic(139404); };
    if ecs_tbl_rel_commands_kind_at(c, 0) != 0 { panic(139405); };
    if ecs_tbl_rel_commands_rl_at(c, 0) != -1 { panic(139406); };
    if ecs_tbl_rel_commands_ur_at(c, 0) != -1 { panic(139407); };
    if ecs_tbl_rel_commands_nw_at(c, 0) != -1 { panic(139408); };
}

@test "insert enqueues INSERT_COMPONENT and set_related stores relationship_kind/target"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_insert(c0, 7, 11, TYPE_POS, 50);
    if ecs_tbl_rel_commands_len(c1) != 1 { panic(139410); };
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_INSERT_COMPONENT { panic(139411); };
    if ecs_tbl_rel_commands_entity_at(c1, 0) != 7 { panic(139412); };
    if ecs_tbl_rel_commands_cmp_at(c1, 0) != 11 { panic(139413); };
    if ecs_tbl_rel_commands_resolve_value(c1, 0) != 50 { panic(139414); };
    if ecs_tbl_rel_commands_resolve_type(c1, 0) != TYPE_POS { panic(139415); };
    let c2 = ecs_tbl_rel_commands_set_related(c1, RK_HIERARCHY, 7, 14);
    if ecs_tbl_rel_commands_kind_at(c2, 1) != ECS_CMD_TBL_REL_SET_RELATED { panic(139416); };
    if ecs_tbl_rel_commands_rk_at(c2, 1) != RK_HIERARCHY { panic(139417); };
    if ecs_tbl_rel_commands_target_at(c2, 1) != 14 { panic(139418); };
    if ecs_tbl_rel_commands_entity_at(c2, 1) != 7 { panic(139419); };
}

@test "set_related_at stores the index slot and despawn carries no payload"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_set_related_at(c0, RK_HIERARCHY, 7, 14, 3);
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_SET_RELATED_AT { panic(139420); };
    if ecs_tbl_rel_commands_idx_at(c1, 0) != 3 { panic(139421); };
    let c2 = ecs_tbl_rel_commands_despawn(c1, 7);
    if ecs_tbl_rel_commands_kind_at(c2, 1) != ECS_CMD_TBL_REL_DESPAWN { panic(139422); };
    if ecs_tbl_rel_commands_entity_at(c2, 1) != 7 { panic(139423); };
    if ecs_tbl_rel_commands_idx_at(c2, 1) != -1 { panic(139424); };
}

@test "insert_resource and write_message enqueue side payload and resolve"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_insert_resource(c0, 888);
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_INSERT_RESOURCE { panic(139430); };
    if ecs_tbl_rel_commands_pres_count(c1) != 1 { panic(139431); };
    if ecs_tbl_rel_commands_resolve_value(c1, 0) != 888 { panic(139432); };
    let c2 = ecs_tbl_rel_commands_write_message(c1, 42);
    if ecs_tbl_rel_commands_kind_at(c2, 1) != ECS_CMD_TBL_REL_WRITE_MESSAGE { panic(139433); };
    if ecs_tbl_rel_commands_pmsg_count(c2) != 1 { panic(139434); };
    if ecs_tbl_rel_commands_resolve_value(c2, 1) != 42 { panic(139435); };
}

@test "remove_related stores entity-list side and indexes via related_index"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_remove_related(c0, RK_HIERARCHY, 14, 21, 22, 23, 24, 4);
    if ecs_tbl_rel_commands_len(c1) != 1 { panic(139440); };
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_REMOVE_RELATED { panic(139441); };
    if ecs_tbl_rel_commands_target_at(c1, 0) != 14 { panic(139442); };
    if ecs_tbl_rel_commands_rk_at(c1, 0) != RK_HIERARCHY { panic(139443); };
    if ecs_tbl_rel_commands_rl_at(c1, 0) != 0 { panic(139444); };
    if ecs_tbl_rel_commands_ur_at(c1, 0) != -1 { panic(139445); };
    if ecs_tbl_rel_commands_nw_at(c1, 0) != -1 { panic(139446); };
    if ecs_tbl_rel_commands_lcount(c1) != 1 { panic(139447); };
    if ecs_tbl_rel_commands_list_count_at(c1, 0) != 4 { panic(139448); };
    let e0 = ecs_tbl_rel_commands_list_at(c1, 0, 0);
    if ecs_tbl_rel_list_entry_entity(e0) != 21 { panic(139449); };
    let e3 = ecs_tbl_rel_commands_list_at(c1, 0, 3);
    if ecs_tbl_rel_list_entry_entity(e3) != 24 { panic(139450); };
}

@test "detach_all and replace_related carry the right kind and list index sema"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_detach_all_related(c0, RK_HIERARCHY, 14);
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_DETACH_ALL_RELATED { panic(139460); };
    if ecs_tbl_rel_commands_target_at(c1, 0) != 14 { panic(139461); };
    if ecs_tbl_rel_commands_rl_at(c1, 0) != -1 { panic(139462); };
    let c2 = ecs_tbl_rel_commands_replace_related(c1, RK_HIERARCHY, 14, 31, 32, 0, 0, 2);
    if ecs_tbl_rel_commands_kind_at(c2, 1) != ECS_CMD_TBL_REL_REPLACE_RELATED { panic(139463); };
    if ecs_tbl_rel_commands_rl_at(c2, 1) != 0 { panic(139464); };
    if ecs_tbl_rel_commands_list_count_at(c2, 0) != 2 { panic(139465); };
    let e1 = ecs_tbl_rel_commands_list_at(c2, 0, 1);
    if ecs_tbl_rel_list_entry_entity(e1) != 32 { panic(139466); };
}

@test "replace_related_with_difference consumes 3 shared list slots"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_replace_related_with_difference(c0, RK_HIERARCHY, 14,
        21, 22, 0, 0, 2, // unrelate: [21, 22]
        31, 32, 0, 0, 2, // relate: [31, 32]
        41, 42, 0, 0, 2  // newly: [41, 42]
    );
    if ecs_tbl_rel_commands_len(c1) != 1 { panic(139470); };
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_REPLACE_RELATED_WITH_DIFFERENCE { panic(139471); };
    if ecs_tbl_rel_commands_target_at(c1, 0) != 14 { panic(139472); };
    if ecs_tbl_rel_commands_rl_at(c1, 0) != 1 { panic(139473); };
    if ecs_tbl_rel_commands_ur_at(c1, 0) != 0 { panic(139474); };
    if ecs_tbl_rel_commands_nw_at(c1, 0) != 2 { panic(139475); };
    if ecs_tbl_rel_commands_lcount(c1) != 3 { panic(139476); };
    // unrelate list (slot 0): [21, 22]
    if ecs_tbl_rel_list_entry_entity(ecs_tbl_rel_commands_list_at(c1, 0, 0)) != 21 { panic(139477); };
    if ecs_tbl_rel_list_entry_entity(ecs_tbl_rel_commands_list_at(c1, 0, 1)) != 22 { panic(139478); };
    // relate list (slot 1): [31, 32]
    if ecs_tbl_rel_list_entry_entity(ecs_tbl_rel_commands_list_at(c1, 1, 0)) != 31 { panic(139479); };
    // newly list (slot 2): [41, 42]
    if ecs_tbl_rel_list_entry_entity(ecs_tbl_rel_commands_list_at(c1, 2, 1)) != 42 { panic(139480); };
}

@test "despawn_related queues DESPAWN_RELATED with no list index"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_despawn_related(c0, RK_HIERARCHY, 14);
    if ecs_tbl_rel_commands_kind_at(c1, 0) != ECS_CMD_TBL_REL_DESPAWN_RELATED { panic(139490); };
    if ecs_tbl_rel_commands_target_at(c1, 0) != 14 { panic(139491); };
    if ecs_tbl_rel_commands_rk_at(c1, 0) != RK_HIERARCHY { panic(139492); };
    if ecs_tbl_rel_commands_rl_at(c1, 0) != -1 { panic(139493); };
    if ecs_tbl_rel_commands_lcount(c1) != 0 { panic(139494); };
}

@test "count_by_kind categorizes mixed queue across 11 kinds"() {
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = ecs_tbl_rel_commands_insert(c0, 1, 10, TYPE_POS, 1);
    let c2 = ecs_tbl_rel_commands_set_related(c1, RK_HIERARCHY, 1, 2);
    let c3 = ecs_tbl_rel_commands_despawn(c2, 3);
    let c4 = ecs_tbl_rel_commands_insert_resource(c3, 9);
    let c5 = ecs_tbl_rel_commands_write_message(c4, 3);
    let c6 = ecs_tbl_rel_commands_set_related_at(c5, RK_HIERARCHY, 1, 2, 0);
    let c7 = ecs_tbl_rel_commands_remove_related(c6, RK_HIERARCHY, 2, 8, 0, 0, 0, 1);
    // Queue cap is 8: exactly 8 commands fit (c1..c8). Two remove_related calls share the
    // cap-4 entity-list side storage (each consumes 1 list slot -> 2 of 4 used). The DID
    // (3-list consumer) and DESPAWN_RELATED run in a separate queue below to stay under cap-8.
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_INSERT_COMPONENT) != 1 { panic(139500); };
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_SET_RELATED) != 1 { panic(139501); };
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_DESPAWN) != 1 { panic(139502); };
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_INSERT_RESOURCE) != 1 { panic(139503); };
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_WRITE_MESSAGE) != 1 { panic(139504); };
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_SET_RELATED_AT) != 1 { panic(139505); };
    if ecs_tbl_rel_commands_count_by_kind(c7, ECS_CMD_TBL_REL_REMOVE_RELATED) != 1 { panic(139506); };
    // The 8th command is a second remove_related against a different target.
    let c8 = ecs_tbl_rel_commands_remove_related(c7, RK_HIERARCHY, 5, 6, 0, 0, 0, 1);
    if ecs_tbl_rel_commands_count_by_kind(c8, ECS_CMD_TBL_REL_REMOVE_RELATED) != 2 { panic(139507); };
    // A 9th command (detach_all_related) is rejected by the cap-8 queue guard.
    let c9 = ecs_tbl_rel_commands_detach_all_related(c8, RK_HIERARCHY, 5);
    if ecs_tbl_rel_commands_count_by_kind(c9, ECS_CMD_TBL_REL_DETACH_ALL_RELATED) != 0 { panic(139508); };
    // 8 commands queued: insert + set_related + despawn + insert_resource + write_message +
    // set_related_at + remove_related + remove_related = 8.
    if ecs_tbl_rel_commands_len(c9) != 8 { panic(139509); };
    // Separate queue: DID (consumes 3 list slots) and DESPAWN_RELATED - both fit cap-8.
    let d0 = ecs_tbl_rel_commands_new();
    let d1 = ecs_tbl_rel_commands_replace_related_with_difference(d0, RK_HIERARCHY, 5, 1, 2, 0, 0, 2, 3, 4, 0, 0, 2, 5, 6, 0, 0, 2);
    if ecs_tbl_rel_commands_count_by_kind(d1, ECS_CMD_TBL_REL_REPLACE_RELATED_WITH_DIFFERENCE) != 1 { panic(139510); };
    let d2 = ecs_tbl_rel_commands_despawn_related(d1, RK_HIERARCHY, 5);
    if ecs_tbl_rel_commands_count_by_kind(d2, ECS_CMD_TBL_REL_DESPAWN_RELATED) != 1 { panic(139511); };
    if ecs_tbl_rel_commands_len(d2) != 2 { panic(139512); };
}

@test "queue cap-8 rejection, list cap-4 rejection, and clear resets all"() {
    // Queue cap-8: 8 inserts fit, 9th rejected. Entity-list side cap-4: 4 replace_related
    // fit (each consumes 1 list slot), the 5th is rejected.
    let c0 = ecs_tbl_rel_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_tbl_rel_commands_insert(c1, i, i, TYPE_POS, 100 + i);
        i = i + 1;
    }
    if ecs_tbl_rel_commands_len(c1) != 8 { panic(139520); };
    if ecs_tbl_rel_commands_pcomp_count(c1) != 8 { panic(139521); };
    let c2 = ecs_tbl_rel_commands_insert(c1, 99, 99, 999, 999);
    if ecs_tbl_rel_commands_len(c2) != 8 { panic(139522); };
    // List side cap-4: first four replace_related fit, fifth is rejected.
    let c3 = ecs_tbl_rel_commands_new();
    let c4 = ecs_tbl_rel_commands_replace_related(c3, RK_HIERARCHY, 5, 1, 0, 0, 0, 1);
    let c5 = ecs_tbl_rel_commands_replace_related(c4, RK_HIERARCHY, 6, 2, 3, 0, 0, 2);
    let c6 = ecs_tbl_rel_commands_replace_related(c5, RK_HIERARCHY, 7, 4, 0, 0, 0, 1);
    let c7 = ecs_tbl_rel_commands_replace_related(c6, RK_HIERARCHY, 8, 5, 6, 0, 0, 2);
    let c8 = ecs_tbl_rel_commands_replace_related(c7, RK_HIERARCHY, 9, 7, 0, 0, 0, 1);
    if ecs_tbl_rel_commands_lcount(c8) != 4 { panic(139523); };
    if ecs_tbl_rel_commands_len(c8) != 4 { panic(139524); };
    let c9 = ecs_tbl_rel_commands_clear(c8);
    if ecs_tbl_rel_commands_len(c9) != 0 { panic(139525); };
    if ecs_tbl_rel_commands_pcomp_count(c9) != 0 { panic(139526); };
    if ecs_tbl_rel_commands_pres_count(c9) != 0 { panic(139527); };
    if ecs_tbl_rel_commands_pmsg_count(c9) != 0 { panic(139528); };
    if ecs_tbl_rel_commands_lcount(c9) != 0 { panic(139529); };
}
