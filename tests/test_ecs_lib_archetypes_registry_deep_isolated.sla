@import "lib/archetypes_registry_deep.sla"

// Batch 347: archetypes_registry deep.
// panic codes: 135400 – 135599.

@test "new_generation_len"() {
    let a = ecs_arch_deep_new();
    if ecs_arch_deep_len(a) != 1 { panic(135400); };
    if ecs_arch_deep_generation(a) != 0 { panic(135401); };
    if ecs_arch_deep_empty_id() != 0 { panic(135402); };
}

@test "records"() {
    let t = ecs_arrec_table(3);
    if ecs_arrec_has_column(t) != true { panic(135410); };
    if ecs_arrec_column(t) != 3 { panic(135411); };
    let s = ecs_arrec_sparse();
    if ecs_arrec_has_column(s) != false { panic(135412); };
    if ecs_arrec_column(s) != -1 { panic(135413); };
}

@test "get"() {
    let a = ecs_arch_deep_new();
    let g0 = ecs_arch_deep_get(a, 0);
    if ecs_arch_get_found(g0) != true { panic(135420); };
    let gm = ecs_arch_deep_get(a, 99);
    if ecs_arch_get_found(gm) != false { panic(135421); };
    let gn = ecs_arch_deep_get(a, -1);
    if ecs_arch_get_found(gn) != false { panic(135422); };
}

@test "spawn"() {
    let a = ecs_arch_deep_new();
    let s1 = ecs_arch_deep_spawn(a);
    if ecs_arch_spawn_id(s1) != 1 { panic(135430); };
    let a1 = ecs_arch_spawn_archetypes(s1);
    if ecs_arch_deep_len(a1) != 2 { panic(135431); };
    if ecs_arch_deep_generation(a1) != 1 { panic(135432); };
    if ecs_arch_get_id(ecs_arch_deep_get(a1, 1)) != 1 { panic(135433); };
}

@test "spawn_capacity_eight"() {
    let a = ecs_arch_deep_new();
    let i = 0;
    while i < 7 {
        a = ecs_arch_spawn_archetypes(ecs_arch_deep_spawn(a));
        i = i + 1;
    }
    if ecs_arch_deep_len(a) != 8 { panic(135440); };
    let overflow = ecs_arch_deep_spawn(a);
    if ecs_arch_spawn_id(overflow) != -1 { panic(135441); };
}

@test "clear_entities_generation"() {
    let a = ecs_arch_deep_new();
    a = ecs_arch_deep_clear_entities(a);
    if ecs_arch_deep_generation(a) != 1 { panic(135450); };
}

@test "iter_at"() {
    let a = ecs_arch_deep_new();
    a = ecs_arch_spawn_archetypes(ecs_arch_deep_spawn(a));
    if ecs_arch_deep_iter_at(a, 0) != 0 { panic(135460); };
    if ecs_arch_deep_iter_at(a, 1) != 1 { panic(135461); };
}

@test "component_index_register_for"() {
    let a = ecs_arch_deep_new();
    a = ecs_arch_deep_register_table(a, 10, 0, 0);
    a = ecs_arch_deep_register_sparse(a, 11, 0);
    if ecs_arch_deep_ci_count(a) != 2 { panic(135470); };
    let r = ecs_arch_deep_ci_for(a, 10, 0);
    if ecs_arch_cif_found(r) != true { panic(135471); };
    if ecs_arch_cif_has(r) != true { panic(135472); };
    if ecs_arch_cif_column(r) != 0 { panic(135473); };
    let s = ecs_arch_deep_ci_for(a, 11, 0);
    if ecs_arch_cif_has(s) != false { panic(135474); };
}

@test "ci_for_miss"() {
    let a = ecs_arch_deep_new();
    a = ecs_arch_deep_register_table(a, 10, 0, 0);
    let miss = ecs_arch_deep_ci_for(a, 99, 0);
    if ecs_arch_cif_found(miss) != false { panic(135480); };
}

@test "ci_archetypes_with"() {
    let a = ecs_arch_deep_new();
    a = ecs_arch_deep_register_table(a, 7, 1, 0);
    a = ecs_arch_deep_register_table(a, 7, 2, 1);
    a = ecs_arch_deep_register_sparse(a, 8, 3);
    let w = ecs_arch_deep_ci_archetypes_with(a, 7);
    if ecs_arch_ciw_count(w) != 2 { panic(135490); };
    if ecs_arch_ciw_first(w) != 1 { panic(135491); };
    let w2 = ecs_arch_deep_ci_archetypes_with(a, 8);
    if ecs_arch_ciw_count(w2) != 1 { panic(135492); };
}
