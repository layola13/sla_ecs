@import "lib/world_error_deep.sla"

// Batch 252: world_error deep (src/world/error.rs).
// panic codes: 116400 – 116599.

@test "entity_not_spawned_and_despawn"() {
    let ns = ecs_we_entity_not_spawned_new(42);
    if ecs_we_entity_not_spawned_entity(ns) != 42 { panic(116400); };
    if ecs_we_entity_not_spawned_code() != ECS_WE_ENTITY_NOT_SPAWNED { panic(116401); };
    let d = ecs_we_entity_despawn_from_not_spawned(ns);
    if ecs_we_entity_despawn_entity(d) != 42 { panic(116402); };
    let back = ecs_we_entity_despawn_as_not_spawned(d);
    if ecs_we_entity_not_spawned_entity(back) != 42 { panic(116403); };
}

@test "try_run_schedule_error"() {
    let e = ecs_we_try_run_schedule_new(7);
    if ecs_we_try_run_schedule_label(e) != 7 { panic(116410); };
}

@test "try_insert_batch_collects_entities"() {
    let e = ecs_we_try_insert_batch_new(3);
    if ecs_we_try_insert_batch_is_empty(e) != true { panic(116420); };
    e = ecs_we_try_insert_batch_push(e, 10);
    e = ecs_we_try_insert_batch_push(e, 11);
    e = ecs_we_try_insert_batch_push(e, 12);
    if ecs_we_try_insert_batch_len(e) != 3 { panic(116421); };
    if ecs_we_try_insert_batch_bundle_type(e) != 3 { panic(116422); };
    if ecs_we_try_insert_batch_entity_at(e, 0) != 10 { panic(116423); };
    if ecs_we_try_insert_batch_entity_at(e, 2) != 12 { panic(116424); };
}

@test "entity_component_error_variants"() {
    let m = ecs_we_entity_component_missing(5);
    let a = ecs_we_entity_component_aliased(5);
    if ecs_we_entity_component_is_missing(m) != true { panic(116430); };
    if ecs_we_entity_component_is_aliased(a) != true { panic(116431); };
    if ecs_we_entity_component_id(m) != 5 { panic(116432); };
    if ecs_we_entity_component_eq(m, a) != false { panic(116433); };
    let m2 = ecs_we_entity_component_missing(5);
    if ecs_we_entity_component_eq(m, m2) != true { panic(116434); };
}

@test "entity_mutable_fetch_error"() {
    let ns = ecs_we_entity_mutable_not_spawned(9);
    let al = ecs_we_entity_mutable_aliased(9);
    if ecs_we_entity_mutable_is_not_spawned(ns) != true { panic(116440); };
    if ecs_we_entity_mutable_is_aliased(al) != true { panic(116441); };
    if ecs_we_entity_mutable_entity(ns) != 9 { panic(116442); };
    if ecs_we_entity_mutable_eq(ns, al) != false { panic(116443); };
    let from = ecs_we_entity_mutable_from_not_spawned(ecs_we_entity_not_spawned_new(9));
    if ecs_we_entity_mutable_eq(ns, from) != true { panic(116444); };
}

@test "resource_fetch_error_variants"() {
    let nr = ecs_we_resource_not_registered();
    let dne = ecs_we_resource_does_not_exist(4);
    let na = ecs_we_resource_no_access(4);
    let im = ecs_we_resource_immutable(4);
    if ecs_we_resource_is_not_registered(nr) != true { panic(116450); };
    if ecs_we_resource_is_does_not_exist(dne) != true { panic(116451); };
    if ecs_we_resource_is_no_access(na) != true { panic(116452); };
    if ecs_we_resource_is_immutable(im) != true { panic(116453); };
    if ecs_we_resource_component_id(dne) != 4 { panic(116454); };
    if ecs_we_resource_eq(dne, na) != false { panic(116455); };
}

@test "classify_entity_lookup"() {
    let bad = ecs_we_classify_entity_lookup(false, 3);
    let ok = ecs_we_classify_entity_lookup(true, 3);
    if ecs_we_entity_mutable_classify_is_ok(bad) != false { panic(116460); };
    if ecs_we_entity_mutable_is_not_spawned(bad) != true { panic(116461); };
    if ecs_we_entity_mutable_classify_is_ok(ok) != true { panic(116462); };
}

@test "classify_resource_mut_path"() {
    let a = ecs_we_classify_resource_mut(false, false, false, false, 1);
    if ecs_we_resource_is_not_registered(a) != true { panic(116470); };
    let b = ecs_we_classify_resource_mut(true, false, false, false, 2);
    if ecs_we_resource_is_does_not_exist(b) != true { panic(116471); };
    let c = ecs_we_classify_resource_mut(true, true, false, true, 3);
    if ecs_we_resource_is_no_access(c) != true { panic(116472); };
    let d = ecs_we_classify_resource_mut(true, true, true, false, 4);
    if ecs_we_resource_is_immutable(d) != true { panic(116473); };
    let e = ecs_we_classify_resource_mut(true, true, true, true, 5);
    if ecs_we_resource_classify_is_ok(e) != true { panic(116474); };
}

@test "try_insert_batch_capacity_four"() {
    let e = ecs_we_try_insert_batch_new(1);
    e = ecs_we_try_insert_batch_push(e, 1);
    e = ecs_we_try_insert_batch_push(e, 2);
    e = ecs_we_try_insert_batch_push(e, 3);
    e = ecs_we_try_insert_batch_push(e, 4);
    e = ecs_we_try_insert_batch_push(e, 5);
    if ecs_we_try_insert_batch_len(e) != 4 { panic(116480); };
    if ecs_we_try_insert_batch_entity_at(e, 3) != 4 { panic(116481); };
}

@test "despawn_new_direct"() {
    let d = ecs_we_entity_despawn_new(100);
    if ecs_we_entity_despawn_entity(d) != 100 { panic(116490); };
    let mf = ecs_we_entity_mutable_aliased(100);
    if ecs_we_entity_mutable_kind(mf) != ECS_WE_MUT_ALIASED { panic(116491); };
    if ecs_we_entity_component_kind(ecs_we_entity_component_missing(8)) != ECS_WE_COMP_MISSING { panic(116492); };
    if ecs_we_resource_kind(ecs_we_resource_no_access(8)) != ECS_WE_RES_NO_ACCESS { panic(116493); };
}
