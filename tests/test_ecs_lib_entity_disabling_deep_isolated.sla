@import "lib/entity_disabling_deep.sla"

// Batch 194: DefaultQueryFilters + Disabled deep.

@test "disabled_marker_id"() {
    let d = ecs_ed_deep_disabled_new();
    if ecs_ed_deep_disabled_component_id(d) != ECS_ED_DISABLED_ID { panic(104500); };
}

@test "empty_filters_no_disabling"() {
    let f = ecs_ed_dqf_empty();
    if ecs_ed_dqf_len(f) != 0 { panic(104510); };
    if ecs_ed_dqf_is_disabling(f, 0) != false { panic(104511); };
}

@test "from_world_registers_disabled"() {
    let f = ecs_ed_dqf_from_world();
    if ecs_ed_dqf_len(f) != 1 { panic(104520); };
    if ecs_ed_dqf_disabling_id_at(f, 0) != ECS_ED_DISABLED_ID { panic(104521); };
    if ecs_ed_dqf_is_disabling(f, ECS_ED_DISABLED_ID) != true { panic(104522); };
}

@test "register_idempotent"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    f = ecs_ed_dqf_register_disabling_component(f, 2);
    if ecs_ed_dqf_len(f) != 2 { panic(104530); };
    if ecs_ed_dqf_disabling_id_at(f, 0) != 1 { panic(104531); };
    if ecs_ed_dqf_disabling_id_at(f, 1) != 2 { panic(104532); };
}

@test "world_register_disabling_facade"() {
    let f = ecs_ed_dqf_from_world();
    f = ecs_ed_world_register_disabling(f, 5);
    if ecs_ed_dqf_is_disabling(f, 5) != true { panic(104540); };
    if ecs_ed_dqf_len(f) != 2 { panic(104541); };
}

@test "modify_access_adds_without_when_unmentioned"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_add_read(fa, 2);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, 1) != true { panic(104550); };
    if ecs_ed_fa_without_count(fa) != 1 { panic(104551); };
    if ecs_ed_fa_with_count(fa) != 0 { panic(104552); };
}

@test "modify_access_keeps_existing_with_filters"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_add_read(fa, 2);
    fa = ecs_ed_fa_and_with(fa, 4);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_with(fa, 4) != true { panic(104560); };
    if ecs_ed_fa_has_without(fa, 1) != true { panic(104561); };
}

@test "modify_access_skips_when_query_mentions_disabling"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_add_read(fa, 2);
    fa = ecs_ed_fa_and_with(fa, 4);
    fa = ecs_ed_fa_and_with(fa, 1); // query targets disabling component
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, 1) != false { panic(104570); };
    if ecs_ed_fa_has_with(fa, 1) != true { panic(104571); };
    if ecs_ed_fa_has_with(fa, 4) != true { panic(104572); };
}

@test "modify_access_skips_on_archetypal_has_or_allow"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_and_with(fa, 4);
    fa = ecs_ed_fa_allow(fa, 1);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, 1) != false { panic(104580); };
    if ecs_ed_fa_contains(fa, 1) != true { panic(104581); };
}

@test "is_dense_true_for_table_only"() {
    let f = ecs_ed_dqf_from_world();
    f = ecs_ed_dqf_set_storage(f, 0, ECS_ED_STORAGE_TABLE);
    if ecs_ed_dqf_is_dense(f) != true { panic(104590); };
}

@test "is_dense_false_if_any_sparse"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    f = ecs_ed_dqf_register_disabling_component(f, 2);
    f = ecs_ed_dqf_set_storage(f, 1, ECS_ED_STORAGE_TABLE);
    f = ecs_ed_dqf_set_storage(f, 2, ECS_ED_STORAGE_SPARSE);
    if ecs_ed_dqf_is_dense(f) != false { panic(104600); };
}

@test "query_filters_disabled_entities"() {
    // Dummy=3, Disabled=0, CustomDisabled=1
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 0);
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    // powers-of-two style counts from Bevy test:
    // 1 plain Dummy, 2 Dummy+Disabled, 4 Dummy+Custom, 8 Dummy+both
    f = ecs_ed_dqf_spawn(f, 0, ecs_ed_deep_mask3(3, -1, -1));
    f = ecs_ed_dqf_spawn(f, 1, ecs_ed_deep_mask3(3, 0, -1));
    f = ecs_ed_dqf_spawn(f, 2, ecs_ed_deep_mask3(3, 0, -1));
    f = ecs_ed_dqf_spawn(f, 3, ecs_ed_deep_mask3(3, 1, -1));
    f = ecs_ed_dqf_spawn(f, 4, ecs_ed_deep_mask3(3, 1, -1));
    f = ecs_ed_dqf_spawn(f, 5, ecs_ed_deep_mask3(3, 1, -1));
    f = ecs_ed_dqf_spawn(f, 6, ecs_ed_deep_mask3(3, 1, -1));
    // only 7 slots used for plain+disabled+custom; skip full 8 duals for capacity
    // plain query mentions only Dummy(3)
    let plain = ecs_ed_deep_mask3(3, -1, -1);
    if ecs_ed_dqf_query_count(f, plain) != 1 { panic(104610); };
}

@test "query_with_disabled_sees_disabled_only"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 0);
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    f = ecs_ed_dqf_spawn(f, 0, ecs_ed_deep_mask3(3, -1, -1));
    f = ecs_ed_dqf_spawn(f, 1, ecs_ed_deep_mask3(3, 0, -1));
    f = ecs_ed_dqf_spawn(f, 2, ecs_ed_deep_mask3(3, 1, -1));
    f = ecs_ed_dqf_spawn(f, 3, ecs_ed_deep_mask3(3, 0, 1));
    // With<Disabled>: mention Dummy+Disabled and require Disabled present
    let mention = ecs_ed_deep_mask3(3, 0, -1);
    let req = ecs_ed_deep_mask3(0, -1, -1);
    // entity1 has Disabled only; entity3 also has CustomDisabled unmentioned => filtered
    if ecs_ed_dqf_query_count_ex(f, mention, req) != 1 { panic(104620); };
    if ecs_ed_dqf_entity_matches_query_ex(f, 1, mention, req) != true { panic(104621); };
    if ecs_ed_dqf_entity_matches_query_ex(f, 0, mention, req) != false { panic(104622); };
    if ecs_ed_dqf_entity_matches_query_ex(f, 3, mention, req) != false { panic(104623); };
}

@test "query_must_mention_all_disabling_on_entity"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 0);
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    f = ecs_ed_dqf_spawn(f, 0, ecs_ed_deep_mask3(3, 0, 1));
    let both = ecs_ed_deep_mask3(3, 0, 1);
    if ecs_ed_dqf_entity_matches_query(f, 0, both) != true { panic(104630); };
    let one = ecs_ed_deep_mask3(3, 0, -1);
    if ecs_ed_dqf_entity_matches_query(f, 0, one) != false { panic(104631); };
}

@test "allow_mentions_without_requiring"() {
    let f = ecs_ed_dqf_from_world();
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_add_read(fa, 9);
    fa = ecs_ed_fa_allow(fa, ECS_ED_DISABLED_ID);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, ECS_ED_DISABLED_ID) != false { panic(104640); };
}

@test "resource_scope_clears_filters_temporarily"() {
    let f = ecs_ed_dqf_from_world();
    f = ecs_ed_dqf_spawn(f, 0, ecs_ed_deep_mask3(0, -1, -1));
    // with filters, plain empty mention should exclude disabled entity
    if ecs_ed_dqf_query_count(f, 0) != 0 { panic(104650); };
    let scope = ecs_ed_dqf_resource_scope_empty(f);
    let empty = scope.0;
    // scoped empty sees entity
    empty.e0 = f.e0;
    empty.occupied = f.occupied;
    if ecs_ed_dqf_query_count(empty, 0) != 1 { panic(104651); };
    // original still has filters
    if ecs_ed_dqf_len(scope.1) != 1 { panic(104652); };
}

@test "overwrite_filters_escape_hatch"() {
    let f = ecs_ed_dqf_from_world();
    f = ecs_ed_dqf_spawn(f, 1, ecs_ed_deep_mask3(0, -1, -1));
    let empty = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_overwrite(f, empty);
    if ecs_ed_dqf_len(f) != 0 { panic(104660); };
    if ecs_ed_dqf_entity_occupied(f, 1) != true { panic(104661); };
    if ecs_ed_dqf_query_count(f, 0) != 1 { panic(104662); };
}

@test "has_data_also_suppresses_without"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 7);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_has_data(fa, 7);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, 7) != false { panic(104670); };
}

@test "multiple_disabling_ids_iteration"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 3);
    f = ecs_ed_dqf_register_disabling_component(f, 5);
    f = ecs_ed_dqf_register_disabling_component(f, 8);
    if ecs_ed_dqf_disabling_ids_count(f) != 3 { panic(104680); };
    if ecs_ed_dqf_disabling_id_at(f, 2) != 8 { panic(104681); };
}

@test "modify_access_multi_disabling"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 1);
    f = ecs_ed_dqf_register_disabling_component(f, 2);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_add_read(fa, 9);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, 1) != true { panic(104690); };
    if ecs_ed_fa_has_without(fa, 2) != true { panic(104691); };
    if ecs_ed_fa_without_count(fa) != 2 { panic(104692); };
}

@test "lifecycle_bootstrap_register_query"() {
    let f = ecs_ed_dqf_from_world();
    f = ecs_ed_world_register_disabling(f, 4);
    f = ecs_ed_dqf_spawn(f, 0, ecs_ed_deep_mask3(9, -1, -1));
    f = ecs_ed_dqf_spawn(f, 1, ecs_ed_deep_mask3(9, 0, -1));
    f = ecs_ed_dqf_spawn(f, 2, ecs_ed_deep_mask3(9, 4, -1));
    let plain = ecs_ed_deep_mask3(9, -1, -1);
    if ecs_ed_dqf_query_count(f, plain) != 1 { panic(104700); };
    let with_disabled_mention = ecs_ed_deep_mask3(9, 0, -1);
    let with_disabled_req = ecs_ed_deep_mask3(0, -1, -1);
    if ecs_ed_dqf_query_count_ex(f, with_disabled_mention, with_disabled_req) != 1 { panic(104701); };
    let with_custom_mention = ecs_ed_deep_mask3(9, 4, -1);
    let with_custom_req = ecs_ed_deep_mask3(4, -1, -1);
    if ecs_ed_dqf_query_count_ex(f, with_custom_mention, with_custom_req) != 1 { panic(104702); };
}

@test "empty_is_dense"() {
    let f = ecs_ed_dqf_empty();
    if ecs_ed_dqf_is_dense(f) != true { panic(104710); };
}

@test "fa_add_write_counts_as_contains"() {
    let f = ecs_ed_dqf_empty();
    f = ecs_ed_dqf_register_disabling_component(f, 2);
    let fa = ecs_ed_fa_new();
    fa = ecs_ed_fa_add_write(fa, 2);
    fa = ecs_ed_dqf_modify_access(f, fa);
    if ecs_ed_fa_has_without(fa, 2) != false { panic(104720); };
}
