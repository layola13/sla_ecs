@import "lib/caller_location_deep.sla"

// Batch 298: caller_location deep.
// panic codes: 125600 – 125799.

@test "none_and_invalid"() {
    let n = ecs_cl_none();
    if ecs_cl_has(n) != false { panic(125600); };
    if ecs_cl_id(n) != 0 { panic(125601); };
    if ecs_cl_has(ecs_cl_new(0, 1, 1)) != false { panic(125602); };
    if ecs_cl_has(ecs_cl_new(1, 0, 1)) != false { panic(125603); };
    if ecs_cl_has(ecs_cl_new(1, 1, 0)) != false { panic(125604); };
}

@test "new_stores_triple_and_id"() {
    let l = ecs_cl_new(7, 120, 9);
    if ecs_cl_is_some(l) != true { panic(125610); };
    if ecs_cl_file(l) != 7 { panic(125611); };
    if ecs_cl_line(l) != 120 { panic(125612); };
    if ecs_cl_column(l) != 9 { panic(125613); };
    if ecs_cl_id(l) != ecs_cl_stable_id(7, 120, 9) { panic(125614); };
}

@test "same_and_eq_id"() {
    let a = ecs_cl_new(9, 44, 5);
    let b = ecs_cl_new(9, 44, 5);
    let c = ecs_cl_new(9, 44, 6);
    if ecs_cl_same(a, b) != true { panic(125620); };
    if ecs_cl_eq_id(a, b) != true { panic(125621); };
    if ecs_cl_same(a, c) != false { panic(125622); };
    if ecs_cl_same(ecs_cl_none(), ecs_cl_none()) != true { panic(125623); };
}

@test "registry_insert"() {
    let r = ecs_cl_reg_new();
    let res = ecs_cl_reg_register(r, ecs_cl_new(12, 30, 4));
    if ecs_cl_res_inserted(res) != true { panic(125630); };
    if ecs_cl_res_duplicate(res) != false { panic(125631); };
    r = ecs_cl_res_registry(res);
    if ecs_cl_reg_len(r) != 1 { panic(125632); };
    if ecs_cl_res_location_id(res) <= 0 { panic(125633); };
}

@test "registry_dedup"() {
    let r = ecs_cl_reg_new();
    let first = ecs_cl_reg_register(r, ecs_cl_new(12, 30, 4));
    r = ecs_cl_res_registry(first);
    let second = ecs_cl_reg_register(r, ecs_cl_new(12, 30, 4));
    if ecs_cl_res_inserted(second) != false { panic(125640); };
    if ecs_cl_res_duplicate(second) != true { panic(125641); };
    if ecs_cl_res_existing_index(second) != 0 { panic(125642); };
    if ecs_cl_reg_len(ecs_cl_res_registry(second)) != 1 { panic(125643); };
}

@test "registry_find_at"() {
    let r = ecs_cl_reg_new();
    r = ecs_cl_res_registry(ecs_cl_reg_register(r, ecs_cl_new(1, 10, 2)));
    r = ecs_cl_res_registry(ecs_cl_reg_register(r, ecs_cl_new(2, 20, 3)));
    let idx = ecs_cl_reg_find(r, ecs_cl_new(2, 20, 3));
    if idx != 1 { panic(125650); };
    let found = ecs_cl_reg_at(r, idx);
    if ecs_cl_file(found) != 2 { panic(125651); };
    if ecs_cl_line(found) != 20 { panic(125652); };
}

@test "registry_ignores_none"() {
    let r = ecs_cl_reg_new();
    let res = ecs_cl_reg_register(r, ecs_cl_none());
    if ecs_cl_res_ignored_none(res) != true { panic(125660); };
    if ecs_cl_res_inserted(res) != false { panic(125661); };
    if ecs_cl_reg_len(ecs_cl_res_registry(res)) != 0 { panic(125662); };
}

@test "registry_multi_insert"() {
    let r = ecs_cl_reg_new();
    r = ecs_cl_res_registry(ecs_cl_reg_register(r, ecs_cl_new(1, 1, 1)));
    r = ecs_cl_res_registry(ecs_cl_reg_register(r, ecs_cl_new(2, 2, 2)));
    r = ecs_cl_res_registry(ecs_cl_reg_register(r, ecs_cl_new(3, 3, 3)));
    if ecs_cl_reg_len(r) != 3 { panic(125670); };
    if ecs_cl_reg_find(r, ecs_cl_new(3, 3, 3)) != 2 { panic(125671); };
}

@test "stable_id_formula"() {
    if ecs_cl_stable_id(1, 2, 3) != 1000000 + 2000 + 3 { panic(125680); };
}

@test "at_out_of_range"() {
    let r = ecs_cl_reg_new();
    if ecs_cl_has(ecs_cl_reg_at(r, 0)) != false { panic(125690); };
    r = ecs_cl_res_registry(ecs_cl_reg_register(r, ecs_cl_new(1, 1, 1)));
    if ecs_cl_has(ecs_cl_reg_at(r, 5)) != false { panic(125691); };
}
