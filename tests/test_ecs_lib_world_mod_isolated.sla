@test "world_entity_valid_get"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_spawn_empty(w);
    let e = ecs_world_mod_entity(r.0, r.1);
    if e.0 != true { panic(90290); };
    let me = ecs_world_mod_entity_valid(r.0, r.1);
    if me != true { panic(90291); };
    let inv = ecs_world_mod_entity_valid(r.0, 000);
    if inv != false { panic(90292); };
}

@test "world_add_schedule_and_run"() {
    let w = ecs_world_mod_new();
    let added = ecs_world_mod_add_schedule(w, 7, 100);
    if added.1 != true { panic(90293); };
    let dup = ecs_world_mod_add_schedule(added.0, 7, 100);
    if dup.1 != false { panic(90294); };
    if ecs_world_mod_schedule_count(dup.0) != 2 { panic(90295); };
    if ecs_world_mod_contains_schedule(dup.0, 7) != true { panic(90296); };
    let r = ecs_world_mod_run_schedule(dup.0, 7);
    if r.1 != true { panic(90297); };
    if r.2 != 100 { panic(90298); };
}

@test "world_try_run_missing_schedule"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_try_run_schedule(w, 99);
    if r.1 != false { panic(90299); };
    if r.2 != 0 { panic(90300); };
}

@test "world_remove_schedule"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_add_schedule(w, 1, 10).0;
    let rr = ecs_world_mod_remove_schedule(r, 1);
    if rr.1 != true { panic(90301); };
    if ecs_world_mod_contains_schedule(rr.0, 1) != false { panic(90302); };
    let miss = ecs_world_mod_remove_schedule(rr.0, 999);
    if miss.1 != false { panic(90303); };
}

@test "world_write_message"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_write_message(w, 55);
    if r.1 != true { panic(90304); };
    if r.2 != 55 { panic(90305); };
    let r2 = ecs_world_mod_write_message_default(w);
    if r2.1 != 0 { panic(90306); };
    let msgs = Vec::new();
    msgs.push(1);
    msgs.push(2);
    let r3 = ecs_world_mod_write_message_batch(w, msgs);
    if r3.1 != 2 { panic(90307); };
}

@test "world_clear_all"() {
    let w = ecs_world_mod_new();
    let w2 = ecs_world_mod_spawn_empty(w).0;
    let w3 = ecs_world_mod_register_resource(w2, 1).0;
    let w4 = ecs_world_mod_init_non_send(w3, 2).0;
    let cleared = ecs_world_mod_clear_all(w4);
    if ecs_world_mod_entity_count(cleared) != 0 { panic(90308); };
    if ecs_world_mod_resource_count(cleared) != 0 { panic(90309); };
    if ecs_world_mod_non_send_count(cleared) != 0 { panic(90310); };
}

@test "world_clear_entities"() {
    let w = ecs_world_mod_new();
