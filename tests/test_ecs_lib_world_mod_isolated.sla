@test "world_resource_scope"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_resource(w, 1).0;
    let rs = ecs_world_mod_resource_scope(r, 1);
    if rs.1 != true { panic(90323); };
    let miss = ecs_world_mod_try_resource_scope(r, 99);
    if miss.1 != false { panic(90324); };
}

@test "world_spawn_batch_iter"() {
    let it = ecs_spawn_batch_iter_new();
    if ecs_spawn_batch_iter_len(it) != 0 { panic(90325); };
    let it2 = ecs_spawn_batch_iter_push(it, 10);
    let it3 = ecs_spawn_batch_iter_push(it2, 20);
    let n = ecs_spawn_batch_iter_next(it3);
    if n.1 != true { panic(90326); };
    if n.2 != 10 { panic(90327); };
    let n2 = ecs_spawn_batch_iter_next(n.0);
    if n2.1 != true { panic(90328); };
    if n2.2 != 20 { panic(90329); };
    let n3 = ecs_spawn_batch_iter_next(n2.0);
    if n3.1 != false { panic(90330); };
}

@test "world_iter_resources"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_resource(w, 1).0;
    let r2 = ecs_world_mod_register_resource(r, 2).0;
    let ids = ecs_world_mod_iter_resources(r2);
    if (len(ids) as i64) != 2 { panic(90331); };
    if ids[0] != 1 { panic(90332); };
    let mut_r = ecs_world_mod_iter_resources_mut(r2);
    if (len(mut_r.1) as i64) != 2 { panic(90333); };
}

@test "world_get_resource_by_id"() {
