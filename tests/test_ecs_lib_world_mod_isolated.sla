@import "lib/world_mod.sla"

// Isolated tests for lib/world_mod.sla — World struct (src/world/mod.rs)
// 50 tests covering spawn/despawn/resource/non_send/schedule/clear ticks

@test "world_id"() {
    let id = ecs_world_id_new(7);
    if ecs_world_id_get(id) != 7 { panic(90209); };
    let a = ecs_world_id_new(1);
    let b = ecs_world_id_new(1);
    let c = ecs_world_id_new(2);
    if ecs_world_id_eq(a, b) != true { panic(90210); };
    if ecs_world_id_eq(a, c) != false { panic(90211); };
}

@test "entity_location"() {
    let l = ecs_entity_location_new(3, 4, 5);
    if ecs_entity_location_archetype(l) != 3 { panic(90212); };
    if ecs_entity_location_table(l) != 4 { panic(90213); };
    if ecs_entity_location_row(l) != 5 { panic(90214); };
}

@test "check_change_ticks"() {
    let c = ecs_check_change_ticks_new(99);
    if ecs_check_change_ticks_max_age(c) != 99 { panic(90215); };
    if ecs_check_change_ticks_checked(c) != false { panic(90216); };
    let c2 = ecs_check_change_ticks_set_checked(c);
    if ecs_check_change_ticks_checked(c2) != true { panic(90217); };
}

@test "world_new_counts"() {
    let w = ecs_world_mod_new();
    if ecs_world_mod_entity_count(w) != 0 { panic(90218); };
    if ecs_world_mod_components_count(w) != 0 { panic(90219); };
    if ecs_world_mod_resource_count(w) != 0 { panic(90220); };
    if ecs_world_mod_non_send_count(w) != 0 { panic(90221); };
    if ecs_world_mod_schedule_count(w) != 0 { panic(90222); };
    if ecs_world_mod_observer_count(w) != 0 { panic(90223); };
    if ecs_world_mod_read_change_tick(w) != 1 { panic(90224); };
    if ecs_world_mod_change_tick(w) != 1 { panic(90225); };
    if ecs_world_mod_last_change_tick(w) != 0 { panic(90226); };
    if ecs_world_mod_apply_final_deferred(w) != true { panic(90227); };
}

@test "world_set_apply_final_deferred"() {
    let w = ecs_world_mod_new();
    let w2 = ecs_world_mod_set_apply_final_deferred(w, false);
    if ecs_world_mod_apply_final_deferred(w2) != false { panic(90228); };
}

@test "world_spawn_empty"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_spawn_empty(w);
    if r.1 != 1 { panic(90229); };
    if ecs_world_mod_entity_count(r.0) != 1 { panic(90230); };
    let r2 = ecs_world_mod_spawn_empty(r.0);
    if r2.1 != 2 { panic(90231); };
    if ecs_world_mod_entity_count(r2.0) != 2 { panic(90232); };
    let ents = ecs_world_mod_entities(r2.0);
    if ents[0] != 1 { panic(90233); };
    if ents[1] != 2 { panic(90234); };
}

@test "world_spawn_at"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_spawn_at(w, 42);
    // spawn_at returns (world, entity, was_new)
    if r.1 != 42 { panic(90235); };
    if r.2 != true { panic(90236); };
    // spawn existing returns was_new = false
    let r2 = ecs_world_mod_spawn_at(r.0, 42);
    if r2.2 != false { panic(90237); };
}

@test "world_spawn_batch"() {
    let w = ecs_world_mod_new();
    let w2 = ecs_world_mod_spawn_batch_push(w, 10);
    let w3 = ecs_world_mod_spawn_batch_push(w2, 11);
    if ecs_world_mod_spawn_batch_len(w3) != 2 { panic(90238); };
    if ecs_world_mod_entity_count(w3) != 2 { panic(90239); };
}

@test "world_register_component"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_component(w, 100);
    if r.1 != 0 { panic(90240); };
    let rec = ecs_world_mod_register_component(r.0, 100);
    if rec.1 != 0 { panic(90241); };
    if ecs_world_mod_components_count(rec.0) != 1 { panic(90242); };
    let r3 = ecs_world_mod_register_component(rec.0, 200);
    if r3.1 != 1 { panic(90243); };
    if ecs_world_mod_component_id(r3.0, 200) != 1 { panic(90244); };
}

@test "world_resource_register_insert"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_resource(w, 5);
    if r.1 != 0 { panic(90245); };
    let r2 = ecs_world_mod_register_resource(r.0, 5);
    // duplicate registration returns existing id (semantics: ComponentId is unique per type)
    if r2.1 != 0 { panic(90246); };
    if ecs_world_mod_resource_count(r2.0) != 1 { panic(902461); };
    let inserted = ecs_world_mod_insert_resource(r2.0, 5, 42);
    if inserted.1 != true { panic(90247); };
    // insert_resource on already-existing is a no-op for count (recording updated)
    if ecs_world_mod_resource_count(inserted.0) != 1 { panic(90248); };
}

@test "world_contains_resource"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_init_resource(w, 3);
    if ecs_world_mod_contains_resource(r.0, 3) != true { panic(90249); };
    if ecs_world_mod_contains_resource(r.0, 99) != false { panic(90250); };
    if ecs_world_mod_contains_resource_by_id(r.0, 3) != true { panic(90251); };
}

@test "world_resource_change_ticks"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_init_resource(w, 7);
    let t = ecs_world_mod_get_resource_change_ticks(r.0, 7);
    if t.0 != true { panic(90252); };
    if t.1 != 1 { panic(90253); };
    let t2 = ecs_world_mod_get_resource_change_ticks(r.0, 99);
    if t2.0 != false { panic(90254); };
}

@test "world_resource_api"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_resource(w, 1);
    let g = ecs_world_mod_resource(r.0, 1);
    if g.0 != true { panic(90255); };
    let gr = ecs_world_mod_get_resource_ref(r.0, 1);
    if gr.0 != true { panic(90256); };
    let gm = ecs_world_mod_resource_mut(r.0, 1);
    if gm.1 != true { panic(90257); };
}

@test "world_get_resource_or_insert_with"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_get_resource_or_insert_with(w, 8, 88);
    if r.1 != true { panic(90258); };
    // second call should return existing without reporting newly inserted
    let r2 = ecs_world_mod_get_resource_or_insert_with(r.0, 8, 99);
    if r2.1 != false { panic(90259); };
}

@test "world_get_resource_or_init"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_get_resource_or_init(w, 9);
    if r.1 != true { panic(90260); };
    let r2 = ecs_world_mod_get_resource_or_init(r.0, 9);
    if r2.1 != false { panic(90261); };
}

@test "world_non_send_api"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_init_non_send(w, 11);
    if r.1 != 0 { panic(90262); };
    if ecs_world_mod_contains_non_send(r.0, 11) != true { panic(90263); };
    let ins = ecs_world_mod_insert_non_send(r.0, 11);
    if ins.1 != true { panic(90264); };
}

@test "world_remove_resource"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_resource(w, 2);
    let rr = ecs_world_mod_remove_resource(r.0, 2);
    if rr.1 != true { panic(90265); };
    let gone = ecs_world_mod_remove_resource(rr.0, 999);
    if gone.1 != false { panic(90266); };
}

@test "world_remove_non_send"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_init_non_send(w, 12).0;
    let rr = ecs_world_mod_remove_non_send_resource(r, 12);
    if rr.1 != true { panic(90267); };
    let gone = ecs_world_mod_remove_non_send_resource(rr.0, 12);
    if gone.1 != false { panic(90268); };
}

@test "world_despawn"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_spawn_empty(w);
    let d = ecs_world_mod_despawn(r.0, r.1);
    if d.1 != true { panic(90269); };
    if ecs_world_mod_entity_count(d.0) != 0 { panic(90270); };
    let d2 = ecs_world_mod_despawn(d.0, 999);
    if d2.1 != false { panic(90271); };
}

@test "world_despawn_no_free"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_spawn_empty(w);
    let dn = ecs_world_mod_despawn_no_free(r.0, r.1);
    if dn.1 != r.1 { panic(90272); };
    let dn2 = ecs_world_mod_despawn_no_free(dn.0, 999);
    if dn2.1 != -1 { panic(90273); };
}

@test "world_clear_trackers"() {
    let w = ecs_world_mod_new();
    let w2 = ecs_world_mod_spawn_empty(w).0;
    let w3 = ecs_world_mod_despawn(w2, 1).0;
    let w4 = ecs_world_mod_clear_trackers(w3);
    if ecs_world_mod_removed_entities_count(w4) != 0 { panic(90274); };
    if ecs_world_mod_last_clear(w4) != 1 { panic(90275); };
}

