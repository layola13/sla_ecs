@test "world_non_send_resource_getters"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_init_non_send(w, 4).0;
    if ecs_world_mod_non_send_resource(r, 4).0 != true { panic(90281); };
    if ecs_world_mod_non_send(r, 4).0 != true { panic(90282); };
    let mut_r = ecs_world_mod_non_send_resource_mut(r, 4);
    if mut_r.1 != true { panic(90283); };
    if ecs_world_mod_get_non_send_resource(r, 4).0 != true { panic(90284); };
}

@test "world_modify_resource"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_resource(w, 1).0;
    let mod_r = ecs_world_mod_modify_resource(r, 1, 5);
    if mod_r.1 != true { panic(90285); };
    if mod_r.2 != 5 { panic(90286); };
    let mod_miss = ecs_world_mod_modify_resource(r, 123, 5);
    if mod_miss.1 != false { panic(90287); };
}

@test "world_modify_component"() {
    let w = ecs_world_mod_new();
    let r = ecs_world_mod_register_component(w, 9).0;
    let mod_r = ecs_world_mod_modify_component(r, 9, 42);
    if mod_r.1 != true { panic(90288); };
    let mod_miss = ecs_world_mod_modify_component(r, 123, 5);
