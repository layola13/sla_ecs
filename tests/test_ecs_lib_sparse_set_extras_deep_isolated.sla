@import "lib/sparse_set_extras_deep.sla"

// Batch 314: sparse_set_extras deep.
// panic codes: 128800 – 128999.

@test "new_empty"() {
    let s = ecs_sse_deep_new(3);
    if ecs_sse_deep_is_empty(s) != true { panic(128800); };
    if ecs_sse_deep_drop_id(s) != 3 { panic(128801); };
}

@test "insert_get"() {
    let s = ecs_sse_deep_new(1);
    s = ecs_sse_deep_insert(s, 10, 100, 5, 9);
    if ecs_sse_deep_len(s) != 1 { panic(128810); };
    let g = ecs_sse_deep_get(s, 10);
    if ecs_sse_get_ok(g) != true { panic(128811); };
    if ecs_sse_get_value(g) != 100 { panic(128812); };
}

@test "contains_and_overwrite"() {
    let s = ecs_sse_deep_insert(ecs_sse_deep_new(0), 1, 10, 1, 1);
    s = ecs_sse_deep_insert(s, 1, 20, 2, 3);
    if ecs_sse_deep_len(s) != 1 { panic(128820); };
    if ecs_sse_get_value(ecs_sse_deep_get(s, 1)) != 20 { panic(128821); };
    let t = ecs_sse_deep_ticks(s, 1);
    if ecs_sse_ticks_changed(t) != 2 { panic(128822); };
    if ecs_sse_ticks_by(t) != 3 { panic(128823); };
}

@test "ticks_on_insert"() {
    let s = ecs_sse_deep_insert(ecs_sse_deep_new(0), 4, 40, 7, 8);
    let t = ecs_sse_deep_ticks(s, 4);
    if ecs_sse_ticks_ok(t) != true { panic(128830); };
    if ecs_sse_ticks_added(t) != 7 { panic(128831); };
    if ecs_sse_ticks_changed(t) != 7 { panic(128832); };
}

@test "remove"() {
    let s = ecs_sse_deep_new(0);
    s = ecs_sse_deep_insert(s, 1, 10, 1, 1);
    s = ecs_sse_deep_insert(s, 2, 20, 1, 1);
    s = ecs_sse_deep_remove(s, 1);
    if ecs_sse_deep_contains(s, 1) != false { panic(128840); };
    if ecs_sse_deep_contains(s, 2) != true { panic(128841); };
    if ecs_sse_deep_len(s) != 1 { panic(128842); };
}

@test "clear_preserves_drop"() {
    let s = ecs_sse_deep_insert(ecs_sse_deep_new(9), 1, 1, 1, 1);
    s = ecs_sse_deep_clear(s);
    if ecs_sse_deep_is_empty(s) != true { panic(128850); };
    if ecs_sse_deep_drop_id(s) != 9 { panic(128851); };
}

@test "capacity_and_multi"() {
    let s = ecs_sse_deep_new(0);
    s = ecs_sse_deep_insert(s, 1, 1, 1, 1);
    s = ecs_sse_deep_insert(s, 2, 2, 1, 1);
    s = ecs_sse_deep_insert(s, 3, 3, 1, 1);
    s = ecs_sse_deep_insert(s, 4, 4, 1, 1);
    if ecs_sse_deep_len(s) != 4 { panic(128860); };
    s = ecs_sse_deep_insert(s, 5, 5, 1, 1);
    if ecs_sse_deep_len(s) != 4 { panic(128861); };
}

@test "miss_get_ticks"() {
    let s = ecs_sse_deep_new(0);
    if ecs_sse_get_ok(ecs_sse_deep_get(s, 9)) != false { panic(128870); };
    if ecs_sse_ticks_ok(ecs_sse_deep_ticks(s, 9)) != false { panic(128871); };
}

@test "sparse_sets_register"() {
    let ss = ecs_sses_deep_new();
    ss = ecs_sses_deep_register(ss, 10, 100);
    ss = ecs_sses_deep_register(ss, 11, 110);
    if ecs_sses_deep_len(ss) != 2 { panic(128880); };
    if ecs_sses_deep_get_drop(ss, 10) != 100 { panic(128881); };
    if ecs_sses_deep_get_drop(ss, 12) != (0 - 1) { panic(128882); };
}

@test "sparse_sets_overwrite"() {
    let ss = ecs_sses_deep_register(ecs_sses_deep_new(), 1, 5);
    ss = ecs_sses_deep_register(ss, 1, 9);
    if ecs_sses_deep_len(ss) != 1 { panic(128890); };
    if ecs_sses_deep_get_drop(ss, 1) != 9 { panic(128891); };
}
