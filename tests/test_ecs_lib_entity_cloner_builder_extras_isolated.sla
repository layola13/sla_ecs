@import "lib/entity_cloner_builder_extras.sla"

// Isolated tests for lib/entity_cloner_builder_extras.sla — EntityClonerBuilder remaining pub surface:
// with_default_clone_fn + override_clone_behavior_with_id + remove_clone_behavior_override_with_id +
// without_required_components (scope) + without_required_by_components (scope).
// Bevy reference: src/entity/clone_entities.rs lines 817-1004 (gaps not in lib/entity_cloner.sla).

const COMP_A: i32 = 3501;
const COMP_B: i32 = 3502;
const COMP_C: i32 = 3503;
const FN_DEFAULT: i32 = 91;
const FN_OVERRIDE_A: i32 = 92;
const FN_OVERRIDE_A2: i32 = 93;
const FN_OVERRIDE_B: i32 = 94;

@test "extras_new_defaults"() {
    let b = ecs_cloner_builder_extras_new();
    if ecs_cloner_builder_extras_default_clone_fn(b) != 0 { panic(91801); };
    if ecs_cloner_builder_extras_override_count(b) != 0 { panic(91802); };
    if ecs_cloner_builder_extras_attach_required_components(b) != 1 { panic(91803); };
    if ecs_cloner_builder_extras_attach_required_by_components(b) != 1 { panic(91804); };
}

@test "extras_with_default_clone_fn"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_with_default_clone_fn(b0, FN_DEFAULT);
    if ecs_cloner_builder_extras_default_clone_fn(b1) != FN_DEFAULT { panic(91805); };
}

@test "extras_override_clone_behavior_with_id_inserts"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b0, COMP_A, FN_OVERRIDE_A);
    if ecs_cloner_builder_extras_override_count(b1) != 1 { panic(91806); };
    let o = ecs_cloner_builder_extras_overridden_at(b1, COMP_A);
    if ecs_clone_override_has(o) != 1 { panic(91807); };
    if ecs_clone_override_fn_id(o) != FN_OVERRIDE_A { panic(91808); };
}

@test "extras_override_clone_behavior_with_id_replaces_existing"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b0, COMP_A, FN_OVERRIDE_A);
    let b2 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b1, COMP_A, FN_OVERRIDE_A2);
    if ecs_cloner_builder_extras_override_count(b2) != 1 { panic(91809); };
    let o = ecs_cloner_builder_extras_overridden_at(b2, COMP_A);
    if ecs_clone_override_fn_id(o) != FN_OVERRIDE_A2 { panic(91810); };
}

@test "extras_override_distinct_components"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b0, COMP_A, FN_OVERRIDE_A);
    let b2 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b1, COMP_B, FN_OVERRIDE_B);
    if ecs_cloner_builder_extras_override_count(b2) != 2 { panic(91811); };
    let oa = ecs_cloner_builder_extras_overridden_at(b2, COMP_A);
    if ecs_clone_override_fn_id(oa) != FN_OVERRIDE_A { panic(91812); };
    let ob = ecs_cloner_builder_extras_overridden_at(b2, COMP_B);
    if ecs_clone_override_fn_id(ob) != FN_OVERRIDE_B { panic(91813); };
}

@test "extras_overridden_at_missing"() {
    let b = ecs_cloner_builder_extras_new();
    let o = ecs_cloner_builder_extras_overridden_at(b, COMP_C);
    if ecs_clone_override_has(o) != 0 { panic(91814); };
    if ecs_clone_override_fn_id(o) != 0 { panic(91815); };
}

@test "extras_remove_clone_behavior_override_with_id_present"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b0, COMP_A, FN_OVERRIDE_A);
    let b2 = ecs_cloner_builder_extras_remove_clone_behavior_override_with_id(b1, COMP_A);
    if ecs_cloner_builder_extras_override_count(b2) != 0 { panic(91816); };
    let o = ecs_cloner_builder_extras_overridden_at(b2, COMP_A);
    if ecs_clone_override_has(o) != 0 { panic(91817); };
}

@test "extras_remove_clone_behavior_override_with_id_missing_is_noop"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b0, COMP_A, FN_OVERRIDE_A);
    let b2 = ecs_cloner_builder_extras_remove_clone_behavior_override_with_id(b1, COMP_B);
    if ecs_cloner_builder_extras_override_count(b2) != 1 { panic(91818); };
    let o = ecs_cloner_builder_extras_overridden_at(b2, COMP_A);
    if ecs_clone_override_fn_id(o) != FN_OVERRIDE_A { panic(91819); };
}

@test "extras_remove_from_middle_preserves_others"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b0, COMP_A, FN_OVERRIDE_A);
    let b2 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b1, COMP_B, FN_OVERRIDE_B);
    let b3 = ecs_cloner_builder_extras_remove_clone_behavior_override_with_id(b2, COMP_A);
    if ecs_cloner_builder_extras_override_count(b3) != 1 { panic(91820); };
    let oa = ecs_cloner_builder_extras_overridden_at(b3, COMP_A);
    if ecs_clone_override_has(oa) != 0 { panic(91821); };
    let ob = ecs_cloner_builder_extras_overridden_at(b3, COMP_B);
    if ecs_clone_override_fn_id(ob) != FN_OVERRIDE_B { panic(91822); };
}

@test "extras_without_required_components_scope_begin_end"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_without_required_components_begin(b0);
    if ecs_cloner_builder_extras_attach_required_components(b1) != 0 { panic(91823); };
    let b2 = ecs_cloner_builder_extras_without_required_components_end(b1);
    if ecs_cloner_builder_extras_attach_required_components(b2) != 1 { panic(91824); };
}

@test "extras_without_required_by_components_scope_begin_end"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_without_required_by_components_begin(b0);
    if ecs_cloner_builder_extras_attach_required_by_components(b1) != 0 { panic(91825); };
    let b2 = ecs_cloner_builder_extras_without_required_by_components_end(b1);
    if ecs_cloner_builder_extras_attach_required_by_components(b2) != 1 { panic(91826); };
}

@test "extras_scope_flags_independent"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_without_required_components_begin(b0);
    // attach_required_components=0, attach_required_by_components should still be 1
    if ecs_cloner_builder_extras_attach_required_components(b1) != 0 { panic(91827); };
    if ecs_cloner_builder_extras_attach_required_by_components(b1) != 1 { panic(91828); };
    let b2 = ecs_cloner_builder_extras_without_required_by_components_begin(b1);
    // both flags now 0
    if ecs_cloner_builder_extras_attach_required_components(b2) != 0 { panic(91829); };
    if ecs_cloner_builder_extras_attach_required_by_components(b2) != 0 { panic(91830); };
}

@test "extras_combined_default_and_override"() {
    let b0 = ecs_cloner_builder_extras_new();
    let b1 = ecs_cloner_builder_extras_with_default_clone_fn(b0, FN_DEFAULT);
    let b2 = ecs_cloner_builder_extras_override_clone_behavior_with_id(b1, COMP_A, FN_OVERRIDE_A);
    if ecs_cloner_builder_extras_default_clone_fn(b2) != FN_DEFAULT { panic(91831); };
    let o = ecs_cloner_builder_extras_overridden_at(b2, COMP_A);
    if ecs_clone_override_fn_id(o) != FN_OVERRIDE_A { panic(91832); };
    // default unaffected by override addition
    if ecs_cloner_builder_extras_default_clone_fn(b2) != FN_DEFAULT { panic(91833); };
}
