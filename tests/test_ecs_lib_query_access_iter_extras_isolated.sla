@import "lib/query_access_iter_extras.sla"

// Isolated tests for lib/query_access_iter_extras.sla — EcsAccessType + EcsAccessLevel + AccessConflictError + is_compatible matrix.
// Bevy: src/query/access_iter.rs.
// panic codes: 92241 – 92290.

@test "access_level_constructors_encode"() {
    let read = ecs_access_level_read(7);
    if ecs_access_level_kind(read) != 0 { panic(92241); };
    if ecs_access_level_component_id(read) != 7 { panic(92242); };
    let write = ecs_access_level_write(9);
    if ecs_access_level_kind(write) != 1 { panic(92243); };
    if ecs_access_level_component_id(write) != 9 { panic(92244); };
    let ra = ecs_access_level_read_all();
    if ecs_access_level_kind(ra) != 2 { panic(92245); };
    if ecs_access_level_component_id(ra) != (0 - 1) { panic(92246); };
    let wa = ecs_access_level_write_all();
    if ecs_access_level_kind(wa) != 3 { panic(92247); };
}

@test "access_type_empty_is_variant_zero"() {
    let e = ecs_access_type_empty();
    if ecs_access_type_variant(e) != 0 { panic(92248); };
}

@test "access_type_component_roundtrip"() {
    let lvl = ecs_access_level_write(5);
    let t = ecs_access_type_component(lvl);
    if ecs_access_type_variant(t) != 1 { panic(92249); };
    if ecs_access_type_level_kind(t) != 1 { panic(92250); };
    if ecs_access_type_component_id(t) != 5 { panic(92251); };
}

@test "is_compatible_empty_with_anything_ok"() {
    let empty = ecs_access_type_empty();
    let comp = ecs_access_type_component(ecs_access_level_write(3));
    let r1 = ecs_access_type_is_compatible(empty, comp);
    if !ecs_acr_ok(r1) { panic(92252); };
    let r2 = ecs_access_type_is_compatible(comp, empty);
    if !ecs_acr_ok(r2) { panic(92253); };
}

@test "is_compatible_read_read_same_id_ok"() {
    let r = ecs_access_type_component(ecs_access_level_read(7));
    let r2 = ecs_access_type_component(ecs_access_level_read(7));
    let res = ecs_access_type_is_compatible(r, r2);
    if !ecs_acr_ok(res) { panic(92254); };
}

@test "is_compatible_read_write_same_id_err"() {
    let r = ecs_access_type_component(ecs_access_level_read(7));
    let w = ecs_access_type_component(ecs_access_level_write(7));
    let res = ecs_access_type_is_compatible(r, w);
    if ecs_acr_ok(res) { panic(92255); };
    if ecs_acr_conflict_a_variant(res) != 1 { panic(92256); };
    if ecs_acr_conflict_b_variant(res) != 1 { panic(92257); };
}

@test "is_compatible_read_write_different_id_ok"() {
    let r = ecs_access_type_component(ecs_access_level_read(7));
    let w = ecs_access_type_component(ecs_access_level_write(8));
    let res = ecs_access_type_is_compatible(r, w);
    if !ecs_acr_ok(res) { panic(92258); };
}

@test "is_compatible_write_write_same_id_err"() {
    let w1 = ecs_access_type_component(ecs_access_level_write(5));
    let w2 = ecs_access_type_component(ecs_access_level_write(5));
    let res = ecs_access_type_is_compatible(w1, w2);
    if ecs_acr_ok(res) { panic(92259); };
}

@test "is_compatible_write_write_different_id_ok"() {
    let w1 = ecs_access_type_component(ecs_access_level_write(5));
    let w2 = ecs_access_type_component(ecs_access_level_write(6));
    let res = ecs_access_type_is_compatible(w1, w2);
    if !ecs_acr_ok(res) { panic(92260); };
}

@test "is_compatible_read_all_with_write_err"() {
    let ra = ecs_access_type_component(ecs_access_level_read_all());
    let w = ecs_access_type_component(ecs_access_level_write(3));
    let res1 = ecs_access_type_is_compatible(ra, w);
    if ecs_acr_ok(res1) { panic(92261); };
    let res2 = ecs_access_type_is_compatible(w, ra);
    if ecs_acr_ok(res2) { panic(92262); };
}

@test "is_compatible_read_all_with_read_ok"() {
    let ra = ecs_access_type_component(ecs_access_level_read_all());
    let r = ecs_access_type_component(ecs_access_level_read(3));
    let res = ecs_access_type_is_compatible(ra, r);
    if !ecs_acr_ok(res) { panic(92263); };
    let res2 = ecs_access_type_is_compatible(r, ra);
    if !ecs_acr_ok(res2) { panic(92264); };
}

@test "is_compatible_write_all_with_anything_err"() {
    let wa = ecs_access_type_component(ecs_access_level_write_all());
    let r = ecs_access_type_component(ecs_access_level_read(3));
    let w = ecs_access_type_component(ecs_access_level_write(3));
    let res_r = ecs_access_type_is_compatible(wa, r);
    if ecs_acr_ok(res_r) { panic(92265); };
    let res_w = ecs_access_type_is_compatible(wa, w);
    if ecs_acr_ok(res_w) { panic(92266); };
    let res_rw = ecs_access_type_is_compatible(r, wa);
    if ecs_acr_ok(res_rw) { panic(92267); };
}

@test "is_compatible_write_all_vs_write_all_err"() {
    let wa1 = ecs_access_type_component(ecs_access_level_write_all());
    let wa2 = ecs_access_type_component(ecs_access_level_write_all());
    let res = ecs_access_type_is_compatible(wa1, wa2);
    if ecs_acr_ok(res) { panic(92268); };
}

@test "is_compatible_component_read_vs_access_write_err"() {
    let read = ecs_access_type_component(ecs_access_level_read(11));
    let writes = Vec::new();
    writes.push(11);
    let acc = ecs_access_type_access(1, Vec::new(), writes, false, false);
    let res = ecs_access_type_is_compatible(read, acc);
    if ecs_acr_ok(res) { panic(92269); };
    let res_rev = ecs_access_type_is_compatible(acc, read);
    if ecs_acr_ok(res_rev) { panic(92270); };
}

@test "is_compatible_component_read_vs_access_without_write_ok"() {
    let read = ecs_access_type_component(ecs_access_level_read(11));
    let acc = ecs_access_type_access(1, Vec::new(), Vec::new(), false, false);
    let res = ecs_access_type_is_compatible(read, acc);
    if !ecs_acr_ok(res) { panic(92271); };
}

