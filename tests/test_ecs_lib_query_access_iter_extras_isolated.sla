@test "is_compatible_access_with_read_all_flag_conflicts_write_component"() {
    let read = ecs_access_type_component(ecs_access_level_read(30));
    let acc = ecs_access_type_access(1, Vec::new(), Vec::new(), true, false);
    // acc.read_all + eg no writes on acc => component(Read(30)) vs Access reads-everything => still Ok
    // because the component Read does not conflict with a read-everything access.
    let res = ecs_access_type_is_compatible(read, acc);
    if !ecs_acr_ok(res) { panic(92277); };
    // but component(Write(30)) vs Access(read_all=true) should Err.
    let write = ecs_access_type_component(ecs_access_level_write(30));
    let res2 = ecs_access_type_is_compatible(write, acc);
    if ecs_acr_ok(res2) { panic(92278); };
}

@test "is_compatible_access_vs_access_no_overlap_ok"() {
    let reads_a = Vec::new();
    reads_a.push(1);
    let writes_b = Vec::new();
    writes_b.push(2);
    let a = ecs_access_type_access(1, reads_a, Vec::new(), false, false);
    let b = ecs_access_type_access(2, Vec::new(), writes_b, false, false);
    let res = ecs_access_type_is_compatible(a, b);
    if !ecs_acr_ok(res) { panic(92279); };
}

