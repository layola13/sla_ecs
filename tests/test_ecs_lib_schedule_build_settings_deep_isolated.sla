@import "lib/schedule_build_settings_deep.sla"

// Batch 318: schedule_build_settings deep.
// panic codes: 129600 – 129799.

@test "log_levels"() {
    if ecs_sbs_log_is_ignore(ecs_sbs_log_ignore()) != true { panic(129600); };
    if ecs_sbs_log_is_warn(ecs_sbs_log_warn()) != true { panic(129601); };
    if ecs_sbs_log_is_error(ecs_sbs_log_error()) != true { panic(129602); };
}

@test "defaults"() {
    let s = ecs_sbs_deep_default();
    if ecs_sbs_deep_ambiguity(s) != ECS_SBS_LOG_IGNORE { panic(129610); };
    if ecs_sbs_deep_hierarchy(s) != ECS_SBS_LOG_WARN { panic(129611); };
    if ecs_sbs_deep_auto_insert(s) != true { panic(129612); };
    if ecs_sbs_deep_shortnames(s) != true { panic(129613); };
    if ecs_sbs_deep_report_sets(s) != true { panic(129614); };
}

@test "new_and_setters"() {
    let s = ecs_sbs_deep_new(ECS_SBS_LOG_ERROR, ECS_SBS_LOG_IGNORE, false, false, false);
    if ecs_sbs_deep_ambiguity(s) != ECS_SBS_LOG_ERROR { panic(129620); };
    s = ecs_sbs_deep_set_ambiguity(s, ECS_SBS_LOG_WARN);
    s = ecs_sbs_deep_set_hierarchy(s, ECS_SBS_LOG_ERROR);
    s = ecs_sbs_deep_set_auto_insert(s, true);
    s = ecs_sbs_deep_set_shortnames(s, true);
    s = ecs_sbs_deep_set_report_sets(s, true);
    if ecs_sbs_deep_hierarchy(s) != ECS_SBS_LOG_ERROR { panic(129621); };
    if ecs_sbs_deep_auto_insert(s) != true { panic(129622); };
}

@test "eq"() {
    let a = ecs_sbs_deep_default();
    let b = ecs_sbs_deep_default();
    if ecs_sbs_deep_eq(a, b) != true { panic(129630); };
    b = ecs_sbs_deep_set_report_sets(b, false);
    if ecs_sbs_deep_eq(a, b) != false { panic(129631); };
}

@test "should_warn_error"() {
    if ecs_sbs_deep_should_warn(ECS_SBS_LOG_IGNORE) != false { panic(129640); };
    if ecs_sbs_deep_should_warn(ECS_SBS_LOG_WARN) != true { panic(129641); };
    if ecs_sbs_deep_should_error(ECS_SBS_LOG_ERROR) != true { panic(129642); };
    if ecs_sbs_deep_should_error(ECS_SBS_LOG_WARN) != false { panic(129643); };
}

@test "metadata_new"() {
    let m = ecs_sbm_deep_new();
    if ecs_sbm_deep_ambiguity(m) != 0 { panic(129650); };
    if ecs_sbm_deep_edges(m) != 0 { panic(129651); };
}

@test "note_ambiguity"() {
    let m = ecs_sbm_deep_note_ambiguity(ecs_sbm_deep_new());
    if ecs_sbm_deep_ambiguity(m) != 1 { panic(129660); };
    if ecs_sbm_deep_warnings(m) != 1 { panic(129661); };
}

@test "note_hierarchy"() {
    let m = ecs_sbm_deep_note_hierarchy(ecs_sbm_deep_new());
    if ecs_sbm_deep_hierarchy(m) != 1 { panic(129670); };
    if ecs_sbm_deep_warnings(m) != 1 { panic(129671); };
}

@test "add_edges"() {
    let m = ecs_sbm_deep_add_edge(ecs_sbm_deep_new(), 5);
    if ecs_sbm_deep_edges(m) != 5 { panic(129680); };
    m = ecs_sbm_deep_add_edge(m, 2);
    if ecs_sbm_deep_edges(m) != 7 { panic(129681); };
}

@test "combined_metadata"() {
    let m = ecs_sbm_deep_new();
    m = ecs_sbm_deep_note_ambiguity(m);
    m = ecs_sbm_deep_note_hierarchy(m);
    m = ecs_sbm_deep_add_edge(m, 3);
    if ecs_sbm_deep_warnings(m) != 2 { panic(129690); };
    if ecs_sbm_deep_edges(m) != 3 { panic(129691); };
}
