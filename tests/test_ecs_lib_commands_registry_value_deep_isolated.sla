// Isolated deep tests for lib/commands_registry_value_deep.sla (Batch 363).
// Kind-discriminated deferred command queue for RegistryValueWorld.
// panic codes: 138600 - 138799.

@import "lib/commands_registry_value_deep.sla"

@test "RegValueCommands new empty and side counts zero"() {
    let c = ecs_reg_value_commands_new();
    if ecs_reg_value_commands_len(c) != 0 { panic(138600); };
    if ecs_reg_value_commands_pcomp_count(c) != 0 { panic(138601); };
    if ecs_reg_value_commands_pres_count(c) != 0 { panic(138602); };
    if ecs_reg_value_commands_pmsg_count(c) != 0 { panic(138603); };
    if ecs_reg_value_commands_kind_at(c, 0) != 0 { panic(138604); };
}

@test "insert enqueues INSERT_COMPONENT with side payload and resolve"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_insert(c0, 7, 11, 100);
    if ecs_reg_value_commands_len(c1) != 1 { panic(138610); };
    if ecs_reg_value_commands_kind_at(c1, 0) != ECS_CMD_REG_VALUE_INSERT_COMPONENT { panic(138611); };
    if ecs_reg_value_commands_entity_at(c1, 0) != 7 { panic(138612); };
    if ecs_reg_value_commands_cmp_at(c1, 0) != 11 { panic(138613); };
    if ecs_reg_value_commands_idx_at(c1, 0) != 0 { panic(138614); };
    if ecs_reg_value_commands_pcomp_count(c1) != 1 { panic(138615); };
    if ecs_reg_value_commands_pcomp_at(c1, 0) != 100 { panic(138616); };
    if ecs_reg_value_commands_resolve_value(c1, 0) != 100 { panic(138617); };
}

@test "multiple insertions fill sequential slots and side payloads"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_insert(c0, 1, 10, 50);
    let c2 = ecs_reg_value_commands_insert(c1, 2, 20, 60);
    let c3 = ecs_reg_value_commands_insert(c2, 3, 30, 70);
    if ecs_reg_value_commands_len(c3) != 3 { panic(138620); };
    if ecs_reg_value_commands_resolve_value(c3, 0) != 50 { panic(138621); };
    if ecs_reg_value_commands_resolve_value(c3, 1) != 60 { panic(138622); };
    if ecs_reg_value_commands_resolve_value(c3, 2) != 70 { panic(138623); };
    if ecs_reg_value_commands_pcomp_count(c3) != 3 { panic(138624); };
    if ecs_reg_value_commands_cmp_at(c3, 2) != 30 { panic(138625); };
}

@test "despawn enqueues DESPAWN with no side payload"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_despawn(c0, 9);
    if ecs_reg_value_commands_len(c1) != 1 { panic(138630); };
    if ecs_reg_value_commands_kind_at(c1, 0) != ECS_CMD_REG_VALUE_DESPAWN { panic(138631); };
    if ecs_reg_value_commands_entity_at(c1, 0) != 9 { panic(138632); };
    if ecs_reg_value_commands_cmp_at(c1, 0) != 0 { panic(138633); };
    if ecs_reg_value_commands_idx_at(c1, 0) != -1 { panic(138634); };
    if ecs_reg_value_commands_resolve_value(c1, 0) != 0 { panic(138635); };
}

@test "insert_resource enqueues resource side payload"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_insert_resource(c0, 888);
    if ecs_reg_value_commands_len(c1) != 1 { panic(138640); };
    if ecs_reg_value_commands_kind_at(c1, 0) != ECS_CMD_REG_VALUE_INSERT_RESOURCE { panic(138641); };
    if ecs_reg_value_commands_pres_count(c1) != 1 { panic(138642); };
    if ecs_reg_value_commands_pres_at(c1, 0) != 888 { panic(138643); };
    if ecs_reg_value_commands_resolve_value(c1, 0) != 888 { panic(138644); };
}

@test "write_message enqueues message side payload"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_write_message(c0, 42);
    if ecs_reg_value_commands_len(c1) != 1 { panic(138650); };
    if ecs_reg_value_commands_kind_at(c1, 0) != ECS_CMD_REG_VALUE_WRITE_MESSAGE { panic(138651); };
    if ecs_reg_value_commands_pmsg_count(c1) != 1 { panic(138652); };
    if ecs_reg_value_commands_pmsg_at(c1, 0) != 42 { panic(138653); };
    if ecs_reg_value_commands_resolve_value(c1, 0) != 42 { panic(138654); };
}

@test "count_by_kind categorizes mixed queue"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_insert(c0, 1, 10, 1);
    let c2 = ecs_reg_value_commands_despawn(c1, 1);
    let c3 = ecs_reg_value_commands_insert(c2, 2, 10, 2);
    let c4 = ecs_reg_value_commands_insert_resource(c3, 9);
    let c5 = ecs_reg_value_commands_write_message(c4, 3);
    let c6 = ecs_reg_value_commands_despawn(c5, 2);
    if ecs_reg_value_commands_count_by_kind(c6, ECS_CMD_REG_VALUE_INSERT_COMPONENT) != 2 { panic(138660); };
    if ecs_reg_value_commands_count_by_kind(c6, ECS_CMD_REG_VALUE_DESPAWN) != 2 { panic(138661); };
    if ecs_reg_value_commands_count_by_kind(c6, ECS_CMD_REG_VALUE_INSERT_RESOURCE) != 1 { panic(138662); };
    if ecs_reg_value_commands_count_by_kind(c6, ECS_CMD_REG_VALUE_WRITE_MESSAGE) != 1 { panic(138663); };
    if ecs_reg_value_commands_len(c6) != 6 { panic(138664); };
}

@test "resolve_value across mixed kinds respects side-array mapping"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = ecs_reg_value_commands_insert(c0, 1, 10, 11);
    let c2 = ecs_reg_value_commands_insert_resource(c1, 22);
    let c3 = ecs_reg_value_commands_write_message(c2, 33);
    let c4 = ecs_reg_value_commands_despawn(c3, 5);
    let c5 = ecs_reg_value_commands_insert(c4, 2, 11, 44);
    if ecs_reg_value_commands_resolve_value(c5, 0) != 11 { panic(138670); };
    if ecs_reg_value_commands_resolve_value(c5, 1) != 22 { panic(138671); };
    if ecs_reg_value_commands_resolve_value(c5, 2) != 33 { panic(138672); };
    if ecs_reg_value_commands_resolve_value(c5, 3) != 0 { panic(138673); };
    if ecs_reg_value_commands_resolve_value(c5, 4) != 44 { panic(138674); };
    if ecs_reg_value_commands_pcomp_count(c5) != 2 { panic(138675); };
    if ecs_reg_value_commands_pres_count(c5) != 1 { panic(138676); };
    if ecs_reg_value_commands_pmsg_count(c5) != 1 { panic(138677); };
}

@test "queue rejects at cap-8 and clear resets all counts"() {
    let c0 = ecs_reg_value_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_reg_value_commands_insert(c1, i, i, 100 + i);
        i = i + 1;
    }
    if ecs_reg_value_commands_len(c1) != 8 { panic(138680); };
    if ecs_reg_value_commands_pcomp_count(c1) != 8 { panic(138681); };
    let c2 = ecs_reg_value_commands_insert(c1, 99, 99, 999);
    if ecs_reg_value_commands_len(c2) != 8 { panic(138682); };
    let c3 = ecs_reg_value_commands_despawn(c2, 99);
    if ecs_reg_value_commands_len(c3) != 8 { panic(138683); };
    let c4 = ecs_reg_value_commands_clear(c3);
    if ecs_reg_value_commands_len(c4) != 0 { panic(138684); };
    if ecs_reg_value_commands_pcomp_count(c4) != 0 { panic(138685); };
    if ecs_reg_value_commands_pres_count(c4) != 0 { panic(138686); };
    if ecs_reg_value_commands_pmsg_count(c4) != 0 { panic(138687); };
}

@test "reserve_entity yields placeholder id and builder helper"() {
    let c0 = ecs_reg_value_commands_new();
    let (c1, id) = ecs_reg_value_commands_reserve_entity(c0);
    if id != 0 { panic(138690); };
    if ecs_reg_value_commands_len(c1) != 0 { panic(138691); };
    let cmd = ecs_reg_value_command(ECS_CMD_REG_VALUE_INSERT_COMPONENT, 3, 7, 0);
    if ecs_reg_value_command_kind(cmd) != ECS_CMD_REG_VALUE_INSERT_COMPONENT { panic(138692); };
    if ecs_reg_value_command_entity_id(cmd) != 3 { panic(138693); };
    if ecs_reg_value_command_component_id(cmd) != 7 { panic(138694); };
    if ecs_reg_value_command_value_index(cmd) != 0 { panic(138695); };
}
