@import "lib/system_name_deep.sla"

// Batch 209: SystemName deep (src/system/system_name.rs).

@test "debug_name_basic"() {
    let d = ecs_sn_debug_name(42);
    if ecs_sn_debug_name_id(d) != 42 { panic(107800); };
    if ecs_sn_debug_path_id(d) != 0 { panic(107801); };
    if ecs_sn_debug_display_code(d) != 42 { panic(107802); };
}

@test "debug_name_with_path_display"() {
    let d = ecs_sn_debug_name_full(7, 3);
    if ecs_sn_debug_display_code(d) != 3000007 { panic(107810); };
}

@test "debug_ends_with"() {
    // name 12007 ends with 2007? using mod 10000 => 2007
    let d = ecs_sn_debug_name(12007);
    if ecs_sn_debug_ends_with(d, 2007) != true { panic(107820); };
    if ecs_sn_debug_ends_with(d, 9999) != false { panic(107821); };
    if ecs_sn_debug_ends_with(d, 12007) != true { panic(107822); };
}

@test "system_name_name_and_eq"() {
    let s = ecs_sn_new(5);
    if ecs_sn_name_id(s) != 5 { panic(107830); };
    if ecs_sn_eq(s, ecs_sn_new(5)) != true { panic(107831); };
    if ecs_sn_eq(s, ecs_sn_new(6)) != false { panic(107832); };
    if ecs_sn_debug_name_id(ecs_sn_into_debug(s)) != 5 { panic(107833); };
}

@test "system_param_readonly_no_access"() {
    if ecs_sn_sp_is_read_only() != true { panic(107840); };
    if ecs_sn_sp_touches_components() != false { panic(107841); };
    let m = ecs_sn_meta_new(11);
    m = ecs_sn_sp_init_access(m);
    if ecs_sn_meta_access_mutations(m) != 0 { panic(107842); };
    let r = ecs_sn_sp_get_param(ecs_sn_sp_init_state(), m);
    if r.0 != true { panic(107843); };
    if ecs_sn_name_id(r.1) != 11 { panic(107844); };
}

@test "exclusive_system_param"() {
    let m = ecs_sn_meta_new(22);
    let r = ecs_sn_esp_get_param(ecs_sn_esp_init(), m);
    if r.0 != true { panic(107850); };
    if ecs_sn_name_id(r.1) != 22 { panic(107851); };
}

@test "run_regular_and_exclusive_match"() {
    let m = ecs_sn_meta_with_path(100, 2);
    let a = ecs_sn_run_regular(m);
    let b = ecs_sn_run_exclusive(m);
    if ecs_sn_eq(a, b) != true { panic(107860); };
    if ecs_sn_display_code(a) != 2000100 { panic(107861); };
}

@test "with_name_on_meta"() {
    let m = ecs_sn_meta_new(1);
    m = ecs_sn_meta_with_name(m, 99);
    let s = ecs_sn_run_regular(m);
    if ecs_sn_name_id(s) != 99 { panic(107870); };
}

@test "closure_with_name_regular"() {
    let s = ecs_sn_run_closure_with_name(55);
    if ecs_sn_name_id(s) != 55 { panic(107880); };
}

@test "closure_with_name_exclusive"() {
    let s = ecs_sn_run_exclusive_closure_with_name(66);
    if ecs_sn_name_id(s) != 66 { panic(107881); };
}

@test "logger_system_param_bundle"() {
    let m = ecs_sn_meta_new(77);
    let l = ecs_sn_logger_from_meta(m);
    if ecs_sn_logger_name_id(l) != 77 { panic(107890); };
    let l2 = ecs_sn_logger_log(l, 3);
    if ecs_sn_logger_log_count(l2) != 1 { panic(107891); };
    if ecs_sn_logger_last_message(l2) != 3 { panic(107892); };
    if ecs_sn_logger_display_code(l2) != 77003 { panic(107893); };
}

@test "regular_param_name_ends_with_suffix"() {
    // path crate::mod::testing modeled as name_id ending with testing code 1234
    let m = ecs_sn_meta_new(991234);
    let s = ecs_sn_run_regular(m);
    if ecs_sn_debug_ends_with(ecs_sn_name(s), 1234) != true { panic(107900); };
}

@test "exclusive_param_name_ends_with_suffix"() {
    let m = ecs_sn_meta_new(881234);
    let s = ecs_sn_run_exclusive(m);
    if ecs_sn_debug_ends_with(ecs_sn_name(s), 1234) != true { panic(107910); };
}

@test "meta_with_name_preserves_path"() {
    let m = ecs_sn_meta_with_path(1, 8);
    m = ecs_sn_meta_with_name(m, 2);
    let d = ecs_sn_meta_name(m);
    if ecs_sn_debug_name_id(d) != 2 { panic(107920); };
    if ecs_sn_debug_path_id(d) != 8 { panic(107921); };
}
