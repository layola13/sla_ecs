@import "lib/query_par_iter_deep.sla"

// Batch 205: QueryParIter deep (src/query/par_iter.rs).

@test "new_defaults"() {
    let p = ecs_qpi_new(0);
    if ecs_qpi_len(p) != 0 { panic(107000); };
    if ecs_qpi_is_empty(p) != true { panic(107001); };
    if ecs_qpi_is_mut(p) != false { panic(107002); };
    if ecs_qpi_consumed(p) != false { panic(107003); };
}

@test "fill_identity_and_mut_flag"() {
    let p = ecs_qpi_new_mut(4);
    p = ecs_qpi_fill_identity(p);
    if ecs_qpi_is_mut(p) != true { panic(107010); };
    if ecs_qpi_get_item(p, 0) != 1 { panic(107011); };
    if ecs_qpi_get_item(p, 3) != 4 { panic(107012); };
}

@test "sequential_for_each_sum"() {
    let p = ecs_qpi_new(5);
    p = ecs_qpi_fill_identity(p); // 1+2+3+4+5 = 15
    p = ecs_qpi_for_each(p, 1);
    if ecs_qpi_used_parallel(p) != false { panic(107020); };
    if ecs_qpi_processed(p) != 5 { panic(107021); };
    if ecs_qpi_init_calls(p) != 1 { panic(107022); };
    if ecs_qpi_batch_count(p) != 1 { panic(107023); };
    if ecs_qpi_sum_result(p) != 15 { panic(107024); };
    if ecs_qpi_consumed(p) != true { panic(107025); };
}

@test "for_each_init_base_value"() {
    let p = ecs_qpi_new(3);
    p = ecs_qpi_fill_identity(p); // 1+2+3=6
    p = ecs_qpi_for_each_init(p, 1, 10);
    if ecs_qpi_sum_result(p) != 16 { panic(107030); };
    if ecs_qpi_init_calls(p) != 1 { panic(107031); };
}

@test "parallel_fixed_batch_size"() {
    let p = ecs_qpi_new(6);
    p = ecs_qpi_fill_identity(p); // 1..6 sum=21
    let bs = ecs_qpi_bs_fixed(2);
    p = ecs_qpi_batching_strategy(p, bs);
    p = ecs_qpi_for_each(p, 4);
    if ecs_qpi_used_parallel(p) != true { panic(107040); };
    if ecs_qpi_last_batch_size(p) != 2 { panic(107041); };
    if ecs_qpi_batch_count(p) != 3 { panic(107042); };
    if ecs_qpi_init_calls(p) != 3 { panic(107043); };
    if ecs_qpi_processed(p) != 6 { panic(107044); };
    // each batch init 0: (1+2)+(3+4)+(5+6)=21
    if ecs_qpi_sum_result(p) != 21 { panic(107045); };
}

@test "parallel_init_base_accumulates_per_batch"() {
    let p = ecs_qpi_new(4);
    p = ecs_qpi_fill_identity(p);
    let bs = ecs_qpi_bs_fixed(2);
    p = ecs_qpi_batching_strategy(p, bs);
    p = ecs_qpi_for_each_init(p, 2, 1);
    // batches: (1+1+2)=4, (1+3+4)=8 => sum_result 12
    if ecs_qpi_batch_count(p) != 2 { panic(107050); };
    if ecs_qpi_sum_result(p) != 12 { panic(107051); };
    if ecs_qpi_init_calls(p) != 2 { panic(107052); };
}

@test "get_batch_size_default_strategy"() {
    let p = ecs_qpi_new(10);
    p = ecs_qpi_fill_identity(p);
    // default: range 1..MAX, bpt=1, threads=2 => batches=2, div_ceil(10,2)=5
    let r = ecs_qpi_get_batch_size(p, 2);
    if r.1 != 5 { panic(107060); };
}

@test "thread_count_zero_falls_sequential"() {
    // our model: thread_count <= 1 is sequential; 0 treated sequential
    let p = ecs_qpi_new(3);
    p = ecs_qpi_fill_identity(p);
    p = ecs_qpi_for_each(p, 0);
    if ecs_qpi_used_parallel(p) != false { panic(107070); };
    if ecs_qpi_sum_result(p) != 6 { panic(107071); };
}

@test "consumed_once"() {
    let p = ecs_qpi_new(2);
    p = ecs_qpi_fill_identity(p);
    p = ecs_qpi_for_each(p, 1);
    let first = ecs_qpi_sum_result(p);
    p = ecs_qpi_for_each(p, 1);
    if ecs_qpi_sum_result(p) != first { panic(107080); };
    if ecs_qpi_processed(p) != 2 { panic(107081); };
}

@test "ticks_preserved"() {
    let p = ecs_qpi_new(1);
    p = ecs_qpi_with_ticks(p, 7, 9);
    if ecs_qpi_last_run(p) != 7 { panic(107090); };
    if ecs_qpi_this_run(p) != 9 { panic(107091); };
}

@test "many_sequential_filters_mask"() {
    let m = ecs_qpi_many_new();
    m = ecs_qpi_many_push(m, 10);
    m = ecs_qpi_many_push(m, 20);
    m = ecs_qpi_many_push(m, 30);
    // mask bit0 and bit2 only (1 + 4 = 5)
    m = ecs_qpi_many_set_match_mask(m, 5);
    m = ecs_qpi_many_for_each(m, 1);
    if ecs_qpi_many_processed(m) != 2 { panic(107100); };
    if ecs_qpi_many_sum(m) != 40 { panic(107101); }; // 10+30
    if ecs_qpi_many_used_parallel(m) != false { panic(107102); };
}

@test "many_parallel_batches"() {
    let m = ecs_qpi_many_new();
    m = ecs_qpi_many_push(m, 1);
    m = ecs_qpi_many_push(m, 2);
    m = ecs_qpi_many_push(m, 3);
    m = ecs_qpi_many_push(m, 4);
    let bs = ecs_qpi_bs_fixed(2);
    m = ecs_qpi_many_batching_strategy(m, bs);
    m = ecs_qpi_many_for_each(m, 2);
    if ecs_qpi_many_used_parallel(m) != true { panic(107110); };
    if ecs_qpi_many_batch_count(m) != 2 { panic(107111); };
    if ecs_qpi_many_init_calls(m) != 2 { panic(107112); };
    if ecs_qpi_many_processed(m) != 4 { panic(107113); };
    if ecs_qpi_many_sum(m) != 10 { panic(107114); };
}

@test "many_unique_flag"() {
    let m = ecs_qpi_many_unique_new();
    if ecs_qpi_many_is_unique(m) != true { panic(107120); };
    m = ecs_qpi_many_push(m, 5);
    m = ecs_qpi_many_for_each(m, 1);
    if ecs_qpi_many_sum(m) != 5 { panic(107121); };
}

@test "empty_for_each"() {
    let p = ecs_qpi_new(0);
    p = ecs_qpi_for_each(p, 4);
    if ecs_qpi_processed(p) != 0 { panic(107130); };
    if ecs_qpi_sum_result(p) != 0 { panic(107131); };
}

@test "expected_batches_helper"() {
    if ecs_qpi_expected_batches(10, 3) != 4 { panic(107140); };
    if ecs_qpi_expected_batches(0, 3) != 0 { panic(107141); };
}

@test "batching_strategy_min_max"() {
    let p = ecs_qpi_new(100);
    // can't store 100 items but batch calc uses item_count field
    p.item_count = 100;
    let bs = ecs_qpi_bs_default();
    bs = ecs_qpi_bs_min(bs, 10);
    bs = ecs_qpi_bs_max(bs, 20);
    bs = ecs_qpi_bs_bpt(bs, 2);
    p = ecs_qpi_batching_strategy(p, bs);
    // threads=2, bpt=2 => batches=4, div_ceil(100,4)=25 clamp to [10,20] => 20
    let r = ecs_qpi_get_batch_size(p, 2);
    if r.1 != 20 { panic(107150); };
}
