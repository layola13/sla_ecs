@import "lib/query_sort_iter_deep.sla"

// Batch 263: query_sort_iter deep (src/query/iter.rs sort family).
// panic codes: 118600 – 118799.

@test "push_and_len"() {
    let q = ecs_qsi_deep_new();
    if ecs_qsi_deep_is_empty(q) != true { panic(118600); };
    q = ecs_qsi_deep_push(q, 1, 30);
    q = ecs_qsi_deep_push(q, 2, 10);
    q = ecs_qsi_deep_push(q, 3, 20);
    if ecs_qsi_deep_len(q) != 3 { panic(118601); };
}

@test "sort_ascending"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 1, 30);
    q = ecs_qsi_deep_push(q, 2, 10);
    q = ecs_qsi_deep_push(q, 3, 20);
    let s = ecs_qsi_deep_sort(q);
    if ecs_qsorted_ok(s) != true { panic(118610); };
    if ecs_qsorted_entity_at(s, 0) != 2 { panic(118611); };
    if ecs_qsorted_key_at(s, 0) != 10 { panic(118612); };
    if ecs_qsorted_entity_at(s, 1) != 3 { panic(118613); };
    if ecs_qsorted_entity_at(s, 2) != 1 { panic(118614); };
}

@test "sort_desc"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 1, 1);
    q = ecs_qsi_deep_push(q, 2, 3);
    q = ecs_qsi_deep_push(q, 3, 2);
    let s = ecs_qsi_deep_sort_desc(q);
    if ecs_qsorted_entity_at(s, 0) != 2 { panic(118620); };
    if ecs_qsorted_key_at(s, 0) != 3 { panic(118621); };
}

@test "consumed_blocks_sort"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 1, 1);
    q = ecs_qsi_deep_mark_consumed(q);
    if ecs_qsi_deep_is_consumed(q) != true { panic(118630); };
    let s = ecs_qsi_deep_sort(q);
    if ecs_qsorted_ok(s) != false { panic(118631); };
}

@test "cached_key_flag"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 1, 2);
    q = ecs_qsi_deep_push(q, 2, 1);
    let s = ecs_qsi_deep_sort_by_cached_key(q);
    if ecs_qsorted_cached(s) != true { panic(118640); };
    let s2 = ecs_qsi_deep_sort_by_key(q);
    if ecs_qsorted_cached(s2) != false { panic(118641); };
}

@test "sorted_next_cursor"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 1, 2);
    q = ecs_qsi_deep_push(q, 2, 1);
    let s = ecs_qsi_deep_sort(q);
    let n = ecs_qsorted_next(s);
    let e0 = ecs_qsorted_next_entity(n);
    let k0 = ecs_qsorted_next_key(n);
    s = ecs_qsorted_next_iter(n);
    if e0 != 2 { panic(118650); };
    if k0 != 1 { panic(118651); };
    n = ecs_qsorted_next(s);
    if ecs_qsorted_next_entity(n) != 1 { panic(118652); };
    s = ecs_qsorted_next_iter(n);
    n = ecs_qsorted_next(s);
    if ecs_qsorted_next_had(n) != false { panic(118653); };
}

@test "unstable_same_order_model"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 5, 5);
    q = ecs_qsi_deep_push(q, 1, 1);
    let s = ecs_qsi_deep_sort_unstable(q);
    if ecs_qsorted_entity_at(s, 0) != 1 { panic(118660); };
}

@test "capacity_eight"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_push(q, 1, 8);
    q = ecs_qsi_deep_push(q, 2, 7);
    q = ecs_qsi_deep_push(q, 3, 6);
    q = ecs_qsi_deep_push(q, 4, 5);
    q = ecs_qsi_deep_push(q, 5, 4);
    q = ecs_qsi_deep_push(q, 6, 3);
    q = ecs_qsi_deep_push(q, 7, 2);
    q = ecs_qsi_deep_push(q, 8, 1);
    q = ecs_qsi_deep_push(q, 9, 0);
    if ecs_qsi_deep_len(q) != 8 { panic(118670); };
    let s = ecs_qsi_deep_sort(q);
    if ecs_qsorted_len(s) != 8 { panic(118671); };
    if ecs_qsorted_key_at(s, 0) != 1 { panic(118672); };
}

@test "push_after_consumed_ignored"() {
    let q = ecs_qsi_deep_new();
    q = ecs_qsi_deep_mark_consumed(q);
    q = ecs_qsi_deep_push(q, 1, 1);
    if ecs_qsi_deep_len(q) != 0 { panic(118680); };
}

@test "empty_sort_ok"() {
    let q = ecs_qsi_deep_new();
    let s = ecs_qsi_deep_sort(q);
    if ecs_qsorted_ok(s) != true { panic(118690); };
    if ecs_qsorted_len(s) != 0 { panic(118691); };
}
