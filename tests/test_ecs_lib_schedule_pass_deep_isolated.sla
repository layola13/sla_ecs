@import "lib/schedule_pass_deep.sla"

// Batch 175 tests for deepened schedule::pass + node.rs surface.

@test "node_id_system_constructors"() {
    let s = ecs_node_id_system(42);
    if ecs_node_id_is_system(s) != true { panic(99000); };
    if ecs_node_id_is_set(s) != false { panic(99001); };
    if ecs_node_id_kind(s) != 0 { panic(99002); };
    if ecs_node_id_key(s) != 42 { panic(99003); };
    let st = ecs_node_id_set(7);
    if ecs_node_id_is_set(st) != true { panic(99004); };
    if ecs_node_id_is_system(st) != false { panic(99005); };
    if ecs_node_id_kind(st) != 1 { panic(99006); };
    if ecs_node_id_key(st) != 7 { panic(99007); };
}

@test "node_id_as_system_and_as_set"() {
    let s = ecs_node_id_system(10);
    let r1 = ecs_node_id_as_system(s);
    if r1.0 != true { panic(99010); };
    if r1.1 != 10 { panic(99011); };
    let r2 = ecs_node_id_as_set(s);
    if r2.0 != false { panic(99012); };
    let st = ecs_node_id_set(20);
    let r3 = ecs_node_id_as_set(st);
    if r3.0 != true { panic(99013); };
    if r3.1 != 20 { panic(99014); };
    let r4 = ecs_node_id_as_system(st);
    if r4.0 != false { panic(99015); };
}

@test "node_id_kind_labels"() {
    if ecs_node_id_kind_label(ecs_node_id_system(1)) != 0 { panic(99020); };
    if ecs_node_id_kind_label(ecs_node_id_set(2)) != 1 { panic(99021); };
}

@test "system_key_and_set_key_surface"() {
    let sk = ecs_p_system_key_new(101);
    if ecs_p_system_key_id(sk) != 101 { panic(99030); };
    if ecs_p_system_key_eq(ecs_p_system_key_new(101), ecs_p_system_key_new(101)) != true { panic(99031); };
    if ecs_p_system_key_eq(ecs_p_system_key_new(101), ecs_p_system_key_new(102)) != false { panic(99032); };
    if ecs_p_system_key_kind_label(sk) != 0 { panic(99033); };
    let ssk = ecs_p_system_set_key_new(202);
    if ecs_p_system_set_key_id(ssk) != 202 { panic(99034); };
    if ecs_p_system_set_key_eq(ecs_p_system_set_key_new(202), ecs_p_system_set_key_new(202)) != true { panic(99035); };
    if ecs_p_system_set_key_kind_label(ssk) != 1 { panic(99036); };
}

@test "node_id_from_system_key_and_set_key"() {
    let n1 = ecs_node_id_from_system_key(ecs_p_system_key_new(33));
    if ecs_node_id_is_system(n1) != true { panic(99040); };
    if ecs_node_id_key(n1) != 33 { panic(99041); };
    let n2 = ecs_node_id_from_set_key(ecs_p_system_set_key_new(88));
    if ecs_node_id_is_set(n2) != true { panic(99042); };
    if ecs_node_id_key(n2) != 88 { panic(99043); };
}

@test "flat_deps_new_and_counts"() {
    let d = ecs_flat_deps_new();
    if ecs_flat_deps_node_count(d) != 0 { panic(99050); };
    if ecs_flat_deps_edge_count(d) != 0 { panic(99051); };
    if ecs_flat_deps_added_count(d) != 0 { panic(99052); };
}

@test "flat_deps_add_edge_logs_added_and_creates_nodes"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    d = ecs_flat_deps_add_edge(d, 2, 3);
    if ecs_flat_deps_node_count(d) != 3 { panic(99060); };
    if ecs_flat_deps_edge_count(d) != 2 { panic(99061); };
    if ecs_flat_deps_added_count(d) != 2 { panic(99062); };
    if ecs_flat_deps_contains_edge(d, 1, 2) != true { panic(99063); };
    if ecs_flat_deps_contains_edge(d, 2, 3) != true { panic(99064); };
    if ecs_flat_deps_contains_edge(d, 1, 3) != false { panic(99065); };
}

@test "flat_deps_add_edge_dedups_added_edges"() {
    // A second identical add_edge via the API appends another graph edge (Bevy allows duplicates)
    // but should not duplicate the added_edges record.
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 10, 20);
    d = ecs_flat_deps_add_edge(d, 10, 20);
    if ecs_flat_deps_edge_count(d) != 2 { panic(99070); };
    if ecs_flat_deps_added_count(d) != 1 { panic(99071); };
    let added = ecs_flat_deps_added_edges(d);
    if len(added) != 2 { panic(99072); };
    if added[0] != 10 { panic(99073); };
    if added[1] != 20 { panic(99074); };
}

@test "flat_deps_remove_edge_forwards_but_does_not_record"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    d = ecs_flat_deps_add_edge(d, 2, 3);
    if ecs_flat_deps_added_count(d) != 2 { panic(99080); };
    let r = ecs_flat_deps_remove_edge(d, 1, 2);
    d = r.0;
    if r.1 != true { panic(99081); };
    if ecs_flat_deps_edge_count(d) != 1 { panic(99082); };
    if ecs_flat_deps_contains_edge(d, 1, 2) != false { panic(99083); };
    // added_edges preserved (no record), per Bevy comment
    if ecs_flat_deps_added_count(d) != 2 { panic(99084); };
}

@test "flat_deps_remove_missing_edge_returns_false"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    let r = ecs_flat_deps_remove_edge(d, 9, 9);
    if r.1 != false { panic(99090); };
    if ecs_flat_deps_edge_count(r.0) != 1 { panic(99091); };
}

@test "flat_deps_toposort_acyclic"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    d = ecs_flat_deps_add_edge(d, 2, 3);
    let r = ecs_flat_deps_toposort(d);
    if r.0 != true { panic(99100); };
    let s = r.1;
    if len(s) != 3 { panic(99101); };
    if s[0] != 1 { panic(99102); };
    if s[1] != 2 { panic(99103); };
    if s[2] != 3 { panic(99104); };
}

@test "flat_deps_toposort_cycle_returns_false"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    d = ecs_flat_deps_add_edge(d, 2, 1);
    let r = ecs_flat_deps_toposort(d);
    if r.0 != false { panic(99110); };
}

@test "flat_deps_toposort_parallel_roots_order"() {
    // 0 -> 2 and 1 -> 2; both roots come before 2.
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 0, 2);
    d = ecs_flat_deps_add_edge(d, 1, 2);
    let r = ecs_flat_deps_toposort(d);
    if r.0 != true { panic(99120); };
    let s = r.1;
    if s[2] != 2 { panic(99121); };
}

@test "flat_deps_toposort_and_graph"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 5, 6);
    d = ecs_flat_deps_add_edge(d, 6, 7);
    let r = ecs_flat_deps_toposort_and_graph(d);
    if r.0 != true { panic(99130); };
    if len(r.1) != 3 { panic(99131); };
    if r.1[0] != 5 { panic(99132); };
    if len(r.2) != 3 { panic(99133); };
    // edges flattened: 4 ints (2 edges * 2 ends)
    if len(r.3) != 4 { panic(99134); };
    if r.3[0] != 5 || r.3[1] != 6 { panic(99135); };
    if r.3[2] != 6 || r.3[3] != 7 { panic(99136); };
}

@test "collapse_set_chain_strategy"() {
    let systems: Vec<i64> = Vec::new();
    systems.push(1);
    systems.push(2);
    systems.push(3);
    let edges = ecs_collapse_set_produce(systems, 0);
    // chain -> only (1,2) and (2,3)
    if len(edges) != 4 { panic(99140); };
    if edges[0] != 1 { panic(99141); };
    if edges[1] != 2 { panic(99142); };
    if edges[2] != 2 { panic(99143); };
    if edges[3] != 3 { panic(99144); };
}

@test "collapse_set_bucket_strategy"() {
    let systems: Vec<i64> = Vec::new();
    systems.push(1);
    systems.push(2);
    systems.push(3);
    let edges = ecs_collapse_set_produce(systems, 1);
    // bucket -> (1,2),(1,3),(2,3)
    if len(edges) != 6 { panic(99150); };
    if edges[0] != 1 { panic(99151); };
    if edges[1] != 2 { panic(99152); };
    if edges[2] != 1 { panic(99153); };
    if edges[3] != 3 { panic(99154); };
    if edges[4] != 2 { panic(99155); };
    if edges[5] != 3 { panic(99156); };
}

@test "collapse_set_single_system_produces_no_edges"() {
    let systems: Vec<i64> = Vec::new();
    systems.push(42);
    let edges = ecs_collapse_set_produce(systems, 0);
    if len(edges) != 0 { panic(99160); };
    let edges2 = ecs_collapse_set_produce(systems, 1);
    if len(edges2) != 0 { panic(99161); };
}

@test "flat_deps_apply_collapse_records_added_edges"() {
    let systems: Vec<i64> = Vec::new();
    systems.push(1);
    systems.push(2);
    systems.push(3);
    let edges = ecs_collapse_set_produce(systems, 0);
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_apply_collapse(d, edges);
    if ecs_flat_deps_edge_count(d) != 2 { panic(99170); };
    if ecs_flat_deps_added_count(d) != 2 { panic(99171); };
    if ecs_flat_deps_contains_edge(d, 1, 2) != true { panic(99172); };
    if ecs_flat_deps_contains_edge(d, 2, 3) != true { panic(99173); };
}

@test "dep_options_some_and_none"() {
    let some = ecs_dep_options_some(50);
    if ecs_dep_options_is_some(some) != true { panic(99180); };
    if ecs_dep_options_is_none(some) != false { panic(99181); };
    if ecs_dep_options_type_id(some) != 50 { panic(99182); };
    if ecs_dep_options_configured(some) != true { panic(99183); };
    let none = ecs_dep_options_none();
    if ecs_dep_options_is_none(none) != true { panic(99184); };
    if ecs_dep_options_is_some(none) != false { panic(99185); };
    if ecs_dep_options_configured(none) != false { panic(99186); };
}

@test "pass_add_dependency_system_to_system_records_edge"() {
    let d = ecs_flat_deps_new();
    let from = ecs_node_id_from_system_key(ecs_p_system_key_new(1));
    let to = ecs_node_id_from_system_key(ecs_p_system_key_new(2));
    d = ecs_pass_add_dependency(d, from, to, ecs_dep_options_none());
    if ecs_flat_deps_edge_count(d) != 1 { panic(99190); };
    if ecs_flat_deps_contains_edge(d, 1, 2) != true { panic(99191); };
}

@test "pass_add_dependency_set_endpoint_is_ignored_by_pass"() {
    // Bevy collapses set endpoints; the generic pass does not directly insert system->set edges
    // into the system DAG (collapse_set is the bridge). Modeled as: set-touched edges are skipped.
    let d = ecs_flat_deps_new();
    let from = ecs_node_id_from_system_key(ecs_p_system_key_new(1));
    let to = ecs_node_id_from_set_key(ecs_p_system_set_key_new(2));
    d = ecs_pass_add_dependency(d, from, to, ecs_dep_options_some(99));
    if ecs_flat_deps_edge_count(d) != 0 { panic(99200); };
    let from2 = ecs_node_id_from_set_key(ecs_p_system_set_key_new(3));
    let to2 = ecs_node_id_from_system_key(ecs_p_system_key_new(4));
    d = ecs_pass_add_dependency(d, from2, to2, ecs_dep_options_some(99));
    if ecs_flat_deps_edge_count(d) != 0 { panic(99201); };
}

@test "pass_obj_adapter_resolve_options_match"() {
    let type_ids: Vec<i64> = Vec::new();
    let values: Vec<EcsDependencyOptions> = Vec::new();
    type_ids.push(11);
    values.push(ecs_dep_options_some(11));
    type_ids.push(22);
    values.push(ecs_dep_options_some(22));
    let opt = ecs_pass_obj_adapter_resolve_options(type_ids, values, 22);
    if ecs_dep_options_is_some(opt) != true { panic(99210); };
    if ecs_dep_options_type_id(opt) != 22 { panic(99211); };
}

@test "pass_obj_adapter_resolve_options_missing_returns_none"() {
    let type_ids: Vec<i64> = Vec::new();
    let values: Vec<EcsDependencyOptions> = Vec::new();
    type_ids.push(11);
    values.push(ecs_dep_options_some(11));
    let opt = ecs_pass_obj_adapter_resolve_options(type_ids, values, 99);
    if ecs_dep_options_is_none(opt) != true { panic(99220); };
}

@test "pass_obj_adapter_constructors_and_accessors"() {
    let a = ecs_pass_obj_adapter_new(3, 777);
    if ecs_pass_obj_adapter_pass_kind(a) != 3 { panic(99230); };
    if ecs_pass_obj_adapter_edge_options_type_id(a) != 777 { panic(99231); };
}

@test "pass_obj_adapter_add_dependency_dispatches_through_options"() {
    let a = ecs_pass_obj_adapter_new(1, 555);
    let type_ids: Vec<i64> = Vec::new();
    let values: Vec<EcsDependencyOptions> = Vec::new();
    // No options registered -> the adapter resolves to None then dispatches the generic
    // add_dependency, which should still record a system->system edge.
    let d = ecs_flat_deps_new();
    let from = ecs_node_id_from_system_key(ecs_p_system_key_new(10));
    let to = ecs_node_id_from_system_key(ecs_p_system_key_new(20));
    d = ecs_pass_obj_adapter_add_dependency(a, d, type_ids, values, from, to);
    if ecs_flat_deps_edge_count(d) != 1 { panic(99240); };
    if ecs_flat_deps_contains_edge(d, 10, 20) != true { panic(99241); };
}

@test "pass_obj_adapter_collapse_set_accumulates_into_dependencies_to_add"() {
    let a = ecs_pass_obj_adapter_new(1, 555);
    let systems: Vec<i64> = Vec::new();
    systems.push(1);
    systems.push(2);
    systems.push(3);
    let out = ecs_pass_obj_adapter_collapse_set(a, ecs_p_system_set_key_new(99), systems, Vec::new(), Vec::new(), 0);
    if len(out) != 4 { panic(99250); };
    if out[0] != 1 { panic(99251); };
    if out[1] != 2 { panic(99252); };
    if out[2] != 2 { panic(99253); };
    if out[3] != 3 { panic(99254); };
}

@test "pass_build_result_ok_and_cycle"() {
    let ok = ecs_pass_build_result_ok(Vec::new());
    if ecs_pass_build_result_is_ok(ok) != true { panic(99260); };
    if ecs_pass_build_result_is_cycle(ok) != false { panic(99261); };
    let cycle = ecs_pass_build_result_cycle();
    if ecs_pass_build_result_is_cycle(cycle) != true { panic(99262); };
    if ecs_pass_build_result_is_ok(cycle) != false { panic(99263); };
}

@test "pass_build_result_custom"() {
    let r = ecs_pass_build_result_custom(9);
    if ecs_pass_build_result_is_custom(r) != true { panic(99270); };
    if ecs_pass_build_result_error_node(r) != 9 { panic(99271); };
    if len(ecs_pass_build_result_sorted(r)) != 0 { panic(99272); };
}

@test "pass_build_generic_acyclic"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    d = ecs_flat_deps_add_edge(d, 2, 3);
    let r = ecs_pass_build_generic(d);
    if ecs_pass_build_result_is_ok(r) != true { panic(99280); };
    let s = ecs_pass_build_result_sorted(r);
    if s[0] != 1 { panic(99281); };
    if s[2] != 3 { panic(99282); };
}

@test "pass_build_generic_cycle"() {
    let d = ecs_flat_deps_new();
    d = ecs_flat_deps_add_edge(d, 1, 2);
    d = ecs_flat_deps_add_edge(d, 2, 1);
    let r = ecs_pass_build_generic(d);
    if ecs_pass_build_result_is_cycle(r) != true { panic(99290); };
    if len(ecs_pass_build_result_sorted(r)) != 0 { panic(99291); };
}

@test "vec_contains_i64_helper"() {
    let v: Vec<i64> = Vec::new();
    v.push(1);
    v.push(3);
    v.push(5);
    if ecs_vec_contains_i64(v, 3) != true { panic(99300); };
    if ecs_vec_contains_i64(v, 4) != false { panic(99301); };
    if ecs_vec_contains_i64(v, 1) != true { panic(99302); };
    if ecs_vec_contains_i64(v, 5) != true { panic(99303); };
}
