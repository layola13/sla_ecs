@import "lib/entry_deep.sla"

// Batch 272: entry deep (src/world/entity_access/entry.rs).
// panic codes: 120400 – 120599.

@test "from_entity_vacant_and_occupied"() {
    let ent = ecs_entry_entity_deep_new(1);
    let e0 = ecs_entry_deep_from_entity(ent, 5);
    if ecs_entry_deep_is_vacant(e0) != true { panic(120400); };
    ent = ecs_entry_entity_deep_set(ent, 5, 50);
    let e1 = ecs_entry_deep_from_entity(ent, 5);
    if ecs_entry_deep_is_occupied(e1) != true { panic(120401); };
    if ecs_entry_deep_value(e1) != 50 { panic(120402); };
}

@test "and_modify_occupied"() {
    let ent = ecs_entry_entity_deep_new(2);
    ent = ecs_entry_entity_deep_set(ent, 3, 10);
    let e = ecs_entry_deep_from_entity(ent, 3);
    e = ecs_entry_deep_and_modify(e, 5);
    if ecs_entry_deep_value(e) != 15 { panic(120410); };
    ent = ecs_entry_deep_entity(e);
    if ecs_entry_entity_deep_get_value(ent, 3) != 15 { panic(120411); };
}

@test "and_modify_vacant_noop"() {
    let ent = ecs_entry_entity_deep_new(3);
    let e = ecs_entry_deep_from_entity(ent, 9);
    e = ecs_entry_deep_and_modify(e, 1);
    if ecs_entry_deep_is_vacant(e) != true { panic(120420); };
    if ecs_entry_entity_deep_contains(ecs_entry_deep_entity(e), 9) != false { panic(120421); };
}

@test "insert_entry_vacant_and_occupied"() {
    let ent = ecs_entry_entity_deep_new(4);
    let e = ecs_entry_deep_from_entity(ent, 1);
    let o = ecs_entry_deep_insert_entry(e, 7);
    if ecs_occupied_entry_deep_get(o) != 7 { panic(120430); };
    ent = ecs_occupied_entry_deep_entity(o);
    let e2 = ecs_entry_deep_from_entity(ent, 1);
    let o2 = ecs_entry_deep_insert_entry(e2, 8);
    if ecs_occupied_entry_deep_get(o2) != 8 { panic(120431); };
}

@test "or_insert_keeps_occupied"() {
    let ent = ecs_entry_entity_deep_new(5);
    ent = ecs_entry_entity_deep_set(ent, 2, 20);
    let e = ecs_entry_deep_from_entity(ent, 2);
    let o = ecs_entry_deep_or_insert(e, 99);
    if ecs_occupied_entry_deep_get(o) != 20 { panic(120440); };
}

@test "or_insert_vacant_inserts"() {
    let ent = ecs_entry_entity_deep_new(6);
    let e = ecs_entry_deep_from_entity(ent, 4);
    let o = ecs_entry_deep_or_insert(e, 40);
    if ecs_occupied_entry_deep_get(o) != 40 { panic(120450); };
    if ecs_entry_entity_deep_contains(ecs_occupied_entry_deep_entity(o), 4) != true { panic(120451); };
}

@test "or_default_and_or_insert_with"() {
    let ent = ecs_entry_entity_deep_new(7);
    let e = ecs_entry_deep_from_entity(ent, 6);
    let o = ecs_entry_deep_or_default(e);
    if ecs_occupied_entry_deep_get(o) != 0 { panic(120460); };
    ent = ecs_occupied_entry_deep_entity(o);
    // already occupied; with shouldn't replace
    let e2 = ecs_entry_deep_from_entity(ent, 6);
    let o2 = ecs_entry_deep_or_insert_with(e2, 12);
    if ecs_occupied_entry_deep_get(o2) != 0 { panic(120461); };
}

@test "occupied_insert_get_mut_into_mut"() {
    let ent = ecs_entry_entity_deep_new(8);
    ent = ecs_entry_entity_deep_set(ent, 1, 1);
    let e = ecs_entry_deep_from_entity(ent, 1);
    let o = ecs_entry_deep_as_occupied(e);
    o = ecs_occupied_entry_deep_insert(o, 33);
    if ecs_occupied_entry_deep_get(o) != 33 { panic(120470); };
    if ecs_occupied_entry_deep_get_mut(o) != 33 { panic(120471); };
    if ecs_occupied_entry_deep_into_mut(o) != 33 { panic(120472); };
}

@test "occupied_take_removes"() {
    let ent = ecs_entry_entity_deep_new(9);
    ent = ecs_entry_entity_deep_set(ent, 2, 22);
    ent = ecs_entry_entity_deep_set(ent, 3, 33);
    let e = ecs_entry_deep_from_entity(ent, 2);
    let o = ecs_entry_deep_as_occupied(e);
    let t = ecs_occupied_entry_deep_take(o);
    if ecs_occupied_take_value(t) != 22 { panic(120480); };
    ent = ecs_occupied_take_entity(t);
    if ecs_entry_entity_deep_contains(ent, 2) != false { panic(120481); };
    if ecs_entry_entity_deep_contains(ent, 3) != true { panic(120482); };
    if ecs_entry_entity_deep_len(ent) != 1 { panic(120483); };
}

@test "vacant_insert"() {
    let ent = ecs_entry_entity_deep_new(10);
    let e = ecs_entry_deep_from_entity(ent, 7);
    let v = ecs_entry_deep_as_vacant(e);
    let o = ecs_vacant_entry_deep_insert(v, 70);
    if ecs_occupied_entry_deep_get(o) != 70 { panic(120490); };
    if ecs_occupied_entry_deep_entity_id(o) != 10 { panic(120491); };
}
