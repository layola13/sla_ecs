@import "lib/query_world_query_deep.sla"

// Batch 260: query_world_query deep (src/query/world_query.rs).
// panic codes: 118000 – 118199.

@test "kinds_and_flags"() {
    let r = ecs_wqd_read(1);
    let w = ecs_wqd_write(2);
    let f = ecs_wqd_filter(3);
    let h = ecs_wqd_has(4);
    let ro = ecs_wqd_read_only(5);
    if ecs_wqd_is_read_only(r) != true { panic(118000); };
    if ecs_wqd_is_write(w) != true { panic(118001); };
    if ecs_wqd_is_filter(f) != true { panic(118002); };
    if ecs_wqd_is_filter(h) != true { panic(118003); };
    if ecs_wqd_is_read_only(ro) != true { panic(118004); };
    if ecs_wqd_component_id(w) != 2 { panic(118005); };
}

@test "dense_flag"() {
    let q = ecs_wqd_read(1);
    if ecs_wqd_is_dense(q) != true { panic(118010); };
    q = ecs_wqd_set_dense(q, false);
    if ecs_wqd_is_dense(q) != false { panic(118011); };
}

@test "update_component_access_matrix"() {
    let a = ecs_wqd_update_component_access(ecs_wqd_write(7));
    if ecs_wqd_access_read(a) != true { panic(118020); };
    if ecs_wqd_access_write(a) != true { panic(118021); };
    if ecs_wqd_access_filter(a) != false { panic(118022); };
    a = ecs_wqd_update_component_access(ecs_wqd_filter(8));
    if ecs_wqd_access_filter(a) != true { panic(118023); };
    if ecs_wqd_access_read(a) != false { panic(118024); };
    a = ecs_wqd_update_component_access(ecs_wqd_read(9));
    if ecs_wqd_access_read(a) != true { panic(118025); };
    if ecs_wqd_access_write(a) != false { panic(118026); };
    if ecs_wqd_access_component_id(a) != 9 { panic(118027); };
}

@test "fetch_ticks_and_row"() {
    let f = ecs_wqd_fetch_new(ecs_wqd_read(1), 10);
    f = ecs_wqd_fetch_set_last_run(f, 3);
    f = ecs_wqd_fetch_set_this_run(f, 5);
    f = ecs_wqd_fetch_set_table_row(f, 2);
    if ecs_wqd_fetch_value(f) != 10 { panic(118030); };
    if ecs_wqd_fetch_last_run(f) != 3 { panic(118031); };
    if ecs_wqd_fetch_this_run(f) != 5 { panic(118032); };
    if ecs_wqd_fetch_table_row(f) != 2 { panic(118033); };
    f = ecs_wqd_fetch_set_value(f, 99);
    if ecs_wqd_fetch_value(f) != 99 { panic(118034); };
}

@test "shrink_write_to_readonly"() {
    let f = ecs_wqd_fetch_new(ecs_wqd_write(4), 40);
    f = ecs_wqd_shrink_to_readonly(f);
    if ecs_wqd_fetch_kind(f) != ECS_WQD_READ_ONLY { panic(118040); };
    if ecs_wqd_fetch_value(f) != 40 { panic(118041); };
    if ecs_wqd_fetch_component_id(f) != 4 { panic(118042); };
}

@test "matches_component_rules"() {
    let f = ecs_wqd_filter(1);
    if ecs_wqd_matches_component(f, true) != true { panic(118050); };
    if ecs_wqd_matches_component(f, false) != false { panic(118051); };
    let h = ecs_wqd_has(1);
    if ecs_wqd_matches_component(h, false) != true { panic(118052); };
    let r = ecs_wqd_read(1);
    if ecs_wqd_matches_component(r, false) != false { panic(118053); };
}

@test "combine_dense"() {
    let a = ecs_wqd_read(1);
    let b = ecs_wqd_set_dense(ecs_wqd_write(2), false);
    if ecs_wqd_combine_dense(a, a) != true { panic(118060); };
    if ecs_wqd_combine_dense(a, b) != false { panic(118061); };
}

@test "has_update_access_is_filter"() {
    let a = ecs_wqd_update_component_access(ecs_wqd_has(3));
    if ecs_wqd_access_filter(a) != true { panic(118070); };
    if ecs_wqd_access_write(a) != false { panic(118071); };
}

@test "read_only_kind"() {
    let q = ecs_wqd_read_only(11);
    if ecs_wqd_kind(q) != ECS_WQD_READ_ONLY { panic(118080); };
    if ecs_wqd_is_write(q) != false { panic(118081); };
    let a = ecs_wqd_update_component_access(q);
    if ecs_wqd_access_read(a) != true { panic(118082); };
}

@test "fetch_kind_tracks_query"() {
    let f = ecs_wqd_fetch_new(ecs_wqd_filter(6), 0);
    if ecs_wqd_fetch_kind(f) != ECS_WQD_FILTER { panic(118090); };
    if ecs_wqd_fetch_component_id(f) != 6 { panic(118091); };
}
