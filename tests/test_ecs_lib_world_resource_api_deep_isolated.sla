@import "lib/world_resource_api_deep.sla"

// Batch 291: world_resource_api deep.
// panic codes: 124200 – 124399.

@test "insert_get_contains_remove"() {
    let w = ecs_wra_deep_new(1);
    let r = ecs_wra_deep_insert(w, 10, 100);
    if ecs_wra_set_ok(r) != true { panic(124200); };
    w = ecs_wra_set_world(r);
    if ecs_wra_deep_contains(w, 10) != true { panic(124201); };
    if ecs_wra_get_value(ecs_wra_deep_get(w, 10)) != 100 { panic(124202); };
    let rm = ecs_wra_deep_remove(w, 10);
    if ecs_wra_set_ok(rm) != true { panic(124203); };
    if ecs_wra_set_value(rm) != 100 { panic(124204); };
    w = ecs_wra_set_world(rm);
    if ecs_wra_deep_contains(w, 10) != false { panic(124205); };
}

@test "init_and_get_or_insert"() {
    let w = ecs_wra_deep_new(1);
    w = ecs_wra_set_world(ecs_wra_deep_init(w, 5));
    if ecs_wra_get_value(ecs_wra_deep_get(w, 5)) != 0 { panic(124210); };
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 5, 55));
    // init no-op when present
    w = ecs_wra_set_world(ecs_wra_deep_init(w, 5));
    if ecs_wra_get_value(ecs_wra_deep_get(w, 5)) != 55 { panic(124211); };
    let g = ecs_wra_deep_get_or_insert_with(w, 5, 999);
    if ecs_wra_set_value(g) != 55 { panic(124212); };
    w = ecs_wra_set_world(g);
    let g2 = ecs_wra_deep_get_or_insert_with(w, 6, 66);
    if ecs_wra_set_value(g2) != 66 { panic(124213); };
    w = ecs_wra_set_world(g2);
    if ecs_wra_deep_rlen(w) != 2 { panic(124214); };
}

@test "change_ticks_and_modify"() {
    let w = ecs_wra_deep_new(1);
    w = ecs_wra_deep_bump_tick(w); // tick=1
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 1, 10));
    if ecs_wra_deep_is_added(w, 1, 0, 1) != true { panic(124220); };
    if ecs_wra_deep_is_changed(w, 1, 0, 1) != true { panic(124221); };
    w = ecs_wra_deep_bump_tick(w); // tick=2
    w = ecs_wra_set_world(ecs_wra_deep_modify(w, 1, 5));
    if ecs_wra_get_value(ecs_wra_deep_get(w, 1)) != 15 { panic(124222); };
    // added stays at 1; changed now 2
    if ecs_wra_deep_is_added(w, 1, 1, 2) != false { panic(124223); };
    if ecs_wra_deep_is_changed(w, 1, 1, 2) != true { panic(124224); };
    let g = ecs_wra_deep_get(w, 1);
    if ecs_wra_get_add(g) != 1 { panic(124225); };
    if ecs_wra_get_ch(g) != 2 { panic(124226); };
}

@test "capacity_four_full"() {
    let w = ecs_wra_deep_new(1);
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 1, 1));
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 2, 2));
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 3, 3));
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 4, 4));
    if ecs_wra_deep_rlen(w) != 4 { panic(124230); };
    let full = ecs_wra_deep_insert(w, 5, 5);
    if ecs_wra_set_ok(full) != false { panic(124231); };
    if ecs_wra_set_err(full) != 2 { panic(124232); };
    // update existing still ok
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 2, 22));
    if ecs_wra_get_value(ecs_wra_deep_get(w, 2)) != 22 { panic(124233); };
}

@test "non_send_insert_thread_check"() {
    let w = ecs_wra_deep_new(5);
    w = ecs_wra_set_world(ecs_wra_deep_insert_non_send(w, 7, 70, 5));
    if ecs_wra_deep_contains_non_send(w, 7) != true { panic(124240); };
    if ecs_wra_get_value(ecs_wra_deep_get_non_send(w, 7)) != 70 { panic(124241); };
    if ecs_wra_deep_non_send_thread_ok(w, 7) != true { panic(124242); };
    w = ecs_wra_set_world(ecs_wra_deep_insert_non_send(w, 8, 80, 9));
    if ecs_wra_deep_non_send_thread_ok(w, 8) != false { panic(124243); };
    if ecs_wra_deep_nslen(w) != 2 { panic(124244); };
}

@test "non_send_init_remove"() {
    let w = ecs_wra_deep_new(1);
    w = ecs_wra_set_world(ecs_wra_deep_init_non_send(w, 3, 1));
    if ecs_wra_get_value(ecs_wra_deep_get_non_send(w, 3)) != 0 { panic(124250); };
    w = ecs_wra_set_world(ecs_wra_deep_insert_non_send(w, 3, 33, 1));
    let rm = ecs_wra_deep_remove_non_send(w, 3);
    if ecs_wra_set_ok(rm) != true { panic(124251); };
    if ecs_wra_set_value(rm) != 33 { panic(124252); };
    w = ecs_wra_set_world(rm);
    if ecs_wra_deep_contains_non_send(w, 3) != false { panic(124253); };
}

@test "resource_scope_extract_and_restore"() {
    let w = ecs_wra_deep_new(1);
    w = ecs_wra_deep_bump_tick(w);
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 9, 90));
    if ecs_wra_deep_contains(w, 9) != true { panic(124260); };
    let b = ecs_wra_deep_resource_scope_begin(w, 9);
    if ecs_wra_set_ok(b) != true { panic(124261); };
    if ecs_wra_set_value(b) != 90 { panic(124262); };
    w = ecs_wra_set_world(b);
    if ecs_wra_deep_scoped_active(w) != true { panic(124263); };
    if ecs_wra_deep_contains(w, 9) != false { panic(124264); };
    w = ecs_wra_set_world(ecs_wra_deep_resource_scope_set(w, 91));
    let e = ecs_wra_deep_resource_scope_end(w);
    if ecs_wra_set_ok(e) != true { panic(124265); };
    w = ecs_wra_set_world(e);
    if ecs_wra_deep_scoped_active(w) != false { panic(124266); };
    if ecs_wra_get_value(ecs_wra_deep_get(w, 9)) != 91 { panic(124267); };
}

@test "try_resource_scope_missing"() {
    let w = ecs_wra_deep_new(1);
    let m = ecs_wra_deep_try_resource_scope_begin(w, 99);
    if ecs_wra_set_ok(m) != false { panic(124270); };
    if ecs_wra_set_err(m) != 1 { panic(124271); };
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 1, 1));
    let b = ecs_wra_deep_resource_scope_begin(w, 1);
    w = ecs_wra_set_world(b);
    // nested scope fails
    let n = ecs_wra_deep_resource_scope_begin(w, 1);
    if ecs_wra_set_ok(n) != false { panic(124272); };
    if ecs_wra_set_err(n) != 3 { panic(124273); };
}

@test "remove_middle_and_multi"() {
    let w = ecs_wra_deep_new(1);
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 1, 10));
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 2, 20));
    w = ecs_wra_set_world(ecs_wra_deep_insert(w, 3, 30));
    w = ecs_wra_set_world(ecs_wra_deep_remove(w, 2));
    if ecs_wra_deep_rlen(w) != 2 { panic(124280); };
    if ecs_wra_deep_contains(w, 2) != false { panic(124281); };
    if ecs_wra_get_value(ecs_wra_deep_get(w, 1)) != 10 { panic(124282); };
    if ecs_wra_get_value(ecs_wra_deep_get(w, 3)) != 30 { panic(124283); };
}

@test "missing_ops"() {
    let w = ecs_wra_deep_new(1);
    if ecs_wra_get_ok(ecs_wra_deep_get(w, 1)) != false { panic(124290); };
    if ecs_wra_set_ok(ecs_wra_deep_remove(w, 1)) != false { panic(124291); };
    if ecs_wra_set_ok(ecs_wra_deep_modify(w, 1, 1)) != false { panic(124292); };
    if ecs_wra_deep_is_added(w, 1, 0, 1) != false { panic(124293); };
    if ecs_wra_deep_is_changed(w, 1, 0, 1) != false { panic(124294); };
}
