@import "lib/filtered_resource_builders.sla"

// Isolated tests for lib/filtered_resource_builders.sla — FilteredResourcesBuilder + FilteredResourcesMutBuilder. Bevy reference: src/world/filtered_resource.rs (gaps not in lib/filtered_resource.sla or lib/system_builder.sla).

@test "fr_builder_new_empty"() {
    let b = ecs_fr_builder_new(7);
    if ecs_fr_builder_world_id(b) != 7 { panic(91595); };
    if ecs_fr_builder_reads_count(b) != 0 { panic(91596); };
}

@test "fr_builder_add_read_by_id"() {
    let b = ecs_fr_builder_new(1);
    let b2 = ecs_fr_builder_add_read_by_id(b, 5);
    if ecs_fr_builder_reads_count(b2) != 1 { panic(91597); };
}

@test "fr_builder_add_read_aliases_by_id"() {
    let b = ecs_fr_builder_new(1);
    let b2 = ecs_fr_builder_add_read(b, 9);
    if ecs_fr_builder_reads_count(b2) != 1 { panic(91598); };
}

@test "fr_builder_add_read_all"() {
    let b = ecs_fr_builder_new(1);
    let b2 = ecs_fr_builder_add_read_all(b);
    if ecs_fr_builder_reads_count(b2) != 1 { panic(91599); };
    let acc = ecs_fr_builder_access(b2);
    if ecs_access_ops_read_at(acc, 0) != -1 { panic(91600); };
}

@test "fr_builder_build_yields_access"() {
    let b = ecs_fr_builder_new(1);
    let b2 = ecs_fr_builder_add_read_by_id(b, 3);
    let b3 = ecs_fr_builder_add_read_by_id(b2, 7);
    let acc = ecs_fr_builder_build(b3);
    if ecs_access_ops_reads_count(acc) != 2 { panic(91601); };
    if ecs_access_ops_read_at(acc, 0) != 3 { panic(91602); };
    if ecs_access_ops_read_at(acc, 1) != 7 { panic(91603); };
}

@test "frm_builder_new_empty"() {
    let b = ecs_frm_builder_new(11);
    if ecs_frm_builder_world_id(b) != 11 { panic(91604); };
    if ecs_frm_builder_reads_count(b) != 0 { panic(91605); };
    if ecs_frm_builder_writes_count(b) != 0 { panic(91606); };
}

@test "frm_builder_add_read_by_id"() {
    let b = ecs_frm_builder_new(1);
    let b2 = ecs_frm_builder_add_read_by_id(b, 5);
    if ecs_frm_builder_reads_count(b2) != 1 { panic(91607); };
    if ecs_frm_builder_writes_count(b2) != 0 { panic(91608); };
}

@test "frm_builder_add_write_by_id"() {
    let b = ecs_frm_builder_new(1);
    let b2 = ecs_frm_builder_add_write_by_id(b, 9);
    if ecs_frm_builder_writes_count(b2) != 1 { panic(91609); };
    if ecs_frm_builder_reads_count(b2) != 0 { panic(91610); };
}

@test "frm_builder_add_read_all"() {
    let b = ecs_frm_builder_new(1);
    let b2 = ecs_frm_builder_add_read_all(b);
    let acc = ecs_frm_builder_access(b2);
    if ecs_access_ops_read_at(acc, 0) != -1 { panic(91611); };
}

@test "frm_builder_add_write_all"() {
    let b = ecs_frm_builder_new(1);
    let b2 = ecs_frm_builder_add_write_all(b);
    let acc = ecs_frm_builder_access(b2);
    if ecs_access_ops_write_at(acc, 0) != -1 { panic(91612); };
}

@test "frm_builder_build_mixes_read_write"() {
    let b = ecs_frm_builder_new(1);
    let b2 = ecs_frm_builder_add_read_by_id(b, 3);
    let b3 = ecs_frm_builder_add_write_by_id(b2, 4);
    let acc = ecs_frm_builder_build(b3);
    if ecs_access_ops_reads_count(acc) != 1 { panic(91613); };
    if ecs_access_ops_writes_count(acc) != 1 { panic(91614); };
    if ecs_access_ops_read_at(acc, 0) != 3 { panic(91615); };
    if ecs_access_ops_write_at(acc, 0) != 4 { panic(91616); };
}

@test "fr_builder_dedup_read_does_not_grow"() {
    // Access ops push-dedup: re-adding the same id reuses the slot.
    let b = ecs_fr_builder_new(1);
    let b2 = ecs_fr_builder_add_read_by_id(b, 5);
    let b3 = ecs_fr_builder_add_read_by_id(b2, 5);
    if ecs_fr_builder_reads_count(b3) != 1 { panic(91617); };
}
