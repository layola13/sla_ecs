// Isolated deep tests for lib/reflect_component_deep.sla (Batch 408).
// Tests the deep reflect-component module: EcsReflectComponentDeep's cap-16 (entity,value)
// pairs, accessor + companion-field semantics of find, insert, apply, remove, take,
// contains, reflect, copy, plus cap-16 enforcement. Tuple-return replacements for remove,
// take, and reflect are read via the last_* accessor fns (no struct tuple unwrap).

@import "lib/reflect_component_deep.sla"

@test "new_and_id"() {
    let r = ecs_reflect_component_deep_new(7);
    if ecs_reflect_component_deep_id(r) != 7 { panic(146850); };
    if ecs_reflect_component_deep_count(r) != 0 { panic(146851); };
}

@test "insert_new_entity"() {
    let r = ecs_reflect_component_deep_new(1);
    let r2 = ecs_reflect_component_deep_insert(r, 100, 1000);
    if ecs_reflect_component_deep_count(r2) != 1 { panic(146852); };
    if ecs_reflect_component_deep_contains(r2, 100) != true { panic(146853); };
    let r3 = ecs_reflect_component_deep_reflect(r2, 100);
    if ecs_reflect_component_deep_last_reflect_present(r3) != true { panic(146854); };
    if ecs_reflect_component_deep_last_reflect_value(r3) != 1000 { panic(146855); };
}

@test "insert_existing_overwrites_value"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 10, 50);
    r = ecs_reflect_component_deep_insert(r, 10, 500);
    if ecs_reflect_component_deep_count(r) != 1 { panic(146856); };
    r = ecs_reflect_component_deep_reflect(r, 10);
    if ecs_reflect_component_deep_last_reflect_value(r) != 500 { panic(146857); };
}

@test "find_not_found_returns_neg1"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 10, 100);
    if ecs_reflect_component_deep_find(r, 11) != (0 - 1) { panic(146858); };
    if ecs_reflect_component_deep_find(r, 10) != 0 { panic(146859); };
}

@test "apply_aliases_insert"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_apply(r, 20, 200);
    if ecs_reflect_component_deep_contains(r, 20) != true { panic(146860); };
    r = ecs_reflect_component_deep_apply(r, 20, 2000);
    r = ecs_reflect_component_deep_reflect(r, 20);
    if ecs_reflect_component_deep_last_reflect_value(r) != 2000 { panic(146861); };
    if ecs_reflect_component_deep_count(r) != 1 { panic(146862); };
}

@test "apply_or_insert_mapped_aliases_insert"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_apply_or_insert_mapped(r, 30, 300);
    if ecs_reflect_component_deep_contains(r, 30) != true { panic(146863); };
    r = ecs_reflect_component_deep_apply_or_insert_mapped(r, 30, 3000);
    r = ecs_reflect_component_deep_reflect(r, 30);
    if ecs_reflect_component_deep_last_reflect_value(r) != 3000 { panic(146864); };
    if ecs_reflect_component_deep_count(r) != 1 { panic(146865); };
}

@test "remove_existing"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 10, 1);
    r = ecs_reflect_component_deep_insert(r, 11, 2);
    r = ecs_reflect_component_deep_insert(r, 12, 3);
    r = ecs_reflect_component_deep_remove(r, 11);
    if ecs_reflect_component_deep_last_remove_success(r) != true { panic(146866); };
    if ecs_reflect_component_deep_contains(r, 11) != false { panic(146867); };
    if ecs_reflect_component_deep_count(r) != 2 { panic(146868); };
    if ecs_reflect_component_deep_contains(r, 10) != true { panic(146869); };
    if ecs_reflect_component_deep_contains(r, 12) != true { panic(146870); };
}

@test "remove_missing_returns_false"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 10, 1);
    r = ecs_reflect_component_deep_remove(r, 99);
    if ecs_reflect_component_deep_last_remove_success(r) != false { panic(146871); };
    if ecs_reflect_component_deep_count(r) != 1 { panic(146872); };
}

@test "remove_same_backswap_keeps_others"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 1, 10);
    r = ecs_reflect_component_deep_insert(r, 2, 20);
    r = ecs_reflect_component_deep_insert(r, 3, 30);
    // remove last slot — no slot should compact; entities 1 and 2 must still hold their values.
    r = ecs_reflect_component_deep_remove(r, 3);
    if ecs_reflect_component_deep_last_remove_success(r) != true { panic(146873); };
    if ecs_reflect_component_deep_count(r) != 2 { panic(146874); };
    r = ecs_reflect_component_deep_reflect(r, 1);
    if ecs_reflect_component_deep_last_reflect_value(r) != 10 { panic(146875); };
    r = ecs_reflect_component_deep_reflect(r, 2);
    if ecs_reflect_component_deep_last_reflect_value(r) != 20 { panic(146876); };
}

@test "take_existing_returns_value"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 50, 9999);
    r = ecs_reflect_component_deep_take(r, 50);
    if ecs_reflect_component_deep_last_take_success(r) != true { panic(146877); };
    if ecs_reflect_component_deep_last_take_value(r) != 9999 { panic(146878); };
    if ecs_reflect_component_deep_contains(r, 50) != false { panic(146879); };
    if ecs_reflect_component_deep_count(r) != 0 { panic(146880); };
}

@test "take_missing_returns_false_value_zero"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_take(r, 77);
    if ecs_reflect_component_deep_last_take_success(r) != false { panic(146881); };
    if ecs_reflect_component_deep_last_take_value(r) != 0 { panic(146882); };
}

@test "contains_after_insert_and_remove"() {
    let r = ecs_reflect_component_deep_new(1);
    if ecs_reflect_component_deep_contains(r, 5) != false { panic(146883); };
    r = ecs_reflect_component_deep_insert(r, 5, 55);
    if ecs_reflect_component_deep_contains(r, 5) != true { panic(146884); };
    r = ecs_reflect_component_deep_remove(r, 5);
    if ecs_reflect_component_deep_contains(r, 5) != false { panic(146885); };
}

@test "reflect_present_and_missing"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 10, 200);
    r = ecs_reflect_component_deep_reflect(r, 10);
    if ecs_reflect_component_deep_last_reflect_present(r) != true { panic(146886); };
    if ecs_reflect_component_deep_last_reflect_value(r) != 200 { panic(146887); };
    r = ecs_reflect_component_deep_reflect(r, 99);
    if ecs_reflect_component_deep_last_reflect_present(r) != false { panic(146888); };
    if ecs_reflect_component_deep_last_reflect_value(r) != 0 { panic(146889); };
}

@test "copy_existing_source"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 1, 111);
    r = ecs_reflect_component_deep_copy(r, 1, 2);
    if ecs_reflect_component_deep_contains(r, 2) != true { panic(146890); };
    r = ecs_reflect_component_deep_reflect(r, 2);
    if ecs_reflect_component_deep_last_reflect_value(r) != 111 { panic(146891); };
    if ecs_reflect_component_deep_count(r) != 2 { panic(146892); };
}

@test "copy_missing_source_is_noop"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_copy(r, 1, 2);
    if ecs_reflect_component_deep_contains(r, 2) != false { panic(146893); };
    if ecs_reflect_component_deep_count(r) != 0 { panic(146894); };
}

@test "count_after_multiple_inserts"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 10, 100);
    r = ecs_reflect_component_deep_insert(r, 20, 200);
    r = ecs_reflect_component_deep_insert(r, 30, 300);
    r = ecs_reflect_component_deep_insert(r, 40, 400);
    if ecs_reflect_component_deep_count(r) != 4 { panic(146895); };
}

@test "cap16_enforced_overflow_silent"() {
    let r = ecs_reflect_component_deep_new(1);
    // Insert 16 distinct entities — exhausts the cap.
    r = ecs_reflect_component_deep_insert(r, 1, 1);
    r = ecs_reflect_component_deep_insert(r, 2, 2);
    r = ecs_reflect_component_deep_insert(r, 3, 3);
    r = ecs_reflect_component_deep_insert(r, 4, 4);
    r = ecs_reflect_component_deep_insert(r, 5, 5);
    r = ecs_reflect_component_deep_insert(r, 6, 6);
    r = ecs_reflect_component_deep_insert(r, 7, 7);
    r = ecs_reflect_component_deep_insert(r, 8, 8);
    r = ecs_reflect_component_deep_insert(r, 9, 9);
    r = ecs_reflect_component_deep_insert(r, 10, 10);
    r = ecs_reflect_component_deep_insert(r, 11, 11);
    r = ecs_reflect_component_deep_insert(r, 12, 12);
    r = ecs_reflect_component_deep_insert(r, 13, 13);
    r = ecs_reflect_component_deep_insert(r, 14, 14);
    r = ecs_reflect_component_deep_insert(r, 15, 15);
    r = ecs_reflect_component_deep_insert(r, 16, 16);
    if ecs_reflect_component_deep_count(r) != 16 { panic(146896); };
    // The 17th new entity is silently dropped by the cap guard.
    r = ecs_reflect_component_deep_insert(r, 17, 17);
    if ecs_reflect_component_deep_count(r) != 16 { panic(146897); };
    if ecs_reflect_component_deep_contains(r, 17) != false { panic(146898); };
}

@test "insert_after_take_does_not_resurrect_old_slot"() {
    let r = ecs_reflect_component_deep_new(1);
    r = ecs_reflect_component_deep_insert(r, 1, 11);
    r = ecs_reflect_component_deep_insert(r, 2, 22);
    r = ecs_reflect_component_deep_take(r, 1);
    // After take, slot 1 is backswapped: entity 2 should now occupy slot 0.
    if ecs_reflect_component_deep_count(r) != 1 { panic(146899); };
    r = ecs_reflect_component_deep_reflect(r, 2);
    if ecs_reflect_component_deep_last_reflect_value(r) != 22 { panic(146900); };
    // Insert a brand new entity — slot 1 is now free, count grows to 2.
    r = ecs_reflect_component_deep_insert(r, 3, 33);
    if ecs_reflect_component_deep_count(r) != 2 { panic(146901); };
    if ecs_reflect_component_deep_contains(r, 3) != true { panic(146902); };
    if ecs_reflect_component_deep_contains(r, 2) != true { panic(146903); };
}
