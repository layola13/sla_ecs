// Isolated deep tests for lib/commands_archetype_value_deep.sla (Batch 362).
// Kind-discriminated deferred command queue for ArchetypeValueWorld.
// panic codes: 138400 - 138599.

@import "lib/commands_archetype_value_deep.sla"

@test "ArchValueCommands new empty and side counts zero"() {
    let c = ecs_arch_value_commands_new();
    if ecs_arch_value_commands_len(c) != 0 { panic(138400); };
    if ecs_arch_value_commands_pcomp_count(c) != 0 { panic(138401); };
    if ecs_arch_value_commands_pres_count(c) != 0 { panic(138402); };
    if ecs_arch_value_commands_pmsg_count(c) != 0 { panic(138403); };
    if ecs_arch_value_commands_kind_at(c, 0) != 0 { panic(138404); };
    if ecs_arch_value_commands_entity_at(c, 0) != 0 { panic(138405); };
    if ecs_arch_value_commands_cmp_at(c, 0) != 0 { panic(138406); };
    if ecs_arch_value_commands_idx_at(c, 0) != 0 { panic(138407); };
}

@test "insert enqueues INSERT_COMPONENT with side payload"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_insert(c0, 7, 11, 100);
    if ecs_arch_value_commands_len(c1) != 1 { panic(138410); };
    if ecs_arch_value_commands_kind_at(c1, 0) != ECS_CMD_ARCH_VALUE_INSERT_COMPONENT { panic(138411); };
    if ecs_arch_value_commands_entity_at(c1, 0) != 7 { panic(138412); };
    if ecs_arch_value_commands_cmp_at(c1, 0) != 11 { panic(138413); };
    if ecs_arch_value_commands_idx_at(c1, 0) != 0 { panic(138414); };
    if ecs_arch_value_commands_pcomp_count(c1) != 1 { panic(138415); };
    if ecs_arch_value_commands_pcomp_at(c1, 0) != 100 { panic(138416); };
    if ecs_arch_value_commands_resolve_value(c1, 0) != 100 { panic(138417); };
}

@test "multiple insertions fill sequential slots side payloads"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_insert(c0, 1, 10, 50);
    let c2 = ecs_arch_value_commands_insert(c1, 2, 20, 60);
    let c3 = ecs_arch_value_commands_insert(c2, 3, 30, 70);
    if ecs_arch_value_commands_len(c3) != 3 { panic(138420); };
    if ecs_arch_value_commands_entity_at(c3, 0) != 1 { panic(138421); };
    if ecs_arch_value_commands_entity_at(c3, 1) != 2 { panic(138422); };
    if ecs_arch_value_commands_entity_at(c3, 2) != 3 { panic(138423); };
    if ecs_arch_value_commands_cmp_at(c3, 2) != 30 { panic(138424); };
    if ecs_arch_value_commands_resolve_value(c3, 0) != 50 { panic(138425); };
    if ecs_arch_value_commands_resolve_value(c3, 1) != 60 { panic(138426); };
    if ecs_arch_value_commands_resolve_value(c3, 2) != 70 { panic(138427); };
    if ecs_arch_value_commands_pcomp_count(c3) != 3 { panic(138428); };
}

@test "despawn enqueues DESPAWN with no side payload"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_despawn(c0, 9);
    if ecs_arch_value_commands_len(c1) != 1 { panic(138430); };
    if ecs_arch_value_commands_kind_at(c1, 0) != ECS_CMD_ARCH_VALUE_DESPAWN { panic(138431); };
    if ecs_arch_value_commands_entity_at(c1, 0) != 9 { panic(138432); };
    if ecs_arch_value_commands_cmp_at(c1, 0) != 0 { panic(138433); };
    if ecs_arch_value_commands_idx_at(c1, 0) != -1 { panic(138434); };
    if ecs_arch_value_commands_resolve_value(c1, 0) != 0 { panic(138435); };
    if ecs_arch_value_commands_pcomp_count(c1) != 0 { panic(138436); };
}

@test "insert_resource enqueues resource side payload"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_insert_resource(c0, 888);
    if ecs_arch_value_commands_len(c1) != 1 { panic(138440); };
    if ecs_arch_value_commands_kind_at(c1, 0) != ECS_CMD_ARCH_VALUE_INSERT_RESOURCE { panic(138441); };
    if ecs_arch_value_commands_pres_count(c1) != 1 { panic(138442); };
    if ecs_arch_value_commands_pres_at(c1, 0) != 888 { panic(138443); };
    if ecs_arch_value_commands_resolve_value(c1, 0) != 888 { panic(138444); };
}

@test "write_message enqueues message side payload"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_write_message(c0, 42);
    if ecs_arch_value_commands_len(c1) != 1 { panic(138450); };
    if ecs_arch_value_commands_kind_at(c1, 0) != ECS_CMD_ARCH_VALUE_WRITE_MESSAGE { panic(138451); };
    if ecs_arch_value_commands_pmsg_count(c1) != 1 { panic(138452); };
    if ecs_arch_value_commands_pmsg_at(c1, 0) != 42 { panic(138453); };
    if ecs_arch_value_commands_resolve_value(c1, 0) != 42 { panic(138454); };
}

@test "count_by_kind categorizes mixed queue"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_insert(c0, 1, 10, 1);
    let c2 = ecs_arch_value_commands_despawn(c1, 1);
    let c3 = ecs_arch_value_commands_insert(c2, 2, 10, 2);
    let c4 = ecs_arch_value_commands_insert_resource(c3, 9);
    let c5 = ecs_arch_value_commands_write_message(c4, 3);
    let c6 = ecs_arch_value_commands_despawn(c5, 2);
    if ecs_arch_value_commands_count_by_kind(c6, ECS_CMD_ARCH_VALUE_INSERT_COMPONENT) != 2 { panic(138460); };
    if ecs_arch_value_commands_count_by_kind(c6, ECS_CMD_ARCH_VALUE_DESPAWN) != 2 { panic(138461); };
    if ecs_arch_value_commands_count_by_kind(c6, ECS_CMD_ARCH_VALUE_INSERT_RESOURCE) != 1 { panic(138462); };
    if ecs_arch_value_commands_count_by_kind(c6, ECS_CMD_ARCH_VALUE_WRITE_MESSAGE) != 1 { panic(138463); };
    if ecs_arch_value_commands_len(c6) != 6 { panic(138464); };
}

@test "resolve_value across mixed kinds respects side-array mapping"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = ecs_arch_value_commands_insert(c0, 1, 10, 11);
    let c2 = ecs_arch_value_commands_insert_resource(c1, 22);
    let c3 = ecs_arch_value_commands_write_message(c2, 33);
    let c4 = ecs_arch_value_commands_despawn(c3, 5);
    let c5 = ecs_arch_value_commands_insert(c4, 2, 11, 44);
    // slot 0: comp 11, slot 1: res 22, slot 2: msg 33, slot 3: despawn 0, slot 4: comp 44
    if ecs_arch_value_commands_resolve_value(c5, 0) != 11 { panic(138470); };
    if ecs_arch_value_commands_resolve_value(c5, 1) != 22 { panic(138471); };
    if ecs_arch_value_commands_resolve_value(c5, 2) != 33 { panic(138472); };
    if ecs_arch_value_commands_resolve_value(c5, 3) != 0 { panic(138473); };
    if ecs_arch_value_commands_resolve_value(c5, 4) != 44 { panic(138474); };
    // side counts: pcomp 2, pres 1, pmsg 1
    if ecs_arch_value_commands_pcomp_count(c5) != 2 { panic(138475); };
    if ecs_arch_value_commands_pres_count(c5) != 1 { panic(138476); };
    if ecs_arch_value_commands_pmsg_count(c5) != 1 { panic(138477); };
}

@test "queue rejects at cap-8 and clear resets"() {
    let c0 = ecs_arch_value_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_arch_value_commands_insert(c1, i, i, 100 + i);
        i = i + 1;
    }
    if ecs_arch_value_commands_len(c1) != 8 { panic(138480); };
    if ecs_arch_value_commands_pcomp_count(c1) != 8 { panic(138481); };
    // exceeds cap-8 -> rejection
    let c2 = ecs_arch_value_commands_insert(c1, 99, 99, 999);
    if ecs_arch_value_commands_len(c2) != 8 { panic(138482); };
    let c3 = ecs_arch_value_commands_despawn(c2, 99);
    if ecs_arch_value_commands_len(c3) != 8 { panic(138483); };
    // clear
    let c4 = ecs_arch_value_commands_clear(c3);
    if ecs_arch_value_commands_len(c4) != 0 { panic(138484); };
    if ecs_arch_value_commands_pcomp_count(c4) != 0 { panic(138485); };
    if ecs_arch_value_commands_pres_count(c4) != 0 { panic(138486); };
    if ecs_arch_value_commands_pmsg_count(c4) != 0 { panic(138487); };
}

@test "reserve_entity yields placeholder id and builder helper"() {
    let c0 = ecs_arch_value_commands_new();
    let (c1, id) = ecs_arch_value_commands_reserve_entity(c0);
    if id != 0 { panic(138490); };
    if ecs_arch_value_commands_len(c1) != 0 { panic(138491); };
    // builder helper constructs a command struct
    let cmd = ecs_arch_value_command(ECS_CMD_ARCH_VALUE_INSERT_COMPONENT, 3, 7, 0);
    if ecs_arch_value_command_kind(cmd) != ECS_CMD_ARCH_VALUE_INSERT_COMPONENT { panic(138492); };
    if ecs_arch_value_command_entity_id(cmd) != 3 { panic(138493); };
    if ecs_arch_value_command_component_id(cmd) != 7 { panic(138494); };
    if ecs_arch_value_command_value_index(cmd) != 0 { panic(138495); };
}
