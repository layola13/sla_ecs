@import "lib/name_deep.sla"

// Batch 200b: Name / NameOrEntity deep.

@test "new_owned_with_hash"() {
    let n = ecs_nm_deep_new(10);
    if ecs_nm_deep_as_str(n) != 10 { panic(106000); };
    if ecs_nm_deep_is_owned(n) != true { panic(106001); };
    if ecs_nm_deep_hash(n) != ecs_nm_hash(10) { panic(106002); };
}

@test "from_static_borrowed"() {
    let n = ecs_nm_deep_from_static(5);
    if ecs_nm_deep_is_borrowed(n) != true { panic(106010); };
    if ecs_nm_deep_as_str(n) != 5 { panic(106011); };
}

@test "set_makes_owned_and_updates_hash"() {
    let n = ecs_nm_deep_from_static(1);
    n = ecs_nm_deep_set(n, 20);
    if ecs_nm_deep_is_owned(n) != true { panic(106020); };
    if ecs_nm_deep_as_str(n) != 20 { panic(106021); };
    if ecs_nm_deep_hash(n) != ecs_nm_hash(20) { panic(106022); };
    if ecs_nm_deep_set_count(n) != 1 { panic(106023); };
}

@test "mutate_borrowed_allocates_owned"() {
    let n = ecs_nm_deep_from_static(10);
    n = ecs_nm_deep_mutate(n, 5);
    if ecs_nm_deep_is_owned(n) != true { panic(106030); };
    if ecs_nm_deep_as_str(n) != 15 { panic(106031); };
    if ecs_nm_deep_mutate_count(n) != 1 { panic(106032); };
    if ecs_nm_deep_hash(n) != ecs_nm_hash(15) { panic(106033); };
}

@test "mutate_owned_in_place"() {
    let n = ecs_nm_deep_new(3);
    n = ecs_nm_deep_mutate(n, 2);
    if ecs_nm_deep_as_str(n) != 5 { panic(106040); };
    if ecs_nm_deep_is_owned(n) != true { panic(106041); };
}

@test "eq_by_content_not_ownership"() {
    let a = ecs_nm_deep_new(7);
    let b = ecs_nm_deep_from_static(7);
    if ecs_nm_deep_eq(a, b) != true { panic(106050); };
    if ecs_nm_deep_is_owned(a) == ecs_nm_deep_is_borrowed(b) { };
    if ecs_nm_deep_hash_consistent(a, b) != true { panic(106051); };
}

@test "display_code"() {
    let n = ecs_nm_deep_new(42);
    if ecs_nm_deep_display_code(n) != 42 { panic(106060); };
}

@test "name_or_entity_variants"() {
    let n = ecs_nm_or_name(3);
    if ecs_nm_or_is_name(n) != true { panic(106070); };
    if ecs_nm_or_name_value(n) != 3 { panic(106071); };
    let e = ecs_nm_or_entity(99);
    if ecs_nm_or_is_entity(e) != true { panic(106072); };
    if ecs_nm_or_entity_id(e) != 99 { panic(106073); };
}

@test "from_name"() {
    let name = ecs_nm_deep_new(8);
    let noe = ecs_nm_or_from_name(name);
    if ecs_nm_or_is_name(noe) != true { panic(106080); };
    if ecs_nm_or_name_value(noe) != 8 { panic(106081); };
}

@test "prefer_name_or_entity"() {
    let a = ecs_nm_or_prefer_name(true, 5, 10);
    if ecs_nm_or_is_name(a) != true { panic(106090); };
    let b = ecs_nm_or_prefer_name(false, 5, 10);
    if ecs_nm_or_is_entity(b) != true { panic(106091); };
    if ecs_nm_or_entity_id(b) != 10 { panic(106092); };
}

@test "or_display_codes"() {
    let n = ecs_nm_or_name(4);
    if ecs_nm_or_display_code(n) != 4 { panic(106100); };
    let e = ecs_nm_or_entity(6);
    if ecs_nm_or_display_code(e) != 1000000006 { panic(106101); };
}

@test "hash_function_deterministic"() {
    if ecs_nm_hash(1) != ecs_nm_hash(1) { panic(106110); };
    // different inputs should usually differ (not guaranteed but for our mixer)
    if ecs_nm_hash(1) == ecs_nm_hash(2) { panic(106111); };
}

@test "lifecycle_set_mutate"() {
    let n = ecs_nm_deep_from_static(1);
    n = ecs_nm_deep_set(n, 2);
    n = ecs_nm_deep_mutate(n, 3);
    if ecs_nm_deep_as_str(n) != 5 { panic(106120); };
    if ecs_nm_deep_set_count(n) != 1 { panic(106121); };
    if ecs_nm_deep_mutate_count(n) != 1 { panic(106122); };
    if ecs_nm_deep_is_owned(n) != true { panic(106123); };
}

@test "neq_names"() {
    let a = ecs_nm_deep_new(1);
    let b = ecs_nm_deep_new(2);
    if ecs_nm_deep_eq(a, b) != false { panic(106130); };
}

@test "ownership_accessors"() {
    let n = ecs_nm_deep_new(1);
    if ecs_nm_deep_ownership(n) != ECS_NM_OWNED { panic(106140); };
    let b = ecs_nm_deep_from_static(1);
    if ecs_nm_deep_ownership(b) != ECS_NM_BORROWED { panic(106141); };
}

@test "double_mutate"() {
    let n = ecs_nm_deep_new(0);
    n = ecs_nm_deep_mutate(n, 1);
    n = ecs_nm_deep_mutate(n, 1);
    if ecs_nm_deep_as_str(n) != 2 { panic(106150); };
    if ecs_nm_deep_mutate_count(n) != 2 { panic(106151); };
}
