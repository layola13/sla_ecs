@import "lib/world_identifier_deep.sla"

// Batch 202: WorldId deep (src/world/identifier.rs).

@test "new_allocates_monotonic_unique"() {
    let a = ecs_wid_alloc_new();
    let r0 = ecs_wid_new(a);
    a = r0.0;
    if r0.1 != true { panic(106400); };
    if ecs_wid_deep_get(r0.2) != 0 { panic(106401); };
    let r1 = ecs_wid_new(a);
    a = r1.0;
    if r1.1 != true { panic(106402); };
    if ecs_wid_deep_get(r1.2) != 1 { panic(106403); };
    if ecs_wid_deep_eq(r0.2, r1.2) != false { panic(106404); };
    if ecs_wid_alloc_issued(a) != 2 { panic(106405); };
    if ecs_wid_alloc_peek(a) != 2 { panic(106406); };
}

@test "batch_unique_50"() {
    let a = ecs_wid_alloc_new();
    let r = ecs_wid_batch_unique(a, 50);
    if r.1 != true { panic(106410); };
    if ecs_wid_alloc_issued(r.0) != 50 { panic(106411); };
    if ecs_wid_alloc_peek(r.0) != 50 { panic(106412); };
}

@test "never_reuse_after_drop"() {
    let a = ecs_wid_alloc_new();
    let r0 = ecs_wid_new(a);
    a = r0.0;
    let id0 = r0.2;
    a = ecs_wid_drop_id(a, id0);
    if ecs_wid_alloc_dropped(a) != 1 { panic(106420); };
    // next still advances only via new(); drop does not free
    let r1 = ecs_wid_new(a);
    a = r1.0;
    if ecs_wid_deep_get(r1.2) != 1 { panic(106421); };
    if ecs_wid_deep_eq(id0, r1.2) != false { panic(106422); };
    if ecs_wid_was_ever_issued(a, 0) != true { panic(106423); };
    if ecs_wid_was_ever_issued(a, 1) != true { panic(106424); };
    if ecs_wid_was_ever_issued(a, 2) != false { panic(106425); };
}

@test "exhausted_returns_none"() {
    // cap=2 means ids 0 and 1 only
    let a = ecs_wid_alloc_with_cap(2);
    let r0 = ecs_wid_new(a);
    a = r0.0;
    if r0.1 != true { panic(106430); };
    let r1 = ecs_wid_new(a);
    a = r1.0;
    if r1.1 != true { panic(106431); };
    let r2 = ecs_wid_new(a);
    if r2.1 != false { panic(106432); };
    // state unchanged on failure
    if ecs_wid_alloc_peek(r2.0) != 2 { panic(106433); };
    if ecs_wid_alloc_issued(r2.0) != 2 { panic(106434); };
}

@test "store_near_overflow_fails"() {
    let a = ecs_wid_alloc_new();
    a = ecs_wid_alloc_store_next(a, ECS_WID_USIZE_MAX);
    let r = ecs_wid_new(a);
    if r.1 != false { panic(106440); };
    if ecs_wid_alloc_peek(r.0) != ECS_WID_USIZE_MAX { panic(106441); };
}

@test "eq_ne_hash_lt"() {
    let a = ecs_wid_deep_from_raw(3);
    let b = ecs_wid_deep_from_raw(3);
    let c = ecs_wid_deep_from_raw(4);
    if ecs_wid_deep_eq(a, b) != true { panic(106450); };
    if ecs_wid_deep_ne(a, c) != true { panic(106451); };
    if ecs_wid_deep_lt(a, c) != true { panic(106452); };
    if ecs_wid_deep_lt(c, a) != false { panic(106453); };
    if ecs_wid_deep_hash(a) != 3 { panic(106454); };
    if ecs_wid_deep_hash(a) != ecs_wid_deep_hash(b) { panic(106455); };
}

@test "from_world_returns_world_id"() {
    let id = ecs_wid_deep_from_raw(9);
    let world = ecs_wid_world_handle(id);
    let got = ecs_wid_from_world(world);
    if ecs_wid_deep_eq(got, id) != true { panic(106460); };
    if ecs_wid_deep_get(ecs_wid_world_id(world)) != 9 { panic(106461); };
}

@test "system_param_readonly_no_access"() {
    if ecs_wid_sp_is_read_only() != true { panic(106470); };
    if ecs_wid_sp_init_access_touches_components() != false { panic(106471); };
    let state = ecs_wid_sp_init_state();
    let world = ecs_wid_world_handle(ecs_wid_deep_from_raw(12));
    let r = ecs_wid_sp_get_param(state, world);
    if r.0 != true { panic(106472); };
    if ecs_wid_deep_get(r.1) != 12 { panic(106473); };
}

@test "exclusive_system_param_captures_id"() {
    let world = ecs_wid_world_handle(ecs_wid_deep_from_raw(21));
    let state = ecs_wid_esp_init(world);
    let r = ecs_wid_esp_get_param(state);
    if r.0 != true { panic(106480); };
    if ecs_wid_deep_get(r.1) != 21 { panic(106481); };
}

@test "run_system_param_matches_world_id"() {
    let world = ecs_wid_world_handle(ecs_wid_deep_from_raw(33));
    let got = ecs_wid_run_system_param(world);
    if ecs_wid_deep_get(got) != 33 { panic(106490); };
    let got2 = ecs_wid_run_exclusive_system_param(world);
    if ecs_wid_deep_eq(got, got2) != true { panic(106491); };
}

@test "sparse_set_index_roundtrip"() {
    let w = ecs_wid_deep_from_raw(44);
    if ecs_wid_sparse_set_index(w) != 44 { panic(106500); };
    if ecs_wid_sparse_roundtrip(w) != true { panic(106501); };
    let back = ecs_wid_get_sparse_set_index(7);
    if ecs_wid_deep_get(back) != 7 { panic(106502); };
}

@test "alloc_with_zero_cap_always_none"() {
    let a = ecs_wid_alloc_with_cap(0);
    let r = ecs_wid_new(a);
    if r.1 != false { panic(106510); };
}

@test "cap_one_single_id"() {
    let a = ecs_wid_alloc_with_cap(1);
    let r0 = ecs_wid_new(a);
    a = r0.0;
    if r0.1 != true { panic(106520); };
    if ecs_wid_deep_get(r0.2) != 0 { panic(106521); };
    let r1 = ecs_wid_new(a);
    if r1.1 != false { panic(106522); };
}

@test "dropped_count_independent_of_issued"() {
    let a = ecs_wid_alloc_new();
    let r0 = ecs_wid_new(a);
    a = r0.0;
    let r1 = ecs_wid_new(a);
    a = r1.0;
    a = ecs_wid_drop_id(a, r0.2);
    a = ecs_wid_drop_id(a, r1.2);
    if ecs_wid_alloc_issued(a) != 2 { panic(106530); };
    if ecs_wid_alloc_dropped(a) != 2 { panic(106531); };
    // still can allocate next unique
    let r2 = ecs_wid_new(a);
    if ecs_wid_deep_get(r2.2) != 2 { panic(106532); };
}

@test "default_cap_is_usize_max_standin"() {
    let a = ecs_wid_alloc_new();
    if ecs_wid_alloc_cap(a) != ECS_WID_USIZE_MAX { panic(106540); };
}
