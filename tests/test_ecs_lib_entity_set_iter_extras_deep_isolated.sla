@import "lib/entity_set_iter_extras_deep.sla"

// Batch 331: entity_set_iter_extras deep.
// panic codes: 132200 – 132399.

@test "wrappers"() {
    let d = ecs_esi_direct(7);
    if ecs_esi_entity(d) != 7 { panic(132200); };
    if ecs_esi_kind(d) != 0 { panic(132201); };
    let r = ecs_esi_ref(d);
    if ecs_esi_kind(r) != 1 { panic(132202); };
    if ecs_esi_kind(ecs_esi_mut(d)) != 2 { panic(132203); };
    if ecs_esi_kind(ecs_esi_box(d)) != 3 { panic(132204); };
    if ecs_esi_kind(ecs_esi_rc(d)) != 4 { panic(132205); };
    if ecs_esi_kind(ecs_esi_arc(d)) != 5 { panic(132206); };
}

@test "same_and_cmp"() {
    let a = ecs_esi_direct(1);
    let b = ecs_esi_direct(1);
    let c = ecs_esi_direct(2);
    if ecs_esi_same(a, b) != true { panic(132210); };
    if ecs_esi_cmp(a, c) != (0 - 1) { panic(132211); };
    if ecs_esi_cmp(c, a) != 1 { panic(132212); };
    if ecs_esi_cmp(a, b) != 0 { panic(132213); };
}

@test "iter_next"() {
    let it = ecs_esi_iter_from4(1, 2, 3, 0, 3);
    if ecs_esi_iter_remaining(it) != 3 { panic(132220); };
    let n1 = ecs_esi_iter_next(it);
    if ecs_esi_next_entity(n1) != 1 { panic(132221); };
    let n2 = ecs_esi_iter_next(ecs_esi_next_iter(n1));
    if ecs_esi_next_entity(n2) != 2 { panic(132222); };
}

@test "iter_next_back"() {
    let it = ecs_esi_iter_from4(1, 2, 3, 0, 3);
    let n = ecs_esi_iter_next_back(it);
    if ecs_esi_next_entity(n) != 3 { panic(132230); };
    let n2 = ecs_esi_iter_next_back(ecs_esi_next_iter(n));
    if ecs_esi_next_entity(n2) != 2 { panic(132231); };
}

@test "iter_empty"() {
    let it = ecs_esi_iter_empty();
    if ecs_esi_iter_is_empty(it) != true { panic(132240); };
    let n = ecs_esi_iter_next(it);
    if ecs_esi_next_has(n) != false { panic(132241); };
}

@test "collect_set"() {
    let it = ecs_esi_iter_from4(4, 5, 6, 0, 3);
    let c = ecs_esi_collect_set(it);
    if ecs_esi_collect_len(c) != 3 { panic(132250); };
    if ecs_esi_collect_first(c) != 4 { panic(132251); };
    if ecs_esi_collect_at(c, 1) != 5 { panic(132252); };
    if ecs_esi_collect_contains(c, 6) != true { panic(132253); };
}

@test "collect_after_next"() {
    let it = ecs_esi_iter_from4(1, 2, 3, 0, 3);
    let n = ecs_esi_iter_next(it);
    let c = ecs_esi_collect_set(ecs_esi_next_iter(n));
    if ecs_esi_collect_len(c) != 2 { panic(132260); };
    if ecs_esi_collect_first(c) != 2 { panic(132261); };
}

@test "from_entity_set_iter"() {
    let it = ecs_esi_iter_from4(9, 8, 0, 0, 2);
    let c = ecs_esi_from_entity_set_iter(it);
    if ecs_esi_collect_len(c) != 2 { panic(132270); };
    if ecs_esi_collect_trusted(c) != 1 { panic(132271); };
}

@test "collect_contains_false"() {
    let c = ecs_esi_collect_set(ecs_esi_iter_from4(1, 0, 0, 0, 1));
    if ecs_esi_collect_contains(c, 2) != false { panic(132280); };
}

@test "both_ends_empty"() {
    let it = ecs_esi_iter_from4(1, 0, 0, 0, 1);
    let n = ecs_esi_iter_next(it);
    let it2 = ecs_esi_next_iter(n);
    if ecs_esi_iter_is_empty(it2) != true { panic(132290); };
    let b = ecs_esi_iter_next_back(it2);
    if ecs_esi_next_has(b) != false { panic(132291); };
}
