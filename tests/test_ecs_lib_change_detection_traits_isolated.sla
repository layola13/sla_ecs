@import "lib/change_detection_traits.sla"

// Isolated tests for lib/change_detection_traits.sla — DetectChanges + DetectChangesMut trait extensions
// Bevy reference: bevy_ecs/src/change_detection/traits.rs

@test "detect_ext_new"() {
    let d = ecs_detect_ext_new(5, 10, 3, 10, 42);
    if ecs_detect_ext_inner(d) != 42 { panic(83900); };
    if ecs_detect_ext_last_changed(d) != 10 { panic(83901); };
    if ecs_detect_ext_changed_by(d) != 0 { panic(83902); };
}

@test "detect_ext_is_added"() {
    let d = ecs_detect_ext_new(5, 10, 3, 10, 42);
    if ecs_detect_ext_is_added(d) != true { panic(83903); };
    let d2 = ecs_detect_ext_new(1, 2, 5, 10, 42);
    if ecs_detect_ext_is_added(d2) != false { panic(83904); };
}

@test "detect_ext_is_changed"() {
    let d = ecs_detect_ext_new(5, 10, 3, 10, 42);
    if ecs_detect_ext_is_changed(d) != true { panic(83905); };
    let d2 = ecs_detect_ext_new(1, 2, 5, 10, 42);
    if ecs_detect_ext_is_changed(d2) != false { panic(83906); };
}

@test "detect_ext_is_added_after"() {
    let d = ecs_detect_ext_new(10, 20, 3, 20, 42);
    if ecs_detect_ext_is_added_after(d, 5) != true { panic(83907); };
    if ecs_detect_ext_is_added_after(d, 10) != false { panic(83908); };
}

@test "detect_ext_is_changed_after"() {
    let d = ecs_detect_ext_new(10, 20, 3, 20, 42);
    if ecs_detect_ext_is_changed_after(d, 5) != true { panic(83909); };
    if ecs_detect_ext_is_changed_after(d, 20) != false { panic(83910); };
}

@test "detect_ext_set_last_changed"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let d2 = ecs_detect_ext_set_last_changed(d, 8);
    if ecs_detect_ext_last_changed(d2) != 8 { panic(83911); };
}

@test "detect_ext_set_last_added"() {
    let d = ecs_detect_ext_new(5, 10, 3, 10, 42);
    let d2 = ecs_detect_ext_set_last_added(d, 99);
    if ecs_detect_ext_added(d2) != 99 { panic(83912); };
}

@test "detect_ext_bypass_change_detection"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let d2 = ecs_detect_ext_bypass_change_detection(d, 99);
    if ecs_detect_ext_inner(d2) != 99 { panic(83913); };
    // Should NOT mark as changed
    if ecs_detect_ext_is_changed(d2) != false { panic(83914); };
}

@test "detect_ext_set_if_neq_changed"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let r = ecs_detect_ext_set_if_neq(d, 99);
    if r.1 != true { panic(83915); };
    if ecs_detect_ext_inner(r.0) != 99 { panic(83916); };
    if ecs_detect_ext_is_changed(r.0) != true { panic(83917); };
}

@test "detect_ext_set_if_neq_same"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let r = ecs_detect_ext_set_if_neq(d, 42);
    if r.1 != false { panic(83918); };
    if ecs_detect_ext_is_changed(r.0) != false { panic(83919); };
}

@test "detect_ext_replace_if_neq_changed"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let r = ecs_detect_ext_replace_if_neq(d, 99);
    if r.1 != true { panic(83920); };
    if r.2 != 42 { panic(83921); };
    if ecs_detect_ext_inner(r.0) != 99 { panic(83922); };
}

@test "detect_ext_replace_if_neq_same"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let r = ecs_detect_ext_replace_if_neq(d, 42);
    if r.1 != false { panic(83923); };
}

@test "detect_ext_clone_from_if_neq"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let r = ecs_detect_ext_clone_from_if_neq(d, 99);
    if r.1 != true { panic(83924); };
    if ecs_detect_ext_inner(r.0) != 99 { panic(83925); };
}

@test "detect_ext_clone_from_same"() {
    let d = ecs_detect_ext_new(5, 2, 3, 10, 42);
    let r = ecs_detect_ext_clone_from_if_neq(d, 42);
    if r.1 != false { panic(83926); };
}

@test "detect_ext_changed_by"() {
    let d = ecs_detect_ext_new(5, 10, 3, 10, 42);
    let d2 = ecs_detect_ext_set_changed_by(d, 99);
    if ecs_detect_ext_changed_by(d2) != 99 { panic(83927); };
}

@test "detect_ext_accessors"() {
    let d = ecs_detect_ext_new(5, 10, 3, 15, 42);
    if ecs_detect_ext_added(d) != 5 { panic(83928); };
    if ecs_detect_ext_last_run(d) != 3 { panic(83929); };
    if ecs_detect_ext_this_run(d) != 15 { panic(83930); };
}
