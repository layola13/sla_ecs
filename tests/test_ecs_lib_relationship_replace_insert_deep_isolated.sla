// Isolated deep tests for lib/relationship_replace_insert_deep.sla (Batch 360).
// panic codes: 138000 - 138199.

@import "lib/relationship_replace_insert_deep.sla"

fn push_into(b: EcsBatchRelatedDeep, e: i64) -> EcsBatchRelatedDeep {
    return ecs_batch_related_push(b, e);
}

@test "EcsReplaceInsert new starts empty no target"() {
    let r = ecs_ri_new();
    if ecs_ri_related_count(r) != 0 { panic(138000); };
    if ecs_ri_has_target(r) != false { panic(138001); };
    if ecs_ri_related_at(r, 0) != 0 { panic(138002); };
}

@test "insert_related appends new entities with order"() {
    let r0 = ecs_ri_new();
    let related = ecs_batch_related_new();
    related = push_into(related, 1);
    related = push_into(related, 2);
    let r1 = ecs_ri_insert_related(r0, 0, related);
    if ecs_ri_related_count(r1) != 2 { panic(138010); };
    if ecs_ri_related_at(r1, 0) != 1 { panic(138011); };
    if ecs_ri_related_at(r1, 1) != 2 { panic(138012); };
    if ecs_ri_has_target(r1) != true { panic(138013); };
}

@test "insert_related dedups existing entity, moves to target"() {
    let r0 = ecs_ri_new();
    let seed = ecs_batch_related_new();
    seed = push_into(seed, 1);
    seed = push_into(seed, 2);
    let r1 = ecs_ri_insert_related(r0, 0, seed);
    let more = ecs_batch_related_new();
    more = push_into(more, 3);
    more = push_into(more, 1);
    let r2 = ecs_ri_insert_related(r1, 1, more);
    // Entity 1 should no longer be duplicated and should appear at a later index.
    if ecs_ri_related_count(r2) != 3 { panic(138020); };
    if ecs_ri_contains(r2, 1) != true { panic(138021); };
    if ecs_ri_contains(r2, 3) != true { panic(138022); };
    if ecs_ri_contains(r2, 2) != true { panic(138023); };
}

@test "replace_related with new set overwrites"() {
    let r0 = ecs_ri_new();
    let seed = ecs_batch_related_new();
    seed = push_into(seed, 1);
    seed = push_into(seed, 2);
    let r1 = ecs_ri_insert_related(r0, 0, seed);
    let next = ecs_batch_related_new();
    next = push_into(next, 7);
    next = push_into(next, 9);
    let r2 = ecs_ri_replace_related(r1, next);
    if ecs_ri_related_count(r2) != 2 { panic(138030); };
    if ecs_ri_contains(r2, 7) != true { panic(138031); };
    if ecs_ri_contains(r2, 9) != true { panic(138032); };
    if ecs_ri_contains(r2, 1) != false { panic(138033); };
}

@test "replace_related empty detaches relationship"() {
    let r0 = ecs_ri_new();
    let seed = ecs_batch_related_new();
    seed = push_into(seed, 42);
    let r1 = ecs_ri_insert_related(r0, 0, seed);
    let r2 = ecs_ri_replace_related(r1, ecs_batch_related_new());
    if ecs_ri_related_count(r2) != 0 { panic(138040); };
    if ecs_ri_has_target(r2) != false { panic(138041); };
}

@test "replace_related dedups entries preserving first occurrence"() {
    let r0 = ecs_ri_new();
    let dup = ecs_batch_related_new();
    dup = push_into(dup, 1);
    dup = push_into(dup, 2);
    dup = push_into(dup, 1);
    let r1 = ecs_ri_replace_related(r0, dup);
    if ecs_ri_related_count(r1) != 2 { panic(138050); };
    if ecs_ri_related_at(r1, 0) != 1 { panic(138051); };
    if ecs_ri_related_at(r1, 1) != 2 { panic(138052); };
}

@test "replace_related_with_difference drops unrelate entries and unifies relate"() {
    let r0 = ecs_ri_new();
    let seed = ecs_batch_related_new();
    seed = push_into(seed, 1);
    seed = push_into(seed, 2);
    seed = push_into(seed, 3);
    let r1 = ecs_ri_insert_related(r0, 0, seed);
    let unrelate = ecs_batch_related_new();
    unrelate = push_into(unrelate, 2);
    let relate = ecs_batch_related_new();
    relate = push_into(relate, 4);
    let r2 = ecs_ri_replace_related_with_difference(r1, unrelate, relate);
    if ecs_ri_related_count(r2) != 3 { panic(138060); };
    if ecs_ri_contains(r2, 2) != false { panic(138061); };
    if ecs_ri_contains(r2, 1) != true { panic(138062); };
    if ecs_ri_contains(r2, 3) != true { panic(138063); };
    if ecs_ri_contains(r2, 4) != true { panic(138064); };
    if ecs_ri_has_target(r2) != true { panic(138065); };
}

@test "replace_related_with_difference dedups existing entries"() {
    let r0 = ecs_ri_new();
    // Manually create a related list with one entry, then run difference with empty unrelate
    // and identical relate to ensure dedup does not duplicate.
    let seed = ecs_batch_related_new();
    seed = push_into(seed, 1);
    let r1 = ecs_ri_insert_related(r0, 0, seed);
    let relate = ecs_batch_related_new();
    relate = push_into(relate, 1);
    let r2 = ecs_ri_replace_related_with_difference(r1, ecs_batch_related_new(), relate);
    if ecs_ri_related_count(r2) != 1 { panic(138070); };
    if ecs_ri_related_at(r2, 0) != 1 { panic(138071); };
}

@test "BatchRelated helpers push and len"() {
    let b = ecs_batch_related_new();
    if ecs_batch_related_len(b) != 0 { panic(138080); };
    let b1 = ecs_batch_related_push(b, 11);
    if ecs_batch_related_len(b1) != 1 { panic(138081); };
    if ecs_batch_related_at(b1, 0) != 11 { panic(138082); };
    let b2 = ecs_batch_related_push(b1, 22);
    let b3 = ecs_batch_related_push(b2, 33);
    let b4 = ecs_batch_related_push(b3, 44);
    let b_full = ecs_batch_related_push(b4, 99);
    if ecs_batch_related_len(b_full) != 4 { panic(138083); };
    if ecs_batch_related_at(b_full, 3) != 44 { panic(138084); };
}

@test "EcsReplaceInsert clear resets"() {
    let r0 = ecs_ri_new();
    let seed = ecs_batch_related_new();
    seed = push_into(seed, 1);
    let r1 = ecs_ri_insert_related(r0, 0, seed);
    if ecs_ri_related_count(r1) != 1 { panic(138090); };
    let r2 = ecs_ri_clear(r1);
    if ecs_ri_related_count(r2) != 0 { panic(138091); };
    if ecs_ri_has_target(r2) != false { panic(138092); };
}
