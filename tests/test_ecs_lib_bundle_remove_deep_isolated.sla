@import "lib/bundle_remove_deep.sla"

// Batch 230: bundle remove deep (src/bundle/remove.rs).
// panic codes: 112000 – 112199.

@test "sorted_remove_bevy_example"() {
    // a = [1..7], b = [1,2,3,5,7] => [4,6]
    let a = ecs_br_list_new();
    a = ecs_br_list_push(a, 1);
    a = ecs_br_list_push(a, 2);
    a = ecs_br_list_push(a, 3);
    a = ecs_br_list_push(a, 4);
    a = ecs_br_list_push(a, 5);
    a = ecs_br_list_push(a, 6);
    a = ecs_br_list_push(a, 7);
    let b = ecs_br_list_new();
    b = ecs_br_list_push(b, 1);
    b = ecs_br_list_push(b, 2);
    b = ecs_br_list_push(b, 3);
    b = ecs_br_list_push(b, 5);
    b = ecs_br_list_push(b, 7);
    let r = ecs_br_sorted_remove(a, b);
    if ecs_br_list_len(r) != 2 { panic(112000); };
    if ecs_br_list_at(r, 0) != 4 { panic(112001); };
    if ecs_br_list_at(r, 1) != 6 { panic(112002); };
}

@test "sorted_remove_all_and_none"() {
    let a = ecs_br_list_push(ecs_br_list_new(), 1);
    let b = ecs_br_list_push(ecs_br_list_new(), 1);
    let r = ecs_br_sorted_remove(a, b);
    if ecs_br_list_len(r) != 0 { panic(112010); };
    let r2 = ecs_br_sorted_remove(a, ecs_br_list_push(ecs_br_list_new(), 2));
    if ecs_br_list_len(r2) != 1 { panic(112011); };
    if ecs_br_list_at(r2, 0) != 1 { panic(112012); };
}

@test "remove_intersection_partial"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_new(1, 1);
    arch = ecs_br_archetype_add_table(arch, 1);
    arch = ecs_br_archetype_add_table(arch, 2);
    arch = ecs_br_archetype_add_sparse(arch, 10);
    w = ecs_br_world_spawn(w, 100, arch);
    let bundle = ecs_br_bundle_new(5);
    bundle = ecs_br_bundle_push(bundle, 1, ECS_BR_TABLE);
    bundle = ecs_br_bundle_push(bundle, 99, ECS_BR_TABLE); // missing — ok for intersection
    let rr = ecs_br_remover_new(w, 1, bundle, false);
    w = rr.0;
    let rem = rr.1;
    if ecs_br_remover_valid(rem) != true { panic(112020); };
    if ecs_br_world_created_count(w) != 1 { panic(112021); };
    if ecs_br_remover_table_move(rem) != true { panic(112022); };
}

@test "take_requires_all_fails"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_new(1, 1);
    arch = ecs_br_archetype_add_table(arch, 1);
    w = ecs_br_world_spawn(w, 1, arch);
    let bundle = ecs_br_bundle_push(ecs_br_bundle_new(3), 1, ECS_BR_TABLE);
    bundle = ecs_br_bundle_push(bundle, 2, ECS_BR_TABLE); // missing
    let rr = ecs_br_remover_new(w, 1, bundle, true);
    w = rr.0;
    if ecs_br_remover_valid(rr.1) != false { panic(112030); };
    // edge cached none
    let g = ecs_br_world_get_arch(w, 1);
    if g.1.take_edge_valid != true { panic(112031); };
    if g.1.take_edge_is_none != true { panic(112032); };
}

@test "remove_and_move_entity"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_new(1, 1);
    arch = ecs_br_archetype_add_table(arch, 1);
    arch = ecs_br_archetype_add_table(arch, 2);
    w = ecs_br_world_spawn(w, 7, arch);
    let bundle = ecs_br_bundle_push(ecs_br_bundle_new(9), 1, ECS_BR_TABLE);
    let rr = ecs_br_remover_new(w, 1, bundle, false);
    w = rr.0;
    let rem = rr.1;
    let out = ecs_br_remover_remove(w, rem, ecs_br_empty_pre_remove());
    w = out.0;
    rem = out.1;
    if ecs_br_world_entity_arch(w) != ecs_br_remover_new_arch(rem) { panic(112040); };
    if ecs_br_remover_removed_count(rem) != 1 { panic(112041); };
    if ecs_br_world_remove_triggers(w) != 1 { panic(112042); };
    if ecs_br_world_on_remove_hooks(w) != 1 { panic(112043); };
}

@test "pre_remove_false_despawns"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_add_table(ecs_br_archetype_new(1, 1), 1);
    w = ecs_br_world_spawn(w, 7, arch);
    let bundle = ecs_br_bundle_push(ecs_br_bundle_new(1), 1, ECS_BR_TABLE);
    let rr = ecs_br_remover_new(w, 1, bundle, false);
    w = rr.0;
    let out = ecs_br_remover_remove(w, rr.1, false);
    if out.0.entity_alive != false { panic(112050); };
    if ecs_br_world_remove_triggers(out.0) != 0 { panic(112051); };
}

@test "edge_cache_reuse"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_add_table(ecs_br_archetype_new(1, 1), 1);
    arch = ecs_br_archetype_add_table(arch, 2);
    w = ecs_br_world_spawn(w, 1, arch);
    let bundle = ecs_br_bundle_push(ecs_br_bundle_new(4), 1, ECS_BR_TABLE);
    let rr1 = ecs_br_remover_new(w, 1, bundle, false);
    w = rr1.0;
    if ecs_br_world_created_count(w) != 1 { panic(112060); };
    let rr2 = ecs_br_remover_new(w, 1, bundle, false);
    w = rr2.0;
    if ecs_br_world_created_count(w) != 1 { panic(112061); };
    if ecs_br_remover_new_arch(rr1.1) != ecs_br_remover_new_arch(rr2.1) { panic(112062); };
}

@test "sparse_only_no_table_move"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_new(1, 5);
    arch = ecs_br_archetype_add_table(arch, 1);
    arch = ecs_br_archetype_add_sparse(arch, 20);
    w = ecs_br_world_spawn(w, 1, arch);
    let bundle = ecs_br_bundle_push(ecs_br_bundle_new(2), 20, ECS_BR_SPARSE);
    let rr = ecs_br_remover_new(w, 1, bundle, true);
    if ecs_br_remover_valid(rr.1) != true { panic(112070); };
    if ecs_br_remover_table_move(rr.1) != false { panic(112071); };
}

@test "storage_constants"() {
    if ecs_br_storage_table() != 0 { panic(112080); };
    if ecs_br_storage_sparse() != 1 { panic(112081); };
}

@test "new_archetype_components"() {
    let w = ecs_br_world_new();
    let arch = ecs_br_archetype_new(1, 1);
    arch = ecs_br_archetype_add_table(arch, 1);
    arch = ecs_br_archetype_add_table(arch, 2);
    arch = ecs_br_archetype_add_table(arch, 3);
    w = ecs_br_world_spawn(w, 1, arch);
    let bundle = ecs_br_bundle_push(ecs_br_bundle_new(1), 2, ECS_BR_TABLE);
    let rr = ecs_br_remover_new(w, 1, bundle, false);
    w = rr.0;
    let g = ecs_br_world_get_arch(w, ecs_br_remover_new_arch(rr.1));
    if ecs_br_list_len(g.1.table_comps) != 2 { panic(112090); };
    if ecs_br_list_contains(g.1.table_comps, 2) != false { panic(112091); };
    if ecs_br_list_contains(g.1.table_comps, 1) != true { panic(112092); };
    if ecs_br_list_contains(g.1.table_comps, 3) != true { panic(112093); };
}
