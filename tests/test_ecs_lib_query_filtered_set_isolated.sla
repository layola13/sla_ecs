@import "lib/query_filtered_set.sla"

// Isolated tests for lib/query_filtered_set.sla — FilteredAccessSet (new/combined_access/filtered_accesses/is_compatible/get_conflicts/get_conflicts_single/add/add_resource_read/_write/add_unfiltered_read_all_components/add_unfiltered_write_all_components/extend/read_all/write_all/clear). Bevy reference: src/query/access.rs (gaps not in lib/query_access_ops.sla).

@test "fas_new_empty"() {
    let s = ecs_fas_new();
    if ecs_fas_filtered_accesses_count(s) != 0 { panic(91560); };
    if ecs_fas_combined_reads_count(s) != 0 { panic(91561); };
}

@test "fas_add_extends_combined"() {
    let s = ecs_fas_new();
    let fa = ecs_filtered_access_new();
    fa = ecs_filtered_access_add_read(fa, 5);
    let s2 = ecs_fas_add(s, fa);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91562); };
    if ecs_fas_combined_reads_count(s2) != 1 { panic(91563); };
}

@test "fas_add_resource_read"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_read(s, 7);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91564); };
    if ecs_fas_combined_reads_count(s2) != 1 { panic(91565); };
}

@test "fas_add_resource_write"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 9);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91566); };
    if ecs_fas_combined_writes_count(s2) != 1 { panic(91567); };
}

@test "fas_add_unfiltered_read_all_components"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_unfiltered_read_all_components(s);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91568); };
    if ecs_fas_combined_reads_count(s2) != 1 { panic(91569); };
}

@test "fas_add_unfiltered_write_all_components"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_unfiltered_write_all_components(s);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91570); };
    if ecs_fas_combined_writes_count(s2) != 1 { panic(91571); };
}

@test "fas_extend_unions_filtered_accesses"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_read(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_write(other, 2);
    let m = ecs_fas_extend(s2, other2);
    if ecs_fas_filtered_accesses_count(m) != 2 { panic(91572); };
    if ecs_fas_combined_reads_count(m) != 1 { panic(91573); };
    if ecs_fas_combined_writes_count(m) != 1 { panic(91574); };
}

@test "fas_read_all_adds_matches_everything_filter"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_read_all(s);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91575); };
    if ecs_fas_combined_reads_count(s2) != 1 { panic(91576); };
    let fa = ecs_fas_filtered_access_at(s2, 0);
    if !ecs_filtered_access_is_matching_everything(fa) { panic(91577); };
}

@test "fas_write_all_adds_matches_everything_filter"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_write_all(s);
    if ecs_fas_filtered_accesses_count(s2) != 1 { panic(91578); };
    let fa = ecs_fas_filtered_access_at(s2, 0);
    if !ecs_filtered_access_is_matching_everything(fa) { panic(91579); };
    if ecs_fas_combined_writes_count(s2) != 1 { panic(91580); };
}

@test "fas_clear_empties_set"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_read(s, 1);
    let s3 = ecs_fas_add_resource_write(s2, 2);
    let s4 = ecs_fas_clear(s3);
    if ecs_fas_filtered_accesses_count(s4) != 0 { panic(91581); };
    if ecs_fas_combined_reads_count(s4) != 0 { panic(91582); };
    if ecs_fas_combined_writes_count(s4) != 0 { panic(91583); };
}

@test "fas_is_compatible_disjoint_writes"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_write(other, 2);
    if !ecs_fas_is_compatible(s2, other2) { panic(91584); };
}

@test "fas_is_compatible_same_write_conflicts"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_write(other, 1);
    if ecs_fas_is_compatible(s2, other2) { panic(91585); };
}

@test "fas_is_compatible_write_vs_read_other_conflicts"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_read(other, 1);
    if ecs_fas_is_compatible(s2, other2) { panic(91586); };
}

@test "fas_is_compatible_shared_reads_compatible"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_read(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_read(other, 1);
    if !ecs_fas_is_compatible(s2, other2) { panic(91587); };
}

@test "fas_get_conflicts_no_conflict_when_compatible"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_read(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_read(other, 1);
    let c = ecs_fas_get_conflicts(s2, other2);
    if !ecs_access_conflicts_is_empty(c) { panic(91588); };
}

@test "fas_get_conflicts_writes_share_id"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_write(other, 1);
    let c = ecs_fas_get_conflicts(s2, other2);
    if ecs_access_conflicts_is_empty(c) { panic(91589); };
    if ecs_access_conflicts_at(c, 0) != 1 { panic(91590); };
}

@test "fas_get_conflicts_single_returned_ids"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 1);
    let fa = ecs_filtered_access_new();
    fa = ecs_filtered_access_add_read(fa, 1);
    let c = ecs_fas_get_conflicts_single(s2, fa);
    if ecs_access_conflicts_is_empty(c) { panic(91591); };
    if ecs_access_conflicts_at(c, 0) != 1 { panic(91592); };
}

@test "fas_get_conflicts_single_no_conflict_when_compatible"() {
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_read(s, 1);
    let fa = ecs_filtered_access_new();
    fa = ecs_filtered_access_add_read(fa, 1);
    let c = ecs_fas_get_conflicts_single(s2, fa);
    if !ecs_access_conflicts_is_empty(c) { panic(91593); };
}

@test "fas_fine_grained_pair_compatibility"() {
    // coarse-incompatible (both write id 1) but each pair mutually-exclusive — model has no With/Without so coarse determines; still conflicts.
    let s = ecs_fas_new();
    let s2 = ecs_fas_add_resource_write(s, 1);
    let other = ecs_fas_new();
    let other2 = ecs_fas_add_resource_read(other, 1);
    // expect conflict at id 1 (write vs read is incompatible)
    let c = ecs_fas_get_conflicts(s2, other2);
    if ecs_access_conflicts_count(c) < 1 { panic(91594); };
}
