@import "lib/removed_component_messages_deep.sla"

// Batch 268: removed_component_messages deep (src/lifecycle.rs RemovedComponentMessages).
// panic codes: 119600 – 119799.

@test "new_empty"() {
    let s = ecs_rcmd_new();
    if ecs_rcmd_buckets(s) != 0 { panic(119600); };
    if ecs_rcmd_iter_count(s) != 0 { panic(119601); };
    let g = ecs_rcmd_get(s, 1);
    if ecs_rcmd_get_has(g) != false { panic(119602); };
}

@test "write_creates_bucket_and_appends"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 10, 41);
    s = ecs_rcmd_write(s, 10, 42);
    if ecs_rcmd_buckets(s) != 1 { panic(119610); };
    let g = ecs_rcmd_get(s, 10);
    if ecs_rcmd_get_has(g) != true { panic(119611); };
    if ecs_rcmd_get_count(g) != 2 { panic(119612); };
    if ecs_rcmd_get_first_entity(g) != 41 { panic(119613); };
    if ecs_rcmd_get_message_count(g) != 2 { panic(119614); };
}

@test "distinct_component_buckets"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 1, 100);
    s = ecs_rcmd_write(s, 2, 200);
    if ecs_rcmd_buckets(s) != 2 { panic(119620); };
    let p0 = ecs_rcmd_iter_pair(s, 0);
    let p1 = ecs_rcmd_iter_pair(s, 1);
    if ecs_rcmd_pair_id(p0) != 1 { panic(119621); };
    if ecs_rcmd_pair_id(p1) != 2 { panic(119622); };
    if ecs_rcmd_pair_count(p0) != 1 { panic(119623); };
}

@test "update_swaps_buffers"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 5, 7);
    s = ecs_rcmd_write(s, 5, 8);
    s = ecs_rcmd_update(s);
    let b = ecs_rcmd_get_bucket(s, 0);
    if ecs_rcmd_bucket_a_len(b) != 2 { panic(119630); };
    if ecs_rcmd_bucket_b_len(b) != 0 { panic(119631); };
    // new writes go to B
    s = ecs_rcmd_write(s, 5, 9);
    b = ecs_rcmd_get_bucket(s, 0);
    if ecs_rcmd_bucket_b_len(b) != 1 { panic(119632); };
    if ecs_rcmd_bucket_len(b) != 3 { panic(119633); };
}

@test "double_update_drops_oldest"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 3, 1);
    s = ecs_rcmd_update(s);
    s = ecs_rcmd_write(s, 3, 2);
    s = ecs_rcmd_update(s);
    let b = ecs_rcmd_get_bucket(s, 0);
    if ecs_rcmd_bucket_a_len(b) != 1 { panic(119640); };
    if ecs_rcmd_bucket_oldest(b) != 1 { panic(119641); };
    if ecs_rcmd_bucket_entity_at(b, 0) != 2 { panic(119642); };
    let g = ecs_rcmd_get(s, 3);
    if ecs_rcmd_get_count(g) != 1 { panic(119643); };
}

@test "reader_len_and_read"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 9, 50);
    s = ecs_rcmd_write(s, 9, 51);
    let r = ecs_rcmd_reader_new(9);
    if ecs_rcmd_reader_len(r, s) != 2 { panic(119650); };
    if ecs_rcmd_reader_is_empty(r, s) != false { panic(119651); };
    let rr0 = ecs_rcmd_reader_read(r, s);
    r = ecs_rcmd_read_reader(rr0);
    if ecs_rcmd_read_has(rr0) != true { panic(119652); };
    if ecs_rcmd_read_entity(rr0) != 50 { panic(119653); };
    if ecs_rcmd_read_id(rr0) != 0 { panic(119654); };
    let rr1 = ecs_rcmd_reader_read(r, s);
    r = ecs_rcmd_read_reader(rr1);
    if ecs_rcmd_read_entity(rr1) != 51 { panic(119655); };
    if ecs_rcmd_reader_is_empty(r, s) != true { panic(119656); };
}

@test "reader_clear_skips_unread"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 4, 10);
    s = ecs_rcmd_write(s, 4, 11);
    let r = ecs_rcmd_reader_new(4);
    r = ecs_rcmd_reader_clear(r, s);
    if ecs_rcmd_reader_is_empty(r, s) != true { panic(119660); };
    let rr = ecs_rcmd_reader_read(r, s);
    if ecs_rcmd_read_has(rr) != false { panic(119661); };
}

@test "reader_survives_update"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 6, 70);
    let r = ecs_rcmd_reader_new(6);
    // unread before update
    if ecs_rcmd_reader_len(r, s) != 1 { panic(119670); };
    s = ecs_rcmd_update(s);
    // still readable from A after one update
    if ecs_rcmd_reader_len(r, s) != 1 { panic(119671); };
    let rr = ecs_rcmd_reader_read(r, s);
    if ecs_rcmd_read_entity(rr) != 70 { panic(119672); };
}

@test "reader_misses_after_double_update"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 7, 80);
    let r = ecs_rcmd_reader_new(7);
    s = ecs_rcmd_update(s);
    s = ecs_rcmd_update(s);
    // message dropped; clamp last and report empty
    if ecs_rcmd_reader_len(r, s) != 0 { panic(119680); };
    let rr = ecs_rcmd_reader_read(r, s);
    if ecs_rcmd_read_has(rr) != false { panic(119681); };
}

@test "read_with_id_matches_read"() {
    let s = ecs_rcmd_new();
    s = ecs_rcmd_write(s, 8, 90);
    let r = ecs_rcmd_reader_new(8);
    let rr = ecs_rcmd_reader_read_with_id(r, s);
    if ecs_rcmd_read_has(rr) != true { panic(119690); };
    if ecs_rcmd_read_entity(rr) != 90 { panic(119691); };
    if ecs_rcmd_read_id(rr) != 0 { panic(119692); };
}
