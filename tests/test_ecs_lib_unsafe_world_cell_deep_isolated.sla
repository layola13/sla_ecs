@import "lib/unsafe_world_cell_deep.sla"

// Batch 251: unsafe_world_cell deep (src/world/unsafe_world_cell.rs).
// panic codes: 116200 – 116399.

@test "readonly_vs_mutable_mode"() {
    let r = ecs_uwc_deep_new_readonly(1);
    let m = ecs_uwc_deep_new_mutable(1);
    if ecs_uwc_deep_is_mutable(r) != false { panic(116200); };
    if ecs_uwc_deep_is_mutable(m) != true { panic(116201); };
    if ecs_uwc_deep_assert_mutable(r) != false { panic(116202); };
    if ecs_uwc_deep_assert_mutable(m) != true { panic(116203); };
    if ecs_uwc_deep_id(r) != 1 { panic(116204); };
}

@test "ticks_and_counts"() {
    let c = ecs_uwc_deep_new_mutable(2);
    c = ecs_uwc_deep_set_counts(c, 3, 4, 5, 6);
    c = ecs_uwc_deep_set_last_change_tick(c, 9);
    c = ecs_uwc_deep_increment_change_tick(c);
    c = ecs_uwc_deep_increment_trigger_id(c);
    if ecs_uwc_deep_entity_count(c) != 3 { panic(116210); };
    if ecs_uwc_deep_archetype_count(c) != 4 { panic(116211); };
    if ecs_uwc_deep_component_count(c) != 5 { panic(116212); };
    if ecs_uwc_deep_bundle_count(c) != 6 { panic(116213); };
    if ecs_uwc_deep_change_tick(c) != 1 { panic(116214); };
    if ecs_uwc_deep_last_change_tick(c) != 9 { panic(116215); };
    if ecs_uwc_deep_last_trigger_id(c) != 1 { panic(116216); };
}

@test "get_entity_spawned_gate"() {
    let c = ecs_uwc_deep_new_readonly(3);
    c = ecs_uwc_deep_set_counts(c, 2, 0, 0, 0);
    let ok = ecs_uwc_deep_get_entity(c, 1);
    let bad = ecs_uwc_deep_get_entity(c, 2);
    if ecs_uwc_entity_result_ok(ok) != true { panic(116220); };
    if ecs_uwc_entity_result_ok(bad) != false { panic(116221); };
    if ecs_uwc_entity_result_kind(bad) != ECS_UWC_ENTITY_NOT_SPAWNED { panic(116222); };
}

@test "resource_get_and_mut"() {
    let c = ecs_uwc_deep_new_mutable(4);
    c = ecs_uwc_deep_insert_resource(c, 10, 100);
    c = ecs_uwc_deep_insert_resource(c, 11, 110);
    let g = ecs_uwc_deep_get_resource_by_id(c, 10);
    if ecs_uwc_res_result_ok(g) != true { panic(116230); };
    if ecs_uwc_res_result_value(g) != 100 { panic(116231); };
    let miss = ecs_uwc_deep_get_resource_by_id(c, 99);
    if ecs_uwc_res_result_kind(miss) != ECS_UWC_RES_MISSING { panic(116232); };
    let mu = ecs_uwc_deep_get_resource_mut_by_id(c, 10, 101);
    c = ecs_uwc_res_result_cell(mu);
    if ecs_uwc_res_result_value(mu) != 101 { panic(116233); };
    g = ecs_uwc_deep_get_resource_by_id(c, 10);
    if ecs_uwc_res_result_value(g) != 101 { panic(116234); };
}

@test "resource_mut_forbidden_on_readonly"() {
    let c = ecs_uwc_deep_new_readonly(5);
    c = ecs_uwc_deep_insert_resource(c, 1, 7);
    let mu = ecs_uwc_deep_get_resource_mut_by_id(c, 1, 8);
    if ecs_uwc_res_result_kind(mu) != ECS_UWC_RES_FORBIDDEN_MUT { panic(116240); };
    let g = ecs_uwc_deep_get_resource_by_id(c, 1);
    if ecs_uwc_res_result_value(g) != 7 { panic(116241); };
}

@test "entity_cell_contains_and_get"() {
    let w = ecs_uwc_deep_new_mutable(6);
    w = ecs_uwc_deep_set_counts(w, 1, 0, 0, 0);
    let e = ecs_uec_deep_new(w, 0);
    e = ecs_uec_deep_insert(e, 3, 30);
    e = ecs_uec_deep_insert(e, 4, 40);
    if ecs_uec_deep_contains_id(e, 3) != true { panic(116250); };
    if ecs_uec_deep_contains_id(e, 9) != false { panic(116251); };
    let g = ecs_uec_deep_get_by_id(e, 4);
    if ecs_uec_comp_result_ok(g) != true { panic(116252); };
    if ecs_uec_comp_result_value(g) != 40 { panic(116253); };
    if ecs_uec_deep_len(e) != 2 { panic(116254); };
}

@test "entity_cell_get_mut"() {
    let w = ecs_uwc_deep_new_mutable(7);
    let e = ecs_uec_deep_new(w, 0);
    e = ecs_uec_deep_insert(e, 1, 10);
    let mu = ecs_uec_deep_get_mut_by_id(e, 1, 11);
    e = ecs_uec_comp_result_cell(mu);
    if ecs_uec_comp_result_value(mu) != 11 { panic(116260); };
    let g = ecs_uec_deep_get_by_id(e, 1);
    if ecs_uec_comp_result_value(g) != 11 { panic(116261); };
}

@test "entity_cell_mut_forbidden_readonly"() {
    let w = ecs_uwc_deep_new_readonly(8);
    let e = ecs_uec_deep_new(w, 0);
    e = ecs_uec_deep_insert(e, 2, 20);
    let mu = ecs_uec_deep_get_mut_by_id(e, 2, 21);
    if ecs_uec_comp_result_kind(mu) != ECS_UWC_COMP_FORBIDDEN_MUT { panic(116270); };
}

@test "entity_cell_missing_component"() {
    let w = ecs_uwc_deep_new_mutable(9);
    let e = ecs_uec_deep_new(w, 1);
    let g = ecs_uec_deep_get_by_id(e, 5);
    if ecs_uec_comp_result_kind(g) != ECS_UWC_COMP_MISSING { panic(116280); };
    let mu = ecs_uec_deep_get_mut_by_id(e, 5, 1);
    if ecs_uec_comp_result_kind(mu) != ECS_UWC_COMP_MISSING { panic(116281); };
    if ecs_uec_deep_id(e) != 1 { panic(116282); };
    if ecs_uec_deep_world_id(e) != 9 { panic(116283); };
}

@test "metadata_access_and_spawn_tick"() {
    let w = ecs_uwc_deep_new_readonly(10);
    w = ecs_uwc_deep_increment_change_tick(w);
    w = ecs_uwc_deep_increment_change_tick(w);
    if ecs_uwc_deep_metadata_ok(w) != true { panic(116290); };
    let e = ecs_uec_deep_new(w, 0);
    if ecs_uec_deep_spawn_tick(e) != 2 { panic(116291); };
}
