@import "lib/relationship_methods_extras.sla"

// Isolated tests for lib/relationship_methods_extras.sla — EntityWorldMut/EntityCommands related-methods gaps:
// add_one_related + detach_all_related + despawn_related + despawn_children + with_related +
// with_related_entities + insert_recursive + remove_recursive. Bevy: src/relationship/related_methods.rs.

const REL_ID: i32 = 1;
const BUNDLE_A: i32 = 501;
const BUNDLE_B: i32 = 502;
const ENT_SELF: i64 = 9000;
const ENT_1: i64 = 9001;
const ENT_2: i64 = 9002;
const ENT_3: i64 = 9003;

@test "extras_entity_id_preserved"() {
    let r = ecs_related_extras_new(ENT_SELF);
    if ecs_related_extras_entity(r) != ENT_SELF { panic(91834); };
    if ecs_related_extras_related_count(r) != 0 { panic(91835); };
}

@test "extras_add_one_related_grows_list"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    if ecs_related_extras_related_count(r1) != 1 { panic(91836); };
    if ecs_related_extras_related_at(r1, 0) != ENT_1 { panic(91837); };
}

@test "extras_add_one_related_idempotent"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_1);
    if ecs_related_extras_related_count(r2) != 1 { panic(91838); };
}

@test "extras_add_one_related_distinct"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    if ecs_related_extras_related_count(r2) != 2 { panic(91839); };
    if ecs_related_extras_related_at(r2, 0) != ENT_1 { panic(91840); };
    if ecs_related_extras_related_at(r2, 1) != ENT_2 { panic(91841); };
}

@test "extras_related_at_oob"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    if ecs_related_extras_related_at(r1, -1) != -1 { panic(91842); };
    if ecs_related_extras_related_at(r1, 5) != -1 { panic(91843); };
}

@test "extras_detach_all_related_clears"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    let r3 = ecs_related_extras_detach_all_related(r2, REL_ID);
    if ecs_related_extras_related_count(r3) != 0 { panic(91844); };
}

@test "extras_detach_all_noop_when_empty"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_detach_all_related(r0, REL_ID);
    if ecs_related_extras_related_count(r1) != 0 { panic(91845); };
}

@test "extras_despawn_related_returns_count_and_first"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    let res = ecs_related_extras_despawn_related(r2, REL_ID);
    if ecs_relate_despawn_count(res) != 2 { panic(91846); };
    if ecs_relate_despawn_first(res) != ENT_1 { panic(91847); };
}

@test "extras_despawn_related_clears_list_after"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let res = ecs_related_extras_despawn_related(r1, REL_ID);
    if ecs_relate_despawn_count(res) != 1 { panic(91848); };
}

@test "extras_despawn_related_empty"() {
    let r = ecs_related_extras_new(ENT_SELF);
    let res = ecs_related_extras_despawn_related(r, REL_ID);
    if ecs_relate_despawn_count(res) != 0 { panic(91849); };
    if ecs_relate_despawn_first(res) != -1 { panic(91850); };
}

@test "extras_despawn_children_equivalent_to_despawn_related"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    let res = ecs_related_extras_despawn_children(r2);
    if ecs_relate_despawn_count(res) != 2 { panic(91851); };
}

@test "extras_with_related_spawns_one"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_with_related(r0, REL_ID, BUNDLE_A, ENT_3);
    if ecs_related_extras_spawned_with_related(r1) != 1 { panic(91852); };
    if ecs_related_extras_related_count(r1) != 1 { panic(91853); };
    if ecs_related_extras_related_at(r1, 0) != ENT_3 { panic(91890); };
}

@test "extras_with_related_adds_to_related_list"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_with_related(r0, REL_ID, BUNDLE_A, ENT_3);
    let r2 = ecs_related_extras_with_related(r1, REL_ID, BUNDLE_B, ENT_2);
    if ecs_related_extras_related_count(r2) != 2 { panic(91854); };
    if ecs_related_extras_spawned_with_related(r2) != 2 { panic(91890); };
}

@test "extras_with_related_entities_spawns_multiple"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let bundles = Vec::new();
    bundles.push(BUNDLE_A);
    bundles.push(BUNDLE_B);
    let r1 = ecs_related_extras_with_related_entities(r0, REL_ID, bundles, 9100);
    if ecs_related_extras_related_count(r1) != 2 { panic(91855); };
    if ecs_related_extras_related_at(r1, 0) != 9100 { panic(91856); };
    if ecs_related_extras_related_at(r1, 1) != 9101 { panic(91857); };
    if ecs_related_extras_spawned_with_related(r1) != 2 { panic(91858); };
}

@test "extras_with_related_entities_empty"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let bundles = Vec::new();
    let r1 = ecs_related_extras_with_related_entities(r0, REL_ID, bundles, 9100);
    if ecs_related_extras_related_count(r1) != 0 { panic(91891); };
    if ecs_related_extras_spawned_with_related(r1) != 0 { panic(91892); };
}

@test "extras_insert_recursive_no_related"() {
    let r = ecs_related_extras_new(ENT_SELF);
    let res = ecs_related_extras_insert_recursive(r, REL_ID, BUNDLE_A);
    if ecs_relate_rec_count(res) != 0 { panic(91859); };
    if ecs_relate_rec_first(res) != -1 { panic(91860); };
}

@test "extras_insert_recursive_flat"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    let res = ecs_related_extras_insert_recursive(r2, REL_ID, BUNDLE_A);
    if ecs_relate_rec_count(res) != 2 { panic(91861); };
    if ecs_relate_rec_first(res) != ENT_1 { panic(91862); };
}

@test "extras_insert_recursive_with_descendants"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_descendant(r1, ENT_1, ENT_2);
    let r3 = ecs_related_extras_add_descendant(r2, ENT_1, ENT_3);
    let res = ecs_related_extras_insert_recursive(r3, REL_ID, BUNDLE_A);
    // ENT_1 + 2 descendants = 3 visited
    if ecs_relate_rec_count(res) != 3 { panic(91863); };
}

@test "extras_insert_recursive_multi_descendants"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    let r3 = ecs_related_extras_add_descendant(r2, ENT_1, ENT_3);
    let r4 = ecs_related_extras_add_descendant(r3, ENT_2, ENT_3);
    let res = ecs_related_extras_insert_recursive(r4, REL_ID, BUNDLE_A);
    // 2 related + 2 descendants = 4
    if ecs_relate_rec_count(res) != 4 { panic(91864); };
}

@test "extras_remove_recursive_no_related"() {
    let r = ecs_related_extras_new(ENT_SELF);
    let res = ecs_related_extras_remove_recursive(r, REL_ID, BUNDLE_B);
    if ecs_relate_rec_count(res) != 0 { panic(91865); };
}

@test "extras_remove_recursive_flat"() {
    let r0 = ecs_related_extras_new(ENT_SELF);
    let r1 = ecs_related_extras_add_one_related(r0, REL_ID, ENT_1);
    let r2 = ecs_related_extras_add_one_related(r1, REL_ID, ENT_2);
    let res = ecs_related_extras_remove_recursive(r2, REL_ID, BUNDLE_B);
    if ecs_relate_rec_count(res) != 2 { panic(91866); };
}
