@import "lib/graph_map_deep.sla"

// Batch 311: graph_map deep.
// panic codes: 128200 – 128399.

@test "new_directed"() {
    let g = ecs_gm_deep_new(true);
    if ecs_gm_deep_is_directed(g) != true { panic(128200); };
    if ecs_gm_deep_node_count(g) != 0 { panic(128201); };
    if ecs_gm_deep_edge_count(g) != 0 { panic(128202); };
}

@test "add_nodes"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_node(g, 1);
    g = ecs_gm_deep_add_node(g, 2);
    g = ecs_gm_deep_add_node(g, 1);
    if ecs_gm_deep_node_count(g) != 2 { panic(128210); };
    if ecs_gm_deep_contains_node(g, 2) != true { panic(128211); };
    if ecs_gm_deep_contains_node(g, 3) != false { panic(128212); };
}

@test "add_edges_directed"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_node(g, 1);
    g = ecs_gm_deep_add_node(g, 2);
    g = ecs_gm_deep_add_edge(g, 1, 2);
    if ecs_gm_deep_edge_count(g) != 1 { panic(128220); };
    if ecs_gm_deep_contains_edge(g, 1, 2) != true { panic(128221); };
    if ecs_gm_deep_contains_edge(g, 2, 1) != false { panic(128222); };
}

@test "undirected_edge"() {
    let g = ecs_gm_deep_new(false);
    g = ecs_gm_deep_add_edge(g, 1, 2);
    if ecs_gm_deep_contains_edge(g, 1, 2) != true { panic(128230); };
    if ecs_gm_deep_contains_edge(g, 2, 1) != true { panic(128231); };
}

@test "neighbors_directed"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_edge(g, 1, 2);
    g = ecs_gm_deep_add_edge(g, 1, 3);
    let n = ecs_gm_deep_neighbors(g, 1);
    if ecs_gm_neigh_count(n) != 2 { panic(128240); };
    if ecs_gm_neigh_first(n) != 2 { panic(128241); };
    if ecs_gm_neigh_second(n) != 3 { panic(128242); };
}

@test "degree"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_edge(g, 1, 2);
    g = ecs_gm_deep_add_edge(g, 3, 1);
    if ecs_gm_deep_degree(g, 1) != 2 { panic(128250); };
}

@test "remove_edge"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_edge(g, 1, 2);
    g = ecs_gm_deep_add_edge(g, 1, 3);
    g = ecs_gm_deep_remove_edge(g, 1, 2);
    if ecs_gm_deep_edge_count(g) != 1 { panic(128260); };
    if ecs_gm_deep_contains_edge(g, 1, 2) != false { panic(128261); };
    if ecs_gm_deep_contains_edge(g, 1, 3) != true { panic(128262); };
}

@test "node_at_and_capacity"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_node(g, 10);
    g = ecs_gm_deep_add_node(g, 20);
    if ecs_gm_deep_node_at(g, 0) != 10 { panic(128270); };
    if ecs_gm_deep_node_at(g, 1) != 20 { panic(128271); };
    g = ecs_gm_deep_add_node(g, 30);
    g = ecs_gm_deep_add_node(g, 40);
    g = ecs_gm_deep_add_node(g, 50);
    g = ecs_gm_deep_add_node(g, 60);
    g = ecs_gm_deep_add_node(g, 70);
    g = ecs_gm_deep_add_node(g, 80);
    if ecs_gm_deep_node_count(g) != 8 { panic(128272); };
    g = ecs_gm_deep_add_node(g, 90);
    if ecs_gm_deep_node_count(g) != 8 { panic(128273); };
}

@test "clear_preserves_directed"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_node(g, 1);
    g = ecs_gm_deep_add_edge(g, 1, 2);
    g = ecs_gm_deep_clear(g);
    if ecs_gm_deep_is_directed(g) != true { panic(128280); };
    if ecs_gm_deep_node_count(g) != 0 { panic(128281); };
    if ecs_gm_deep_edge_count(g) != 0 { panic(128282); };
}

@test "edge_accessors"() {
    let g = ecs_gm_deep_new(true);
    g = ecs_gm_deep_add_edge(g, 5, 6);
    if ecs_gm_deep_edge_from(g, 0) != 5 { panic(128290); };
    if ecs_gm_deep_edge_to(g, 0) != 6 { panic(128291); };
}
