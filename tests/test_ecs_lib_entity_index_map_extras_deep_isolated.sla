@import "lib/entity_index_map_extras_deep.sla"

// Batch 315: entity_index_map_extras deep.
// panic codes: 129000 – 129199.

@test "insert_get_len"() {
    let m = ecs_eim_deep_new();
    if ecs_eim_deep_is_empty(m) != true { panic(129000); };
    m = ecs_eim_deep_insert(m, 10, 100);
    m = ecs_eim_deep_insert(m, 20, 200);
    if ecs_eim_deep_len(m) != 2 { panic(129001); };
    let g = ecs_eim_deep_get(m, 10);
    if ecs_eim_get_ok(g) != true { panic(129002); };
    if ecs_eim_get_value(g) != 100 { panic(129003); };
    if ecs_eim_get_index(g) != 0 { panic(129004); };
}

@test "ordered_indices"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_insert(ecs_eim_deep_new(), 1, 11), 2, 22);
    if ecs_eim_deep_key_at(m, 0) != 1 { panic(129010); };
    if ecs_eim_deep_key_at(m, 1) != 2 { panic(129011); };
    if ecs_eim_deep_value_at(m, 1) != 22 { panic(129012); };
}

@test "overwrite_preserves_index"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_insert(ecs_eim_deep_new(), 1, 1), 2, 2);
    m = ecs_eim_deep_insert(m, 1, 9);
    if ecs_eim_deep_len(m) != 2 { panic(129020); };
    if ecs_eim_get_index(ecs_eim_deep_get(m, 1)) != 0 { panic(129021); };
    if ecs_eim_get_value(ecs_eim_deep_get(m, 1)) != 9 { panic(129022); };
}

@test "get_range"() {
    let m = ecs_eim_deep_new();
    m = ecs_eim_deep_insert(m, 1, 10);
    m = ecs_eim_deep_insert(m, 2, 20);
    m = ecs_eim_deep_insert(m, 3, 30);
    let s = ecs_eim_deep_get_range(m, 1, 3);
    if ecs_eim_slice_len(s) != 2 { panic(129030); };
    if ecs_eim_slice_key_at(s, 0) != 2 { panic(129031); };
    if ecs_eim_slice_key_at(s, 1) != 3 { panic(129032); };
}

@test "get_range_invalid"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_new(), 1, 1);
    let s = ecs_eim_deep_get_range(m, 0, 0);
    if ecs_eim_slice_len(s) != 0 { panic(129040); };
    let s2 = ecs_eim_deep_get_range(m, 0, 5);
    if ecs_eim_slice_len(s2) != 0 { panic(129041); };
}

@test "keys_iter"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_insert(ecs_eim_deep_new(), 7, 1), 8, 2);
    let it = ecs_eim_deep_keys(m);
    if ecs_eim_iter_remaining(it) != 2 { panic(129050); };
    let n1 = ecs_eim_iter_next(it);
    if ecs_eim_next_has(n1) != true { panic(129051); };
    if ecs_eim_next_key(n1) != 7 { panic(129052); };
    let n2 = ecs_eim_iter_next(ecs_eim_next_iter(n1));
    if ecs_eim_next_key(n2) != 8 { panic(129053); };
    let n3 = ecs_eim_iter_next(ecs_eim_next_iter(n2));
    if ecs_eim_next_has(n3) != false { panic(129054); };
}

@test "drain"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_insert(ecs_eim_deep_new(), 1, 1), 2, 2);
    let d = ecs_eim_deep_drain(m);
    if ecs_eim_deep_is_empty(ecs_eim_drain_map(d)) != true { panic(129060); };
    if ecs_eim_deep_len(ecs_eim_drain_drained(d)) != 2 { panic(129061); };
}

@test "contains_and_clear"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_new(), 5, 50);
    if ecs_eim_deep_contains(m, 5) != true { panic(129070); };
    if ecs_eim_deep_contains(m, 6) != false { panic(129071); };
    m = ecs_eim_deep_clear(m);
    if ecs_eim_deep_is_empty(m) != true { panic(129072); };
}

@test "capacity_eight"() {
    let m = ecs_eim_deep_new();
    m = ecs_eim_deep_insert(m, 1, 1);
    m = ecs_eim_deep_insert(m, 2, 2);
    m = ecs_eim_deep_insert(m, 3, 3);
    m = ecs_eim_deep_insert(m, 4, 4);
    m = ecs_eim_deep_insert(m, 5, 5);
    m = ecs_eim_deep_insert(m, 6, 6);
    m = ecs_eim_deep_insert(m, 7, 7);
    m = ecs_eim_deep_insert(m, 8, 8);
    if ecs_eim_deep_len(m) != 8 { panic(129080); };
    m = ecs_eim_deep_insert(m, 9, 9);
    if ecs_eim_deep_len(m) != 8 { panic(129081); };
}

@test "get_index_second"() {
    let m = ecs_eim_deep_insert(ecs_eim_deep_insert(ecs_eim_deep_new(), 1, 1), 2, 2);
    if ecs_eim_get_index(ecs_eim_deep_get(m, 2)) != 1 { panic(129090); };
}
