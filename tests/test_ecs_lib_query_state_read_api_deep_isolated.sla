@test "iter_many_matched_sum"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r_q0 = ecs_qs_deep_read_api_spawn(s0, 10); s0 = ecs_qs_deep_spawn_result_state(r_q0);
    s0 = ecs_qs_deep_spawn_result_state(ecs_qs_deep_read_api_spawn(s0, 20));
    s0 = ecs_qs_deep_spawn_result_state(ecs_qs_deep_read_api_spawn(s0, 30));
    let ea = ecs_qs_deep_entity_arg_new();
    ea = ecs_qs_deep_entity_arg_push(ea, 0);
    ea = ecs_qs_deep_entity_arg_push(ea, 2);
    let r = ecs_qs_deep_read_api_iter_many(s0, ea);
    if ecs_qs_deep_itermany_requested(r) != 2 { panic(145620); };
    if ecs_qs_deep_itermany_matched(r) != 2 { panic(145621); };
    if ecs_qs_deep_itermany_sum(r) != 40 { panic(145622); };
}

