// Isolated deep tests for lib/query_state_read_api_deep.sla (Batch 404).
// Tests the deep QueryState read API: new, try_new, spawn, single, get, get_many, iter_many, entity arg.

@import "lib/query_state_read_api_deep.sla"

@test "err_codes_and_predicates"() {
    if ecs_qe_deep_err_query_does_not_match() != 0 { panic(145300); };
    if ecs_qe_deep_err_not_spawned() != 1 { panic(145301); };
    if ecs_qe_deep_err_aliased_mutability() != 2 { panic(145302); };
    if ecs_qs_deep_err_no_entities() != 0 { panic(145303); };
    if ecs_qs_deep_err_multiple_entities() != 1 { panic(145304); };
    if ecs_qe_deep_err_is_query_does_not_match(0) != true { panic(145305); };
    if ecs_qe_deep_err_is_not_spawned(1) != true { panic(145306); };
    if ecs_qe_deep_err_is_aliased_mutability(2) != true { panic(145307); };
    if ecs_qs_deep_err_is_no_entities(0) != true { panic(145308); };
    if ecs_qs_deep_err_is_multiple_entities(1) != true { panic(145309); };
    if ecs_qe_deep_err_is_query_does_not_match(1) != false { panic(145310); };
    if ecs_qe_deep_err_is_not_spawned(0) != false { panic(145311); };
}

@test "new_and_from_builder"() {
    let s = ecs_qs_deep_read_api_new(7, 3);
    if ecs_qs_deep_read_api_type_id(s) != 7 { panic(145320); };
    if ecs_qs_deep_read_api_world_id(s) != 3 { panic(145321); };
    if ecs_qs_deep_read_api_count(s) != 0 { panic(145322); };
    if ecs_qs_deep_read_api_is_empty(s) != true { panic(145323); };
    if ecs_qs_deep_read_api_archetype_generation(s) != 0 { panic(145324); };
    let b = ecs_qs_deep_read_api_from_builder(99, 5, 2);
    if ecs_qs_deep_read_api_builder_source(b) != 99 { panic(145325); };
    if ecs_qs_deep_read_api_type_id(b) != 5 { panic(145326); };
    if ecs_qs_deep_read_api_world_id(b) != 2 { panic(145327); };
}

@test "try_new_ok_and_fail"() {
    let r = ecs_qs_deep_read_api_try_new(2, 10);
    if ecs_qs_deep_read_api_try_new_ok(r) != 1 { panic(145340); };
    let s0 = ecs_qs_deep_read_api_try_new_state(r);
    if ecs_qs_deep_read_api_try_new_ok_value(s0) != 1 { panic(145341); };
    if ecs_qs_deep_read_api_type_id(s0) != 10 { panic(145342); };
    let rf = ecs_qs_deep_read_api_try_new(0, 20);
    if ecs_qs_deep_read_api_try_new_ok(rf) != 0 { panic(145343); };
    let sf = ecs_qs_deep_read_api_try_new_state(rf);
    if ecs_qs_deep_read_api_try_new_ok_value(sf) != 0 { panic(145344); };
    let rf2 = ecs_qs_deep_read_api_try_new(-1, 30);
    if ecs_qs_deep_read_api_try_new_ok(rf2) != 0 { panic(145345); };
}

@test "spawn_and_chaining"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r1 = ecs_qs_deep_read_api_spawn(s0, 100);
    if ecs_qs_deep_spawn_result_entity_idx(r1) != 0 { panic(145360); };
    let s1 = ecs_qs_deep_spawn_result_state(r1);
    if ecs_qs_deep_read_api_count(s1) != 1 { panic(145361); };
    let r2 = ecs_qs_deep_read_api_spawn(s1, 200);
    if ecs_qs_deep_spawn_result_entity_idx(r2) != 1 { panic(145362); };
    let s2 = ecs_qs_deep_spawn_result_state(r2);
    if ecs_qs_deep_read_api_count(s2) != 2 { panic(145363); };
    let r3 = ecs_qs_deep_read_api_spawn(s2, 300);
    let s3 = ecs_qs_deep_spawn_result_state(r3);
    if ecs_qs_deep_read_api_count(s3) != 3 { panic(145364); };
}

@test "spawn_cap_overflow"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let rr0 = ecs_qs_deep_read_api_spawn(s0, 10); s0 = ecs_qs_deep_spawn_result_state(rr0);
    let rr1 = ecs_qs_deep_read_api_spawn(s0, 20); s0 = ecs_qs_deep_spawn_result_state(rr1);
    let rr2 = ecs_qs_deep_read_api_spawn(s0, 30); s0 = ecs_qs_deep_spawn_result_state(rr2);
    if ecs_qs_deep_read_api_count(s0) != 3 { panic(145380); };
}

@test "entity_is_spawned_is_empty_contains"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    if ecs_qs_deep_read_api_is_empty(s0) != true { panic(145400); };
    if ecs_qs_deep_read_api_contains(s0, 0) != false { panic(145401); };
    let r1 = ecs_qs_deep_read_api_spawn(s0, 10);
    let s1 = ecs_qs_deep_spawn_result_state(r1);
    if ecs_qs_deep_read_api_entity_is_spawned(s1, 0) != true { panic(145402); };
    if ecs_qs_deep_read_api_entity_is_spawned(s1, 1) != false { panic(145403); };
    if ecs_qs_deep_read_api_entity_is_spawned(s1, -1) != false { panic(145404); };
    if ecs_qs_deep_read_api_is_empty(s1) != false { panic(145405); };
    if ecs_qs_deep_read_api_contains(s1, 0) != true { panic(145406); };
}

@test "single_no_one_multiple"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r0 = ecs_qs_deep_read_api_single(s0);
    if ecs_qs_deep_single_found(r0) != false { panic(145420); };
    if ecs_qs_deep_single_err_code(r0) != 0 { panic(145421); };
    let r1 = ecs_qs_deep_read_api_spawn(s0, 50);
    let s1 = ecs_qs_deep_spawn_result_state(r1);
    let r0a = ecs_qs_deep_read_api_single(s1);
    if ecs_qs_deep_single_found(r0a) != true { panic(145422); };
    if ecs_qs_deep_single_entity_idx(r0a) != 0 { panic(145423); };
    if ecs_qs_deep_single_value(r0a) != 50 { panic(145424); };
    let r2 = ecs_qs_deep_read_api_spawn(s1, 60);
    let s2 = ecs_qs_deep_spawn_result_state(r2);
    let r0b = ecs_qs_deep_read_api_single(s2);
    if ecs_qs_deep_single_found(r0b) != false { panic(145425); };
    if ecs_qs_deep_single_err_code(r0b) != 1 { panic(145426); };
}

@test "single_mut_delegates"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r1 = ecs_qs_deep_read_api_spawn(s0, 77);
    let s1 = ecs_qs_deep_spawn_result_state(r1);
    let rm = ecs_qs_deep_read_api_single_mut(s1);
    if ecs_qs_deep_single_found(rm) != true { panic(145440); };
    if ecs_qs_deep_single_value(rm) != 77 { panic(145441); };
}

@test "get_spawned_and_unspawned"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r1 = ecs_qs_deep_read_api_spawn(s0, 999);
    let s1 = ecs_qs_deep_spawn_result_state(r1);
    let g1 = ecs_qs_deep_read_api_get(s1, 0);
    if ecs_qs_deep_get_ok(g1) != 1 { panic(145460); };
    if ecs_qs_deep_get_value(g1) != 999 { panic(145461); };
    let g2 = ecs_qs_deep_read_api_get(s1, 5);
    if ecs_qs_deep_get_ok(g2) != 0 { panic(145462); };
    if ecs_qs_deep_get_err_code(g2) != 1 { panic(145463); };
}

@test "get_mut_delegates"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r1 = ecs_qs_deep_read_api_spawn(s0, 42);
    let s1 = ecs_qs_deep_spawn_result_state(r1);
    let gm = ecs_qs_deep_read_api_get_mut(s1, 0);
    if ecs_qs_deep_get_value(gm) != 42 { panic(145480); };
    if ecs_qs_deep_get_ok(gm) != 1 { panic(145481); };
}

@test "entity_arg_push_at_len"() {
    let ea = ecs_qs_deep_entity_arg_new();
    if ecs_qs_deep_entity_arg_len(ea) != 0 { panic(145500); };
    let ea1 = ecs_qs_deep_entity_arg_push(ea, 0);
    if ecs_qs_deep_entity_arg_len(ea1) != 1 { panic(145501); };
    if ecs_qs_deep_entity_arg_at(ea1, 0) != 0 { panic(145502); };
    let ea2 = ecs_qs_deep_entity_arg_push(ea1, 1);
    if ecs_qs_deep_entity_arg_len(ea2) != 2 { panic(145503); };
    if ecs_qs_deep_entity_arg_at(ea2, 1) != 1 { panic(145504); };
    let ea3 = ecs_qs_deep_entity_arg_push(ea2, 2);
    if ecs_qs_deep_entity_arg_at(ea3, 2) != 2 { panic(145505); };
    if ecs_qs_deep_entity_arg_len(ea3) != 3 { panic(145506); };
}

@test "get_many_ro_multiple"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    let r_q0 = ecs_qs_deep_read_api_spawn(s0, 10); s0 = ecs_qs_deep_spawn_result_state(r_q0);
    s0 = ecs_qs_deep_spawn_result_state(ecs_qs_deep_read_api_spawn(s0, 20));
    let ea = ecs_qs_deep_entity_arg_new();
    ea = ecs_qs_deep_entity_arg_push(ea, 0);
    ea = ecs_qs_deep_entity_arg_push(ea, 1);
    let r = ecs_qs_deep_read_api_get_many_ro(s0, ea);
    if ecs_qs_deep_getmany_count(r) != 2 { panic(145520); };
    if ecs_qs_deep_getmany_matched(r) != 2 { panic(145521); };
    if ecs_qs_deep_getmany_sum(r) != 30 { panic(145522); };
    if ecs_qs_deep_getmany_first_value(r) != 10 { panic(145523); };
    if ecs_qs_deep_getmany_first_err(r) != -1 { panic(145524); };
    if ecs_qs_deep_getmany_aliased_idx(r) != -1 { panic(145525); };
}

