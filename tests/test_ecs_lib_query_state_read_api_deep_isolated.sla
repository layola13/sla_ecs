@test "update_archetypes_bumps_gen"() {
    let s0 = ecs_qs_deep_read_api_new(0, 1);
    if ecs_qs_deep_read_api_archetype_generation(s0) != 0 { panic(145680); };
    let s1 = ecs_qs_deep_read_api_update_archetypes(s0);
    if ecs_qs_deep_read_api_archetype_generation(s1) != 1 { panic(145681); };
    let s2 = ecs_qs_deep_read_api_update_archetypes(s1);
    if ecs_qs_deep_read_api_archetype_generation(s2) != 2 { panic(145682); };
}

@test "first_duplicate_index_logic"() {
    let ea = ecs_qs_deep_entity_arg_new();
    ea = ecs_qs_deep_entity_arg_push(ea, 0);
    ea = ecs_qs_deep_entity_arg_push(ea, 1);
    ea = ecs_qs_deep_entity_arg_push(ea, 1);
    ea = ecs_qs_deep_entity_arg_push(ea, 2);
    let idx = ecs_qs_deep_read_api_first_duplicate_index(ea);
    if idx != 1 { panic(145700); };
    let ea2 = ecs_qs_deep_entity_arg_new();
    ea2 = ecs_qs_deep_entity_arg_push(ea2, 0);
    ea2 = ecs_qs_deep_entity_arg_push(ea2, 1);
    ea2 = ecs_qs_deep_entity_arg_push(ea2, 2);
    let idx2 = ecs_qs_deep_read_api_first_duplicate_index(ea2);
    if idx2 != -1 { panic(145701); };
}
