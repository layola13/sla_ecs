@import "lib/component_info_extras_deep.sla"

// Batch 293: component_info_extras deep.
// panic codes: 124600 – 124799.

@test "empty_registry"() {
    let c = ecs_cie_deep_new();
    if ecs_cie_deep_is_empty(c) != true { panic(124600); };
    if ecs_cie_deep_len(c) != 0 { panic(124601); };
    if ecs_cie_deep_any_queued(c) != false { panic(124602); };
    if ecs_cie_deep_any_registered(c) != false { panic(124603); };
}

@test "init_component_and_get_info"() {
    let c = ecs_cie_deep_new();
    let r = ecs_cie_deep_init_component(c, 100, 1000, true, 0, true);
    if ecs_cie_get_ok(r) != true { panic(124610); };
    if ecs_cie_get_id(r) != 0 { panic(124611); };
    c = ecs_cie_get_world(r);
    if ecs_cie_deep_len(c) != 1 { panic(124612); };
    if ecs_cie_deep_num_registered(c) != 1 { panic(124613); };
    let g = ecs_cie_deep_get_info(c, 0);
    if ecs_cie_get_ok(g) != true { panic(124614); };
    let info = ecs_cie_get_info(g);
    if ecs_cie_info_name(info) != 100 { panic(124615); };
    if ecs_cie_info_type_id(info) != 1000 { panic(124616); };
    if ecs_cie_info_mutable(info) != true { panic(124617); };
    if ecs_cie_info_is_send(info) != true { panic(124618); };
}

@test "init_resource_and_lookup"() {
    let c = ecs_cie_deep_new();
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 1, 10, true, 0, true));
    let r = ecs_cie_deep_init_resource(c, 2, 20);
    if ecs_cie_get_ok(r) != true { panic(124620); };
    c = ecs_cie_get_world(r);
    if ecs_cie_deep_resource_count(c) != 1 { panic(124621); };
    let g = ecs_cie_deep_get_resource_id(c, 20);
    if ecs_cie_get_ok(g) != true { panic(124622); };
    if ecs_cie_info_is_resource(ecs_cie_get_info(g)) != true { panic(124623); };
    let miss = ecs_cie_deep_get_resource_id(c, 10);
    if ecs_cie_get_ok(miss) != false { panic(124624); };
}

@test "queue_and_register"() {
    let c = ecs_cie_deep_new();
    let q = ecs_cie_deep_queue_component(c, 5, 50, false);
    if ecs_cie_get_ok(q) != true { panic(124630); };
    c = ecs_cie_get_world(q);
    if ecs_cie_deep_num_queued(c) != 1 { panic(124631); };
    if ecs_cie_deep_num_registered(c) != 0 { panic(124632); };
    if ecs_cie_deep_is_id_valid(c, 0) != false { panic(124633); };
    if ecs_cie_get_ok(ecs_cie_deep_get_info(c, 0)) != false { panic(124634); };
    let reg = ecs_cie_deep_register_queued(c, 0);
    if ecs_cie_get_ok(reg) != true { panic(124635); };
    c = ecs_cie_get_world(reg);
    if ecs_cie_deep_num_queued(c) != 0 { panic(124636); };
    if ecs_cie_deep_is_id_valid(c, 0) != true { panic(124637); };
    if ecs_cie_info_mutable(ecs_cie_get_info(reg)) != false { panic(124638); };
}

@test "get_id_by_type_and_reuse"() {
    let c = ecs_cie_deep_new();
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 1, 111, true, 0, true));
    let g = ecs_cie_deep_get_id(c, 111);
    if ecs_cie_get_ok(g) != true { panic(124640); };
    if ecs_cie_get_id(g) != 0 { panic(124641); };
    // re-init same type reuses
    let r = ecs_cie_deep_init_component(c, 1, 111, true, 0, true);
    if ecs_cie_get_id(r) != 0 { panic(124642); };
    c = ecs_cie_get_world(r);
    if ecs_cie_deep_len(c) != 1 { panic(124643); };
    let miss = ecs_cie_deep_get_valid_id(c, 999);
    if ecs_cie_get_ok(miss) != false { panic(124644); };
}

@test "hooks_and_required"() {
    let c = ecs_cie_deep_new();
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 1, 1, true, 0, true));
    let h = ecs_cie_deep_set_hooks(c, 0, 7);
    if ecs_cie_get_ok(h) != true { panic(124650); };
    c = ecs_cie_get_world(h);
    if ecs_cie_info_has_hooks(ecs_cie_get_info(h)) != true { panic(124651); };
    if ecs_cie_info_hook_mask(ecs_cie_get_info(h)) != 7 { panic(124652); };
    let rq = ecs_cie_deep_set_required(c, 0, 2, 3);
    if ecs_cie_info_required_count(ecs_cie_get_info(rq)) != 2 { panic(124653); };
    if ecs_cie_info_required_by_count(ecs_cie_get_info(rq)) != 3 { panic(124654); };
}

@test "storage_types_count"() {
    let c = ecs_cie_deep_new();
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 1, 1, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 2, 2, true, 1, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 3, 3, true, 0, false));
    if ecs_cie_deep_count_storage(c, 0) != 2 { panic(124660); };
    if ecs_cie_deep_count_storage(c, 1) != 1 { panic(124661); };
    if ecs_cie_info_storage(ecs_cie_get_info(ecs_cie_deep_get_info(c, 1))) != 1 { panic(124662); };
    if ecs_cie_info_is_send(ecs_cie_get_info(ecs_cie_deep_get_info(c, 2))) != false { panic(124663); };
}

@test "capacity_eight"() {
    let c = ecs_cie_deep_new();
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 1, 1, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 2, 2, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 3, 3, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 4, 4, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 5, 5, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 6, 6, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 7, 7, true, 0, true));
    c = ecs_cie_get_world(ecs_cie_deep_init_component(c, 8, 8, true, 0, true));
    if ecs_cie_deep_len(c) != 8 { panic(124670); };
    let full = ecs_cie_deep_init_component(c, 9, 9, true, 0, true);
    if ecs_cie_get_ok(full) != false { panic(124671); };
    if ecs_cie_get_err(full) != 2 { panic(124672); };
}

@test "missing_ids"() {
    let c = ecs_cie_deep_new();
    if ecs_cie_get_ok(ecs_cie_deep_get_info(c, 0)) != false { panic(124680); };
    if ecs_cie_get_ok(ecs_cie_deep_get_info(c, -1)) != false { panic(124681); };
    if ecs_cie_deep_is_id_valid(c, 0) != false { panic(124682); };
    if ecs_cie_get_ok(ecs_cie_deep_register_queued(c, 3)) != false { panic(124683); };
}

@test "clone_behavior_default"() {
    let c = ecs_cie_deep_new();
    let r = ecs_cie_deep_init_component(c, 1, 1, true, 0, true);
    if ecs_cie_info_clone_behavior(ecs_cie_get_info(r)) != 1 { panic(124690); };
    c = ecs_cie_get_world(r);
    let info = ecs_cie_info_with_clone_behavior(ecs_cie_deep_get_slot(c, 0), 0);
    if ecs_cie_info_clone_behavior(info) != 0 { panic(124691); };
}
