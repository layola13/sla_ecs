// Isolated deep tests for lib/commands_dynamic_deep.sla (Batch 368).
// Kind-discriminated ordered deferred command queue for DynamicWorld (5 kinds; 2 component cols).
// panic codes: 139600 - 139799.

@import "lib/commands_dynamic_deep.sla"

const COMP_A_VAL: i32 = 311;
const COMP_B_VAL: i32 = 312;
const RES_VAL: i32 = 888;
const MSG_VAL: i32 = 42;

@test "DynCommands new empty and side counts zero"() {
    let c = ecs_dyn_commands_new();
    if ecs_dyn_commands_len(c) != 0 { panic(139600); };
    if ecs_dyn_commands_pa_count(c) != 0 { panic(139601); };
    if ecs_dyn_commands_pb_count(c) != 0 { panic(139602); };
    if ecs_dyn_commands_pres_count(c) != 0 { panic(139603); };
    if ecs_dyn_commands_pmsg_count(c) != 0 { panic(139604); };
    if ecs_dyn_commands_kind_at(c, 0) != 0 { panic(139605); };
    if ecs_dyn_commands_idx_at(c, 0) != 0 { panic(139606); };
    if ecs_dyn_commands_cmp_at(c, 0) != 0 { panic(139607); };
}

@test "insert_a enqueues INSERT_A and stores A-side payload + component discriminator"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_a(c0, 7, COMP_A_VAL);
    if ecs_dyn_commands_len(c1) != 1 { panic(139610); };
    if ecs_dyn_commands_kind_at(c1, 0) != ECS_CMD_DYN_INSERT_A { panic(139611); };
    if ecs_dyn_commands_entity_at(c1, 0) != 7 { panic(139612); };
    if ecs_dyn_commands_cmp_at(c1, 0) != ECS_CMD_DYN_COMPONENT_A { panic(139613); };
    if ecs_dyn_commands_resolve_value(c1, 0) != COMP_A_VAL { panic(139614); };
    if ecs_dyn_commands_resolve_component(c1, 0) != ECS_CMD_DYN_COMPONENT_A { panic(139615); };
    if ecs_dyn_commands_pa_count(c1) != 1 { panic(139616); };
    if ecs_dyn_commands_pb_count(c1) != 0 { panic(139617); };
}

@test "insert_b enqueues INSERT_B and stores B-side payload distinct from A"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_b(c0, 9, COMP_B_VAL);
    if ecs_dyn_commands_len(c1) != 1 { panic(139620); };
    if ecs_dyn_commands_kind_at(c1, 0) != ECS_CMD_DYN_INSERT_B { panic(139621); };
    if ecs_dyn_commands_entity_at(c1, 0) != 9 { panic(139622); };
    if ecs_dyn_commands_cmp_at(c1, 0) != ECS_CMD_DYN_COMPONENT_B { panic(139623); };
    if ecs_dyn_commands_resolve_value(c1, 0) != COMP_B_VAL { panic(139624); };
    if ecs_dyn_commands_resolve_component(c1, 0) != ECS_CMD_DYN_COMPONENT_B { panic(139625); };
    if ecs_dyn_commands_pb_count(c1) != 1 { panic(139626); };
    if ecs_dyn_commands_pa_count(c1) != 0 { panic(139627); };
}

@test "despawn enqueues DESPAWN with -1 value_index and zero resolve"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_despawn(c0, 5);
    if ecs_dyn_commands_len(c1) != 1 { panic(139630); };
    if ecs_dyn_commands_kind_at(c1, 0) != ECS_CMD_DYN_DESPAWN { panic(139631); };
    if ecs_dyn_commands_entity_at(c1, 0) != 5 { panic(139632); };
    if ecs_dyn_commands_idx_at(c1, 0) != -1 { panic(139633); };
    if ecs_dyn_commands_resolve_value(c1, 0) != 0 { panic(139634); };
    if ecs_dyn_commands_resolve_component(c1, 0) != 0 { panic(139635); };
}

@test "insert_resource and write_message enqueue side payloads and resolve"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_resource(c0, RES_VAL);
    if ecs_dyn_commands_kind_at(c1, 0) != ECS_CMD_DYN_INSERT_RESOURCE { panic(139640); };
    if ecs_dyn_commands_pres_count(c1) != 1 { panic(139641); };
    if ecs_dyn_commands_resolve_value(c1, 0) != RES_VAL { panic(139642); };
    let c2 = ecs_dyn_commands_write_message(c1, MSG_VAL);
    if ecs_dyn_commands_kind_at(c2, 1) != ECS_CMD_DYN_WRITE_MESSAGE { panic(139643); };
    if ecs_dyn_commands_pmsg_count(c2) != 1 { panic(139644); };
    if ecs_dyn_commands_resolve_value(c2, 1) != MSG_VAL { panic(139645); };
    if ecs_dyn_commands_resolve_component(c2, 1) != 0 { panic(139646); };
}

@test "order preserved: insert_a then insert_b then despawn keep slot order"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_a(c0, 1, 100);
    let c2 = ecs_dyn_commands_insert_b(c1, 1, 200);
    let c3 = ecs_dyn_commands_despawn(c2, 2);
    if ecs_dyn_commands_len(c3) != 3 { panic(139650); };
    if ecs_dyn_commands_kind_at(c3, 0) != ECS_CMD_DYN_INSERT_A { panic(139651); };
    if ecs_dyn_commands_kind_at(c3, 1) != ECS_CMD_DYN_INSERT_B { panic(139652); };
    if ecs_dyn_commands_kind_at(c3, 2) != ECS_CMD_DYN_DESPAWN { panic(139653); };
    if ecs_dyn_commands_resolve_value(c3, 0) != 100 { panic(139654); };
    if ecs_dyn_commands_resolve_value(c3, 1) != 200 { panic(139655); };
    if ecs_dyn_commands_resolve_value(c3, 2) != 0 { panic(139656); };
}

@test "side columns are independent: A and B pushes track separate counts"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_a(c0, 1, 11);
    let c2 = ecs_dyn_commands_insert_a(c1, 2, 12);
    let c3 = ecs_dyn_commands_insert_b(c2, 1, 21);
    let c4 = ecs_dyn_commands_insert_b(c3, 2, 22);
    if ecs_dyn_commands_pa_count(c4) != 2 { panic(139660); };
    if ecs_dyn_commands_pb_count(c4) != 2 { panic(139661); };
    if ecs_dyn_commands_len(c4) != 4 { panic(139662); };
    // idx_at points into the correct side column: A commands 0/1, B commands 2/3.
    if ecs_dyn_commands_idx_at(c4, 0) != 0 { panic(139663); };
    if ecs_dyn_commands_idx_at(c4, 1) != 1 { panic(139664); };
    if ecs_dyn_commands_idx_at(c4, 2) != 0 { panic(139665); };
    if ecs_dyn_commands_idx_at(c4, 3) != 1 { panic(139666); };
    if ecs_dyn_commands_resolve_value(c4, 0) != 11 { panic(139667); };
    if ecs_dyn_commands_resolve_value(c4, 3) != 22 { panic(139668); };
}

@test "count_by_kind categorizes a mixed queue across all 5 kinds"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_a(c0, 1, 100);
    let c2 = ecs_dyn_commands_insert_b(c1, 1, 200);
    let c3 = ecs_dyn_commands_despawn(c2, 2);
    let c4 = ecs_dyn_commands_insert_resource(c3, 300);
    let c5 = ecs_dyn_commands_write_message(c4, 400);
    let c6 = ecs_dyn_commands_insert_a(c5, 3, 101);
    if ecs_dyn_commands_count_by_kind(c6, ECS_CMD_DYN_INSERT_A) != 2 { panic(139670); };
    if ecs_dyn_commands_count_by_kind(c6, ECS_CMD_DYN_INSERT_B) != 1 { panic(139671); };
    if ecs_dyn_commands_count_by_kind(c6, ECS_CMD_DYN_DESPAWN) != 1 { panic(139672); };
    if ecs_dyn_commands_count_by_kind(c6, ECS_CMD_DYN_INSERT_RESOURCE) != 1 { panic(139673); };
    if ecs_dyn_commands_count_by_kind(c6, ECS_CMD_DYN_WRITE_MESSAGE) != 1 { panic(139674); };
    if ecs_dyn_commands_len(c6) != 6 { panic(139675); };
    // resolve across mixed kinds: A->pa, B->pb, DESPAWN->0, RES->pres, MSG->pmsg, second A->pa.
    if ecs_dyn_commands_resolve_value(c6, 0) != 100 { panic(139676); };
    if ecs_dyn_commands_resolve_value(c6, 1) != 200 { panic(139677); };
    if ecs_dyn_commands_resolve_value(c6, 2) != 0 { panic(139678); };
    if ecs_dyn_commands_resolve_value(c6, 3) != 300 { panic(139679); };
    if ecs_dyn_commands_resolve_value(c6, 4) != 400 { panic(139680); };
    if ecs_dyn_commands_resolve_value(c6, 5) != 101 { panic(139681); };
}

@test "cap-8 rejection on command list and per-side cap-8 rejection"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_dyn_commands_insert_a(c1, i, 100 + i);
        i = i + 1;
    }
    // 8 commands fit (all INSERT_A), 9th rejected by the queue cap.
    if ecs_dyn_commands_len(c1) != 8 { panic(139690); };
    if ecs_dyn_commands_pa_count(c1) != 8 { panic(139691); };
    let c2 = ecs_dyn_commands_insert_a(c1, 99, 999);
    if ecs_dyn_commands_len(c2) != 8 { panic(139692); };
    if ecs_dyn_commands_pa_count(c2) != 8 { panic(139693); };
    // Per-side cap-8: 8 insert_resource fit on a fresh queue, 9th rejected.
    let c3 = ecs_dyn_commands_new();
    let c4 = c3;
    let j: i32 = 0;
    while j < 8 {
        c4 = ecs_dyn_commands_insert_resource(c4, 500 + j);
        j = j + 1;
    }
    if ecs_dyn_commands_pres_count(c4) != 8 { panic(139694); };
    if ecs_dyn_commands_len(c4) != 8 { panic(139695); };
    let c5 = ecs_dyn_commands_insert_resource(c4, 599);
    if ecs_dyn_commands_pres_count(c5) != 8 { panic(139696); };
    if ecs_dyn_commands_len(c5) != 8 { panic(139697); };
}

@test "clear resets all command slots and all four side counts"() {
    let c0 = ecs_dyn_commands_new();
    let c1 = ecs_dyn_commands_insert_a(c0, 1, 100);
    let c2 = ecs_dyn_commands_insert_b(c1, 1, 200);
    let c3 = ecs_dyn_commands_insert_resource(c2, 300);
    let c4 = ecs_dyn_commands_write_message(c3, 400);
    let c5 = ecs_dyn_commands_despawn(c4, 5);
    if ecs_dyn_commands_len(c5) != 5 { panic(139700); };
    if ecs_dyn_commands_pa_count(c5) != 1 { panic(139701); };
    if ecs_dyn_commands_pb_count(c5) != 1 { panic(139702); };
    if ecs_dyn_commands_pres_count(c5) != 1 { panic(139703); };
    if ecs_dyn_commands_pmsg_count(c5) != 1 { panic(139704); };
    let c6 = ecs_dyn_commands_clear(c5);
    if ecs_dyn_commands_len(c6) != 0 { panic(139705); };
    if ecs_dyn_commands_pa_count(c6) != 0 { panic(139706); };
    if ecs_dyn_commands_pb_count(c6) != 0 { panic(139707); };
    if ecs_dyn_commands_pres_count(c6) != 0 { panic(139708); };
    if ecs_dyn_commands_pmsg_count(c6) != 0 { panic(139709); };
    if ecs_dyn_commands_kind_at(c6, 0) != 0 { panic(139710); };
}
