// Isolated deep tests for lib/entity_index_map_iter_extras_deep.sla (Batch 374).
// Mirrors shallow lib/entity_index_map_iter_extras.sla (Vec-backed extras — IterMut, IntoIter,
// Drain::as_slice, boxed Slice conversion/clone/default, Slice equality/order/hash/index
// variants) but on the cap-16 parallel-array deep storage. No tuple-return callsites (Batch 373
// observation: let (a, b) = tuple_fn() retroactively corrupts prior assertions referencing the
// struct); all multi-slot returns are wrapper structs and the tests read scalar fields from those.
// panic codes: 140800 - 140999.

@import "lib/entity_index_map_iter_extras_deep.sla"

@test "EcsEim2DeepMap insert replace length and cap-16 reject"() {
    let m0 = ecs_eim2_deep_new();
    if ecs_eim2_deep_map_len(m0) != 0 { panic(140800); };
    let m1 = ecs_eim2_deep_insert(m0, 1, 11);
    let m2 = ecs_eim2_deep_insert(m1, 2, 22);
    let m3 = ecs_eim2_deep_insert(m2, 3, 33);
    if ecs_eim2_deep_map_len(m3) != 3 { panic(140801); };
    if ecs_eim2_deep_map_key_at(m3, 0) != 1 { panic(140802); };
    if ecs_eim2_deep_map_val_at(m3, 0) != 11 { panic(140803); };
    if ecs_eim2_deep_map_key_at(m3, 1) != 2 { panic(140804); };
    if ecs_eim2_deep_map_val_at(m3, 1) != 22 { panic(140805); };
    if ecs_eim2_deep_map_key_at(m3, 2) != 3 { panic(140806); };
    if ecs_eim2_deep_map_val_at(m3, 2) != 33 { panic(140807); };
    // replace existing key's value (slot 1 becomes 99).
    let m4 = ecs_eim2_deep_insert(m3, 2, 99);
    if ecs_eim2_deep_map_len(m4) != 3 { panic(140810); };
    if ecs_eim2_deep_map_val_at(m4, 1) != 99 { panic(140811); };
    if ecs_eim2_deep_map_val_at(m4, 0) != 11 { panic(140812); };
    if ecs_eim2_deep_map_val_at(m4, 2) != 33 { panic(140813); };
    // cap-16 reject: fill to 16 then the 17th insert must NOT grow len.
    let m5 = ecs_eim2_deep_insert(m4, 10, 100);
    let m6 = ecs_eim2_deep_insert(m5, 11, 110);
    let m7 = ecs_eim2_deep_insert(m6, 12, 120);
    let m8 = ecs_eim2_deep_insert(m7, 13, 130);
    let m9 = ecs_eim2_deep_insert(m8, 14, 140);
    let m10 = ecs_eim2_deep_insert(m9, 15, 150);
    let m11 = ecs_eim2_deep_insert(m10, 16, 160);
    let m12 = ecs_eim2_deep_insert(m11, 17, 170);
    let m13 = ecs_eim2_deep_insert(m12, 18, 180);
    let m14 = ecs_eim2_deep_insert(m13, 19, 190);
    let m15 = ecs_eim2_deep_insert(m14, 20, 200);
    let m16 = ecs_eim2_deep_insert(m15, 21, 210);
    let m17 = ecs_eim2_deep_insert(m16, 22, 220);
    if ecs_eim2_deep_map_len(m17) != 16 { panic(140820); };
    // 17th insert rejected (len stays 16, last slot still holds key=22, value=220 — we filled 6 of
    // the 16 so key 22 is the last and the next insert must NOT alter it).
    let m18 = ecs_eim2_deep_insert(m17, 50, 500);
    if ecs_eim2_deep_map_len(m18) != 16 { panic(140821); };
    if ecs_eim2_deep_map_key_at(m18, 15) != 22 { panic(140822); };
    if ecs_eim2_deep_map_val_at(m18, 15) != 220 { panic(140823); };
}

@test "EcsEim2DeepSlice boxed-flag conversion/clone/into-inner"() {
    let m0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let m1 = ecs_eim2_deep_insert(m0, 2, 22);
    // as_slice: len copy, boxed=0.
    let s0 = ecs_eim2_deep_as_slice(m1);
    if ecs_eim2_deep_slice_len(s0) != 2 { panic(140830); };
    if ecs_eim2_deep_slice_boxed(s0) != 0 { panic(140831); };
    if ecs_eim2_deep_slice_key_at(s0, 0) != 1 { panic(140832); };
    if ecs_eim2_deep_slice_val_at(s0, 1) != 22 { panic(140833); };
    // into_boxed_slice: boxed=1.
    let bx1 = ecs_eim2_deep_into_boxed_slice(m1);
    if ecs_eim2_deep_slice_boxed(bx1) != 1 { panic(140840); };
    if ecs_eim2_deep_slice_len(bx1) != 2 { panic(140841); };
    // boxed_clone: still boxed=1.
    let bc = ecs_eim2_deep_boxed_clone(bx1);
    if ecs_eim2_deep_slice_boxed(bc) != 1 { panic(140842); };
    if ecs_eim2_deep_slice_key_at(bc, 0) != 1 { panic(140843); };
    // boxed_into_inner: boxed=0.
    let bi = ecs_eim2_deep_boxed_into_inner(bc);
    if ecs_eim2_deep_slice_boxed(bi) != 0 { panic(140844); };
    if ecs_eim2_deep_slice_val_at(bi, 1) != 22 { panic(140845); };
    // boxed_default: empty + boxed=1.
    let bd = ecs_eim2_deep_boxed_default();
    if ecs_eim2_deep_slice_len(bd) != 0 { panic(140850); };
    if ecs_eim2_deep_slice_boxed(bd) != 1 { panic(140851); };
    // empty_slice: len 0 boxed 0.
    let es = ecs_eim2_deep_empty_slice();
    if ecs_eim2_deep_slice_len(es) != 0 { panic(140852); };
    if ecs_eim2_deep_slice_boxed(es) != 0 { panic(140853); };
}

@test "EcsEim2DeepSlice slice_at in range and out of range"() {
    let m0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 7, 70);
    let m1 = ecs_eim2_deep_insert(m0, 8, 80);
    let s0 = ecs_eim2_deep_as_slice(m1);
    // index 0 (key=7, value=70).
    let r0 = ecs_eim2_deep_slice_at(s0, 0);
    if r0.has != 1 { panic(140860); };
    if r0.key != 7 { panic(140861); };
    if r0.value != 70 { panic(140862); };
    // index 1.
    let r1 = ecs_eim2_deep_slice_at(s0, 1);
    if r1.has != 1 { panic(140863); };
    if r1.key != 8 { panic(140864); };
    if r1.value != 80 { panic(140865); };
    // out of range: -1 and 2.
    if ecs_eim2_deep_slice_at(s0, 2).has != 0 { panic(140866); };
    let rneg = ecs_eim2_deep_slice_at(s0, -1);
    if rneg.has != 0 { panic(140867); };
    if rneg.key != -1 { panic(140868); };
}

@test "EcsEim2DeepSlice range helpers shape a window"() {
    // Build a slice with 4 entries (1,11)(2,22)(3,33)(4,44).
    let t4a = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let t4b = ecs_eim2_deep_insert(t4a, 2, 22);
    let t4c = ecs_eim2_deep_insert(t4b, 3, 33);
    let t4d = ecs_eim2_deep_insert(t4c, 4, 44);
    let s0 = ecs_eim2_deep_as_slice(t4d);
    // range [1, 3) yields (2,22)(3,33) of cap-2 slice.
    let rr = ecs_eim2_deep_slice_range(s0, 1, 3);
    if rr.has != 1 { panic(140870); };
    let out = ecs_eim2_deep_slice_range_slice(s0, 1, 3);
    if ecs_eim2_deep_slice_len(out) != 2 { panic(140871); };
    if ecs_eim2_deep_slice_key_at(out, 0) != 2 { panic(140872); };
    if ecs_eim2_deep_slice_val_at(out, 0) != 22 { panic(140873); };
    if ecs_eim2_deep_slice_key_at(out, 1) != 3 { panic(140874); };
    if ecs_eim2_deep_slice_val_at(out, 1) != 33 { panic(140875); };
    // range_from(2) yields (3,33)(4,44).
    let rfr = ecs_eim2_deep_slice_range_from(s0, 2);
    if rfr.has != 1 { panic(140876); };
    let out_from = ecs_eim2_deep_slice_range_from_slice(s0, 2);
    if ecs_eim2_deep_slice_len(out_from) != 2 { panic(140877); };
    if ecs_eim2_deep_slice_key_at(out_from, 0) != 3 { panic(140878); };
    if ecs_eim2_deep_slice_key_at(out_from, 1) != 4 { panic(140879); };
    // range_to(2) yields (1,11)(2,22).
    let rto = ecs_eim2_deep_slice_range_to(s0, 2);
    if rto.has != 1 { panic(140880); };
    let out_to = ecs_eim2_deep_slice_range_to_slice(s0, 2);
    if ecs_eim2_deep_slice_len(out_to) != 2 { panic(140881); };
    if ecs_eim2_deep_slice_val_at(out_to, 0) != 11 { panic(140882); };
    if ecs_eim2_deep_slice_val_at(out_to, 1) != 22 { panic(140883); };
    // range_inclusive(0, 1) yields (1,11)(2,22).
    let ri = ecs_eim2_deep_slice_range_inclusive(s0, 0, 1);
    if ri.has != 1 { panic(140884); };
    let out_i = ecs_eim2_deep_slice_range_inclusive_slice(s0, 0, 1);
    if ecs_eim2_deep_slice_len(out_i) != 2 { panic(140885); };
    if ecs_eim2_deep_slice_key_at(out_i, 1) != 2 { panic(140886); };
    // bad ranges: negative start, end<start, end>len all rejected (has=0).
    if ecs_eim2_deep_slice_range(s0, -1, 2).has != 0 { panic(140890); };
    if ecs_eim2_deep_slice_range(s0, 3, 2).has != 0 { panic(140891); };
    if ecs_eim2_deep_slice_range(s0, 0, 5).has != 0 { panic(140892); };
}

@test "EcsEim2DeepSlice eq and cmp"() {
    let c5a0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let c5a1 = ecs_eim2_deep_insert(c5a0, 2, 22);
    let c5b0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let c5b1 = ecs_eim2_deep_insert(c5b0, 2, 22);
    let s1 = ecs_eim2_deep_as_slice(c5a1);
    let s2 = ecs_eim2_deep_as_slice(c5b1);
    if ecs_eim2_deep_slice_eq(s1, s2) != true { panic(140900); };
    // different value -> not eq.
    let c5c0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let c5c1 = ecs_eim2_deep_insert(c5c0, 2, 99);
    let s3 = ecs_eim2_deep_as_slice(c5c1);
    if ecs_eim2_deep_slice_eq(s1, s3) != false { panic(140901); };
    // different lengths -> not eq.
    let c5d0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let s4 = ecs_eim2_deep_as_slice(c5d0);
    if ecs_eim2_deep_slice_eq(s1, s4) != false { panic(140902); };
    // cmp: shorter-prefix = prefix equality -> tie broken by length -> (-1) for shorter.
    if ecs_eim2_deep_slice_cmp(s4, s1) != -1 { panic(140910); };
    if ecs_eim2_deep_slice_cmp(s1, s4) != 1 { panic(140911); };
    if ecs_eim2_deep_slice_cmp(s1, s2) != 0 { panic(140912); };
    // first key differs: a.key=1 < b.key=9.
    let c5e0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 9, 22);
    let s5 = ecs_eim2_deep_as_slice(c5e0);
    if ecs_eim2_deep_slice_cmp(s1, s5) != -1 { panic(140913); };
    if ecs_eim2_deep_slice_cmp(s5, s1) != 1 { panic(140914); };
    // values differ where keys are equal.
    let c5f0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 5);
    let s6 = ecs_eim2_deep_as_slice(c5f0);
    if ecs_eim2_deep_slice_cmp(s6, s4) != -1 { panic(140915); };
    if ecs_eim2_deep_slice_cmp(s4, s6) != 1 { panic(140916); };
}

@test "EcsEim2DeepSlice hash stability and content sensitivity"() {
    let h6a0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let h6a1 = ecs_eim2_deep_insert(h6a0, 2, 22);
    let s1 = ecs_eim2_deep_as_slice(h6a1);
    let h1 = ecs_eim2_deep_slice_hash(s1);
    let h6b0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let h6b1 = ecs_eim2_deep_insert(h6b0, 2, 22);
    let s2 = ecs_eim2_deep_as_slice(h6b1);
    let h2 = ecs_eim2_deep_slice_hash(s2);
    if h1 != h2 { panic(140920); };
    // different content -> different hash (value 22 -> 99).
    let h6c0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let h6c1 = ecs_eim2_deep_insert(h6c0, 2, 99);
    let s3 = ecs_eim2_deep_as_slice(h6c1);
    let h3 = ecs_eim2_deep_slice_hash(s3);
    if h1 == h3 { panic(140921); };
    // empty hash = 17.
    let es = ecs_eim2_deep_empty_slice();
    if ecs_eim2_deep_slice_hash(es) != 17 { panic(140922); };
}

@test "EcsEim2DeepIterMut set_next advances and overwrites values"() {
    // Build (key=7,val=70)(8,80)(9,90).
    let t7a = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 7, 70);
    let t7b = ecs_eim2_deep_insert(t7a, 8, 80);
    let t7c = ecs_eim2_deep_insert(t7b, 9, 90);
    let it0 = ecs_eim2_deep_iter_mut(t7c);
    if ecs_eim2_deep_iter_mut_front(it0) != 0 { panic(140930); };
    if ecs_eim2_deep_iter_mut_back(it0) != 3 { panic(140931); };
    // next #1: write value=11 to slot 0, return key=7, old_value=70, new_value=11, advance front=1.
    let r1 = ecs_eim2_deep_iter_mut_set_next(it0, 11);
    if r1.has != 1 { panic(140932); };
    if r1.key != 7 { panic(140933); };
    if r1.old_value != 70 { panic(140934); };
    if r1.new_value != 11 { panic(140935); };
    if r1.r_front != 1 { panic(140936); };
    // rebuild iter from result.
    let it1 = ecs_eim2_deep_iter_mut_from_result(r1);
    if ecs_eim2_deep_iter_mut_val_at(it1, 0) != 11 { panic(140937); };
    if ecs_eim2_deep_iter_mut_front(it1) != 1 { panic(140938); };
    // next #2: write value=22 to slot 1.
    let r2 = ecs_eim2_deep_iter_mut_set_next(it1, 22);
    if r2.has != 1 { panic(140939); };
    if r2.key != 8 { panic(140939); };
    if r2.old_value != 80 { panic(140940); };
    if r2.new_value != 22 { panic(140941); };
    let it2 = ecs_eim2_deep_iter_mut_from_result(r2);
    if ecs_eim2_deep_iter_mut_val_at(it2, 1) != 22 { panic(140942); };
    // next #3 already exhausted after advancing once more — r3 has=0.
    let r3 = ecs_eim2_deep_iter_mut_set_next(it2, 33);
    if r3.has != 1 { panic(140943); };
    let it3 = ecs_eim2_deep_iter_mut_from_result(r3);
    let r4 = ecs_eim2_deep_iter_mut_set_next(it3, 44);
    if r4.has != 0 { panic(140944); };
    if r4.key != -1 { panic(140945); };
    // iter_mut_as_slice reflects the post-write buffer window [front,back). After advancing
    // front=3 the empty window should produce an empty slice.
    let it_empty = ecs_eim2_deep_iter_mut_from_result(r4);
    let asl = ecs_eim2_deep_iter_mut_as_slice(it_empty);
    if ecs_eim2_deep_slice_len(asl) != 0 { panic(140946); };
    // rebuild iter with front=0 to view the full written buffer.
    let it_full = ecs_eim2_deep_iter_mut_from_result(r4);
    // front through back here is [3,3); we re-window to [0,3) via set_window helper for IterMut.
    // Provide a set-window helper for iter_mut mirroring the IntoIter one.
    let it_full2 = ecs_eim2_deep_iter_mut_set_window(it_full, 0, 3);
    let asl2 = ecs_eim2_deep_iter_mut_as_slice(it_full2);
    if ecs_eim2_deep_slice_len(asl2) != 3 { panic(140947); };
    if ecs_eim2_deep_slice_val_at(asl2, 0) != 11 { panic(140948); };
    if ecs_eim2_deep_slice_val_at(asl2, 1) != 22 { panic(140949); };
    if ecs_eim2_deep_slice_val_at(asl2, 2) != 33 { panic(140950); };
}

@test "EcsEim2DeepIntoIter next / next_back / as_slice"() {
    // (1,11)(2,22)(3,33).
    let t8a = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let t8b = ecs_eim2_deep_insert(t8a, 2, 22);
    let t8c = ecs_eim2_deep_insert(t8b, 3, 33);
    let it0 = ecs_eim2_deep_into_iter(t8c);
    // next() should yield in order from front: (1,11) then (2,22) then (3,33).
    let n0 = ecs_eim2_deep_into_iter_next(it0);
    if n0.has != 1 { panic(140960); };
    if n0.key != 1 { panic(140961); };
    if n0.value != 11 { panic(140962); };
    // advance via set_window.
    let it1 = ecs_eim2_deep_into_iter_set_window(it0, n0.iter_front, n0.iter_back);
    let n1 = ecs_eim2_deep_into_iter_next(it1);
    if n1.has != 1 { panic(140963); };
    if n1.key != 2 { panic(140964); };
    if n1.value != 22 { panic(140965); };
    let it2 = ecs_eim2_deep_into_iter_set_window(it1, n1.iter_front, n1.iter_back);
    let n2 = ecs_eim2_deep_into_iter_next(it2);
    if n2.key != 3 { panic(140966); };
    let it3 = ecs_eim2_deep_into_iter_set_window(it2, n2.iter_front, n2.iter_back);
    let n3 = ecs_eim2_deep_into_iter_next(it3);
    if n3.has != 0 { panic(140967); };
    // next_back: pop from back.
    let itb0 = ecs_eim2_deep_into_iter_set_window(ecs_eim2_deep_into_iter(t8c), 0, 3);
    let nb0 = ecs_eim2_deep_into_iter_next_back(itb0);
    if nb0.key != 3 { panic(140968); };
    if nb0.value != 33 { panic(140969); };
    let itb1 = ecs_eim2_deep_into_iter_set_window(itb0, nb0.iter_front, nb0.iter_back);
    let nb1 = ecs_eim2_deep_into_iter_next_back(itb1);
    if nb1.key != 2 { panic(140970); };
    // as_slice of full window shows all three.
    let asl = ecs_eim2_deep_into_iter_as_slice(ecs_eim2_deep_into_iter(t8c));
    if ecs_eim2_deep_slice_len(asl) != 3 { panic(140971); };
    if ecs_eim2_deep_slice_key_at(asl, 0) != 1 { panic(140972); };
    if ecs_eim2_deep_slice_key_at(asl, 1) != 2 { panic(140973); };
    if ecs_eim2_deep_slice_key_at(asl, 2) != 3 { panic(140974); };
}

@test "EcsEim2DeepDrain drain splits kept vs drained buffers"() {
    // Build (1,11)(2,22)(3,33)(4,44)(5,55).
    let t10a = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let t10b = ecs_eim2_deep_insert(t10a, 2, 22);
    let t10c = ecs_eim2_deep_insert(t10b, 3, 33);
    let t10d = ecs_eim2_deep_insert(t10c, 4, 44);
    let t10e = ecs_eim2_deep_insert(t10d, 5, 55);
    // drain [1, 3): removes 2,22 and 3,33; kept = (1,11)(4,44)(5,55); drained = (2,22)(3,33).
    let dr = ecs_eim2_deep_drain_result(t10e, 1, 3);
    if dr.has != 1 { panic(140980); };
    let kept = ecs_eim2_deep_drain_kept_map(t10e, 1, 3);
    if ecs_eim2_deep_map_len(kept) != 3 { panic(140981); };
    if ecs_eim2_deep_map_key_at(kept, 0) != 1 { panic(140982); };
    if ecs_eim2_deep_map_val_at(kept, 0) != 11 { panic(140983); };
    if ecs_eim2_deep_map_key_at(kept, 1) != 4 { panic(140984); };
    if ecs_eim2_deep_map_val_at(kept, 1) != 44 { panic(140985); };
    if ecs_eim2_deep_map_key_at(kept, 2) != 5 { panic(140986); };
    if ecs_eim2_deep_map_val_at(kept, 2) != 55 { panic(140987); };
    // drain buffer.
    let d = ecs_eim2_deep_drain_drained(t10e, 1, 3);
    if ecs_eim2_deep_drain_len(d) != 2 { panic(140988); };
    if ecs_eim2_deep_drain_key_at(d, 0) != 2 { panic(140989); };
    if ecs_eim2_deep_drain_val_at(d, 0) != 22 { panic(140990); };
    if ecs_eim2_deep_drain_key_at(d, 1) != 3 { panic(140991); };
    if ecs_eim2_deep_drain_val_at(d, 1) != 33 { panic(140992); };
    // drain_as_slice of the drained buffer.
    let asl = ecs_eim2_deep_drain_as_slice(d);
    if ecs_eim2_deep_slice_len(asl) != 2 { panic(140993); };
    if ecs_eim2_deep_slice_key_at(asl, 0) != 2 { panic(140994); };
    if ecs_eim2_deep_slice_key_at(asl, 1) != 3 { panic(140995); };
    // Clamp extremes: drain [0, 100] drains every entry, kept empty.
    let kept_all = ecs_eim2_deep_drain_kept_map(t10e, 0, 100);
    if ecs_eim2_deep_map_len(kept_all) != 0 { panic(140996); };
    let d_all = ecs_eim2_deep_drain_drained(t10e, 0, 100);
    if ecs_eim2_deep_drain_len(d_all) != 5 { panic(140997); };
    // Empty range drain [2, 2) leaves map intact, drain buffer empty.
    let kept_eq = ecs_eim2_deep_drain_kept_map(t10e, 2, 2);
    if ecs_eim2_deep_map_len(kept_eq) != 5 { panic(140998); };
    if ecs_eim2_deep_drain_drained(t10e, 2, 2).len != 0 { panic(140999); };
}

@test "EcsEim2DeepIntoIter empty window and exhausted behavior"() {
    // (1,11) single-entry map.
    let x0 = ecs_eim2_deep_insert(ecs_eim2_deep_new(), 1, 11);
    let it_full = ecs_eim2_deep_into_iter(x0);
    if ecs_eim2_deep_into_iter_len(it_full) != 1 { panic(140923); };
    // next() returns the only entry; next_back again is empty window -> has=0.
    let nx = ecs_eim2_deep_into_iter_next(it_full);
    if nx.has != 1 { panic(140924); };
    if nx.key != 1 { panic(140925); };
    if nx.value != 11 { panic(140926); };
    let it_adv = ecs_eim2_deep_into_iter_set_window(it_full, nx.iter_front, nx.iter_back);
    let nb_ex = ecs_eim2_deep_into_iter_next_back(it_adv);
    if nb_ex.has != 0 { panic(140927); };
    if nb_ex.iter_front != nx.iter_front { panic(140928); };
    if nb_ex.iter_back != nx.iter_back { panic(140929); };
    let nx_ex = ecs_eim2_deep_into_iter_next(it_adv);
    if nx_ex.has != 0 { panic(140951); };
    // as_slice of an empty-from-the-start window (front=0, back=0) is empty.
    let it_empty = ecs_eim2_deep_into_iter_set_window(ecs_eim2_deep_into_iter(x0), 0, 0);
    let es = ecs_eim2_deep_into_iter_as_slice(it_empty);
    if ecs_eim2_deep_slice_len(es) != 0 { panic(140952); };
    // collapsed map (len=0) emits a fast-empty iter with no front/back movement.
    let empty_iter = ecs_eim2_deep_into_iter(ecs_eim2_deep_new());
    if ecs_eim2_deep_into_iter_front(empty_iter) != 0 { panic(140953); };
    if ecs_eim2_deep_into_iter_back(empty_iter) != 0 { panic(140954); };
    let nxz = ecs_eim2_deep_into_iter_next(empty_iter);
    if nxz.has != 0 { panic(140955); };
    if nxz.iter_front != 0 { panic(140956); };
    if nxz.iter_back != 0 { panic(140957); };
}
