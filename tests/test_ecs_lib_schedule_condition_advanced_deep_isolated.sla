@import "lib/schedule_condition_advanced_deep.sla"

// Batch 343: schedule_condition_advanced deep.
// panic codes: 134600 – 134799.

@test "changed_first_call"() {
    let st = ecs_cond_state_new();
    let c = ecs_cond_changed(st, true);
    if ecs_cond_changed_result(c) != 1 { panic(134600); };
    if ecs_cond_state_prev(ecs_cond_changed_state(c)) != 1 { panic(134601); };
    if ecs_cond_state_initialized(ecs_cond_changed_state(c)) != 1 { panic(134602); };
    if ecs_cond_state_calls(ecs_cond_changed_state(c)) != 1 { panic(134603); };
}

@test "changed_no_change"() {
    let st = ecs_cond_changed_state(ecs_cond_changed(ecs_cond_state_new(), true));
    let s2 = ecs_cond_changed(st, true);
    if ecs_cond_changed_result(s2) != 0 { panic(134610); };
    if ecs_cond_state_calls(ecs_cond_changed_state(s2)) != 2 { panic(134611); };
}

@test "changed_flip"() {
    let st = ecs_cond_changed_state(ecs_cond_changed(ecs_cond_state_new(), true));
    let s2 = ecs_cond_changed(st, false);
    if ecs_cond_changed_result(s2) != 1 { panic(134620); };
}

@test "changed_to_matching"() {
    let st = ecs_cond_state_new();
    let r1 = ecs_cond_changed_to(st, true, true);
    if ecs_cond_changed_to_result(r1) != 1 { panic(134630); };
    let st2 = ecs_cond_changed_to_state(r1);
    let r2 = ecs_cond_changed_to(st2, true, false);
    if ecs_cond_changed_to_result(r2) != 0 { panic(134631); };
    let st3 = ecs_cond_changed_to_state(r2);
    let r3 = ecs_cond_changed_to(st3, true, true);
    if ecs_cond_changed_to_result(r3) != 1 { panic(134632); };
}

@test "combinators_basic"() {
    if ecs_cond_and(true, false) != false { panic(134640); };
    if ecs_cond_or(true, false) != true { panic(134641); };
    if ecs_cond_nand(true, true) != false { panic(134642); };
    if ecs_cond_nor(false, false) != true { panic(134643); };
    if ecs_cond_xor(true, false) != true { panic(134644); };
    if ecs_cond_not(true) != false { panic(134645); };
}

@test "combine_by_kind"() {
    if ecs_cond_combine(ECS_COND_AND_THEN, true, true) != true { panic(134650); };
    if ecs_cond_combine(ECS_COND_OR_EAGER, false, false) != false { panic(134651); };
    if ecs_cond_combine(ECS_COND_NOR_THEN, true, false) != false { panic(134652); };
    if ecs_cond_combine(ECS_COND_XOR_THEN, true, true) != false { panic(134653); };
}

@test "combine_i32"() {
    if ecs_cond_combine_i32(ECS_COND_AND_THEN, 1, 1) != 1 { panic(134660); };
    if ecs_cond_combine_i32(ECS_COND_AND_THEN, 1, 0) != 0 { panic(134661); };
    if ecs_cond_combine_i32(ECS_COND_OR_ELSE, 0, 1) != 1 { panic(134662); };
}

@test "resource_exists_and"() {
    if ecs_cond_resource_exists_and(true, true) != true { panic(134670); };
    if ecs_cond_resource_exists_and(false, true) != false { panic(134671); };
    if ecs_cond_resource_exists_and(true, false) != false { panic(134672); };
}

@test "cond_set_push_fold"() {
    let s = ecs_cond_set_new(ECS_COND_AND_THEN);
    s = ecs_cond_set_push(s, 1, true);
    if ecs_cond_set_len(s) != 1 { panic(134680); };
    if ecs_cond_set_get(s, 0) != 1 { panic(134681); };
    s = ecs_cond_set_push(s, 2, true);
    s = ecs_cond_set_push(s, 3, false);
    if ecs_cond_set_fold(s) != 0 { panic(134682); };
}

@test "cond_set_or_fold"() {
    let s = ecs_cond_set_new(ECS_COND_OR_ELSE);
    s = ecs_cond_set_push(s, 1, false);
    s = ecs_cond_set_push(s, 2, true);
    s = ecs_cond_set_push(s, 3, false);
    if ecs_cond_set_fold(s) != 1 { panic(134690); };
    if ecs_cond_set_fold_kind(s) != ECS_COND_OR_ELSE { panic(134691); };
}
