@import "lib/event_mod.sla"

// Isolated tests for lib/event_mod.sla — EventKey + World event registry facade.
// Bevy reference: src/event/mod.rs

@test "event_key_new_id"() {
    let k = ecs_event_key_new(42);
    if ecs_event_key_component_id(k) != 42 { panic(91044); };
}

@test "event_registry_new_empty"() {
    let r = ecs_event_registry_new();
    if ecs_event_registry_len(r) != 0 { panic(91045); };
    if ecs_event_registry_is_empty(r) != true { panic(91046); };
    if ecs_event_registry_next_component_id(r) != 1 { panic(91047); };
}

@test "register_event_key_new"() {
    let r = ecs_event_registry_new();
    let res = ecs_event_registry_register_event_key(r, 100);
    let r2 = res.0;
    let k = res.1;
    if ecs_event_key_component_id(k) != 1 { panic(91048); };
    if ecs_event_registry_len(r2) != 1 { panic(91049); };
    if ecs_event_registry_next_component_id(r2) != 2 { panic(91050); };
}

@test "register_event_key_idempotent"() {
    let r = ecs_event_registry_new();
    let res1 = ecs_event_registry_register_event_key(r, 100);
    let r2 = res1.0;
    let res2 = ecs_event_registry_register_event_key(r2, 100);
    let k = res2.1;
    let r3 = res2.0;
    if ecs_event_key_component_id(k) != 1 { panic(91051); };
    if ecs_event_registry_len(r3) != 1 { panic(91052); };
    if ecs_event_registry_next_component_id(r3) != 2 { panic(91053); };
}

@test "register_multiple_event_keys"() {
    let r = ecs_event_registry_new();
    let res1 = ecs_event_registry_register_event_key(r, 100);
    let r2 = res1.0;
    let res2 = ecs_event_registry_register_event_key(r2, 200);
    let r3 = res2.0;
    let k2 = res2.1;
    let res3 = ecs_event_registry_register_event_key(r3, 300);
    let r4 = res3.0;
    let k3 = res3.1;
    if ecs_event_registry_len(r4) != 3 { panic(91054); };
    if ecs_event_key_component_id(k2) != 2 { panic(91055); };
    if ecs_event_key_component_id(k3) != 3 { panic(91056); };
    if ecs_event_registry_next_component_id(r4) != 4 { panic(91057); };
}

@test "event_key_lookup_present"() {
    let r = ecs_event_registry_new();
    let res = ecs_event_registry_register_event_key(r, 100);
    let r2 = res.0;
    let g = ecs_event_registry_event_key(r2, 100);
    if g.0 != true { panic(91058); };
    if g.1 != 1 { panic(91059); };
}

@test "event_key_lookup_absent"() {
    let r = ecs_event_registry_new();
    let res = ecs_event_registry_register_event_key(r, 100);
    let r2 = res.0;
    let g = ecs_event_registry_event_key(r2, 999);
    if g.0 != false { panic(91060); };
}

@test "event_key_lookup_after_remove"() {
    let r = ecs_event_registry_new();
    let res = ecs_event_registry_register_event_key(r, 100);
    let r2 = res.0;
    let rm = ecs_event_registry_remove_event_key(r2, 100);
    if rm.0 != true { panic(91061); };
    let r3 = rm.1;
    let g = ecs_event_registry_event_key(r3, 100);
    if g.0 != false { panic(91062); };
    if ecs_event_registry_len(r3) != 0 { panic(91063); };
}

@test "remove_event_key_missing"() {
    let r = ecs_event_registry_new();
    let res = ecs_event_registry_register_event_key(r, 100);
    let r2 = res.0;
    let rm = ecs_event_registry_remove_event_key(r2, 999);
    if rm.0 != false { panic(91064); };
    if ecs_event_registry_len(rm.1) != 1 { panic(91065); };
}

@test "register_after_remove_allocates_new_id"() {
    let r = ecs_event_registry_new();
    let res1 = ecs_event_registry_register_event_key(r, 100);
    let r2 = res1.0;
    let rm = ecs_event_registry_remove_event_key(r2, 100);
    let r3 = rm.1;
    let res3 = ecs_event_registry_register_event_key(r3, 100);
    let k = res3.1;
    // Component ids are monotonic; a fresh register re-uses freed id allocation pattern.
    if ecs_event_key_component_id(k) != 2 { panic(91066); };
    if ecs_event_registry_next_component_id(res3.0) != 3 { panic(91067); };
}

@test "registry_full_workflow"() {
    let r0 = ecs_event_registry_new();
    let res1 = ecs_event_registry_register_event_key(r0, 10);
    let r1 = res1.0;
    let res2 = ecs_event_registry_register_event_key(r1, 20);
    let r2 = res2.0;
    let res3 = ecs_event_registry_register_event_key(r2, 30);
    let r3 = res3.0;
    let g = ecs_event_registry_event_key(r3, 20);
    if g.0 != true { panic(91068); };
    if g.1 != 2 { panic(91069); };
    let rm = ecs_event_registry_remove_event_key(r3, 20);
    let r4 = rm.1;
    if ecs_event_registry_len(r4) != 2 { panic(91070); };
    let g2 = ecs_event_registry_event_key(r4, 10);
    if g2.1 != 1 { panic(91071); };
    let g3 = ecs_event_registry_event_key(r4, 30);
    if g3.1 != 3 { panic(91072); };
}
