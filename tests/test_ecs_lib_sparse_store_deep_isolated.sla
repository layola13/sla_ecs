@import "lib/sparse_store_deep.sla"

// Batch 340: sparse_store deep.
// panic codes: 134000 – 134199.

@test "new_empty"() {
    let s = ecs_ssd_new();
    if ecs_ssd_count(s) != 0 { panic(134000); };
    if ecs_ssd_is_empty(s) != true { panic(134001); };
}

@test "insert_get_has"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 1, 10, 20);
    if ecs_ssd_count(s) != 1 { panic(134010); };
    if ecs_ssd_has(s, 1) != true { panic(134011); };
    if ecs_ssd_dense_slot_of(s, 1) != 0 { panic(134012); };
    let g = ecs_ssd_get(s, 1);
    if ecs_ssd_get_ok(g) != true { panic(134013); };
    if ecs_ssd_get_x(g) != 10 { panic(134014); };
    if ecs_ssd_get_y(g) != 20 { panic(134015); };
}

@test "write_updates"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 1, 1, 2);
    let slot = ecs_ssd_dense_slot_of(s, 1);
    s = ecs_ssd_write(s, slot, 26, 6);
    let g = ecs_ssd_get(s, 1);
    if ecs_ssd_get_x(g) != 26 { panic(134020); };
    if ecs_ssd_get_y(g) != 6 { panic(134021); };
}

@test "remove_swap_mapping"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 1, 10, 0);
    s = ecs_ssd_insert(s, 2, 20, 0);
    s = ecs_ssd_insert(s, 3, 30, 0);
    let slot = ecs_ssd_dense_slot_of(s, 2);
    s = ecs_ssd_remove(s, 2);
    if ecs_ssd_count(s) != 2 { panic(134030); };
    if ecs_ssd_has(s, 2) != false { panic(134031); };
    if ecs_ssd_has(s, 3) != true { panic(134032); };
    let moved_slot = ecs_ssd_dense_slot_of(s, 3);
    if moved_slot != slot { panic(134033); };
    let moved = ecs_ssd_get(s, 3);
    if ecs_ssd_get_x(moved) != 30 { panic(134034); };
}

@test "insert_duplicate_noop"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 5, 1, 1);
    let s2 = ecs_ssd_insert(s, 5, 9, 9);
    if ecs_ssd_count(s2) != 1 { panic(134040); };
    if ecs_ssd_get_x(ecs_ssd_get(s2, 5)) != 1 { panic(134041); };
}

@test "remove_missing_noop"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 1, 1, 1);
    let s2 = ecs_ssd_remove(s, 99);
    if ecs_ssd_count(s2) != 1 { panic(134050); };
}

@test "capacity_four"() {
    let s = ecs_ssd_new();
    s = ecs_ssd_insert(s, 1, 1, 0);
    s = ecs_ssd_insert(s, 2, 2, 0);
    s = ecs_ssd_insert(s, 3, 3, 0);
    s = ecs_ssd_insert(s, 4, 4, 0);
    if ecs_ssd_count(s) != 4 { panic(134060); };
    let full = ecs_ssd_insert(s, 5, 5, 0);
    if ecs_ssd_count(full) != 4 { panic(134061); };
    if ecs_ssd_has(full, 5) != false { panic(134062); };
}

@test "dense_entity_at"() {
    let s = ecs_ssd_insert(ecs_ssd_insert(ecs_ssd_new(), 10, 100, 1), 20, 200, 2);
    if ecs_ssd_dense_entity_at(s, 0) != 10 { panic(134070); };
    if ecs_ssd_dense_entity_at(s, 1) != 20 { panic(134071); };
}

@test "clear"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 1, 1, 1);
    s = ecs_ssd_clear(s);
    if ecs_ssd_is_empty(s) != true { panic(134080); };
    if ecs_ssd_has(s, 1) != false { panic(134081); };
}

@test "get_missing"() {
    let s = ecs_ssd_insert(ecs_ssd_new(), 1, 1, 1);
    let g = ecs_ssd_get(s, 2);
    if ecs_ssd_get_ok(g) != false { panic(134090); };
    if ecs_ssd_dense_slot_of(s, 2) != -1 { panic(134091); };
}
