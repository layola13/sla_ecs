// Isolated deep tests for lib/system_registry_template_deep.sla (Batch 406).
// Tests the deep system-registry templates: SystemHandleOrValue, SystemHandleValue (ref count),
// SystemHandleTemplate (handle/value variants + build), CachedSystemId, CachedSystemRegistry
// (register/unregister/find/contains/count/run/run_with), TrackedSystem, stripped handle, and
// TemplateContext.

@import "lib/system_registry_template_deep.sla"

@test "hov_handle_and_value"() {
    let h = ecs_sys_hov_deep_handle(99);
    if ecs_sys_hov_deep_is_handle(h) != true { panic(146100); };
    if ecs_sys_hov_deep_is_value(h) != false { panic(146101); };
    if ecs_sys_hov_deep_handle_entity(h) != 99 { panic(146102); };
    if ecs_sys_hov_deep_has_value(h) != false { panic(146103); };
    if ecs_sys_hov_deep_system_id(h) != 0 { panic(146104); };
    let v = ecs_sys_hov_deep_value(42);
    if ecs_sys_hov_deep_is_value(v) != true { panic(146105); };
    if ecs_sys_hov_deep_is_handle(v) != false { panic(146106); };
    if ecs_sys_hov_deep_system_id(v) != 42 { panic(146107); };
    if ecs_sys_hov_deep_has_value(v) != true { panic(146108); };
    if ecs_sys_hov_deep_handle_entity(v) != 0 { panic(146109); };
}

@test "handle_value_new_clone_drop_refcount"() {
    let v0 = ecs_system_handle_value_deep_new(7);
    if ecs_system_handle_value_deep_ref_count(v0) != 1 { panic(146120); };
    if ecs_system_handle_value_deep_inner_kind(v0) != 1 { panic(146121); };
    if ecs_system_handle_value_deep_has_value(v0) != true { panic(146122); };
    let v1 = ecs_system_handle_value_deep_clone(v0);
    if ecs_system_handle_value_deep_ref_count(v1) != 2 { panic(146123); };
    let v2 = ecs_system_handle_value_deep_drop_clone(v1);
    if ecs_system_handle_value_deep_ref_count(v2) != 1 { panic(146124); };
    let v3 = ecs_system_handle_value_deep_drop_clone(v2);
    if ecs_system_handle_value_deep_ref_count(v3) != 0 { panic(146125); };
    // Drop once more — ref_count stays at 0 (guarded).
    let v4 = ecs_system_handle_value_deep_drop_clone(v3);
    if ecs_system_handle_value_deep_ref_count(v4) != 0 { panic(146126); };
}

@test "handle_value_build_converts_to_handle"() {
    let v0 = ecs_system_handle_value_deep_new(5);
    let v1 = ecs_system_handle_value_deep_build(v0, 200);
    if ecs_system_handle_value_deep_inner_kind(v1) != 0 { panic(146140); };
    if ecs_system_handle_value_deep_handle(v1) != 200 { panic(146141); };
    if ecs_system_handle_value_deep_has_value(v1) != false { panic(146142); };
    // Calling build on an already-converted value is a no-op (mutation branch guarded).
    let v2 = ecs_system_handle_value_deep_build(v1, 999);
    if ecs_system_handle_value_deep_handle(v2) != 200 { panic(146143); };
}

@test "template_handle_weak_and_value"() {
    let t_h = ecs_system_template_deep_handle_weak(11);
    if ecs_system_template_deep_is_handle(t_h) != true { panic(146160); };
    if ecs_system_template_deep_is_value(t_h) != false { panic(146161); };
    if ecs_system_template_deep_handle(t_h) != 11 { panic(146162); };
    if ecs_system_template_deep_value_ref_count(t_h) != 1 { panic(146163); };
    let t_v = ecs_system_template_deep_value(33);
    if ecs_system_template_deep_is_value(t_v) != true { panic(146164); };
    if ecs_system_template_deep_is_handle(t_v) != false { panic(146165); };
    if ecs_system_template_deep_handle(t_v) != 0 { panic(146166); };
    if ecs_system_template_deep_value_ref_count(t_v) != 1 { panic(146167); };
}

@test "template_default"() {
    let d = ecs_system_template_deep_default();
    if ecs_system_template_deep_is_handle(d) != true { panic(146180); };
    if ecs_system_template_deep_handle(d) != (0 - 1) { panic(146181); };
}

@test "template_clone_handle_bumps_no_refcount"() {
    let t_h = ecs_system_template_deep_handle_weak(11);
    let t_copy = ecs_system_template_deep_clone(t_h);
    if ecs_system_template_deep_is_handle(t_copy) != true { panic(146200); };
    if ecs_system_template_deep_handle(t_copy) != 11 { panic(146201); };
    // Handle variant cloning does NOT touch the value ref count.
    if ecs_system_template_deep_value_ref_count(t_copy) != 1 { panic(146202); };
}

@test "template_clone_value_bumps_refcount"() {
    let t_v = ecs_system_template_deep_value(33);
    let t_v_clone = ecs_system_template_deep_clone(t_v);
    if ecs_system_template_deep_is_value(t_v_clone) != true { panic(146220); };
    if ecs_system_template_deep_value_ref_count(t_v_clone) != 2 { panic(146221); };
}

@test "template_from_handle_boxed_id"() {
    let t1 = ecs_system_template_deep_from_handle(7);
    if ecs_system_template_deep_is_handle(t1) != true { panic(146240); };
    if ecs_system_template_deep_handle(t1) != 7 { panic(146241); };
    let t2 = ecs_system_template_deep_from_boxed(8);
    if ecs_system_template_deep_is_value(t2) != true { panic(146242); };
    let t3 = ecs_system_template_deep_from_id(9);
    if ecs_system_template_deep_is_handle(t3) != true { panic(146243); };
    if ecs_system_template_deep_handle(t3) != 9 { panic(146244); };
}

@test "template_build_handle_returns_handle"() {
    let t = ecs_system_template_deep_handle_weak(100);
    let t2 = ecs_system_template_deep_build(t, 999);
    if ecs_template_deep_last_build_entity(t2) != 100 { panic(146260); };
    if ecs_system_template_deep_is_handle(t2) != true { panic(146261); };
    if ecs_system_template_deep_handle(t2) != 100 { panic(146262); };
}

@test "template_build_value_converts_and_assigns"() {
    let t = ecs_system_template_deep_value(33);
    let t2 = ecs_system_template_deep_build(t, 500);
    if ecs_template_deep_last_build_entity(t2) != 500 { panic(146280); };
    if ecs_system_template_deep_is_handle(t2) != true { panic(146281); };
    if ecs_system_template_deep_handle(t2) != 500 { panic(146282); };
    if ecs_system_template_deep_value_ref_count(t2) != 1 { panic(146283); };
}

@test "system_value_new_alias"() {
    let t = ecs_system_value_deep_new(123);
    if ecs_system_template_deep_is_value(t) != true { panic(146300); };
    if ecs_system_template_deep_value_ref_count(t) != 1 { panic(146301); };
}

@test "cached_system_id"() {
    let c = ecs_cached_system_id_deep_new(55, 7);
    if ecs_cached_system_id_deep_entity(c) != 55 { panic(146320); };
    if ecs_cached_system_id_deep_type_id(c) != 7 { panic(146321); };
}

@test "cached_registry_new_empty"() {
    let reg = ecs_cached_system_registry_deep_new();
    if ecs_cached_registry_deep_count(reg) != 0 { panic(146340); };
    if ecs_cached_registry_deep_find(reg, 1) >= 0 { panic(146341); };
    if ecs_cached_registry_deep_contains(reg, 1) != false { panic(146342); };
}

@test "cached_registry_register_find_contains"() {
    let reg = ecs_cached_system_registry_deep_new();
    let reg1 = ecs_cached_registry_deep_register(reg, 10, 100);
    if ecs_cached_registry_deep_last_registered_entity(reg1) != 100 { panic(146360); };
    if ecs_cached_registry_deep_count(reg1) != 1 { panic(146361); };
    if ecs_cached_registry_deep_find(reg1, 10) != 100 { panic(146362); };
    if ecs_cached_registry_deep_contains(reg1, 10) != true { panic(146363); };
    let reg2 = ecs_cached_registry_deep_register(reg1, 20, 200);
    if ecs_cached_registry_deep_count(reg2) != 2 { panic(146364); };
    if ecs_cached_registry_deep_find(reg2, 20) != 200 { panic(146365); };
}

@test "cached_registry_register_existing_returns_existing"() {
    let reg = ecs_cached_system_registry_deep_new();
    let reg1 = ecs_cached_registry_deep_register(reg, 10, 100);
    let reg2 = ecs_cached_registry_deep_register(reg1, 10, 999);
    if ecs_cached_registry_deep_last_registered_entity(reg2) != 100 { panic(146380); };
    if ecs_cached_registry_deep_count(reg2) != 1 { panic(146381); };
}

@test "cached_registry_run_returns_entity"() {
    let reg = ecs_cached_system_registry_deep_new();
    let reg1 = ecs_cached_registry_deep_register(reg, 10, 100);
    if ecs_cached_registry_deep_run(reg1, 10) != 100 { panic(146400); };
    if ecs_cached_registry_deep_run(reg1, 99) != (0 - 1) { panic(146401); };
}

@test "cached_registry_run_with_preserves_input"() {
    let reg = ecs_cached_system_registry_deep_new();
    let reg1 = ecs_cached_registry_deep_register(reg, 10, 100);
    let rw = ecs_cached_registry_deep_run_with(reg1, 10, 555);
    if ecs_cached_registry_deep_last_run_with_entity(rw) != 100 { panic(146420); };
    if ecs_cached_registry_deep_last_run_with_input(rw) != 555 { panic(146421); };
    let rw_missing = ecs_cached_registry_deep_run_with(reg1, 99, 777);
    if ecs_cached_registry_deep_last_run_with_entity(rw_missing) != (0 - 1) { panic(146422); };
    if ecs_cached_registry_deep_last_run_with_input(rw_missing) != 777 { panic(146423); };
}

@test "cached_registry_unregister_actually_removes"() {
    let reg = ecs_cached_system_registry_deep_new();
    let reg1 = ecs_cached_registry_deep_register(reg, 10, 100);
    let reg2 = ecs_cached_registry_deep_register(reg1, 20, 200);
    let reg3 = ecs_cached_registry_deep_unregister(reg2, 10);
    if ecs_cached_registry_deep_last_unregister_success(reg3) != true { panic(146440); };
    if ecs_cached_registry_deep_count(reg3) != 1 { panic(146441); };
    if ecs_cached_registry_deep_contains(reg3, 10) != false { panic(146442); };
    if ecs_cached_registry_deep_contains(reg3, 20) != true { panic(146443); };
    if ecs_cached_registry_deep_find(reg3, 20) != 200 { panic(146444); };
}

@test "cached_registry_unregister_missing_is_unsuccessful"() {
    let reg = ecs_cached_system_registry_deep_new();
    let reg2 = ecs_cached_registry_deep_unregister(reg, 999);
    if ecs_cached_registry_deep_last_unregister_success(reg2) != false { panic(146460); };
    if ecs_cached_registry_deep_count(reg2) != 0 { panic(146461); };
}

@test "tracked_system_and_boxed_alias"() {
    let t = ecs_tracked_system_deep_new(50, 60);
    if ecs_tracked_system_deep_entity(t) != 50 { panic(146480); };
    if ecs_tracked_system_deep_despawner_entity(t) != 60 { panic(146481); };
    let tb = ecs_tracked_boxed_deep_new(70, 80);
    if ecs_tracked_system_deep_entity(tb) != 70 { panic(146482); };
    if ecs_tracked_system_deep_despawner_entity(tb) != 80 { panic(146483); };
}

@test "system_id_and_despawner_simple_wrappers"() {
    let id = ecs_system_id_deep_mk(11);
    if ecs_system_id_deep_entity(id) != 11 { panic(146500); };
    let d = ecs_registered_system_despawner_deep_mk(22);
    if ecs_registered_system_despawner_deep_entity(d) != 22 { panic(146501); };
}

@test "stripped_handle_strong_weak"() {
    let hs = ecs_stripped_handle_deep_strong(3);
    if ecs_stripped_handle_deep_is_strong(hs) != true { panic(146520); };
    if ecs_stripped_handle_deep_is_weak(hs) != false { panic(146521); };
    if ecs_stripped_handle_deep_entity(hs) != 3 { panic(146522); };
    let hw = ecs_stripped_handle_deep_weak(4);
    if ecs_stripped_handle_deep_is_weak(hw) != true { panic(146523); };
    if ecs_stripped_handle_deep_is_strong(hw) != false { panic(146524); };
    if ecs_stripped_handle_deep_entity(hw) != 4 { panic(146525); };
}

@test "template_context_new_and_alloc"() {
    let c = ecs_template_context_deep_new(100);
    if ecs_template_context_deep_next(c) != 100 { panic(146540); };
    let c1 = ecs_template_context_deep_allocate_entity(c);
    if ecs_template_context_deep_last_allocated_entity(c1) != 100 { panic(146541); };
    if ecs_template_context_deep_next(c1) != 101 { panic(146542); };
    let c2 = ecs_template_context_deep_allocate_entity(c1);
    if ecs_template_context_deep_last_allocated_entity(c2) != 101 { panic(146543); };
    if ecs_template_context_deep_next(c2) != 102 { panic(146544); };
}

@test "template_clone_template_alias"() {
    let t = ecs_system_template_deep_value(900);
    let t_clone = ecs_template_deep_clone_template(t);
    if ecs_system_template_deep_value_ref_count(t_clone) != 2 { panic(146560); };
    let t_h = ecs_system_template_deep_handle_weak(5);
    let t_h_clone = ecs_template_deep_clone_template(t_h);
    if ecs_system_template_deep_handle(t_h_clone) != 5 { panic(146561); };
}

@test "cached_registry_cap16_not_exceeded_on_overflow"() {
    let reg = ecs_cached_system_registry_deep_new();
    let i: i32 = 0;
    while i < 16 {
        reg = ecs_cached_registry_deep_register(reg, 100 + i, 1000 + i as i64);
        i = i + 1;
    }
    if ecs_cached_registry_deep_count(reg) != 16 { panic(146580); };
    // 17th register: cap-16 guard holds: count stays at 16 (the slot for type_id 116 is recorded
    // but the count itself does not go past cap).
    let reg17 = ecs_cached_registry_deep_register(reg, 116, 9000);
    if ecs_cached_registry_deep_count(reg17) > 16 { panic(146581); };
}
