@import "lib/change_detection_traits_deep.sla"

// Batch 221: change_detection traits deep (src/change_detection/traits.rs).
// panic codes: 110200 – 110399.

@test "is_added_and_changed_basic"() {
    // value added/changed at 5; last_run=3; this_run=10
    let d = ecs_cdtr_new(1, 5, 5, 3, 10);
    if ecs_cdtr_is_added(d) != true { panic(110200); };
    if ecs_cdtr_is_changed(d) != true { panic(110201); };
    if ecs_cdtr_is_mutated_only(d) != false { panic(110202); };
}

@test "mutated_only_after_change"() {
    // added at 2 (before last_run=4), changed at 6; this_run=10
    let d = ecs_cdtr_new(0, 2, 6, 4, 10);
    if ecs_cdtr_is_added(d) != false { panic(110210); };
    if ecs_cdtr_is_changed(d) != true { panic(110211); };
    if ecs_cdtr_is_mutated_only(d) != true { panic(110212); };
}

@test "is_changed_after"() {
    let d = ecs_cdtr_new(0, 1, 8, 0, 10);
    if ecs_cdtr_is_changed_after(d, 5) != true { panic(110220); };
    if ecs_cdtr_is_changed_after(d, 9) != false { panic(110221); };
    if ecs_cdtr_is_added_after(d, 0) != true { panic(110222); };
}

@test "set_changed_flags_this_run"() {
    let d = ecs_cdtr_new(1, 1, 1, 5, 10);
    d = ecs_cdtr_set_changed(d);
    if ecs_cdtr_last_changed(d) != 10 { panic(110230); };
    if ecs_cdtr_set_changed_count(d) != 1 { panic(110231); };
    if ecs_cdtr_is_changed(d) != true { panic(110232); };
}

@test "set_added_sets_both"() {
    let d = ecs_cdtr_new(0, 1, 2, 5, 12);
    d = ecs_cdtr_set_added(d);
    if ecs_cdtr_added(d) != 12 { panic(110240); };
    if ecs_cdtr_last_changed(d) != 12 { panic(110241); };
}

@test "set_last_changed_and_added"() {
    let d = ecs_cdtr_new(0, 1, 2, 0, 10);
    d = ecs_cdtr_set_last_changed(d, 7);
    if ecs_cdtr_last_changed(d) != 7 { panic(110250); };
    d = ecs_cdtr_set_last_added(d, 3);
    if ecs_cdtr_added(d) != 3 { panic(110251); };
    if ecs_cdtr_last_changed(d) != 3 { panic(110252); };
}

@test "bypass_does_not_change_tick"() {
    let d = ecs_cdtr_new(1, 1, 1, 5, 10);
    d = ecs_cdtr_bypass(d, 99);
    if ecs_cdtr_value(d) != 99 { panic(110260); };
    if ecs_cdtr_last_changed(d) != 1 { panic(110261); };
    if ecs_cdtr_bypass_count(d) != 1 { panic(110262); };
    if ecs_cdtr_is_changed(d) != false { panic(110263); };
}

@test "set_if_neq_true_and_false"() {
    let d = ecs_cdtr_new(5, 1, 1, 0, 10);
    let r1 = ecs_cdtr_set_if_neq(d, 5);
    if r1.1 != false { panic(110270); };
    if ecs_cdtr_last_changed(r1.0) != 1 { panic(110271); };
    let r2 = ecs_cdtr_set_if_neq(r1.0, 8);
    if r2.1 != true { panic(110272); };
    if ecs_cdtr_value(r2.0) != 8 { panic(110273); };
    if ecs_cdtr_last_changed(r2.0) != 10 { panic(110274); };
}

@test "replace_if_neq"() {
    let d = ecs_cdtr_new(3, 1, 1, 0, 10);
    let r = ecs_cdtr_replace_if_neq(d, 9);
    if ecs_cdtr_replace_replaced(r) != true { panic(110280); };
    if ecs_cdtr_replace_old(r) != 3 { panic(110281); };
    if ecs_cdtr_value(ecs_cdtr_replace_d(r)) != 9 { panic(110282); };
    let r2 = ecs_cdtr_replace_if_neq(ecs_cdtr_replace_d(r), 9);
    if ecs_cdtr_replace_replaced(r2) != false { panic(110283); };
}

@test "clone_from_if_neq"() {
    let d = ecs_cdtr_new(2, 0, 0, 0, 5);
    let r = ecs_cdtr_clone_from_if_neq(d, 4);
    if r.1 != true { panic(110290); };
    if ecs_cdtr_value(r.0) != 4 { panic(110291); };
}

@test "deref_mut_write"() {
    let d = ecs_cdtr_new(0, 0, 0, 0, 6);
    d = ecs_cdtr_deref_mut_write(d, 42);
    if ecs_cdtr_value(d) != 42 { panic(110300); };
    if ecs_cdtr_last_changed(d) != 6 { panic(110301); };
}

@test "advance_run_clears_freshness"() {
    let d = ecs_cdtr_new(1, 5, 5, 3, 10);
    if ecs_cdtr_is_changed(d) != true { panic(110310); };
    d = ecs_cdtr_advance_run(d, 20);
    // last_run becomes 10; changed still 5 → not newer
    if ecs_cdtr_last_run(d) != 10 { panic(110311); };
    if ecs_cdtr_this_run(d) != 20 { panic(110312); };
    if ecs_cdtr_is_changed(d) != false { panic(110313); };
    if ecs_cdtr_is_added(d) != false { panic(110314); };
}

@test "set_changed_with_caller"() {
    let d = ecs_cdtr_new(0, 0, 0, 0, 3);
    d = ecs_cdtr_set_changed_with_caller(d, 99);
    if ecs_cdtr_has_changed_by(d) != true { panic(110320); };
    if ecs_cdtr_changed_by(d) != 99 { panic(110321); };
    if ecs_cdtr_last_changed(d) != 3 { panic(110322); };
}

@test "accessors"() {
    let d = ecs_cdtr_new(7, 2, 4, 1, 9);
    if ecs_cdtr_value(d) != 7 { panic(110330); };
    if ecs_cdtr_added(d) != 2 { panic(110331); };
    if ecs_cdtr_last_changed(d) != 4 { panic(110332); };
    if ecs_cdtr_this_run(d) != 9 { panic(110333); };
    if ecs_cdtr_last_run(d) != 1 { panic(110334); };
}

@test "set_if_neq_uses_bypass_then_flag"() {
    let d = ecs_cdtr_new(1, 0, 0, 0, 10);
    let r = ecs_cdtr_set_if_neq(d, 2);
    if ecs_cdtr_bypass_count(r.0) != 1 { panic(110340); };
    if ecs_cdtr_set_changed_count(r.0) != 1 { panic(110341); };
}
