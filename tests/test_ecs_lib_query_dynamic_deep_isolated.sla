// Isolated deep tests for lib/query_dynamic_deep.sla (Batch 396).
// Mirrors shallow lib/query_dynamic.sla's DynamicWorld query surface.
// panic codes: 144000 - 144053 (Batch 396 band; previous Batch 395 used 143900-143963).

@import "lib/query_dynamic_deep.sla"

fn sw_w(s: EcsQdSpawn) -> EcsQdWorld { return ecs_qd_spawn_world(s); }
fn sw_e(s: EcsQdSpawn) -> EcsQdEntity { return ecs_qd_spawn_entity(s); }

@test "EcsQd dynamic query read entity and while iteration"() {
    let w0 = ecs_qd_world_new();
    let sp1 = ecs_qd_world_spawn(w0);
    let w1a = sw_w(sp1);
    let e1 = sw_e(sp1);
    let w1 = ecs_qd_insert_a(w1a, e1, 10, 0);
    let sp2 = ecs_qd_world_spawn(w1);
    let w2a = sw_w(sp2);
    let e2 = sw_e(sp2);
    let w2 = ecs_qd_insert_a(w2a, e2, 20, 0);
    let q = ecs_qd_query_a(w2);
    let total: i32 = 0;
    let i: i32 = 0;
    while i < ecs_qd_query_a_count(q) {
        let item = ecs_qd_query_a_at(q, i);
        total = total + item.x;
        i = i + 1;
    }
    if total != 30 { panic(144000); };
    let entity_q = ecs_qd_query_entity_a(w2);
    if ecs_qd_entity_a_query_count(entity_q) != 2 { panic(144001); };
    let qe1 = ecs_qd_entity_a_query_entity_at(entity_q, 0);
    let qe2 = ecs_qd_entity_a_query_entity_at(entity_q, 1);
    if qe1.id != e1.id { panic(144002); };
    if qe2.id != e2.id { panic(144003); };
}

@test "EcsQd dynamic query mut writeback"() {
    let w0 = ecs_qd_world_new();
    let sp1 = ecs_qd_world_spawn(w0);
    let w1a = sw_w(sp1);
    let e1 = sw_e(sp1);
    let w1 = ecs_qd_insert_a(w1a, e1, 1, 0);
    let w2 = ecs_qd_increment_tick(w1);
    let q = ecs_qd_query_mut_a(w2);
    if ecs_qd_pair_query_count(q) != 1 { panic(144010); };
    let item = ecs_qd_pair_query_a_at(q, 0);
    let slot = ecs_qd_pair_query_a_slot_at(q, 0);
    let w3 = ecs_qd_query_mut_a_write(w2, e1, slot, item.x + 9, item.y);
    let out = ecs_qd_get_a(w3, e1);
    if out.x != 10 { panic(144011); };
    if ecs_qd_a_changed_since(w3, e1, 1) != true { panic(144012); };
}

@test "EcsQd dynamic query pair mut and with without filters"() {
    let w0 = ecs_qd_world_new();
    let sp1 = ecs_qd_world_spawn(w0);
    let w1a = sw_w(sp1);
    let e1 = sw_e(sp1);
    let w1 = ecs_qd_insert_a(w1a, e1, 1, 0);
    let sp2 = ecs_qd_world_spawn(w1);
    let w2a = sw_w(sp2);
    let e2 = sw_e(sp2);
    let w2 = ecs_qd_insert_a(w2a, e2, 2, 0);
    let w3 = ecs_qd_insert_b(w2, e1, 5, 0);
    let pairs = ecs_qd_query_mut_a_b(w3);
    if ecs_qd_pair_query_count(pairs) != 1 { panic(144020); };
    let a = ecs_qd_pair_query_a_at(pairs, 0);
    let b = ecs_qd_pair_query_b_at(pairs, 0);
    let slot = ecs_qd_pair_query_a_slot_at(pairs, 0);
    let w4 = ecs_qd_pair_write_a(w3, e1, slot, a.x + b.x, 0);
    let out = ecs_qd_get_a(w4, e1);
    if out.x != 6 { panic(144021); };
    let with_q = ecs_qd_query_a_with_b(w4);
    let without_q = ecs_qd_query_a_without_b(w4);
    if ecs_qd_query_a_count(with_q) != 1 { panic(144022); };
    if ecs_qd_query_a_count(without_q) != 1 { panic(144023); };
    let without_item = ecs_qd_query_a_at(without_q, 0);
    if without_item.x != 2 { panic(144024); };
}

@test "EcsQd dynamic query added changed filters"() {
    let w0 = ecs_qd_world_new();
    let sp1 = ecs_qd_world_spawn(w0);
    let w1a = sw_w(sp1);
    let e1 = sw_e(sp1);
    let w1 = ecs_qd_insert_a(w1a, e1, 1, 0);
    let sp2 = ecs_qd_world_spawn(w1);
    let w2a = sw_w(sp2);
    let w2 = ecs_qd_insert_a(w2a, sw_e(sp2), 2, 0);
    let added = ecs_qd_query_a_added(w2, 0);
    if ecs_qd_query_a_count(added) != 2 { panic(144030); };
    let w3 = ecs_qd_increment_tick(w2);
    let q = ecs_qd_query_mut_a(w3);
    let item = ecs_qd_pair_query_a_at(q, 0);
    let slot = ecs_qd_pair_query_a_slot_at(q, 0);
    let w4 = ecs_qd_query_mut_a_write(w3, e1, slot, 9, 0);
    let changed = ecs_qd_query_a_changed(w4, 1);
    if ecs_qd_query_a_count(changed) != 1 { panic(144031); };
    let changed_item = ecs_qd_query_a_at(changed, 0);
    if changed_item.x != 9 { panic(144032); };
    let added_late = ecs_qd_query_a_added(w4, 1);
    if ecs_qd_query_a_count(added_late) != 0 { panic(144033); };
}

@test "EcsQd cap sentinel and stale despawn filtering"() {
    let w = ecs_qd_world_new();
    let i: i32 = 0;
    while i < 15 {
        let sp = ecs_qd_world_spawn(w);
        w = sw_w(sp);
        let e = sw_e(sp);
        if e.id != i + 1 { panic(144040 + i); };
        i = i + 1;
    }
    let sp16 = ecs_qd_world_spawn(w);
    let sentinel = sw_e(sp16);
    if sentinel.id != -1 { panic(144050); };
    let e1 = ecs_qd_entity_new(1, 0);
    let w2 = ecs_qd_insert_a(w, e1, 5, 0);
    let w3 = ecs_qd_despawn(w2, e1);
    let q = ecs_qd_query_a(w3);
    if ecs_qd_query_a_count(q) != 0 { panic(144051); };
}
