@import "lib/observer_distributed_storage_deep.sla"

// Batch 228: observer distributed storage deep (src/observer/distributed_storage.rs).
// panic codes: 111600 – 111799.

@test "observer_try_new_rejects_exclusive"() {
    let t = ecs_ods_observer_try_new(1, 10, true, 5, 99);
    if t.0 != false { panic(111600); };
    let ok = ecs_ods_observer_try_new(1, 10, false, 5, 99);
    if ok.0 != true { panic(111601); };
    if ecs_ods_observer_system_name(ok.1) != 10 { panic(111602); };
    if ecs_ods_observer_is_dynamic(ok.1) != false { panic(111603); };
}

@test "dynamic_runner_hook_kind"() {
    let o = ecs_ods_observer_with_dynamic_runner(77);
    if ecs_ods_observer_is_dynamic(o) != true { panic(111610); };
    if ecs_ods_observer_hook_kind(o) != ECS_ODS_HOOK_DYNAMIC { panic(111611); };
    if ecs_ods_observer_runner(o) != 77 { panic(111612); };
}

@test "descriptor_watch_entity_component_event"() {
    let o = ecs_ods_observer_new(1, 2, false, 3, 4);
    o = ecs_ods_observer_with_entity(o, 100);
    o = ecs_ods_observer_with_component(o, 7);
    o = ecs_ods_observer_with_event_key(o, 9);
    let d = ecs_ods_observer_descriptor(o);
    if ecs_ods_desc_entity_len(d) != 1 { panic(111620); };
    if ecs_ods_desc_has_entity(d, 100) != true { panic(111621); };
    if ecs_ods_desc_has_component(d, 7) != true { panic(111622); };
    if ecs_ods_desc_has_event_key(d, 9) != true { panic(111623); };
}

@test "with_entities_and_components2"() {
    let o = ecs_ods_observer_new(1, 2, false, 3, 4);
    o = ecs_ods_observer_with_entities2(o, 10, 20);
    o = ecs_ods_observer_with_components2(o, 1, 2);
    let d = ecs_ods_observer_descriptor(o);
    if ecs_ods_desc_entity_len(d) != 2 { panic(111630); };
    if ecs_ods_desc_component_len(d) != 2 { panic(111631); };
    if ecs_ods_desc_entity_at(d, 1) != 20 { panic(111632); };
}

@test "run_if_and_error_handler_name"() {
    let o = ecs_ods_observer_new(1, 2, false, 3, 4);
    o = ecs_ods_observer_run_if(o, 50);
    o = ecs_ods_observer_run_if(o, 51);
    o = ecs_ods_observer_with_error_handler(o, 8);
    o = ecs_ods_observer_set_name(o, 999);
    if ecs_ods_observer_conditions_len(o) != 2 { panic(111640); };
    if ecs_ods_observer_has_error_handler(o) != true { panic(111641); };
    if ecs_ods_observer_error_handler(o) != 8 { panic(111642); };
    if ecs_ods_observer_system_name(o) != 999 { panic(111643); };
}

@test "typed_hook_on_add_registers"() {
    let w = ecs_ods_world_new(42);
    let o = ecs_ods_observer_new(1, 2, false, 5, 9);
    o = ecs_ods_observer_with_bundle(o, 11, 12, 2);
    o = ecs_ods_observer_run_if(o, 70);
    w = ecs_ods_world_set_observer(w, 100, o);
    w = ecs_ods_observer_component_on_add(w, 100);
    if ecs_ods_world_register_count(w) != 1 { panic(111650); };
    if ecs_ods_world_is_registered(w, 100) != true { panic(111651); };
    let g = ecs_ods_world_get_observer(w, 100);
    if g.0 != true { panic(111652); };
    if ecs_ods_observer_system_initialized(g.1) != true { panic(111653); };
    let d = ecs_ods_observer_descriptor(g.1);
    if ecs_ods_desc_has_event_key(d, 5) != true { panic(111654); };
    if ecs_ods_desc_has_component(d, 11) != true { panic(111655); };
    if ecs_ods_desc_has_component(d, 12) != true { panic(111656); };
    if ecs_ods_conditions_all_initialized(g.1.conditions) != true { panic(111657); };
}

@test "dynamic_hook_skips_empty_keys"() {
    let w = ecs_ods_world_new(42);
    let o = ecs_ods_observer_with_dynamic_runner(3);
    w = ecs_ods_world_set_observer(w, 50, o);
    w = ecs_ods_observer_component_on_add(w, 50);
    if ecs_ods_world_register_count(w) != 0 { panic(111660); };
}

@test "dynamic_hook_sets_fallback_error_handler"() {
    let w = ecs_ods_world_new(77);
    let o = ecs_ods_observer_with_dynamic_runner(3);
    o = ecs_ods_observer_with_event_key(o, 9);
    o = ecs_ods_observer_run_if(o, 1);
    w = ecs_ods_world_set_observer(w, 50, o);
    w = ecs_ods_observer_component_on_add(w, 50);
    if ecs_ods_world_register_count(w) != 1 { panic(111670); };
    let g = ecs_ods_world_get_observer(w, 50);
    if ecs_ods_observer_has_error_handler(g.1) != true { panic(111671); };
    if ecs_ods_observer_error_handler(g.1) != 77 { panic(111672); };
    if ecs_ods_conditions_all_initialized(g.1.conditions) != true { panic(111673); };
}

@test "observer_on_remove_unregisters"() {
    let w = ecs_ods_world_new(1);
    let o = ecs_ods_observer_new(1, 2, false, 5, 9);
    o = ecs_ods_observer_with_entity(o, 10);
    w = ecs_ods_world_set_observer(w, 100, o);
    w = ecs_ods_observer_component_on_add(w, 100);
    w = ecs_ods_observer_component_on_remove(w, 100);
    if ecs_ods_world_unregister_count(w) != 1 { panic(111680); };
    if ecs_ods_world_is_unregistered(w, 100) != true { panic(111681); };
    let g = ecs_ods_world_get_observer(w, 100);
    if ecs_ods_desc_entity_len(ecs_ods_observer_descriptor(g.1)) != 0 { panic(111682); };
}

@test "observed_by_on_remove_despawns_when_all_gone"() {
    let w = ecs_ods_world_new(1);
    let o = ecs_ods_observer_new(1, 2, false, 5, 9);
    o = ecs_ods_observer_with_entity(o, 10);
    w = ecs_ods_world_set_observer(w, 200, o);
    let obs = ecs_ods_observed_by_push(ecs_ods_observed_by_new(), 200);
    w = ecs_ods_world_set_observed_by(w, 10, obs);
    w = ecs_ods_observed_by_on_remove(w, 10);
    if ecs_ods_world_despawn_count(w) != 1 { panic(111690); };
    let g = ecs_ods_world_get_observer(w, 200);
    if ecs_ods_observer_alive(g.1) != false { panic(111691); };
    if ecs_ods_observer_despawned_watched(g.1) != 1 { panic(111692); };
}

@test "observed_by_on_remove_partial_keeps_observer"() {
    let w = ecs_ods_world_new(1);
    let o = ecs_ods_observer_new(1, 2, false, 5, 9);
    o = ecs_ods_observer_with_entities2(o, 10, 11);
    w = ecs_ods_world_set_observer(w, 200, o);
    let obs = ecs_ods_observed_by_push(ecs_ods_observed_by_new(), 200);
    w = ecs_ods_world_set_observed_by(w, 10, obs);
    w = ecs_ods_observed_by_on_remove(w, 10);
    if ecs_ods_world_despawn_count(w) != 0 { panic(111700); };
    let g = ecs_ods_world_get_observer(w, 200);
    if ecs_ods_observer_alive(g.1) != true { panic(111701); };
    if ecs_ods_observer_despawned_watched(g.1) != 1 { panic(111702); };
}

@test "into_entity_observer_and_condition"() {
    let o = ecs_ods_into_entity_observer(1, 2, 3, 4, 55);
    if ecs_ods_desc_has_entity(ecs_ods_observer_descriptor(o), 55) != true { panic(111710); };
    let o2 = ecs_ods_into_entity_observer_with_condition(1, 2, 3, 4, 66, 90, 1);
    if ecs_ods_observer_conditions_len(o2) != 1 { panic(111711); };
    if ecs_ods_desc_has_entity(ecs_ods_observer_descriptor(o2), 66) != true { panic(111712); };
}

@test "storage_and_clone_constants"() {
    if ecs_ods_observer_storage_type() != ECS_ODS_STORAGE_SPARSE_SET { panic(111720); };
    if ecs_ods_observed_by_storage_type() != ECS_ODS_STORAGE_SPARSE_SET { panic(111721); };
    if ecs_ods_observed_by_clone_behavior() != ECS_ODS_CLONE_IGNORE { panic(111722); };
}

@test "desc_with_event_keys_replace"() {
    let d = ecs_ods_desc_push_event_key(ecs_ods_desc_new(), 1);
    d = ecs_ods_desc_with_event_keys(d, 8, 9, 2);
    if ecs_ods_desc_event_key_len(d) != 2 { panic(111730); };
    if ecs_ods_desc_event_key_at(d, 0) != 8 { panic(111731); };
    if ecs_ods_desc_event_key_at(d, 1) != 9 { panic(111732); };
}

@test "observed_by_get_and_push"() {
    let o = ecs_ods_observed_by_new();
    o = ecs_ods_observed_by_push(o, 1);
    o = ecs_ods_observed_by_push(o, 2);
    if ecs_ods_observed_by_get_len(o) != 2 { panic(111740); };
    if ecs_ods_observed_by_contains(o, 2) != true { panic(111741); };
    if ecs_ods_observed_by_at(o, 0) != 1 { panic(111742); };
}
