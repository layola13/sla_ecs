@import "lib/query_access_ops_deep.sla"

// Batch 323: query_access_ops deep.
// panic codes: 130600 – 130799.

@test "cset_insert_contains"() {
    let s = ecs_cset_deep_new();
    s = ecs_cset_deep_insert(s, 1);
    s = ecs_cset_deep_insert(s, 3);
    if ecs_cset_deep_contains(s, 1) != true { panic(130600); };
    if ecs_cset_deep_contains(s, 2) != false { panic(130601); };
}

@test "cset_union_intersection"() {
    let a = ecs_cset_deep_insert(ecs_cset_deep_new(), 1);
    let b = ecs_cset_deep_insert(ecs_cset_deep_insert(ecs_cset_deep_new(), 1), 2);
    let u = ecs_cset_deep_union(a, b);
    if ecs_cset_deep_contains(u, 2) != true { panic(130610); };
    let i = ecs_cset_deep_intersection(a, b);
    if ecs_cset_deep_contains(i, 1) != true { panic(130611); };
    if ecs_cset_deep_contains(i, 2) != false { panic(130612); };
}

@test "cset_difference_subset_disjoint"() {
    let a = ecs_cset_deep_insert(ecs_cset_deep_insert(ecs_cset_deep_new(), 1), 2);
    let b = ecs_cset_deep_insert(ecs_cset_deep_new(), 2);
    let d = ecs_cset_deep_difference(a, b);
    if ecs_cset_deep_contains(d, 1) != true { panic(130620); };
    if ecs_cset_deep_contains(d, 2) != false { panic(130621); };
    if ecs_cset_deep_is_subset(b, a) != true { panic(130622); };
    if ecs_cset_deep_is_disjoint(ecs_cset_deep_insert(ecs_cset_deep_new(), 5), a) != true { panic(130623); };
}

@test "cset_empty_clear"() {
    let s = ecs_cset_deep_new();
    if ecs_cset_deep_is_empty(s) != true { panic(130630); };
    if ecs_cset_deep_is_clear(s) != true { panic(130631); };
}

@test "access_add_read_write"() {
    let a = ecs_aops_deep_new();
    a = ecs_aops_deep_add_read(a, 1);
    a = ecs_aops_deep_add_write(a, 2);
    if ecs_aops_deep_has_any_read(a) != true { panic(130640); };
    if ecs_aops_deep_has_any_write(a) != true { panic(130641); };
    if (ecs_aops_deep_writes(a) & ecs_cset_deep_mask(2)) == 0 { panic(130642); };
}

@test "conflicts_detected"() {
    let a = ecs_aops_deep_add_write(ecs_aops_deep_new(), 1);
    let b = ecs_aops_deep_add_read(ecs_aops_deep_new(), 1);
    let c = ecs_aops_deep_get_conflicts(a, b);
    if ecs_aconf_deep_is_empty(c) != false { panic(130650); };
    if (ecs_aconf_deep_bits(c) & ecs_cset_deep_mask(1)) == 0 { panic(130651); };
}

@test "no_conflicts"() {
    let a = ecs_aops_deep_add_read(ecs_aops_deep_new(), 1);
    let b = ecs_aops_deep_add_read(ecs_aops_deep_new(), 2);
    let c = ecs_aops_deep_get_conflicts(a, b);
    if ecs_aconf_deep_is_empty(c) != true { panic(130660); };
}

@test "extend_union"() {
    let a = ecs_aops_deep_add_read(ecs_aops_deep_new(), 1);
    let b = ecs_aops_deep_add_write(ecs_aops_deep_new(), 2);
    let e = ecs_aops_deep_extend(a, b);
    if (ecs_aops_deep_reads(e) & ecs_cset_deep_mask(1)) == 0 { panic(130670); };
    if (ecs_aops_deep_writes(e) & ecs_cset_deep_mask(2)) == 0 { panic(130671); };
}

@test "intersection"() {
    let a = ecs_aops_deep_add_write(ecs_aops_deep_add_read(ecs_aops_deep_new(), 1), 2);
    let b = ecs_aops_deep_add_write(ecs_aops_deep_add_read(ecs_aops_deep_new(), 2), 2);
    let i = ecs_aops_deep_intersection(a, b);
    if (ecs_aops_inter_reads(i) & ecs_cset_deep_mask(2)) == 0 { panic(130680); };
    if (ecs_aops_inter_writes(i) & ecs_cset_deep_mask(2)) == 0 { panic(130681); };
}

@test "aconf_all"() {
    let c = ecs_aconf_deep_all();
    if ecs_aconf_deep_is_all(c) != true { panic(130690); };
    if ecs_aconf_deep_is_empty(c) != false { panic(130691); };
}
