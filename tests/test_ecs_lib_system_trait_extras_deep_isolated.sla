@import "lib/system_trait_extras_deep.sla"

// Batch 319: system_trait_extras deep.
// panic codes: 129800 – 129999.

@test "new_type_id"() {
    let s = ecs_ste_deep_new(42);
    if ecs_ste_deep_type_id(s) != 42 { panic(129800); };
    if ecs_ste_deep_run_count(s) != 0 { panic(129801); };
    if ecs_ste_deep_is_send(s) != true { panic(129802); };
}

@test "non_send"() {
    let s = ecs_ste_deep_set_non_send(ecs_ste_deep_new(1));
    if ecs_ste_deep_is_send(s) != false { panic(129810); };
}

@test "refresh_hotpatch"() {
    let s = ecs_ste_deep_new(1);
    let s2 = ecs_ste_deep_refresh_hotpatch(s);
    if ecs_ste_deep_type_id(s2) != 1 { panic(129820); };
}

@test "queue_deferred"() {
    let s = ecs_ste_deep_queue_deferred(ecs_ste_deep_new(1), 3);
    if ecs_ste_deep_deferred_count(s) != 3 { panic(129830); };
    if ecs_ste_deep_has_deferred(s) != true { panic(129831); };
}

@test "change_tick_last_run"() {
    let s = ecs_ste_deep_check_change_tick(ecs_ste_deep_new(1), 9);
    if ecs_ste_deep_last_run(s) != 9 { panic(129840); };
    s = ecs_ste_deep_set_last_run(s, 11);
    if ecs_ste_deep_last_run(s) != 11 { panic(129841); };
}

@test "default_sets"() {
    let s = ecs_ste_deep_new(1);
    s = ecs_ste_deep_add_default_set(s, 100);
    s = ecs_ste_deep_add_default_set(s, 200);
    let r = ecs_ste_deep_default_sets(s);
    if ecs_ste_sets_count(r) != 2 { panic(129850); };
    if ecs_ste_sets_first(r) != 100 { panic(129851); };
}

@test "run_readonly"() {
    let s = ecs_ste_deep_new(1);
    let r = ecs_ste_deep_run_readonly(s, 0);
    if ecs_ste_run_count(r) != 1 { panic(129860); };
    if ecs_ste_run_queued(r) != 0 { panic(129861); };
    if ecs_ste_deep_run_count(ecs_ste_run_system(r)) != 1 { panic(129862); };
}

@test "run_without_deferred_apply"() {
    let s = ecs_ste_deep_new(1);
    let r = ecs_ste_deep_run_without_applying_deferred(s, 0);
    if ecs_ste_run_count(r) != 1 { panic(129870); };
    if ecs_ste_run_queued(r) != 1 { panic(129871); };
    if ecs_ste_deep_has_deferred(ecs_ste_run_system(r)) != true { panic(129872); };
}

@test "sets_capacity_four"() {
    let s = ecs_ste_deep_new(1);
    s = ecs_ste_deep_add_default_set(s, 1);
    s = ecs_ste_deep_add_default_set(s, 2);
    s = ecs_ste_deep_add_default_set(s, 3);
    s = ecs_ste_deep_add_default_set(s, 4);
    s = ecs_ste_deep_add_default_set(s, 5);
    let r = ecs_ste_deep_default_sets(s);
    if ecs_ste_sets_count(r) != 4 { panic(129880); };
}

@test "flags_bits"() {
    let s = ecs_ste_deep_set_non_send(ecs_ste_deep_queue_deferred(ecs_ste_deep_new(1), 1));
    if (ecs_ste_deep_flags(s) & ECS_STE_NON_SEND) == 0 { panic(129890); };
    if (ecs_ste_deep_flags(s) & ECS_STE_HAS_DEFERRED) == 0 { panic(129891); };
}
