@import "lib/never_deep.sla"

// Batch 223: never deep (src/never.rs).
// panic codes: 110700 – 110799.

@test "type_metadata"() {
    if ecs_never_deep_type_id() != 78001 { panic(110700); };
    if ecs_never_deep_fn_ret_marker() != 78002 { panic(110701); };
    if ecs_never_deep_debug_name_id() != 78001 { panic(110702); };
}

@test "uninhabited_flags"() {
    if ecs_never_deep_is_uninhabited() != true { panic(110710); };
    if ecs_never_deep_can_construct() != false { panic(110711); };
    if ecs_never_deep_is_zero_sized_model() != true { panic(110712); };
}

@test "fn_ret_never_output"() {
    let n = ecs_never_fn_ret_never();
    if ecs_never_fn_ret_is_never(n) != true { panic(110720); };
    if ecs_never_fn_ret_output_type_id(n) != 78001 { panic(110721); };
}

@test "fn_ret_ordinary"() {
    let o = ecs_never_fn_ret_ordinary(123);
    if ecs_never_fn_ret_is_never(o) != false { panic(110730); };
    if ecs_never_fn_ret_output_type_id(o) != 123 { panic(110731); };
}

@test "system_compat_accepts_never"() {
    let c = ecs_never_system_compat_new();
    let n = ecs_never_fn_ret_never();
    if ecs_never_system_accepts(c, n) != true { panic(110740); };
    let o = ecs_never_fn_ret_ordinary(1);
    if ecs_never_system_accepts(c, o) != true { panic(110741); };
}

@test "match_empty_type_level"() {
    if ecs_never_deep_match_empty_type_id(55) != 55 { panic(110750); };
}

@test "type_eq"() {
    if ecs_never_deep_type_eq(78001, 78001) != true { panic(110760); };
    if ecs_never_deep_type_eq(78001, 0) != false { panic(110761); };
}
