// Isolated deep tests for lib/relationship_declaration_deep.sla (Batch 393).
// Mirrors shallow lib/relationship_declaration.sla's derive-like relationship declarations.
// Vec registry is flattened to cap-16 slot families; booleans are represented as i32 flags.
// panic codes: 143700 - 143782 (Batch 393 band; previous Batch 392 used 143600-143682).

@import "lib/relationship_declaration_deep.sla"

fn rr_reg(r: EcsRelationshipDeclarationRegisterResultDeep) -> EcsRelationshipDeclarationRegistryDeep { return ecs_rel_decl_result_registry(r); }
fn rr_inserted(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_inserted(r); }
fn rr_duplicate(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_duplicate(r); }
fn rr_id_collision(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_id_collision(r); }
fn rr_pair_conflict(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_pair_conflict(r); }
fn rr_invalid(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_invalid(r); }
fn rr_existing_index(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_existing_index(r); }
fn rr_error(r: EcsRelationshipDeclarationRegisterResultDeep) -> i32 { return ecs_rel_decl_result_error_code(r); }

@test "EcsRelationshipDeclarationDeep many records target collection shape"() {
    let declaration = ecs_rel_decl_many(100, 101, 102, true, false, true);
    if ecs_rel_decl_valid(declaration) != 1 { panic(143700); };
    if ecs_rel_decl_target_mode(declaration) != ECS_RELATIONSHIP_DECL_TARGET_MANY_DEEP { panic(143701); };
    if ecs_rel_decl_linked_spawn(declaration) != 1 { panic(143702); };
    if ecs_rel_decl_allow_self(declaration) != 0 { panic(143703); };
    if ecs_rel_decl_ordered(declaration) != 1 { panic(143704); };
}

@test "EcsRelationshipDeclarationDeep one rejects ordered target collection"() {
    let declaration = ecs_rel_decl_new(200, 201, 202, ECS_RELATIONSHIP_DECL_TARGET_ONE_DEEP, false, false, true);
    if ecs_rel_decl_valid(declaration) != 0 { panic(143710); };
    if ecs_rel_decl_error_code(declaration) != ECS_RELATIONSHIP_DECL_ERR_ONE_TO_ONE_ORDERED_DEEP { panic(143711); };
}

@test "EcsRelationshipDeclarationDeep rejects invalid ids and same pair component"() {
    let bad_source = ecs_rel_decl_many(1, 0, 3, false, false, false);
    if ecs_rel_decl_error_code(bad_source) != ECS_RELATIONSHIP_DECL_ERR_SOURCE_ID_DEEP { panic(143720); };
    let same = ecs_rel_decl_many(1, 3, 3, false, false, false);
    if ecs_rel_decl_error_code(same) != ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT_DEEP { panic(143721); };
    let bad_rel = ecs_rel_decl_many(0, 2, 3, false, false, false);
    if ecs_rel_decl_error_code(bad_rel) != ECS_RELATIONSHIP_DECL_ERR_RELATIONSHIP_ID_DEEP { panic(143722); };
    let bad_target = ecs_rel_decl_many(1, 2, 0, false, false, false);
    if ecs_rel_decl_error_code(bad_target) != ECS_RELATIONSHIP_DECL_ERR_TARGET_ID_DEEP { panic(143723); };
    let bad_mode = ecs_rel_decl_new(1, 2, 3, 9, false, false, false);
    if ecs_rel_decl_error_code(bad_mode) != ECS_RELATIONSHIP_DECL_ERR_TARGET_MODE_DEEP { panic(143724); };
}

@test "EcsRelationshipDeclarationDeep registry inserts unique declaration"() {
    let registry = ecs_rel_decl_registry_new();
    let declaration = ecs_rel_decl_many(10, 11, 12, true, false, true);
    let result = ecs_rel_decl_registry_register(registry, declaration);
    if rr_inserted(result) != 1 { panic(143730); };
    let next_registry = rr_reg(result);
    if ecs_rel_decl_registry_len(next_registry) != 1 { panic(143731); };
    let stored = ecs_rel_decl_registry_at(next_registry, 0);
    if ecs_rel_decl_relationship_type_id(stored) != 10 { panic(143732); };
}

@test "EcsRelationshipDeclarationDeep registry reports duplicate declaration"() {
    let registry = ecs_rel_decl_registry_new();
    let declaration = ecs_rel_decl_many(20, 21, 22, true, false, true);
    let first = ecs_rel_decl_registry_register(registry, declaration);
    let again = ecs_rel_decl_many(20, 21, 22, true, false, true);
    let second = ecs_rel_decl_registry_register(rr_reg(first), again);
    if rr_duplicate(second) != 1 { panic(143740); };
    if rr_inserted(second) != 0 { panic(143741); };
    if rr_existing_index(second) != 0 { panic(143742); };
}

@test "EcsRelationshipDeclarationDeep registry reports id collision"() {
    let registry = ecs_rel_decl_registry_new();
    let first = ecs_rel_decl_many(30, 31, 32, true, false, true);
    let second_decl = ecs_rel_decl_many(30, 33, 34, true, false, true);
    let inserted = ecs_rel_decl_registry_register(registry, first);
    let collision = ecs_rel_decl_registry_register(rr_reg(inserted), second_decl);
    if rr_id_collision(collision) != 1 { panic(143750); };
    if rr_inserted(collision) != 0 { panic(143751); };
    if ecs_rel_decl_registry_len(rr_reg(collision)) != 1 { panic(143752); };
}

@test "EcsRelationshipDeclarationDeep registry reports component pair conflict"() {
    let registry = ecs_rel_decl_registry_new();
    let first = ecs_rel_decl_many(40, 41, 42, true, false, true);
    let second_decl = ecs_rel_decl_many(43, 41, 42, true, false, true);
    let inserted = ecs_rel_decl_registry_register(registry, first);
    let conflict = ecs_rel_decl_registry_register(rr_reg(inserted), second_decl);
    if rr_pair_conflict(conflict) != 1 { panic(143760); };
    if rr_id_collision(conflict) != 0 { panic(143761); };
    if rr_existing_index(conflict) != 0 { panic(143762); };
}

@test "EcsRelationshipDeclarationDeep registry rejects invalid declaration"() {
    let registry = ecs_rel_decl_registry_new();
    let invalid = ecs_rel_decl_many(50, 51, 51, true, false, true);
    let result = ecs_rel_decl_registry_register(registry, invalid);
    if rr_invalid(result) != 1 { panic(143770); };
    if rr_error(result) != ECS_RELATIONSHIP_DECL_ERR_SAME_COMPONENT_DEEP { panic(143771); };
    if ecs_rel_decl_registry_len(rr_reg(result)) != 0 { panic(143772); };
}

@test "EcsRelationshipDeclarationDeep registry cap rejects seventeenth unique declaration"() {
    let registry = ecs_rel_decl_registry_new();
    let i: i32 = 0;
    while i < 16 {
        let declaration = ecs_rel_decl_many(1000 + i, 2000 + i, 3000 + i, false, false, false);
        let result = ecs_rel_decl_registry_register(registry, declaration);
        registry = rr_reg(result);
        if rr_inserted(result) != 1 { panic(143780); };
        i = i + 1;
    }
    if ecs_rel_decl_registry_len(registry) != 16 { panic(143781); };
    let overflow = ecs_rel_decl_many(2000, 4000, 5000, false, false, false);
    let result2 = ecs_rel_decl_registry_register(registry, overflow);
    if rr_invalid(result2) != 1 { panic(143782); };
    if ecs_rel_decl_registry_len(rr_reg(result2)) != 16 { panic(143783); };
}
