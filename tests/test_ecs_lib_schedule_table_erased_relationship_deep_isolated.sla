// Isolated deep tests for lib/schedule_table_erased_relationship_deep.sla (Batch 397).
// Mirrors erased relationship schedule batching without fn-pointers or runtime world erasure.
// panic codes: 144100 - 144172 (Batch 397 band; previous Batch 396 used 144000-144053).

@import "lib/schedule_table_erased_relationship_deep.sla"

@test "EcsStrSchedule runs non-conflicting systems in one batch"() {
    let w0 = ecs_str_world_new(4, 6, 1);
    let move_access0 = ecs_str_access_none();
    let move_access1 = ecs_str_access_write_component(move_access0, 1);
    let move_access = ecs_str_access_read_component(move_access1, 2);
    let rel_access0 = ecs_str_access_none();
    let rel_access1 = ecs_str_access_read_relationship(rel_access0, 1);
    let rel_access = ecs_str_access_write_resource(rel_access1);
    let msg_access0 = ecs_str_access_none();
    let msg_access = ecs_str_access_write_messages(msg_access0);
    let s0 = ecs_str_schedule_default();
    let s1 = ecs_str_schedule_add_system(s0, ECS_STR_SYS_MOVE, move_access);
    let s2 = ecs_str_schedule_add_system(s1, ECS_STR_SYS_REL_COUNT, rel_access);
    let s3 = ecs_str_schedule_add_system(s2, ECS_STR_SYS_MESSAGE, msg_access);
    if ecs_str_schedule_conflict_count(s3) != 0 { panic(144100); };
    if ecs_str_schedule_batch_count(s3) != 1 { panic(144101); };
    if ecs_str_schedule_max_parallel_width(s3) != 3 { panic(144102); };
    let w1 = ecs_str_schedule_run(s3, w0);
    if ecs_str_world_change_tick(w1) != 2 { panic(144103); };
    if ecs_str_world_pos_x(w1) != 10 { panic(144104); };
    if ecs_str_world_resource_tick(w1) != 1 { panic(144105); };
    if ecs_str_world_message_count(w1) != 1 { panic(144106); };
    if ecs_str_world_last_message(w1) != 2 { panic(144107); };
}

@test "EcsStrSchedule records relationship conflicts and batches"() {
    let read_rel0 = ecs_str_access_none();
    let read_rel = ecs_str_access_read_relationship(read_rel0, 1);
    let write_rel0 = ecs_str_access_none();
    let write_rel = ecs_str_access_write_relationship(write_rel0, 1);
    let msg0 = ecs_str_access_none();
    let msg = ecs_str_access_write_messages(msg0);
    let s0 = ecs_str_schedule_default();
    let s1 = ecs_str_schedule_add_system(s0, ECS_STR_SYS_REL_COUNT, read_rel);
    let s2 = ecs_str_schedule_add_system(s1, ECS_STR_SYS_RELATE_FIRST_TWO, write_rel);
    let s3 = ecs_str_schedule_add_system(s2, ECS_STR_SYS_MESSAGE, msg);
    if ecs_str_schedule_conflict_count(s3) != 1 { panic(144120); };
    if ecs_str_schedule_batch_count(s3) != 2 { panic(144121); };
    if ecs_str_schedule_system_batch(s3, 0) != 0 { panic(144122); };
    if ecs_str_schedule_system_batch(s3, 1) != 1 { panic(144123); };
    if ecs_str_schedule_system_batch(s3, 2) != 0 { panic(144124); };
    if ecs_str_schedule_batch_width(s3, 0) != 2 { panic(144125); };
    if ecs_str_schedule_max_parallel_width(s3) != 2 { panic(144126); };
}

@test "EcsStrSchedule planned run honors type access declarations"() {
    let w0 = ecs_str_world_new(1, 2, 0);
    let move_access0 = ecs_str_access_none();
    let move_access1 = ecs_str_access_write_type(move_access0, 401);
    let move_access = ecs_str_access_read_type(move_access1, 402);
    let relate_access0 = ecs_str_access_none();
    let relate_access = ecs_str_access_write_relationship(relate_access0, 1);
    let s0 = ecs_str_schedule_default();
    let s1 = ecs_str_schedule_add_system(s0, ECS_STR_SYS_MOVE, move_access);
    let s2 = ecs_str_schedule_add_system(s1, ECS_STR_SYS_RELATE_FIRST_TWO, relate_access);
    if ecs_str_schedule_batch_count(s2) != 1 { panic(144140); };
    let w1 = ecs_str_schedule_run_planned(s2, w0);
    if ecs_str_world_pos_x(w1) != 3 { panic(144141); };
    if ecs_str_world_relationship_count(w1) != 1 { panic(144142); };
    if ecs_str_world_related(w1) != 1 { panic(144143); };
}

@test "EcsStrAccess detects resource and message conflicts"() {
    let rr0 = ecs_str_access_none();
    let rr = ecs_str_access_read_resource(rr0);
    let wr0 = ecs_str_access_none();
    let wr = ecs_str_access_write_resource(wr0);
    let rm0 = ecs_str_access_none();
    let rm = ecs_str_access_read_messages(rm0);
    let wm0 = ecs_str_access_none();
    let wm = ecs_str_access_write_messages(wm0);
    let plain = ecs_str_access_none();
    if ecs_str_access_conflicts(rr, wr) != true { panic(144150); };
    if ecs_str_access_conflicts(wr, rr) != true { panic(144151); };
    if ecs_str_access_conflicts(rm, wm) != true { panic(144152); };
    if ecs_str_access_conflicts(wm, rm) != true { panic(144153); };
    if ecs_str_access_conflicts(rr, wm) != false { panic(144154); };
    if ecs_str_access_conflicts(plain, wm) != false { panic(144155); };
}

@test "EcsStrSchedule out of range accessors return sentinels"() {
    let a = ecs_str_access_none();
    let s0 = ecs_str_schedule_default();
    let s1 = ecs_str_schedule_add_system(s0, ECS_STR_SYS_MESSAGE, a);
    if ecs_str_schedule_system_batch(s1, -1) != -1 { panic(144160); };
    if ecs_str_schedule_system_batch(s1, 1) != -1 { panic(144161); };
    if ecs_str_schedule_kind_at(s1, -1) != -1 { panic(144162); };
    if ecs_str_schedule_kind_at(s1, 1) != -1 { panic(144163); };
}

@test "EcsStrSchedule fixed cap ignores ninth system"() {
    let a = ecs_str_access_none();
    let s = ecs_str_schedule_default();
    let i: i32 = 0;
    while i < 8 {
        s = ecs_str_schedule_add_system(s, ECS_STR_SYS_MESSAGE, a);
        i = i + 1;
    }
    if ecs_str_schedule_batch_width(s, 0) != 8 { panic(144170); };
    let overflow = ecs_str_schedule_add_system(s, ECS_STR_SYS_MESSAGE, a);
    if ecs_str_schedule_batch_width(overflow, 0) != 8 { panic(144171); };
    if ecs_str_schedule_kind_at(overflow, 8) != -1 { panic(144172); };
}
