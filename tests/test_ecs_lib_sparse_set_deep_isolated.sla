@import "lib/sparse_set_deep.sla"

// Batch 236: sparse_set deep (src/storage/sparse_set.rs).
// panic codes: 113200 – 113399.

@test "sparse_array_insert_get_remove"() {
    let a = ecs_sa_new();
    if ecs_sa_contains(a, 3) != false { panic(113200); };
    a = ecs_sa_insert(a, 3, 7);
    if ecs_sa_contains(a, 3) != true { panic(113201); };
    let g = ecs_sa_get(a, 3);
    if g.0 != true { panic(113202); };
    if g.1 != 7 { panic(113203); };
    let r = ecs_sa_remove(a, 3);
    a = r.0;
    if r.1 != true { panic(113204); };
    if r.2 != 7 { panic(113205); };
    if ecs_sa_contains(a, 3) != false { panic(113206); };
}

@test "sparse_set_insert_overwrite_get"() {
    let s = ecs_ss_new();
    s = ecs_ss_insert(s, 2, 20);
    s = ecs_ss_insert(s, 5, 50);
    if ecs_ss_len(s) != 2 { panic(113210); };
    if ecs_ss_get(s, 2).1 != 20 { panic(113211); };
    s = ecs_ss_insert(s, 2, 22);
    if ecs_ss_len(s) != 2 { panic(113212); };
    if ecs_ss_get(s, 2).1 != 22 { panic(113213); };
    if ecs_ss_contains(s, 5) != true { panic(113214); };
}

@test "sparse_set_get_or_insert_and_remove_swap"() {
    let s = ecs_ss_new();
    let r = ecs_ss_get_or_insert_with(s, 1, 11);
    s = r.0;
    if r.1 != 11 { panic(113220); };
    r = ecs_ss_get_or_insert_with(s, 1, 99);
    s = r.0;
    if r.1 != 11 { panic(113221); };
    s = ecs_ss_insert(s, 2, 22);
    s = ecs_ss_insert(s, 3, 33);
    let rem = ecs_ss_remove(s, 1);
    s = rem.0;
    if rem.1 != true { panic(113222); };
    if rem.2 != 11 { panic(113223); };
    if ecs_ss_len(s) != 2 { panic(113224); };
    if ecs_ss_contains(s, 1) != false { panic(113225); };
    if ecs_ss_get(s, 3).1 != 33 { panic(113226); };
}

@test "sparse_set_clear_and_capacity"() {
    let s = ecs_ss_with_capacity(4);
    if ecs_ss_capacity(s) != 4 { panic(113230); };
    s = ecs_ss_insert(s, 0, 1);
    s = ecs_ss_insert(s, 1, 2);
    s = ecs_ss_clear(s);
    if ecs_ss_is_empty(s) != true { panic(113231); };
    if ecs_ss_capacity(s) != 4 { panic(113232); };
}

@test "component_sparse_set_insert_ticks"() {
    let c = ecs_css_new(9);
    c = ecs_css_insert(c, 10, 100, 1, 7);
    c = ecs_css_insert(c, 11, 110, 2, 8);
    if ecs_css_len(c) != 2 { panic(113240); };
    if ecs_css_drop_id(c) != 9 { panic(113241); };
    let g = ecs_css_get_with_ticks(c, 10);
    if g.0 != true { panic(113242); };
    if g.1 != 100 { panic(113243); };
    if g.2 != 1 { panic(113244); };
    if g.3 != 1 { panic(113245); };
    if g.4 != 7 { panic(113246); };
    // overwrite updates changed tick only
    c = ecs_css_insert(c, 10, 101, 5, 3);
    g = ecs_css_get_with_ticks(c, 10);
    if g.1 != 101 { panic(113247); };
    if g.2 != 1 { panic(113248); };
    if g.3 != 5 { panic(113249); };
    if g.4 != 3 { panic(113250); };
}

@test "component_sparse_set_remove"() {
    let c = ecs_css_new(0);
    c = ecs_css_insert(c, 1, 10, 1, 0);
    c = ecs_css_insert(c, 2, 20, 1, 0);
    c = ecs_css_insert(c, 3, 30, 1, 0);
    let r = ecs_css_remove(c, 2);
    c = r.0;
    if r.1 != true { panic(113260); };
    if r.2 != 20 { panic(113261); };
    if ecs_css_len(c) != 2 { panic(113262); };
    if ecs_css_contains(c, 2) != false { panic(113263); };
    if ecs_css_get(c, 3).1 != 30 { panic(113264); };
}

@test "sparse_sets_registry"() {
    let s = ecs_sparse_sets_new();
    if ecs_sparse_sets_is_empty(s) != true { panic(113270); };
    let r = ecs_sparse_sets_get_or_insert(s, 5, 1);
    s = r.0;
    let set = r.1;
    set = ecs_css_insert(set, 100, 7, 1, 0);
    s = ecs_sparse_sets_set(s, 5, set);
    if ecs_sparse_sets_len(s) != 1 { panic(113271); };
    let g = ecs_sparse_sets_get(s, 5);
    if g.0 != true { panic(113272); };
    if ecs_css_get(g.1, 100).1 != 7 { panic(113273); };
    // second component
    r = ecs_sparse_sets_get_or_insert(s, 6, 2);
    s = r.0;
    if ecs_sparse_sets_len(s) != 2 { panic(113274); };
}

@test "sparse_array_clear"() {
    let a = ecs_sa_insert(ecs_sa_new(), 1, 2);
    a = ecs_sa_insert(a, 4, 5);
    a = ecs_sa_clear(a);
    if ecs_sa_contains(a, 1) != false { panic(113280); };
    if ecs_sa_contains(a, 4) != false { panic(113281); };
}

@test "sparse_set_missing_get"() {
    let s = ecs_ss_new();
    let g = ecs_ss_get(s, 9);
    if g.0 != false { panic(113290); };
    let rem = ecs_ss_remove(s, 9);
    if rem.1 != false { panic(113291); };
}

@test "css_empty_and_missing"() {
    let c = ecs_css_new(0);
    if ecs_css_is_empty(c) != true { panic(113300); };
    if ecs_css_get(c, 1).0 != false { panic(113301); };
    let r = ecs_css_remove(c, 1);
    if r.1 != false { panic(113302); };
}
