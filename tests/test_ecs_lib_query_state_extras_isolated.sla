@import "lib/query_state_extras.sla"

// Isolated tests for lib/query_state_extras.sla — StorageSwitch + fetch wrappers + QueryState surface.
// Bevy reference: src/query/state.rs + src/query/fetch.rs

@test "storage_switch_new_extract_table"() {
    let sw = ecs_storage_switch_new<i64, i64>(100, 200);
    if ecs_storage_switch_extract_table<i64, i64>(sw) != 100 { panic(90684); };
}

@test "storage_switch_new_extract_sparse"() {
    let sw = ecs_storage_switch_new<i64, i64>(100, 200);
    if ecs_storage_switch_extract_sparse<i64, i64>(sw) != 200 { panic(90685); };
}

@test "storage_switch_extract_by_id_table"() {
    let sw = ecs_storage_switch_new<i64, i64>(11, 22);
    let r = ecs_storage_switch_extract_by_id<i64, i64>(sw, 0);
    let tag = r.0;
    let t0 = r.1;
    if tag != 0 { panic(90686); };
    if t0 != 11 { panic(90687); };
}

@test "storage_switch_extract_by_id_sparse"() {
    let sw = ecs_storage_switch_new<i64, i64>(11, 22);
    let r = ecs_storage_switch_extract_by_id<i64, i64>(sw, 1);
    let tag = r.0;
    if tag != 1 { panic(90688); };
}

@test "read_fetch_get"() {
    let f = ecs_read_fetch_new<i64>(42);
    if ecs_read_fetch_get<i64>(f) != 42 { panic(90689); };
}

@test "write_fetch_get_set"() {
    let f = ecs_write_fetch_new<i64>(10);
    if ecs_write_fetch_get<i64>(f) != 10 { panic(90690); };
    let f2 = ecs_write_fetch_set<i64>(f, 99);
    if ecs_write_fetch_get<i64>(f2) != 99 { panic(90691); };
}

@test "ref_fetch_get"() {
    let f = ecs_ref_fetch_new<i64>(77);
    if ecs_ref_fetch_get<i64>(f) != 77 { panic(90692); };
}

@test "query_state_v2_new_defaults"() {
    let s = ecs_query_state_v2_new(5);
    if ecs_query_state_v2_world_id(s) != 5 { panic(90693); };
    if ecs_query_state_v2_generation(s) != 0 { panic(90694); };
    if ecs_query_state_v2_is_readonly(s) != false { panic(90695); };
    if ecs_query_state_v2_matched_table_count(s) != 0 { panic(90696); };
    if ecs_query_state_v2_matched_archetype_count(s) != 0 { panic(90697); };
}

@test "query_state_v2_add_read"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_read(s, 7);
    let ca = ecs_query_state_v2_component_access(s2);
    if ca[0] != 7 { panic(90698); };
    if len(ca) as i32 != 1 { panic(90699); };
    if ecs_query_state_v2_has_read(s2, 7) != true { panic(90700); };
    if ecs_query_state_v2_has_read(s2, 8) != false { panic(90701); };
}

@test "query_state_v2_add_write"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_write(s, 9);
    if ecs_query_state_v2_has_write(s2, 9) != true { panic(90702); };
    if ecs_query_state_v2_has_write(s2, 7) != false { panic(90703); };
    if ecs_query_state_v2_has_read(s2, 9) != true { panic(90704); };
}

@test "query_state_v2_as_readonly"() {
    let s = ecs_query_state_v2_new(1);
    let s2 = ecs_query_state_v2_as_readonly(s);
    if ecs_query_state_v2_is_readonly(s2) != true { panic(90705); };
}

@test "query_state_v2_matched_tables"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_matched_table(s, 11);
    let s3 = ecs_query_state_v2_add_matched_table(s2, 22);
    let mt = ecs_query_state_v2_matched_tables(s3);
    if len(mt) as i32 != 2 { panic(90706); };
    if mt[0] != 11 { panic(90707); };
    if mt[1] != 22 { panic(90708); };
    if ecs_query_state_v2_matched_table_count(s3) != 2 { panic(90709); };
}

@test "query_state_v2_matched_archetypes"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_matched_archetype(s, 33);
    let ma = ecs_query_state_v2_matched_archetypes(s2);
    if len(ma) as i32 != 1 { panic(90710); };
    if ma[0] != 33 { panic(90711); };
    if ecs_query_state_v2_matched_archetype_count(s2) != 1 { panic(90712); };
}

@test "query_state_v2_validate_world_match"() {
    let s = ecs_query_state_v2_new(5);
    let r = ecs_query_state_v2_validate_world(s, 5);
    let ok0 = r.1;
    if ok0 != true { panic(90713); };
}

@test "query_state_v2_validate_world_mismatch"() {
    let s = ecs_query_state_v2_new(5);
    let r = ecs_query_state_v2_validate_world(s, 9);
    let s2 = r.0;
    let ok0 = r.1;
    if ok0 != false { panic(90714); };
    if ecs_query_state_v2_generation(s2) != 1 { panic(90715); };
}

@test "query_state_v2_matches_component_set_yes"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_read(s, 7);
    let set = Vec::new();
    set.push(3);
    set.push(7);
    if ecs_query_state_v2_matches_component_set(s2, set) != true { panic(90716); };
}

@test "query_state_v2_matches_component_set_no"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_read(s, 9);
    let set = Vec::new();
    set.push(3);
    set.push(7);
    if ecs_query_state_v2_matches_component_set(s2, set) != false { panic(90717); };
}

@test "query_state_v2_transmute"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_transmute_filtered(s, 42);
    if ecs_query_state_v2_generation(s2) != 42 { panic(90718); };
}

@test "query_state_v2_join"() {
    let s = ecs_query_state_v2_new(0);
    let s2 = ecs_query_state_v2_add_read(s, 1);
    let s3 = ecs_query_state_v2_join_filtered(s2, 5);
    if ecs_query_state_v2_generation(s3) != 5 { panic(90719); };
}

@test "query_state_v2_static_combo"() {
    let s = ecs_query_state_v2_new(2);
    let s2 = ecs_query_state_v2_add_read(s, 100);
    let s3 = ecs_query_state_v2_add_write(s2, 200);
    let s4 = ecs_query_state_v2_add_matched_table(s3, 1);
    let s5 = ecs_query_state_v2_add_matched_archetype(s4, 10);
    let s6 = ecs_query_state_v2_as_readonly(s5);
    if ecs_query_state_v2_has_read(s6, 100) != true { panic(90720); };
    if ecs_query_state_v2_has_write(s6, 200) != true { panic(90721); };
    if ecs_query_state_v2_matched_table_count(s6) != 1 { panic(90722); };
    if ecs_query_state_v2_matched_archetype_count(s6) != 1 { panic(90723); };
    if ecs_query_state_v2_is_readonly(s6) != true { panic(90724); };
}

@test "write_fetch_round_trip"() {
    let f = ecs_write_fetch_new<i32>(1);
    let f2 = ecs_write_fetch_set<i32>(f, 2);
    let f3 = ecs_write_fetch_set<i32>(f2, 3);
    if ecs_write_fetch_get<i32>(f3) != 3 { panic(90725); };
}

@test "query_state_v2_any_read_then_validate"() {
    let s = ecs_query_state_v2_new(7);
    let s2 = ecs_query_state_v2_add_read(s, 1);
    let s3 = ecs_query_state_v2_add_read(s2, 2);
    let r = ecs_query_state_v2_validate_world(s3, 7);
    let ok0 = r.1;
    let s4 = r.0;
    if ok0 != true { panic(90726); };
    if ecs_query_state_v2_generation(s4) != 0 { panic(90727); };
    if ecs_query_state_v2_world_id(s4) != 7 { panic(90728); };
}
