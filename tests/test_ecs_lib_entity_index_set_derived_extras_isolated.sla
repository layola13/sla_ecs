@import "lib/entity_index_set_derived_extras.sla"

// Isolated tests for lib/entity_index_set_derived_extras.sla.
// Bevy reference: bevy_ecs/src/entity/index_set.rs derived wrappers and iterator traits.

fn make_eis4_values() -> Vec<i64> {
    let values: Vec<i64> = Vec::new();
    values.push(10);
    values.push(20);
    values.push(10);
    values.push(30);
    return values;
}

fn make_eis4_set() -> EcsEis4Set {
    return ecs_eis4_from_iter(make_eis4_values());
}

@test "entity index set derived extras new default capacity markers"() {
    let fresh = ecs_eis4_new();
    let defaulted = ecs_eis4_default();
    let capped = ecs_eis4_with_capacity(12);
    let clamped = ecs_eis4_with_capacity(-5);
    if ecs_eis4_len(fresh) != 0 { panic(92737); };
    if ecs_eis4_debug_kind(fresh) != 1 { panic(92738); };
    if ecs_eis4_debug_kind(defaulted) != 2 { panic(92739); };
    if capped.capacity_hint != 12 { panic(92740); };
    if clamped.capacity_hint != 0 { panic(92741); };
    if capped.constructed_kind != 3 { panic(92742); };
}

@test "entity index set derived extras clone preserves items and capacity"() {
    let set = ecs_eis4_with_capacity(8);
    let inserted = ecs_eis4_insert(set, 44);
    let cloned = ecs_eis4_clone(inserted.set);
    if ecs_eis4_debug_kind(cloned) != 4 { panic(92743); };
    if cloned.capacity_hint != 8 { panic(92744); };
    if ecs_eis4_contains(cloned, 44) != true { panic(92745); };
}

@test "entity index set derived extras extend owned dedups"() {
    let set = ecs_eis4_extend_owned(ecs_eis4_new(), make_eis4_values());
    if ecs_eis4_len(set) != 3 { panic(92746); };
    if ecs_eis4_contains(set, 10) != true { panic(92747); };
    if ecs_eis4_contains(set, 20) != true { panic(92748); };
    if ecs_eis4_contains(set, 30) != true { panic(92749); };
}

@test "entity index set derived extras extend refs dedups"() {
    let base = ecs_eis4_from_array4(1, 2, 3, 3);
    let refs: Vec<i64> = Vec::new();
    refs.push(3);
    refs.push(4);
    refs.push(4);
    let set = ecs_eis4_extend_refs(base, refs);
    if ecs_eis4_len(set) != 4 { panic(92750); };
    if ecs_eis4_contains(set, 4) != true { panic(92751); };
}

@test "entity index set derived extras from array capacity marker"() {
    let set = ecs_eis4_from_array4(7, 8, 7, 9);
    if ecs_eis4_len(set) != 3 { panic(92752); };
    if set.capacity_hint != 4 { panic(92753); };
    if ecs_eis4_debug_kind(set) != 5 { panic(92754); };
}

@test "entity index set derived extras eq inner ignores order"() {
    let inner: Vec<i64> = Vec::new();
    inner.push(30);
    inner.push(10);
    inner.push(20);
    if ecs_eis4_eq_inner(make_eis4_set(), inner) != true { panic(92755); };
}

@test "entity index set derived extras eq inner length mismatch"() {
    let inner: Vec<i64> = Vec::new();
    inner.push(10);
    inner.push(20);
    if ecs_eis4_eq_inner(make_eis4_set(), inner) != false { panic(92756); };
}

@test "entity index set derived extras iter size hint tracks next"() {
    let iter = ecs_eis4_iter(make_eis4_set());
    let hint = ecs_eis4_size_hint(iter);
    if hint.lower != 3 { panic(92757); };
    if hint.upper != 3 { panic(92758); };
    let first = ecs_eis4_iter_next(iter);
    let after = ecs_eis4_size_hint(first.iter);
    if first.value != 10 { panic(92759); };
    if after.lower != 2 { panic(92760); };
    if after.upper != 2 { panic(92761); };
}

@test "entity index set derived extras iterator debug markers"() {
    let iter = ecs_eis4_iter(make_eis4_set());
    let owned = ecs_eis4_into_iter(make_eis4_set());
    let drained = ecs_eis4_drain(make_eis4_set(), 1, 3);
    if ecs_eis4_iter_debug_kind(iter) != 10 { panic(92762); };
    if ecs_eis4_iter_debug_kind(owned) != 20 { panic(92763); };
    if ecs_eis4_iter_debug_kind(drained) != 30 { panic(92764); };
    if drained.trusted_unique != 1 { panic(92765); };
}

@test "entity index set derived extras next back behavior"() {
    let iter = ecs_eis4_into_iter(make_eis4_set());
    let back = ecs_eis4_iter_next_back(iter);
    let front = ecs_eis4_iter_next(back.iter);
    if back.has != 1 { panic(92766); };
    if back.value != 30 { panic(92767); };
    if front.value != 10 { panic(92768); };
    if ecs_eis4_iter_remaining(front.iter) != 1 { panic(92769); };
}

@test "entity index set derived extras drain clamps range"() {
    let drained = ecs_eis4_drain(make_eis4_set(), -5, 99);
    let first = ecs_eis4_iter_next(drained);
    let last = ecs_eis4_iter_next_back(first.iter);
    if first.value != 10 { panic(92770); };
    if last.value != 30 { panic(92771); };
    if ecs_eis4_iter_remaining(last.iter) != 1 { panic(92772); };
}

@test "entity index set derived extras exhausted iterator"() {
    let empty = ecs_eis4_iter(ecs_eis4_new());
    let next = ecs_eis4_iter_next(empty);
    let back = ecs_eis4_iter_next_back(next.iter);
    if next.has != 0 { panic(92773); };
    if back.has != 0 { panic(92774); };
}
