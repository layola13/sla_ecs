@import "lib/system_builder_deep.sla"

@test "param_builder_factory_kinds"() {
    if ecs_param_builder_deep_kind(ecs_param_builder_deep_of(1)) != ECS_PB_DEEP_OF { panic(101100); };
    if ecs_param_builder_deep_kind(ecs_param_builder_deep_resource(2)) != ECS_PB_DEEP_RESOURCE { panic(101101); };
    if ecs_param_builder_deep_kind(ecs_param_builder_deep_resource_mut(3)) != ECS_PB_DEEP_RESOURCE_MUT { panic(101102); };
    if ecs_param_builder_deep_kind(ecs_param_builder_deep_local(4, 99)) != ECS_PB_DEEP_LOCAL { panic(101103); };
    if ecs_param_builder_deep_local_initial(ecs_param_builder_deep_local(4, 99)) != 99 { panic(101104); };
    if ecs_param_builder_deep_kind(ecs_param_builder_deep_query(5)) != ECS_PB_DEEP_QUERY { panic(101105); };
    if ecs_param_builder_deep_filter_id(ecs_param_builder_deep_query_filtered(5, 7)) != 7 { panic(101106); };
}

@test "param_builder_option_result_if_wrap_inner"() {
    let opt = ecs_param_builder_deep_option(ECS_PB_DEEP_RESOURCE, 10);
    if ecs_param_builder_deep_kind(opt) != ECS_PB_DEEP_OPTION { panic(101110); };
    if ecs_param_builder_deep_inner_kind(opt) != ECS_PB_DEEP_RESOURCE { panic(101111); };
    let res = ecs_param_builder_deep_result(ECS_PB_DEEP_RESOURCE, 10);
    if ecs_param_builder_deep_kind(res) != ECS_PB_DEEP_RESULT { panic(101112); };
    let iff = ecs_param_builder_deep_if(ECS_PB_DEEP_RESOURCE, 10);
    if ecs_param_builder_deep_kind(iff) != ECS_PB_DEEP_IF { panic(101113); };
}

@test "param_builder_param_set_and_filtered"() {
    if ecs_param_builder_deep_set_count(ecs_param_builder_deep_param_set(3)) != 3 { panic(101120); };
    let fr = ecs_param_builder_deep_filtered_res(2, 1);
    if ecs_param_builder_deep_read_count(fr) != 2 { panic(101121); };
    if ecs_param_builder_deep_write_count(fr) != 1 { panic(101122); };
    let frm = ecs_param_builder_deep_filtered_res_mut(0, 4);
    if ecs_param_builder_deep_kind(frm) != ECS_PB_DEEP_FILTERED_RES_MUT { panic(101123); };
}

@test "builder_system_starts_uninitialized"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_resource(1), 100, 200);
    if ecs_builder_system_deep_is_uninitialized(s) != true { panic(101130); };
    if ecs_builder_system_deep_is_initialized(s) != false { panic(101131); };
    let n = ecs_builder_system_deep_name(s);
    if n.0 != true { panic(101132); };
    if n.1 != 200 { panic(101133); };
}

@test "run_unsafe_panics_when_uninitialized"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_of(1), 1, 1);
    s = ecs_builder_system_deep_run_unsafe(s);
    if ecs_builder_system_deep_run_ok(s) != false { panic(101140); };
    if ecs_builder_system_deep_last_error(s) != 1 { panic(101141); };
}

@test "initialize_transitions_to_initialized_and_builds_access"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_resource_mut(5), 10, 20);
    s = ecs_builder_system_deep_initialize(s);
    if ecs_builder_system_deep_last_error(s) != 0 { panic(101150); };
    if ecs_builder_system_deep_is_initialized(s) != true { panic(101151); };
    if ecs_builder_system_deep_system_access_writes(s) != 1 { panic(101152); };
    if ecs_builder_system_deep_system_access_reads(s) != 0 { panic(101153); };
}

@test "run_unsafe_works_after_initialize"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_query(1), 1, 1);
    s = ecs_builder_system_deep_initialize(s);
    s = ecs_builder_system_deep_run_unsafe(s);
    if ecs_builder_system_deep_run_ok(s) != true { panic(101160); };
    if ecs_builder_system_deep_system_run_count(s) != 1 { panic(101161); };
    s = ecs_builder_system_deep_run_unsafe(s);
    if ecs_builder_system_deep_system_run_count(s) != 2 { panic(101162); };
}

@test "apply_and_queue_deferred_noop_when_uninitialized"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_of(1), 1, 1);
    s = ecs_builder_system_deep_queue_deferred(s, 5);
    s = ecs_builder_system_deep_apply_deferred(s);
    if ecs_builder_system_deep_is_uninitialized(s) != true { panic(101170); };
    s = ecs_builder_system_deep_initialize(s);
    s = ecs_builder_system_deep_queue_deferred(s, 3);
    if ecs_builder_system_deep_system_deferred(s) != 3 { panic(101171); };
    s = ecs_builder_system_deep_apply_deferred(s);
    if ecs_builder_system_deep_system_deferred(s) != 0 { panic(101172); };
}

@test "last_run_meta_before_init_then_system_after"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_of(1), 1, 1);
    s = ecs_builder_system_deep_set_last_run(s, 42);
    let lr = ecs_builder_system_deep_get_last_run(s);
    if lr.0 != true { panic(101180); };
    if lr.1 != 42 { panic(101181); };
    s = ecs_builder_system_deep_initialize(s);
    let lr2 = ecs_builder_system_deep_get_last_run(s);
    if lr2.1 != 42 { panic(101182); };
    s = ecs_builder_system_deep_set_last_run(s, 99);
    if ecs_builder_system_deep_get_last_run(s).1 != 99 { panic(101183); };
}

@test "force_invalid_blocks_run_and_name"() {
    let s = ecs_builder_system_deep_force_invalid(ecs_builder_system_deep_new(ecs_param_builder_deep_of(1), 1, 1));
    if ecs_builder_system_deep_is_invalid(s) != true { panic(101190); };
    let n = ecs_builder_system_deep_name(s);
    if n.0 != false { panic(101191); };
    s = ecs_builder_system_deep_run_unsafe(s);
    if ecs_builder_system_deep_last_error(s) != 2 { panic(101192); };
    s = ecs_builder_system_deep_initialize(s);
    if ecs_builder_system_deep_last_error(s) != 2 { panic(101193); };
    if ecs_builder_system_deep_is_invalid(s) != true { panic(101194); };
}

@test "reinitialize_initialized_rebuilds_access"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_resource(1), 1, 1);
    s = ecs_builder_system_deep_initialize(s);
    if ecs_builder_system_deep_system_access_reads(s) != 1 { panic(101200); };
    s = ecs_builder_system_deep_initialize(s);
    if ecs_builder_system_deep_is_initialized(s) != true { panic(101201); };
    if ecs_builder_system_deep_system_access_reads(s) != 1 { panic(101202); };
}

@test "into_builder_and_build_system_facades"() {
    let b = ecs_param_builder_deep_local(3, 7);
    let s = ecs_param_builder_deep_build_system(b, 50, 60);
    if ecs_builder_system_deep_is_uninitialized(s) != true { panic(101210); };
    if ecs_builder_system_deep_func_id(s) != 50 { panic(101211); };
    if ecs_local_builder_deep_value(ecs_builder_system_deep_builder(s)) != 7 { panic(101212); };
    let into = ecs_into_builder_system_deep_into(b, 1, 2);
    if ecs_builder_system_deep_state(into) != ECS_BS_UNINITIALIZED { panic(101213); };
}

@test "build_state_then_build_system_initializes"() {
    let st = ecs_param_builder_deep_build_state(ecs_param_builder_deep_query(9), 123);
    if ecs_system_state_deep_ready(st) != true { panic(101220); };
    if ecs_system_state_deep_world_id(st) != 123 { panic(101221); };
    let s = ecs_system_state_deep_build_system(st, 1, 2);
    if ecs_builder_system_deep_is_initialized(s) != true { panic(101222); };
    if ecs_builder_system_deep_system_access_reads(s) != 1 { panic(101223); };
}

@test "param_set_builder_accumulate"() {
    let p = ecs_param_set_builder_deep_new();
    p = ecs_param_set_builder_deep_add(p, ecs_param_builder_deep_of(1));
    p = ecs_param_set_builder_deep_add(p, ecs_param_builder_deep_resource(2));
    if ecs_param_set_builder_deep_len(p) != 2 { panic(101230); };
    let b = ecs_param_set_builder_deep_into_param_builder(p);
    if ecs_param_builder_deep_kind(b) != ECS_PB_DEEP_PARAM_SET { panic(101231); };
    if ecs_param_builder_deep_set_count(b) != 2 { panic(101232); };
    let s = ecs_builder_system_deep_initialize(ecs_builder_system_deep_new(b, 1, 1));
    if ecs_builder_system_deep_system_access_reads(s) != 2 { panic(101233); };
}

@test "option_builder_access_from_inner"() {
    let opt = ecs_param_builder_deep_option(ECS_PB_DEEP_RESOURCE_MUT, 5);
    let acc = ecs_param_builder_deep_build_access(opt);
    if acc.0 != 0 { panic(101240); };
    if acc.1 != 1 { panic(101241); };
}

@test "filtered_resources_access_counts"() {
    let b = ecs_param_builder_deep_filtered_res(3, 2);
    let acc = ecs_param_builder_deep_build_access(b);
    if acc.0 != 3 { panic(101250); };
    if acc.1 != 2 { panic(101251); };
}

@test "query_param_builder_new_and_box"() {
    let q = ecs_query_param_builder_deep_new(42);
    if ecs_param_builder_deep_kind(q) != ECS_PB_DEEP_QUERY { panic(101260); };
    if ecs_param_builder_deep_type_id(q) != 42 { panic(101261); };
    let q2 = ecs_query_param_builder_deep_new_box(43);
    if ecs_param_builder_deep_type_id(q2) != 43 { panic(101262); };
}

@test "dyn_param_builder_wraps_inner"() {
    let d = ecs_param_builder_deep_dyn(ECS_PB_DEEP_LOCAL, 1);
    if ecs_param_builder_deep_kind(d) != ECS_PB_DEEP_DYN { panic(101270); };
    if ecs_param_builder_deep_inner_kind(d) != ECS_PB_DEEP_LOCAL { panic(101271); };
}

@test "flags_from_meta_before_init"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_of(1), 1, 1);
    s = ecs_builder_system_deep_set_meta_flags(s, 4);
    let f = ecs_builder_system_deep_flags(s);
    if f.0 != true { panic(101280); };
    if f.1 != 4 { panic(101281); };
    s = ecs_builder_system_deep_initialize(s);
    let f2 = ecs_builder_system_deep_flags(s);
    if f2.0 != true { panic(101282); };
    if f2.1 != 4 { panic(101283); };
}

@test "builder_kind_preserved"() {
    let s = ecs_builder_system_deep_new(ecs_param_builder_deep_query_filtered(9, 8), 1, 1);
    if ecs_builder_system_deep_builder_kind(s) != ECS_PB_DEEP_QUERY_FILTERED { panic(101290); };
    if ecs_param_builder_deep_filter_id(ecs_builder_system_deep_builder(s)) != 8 { panic(101291); };
}
