// Isolated deep tests for lib/hierarchy_commands_deep.sla (Batch 380).
// Mirror shallow lib/hierarchy_commands.sla facade (src/hierarchy.rs EntityCommands /
// EntityWorldMut pub methods on ChildOf) on cap-8 kind-discriminated deferred command queue +
// cap-8 x cap-4 entity-list pool + cap-8 parent x cap-4 children world. No tuple-return
// destructuring (wrapper structs EcsHierCmdApplyDeep / EcsHierReserveDeep with scalar accessors);
// no `let m = fn(m, ...)` chained rebinding — sequential names. panic codes: 142000 - 142188.

@import "lib/hierarchy_commands_deep.sla"

@test "EcsHierCmdsDeep new + len + add_child queueing"() {
    let s0 = ecs_hier_cmd_state_deep_new();
    if ecs_hier_cmd_state_deep_len(s0) != 0 { panic(142000); };
    let s1 = ecs_hier_cmds_deep_add_child(s0, 1, 2);
    let s2 = ecs_hier_cmds_deep_add_child(s1, 1, 3);
    let s3 = ecs_hier_cmds_deep_add_child(s2, 1, 4);
    if ecs_hier_cmd_state_deep_len(s3) != 3 { panic(142001); };
    if ecs_hier_cmd_state_deep_kind_at(s3, 0) != ECS_HIER_ADD_CHILD { panic(142002); };
    if ecs_hier_cmd_state_deep_target_at(s3, 0) != 1 { panic(142003); };
    if ecs_hier_cmd_state_deep_child_at(s3, 2) != 4 { panic(142004); };
}

@test "EcsHierCmdsDeep add_child apply reorder + child_at order"() {
    let w0 = ecs_hier_world_deep_new();
    let spawn1 = ecs_hier_world_deep_spawn(w0);
    let w1 = spawn1.0;
    let root = spawn1.1;
    let spawn2 = ecs_hier_world_deep_spawn(w1);
    let w2 = spawn2.0;
    let child1 = spawn2.1;
    let spawn3 = ecs_hier_world_deep_spawn(w2);
    let w3 = spawn3.0;
    let child2 = spawn3.1;
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, child1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, child1);
    let s3 = ecs_hier_cmds_deep_add_child(s2, root, child2);
    if ecs_hier_world_deep_child_count(w3, root) != 0 { panic(142005); };
    let apply = ecs_hier_commands_deep_apply(w3, s3);
    let w4 = ecs_hier_cmd_apply_world(apply);
    if ecs_hier_world_deep_child_count(w4, root) != 3 { panic(142006); };
    if ecs_hier_world_deep_child_at(w4, root, 0) != child1 { panic(142007); };
    if ecs_hier_world_deep_child_at(w4, root, 1) != child1 { panic(142008); };
    if ecs_hier_world_deep_child_at(w4, root, 2) != child2 { panic(142009); };
}

@test "EcsHierCmdsDeep insert_child at index preserves order"() {
    let w0 = ecs_hier_world_deep_new();
    let spawn1 = ecs_hier_world_deep_spawn(w0);
    let w1 = spawn1.0;
    let root = spawn1.1;
    let spawn2 = ecs_hier_world_deep_spawn(w1);
    let w2 = spawn2.0;
    let c1 = spawn2.1;
    let spawn3 = ecs_hier_world_deep_spawn(w2);
    let w3 = spawn3.0;
    let c2 = spawn3.1;
    let spawn4 = ecs_hier_world_deep_spawn(w3);
    let w4 = spawn4.0;
    let c3 = spawn4.1;
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, c1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, c2);
    let s3 = ecs_hier_cmds_deep_insert_child(s2, root, 1, c3);
    let apply = ecs_hier_commands_deep_apply(w4, s3);
    let w5 = ecs_hier_cmd_apply_world(apply);
    if ecs_hier_world_deep_child_count(w5, root) != 3 { panic(142010); };
    if ecs_hier_world_deep_child_at(w5, root, 0) != c1 { panic(142011); };
    if ecs_hier_world_deep_child_at(w5, root, 1) != c3 { panic(142012); };
    if ecs_hier_world_deep_child_at(w5, root, 2) != c2 { panic(142013); };
}

@test "EcsHierCmdsDeep detach_child single then has_parent false"() {
    let w0 = ecs_hier_world_deep_new();
    let spawn1 = ecs_hier_world_deep_spawn(w0);
    let w1 = spawn1.0;
    let root = spawn1.1;
    let spawn2 = ecs_hier_world_deep_spawn(w1);
    let w2 = spawn2.0;
    let c1 = spawn2.1;
    let spawn3 = ecs_hier_world_deep_spawn(w2);
    let w3 = spawn3.0;
    let c2 = spawn3.1;
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, c1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, c2);
    let apply1 = ecs_hier_commands_deep_apply(w3, s2);
    let w4 = ecs_hier_cmd_apply_world(apply1);
    if ecs_hier_world_deep_has_parent(w4, c1) != true { panic(142014); };
    let s3 = ecs_hier_cmds_deep_detach_child(apply1.commands, root, c1);
    let apply2 = ecs_hier_commands_deep_apply(w4, s3);
    let w5 = ecs_hier_cmd_apply_world(apply2);
    if ecs_hier_world_deep_has_parent(w5, c1) != false { panic(142015); };
    if ecs_hier_world_deep_has_parent(w5, c2) != true { panic(142016); };
    if ecs_hier_world_deep_child_count(w5, root) != 1 { panic(142017); };
}

@test "EcsHierCmdsDeep detach_all_children clears parent slot"() {
    let w0 = ecs_hier_world_deep_new();
    let spawn1 = ecs_hier_world_deep_spawn(w0);
    let w1 = spawn1.0;
    let root = spawn1.1;
    let spawn2 = ecs_hier_world_deep_spawn(w1);
    let w2 = spawn2.0;
    let c1 = spawn2.1;
    let spawn3 = ecs_hier_world_deep_spawn(w2);
    let w3 = spawn3.0;
    let c2 = spawn3.1;
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, c1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, c2);
    let s3 = ecs_hier_cmds_deep_detach_all_children(s2, root);
    let apply = ecs_hier_commands_deep_apply(w3, s3);
    let w4 = ecs_hier_cmd_apply_world(apply);
    if ecs_hier_world_deep_child_count(w4, root) != 0 { panic(142018); };
    if ecs_hier_world_deep_has_parent(w4, c1) != false { panic(142019); };
    if ecs_hier_world_deep_has_parent(w4, c2) != false { panic(142020); };
}

@test "EcsHierCmdsDeep replace_children via list pool"() {
    let w0 = ecs_hier_world_deep_new();
    let spawn1 = ecs_hier_world_deep_spawn(w0);
    let w1 = spawn1.0;
    let root = spawn1.1;
    let sp2 = ecs_hier_world_deep_spawn(w1);
    let w2 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_hier_world_deep_spawn(w2);
    let w3 = sp3.0;
    let c2 = sp3.1;
    let sp4 = ecs_hier_world_deep_spawn(w3);
    let w4 = sp4.0;
    let c3 = sp4.1;
    // Seed with c1, c2 then replace with list holding c3 only (index 0).
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, c1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, c2);
    let apply1 = ecs_hier_commands_deep_apply(w4, s2);
    let w5 = ecs_hier_cmd_apply_world(apply1);
    if ecs_hier_world_deep_child_count(w5, root) != 2 { panic(142021); };
    // Build a replace command referencing pool list index 0 holding c3.
    let s3 = ecs_hier_cmd_state_deep_new();
    let s4 = ecs_hier_cmds_deep_alloc_list(s3);
    let s5 = ecs_hier_cmds_deep_push_list_entity(s4, 0, c3);
    let s6 = ecs_hier_cmds_deep_replace_children(s5, root, 0);
    let apply2 = ecs_hier_commands_deep_apply(w5, s6);
    let w6 = ecs_hier_cmd_apply_world(apply2);
    if ecs_hier_world_deep_child_count(w6, root) != 1 { panic(142022); };
    if ecs_hier_world_deep_child_at(w6, root, 0) != c3 { panic(142023); };
    if ecs_hier_world_deep_has_parent(w6, c1) != false { panic(142024); };
    if ecs_hier_world_deep_has_parent(w6, c2) != false { panic(142025); };
}

@test "EcsHierCmdsDeep replace_diff unrelate + relate + newly"() {
    let w0 = ecs_hier_world_deep_new();
    let sp1 = ecs_hier_world_deep_spawn(w0);
    let w1 = sp1.0;
    let root = sp1.1;
    let sp2 = ecs_hier_world_deep_spawn(w1);
    let w2 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_hier_world_deep_spawn(w2);
    let w3 = sp3.0;
    let c2 = sp3.1;
    let sp4 = ecs_hier_world_deep_spawn(w3);
    let w4 = sp4.0;
    let c3 = sp4.1;
    // Seed root with c1 + c2.
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, c1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, c2);
    let apply1 = ecs_hier_commands_deep_apply(w4, s2);
    let w5 = ecs_hier_cmd_apply_world(apply1);
    // diff: unrelate [c1](idx 0), relate [c2, c3](idx 1), newly [c3](idx 2).
    let s3 = ecs_hier_cmd_state_deep_new();
    let s4 = ecs_hier_cmds_deep_alloc_list(s3);
    let s5 = ecs_hier_cmds_deep_push_list_entity(s4, 0, c1);
    let s6 = ecs_hier_cmds_deep_alloc_list(s5);
    let s7 = ecs_hier_cmds_deep_push_list_entity(s6, 1, c2);
    let s8 = ecs_hier_cmds_deep_push_list_entity(s7, 1, c3);
    let s9 = ecs_hier_cmds_deep_alloc_list(s8);
    let s10 = ecs_hier_cmds_deep_push_list_entity(s9, 2, c3);
    let s11 = ecs_hier_cmds_deep_replace_diff(s10, root, 0, 1, 2);
    let apply2 = ecs_hier_commands_deep_apply(w5, s11);
    let w6 = ecs_hier_cmd_apply_world(apply2);
    if ecs_hier_world_deep_has_parent(w6, c1) != false { panic(142026); };
    if ecs_hier_world_deep_has_parent(w6, c2) != true { panic(142027); };
    if ecs_hier_world_deep_has_parent(w6, c3) != true { panic(142028); };
    if ecs_hier_world_deep_child_count(w6, root) != 2 { panic(142029); };
    if ecs_hier_world_deep_is_alive(w6, c3) != true { panic(142030); };
}

@test "EcsHierCmdsDeep despawn_children marks children not alive"() {
    let w0 = ecs_hier_world_deep_new();
    let sp1 = ecs_hier_world_deep_spawn(w0);
    let w1 = sp1.0;
    let root = sp1.1;
    let sp2 = ecs_hier_world_deep_spawn(w1);
    let w2 = sp2.0;
    let c1 = sp2.1;
    let sp3 = ecs_hier_world_deep_spawn(w2);
    let w3 = sp3.0;
    let c2 = sp3.1;
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_add_child(s0, root, c1);
    let s2 = ecs_hier_cmds_deep_add_child(s1, root, c2);
    let s3 = ecs_hier_cmds_deep_despawn_children(s2, root);
    let apply = ecs_hier_commands_deep_apply(w3, s3);
    let w4 = ecs_hier_cmd_apply_world(apply);
    if ecs_hier_world_deep_is_alive(w4, root) != true { panic(142031); };
    if ecs_hier_world_deep_is_alive(w4, c1) != false { panic(142032); };
    if ecs_hier_world_deep_is_alive(w4, c2) != false { panic(142033); };
    if ecs_hier_world_deep_child_count(w4, root) != 0 { panic(142034); };
}

@test "EcsHierCmdsDeep despawn single entity + cap-8 reject + clear"() {
    let w0 = ecs_hier_world_deep_new();
    let sp1 = ecs_hier_world_deep_spawn(w0);
    let w1 = sp1.0;
    let e1 = sp1.1;
    let sp2 = ecs_hier_world_deep_spawn(w1);
    let w2 = sp2.0;
    let e2 = sp2.1;
    if ecs_hier_world_deep_is_alive(w2, e1) != true { panic(142035); };
    let s0 = ecs_hier_cmd_state_deep_new();
    let s1 = ecs_hier_cmds_deep_despawn(s0, e1);
    let apply = ecs_hier_commands_deep_apply(w2, s1);
    let w3 = ecs_hier_cmd_apply_world(apply);
    if ecs_hier_world_deep_is_alive(w3, e1) != false { panic(142036); };
    if ecs_hier_world_deep_is_alive(w3, e2) != true { panic(142037); };
    // Cap-8 reject: push 8 commands then attempt a 9th — state stays at count 8.
    let sA = ecs_hier_cmd_state_deep_new();
    let sB = ecs_hier_cmds_deep_add_child(sA, e2, e1);
    let sC = ecs_hier_cmds_deep_add_child(sB, e2, e1);
    let sD = ecs_hier_cmds_deep_add_child(sC, e2, e1);
    let sE = ecs_hier_cmds_deep_add_child(sD, e2, e1);
    let sF = ecs_hier_cmds_deep_add_child(sE, e2, e1);
    let sG = ecs_hier_cmds_deep_add_child(sF, e2, e1);
    let sH = ecs_hier_cmds_deep_add_child(sG, e2, e1);
    let sI = ecs_hier_cmds_deep_add_child(sH, e2, e1);
    let sJ = ecs_hier_cmds_deep_add_child(sI, e2, e1);
    if ecs_hier_cmd_state_deep_len(sJ) != 8 { panic(142038); };
    let sK = ecs_hier_cmds_deep_clear(sJ);
    if ecs_hier_cmd_state_deep_len(sK) != 0 { panic(142039); };
}

@test "EcsHierCmdsDeep reserve_entity wrapper + spawn chain"() {
    let w0 = ecs_hier_world_deep_new();
    let s0 = ecs_hier_cmd_state_deep_new();
    let res = ecs_hier_commands_deep_reserve_entity(w0, s0);
    let w1 = ecs_hier_cmd_reserve_world(res);
    let e = ecs_hier_cmd_reserve_entity(res);
    if e != 1 { panic(142040); };
    if ecs_hier_world_deep_is_alive(w1, e) != true { panic(142041); };
    let res2 = ecs_hier_commands_deep_reserve_entity(w1, s0);
    let w2 = ecs_hier_cmd_reserve_world(res2);
    let e2 = ecs_hier_cmd_reserve_entity(res2);
    if e2 != 2 { panic(142042); };
    if ecs_hier_world_deep_is_alive(w2, e2) != true { panic(142043); };
    // deferred queue should NOT grow from reserve_entity (no command pushed).
    let cmds = ecs_hier_cmd_reserve_commands(res2);
    if ecs_hier_commands_deep_len(cmds) != 0 { panic(142044); };
    // Multi-kind queue: add + despawn applied in order yields alive=false on the second child.
    let s1 = ecs_hier_cmd_state_deep_new();
    let s2 = ecs_hier_cmds_deep_add_child(s1, e, e2);
    let s3 = ecs_hier_cmds_deep_despawn(s2, e2);
    let apply = ecs_hier_commands_deep_apply(w2, s3);
    let w3 = ecs_hier_cmd_apply_world(apply);
    if ecs_hier_world_deep_is_alive(w3, e2) != false { panic(142045); };
    if ecs_hier_world_deep_child_count(w3, e) != 1 { panic(142046); };
}
