@import "lib/query_builder_deep.sla"

// Batch 254: query_builder deep (src/query/builder.rs).
// panic codes: 116800 – 116999.

@test "new_and_data_ref_mut"() {
    let b = ecs_qb_deep_new(3);
    if ecs_qb_deep_world(b) != 3 { panic(116800); };
    b = ecs_qb_deep_data(b, 1);
    b = ecs_qb_deep_ref_id(b, 2);
    b = ecs_qb_deep_mut_id(b, 3);
    if ecs_qb_deep_data_len(b) != 3 { panic(116801); };
    let built = ecs_qb_deep_build(b);
    if ecs_qb_build_write_count(built) != 1 { panic(116802); };
}

@test "with_without_match"() {
    let b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_with(b, 10);
    b = ecs_qb_deep_without(b, 20);
    if ecs_qb_deep_entity_matches(b, 10, 30, 0, 0, 2) != true { panic(116810); };
    if ecs_qb_deep_entity_matches(b, 10, 20, 0, 0, 2) != false { panic(116811); };
    if ecs_qb_deep_entity_matches(b, 30, 0, 0, 0, 1) != false { panic(116812); };
}

@test "or_and_optional_counts"() {
    let b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_or(b);
    if ecs_qb_deep_in_or(b) != true { panic(116820); };
    if ecs_qb_deep_or_groups(b) != 1 { panic(116821); };
    b = ecs_qb_deep_and(b);
    if ecs_qb_deep_in_or(b) != false { panic(116822); };
    b = ecs_qb_deep_optional(b);
    b = ecs_qb_deep_optional(b);
    if ecs_qb_deep_optional_count(b) != 2 { panic(116823); };
}

@test "dense_inference_sparse_filter"() {
    let b = ecs_qb_deep_new(1);
    if ecs_qb_deep_is_dense(b) != true { panic(116830); };
    b = ecs_qb_deep_mark_with_sparse(b);
    if ecs_qb_deep_is_dense(b) != false { panic(116831); };
    b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_mark_data_sparse(b);
    if ecs_qb_deep_is_dense(b) != false { panic(116832); };
}

@test "extend_access_merges"() {
    let a = ecs_qb_deep_new(1);
    a = ecs_qb_deep_data(a, 1);
    a = ecs_qb_deep_with(a, 2);
    let o = ecs_qb_deep_new(1);
    o = ecs_qb_deep_mut_id(o, 3);
    o = ecs_qb_deep_without(o, 4);
    a = ecs_qb_deep_extend(a, o);
    if ecs_qb_deep_data_len(a) != 2 { panic(116840); };
    if ecs_qb_deep_with_len(a) != 1 { panic(116841); };
    if ecs_qb_deep_without_len(a) != 1 { panic(116842); };
}

@test "transmute_replaces_data"() {
    let b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_mut_id(b, 9);
    b = ecs_qb_deep_mut_id(b, 8);
    b = ecs_qb_deep_transmute2(b, 1, 2);
    let built = ecs_qb_deep_build(b);
    if ecs_qb_build_data_len(built) != 2 { panic(116850); };
    if ecs_qb_build_write_count(built) != 0 { panic(116851); };
}

@test "build_snapshot"() {
    let b = ecs_qb_deep_new(5);
    b = ecs_qb_deep_data(b, 1);
    b = ecs_qb_deep_mut_id(b, 2);
    b = ecs_qb_deep_with(b, 3);
    b = ecs_qb_deep_without(b, 4);
    b = ecs_qb_deep_or(b);
    b = ecs_qb_deep_optional(b);
    let s = ecs_qb_deep_build(b);
    if ecs_qb_build_world(s) != 5 { panic(116860); };
    if ecs_qb_build_data_len(s) != 2 { panic(116861); };
    if ecs_qb_build_with_len(s) != 1 { panic(116862); };
    if ecs_qb_build_without_len(s) != 1 { panic(116863); };
    if ecs_qb_build_write_count(s) != 1 { panic(116864); };
    if ecs_qb_build_or_groups(s) != 1 { panic(116865); };
    if ecs_qb_build_optional_count(s) != 1 { panic(116866); };
    if ecs_qb_build_is_dense(s) != true { panic(116867); };
}

@test "capacity_four_data"() {
    let b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_data(b, 1);
    b = ecs_qb_deep_data(b, 2);
    b = ecs_qb_deep_data(b, 3);
    b = ecs_qb_deep_data(b, 4);
    b = ecs_qb_deep_data(b, 5);
    if ecs_qb_deep_data_len(b) != 4 { panic(116870); };
}

@test "with_without_capacity"() {
    let b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_with(b, 1);
    b = ecs_qb_deep_with(b, 2);
    b = ecs_qb_deep_with(b, 3);
    b = ecs_qb_deep_with(b, 4);
    b = ecs_qb_deep_with(b, 5);
    b = ecs_qb_deep_without(b, 6);
    b = ecs_qb_deep_without(b, 7);
    if ecs_qb_deep_with_len(b) != 4 { panic(116880); };
    if ecs_qb_deep_without_len(b) != 2 { panic(116881); };
}

@test "or_then_with_clears_first_flag"() {
    let b = ecs_qb_deep_new(1);
    b = ecs_qb_deep_or(b);
    b = ecs_qb_deep_with(b, 1);
    // still in or mode after first term
    if ecs_qb_deep_in_or(b) != true { panic(116890); };
    if ecs_qb_deep_with_len(b) != 1 { panic(116891); };
}
