@import "lib/schedule_configs_extras.sla"

// Isolated tests for lib/schedule_configs_extras.sla — IntoScheduleConfigs/ScheduleConfigs gaps (chain/chain_ignore_deferred/distributive_run_if/run_if/ambiguous_with/ambiguous_with_all/before_ignore_deferred/after_ignore_deferred/into_configs). Bevy reference: src/schedule/config.rs (gaps not in lib/schedule_config.sla).

@test "configs_v2_new_empty"() {
    let c = ecs_schedule_configs_v2_new();
    if ecs_schedule_configs_v2_len(c) != 0 { panic(91618); };
    if ecs_schedule_configs_v2_is_chain(c) { panic(91619); };
    if !ecs_schedule_configs_v2_applies_deferred_on_edges(c) { panic(91620); };
}

@test "configs_v2_add_grows_len"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    let c3 = ecs_schedule_configs_v2_add(c2, 2);
    if ecs_schedule_configs_v2_len(c3) != 2 { panic(91621); };
    if ecs_schedule_configs_v2_system_at(c3, 0) != 1 { panic(91622); };
    if ecs_schedule_configs_v2_system_at(c3, 1) != 2 { panic(91623); };
}

@test "configs_v2_system_at_out_of_bounds"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    if ecs_schedule_configs_v2_system_at(c2, -1) != -1 { panic(91624); };
    if ecs_schedule_configs_v2_system_at(c2, 99) != -1 { panic(91625); };
}

@test "chain_sets_chain_and_applies_deferred"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    let c3 = ecs_schedule_configs_v2_add(c2, 2);
    let c4 = ecs_schedule_configs_v2_chain(c3);
    if !ecs_schedule_configs_v2_is_chain(c4) { panic(91626); };
    if !ecs_schedule_configs_v2_applies_deferred_on_edges(c4) { panic(91627); };
}

@test "chain_ignore_deferred_sets_chain_and_no_deferred"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_chain_ignore_deferred(c);
    if !ecs_schedule_configs_v2_is_chain(c2) { panic(91628); };
    if ecs_schedule_configs_v2_applies_deferred_on_edges(c2) { panic(91629); };
}

@test "distributive_run_if_distributes_across_all_configs"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    let c3 = ecs_schedule_configs_v2_add(c2, 2);
    let c4 = ecs_schedule_configs_v2_add(c3, 3);
    let c5 = ecs_schedule_configs_v2_distributive_run_if(c4, 77);
    if ecs_schedule_configs_v2_distributive_conditions(c5) != 3 { panic(91630); };
}

@test "run_if_is_collective_once"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    let c3 = ecs_schedule_configs_v2_add(c2, 2);
    let c4 = ecs_schedule_configs_v2_run_if(c3, 88);
    if ecs_schedule_configs_v2_collective_conditions(c4) != 1 { panic(91631); };
}

@test "distributive_vs_collective_run_if_distinct"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    let c3 = ecs_schedule_configs_v2_add(c2, 2);
    let c4 = ecs_schedule_configs_v2_run_if(c3, 1);
    let c5 = ecs_schedule_configs_v2_distributive_run_if(c4, 2);
    if ecs_schedule_configs_v2_collective_conditions(c5) != 1 { panic(91632); };
    if ecs_schedule_configs_v2_distributive_conditions(c5) != 2 { panic(91633); };
}

@test "before_ignore_deferred_records_set_id"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_before_ignore_deferred(c, 9);
    if ecs_schedule_configs_v2_before_id_ignore_deferred(c2) != 9 { panic(91634); };
}

@test "after_ignore_deferred_records_set_id"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_after_ignore_deferred(c, 11);
    if ecs_schedule_configs_v2_after_id_ignore_deferred(c2) != 11 { panic(91635); };
}

@test "ambiguous_with_records_set_id"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_ambiguous_with(c, 7);
    let c3 = ecs_schedule_configs_v2_ambiguous_with(c2, 9);
    if ecs_schedule_configs_v2_ambiguous_with_ids_count(c3) != 2 { panic(91636); };
    if ecs_schedule_configs_v2_ambiguous_with_at(c3, 0) != 7 { panic(91637); };
    if ecs_schedule_configs_v2_ambiguous_with_at(c3, 1) != 9 { panic(91638); };
}

@test "ambiguous_with_all_flags"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_ambiguous_with(c, 7);
    let c3 = ecs_schedule_configs_v2_ambiguous_with_all(c2);
    if !ecs_schedule_configs_v2_is_ambiguous_with_all(c3) { panic(91639); };
}

@test "into_configs_is_identity"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_add(c, 1);
    let c3 = ecs_schedule_configs_v2_into_configs(c2);
    if ecs_schedule_configs_v2_len(c3) != 1 { panic(91640); };
    if ecs_schedule_configs_v2_system_at(c3, 0) != 1 { panic(91641); };
}

@test "ambiguous_with_at_out_of_bounds"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_ambiguous_with(c, 7);
    if ecs_schedule_configs_v2_ambiguous_with_at(c2, -1) != -1 { panic(91642); };
    if ecs_schedule_configs_v2_ambiguous_with_at(c2, 99) != -1 { panic(91643); };
}

@test "distributive_run_if_on_empty_does_not_increment"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_distributive_run_if(c, 77);
    if ecs_schedule_configs_v2_distributive_conditions(c2) != 0 { panic(91644); };
}

@test "chain_then_chain_ignore_deferred_overrides_deferred_flag"() {
    let c = ecs_schedule_configs_v2_new();
    let c2 = ecs_schedule_configs_v2_chain(c);
    let c3 = ecs_schedule_configs_v2_chain_ignore_deferred(c2);
    if !ecs_schedule_configs_v2_is_chain(c3) { panic(91645); };
    if ecs_schedule_configs_v2_applies_deferred_on_edges(c3) { panic(91646); };
}
