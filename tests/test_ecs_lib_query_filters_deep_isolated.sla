@import "lib/query_filters_deep.sla"

// Batch 255: query_filters deep (src/query/filter.rs + fetch.rs).
// panic codes: 117000 – 117199.

@test "with_without_basic"() {
    let c = ecs_qf_comps_new();
    c = ecs_qf_comps_push(c, 1);
    c = ecs_qf_comps_push(c, 2);
    if ecs_qf_with_matches(1, c) != true { panic(117000); };
    if ecs_qf_with_matches(3, c) != false { panic(117001); };
    if ecs_qf_without_matches(3, c) != true { panic(117002); };
    if ecs_qf_without_matches(2, c) != false { panic(117003); };
}

@test "or_filter"() {
    let c = ecs_qf_comps_new();
    c = ecs_qf_comps_push(c, 5);
    if ecs_qf_or_matches(5, 6, c) != true { panic(117010); };
    if ecs_qf_or_matches(6, 7, c) != false { panic(117011); };
}

@test "added_changed_spawned"() {
    let added = ecs_qf_comps_new();
    added = ecs_qf_comps_push(added, 9);
    let changed = ecs_qf_comps_new();
    changed = ecs_qf_comps_push(changed, 8);
    if ecs_qf_added_matches(9, added) != true { panic(117020); };
    if ecs_qf_added_matches(8, added) != false { panic(117021); };
    if ecs_qf_changed_matches(8, changed) != true { panic(117022); };
    if ecs_qf_spawned_matches(true) != true { panic(117023); };
    if ecs_qf_spawned_matches(false) != false { panic(117024); };
}

@test "bundle_combines_filters"() {
    let b = ecs_qf_bundle_new();
    b = ecs_qf_bundle_with(b, 1);
    b = ecs_qf_bundle_without(b, 2);
    b = ecs_qf_bundle_or(b, 3, 4);
    b = ecs_qf_bundle_added(b, 5);
    b = ecs_qf_bundle_changed(b, 6);
    b = ecs_qf_bundle_spawned(b);
    let comps = ecs_qf_comps_new();
    comps = ecs_qf_comps_push(comps, 1);
    comps = ecs_qf_comps_push(comps, 3);
    let added = ecs_qf_comps_new();
    added = ecs_qf_comps_push(added, 5);
    let changed = ecs_qf_comps_new();
    changed = ecs_qf_comps_push(changed, 6);
    if ecs_qf_bundle_matches(b, comps, added, changed, true) != true { panic(117030); };
    if ecs_qf_bundle_matches(b, comps, added, changed, false) != false { panic(117031); };
}

@test "bundle_without_blocks"() {
    let b = ecs_qf_bundle_new();
    b = ecs_qf_bundle_without(b, 2);
    let comps = ecs_qf_comps_new();
    comps = ecs_qf_comps_push(comps, 2);
    let empty = ecs_qf_comps_new();
    if ecs_qf_bundle_matches(b, comps, empty, empty, false) != false { panic(117040); };
}

@test "has_anyof_option_fetch"() {
    let c = ecs_qf_comps_new();
    c = ecs_qf_comps_push(c, 1);
    c = ecs_qf_comps_push(c, 3);
    if ecs_qf_has_fetch(c, 1) != true { panic(117050); };
    if ecs_qf_has_fetch(c, 2) != false { panic(117051); };
    let any = ecs_qf_any_of_fetch(c, 2, 3);
    if ecs_qf_any_of_a(any) != false { panic(117052); };
    if ecs_qf_any_of_b(any) != true { panic(117053); };
    let opt = ecs_qf_option_fetch(c, 1);
    if ecs_qf_option_is_some(opt) != true { panic(117054); };
    if ecs_qf_option_value(opt) != 1 { panic(117055); };
    opt = ecs_qf_option_fetch(c, 9);
    if ecs_qf_option_is_some(opt) != false { panic(117056); };
}

@test "archetype_filter"() {
    let table = ecs_qf_comps_new();
    table = ecs_qf_comps_push(table, 7);
    table = ecs_qf_comps_push(table, 8);
    if ecs_qf_archetype_matches(table, 7) != true { panic(117060); };
    if ecs_qf_archetype_matches(table, 9) != false { panic(117061); };
}

@test "allow_bypasses_default_disable"() {
    let allow = ecs_qf_allow_new(4);
    if ecs_qf_allow_id(allow) != 4 { panic(117070); };
    if ecs_qf_disabled_by_default(4, true, allow) != false { panic(117071); };
    if ecs_qf_disabled_by_default(5, true, allow) != true { panic(117072); };
    if ecs_qf_disabled_by_default(5, false, allow) != false { panic(117073); };
}

@test "comps_capacity_four"() {
    let c = ecs_qf_comps_new();
    c = ecs_qf_comps_push(c, 1);
    c = ecs_qf_comps_push(c, 2);
    c = ecs_qf_comps_push(c, 3);
    c = ecs_qf_comps_push(c, 4);
    c = ecs_qf_comps_push(c, 5);
    if ecs_qf_comps_has(c, 4) != true { panic(117080); };
    if ecs_qf_comps_has(c, 5) != false { panic(117081); };
}

@test "or_with_combo"() {
    let b = ecs_qf_bundle_new();
    b = ecs_qf_bundle_with(b, 1);
    b = ecs_qf_bundle_or(b, 2, 3);
    let comps = ecs_qf_comps_new();
    comps = ecs_qf_comps_push(comps, 1);
    comps = ecs_qf_comps_push(comps, 9);
    let empty = ecs_qf_comps_new();
    // has with, but or fails
    if ecs_qf_bundle_matches(b, comps, empty, empty, false) != false { panic(117090); };
    comps = ecs_qf_comps_push(comps, 2);
    if ecs_qf_bundle_matches(b, comps, empty, empty, false) != true { panic(117091); };
}
