@import "lib/thin_array_ptr_deep.sla"

// Batch 204: ThinArrayPtr deep (src/storage/thin_array_ptr.rs).

@test "empty_defaults"() {
    let a = ecs_tap_empty();
    if ecs_tap_capacity(a) != 0 { panic(106800); };
    if ecs_tap_len(a) != 0 { panic(106801); };
    if ecs_tap_is_empty(a) != true { panic(106802); };
    if ecs_tap_alive(a) != true { panic(106803); };
    if ecs_tap_alloc_count(a) != 0 { panic(106804); };
}

@test "with_capacity_zero_no_alloc"() {
    let a = ecs_tap_with_capacity(0);
    if ecs_tap_capacity(a) != 0 { panic(106810); };
    if ecs_tap_alloc_count(a) != 0 { panic(106811); };
}

@test "with_capacity_allocates"() {
    let a = ecs_tap_with_capacity(4);
    if ecs_tap_capacity(a) != 4 { panic(106820); };
    if ecs_tap_alloc_count(a) != 1 { panic(106821); };
    if ecs_tap_last_error(a) != ECS_TAP_OK { panic(106822); };
}

@test "alloc_overflow_cap"() {
    let a = ecs_tap_empty();
    a = ecs_tap_alloc(a, 100);
    if ecs_tap_last_error(a) != ECS_TAP_ERR_OVERFLOW { panic(106830); };
    if ecs_tap_capacity(a) != 0 { panic(106831); };
}

@test "initialize_and_get"() {
    let a = ecs_tap_with_capacity(4);
    a = ecs_tap_push(a, 10);
    a = ecs_tap_push(a, 20);
    a = ecs_tap_push(a, 30);
    if ecs_tap_len(a) != 3 { panic(106840); };
    let g = ecs_tap_get_unchecked(a, 1);
    if g.0 != true { panic(106841); };
    if g.1 != 20 { panic(106842); };
    let miss = ecs_tap_get_unchecked(a, 3);
    if miss.0 != false { panic(106843); };
}

@test "get_unchecked_mut_set"() {
    let a = ecs_tap_with_capacity(2);
    a = ecs_tap_push(a, 1);
    a = ecs_tap_push(a, 2);
    let r = ecs_tap_get_unchecked_mut_set(a, 0, 99);
    a = r.0;
    if r.1 != true { panic(106850); };
    if r.2 != 1 { panic(106851); };
    let g = ecs_tap_get_unchecked(a, 0);
    if g.1 != 99 { panic(106852); };
}

@test "initialize_oob_errors"() {
    let a = ecs_tap_with_capacity(2);
    a = ecs_tap_initialize_unchecked(a, 5, 1);
    if ecs_tap_last_error(a) != ECS_TAP_ERR_OOB { panic(106860); };
}

@test "swap_remove_last_middle"() {
    let a = ecs_tap_with_capacity(4);
    a = ecs_tap_push(a, 1);
    a = ecs_tap_push(a, 2);
    a = ecs_tap_push(a, 3);
    // remove index 0, keep last (2)
    let r = ecs_tap_swap_remove_last(a, 0);
    a = r.0;
    if r.1 != 1 { panic(106870); };
    if ecs_tap_len(a) != 2 { panic(106871); };
    // slot0 should now be former last (3)
    let g0 = ecs_tap_get_unchecked(a, 0);
    if g0.1 != 3 { panic(106872); };
    let g1 = ecs_tap_get_unchecked(a, 1);
    if g1.1 != 2 { panic(106873); };
}

@test "swap_remove_same_index_is_pop"() {
    let a = ecs_tap_with_capacity(3);
    a = ecs_tap_push(a, 7);
    a = ecs_tap_push(a, 8);
    let r = ecs_tap_swap_remove_unchecked(a, 1, 1);
    a = r.0;
    if r.1 != 8 { panic(106880); };
    if ecs_tap_len(a) != 1 { panic(106881); };
    if ecs_tap_last_error(a) != ECS_TAP_OK { panic(106882); };
}

@test "swap_remove_nonoverlapping_rejects_same"() {
    let a = ecs_tap_with_capacity(2);
    a = ecs_tap_push(a, 1);
    a = ecs_tap_push(a, 2);
    let r = ecs_tap_swap_remove_nonoverlapping(a, 0, 0);
    if ecs_tap_last_error(r.0) != ECS_TAP_ERR_SAME_INDEX { panic(106890); };
}

@test "realloc_grows_and_preserves"() {
    let a = ecs_tap_with_capacity(2);
    a = ecs_tap_push(a, 4);
    a = ecs_tap_push(a, 5);
    a = ecs_tap_realloc(a, 2, 4);
    if ecs_tap_capacity(a) != 4 { panic(106900); };
    if ecs_tap_realloc_count(a) != 1 { panic(106901); };
    if ecs_tap_len(a) != 2 { panic(106902); };
    let g = ecs_tap_get_unchecked(a, 1);
    if g.1 != 5 { panic(106903); };
}

@test "realloc_cap_mismatch"() {
    let a = ecs_tap_with_capacity(2);
    a = ecs_tap_realloc(a, 3, 4);
    if ecs_tap_last_error(a) != ECS_TAP_ERR_CAP_MISMATCH { panic(106910); };
}

@test "clear_elements_drops_and_keeps_capacity"() {
    let a = ecs_tap_with_capacity(4);
    a = ecs_tap_push(a, 1);
    a = ecs_tap_push(a, 2);
    a = ecs_tap_push(a, 3);
    a = ecs_tap_clear_elements(a);
    if ecs_tap_len(a) != 0 { panic(106920); };
    if ecs_tap_capacity(a) != 4 { panic(106921); };
    if ecs_tap_drop_elem_count(a) != 3 { panic(106922); };
}

@test "clear_without_needs_drop_skips_drop_count"() {
    let a = ecs_tap_with_capacity(2);
    a = ecs_tap_set_needs_drop(a, false);
    a = ecs_tap_push(a, 9);
    a = ecs_tap_push(a, 8);
    a = ecs_tap_clear_elements(a);
    if ecs_tap_drop_elem_count(a) != 0 { panic(106930); };
    if ecs_tap_len(a) != 0 { panic(106931); };
}

@test "drop_deallocates"() {
    let a = ecs_tap_with_capacity(3);
    a = ecs_tap_push(a, 1);
    a = ecs_tap_push(a, 2);
    a = ecs_tap_drop(a, 3, 2);
    if ecs_tap_alive(a) != false { panic(106940); };
    if ecs_tap_capacity(a) != 0 { panic(106941); };
    if ecs_tap_len(a) != 0 { panic(106942); };
    if ecs_tap_dealloc_count(a) != 1 { panic(106943); };
    if ecs_tap_drop_elem_count(a) != 2 { panic(106944); };
}

@test "drop_zero_capacity_no_dealloc"() {
    let a = ecs_tap_empty();
    a = ecs_tap_drop(a, 0, 0);
    if ecs_tap_dealloc_count(a) != 0 { panic(106950); };
    if ecs_tap_alive(a) != false { panic(106951); };
}

@test "as_slice_copies_prefix"() {
    let a = ecs_tap_with_capacity(4);
    a = ecs_tap_push(a, 10);
    a = ecs_tap_push(a, 20);
    a = ecs_tap_push(a, 30);
    let s = ecs_tap_as_slice(a, 2);
    if ecs_tap_slice_len(s) != 2 { panic(106960); };
    if ecs_tap_slice_get(s, 0) != 10 { panic(106961); };
    if ecs_tap_slice_get(s, 1) != 20 { panic(106962); };
    let s2 = ecs_tap_as_slice(a, 10);
    if ecs_tap_slice_len(s2) != 3 { panic(106963); };
}

@test "push_until_capacity"() {
    let a = ecs_tap_with_capacity(3);
    a = ecs_tap_push(a, 1);
    a = ecs_tap_push(a, 2);
    a = ecs_tap_push(a, 3);
    if ecs_tap_len(a) != 3 { panic(106970); };
    a = ecs_tap_push(a, 4);
    if ecs_tap_last_error(a) != ECS_TAP_ERR_OOB { panic(106971); };
    if ecs_tap_len(a) != 3 { panic(106972); };
}
