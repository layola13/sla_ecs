@import "lib/system_registry_template.sla"

// Isolated tests for lib/system_registry_template.sla — SystemHandleTemplate + Cache + Tracked
// Bevy reference: bevy_ecs/src/system/system_registry.rs

@test "sys_hov_handle"() {
    let h = ecs_sys_hov_handle(42);
    if ecs_sys_hov_is_handle(h) != true { panic(90136); };
    if ecs_sys_hov_is_value(h) != false { panic(90137); };
    if ecs_sys_hov_handle_entity(h) != 42 { panic(90138); };
    if ecs_sys_hov_has_value(h) != false { panic(90139); };
}

@test "sys_hov_value"() {
    let v = ecs_sys_hov_value(7);
    if ecs_sys_hov_is_value(v) != true { panic(90140); };
    if ecs_sys_hov_is_handle(v) != false { panic(90141); };
    if ecs_sys_hov_system_id(v) != 7 { panic(90142); };
    if ecs_sys_hov_has_value(v) != true { panic(90143); };
}

@test "system_handle_value_refcount"() {
    let v = ecs_system_handle_value_new(11);
    if ecs_system_handle_value_ref_count(v) != 1 { panic(90144); };
    if ecs_system_handle_value_has_value(v) != true { panic(90145); };
    let v2 = ecs_system_handle_value_clone(v);
    if ecs_system_handle_value_ref_count(v2) != 2 { panic(90146); };
    let v3 = ecs_system_handle_value_drop_clone(v2);
    if ecs_system_handle_value_ref_count(v3) != 1 { panic(90147); };
}

@test "system_handle_value_build"() {
    let v = ecs_system_handle_value_new(99);
    if ecs_system_handle_value_inner_kind(v) != 1 { panic(90148); };
    let v2 = ecs_system_handle_value_build(v, 55);
    if ecs_system_handle_value_inner_kind(v2) != 0 { panic(90149); };
    if ecs_system_handle_value_handle(v2) != 55 { panic(90150); };
    if ecs_system_handle_value_has_value(v2) != false { panic(90151); };
    // Building twice is idempotent
    let v3 = ecs_system_handle_value_build(v2, 99);
    if ecs_system_handle_value_handle(v3) != 55 { panic(90152); };
}

@test "template_handle_weak"() {
    let t = ecs_system_template_handle_weak(33);
    if ecs_system_template_is_handle(t) != true { panic(90153); };
    if ecs_system_template_is_value(t) != false { panic(90154); };
    if ecs_system_template_handle(t) != 33 { panic(90155); };
}

@test "template_value"() {
    let t = ecs_system_template_value(10);
    if ecs_system_template_is_value(t) != true { panic(90156); };
    let cnt = ecs_system_template_value_ref_count(t);
    if cnt != 1 { panic(90157); };
}

@test "template_default"() {
    let t = ecs_system_template_default();
    if ecs_system_template_is_handle(t) != true { panic(90158); };
    if ecs_system_template_handle(t) != -1 { panic(90159); };
}

@test "template_clone_handle"() {
    let t = ecs_system_template_handle_weak(7);
    let t2 = ecs_template_clone_template(t);
    if ecs_system_template_handle(t2) != 7 { panic(90160); };
    if ecs_system_template_is_handle(t2) != true { panic(90161); };
}

@test "template_clone_value"() {
    let t = ecs_system_template_value(5);
    let t2 = ecs_template_clone_template(t);
    if ecs_system_template_is_value(t2) != true { panic(90162); };
    if ecs_system_template_value_ref_count(t2) != 2 { panic(90163); };
}

@test "template_from_id"() {
    let t = ecs_system_template_from_id(123);
    if ecs_system_template_is_handle(t) != true { panic(90164); };
}

@test "template_build_handle_var"() {
    let t = ecs_system_template_handle_weak(88);
    let r = ecs_system_template_build(t, 99);
    if r.1 != 88 { panic(90165); };
    // build on a Handle variant doesn't change the hold
    if ecs_system_template_handle(r.0) != 88 { panic(90166); };
}

@test "template_build_value_var"() {
    let t = ecs_system_template_value(0);
    let r = ecs_system_template_build(t, 777);
    if r.1 != 777 { panic(90167); };
    if ecs_system_template_is_handle(r.0) != true { panic(90168); };
    if ecs_system_template_handle(r.0) != 777 { panic(90169); };
}

@test "system_value_new_fn"() {
    let t = ecs_system_value_new(42);
    if ecs_system_template_is_value(t) != true { panic(90170); };
}

@test "cached_system_id"() {
    let c = ecs_cached_system_id_new(55, 7);
    if ecs_cached_system_id_entity(c) != 55 { panic(90171); };
    if ecs_cached_system_id_type_id(c) != 7 { panic(90172); };
}

@test "cached_registry_register"() {
    let reg = ecs_cached_system_registry_new();
    if ecs_cached_registry_count(reg) != 0 { panic(90173); };
    let r = ecs_cached_registry_register(reg, 1, 100);
    let reg2 = r.0;
    if r.1 != 100 { panic(90174); };
    if ecs_cached_registry_count(reg2) != 1 { panic(90175); };
    if ecs_cached_registry_contains(reg2, 1) != true { panic(90176); };
    if ecs_cached_registry_find(reg2, 1) != 100 { panic(90177); };
}

@test "cached_registry_register_idempotent"() {
    let reg = ecs_cached_system_registry_new();
    let r1 = ecs_cached_registry_register(reg, 2, 200);
    let r2 = ecs_cached_registry_register(r1.0, 2, 999);
    // second call returns existing handle, no new entry
    if r2.1 != 200 { panic(90178); };
    if ecs_cached_registry_count(r2.0) != 1 { panic(90179); };
}

@test "cached_registry_unregister"() {
    let reg = ecs_cached_system_registry_new();
    let r = ecs_cached_registry_register(reg, 3, 300);
    let rr = ecs_cached_registry_unregister(r.0, 3);
    if rr.1 != true { panic(90180); };
    if ecs_cached_registry_count(rr.0) != 0 { panic(90181); };
    if ecs_cached_registry_contains(rr.0, 3) != false { panic(90182); };
    // unregister missing
    let rr2 = ecs_cached_registry_unregister(rr.0, 999);
    if rr2.1 != false { panic(90183); };
}

@test "cached_registry_multiple"() {
    let reg = ecs_cached_system_registry_new();
    let r1 = ecs_cached_registry_register(reg, 1, 11);
    let r2 = ecs_cached_registry_register(r1.0, 2, 22);
    let r3 = ecs_cached_registry_register(r2.0, 3, 33);
    if ecs_cached_registry_count(r3.0) != 3 { panic(90184); };
    if ecs_cached_registry_find(r3.0, 2) != 22 { panic(90185); };
    // unregister middle
    let rr = ecs_cached_registry_unregister(r3.0, 2);
    if rr.1 != true { panic(90186); };
    if ecs_cached_registry_count(rr.0) != 2 { panic(90187); };
    if ecs_cached_registry_find(rr.0, 1) != 11 { panic(90188); };
    if ecs_cached_registry_find(rr.0, 3) != 33 { panic(90189); };
}

@test "cached_registry_run"() {
    let reg = ecs_cached_system_registry_new();
    let r = ecs_cached_registry_register(reg, 5, 500);
    let e = ecs_cached_registry_run(r.0, 5);
    if e != 500 { panic(90190); };
    let missing = ecs_cached_registry_run(r.0, 99);
    if missing != -1 { panic(90191); };
}

@test "cached_registry_run_with"() {
    let reg = ecs_cached_system_registry_new();
    let r = ecs_cached_registry_register(reg, 8, 800);
    let rw = ecs_cached_registry_run_with(r.0, 8, 42);
    if rw.0 != 800 { panic(90192); };
    if rw.1 != 42 { panic(90193); };
    let miss = ecs_cached_registry_run_with(r.0, 999, 1);
    if miss.0 != -1 { panic(90194); };
}

@test "tracked_system_new"() {
    let t = ecs_tracked_system_new(101, 202);
    let id = ecs_tracked_system_id(t);
    if ecs_system_id_entity(id) != 101 { panic(90195); };
    let d = ecs_tracked_system_despawner(t);
    if ecs_registered_system_despawner_entity(d) != 202 { panic(90196); };
    if ecs_tracked_system_entity(t) != 101 { panic(90197); };
    if ecs_tracked_system_despawner_entity(t) != 202 { panic(90198); };
}

@test "tracked_boxed_new"() {
    let t = ecs_tracked_boxed_new(303, 404);
    if ecs_tracked_system_entity(t) != 303 { panic(90199); };
    if ecs_tracked_system_despawner_entity(t) != 404 { panic(90200); };
}

@test "stripped_handle_strong_weak"() {
    let hs = ecs_stripped_handle_strong(15);
    let hw = ecs_stripped_handle_weak(25);
    if ecs_stripped_handle_is_strong(hs) != true { panic(90201); };
    if ecs_stripped_handle_is_weak(hs) != false { panic(90202); };
    if ecs_stripped_handle_is_weak(hw) != true { panic(90203); };
    if ecs_stripped_handle_entity(hs) != 15 { panic(90204); };
}

@test "template_context_allocate"() {
    let c = ecs_template_context_new(1000);
    if c.next_entity != 1000 { panic(90205); };
    let a = ecs_template_context_allocate_entity(c);
    if a.1 != 1000 { panic(90206); };
    let b = ecs_template_context_allocate_entity(a.0);
    if b.1 != 1001 { panic(90207); };
    let next = ecs_template_context_next(b.0);
    if next != 1002 { panic(90208); };
}
