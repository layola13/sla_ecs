@import "lib/message_mut_iterators_deep.sla"

// Batch 270: message_mut_iterators deep (src/message/mut_iterators.rs).
// panic codes: 120000 – 120199.

@test "write_and_mut_iter_reads_all"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 10);
    m = ecs_mmi_messages_write(m, 20);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    if ecs_mmi_iter_len(it) != 2 { panic(120000); };
    if ecs_mmi_iter_is_mut(it) != true { panic(120001); };
    let n0 = ecs_mmi_iter_next(it);
    it = ecs_mmi_next_iter(n0);
    if ecs_mmi_next_has(n0) != true { panic(120002); };
    if ecs_mmi_next_value(n0) != 10 { panic(120003); };
    if ecs_mmi_next_id(n0) != 0 { panic(120004); };
    let n1 = ecs_mmi_iter_next(it);
    if ecs_mmi_next_value(n1) != 20 { panic(120005); };
}

@test "mut_apply_updates_message"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 5);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    let n0 = ecs_mmi_iter_next(it);
    m = ecs_mmi_apply_mut(m, ecs_mmi_next_id(n0), 99);
    // re-read with new cursor
    let c2 = ecs_mmi_cursor_new();
    let nr2 = ecs_mmi_mut_iter_with_id_new(c2, m);
    let it2 = ecs_mmi_new_iter(nr2);
    let n2 = ecs_mmi_iter_next(it2);
    if ecs_mmi_next_value(n2) != 99 { panic(120010); };
}

@test "without_id_flag"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 1);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_without_id(ecs_mmi_new_iter(nr));
    if ecs_mmi_iter_without_id_flag(it) != true { panic(120020); };
    if ecs_mmi_iter_len(it) != 1 { panic(120021); };
}

@test "count_consumes_unread"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 1);
    m = ecs_mmi_messages_write(m, 2);
    m = ecs_mmi_messages_write(m, 3);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    let cr = ecs_mmi_iter_count(it);
    if ecs_mmi_count_n(cr) != 3 { panic(120030); };
    if ecs_mmi_iter_len(ecs_mmi_count_iter(cr)) != 0 { panic(120031); };
    let c2 = ecs_mmi_cursor_from_iter(ecs_mmi_count_iter(cr));
    if ecs_mmi_cursor_last(c2) != 3 { panic(120032); };
}

@test "last_returns_final"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 4);
    m = ecs_mmi_messages_write(m, 5);
    m = ecs_mmi_messages_write(m, 6);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    let lr = ecs_mmi_iter_last(it);
    if ecs_mmi_next_has(lr) != true { panic(120040); };
    if ecs_mmi_next_value(lr) != 6 { panic(120041); };
    if ecs_mmi_iter_len(ecs_mmi_next_iter(lr)) != 0 { panic(120042); };
}

@test "nth_skips"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 10);
    m = ecs_mmi_messages_write(m, 20);
    m = ecs_mmi_messages_write(m, 30);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    let n = ecs_mmi_iter_nth(it, 1);
    if ecs_mmi_next_has(n) != true { panic(120050); };
    if ecs_mmi_next_value(n) != 20 { panic(120051); };
    if ecs_mmi_next_id(n) != 1 { panic(120052); };
}

@test "nth_past_end_exhausts"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 1);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    let n = ecs_mmi_iter_nth(it, 5);
    if ecs_mmi_next_has(n) != false { panic(120060); };
    if ecs_mmi_iter_len(ecs_mmi_next_iter(n)) != 0 { panic(120061); };
}

@test "update_then_iter_chain_a_then_b"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 7);
    m = ecs_mmi_messages_update(m);
    m = ecs_mmi_messages_write(m, 8);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    if ecs_mmi_iter_len(it) != 2 { panic(120070); };
    let n0 = ecs_mmi_iter_next(it);
    it = ecs_mmi_next_iter(n0);
    if ecs_mmi_next_value(n0) != 7 { panic(120071); };
    let n1 = ecs_mmi_iter_next(it);
    if ecs_mmi_next_value(n1) != 8 { panic(120072); };
}

@test "par_batching_and_sum"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 1);
    m = ecs_mmi_messages_write(m, 2);
    m = ecs_mmi_messages_write(m, 3);
    m = ecs_mmi_messages_write(m, 4);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    let it = ecs_mmi_new_iter(nr);
    let p = ecs_mmi_par_from_iter(it);
    p = ecs_mmi_par_batching_strategy(p, 2);
    if ecs_mmi_par_batch_size(p) != 2 { panic(120080); };
    if ecs_mmi_par_batch_count(p) != 2 { panic(120081); };
    if ecs_mmi_par_for_each_sum(it) != 10 { panic(120082); };
}

@test "cursor_advances_only_unread"() {
    let m = ecs_mmi_messages_new();
    m = ecs_mmi_messages_write(m, 1);
    m = ecs_mmi_messages_write(m, 2);
    let c = ecs_mmi_cursor_new();
    let nr = ecs_mmi_mut_iter_with_id_new(c, m);
    c = ecs_mmi_new_cursor(nr);
    // after construction last = message_count - unread = 0
    if ecs_mmi_cursor_last(c) != 0 { panic(120090); };
    let it = ecs_mmi_new_iter(nr);
    let n0 = ecs_mmi_iter_next(it);
    it = ecs_mmi_next_iter(n0);
    c = ecs_mmi_cursor_from_iter(it);
    if ecs_mmi_cursor_last(c) != 1 { panic(120091); };
}
