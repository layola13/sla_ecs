@import "lib/schedules_deep.sla"

// Batch 180 tests for deepened Schedules collection surface.

@test "schedules_deep_new_empty"() {
    let s = ecs_schedules_deep_new();
    if ecs_schedules_deep_is_empty(s) != true { panic(100400); };
    if ecs_schedules_deep_len(s) != 0 { panic(100401); };
    if ecs_schedules_deep_temporarily_removed_count(s) != 0 { panic(100402); };
    if ecs_schedules_deep_empty_labels_count(s) != 0 { panic(100403); };
}

@test "insert_new_and_replace"() {
    let s = ecs_schedules_deep_new();
    let r = ecs_schedules_deep_insert(s, 1, 100);
    s = r.0;
    if r.1 != false { panic(100410); };
    if r.2 != -1 { panic(100411); };
    if ecs_schedules_deep_contains(s, 1) != true { panic(100412); };
    let r2 = ecs_schedules_deep_insert(s, 1, 200);
    s = r2.0;
    if r2.1 != true { panic(100413); };
    if r2.2 != 100 { panic(100414); };
    let g = ecs_schedules_deep_get(s, 1);
    if g.0 != true { panic(100415); };
    if ecs_sched_deep_entry_id(g.1) != 200 { panic(100416); };
}

@test "insert_clears_temporarily_removed"() {
    let s = ecs_schedules_deep_new();
    let r = ecs_schedules_deep_insert(s, 5, 50);
    s = r.0;
    let rt = ecs_schedules_deep_remove_temporarily(s, 5);
    s = rt.0;
    if ecs_schedules_deep_is_temporarily_removed(s, 5) != true { panic(100420); };
    let ri = ecs_schedules_deep_insert(s, 5, 51);
    s = ri.0;
    if ecs_schedules_deep_is_temporarily_removed(s, 5) != false { panic(100421); };
    if ecs_schedules_deep_contains(s, 5) != true { panic(100422); };
}

@test "reinsert_reports_was_temporarily_removed"() {
    let s = ecs_schedules_deep_new();
    let r = ecs_schedules_deep_insert(s, 3, 30);
    s = r.0;
    let rt = ecs_schedules_deep_remove_temporarily(s, 3);
    s = rt.0;
    let rr = ecs_schedules_deep_reinsert(s, 3, 31);
    s = rr.0;
    if rr.1 != true { panic(100430); };
    // not temporarily removed on second reinsert of present entry
    let rr2 = ecs_schedules_deep_reinsert(s, 3, 32);
    if rr2.1 != false { panic(100431); };
    if rr2.2 != true { panic(100432); };
}

@test "remove_permanent_does_not_track_temp_or_empty"() {
    let s = ecs_schedules_deep_new();
    let r = ecs_schedules_deep_insert(s, 2, 20);
    s = r.0;
    let rm = ecs_schedules_deep_remove(s, 2);
    s = rm.0;
    if rm.1 != true { panic(100440); };
    if rm.2 != 20 { panic(100441); };
    if ecs_schedules_deep_is_temporarily_removed(s, 2) != false { panic(100442); };
    if ecs_schedules_deep_is_empty_label(s, 2) != false { panic(100443); };
    if ecs_schedules_deep_contains(s, 2) != false { panic(100444); };
}

@test "remove_temporarily_present_tracks_temp_and_clears_empty"() {
    let s = ecs_schedules_deep_new();
    // pre-mark empty then insert so we can verify empty_labels removal
    s = ecs_schedules_deep_new();
    let miss = ecs_schedules_deep_remove_temporarily(s, 9);
    s = miss.0;
    if ecs_schedules_deep_is_empty_label(s, 9) != true { panic(100450); };
    let ins = ecs_schedules_deep_insert(s, 9, 90);
    s = ins.0;
    // empty_labels not auto-cleared by insert in Bevy; only remove_temporarily success path clears it.
    // Seed empty again after insert to verify success path removes it.
    s.empty_labels = ecs_vec_push_unique_i64(s.empty_labels, 9);
    let rt = ecs_schedules_deep_remove_temporarily(s, 9);
    s = rt.0;
    if rt.1 != true { panic(100451); };
    if rt.2 != 90 { panic(100452); };
    if ecs_schedules_deep_is_temporarily_removed(s, 9) != true { panic(100453); };
    if ecs_schedules_deep_is_empty_label(s, 9) != false { panic(100454); };
    if ecs_schedules_deep_contains(s, 9) != false { panic(100455); };
}

@test "remove_temporarily_missing_marks_empty_label"() {
    let s = ecs_schedules_deep_new();
    let rt = ecs_schedules_deep_remove_temporarily(s, 77);
    s = rt.0;
    if rt.1 != false { panic(100460); };
    if ecs_schedules_deep_is_empty_label(s, 77) != true { panic(100461); };
    if ecs_schedules_deep_is_temporarily_removed(s, 77) != false { panic(100462); };
    // second missing call keeps empty (unique)
    let rt2 = ecs_schedules_deep_remove_temporarily(s, 77);
    s = rt2.0;
    if ecs_schedules_deep_empty_labels_count(s) != 1 { panic(100463); };
}

@test "remove_entry_returns_label_and_id"() {
    let s = ecs_schedules_deep_new();
    let r = ecs_schedules_deep_insert(s, 4, 40);
    s = r.0;
    let re = ecs_schedules_deep_remove_entry(s, 4);
    s = re.0;
    if re.1 != true { panic(100470); };
    if re.2 != 4 { panic(100471); };
    if re.3 != 40 { panic(100472); };
    let re2 = ecs_schedules_deep_remove_entry(s, 4);
    if re2.1 != false { panic(100473); };
}

@test "entry_creates_or_returns_existing"() {
    let s = ecs_schedules_deep_new();
    let e1 = ecs_schedules_deep_entry(s, 11);
    s = e1.0;
    if ecs_schedules_deep_len(s) != 1 { panic(100480); };
    let e2 = ecs_schedules_deep_entry(s, 11);
    s = e2.0;
    if e1.1 != e2.1 { panic(100481); };
    if ecs_schedules_deep_len(s) != 1 { panic(100482); };
    let g = ecs_schedules_deep_get(s, 11);
    if g.0 != true { panic(100483); };
    if ecs_sched_deep_entry_id(g.1) != 1 { panic(100484); };
}

@test "configure_schedules_applies_to_all_present"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_insert(s, 1, 10).0;
    s = ecs_schedules_deep_insert(s, 2, 20).0;
    s = ecs_schedules_deep_configure_schedules(s, 99);
    let g1 = ecs_schedules_deep_get(s, 1);
    let g2 = ecs_schedules_deep_get(s, 2);
    if ecs_sched_deep_entry_build_settings_tag(g1.1) != 99 { panic(100490); };
    if ecs_sched_deep_entry_build_settings_tag(g2.1) != 99 { panic(100491); };
    // future inserts not affected until configure again
    s = ecs_schedules_deep_insert(s, 3, 30).0;
    let g3 = ecs_schedules_deep_get(s, 3);
    if ecs_sched_deep_entry_build_settings_tag(g3.1) != 0 { panic(100492); };
}

@test "allow_ambiguous_component_and_resource"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_allow_ambiguous_component(s, 100);
    s = ecs_schedules_deep_allow_ambiguous_resource(s, 200);
    s = ecs_schedules_deep_allow_ambiguous_component(s, 100);
    if ecs_schedules_deep_ignored_ambiguities_count(s) != 2 { panic(100500); };
    if ecs_schedules_deep_contains_ignored_ambiguity(s, 100) != true { panic(100501); };
    if ecs_schedules_deep_contains_ignored_ambiguity(s, 200) != true { panic(100502); };
    if ecs_schedules_deep_print_ignored_ambiguities_count(s) != 2 { panic(100503); };
}

@test "add_systems_via_entry"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_add_systems(s, 1, 10);
    s = ecs_schedules_deep_add_systems(s, 1, 11);
    // creates schedule if missing
    if ecs_schedules_deep_contains(s, 1) != true { panic(100510); };
    let g = ecs_schedules_deep_get(s, 1);
    if ecs_sched_deep_entry_system_count(g.1) != 2 { panic(100511); };
}

@test "configure_sets_via_entry"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_configure_sets(s, 2, 50);
    s = ecs_schedules_deep_configure_sets(s, 2, 51);
    let g = ecs_schedules_deep_get(s, 2);
    if ecs_sched_deep_entry_set_count(g.1) != 2 { panic(100520); };
}

@test "ignore_ambiguity_via_entry"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_ignore_ambiguity(s, 3, 1, 2);
    s = ecs_schedules_deep_ignore_ambiguity(s, 3, 3, 4);
    let g = ecs_schedules_deep_get(s, 3);
    if ecs_sched_deep_entry_ignore_pair_count(g.1) != 2 { panic(100530); };
}

@test "remove_systems_in_set_not_found"() {
    let s = ecs_schedules_deep_new();
    let r = ecs_schedules_deep_remove_systems_in_set(s, 99, 1);
    if r.0 != false { panic(100540); };
    if r.1 != 0 { panic(100541); };
    if ecs_schedule_error_not_found() != 1 { panic(100542); };
}

@test "remove_systems_in_set_filters_matching_ids"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_add_systems(s, 1, 7);
    s = ecs_schedules_deep_add_systems(s, 1, 8);
    s = ecs_schedules_deep_add_systems(s, 1, 7);
    let r = ecs_schedules_deep_remove_systems_in_set(s, 1, 7);
    s = r.2;
    if r.0 != true { panic(100550); };
    if r.1 != 2 { panic(100551); };
    let g = ecs_schedules_deep_get(s, 1);
    if ecs_sched_deep_entry_system_count(g.1) != 1 { panic(100552); };
}

@test "check_change_ticks_increments_all"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_insert(s, 1, 10).0;
    s = ecs_schedules_deep_insert(s, 2, 20).0;
    s = ecs_schedules_deep_check_change_ticks(s);
    s = ecs_schedules_deep_check_change_ticks(s);
    let g1 = ecs_schedules_deep_get(s, 1);
    let g2 = ecs_schedules_deep_get(s, 2);
    if ecs_sched_deep_entry_change_tick_checks(g1.1) != 2 { panic(100560); };
    if ecs_sched_deep_entry_change_tick_checks(g2.1) != 2 { panic(100561); };
}

@test "iter_labels_preserves_insertion_order"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_insert(s, 3, 30).0;
    s = ecs_schedules_deep_insert(s, 1, 10).0;
    s = ecs_schedules_deep_insert(s, 2, 20).0;
    let labels = ecs_schedules_deep_iter_labels(s);
    if len(labels) != 3 { panic(100570); };
    if labels[0] != 3 { panic(100571); };
    if labels[1] != 1 { panic(100572); };
    if labels[2] != 2 { panic(100573); };
}

@test "get_temporarily_removed_and_empty_labels_snapshots"() {
    let s = ecs_schedules_deep_new();
    s = ecs_schedules_deep_insert(s, 1, 10).0;
    s = ecs_schedules_deep_remove_temporarily(s, 1).0;
    s = ecs_schedules_deep_remove_temporarily(s, 2).0;
    let tr = ecs_schedules_deep_temporarily_removed(s);
    let el = ecs_schedules_deep_empty_labels(s);
    if len(tr) != 1 { panic(100580); };
    if tr[0] != 1 { panic(100581); };
    if len(el) != 1 { panic(100582); };
    if el[0] != 2 { panic(100583); };
}

@test "entry_at_and_get_missing"() {
    let s = ecs_schedules_deep_new();
    let miss = ecs_schedules_deep_get(s, 1);
    if miss.0 != false { panic(100590); };
    s = ecs_schedules_deep_insert(s, 1, 10).0;
    let at = ecs_schedules_deep_entry_at(s, 0);
    if at.0 != true { panic(100591); };
    if ecs_sched_deep_entry_label(at.1) != 1 { panic(100592); };
    let at2 = ecs_schedules_deep_entry_at(s, 5);
    if at2.0 != false { panic(100593); };
}
