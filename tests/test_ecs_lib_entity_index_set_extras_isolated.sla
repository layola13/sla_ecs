@import "lib/entity_index_set_extras.sla"

// Isolated tests for lib/entity_index_set_extras.sla.
// Bevy reference: bevy_ecs/src/entity/index_set.rs

fn make_eis4() -> EcsEntityIndexSetExtras {
    let set0 = ecs_eis_new();
    let result1 = ecs_eis_insert(set0, 10);
    let result2 = ecs_eis_insert(result1.set, 20);
    let result3 = ecs_eis_insert(result2.set, 30);
    let result4 = ecs_eis_insert(result3.set, 40);
    return result4.set;
}

fn make_eis_from_values() -> EcsEntityIndexSetExtras {
    let values: Vec<i64> = Vec::new();
    values.push(7);
    values.push(8);
    values.push(7);
    values.push(9);
    return ecs_eis_from_iter(values);
}

@test "entity index set extras from iter dedups in order"() {
    let set = make_eis_from_values();
    if ecs_eis_len(set) != 3 { panic(92628); };
    let slice = ecs_eis_as_slice(set);
    let first = ecs_eis_slice_at(slice, 0);
    let second = ecs_eis_slice_at(slice, 1);
    let third = ecs_eis_slice_at(slice, 2);
    if first.value != 7 { panic(92629); };
    if second.value != 8 { panic(92630); };
    if third.value != 9 { panic(92631); };
}

@test "entity index set extras into inner returns ordered values"() {
    let inner = ecs_eis_into_inner(make_eis4());
    if len(inner) != 4 { panic(92632); };
    if inner[2] != 30 { panic(92633); };
}

@test "entity index set extras as slice and index value"() {
    let slice = ecs_eis_as_slice(make_eis4());
    if ecs_eis_slice_len(slice) != 4 { panic(92634); };
    let value = ecs_eis_index_value(make_eis4(), 1);
    if value.has != 1 { panic(92635); };
    if value.value != 20 { panic(92636); };
}

@test "entity index set extras get range"() {
    let result = ecs_eis_get_range(make_eis4(), 1, 3);
    if result.has != 1 { panic(92637); };
    if ecs_eis_slice_len(result.slice) != 2 { panic(92638); };
    let first = ecs_eis_slice_at(result.slice, 0);
    if first.value != 20 { panic(92639); };
}

@test "entity index set extras invalid range none"() {
    let result = ecs_eis_get_range(make_eis4(), 3, 2);
    if result.has != 0 { panic(92640); };
}

@test "entity index set extras range variants"() {
    let slice = ecs_eis_as_slice(make_eis4());
    let from = ecs_eis_slice_range_from(slice, 2);
    let to = ecs_eis_slice_range_to(slice, 2);
    let inclusive = ecs_eis_slice_range_inclusive(slice, 1, 2);
    if ecs_eis_slice_len(from.slice) != 2 { panic(92641); };
    if ecs_eis_slice_len(to.slice) != 2 { panic(92642); };
    if ecs_eis_slice_len(inclusive.slice) != 2 { panic(92643); };
}

@test "entity index set extras index range"() {
    let result = ecs_eis_index_range(make_eis4(), 0, 2);
    if result.has != 1 { panic(92644); };
    let second = ecs_eis_slice_at(result.slice, 1);
    if second.value != 20 { panic(92645); };
}

@test "entity index set extras split at"() {
    let split = ecs_eis_slice_split_at(ecs_eis_as_slice(make_eis4()), 2);
    if ecs_eis_slice_len(split.left) != 2 { panic(92646); };
    if ecs_eis_slice_len(split.right) != 2 { panic(92647); };
    let first_right = ecs_eis_slice_at(split.right, 0);
    if first_right.value != 30 { panic(92648); };
}

@test "entity index set extras split first"() {
    let result = ecs_eis_slice_split_first(ecs_eis_as_slice(make_eis4()));
    if result.has != 1 { panic(92649); };
    if result.value != 10 { panic(92650); };
    if ecs_eis_slice_len(result.rest) != 3 { panic(92651); };
}

@test "entity index set extras split last"() {
    let result = ecs_eis_slice_split_last(ecs_eis_as_slice(make_eis4()));
    if result.has != 1 { panic(92652); };
    if result.value != 40 { panic(92653); };
    if ecs_eis_slice_len(result.rest) != 3 { panic(92654); };
}

@test "entity index set extras empty split first none"() {
    let result = ecs_eis_slice_split_first(ecs_eis_slice_new());
    if result.has != 0 { panic(92655); };
}

@test "entity index set extras boxed slice clone and inner"() {
    let boxed = ecs_eis_into_boxed_slice(make_eis4());
    if boxed.boxed != 1 { panic(92656); };
    let cloned = ecs_eis_boxed_clone(boxed);
    let inner = ecs_eis_boxed_into_inner(cloned);
    if inner.boxed != 0 { panic(92657); };
    if ecs_eis_slice_len(inner) != 4 { panic(92658); };
}

@test "entity index set extras boxed default empty"() {
    let boxed = ecs_eis_boxed_default();
    if boxed.boxed != 1 { panic(92659); };
    if ecs_eis_slice_len(boxed) != 0 { panic(92660); };
}

@test "entity index set extras slice equality order sensitive"() {
    let a = ecs_eis_as_slice(make_eis4());
    let b = ecs_eis_as_slice(make_eis4());
    if ecs_eis_slice_eq(a, b) != true { panic(92661); };
    let reversed_values: Vec<i64> = Vec::new();
    reversed_values.push(40);
    reversed_values.push(30);
    reversed_values.push(20);
    reversed_values.push(10);
    let reversed = ecs_eis_as_slice(ecs_eis_from_iter(reversed_values));
    if ecs_eis_slice_eq(a, reversed) != false { panic(92662); };
}

@test "entity index set extras slice comparison and hash"() {
    let a = ecs_eis_as_slice(make_eis4());
    let values: Vec<i64> = Vec::new();
    values.push(10);
    values.push(20);
    values.push(31);
    let b = ecs_eis_as_slice(ecs_eis_from_iter(values));
    if ecs_eis_slice_cmp(a, b) != -1 { panic(92663); };
    if ecs_eis_slice_hash(a) != ecs_eis_slice_hash(ecs_eis_as_slice(make_eis4())) { panic(92664); };
}

@test "entity index set extras set equality ignores order"() {
    let values: Vec<i64> = Vec::new();
    values.push(40);
    values.push(30);
    values.push(20);
    values.push(10);
    let reversed = ecs_eis_from_iter(values);
    if ecs_eis_eq(make_eis4(), reversed) != true { panic(92665); };
}

@test "entity index set extras set algebra"() {
    let values: Vec<i64> = Vec::new();
    values.push(30);
    values.push(50);
    values.push(10);
    let other = ecs_eis_from_iter(values);
    let intersection = ecs_eis_intersection(make_eis4(), other);
    let unioned = ecs_eis_union(make_eis4(), other);
    let diff = ecs_eis_difference(make_eis4(), other);
    let sym = ecs_eis_symmetric_difference(make_eis4(), other);
    if ecs_eis_len(intersection) != 2 { panic(92666); };
    if ecs_eis_len(unioned) != 5 { panic(92667); };
    if ecs_eis_len(diff) != 2 { panic(92668); };
    if ecs_eis_len(sym) != 3 { panic(92669); };
}

@test "entity index set extras iter next and back"() {
    let iter = ecs_eis_iter(make_eis4());
    let first = ecs_eis_iter_next(iter);
    let last = ecs_eis_iter_next_back(first.iter);
    if first.value != 10 { panic(92670); };
    if last.value != 40 { panic(92671); };
    if ecs_eis_iter_remaining(last.iter) != 2 { panic(92672); };
    if last.iter.trusted_unique != 1 { panic(92673); };
}

@test "entity index set extras iter as slice after next"() {
    let iter = ecs_eis_iter(make_eis4());
    let first = ecs_eis_iter_next(iter);
    let rest = ecs_eis_iter_as_slice(first.iter);
    if ecs_eis_slice_len(rest) != 3 { panic(92674); };
    let head = ecs_eis_slice_at(rest, 0);
    if head.value != 20 { panic(92675); };
}

@test "entity index set extras iter clone and default"() {
    let iter = ecs_eis_iter(make_eis4());
    let first = ecs_eis_iter_next(iter);
    let cloned = ecs_eis_iter_clone(first.iter);
    let cloned_next = ecs_eis_iter_next(cloned);
    if cloned_next.value != 20 { panic(92676); };
    if ecs_eis_iter_remaining(ecs_eis_iter_default()) != 0 { panic(92677); };
}

@test "entity index set extras into iter next and back"() {
    let iter = ecs_eis_into_iter(make_eis4());
    let first = ecs_eis_into_iter_next(iter);
    let last = ecs_eis_into_iter_next_back(first.iter);
    if first.value != 10 { panic(92678); };
    if last.value != 40 { panic(92679); };
}

@test "entity index set extras into iter as slice clone default"() {
    let iter = ecs_eis_into_iter(make_eis4());
    let first = ecs_eis_into_iter_next(iter);
    let cloned = ecs_eis_into_iter_clone(first.iter);
    let rest = ecs_eis_into_iter_as_slice(cloned);
    if ecs_eis_slice_len(rest) != 3 { panic(92680); };
    let empty = ecs_eis_into_iter_default();
    let missing = ecs_eis_into_iter_next(empty);
    if missing.has != 0 { panic(92681); };
}

@test "entity index set extras drain middle"() {
    let result = ecs_eis_drain(make_eis4(), 1, 3);
    if ecs_eis_len(result.set) != 2 { panic(92682); };
    let first = ecs_eis_drain_next(result.drain);
    let second = ecs_eis_drain_next(first.drain);
    if first.value != 20 { panic(92683); };
    if second.value != 30 { panic(92684); };
}

@test "entity index set extras drain as slice and back"() {
    let result = ecs_eis_drain(make_eis4(), 1, 4);
    let slice = ecs_eis_drain_as_slice(result.drain);
    if ecs_eis_slice_len(slice) != 3 { panic(92685); };
    let back = ecs_eis_drain_next_back(result.drain);
    if back.value != 40 { panic(92686); };
}

@test "entity index set extras drain clamps"() {
    let result = ecs_eis_drain(make_eis4(), -2, 99);
    if ecs_eis_len(result.set) != 0 { panic(92687); };
    let slice = ecs_eis_drain_as_slice(result.drain);
    if ecs_eis_slice_len(slice) != 4 { panic(92688); };
}

@test "entity index set extras missing index"() {
    let value = ecs_eis_slice_at(ecs_eis_as_slice(make_eis4()), 12);
    if value.has != 0 { panic(92689); };
}
