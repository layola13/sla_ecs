// Isolated deep tests for lib/resource_erased_deep.sla (Batch 354).
// panic codes: 136802 - 136999.

@import "lib/resource_erased_deep.sla"

const ECS_TIME_TYPE: i32 = 123101;
const ECS_SCORE_TYPE: i32 = 123102;

@test "ErasedResources new starts empty"() {
    let r = ecs_erased_resources_new();
    if ecs_erased_resources_count(r) != 0 { panic(136802); };
    if ecs_erased_resources_change_tick(r) != 1 { panic(136803); };
    if ecs_erased_resources_has(r, ECS_TIME_TYPE) != false { panic(136804); };
}

@test "ErasedResources insert stores by type and reads back"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_TIME_TYPE, 1);
    let r2 = ecs_erased_resources_insert(r1, ECS_SCORE_TYPE, 7);
    if ecs_erased_resources_count(r2) != 2 { panic(136810); };
    if ecs_erased_resources_has(r2, ECS_TIME_TYPE) != true { panic(136811); };
    if ecs_erased_resources_has(r2, ECS_SCORE_TYPE) != true { panic(136812); };
    if ecs_erased_resources_get_payload(r2, ECS_TIME_TYPE) != 1 { panic(136813); };
    if ecs_erased_resources_get_payload(r2, ECS_SCORE_TYPE) != 7 { panic(136814); };
}

@test "ErasedResources slot linear search returns index or -1"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_TIME_TYPE, 1);
    let r2 = ecs_erased_resources_insert(r1, ECS_SCORE_TYPE, 7);
    if ecs_erased_resources_slot(r2, ECS_TIME_TYPE) != 0 { panic(136820); };
    if ecs_erased_resources_slot(r2, ECS_SCORE_TYPE) != 1 { panic(136821); };
    if ecs_erased_resources_slot(r2, 999) != -1 { panic(136822); };
}

@test "ErasedResources replace tracks changed tick but not added tick"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_TIME_TYPE, 1);
    let before = ecs_erased_resources_change_tick(r1);
    // Bump change_tick.
    let r2 = ecs_erased_resources_increment_tick(r1);
    let r3 = ecs_erased_resources_insert(r2, ECS_TIME_TYPE, 3);
    // added_since(before) (added_tick > before) is false (the type was added before tick bump)
    if ecs_erased_resources_added_since(r3, ECS_TIME_TYPE, before) != false { panic(136830); };
    // changed_since(before) is true (changed_tick > before)
    if ecs_erased_resources_changed_since(r3, ECS_TIME_TYPE, before) != true { panic(136831); };
    if ecs_erased_resources_get_payload(r3, ECS_TIME_TYPE) != 3 { panic(136832); };
}

@test "ErasedResources res returns added/changed ticks"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_TIME_TYPE, 1);
    let res = ecs_erased_resources_res(r1, ECS_TIME_TYPE);
    if ecs_erased_res_value(res) != 1 { panic(136840); };
    if ecs_erased_res_added_tick(res) != 1 { panic(136841); };
    if ecs_erased_res_changed_tick(res) != 1 { panic(136842); };
}

@test "ErasedResources write updates value and changes tick"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_SCORE_TYPE, 7);
    let before = ecs_erased_resources_change_tick(r1);
    let r2 = ecs_erased_resources_increment_tick(r1);
    let r3 = ecs_erased_resources_write(r2, ECS_SCORE_TYPE, 8);
    if ecs_erased_resources_get_payload(r3, ECS_SCORE_TYPE) != 8 { panic(136850); };
    if ecs_erased_resources_changed_since(r3, ECS_SCORE_TYPE, before) != true { panic(136851); };
    // write to absent type is no-op
    let r4 = ecs_erased_resources_write(r3, 999, 99);
    if ecs_erased_resources_count(r4) != 1 { panic(136852); };
}

@test "ErasedResources res_mut_write composed write"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_SCORE_TYPE, 7);
    let r2 = ecs_erased_resources_increment_tick(r1);
    let r3 = ecs_erased_resources_res_mut_write(r2, ECS_SCORE_TYPE, 10);
    if ecs_erased_resources_get_payload(r3, ECS_SCORE_TYPE) != 10 { panic(136860); };
    let res = ecs_erased_resources_res_mut(r3, ECS_SCORE_TYPE);
    if ecs_erased_res_value(res) != 10 { panic(136861); };
}

@test "ErasedResources remove swap-removes last into slot"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_TIME_TYPE, 1);
    let r2 = ecs_erased_resources_insert(r1, ECS_SCORE_TYPE, 7);
    // Remove TIME — SCORE slot moved into slot 0.
    let r3 = ecs_erased_resources_remove(r2, ECS_TIME_TYPE);
    if ecs_erased_resources_count(r3) != 1 { panic(136870); };
    if ecs_erased_resources_has(r3, ECS_TIME_TYPE) != false { panic(136871); };
    if ecs_erased_resources_has(r3, ECS_SCORE_TYPE) != true { panic(136872); };
    if ecs_erased_resources_get_payload(r3, ECS_SCORE_TYPE) != 7 { panic(136873); };
    // Remove absent is no-op
    let r4 = ecs_erased_resources_remove(r3, 999);
    if ecs_erased_resources_count(r4) != 1 { panic(136874); };
}

@test "ErasedResources capacity-8 enqueue cap-reject"() {
    let r0 = ecs_erased_resources_new();
    let i: i32 = 0;
    let r = r0;
    while i < 8 {
        r = ecs_erased_resources_insert(r, 100 + i, i);
        i = i + 1;
    }
    if ecs_erased_resources_count(r) != 8 { panic(136880); };
    // Insert a 9th distinct type_id — rejected by cap.
    let r2 = ecs_erased_resources_insert(r, 200, 0);
    if ecs_erased_resources_count(r2) != 8 { panic(136881); };
}

@test "ErasedResources clear resets all and increments stay fresh"() {
    let r0 = ecs_erased_resources_new();
    let r1 = ecs_erased_resources_insert(r0, ECS_TIME_TYPE, 1);
    let r2 = ecs_erased_resources_insert(r1, ECS_SCORE_TYPE, 7);
    let r3 = ecs_erased_resources_clear(r2);
    if ecs_erased_resources_count(r3) != 0 { panic(136890); };
    if ecs_erased_resources_has(r3, ECS_TIME_TYPE) != false { panic(136891); };
    if ecs_erased_resources_has(r3, ECS_SCORE_TYPE) != false { panic(136892); };
    // change_tick resets to 1 (fresh-match shallow).
    if ecs_erased_resources_change_tick(r3) != 1 { panic(136893); };
    // Insertions after clear work.
    let r4 = ecs_erased_resources_insert(r3, ECS_TIME_TYPE, 5);
    if ecs_erased_resources_get_payload(r4, ECS_TIME_TYPE) != 5 { panic(136894); };
}
