@import "lib/entity_index_set_derived_extras_deep.sla"

// Batch 342: entity_index_set_derived_extras deep.
// panic codes: 134400 – 134599.

@test "constructors"() {
    let a = ecs_eisd_new();
    let b = ecs_eisd_default();
    let c = ecs_eisd_with_capacity(5);
    let d = ecs_eisd_with_capacity(-3);
    if ecs_eisd_kind(a) != 1 { panic(134400); };
    if ecs_eisd_kind(b) != 2 { panic(134401); };
    if ecs_eisd_kind(c) != 3 { panic(134402); };
    if ecs_eisd_capacity(c) != 5 { panic(134403); };
    if ecs_eisd_capacity(d) != 0 { panic(134404); };
}

@test "insert_contains"() {
    let s = ecs_eisd_new();
    let r = ecs_eisd_insert(s, 1);
    if ecs_eisd_ins_inserted(r) != true { panic(134410); };
    s = ecs_eisd_ins_set(r);
    let r2 = ecs_eisd_insert(s, 1);
    if ecs_eisd_ins_inserted(r2) != false { panic(134411); };
    if ecs_eisd_contains(s, 1) != true { panic(134412); };
}

@test "clone_and_from"() {
    let s = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 3));
    let c = ecs_eisd_clone(s);
    if ecs_eisd_kind(c) != 4 { panic(134420); };
    let f = ecs_eisd_from_index_set(s);
    if ecs_eisd_kind(f) != 6 { panic(134421); };
    if ecs_eisd_contains(f, 3) != true { panic(134422); };
}

@test "eq"() {
    let a = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 1)), 2));
    let b = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 2)), 1));
    if ecs_eisd_eq(a, b) != true { panic(134430); };
    let c = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 1));
    if ecs_eisd_eq(a, c) != false { panic(134431); };
}

@test "union_intersection"() {
    let a = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 1)), 2));
    let b = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 2)), 3));
    let u = ecs_eisd_union(a, b);
    if ecs_eisd_len(u) != 3 { panic(134440); };
    let i = ecs_eisd_intersection(a, b);
    if ecs_eisd_len(i) != 1 { panic(134441); };
    if ecs_eisd_contains(i, 2) != true { panic(134442); };
}

@test "iter_next"() {
    let s = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 4)), 5));
    let it = ecs_eisd_iter(s);
    if ecs_eisd_iter_remaining(it) != 2 { panic(134450); };
    if ecs_eisd_iter_debug(it) != 10 { panic(134451); };
    let n1 = ecs_eisd_iter_next(it);
    if ecs_eisd_next_value(n1) != 4 { panic(134452); };
    let n2 = ecs_eisd_iter_next(ecs_eisd_next_iter(n1));
    if ecs_eisd_next_value(n2) != 5 { panic(134453); };
}

@test "iter_next_back"() {
    let s = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 7)), 8));
    let it = ecs_eisd_iter(s);
    let nb = ecs_eisd_iter_next_back(it);
    if ecs_eisd_next_value(nb) != 8 { panic(134460); };
}

@test "capacity_eight"() {
    let s = ecs_eisd_new();
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 1));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 2));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 3));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 4));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 5));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 6));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 7));
    s = ecs_eisd_ins_set(ecs_eisd_insert(s, 8));
    if ecs_eisd_len(s) != 8 { panic(134470); };
    let r = ecs_eisd_insert(s, 9);
    if ecs_eisd_ins_inserted(r) != false { panic(134471); };
}

@test "at_access"() {
    let s = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 10)), 20));
    if ecs_eisd_at(s, 0) != 10 { panic(134480); };
    if ecs_eisd_at(s, 1) != 20 { panic(134481); };
}

@test "empty"() {
    let s = ecs_eisd_new();
    if ecs_eisd_is_empty(s) != true { panic(134490); };
}

@test "iter_end"() {
    let s = ecs_eisd_ins_set(ecs_eisd_insert(ecs_eisd_new(), 1));
    let n1 = ecs_eisd_iter_next(ecs_eisd_iter(s));
    let n2 = ecs_eisd_iter_next(ecs_eisd_next_iter(n1));
    if ecs_eisd_next_has(n2) != false { panic(134495); };
}
