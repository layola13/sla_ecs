@import "lib/executor_single_threaded.sla"

// Isolated tests for lib/executor_single_threaded.sla — SingleThreadedExecutor
// Bevy reference: bevy_ecs/src/schedule/executor/single_threaded.rs

@test "single_threaded_new"() {
    let e = ecs_single_threaded_executor_new();
    if ecs_single_threaded_executor_apply_final_deferred(e) != true { panic(82800); };
    if ecs_single_threaded_executor_systems_run(e) != 0 { panic(82801); };
    if ecs_single_threaded_executor_systems_skipped(e) != 0 { panic(82802); };
}

@test "single_threaded_init"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    if ecs_single_threaded_executor_system_count(e2) != 5 { panic(82803); };
    if ecs_single_threaded_executor_set_count(e2) != 3 { panic(82804); };
    if ecs_single_threaded_executor_completed_count(e2) != 0 { panic(82805); };
}

@test "single_threaded_set_apply_final_deferred"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_set_apply_final_deferred(e, false);
    if ecs_single_threaded_executor_apply_final_deferred(e2) != false { panic(82806); };
}

@test "single_threaded_mark_completed"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_mark_completed(e2, 2);
    if ecs_single_threaded_executor_is_completed(e3, 2) != true { panic(82807); };
    if ecs_single_threaded_executor_is_completed(e3, 0) != false { panic(82808); };
    if ecs_single_threaded_executor_completed_count(e3) != 1 { panic(82809); };
}

@test "single_threaded_mark_set_evaluated"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_mark_set_evaluated(e2, 1);
    if ecs_single_threaded_executor_is_set_evaluated(e3, 1) != true { panic(82810); };
    if ecs_single_threaded_executor_is_set_evaluated(e3, 0) != false { panic(82811); };
}

@test "single_threaded_run_system"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_run_system(e2, 0, false);
    if ecs_single_threaded_executor_systems_run(e3) != 1 { panic(82812); };
    if ecs_single_threaded_executor_is_completed(e3, 0) != true { panic(82813); };
    if ecs_single_threaded_executor_is_unapplied(e3, 0) != true { panic(82814); };
}

@test "single_threaded_run_apply_deferred_system_applies_prior_unapplied"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_run_system(e2, 0, false);
    let e4 = ecs_single_threaded_executor_run_system(e3, 1, false);
    if ecs_single_threaded_executor_unapplied_count(e4) != 2 { panic(82815); };
    let e5 = ecs_single_threaded_executor_run_system(e4, 2, true);
    if ecs_single_threaded_executor_systems_run(e5) != 3 { panic(82832); };
    if ecs_single_threaded_executor_is_completed(e5, 2) != true { panic(82833); };
    if ecs_single_threaded_executor_is_unapplied(e5, 0) { panic(82816); };
    if ecs_single_threaded_executor_is_unapplied(e5, 1) { panic(82834); };
    if ecs_single_threaded_executor_is_unapplied(e5, 2) { panic(82835); };
    if ecs_single_threaded_executor_deferred_applied(e5) != 2 { panic(82836); };
    if ecs_single_threaded_executor_unapplied_count(e5) != 0 { panic(82837); };
}

@test "single_threaded_skip_system"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_skip_system(e2, 0);
    if ecs_single_threaded_executor_systems_skipped(e3) != 1 { panic(82817); };
    if ecs_single_threaded_executor_systems_run(e3) != 0 { panic(82818); };
    if ecs_single_threaded_executor_is_completed(e3, 0) != true { panic(82819); };
    if ecs_single_threaded_executor_is_unapplied(e3, 0) { panic(82838); };
}

@test "single_threaded_apply_deferred"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_run_system(e2, 0, false);
    let e4 = ecs_single_threaded_executor_run_system(e3, 1, false);
    if ecs_single_threaded_executor_unapplied_count(e4) != 2 { panic(82820); };
    let e5 = ecs_single_threaded_executor_apply_deferred(e4);
    if ecs_single_threaded_executor_unapplied_count(e5) != 0 { panic(82821); };
    if ecs_single_threaded_executor_deferred_applied(e5) != 2 { panic(82822); };
}

@test "single_threaded_finish_applies_final_deferred_and_clears_transient"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_run_system(e2, 0, false);
    let e4 = ecs_single_threaded_executor_run_system(e3, 1, false);
    let e5 = ecs_single_threaded_executor_mark_set_evaluated(e4, 0);
    if ecs_single_threaded_executor_unapplied_count(e5) != 2 { panic(82823); };
    let e6 = ecs_single_threaded_executor_finish(e5);
    if ecs_single_threaded_executor_completed_count(e6) != 0 { panic(82824); };
    if ecs_single_threaded_executor_evaluated_set_count(e6) != 0 { panic(82839); };
    if ecs_single_threaded_executor_unapplied_count(e6) != 0 { panic(82840); };
    if ecs_single_threaded_executor_deferred_applied(e6) != 2 { panic(82841); };
}

@test "single_threaded_finish_without_final_deferred_preserves_unapplied"() {
    let e = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e, 3, 1);
    let e2 = ecs_single_threaded_executor_set_apply_final_deferred(e1, false);
    let e3 = ecs_single_threaded_executor_run_system(e2, 0, false);
    let e4 = ecs_single_threaded_executor_skip_system(e3, 1);
    let e5 = ecs_single_threaded_executor_mark_set_evaluated(e4, 0);
    let finished = ecs_single_threaded_executor_finish_run(e5);
    if ecs_single_threaded_executor_completed_count(finished) != 0 { panic(82842); };
    if ecs_single_threaded_executor_evaluated_set_count(finished) != 0 { panic(82843); };
    if ecs_single_threaded_executor_unapplied_count(finished) != 1 { panic(82844); };
    if ecs_single_threaded_executor_is_unapplied(finished, 0) != true { panic(82845); };
    if ecs_single_threaded_executor_deferred_applied(finished) != 0 { panic(82846); };
}

@test "single_threaded_mark_completed_out_of_range"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_mark_completed(e2, 99);
    if ecs_single_threaded_executor_completed_count(e3) != 0 { panic(82825); };
    let e4 = ecs_single_threaded_executor_mark_completed(e2, -1);
    if ecs_single_threaded_executor_completed_count(e4) != 0 { panic(82826); };
}

@test "single_threaded_is_completed_not_initialized"() {
    let e = ecs_single_threaded_executor_new();
    if ecs_single_threaded_executor_is_completed(e, 0) != false { panic(82827); };
}

@test "single_threaded_run_multiple"() {
    let e = ecs_single_threaded_executor_new();
    let e2 = ecs_single_threaded_executor_init(e, 5, 3);
    let e3 = ecs_single_threaded_executor_run_system(e2, 0, false);
    let e4 = ecs_single_threaded_executor_skip_system(e3, 1);
    let e5 = ecs_single_threaded_executor_run_system(e4, 2, false);
    let e6 = ecs_single_threaded_executor_run_system(e5, 3, true);
    if ecs_single_threaded_executor_systems_run(e6) != 3 { panic(82828); };
    if ecs_single_threaded_executor_systems_skipped(e6) != 1 { panic(82829); };
    if ecs_single_threaded_executor_completed_count(e6) != 4 { panic(82830); };
    if ecs_single_threaded_executor_deferred_applied(e6) != 2 { panic(82831); };
    if ecs_single_threaded_executor_unapplied_count(e6) != 0 { panic(82847); };
}

@test "single_threaded_failed_set_condition_marks_set_systems_completed"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 3, 1);
    let systems = Vec::new();
    systems.push(0);
    systems.push(1);
    let e2 = ecs_single_threaded_executor_apply_failed_set_condition(e1, 0, systems);
    if ecs_single_threaded_executor_is_set_evaluated(e2, 0) != true { panic(82848); };
    if ecs_single_threaded_executor_is_completed(e2, 0) != true { panic(82849); };
    if ecs_single_threaded_executor_is_completed(e2, 1) != true { panic(82850); };
    if ecs_single_threaded_executor_is_completed(e2, 2) { panic(82851); };
    if ecs_single_threaded_executor_systems_skipped(e2) != 2 { panic(82852); };
    if ecs_single_threaded_executor_unapplied_count(e2) != 0 { panic(82853); };
    let e3 = ecs_single_threaded_executor_process_system(e2, 2, true, false);
    if ecs_single_threaded_executor_systems_run(e3) != 1 { panic(82854); };
    if ecs_single_threaded_executor_is_unapplied(e3, 2) != true { panic(82855); };
}

@test "single_threaded_passed_set_condition_marks_evaluated_only"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 2, 1);
    let e2 = ecs_single_threaded_executor_apply_passed_set_condition(e1, 0);
    if ecs_single_threaded_executor_is_set_evaluated(e2, 0) != true { panic(82856); };
    if ecs_single_threaded_executor_completed_count(e2) != 0 { panic(82857); };
    let systems = Vec::new();
    systems.push(0);
    systems.push(1);
    let e3 = ecs_single_threaded_executor_apply_failed_set_condition(e2, 0, systems);
    if ecs_single_threaded_executor_completed_count(e3) != 0 { panic(82858); };
    if ecs_single_threaded_executor_systems_skipped(e3) != 0 { panic(82859); };
}

@test "single_threaded_initial_skips_mark_completed_before_run"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 3, 0);
    let skipped = Vec::new();
    skipped.push(1);
    let e2 = ecs_single_threaded_executor_apply_initial_skips(e1, skipped);
    if ecs_single_threaded_executor_is_completed(e2, 1) != true { panic(82860); };
    if ecs_single_threaded_executor_systems_skipped(e2) != 1 { panic(82861); };
    let e3 = ecs_single_threaded_executor_process_system(e2, 0, true, false);
    let e4 = ecs_single_threaded_executor_process_system(e3, 1, true, false);
    let e5 = ecs_single_threaded_executor_process_system(e4, 2, true, false);
    if ecs_single_threaded_executor_systems_run(e5) != 2 { panic(82862); };
    if ecs_single_threaded_executor_systems_skipped(e5) != 1 { panic(82863); };
    if ecs_single_threaded_executor_is_unapplied(e5, 1) { panic(82864); };
}

@test "single_threaded_condition_fold_evaluates_all_after_false"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 1, 0);
    let outcomes = Vec::new();
    outcomes.push(ecs_single_threaded_condition_outcome_true());
    outcomes.push(ecs_single_threaded_condition_outcome_false());
    outcomes.push(ecs_single_threaded_condition_outcome_true());
    let folded = ecs_single_threaded_executor_evaluate_and_fold_conditions(e1, 0, outcomes);
    if ecs_single_threaded_condition_fold_should_run(folded) { panic(82865); };
    if ecs_single_threaded_condition_fold_evaluated_count(folded) != 3 { panic(82866); };
    if ecs_single_threaded_condition_fold_aborted(folded) { panic(82867); };
}

@test "single_threaded_condition_fold_error_handler_panic_aborts_remaining"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 1, 0);
    let outcomes = Vec::new();
    outcomes.push(ecs_single_threaded_condition_outcome_true());
    outcomes.push(ecs_single_threaded_condition_outcome_error_handler_panic());
    outcomes.push(ecs_single_threaded_condition_outcome_true());
    let folded = ecs_single_threaded_executor_evaluate_and_fold_conditions(e1, 0, outcomes);
    if ecs_single_threaded_condition_fold_should_run(folded) { panic(82868); };
    if ecs_single_threaded_condition_fold_evaluated_count(folded) != 2 { panic(82869); };
    if ecs_single_threaded_condition_fold_aborted(folded) != true { panic(82870); };
    if ecs_single_threaded_executor_has_panic_payload(folded.executor) != true { panic(82871); };
    if ecs_single_threaded_executor_panic_payload_phase(folded.executor) != ecs_single_threaded_panic_phase_run_condition() { panic(82872); };
    if ecs_single_threaded_executor_panic_payload_system(folded.executor) != 0 { panic(82873); };
}

@test "single_threaded_run_plan_drives_schedule_order_with_skip_and_apply_barrier"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 4, 0);
    let p0 = ecs_single_threaded_run_plan_new(e1);
    let p1 = ecs_single_threaded_run_plan_add_system(p0, ecs_single_threaded_system_spec_new(0, true, false));
    let p2 = ecs_single_threaded_run_plan_add_system(p1, ecs_single_threaded_system_spec_new(1, false, false));
    let p3 = ecs_single_threaded_run_plan_add_system(p2, ecs_single_threaded_system_spec_new(2, true, false));
    let p4 = ecs_single_threaded_run_plan_add_system(p3, ecs_single_threaded_system_spec_new(3, true, true));
    let p5 = ecs_single_threaded_run_plan_drive_all(p4);
    if ecs_single_threaded_run_plan_run_count(p5) != 3 { panic(82874); };
    if ecs_single_threaded_run_plan_run_at(p5, 0) != 0 { panic(82875); };
    if ecs_single_threaded_run_plan_run_at(p5, 1) != 2 { panic(82876); };
    if ecs_single_threaded_run_plan_run_at(p5, 2) != 3 { panic(82877); };
    if ecs_single_threaded_run_plan_skipped_count(p5) != 1 { panic(82878); };
    if ecs_single_threaded_run_plan_skipped_at(p5, 0) != 1 { panic(82879); };
    if ecs_single_threaded_executor_deferred_applied(p5.executor) != 2 { panic(82880); };
    if ecs_single_threaded_executor_unapplied_count(p5.executor) != 0 { panic(82881); };
    if ecs_single_threaded_executor_is_unapplied(p5.executor, 3) { panic(82882); };
    let finished = ecs_single_threaded_executor_finish_run(p5.executor);
    if ecs_single_threaded_executor_completed_count(finished) != 0 { panic(82883); };
    if ecs_single_threaded_executor_deferred_applied(finished) != 2 { panic(82884); };
}

@test "single_threaded_system_handled_error_still_marks_unapplied"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 1, 0);
    let e2 = ecs_single_threaded_executor_run_system_with_handled_error(e1, 0);
    if ecs_single_threaded_executor_is_completed(e2, 0) != true { panic(82885); };
    if ecs_single_threaded_executor_is_unapplied(e2, 0) != true { panic(82886); };
    if ecs_single_threaded_executor_system_handled_error_count(e2) != 1 { panic(82887); };
    if ecs_single_threaded_executor_handled_error_phase(e2) != ecs_single_threaded_panic_phase_system() { panic(82888); };
    if ecs_single_threaded_executor_has_panic_payload(e2) { panic(82889); };
}

@test "single_threaded_finish_run_deferred_error_clears_before_payload_take"() {
    let e0 = ecs_single_threaded_executor_new();
    let e1 = ecs_single_threaded_executor_init(e0, 3, 0);
    let e2 = ecs_single_threaded_executor_run_system(e1, 0, false);
    let e3 = ecs_single_threaded_executor_run_system(e2, 1, false);
    let e4 = ecs_single_threaded_executor_run_system(e3, 2, false);
    let finished = ecs_single_threaded_executor_finish_run_with_deferred_error(e4, 1);
    if finished.deferred_applied != 2 { panic(82890); };
    if ecs_single_threaded_executor_unapplied_count(finished) != 0 { panic(82891); };
    if ecs_single_threaded_executor_completed_count(finished) != 0 { panic(82892); };
    if ecs_single_threaded_executor_has_panic_payload(finished) != true { panic(82893); };
    if ecs_single_threaded_executor_deferred_panic_payload_count(finished) != 1 { panic(82894); };
    if ecs_single_threaded_executor_panic_payload_phase(finished) != ecs_single_threaded_panic_phase_apply_deferred() { panic(82895); };
    if ecs_single_threaded_executor_panic_payload_system(finished) != 1 { panic(82896); };
    let after_take = ecs_single_threaded_executor_take_panic_payload(finished);
    if ecs_single_threaded_executor_has_panic_payload(after_take) { panic(82897); };
    if ecs_single_threaded_executor_panic_rethrow_count(after_take) != 1 { panic(82898); };
}
