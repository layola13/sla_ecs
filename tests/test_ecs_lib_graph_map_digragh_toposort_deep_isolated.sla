@import "lib/graph_map_digragh_toposort_deep.sla"

// Batch 327: graph_map_digragh_toposort deep.
// panic codes: 131400 – 131599.

@test "new_counts"() {
    let g = ecs_dg_deep_new(3);
    if ecs_dg_deep_node_count(g) != 3 { panic(131400); };
    if ecs_dg_deep_edge_count(g) != 0 { panic(131401); };
}

@test "add_edge_contains"() {
    let g = ecs_dg_deep_new(3);
    g = ecs_dg_deep_add_edge(g, 0, 1);
    if ecs_dg_deep_contains_edge(g, 0, 1) != true { panic(131410); };
    if ecs_dg_deep_contains_edge(g, 1, 0) != false { panic(131411); };
}

@test "self_loop"() {
    let g = ecs_dg_deep_add_edge(ecs_dg_deep_new(2), 1, 1);
    let r = ecs_dg_deep_toposort(g);
    if ecs_dg_topo_is_loop(r) != true { panic(131420); };
    if ecs_dg_topo_loop_node(r) != 1 { panic(131421); };
}

@test "two_cycle"() {
    let g = ecs_dg_deep_new(2);
    g = ecs_dg_deep_add_edge(g, 0, 1);
    g = ecs_dg_deep_add_edge(g, 1, 0);
    let r = ecs_dg_deep_toposort(g);
    if ecs_dg_topo_is_cycle(r) != true { panic(131430); };
    if ecs_dg_topo_cycle_len(r) != 2 { panic(131431); };
}

@test "chain_toposort"() {
    let g = ecs_dg_deep_new(3);
    g = ecs_dg_deep_add_edge(g, 0, 1);
    g = ecs_dg_deep_add_edge(g, 1, 2);
    let r = ecs_dg_deep_toposort(g);
    if ecs_dg_topo_is_ok(r) != true { panic(131440); };
    if ecs_dg_topo_order_at(r, 0) != 0 { panic(131441); };
    if ecs_dg_topo_order_at(r, 1) != 1 { panic(131442); };
    if ecs_dg_topo_order_at(r, 2) != 2 { panic(131443); };
}

@test "empty_graph_order"() {
    let g = ecs_dg_deep_new(2);
    let r = ecs_dg_deep_toposort(g);
    if ecs_dg_topo_is_ok(r) != true { panic(131450); };
    if ecs_dg_topo_order_len(r) != 2 { panic(131451); };
}

@test "direction_helpers"() {
    if ecs_dg_direction_is_incoming(ECS_DG_IN) != true { panic(131460); };
    if ecs_dg_direction_is_outgoing(ECS_DG_OUT) != true { panic(131461); };
    if ecs_dg_direction_opposite(ECS_DG_IN) != ECS_DG_OUT { panic(131462); };
    if ecs_dg_direction_opposite(ECS_DG_OUT) != ECS_DG_IN { panic(131463); };
}

@test "has_self_loop_helper"() {
    let g = ecs_dg_deep_add_edge(ecs_dg_deep_new(2), 0, 0);
    if ecs_dg_deep_has_self_loop(g) != 0 { panic(131470); };
}

@test "has_two_cycle_helper"() {
    let g = ecs_dg_deep_new(2);
    g = ecs_dg_deep_add_edge(g, 0, 1);
    g = ecs_dg_deep_add_edge(g, 1, 0);
    if ecs_dg_deep_has_two_cycle(g) != true { panic(131480); };
}

@test "edge_count"() {
    let g = ecs_dg_deep_new(3);
    g = ecs_dg_deep_add_edge(g, 0, 1);
    g = ecs_dg_deep_add_edge(g, 1, 2);
    if ecs_dg_deep_edge_count(g) != 2 { panic(131490); };
}
