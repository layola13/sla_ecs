@import "lib/query_access_deep.sla"

// Batch 257: query_access deep (src/query/access.rs).
// panic codes: 117400 – 117599.

@test "add_read_write_implies_read"() {
    let a = ecs_access_deep_new();
    a = ecs_access_deep_add_write(a, 5);
    if ecs_access_deep_has_write(a, 5) != true { panic(117400); };
    if ecs_access_deep_has_read(a, 5) != true { panic(117401); };
    if ecs_access_deep_write_len(a) != 1 { panic(117402); };
    if ecs_access_deep_read_len(a) != 1 { panic(117403); };
}

@test "dedup_reads"() {
    let a = ecs_access_deep_new();
    a = ecs_access_deep_add_read(a, 1);
    a = ecs_access_deep_add_read(a, 1);
    a = ecs_access_deep_add_read(a, 2);
    if ecs_access_deep_read_len(a) != 2 { panic(117410); };
}

@test "compatible_reads_only"() {
    let a = ecs_access_deep_new();
    a = ecs_access_deep_add_read(a, 1);
    let b = ecs_access_deep_new();
    b = ecs_access_deep_add_read(b, 1);
    if ecs_access_deep_is_compatible(a, b) != true { panic(117420); };
}

@test "incompatible_write_vs_read"() {
    let a = ecs_access_deep_new();
    a = ecs_access_deep_add_write(a, 3);
    let b = ecs_access_deep_new();
    b = ecs_access_deep_add_read(b, 3);
    if ecs_access_deep_is_compatible(a, b) != false { panic(117430); };
    let c = ecs_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_has(c) != true { panic(117431); };
    if ecs_access_conflict_id(c) != 3 { panic(117432); };
}

@test "reads_all_conflicts_with_write"() {
    let a = ecs_access_deep_new();
    a = ecs_access_deep_set_reads_all(a);
    let b = ecs_access_deep_new();
    b = ecs_access_deep_add_write(b, 9);
    if ecs_access_deep_reads_inverted(a) != true { panic(117440); };
    if ecs_access_deep_is_compatible(a, b) != false { panic(117441); };
}

@test "archetypal_does_not_conflict"() {
    let a = ecs_access_deep_new();
    a = ecs_access_deep_add_archetypal(a, 4);
    let b = ecs_access_deep_new();
    b = ecs_access_deep_add_write(b, 4);
    if ecs_access_deep_arch_len(a) != 1 { panic(117450); };
    if ecs_access_deep_is_compatible(a, b) != true { panic(117451); };
}

@test "filtered_access_with_without"() {
    let f = ecs_fa_deep_new();
    f = ecs_fa_deep_add_write(f, 1);
    f = ecs_fa_deep_and_with(f, 2);
    f = ecs_fa_deep_and_without(f, 3);
    if ecs_fa_deep_with_len(f) != 1 { panic(117460); };
    if ecs_fa_deep_without_len(f) != 1 { panic(117461); };
    let acc = ecs_fa_deep_access(f);
    if ecs_access_deep_has_write(acc, 1) != true { panic(117462); };
}

@test "filtered_disjoint_allows_conflict"() {
    let a = ecs_fa_deep_new();
    a = ecs_fa_deep_add_write(a, 1);
    a = ecs_fa_deep_and_with(a, 7);
    let b = ecs_fa_deep_new();
    b = ecs_fa_deep_add_read(b, 1);
    b = ecs_fa_deep_and_without(b, 7);
    // access would conflict, filters disjoint => compatible
    if ecs_fa_deep_is_compatible(a, b) != true { panic(117470); };
}

@test "filtered_same_access_conflict"() {
    let a = ecs_fa_deep_new();
    a = ecs_fa_deep_add_write(a, 1);
    let b = ecs_fa_deep_new();
    b = ecs_fa_deep_add_read(b, 1);
    if ecs_fa_deep_is_compatible(a, b) != false { panic(117480); };
}

@test "no_conflict_empty"() {
    let a = ecs_access_deep_new();
    let b = ecs_access_deep_new();
    let c = ecs_access_deep_get_conflicts(a, b);
    if ecs_access_conflict_has(c) != false { panic(117490); };
    if ecs_access_deep_is_compatible(a, b) != true { panic(117491); };
}
