@import "lib/observer_condition_deep.sla"

// Batch 217: observer condition deep (src/observer/condition.rs).
// panic codes: 109400 – 109599.

@test "condition_new_uninitialized"() {
    let c = ecs_oc_condition_new(1, true);
    if ecs_oc_condition_is_initialized(c) != false { panic(109400); };
    if ecs_oc_condition_system_id(c) != 1 { panic(109401); };
    if ecs_oc_condition_result(c) != true { panic(109402); };
}

@test "check_uninitialized_false_no_count"() {
    let c = ecs_oc_condition_new(2, true);
    let r = ecs_oc_condition_check(c);
    if r.1 != false { panic(109410); };
    if ecs_oc_condition_check_count(r.0) != 0 { panic(109411); };
}

@test "initialize_then_check_true"() {
    let c = ecs_oc_condition_new(3, true);
    c = ecs_oc_condition_initialize(c);
    let r = ecs_oc_condition_check(c);
    if r.1 != true { panic(109420); };
    if ecs_oc_condition_check_count(r.0) != 1 { panic(109421); };
    if ecs_oc_condition_last_result(r.0) != true { panic(109422); };
}

@test "check_false_result"() {
    let c = ecs_oc_condition_new(4, false);
    c = ecs_oc_condition_initialize(c);
    let r = ecs_oc_condition_check(c);
    if r.1 != false { panic(109430); };
    if ecs_oc_condition_last_result(r.0) != false { panic(109431); };
}

@test "check_fail_unwraps_or_false"() {
    let c = ecs_oc_condition_new(5, true);
    c = ecs_oc_condition_initialize(c);
    c = ecs_oc_condition_set_fail(c, true);
    let r = ecs_oc_condition_check(c);
    if r.1 != false { panic(109440); };
    if ecs_oc_condition_check_count(r.0) != 1 { panic(109441); };
    if ecs_oc_condition_last_result(r.0) != false { panic(109442); };
}

@test "from_boxed_same_as_new"() {
    let c = ecs_oc_condition_from_boxed(9, false);
    if ecs_oc_condition_is_initialized(c) != false { panic(109450); };
    if ecs_oc_condition_system_id(c) != 9 { panic(109451); };
}

@test "with_run_if_chain_and_len"() {
    let o = ecs_oc_with_new(100, 7, 8);
    if ecs_oc_with_system_id(o) != 100 { panic(109460); };
    if ecs_oc_with_event_type(o) != 7 { panic(109461); };
    if ecs_oc_with_bundle_type(o) != 8 { panic(109462); };
    o = ecs_oc_with_run_if(o, 1, true);
    o = ecs_oc_with_run_if(o, 2, true);
    o = ecs_oc_with_run_if(o, 3, false);
    if ecs_oc_with_cond_len(o) != 3 { panic(109463); };
}

@test "take_conditions_returns_system_and_marks_taken"() {
    let o = ecs_oc_with_new(50, 1, 2);
    o = ecs_oc_with_run_if(o, 10, true);
    o = ecs_oc_with_run_if(o, 11, true);
    let t = ecs_oc_with_take(o);
    if t.0 != 50 { panic(109470); };
    if t.1 != 2 { panic(109471); };
    if ecs_oc_with_taken(t.2) != true { panic(109472); };
}

@test "eval_and_all_true"() {
    let o = ecs_oc_with_new(1, 1, 1);
    o = ecs_oc_with_run_if(o, 1, true);
    o = ecs_oc_with_run_if(o, 2, true);
    let r = ecs_oc_with_ready_eval(o);
    o = r.0;
    let f = r.1;
    if ecs_oc_fold_should(f) != true { panic(109480); };
    if ecs_oc_fold_evaluated(f) != 2 { panic(109481); };
    if ecs_oc_fold_true_count(f) != 2 { panic(109482); };
    if ecs_oc_with_slot_checks(o, 0) != 1 { panic(109483); };
    if ecs_oc_with_slot_checks(o, 1) != 1 { panic(109484); };
}

@test "eval_and_non_short_circuit_on_false"() {
    let o = ecs_oc_with_new(1, 1, 1);
    o = ecs_oc_with_run_if(o, 1, false);
    o = ecs_oc_with_run_if(o, 2, true);
    o = ecs_oc_with_run_if(o, 3, true);
    let r = ecs_oc_with_ready_eval(o);
    o = r.0;
    let f = r.1;
    if ecs_oc_fold_should(f) != false { panic(109490); };
    // all three still evaluated
    if ecs_oc_fold_evaluated(f) != 3 { panic(109491); };
    if ecs_oc_fold_true_count(f) != 2 { panic(109492); };
    if ecs_oc_with_slot_checks(o, 0) != 1 { panic(109493); };
    if ecs_oc_with_slot_checks(o, 1) != 1 { panic(109494); };
    if ecs_oc_with_slot_checks(o, 2) != 1 { panic(109495); };
}

@test "uninitialized_slots_fail_check"() {
    let o = ecs_oc_with_new(1, 1, 1);
    o = ecs_oc_with_run_if(o, 1, true);
    // no initialize_all
    let r = ecs_oc_with_eval_and(o);
    let f = r.1;
    if ecs_oc_fold_should(f) != false { panic(109500); };
    if ecs_oc_fold_evaluated(f) != 1 { panic(109501); };
}

@test "fail_slot_counts_as_false_but_continues"() {
    let o = ecs_oc_with_new(1, 1, 1);
    o = ecs_oc_with_run_if(o, 1, true);
    o = ecs_oc_with_run_if(o, 2, true);
    o = ecs_oc_with_set_fail_at(o, 0, true);
    let r = ecs_oc_with_ready_eval(o);
    o = r.0;
    let f = r.1;
    if ecs_oc_fold_should(f) != false { panic(109510); };
    if ecs_oc_fold_evaluated(f) != 2 { panic(109511); };
    if ecs_oc_with_slot_checks(o, 0) != 1 { panic(109512); };
    if ecs_oc_with_slot_checks(o, 1) != 1 { panic(109513); };
}

@test "four_conditions_capacity"() {
    let o = ecs_oc_with_new(1, 1, 1);
    o = ecs_oc_with_run_if(o, 1, true);
    o = ecs_oc_with_run_if(o, 2, true);
    o = ecs_oc_with_run_if(o, 3, true);
    o = ecs_oc_with_run_if(o, 4, true);
    if ecs_oc_with_cond_len(o) != 4 { panic(109520); };
    // overflow ignored
    o = ecs_oc_with_run_if(o, 5, false);
    if ecs_oc_with_cond_len(o) != 4 { panic(109521); };
    let r = ecs_oc_with_ready_eval(o);
    if ecs_oc_fold_should(r.1) != true { panic(109522); };
    if ecs_oc_fold_evaluated(r.1) != 4 { panic(109523); };
}

@test "set_result_then_check"() {
    let c = ecs_oc_condition_new(1, true);
    c = ecs_oc_condition_initialize(c);
    c = ecs_oc_condition_set_result(c, false);
    let r = ecs_oc_condition_check(c);
    if r.1 != false { panic(109530); };
}

@test "double_check_increments"() {
    let c = ecs_oc_condition_new(1, true);
    c = ecs_oc_condition_initialize(c);
    let r1 = ecs_oc_condition_check(c);
    let r2 = ecs_oc_condition_check(r1.0);
    if ecs_oc_condition_check_count(r2.0) != 2 { panic(109540); };
    if r2.1 != true { panic(109541); };
}

@test "empty_conditions_and_is_true"() {
    let o = ecs_oc_with_new(9, 1, 1);
    let r = ecs_oc_with_ready_eval(o);
    if ecs_oc_fold_should(r.1) != true { panic(109550); };
    if ecs_oc_fold_evaluated(r.1) != 0 { panic(109551); };
}
