@import "lib/relationship_replace_insert.sla"

// Isolated tests for lib/relationship_replace_insert.sla — insert_related + replace_related +
// replace_related_with_difference. Bevy: src/relationship/related_methods.rs.

const REL_ID: i32 = 1;
const E0: i64 = 1000;
const E1: i64 = 1001;
const E2: i64 = 1002;
const E3: i64 = 1003;
const E4: i64 = 1004;

@test "ri_new_empty"() {
    let r = ecs_ri_new();
    if ecs_ri_related_count(r) != 0 { panic(91935); };
    if ecs_ri_has_target(r) { panic(91936); };
}

@test "ri_with_existing_carries_target_and_entries"() {
    let src = Vec::new();
    src.push(E0);
    src.push(E1);
    let r = ecs_ri_with_existing(src);
    if ecs_ri_related_count(r) != 2 { panic(91937); };
    if !ecs_ri_has_target(r) { panic(91938); };
}

@test "ri_related_at_oob"() {
    let r = ecs_ri_new();
    if ecs_ri_related_at(r, -1) != -1 { panic(91939); };
    if ecs_ri_related_at(r, 9) != -1 { panic(91940); };
}

@test "ri_replace_related_empty_detaches"() {
    let src = Vec::new();
    src.push(E0);
    let r0 = ecs_ri_with_existing(src);
    let empty = Vec::new();
    let r1 = ecs_ri_replace_related(r0, REL_ID, empty);
    if ecs_ri_related_count(r1) != 0 { panic(91941); };
    if ecs_ri_has_target(r1) { panic(91942); };
}

@test "ri_replace_related_full_set"() {
    let r0 = ecs_ri_new();
    let new_set = Vec::new();
    new_set.push(E1);
    new_set.push(E2);
    let r1 = ecs_ri_replace_related(r0, REL_ID, new_set);
    if ecs_ri_related_count(r1) != 2 { panic(91943); };
    if !ecs_ri_has_target(r1) { panic(91944); };
    if ecs_ri_related_at(r1, 0) != E1 { panic(91945); };
    if ecs_ri_related_at(r1, 1) != E2 { panic(91946); };
}

@test "ri_replace_related_dedupes"() {
    let r0 = ecs_ri_new();
    let new_set = Vec::new();
    new_set.push(E1);
    new_set.push(E2);
    new_set.push(E1);
    let r1 = ecs_ri_replace_related(r0, REL_ID, new_set);
    if ecs_ri_related_count(r1) != 2 { panic(91947); };
}

@test "ri_insert_related_grows_list_at_index"() {
    let r0 = ecs_ri_new();
    let r1 = ecs_ri_insert_related(r0, REL_ID, 0, Vec::new());
    let s1 = Vec::new();
    s1.push(E0);
    s1.push(E1);
    let r2 = ecs_ri_replace_related(r1, REL_ID, s1);
    let to_insert = Vec::new();
    to_insert.push(E2);
    to_insert.push(E3);
    let r3 = ecs_ri_insert_related(r2, REL_ID, 1, to_insert);
    // [E0, E1] + insert [E2, E3] at idx 1 → [E0, E2, E3, E1]
    if ecs_ri_related_count(r3) != 4 { panic(91948); };
    if ecs_ri_related_at(r3, 0) != E0 { panic(91949); };
    if ecs_ri_related_at(r3, 1) != E2 { panic(91950); };
    if ecs_ri_related_at(r3, 2) != E3 { panic(91951); };
    if ecs_ri_related_at(r3, 3) != E1 { panic(91952); };
}

@test "ri_insert_related_no_existing_inserts_via_index_zero"() {
    let r0 = ecs_ri_new();
    let to_insert = Vec::new();
    to_insert.push(E0);
    let r1 = ecs_ri_insert_related(r0, REL_ID, 0, to_insert);
    if ecs_ri_related_count(r1) != 1 { panic(91953); };
    if ecs_ri_related_at(r1, 0) != E0 { panic(91954); };
    if !ecs_ri_has_target(r1) { panic(91955); };
}

@test "ri_insert_related_should_move_existing"() {
    // start [E0, E1, E2]; insert_related idx=0 with [E2]: E2 moved from existing slot back to idx 0
    let src = Vec::new();
    src.push(E0);
    src.push(E1);
    src.push(E2);
    let r0 = ecs_ri_with_existing(src);
    let to_insert = Vec::new();
    to_insert.push(E2);
    let r1 = ecs_ri_insert_related(r0, REL_ID, 0, to_insert);
    if ecs_ri_related_count(r1) != 3 { panic(91956); };
    if ecs_ri_related_at(r1, 0) != E2 { panic(91957); };
}

@test "ri_insert_related_empty_input_no_change"() {
    let src = Vec::new();
    src.push(E0);
    let r0 = ecs_ri_with_existing(src);
    let r1 = ecs_ri_insert_related(r0, REL_ID, 0, Vec::new());
    if ecs_ri_related_count(r1) != 1 { panic(91958); };
    if ecs_ri_related_at(r1, 0) != E0 { panic(91959); };
}

@test "ri_replace_difference_unrelate_existing"() {
    let src = Vec::new();
    src.push(E0);
    src.push(E1);
    src.push(E2);
    let r0 = ecs_ri_with_existing(src);
    let unrelate = Vec::new();
    unrelate.push(E1);
    let relate = Vec::new();
    let newly = Vec::new();
    let (r1, res) = ecs_ri_replace_related_with_difference(r0, REL_ID, unrelate, relate, newly);
    // kept = [E0, E2]
    if ecs_rel_diff_count(res) != 2 { panic(91960); };
    if ecs_rel_diff_first(res) != E0 { panic(91961); };
    if ecs_ri_related_at(r1, 1) != E2 { panic(91962); };
}

@test "ri_replace_difference_relate_new"() {
    let src = Vec::new();
    src.push(E0);
    let r0 = ecs_ri_with_existing(src);
    let unrelate = Vec::new();
    let relate = Vec::new();
    relate.push(E1);
    relate.push(E2);
    let newly = Vec::new();
    let (r1, res) = ecs_ri_replace_related_with_difference(r0, REL_ID, unrelate, relate, newly);
    // kept = [E0] ∪ [E1, E2] = [E0, E1, E2]
    if ecs_rel_diff_count(res) != 3 { panic(91963); };
    if ecs_ri_related_at(r1, 0) != E0 { panic(91964); };
    if ecs_ri_related_at(r1, 1) != E1 { panic(91965); };
    if ecs_ri_related_at(r1, 2) != E2 { panic(91966); };
}

@test "ri_replace_difference_both_unrelate_and_relate"() {
    let src = Vec::new();
    src.push(E0);
    src.push(E1);
    src.push(E2);
    let r0 = ecs_ri_with_existing(src);
    let unrelate = Vec::new();
    unrelate.push(E2);
    let relate = Vec::new();
    relate.push(E3);
    let newly = Vec::new();
    let (r1, res) = ecs_ri_replace_related_with_difference(r0, REL_ID, unrelate, relate, newly);
    // kept = [E0, E1] ∪ [E3] = [E0, E1, E3]
    if ecs_rel_diff_count(res) != 3 { panic(91967); };
    if ecs_ri_related_at(r1, 2) != E3 { panic(91968); };
    if ecs_ri_has_target(r1) != true { panic(91969); };
}

@test "ri_replace_difference_empty_result_when_unrelate_all"() {
    let src = Vec::new();
    src.push(E0);
    src.push(E1);
    let r0 = ecs_ri_with_existing(src);
    let unrelate = Vec::new();
    unrelate.push(E0);
    unrelate.push(E1);
    let relate = Vec::new();
    let newly = Vec::new();
    let (r1, res) = ecs_ri_replace_related_with_difference(r0, REL_ID, unrelate, relate, newly);
    if ecs_rel_diff_count(res) != 0 { panic(91970); };
    if ecs_rel_diff_first(res) != -1 { panic(91971); };
    // Bevy leaves the RelationshipTarget set in place (empty collection); model has_target stays set.
    if !ecs_ri_has_target(r1) { panic(91972); };
}

@test "ri_replace_difference_relate_dedup"() {
    let src = Vec::new();
    src.push(E0);
    let r0 = ecs_ri_with_existing(src);
    let unrelate = Vec::new();
    let relate = Vec::new();
    relate.push(E1);
    relate.push(E1);
    relate.push(E2);
    let newly = Vec::new();
    let (r1, res) = ecs_ri_replace_related_with_difference(r0, REL_ID, unrelate, relate, newly);
    if ecs_rel_diff_count(res) != 3 { panic(91973); };
}

@test "ri_replace_difference_existing_not_owned_overlapping_keep"() {
    let src = Vec::new();
    src.push(E0);
    src.push(E1);
    let r0 = ecs_ri_with_existing(src);
    // unrelate E0, relate E0 + E2 — but relate reintroduces E0 (Bevy asserts newly_related ⊂ relate — so re-relating is allowed)
    let unrelate = Vec::new();
    unrelate.push(E0);
    let relate = Vec::new();
    relate.push(E0);
    relate.push(E2);
    let newly = Vec::new();
    let (r1, res) = ecs_ri_replace_related_with_difference(r0, REL_ID, unrelate, relate, newly);
    // kept = [E1]; union relate [E0, E2] → [E1, E0, E2]
    if ecs_rel_diff_count(res) != 3 { panic(91974); };
}
