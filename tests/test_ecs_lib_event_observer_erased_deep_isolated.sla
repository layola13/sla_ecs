// Isolated deep tests for lib/event_observer_erased_deep.sla (Batch 353).
// panic codes: 136600 - 136799.

@import "lib/event_observer_erased_deep.sla"

@test "ErasedObservers new starts with empty state"() {
    let o = ecs_erased_observers_new();
    if ecs_erased_observers_count(o) != 0 { panic(136600); };
    if ecs_erased_observers_trigger_count(o) != 0 { panic(136601); };
    if ecs_erased_observers_result_sum(o) != 0 { panic(136602); };
    if ecs_erased_observers_last_entity_id(o) != -1 { panic(136603); };
    if ecs_erased_observers_last_event_type_id(o) != 0 { panic(136604); };
}

@test "ErasedEventValue accessors"() {
    let v = ecs_erased_event_value_new(ECS_EVT_SPEAK_DEEP, 7);
    if ecs_erased_event_value_type_id(v) != ECS_EVT_SPEAK_DEEP { panic(136610); };
    if ecs_erased_event_value_payload(v) != 7 { panic(136611); };
}

@test "Observer record accessors"() {
    let o = ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK);
    if ecs_erased_observer_type_id(o) != ECS_EVT_SPEAK_DEEP { panic(136620); };
    if ecs_erased_observer_kind(o) != ECS_OBSERVER_KIND_SPEAK { panic(136621); };
}

@test "Observers add appends and count grows"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    if ecs_erased_observers_count(o1) != 1 { panic(136630); };
    let o2 = ecs_erased_observers_add(o1, ecs_erased_observer_new(ECS_EVT_EXPLODE_DEEP, ECS_OBSERVER_KIND_EXPLODE));
    if ecs_erased_observers_count(o2) != 2 { panic(136631); };
    // Capacity cap-8: add 7 more (total 9) — accepted up to 8.
    let o = o2;
    let i: i32 = 0;
    while i < 7 {
        o = ecs_erased_observers_add(o, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
        i = i + 1;
    }
    if ecs_erased_observers_count(o) != 8 { panic(136632); };
    // 9th addition is rejected by cap.
    let o_full = ecs_erased_observers_add(o, ecs_erased_observer_new(ECS_EVT_EXPLODE_DEEP, ECS_OBSERVER_KIND_EXPLODE));
    if ecs_erased_observers_count(o_full) != 8 { panic(136633); };
}

@test "Speak observer trigger whole-world"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    let v = ecs_erased_event_value_new(ECS_EVT_SPEAK_DEEP, 5);
    let o2 = ecs_erased_observers_trigger(o1, v, -1);
    if ecs_erased_observers_trigger_count(o2) != 1 { panic(136640); };
    if ecs_erased_observers_result_sum(o2) != 5 { panic(136641); };
    if ecs_erased_observers_last_event_type_id(o2) != ECS_EVT_SPEAK_DEEP { panic(136642); };
    if ecs_erased_observers_last_entity_id(o2) != -1 { panic(136643); };
}

@test "explode observer trigger targeted entity"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_EXPLODE_DEEP, ECS_OBSERVER_KIND_EXPLODE));
    let v = ecs_erased_event_value_new(ECS_EVT_EXPLODE_DEEP, 4);
    let o2 = ecs_erased_observers_trigger_entity(o1, v, 9);
    if ecs_erased_observers_trigger_count(o2) != 1 { panic(136650); };
    if ecs_erased_observers_result_sum(o2) != 13 { panic(136651); };
    if ecs_erased_observers_last_entity_id(o2) != 9 { panic(136652); };
    if ecs_erased_observers_last_event_type_id(o2) != ECS_EVT_EXPLODE_DEEP { panic(136653); };
}

@test "Multiple observers same type_id fan out independently"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    let o2 = ecs_erased_observers_add(o1, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    if ecs_erased_observers_count(o2) != 2 { panic(136660); };
    let v = ecs_erased_event_value_new(ECS_EVT_SPEAK_DEEP, 3);
    let o3 = ecs_erased_observers_trigger(o2, v, -1);
    if ecs_erased_observers_trigger_count(o3) != 2 { panic(136661); };
    if ecs_erased_observers_result_sum(o3) != 6 { panic(136662); };
}

@test "Observer with mismatched type_id does not fire"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    let v = ecs_erased_event_value_new(ECS_EVT_EXPLODE_DEEP, 99);
    let o2 = ecs_erased_observers_trigger(o1, v, -1);
    if ecs_erased_observers_trigger_count(o2) != 0 { panic(136670); };
    if ecs_erased_observers_result_sum(o2) != 0 { panic(136671); };
    if ecs_erased_observers_last_event_type_id(o2) != 0 { panic(136672); };
}

@test "Mixed observers fan out only matching event"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    let o2 = ecs_erased_observers_add(o1, ecs_erased_observer_new(ECS_EVT_EXPLODE_DEEP, ECS_OBSERVER_KIND_EXPLODE));
    let v = ecs_erased_event_value_new(ECS_EVT_SPEAK_DEEP, 2);
    let o3 = ecs_erased_observers_trigger_entity(o2, v, 10);
    if ecs_erased_observers_trigger_count(o3) != 1 { panic(136680); };
    if ecs_erased_observers_result_sum(o3) != 12 { panic(136681); };
    if ecs_erased_observers_last_entity_id(o3) != 10 { panic(136682); };
    // Subsequent explosion event fires the explode observer.
    let v2 = ecs_erased_event_value_new(ECS_EVT_EXPLODE_DEEP, 4);
    let o4 = ecs_erased_observers_trigger_entity(o3, v2, 10);
    if ecs_erased_observers_trigger_count(o4) != 2 { panic(136683); };
    if ecs_erased_observers_result_sum(o4) != 26 { panic(136684); };
}

@test "Observer clear resets all counters"() {
    let o0 = ecs_erased_observers_new();
    let o1 = ecs_erased_observers_add(o0, ecs_erased_observer_new(ECS_EVT_SPEAK_DEEP, ECS_OBSERVER_KIND_SPEAK));
    let v = ecs_erased_event_value_new(ECS_EVT_SPEAK_DEEP, 5);
    let o2 = ecs_erased_observers_trigger(o1, v, -1);
    if ecs_erased_observers_count(o2) != 1 { panic(136690); };
    let o3 = ecs_erased_observers_clear(o2);
    if ecs_erased_observers_count(o3) != 0 { panic(136691); };
    if ecs_erased_observers_trigger_count(o3) != 0 { panic(136692); };
    if ecs_erased_observers_result_sum(o3) != 0 { panic(136693); };
    if ecs_erased_observers_last_entity_id(o3) != -1 { panic(136694); };
    if ecs_erased_observers_last_event_type_id(o3) != 0 { panic(136695); };
}
