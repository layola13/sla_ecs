@import "lib/entity_index_set_extras_deep.sla"

// Batch 316: entity_index_set_extras deep.
// panic codes: 129200 – 129399.

@test "insert_contains_len"() {
    let s = ecs_eis_deep_new();
    if ecs_eis_deep_is_empty(s) != true { panic(129200); };
    s = ecs_eis_deep_insert(s, 1);
    s = ecs_eis_deep_insert(s, 2);
    s = ecs_eis_deep_insert(s, 1);
    if ecs_eis_deep_len(s) != 2 { panic(129201); };
    if ecs_eis_deep_contains(s, 2) != true { panic(129202); };
}

@test "ordered_at"() {
    let s = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 10), 20);
    if ecs_eis_deep_at(s, 0) != 10 { panic(129210); };
    if ecs_eis_deep_at(s, 1) != 20 { panic(129211); };
}

@test "get_range"() {
    let s = ecs_eis_deep_new();
    s = ecs_eis_deep_insert(s, 1);
    s = ecs_eis_deep_insert(s, 2);
    s = ecs_eis_deep_insert(s, 3);
    let sl = ecs_eis_deep_get_range(s, 1, 3);
    if ecs_eis_slice_len(sl) != 2 { panic(129220); };
    if ecs_eis_slice_at(sl, 0) != 2 { panic(129221); };
    if ecs_eis_slice_at(sl, 1) != 3 { panic(129222); };
}

@test "union_intersection"() {
    let a = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 1), 2);
    let b = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 2), 3);
    let u = ecs_eis_deep_union(a, b);
    if ecs_eis_deep_len(u) != 3 { panic(129230); };
    let i = ecs_eis_deep_intersection(a, b);
    if ecs_eis_deep_len(i) != 1 { panic(129231); };
    if ecs_eis_deep_contains(i, 2) != true { panic(129232); };
}

@test "difference_subset"() {
    let a = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 1), 2);
    let b = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 2), 3);
    let d = ecs_eis_deep_difference(a, b);
    if ecs_eis_deep_len(d) != 1 { panic(129240); };
    if ecs_eis_deep_contains(d, 1) != true { panic(129241); };
    let sub = ecs_eis_deep_insert(ecs_eis_deep_new(), 2);
    if ecs_eis_deep_is_subset(sub, a) != true { panic(129242); };
    if ecs_eis_deep_is_subset(a, sub) != false { panic(129243); };
}

@test "iter_next"() {
    let s = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 4), 5);
    let it = ecs_eis_deep_iter(s);
    if ecs_eis_iter_remaining(it) != 2 { panic(129250); };
    let n1 = ecs_eis_iter_next(it);
    if ecs_eis_next_value(n1) != 4 { panic(129251); };
    let n2 = ecs_eis_iter_next(ecs_eis_next_iter(n1));
    if ecs_eis_next_value(n2) != 5 { panic(129252); };
}

@test "iter_next_back"() {
    let s = ecs_eis_deep_insert(ecs_eis_deep_insert(ecs_eis_deep_new(), 4), 5);
    let it = ecs_eis_deep_iter(s);
    let n = ecs_eis_iter_next_back(it);
    if ecs_eis_next_value(n) != 5 { panic(129260); };
    let n2 = ecs_eis_iter_next_back(ecs_eis_next_iter(n));
    if ecs_eis_next_value(n2) != 4 { panic(129261); };
}

@test "capacity_eight"() {
    let s = ecs_eis_deep_new();
    s = ecs_eis_deep_insert(s, 1);
    s = ecs_eis_deep_insert(s, 2);
    s = ecs_eis_deep_insert(s, 3);
    s = ecs_eis_deep_insert(s, 4);
    s = ecs_eis_deep_insert(s, 5);
    s = ecs_eis_deep_insert(s, 6);
    s = ecs_eis_deep_insert(s, 7);
    s = ecs_eis_deep_insert(s, 8);
    if ecs_eis_deep_len(s) != 8 { panic(129270); };
    s = ecs_eis_deep_insert(s, 9);
    if ecs_eis_deep_len(s) != 8 { panic(129271); };
}

@test "clear"() {
    let s = ecs_eis_deep_insert(ecs_eis_deep_new(), 1);
    s = ecs_eis_deep_clear(s);
    if ecs_eis_deep_is_empty(s) != true { panic(129280); };
}

@test "range_invalid"() {
    let s = ecs_eis_deep_insert(ecs_eis_deep_new(), 1);
    let sl = ecs_eis_deep_get_range(s, 0, 0);
    if ecs_eis_slice_len(sl) != 0 { panic(129290); };
}
