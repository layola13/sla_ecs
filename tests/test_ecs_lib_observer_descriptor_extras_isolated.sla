@import "lib/observer_descriptor_extras.sla"

// Isolated tests for lib/observer_descriptor_extras.sla — ObserverDescriptor v2 + Observer run state + ObserverV2.
// Bevy reference: src/observer/distributed_storage.rs

@test "descriptor_v2_new_empty"() {
    let d = ecs_observer_descriptor_v2_new();
    if ecs_observer_descriptor_v2_event_key_count(d) != 0 { panic(91105); };
    if ecs_observer_descriptor_v2_component_count(d) != 0 { panic(91106); };
    if ecs_observer_descriptor_v2_entity_count(d) != 0 { panic(91107); };
}

@test "descriptor_v2_with_event_key"() {
    let d = ecs_observer_descriptor_v2_new();
    let d2 = ecs_observer_descriptor_v2_with_event_key(d, 100);
    let d3 = ecs_observer_descriptor_v2_with_event_key(d2, 200);
    if ecs_observer_descriptor_v2_event_key_count(d3) != 2 { panic(91108); };
    let r1 = ecs_observer_descriptor_v2_event_key_at(d3, 0);
    let r2 = ecs_observer_descriptor_v2_event_key_at(d3, 1);
    if r1.0 != true { panic(91109); };
    if r1.1 != 100 { panic(91110); };
    if r2.0 != true { panic(91111); };
    if r2.1 != 200 { panic(91112); };
}

@test "descriptor_v2_event_key_at_out_of_range"() {
    let d = ecs_observer_descriptor_v2_new();
    let r = ecs_observer_descriptor_v2_event_key_at(d, 0);
    if r.0 != false { panic(91113); };
}

@test "descriptor_v2_with_component"() {
    let d = ecs_observer_descriptor_v2_new();
    let d2 = ecs_observer_descriptor_v2_with_component(d, 7);
    if ecs_observer_descriptor_v2_component_count(d2) != 1 { panic(91114); };
    let r = ecs_observer_descriptor_v2_component_at(d2, 0);
    if r.0 != true { panic(91115); };
    if r.1 != 7 { panic(91116); };
}

@test "descriptor_v2_with_entity"() {
    let d = ecs_observer_descriptor_v2_new();
    let d2 = ecs_observer_descriptor_v2_with_entity(d, 99);
    if ecs_observer_descriptor_v2_entity_count(d2) != 1 { panic(91117); };
    let r = ecs_observer_descriptor_v2_entity_at(d2, 0);
    if r.0 != true { panic(91118); };
    if r.1 != 99 { panic(91119); };
}

@test "run_state_new_defaults"() {
    let r = ecs_observer_run_state_new();
    if ecs_observer_run_state_last_trigger_id(r) != 0 { panic(91120); };
    if ecs_observer_run_state_despawned_watched_entities(r) != 0 { panic(91121); };
}

@test "run_state_run_advances_trigger"() {
    let r = ecs_observer_run_state_new();
    let r2 = ecs_observer_run_state_run(r);
    let r3 = ecs_observer_run_state_run(r2);
    if ecs_observer_run_state_last_trigger_id(r3) != 2 { panic(91122); };
}

@test "run_state_record_despawned"() {
    let r = ecs_observer_run_state_new();
    let r2 = ecs_observer_run_state_record_despawned(r);
    let r3 = ecs_observer_run_state_record_despawned(r2);
    if ecs_observer_run_state_despawned_watched_entities(r3) != 2 { panic(91123); };
}

@test "run_state_reset"() {
    let r = ecs_observer_run_state_new();
    let r2 = ecs_observer_run_state_run(r);
    let r3 = ecs_observer_run_state_record_despawned(r2);
    let r4 = ecs_observer_run_state_reset(r3);
    if ecs_observer_run_state_last_trigger_id(r4) != 0 { panic(91124); };
    if ecs_observer_run_state_despawned_watched_entities(r4) != 0 { panic(91125); };
}

@test "observer_v2_new_defaults"() {
    let o = ecs_observer_v2_new();
    if ecs_observer_v2_error_handler_id(o) != 0 { panic(91126); };
    if ecs_observer_v2_name_id(o) != 0 { panic(91127); };
    if ecs_observer_v2_last_trigger_id(o) != 0 { panic(91128); };
    if ecs_observer_v2_despawned_watched_entities(o) != 0 { panic(91129); };
    let c = ecs_observer_v2_describe_counts(o);
    if c.0 != 0 { panic(91130); };
    if c.1 != 0 { panic(91131); };
    if c.2 != 0 { panic(91132); };
}

@test "observer_v2_with_event_key"() {
    let o = ecs_observer_v2_new();
    let o2 = ecs_observer_v2_with_event_key(o, 5);
    let c = ecs_observer_v2_describe_counts(o2);
    if c.0 != 1 { panic(91133); };
}

@test "observer_v2_with_component"() {
    let o = ecs_observer_v2_new();
    let o2 = ecs_observer_v2_with_component(o, 7);
    let c = ecs_observer_v2_describe_counts(o2);
    if c.1 != 1 { panic(91134); };
}

@test "observer_v2_with_entity"() {
    let o = ecs_observer_v2_new();
    let o2 = ecs_observer_v2_with_entity(o, 999);
    let c = ecs_observer_v2_describe_counts(o2);
    if c.2 != 1 { panic(91135); };
}

@test "observer_v2_with_error_handler"() {
    let o = ecs_observer_v2_new();
    let o2 = ecs_observer_v2_with_error_handler(o, 42);
    if ecs_observer_v2_error_handler_id(o2) != 42 { panic(91136); };
}

@test "observer_v2_with_name"() {
    let o = ecs_observer_v2_new();
    let o2 = ecs_observer_v2_with_name(o, 890);
    if ecs_observer_v2_name_id(o2) != 890 { panic(91137); };
}

@test "observer_v2_run_advances_trigger"() {
    let o = ecs_observer_v2_new();
    let o2 = ecs_observer_v2_run(o);
    let o3 = ecs_observer_v2_run(o2);
    if ecs_observer_v2_last_trigger_id(o3) != 2 { panic(91138); };
}

@test "observer_v2_full_workflow"() {
    let o0 = ecs_observer_v2_new();
    let o1 = ecs_observer_v2_with_event_key(o0, 10);
    let o2 = ecs_observer_v2_with_event_key(o1, 20);
    let o3 = ecs_observer_v2_with_component(o2, 100);
    let o4 = ecs_observer_v2_with_entity(o3, 999);
    let o5 = ecs_observer_v2_with_error_handler(o4, 7);
    let o6 = ecs_observer_v2_with_name(o5, 777);
    let o7 = ecs_observer_v2_run(o6);
    let o8 = ecs_observer_v2_run(o7);
    if ecs_observer_v2_error_handler_id(o8) != 7 { panic(91139); };
    if ecs_observer_v2_name_id(o8) != 777 { panic(91140); };
    let c = ecs_observer_v2_describe_counts(o8);
    if c.0 != 2 { panic(91141); };
    if c.1 != 1 { panic(91142); };
    if c.2 != 1 { panic(91143); };
    if ecs_observer_v2_last_trigger_id(o8) != 2 { panic(91144); };
}
