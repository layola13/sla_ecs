@import "lib/batching_deep.sla"

// Batch 198: BatchingStrategy deep.

@test "new_defaults"() {
    let bs = ecs_bs_deep_new();
    if ecs_bs_deep_min(bs) != 1 { panic(105400); };
    if ecs_bs_deep_bpt(bs) != 1 { panic(105401); };
    if ecs_bs_deep_range_is_empty(bs) != false { panic(105402); };
}

@test "default_alias"() {
    let bs = ecs_bs_deep_default();
    if ecs_bs_deep_min(bs) != 1 { panic(105410); };
}

@test "fixed_is_empty_range_returns_start"() {
    let bs = ecs_bs_deep_fixed(64);
    if ecs_bs_deep_range_is_empty(bs) != true { panic(105420); };
    let r = ecs_bs_deep_calc_batch_size(bs, 1000, 4);
    if r.1 != 64 { panic(105421); };
    // thread count ignored when empty
    let r2 = ecs_bs_deep_calc_batch_size(bs, 1000, 0);
    if r2.1 != 64 { panic(105422); };
    if ecs_bs_deep_last_error(r2.0) != ECS_BS_OK { panic(105423); };
}

@test "calc_basic_div_ceil"() {
    // 100 items, 4 threads, bpt=1 => batches=4 => size=25
    let bs = ecs_bs_deep_new();
    let r = ecs_bs_deep_calc_batch_size(bs, 100, 4);
    if r.1 != 25 { panic(105430); };
}

@test "calc_rounds_up"() {
    // 10 items, 4 threads => ceil(10/4)=3
    let bs = ecs_bs_deep_new();
    let r = ecs_bs_deep_calc_batch_size(bs, 10, 4);
    if r.1 != 3 { panic(105440); };
}

@test "min_batch_clamps_up"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_min_batch_size(bs, 50);
    // would be 25 without min
    let r = ecs_bs_deep_calc_batch_size(bs, 100, 4);
    if r.1 != 50 { panic(105450); };
}

@test "max_batch_clamps_down"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_max_batch_size(bs, 10);
    // 100 items / 1 thread = 100, clamp to 10
    let r = ecs_bs_deep_calc_batch_size(bs, 100, 1);
    if r.1 != 10 { panic(105460); };
}

@test "batches_per_thread_increases_batches"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_batches_per_thread(bs, 2);
    // 100 items, 4 threads * 2 bpt = 8 batches => ceil(100/8)=13
    let r = ecs_bs_deep_calc_batch_size(bs, 100, 4);
    if r.1 != 13 { panic(105470); };
}

@test "zero_bpt_errors"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_batches_per_thread(bs, 0);
    if ecs_bs_deep_last_error(bs) != ECS_BS_ERR_ZERO_BPT { panic(105480); };
    // bpt unchanged
    if ecs_bs_deep_bpt(bs) != 1 { panic(105481); };
}

@test "zero_threads_errors"() {
    let bs = ecs_bs_deep_new();
    let r = ecs_bs_deep_calc_batch_size(bs, 100, 0);
    if ecs_bs_deep_last_error(r.0) != ECS_BS_ERR_ZERO_THREADS { panic(105490); };
    if r.1 != 0 { panic(105491); };
}

@test "div_ceil_helper"() {
    if ecs_bs_deep_div_ceil(10, 3) != 4 { panic(105500); };
    if ecs_bs_deep_div_ceil(9, 3) != 3 { panic(105501); };
    if ecs_bs_deep_div_ceil(1, 1) != 1 { panic(105502); };
}

@test "num_batches"() {
    if ecs_bs_deep_num_batches(25, 100) != 4 { panic(105510); };
    if ecs_bs_deep_num_batches(3, 10) != 4 { panic(105511); };
}

@test "plan_returns_size_and_count"() {
    let bs = ecs_bs_deep_new();
    let p = ecs_bs_deep_plan(bs, 100, 4);
    if p.1 != 25 { panic(105520); };
    if p.2 != 4 { panic(105521); };
}

@test "min_max_accessors_after_configure"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_min_batch_size(bs, 8);
    bs = ecs_bs_deep_max_batch_size(bs, 32);
    if ecs_bs_deep_min(bs) != 8 { panic(105530); };
    if ecs_bs_deep_max(bs) != 32 { panic(105531); };
}

@test "fixed_then_calc_ignores_items"() {
    let bs = ecs_bs_deep_fixed(16);
    let r = ecs_bs_deep_calc_batch_size(bs, 1, 8);
    if r.1 != 16 { panic(105540); };
    let r2 = ecs_bs_deep_calc_batch_size(bs, 100000, 8);
    if r2.1 != 16 { panic(105541); };
}

@test "lifecycle_configure_calc"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_min_batch_size(bs, 4);
    bs = ecs_bs_deep_max_batch_size(bs, 20);
    bs = ecs_bs_deep_batches_per_thread(bs, 2);
    let r = ecs_bs_deep_calc_batch_size(bs, 50, 2);
    // batches = 2*2=4, ceil(50/4)=13, clamp to [4,20] => 13
    if r.1 != 13 { panic(105550); };
    if ecs_bs_deep_last_error(r.0) != ECS_BS_OK { panic(105551); };
}

@test "single_thread_full_size"() {
    let bs = ecs_bs_deep_new();
    let r = ecs_bs_deep_calc_batch_size(bs, 77, 1);
    if r.1 != 77 { panic(105560); };
}

@test "clamp_helper"() {
    if ecs_bs_deep_clamp(5, 1, 10) != 5 { panic(105570); };
    if ecs_bs_deep_clamp(0, 1, 10) != 1 { panic(105571); };
    if ecs_bs_deep_clamp(99, 1, 10) != 10 { panic(105572); };
}

@test "bpt_success_clears_error"() {
    let bs = ecs_bs_deep_new();
    bs = ecs_bs_deep_batches_per_thread(bs, 0);
    bs = ecs_bs_deep_batches_per_thread(bs, 3);
    if ecs_bs_deep_last_error(bs) != ECS_BS_OK { panic(105580); };
    if ecs_bs_deep_bpt(bs) != 3 { panic(105581); };
}
