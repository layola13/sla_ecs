@import "lib/archetypes_registry.sla"

// Isolated tests for lib/archetypes_registry.sla — Archetypes collection + ArchetypeRecord + ComponentIndex.
// Bevy reference: src/archetype.rs (Archetypes + ComponentIndex + ArchetypeRecord)

@test "arch_record_table"() {
    let r = ecs_arch_record_table(3);
    let col = ecs_arch_record_column(r);
    if col.0 != true { panic(90909); };
    if col.1 != 3 { panic(90910); };
}

@test "arch_record_sparse"() {
    let r = ecs_arch_record_sparse();
    let col = ecs_arch_record_column(r);
    if col.0 != false { panic(90911); };
    if col.1 != -1 { panic(90912); };
}

@test "archetypes_new_has_empty"() {
    let a = ecs_archetypes_new();
    if ecs_archetypes_len(a) != 1 { panic(90913); };
    if ecs_archetypes_empty_id(a) != 0 { panic(90914); };
}

@test "archetypes_generation_initial"() {
    let a = ecs_archetypes_new();
    if ecs_archetypes_generation_collect(a) != 0 { panic(90915); };
}

@test "archetypes_spawn_table_bumps_generation"() {
    let a = ecs_archetypes_new();
    let r = ecs_archetypes_spawn_table(a);
    let a2 = r.0;
    let id0 = r.1;
    if id0 != 1 { panic(90916); };
    if ecs_archetypes_generation_collect(a2) != 1 { panic(90918); };
    if ecs_archetypes_len(a2) != 2 { panic(90919); };
}

@test "archetypes_get_existing"() {
    let a = ecs_archetypes_new();
    let r = ecs_archetypes_spawn_table(a);
    let a2 = r.0;
    let g = ecs_archetypes_get(a2, 1);
    if g.0 != true { panic(90920); };
    if g.1 != 1 { panic(90921); };
}

@test "archetypes_get_out_of_range"() {
    let a = ecs_archetypes_new();
    let g = ecs_archetypes_get(a, 99);
    if g.0 != false { panic(90922); };
}

@test "archetypes_get_negative"() {
    let a = ecs_archetypes_new();
    let g = ecs_archetypes_get(a, -1);
    if g.0 != false { panic(90923); };
}

@test "archetypes_iter_count"() {
    let a = ecs_archetypes_new();
    let r = ecs_archetypes_spawn_table(a);
    let a2 = r.0;
    if ecs_archetypes_iter_count(a2) != 2 { panic(90924); };
}

@test "archetypes_iter_at"() {
    let a = ecs_archetypes_new();
    let r = ecs_archetypes_spawn_table(a);
    let a2 = r.0;
    let r1 = ecs_archetypes_iter_at(a2, 0);
    let r2 = ecs_archetypes_iter_at(a2, 1);
    let r3 = ecs_archetypes_iter_at(a2, 5);
    if r1.0 != true { panic(90925); };
    if r1.1 != 0 { panic(90926); };
    if r2.0 != true { panic(90927); };
    if r2.1 != 1 { panic(90928); };
    if r3.0 != false { panic(90929); };
}

@test "archetypes_clear_entities_bumps_generation"() {
    let a = ecs_archetypes_new();
    let a2 = ecs_archetypes_clear_entities(a);
    if ecs_archetypes_generation_collect(a2) != 1 { panic(90930); };
}

@test "component_index_empty_initially"() {
    let a = ecs_archetypes_new();
    if ecs_archetypes_component_index_count(a) != 0 { panic(90931); };
}

@test "component_index_register_table"() {
    let a = ecs_archetypes_new();
    let a2 = ecs_archetypes_register_component_table(a, 100, 7, 3);
    if ecs_archetypes_component_index_count(a2) != 1 { panic(90932); };
    let r = ecs_archetypes_component_index_for(a2, 100, 7);
    if r.0 != true { panic(90933); };
    if r.1 != true { panic(90934); };
    if r.2 != 3 { panic(90935); };
}

@test "component_index_register_sparse"() {
    let a = ecs_archetypes_new();
    let a2 = ecs_archetypes_register_component_sparse(a, 100, 7);
    let r = ecs_archetypes_component_index_for(a2, 100, 7);
    if r.0 != true { panic(90936); };
    if r.1 != false { panic(90937); };
    if r.2 != -1 { panic(90938); };
}

@test "component_index_for_miss"() {
    let a = ecs_archetypes_new();
    let a2 = ecs_archetypes_register_component_table(a, 100, 7, 3);
    let r = ecs_archetypes_component_index_for(a2, 999, 7);
    if r.0 != false { panic(90939); };
    let r2 = ecs_archetypes_component_index_for(a2, 100, 999);
    if r2.0 != false { panic(90940); };
}

@test "component_index_archetypes_with_single"() {
    let a = ecs_archetypes_new();
    let a2 = ecs_archetypes_register_component_table(a, 100, 7, 1);
    let r = ecs_archetypes_component_index_archetypes_with(a2, 100);
    if r.0 != 1 { panic(90941); };
    if r.1 != 7 { panic(90942); };
}

@test "component_index_archetypes_with_multiple"() {
    let a = ecs_archetypes_new();
    let a2 = ecs_archetypes_register_component_table(a, 100, 7, 1);
    let a3 = ecs_archetypes_register_component_table(a2, 100, 8, 0);
    let a4 = ecs_archetypes_register_component_sparse(a3, 100, 9);
    let r = ecs_archetypes_component_index_archetypes_with(a4, 100);
    if r.0 != 3 { panic(90943); };
    if r.1 != 7 { panic(90944); };
}

@test "component_index_archetypes_with_none"() {
    let a = ecs_archetypes_new();
    let r = ecs_archetypes_component_index_archetypes_with(a, 100);
    if r.0 != 0 { panic(90945); };
}

@test "archetypes_full_combination"() {
    let a0 = ecs_archetypes_new();
    if ecs_archetypes_len(a0) != 1 { panic(90946); };
    let r1 = ecs_archetypes_spawn_table(a0);
    let a1 = r1.0;
    let id1 = r1.1;
    let a2 = ecs_archetypes_register_component_table(a1, 50, id1, 0);
    let a3 = ecs_archetypes_register_component_sparse(a2, 51, id1);
    if ecs_archetypes_len(a3) != 2 { panic(90947); };
    if ecs_archetypes_component_index_count(a3) != 2 { panic(90948); };
    let r2 = ecs_archetypes_component_index_for(a3, 50, id1);
    if r2.1 != true { panic(90949); };
    let r3 = ecs_archetypes_component_index_for(a3, 51, id1);
    if r3.1 != false { panic(90950); };
}
