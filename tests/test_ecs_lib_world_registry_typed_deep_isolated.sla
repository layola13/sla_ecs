// Isolated deep tests for lib/world_registry_typed_deep.sla (Batch 394).
// Mirrors shallow lib/world_registry_typed.sla's RegistryTypedWorld<A,B,R,M>.
// panic codes: 143800 - 143872 (Batch 394 band; previous Batch 393 used 143700-143783).

@import "lib/world_registry_typed_deep.sla"

fn sw_w(s: EcsWrtSpawn) -> EcsWrtWorld { return ecs_wrt_spawn_world(s); }
fn sw_e(s: EcsWrtSpawn) -> EcsWrtEntity { return ecs_wrt_spawn_entity(s); }

@test "EcsWrtWorld binds values to component ids and filters A without B"() {
    let w0 = ecs_wrt_world_new();
    let s1 = ecs_wrt_world_spawn(w0);
    let w1 = sw_w(s1);
    let e1 = sw_e(s1);
    let s2 = ecs_wrt_world_spawn(w1);
    let w2 = sw_w(s2);
    let e2 = sw_e(s2);
    let w3 = ecs_wrt_insert_a(w2, e1, 1, 0);
    let w4 = ecs_wrt_insert_b(w3, e1, 4, 0);
    let w5 = ecs_wrt_insert_a(w4, e2, 2, 0);
    if ecs_wrt_has_a(w5, e1) != true { panic(143800); };
    if ecs_wrt_has_b(w5, e2) != false { panic(143801); };
    let all = ecs_wrt_query_a(w5);
    if ecs_wrt_query_a_count(all) != 2 { panic(143802); };
    let without = ecs_wrt_query_a_without_b(w5);
    if ecs_wrt_query_a_count(without) != 1 { panic(143803); };
    let only = ecs_wrt_query_a_at(without, 0);
    if only.x != 2 { panic(143804); };
}

@test "EcsWrtWorld pair writeback marks A changed but not newly added"() {
    let w0 = ecs_wrt_world_new();
    let s1 = ecs_wrt_world_spawn(w0);
    let w1 = sw_w(s1);
    let e1 = sw_e(s1);
    let w2 = ecs_wrt_insert_a(w1, e1, 3, 0);
    let w3 = ecs_wrt_insert_b(w2, e1, 5, 0);
    let before = ecs_wrt_world_change_tick(w3);
    let w4 = ecs_wrt_increment_tick(w3);
    let q = ecs_wrt_query_mut_a_b(w4);
    if ecs_wrt_pair_query_count(q) != 1 { panic(143810); };
    let a = ecs_wrt_pair_query_a_at(q, 0);
    let b = ecs_wrt_pair_query_b_at(q, 0);
    let slot = ecs_wrt_pair_query_a_slot_at(q, 0);
    let w5 = ecs_wrt_pair_write_a(w4, e1, slot, a.x + b.x, 0);
    let out = ecs_wrt_get_a(w5, e1);
    if out.x != 8 { panic(143811); };
    if ecs_wrt_a_added_since(w5, e1, before) != false { panic(143812); };
    if ecs_wrt_a_changed_since(w5, e1, before) != true { panic(143813); };
}

@test "EcsWrtWorld despawn removes registry membership and typed values"() {
    let w0 = ecs_wrt_world_new();
    let s1 = ecs_wrt_world_spawn(w0);
    let w1 = sw_w(s1);
    let e1 = sw_e(s1);
    let w2 = ecs_wrt_insert_a(w1, e1, 9, 0);
    let w3 = ecs_wrt_insert_b(w2, e1, 1, 0);
    let w4 = ecs_wrt_despawn(w3, e1);
    if ecs_wrt_is_alive(w4, e1) != false { panic(143820); };
    if ecs_wrt_has_a(w4, e1) != false { panic(143821); };
    let q = ecs_wrt_query_a(w4);
    if ecs_wrt_query_a_count(q) != 0 { panic(143822); };
}

@test "EcsWrtWorld remove_a updates query and keeps B"() {
    let w0 = ecs_wrt_world_new();
    let s1 = ecs_wrt_world_spawn(w0);
    let w1 = sw_w(s1);
    let e1 = sw_e(s1);
    let w2 = ecs_wrt_insert_a(w1, e1, 6, 0);
    let w3 = ecs_wrt_insert_b(w2, e1, 7, 0);
    let w4 = ecs_wrt_remove_a(w3, e1);
    if ecs_wrt_has_a(w4, e1) != false { panic(143830); };
    if ecs_wrt_has_b(w4, e1) != true { panic(143831); };
    let q = ecs_wrt_query_mut_a_b(w4);
    if ecs_wrt_pair_query_count(q) != 0 { panic(143832); };
}

@test "EcsWrtWorld resource and message lifecycle"() {
    let w0 = ecs_wrt_world_new();
    let w1 = ecs_wrt_insert_resource(w0, 42);
    let r = ecs_wrt_get_resource(w1);
    if ecs_wrt_time_tick(r) != 42 { panic(143840); };
    let w2 = ecs_wrt_write_message(w1, 100);
    let w3 = ecs_wrt_write_message(w2, 200);
    let reader0 = ecs_wrt_message_reader_new();
    let m1 = ecs_wrt_read_message(w3, reader0);
    if ecs_wrt_read_has_value(m1) != 1 { panic(143841); };
    if ecs_wrt_read_amount(m1) != 100 { panic(143842); };
    let reader1 = ecs_wrt_message_reader_with_cursor(ecs_wrt_read_cursor(m1));
    let m2 = ecs_wrt_read_message(w3, reader1);
    if ecs_wrt_read_amount(m2) != 200 { panic(143843); };
    let reader2 = ecs_wrt_message_reader_with_cursor(ecs_wrt_read_cursor(m2));
    let m3 = ecs_wrt_read_message(w3, reader2);
    if ecs_wrt_read_has_value(m3) != 0 { panic(143844); };
}

@test "EcsWrtWorld cap-16 spawn sentinel after slot-zero reservation"() {
    let w = ecs_wrt_world_new();
    let i: i32 = 0;
    while i < 15 {
        let sp = ecs_wrt_world_spawn(w);
        w = sw_w(sp);
        let e = sw_e(sp);
        if e.id != i + 1 { panic(143850 + i); };
        i = i + 1;
    }
    let sp16 = ecs_wrt_world_spawn(w);
    let e16 = sw_e(sp16);
    if e16.id != -1 { panic(143870); };
    if e16.generation != 0 { panic(143871); };
    if ecs_wrt_world_entity_count(w) != 15 { panic(143872); };
}
