@import "lib/message_registry_update_deep.sla"

// Batch 330: message_registry_update deep.
// panic codes: 132000 – 132199.

@test "register_count"() {
    let r = ecs_mru_deep_new();
    r = ecs_mru_deep_register(r, 1);
    r = ecs_mru_deep_register(r, 2);
    r = ecs_mru_deep_register(r, 1);
    if ecs_mru_deep_count(r) != 2 { panic(132000); };
    if ecs_mru_deep_is_registered(r, 2) != true { panic(132001); };
}

@test "deregister"() {
    let r = ecs_mru_deep_register(ecs_mru_deep_register(ecs_mru_deep_new(), 1), 2);
    r = ecs_mru_deep_deregister(r, 1);
    if ecs_mru_deep_is_registered(r, 1) != false { panic(132010); };
    if ecs_mru_deep_is_registered(r, 2) != true { panic(132011); };
    if ecs_mru_deep_count(r) != 1 { panic(132012); };
}

@test "signal_forced"() {
    let r = ecs_mru_deep_signal(ecs_mru_deep_new(), true);
    if ecs_mru_deep_has_signal(r) != true { panic(132020); };
    if ecs_mru_deep_should_update(r) != ECS_MRU_FORCED { panic(132021); };
}

@test "should_update_yes_no"() {
    let empty = ecs_mru_deep_new();
    if ecs_mru_deep_should_update(empty) != ECS_MRU_NO { panic(132030); };
    let r = ecs_mru_deep_register(empty, 3);
    if ecs_mru_deep_should_update(r) != ECS_MRU_YES { panic(132031); };
}

@test "run_updates"() {
    let r = ecs_mru_deep_register(ecs_mru_deep_new(), 1);
    r = ecs_mru_deep_run_updates(r, 10);
    if ecs_mru_deep_update_count(r) != 1 { panic(132040); };
    if ecs_mru_deep_last_tick(r) != 10 { panic(132041); };
    if ecs_mru_deep_has_signal(r) != false { panic(132042); };
}

@test "run_updates_no_op"() {
    let r = ecs_mru_deep_run_updates(ecs_mru_deep_new(), 5);
    if ecs_mru_deep_update_count(r) != 0 { panic(132050); };
}

@test "mut_iterator"() {
    let it = ecs_mmi_deep_new(3);
    if ecs_mmi_deep_len(it) != 3 { panic(132060); };
    it = ecs_mmi_deep_advance(it);
    if ecs_mmi_deep_len(it) != 2 { panic(132061); };
    it = ecs_mmi_deep_without_id(it);
    if ecs_mmi_deep_is_empty(it) != false { panic(132062); };
}

@test "par_iter_batching"() {
    let p = ecs_mmp_deep_new(10);
    p = ecs_mmp_deep_batching(p, 3);
    if ecs_mmp_deep_batch_count(p) != 4 { panic(132070); };
    if ecs_mmp_deep_for_each(p) != 10 { panic(132071); };
}

@test "capacity_four_register"() {
    let r = ecs_mru_deep_new();
    r = ecs_mru_deep_register(r, 1);
    r = ecs_mru_deep_register(r, 2);
    r = ecs_mru_deep_register(r, 3);
    r = ecs_mru_deep_register(r, 4);
    if ecs_mru_deep_count(r) != 4 { panic(132080); };
    r = ecs_mru_deep_register(r, 5);
    if ecs_mru_deep_count(r) != 4 { panic(132081); };
}

@test "forced_clears_on_update"() {
    let r = ecs_mru_deep_signal(ecs_mru_deep_new(), true);
    r = ecs_mru_deep_run_updates(r, 1);
    if ecs_mru_deep_has_signal(r) != false { panic(132090); };
    if ecs_mru_deep_update_count(r) != 1 { panic(132091); };
}
