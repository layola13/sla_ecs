@import "lib/entity_set_deep.sla"

// Batch 261: entity_set deep (src/entity/entity_set.rs).
// panic codes: 118200 – 118399.

@test "insert_unique_and_dedup"() {
    let s = ecs_es_deep_new();
    if ecs_es_deep_is_empty(s) != true { panic(118200); };
    let r = ecs_es_deep_insert(s, 1);
    s = ecs_es_insert_set(r);
    if ecs_es_insert_inserted(r) != true { panic(118201); };
    r = ecs_es_deep_insert(s, 1);
    s = ecs_es_insert_set(r);
    if ecs_es_insert_inserted(r) != false { panic(118202); };
    if ecs_es_deep_len(s) != 1 { panic(118203); };
}

@test "contains_and_at"() {
    let s = ecs_es_deep_new();
    let r = ecs_es_deep_insert(s, 10);
    s = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(s, 20);
    s = ecs_es_insert_set(r);
    if ecs_es_deep_contains(s, 10) != true { panic(118210); };
    if ecs_es_deep_contains(s, 30) != false { panic(118211); };
    if ecs_es_deep_at(s, 0) != 10 { panic(118212); };
    if ecs_es_deep_at(s, 1) != 20 { panic(118213); };
}

@test "remove_entity"() {
    let s = ecs_es_deep_new();
    let r = ecs_es_deep_insert(s, 1);
    s = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(s, 2);
    s = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(s, 3);
    s = ecs_es_insert_set(r);
    s = ecs_es_deep_remove(s, 2);
    if ecs_es_deep_len(s) != 2 { panic(118220); };
    if ecs_es_deep_contains(s, 2) != false { panic(118221); };
    if ecs_es_deep_contains(s, 1) != true { panic(118222); };
    if ecs_es_deep_contains(s, 3) != true { panic(118223); };
}

@test "list_unique_and_collect"() {
    if ecs_es_deep_list_is_unique(1, 2, 3, 4, 4) != true { panic(118230); };
    if ecs_es_deep_list_is_unique(1, 2, 1, 4, 4) != false { panic(118231); };
    let c = ecs_es_deep_collect4(1, 2, 3, 0, 3);
    if ecs_es_collect_ok(c) != true { panic(118232); };
    let s = ecs_es_collect_set(c);
    if ecs_es_deep_len(s) != 3 { panic(118233); };
    c = ecs_es_deep_collect4(1, 1, 2, 0, 3);
    if ecs_es_collect_ok(c) != false { panic(118234); };
}

@test "unique_entity_vec"() {
    let v = ecs_uev_deep_new();
    v = ecs_uev_deep_push(v, 5);
    v = ecs_uev_deep_push(v, 6);
    v = ecs_uev_deep_push(v, 5);
    if ecs_uev_deep_len(v) != 2 { panic(118240); };
    if ecs_uev_deep_contains(v, 6) != true { panic(118241); };
    if ecs_uev_deep_at(v, 0) != 5 { panic(118242); };
}

@test "intersection"() {
    let a = ecs_es_deep_new();
    let r = ecs_es_deep_insert(a, 1);
    a = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(a, 2);
    a = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(a, 3);
    a = ecs_es_insert_set(r);
    let b = ecs_es_deep_new();
    r = ecs_es_deep_insert(b, 2);
    b = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(b, 3);
    b = ecs_es_insert_set(r);
    r = ecs_es_deep_insert(b, 4);
    b = ecs_es_insert_set(r);
    let i = ecs_es_deep_intersection(a, b);
    if ecs_es_deep_len(i) != 2 { panic(118250); };
    if ecs_es_deep_contains(i, 2) != true { panic(118251); };
    if ecs_es_deep_contains(i, 3) != true { panic(118252); };
    if ecs_es_deep_contains(i, 1) != false { panic(118253); };
}

@test "entity_equivalent_helpers"() {
    if ecs_es_deep_entity_of(9) != 9 { panic(118260); };
    if ecs_es_deep_eq(1, 1) != true { panic(118261); };
    if ecs_es_deep_eq(1, 2) != false { panic(118262); };
}

@test "capacity_eight"() {
    let s = ecs_es_deep_new();
    let i = 1;
    while i <= 9 {
        let r = ecs_es_deep_insert(s, i as i64);
        s = ecs_es_insert_set(r);
        i = i + 1;
    }
    if ecs_es_deep_len(s) != 8 { panic(118270); };
}

@test "remove_missing_noop"() {
    let s = ecs_es_deep_new();
    let r = ecs_es_deep_insert(s, 1);
    s = ecs_es_insert_set(r);
    s = ecs_es_deep_remove(s, 99);
    if ecs_es_deep_len(s) != 1 { panic(118280); };
}

@test "empty_intersection"() {
    let a = ecs_es_deep_new();
    let r = ecs_es_deep_insert(a, 1);
    a = ecs_es_insert_set(r);
    let b = ecs_es_deep_new();
    r = ecs_es_deep_insert(b, 2);
    b = ecs_es_insert_set(r);
    let i = ecs_es_deep_intersection(a, b);
    if ecs_es_deep_is_empty(i) != true { panic(118290); };
}
