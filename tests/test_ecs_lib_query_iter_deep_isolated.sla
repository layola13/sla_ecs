@import "lib/query_iter_deep.sla"

// Batch 256: query_iter deep (src/query/iter.rs).
// panic codes: 117200 – 117399.

@test "push_and_len"() {
    let it = ecs_qi_deep_new();
    if ecs_qi_deep_is_empty(it) != true { panic(117200); };
    it = ecs_qi_deep_push(it, 1, 10);
    it = ecs_qi_deep_push(it, 2, 20);
    if ecs_qi_deep_len(it) != 2 { panic(117201); };
    if ecs_qi_deep_remaining(it) != 2 { panic(117202); };
}

@test "next_and_size_hint"() {
    let it = ecs_qi_deep_new();
    it = ecs_qi_deep_push(it, 1, 10);
    it = ecs_qi_deep_push(it, 2, 20);
    if ecs_qi_deep_size_hint_lower(it) != 2 { panic(117210); };
    let n = ecs_qi_deep_next(it);
    let had = ecs_qi_next_had(n);
    let ent = ecs_qi_next_entity(n);
    let val = ecs_qi_next_value(n);
    it = ecs_qi_next_iter(n);
    if had != true { panic(117211); };
    if ent != 1 { panic(117212); };
    if val != 10 { panic(117213); };
    if ecs_qi_deep_remaining(it) != 1 { panic(117214); };
    n = ecs_qi_deep_next(it);
    it = ecs_qi_next_iter(n);
    n = ecs_qi_deep_next(it);
    if ecs_qi_next_had(n) != false { panic(117215); };
}

@test "nth_and_last"() {
    let it = ecs_qi_deep_new();
    it = ecs_qi_deep_push(it, 1, 10);
    it = ecs_qi_deep_push(it, 2, 20);
    it = ecs_qi_deep_push(it, 3, 30);
    let n = ecs_qi_deep_nth(it, 1);
    if ecs_qi_next_entity(n) != 2 { panic(117220); };
    it = ecs_qi_next_iter(n);
    if ecs_qi_deep_cursor(it) != 2 { panic(117221); };
    let last = ecs_qi_deep_last(it);
    if ecs_qi_last_had(last) != true { panic(117222); };
    if ecs_qi_last_entity(last) != 3 { panic(117223); };
    if ecs_qi_last_value(last) != 30 { panic(117224); };
}

@test "sort_by_value"() {
    let it = ecs_qi_deep_new();
    it = ecs_qi_deep_push(it, 1, 30);
    it = ecs_qi_deep_push(it, 2, 10);
    it = ecs_qi_deep_push(it, 3, 20);
    it = ecs_qi_deep_sort_by_value(it);
    if ecs_qi_deep_value_at(it, 0) != 10 { panic(117230); };
    if ecs_qi_deep_entity_at(it, 0) != 2 { panic(117231); };
    if ecs_qi_deep_value_at(it, 1) != 20 { panic(117232); };
    if ecs_qi_deep_value_at(it, 2) != 30 { panic(117233); };
}

@test "capacity_eight"() {
    let it = ecs_qi_deep_new();
    it = ecs_qi_deep_push(it, 1, 1);
    it = ecs_qi_deep_push(it, 2, 2);
    it = ecs_qi_deep_push(it, 3, 3);
    it = ecs_qi_deep_push(it, 4, 4);
    it = ecs_qi_deep_push(it, 5, 5);
    it = ecs_qi_deep_push(it, 6, 6);
    it = ecs_qi_deep_push(it, 7, 7);
    it = ecs_qi_deep_push(it, 8, 8);
    it = ecs_qi_deep_push(it, 9, 9);
    if ecs_qi_deep_len(it) != 8 { panic(117240); };
}

@test "many_iter_found"() {
    let m = ecs_qmi_deep_new();
    m = ecs_qmi_deep_push_target(m, 10);
    m = ecs_qmi_deep_push_target(m, 20);
    m = ecs_qmi_deep_push_target(m, 30);
    m = ecs_qmi_deep_set_found(m, 20, 200);
    m = ecs_qmi_deep_set_found(m, 10, 100);
    if ecs_qmi_deep_found_count(m) != 2 { panic(117250); };
    let n = ecs_qmi_deep_next(m);
    let e0 = ecs_qmi_next_entity(n);
    let v0 = ecs_qmi_next_value(n);
    m = ecs_qmi_next_iter(n);
    if e0 != 10 { panic(117251); };
    if v0 != 100 { panic(117252); };
    n = ecs_qmi_deep_next(m);
    if ecs_qmi_next_entity(n) != 20 { panic(117253); };
    m = ecs_qmi_next_iter(n);
    n = ecs_qmi_deep_next(m);
    if ecs_qmi_next_had(n) != false { panic(117254); };
}

@test "many_skips_missing"() {
    let m = ecs_qmi_deep_new();
    m = ecs_qmi_deep_push_target(m, 1);
    m = ecs_qmi_deep_push_target(m, 2);
    m = ecs_qmi_deep_set_found(m, 2, 22);
    let n = ecs_qmi_deep_next(m);
    if ecs_qmi_next_entity(n) != 2 { panic(117260); };
}

@test "empty_last_and_next"() {
    let it = ecs_qi_deep_new();
    let last = ecs_qi_deep_last(it);
    if ecs_qi_last_had(last) != false { panic(117270); };
    let n = ecs_qi_deep_next(it);
    if ecs_qi_next_had(n) != false { panic(117271); };
}

@test "size_hint_upper_eq_lower"() {
    let it = ecs_qi_deep_new();
    it = ecs_qi_deep_push(it, 1, 1);
    it = ecs_qi_deep_push(it, 2, 2);
    let n = ecs_qi_deep_next(it);
    it = ecs_qi_next_iter(n);
    if ecs_qi_deep_size_hint_lower(it) != ecs_qi_deep_size_hint_upper(it) { panic(117280); };
    if ecs_qi_deep_size_hint_lower(it) != 1 { panic(117281); };
}

@test "nth_past_end"() {
    let it = ecs_qi_deep_new();
    it = ecs_qi_deep_push(it, 1, 1);
    let n = ecs_qi_deep_nth(it, 5);
    if ecs_qi_next_had(n) != false { panic(117290); };
}
