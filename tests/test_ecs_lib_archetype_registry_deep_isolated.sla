// Isolated deep tests for lib/archetype_registry_deep.sla (Batch 383).
// Mirrors shallow lib/archetype_registry.sla `RegistryArchetypeWorld` pub fns on a self-contained
// cap-8 archetypes x cap-16 entities-per-arch x cap-8 component-ids per arch storage, with the
// entity generation/alive/component-attach registry inlined (so no `@import world_registry.sla`).
// No tuple-return destructuring (wrapper structs EcsArchInfoDeep / EcsArchSpawnDeep /
// EcsArchSlotDeep / EcsArchSignDeep / EcsArchQueryDeep / EcsArchRegisterDeep with scalar accessors).
// No `let m = fn(m, ...)` chained rebinding. panic codes: 142400 - 142499.

@import "lib/archetype_registry_deep.sla"

@test "EcsArchWorldDeep new + register table/sparse_set + info accessors + counts"() {
    let w0 = ecs_arch_world_deep_new();
    if ecs_arch_world_deep_archetype_count(w0) != 1 { panic(142400); };
    if ecs_arch_world_deep_comp_count(w0) != 0 { panic(142401); };
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let info1 = ecs_arch_world_deep_register_info(r1);
    if ecs_arch_world_deep_info_id(info1) != 0 { panic(142402); };
    if ecs_arch_world_deep_info_storage(info1) != ECS_AREG_STORAGE_TABLE { panic(142403); };
    if ecs_arch_world_deep_comp_count(w1) != 1 { panic(142404); };
    let r2 = ecs_arch_world_deep_register_sparse_set_w(w1);
    let w2 = ecs_arch_world_deep_register_world(r2);
    let info2 = ecs_arch_world_deep_register_info(r2);
    if ecs_arch_world_deep_info_id(info2) != 1 { panic(142405); };
    if ecs_arch_world_deep_info_storage(info2) != ECS_AREG_STORAGE_SPARSE { panic(142406); };
    if ecs_arch_world_deep_comp_count(w2) != 2 { panic(142407); };
}

@test "EcsArchWorldDeep new spawn attaches to empty-archetype id 0"() {
    let w0 = ecs_arch_world_deep_new();
    let sp = ecs_arch_world_deep_spawn(w0);
    let w1 = ecs_arch_world_deep_spawn_world(sp);
    let e0 = ecs_arch_world_deep_spawn_entity(sp);
    if e0 != 0 { panic(142410); };
    if ecs_arch_world_deep_is_alive(w1, e0) != true { panic(142411); };
    if ecs_arch_world_deep_entity_archetype_id(w1, e0) != 0 { panic(142412); };
    if ecs_arch_world_deep_entity_row(w1, e0) != 0 { panic(142413); };
    if ecs_arch_world_deep_archetype_entity_count(w1, 0) != 1 { panic(142414); };
    let sp2 = ecs_arch_world_deep_spawn(w1);
    let w2 = ecs_arch_world_deep_spawn_world(sp2);
    let e1 = ecs_arch_world_deep_spawn_entity(sp2);
    if e1 != 1 { panic(142415); };
    if ecs_arch_world_deep_archetype_entity_count(w2, 0) != 2 { panic(142416); };
}

@test "EcsArchWorldDeep get_or_create_archetype creates matching + distinct archetypes"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let r2 = ecs_arch_world_deep_register_table_w(w1);
    let w2 = ecs_arch_world_deep_register_world(r2);
    // Signature [0] -> archetype 1 (empty=0 is still slot 0).
    let s0 = ecs_arch_world_deep_single_sign(0);
    let slot1 = ecs_arch_world_deep_get_or_create_archetype(w2, s0);
    let w3 = ecs_arch_world_deep_slot_world(slot1);
    let id1 = ecs_arch_world_deep_slot_id(slot1);
    if id1 != 1 { panic(142420); };
    // Same signature should reuse the existing archetype (id 1).
    let slot2 = ecs_arch_world_deep_get_or_create_archetype(w3, s0);
    let id2 = ecs_arch_world_deep_slot_id(slot2);
    if id2 != 1 { panic(142421); };
    let w4 = ecs_arch_world_deep_slot_world(slot2);
    if ecs_arch_world_deep_archetype_count(w4) != 2 { panic(142422); };
    // A distinct signature [1] hits a new archetype id 2.
    let s1 = ecs_arch_world_deep_single_sign(1);
    let slot3 = ecs_arch_world_deep_get_or_create_archetype(w4, s1);
    let id3 = ecs_arch_world_deep_slot_id(slot3);
    if id3 != 2 { panic(142423); };
}

@test "EcsArchWorldDeep identical signatures coalesce into the same archetype"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let r2 = ecs_arch_world_deep_register_table_w(w1);
    let w2 = ecs_arch_world_deep_register_world(r2);
    let sp1 = ecs_arch_world_deep_spawn(w2);
    let w3 = ecs_arch_world_deep_spawn_world(sp1);
    let e1 = ecs_arch_world_deep_spawn_entity(sp1);
    let sp2 = ecs_arch_world_deep_spawn(w3);
    let w4 = ecs_arch_world_deep_spawn_world(sp2);
    let e2 = ecs_arch_world_deep_spawn_entity(sp2);
    let w5 = ecs_arch_world_deep_insert_component(w4, e1, 0);
    let w6 = ecs_arch_world_deep_insert_component(w5, e1, 1);
    let w7 = ecs_arch_world_deep_insert_component(w6, e2, 1);
    let w8 = ecs_arch_world_deep_insert_component(w7, e2, 0);
    let a1 = ecs_arch_world_deep_entity_archetype_id(w8, e1);
    let a2 = ecs_arch_world_deep_entity_archetype_id(w8, e2);
    if a1 != a2 { panic(142430); };
    if ecs_arch_world_deep_archetype_entity_count(w8, a1) != 2 { panic(142431); };
    let q = ecs_arch_world_deep_query_component(w8, 0);
    if ecs_arch_world_deep_query_count(q) != 2 { panic(142432); };
    if ecs_arch_world_deep_archetype_count(w8) < 4 { panic(142433); };
}

@test "EcsArchWorldDeep remove_component migrates entity into shared archetype (mirror shallow test 2)"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let r2 = ecs_arch_world_deep_register_table_w(w1);
    let w2 = ecs_arch_world_deep_register_world(r2);
    let sp1 = ecs_arch_world_deep_spawn(w2);
    let w3 = ecs_arch_world_deep_spawn_world(sp1);
    let e1 = ecs_arch_world_deep_spawn_entity(sp1);
    let sp2 = ecs_arch_world_deep_spawn(w3);
    let w4 = ecs_arch_world_deep_spawn_world(sp2);
    let e2 = ecs_arch_world_deep_spawn_entity(sp2);
    let w5 = ecs_arch_world_deep_insert_component(w4, e1, 0);
    let w6 = ecs_arch_world_deep_insert_component(w5, e1, 1);
    let w7 = ecs_arch_world_deep_insert_component(w6, e2, 0);
    // e1 had [0, 1]; remove component 1 -> signature becomes [0], sharing e2's archetype.
    let w8 = ecs_arch_world_deep_remove_component(w7, e1, 1);
    let a1 = ecs_arch_world_deep_entity_archetype_id(w8, e1);
    let a2 = ecs_arch_world_deep_entity_archetype_id(w8, e2);
    if a1 != a2 { panic(142440); };
    if ecs_arch_world_deep_archetype_entity_count(w8, a1) != 2 { panic(142441); };
    let row_before = ecs_arch_world_deep_entity_row(w8, e1);
    if row_before < 0 { panic(142442); };
}

@test "EcsArchWorldDeep despawn detaches + bumps generation + clears stale aliases"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let sp1 = ecs_arch_world_deep_spawn(w1);
    let w2 = ecs_arch_world_deep_spawn_world(sp1);
    let e1 = ecs_arch_world_deep_spawn_entity(sp1);
    let sp2 = ecs_arch_world_deep_spawn(w2);
    let w3 = ecs_arch_world_deep_spawn_world(sp2);
    let e2 = ecs_arch_world_deep_spawn_entity(sp2);
    let w4 = ecs_arch_world_deep_insert_component(w3, e1, 0);
    let w5 = ecs_arch_world_deep_insert_component(w4, e2, 0);
    // Despawn e2; later spawn at slot 1 must reuse the slot with generation bumped.
    let w6 = ecs_arch_world_deep_despawn(w5, e2);
    if ecs_arch_world_deep_is_alive(w6, e2) != false { panic(142450); };
    if ecs_arch_world_deep_entity_archetype_id(w6, e2) != -1 { panic(142451); };
    let q1 = ecs_arch_world_deep_query_component(w6, 0);
    if ecs_arch_world_deep_query_count(q1) != 1 { panic(142452); };
    if ecs_arch_world_deep_query_entity_id(q1, 0) != e1 { panic(142453); };
    let q1e0 = ecs_arch_world_deep_query_entity_id(q1, 0);
    if q1e0 != 0 { panic(142454); };
    // Now respawn -- slot 1 reuses but with bumped generation in this deep model.
    let q1g0 = ecs_arch_world_deep_query_generation(q1, 0);
    // Generation of e1 is 0 initially after spawn (mirror Bevy start-of-world generation).
    if q1g0 != 0 { panic(142455); };
    // Detaching then despawn keeps e1's archetype count correct (e1 still alive in arch [0]).
    let a_e1 = ecs_arch_world_deep_entity_archetype_id(w6, e1);
    if ecs_arch_world_deep_archetype_entity_count(w6, a_e1) != 1 { panic(142456); };
}

@test "EcsArchWorldDeep detach swap-remove coordinate move updates location.row"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    // Spawn three entities all live in the empty-archetype 0; rows 0,1,2 for e0,e1,e2.
    let sp0 = ecs_arch_world_deep_spawn(w1);
    let w2 = ecs_arch_world_deep_spawn_world(sp0);
    let e0 = ecs_arch_world_deep_spawn_entity(sp0);
    let sp1 = ecs_arch_world_deep_spawn(w2);
    let w3 = ecs_arch_world_deep_spawn_world(sp1);
    let e1 = ecs_arch_world_deep_spawn_entity(sp1);
    let sp2 = ecs_arch_world_deep_spawn(w3);
    let w4 = ecs_arch_world_deep_spawn_world(sp2);
    let e2 = ecs_arch_world_deep_spawn_entity(sp2);
    if ecs_arch_world_deep_archetype_entity_count(w4, 0) != 3 { panic(142460); };
    if ecs_arch_world_deep_entity_row(w4, e1) != 1 { panic(142461); };
    // Remove e1 (which is at row 1, not at the tail): swap tail (e2 at row 2) into row 1; e2.row becomes 1.
    let w5 = ecs_arch_world_deep_despawn(w4, e1);
    if ecs_arch_world_deep_is_alive(w5, e1) != false { panic(142462); };
    if ecs_arch_world_deep_archetype_entity_count(w5, 0) != 2 { panic(142463); };
    if ecs_arch_world_deep_entity_row(w5, e2) != 1 { panic(142464); };
    if ecs_arch_world_deep_entity_row(w5, e0) != 0 { panic(142465); };
}

@test "EcsArchWorldDeep query_component skips despawned entities with correct generation in result"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let sp0 = ecs_arch_world_deep_spawn(w1);
    let w2 = ecs_arch_world_deep_spawn_world(sp0);
    let e0 = ecs_arch_world_deep_spawn_entity(sp0);
    let sp1 = ecs_arch_world_deep_spawn(w2);
    let w3 = ecs_arch_world_deep_spawn_world(sp1);
    let e1 = ecs_arch_world_deep_spawn_entity(sp1);
    let w4 = ecs_arch_world_deep_insert_component(w3, e0, 0);
    let w5 = ecs_arch_world_deep_insert_component(w4, e1, 0);
    let q0 = ecs_arch_world_deep_query_component(w5, 0);
    if ecs_arch_world_deep_query_count(q0) != 2 { panic(142470); };
    // Despawn e0 -- g0 becomes 1; e1 stays with gen 0; query for component 0 returns e1 only.
    let w6 = ecs_arch_world_deep_despawn(w5, e0);
    let q1 = ecs_arch_world_deep_query_component(w6, 0);
    if ecs_arch_world_deep_query_count(q1) != 1 { panic(142471); };
    if ecs_arch_world_deep_query_entity_id(q1, 0) != e1 { panic(142472); };
    if ecs_arch_world_deep_query_generation(q1, 0) != 0 { panic(142473); };
}

@test "EcsArchWorldDeep insert + remove + insert returns to lower-archetype-id"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let sp = ecs_arch_world_deep_spawn(w1);
    let w2 = ecs_arch_world_deep_spawn_world(sp);
    let e0 = ecs_arch_world_deep_spawn_entity(sp);
    // Insert [0]; archetype 1.
    let w3 = ecs_arch_world_deep_insert_component(w2, e0, 0);
    let a_after_insert = ecs_arch_world_deep_entity_archetype_id(w3, e0);
    if a_after_insert != 1 { panic(142480); };
    // Remove [0]; back to empty-archetype (id 0).
    let w4 = ecs_arch_world_deep_remove_component(w3, e0, 0);
    let a_after_remove = ecs_arch_world_deep_entity_archetype_id(w4, e0);
    if a_after_remove != 0 { panic(142481); };
    let row_after_remove = ecs_arch_world_deep_entity_row(w4, e0);
    if row_after_remove < 0 { panic(142482); };
    // Re-insert [0] -- reuses archetype 1 (already in the table from the earlier get_or_create).
    let w5 = ecs_arch_world_deep_insert_component(w4, e0, 0);
    let a_re_insert = ecs_arch_world_deep_entity_archetype_id(w5, e0);
    if a_re_insert != 1 { panic(142483); };
    if ecs_arch_world_deep_archetype_entity_count(w5, 1) != 1 { panic(142484); };
}

@test "EcsArchWorldDeep cap-8 components reject silent beyond ECS_AREG_COMP_CAP"() {
    let w0 = ecs_arch_world_deep_new();
    let r1 = ecs_arch_world_deep_register_table_w(w0);
    let w1 = ecs_arch_world_deep_register_world(r1);
    let r2 = ecs_arch_world_deep_register_table_w(w1);
    let w2 = ecs_arch_world_deep_register_world(r2);
    let r3 = ecs_arch_world_deep_register_table_w(w2);
    let w3 = ecs_arch_world_deep_register_world(r3);
    let r4 = ecs_arch_world_deep_register_table_w(w3);
    let w4 = ecs_arch_world_deep_register_world(r4);
    let r5 = ecs_arch_world_deep_register_sparse_set_w(w4);
    let w5 = ecs_arch_world_deep_register_world(r5);
    let r6 = ecs_arch_world_deep_register_table_w(w5);
    let w6 = ecs_arch_world_deep_register_world(r6);
    let r7 = ecs_arch_world_deep_register_table_w(w6);
    let w7 = ecs_arch_world_deep_register_world(r7);
    let r8 = ecs_arch_world_deep_register_table_w(w7);
    let w8 = ecs_arch_world_deep_register_world(r8);
    if ecs_arch_world_deep_comp_count(w8) != 8 { panic(142490); };
    let reg_overflow = ecs_arch_world_deep_register_table_w(w8);
    let w9 = ecs_arch_world_deep_register_world(reg_overflow);
    let info_overflow = ecs_arch_world_deep_register_info(reg_overflow);
    if ecs_arch_world_deep_comp_count(w9) != 8 { panic(142491); };
    if ecs_arch_world_deep_info_id(info_overflow) != 7 { panic(142492); };
    let sp = ecs_arch_world_deep_spawn(w9);
    let w10 = ecs_arch_world_deep_spawn_world(sp);
    let e0 = ecs_arch_world_deep_spawn_entity(sp);
    // Insert component id=7 succeeds (within cap-8).
    let w11 = ecs_arch_world_deep_insert_component(w10, e0, 7);
    let q7 = ecs_arch_world_deep_query_component(w11, 7);
    if ecs_arch_world_deep_query_count(q7) != 1 { panic(142493); };
    // Insert component id=8 silently rejects (>= cap-8 -> no-op).
    let w12 = ecs_arch_world_deep_insert_component(w11, e0, 8);
    let q8 = ecs_arch_world_deep_query_component(w12, 8);
    if ecs_arch_world_deep_query_count(q8) != 0 { panic(142494); };
    if ecs_arch_world_deep_query_found(q8) != false { panic(142495); };
    // Spawn past cap-16 silently rejects (returns -1).
    let w_e0 = ecs_arch_world_deep_spawn(w11);
    let handled_spawn = ecs_arch_world_deep_spawn_entity(w_e0);
    if handled_spawn == -1 { panic(142496); };
    // The world returned through spawn should still register the cap-16 reject as the next entity absent.
    // we verify no panic / silent reject of further cap-8 archetype creates with all-component signature:
    let s_all = ecs_arch_world_deep_single_sign(0);
    let slot = ecs_arch_world_deep_get_or_create_archetype(w11, s_all);
    let slot_id = ecs_arch_world_deep_slot_id(slot);
    if slot_id < 0 { panic(142497); };
    if slot_id != ecs_arch_world_deep_find_archetype(ecs_arch_world_deep_slot_world(slot), s_all) { panic(142498); };
    if ecs_arch_world_deep_arch_components_count(ecs_arch_world_deep_slot_world(slot), slot_id) != 1 { panic(142499); };
}
