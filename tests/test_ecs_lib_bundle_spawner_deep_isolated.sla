@import "lib/bundle_spawner_deep.sla"

// Batch 341: bundle_spawner deep.
// panic codes: 134200 – 134399.

@test "spawner_new"() {
    let s = ecs_bsd_spawner_new(7, 3);
    if ecs_bsd_spawner_world(s) != 7 { panic(134200); };
    if ecs_bsd_spawner_tick(s) != 3 { panic(134201); };
    if ecs_bsd_spawner_is_empty(s) != true { panic(134202); };
}

@test "spawner_spawn_get"() {
    let s = ecs_bsd_spawner_spawn(ecs_bsd_spawner_new(1, 0), 100);
    s = ecs_bsd_spawner_spawn(s, 200);
    if ecs_bsd_spawner_len(s) != 2 { panic(134210); };
    if ecs_bsd_spawner_get(s, 0) != 100 { panic(134211); };
    if ecs_bsd_spawner_get(s, 1) != 200 { panic(134212); };
}

@test "spawner_reserve_batch"() {
    let s = ecs_bsd_spawner_reserve(ecs_bsd_spawner_new(1, 0), 5);
    if ecs_bsd_spawner_reserved(s) != 5 { panic(134220); };
    s = ecs_bsd_spawner_spawn_batch4(s, 1, 2, 3, 4);
    if ecs_bsd_spawner_len(s) != 4 { panic(134221); };
    if ecs_bsd_spawner_get(s, 3) != 4 { panic(134222); };
}

@test "spawner_capacity_four"() {
    let s = ecs_bsd_spawner_spawn_batch4(ecs_bsd_spawner_new(1, 0), 1, 2, 3, 4);
    let full = ecs_bsd_spawner_spawn(s, 5);
    if ecs_bsd_spawner_len(full) != 4 { panic(134230); };
}

@test "insert_targets"() {
    let ib = ecs_bsd_insert_new(2, 9, 55);
    if ecs_bsd_insert_bundle_type(ib) != 55 { panic(134240); };
    if ecs_bsd_insert_is_empty(ib) != true { panic(134241); };
    ib = ecs_bsd_insert_target(ib, 10);
    ib = ecs_bsd_insert_target(ib, 20);
    if ecs_bsd_insert_len(ib) != 2 { panic(134242); };
    if ecs_bsd_insert_get(ib, 0) != 10 { panic(134243); };
    if ecs_bsd_insert_get(ib, 1) != 20 { panic(134244); };
    if ecs_bsd_insert_world(ib) != 2 { panic(134245); };
}

@test "insert_capacity_four"() {
    let ib = ecs_bsd_insert_new(1, 0, 1);
    ib = ecs_bsd_insert_target(ib, 1);
    ib = ecs_bsd_insert_target(ib, 2);
    ib = ecs_bsd_insert_target(ib, 3);
    ib = ecs_bsd_insert_target(ib, 4);
    let full = ecs_bsd_insert_target(ib, 5);
    if ecs_bsd_insert_len(full) != 4 { panic(134250); };
}

@test "inserter_counts"() {
    let bi = ecs_bsd_inserter_new(3, 1, 77);
    if ecs_bsd_inserter_bundle_type(bi) != 77 { panic(134260); };
    bi = ecs_bsd_inserter_insert(bi);
    bi = ecs_bsd_inserter_insert(bi);
    if ecs_bsd_inserter_count(bi) != 2 { panic(134261); };
    bi = ecs_bsd_inserter_insert_batch(bi, 5);
    if ecs_bsd_inserter_count(bi) != 7 { panic(134262); };
}

@test "remover_counts"() {
    let br = ecs_bsd_remover_new(4, 2, 88);
    if ecs_bsd_remover_bundle_type(br) != 88 { panic(134270); };
    br = ecs_bsd_remover_remove(br);
    br = ecs_bsd_remover_remove(br);
    br = ecs_bsd_remover_remove(br);
    if ecs_bsd_remover_count(br) != 3 { panic(134271); };
}

@test "spawner_tick_preserved"() {
    let s = ecs_bsd_spawner_spawn(ecs_bsd_spawner_new(9, 42), 1);
    if ecs_bsd_spawner_tick(s) != 42 { panic(134280); };
    if ecs_bsd_spawner_world(s) != 9 { panic(134281); };
}

@test "insert_empty_after_new"() {
    let ib = ecs_bsd_insert_new(1, 0, 1);
    if ecs_bsd_insert_len(ib) != 0 { panic(134290); };
    if ecs_bsd_insert_get(ib, 0) != 0 { panic(134291); };
}
