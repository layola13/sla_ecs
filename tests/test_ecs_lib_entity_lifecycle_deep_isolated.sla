@import "lib/entity_lifecycle_deep.sla"

// Batch 249: entity_lifecycle deep (entity_disabling + lifecycle hooks/removed).
// panic codes: 115800 – 115999.

@test "dqf_register_and_is_disabling"() {
    let f = ecs_dqf_deep_new();
    if ecs_dqf_deep_len(f) != 0 { panic(115800); };
    f = ecs_dqf_deep_register(f, 10);
    f = ecs_dqf_deep_register(f, 11);
    f = ecs_dqf_deep_register(f, 10);
    if ecs_dqf_deep_len(f) != 2 { panic(115801); };
    if ecs_dqf_deep_is_disabling(f, 10) != true { panic(115802); };
    if ecs_dqf_deep_is_disabling(f, 99) != false { panic(115803); };
    let first = ecs_dqf_deep_first(f);
    if first.0 != true { panic(115804); };
    if first.1 != 10 { panic(115805); };
}

@test "dqf_entity_disabled_unless_mentioned"() {
    let f = ecs_dqf_deep_new();
    f = ecs_dqf_deep_register(f, 5);
    // entity has disabling 5, query doesn't mention -> disabled
    if ecs_dqf_deep_entity_disabled(f, 5, 0, 1, 1, 0, 1) != true { panic(115810); };
    // query mentions 5 -> not disabled by filter
    if ecs_dqf_deep_entity_disabled(f, 5, 0, 1, 5, 0, 1) != false { panic(115811); };
    // entity has no disabling
    if ecs_dqf_deep_entity_disabled(f, 1, 2, 2, 0, 0, 0) != false { panic(115812); };
}

@test "hooks_set_and_has"() {
    let h = ecs_hooks_deep_new();
    h = ecs_hooks_deep_on_add(h, 1);
    h = ecs_hooks_deep_on_insert(h, 2);
    h = ecs_hooks_deep_on_remove(h, 3);
    if ecs_hooks_deep_has_on_add(h) != true { panic(115820); };
    if ecs_hooks_deep_has_on_insert(h) != true { panic(115821); };
    if ecs_hooks_deep_has_on_discard(h) != false { panic(115822); };
    if ecs_hooks_deep_has_on_remove(h) != true { panic(115823); };
    if ecs_hooks_deep_to_flags(h) != (1 | 2 | 8) { panic(115824); };
}

@test "hooks_try_only_once"() {
    let h = ecs_hooks_deep_new();
    let r = ecs_hooks_deep_try_on_add(h, 9);
    h = r.1;
    if r.0 != true { panic(115830); };
    r = ecs_hooks_deep_try_on_add(h, 10);
    h = r.1;
    if r.0 != false { panic(115831); };
    if h.on_add != 9 { panic(115832); };
    r = ecs_hooks_deep_try_on_insert(h, 11);
    h = r.1;
    if r.0 != true { panic(115833); };
}

@test "hooks_despawn_discard"() {
    let h = ecs_hooks_deep_new();
    h = ecs_hooks_deep_on_discard(h, 4);
    h = ecs_hooks_deep_on_despawn(h, 5);
    if ecs_hooks_deep_has_on_discard(h) != true { panic(115840); };
    if ecs_hooks_deep_has_on_despawn(h) != true { panic(115841); };
    if ecs_hooks_deep_to_flags(h) != (4 | 16) { panic(115842); };
}

@test "removed_write_read_cursor"() {
    let r = ecs_removed_deep_new(7);
    if ecs_removed_deep_is_empty(r) != true { panic(115850); };
    r = ecs_removed_deep_write(r, 100);
    r = ecs_removed_deep_write(r, 101);
    r = ecs_removed_deep_write(r, 102);
    if ecs_removed_deep_len(r) != 3 { panic(115851); };
    if ecs_removed_deep_component_id(r) != 7 { panic(115852); };
    let rd = ecs_removed_deep_read(r);
    let had0 = ecs_removed_deep_read_had(rd);
    let ent0 = ecs_removed_deep_read_entity(rd);
    r = ecs_removed_deep_read_state(rd);
    if had0 != true { panic(115853); };
    if ent0 != 100 { panic(115854); };
    rd = ecs_removed_deep_read(r);
    let ent1 = ecs_removed_deep_read_entity(rd);
    r = ecs_removed_deep_read_state(rd);
    if ent1 != 101 { panic(115855); };
    if ecs_removed_deep_cursor(r) != 2 { panic(115856); };
    if ecs_removed_deep_has_unread(r) != true { panic(115857); };
}

@test "removed_reset_and_clear"() {
    let r = ecs_removed_deep_new(1);
    r = ecs_removed_deep_write(r, 1);
    r = ecs_removed_deep_write(r, 2);
    let rd = ecs_removed_deep_read(r);
    r = ecs_removed_deep_read_state(rd);
    r = ecs_removed_deep_reset_cursor(r);
    if ecs_removed_deep_cursor(r) != 0 { panic(115860); };
    rd = ecs_removed_deep_read(r);
    let ent = ecs_removed_deep_read_entity(rd);
    r = ecs_removed_deep_read_state(rd);
    if ent != 1 { panic(115861); };
    r = ecs_removed_deep_clear(r);
    if ecs_removed_deep_len(r) != 0 { panic(115862); };
    if ecs_removed_deep_is_empty(r) != true { panic(115863); };
}

@test "removed_read_exhausted"() {
    let r = ecs_removed_deep_new(2);
    r = ecs_removed_deep_write(r, 9);
    let rd = ecs_removed_deep_read(r);
    let had0 = ecs_removed_deep_read_had(rd);
    let ent0 = ecs_removed_deep_read_entity(rd);
    r = ecs_removed_deep_read_state(rd);
    if had0 != true { panic(115868); };
    if ent0 != 9 { panic(115869); };
    rd = ecs_removed_deep_read(r);
    let had1 = ecs_removed_deep_read_had(rd);
    r = ecs_removed_deep_read_state(rd);
    if had1 != false { panic(115870); };
    if ecs_removed_deep_has_unread(r) != false { panic(115871); };
}

@test "dqf_capacity_four"() {
    let f = ecs_dqf_deep_new();
    f = ecs_dqf_deep_register(f, 1);
    f = ecs_dqf_deep_register(f, 2);
    f = ecs_dqf_deep_register(f, 3);
    f = ecs_dqf_deep_register(f, 4);
    f = ecs_dqf_deep_register(f, 5);
    if ecs_dqf_deep_len(f) != 4 { panic(115880); };
    if ecs_dqf_deep_is_disabling(f, 4) != true { panic(115881); };
    if ecs_dqf_deep_is_disabling(f, 5) != false { panic(115882); };
}

@test "hooks_try_on_remove"() {
    let h = ecs_hooks_deep_new();
    let r = ecs_hooks_deep_try_on_remove(h, 20);
    h = r.1;
    if r.0 != true { panic(115890); };
    r = ecs_hooks_deep_try_on_remove(h, 21);
    if r.0 != false { panic(115891); };
}
