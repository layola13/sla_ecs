@import "lib/clone_entities_deep.sla"

// Batch 299: clone_entities deep.
// panic codes: 125800 – 125999.

@test "source_component_read"() {
    let s = ecs_ce_src_new(3, 16, 99);
    if ecs_ce_src_id(s) != 3 { panic(125800); };
    if ecs_ce_src_size(s) != 16 { panic(125801); };
    if ecs_ce_src_ptr(s) != 99 { panic(125802); };
    let ok = ecs_ce_src_read(s, 3);
    if ecs_ce_read_ok(ok) != true { panic(125803); };
    if ecs_ce_read_value(ok) != 99 { panic(125804); };
    let miss = ecs_ce_src_read(s, 4);
    if ecs_ce_read_ok(miss) != false { panic(125805); };
}

@test "mapper_get_or_alloc"() {
    let m = ecs_ce_map_new(100);
    let g = ecs_ce_map_get_or_alloc(m, 1);
    if ecs_ce_map_get_ok(g) != true { panic(125810); };
    if ecs_ce_map_get_target(g) != 100 { panic(125811); };
    m = ecs_ce_map_get_map(g);
    if ecs_ce_map_len(m) != 1 { panic(125812); };
    let g2 = ecs_ce_map_get_or_alloc(m, 1);
    if ecs_ce_map_get_target(g2) != 100 { panic(125813); };
    m = ecs_ce_map_get_map(g2);
    if ecs_ce_map_len(m) != 1 { panic(125814); };
    let g3 = ecs_ce_map_get_or_alloc(m, 2);
    if ecs_ce_map_get_target(g3) != 101 { panic(125815); };
}

@test "mapper_resolve_and_has"() {
    let m = ecs_ce_map_new(10);
    m = ecs_ce_map_get_map(ecs_ce_map_get_or_alloc(m, 5));
    if ecs_ce_map_has(m, 5) != true { panic(125820); };
    if ecs_ce_map_has(m, 6) != false { panic(125821); };
    if ecs_ce_map_resolve(m, 5) != 10 { panic(125822); };
    if ecs_ce_map_resolve(m, 6) != 6 { panic(125823); };
}

@test "clone_ctx_write_and_queue"() {
    let c = ecs_ce_ctx_new(1, 10, 20, 8, false);
    if ecs_ce_ctx_written(c) != false { panic(125830); };
    c = ecs_ce_ctx_write(c);
    if ecs_ce_ctx_written(c) != true { panic(125831); };
    c = ecs_ce_ctx_write_moved(c);
    if ecs_ce_ctx_moved(c) != true { panic(125832); };
    c = ecs_ce_ctx_set_linked(c, true);
    if ecs_ce_ctx_linked(c) != true { panic(125833); };
    c = ecs_ce_ctx_queue_entity(c, 50);
    c = ecs_ce_ctx_queue_entity(c, 51);
    if ecs_ce_ctx_qlen(c) != 2 { panic(125834); };
    if ecs_ce_ctx_queued_at(c, 0) != 50 { panic(125835); };
    if ecs_ce_ctx_queued_at(c, 1) != 51 { panic(125836); };
}

@test "state_override_behavior"() {
    let s = ecs_ce_state_new();
    if ecs_ce_state_default(s) != 1 { panic(125840); };
    s = ecs_ce_state_set_default(s, 0);
    if ecs_ce_state_behavior_of(s, 9) != 0 { panic(125841); };
    s = ecs_ce_state_override(s, 3, 1);
    if ecs_ce_state_behavior_of(s, 3) != 1 { panic(125842); };
    if ecs_ce_state_should_write(s, 9) != false { panic(125843); };
    if ecs_ce_state_should_write(s, 3) != true { panic(125844); };
}

@test "state_flags_and_apply_clone"() {
    let s = ecs_ce_state_set_moving(ecs_ce_state_new(), true);
    s = ecs_ce_state_set_linked(s, true);
    if ecs_ce_state_moving(s) != true { panic(125850); };
    if ecs_ce_state_linked(s) != true { panic(125851); };
    s = ecs_ce_state_override(s, 1, 2); // move
    let src = ecs_ce_src_new(1, 4, 7);
    let ctx = ecs_ce_ctx_new(1, 1, 2, 4, true);
    ctx = ecs_ce_apply(s, src, ctx);
    if ecs_ce_ctx_moved(ctx) != true { panic(125852); };
}

@test "apply_ignore_skips_write"() {
    let s = ecs_ce_state_override(ecs_ce_state_new(), 5, 0);
    let src = ecs_ce_src_new(5, 1, 1);
    let ctx = ecs_ce_ctx_new(5, 1, 2, 1, false);
    ctx = ecs_ce_apply(s, src, ctx);
    if ecs_ce_ctx_written(ctx) != false { panic(125860); };
}

@test "mapper_capacity_four"() {
    let m = ecs_ce_map_new(1);
    m = ecs_ce_map_get_map(ecs_ce_map_get_or_alloc(m, 1));
    m = ecs_ce_map_get_map(ecs_ce_map_get_or_alloc(m, 2));
    m = ecs_ce_map_get_map(ecs_ce_map_get_or_alloc(m, 3));
    m = ecs_ce_map_get_map(ecs_ce_map_get_or_alloc(m, 4));
    if ecs_ce_map_len(m) != 4 { panic(125870); };
    let full = ecs_ce_map_get_or_alloc(m, 5);
    if ecs_ce_map_get_ok(full) != false { panic(125871); };
}

@test "ctx_accessors"() {
    let c = ecs_ce_ctx_new(9, 100, 200, 32, true);
    if ecs_ce_ctx_component_id(c) != 9 { panic(125880); };
    if ecs_ce_ctx_source(c) != 100 { panic(125881); };
    if ecs_ce_ctx_target(c) != 200 { panic(125882); };
    if ecs_ce_ctx_size(c) != 32 { panic(125883); };
    if ecs_ce_ctx_moving(c) != true { panic(125884); };
}

@test "default_clone_apply"() {
    let s = ecs_ce_state_new();
    let src = ecs_ce_src_new(2, 8, 55);
    let ctx = ecs_ce_apply(s, src, ecs_ce_ctx_new(2, 1, 2, 8, false));
    if ecs_ce_ctx_written(ctx) != true { panic(125890); };
    if ecs_ce_ctx_moved(ctx) != false { panic(125891); };
}
