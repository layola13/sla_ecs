@import "lib/required_components_dynamic.sla"

// Isolated tests for lib/required_components_dynamic.sla — RequiredComponents register_by_id +
// register_dynamic_with + RequiredComponentsRegistrator::register_required_by_id +
// register_required_dynamic_with + components_registrator accessor. Bevy reference:
// src/component/required.rs (dynamic registration gaps not in lib/component_required.sla).

const COMP_A: i32 = 3101;
const COMP_B: i32 = 3102;
const COMP_C: i32 = 3103;
const CTOR_X: i32 = 1;
const CTOR_Y: i32 = 2;
const CTOR_Z: i32 = 3;
const TGT: i32 = 3001;
const DUP_KIND: i32 = 0;

@test "dyn_new_empty_direct_and_all"() {
    let r = ecs_required_components_dyn_new();
    if ecs_required_components_dyn_direct_count(r) != 0 { panic(91647); };
    if ecs_required_components_dyn_all_count(r) != 0 { panic(91648); };
}

@test "dyn_register_dynamic_with_grows_direct_and_all"() {
    let r = ecs_required_components_dyn_new();
    let res = ecs_required_components_dyn_register_dynamic_with(r, COMP_A, CTOR_X);
    if ecs_req_dyn_ok(res) != 1 { panic(91649); };
    if ecs_req_dyn_err_kind(res) != -1 { panic(91650); };
    if ecs_req_dyn_direct_len(res) != 1 { panic(91651); };
    if ecs_req_dyn_all_len(res) != 1 { panic(91652); };
}

@test "dyn_register_dynamic_with_duplicated_id_returns_err"() {
    let r = ecs_required_components_dyn_new();
    let res1 = ecs_required_components_dyn_register_dynamic_with(r, COMP_A, CTOR_X);
    if ecs_req_dyn_ok(res1) != 1 { panic(91653); };
    let res2 = ecs_required_components_dyn_register_dynamic_with(r, COMP_A, CTOR_Y);
    if ecs_req_dyn_ok(res2) != 0 { panic(91654); };
    if ecs_req_dyn_err_kind(res2) != DUP_KIND { panic(91655); };
}

@test "dyn_register_by_id_equivalent_to_dynamic_with"() {
    let r = ecs_required_components_dyn_new();
    let res = ecs_required_components_dyn_register_by_id(r, COMP_B, CTOR_Y);
    if ecs_req_dyn_ok(res) != 1 { panic(91656); };
    if ecs_req_dyn_direct_len(res) != 1 { panic(91657); };
    if ecs_req_dyn_all_len(res) != 1 { panic(91658); };
}

@test "dyn_direct_at_bounds_check"() {
    let r0 = ecs_required_components_dyn_new();
    let r = ecs_required_components_dyn_register_dynamic_with_mut(r0, COMP_A, CTOR_X);
    if ecs_required_components_dyn_direct_at(r, 0) != COMP_A { panic(91659); };
    if ecs_required_components_dyn_direct_at(r, -1) != -1 { panic(91660); };
    if ecs_required_components_dyn_direct_at(r, 5) != -1 { panic(91661); };
}

@test "dyn_all_at_bounds_check"() {
    let r0 = ecs_required_components_dyn_new();
    let r = ecs_required_components_dyn_register_dynamic_with_mut(r0, COMP_A, CTOR_X);
    if ecs_required_components_dyn_all_at(r, 0) != COMP_A { panic(91662); };
    if ecs_required_components_dyn_all_at(r, 3) != -1 { panic(91663); };
}

@test "dyn_iter_count_and_nth"() {
    let r0 = ecs_required_components_dyn_new();
    let r = ecs_required_components_dyn_register_dynamic_with_mut(r0, COMP_A, CTOR_X);
    if ecs_required_components_dyn_iter_count(r) != 1 { panic(91664); };
    if ecs_required_components_dyn_iter_nth(r, 0) != COMP_A { panic(91665); };
}

@test "reg_dyn_new_empty"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    if ecs_required_components_registrator_dyn_target(r) != TGT { panic(91666); };
    if ecs_required_components_registrator_dyn_required_direct_count(r) != 0 { panic(91667); };
    if ecs_required_components_registrator_dyn_required_all_count(r) != 0 { panic(91668); };
    if ecs_required_components_registrator_dyn_last_ok(r) != 1 { panic(91669); };
    if ecs_required_components_registrator_dyn_last_err_kind(r) != -1 { panic(91670); };
}

@test "reg_dyn_components_next_id_default"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    if ecs_required_components_registrator_dyn_components_next_id(r) != 100 { panic(91671); };
}

@test "reg_dyn_register_required_by_id_success"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    let r2 = ecs_required_components_registrator_dyn_register_required_by_id(r, COMP_A, CTOR_X);
    if ecs_required_components_registrator_dyn_last_ok(r2) != 1 { panic(91672); };
    if ecs_required_components_registrator_dyn_last_err_kind(r2) != -1 { panic(91673); };
    if ecs_required_components_registrator_dyn_required_direct_count(r2) != 1 { panic(91674); };
    if ecs_required_components_registrator_dyn_required_all_count(r2) != 1 { panic(91675); };
    if ecs_required_components_registrator_dyn_required_direct_at(r2, 0) != COMP_A { panic(91676); };
    if ecs_required_components_registrator_dyn_required_all_at(r2, 0) != COMP_A { panic(91677); };
}

@test "reg_dyn_register_required_by_id_duplicate_returns_err"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    let r2 = ecs_required_components_registrator_dyn_register_required_by_id(r, COMP_A, CTOR_X);
    if ecs_required_components_registrator_dyn_last_ok(r2) != 1 { panic(91678); };
    let r3 = ecs_required_components_registrator_dyn_register_required_by_id(r2, COMP_A, CTOR_Y);
    if ecs_required_components_registrator_dyn_last_ok(r3) != 0 { panic(91679); };
    if ecs_required_components_registrator_dyn_last_err_kind(r3) != DUP_KIND { panic(91680); };
    // duplicate did NOT mutate the required set
    if ecs_required_components_registrator_dyn_required_direct_count(r3) != 1 { panic(91681); };
    if ecs_required_components_registrator_dyn_required_direct_at(r3, 0) != COMP_A { panic(91682); };
}

@test "reg_dyn_register_required_dynamic_with_success"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    let r2 = ecs_required_components_registrator_dyn_register_required_dynamic_with(r, COMP_B, CTOR_Y);
    if ecs_required_components_registrator_dyn_last_ok(r2) != 1 { panic(91683); };
    if ecs_required_components_registrator_dyn_required_direct_count(r2) != 1 { panic(91684); };
    if ecs_required_components_registrator_dyn_required_all_at(r2, 0) != COMP_B { panic(91685); };
}

@test "reg_dyn_register_required_dynamic_with_duplicate"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    let r2 = ecs_required_components_registrator_dyn_register_required_dynamic_with(r, COMP_C, CTOR_Z);
    if ecs_required_components_registrator_dyn_last_ok(r2) != 1 { panic(91686); };
    let r3 = ecs_required_components_registrator_dyn_register_required_dynamic_with(r2, COMP_C, CTOR_X);
    if ecs_required_components_registrator_dyn_last_ok(r3) != 0 { panic(91687); };
    if ecs_required_components_registrator_dyn_last_err_kind(r3) != DUP_KIND { panic(91688); };
}

@test "reg_dyn_two_distinct_ids_grow_chains"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    let r2 = ecs_required_components_registrator_dyn_register_required_by_id(r, COMP_A, CTOR_X);
    let r3 = ecs_required_components_registrator_dyn_register_required_dynamic_with(r2, COMP_B, CTOR_Y);
    if ecs_required_components_registrator_dyn_last_ok(r3) != 1 { panic(91689); };
    if ecs_required_components_registrator_dyn_required_direct_count(r3) != 2 { panic(91690); };
    if ecs_required_components_registrator_dyn_required_all_count(r3) != 2 { panic(91691); };
    // new id COMP_B prepended to all at head (depth-first)
    if ecs_required_components_registrator_dyn_required_all_at(r3, 0) != COMP_B { panic(91692); };
    if ecs_required_components_registrator_dyn_required_all_at(r3, 1) != COMP_A { panic(91693); };
}

@test "reg_dyn_target_preserved_through_registrations"() {
    let r = ecs_required_components_registrator_dyn_new(TGT);
    let r2 = ecs_required_components_registrator_dyn_register_required_by_id(r, COMP_A, CTOR_X);
    let r3 = ecs_required_components_registrator_dyn_register_required_dynamic_with(r2, COMP_B, CTOR_Y);
    if ecs_required_components_registrator_dyn_target(r3) != TGT { panic(91694); };
    if ecs_required_components_registrator_dyn_components_next_id(r3) != 100 { panic(91695); };
}

@test "dyn_chained_two_ids_all_head_ordering"() {
    let r0 = ecs_required_components_dyn_new();
    let r1 = ecs_required_components_dyn_register_dynamic_with_mut(r0, COMP_A, CTOR_X);
    let r = ecs_required_components_dyn_register_dynamic_with_mut(r1, COMP_B, CTOR_Y);
    if ecs_required_components_dyn_iter_count(r) != 2 { panic(91696); };
    if ecs_required_components_dyn_direct_count(r) != 2 { panic(91697); };
    if ecs_required_components_dyn_all_at(r, 0) != COMP_B { panic(91698); };
    if ecs_required_components_dyn_all_at(r, 1) != COMP_A { panic(91699); };
}
