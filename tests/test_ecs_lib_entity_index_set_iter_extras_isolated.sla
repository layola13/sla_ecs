@import "lib/entity_index_set_iter_extras.sla"

// Isolated tests for lib/entity_index_set_iter_extras.sla.
// Bevy reference: bevy_ecs/src/entity/index_set.rs remaining iterator and Slice impls.

fn make_eis3_4() -> EcsEis3Set {
    let values: Vec<i64> = Vec::new();
    values.push(10);
    values.push(20);
    values.push(30);
    values.push(40);
    return ecs_eis3_from_vec(values);
}

fn make_eis3_other() -> EcsEis3Set {
    let values: Vec<i64> = Vec::new();
    values.push(30);
    values.push(50);
    values.push(10);
    return ecs_eis3_from_vec(values);
}

@test "entity index set iter extras bound range included excluded"() {
    let result = ecs_eis3_set_bound_range(make_eis3_4(), ecs_eis3_bound_included(1), ecs_eis3_bound_excluded(3));
    if result.has != 1 { panic(92690); };
    if ecs_eis3_slice_len(result.slice) != 2 { panic(92691); };
    let first = ecs_eis3_slice_range(result.slice, 0, 1);
    if first.has != 1 { panic(92692); };
}

@test "entity index set iter extras bound unbounded to included"() {
    let result = ecs_eis3_set_bound_range(make_eis3_4(), ecs_eis3_bound_unbounded(), ecs_eis3_bound_included(1));
    if result.has != 1 { panic(92693); };
    if ecs_eis3_slice_len(result.slice) != 2 { panic(92694); };
}

@test "entity index set iter extras bound excluded to unbounded"() {
    let result = ecs_eis3_set_bound_range(make_eis3_4(), ecs_eis3_bound_excluded(1), ecs_eis3_bound_unbounded());
    if result.has != 1 { panic(92695); };
    if ecs_eis3_slice_len(result.slice) != 2 { panic(92696); };
}

@test "entity index set iter extras invalid bound range none"() {
    let result = ecs_eis3_set_bound_range(make_eis3_4(), ecs_eis3_bound_included(3), ecs_eis3_bound_excluded(2));
    if result.has != 0 { panic(92697); };
}

@test "entity index set iter extras slice unchecked mut marker"() {
    let slice = ecs_eis3_as_slice(make_eis3_4());
    let mutable_slice = ecs_eis3_from_slice_unchecked_mut(slice);
    let inner = ecs_eis3_slice_as_inner(mutable_slice);
    if inner.mutable_view != 1 { panic(92698); };
    if inner.inner_view != 1 { panic(92699); };
    if inner.len != 4 { panic(92700); };
}

@test "entity index set iter extras boxed as inner marker"() {
    let boxed = ecs_eis3_slice_boxed(make_eis3_4());
    let inner = ecs_eis3_boxed_as_inner(boxed);
    if inner.boxed != 1 { panic(92701); };
    if inner.inner_view != 1 { panic(92702); };
    if inner.len != 4 { panic(92703); };
}

@test "entity index set iter extras boxed into iter owning"() {
    let boxed = ecs_eis3_slice_boxed(make_eis3_4());
    let iter = ecs_eis3_boxed_into_iter(boxed);
    let first = ecs_eis3_into_iter_next(iter);
    let last = ecs_eis3_into_iter_next_back(first.iter);
    if first.value != 10 { panic(92704); };
    if last.value != 40 { panic(92705); };
    if last.iter.trusted_unique != 1 { panic(92706); };
}

@test "entity index set iter extras iter into inner marker"() {
    let iter = ecs_eis3_iter(make_eis3_4());
    let first = ecs_eis3_iter_next(iter);
    let inner = ecs_eis3_iter_into_inner(first.iter);
    if inner.inner_exposed != 1 { panic(92707); };
    let next = ecs_eis3_iter_next(inner);
    if next.value != 20 { panic(92708); };
}

@test "entity index set iter extras into iter into inner marker"() {
    let iter = ecs_eis3_boxed_into_iter(ecs_eis3_slice_boxed(make_eis3_4()));
    let first = ecs_eis3_into_iter_next(iter);
    let inner = ecs_eis3_into_iter_into_inner(first.iter);
    if inner.inner_exposed != 1 { panic(92709); };
    let next = ecs_eis3_into_iter_next(inner);
    if next.value != 20 { panic(92710); };
}

@test "entity index set iter extras drain into inner marker"() {
    let result = ecs_eis3_drain(make_eis3_4(), 1, 3);
    let first = ecs_eis3_drain_next(result.drain);
    let inner = ecs_eis3_drain_into_inner(first.drain);
    if inner.inner_exposed != 1 { panic(92711); };
    let next = ecs_eis3_drain_next(inner);
    if next.value != 30 { panic(92712); };
}

@test "entity index set iter extras intersection iterator"() {
    let iter = ecs_eis3_intersection_iter(make_eis3_4(), make_eis3_other());
    let first = ecs_eis3_op_iter_next(iter);
    let second = ecs_eis3_op_iter_next(first.iter);
    if first.value != 10 { panic(92713); };
    if second.value != 30 { panic(92714); };
    if second.iter.op_kind != 1 { panic(92715); };
}

@test "entity index set iter extras union iterator"() {
    let iter = ecs_eis3_union_iter(make_eis3_4(), make_eis3_other());
    let back = ecs_eis3_op_iter_next_back(iter);
    if back.value != 50 { panic(92716); };
    if back.iter.trusted_unique != 1 { panic(92717); };
}

@test "entity index set iter extras difference iterator"() {
    let iter = ecs_eis3_difference_iter(make_eis3_4(), make_eis3_other());
    let first = ecs_eis3_op_iter_next(iter);
    let second = ecs_eis3_op_iter_next(first.iter);
    if first.value != 20 { panic(92718); };
    if second.value != 40 { panic(92719); };
}

@test "entity index set iter extras symmetric difference iterator"() {
    let iter = ecs_eis3_symmetric_difference_iter(make_eis3_4(), make_eis3_other());
    let collected = ecs_eis3_collect_op_iter(iter);
    if ecs_eis3_len(collected) != 3 { panic(92720); };
    if ecs_eis3_contains(collected, 20) != true { panic(92721); };
    if ecs_eis3_contains(collected, 40) != true { panic(92722); };
    if ecs_eis3_contains(collected, 50) != true { panic(92723); };
}

@test "entity index set iter extras collect op iterator dedups"() {
    let iter = ecs_eis3_union_iter(make_eis3_4(), make_eis3_other());
    let collected = ecs_eis3_collect_op_iter(iter);
    if ecs_eis3_len(collected) != 5 { panic(92724); };
    if ecs_eis3_contains(collected, 50) != true { panic(92725); };
}

@test "entity index set iter extras splice replacement"() {
    let replacement_values: Vec<i64> = Vec::new();
    replacement_values.push(99);
    replacement_values.push(20);
    let replacement = ecs_eis3_from_vec(replacement_values);
    let result = ecs_eis3_splice_unique(make_eis3_4(), 1, 3, replacement);
    if ecs_eis3_len(result.set) != 4 { panic(92726); };
    if ecs_eis3_contains(result.set, 99) != true { panic(92727); };
    if ecs_eis3_contains(result.set, 30) != false { panic(92728); };
}

@test "entity index set iter extras splice removed iterator"() {
    let replacement_values: Vec<i64> = Vec::new();
    replacement_values.push(99);
    let replacement = ecs_eis3_from_vec(replacement_values);
    let result = ecs_eis3_splice_unique(make_eis3_4(), 1, 3, replacement);
    let first = ecs_eis3_op_iter_next(result.removed);
    let second = ecs_eis3_op_iter_next(first.iter);
    if first.value != 20 { panic(92729); };
    if second.value != 30 { panic(92730); };
    if second.iter.op_kind != 5 { panic(92731); };
}

@test "entity index set iter extras splice dedups replacement against kept"() {
    let replacement_values: Vec<i64> = Vec::new();
    replacement_values.push(10);
    replacement_values.push(60);
    replacement_values.push(60);
    let replacement = ecs_eis3_from_vec(replacement_values);
    let result = ecs_eis3_splice_unique(make_eis3_4(), 1, 2, replacement);
    if ecs_eis3_len(result.set) != 4 { panic(92732); };
    if ecs_eis3_contains(result.set, 60) != true { panic(92733); };
}

@test "entity index set iter extras op iterator exhausted"() {
    let empty_values: Vec<i64> = Vec::new();
    let empty = ecs_eis3_from_vec(empty_values);
    let iter = ecs_eis3_intersection_iter(empty, make_eis3_other());
    let next = ecs_eis3_op_iter_next(iter);
    if next.has != 0 { panic(92734); };
}

@test "entity index set iter extras drain clamps and into inner empty"() {
    let result = ecs_eis3_drain(make_eis3_4(), 9, 12);
    let inner = ecs_eis3_drain_into_inner(result.drain);
    if inner.inner_exposed != 1 { panic(92735); };
    let next = ecs_eis3_drain_next(inner);
    if next.has != 0 { panic(92736); };
}
