@import "lib/relationship_query_deep.sla"

// Batch 237: relationship_query deep (src/relationship/relationship_query.rs).
// panic codes: 113400 – 113599.

@test "related_and_sources_on_sample_tree"() {
    let w = ecs_rq_sample_tree();
    let r = ecs_rq_related(w, 4);
    if r.0 != true { panic(113400); };
    if r.1 != 2 { panic(113401); };
    r = ecs_rq_related(w, 1);
    if r.0 != false { panic(113402); };
    let src = ecs_rq_sources(w, 1);
    if ecs_rq_list_len(src) != 2 { panic(113403); };
    if ecs_rq_list_at(src, 0) != 2 { panic(113404); };
    if ecs_rq_list_at(src, 1) != 3 { panic(113405); };
    src = ecs_rq_sources(w, 8);
    if ecs_rq_list_len(src) != 0 { panic(113406); };
}

@test "root_ancestor_walks_to_top"() {
    let w = ecs_rq_sample_tree();
    if ecs_rq_root_ancestor(w, 7) != 1 { panic(113410); };
    if ecs_rq_root_ancestor(w, 4) != 1 { panic(113411); };
    if ecs_rq_root_ancestor(w, 1) != 1 { panic(113412); };
    if ecs_rq_root_ancestor(w, 8) != 8 { panic(113413); };
}

@test "iter_ancestors_parent_chain"() {
    let w = ecs_rq_sample_tree();
    let a = ecs_rq_iter_ancestors(w, 7);
    if ecs_rq_list_len(a) != 3 { panic(113420); };
    if ecs_rq_list_at(a, 0) != 6 { panic(113421); };
    if ecs_rq_list_at(a, 1) != 3 { panic(113422); };
    if ecs_rq_list_at(a, 2) != 1 { panic(113423); };
    a = ecs_rq_iter_ancestors(w, 1);
    if ecs_rq_list_len(a) != 0 { panic(113424); };
}

@test "iter_siblings_excludes_self"() {
    let w = ecs_rq_sample_tree();
    let s = ecs_rq_iter_siblings(w, 2);
    if ecs_rq_list_len(s) != 1 { panic(113430); };
    if ecs_rq_list_at(s, 0) != 3 { panic(113431); };
    s = ecs_rq_iter_siblings(w, 5);
    if ecs_rq_list_len(s) != 1 { panic(113432); };
    if ecs_rq_list_at(s, 0) != 6 { panic(113433); };
    s = ecs_rq_iter_siblings(w, 1);
    if ecs_rq_list_len(s) != 0 { panic(113434); };
}

@test "iter_descendants_bfs_order"() {
    let w = ecs_rq_sample_tree();
    // BFS from 1: 2,3 then 4 then 5,6 then 7
    let d = ecs_rq_iter_descendants_bfs(w, 1);
    if ecs_rq_list_len(d) != 6 { panic(113440); };
    if ecs_rq_list_at(d, 0) != 2 { panic(113441); };
    if ecs_rq_list_at(d, 1) != 3 { panic(113442); };
    if ecs_rq_list_at(d, 2) != 4 { panic(113443); };
    if ecs_rq_list_at(d, 3) != 5 { panic(113444); };
    if ecs_rq_list_at(d, 4) != 6 { panic(113445); };
    if ecs_rq_list_at(d, 5) != 7 { panic(113446); };
}

@test "iter_descendants_alias_matches_bfs"() {
    let w = ecs_rq_sample_tree();
    let a = ecs_rq_iter_descendants(w, 3);
    let b = ecs_rq_iter_descendants_bfs(w, 3);
    if ecs_rq_list_len(a) != ecs_rq_list_len(b) { panic(113450); };
    if ecs_rq_list_at(a, 0) != 5 { panic(113451); };
    if ecs_rq_list_at(a, 1) != 6 { panic(113452); };
    if ecs_rq_list_at(a, 2) != 7 { panic(113453); };
}

@test "iter_descendants_depth_first_order"() {
    let w = ecs_rq_sample_tree();
    // DFS preorder children left-to-right: 2,4,3,5,6,7
    let d = ecs_rq_iter_descendants_depth_first(w, 1);
    if ecs_rq_list_len(d) != 6 { panic(113460); };
    if ecs_rq_list_at(d, 0) != 2 { panic(113461); };
    if ecs_rq_list_at(d, 1) != 4 { panic(113462); };
    if ecs_rq_list_at(d, 2) != 3 { panic(113463); };
    if ecs_rq_list_at(d, 3) != 5 { panic(113464); };
    if ecs_rq_list_at(d, 4) != 6 { panic(113465); };
    if ecs_rq_list_at(d, 5) != 7 { panic(113466); };
}

@test "iter_leaves_filters_descendants"() {
    let w = ecs_rq_sample_tree();
    // leaves under 1 in DFS order: 4,5,7
    let leaves = ecs_rq_iter_leaves(w, 1);
    if ecs_rq_list_len(leaves) != 3 { panic(113470); };
    if ecs_rq_list_at(leaves, 0) != 4 { panic(113471); };
    if ecs_rq_list_at(leaves, 1) != 5 { panic(113472); };
    if ecs_rq_list_at(leaves, 2) != 7 { panic(113473); };
    leaves = ecs_rq_iter_leaves(w, 2);
    if ecs_rq_list_len(leaves) != 1 { panic(113474); };
    if ecs_rq_list_at(leaves, 0) != 4 { panic(113475); };
}

@test "list_helpers_push_contains_at"() {
    let l = ecs_rq_list_new();
    if ecs_rq_list_len(l) != 0 { panic(113480); };
    l = ecs_rq_list_push(l, 10);
    l = ecs_rq_list_push(l, 20);
    l = ecs_rq_list_push(l, 30);
    if ecs_rq_list_len(l) != 3 { panic(113481); };
    if ecs_rq_list_at(l, 1) != 20 { panic(113482); };
    if ecs_rq_list_contains(l, 30) != true { panic(113483); };
    if ecs_rq_list_contains(l, 99) != false { panic(113484); };
}

@test "link_builds_bidirectional_edges"() {
    let w = ecs_rq_world_new();
    w = ecs_rq_link(w, 2, 1);
    w = ecs_rq_link(w, 3, 1);
    let r = ecs_rq_related(w, 2);
    if r.0 != true { panic(113490); };
    if r.1 != 1 { panic(113491); };
    let src = ecs_rq_sources(w, 1);
    if ecs_rq_list_len(src) != 2 { panic(113492); };
    if ecs_rq_list_contains(src, 2) != true { panic(113493); };
    if ecs_rq_list_contains(src, 3) != true { panic(113494); };
    if ecs_rq_is_leaf(w, 2) != true { panic(113495); };
    if ecs_rq_is_leaf(w, 1) != false { panic(113496); };
}
