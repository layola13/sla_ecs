@import "lib/system_trait_extras.sla"

// Isolated tests for lib/system_trait_extras.sla — System trait gaps (is_send + system_type +
// refresh_hotpatch + queue_deferred + check_change_tick + default_system_sets + get_last_run +
// set_last_run + run_readonly + run_without_applying_deferred). Bevy reference: src/system/system.rs.

const TYPE_A: i64 = 1001;
const TYPE_B: i64 = 1002;
const TICK_42: i64 = 42;
const TICK_99: i64 = 99;
const SET_X: i64 = 7001;
const SET_Y: i64 = 7002;
const IN_5: i64 = 5;

@test "extras_new_type_id_default"() {
    let s = ecs_system_extras_new(TYPE_A);
    if ecs_system_extras_type_id(s) != TYPE_A { panic(91893); };
    if !ecs_system_extras_is_send(s) { panic(91894); };
    if ecs_system_extras_run_count(s) != 0 { panic(91895); };
    if ecs_system_extras_get_last_run(s) != 0 { panic(91896); };
    if ecs_system_extras_deferred_count(s) != 0 { panic(91897); };
}

@test "extras_is_send_default_true"() {
    let s = ecs_system_extras_new(TYPE_A);
    if !ecs_system_extras_is_send(s) { panic(91898); };
}

@test "extras_set_non_send_makes_is_send_false"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_set_non_send(s0, true);
    if ecs_system_extras_is_send(s1) { panic(91899); };
}

@test "extras_set_non_send_false_keeps_true"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_set_non_send(s0, false);
    if !ecs_system_extras_is_send(s1) { panic(91900); };
}

@test "extras_type_id_distinct"() {
    let s1 = ecs_system_extras_new(TYPE_A);
    let s2 = ecs_system_extras_new(TYPE_B);
    if ecs_system_extras_type_id(s1) == ecs_system_extras_type_id(s2) { panic(91901); };
}

@test "extras_refresh_hotpatch_noop"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_refresh_hotpatch(s0);
    if ecs_system_extras_type_id(s1) != TYPE_A { panic(91902); };
    if !ecs_system_extras_is_send(s1) { panic(91903); };
    if ecs_system_extras_run_count(s1) != 0 { panic(91904); };
}

@test "extras_queue_deferred_increments"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_queue_deferred(s0, 3);
    if ecs_system_extras_deferred_count(s1) != 3 { panic(91905); };
    let s2 = ecs_system_extras_queue_deferred(s1, 2);
    if ecs_system_extras_deferred_count(s2) != 5 { panic(91906); };
}

@test "extras_queue_deferred_zero_no_change"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_queue_deferred(s0, 0);
    if ecs_system_extras_deferred_count(s1) != 0 { panic(91907); };
}

@test "extras_check_change_tick_updates_last_run"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_check_change_tick(s0, TICK_42);
    if ecs_system_extras_get_last_run(s1) != TICK_42 { panic(91908); };
}

@test "extras_set_last_run_and_get"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_set_last_run(s0, TICK_99);
    if ecs_system_extras_get_last_run(s1) != TICK_99 { panic(91909); };
}

@test "extras_default_system_sets_empty"() {
    let s = ecs_system_extras_new(TYPE_A);
    let res = ecs_system_extras_default_system_sets(s);
    if ecs_sys_set_count(res) != 0 { panic(91910); };
    if ecs_sys_set_first_id(res) != -1 { panic(91911); };
}

@test "extras_add_default_system_set"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_add_default_system_set(s0, SET_X);
    let res = ecs_system_extras_default_system_sets(s1);
    if ecs_sys_set_count(res) != 1 { panic(91912); };
    if ecs_sys_set_first_id(res) != SET_X { panic(91913); };
}

@test "extras_add_multiple_default_sets_returns_first"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_add_default_system_set(s0, SET_X);
    let s2 = ecs_system_extras_add_default_system_set(s1, SET_Y);
    let res = ecs_system_extras_default_system_sets(s2);
    if ecs_sys_set_count(res) != 2 { panic(91914); };
    if ecs_sys_set_first_id(res) != SET_X { panic(91915); };
}

@test "extras_run_without_applying_deferred_bumps_run_count"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let (s1, res) = ecs_system_extras_run_without_applying_deferred(s0, IN_5);
    if ecs_run_wod_count(res) != 1 { panic(91916); };
    if ecs_run_wod_last_run(res) != IN_5 { panic(91917); };
    if ecs_system_extras_run_count(s1) != 1 { panic(91918); };
    if ecs_system_extras_get_last_run(s1) != IN_5 { panic(91919); };
}

@test "extras_run_without_applying_deferred_preserves_deferred_count"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_queue_deferred(s0, 2);
    let (s2, res) = ecs_system_extras_run_without_applying_deferred(s1, IN_5);
    if ecs_run_wod_deferred(res) != 2 { panic(91920); };
    if ecs_system_extras_deferred_count(s2) != 2 { panic(91921); };
}

@test "extras_run_readonly_increments_run_count"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let (s1, res) = ecs_system_extras_run_readonly(s0, IN_5);
    if ecs_run_rd_count(res) != 1 { panic(91922); };
    if ecs_run_rd_queued(res) != 0 { panic(91923); };
    if ecs_system_extras_run_count(s1) != 1 { panic(91924); };
    if ecs_system_extras_get_last_run(s1) != IN_5 { panic(91925); };
}

@test "extras_run_readonly_does_not_consume_deferred"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_queue_deferred(s0, 4);
    let (s2, res) = ecs_system_extras_run_readonly(s1, IN_5);
    if ecs_run_rd_queued(res) != 0 { panic(91926); };
    if ecs_system_extras_deferred_count(s2) != 4 { panic(91927); };
}

@test "extras_run_readonly_then_unset_set_run_count"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let (s1, res1) = ecs_system_extras_run_readonly(s0, IN_5);
    if ecs_run_rd_count(res1) != 1 { panic(91928); };
    let (s2, res2) = ecs_system_extras_run_readonly(s1, IN_5 + 1);
    if ecs_run_rd_count(res2) != 2 { panic(91929); };
    if ecs_system_extras_get_last_run(s2) != IN_5 + 1 { panic(91930); };
}

@test "extras_run_wod_then_get_last_run_fresh"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let s1 = ecs_system_extras_set_last_run(s0, TICK_42);
    let (s2, res) = ecs_system_extras_run_without_applying_deferred(s1, IN_5);
    if ecs_run_wod_last_run(res) != IN_5 { panic(91931); };
    if ecs_system_extras_get_last_run(s2) != IN_5 { panic(91932); };
}

@test "extras_combined_run_paths_run_count"() {
    let s0 = ecs_system_extras_new(TYPE_A);
    let (s1, dr1) = ecs_system_extras_run_readonly(s0, IN_5);
    let (s2, dr2) = ecs_system_extras_run_without_applying_deferred(s1, IN_5 + 1);
    let (s3, res3) = ecs_system_extras_run_readonly(s2, IN_5 + 2);
    if ecs_run_rd_count(res3) != 3 { panic(91933); };
    if ecs_system_extras_run_count(s3) != 3 { panic(91934); };
}
