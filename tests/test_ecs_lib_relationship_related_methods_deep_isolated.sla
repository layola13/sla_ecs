@import "lib/relationship_related_methods_deep.sla"

// Batch 233: relationship related_methods deep (src/relationship/related_methods.rs).
// panic codes: 112600 – 112799.

@test "hook_constants"() {
    if ecs_rrm_hook_run() != 0 { panic(112600); };
    if ecs_rrm_hook_skip() != 1 { panic(112601); };
}

@test "add_one_and_add_related"() {
    let w = ecs_rrm_world_new(1, 100);
    w = ecs_rrm_add_one_related(w, 10);
    w = ecs_rrm_add_related2(w, 11, 12);
    if ecs_rrm_world_coll_len(w) != 3 { panic(112610); };
    if ecs_rrm_world_coll_at(w, 0) != 10 { panic(112611); };
    if ecs_rrm_entity_has_rel(w, 11) != true { panic(112612); };
    if ecs_rrm_world_hook_run(w) != 3 { panic(112613); };
    if ecs_rrm_world_has_target(w) != true { panic(112614); };
}

@test "insert_related_place_existing_and_new"() {
    // Bevy example shape: add [e0,e1,e2,e2] then insert_related(1, [e0,e3,e4,e4])
    // Simplified without duplicate handling in add: start with e0,e1,e2
    let w = ecs_rrm_world_new(1, 100);
    w = ecs_rrm_add_related3(w, 10, 11, 12);
    // insert at 1: e0(10), e3(13), e4(14) — place existing e0, add e3,e4
    w = ecs_rrm_insert_related(w, 1, 10, 13, 14, 0, 3);
    // collection should contain 11,10,13,12,14-ish after places
    if ecs_rrm_world_coll_len(w) < 4 { panic(112620); };
    if ecs_rrm_coll_contains(w.coll, 13) != true { panic(112621); };
    if ecs_rrm_coll_contains(w.coll, 14) != true { panic(112622); };
    if ecs_rrm_coll_contains(w.coll, 10) != true { panic(112623); };
}

@test "detach_all_related"() {
    let w = ecs_rrm_world_new(1, 10);
    w = ecs_rrm_add_related2(w, 2, 3);
    w = ecs_rrm_detach_all_related(w);
    if ecs_rrm_world_has_target(w) != false { panic(112630); };
    if ecs_rrm_world_coll_len(w) != 0 { panic(112631); };
    if ecs_rrm_entity_has_rel(w, 2) != false { panic(112632); };
}

@test "replace_related_with_difference_skip_hooks"() {
    let w = ecs_rrm_world_new(1, 50);
    w = ecs_rrm_add_related2(w, 2, 3);
    let runs = ecs_rrm_world_hook_run(w);
    // unrelate 2, relate [3,4], newly [4]
    w = ecs_rrm_replace_related_with_difference(w, 2, 0, 1, 3, 4, 0, 2, 4, 0, 1);
    if ecs_rrm_world_coll_len(w) != 2 { panic(112640); };
    if ecs_rrm_coll_contains(w.coll, 3) != true { panic(112641); };
    if ecs_rrm_coll_contains(w.coll, 4) != true { panic(112642); };
    if ecs_rrm_entity_has_rel(w, 2) != false { panic(112643); };
    if ecs_rrm_world_hook_skip(w) != 1 { panic(112644); };
    if ecs_rrm_world_hook_run(w) != runs { panic(112645); };
}

@test "despawn_related_and_children"() {
    let w = ecs_rrm_world_new(1, 10);
    w = ecs_rrm_add_related2(w, 2, 3);
    w = ecs_rrm_despawn_children(w);
    if ecs_rrm_world_despawn_count(w) != 2 { panic(112650); };
    if ecs_rrm_entity_alive(w, 2) != false { panic(112651); };
    if ecs_rrm_world_has_target(w) != false { panic(112652); };
}

@test "with_related_and_spawner"() {
    let w = ecs_rrm_world_new(1, 100);
    w = ecs_rrm_with_related(w, 7);
    if ecs_rrm_world_spawned(w) != 1 { panic(112660); };
    if ecs_rrm_entity_bundle(w, 100).1 != 7 { panic(112661); };
    let r = ecs_rrm_with_related_entities_spawner(w, 2);
    w = r.0;
    if ecs_rrm_spawner_len(r.1) != 2 { panic(112662); };
    if ecs_rrm_world_spawned(w) != 3 { panic(112663); };
}

@test "insert_remove_recursive_bfs"() {
    let w = ecs_rrm_world_new(1, 50);
    w = ecs_rrm_add_one_related(w, 10);
    w = ecs_rrm_add_one_related(w, 11);
    w = ecs_rrm_world_add_descendant(w, 10, 20);
    w = ecs_rrm_world_add_descendant(w, 10, 21);
    w = ecs_rrm_insert_recursive(w, 99);
    // visits: 10,20,21,11 = 4
    if ecs_rrm_world_recursive_visit(w) != 4 { panic(112670); };
    if ecs_rrm_entity_bundle(w, 10).0 != true { panic(112671); };
    if ecs_rrm_entity_bundle(w, 10).1 != 99 { panic(112672); };
    w = ecs_rrm_remove_recursive(w);
    if ecs_rrm_entity_bundle(w, 10).0 != false { panic(112673); };
}

@test "coll_place_helpers"() {
    let c = ecs_rrm_coll_new();
    c = ecs_rrm_coll_push(c, 1);
    c = ecs_rrm_coll_push(c, 2);
    c = ecs_rrm_coll_push(c, 3);
    c = ecs_rrm_coll_place(c, 3, 0);
    if ecs_rrm_coll_at(c, 0) != 3 { panic(112680); };
    c = ecs_rrm_coll_place_most_recent(c, 1);
    if ecs_rrm_coll_len(c) != 3 { panic(112681); };
}

@test "replace_when_no_target_adds"() {
    let w = ecs_rrm_world_new(1, 10);
    w = ecs_rrm_replace_related_with_difference(w, 0, 0, 0, 5, 6, 0, 2, 5, 6, 2);
    if ecs_rrm_world_coll_len(w) != 2 { panic(112690); };
    if ecs_rrm_world_hook_run(w) != 2 { panic(112691); };
}
