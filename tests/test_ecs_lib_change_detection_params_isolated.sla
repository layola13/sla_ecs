@import "lib/change_detection_params.sla"

// Isolated tests for lib/change_detection_params.sla — Res/ResMut/NonSend/NonSendMut/Ref/Mut/MutUntyped
// Bevy reference: bevy_ecs/src/change_detection/params.rs

@test "ref_new"() {
    let r = ecs_ref_new(42, 5, 10, 3, 10);
    if ecs_ref_data(r) != 42 { panic(83800); };
    if ecs_ref_is_added(r) != true { panic(83801); };
    if ecs_ref_is_changed(r) != true { panic(83802); };
}

@test "ref_not_added"() {
    let r = ecs_ref_new(42, 1, 2, 5, 10);
    if ecs_ref_is_added(r) != false { panic(83803); };
    if ecs_ref_is_changed(r) != false { panic(83804); };
}

@test "ref_accessors"() {
    let r = ecs_ref_new(42, 5, 10, 3, 10);
    if ecs_ref_added_tick(r) != 5 { panic(83805); };
    if ecs_ref_changed_tick(r) != 10 { panic(83806); };
    if ecs_ref_last_run(r) != 3 { panic(83807); };
    if ecs_ref_this_run(r) != 10 { panic(83808); };
}

@test "mut_new"() {
    let m = ecs_mut_new(42, 5, 10, 3, 10);
    if ecs_mut_data(m) != 42 { panic(83809); };
    if ecs_mut_is_added(m) != true { panic(83810); };
}

@test "mut_set_data"() {
    let m = ecs_mut_new(42, 5, 10, 3, 10);
    let m2 = ecs_mut_set_data(m, 99);
    if ecs_mut_data(m2) != 99 { panic(83811); };
    if ecs_mut_changed_tick(m2) != 10 { panic(83812); };
}

@test "mut_set_changed"() {
    let m = ecs_mut_new(42, 5, 2, 3, 10);
    let m2 = ecs_mut_set_changed(m);
    if ecs_mut_is_changed(m2) != true { panic(83813); };
    if ecs_mut_changed_tick(m2) != 10 { panic(83814); };
}

@test "mut_reborrow"() {
    let m = ecs_mut_new(42, 5, 10, 3, 10);
    let r = ecs_mut_reborrow(m);
    if ecs_ref_data(r) != 42 { panic(83815); };
    if ecs_ref_added_tick(r) != 5 { panic(83816); };
}

@test "mut_map"() {
    let m = ecs_mut_new(42, 5, 10, 3, 10);
    let m2 = ecs_mut_map(m, 99);
    if ecs_mut_data(m2) != 99 { panic(83817); };
    if ecs_mut_added_tick(m2) != 5 { panic(83818); };
}

@test "mut_into_inner"() {
    let m = ecs_mut_new(42, 5, 10, 3, 10);
    if ecs_mut_into_inner(m) != 42 { panic(83819); };
}

@test "mut_untyped_new"() {
    let m = ecs_mut_untyped_new(42, 10, 3, 10);
