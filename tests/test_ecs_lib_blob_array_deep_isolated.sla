@import "lib/blob_array_deep.sla"

// Batch 240: blob_array deep (src/storage/blob_array.rs).
// panic codes: 114000 – 114199.

@test "layout_zst_and_capacity"() {
    let b = ecs_ba_with_capacity(8, 8, true, 4);
    if ecs_ba_layout_size(b) != 8 { panic(114000); };
    if ecs_ba_layout_align(b) != 8 { panic(114001); };
    if ecs_ba_capacity(b) != 4 { panic(114002); };
    if ecs_ba_get_drop(b) != true { panic(114003); };
    let z = ecs_ba_new(0, 1, false);
    if ecs_ba_is_zst(z) != true { panic(114004); };
    if ecs_ba_is_empty(z) != true { panic(114005); };
}

@test "initialize_and_get"() {
    let b = ecs_ba_new(8, 8, false);
    b = ecs_ba_initialize(b, 0, 10);
    b = ecs_ba_initialize(b, 1, 20);
    b = ecs_ba_initialize(b, 2, 30);
    if ecs_ba_len(b) != 3 { panic(114010); };
    if ecs_ba_get(b, 0).1 != 10 { panic(114011); };
    if ecs_ba_get(b, 2).1 != 30 { panic(114012); };
    if ecs_ba_get(b, 3).0 != false { panic(114013); };
    if ecs_ba_get_ptr(b).1 != 10 { panic(114014); };
}

@test "replace_drops_old_when_has_drop"() {
    let b = ecs_ba_new(4, 4, true);
    b = ecs_ba_initialize(b, 0, 1);
    b = ecs_ba_initialize(b, 1, 2);
    b = ecs_ba_replace(b, 0, 9);
    if ecs_ba_get(b, 0).1 != 9 { panic(114020); };
    if ecs_ba_drop_count(b) != 1 { panic(114021); };
    let c = ecs_ba_new(4, 4, false);
    c = ecs_ba_initialize(c, 0, 1);
    c = ecs_ba_replace(c, 0, 3);
    if ecs_ba_drop_count(c) != 0 { panic(114022); };
}

@test "swap_remove_moves_last"() {
    let b = ecs_ba_new(8, 8, false);
    b = ecs_ba_initialize(b, 0, 10);
    b = ecs_ba_initialize(b, 1, 20);
    b = ecs_ba_initialize(b, 2, 30);
    b = ecs_ba_swap_remove(b, 0);
    if ecs_ba_len(b) != 2 { panic(114030); };
    if ecs_ba_get(b, 0).1 != 30 { panic(114031); };
    if ecs_ba_get(b, 1).1 != 20 { panic(114032); };
}

@test "swap_remove_and_drop_counts"() {
    let b = ecs_ba_new(8, 8, true);
    b = ecs_ba_initialize(b, 0, 1);
    b = ecs_ba_initialize(b, 1, 2);
    b = ecs_ba_swap_remove_and_drop(b, 0);
    if ecs_ba_len(b) != 1 { panic(114040); };
    if ecs_ba_drop_count(b) != 1 { panic(114041); };
    if ecs_ba_get(b, 0).1 != 2 { panic(114042); };
}

@test "clear_and_drop_all"() {
    let b = ecs_ba_new(8, 8, true);
    b = ecs_ba_initialize(b, 0, 1);
    b = ecs_ba_initialize(b, 1, 2);
    b = ecs_ba_initialize(b, 2, 3);
    b = ecs_ba_clear(b);
    if ecs_ba_len(b) != 0 { panic(114050); };
    if ecs_ba_drop_count(b) != 3 { panic(114051); };
    if ecs_ba_is_empty(b) != true { panic(114052); };
    b = ecs_ba_initialize(b, 0, 9);
    b = ecs_ba_drop_all(b);
    if ecs_ba_len(b) != 0 { panic(114053); };
    if ecs_ba_drop_count(b) != 4 { panic(114054); };
}

@test "drop_last_element"() {
    let b = ecs_ba_new(8, 8, true);
    b = ecs_ba_initialize(b, 0, 1);
    b = ecs_ba_initialize(b, 1, 2);
    b = ecs_ba_drop_last(b);
    if ecs_ba_len(b) != 1 { panic(114060); };
    if ecs_ba_drop_count(b) != 1 { panic(114061); };
    if ecs_ba_get(b, 0).1 != 1 { panic(114062); };
}

@test "get_sub_slice"() {
    let b = ecs_ba_new(8, 8, false);
    b = ecs_ba_initialize(b, 0, 5);
    b = ecs_ba_initialize(b, 1, 6);
    b = ecs_ba_initialize(b, 2, 7);
    let s = ecs_ba_get_sub_slice(b, 2);
    if ecs_ba_slice_len(s) != 2 { panic(114070); };
    if ecs_ba_slice_at(s, 0) != 5 { panic(114071); };
    if ecs_ba_slice_at(s, 1) != 6 { panic(114072); };
    s = ecs_ba_get_sub_slice(b, 10);
    if ecs_ba_slice_len(s) != 3 { panic(114073); };
}

@test "count_matching"() {
    let b = ecs_ba_new(4, 4, false);
    b = ecs_ba_initialize(b, 0, 1);
    b = ecs_ba_initialize(b, 1, 2);
    b = ecs_ba_initialize(b, 2, 1);
    b = ecs_ba_initialize(b, 3, 1);
    if ecs_ba_count_matching(b, 1) != 3 { panic(114080); };
    if ecs_ba_count_matching(b, 2) != 1 { panic(114081); };
    if ecs_ba_count_matching(b, 9) != 0 { panic(114082); };
}

@test "initialize_rejects_non_append_index"() {
    let b = ecs_ba_new(8, 8, false);
    b = ecs_ba_initialize(b, 0, 1);
    let b2 = ecs_ba_initialize(b, 2, 99);
    if ecs_ba_len(b2) != 1 { panic(114090); };
    if ecs_ba_get(b2, 0).1 != 1 { panic(114091); };
}
