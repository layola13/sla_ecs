@import "lib/metadata_identity_deep.sla"

// Batch 338: metadata_identity deep.
// panic codes: 133600 – 133799.

@test "stable_same_source"() {
    let first = ecs_mid_component(17, 23, 31);
    let second = ecs_mid_component(17, 23, 31);
    if ecs_mid_type_id(first) != ecs_mid_type_id(second) { panic(133600); };
    if ecs_mid_i32_type_id(first) <= 0 { panic(133601); };
}

@test "kind_separates"() {
    let component = ecs_mid_component(17, 23, 31);
    let resource = ecs_mid_resource(17, 23, 31);
    if ecs_mid_type_id(component) == ecs_mid_type_id(resource) { panic(133610); };
    if ecs_mid_kind(component) != ECS_MID_COMPONENT { panic(133611); };
    if ecs_mid_kind(resource) != ECS_MID_RESOURCE { panic(133612); };
}

@test "normalize_zero_negative"() {
    let identity = ecs_mid_component(0, -5, 0);
    if ecs_mid_ns(identity) != 1 { panic(133620); };
    if ecs_mid_local(identity) != 5 { panic(133621); };
    if ecs_mid_path(identity) != 1 { panic(133622); };
}

@test "all_kind_constructors"() {
    let m = ecs_mid_message(1, 2, 3);
    let e = ecs_mid_event(1, 2, 3);
    let rel = ecs_mid_relationship(1, 2, 3);
    if ecs_mid_kind(m) != ECS_MID_MESSAGE { panic(133630); };
    if ecs_mid_kind(e) != ECS_MID_EVENT { panic(133631); };
    if ecs_mid_kind(rel) != ECS_MID_RELATIONSHIP { panic(133632); };
    if ecs_mid_type_id(m) == ecs_mid_type_id(e) { panic(133633); };
}

@test "registry_insert_unique"() {
    let registry = ecs_mid_reg_new();
    let identity = ecs_mid_component(1, 2, 3);
    let result = ecs_mid_reg_register(registry, identity);
    if ecs_mid_res_inserted(result) != true { panic(133640); };
    if ecs_mid_res_duplicate(result) != false { panic(133641); };
    if ecs_mid_res_collision(result) != false { panic(133642); };
    if ecs_mid_reg_len(ecs_mid_res_registry(result)) != 1 { panic(133643); };
}

@test "registry_duplicate_source"() {
    let identity = ecs_mid_component(4, 5, 6);
    let first = ecs_mid_reg_register(ecs_mid_reg_new(), identity);
    let second = ecs_mid_reg_register(ecs_mid_res_registry(first), ecs_mid_component(4, 5, 6));
    if ecs_mid_res_inserted(second) != false { panic(133650); };
    if ecs_mid_res_duplicate(second) != true { panic(133651); };
    if ecs_mid_res_collision(second) != false { panic(133652); };
    if ecs_mid_res_index(second) != 0 { panic(133653); };
}

@test "registry_id_collision"() {
    let first = ecs_mid_component(7, 8, 9);
    let second = ecs_mid_with_type_id(ecs_mid_component(7, 8, 10), ecs_mid_type_id(first));
    let inserted = ecs_mid_reg_register(ecs_mid_reg_new(), first);
    let collision = ecs_mid_reg_register(ecs_mid_res_registry(inserted), second);
    if ecs_mid_res_inserted(collision) != false { panic(133660); };
    if ecs_mid_res_duplicate(collision) != false { panic(133661); };
    if ecs_mid_res_collision(collision) != true { panic(133662); };
    if ecs_mid_reg_len(ecs_mid_res_registry(collision)) != 1 { panic(133663); };
}

@test "same_source_false_on_kind"() {
    let a = ecs_mid_component(1, 2, 3);
    let b = ecs_mid_resource(1, 2, 3);
    if ecs_mid_same_source(a, b) != false { panic(133670); };
    if ecs_mid_same_source(a, ecs_mid_component(1, 2, 3)) != true { panic(133671); };
}

@test "capacity_four"() {
    let r = ecs_mid_reg_new();
    r = ecs_mid_res_registry(ecs_mid_reg_register(r, ecs_mid_component(1, 1, 1)));
    r = ecs_mid_res_registry(ecs_mid_reg_register(r, ecs_mid_component(2, 2, 2)));
    r = ecs_mid_res_registry(ecs_mid_reg_register(r, ecs_mid_component(3, 3, 3)));
    r = ecs_mid_res_registry(ecs_mid_reg_register(r, ecs_mid_component(4, 4, 4)));
    if ecs_mid_reg_len(r) != 4 { panic(133680); };
    let overflow = ecs_mid_reg_register(r, ecs_mid_component(5, 5, 5));
    if ecs_mid_res_inserted(overflow) != false { panic(133681); };
    if ecs_mid_reg_len(ecs_mid_res_registry(overflow)) != 4 { panic(133682); };
}

@test "reg_get_and_find"() {
    let r = ecs_mid_res_registry(ecs_mid_reg_register(ecs_mid_reg_new(), ecs_mid_component(11, 12, 13)));
    r = ecs_mid_res_registry(ecs_mid_reg_register(r, ecs_mid_resource(21, 22, 23)));
    let first = ecs_mid_reg_get(r, 0);
    let second = ecs_mid_reg_get(r, 1);
    if ecs_mid_kind(first) != ECS_MID_COMPONENT { panic(133690); };
    if ecs_mid_kind(second) != ECS_MID_RESOURCE { panic(133691); };
    if ecs_mid_reg_find_type_id(r, ecs_mid_type_id(second)) != 1 { panic(133692); };
    if ecs_mid_reg_find_type_id(r, 999999) != -1 { panic(133693); };
}
