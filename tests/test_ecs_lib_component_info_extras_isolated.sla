@import "lib/component_info_extras.sla"

// Isolated tests for lib/component_info_extras.sla — ComponentInfo accessors + Components registry.
// Bevy reference: src/component/info.rs

@test "component_info_v2_accessors"() {
    let info = ecs_component_info_v2_new(5, 1000, true, 900, true, 1, true, 42, 3, 2);
    if ecs_component_info_v2_id(info) != 5 { panic(90623); };
    if ecs_component_info_v2_name(info) != 1000 { panic(90624); };
    if ecs_component_info_v2_mutable(info) != true { panic(90625); };
    if ecs_component_info_v2_storage_type(info) != 1 { panic(90626); };
    if ecs_component_info_v2_is_send_and_sync(info) != true { panic(90627); };
    if ecs_component_info_v2_has_hooks(info) != true { panic(90628); };
    if ecs_component_info_v2_required_components(info) != 3 { panic(90629); };
    if ecs_component_info_v2_required_by(info) != 2 { panic(90630); };
}

@test "component_info_v2_type_id_present"() {
    let info = ecs_component_info_v2_new(1, 1, true, 777, true, 0, true, 0, 0, 0);
    let r = ecs_component_info_v2_type_id(info);
    let has = r.0;
    let tid = r.1;
    if has != true { panic(90631); };
    if tid != 777 { panic(90632); };
}

@test "component_info_v2_type_id_absent"() {
    let info = ecs_component_info_v2_new(1, 1, true, 0, false, 0, true, 0, 0, 0);
    let r = ecs_component_info_v2_type_id(info);
    let has = r.0;
    if has != false { panic(90633); };
}

@test "component_info_v2_clone_behavior"() {
    let info = ecs_component_info_v2_new(1, 1, true, 0, false, 0, true, 99, 0, 0);
    if ecs_component_info_v2_clone_behavior(info) != 99 { panic(90634); };
}

@test "components_new_empty"() {
    let c = ecs_components_new();
    if ecs_components_len(c) != 0 { panic(90635); };
    if ecs_components_is_empty(c) != true { panic(90636); };
    if ecs_components_num_registered(c) != 0 { panic(90637); };
    if ecs_components_any_registered(c) != false { panic(90638); };
    if ecs_components_num_queued(c) != 0 { panic(90639); };
    if ecs_components_any_queued(c) != false { panic(90640); };
}

@test "components_init_component"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1000, 900, true, 0, true);
    let c2 = r.0;
    let cid = r.1;
    if cid != 0 { panic(90641); };
    if ecs_components_len(c2) != 1 { panic(90642); };
    if ecs_components_num_registered(c2) != 1 { panic(90643); };
    if ecs_components_any_registered(c2) != true { panic(90644); };
}

@test "components_init_resource"() {
    let c = ecs_components_new();
    let r = ecs_components_init_resource(c, 2000, 800);
    let c2 = r.0;
    if ecs_components_len(c2) != 1 { panic(90645); };
    // resource counts as registered
    if ecs_components_num_registered(c2) != 1 { panic(90646); };
}

@test "components_queue_component"() {
    let c = ecs_components_new();
    let r = ecs_components_queue_component(c, 1000, 900, true);
    let c2 = r.0;
    let cid = r.1;
    if cid != 0 { panic(90647); };
    if ecs_components_len(c2) != 1 { panic(90648); };
    if ecs_components_num_queued(c2) != 1 { panic(90649); };
    if ecs_components_any_queued(c2) != true { panic(90650); };
    // queued (not registered) does not count toward num_registered
    if ecs_components_num_registered(c2) != 0 { panic(90651); };
}

@test "components_num_queued_mut"() {
    let c = ecs_components_new();
    let r = ecs_components_queue_component(c, 1000, 900, true);
    let c2 = r.0;
    if ecs_components_num_queued_mut(c2) != 1 { panic(90652); };
    if ecs_components_any_queued_mut(c2) != true { panic(90653); };
}

@test "components_get_info_registered"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1234, 900, true, 0, true);
    let c2 = r.0;
    let id = r.1;
    let gi = ecs_components_get_info(c2, id);
    let ok0 = gi.0;
    let info = gi.1;
    if ok0 != true { panic(90654); };
    if ecs_component_info_v2_id(info) != id { panic(90655); };
    if ecs_component_info_v2_name(info) != 1234 { panic(90656); };
}

@test "components_get_info_out_of_range"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1, 1, true, 0, true);
    let c2 = r.0;
    let gi = ecs_components_get_info(c2, 5);
    let ok0 = gi.0;
    if ok0 != false { panic(90657); };
}

@test "components_get_info_negative"() {
    let c = ecs_components_new();
    let gi = ecs_components_get_info(c, -1);
    let ok0 = gi.0;
    if ok0 != false { panic(90658); };
}

@test "components_get_name_registered"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 5555, 900, true, 0, true);
    let c2 = r.0;
    let id = r.1;
    let gn = ecs_components_get_name(c2, id);
    let ok0 = gn.0;
    let n0 = gn.1;
    if ok0 != true { panic(90659); };
    if n0 != 5555 { panic(90660); };
}

@test "components_get_name_unregistered"() {
    let c = ecs_components_new();
    let r = ecs_components_queue_component(c, 5555, 900, true);
    let c2 = r.0;
    let id = r.1;
    let gn = ecs_components_get_name(c2, id);
    let ok0 = gn.0;
    if ok0 != false { panic(90661); };
}

@test "components_is_id_valid"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1, 1, true, 0, true);
    let c2 = r.0;
    if ecs_components_is_id_valid(c2, 0) != true { panic(90662); };
    if ecs_components_is_id_valid(c2, 1) != false { panic(90663); };
    if ecs_components_is_id_valid(c2, -1) != false { panic(90664); };
}

@test "components_get_id"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r.0;
    let gid = ecs_components_get_id(c2, 900);
    let ok0 = gid.0;
    let cid0 = gid.1;
    if ok0 != true { panic(90665); };
    if cid0 != 0 { panic(90666); };
}

@test "components_get_id_missing"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r.0;
    let gid = ecs_components_get_id(c2, 999);
    let ok0 = gid.0;
    if ok0 != false { panic(90667); };
}

@test "components_get_valid_id_registered"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r.0;
    let gid = ecs_components_get_valid_id(c2, 900);
    let ok0 = gid.0;
    let cid0 = gid.1;
    if ok0 != true { panic(90668); };
    if cid0 != 0 { panic(90669); };
}

@test "components_get_valid_id_queued_returns_false"() {
    let c = ecs_components_new();
    let r = ecs_components_queue_component(c, 1, 900, true);
    let c2 = r.0;
    let gid = ecs_components_get_valid_id(c2, 900);
    let ok0 = gid.0;
    // queued: not yet registered -> get_valid_id returns None
    if ok0 != false { panic(90670); };
}

@test "components_get_valid_id_resource_excluded"() {
    let c = ecs_components_new();
    let r = ecs_components_init_resource(c, 1, 900);
    let c2 = r.0;
    let gid = ecs_components_get_valid_id(c2, 900);
    let ok0 = gid.0;
    // resource slot is registered, but get_valid_id only returns components not resources
    if ok0 != false { panic(90671); };
}

@test "components_get_valid_resource_id"() {
    let c = ecs_components_new();
    let r1 = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r1.0;
    let r2 = ecs_components_init_resource(c2, 2, 800);
    let c3 = r2.0;
    let gl = ecs_components_get_valid_resource_id(c3, 800);
    let ok0 = gl.0;
    let rid0 = gl.1;
    if ok0 != true { panic(90672); };
    if rid0 != 1 { panic(90673); };
}

@test "components_get_valid_resource_id_component_excluded"() {
    let c = ecs_components_new();
    let r = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r.0;
    let gl = ecs_components_get_valid_resource_id(c2, 900);
    let ok0 = gl.0;
    // component slot but called get_valid_resource_id -> should be None
    if ok0 != false { panic(90674); };
}

@test "components_get_resource_id"() {
    let c = ecs_components_new();
    let r = ecs_components_init_resource(c, 1, 800);
    let c2 = r.0;
    let id = r.1;
    let gid = ecs_components_get_resource_id(c2, 800);
    let ok0 = gid.0;
    let cid0 = gid.1;
    if ok0 != true { panic(90675); };
    if cid0 != id { panic(90676); };
}

@test "components_iter_registered"() {
    let c = ecs_components_new();
    let r1 = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r1.0;
    let r2 = ecs_components_queue_component(c2, 2, 901, true);
    let c3 = r2.0;
    let r3 = ecs_components_init_resource(c3, 3, 902);
    let c4 = r3.0;
    let it = ecs_components_iter_registered(c4);
    // registered: slot 0 (component) and slot 2 (resource). slot 1 is queued.
    if len(it) as i32 != 2 { panic(90677); };
    if it[0] != 0 { panic(90678); };
    if it[1] != 2 { panic(90679); };
}

@test "components_multiple_then_counts"() {
    let c = ecs_components_new();
    let r1 = ecs_components_init_component(c, 1, 900, true, 0, true);
    let c2 = r1.0;
    let r2 = ecs_components_init_component(c2, 2, 901, true, 0, true);
    let c3 = r2.0;
    let r3 = ecs_components_queue_component(c3, 3, 902, true);
    let c4 = r3.0;
    if ecs_components_len(c4) != 3 { panic(90680); };
    if ecs_components_num_registered(c4) != 2 { panic(90681); };
    if ecs_components_num_queued(c4) != 1 { panic(90682); };
    if ecs_components_is_empty(c4) != false { panic(90683); };
}
