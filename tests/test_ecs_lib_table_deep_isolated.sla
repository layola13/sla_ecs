@import "lib/table_deep.sla"

// Batch 238: table storage deep (src/storage/table/mod.rs + column.rs).
// panic codes: 113600 – 113799.

@test "table_id_and_row_wrappers"() {
    let id = ecs_td_id_new(7);
    if ecs_td_id_value(id) != 7 { panic(113600); };
    let row = ecs_td_row_new(3);
    if ecs_td_row_value(row) != 3 { panic(113601); };
}

@test "column_initialize_replace_ticks"() {
    let c = ecs_td_col_new(5, 8, 8, true);
    if ecs_td_col_has_drop(c) != true { panic(113610); };
    if ecs_td_col_len(c) != 0 { panic(113611); };
    c = ecs_td_col_initialize(c, 100, 1, 9);
    c = ecs_td_col_initialize(c, 200, 2, 10);
    if ecs_td_col_len(c) != 2 { panic(113612); };
    if ecs_td_col_get_data(c, 0).1 != 100 { panic(113613); };
    if ecs_td_col_get_added(c, 0).1 != 1 { panic(113614); };
    if ecs_td_col_get_changed(c, 0).1 != 1 { panic(113615); };
    c = ecs_td_col_replace(c, 0, 101, 5, 11);
    if ecs_td_col_get_data(c, 0).1 != 101 { panic(113616); };
    if ecs_td_col_get_added(c, 0).1 != 1 { panic(113617); };
    if ecs_td_col_get_changed(c, 0).1 != 5 { panic(113618); };
    if ecs_td_col_get_changed_by(c, 0).1 != 11 { panic(113619); };
}

@test "column_swap_remove_and_clear"() {
    let c = ecs_td_col_new(1, 4, 8, false);
    c = ecs_td_col_initialize(c, 10, 1, 0);
    c = ecs_td_col_initialize(c, 20, 1, 0);
    c = ecs_td_col_initialize(c, 30, 1, 0);
    c = ecs_td_col_swap_remove(c, 0);
    if ecs_td_col_len(c) != 2 { panic(113620); };
    if ecs_td_col_get_data(c, 0).1 != 30 { panic(113621); };
    if ecs_td_col_get_data(c, 1).1 != 20 { panic(113622); };
    c = ecs_td_col_clear(c);
    if ecs_td_col_len(c) != 0 { panic(113623); };
    if ecs_td_col_component_id(c) != 1 { panic(113624); };
}

@test "column_check_ticks_clamps"() {
    let c = ecs_td_col_new(2, 4, 8, false);
    c = ecs_td_col_initialize(c, 1, 50, 0);
    c = ecs_td_col_initialize(c, 2, 10, 0);
    c = ecs_td_col_check_ticks(c, 20);
    if ecs_td_col_get_added(c, 0).1 != 20 { panic(113630); };
    if ecs_td_col_get_changed(c, 0).1 != 20 { panic(113631); };
    if ecs_td_col_get_added(c, 1).1 != 10 { panic(113632); };
}

@test "table_builder_columns_and_allocate"() {
    let t = ecs_td_table_new(1, 8);
    if ecs_td_table_is_empty(t) != true { panic(113640); };
    t = ecs_td_table_add_column(t, 10, 8, false);
    t = ecs_td_table_add_column(t, 11, 4, true);
    if ecs_td_table_component_count(t) != 2 { panic(113641); };
    if ecs_td_table_has_column(t, 10) != true { panic(113642); };
    if ecs_td_table_has_column(t, 99) != false { panic(113643); };
    if ecs_td_table_column_index(t, 11) != 1 { panic(113644); };
    let r = ecs_td_table_allocate(t, 100, 3);
    t = r.0;
    if r.1 != 0 { panic(113645); };
    r = ecs_td_table_allocate(t, 101, 3);
    t = r.0;
    if r.1 != 1 { panic(113646); };
    if ecs_td_table_entity_count(t) != 2 { panic(113647); };
    if ecs_td_table_get_entity(t, 1) != 101 { panic(113648); };
    if ecs_td_table_get_added_tick(t, 10, 0).1 != 3 { panic(113649); };
}

@test "table_set_get_component_and_ticks"() {
    let t = ecs_td_table_new(1, 8);
    t = ecs_td_table_add_column(t, 7, 8, false);
    let r = ecs_td_table_allocate(t, 1, 1);
    t = r.0;
    t = ecs_td_table_set_component(t, 7, 0, 42, 9, 5);
    let g = ecs_td_table_get_component(t, 7, 0);
    if g.0 != true { panic(113650); };
    if g.1 != 42 { panic(113651); };
    if ecs_td_table_get_added_tick(t, 7, 0).1 != 1 { panic(113652); };
    if ecs_td_table_get_changed_tick(t, 7, 0).1 != 9 { panic(113653); };
}

@test "table_swap_remove_moves_last"() {
    let t = ecs_td_table_new(1, 8);
    t = ecs_td_table_add_column(t, 1, 4, false);
    let r = ecs_td_table_allocate(t, 10, 1); t = r.0;
    r = ecs_td_table_allocate(t, 20, 1); t = r.0;
    r = ecs_td_table_allocate(t, 30, 1); t = r.0;
    t = ecs_td_table_set_component(t, 1, 0, 100, 1, 0);
    t = ecs_td_table_set_component(t, 1, 1, 200, 1, 0);
    t = ecs_td_table_set_component(t, 1, 2, 300, 1, 0);
    t = ecs_td_table_swap_remove(t, 0);
    if ecs_td_table_entity_count(t) != 2 { panic(113660); };
    if ecs_td_table_get_entity(t, 0) != 30 { panic(113661); };
    if ecs_td_table_get_component(t, 1, 0).1 != 300 { panic(113662); };
    if ecs_td_table_get_entity(t, 1) != 20 { panic(113663); };
}

@test "table_clear_keeps_columns"() {
    let t = ecs_td_table_new(2, 8);
    t = ecs_td_table_add_column(t, 3, 4, false);
    t = ecs_td_table_add_column(t, 4, 4, true);
    let r = ecs_td_table_allocate(t, 1, 1); t = r.0;
    t = ecs_td_table_clear(t);
    if ecs_td_table_entity_count(t) != 0 { panic(113670); };
    if ecs_td_table_component_count(t) != 2 { panic(113671); };
    if ecs_td_table_has_column(t, 3) != true { panic(113672); };
    if ecs_td_table_has_column(t, 4) != true { panic(113673); };
    if ecs_td_table_is_empty(t) != true { panic(113674); };
}

@test "tables_registry_empty_reserved_and_push"() {
    let ts = ecs_td_tables_new();
    if ecs_td_tables_len(ts) != 1 { panic(113680); };
    let g = ecs_td_tables_get(ts, 0);
    if g.0 != true { panic(113681); };
    if ecs_td_table_id(g.1) != 0 { panic(113682); };
    let t = ecs_td_table_new(0, 8);
    t = ecs_td_table_add_column(t, 9, 8, false);
    let p = ecs_td_tables_push(ts, t);
    ts = p.0;
    if p.1 != 1 { panic(113683); };
    if ecs_td_tables_len(ts) != 2 { panic(113684); };
    g = ecs_td_tables_get(ts, 1);
    if g.0 != true { panic(113685); };
    if ecs_td_table_has_column(g.1, 9) != true { panic(113686); };
    if ecs_td_table_id(g.1) != 1 { panic(113687); };
}

@test "tables_set_and_allocate_through_registry"() {
    let ts = ecs_td_tables_new();
    let t = ecs_td_table_new(0, 8);
    t = ecs_td_table_add_column(t, 1, 4, false);
    let p = ecs_td_tables_push(ts, t);
    ts = p.0;
    let id = p.1;
    let g = ecs_td_tables_get(ts, id);
    t = g.1;
    let r = ecs_td_table_allocate(t, 55, 2);
    t = r.0;
    t = ecs_td_table_set_component(t, 1, 0, 77, 4, 3);
    ts = ecs_td_tables_set(ts, id, t);
    g = ecs_td_tables_get(ts, id);
    if ecs_td_table_entity_count(g.1) != 1 { panic(113690); };
    if ecs_td_table_get_component(g.1, 1, 0).1 != 77 { panic(113691); };
    if ecs_td_table_get_changed_tick(g.1, 1, 0).1 != 4 { panic(113692); };
}
