@import "lib/result_deep.sla"

// Batch 308: result deep.
// panic codes: 127600 – 127799.

@test "ok_and_err"() {
    let o = ecs_res_ok(42);
    let e = ecs_res_err(7);
    if ecs_res_is_ok(o) != true { panic(127600); };
    if ecs_res_is_err(e) != true { panic(127601); };
    if ecs_res_ok_value(o) != 42 { panic(127602); };
    if ecs_res_err_code(e) != 7 { panic(127603); };
}

@test "unwrap_or"() {
    if ecs_res_unwrap_or(ecs_res_ok(5), 9) != 5 { panic(127610); };
    if ecs_res_unwrap_or(ecs_res_err(1), 9) != 9 { panic(127611); };
}

@test "map_ok_and_err"() {
    let o = ecs_res_map(ecs_res_ok(10), 3);
    if ecs_res_ok_value(o) != 13 { panic(127620); };
    let e = ecs_res_map(ecs_res_err(2), 3);
    if ecs_res_is_err(e) != true { panic(127621); };
    if ecs_res_err_code(e) != 2 { panic(127622); };
}

@test "map_err"() {
    let e = ecs_res_map_err(ecs_res_err(4), 1);
    if ecs_res_err_code(e) != 5 { panic(127630); };
    let o = ecs_res_map_err(ecs_res_ok(8), 1);
    if ecs_res_is_ok(o) != true { panic(127631); };
    if ecs_res_ok_value(o) != 8 { panic(127632); };
}

@test "and_then_or_else"() {
    let a = ecs_res_and_then(ecs_res_ok(1), 99);
    if ecs_res_ok_value(a) != 99 { panic(127640); };
    let b = ecs_res_and_then(ecs_res_err(3), 99);
    if ecs_res_err_code(b) != 3 { panic(127641); };
    let c = ecs_res_or_else(ecs_res_err(3), 50);
    if ecs_res_ok_value(c) != 50 { panic(127642); };
    let d = ecs_res_or_else(ecs_res_ok(8), 50);
    if ecs_res_ok_value(d) != 8 { panic(127643); };
}

@test "eq"() {
    if ecs_res_eq(ecs_res_ok(1), ecs_res_ok(1)) != true { panic(127650); };
    if ecs_res_eq(ecs_res_ok(1), ecs_res_ok(2)) != false { panic(127651); };
    if ecs_res_eq(ecs_res_err(4), ecs_res_err(4)) != true { panic(127652); };
    if ecs_res_eq(ecs_res_ok(1), ecs_res_err(1)) != false { panic(127653); };
}

@test "inspect_ok_err"() {
    let i = ecs_res_inspect_ok(ecs_res_ok(3));
    if ecs_res_inspect_ok_seen(i) != true { panic(127660); };
    if ecs_res_inspect_err_seen(i) != false { panic(127661); };
    let j = ecs_res_inspect_err(ecs_res_err(9));
    if ecs_res_inspect_err_seen(j) != true { panic(127662); };
    if ecs_res_inspect_ok_seen(j) != false { panic(127663); };
    if ecs_res_ok_value(ecs_res_inspect_result(i)) != 3 { panic(127664); };
}

@test "from_option"() {
    let o = ecs_res_from_option(true, 12);
    if ecs_res_is_ok(o) != true { panic(127670); };
    if ecs_res_ok_value(o) != 12 { panic(127671); };
    let n = ecs_res_from_option(false, 0);
    if ecs_res_is_none_err(n) != true { panic(127672); };
    if ecs_res_is_none_err(o) != false { panic(127673); };
}

@test "flatten_pair"() {
    let ok = ecs_res_flatten_pair(true, 6, 0);
    if ecs_res_ok_value(ok) != 6 { panic(127680); };
    let nested = ecs_res_flatten_pair(true, 0 - 4, 0);
    if ecs_res_err_code(nested) != 4 { panic(127681); };
    let outer = ecs_res_flatten_pair(false, 0, 11);
    if ecs_res_err_code(outer) != 11 { panic(127682); };
}

@test "is_err_on_ok"() {
    if ecs_res_is_err(ecs_res_ok(1)) != false { panic(127690); };
    if ecs_res_is_ok(ecs_res_err(2)) != false { panic(127691); };
}
