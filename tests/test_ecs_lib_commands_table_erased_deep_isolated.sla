// Isolated deep tests for lib/commands_table_erased_deep.sla (Batch 365).
// Kind-discriminated deferred command queue for TableErasedWorld incl. batch-bundle commands.
// panic codes: 139000 - 139199.

@import "lib/commands_table_erased_deep.sla"

const TYPE_POS: i32 = 411;
const TYPE_VEL: i32 = 412;
const TYPE_MARKER: i32 = 413;

@test "TblErasedCommands new empty and side counts zero"() {
    let c = ecs_tbl_erased_commands_new();
    if ecs_tbl_erased_commands_len(c) != 0 { panic(139000); };
    if ecs_tbl_erased_commands_pcomp_count(c) != 0 { panic(139001); };
    if ecs_tbl_erased_commands_pres_count(c) != 0 { panic(139002); };
    if ecs_tbl_erased_commands_pmsg_count(c) != 0 { panic(139003); };
    if ecs_tbl_erased_commands_b2_count(c) != 0 { panic(139004); };
    if ecs_tbl_erased_commands_b3_count(c) != 0 { panic(139005); };
    if ecs_tbl_erased_commands_kind_at(c, 0) != 0 { panic(139006); };
}

@test "insert enqueues INSERT_COMPONENT with type_id and scalar value"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = ecs_tbl_erased_commands_insert(c0, 7, 11, TYPE_POS, 50);
    if ecs_tbl_erased_commands_len(c1) != 1 { panic(139010); };
    if ecs_tbl_erased_commands_kind_at(c1, 0) != ECS_CMD_TBL_ERASED_INSERT_COMPONENT { panic(139011); };
    if ecs_tbl_erased_commands_entity_at(c1, 0) != 7 { panic(139012); };
    if ecs_tbl_erased_commands_cmp_at(c1, 0) != 11 { panic(139013); };
    if ecs_tbl_erased_commands_idx_at(c1, 0) != 0 { panic(139014); };
    if ecs_tbl_erased_commands_pcomp_count(c1) != 1 { panic(139015); };
    if ecs_tbl_erased_commands_resolve_value(c1, 0) != 50 { panic(139016); };
    if ecs_tbl_erased_commands_resolve_type(c1, 0) != TYPE_POS { panic(139017); };
    if ecs_tbl_erased_commands_pv_at(c1, 0) != 50 { panic(139018); };
}

@test "despawn insert_resource write_message mixed-path queue"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = ecs_tbl_erased_commands_despawn(c0, 9);
    if ecs_tbl_erased_commands_kind_at(c1, 0) != ECS_CMD_TBL_ERASED_DESPAWN { panic(139020); };
    if ecs_tbl_erased_commands_idx_at(c1, 0) != -1 { panic(139021); };
    let c2 = ecs_tbl_erased_commands_insert_resource(c1, 888);
    if ecs_tbl_erased_commands_kind_at(c2, 1) != ECS_CMD_TBL_ERASED_INSERT_RESOURCE { panic(139022); };
    if ecs_tbl_erased_commands_pres_count(c2) != 1 { panic(139023); };
    if ecs_tbl_erased_commands_resolve_value(c2, 1) != 888 { panic(139024); };
    let c3 = ecs_tbl_erased_commands_write_message(c2, 42);
    if ecs_tbl_erased_commands_kind_at(c3, 2) != ECS_CMD_TBL_ERASED_WRITE_MESSAGE { panic(139025); };
    if ecs_tbl_erased_commands_pmsg_count(c3) != 1 { panic(139026); };
    if ecs_tbl_erased_commands_resolve_value(c3, 2) != 42 { panic(139027); };
    if ecs_tbl_erased_commands_len(c3) != 3 { panic(139028); };
}

@test "spawn_batch_bundle2 stores bundle2 tail-side array"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = ecs_tbl_erased_commands_spawn_batch_bundle2(c0, TYPE_POS, TYPE_VEL, 1, 2, TYPE_POS, TYPE_MARKER, 3, 4, 2);
    if ecs_tbl_erased_commands_len(c1) != 1 { panic(139030); };
    if ecs_tbl_erased_commands_kind_at(c1, 0) != ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE2 { panic(139031); };
    if ecs_tbl_erased_commands_b2_count(c1) != 1 { panic(139032); };
    let slot: i32 = ecs_tbl_erased_commands_batch_slot(c1, 0);
    if slot != 0 { panic(139033); };
    if ecs_tbl_erased_commands_b2c_at(c1, 0) != 2 { panic(139034); };
    let b0 = ecs_tbl_erased_commands_b2_at(c1, 0, 0);
    if ecs_tbl_erased_b2_first_type(b0) != TYPE_POS { panic(139035); };
    if ecs_tbl_erased_b2_second_type(b0) != TYPE_VEL { panic(139036); };
    if ecs_tbl_erased_b2_first_value(b0) != 1 { panic(139037); };
    if ecs_tbl_erased_b2_second_value(b0) != 2 { panic(139038); };
    let b1 = ecs_tbl_erased_commands_b2_at(c1, 0, 1);
    if ecs_tbl_erased_b2_second_type(b1) != TYPE_MARKER { panic(139039); };
    if ecs_tbl_erased_b2_first_value(b1) != 3 { panic(139040); };
}

@test "spawn_batch_bundle3 stores bundle3 cap-2 batch entries"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = ecs_tbl_erased_commands_spawn_batch_bundle3(c0, TYPE_POS, TYPE_VEL, TYPE_MARKER, 1, 2, 3, TYPE_POS, TYPE_VEL, TYPE_MARKER, 4, 5, 6, 2);
    if ecs_tbl_erased_commands_len(c1) != 1 { panic(139050); };
    if ecs_tbl_erased_commands_kind_at(c1, 0) != ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE3 { panic(139051); };
    if ecs_tbl_erased_commands_b3_count(c1) != 1 { panic(139052); };
    if ecs_tbl_erased_commands_b3c_at(c1, 0) != 2 { panic(139053); };
    let b0 = ecs_tbl_erased_commands_b3_at(c1, 0, 0);
    if ecs_tbl_erased_b3_third_type(b0) != TYPE_MARKER { panic(139054); };
    if ecs_tbl_erased_b3_first_value(b0) != 1 { panic(139055); };
    if ecs_tbl_erased_b3_third_value(b0) != 3 { panic(139056); };
    let b1 = ecs_tbl_erased_commands_b3_at(c1, 0, 1);
    if ecs_tbl_erased_b3_second_value(b1) != 5 { panic(139057); };
    if ecs_tbl_erased_b3_third_type(b1) != TYPE_MARKER { panic(139058); };
}

@test "insert_batch_bundle2 and _if_new queue distinct kinds"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = ecs_tbl_erased_commands_insert_batch_bundle2(c0, 5, 6, TYPE_POS, TYPE_VEL, 1, 2, TYPE_POS, TYPE_MARKER, 3, 4, 2);
    if ecs_tbl_erased_commands_kind_at(c1, 0) != ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2 { panic(139060); };
    if ecs_tbl_erased_commands_b2_count(c1) != 1 { panic(139061); };
    let b = ecs_tbl_erased_commands_b2_at(c1, 0, 0);
    if ecs_tbl_erased_b2_entity(b) != 5 { panic(139062); };
    if ecs_tbl_erased_b2_first_type(b) != TYPE_POS { panic(139063); };
    let b2 = ecs_tbl_erased_commands_b2_at(c1, 0, 1);
    if ecs_tbl_erased_b2_entity(b2) != 6 { panic(139064); };
    let c2 = ecs_tbl_erased_commands_insert_batch_bundle2_if_new(c1, 7, 8, TYPE_VEL, TYPE_MARKER, 9, 10, TYPE_VEL, TYPE_POS, 11, 12, 2);
    if ecs_tbl_erased_commands_kind_at(c2, 1) != ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2_IF_NEW { panic(139065); };
    if ecs_tbl_erased_commands_b2_count(c2) != 2 { panic(139066); };
    let b3 = ecs_tbl_erased_commands_b2_at(c2, 1, 1);
    if ecs_tbl_erased_b2_first_type(b3) != TYPE_VEL { panic(139067); };
    if ecs_tbl_erased_b2_first_value(b3) != 11 { panic(139068); };
}

@test "insert_batch_bundle3 and _if_new queue distinct kinds"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = ecs_tbl_erased_commands_insert_batch_bundle3(c0, 5, 6, TYPE_POS, TYPE_VEL, TYPE_MARKER, 1, 2, 3, TYPE_MARKER, TYPE_POS, TYPE_VEL, 4, 5, 6, 2);
    if ecs_tbl_erased_commands_kind_at(c1, 0) != ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE3 { panic(139070); };
    if ecs_tbl_erased_commands_b3_count(c1) != 1 { panic(139071); };
    let b = ecs_tbl_erased_commands_b3_at(c1, 0, 0);
    if ecs_tbl_erased_b3_entity(b) != 5 { panic(139072); };
    if ecs_tbl_erased_b3_third_value(b) != 3 { panic(139073); };
    let c2 = ecs_tbl_erased_commands_insert_batch_bundle3_if_new(c1, 7, 8, TYPE_VEL, TYPE_POS, TYPE_MARKER, 9, 10, 11, TYPE_MARKER, TYPE_POS, TYPE_VEL, 12, 13, 14, 2);
    if ecs_tbl_erased_commands_kind_at(c2, 1) != ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE3_IF_NEW { panic(139074); };
    if ecs_tbl_erased_commands_b3_count(c2) != 2 { panic(139075); };
    let b2 = ecs_tbl_erased_commands_b3_at(c2, 1, 1);
    if ecs_tbl_erased_b3_first_value(b2) != 12 { panic(139076); };
}

@test "count_by_kind across ten kinds of queue (split queues)"() {
    // Queue A: 4 trivial kinds (cap-8 command list, no batch side arrays consumed).
    let a0 = ecs_tbl_erased_commands_new();
    let a1 = ecs_tbl_erased_commands_insert(a0, 1, 10, TYPE_POS, 1);
    let a2 = ecs_tbl_erased_commands_despawn(a1, 1);
    let a3 = ecs_tbl_erased_commands_insert_resource(a2, 9);
    let a4 = ecs_tbl_erased_commands_write_message(a3, 3);
    if ecs_tbl_erased_commands_count_by_kind(a4, ECS_CMD_TBL_ERASED_INSERT_COMPONENT) != 1 { panic(139080); };
    if ecs_tbl_erased_commands_count_by_kind(a4, ECS_CMD_TBL_ERASED_DESPAWN) != 1 { panic(139081); };
    if ecs_tbl_erased_commands_count_by_kind(a4, ECS_CMD_TBL_ERASED_INSERT_RESOURCE) != 1 { panic(139082); };
    if ecs_tbl_erased_commands_count_by_kind(a4, ECS_CMD_TBL_ERASED_WRITE_MESSAGE) != 1 { panic(139083); };
    // Queue B: 3 b2 batch kinds (cap-2 batches): spawn, insert, insert_if_new — fill b2 slots exactly.
    let b0 = ecs_tbl_erased_commands_new();
    let b1 = ecs_tbl_erased_commands_spawn_batch_bundle2(b0, TYPE_POS, TYPE_VEL, 1, 2, TYPE_POS, TYPE_MARKER, 3, 4, 2);
    let b2 = ecs_tbl_erased_commands_insert_batch_bundle2(b1, 5, 6, TYPE_POS, TYPE_VEL, 1, 2, TYPE_VEL, TYPE_MARKER, 3, 4, 2);
    // third b2 batch is rejected by cap-2; queue freezes at 2 b2 batches. Test that first two
    // b2 kinds are counted and the third does not appear in this queue.
    if ecs_tbl_erased_commands_count_by_kind(b2, ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE2) != 1 { panic(139084); };
    if ecs_tbl_erased_commands_count_by_kind(b2, ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2) != 1 { panic(139086); };
    if ecs_tbl_erased_commands_len(b2) != 2 { panic(139087); };
    // Queue C: 3 b3 batch kinds — only fits 2 of them, same cap pattern.
    let d0 = ecs_tbl_erased_commands_new();
    let d1 = ecs_tbl_erased_commands_spawn_batch_bundle3(d0, TYPE_POS, TYPE_VEL, TYPE_MARKER, 1, 2, 3, TYPE_POS, TYPE_VEL, TYPE_MARKER, 4, 5, 6, 2);
    let d2 = ecs_tbl_erased_commands_insert_batch_bundle3(d1, 1, 2, TYPE_MARKER, TYPE_POS, TYPE_VEL, 1, 2, 3, TYPE_POS, TYPE_VEL, TYPE_MARKER, 4, 5, 6, 2);
    if ecs_tbl_erased_commands_count_by_kind(d2, ECS_CMD_TBL_ERASED_SPAWN_BATCH_BUNDLE3) != 1 { panic(139085); };
    if ecs_tbl_erased_commands_count_by_kind(d2, ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE3) != 1 { panic(139088); };
    if ecs_tbl_erased_commands_len(d2) != 2 { panic(139089); };
    // Queue D: IF_NEW kinds alone to verify count and cap behavior.
    let e0 = ecs_tbl_erased_commands_new();
    let e1 = ecs_tbl_erased_commands_insert_batch_bundle2_if_new(e0, 1, 2, TYPE_POS, TYPE_VEL, 1, 2, TYPE_VEL, TYPE_MARKER, 3, 4, 2);
    let e2 = ecs_tbl_erased_commands_insert_batch_bundle3_if_new(e1, 1, 2, TYPE_MARKER, TYPE_POS, TYPE_VEL, 1, 2, 3, TYPE_POS, TYPE_VEL, TYPE_MARKER, 4, 5, 6, 2);
    if ecs_tbl_erased_commands_count_by_kind(e2, ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE2_IF_NEW) != 1 { panic(139090); };
    if ecs_tbl_erased_commands_count_by_kind(e2, ECS_CMD_TBL_ERASED_INSERT_BATCH_BUNDLE3_IF_NEW) != 1 { panic(139091); };
    if ecs_tbl_erased_commands_len(e2) != 2 { panic(139092); };
}

@test "queue cap-8 rejection on commands and side arrays; clear resets all"() {
    let c0 = ecs_tbl_erased_commands_new();
    let c1 = c0;
    let i: i32 = 0;
    while i < 8 {
        c1 = ecs_tbl_erased_commands_insert(c1, i, i, TYPE_POS, 100 + i);
        i = i + 1;
    }
    if ecs_tbl_erased_commands_len(c1) != 8 { panic(139100); };
    if ecs_tbl_erased_commands_pcomp_count(c1) != 8 { panic(139101); };
    let c2 = ecs_tbl_erased_commands_insert(c1, 99, 99, 999, 999);
    if ecs_tbl_erased_commands_len(c2) != 8 { panic(139102); };
    let c3 = ecs_tbl_erased_commands_clear(c2);
    if ecs_tbl_erased_commands_len(c3) != 0 { panic(139103); };
    if ecs_tbl_erased_commands_pcomp_count(c3) != 0 { panic(139104); };
    if ecs_tbl_erased_commands_pres_count(c3) != 0 { panic(139105); };
    if ecs_tbl_erased_commands_pmsg_count(c3) != 0 { panic(139106); };
    if ecs_tbl_erased_commands_b2_count(c3) != 0 { panic(139107); };
    if ecs_tbl_erased_commands_b3_count(c3) != 0 { panic(139108); };
}

@test "batch cap-2 rejection for b2 and b3 side arrays"() {
    let c0 = ecs_tbl_erased_commands_new();
    // two bundle2 batches allowed, the third is rejected
    let c1 = ecs_tbl_erased_commands_spawn_batch_bundle2(c0, TYPE_POS, TYPE_VEL, 1, 2, TYPE_POS, TYPE_MARKER, 3, 4, 2);
    let c2 = ecs_tbl_erased_commands_spawn_batch_bundle2(c1, TYPE_POS, TYPE_VEL, 5, 6, TYPE_POS, TYPE_MARKER, 7, 8, 2);
    let c3 = ecs_tbl_erased_commands_spawn_batch_bundle2(c2, TYPE_POS, TYPE_VEL, 9, 10, TYPE_POS, TYPE_MARKER, 11, 12, 2);
    if ecs_tbl_erased_commands_b2_count(c3) != 2 { panic(139110); };
    if ecs_tbl_erased_commands_len(c3) != 2 { panic(139111); };
    // same for bundle3 batches
    let c4 = ecs_tbl_erased_commands_spawn_batch_bundle3(c3, TYPE_POS, TYPE_VEL, TYPE_MARKER, 1, 2, 3, TYPE_POS, TYPE_VEL, TYPE_MARKER, 4, 5, 6, 2);
    let c5 = ecs_tbl_erased_commands_spawn_batch_bundle3(c4, TYPE_POS, TYPE_VEL, TYPE_MARKER, 7, 8, 9, TYPE_POS, TYPE_VEL, TYPE_MARKER, 10, 11, 12, 2);
    let c6 = ecs_tbl_erased_commands_spawn_batch_bundle3(c5, TYPE_POS, TYPE_VEL, TYPE_MARKER, 13, 14, 15, TYPE_POS, TYPE_VEL, TYPE_MARKER, 16, 17, 18, 2);
    if ecs_tbl_erased_commands_b3_count(c6) != 2 { panic(139112); };
    if ecs_tbl_erased_commands_len(c6) != 4 { panic(139113); };
}
