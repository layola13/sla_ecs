@import "lib/query_state_deep.sla"

// Batch 253: query_state deep (src/query/state.rs).
// panic codes: 116600 – 116799.

@test "new_init_access_and_world_id"() {
    let s = ecs_qs_deep_new(9);
    if ecs_qs_deep_world_id(s) != 9 { panic(116600); };
    if ecs_qs_deep_is_initialized(s) != false { panic(116601); };
    if ecs_qs_deep_is_empty(s) != true { panic(116602); };
    s = ecs_qs_deep_init_access(s);
    if ecs_qs_deep_is_initialized(s) != true { panic(116603); };
}

@test "add_read_write_dedup"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_add_read(s, 2);
    s = ecs_qs_deep_add_read(s, 3);
    s = ecs_qs_deep_add_read(s, 2);
    s = ecs_qs_deep_add_write(s, 4);
    s = ecs_qs_deep_add_write(s, 4);
    if ecs_qs_deep_read_len(s) != 2 { panic(116610); };
    if ecs_qs_deep_write_len(s) != 1 { panic(116611); };
}

@test "new_archetype_matches_required"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_add_read(s, 1);
    s = ecs_qs_deep_add_write(s, 2);
    s = ecs_qs_deep_new_archetype(s, 10, 20, 1, 2, 0, 0, 2);
    if ecs_qs_deep_archetype_count(s) != 1 { panic(116620); };
    if ecs_qs_deep_table_count(s) != 1 { panic(116621); };
    if ecs_qs_deep_contains_archetype(s, 10) != true { panic(116622); };
    if ecs_qs_deep_contains_table(s, 20) != true { panic(116623); };
    // missing required write
    s = ecs_qs_deep_new_archetype(s, 11, 21, 1, 0, 0, 0, 1);
    if ecs_qs_deep_archetype_count(s) != 1 { panic(116624); };
}

@test "non_dense_skips_table_match"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_set_dense(s, false);
    s = ecs_qs_deep_add_read(s, 5);
    s = ecs_qs_deep_new_archetype(s, 3, 99, 5, 0, 0, 0, 1);
    if ecs_qs_deep_is_dense(s) != false { panic(116630); };
    if ecs_qs_deep_archetype_count(s) != 1 { panic(116631); };
    if ecs_qs_deep_table_count(s) != 0 { panic(116632); };
}

@test "update_archetypes_generation_gate"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_update_archetypes(s, 2);
    if ecs_qs_deep_generation(s) != 2 { panic(116640); };
    s = ecs_qs_deep_update_archetypes(s, 2);
    if ecs_qs_deep_generation(s) != 2 { panic(116641); };
    s = ecs_qs_deep_update_archetypes(s, 5);
    if ecs_qs_deep_generation(s) != 5 { panic(116642); };
}

@test "as_readonly_moves_writes"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_add_read(s, 1);
    s = ecs_qs_deep_add_write(s, 2);
    s = ecs_qs_deep_add_write(s, 3);
    s = ecs_qs_deep_as_readonly(s);
    if ecs_qs_deep_write_len(s) != 0 { panic(116650); };
    if ecs_qs_deep_read_len(s) != 3 { panic(116651); };
}

@test "get_and_get_many"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_add_read(s, 1);
    s = ecs_qs_deep_new_archetype(s, 7, 1, 1, 0, 0, 0, 1);
    if ecs_qs_deep_get_ok(s, 7) != true { panic(116660); };
    if ecs_qs_deep_get_ok(s, 8) != false { panic(116661); };
    let m = ecs_qs_deep_get_many2(s, 1, 7, 2, 7);
    if ecs_qs_many_ok(m) != true { panic(116662); };
    if ecs_qs_many_unique(m) != true { panic(116663); };
    m = ecs_qs_deep_get_many2(s, 1, 7, 1, 7);
    if ecs_qs_many_unique(m) != false { panic(116664); };
    m = ecs_qs_deep_get_many2(s, 1, 7, 2, 9);
    if ecs_qs_many_ok(m) != false { panic(116665); };
}

@test "intersect_matched_sets"() {
    let a = ecs_qs_deep_new(1);
    a = ecs_qs_deep_init_access(a);
    a = ecs_qs_deep_add_read(a, 1);
    a = ecs_qs_deep_add_table(a, 10);
    a = ecs_qs_deep_add_table(a, 11);
    a = ecs_qs_deep_add_archetype(a, 20);
    a = ecs_qs_deep_add_archetype(a, 21);
    let b = ecs_qs_deep_new(1);
    b = ecs_qs_deep_init_access(b);
    b = ecs_qs_deep_add_table(b, 11);
    b = ecs_qs_deep_add_table(b, 12);
    b = ecs_qs_deep_add_archetype(b, 21);
    b = ecs_qs_deep_add_archetype(b, 22);
    let c = ecs_qs_deep_intersect(a, b);
    if ecs_qs_deep_table_count(c) != 1 { panic(116670); };
    if ecs_qs_deep_contains_table(c, 11) != true { panic(116671); };
    if ecs_qs_deep_archetype_count(c) != 1 { panic(116672); };
    if ecs_qs_deep_contains_archetype(c, 21) != true { panic(116673); };
    if ecs_qs_deep_is_initialized(c) != true { panic(116674); };
}

@test "is_empty_after_match"() {
    let s = ecs_qs_deep_new(1);
    if ecs_qs_deep_is_empty(s) != true { panic(116680); };
    s = ecs_qs_deep_add_archetype(s, 1);
    if ecs_qs_deep_is_empty(s) != false { panic(116681); };
}

@test "dedup_matched_ids"() {
    let s = ecs_qs_deep_new(1);
    s = ecs_qs_deep_add_table(s, 5);
    s = ecs_qs_deep_add_table(s, 5);
    s = ecs_qs_deep_add_archetype(s, 6);
    s = ecs_qs_deep_add_archetype(s, 6);
    if ecs_qs_deep_table_count(s) != 1 { panic(116690); };
    if ecs_qs_deep_archetype_count(s) != 1 { panic(116691); };
}
