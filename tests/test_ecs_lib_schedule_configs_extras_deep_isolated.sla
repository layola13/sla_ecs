@import "lib/schedule_configs_extras_deep.sla"

// Batch 332: schedule_configs_extras deep.
// panic codes: 132400 – 132599.

@test "add_systems"() {
    let c = ecs_sce_deep_new();
    c = ecs_sce_deep_add(c, 10);
    c = ecs_sce_deep_add(c, 20);
    if ecs_sce_deep_len(c) != 2 { panic(132400); };
    if ecs_sce_deep_system_at(c, 1) != 20 { panic(132401); };
}

@test "chain"() {
    let c = ecs_sce_deep_chain(ecs_sce_deep_add(ecs_sce_deep_new(), 1));
    if ecs_sce_deep_is_chain(c) != true { panic(132410); };
    if ecs_sce_deep_applies_deferred(c) != true { panic(132411); };
}

@test "chain_ignore_deferred"() {
    let c = ecs_sce_deep_chain_ignore_deferred(ecs_sce_deep_new());
    if ecs_sce_deep_is_chain(c) != true { panic(132420); };
    if ecs_sce_deep_applies_deferred(c) != false { panic(132421); };
}

@test "run_if_conditions"() {
    let c = ecs_sce_deep_add(ecs_sce_deep_add(ecs_sce_deep_new(), 1), 2);
    c = ecs_sce_deep_distributive_run_if(c, 9);
    c = ecs_sce_deep_run_if(c, 8);
    if ecs_sce_deep_distributive(c) != 2 { panic(132430); };
    if ecs_sce_deep_collective(c) != 1 { panic(132431); };
}

@test "before_after_ignore"() {
    let c = ecs_sce_deep_new();
    c = ecs_sce_deep_before_ignore_deferred(c, 5);
    c = ecs_sce_deep_after_ignore_deferred(c, 6);
    if ecs_sce_deep_before(c) != 5 { panic(132440); };
    if ecs_sce_deep_after(c) != 6 { panic(132441); };
}

@test "ambiguous_with"() {
    let c = ecs_sce_deep_ambiguous_with(ecs_sce_deep_ambiguous_with(ecs_sce_deep_new(), 1), 2);
    if ecs_sce_deep_amb_count(c) != 2 { panic(132450); };
    if ecs_sce_deep_amb_at(c, 1) != 2 { panic(132451); };
}

@test "ambiguous_with_all"() {
    let c = ecs_sce_deep_ambiguous_with_all(ecs_sce_deep_new());
    if ecs_sce_deep_amb_all(c) != true { panic(132460); };
}

@test "into_configs"() {
    let c = ecs_sce_deep_add(ecs_sce_deep_new(), 3);
    let d = ecs_sce_deep_into_configs(c);
    if ecs_sce_deep_len(d) != 1 { panic(132470); };
}

@test "capacity_four_systems"() {
    let c = ecs_sce_deep_new();
    c = ecs_sce_deep_add(c, 1);
    c = ecs_sce_deep_add(c, 2);
    c = ecs_sce_deep_add(c, 3);
    c = ecs_sce_deep_add(c, 4);
    c = ecs_sce_deep_add(c, 5);
    if ecs_sce_deep_len(c) != 4 { panic(132480); };
}

@test "system_at_oob"() {
    let c = ecs_sce_deep_new();
    if ecs_sce_deep_system_at(c, 0) != (0 - 1) { panic(132490); };
}
