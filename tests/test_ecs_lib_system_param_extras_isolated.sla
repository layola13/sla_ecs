@import "lib/system_param_extras.sla"

// Isolated tests for lib/system_param_extras.sla — Local<T> + StaticSystemParam + SystemParamValidationError.
// Bevy: src/system/system_param.rs.
// panic codes: 92200 – 92240.

@test "local_new_from_world_initializes_with_value"() {
    let l = ecs_local_new_from_world(42);
    if !ecs_local_is_initialized(l) { panic(92200); };
    if ecs_local_get(l) != 42 { panic(92201); };
}

@test "local_new_uninit_is_uninitialized_zero"() {
    let l = ecs_local_new_uninit();
    if ecs_local_is_initialized(l) { panic(92202); };
    if ecs_local_get(l) != 0 { panic(92203); };
}

@test "local_set_mutates_and_initializes"() {
    let l0 = ecs_local_new_uninit();
    let l1 = ecs_local_set(l0, 99);
    if !ecs_local_is_initialized(l1) { panic(92204); };
    if ecs_local_get(l1) != 99 { panic(92205); };
    // re-overwrite
    let l2 = ecs_local_set(l1, 100);
    if ecs_local_get(l2) != 100 { panic(92206); };
}

@test "local_from_world_value_is_persisted_across_set"() {
    let l0 = ecs_local_new_from_world(7);
    let l1 = ecs_local_set(l0, 8);
    if ecs_local_get(l1) != 8 { panic(92207); };
    if !ecs_local_is_initialized(l1) { panic(92208); };
}

@test "static_system_param_new_and_into_inner"() {
    let p = ecs_static_system_param_new(555);
    if ecs_static_system_param_get(p) != 555 { panic(92209); };
    let inner = ecs_static_system_param_into_inner(p);
    if inner != 555 { panic(92210); };
}

@test "static_system_param_set_mutates_inner"() {
    let p0 = ecs_static_system_param_new(10);
    let p1 = ecs_static_system_param_set(p0, 20);
    if ecs_static_system_param_get(p1) != 20 { panic(92211); };
    if ecs_static_system_param_into_inner(p1) != 20 { panic(92212); };
}

@test "static_system_param_deref_returns_same_as_into_inner"() {
    let p = ecs_static_system_param_new(333);
    if ecs_static_system_param_get(p) != ecs_static_system_param_into_inner(p) { panic(92213); };
}

@test "spve_empty_is_default_values"() {
    let e = ecs_spve_empty();
    if ecs_spve_skipped_get(e) { panic(92214); };
    if ecs_spve_message(e) != 0 { panic(92215); };
    if ecs_spve_param(e) != 0 { panic(92216); };
    if ecs_spve_field(e) != 0 { panic(92217); };
}

@test "spve_new_sets_all_fields"() {
    let e = ecs_spve_new(7, true, 100, 3);
    if !ecs_spve_skipped_get(e) { panic(92218); };
    if ecs_spve_message(e) != 100 { panic(92219); };
    if ecs_spve_param(e) != 7 { panic(92220); };
    if ecs_spve_field(e) != 3 { panic(92221); };
}

@test "spve_skipped_sets_skip_and_no_field"() {
    let e = ecs_spve_skipped(9, 200);
    if !ecs_spve_skipped_get(e) { panic(92222); };
    if ecs_spve_message(e) != 200 { panic(92223); };
    if ecs_spve_param(e) != 9 { panic(92224); };
    if ecs_spve_field(e) != 0 { panic(92225); };
}

@test "spve_invalid_sets_no_skip_and_no_field"() {
    let e = ecs_spve_invalid(12, 300);
    if ecs_spve_skipped_get(e) { panic(92226); };
    if ecs_spve_message(e) != 300 { panic(92227); };
    if ecs_spve_param(e) != 12 { panic(92228); };
    if ecs_spve_field(e) != 0 { panic(92229); };
}

@test "spve_display_no_field"() {
    let e = ecs_spve_new(7, false, 100, 0);
    let d = ecs_spve_display(e);
    if ecs_spve_dr_param(d) != 7 { panic(92230); };
    if ecs_spve_dr_has_field(d) { panic(92231); };
    if ecs_spve_dr_message(d) != 100 { panic(92232); };
}

@test "spve_display_with_field"() {
    let e = ecs_spve_new(7, true, 100, 3);
    let d = ecs_spve_display(e);
    if ecs_spve_dr_param(d) != 7 { panic(92233); };
    if !ecs_spve_dr_has_field(d) { panic(92234); };
    if ecs_spve_dr_message(d) != 100 { panic(92235); };
}

@test "spve_skipped_vs_invalid_distinguished"() {
    let s = ecs_spve_skipped(1, 10);
    let inv = ecs_spve_invalid(1, 10);
    if !ecs_spve_skipped_get(s) { panic(92236); };
    if ecs_spve_skipped_get(inv) { panic(92237); };
    // both share the same message + param + (no field) — only skipped differs.
    if ecs_spve_message(s) != ecs_spve_message(inv) { panic(92238); };
}

@test "local_and_spve_independent_state"() {
    let l = ecs_local_new_from_world(5);
    let err = ecs_spve_skipped(2, 9);
    if ecs_local_get(l) != 5 { panic(92239); };
    if ecs_spve_param(err) != 2 { panic(92240); };
}
